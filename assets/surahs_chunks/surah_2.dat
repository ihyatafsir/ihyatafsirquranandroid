ad.\" [Allāh] said, \"Have you not believed?\" He said, \"Yes, but [I ask] only that my heart may be satisfied.\" [Allāh] said, \"Take four birds and commit them to yourself.[1] Then [after slaughtering them] put on each hill a portion of them; then call them - they will come [flying] to you in haste. And know that Allāh is Exalted in Might and Wise.\"", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "إِبْرَٰهِۦمُ", "translit": "ُmۦِhَٰrْbِiʾ", "root": ""}, {"id": 4, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 5, "arabic": "أَرِنِى", "translit": "àِnِrَaʾ", "root": "راي"}, {"id": 6, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 7, "arabic": "تُحْىِ", "translit": "ِàْḥُt", "root": "حيي"}, {"id": 8, "arabic": "ٱلْمَوْتَىٰ", "translit": "ٰàَtْwَmْlٱ", "root": "موت"}, {"id": 9, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 10, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 11, "arabic": "تُؤْمِن", "translit": "nِmْwʾُt", "root": "امن"}, {"id": 12, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 13, "arabic": "بَلَىٰ", "translit": "ٰàَlَb", "root": ""}, {"id": 14, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 15, "arabic": "لِّيَطْمَئِنَّ", "translit": "َّnِyʾَmْṭَyِّl", "root": "طمان"}, {"id": 16, "arabic": "قَلْبِى", "translit": "àِbْlَq", "root": "قلب"}, {"id": 17, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 18, "arabic": "فَخُذْ", "translit": "ْhdُhkَf", "root": "اخذ"}, {"id": 19, "arabic": "أَرْبَعَةً", "translit": "ًẗَʿعَbْrَaʾ", "root": "ربع"}, {"id": 20, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 21, "arabic": "ٱلطَّيْرِ", "translit": "ِrْyَّṭlٱ", "root": "طير"}, {"id": 22, "arabic": "فَصُرْهُنَّ", "translit": "َّnُhْrُṣَf", "root": "صور"}, {"id": 23, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 24, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 25, "arabic": "ٱجْعَلْ", "translit": "ْlَʿعْjgٱ", "root": "جعل"}, {"id": 26, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 27, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 28, "arabic": "جَبَلٍ", "translit": "ٍlَbَjg", "root": "جبل"}, {"id": 29, "arabic": "مِّنْهُنَّ", "translit": "َّnُhْnِّm", "root": ""}, {"id": 30, "arabic": "جُزْءًا", "translit": "āًءْzُjg", "root": "جزا"}, {"id": 31, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 32, "arabic": "ٱدْعُهُنَّ", "translit": "َّnُhُʿعْdٱ", "root": "دعو"}, {"id": 33, "arabic": "يَأْتِينَكَ", "translit": "َkَnyِtْaʾَy", "root": "اتي"}, {"id": 34, "arabic": "سَعْيًا", "translit": "āًyْʿعَs", "root": "سعي"}, {"id": 35, "arabic": "وَٱعْلَمْ", "translit": "ْmَlْʿعٱَw", "root": "علم"}, {"id": 36, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 37, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 38, "arabic": "عَزِيزٌ", "translit": "ٌzyِzَʿع", "root": "عزز"}, {"id": 39, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": true}, {"ayah": 261, "text": "مَّثَلُ ٱلَّذِينَ يُنفِقُونَ أَمْوَٰلَهُمْ فِى سَبِيلِ ٱللَّهِ كَمَثَلِ حَبَّةٍ أَنۢبَتَتْ سَبْعَ سَنَابِلَ فِى كُلِّ سُنۢبُلَةٍ مِّا۟ئَةُ حَبَّةٍۗ وَٱللَّهُ يُضَٰعِفُ لِمَن يَشَآءُۗ وَٱللَّهُ وَٰسِعٌ عَلِيمٌ ", "translation": "The example of those who spend their wealth in the way of Allāh is like a seed [of grain] which grows seven spikes; in each spike is a hundred grains. And Allāh multiplies [His reward] for whom He wills. And Allāh is all-Encompassing and Knowing.", "words": [{"id": 1, "arabic": "مَّثَلُ", "translit": "ُlَhtَّm", "root": "مثل"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يُنفِقُونَ", "translit": "َnwُqِfnُy", "root": "نفق"}, {"id": 4, "arabic": "أَمْوَٰلَهُمْ", "translit": "ْmُhَlَٰwْmَaʾ", "root": "مول"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "كَمَثَلِ", "translit": "ِlَhtَmَk", "root": "مثل"}, {"id": 9, "arabic": "حَبَّةٍ", "translit": "ٍẗَّbَḥ", "root": "حبب"}, {"id": 10, "arabic": "أَنۢبَتَتْ", "translit": "ْtَtَbۢnَaʾ", "root": "نبت"}, {"id": 11, "arabic": "سَبْعَ", "translit": "َʿعْbَs", "root": "سبع"}, {"id": 12, "arabic": "سَنَابِلَ", "translit": "َlِbāَnَs", "root": "سنبل"}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 15, "arabic": "سُنۢبُلَةٍ", "translit": "ٍẗَlُbۢnُs", "root": "سنبل"}, {"id": 16, "arabic": "مِّا۟ئَةُ", "translit": "ُẗَyʾ۟āِّm", "root": "ماي"}, {"id": 17, "arabic": "حَبَّةٍ", "translit": "ٍẗَّbَḥ", "root": "حبب"}, {"id": 18, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 19, "arabic": "يُضَٰعِفُ", "translit": "ُfِʿعَٰḍُy", "root": "ضعف"}, {"id": 20, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 21, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 22, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 23, "arabic": "وَٰسِعٌ", "translit": "ٌʿعِsَٰw", "root": "وسع"}, {"id": 24, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 262, "text": "ٱلَّذِينَ يُنفِقُونَ أَمْوَٰلَهُمْ فِى سَبِيلِ ٱللَّهِ ثُمَّ لَا يُتْبِعُونَ مَآ أَنفَقُوا۟ مَنًّا وَلَآ أَذًىۙ لَّهُمْ أَجْرُهُمْ عِندَ رَبِّهِمْ وَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ ", "translation": "Those who spend their wealth in the way of Allāh and then do not follow up what they have spent with reminders [of it] or [other] injury will have their reward with their Lord, and there will be no fear concerning them, nor will they grieve.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يُنفِقُونَ", "translit": "َnwُqِfnُy", "root": "نفق"}, {"id": 3, "arabic": "أَمْوَٰلَهُمْ", "translit": "ْmُhَlَٰwْmَaʾ", "root": "مول"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "يُتْبِعُونَ", "translit": "َnwُʿعِbْtُy", "root": "تبع"}, {"id": 10, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 11, "arabic": "أَنفَقُوا۟", "translit": "۟āwُqَfnَaʾ", "root": "نفق"}, {"id": 12, "arabic": "مَنًّا", "translit": "āًّnَm", "root": "منن"}, {"id": 13, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 14, "arabic": "أَذًى", "translit": "àًhdَaʾ", "root": "اذي"}, {"id": 15, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 16, "arabic": "أَجْرُهُمْ", "translit": "ْmُhُrْjgَaʾ", "root": "اجر"}, {"id": 17, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 18, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 19, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 20, "arabic": "خَوْفٌ", "translit": "ٌfْwَhk", "root": "خوف"}, {"id": 21, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 22, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 23, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 24, "arabic": "يَحْزَنُونَ", "translit": "َnwُnَzْḥَy", "root": "حزن"}], "hasIhya": true}, {"ayah": 263, "text": "قَوْلٌ مَّعْرُوفٌ وَمَغْفِرَةٌ خَيْرٌ مِّن صَدَقَةٍ يَتْبَعُهَآ أَذًىۗ وَٱللَّهُ غَنِىٌّ حَلِيمٌ ", "translation": "Kind speech and forgiveness are better than charity followed by injury. And Allāh is Free of need and Forbearing.", "words": [{"id": 1, "arabic": "قَوْلٌ", "translit": "ٌlْwَq", "root": "قول"}, {"id": 2, "arabic": "مَّعْرُوفٌ", "translit": "ٌfwُrْʿعَّm", "root": "عرف"}, {"id": 3, "arabic": "وَمَغْفِرَةٌ", "translit": "ٌẗَrِfْغَmَw", "root": "غفر"}, {"id": 4, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "صَدَقَةٍ", "translit": "ٍẗَqَdَṣ", "root": "صدق"}, {"id": 7, "arabic": "يَتْبَعُهَآ", "translit": "ٓāَhُʿعَbْtَy", "root": "تبع"}, {"id": 8, "arabic": "أَذًى", "translit": "àًhdَaʾ", "root": "اذي"}, {"id": 9, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 10, "arabic": "غَنِىٌّ", "translit": "ٌّàِnَغ", "root": "غني"}, {"id": 11, "arabic": "حَلِيمٌ", "translit": "ٌmyِlَḥ", "root": "حلم"}], "hasIhya": false}, {"ayah": 264, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تُبْطِلُوا۟ صَدَقَٰتِكُم بِٱلْمَنِّ وَٱلْأَذَىٰ كَٱلَّذِى يُنفِقُ مَالَهُۥ رِئَآءَ ٱلنَّاسِ وَلَا يُؤْمِنُ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِۖ فَمَثَلُهُۥ كَمَثَلِ صَفْوَانٍ عَلَيْهِ تُرَابٌ فَأَصَابَهُۥ وَابِلٌ فَتَرَكَهُۥ صَلْدًاۖ لَّا يَقْدِرُونَ عَلَىٰ شَىْءٍ مِّمَّا كَسَبُوا۟ۗ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلْكَٰفِرِينَ ", "translation": "O you who have believed, do not invalidate your charities with reminders [of it] or injury as does one who spends his wealth [only] to be seen by the people and does not believe in Allāh and the Last Day. His example is like that of a [large] smooth stone upon which is dust and is hit by a downpour that leaves it bare. They are unable [to keep] anything of what they have earned. And Allāh does not guide the disbelieving people.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تُبْطِلُوا۟", "translit": "۟āwُlِṭْbُt", "root": "بطل"}, {"id": 6, "arabic": "صَدَقَٰتِكُم", "translit": "mُkِtَٰqَdَṣ", "root": "صدق"}, {"id": 7, "arabic": "بِٱلْمَنِّ", "translit": "ِّnَmْlٱِb", "root": "منن"}, {"id": 8, "arabic": "وَٱلْأَذَىٰ", "translit": "ٰàَhdَaʾْlٱَw", "root": "اذي"}, {"id": 9, "arabic": "كَٱلَّذِى", "translit": "àِhdَّlٱَk", "root": ""}, {"id": 10, "arabic": "يُنفِقُ", "translit": "ُqِfnُy", "root": "نفق"}, {"id": 11, "arabic": "مَالَهُۥ", "translit": "ۥُhَlāَm", "root": "مول"}, {"id": 12, "arabic": "رِئَآءَ", "translit": "َءٓāَyʾِr", "root": "راي"}, {"id": 13, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 14, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 15, "arabic": "يُؤْمِنُ", "translit": "ُnِmْwʾُy", "root": "امن"}, {"id": 16, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 17, "arabic": "وَٱلْيَوْمِ", "translit": "ِmْwَyْlٱَw", "root": "يوم"}, {"id": 18, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 19, "arabic": "فَمَثَلُهُۥ", "translit": "ۥُhُlَhtَmَf", "root": "مثل"}, {"id": 20, "arabic": "كَمَثَلِ", "translit": "ِlَhtَmَk", "root": "مثل"}, {"id": 21, "arabic": "صَفْوَانٍ", "translit": "ٍnāَwْfَṣ", "root": "صفو"}, {"id": 22, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 23, "arabic": "تُرَابٌ", "translit": "ٌbāَrُt", "root": "ترب"}, {"id": 24, "arabic": "فَأَصَابَهُۥ", "translit": "ۥُhَbāَṣَaʾَf", "root": "صوب"}, {"id": 25, "arabic": "وَابِلٌ", "translit": "ٌlِbāَw", "root": "وبل"}, {"id": 26, "arabic": "فَتَرَكَهُۥ", "translit": "ۥُhَkَrَtَf", "root": "ترك"}, {"id": 27, "arabic": "صَلْدًا", "translit": "āًdْlَṣ", "root": "صلد"}, {"id": 28, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 29, "arabic": "يَقْدِرُونَ", "translit": "َnwُrِdْqَy", "root": "قدر"}, {"id": 30, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 31, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 32, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 33, "arabic": "كَسَبُوا۟", "translit": "۟āwُbَsَk", "root": "كسب"}, {"id": 34, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 35, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 36, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 37, "arabic": "ٱلْقَوْمَ", "translit": "َmْwَqْlٱ", "root": "قوم"}, {"id": 38, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": true}, {"ayah": 265, "text": "وَمَثَلُ ٱلَّذِينَ يُنفِقُونَ أَمْوَٰلَهُمُ ٱبْتِغَآءَ مَرْضَاتِ ٱللَّهِ وَتَثْبِيتًا مِّنْ أَنفُسِهِمْ كَمَثَلِ جَنَّةٍۭ بِرَبْوَةٍ أَصَابَهَا وَابِلٌ فَـَٔاتَتْ أُكُلَهَا ضِعْفَيْنِ فَإِن لَّمْ يُصِبْهَا وَابِلٌ فَطَلٌّۗ وَٱللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ ", "translation": "And the example of those who spend their wealth seeking means to the approval of Allāh and assuring [reward for] themselves is like a garden on high ground which is hit by a downpour - so it yields its fruits in double. And [even] if it is not hit by a downpour, then a drizzle [is sufficient]. And Allāh, of what you do, is Seeing.", "words": [{"id": 1, "arabic": "وَمَثَلُ", "translit": "ُlَhtَmَw", "root": "مثل"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يُنفِقُونَ", "translit": "َnwُqِfnُy", "root": "نفق"}, {"id": 4, "arabic": "أَمْوَٰلَهُمُ", "translit": "ُmُhَlَٰwْmَaʾ", "root": "مول"}, {"id": 5, "arabic": "ٱبْتِغَآءَ", "translit": "َءٓāَغِtْbٱ", "root": "بغي"}, {"id": 6, "arabic": "مَرْضَاتِ", "translit": "ِtāَḍْrَm", "root": "رضو"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "وَتَثْبِيتًا", "translit": "āًtyِbْhtَtَw", "root": "ثبت"}, {"id": 9, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 10, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 11, "arabic": "كَمَثَلِ", "translit": "ِlَhtَmَk", "root": "مثل"}, {"id": 12, "arabic": "جَنَّةٍۭ", "translit": "ٍۭẗَّnَjg", "root": "جنن"}, {"id": 13, "arabic": "بِرَبْوَةٍ", "translit": "ٍẗَwْbَrِb", "root": "ربو"}, {"id": 14, "arabic": "أَصَابَهَا", "translit": "āَhَbāَṣَaʾ", "root": "صوب"}, {"id": 15, "arabic": "وَابِلٌ", "translit": "ٌlِbāَw", "root": "وبل"}, {"id": 16, "arabic": "فَـَٔاتَتْ", "translit": "ْtَtāَٔـَf", "root": "اتي"}, {"id": 17, "arabic": "أُكُلَهَا", "translit": "āَhَlُkُaʾ", "root": "اكل"}, {"id": 18, "arabic": "ضِعْفَيْنِ", "translit": "ِnْyَfْʿعِḍ", "root": "ضعف"}, {"id": 19, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 20, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 21, "arabic": "يُصِبْهَا", "translit": "āَhْbِṣُy", "root": "صوب"}, {"id": 22, "arabic": "وَابِلٌ", "translit": "ٌlِbāَw", "root": "وبل"}, {"id": 23, "arabic": "فَطَلٌّ", "translit": "ٌّlَṭَf", "root": "طلل"}, {"id": 24, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 25, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 26, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 27, "arabic": "بَصِيرٌ", "translit": "ٌryِṣَb", "root": "بصر"}], "hasIhya": false}, {"ayah": 266, "text": "أَيَوَدُّ أَحَدُكُمْ أَن تَكُونَ لَهُۥ جَنَّةٌ مِّن نَّخِيلٍ وَأَعْنَابٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ لَهُۥ فِيهَا مِن كُلِّ ٱلثَّمَرَٰتِ وَأَصَابَهُ ٱلْكِبَرُ وَلَهُۥ ذُرِّيَّةٌ ضُعَفَآءُ فَأَصَابَهَآ إِعْصَارٌ فِيهِ نَارٌ فَٱحْتَرَقَتْۗ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمُ ٱلْءَايَٰتِ لَعَلَّكُمْ تَتَفَكَّرُونَ ", "translation": "Would one of you like to have a garden of palm trees and grapevines underneath which rivers flow in which he has from every fruit? But he is afflicted with old age and has weak [i.e., immature] offspring, and it is hit by a whirlwind containing fire and is burned. Thus does Allāh make clear to you [His] verses that you might give thought.", "words": [{"id": 1, "arabic": "أَيَوَدُّ", "translit": "ُّdَwَyَaʾ", "root": "ودد"}, {"id": 2, "arabic": "أَحَدُكُمْ", "translit": "ْmُkُdَḥَaʾ", "root": "احد"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "تَكُونَ", "translit": "َnwُkَt", "root": "كون"}, {"id": 5, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 6, "arabic": "جَنَّةٌ", "translit": "ٌẗَّnَjg", "root": "جنن"}, {"id": 7, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 8, "arabic": "نَّخِيلٍ", "translit": "ٍlyِhkَّn", "root": "نخل"}, {"id": 9, "arabic": "وَأَعْنَابٍ", "translit": "ٍbāَnْʿعَaʾَw", "root": "عنب"}, {"id": 10, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 13, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 14, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 15, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 16, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 17, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 18, "arabic": "ٱلثَّمَرَٰتِ", "translit": "ِtَٰrَmَّhtlٱ", "root": "ثمر"}, {"id": 19, "arabic": "وَأَصَابَهُ", "translit": "ُhَbāَṣَaʾَw", "root": "صوب"}, {"id": 20, "arabic": "ٱلْكِبَرُ", "translit": "ُrَbِkْlٱ", "root": "كبر"}, {"id": 21, "arabic": "وَلَهُۥ", "translit": "ۥُhَlَw", "root": ""}, {"id": 22, "arabic": "ذُرِّيَّةٌ", "translit": "ٌẗَّyِّrُhd", "root": "ذرر"}, {"id": 23, "arabic": "ضُعَفَآءُ", "translit": "ُءٓāَfَʿعُḍ", "root": "ضعف"}, {"id": 24, "arabic": "فَأَصَابَهَآ", "translit": "ٓāَhَbāَṣَaʾَf", "root": "صوب"}, {"id": 25, "arabic": "إِعْصَارٌ", "translit": "ٌrāَṣْʿعِiʾ", "root": "عصر"}, {"id": 26, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 27, "arabic": "نَارٌ", "translit": "ٌrāَn", "root": "نور"}, {"id": 28, "arabic": "فَٱحْتَرَقَتْ", "translit": "ْtَqَrَtْḥٱَf", "root": "حرق"}, {"id": 29, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 30, "arabic": "يُبَيِّنُ", "translit": "ُnِّyَbُy", "root": "بين"}, {"id": 31, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 32, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 33, "arabic": "ٱلْءَايَٰتِ", "translit": "ِtَٰyāَءْlٱ", "root": "ايي"}, {"id": 34, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 35, "arabic": "تَتَفَكَّرُونَ", "translit": "َnwُrَّkَfَtَt", "root": "فكر"}], "hasIhya": false}, {"ayah": 267, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ أَنفِقُوا۟ مِن طَيِّبَٰتِ مَا كَسَبْتُمْ وَمِمَّآ أَخْرَجْنَا لَكُم مِّنَ ٱلْأَرْضِۖ وَلَا تَيَمَّمُوا۟ ٱلْخَبِيثَ مِنْهُ تُنفِقُونَ وَلَسْتُم بِـَٔاخِذِيهِ إِلَّآ أَن تُغْمِضُوا۟ فِيهِۚ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ غَنِىٌّ حَمِيدٌ ", "translation": "O you who have believed, spend from the good things which you have earned and from that which We have produced for you from the earth. And do not aim toward the defective therefrom, spending [from that] while you would not take it [yourself] except with closed eyes. And know that Allāh is Free of need and Praiseworthy.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "أَنفِقُوا۟", "translit": "۟āwُqِfnَaʾ", "root": "نفق"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "طَيِّبَٰتِ", "translit": "ِtَٰbِّyَṭ", "root": "طيب"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "كَسَبْتُمْ", "translit": "ْmُtْbَsَk", "root": "كسب"}, {"id": 9, "arabic": "وَمِمَّآ", "translit": "ٓāَّmِmَw", "root": ""}, {"id": 10, "arabic": "أَخْرَجْنَا", "translit": "āَnْjgَrْhkَaʾ", "root": "خرج"}, {"id": 11, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 12, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 13, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 14, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 15, "arabic": "تَيَمَّمُوا۟", "translit": "۟āwُmَّmَyَt", "root": "يمم"}, {"id": 16, "arabic": "ٱلْخَبِيثَ", "translit": "َhtyِbَhkْlٱ", "root": "خبث"}, {"id": 17, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 18, "arabic": "تُنفِقُونَ", "translit": "َnwُqِfnُt", "root": "نفق"}, {"id": 19, "arabic": "وَلَسْتُم", "translit": "mُtْsَlَw", "root": "ليس"}, {"id": 20, "arabic": "بِـَٔاخِذِيهِ", "translit": "ِhyِhdِhkāَٔـِb", "root": "اخذ"}, {"id": 21, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 22, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 23, "arabic": "تُغْمِضُوا۟", "translit": "۟āwُḍِmْغُt", "root": "غمض"}, {"id": 24, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 25, "arabic": "وَٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱَw", "root": "علم"}, {"id": 26, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 27, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 28, "arabic": "غَنِىٌّ", "translit": "ٌّàِnَغ", "root": "غني"}, {"id": 29, "arabic": "حَمِيدٌ", "translit": "ٌdyِmَḥ", "root": "حمد"}], "hasIhya": true}, {"ayah": 268, "text": "ٱلشَّيْطَٰنُ يَعِدُكُمُ ٱلْفَقْرَ وَيَأْمُرُكُم بِٱلْفَحْشَآءِۖ وَٱللَّهُ يَعِدُكُم مَّغْفِرَةً مِّنْهُ وَفَضْلًاۗ وَٱللَّهُ وَٰسِعٌ عَلِيمٌ ", "translation": "Satan threatens you with poverty and orders you to immorality, while Allāh promises you forgiveness from Him and bounty. And Allāh is all-Encompassing and Knowing.", "words": [{"id": 1, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 2, "arabic": "يَعِدُكُمُ", "translit": "ُmُkُdِʿعَy", "root": "وعد"}, {"id": 3, "arabic": "ٱلْفَقْرَ", "translit": "َrْqَfْlٱ", "root": "فقر"}, {"id": 4, "arabic": "وَيَأْمُرُكُم", "translit": "mُkُrُmْaʾَyَw", "root": "امر"}, {"id": 5, "arabic": "بِٱلْفَحْشَآءِ", "translit": "ِءٓāَhsْḥَfْlٱِb", "root": "فحش"}, {"id": 6, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 7, "arabic": "يَعِدُكُم", "translit": "mُkُdِʿعَy", "root": "وعد"}, {"id": 8, "arabic": "مَّغْفِرَةً", "translit": "ًẗَrِfْغَّm", "root": "غفر"}, {"id": 9, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 10, "arabic": "وَفَضْلًا", "translit": "āًlْḍَfَw", "root": "فضل"}, {"id": 11, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 12, "arabic": "وَٰسِعٌ", "translit": "ٌʿعِsَٰw", "root": "وسع"}, {"id": 13, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 269, "text": "يُؤْتِى ٱلْحِكْمَةَ مَن يَشَآءُۚ وَمَن يُؤْتَ ٱلْحِكْمَةَ فَقَدْ أُوتِىَ خَيْرًا كَثِيرًاۗ وَمَا يَذَّكَّرُ إِلَّآ أُو۟لُوا۟ ٱلْأَلْبَٰبِ ", "translation": "He gives wisdom[1] to whom He wills, and whoever has been given wisdom has certainly been given much good. And none will remember except those of understanding.", "words": [{"id": 1, "arabic": "يُؤْتِى", "translit": "àِtْwʾُy", "root": "اتي"}, {"id": 2, "arabic": "ٱلْحِكْمَةَ", "translit": "َẗَmْkِḥْlٱ", "root": "حكم"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 5, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 6, "arabic": "يُؤْتَ", "translit": "َtْwʾُy", "root": "اتي"}, {"id": 7, "arabic": "ٱلْحِكْمَةَ", "translit": "َẗَmْkِḥْlٱ", "root": "حكم"}, {"id": 8, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 9, "arabic": "أُوتِىَ", "translit": "َàِtwُaʾ", "root": "اتي"}, {"id": 10, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 11, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 12, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 13, "arabic": "يَذَّكَّرُ", "translit": "ُrَّkَّhdَy", "root": "ذكر"}, {"id": 14, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 15, "arabic": "أُو۟لُوا۟", "translit": "۟āwُl۟wُaʾ", "root": ""}, {"id": 16, "arabic": "ٱلْأَلْبَٰبِ", "translit": "ِbَٰbْlَaʾْlٱ", "root": "لبب"}], "hasIhya": true}, {"ayah": 270, "text": "وَمَآ أَنفَقْتُم مِّن نَّفَقَةٍ أَوْ نَذَرْتُم مِّن نَّذْرٍ فَإِنَّ ٱللَّهَ يَعْلَمُهُۥۗ وَمَا لِلظَّٰلِمِينَ مِنْ أَنصَارٍ ", "translation": "And whatever you spend of expenditures or make of vows - indeed, Allāh knows of it. And for the wrongdoers there are no helpers.", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَنفَقْتُم", "translit": "mُtْqَfnَaʾ", "root": "نفق"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "نَّفَقَةٍ", "translit": "ٍẗَqَfَّn", "root": "نفق"}, {"id": 5, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 6, "arabic": "نَذَرْتُم", "translit": "mُtْrَhdَn", "root": "نذر"}, {"id": 7, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 8, "arabic": "نَّذْرٍ", "translit": "ٍrْhdَّn", "root": "نذر"}, {"id": 9, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "يَعْلَمُهُۥ", "translit": "ۥُhُmَlْʿعَy", "root": "علم"}, {"id": 12, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 13, "arabic": "لِلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlِl", "root": "ظلم"}, {"id": 14, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 15, "arabic": "أَنصَارٍ", "translit": "ٍrāَṣnَaʾ", "root": "نصر"}], "hasIhya": false}, {"ayah": 271, "text": "إِن تُبْدُوا۟ ٱلصَّدَقَٰتِ فَنِعِمَّا هِىَۖ وَإِن تُخْفُوهَا وَتُؤْتُوهَا ٱلْفُقَرَآءَ فَهُوَ خَيْرٌ لَّكُمْۚ وَيُكَفِّرُ عَنكُم مِّن سَيِّـَٔاتِكُمْۗ وَٱللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ ", "translation": "If you disclose your charitable expenditures, they are good; but if you conceal them and give them to the poor, it is better for you, and He will remove from you some of your misdeeds [thereby]. And Allāh, of what you do, is [fully] Aware.", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "تُبْدُوا۟", "translit": "۟āwُdْbُt", "root": "بدو"}, {"id": 3, "arabic": "ٱلصَّدَقَٰتِ", "translit": "ِtَٰqَdَّṣlٱ", "root": "صدق"}, {"id": 4, "arabic": "فَنِعِمَّا", "translit": "āَّmِʿعِnَf", "root": "نعم"}, {"id": 5, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 6, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 7, "arabic": "تُخْفُوهَا", "translit": "āَhwُfْhkُt", "root": "خفي"}, {"id": 8, "arabic": "وَتُؤْتُوهَا", "translit": "āَhwُtْwʾُtَw", "root": "اتي"}, {"id": 9, "arabic": "ٱلْفُقَرَآءَ", "translit": "َءٓāَrَqُfْlٱ", "root": "فقر"}, {"id": 10, "arabic": "فَهُوَ", "translit": "َwُhَf", "root": ""}, {"id": 11, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 12, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 13, "arabic": "وَيُكَفِّرُ", "translit": "ُrِّfَkُyَw", "root": "كفر"}, {"id": 14, "arabic": "عَنكُم", "translit": "mُknَʿع", "root": ""}, {"id": 15, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 16, "arabic": "سَيِّـَٔاتِكُمْ", "translit": "ْmُkِtāَٔـِّyَs", "root": "سوا"}, {"id": 17, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 18, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 19, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 20, "arabic": "خَبِيرٌ", "translit": "ٌryِbَhk", "root": "خبر"}], "hasIhya": true}, {"ayah": 272, "text": "لَّيْسَ عَلَيْكَ هُدَىٰهُمْ وَلَٰكِنَّ ٱللَّهَ يَهْدِى مَن يَشَآءُۗ وَمَا تُنفِقُوا۟ مِنْ خَيْرٍ فَلِأَنفُسِكُمْۚ وَمَا تُنفِقُونَ إِلَّا ٱبْتِغَآءَ وَجْهِ ٱللَّهِۚ وَمَا تُنفِقُوا۟ مِنْ خَيْرٍ يُوَفَّ إِلَيْكُمْ وَأَنتُمْ لَا تُظْلَمُونَ ", "translation": "Not upon you, [O Muḥammad], is [responsibility for] their guidance, but Allāh guides whom He wills. And whatever good you [believers] spend is for yourselves, and you do not spend except seeking the face [i.e., approval] of Allāh. And whatever you spend of good[1] - it will be fully repaid to you, and you will not be wronged.", "words": [{"id": 1, "arabic": "لَّيْسَ", "translit": "َsْyَّl", "root": "ليس"}, {"id": 2, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 3, "arabic": "هُدَىٰهُمْ", "translit": "ْmُhٰàَdُh", "root": "هدي"}, {"id": 4, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 7, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 8, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "تُنفِقُوا۟", "translit": "۟āwُqِfnُt", "root": "نفق"}, {"id": 11, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 12, "arabic": "خَيْرٍ", "translit": "ٍrْyَhk", "root": "خير"}, {"id": 13, "arabic": "فَلِأَنفُسِكُمْ", "translit": "ْmُkِsُfnَaʾِlَf", "root": "نفس"}, {"id": 14, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 15, "arabic": "تُنفِقُونَ", "translit": "َnwُqِfnُt", "root": "نفق"}, {"id": 16, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 17, "arabic": "ٱبْتِغَآءَ", "translit": "َءٓāَغِtْbٱ", "root": "بغي"}, {"id": 18, "arabic": "وَجْهِ", "translit": "ِhْjgَw", "root": "وجه"}, {"id": 19, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 21, "arabic": "تُنفِقُوا۟", "translit": "۟āwُqِfnُt", "root": "نفق"}, {"id": 22, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 23, "arabic": "خَيْرٍ", "translit": "ٍrْyَhk", "root": "خير"}, {"id": 24, "arabic": "يُوَفَّ", "translit": "َّfَwُy", "root": "وفي"}, {"id": 25, "arabic": "إِلَيْكُمْ", "translit": "ْmُkْyَlِiʾ", "root": ""}, {"id": 26, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 27, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 28, "arabic": "تُظْلَمُونَ", "translit": "َnwُmَlْẓُt", "root": "ظلم"}], "hasIhya": false}, {"ayah": 273, "text": "لِلْفُقَرَآءِ ٱلَّذِينَ أُحْصِرُوا۟ فِى سَبِيلِ ٱللَّهِ لَا يَسْتَطِيعُونَ ضَرْبًا فِى ٱلْأَرْضِ يَحْسَبُهُمُ ٱلْجَاهِلُ أَغْنِيَآءَ مِنَ ٱلتَّعَفُّفِ تَعْرِفُهُم بِسِيمَٰهُمْ لَا يَسْـَٔلُونَ ٱلنَّاسَ إِلْحَافًاۗ وَمَا تُنفِقُوا۟ مِنْ خَيْرٍ فَإِنَّ ٱللَّهَ بِهِۦ عَلِيمٌ ", "translation": "[Charity is] for the poor who have been restricted for the cause of Allāh, unable to move about in the land. An ignorant [person] would think them self-sufficient because of their restraint, but you will know them by their [characteristic] sign. They do not ask people persistently [or at all]. And whatever you spend of good - indeed, Allāh is Knowing of it.", "words": [{"id": 1, "arabic": "لِلْفُقَرَآءِ", "translit": "ِءٓāَrَqُfْlِl", "root": "فقر"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "أُحْصِرُوا۟", "translit": "۟āwُrِṣْḥُaʾ", "root": "حصر"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يَسْتَطِيعُونَ", "translit": "َnwُʿعyِṭَtْsَy", "root": "طوع"}, {"id": 9, "arabic": "ضَرْبًا", "translit": "āًbْrَḍ", "root": "ضرب"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 12, "arabic": "يَحْسَبُهُمُ", "translit": "ُmُhُbَsْḥَy", "root": "حسب"}, {"id": 13, "arabic": "ٱلْجَاهِلُ", "translit": "ُlِhāَjgْlٱ", "root": "جهل"}, {"id": 14, "arabic": "أَغْنِيَآءَ", "translit": "َءٓāَyِnْغَaʾ", "root": "غني"}, {"id": 15, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 16, "arabic": "ٱلتَّعَفُّفِ", "translit": "ِfُّfَʿعَّtlٱ", "root": "عفف"}, {"id": 17, "arabic": "تَعْرِفُهُم", "translit": "mُhُfِrْʿعَt", "root": "عرف"}, {"id": 18, "arabic": "بِسِيمَٰهُمْ", "translit": "ْmُhَٰmyِsِb", "root": "سوم"}, {"id": 19, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 20, "arabic": "يَسْـَٔلُونَ", "translit": "َnwُlَٔـْsَy", "root": "سال"}, {"id": 21, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 22, "arabic": "إِلْحَافًا", "translit": "āًfāَḥْlِiʾ", "root": "لحف"}, {"id": 23, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 24, "arabic": "تُنفِقُوا۟", "translit": "۟āwُqِfnُt", "root": "نفق"}, {"id": 25, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 26, "arabic": "خَيْرٍ", "translit": "ٍrْyَhk", "root": "خير"}, {"id": 27, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 28, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 29, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 30, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 274, "text": "ٱلَّذِينَ يُنفِقُونَ أَمْوَٰلَهُم بِٱلَّيْلِ وَٱلنَّهَارِ سِرًّا وَعَلَانِيَةً فَلَهُمْ أَجْرُهُمْ عِندَ رَبِّهِمْ وَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ ", "translation": "Those who spend their wealth [in Allāh's way] by night and by day, secretly and publicly - they will have their reward with their Lord. And no fear will there be concerning them, nor will they grieve.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يُنفِقُونَ", "translit": "َnwُqِfnُy", "root": "نفق"}, {"id": 3, "arabic": "أَمْوَٰلَهُم", "translit": "mُhَlَٰwْmَaʾ", "root": "مول"}, {"id": 4, "arabic": "بِٱلَّيْلِ", "translit": "ِlْyَّlٱِb", "root": "ليل"}, {"id": 5, "arabic": "وَٱلنَّهَارِ", "translit": "ِrāَhَّnlٱَw", "root": "نهر"}, {"id": 6, "arabic": "سِرًّا", "translit": "āًّrِs", "root": "سرر"}, {"id": 7, "arabic": "وَعَلَانِيَةً", "translit": "ًẗَyِnāَlَʿعَw", "root": "علن"}, {"id": 8, "arabic": "فَلَهُمْ", "translit": "ْmُhَlَf", "root": ""}, {"id": 9, "arabic": "أَجْرُهُمْ", "translit": "ْmُhُrْjgَaʾ", "root": "اجر"}, {"id": 10, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 11, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "خَوْفٌ", "translit": "ٌfْwَhk", "root": "خوف"}, {"id": 14, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 15, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 16, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 17, "arabic": "يَحْزَنُونَ", "translit": "َnwُnَzْḥَy", "root": "حزن"}], "hasIhya": false}, {"ayah": 275, "text": "ٱلَّذِينَ يَأْكُلُونَ ٱلرِّبَوٰا۟ لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ ٱلَّذِى يَتَخَبَّطُهُ ٱلشَّيْطَٰنُ مِنَ ٱلْمَسِّۚ ذَٰلِكَ بِأَنَّهُمْ قَالُوٓا۟ إِنَّمَا ٱلْبَيْعُ مِثْلُ ٱلرِّبَوٰا۟ۗ وَأَحَلَّ ٱللَّهُ ٱلْبَيْعَ وَحَرَّمَ ٱلرِّبَوٰا۟ۚ فَمَن جَآءَهُۥ مَوْعِظَةٌ مِّن رَّبِّهِۦ فَٱنتَهَىٰ فَلَهُۥ مَا سَلَفَ وَأَمْرُهُۥٓ إِلَى ٱللَّهِۖ وَمَنْ عَادَ فَأُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلنَّارِۖ هُمْ فِيهَا خَٰلِدُونَ ", "translation": "Those who consume interest[1] cannot stand [on the Day of Resurrection] except as one stands who is being beaten by Satan into insanity. That is because they say, \"Trade is [just] like interest.\" But Allāh has permitted trade and has forbidden interest. So whoever has received an admonition from his Lord and desists may have what is past, and his affair rests with Allāh. But whoever returns [to dealing in interest or usury] - those are the companions of the Fire; they will abide eternally therein.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يَأْكُلُونَ", "translit": "َnwُlُkْaʾَy", "root": "اكل"}, {"id": 3, "arabic": "ٱلرِّبَوٰا۟", "translit": "۟āٰwَbِّrlٱ", "root": "ربو"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "يَقُومُونَ", "translit": "َnwُmwُqَy", "root": "قوم"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 8, "arabic": "يَقُومُ", "translit": "ُmwُqَy", "root": "قوم"}, {"id": 9, "arabic": "ٱلَّذِى", "tran