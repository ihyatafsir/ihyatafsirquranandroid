لْحَقُّ سَفِيهاً اَوْ ضَعِيفاً اَوْ لَا يَسْتَطِيعُ أَنْ يُّمِلَّ هُوَ فَلْيُمْلِلْ وَلِيُّهُۥ بِالْعَدْلِۖ وَاسْتَشْهِدُواْ شَهِيدَيْنِ مِن رِّجَالِكُمْۖ فَإِن لَّمْ يَكُونَا رَجُلَيْنِ فَرَجُلࣱ وَامْرَأَتَٰنِ مِمَّن تَرْضَوْنَ مِنَ اَ۬لشُّهَدَآءِ اَ۬ن تَضِلَّ إِحْد۪يٰهُمَا فَتُذَكِّرَ إِحْد۪يٰهُمَا اَ۬لُاخْر۪يٰۖ وَلَا يَابَ اَ۬لشُّهَدَآءُ اِ۪ذَا مَا دُعُواْۖ وَلَا تَسْـَٔمُوٓاْ أَن تَكْتُبُوهُ صَغِيراً اَوْ كَبِيراً اِلَيٰٓ أَجَلِهِۦۖ ذَٰلِكُمُۥٓ أَقْسَطُ عِندَ اَ۬للَّهِ وَأَقْوَمُ لِلشَّهَٰدَةِ وَأَدْن۪يٰٓ أَلَّا تَرْتَابُوٓاْ إِلَّآ أَن تَكُونَ تِجَٰرَةٌ حَاضِرَةࣱ تُدِيرُونَهَا بَيْنَكُمْ فَلَيْسَ عَلَيْكُمْ جُنَاحٌ اَلَّا تَكْتُبُوهَاۖ وَأَشْهِدُوٓاْ إِذَا تَبَايَعْتُمْۖ وَلَا يُضَآرَّ كَاتِبࣱ وَلَا شَهِيدࣱۖ وَإِن تَفْعَلُواْ فَإِنَّهُۥ فُسُوقُۢ بِكُمْۖ وَاتَّقُواْ اُ۬للَّهَۖ وَيُعَلِّمُكُمُ اُ۬للَّهُۖ وَاللَّهُ بِكُلِّ شَےْءٍ عَلِيمࣱۖ", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓاْ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 5, "arabic": "تَدَايَنتُم", "translit": "", "root": ""}, {"id": 6, "arabic": "بِدَيْنٍ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِلَيٰٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَجَلࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "مُّسَمّيࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَاكْتُبُوهُۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَلْيَكْتُب", "translit": "", "root": ""}, {"id": 12, "arabic": "بَّيْنَكُمْ", "translit": "", "root": ""}, {"id": 13, "arabic": "كَاتِبُۢ", "translit": "", "root": ""}, {"id": 14, "arabic": "بِالْعَدْلِۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 16, "arabic": "يَابَ", "translit": "", "root": ""}, {"id": 17, "arabic": "كَاتِبٌ", "translit": "", "root": ""}, {"id": 18, "arabic": "اَنْ", "translit": "", "root":