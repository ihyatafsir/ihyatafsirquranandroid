 "arabic": "أَنتَ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِنِعْمَتِ", "translit": "", "root": ""}, {"id": 5, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِكَاهِنࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 8, "arabic": "مَجْنُونٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 30, "text": "اَمْ يَقُولُونَ شَاعِرࣱ نَّتَرَبَّصُ بِهِۦ رَيْبَ اَ۬لْمَنُونِۖ", "words": [{"id": 1, "arabic": "اَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَقُولُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "شَاعِرࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "نَّتَرَبَّصُ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "رَيْبَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْمَنُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 31, "text": "قُلْ تَرَبَّصُواْۖ فَإِنِّے مَعَكُم مِّنَ اَ۬لْمُتَرَبِّصِينَۖ", "words": [{"id": 1, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَرَبَّصُواْۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَإِنِّے", "translit": "", "root": ""}, {"id": 4, "arabic": "مَعَكُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْمُتَرَبِّصِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 32, "text": "أَمْ تَامُرُهُمُۥٓ أَحْلَٰمُهُم بِهَٰذَآ أَمْ هُمْ قَوْمࣱ طَاغُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَامُرُهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَحْلَٰمُهُم", "translit": "", "root": ""}, {"id": 4, "arabic": "بِهَٰذَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَوْمࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "طَاغُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 33, "text": "أَمْ يَقُولُونَ تَقَوَّلَهُۥۖ بَل لَّا يُومِنُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَقُولُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "تَقَوَّلَهُۥۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "بَل", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "يُومِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 34, "text": "فَلْيَاتُواْ بِحَدِيثࣲ مِّثْلِهِۦٓ إِن كَانُواْ صَٰدِقِينَۖ", "words": [{"id": 1, "arabic": "فَلْيَاتُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِحَدِيثࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّثْلِهِۦٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِن", "translit": "", "root": ""}, {"id": 5, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "صَٰدِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 35, "text": "أَمْ خُلِقُواْ مِنْ غَيْرِ شَےْءٍ اَمْ هُمُ اُ۬لْخَٰلِقُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خُلِقُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 4, "arabic": "غَيْرِ", "translit": "", "root": ""}, {"id": 5, "arabic": "شَےْءٍ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لْخَٰلِقُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 36, "text": "أَمْ خَلَقُواْ اُ۬لسَّمَٰوَٰتِ وَالَارْضَۖ بَل لَّا يُوقِنُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالَارْضَۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَل", "translit": "", "root": ""}, {"id": 6, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "يُوقِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 37, "text": "أَمْ عِندَهُمْ خَزَآئِنُ رَبِّكَ أَمْ هُمُ اُ۬لْمُصَيْطِرُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عِندَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "خَزَآئِنُ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْمُصَيْطِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 38, "text": "أَمْ لَهُمْ سُلَّمࣱ يَسْتَمِعُونَ فِيهِۖ فَلْيَاتِ مُسْتَمِعُهُم بِسُلْطَٰنࣲ مُّبِينٍۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "سُلَّمࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَسْتَمِعُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِيهِۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَلْيَاتِ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُسْتَمِعُهُم", "translit": "", "root": ""}, {"id": 8, "arabic": "بِسُلْطَٰنࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "مُّبِينٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 39, "text": "اَمْ لَهُ اُ۬لْبَنَٰتُ وَلَكُمُ اُ۬لْبَنُونَۖ", "words": [{"id": 1, "arabic": "اَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْبَنَٰتُ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَلَكُمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْبَنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 40, "text": "أَمْ تَسْـَٔلُهُمُۥٓ أَجْراࣰ فَهُم مِّن مَّغْرَمࣲ مُّثْقَلُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَسْـَٔلُهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَجْراࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَهُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 6, "arabic": "مَّغْرَمࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّثْقَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 41, "text": "أَمْ عِندَهُمُ اُ۬لْغَيْبُ فَهُمْ يَكْتُبُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عِندَهُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْغَيْبُ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَكْتُبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 42, "text": "أَمْ يُرِيدُونَ كَيْداࣰۖ فَالذِينَ كَفَرُواْ هُمُ اُ۬لْمَكِيدُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يُرِيدُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَيْداࣰۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَالذِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْمَكِيدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 43, "text": "أَمْ لَهُمُۥٓ إِلَٰهٌ غَيْرُ اُ۬للَّهِۖ سُبْحَٰنَ اَ۬للَّهِ عَمَّا يُشْرِكُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَٰهٌ", "translit": "", "root": ""}, {"id": 4, "arabic": "غَيْرُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "سُبْحَٰنَ", "translit":