{"id": 5, "arabic": "عَذَابَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لسَّمُومِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 28, "text": "إِنَّا كُنَّا مِن قَبْلُ نَدْعُوهُ أَنَّهُۥ هُوَ اَ۬لْبَرُّ اُ۬لرَّحِيمُۖ", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَبْلُ", "translit": "", "root": ""}, {"id": 5, "arabic": "نَدْعُوهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَنَّهُۥ", "translit": "", "root": ""}, {"id": 7, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لْبَرُّ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬لرَّحِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 29, "text": "فَذَكِّرْ فَمَآ أَنتَ بِنِعْمَتِ رَبِّكَ بِكَاهِنࣲ وَلَا مَجْنُونٍۖ", "words": [{"id": 1, "arabic": "فَذَكِّرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَمَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنتَ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِنِعْمَتِ", "translit": "", "root": ""}, {"id": 5, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِكَاهِنࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 8, "arabic": "مَجْنُونٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 30, "text": "اَمْ يَقُولُونَ شَاعِرࣱ نَّتَرَبَّصُ بِهِۦ رَيْبَ اَ۬لْمَنُونِۖ", "words": [{"id": 1, "arabic": "اَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَقُولُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "شَاعِرࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "نَّتَرَبَّصُ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "رَيْبَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْمَنُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 31, "text": "قُلْ تَرَبَّصُواْۖ فَإِنِّے مَعَكُم مِّنَ اَ۬لْمُتَرَبِّصِينَۖ", "words": [{"id": 1, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَرَبَّصُواْۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَإِنِّے", "translit": "", "root": ""}, {"id": 4, "arabic": "مَعَكُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْمُتَرَبِّصِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 32, "text": "أَمْ تَامُرُهُمُۥٓ أَحْلَٰمُهُم بِهَٰذَآ أَمْ هُمْ قَوْمࣱ طَاغُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَامُرُهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَحْلَٰمُهُم", "translit": "", "root": ""}, {"id": 4, "arabic": "بِهَٰذَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَوْمࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "طَاغُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 33, "text": "أَمْ يَقُولُونَ تَقَوَّلَهُۥۖ بَل لَّا يُومِنُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَقُولُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "تَقَوَّلَهُۥۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "بَل", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "يُومِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 34, "text": "فَلْيَاتُواْ بِحَدِيثࣲ مِّثْلِهِۦٓ إِن كَانُواْ صَٰدِقِينَۖ", "words": [{"id": 1, "arabic": "فَلْيَاتُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِحَدِيثࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّثْلِهِۦٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِن", "translit": "