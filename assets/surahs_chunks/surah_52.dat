bic": "وَلَا", "translit": "", "root": ""}, {"id": 8, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "يُنصَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 47, "text": "وَإِنَّ لِلذِينَ ظَلَمُواْ عَذَاباࣰ دُونَ ذَٰلِكَۖ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِلذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ظَلَمُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَذَاباࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "دُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "ذَٰلِكَۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَٰكِنَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَكْثَرَهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَا", "translit": "", "root": ""}, {"id": 10, "arabic": "يَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 48, "text": "وَاصْبِرْ لِحُكْمِ رَبِّكَ فَإِنَّكَ بِأَعْيُنِنَاۖ وَسَبِّحْ بِحَمْدِ رَبِّكَ حِينَ تَقُومُۖ", "words": [{"id": 1, "arabic": "وَاصْبِرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِحُكْمِ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَإِنَّكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِأَعْيُنِنَاۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَسَبِّحْ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِحَمْدِ", "translit": "", "root": ""}, {"id": 8, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 9, "arabic": "حِينَ", "translit": "", "root": ""}, {"id": 10, "arabic": "تَقُومُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 49, "text": "وَمِنَ اَ۬ليْلِ فَسَبِّحْهُ وَإِدْبَٰرَ اَ۬لنُّجُومِۖ", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬ليْلِ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَسَ