{"surah":52,"verses":[{"ayah":1,"text":"وَٱلطُّورِ ","translation":"By the mount","words":[{"id":1,"arabic":"وَٱلطُّورِ","translit":"ِrwُّṭlٱَw","root":"طور"}],"hasIhya":false},{"ayah":2,"text":"وَكِتَٰبٍ مَّسْطُورٍ ","translation":"And [by] a Book inscribed[1]","words":[{"id":1,"arabic":"وَكِتَٰبٍ","translit":"ٍbَٰtِkَw","root":"كتب"},{"id":2,"arabic":"مَّسْطُورٍ","translit":"ٍrwُṭْsَّm","root":"سطر"}],"hasIhya":false},{"ayah":3,"text":"فِى رَقٍّ مَّنشُورٍ ","translation":"In parchment spread open","words":[{"id":1,"arabic":"فِى","translit":"àِf","root":""},{"id":2,"arabic":"رَقٍّ","translit":"ٍّqَr","root":"رقق"},{"id":3,"arabic":"مَّنشُورٍ","translit":"ٍrwُhsnَّm","root":"نشر"}],"hasIhya":false},{"ayah":4,"text":"وَٱلْبَيْتِ ٱلْمَعْمُورِ ","translation":"And [by] the frequented House[1]","words":[{"id":1,"arabic":"وَٱلْبَيْتِ","translit":"ِtْyَbْlٱَw","root":"بيت"},{"id":2,"arabic":"ٱلْمَعْمُورِ","translit":"ِrwُmْʿعَmْlٱ","root":"عمر"}],"hasIhya":false},{"ayah":5,"text":"وَٱلسَّقْفِ ٱلْمَرْفُوعِ ","translation":"And [by] the ceiling [i.e., heaven] raised high","words":[{"id":1,"arabic":"وَٱلسَّقْفِ","translit":"ِfْqَّslٱَw","root":"سقف"},{"id":2,"arabic":"ٱلْمَرْفُوعِ","translit":"ِʿعwُfْrَmْlٱ","root":"رفع"}],"hasIhya":false},{"ayah":6,"text":"وَٱلْبَحْرِ ٱلْمَسْجُورِ ","translation":"And [by] the sea set on fire,[1]","words":[{"id":1,"arabic":"وَٱلْبَحْرِ","translit":"ِrْḥَbْlٱَw","root":"بحر"},{"id":2,"arabic":"ٱلْمَسْجُورِ","translit":"ِrwُjgْsَmْlٱ","root":"سجر"}],"hasIhya":false},{"ayah":7,"text":"إِنَّ عَذَابَ رَبِّكَ لَوَٰقِعٌ ","translation":"Indeed, the punishment of your Lord will occur.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"عَذَابَ","translit":"َbāَhdَʿع","root":"عذب"},{"id":3,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":4,"arabic":"لَوَٰقِعٌ","translit":"ٌʿعِqَٰwَl","root":"وقع"}],"hasIhya":true},{"ayah":8,"text":"مَّا لَهُۥ مِن دَافِعٍ ","translation":"Of it there is no preventer.","words":[{"id":1,"arabic":"مَّا","translit":"āَّm","root":""},{"id":2,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"دَافِعٍ","translit":"ٍʿعِfāَd","root":"دفع"}],"hasIhya":false},{"ayah":9,"text":"يَوْمَ تَمُورُ ٱلسَّمَآءُ مَوْرًا ","translation":"On the Day the heaven will sway with circular motion","words":[{"id":1,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":2,"arabic":"تَمُورُ","translit":"ُrwُmَt","root":"مور"},{"id":3,"arabic":"ٱلسَّمَآءُ","translit":"ُءٓāَmَّslٱ","root":"سمو"},{"id":4,"arabic":"مَوْرًا","translit":"āًrْwَm","root":"مور"}],"hasIhya":false},{"ayah":10,"text":"وَتَسِيرُ ٱلْجِبَالُ سَيْرًا ","translation":"And the mountains will pass on, departing[1] -","words":[{"id":1,"arabic":"وَتَسِيرُ","translit":"ُryِsَtَw","root":"سير"},{"id":2,"arabic":"ٱلْجِبَالُ","translit":"ُlāَbِjgْlٱ","root":"جبل"},{"id":3,"arabic":"سَيْرًا","translit":"āًrْyَs","root":"سير"}],"hasIhya":false},{"ayah":11,"text":"فَوَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ ","translation":"Then woe, that Day, to the deniers,","words":[{"id":1,"arabic":"فَوَيْلٌ","translit":"ٌlْyَwَf","root":""},{"id":2,"arabic":"يَوْمَئِذٍ","translit":"ٍhdِyʾَmْwَy","root":"يوم"},{"id":3,"arabic":"لِّلْمُكَذِّبِينَ","translit":"َnyِbِّhdَkُmْlِّl","root":"كذب"}],"hasIhya":false},{"ayah":12,"text":"ٱلَّذِينَ هُمْ فِى خَوْضٍ يَلْعَبُونَ ","translation":"Who are in [empty] discourse amusing themselves.","words":[{"id":1,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":2,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"خَوْضٍ","translit":"ٍḍْwَhk","root":"خوض"},{"id":5,"arabic":"يَلْعَبُونَ","translit":"َnwُbَʿعْlَy","root":"لعب"}],"hasIhya":false},{"ayah":13,"text":"يَوْمَ يُدَعُّونَ إِلَىٰ نَارِ جَهَنَّمَ دَعًّا ","translation":"The Day they are thrust toward the fire of Hell with a [violent] thrust, [its angels will say],","words":[{"id":1,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":2,"arabic":"يُدَعُّونَ","translit":"َnwُّʿعَdُy","root":"دعع"},{"id":3,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":4,"arabic":"نَارِ","translit":"ِrāَn","root":"نور"},{"id":5,"arabic":"جَهَنَّمَ","translit":"َmَّnَhَjg","root":""},{"id":6,"arabic":"دَعًّا","translit":"āًّʿعَd","root":"دعع"}],"hasIhya":true},{"ayah":14,"text":"هَٰذِهِ ٱلنَّارُ ٱلَّتِى كُنتُم بِهَا تُكَذِّبُونَ ","translation":"\"This is the Fire which you used to deny.","words":[{"id":1,"arabic":"هَٰذِهِ","translit":"ِhِhdَٰh","root":""},{"id":2,"arabic":"ٱلنَّارُ","translit":"ُrāَّnlٱ","root":"نور"},{"id":3,"arabic":"ٱلَّتِى","translit":"àِtَّlٱ","root":""},{"id":4,"arabic":"كُنتُم","translit":"mُtnُk","root":"كون"},{"id":5,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":6,"arabic":"تُكَذِّبُونَ","translit":"َnwُbِّhdَkُt","root":"كذب"}],"hasIhya":false},{"ayah":15,"text":"أَفَسِحْرٌ هَٰذَآ أَمْ أَنتُمْ لَا تُبْصِرُونَ ","translation":"Then is this magic, or do you not see?","words":[{"id":1,"arabic":"أَفَسِحْرٌ","translit":"ٌrْḥِsَfَaʾ","root":"سحر"},{"id":2,"arabic":"هَٰذَآ","translit":"ٓāَhdَٰh","root":""},{"id":3,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":4,"arabic":"أَنتُمْ","translit":"ْmُtnَaʾ","root":""},{"id":5,"arabic":"لَا","translit":"āَl","root":""},{"id":6,"arabic":"تُبْصِرُونَ","translit":"َnwُrِṣْbُt","root":"بصر"}],"hasIhya":true},{"ayah":16,"text":"ٱصْلَوْهَا فَٱصْبِرُوٓا۟ أَوْ لَا تَصْبِرُوا۟ سَوَآءٌ عَلَيْكُمْۖ إِنَّمَا تُجْزَوْنَ مَا كُنتُمْ تَعْمَلُونَ ","translation":"[Enter to] burn therein; then be patient or impatient - it is all the same for you. You are only being recompensed [for] what you used to do.\"","words":[{"id":1,"arabic":"ٱصْلَوْهَا","translit":"āَhْwَlْṣٱ","root":"صلي"},{"id":2,"arabic":"فَٱصْبِرُوٓا۟","translit":"۟āٓwُrِbْṣٱَf","root":"صبر"},{"id":3,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"تَصْبِرُوا۟","translit":"۟