 "text": "وَالذِينَ ءَامَنُواْ وَاتَّبَعَتْهُمْ ذُرِّيَّتُهُم بِإِيمَٰنٍ اَلْحَقْنَا بِهِمْ ذُرِّيَّٰتِهِمْ وَمَآ أَلَتْنَٰهُم مِّنْ عَمَلِهِم مِّن شَےْءࣲۖ كُلُّ اُ۪مْرِےِٕۢ بِمَا كَسَبَ رَهِينࣱۖ", "words": [{"id": 1, "arabic": "وَالذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَاتَّبَعَتْهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "ذُرِّيَّتُهُم", "translit": "", "root": ""}, {"id": 5, "arabic": "بِإِيمَٰنٍ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَلْحَقْنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهِمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "ذُرِّيَّٰتِهِمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَلَتْنَٰهُم", "translit": "", "root": ""}, {"id": 11, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 12, "arabic": "عَمَلِهِم", "translit": "", "root": ""}, {"id": 13, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 14, "arabic": "شَےْءࣲۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "كُلُّ", "translit": "", "root": ""}, {"id": 16, "arabic": "اُ۪مْرِےِٕۢ", "translit": "", "root": ""}, {"id": 17, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 18, "arabic": "كَسَبَ", "translit": "", "root": ""}, {"id": 19, "arabic": "رَهِينࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 22, "text": "وَأَمْدَدْنَٰهُم بِفَٰكِهَةࣲ وَلَحْمࣲ مِّمَّا يَشْتَهُونَ", "words": [{"id": 1, "arabic": "وَأَمْدَدْنَٰهُم", "translit": "", "root": ""}, {"id": 2, "arabic": "بِفَٰكِهَةࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَلَحْمࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّمَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "يَشْتَهُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 23, "text": "يَتَنَٰزَعُونَ فِيهَا كَأْساࣰ لَّا لَغْوࣱ فِيهَا وَلَا تَاثِيمࣱۖ", "words": [{"id": 1, "arabic": "يَتَنَٰزَعُونَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "كَأْساࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "لَغْوࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 8, "arabic": "تَاثِيمࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 24, "text": "۞وَيَطُوفُ عَلَيْهِمْ غِلْمَانࣱ لَّهُمْ كَأَنَّهُمْ لُؤْلُؤࣱ مَّكْنُونࣱۖ", "words": [{"id": 1, "arabic": "۞وَيَطُوفُ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "غِلْمَانࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَّهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "كَأَنَّهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "لُؤْلُؤࣱ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَّكْنُونࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 25, "text": "وَأَقْبَلَ بَعْضُهُمْ عَلَيٰ بَعْضࣲ يَتَسَآءَلُونَۖ", "words": [{"id": 1, "arabic": "وَأَقْبَلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَعْضُهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "بَعْضࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَتَسَآءَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 26, "text": "قَالُوٓاْ إِنَّا كُنَّا قَبْلُ فِےٓ أَهْلِنَا مُشْفِقِينَ", "words": [{"id": 1, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "قَبْلُ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَهْلِنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "مُشْفِقِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 27, "text": "فَمَنَّ اَ۬للَّهُ عَلَيْنَا وَوَق۪يٰنَا عَذَابَ اَ۬لسَّمُومِۖ", "words": [{"id": 1, "arabic": "فَمَنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "وَوَق۪يٰنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "عَذَابَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لسَّمُومِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 28, "text": "إِنَّا كُنَّا مِن قَبْلُ نَدْعُوهُ أَنَّهُۥ هُوَ اَ۬لْبَرُّ اُ۬لرَّحِيمُۖ", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَبْلُ", "translit": "", "root": ""}, {"id": 5, "arabic": "نَدْعُوهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَنَّهُۥ", "translit": "", "root": ""}, {"id": 7, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لْبَرُّ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬لرَّحِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 29, "text": "فَذَكِّرْ فَمَآ أَنتَ بِنِعْمَتِ رَبِّكَ بِكَاهِنࣲ وَلَا مَجْنُونٍۖ", "words": [{"id": 1, "arabic": "فَذَكِّرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَمَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنتَ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِنِعْمَتِ", "translit": "", "root": ""}, {"id": 5, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِكَاهِنࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 8, "arabic": "مَجْنُونٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 30, "text": "اَمْ يَقُولُونَ شَاعِرࣱ نَّتَرَبَّصُ بِهِۦ رَيْبَ اَ۬لْمَنُونِۖ", "words": [{"id": 1, "arabic": "اَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَقُولُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "شَاعِرࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "نَّتَرَبَّصُ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "رَيْبَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْمَنُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 31, "text": "قُلْ تَرَبَّصُواْۖ فَإِنِّے مَعَكُم مِّنَ اَ۬لْمُتَرَبِّصِينَۖ", "words": [{"id": 1, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَرَبَّصُواْۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَإِنِّے", "translit": "", "root": ""}, {"id": 4, "arabic": "مَعَكُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْمُتَرَبِّصِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 32, "text": "أَمْ تَامُرُهُمُۥٓ أَحْلَٰمُهُم بِهَٰذَآ أَمْ هُمْ قَوْمࣱ طَاغُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَامُرُهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَحْلَٰمُهُم", "translit": "", "root": ""}, {"id": 4, "arabic": "بِهَٰذَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَوْمࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "طَاغُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 33, "text": "أَمْ يَقُولُونَ تَقَوَّلَهُۥۖ بَل لَّا يُومِنُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَقُولُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "تَقَوَّلَهُۥۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "بَل", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "يُومِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 34, "text": "فَلْيَاتُواْ بِحَدِيثࣲ مِّثْلِهِۦٓ إِن كَانُواْ صَٰدِقِينَۖ", "words": [{"id": 1, "arabic": "فَلْيَاتُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِحَدِيثࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّثْلِهِۦٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِن", "translit": "", "root": ""}, {"id": 5, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "صَٰدِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 35, "text": "أَمْ خُلِقُواْ مِنْ غَيْرِ شَےْءٍ اَمْ هُمُ اُ۬لْخَٰلِقُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خُلِقُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 4, "arabic": "غَيْرِ", "translit": "", "root": ""}, {"id": 5, "arabic": "شَےْءٍ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لْخَٰلِقُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 36, "text": "أَمْ خَلَقُواْ اُ۬لسَّمَٰوَٰتِ وَالَارْضَۖ بَل لَّا يُوقِنُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالَارْضَۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَل", "translit": "", "root": ""}, {"id": 6, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "يُوقِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 37, "text": "أَمْ عِندَهُمْ خَزَآئِنُ رَبِّكَ أَمْ هُمُ اُ۬لْمُصَيْطِرُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عِندَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "خَزَآئِنُ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْمُصَيْطِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 38, "text": "أَمْ لَهُمْ سُلَّمࣱ يَسْتَمِعُونَ فِيهِۖ فَلْيَاتِ مُسْتَمِعُهُم بِسُلْطَٰنࣲ مُّبِينٍۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "سُلَّمࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَسْتَمِعُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِيهِۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَلْيَاتِ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُسْتَمِعُهُم", "translit": "", "root": ""}, {"id": 8, "arabic": "بِسُلْطَٰنࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "مُّبِينٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 39, "text": "اَمْ لَهُ اُ۬لْبَنَٰتُ وَلَكُمُ اُ۬لْبَنُونَۖ", "words": [{"id": 1, "arabic": "اَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْبَنَٰتُ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَلَكُمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْبَنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 40, "text": "أَمْ تَسْـَٔلُهُمُۥٓ أَجْراࣰ فَهُم مِّن مَّغْرَمࣲ مُّثْقَلُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَسْـَٔلُهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَجْراࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَهُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 6, "arabic": "مَّغْرَمࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّثْقَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 41, "text": "أَمْ عِندَهُمُ اُ۬لْغَيْبُ فَهُمْ يَكْتُبُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عِندَهُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْغَيْبُ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَكْتُبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 42, "text": "أَمْ يُرِيدُونَ كَيْداࣰۖ فَالذِينَ كَفَرُواْ هُمُ اُ۬لْمَكِيدُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يُرِيدُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَيْداࣰۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَالذِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْمَكِيدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 43, "text": "أَمْ لَهُمُۥٓ إِلَٰهٌ غَيْرُ اُ۬للَّهِۖ سُبْحَٰنَ اَ۬للَّهِ عَمَّا يُشْرِكُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَٰهٌ", "translit": "", "root": ""}, {"id": 4, "arabic": "غَيْرُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "سُبْحَٰنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَمَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "يُشْرِكُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 52, "ayah": 44, "text": "۞وَإِنْ يَّرَوْاْ كِسْفاࣰ مِّنَ اَ۬لسَّمَآءِ سَاقِطاࣰ يَقُولُواْ سَحَابࣱ مَّرْكُومࣱۖ", "words": [{"id": 1, "arabic": "۞وَإِنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَّرَوْاْ", "translit": "", "root": ""},