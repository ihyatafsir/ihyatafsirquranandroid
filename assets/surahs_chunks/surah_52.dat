82]],"28":[[1,400,1868],[2,1868,3280],[3,3280,3839],[4,3839,4804],[5,4804,6440],[6,6440,7712],[7,7712,8383],[8,8383,9515],[9,9515,11374]],"29":[[1,400,1739],[2,1739,3440],[3,3440,4324],[4,4324,5760],[5,5760,6796],[6,6796,8315],[7,8315,9447],[8,9447,11034]],"30":[[1,400,908],[2,908,2687],[3,2687,3842],[4,3842,5574],[5,5574,6013],[6,6013,6821],[7,6821,8161]],"31":[[1,400,936],[2,936,2921],[3,2921,4419],[4,4419,5442],[5,5442,6282],[6,6282,8683]],"32":[[1,400,1034],[2,1034,2791],[3,2791,4750],[4,4750,6968],[5,6968,7602],[6,7602,8149],[7,8149,9215],[8,9215,11087]],"33":[[1,350,879],[2,879,2732],[3,2732,4350],[4,4350,4831],[5,4831,5637],[6,5637,7394]],"34":[[1,400,2515],[2,2515,3885],[3,3885,5541],[4,5541,6070],[5,6070,7680],[6,7680,9310]],"35":[[1,350,843],[2,843,2278],[3,2278,2726],[4,2726,3533],[5,3533,4318],[6,4318,4811],[7,4811,5237],[8,5237,6976]],"36":[[1,400,827],[2,827,2071],[3,2071,3669],[4,3669,4893],[5,4893,5282],[6,5282,5933],[7,5933,7429]],"37":[[1,400,987],[2,987,2347],[3,2347,4629],[4,4629,5629],[5,5629,6216],[6,6216,6723],[7,6723,9362]],"38":[[1,400,1043],[2,1043,1891],[3,1891,3016],[4,3016,5442],[5,5442,6436],[6,6436,8102],[7,8102,10206],[8,10206,12012],[9,12012,13751]],"39":[[1,350,909],[2,909,1392],[3,1392,2637],[4,2637,3780],[5,3780,5252]],"40":[[1,400,1003],[2,1003,2456],[3,2456,3840],[4,3840,4635],[5,4635,5581],[6,5581,7102],[7,7102,9362]],"41":[[1,350,887],[2,887,2133],[3,2133,3330],[4,3330,4038],[5,4038,5749]],"42":[[1,400,878],[2,878,2508],[3,2508,3616],[4,3616,5061],[5,5061,6387],[6,6387,6800],[7,6800,8605]],"43":[[1,400,1036],[2,1036,1875],[3,1875,2945],[4,2945,3986],[5,3986,5128],[6,5128,6606],[7,6606,7748],[8,7748,9266],[9,9266,11348]],"44":[[1,400,1240],[2,1240,2512],[3,2512,3580],[4,3580,4364],[5,4364,6450],[6,6450,7995],[7,7995,9880],[8,9880,10970],[9,10970,12549]],"45":[[1,400,1417],[2,1417,2485],[3,2485,3991],[4,3991,5191],[5,5191,6137],[6,6137,6829],[7,6829,8396]],"46":[[1,400,1389],[2,1389,2032],[3,2032,3293],[4,3293,4307],[5,4307,5642