{"surah": 60, "verses": [{"ayah": 1, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَتَّخِذُوا۟ عَدُوِّى وَعَدُوَّكُمْ أَوْلِيَآءَ تُلْقُونَ إِلَيْهِم بِٱلْمَوَدَّةِ وَقَدْ كَفَرُوا۟ بِمَا جَآءَكُم مِّنَ ٱلْحَقِّ يُخْرِجُونَ ٱلرَّسُولَ وَإِيَّاكُمْۙ أَن تُؤْمِنُوا۟ بِٱللَّهِ رَبِّكُمْ إِن كُنتُمْ خَرَجْتُمْ جِهَٰدًا فِى سَبِيلِى وَٱبْتِغَآءَ مَرْضَاتِىۚ تُسِرُّونَ إِلَيْهِم بِٱلْمَوَدَّةِ وَأَنَا۠ أَعْلَمُ بِمَآ أَخْفَيْتُمْ وَمَآ أَعْلَنتُمْۚ وَمَن يَفْعَلْهُ مِنكُمْ فَقَدْ ضَلَّ سَوَآءَ ٱلسَّبِيلِ ", "translation": "O you who have believed, do not take My enemies and your enemies as allies,[1] extending to them affection while they have disbelieved in what came to you of the truth, having driven out the Prophet and yourselves [only] because you believe in Allāh, your Lord. If you have come out for jihād [i.e., fighting or striving] in My cause and seeking means to My approval, [take them not as friends]. You confide to them affection [i.e., instruction], but I am most knowing of what you have concealed and what you have declared. And whoever does it among you has certainly strayed from the soundness of the way.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَتَّخِذُوا۟", "translit": "۟āwُhdِhkَّtَt", "root": "اخذ"}, {"id": 6, "arabic": "عَدُوِّى", "translit": "àِّwُdَʿع", "root": "عدو"}, {"id": 7, "arabic": "وَعَدُوَّكُمْ", "translit": "ْmُkَّwُdَʿعَw", "root": "عدو"}, {"id": 8, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 9, "arabic": "تُلْقُونَ", "translit": "َnwُqْlُt", "root": "لقي"}, {"id": 10, "arabic": "إِلَيْهِم", "translit": "mِhْyَlِiʾ", "root": ""}, {"id": 11, "arabic": "بِٱلْمَوَدَّةِ", "translit": "ِẗَّdَwَmْlٱِb", "root": "ودد"}, {"id": 12, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 13, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 14, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 15, "arabic": "جَآءَكُم", "translit": "mُkَءٓāَjg", "root": "جيا"}, {"id": 16, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 17, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 18, "arabic": "يُخْرِجُونَ", "translit": "َnwُjgِrْhkُy", "root": "خرج"}, {"id": 19, "arabic": "ٱلرَّسُولَ", "translit": "َlwُsَّrlٱ", "root": "رسل"}, {"id": 20, "arabic": "وَإِيَّاكُمْ", "translit": "ْmُkāَّyِiʾَw", "root": ""}, {"id": 21, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 22, "arabic": "تُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُt", "root": "امن"}, {"id": 23, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 24, "arabic": "رَبِّكُمْ", "translit": "ْmُkِّbَr", "root": "ربب"}, {"id": 25, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 26, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 27, "arabic": "خَرَجْتُمْ", "translit": "ْmُtْjgَrَhk", "root": "خرج"}, {"id": 28, "arabic": "جِهَٰدًا", "translit": "āًdَٰhِjg", "root": "جهد"}, {"id": 29, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 30, "arabic": "سَبِيلِى", "translit": "àِlyِbَs", "root": "سبل"}, {"id": 31, "arabic": "وَٱبْتِغَآءَ", "translit": "َءٓāَغِtْbٱَw", "root": "بغي"}, {"id": 32, "arabic": "مَرْضَاتِى", "translit": "àِtāَḍْrَm", "root": "رضو"}, {"id": 33, "arabic": "تُسِرُّونَ", "translit": "َnwُّrِsُt", "root": "سرر"}, {"id": 34, "arabic": "إِلَيْهِم", "translit": "mِhْyَlِiʾ", "root": ""}, {"id": 35, "arabic": "بِٱلْمَوَدَّةِ", "translit": "ِẗَّdَwَmْlٱِb", "root": "ودد"}, {"id": 36, "arabic": "وَأَنَا۠", "translit": "۠āَnَaʾَw", "root": ""}, {"id": 37, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 38, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 39, "arabic": "أَخْفَيْتُمْ", "translit": "ْmُtْyَfْhkَaʾ", "root": "خفي"}, {"id": 40, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 41, "arabic": "أَعْلَنتُمْ", "translit": "ْmُtnَlْʿعَaʾ", "root": "علن"}, {"id": 42, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 43, "arabic": "يَفْعَلْهُ", "translit": "ُhْlَʿعْfَy", "root": "فعل"}, {"id": 44, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 45, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 46, "arabic": "ضَلَّ", "translit": "َّlَḍ", "root": "ضلل"}, {"id": 47, "arabic": "سَوَآءَ", "translit": "َءٓāَwَs", "root": "سوي"}, {"id": 48, "arabic": "ٱلسَّبِيلِ", "translit": "ِlyِbَّslٱ", "root": "سبل"}], "hasIhya": true}, {"ayah": 2, "text": "إِن يَثْقَفُوكُمْ يَكُونُوا۟ لَكُمْ أَعْدَآءً وَيَبْسُطُوٓا۟ إِلَيْكُمْ أَيْدِيَهُمْ وَأَلْسِنَتَهُم بِٱلسُّوٓءِ وَوَدُّوا۟ لَوْ تَكْفُرُونَ ", "translation": "If they gain dominance over you, they would be [i.e., behave] to you as enemies and extend against you their hands and their tongues with evil, and they wish you would disbelieve.", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "يَثْقَفُوكُمْ", "translit": "ْmُkwُfَqْhtَy", "root": "ثقف"}, {"id": 3, "arabic": "يَكُونُوا۟", "translit": "۟āwُnwُkَy", "root": "كون"}, {"id": 4, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 5, "arabic": "أَعْدَآءً", "translit": "ًءٓāَdْʿعَaʾ", "root": "عدو"}, {"id": 6, "arabic": "وَيَبْسُطُوٓا۟", "translit": "۟āٓwُṭُsْbَyَw", "root": "بسط"}, {"id": 7, "arabic": "إِلَيْكُمْ", "translit": "ْmُkْyَlِiʾ", "root": ""}, {"id": 8, "arabic": "أَيْدِيَهُمْ", "translit": "ْmُhَyِdْyَaʾ", "root": "يدي"}, {"id": 9, "arabic": "وَأَلْسِنَتَهُم", "translit": "mُhَtَnِsْlَaʾَw", "root": "لسن"}, {"id": 10, "arabic": "بِٱلسُّوٓءِ", "translit": "ِءٓwُّslٱِb", "root": "سوا"}, {"id": 11, "arabic": "وَوَدُّوا۟", "translit": "۟āwُّdَwَw", "root": "ودد"}, {"id": 12, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 13, "arabic": "تَكْفُرُونَ", "translit": "َnwُrُfْkَt", "root": "كفر"}], "hasIhya": false}, {"ayah": 3, "text": "لَن تَنفَعَكُمْ أَرْحَامُكُمْ وَلَآ أَوْلَٰدُكُمْۚ يَوْمَ ٱلْقِيَٰمَةِ يَفْصِلُ بَيْنَكُمْۚ وَٱللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ ", "translation": "Never will your relatives or your children benefit you; the Day of Resurrection He will judge between you. And Allāh, of what you do, is Seeing.", "words": [{"id": 1, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 2, "arabic": "تَنفَعَكُمْ", "translit": "ْmُkَʿعَfnَt", "root": "نفع"}, {"id": 3, "arabic": "أَرْحَامُكُمْ", "translit": "ْmُkُmāَḥْrَaʾ", "root": "رحم"}, {"id": 4, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 5, "arabic": "أَوْلَٰدُكُمْ", "translit": "ْmُkُdَٰlْwَaʾ", "root": "ولد"}, {"id": 6, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 7, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 8, "arabic": "يَفْصِلُ", "translit": "ُlِṣْfَy", "root": "فصل"}, {"id": 9, "arabic": "بَيْنَكُمْ", "translit": "ْmُkَnْyَb", "root": "بين"}, {"id": 10, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 11, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 12, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 13, "arabic": "بَصِيرٌ", "translit": "ٌryِṣَb", "root": "بصر"}], "hasIhya": false}, {"ayah": 4, "text": "قَدْ كَانَتْ لَكُمْ أُسْوَةٌ حَسَنَةٌ فِىٓ إِبْرَٰهِيمَ وَٱلَّذِينَ مَعَهُۥٓ إِذْ قَالُوا۟ لِقَوْمِهِمْ إِنَّا بُرَءَٰٓؤُا۟ مِنكُمْ وَمِمَّا تَعْبُدُونَ مِن دُونِ ٱللَّهِ كَفَرْنَا بِكُمْ وَبَدَا بَيْنَنَا وَبَيْنَكُمُ ٱلْعَدَٰوَةُ وَٱلْبَغْضَآءُ أَبَدًا حَتَّىٰ تُؤْمِنُوا۟ بِٱللَّهِ وَحْدَهُۥٓ إِلَّا قَوْلَ إِبْرَٰهِيمَ لِأَبِيهِ لَأَسْتَغْفِرَنَّ لَكَ وَمَآ أَمْلِكُ لَكَ مِنَ ٱللَّهِ مِن شَىْءٍۖ رَّبَّنَا عَلَيْكَ تَوَكَّلْنَا وَإِلَيْكَ أَنَبْنَا وَإِلَيْكَ ٱلْمَصِيرُ ", "translation": "There has already been for you an excellent pattern[1] in Abraham and those with him, when they said to their people, \"Indeed, we are disassociated from you and from whatever you worship other than Allāh. We have denied you, and there has appeared between us and you animosity and hatred forever until you believe in Allāh alone\" - except for the saying of Abraham to his father, \"I will surely ask forgiveness for you, but I have not [power to do] for you anything against Allāh. Our Lord, upon You we have relied, and to You we have returned, and to You is the destination.", "words": [{"id": 1, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 2, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 3, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 4, "arabic": "أُسْوَةٌ", "translit": "ٌẗَwْsُaʾ", "root": "اسو"}, {"id": 5, "arabic": "حَسَنَةٌ", "translit": "ٌẗَnَsَḥ", "root": "حسن"}, {"id": 6, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 7, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 8, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 9, "arabic": "مَعَهُۥٓ", "translit": "ٓۥُhَʿعَm", "root": ""}, {"id": 10, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 11, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 12, "arabic": "لِقَوْمِهِمْ", "translit": "ْmِhِmْwَqِl", "root": "قوم"}, {"id": 13, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 14, "arabic": "بُرَءَٰٓؤُا۟", "translit": "۟āُwʾَٰٓءَrُb", "root": "برا"}, {"id": 15, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 16, "arabic": "وَمِمَّا", "translit": "āَّmِmَw", "root": ""}, {"id": 17, "arabic": "تَعْبُدُونَ", "translit": "َnwُdُbْʿعَt", "root": "عبد"}, {"id": 18, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 19, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 20, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "كَفَرْنَا", "translit": "āَnْrَfَk", "root": "كفر"}, {"id": 22, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": ""}, {"id": 23, "arabic": "وَبَدَا", "translit": "āَdَbَw", "root": "بدو"}, {"id": 24, "arabic": "بَيْنَنَا", "translit": "āَnَnْyَb", "root": "بين"}, {"id": 25, "arabic": "وَبَيْنَكُمُ", "translit": "ُmُkَnْyَbَw", "root": "بين"}, {"id": 26, "arabic": "ٱلْعَدَٰوَةُ", "translit": "ُẗَwَٰdَʿعْlٱ", "root": "عدو"}, {"id": 27, "arabic": "وَٱلْبَغْضَآءُ", "translit": "ُءٓāَḍْغَbْlٱَw", "root": "بغض"}, {"id": 28, "arabic": "أَبَدًا", "translit": "āًdَbَaʾ", "root": "ابد"}, {"id": 29, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 30, "arabic": "تُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُt", "root": "امن"}, {"id": 31, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 32, "arabic": "وَحْدَهُۥٓ", "translit": "ٓۥُhَdْḥَw", "root": "وحد"}, {"id": 33, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 34, "arabic": "قَوْلَ", "translit": "َlْwَq", "root": "قول"}, {"id": 35, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 36, "arabic": "لِأَبِيهِ", "translit": "ِhyِbَaʾِl", "root": "ابو"}, {"id": 37, "arabic": "لَأَسْتَغْفِرَنَّ", "translit": "َّnَrِfْغَtْsَaʾَl", "root": "غفر"}, {"id": 38, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 39, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 40, "arabic": "أَمْلِكُ", "translit": "ُkِlْmَaʾ", "root": "ملك"}, {"id": 41, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 42, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 43, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 44, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 45, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 46, "arabic": "رَّبَّنَا", "translit": "āَnَّbَّr", "root": "ربب"}, {"id": 47, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 48, "arabic": "تَوَكَّلْنَا", "translit": "āَnْlَّkَwَt", "root": "وكل"}, {"id": 49, "arabic": "وَإِلَيْكَ", "translit": "َkْyَlِiʾَw", "root": ""}, {"id": 50, "arabic": "أَنَبْنَا", "translit": "āَnْbَnَaʾ", "root": "نوب"}, {"id": 51, "arabic": "وَإِلَيْكَ", "translit": "َkْyَlِiʾَw", "root": ""}, {"id": 52, "arabic": "ٱلْمَصِيرُ", "translit": "ُryِṣَmْlٱ", "root": "صير"}], "hasIhya": true}, {"ayah": 5, "text": "رَبَّنَا لَا تَجْعَلْنَا فِتْنَةً لِّلَّذِينَ كَفَرُوا۟ وَٱغْفِرْ لَنَا رَبَّنَآۖ إِنَّكَ أَنتَ ٱلْعَزِيزُ ٱلْحَكِيمُ ", "translation": "Our Lord, make us not [objects of] torment for the disbelievers and forgive us, our Lord. Indeed, it is You who is the Exalted in Might, the Wise.\"", "words": [{"id": 1, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "تَجْعَلْنَا", "translit": "āَnْlَʿعْjgَt", "root": "جعل"}, {"id": 4, "arabic": "فِتْنَةً", "translit": "ًẗَnْtِf", "root": "فتن"}, {"id": 5, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 6, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 7, "arabic": "وَٱغْفِرْ", "translit": "ْrِfْغٱَw", "root": "غفر"}, {"id": 8, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 9, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 10, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 11, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 12, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 13, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}, {"ayah": 6, "text": "لَقَدْ كَانَ لَكُمْ فِيهِمْ أُسْوَةٌ حَسَنَةٌ لِّمَن كَانَ يَرْجُوا۟ ٱللَّهَ وَٱلْيَوْمَ ٱلْءَاخِرَۚ وَمَن يَتَوَلَّ فَإِنَّ ٱللَّهَ هُوَ ٱلْغَنِىُّ ٱلْحَمِيدُ ", "translation": "There has certainly been for you in them an excellent pattern for anyone whose hope is in Allāh and the Last Day. And whoever turns away - then indeed, Allāh is the Free of need, the Praiseworthy.", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 4, "arabic": "فِيهِمْ", "translit": "ْmِhyِf", "root": ""}, {"id": 5, "arabic": "أُسْوَةٌ", "translit": "ٌẗَwْsُaʾ", "root": "اسو"}, {"id": 6, "arabic": "حَسَنَةٌ", "translit": "ٌẗَnَsَḥ", "root": "حسن"}, {"id": 7, "arabic": "لِّمَن", "translit": "nَmِّl", "root": ""}, {"id": 8, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 9, "arabic": "يَرْجُوا۟", "translit": "۟āwُjgْrَy", "root": "رجو"}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "وَٱلْيَوْمَ", "translit": "َmْwَyْlٱَw", "root": "يوم"}, {"id": 12, "arabic": "ٱلْءَاخِرَ", "translit": "َrِhkāَءْlٱ", "root": "اخر"}, {"id": 13, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 14, "arabic": "يَتَوَلَّ", "translit": "َّlَwَtَy", "root": "ولي"}, {"id": 15, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 16, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 18, "arabic": "ٱلْغَنِىُّ", "translit": "ُّàِnَغْlٱ", "root": "غني"}, {"id": 19, "arabic": "ٱلْحَمِيدُ", "translit": "ُdyِmَḥْlٱ", "root": "حمد"}], "hasIhya": false}, {"ayah": 7, "text": "عَسَى ٱللَّهُ أَن يَجْعَلَ بَيْنَكُمْ وَبَيْنَ ٱلَّذِينَ عَادَيْتُم مِّنْهُم مَّوَدَّةًۚ وَٱللَّهُ قَدِيرٌۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ ", "translation": "Perhaps Allāh will put, between you and those to whom you have been enemies among them, affection. And Allāh is competent,[1] and Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "عَسَى", "translit": "àَsَʿع", "root": "عسي"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "يَجْعَلَ", "translit": "َlَʿعْjgَy", "root": "جعل"}, {"id": 5, "arabic": "بَيْنَكُمْ", "translit": "ْmُkَnْyَb", "root": "بين"}, {"id": 6, "arabic": "وَبَيْنَ", "translit": "َnْyَbَw", "root": "بين"}, {"id": 7, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "عَادَيْتُم", "translit": "mُtْyَdāَʿع", "root": "عدو"}, {"id": 9, "arabic": "مِّنْهُم", "translit": "mُhْnِّm", "root": ""}, {"id": 10, "arabic": "مَّوَدَّةً", "translit": "ًẗَّdَwَّm", "root": "ودد"}, {"id": 11, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 12, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}, {"id": 13, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 14, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 15, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 8, "text": "لَّا يَنْهَىٰكُمُ ٱللَّهُ عَنِ ٱلَّذِينَ لَمْ يُقَٰتِلُوكُمْ فِى ٱلدِّينِ وَلَمْ يُخْرِجُوكُم مِّن دِيَٰرِكُمْ أَن تَبَرُّوهُمْ وَتُقْسِطُوٓا۟ إِلَيْهِمْۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلْمُقْسِطِينَ ", "translation": "Allāh does not forbid you from those who do not fight you because of religion and do not expel you from your homes - from being righteous toward them and acting justly toward them. Indeed, Allāh loves those who act justly.", "words": [{"id": 1, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 2, "arabic": "يَنْهَىٰكُمُ", "translit": "ُmُkٰàَhْnَy", "root": "نهي"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 7, "arabic": "يُقَٰتِلُوكُمْ", "translit": "ْmُkwُlِtَٰqُy", "root": "قتل"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلدِّينِ", "translit": "ِnyِّdlٱ", "root": "دين"}, {"id": 10, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 11, "arabic": "يُخْرِجُوكُم", "translit": "mُkwُjgِrْhkُy", "root": "خرج"}, {"id": 12, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 13, "arabic": "دِيَٰرِكُمْ", "translit": "ْmُkِrَٰyِd", "root": "دور"}, {"id": 14, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 15, "arabic": "تَبَرُّوهُمْ", "translit": "ْmُhwُّrَbَt", "root": "برر"}, {"id": 16, "arabic": "وَتُقْسِطُوٓا۟", "translit": "۟āٓwُṭِsْqُtَw", "root": "قسط"}, {"id": 17, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 18, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 19, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 21, "arabic": "ٱلْمُقْسِطِينَ", "translit": "َnyِṭِsْqُmْlٱ", "root": "قسط"}], "hasIhya": false}, {"ayah": 9, "text": "إِنَّمَا يَنْهَىٰكُمُ ٱللَّهُ عَنِ ٱلَّذِينَ قَٰتَلُوكُمْ فِى ٱلدِّينِ وَأَخْرَجُوكُم مِّن دِيَٰرِكُمْ وَظَٰهَرُوا۟ عَلَىٰٓ إِخْرَاجِكُمْ أَن تَوَلَّوْهُمْۚ وَمَن يَتَوَلَّهُمْ فَأُو۟لَٰٓئِكَ هُمُ ٱلظَّٰلِمُونَ ", "translation": "Allāh only forbids you from those who fight you because of religion and expel you from your homes and aid in your expulsion - [forbids] that you make allies[1] of them. And whoever makes allies of them, then it is those who are the wrongdoers.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "يَنْهَىٰكُمُ", "translit": "ُmُkٰàَhْnَy", "root": "نهي"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "قَٰتَلُوكُمْ", "translit": "ْmُkwُlَtَٰq", "root": "قتل"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلدِّينِ", "translit": "ِnyِّdlٱ", "root": "دين"}, {"id": 9, "arabic": "وَأَخْرَجُوكُم", "translit": "mُkwُjgَrْhkَaʾَw", "root": "خرج"}, {"id": 10, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 11, "arabic": "دِيَٰرِكُمْ", "translit": "ْmُkِrَٰyِd", "root": "دور"}, {"id": 12, "arabic": "وَظَٰهَرُوا۟", "translit": "۟āwُrَhَٰẓَw", "root": "ظهر"}, {"id": 13, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 14, "arabic": "إِخْرَاجِكُمْ", "translit": "ْmُkِjgāَrْhkِiʾ", "root": "خرج"}, {"id": 15, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 16, "arabic": "تَوَلَّوْهُمْ", "translit": "ْmُhْwَّlَwَt", "root": "ولي"}, {"id": 17, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 18, "arabic": "يَتَوَلَّهُمْ", "translit": "ْmُhَّlَwَtَy", "root": "ولي"}, {"id": 19, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 20, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 21, "arabic": "ٱلظَّٰلِمُونَ", "translit": "َnwُmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 10, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا جَآءَكُمُ ٱلْمُؤْمِنَٰتُ مُهَٰجِرَٰتٍ فَٱمْتَحِنُوهُنَّۖ ٱللَّهُ أَعْلَمُ بِإِيمَٰنِهِنَّۖ فَإِنْ عَلِمْتُمُوهُنَّ مُؤْمِنَٰتٍ فَلَا تَرْجِعُوهُنَّ إِلَى ٱلْكُفَّارِۖ لَا هُنَّ حِلٌّ لَّهُمْ وَلَا هُمْ يَحِلُّونَ لَهُنَّۖ وَءَاتُوهُم مَّآ أَنفَقُوا۟ۚ وَلَا جُنَاحَ عَلَيْكُمْ أَن تَنكِحُوهُنَّ إِذَآ ءَاتَيْتُمُوهُنَّ أُجُورَهُنَّۚ وَلَا تُمْسِكُوا۟ بِعِصَمِ ٱلْكَوَافِرِ وَسْـَٔلُوا۟ مَآ أَنفَقْتُمْ وَلْيَسْـَٔلُوا۟ مَآ أَنفَقُوا۟ۚ ذَٰلِكُمْ حُكْمُ ٱللَّهِۖ يَحْكُمُ بَيْنَكُمْۚ وَٱللَّهُ عَلِيمٌ حَكِيمٌ ", "translation": "O you who have believed, when the believing women come to you as emigrants, examine [i.e., test] them. Allāh is most knowing as to their faith. And if you know them to be believers, then do not return them to the disbelievers; they are not lawful [wives] for them, nor are they lawful [husbands] for them. But give them [i.e., the disbelievers] what they have spent.[1] And there is no blame upon you if you marry them when you have given them their due compensation [i.e., mahr]. And hold not to marriage bonds with disbelieving women, but ask for what you have spent and let them [i.e., the disbelievers] ask for what they have spent.[2] That is the judgement of Allāh; He judges between you. And Allāh is Knowing and Wise.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "جَآءَكُمُ", "translit": "ُmُkَءٓāَjg", "root": "جيا"}, {"id": 6, "arabic": "ٱلْمُؤْمِنَٰتُ", "translit": "ُtَٰnِmْwʾُmْlٱ", "root": "امن"}, {"id": 7, "arabic": "مُهَٰجِرَٰتٍ", "translit": "ٍtَٰrِjgَٰhُm", "root": "هجر"}, {"id": 8, "arabic": "فَٱمْتَحِنُوهُنَّ", "translit": "َّnُhwُnِḥَtْmٱَf", "root": "محن"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 11, "arabic": "بِإِيمَٰنِهِنَّ", "translit": "َّnِhِnَٰmyِiʾِb", "root": "امن"}, {"id": 12, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 13, "arabic": "عَلِمْتُمُوهُنَّ", "translit": "َّnُhwُmُtْmِlَʿع", "root": "علم"}, {"id": 14, "arabic": "مُؤْمِنَٰتٍ", "translit": "ٍtَٰnِmْwʾُm", "root": "امن"}, {"id": 15, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 16, "arabic": "تَرْجِعُوهُنَّ", "translit": "َّnُhwُʿعِjgْrَt", "root": "رجع"}, {"id": 17, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 18, "arabic": "ٱلْكُفَّارِ", "translit": "ِrāَّfُkْlٱ", "root": "كفر"}, {"id": 19, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 20, "arabic": "هُنَّ", "translit": "َّnُh", "root": ""}, {"id": 21, "arabic": "حِلٌّ", "translit": "ٌّlِḥ", "root": "حلل"}, {"id": 22, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 23, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 24, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 25, "arabic": "يَحِلُّونَ", "translit": "َnwُّlِḥَy", "root": "حلل"}, {"id": 26, "arabic": "لَهُنَّ", "translit": "َّnُhَl", "root": ""}, {"id": 27, "arabic": "وَءَاتُوهُم", "translit": "mُhwُtāَءَw", "root": "اتي"}, {"id": 28, "arabic": "مَّآ", "translit": "ٓāَّm", "root": ""}, {"id": 29, "arabic": "أَنفَقُوا۟", "translit": "۟āwُqَfnَaʾ", "root": "نفق"}, {"id": 30, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 31, "arabic": "جُنَاحَ", "translit": "َḥāَnُjg", "root": "جنح"}, {"id": 32, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 33, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 34, "arabic": "تَنكِحُوهُنَّ", "translit": "َّnُhwُḥِknَt", "root": "نكح"}, {"id": 35, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 36, "arabic": "ءَاتَيْتُمُوهُنَّ", "translit": "َّnُhwُmُtْyَtāَء", "root": "اتي"}, {"id": 37, "arabic": "أُجُورَهُنَّ", "translit": "َّnُhَrwُjgُaʾ", "root": "اجر"}, {"id": 38, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 39, "arabic": "تُمْسِكُوا۟", "translit": "۟āwُkِsْmُt", "root": "مسك"}, {"id": 40, "arabic": "بِعِصَمِ", "translit": "ِmَṣِʿعِb", "root": "عصم"}, {"id": 41, "arabic": "ٱلْكَوَافِرِ", "translit": "ِrِfāَwَkْlٱ", "root": "كفر"}, {"id": 42, "arabic": "وَسْـَٔلُوا۟", "translit": "۟āwُlَٔـْsَw", "root": "سال"}, {"id": 43, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 44, "arabic": "أَنفَقْتُمْ", "translit": "ْmُtْqَfnَaʾ", "root": "نفق"}, {"id": 45, "arabic": "وَلْيَسْـَٔلُوا۟", "translit": "۟āwُlَٔـْsَyْlَw", "root": "سال"}, {"id": 46, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 47, "arabic": "أَنفَقُوا۟", "translit": "۟āwُqَfnَaʾ", "root": "نفق"}, {"id": 48, "arabic": "ذَٰلِكُمْ", "translit": "ْmُkِlَٰhd", "root": ""}, {"id": 49, "arabic": "حُكْمُ", "translit": "ُmْkُḥ", "root": "حكم"}, {"id": 50, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 51, "arabic": "يَحْكُمُ", "translit": "ُmُkْḥَy", "root": "حكم"}, {"id": 52, "arabic": "بَيْنَكُمْ", "translit": "ْmُkَnْyَb", "root": "بين"}, {"id": 53, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 54, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}, {"id": 55, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": true}, {"ayah": 11, "text": "وَإِن فَاتَكُمْ شَىْءٌ مِّنْ أَزْوَٰجِكُمْ إِلَى ٱلْكُفَّارِ فَعَاقَبْتُمْ فَـَٔاتُوا۟ ٱلَّذِينَ ذَهَبَتْ أَزْوَٰجُهُم مِّثْلَ مَآ أَنفَقُوا۟ۚ وَٱتَّقُوا۟ ٱللَّهَ ٱلَّذِىٓ أَنتُم بِهِۦ مُؤْمِنُونَ ", "translation": "And if you have lost any of your wives to the disbelievers and you subsequently obtain [something],[1] then give those whose wives have gone the equivalent of what they had spent. And fear Allāh, in whom you are believers.", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "فَاتَكُمْ", "translit": "ْmُkَtāَf", "root": "فوت"}, {"id": 3, "arabic": "شَىْءٌ", "translit": "ٌءْàَhs", "root": "شيا"}, {"id": 4, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 5, "arabic": "أَزْوَٰجِكُمْ", "translit": "ْmُkِjgَٰwْzَaʾ", "root": "زوج"}, {"id": 6, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 7, "arabic": "ٱلْكُفَّارِ", "translit": "ِrāَّfُkْlٱ", "root": "كفر"}, {"id": 8, "arabic": "فَعَاقَبْتُمْ", "translit": "ْmُtْbَqāَʿعَf", "root": "عقب"}, {"id": 9, "arabic": "فَـَٔاتُوا۟", "translit": "۟āwُtāَٔـَf", "root": "اتي"}, {"id": 10, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "ذَهَبَتْ", "translit": "ْtَbَhَhd", "root": "ذهب"}, {"id": 12, "arabic": "أَزْوَٰجُهُم", "translit": "mُhُjgَٰwْzَaʾ", "root": "زوج"}, {"id": 13, "arabic": "مِّثْلَ", "translit": "َlْhtِّm", "root": "مثل"}, {"id": 14, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 15, "arabic": "أَنفَقُوا۟", "translit": "۟āwُqَfnَaʾ", "root": "نفق"}, {"id": 16, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 17, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 19, "arabic": "أَنتُم", "translit": "mُtnَaʾ", "root": ""}, {"id": 20, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 21, "arabic": "مُؤْمِنُونَ", "translit": "َnwُnِmْwʾُm", "root": "امن"}], "hasIhya": false}, {"ayah": 12, "text": "يَٰٓأَيُّهَا ٱلنَّبِىُّ إِذَا جَآءَكَ ٱلْمُؤْمِنَٰتُ يُبَايِعْنَكَ عَلَىٰٓ أَن لَّا يُشْرِكْنَ بِٱللَّهِ شَيْـًٔا وَلَا يَسْرِقْنَ وَلَا يَزْنِينَ وَلَا يَقْتُلْنَ أَوْلَٰدَهُنَّ وَلَا يَأْتِينَ بِبُهْتَٰنٍ يَفْتَرِينَهُۥ بَيْنَ أَيْدِيهِنَّ وَأَرْجُلِهِنَّ وَلَا يَعْصِينَكَ فِى مَعْرُوفٍۙ فَبَايِعْهُنَّ وَٱسْتَغْفِرْ لَهُنَّ ٱللَّهَۖ إِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ", "translation": "O Prophet, when the believing women come to you pledging to you that they will not associate anything with Allāh, nor will they steal, nor will they commit unlawful sexual intercourse, nor will they kill their children, nor will they bring forth a slander they have invented between their arms and legs,[1] nor will they disobey you in what is right - then accept their pledge and ask forgiveness for them of Allāh. Indeed, Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلنَّبِىُّ", "translit": "ُّàِbَّnlٱ", "root": "نبا"}, {"id": 3, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 4, "arabic": "جَآءَكَ", "translit": "َkَءٓāَjg", "root": "جيا"}, {"id": 5, "arabic": "ٱلْمُؤْمِنَٰتُ", "translit": "ُtَٰnِmْwʾُmْlٱ", "root": "امن"}, {"id": 6, "arabic": "يُبَايِعْنَكَ", "translit": "َkَnْʿعِyāَbُy", "root": "بيع"}, {"id": 7, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 10, "arabic": "يُشْرِكْنَ", "translit": "َnْkِrْhsُy", "root": "شرك"}, {"id": 11, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 12, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 13, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 14, "arabic": "يَسْرِقْنَ", "translit": "َnْqِrْsَy", "root": "سرق"}, {"id": 15, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 16, "arabic": "يَزْنِينَ", "translit": "َnyِnْzَy", "root": "زني"}, {"id": 17, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 18, "arabic": "يَقْتُلْنَ", "translit": "َnْlُtْqَy", "root": "قتل"}, {"id": 19, "arabic": "أَوْلَٰدَهُنَّ", "translit": "َّnُhَdَٰlْwَaʾ", "root": "ولد"}, {"id": 20, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 21, "arabic": "يَأْتِينَ", "translit": "َnyِtْaʾَy", "root": "اتي"}, {"id": 22, "arabic": "بِبُهْتَٰنٍ", "translit": "ٍnَٰtْhُbِb", "root": "بهت"}, {"id": 23, "arabic": "يَفْتَرِينَهُۥ", "translit": "ۥُhَnyِrَtْfَy", "root": "فري"}, {"id": 24, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 25, "arabic": "أَيْدِيهِنَّ", "translit": "َّnِhyِdْyَaʾ", "root": "يدي"}, {"id": 26, "arabic": "وَأَرْجُلِهِنَّ", "translit": "َّnِhِlُjgْrَaʾَw", "root": "رجل"}, {"id": 27, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 28, "arabic": "يَعْصِينَكَ", "translit": "َkَnyِṣْʿعَy", "root": "عصي"}, {"id": 29, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 30, "arabic": "مَعْرُوفٍ", "translit": "ٍfwُrْʿعَm", "root": "عرف"}, {"id": 31, "arabic": "فَبَايِعْهُنَّ", "translit": "َّnُhْʿعِyāَbَf", "root": "بيع"}, {"id": 32, "arabic": "وَٱسْتَغْفِرْ", "translit": "ْrِfْغَtْsٱَw", "root": "غفر"}, {"id": 33, "arabic": "لَهُنَّ", "translit": "َّnُhَl", "root": ""}, {"id": 34, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 35, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 36, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 37, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 38, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 13, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَتَوَلَّوْا۟ قَوْمًا غَضِبَ ٱللَّهُ عَلَيْهِمْ قَدْ يَئِسُوا۟ مِنَ ٱلْءَاخِرَةِ كَمَا يَئِسَ ٱلْكُفَّارُ مِنْ أَصْحَٰبِ ٱلْقُبُورِ ", "translation": "O you who have believed, do not make allies of a people with whom Allāh has become angry. They have despaired of [reward in] the Hereafter just as the disbelievers have despaired of [meeting] the companions [i.e., inhabitants] of the graves.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَتَوَلَّوْا۟", "translit": "۟āْwَّlَwَtَt", "root": "ولي"}, {"id": 6, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 7, "arabic": "غَضِبَ", "translit": "َbِḍَغ", "root": "غضب"}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 10, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 11, "arabic": "يَئِسُوا۟", "translit": "۟āwُsِyʾَy", "root": "ياس"}, {"id": 12, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 13, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 14, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 15, "arabic": "يَئِسَ", "translit": "َsِyʾَy", "root": "ياس"}, {"id": 16, "arabic": "ٱلْكُفَّارُ", "translit": "ُrāَّfُkْlٱ", "root": "كفر"}, {"id": 17, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 18, "arabic": "أَصْحَٰبِ", "translit": "ِbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 19, "arabic": "ٱلْقُبُورِ", "translit": "ِrwُbُqْlٱ", "root": "قبر"}], "hasIhya": true}], "tafsir": {"1": [{"arabic": "وأما الانبساط معه والاسترسال إليه كما يسترسل إلى الأصدقاء فهو مكروه كراهة شديدة يكاد ينتهي ما يقوى منها إلى حد التحريم قال تعالى لا تجد قوما يؤمنون بالله واليوم الآخر يوادون من حاد الله ورسوله ولو كانوا آباءهم أو أبناءهم الآية وقال صلى الله عليه وسلم المسلم والمشرك لا تتراءى ناراهما حديث المؤمن والمشرك لا تتراءى ناراهما رواه أبو داود والترمذي من حديث جرير أنا بريء من كل مسلم يقيم بين أظهر المشركين قالوا يا رسول الله ولم قال لا تراءى ناراهما رواه النسائي مرسلا وقال البخاري الصحيح أنه مرسل وقال عز", "english": "And as for being expansive with him and freely conversing with him as one converses freely with friends, it is disliked with a severe dislike that almost reaches the limit of prohibition. Allah the Exalted said: 'You will not find a people who believe in Allah and the Last Day loving those who oppose Allah and His Messenger, even if they were their fathers or their sons...' the verse. And the Prophet (peace be upon him) said: 'The Muslim and the polytheist - their fires should not be visible to one another.' The hadith: 'The believer and the polytheist - their fires should not be visible to one another' was narrated by Abu Dawud and al-Tirmidhi from the hadith of Jarir: 'I am free from every Muslim who resides among the polytheists.' They said: 'O Messenger of Allah, why?' He said: 'Their fires should not be visible to one another.' It was narrated by al-Nasa'i as mursal, and al-Bukhari said the authentic is that it is mursal. And Allah the Mighty and Majestic said: 'O you who have believed, do not take My enemy and your enemy as allies...' the verse.", "book_file": "vol2_j2-k05.doc.txt", "book_title": "Duties of Brotherhood", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Duties of Brotherhood'", "badge": "Hadith"}, {"arabic": "وقال كعب الأحبار ما في القرآن من يا أيها الذين آمنوا فهو في التوراة يا أيها المساكين", "english": "And Ka'b al-Ahbar said: 'What is in the Quran of \"O you who have believed\" is in the Torah \"O you poor ones (al-Masakin)\".'", "book_file": "vol2_j2-k05.doc.txt", "book_title": "Duties of Brotherhood", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Duties of Brotherhood'", "badge": "General"}], "4": [{"arabic": "رضيت بالله ربا وبالإسلام دينا وبمحمد ﭬ نبيا ﴿ ربنا عليك توكلنا وإليك أنبنا وإليك المصير ﴾ {}[237] وإذا أمسى قال ذلك إلا أنه يقول أمسينا ويقول مع ذلك أعوذ بكلمات الله التامات وأسمائه كلها من شر ما ذرأ وبرأ ومن شر كل ذي شر ومن شر كل دابة أنت آخذ بناصيتها إن ربي على صراط مستقيم[238]", "english": "I am pleased with Allah as Lord, with Islam as religion, and with Muhammad (peace be upon him) as prophet. 'Our Lord, upon You we have relied, and to You we have turned, and to You is the final destination.' And when evening comes, he says that except he says 'we have entered evening' and says with that: 'I seek refuge in the perfect words of Allah and all His names from the evil of what He has created and brought forth, and from the evil of every possessor of evil, and from the evil of every creature whose forelock You take hold of; indeed my Lord is upon a straight path.'", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance", "badge": "Du'a"}], "7": [{"arabic": "وينبغي أن لا يبالغ في البغضة عند الوقيعة قال الله تعالى عسى الله أن يجعل بينكم وبين الذين عاديتم منهم مودة و قال عليه السلام أحبب حبيبك هونا ما عسى أن يكون بغيضك يوما ما وأبغض بغيضك هونا ما عسى أن يكون حبيبك يوما ما", "english": "And it is necessary that one should not exaggerate in hatred during enmity. Allah the Exalted said: 'Perhaps Allah will place between you and those whom you have been enemies among them affection.' And he (peace be upon him) said: 'Love your beloved moderately, for perhaps he may become your enemy one day; and hate your enemy moderately, for perhaps he may become your beloved one day.'", "book_file": "vol2_j2-k05.doc.txt", "book_title": "Duties of Brotherhood", "content_type": "fiqh", "topic": "Al-Ghazali on the outer and inner dimensions of worship, from 'Duties of Brotherhood'", "badge": "Worship"}], "10": [{"arabic": "وقال كعب الأحبار ما في القرآن من يا أيها الذين آمنوا فهو في التوراة يا أيها المساكين", "english": "And Ka'b al-Ahbar said: 'What is in the Quran of \"O you who have believed\" is in the Torah \"O you poor ones (Masakin)\"'.", "book_file": "vol2_j2-k05.doc.txt", "book_title": "Duties of Brotherhood", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Duties of Brotherhood'", "badge": "General"}], "13": [{"arabic": "ومهما تراكمت الذنوب طبع على القلوب وعند ذلك يعمى القلب عن إدراك الحق وصلاح الدين ويستهين بأمر الآخرة ويستعظم أمر الدنيا ويصير مقصور الهم عليها فإذا قرع سمعه أمر الآخرة وما فيها من الأخطار دخل من أذن وخرج من أذن ولم يستقر في القلب ولم يحركه إلى التوبة والتدارك أولئك يئسوا من الآخرة كما يئس الكفار من أصحاب القبور وهذا هو معنى اسوداد القلب بالذنوب كما نطق به القرآن والسنة", "english": "And whenever sins accumulate, a seal (Taba') is placed upon the hearts (Qulub), and at that point the heart (Qalb) becomes blind to perceiving the truth (Haqq) and the rectification of religion (Deen), and it belittles the matter of the Hereafter (Akhirah) and magnifies the matter of the world (Dunya), and its concern becomes restricted to it. So when the matter of the Hereafter (Akhirah) and what it contains of dangers strikes his hearing, it enters from one ear and exits from the other, and it does not settle in the heart (Qalb) and does not move him to repentance (Tawbah) and rectification. Those have despaired of the Hereafter (Akhirah) as the disbelievers (Kuffar) have despaired of the companions of the graves. And this is the meaning of the blackening of the heart (Qalb) by sins as the Quran and Sunnah have articulated.", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "وقال كعب الأحبار ما في القرآن من يا أيها الذين آمنوا فهو في التوراة يا أيها المساكين", "english": "And Ka'b al-Ahbar said: 'Whatever is in the Quran of \"O you who have believed\" is in the Torah \"O you poor ones (Masakin)\".'", "book_file": "vol2_j2-k05.doc.txt", "book_title": "Duties of Brotherhood", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Duties of Brotherhood'", "badge": "General"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 3572], [2, 3572, 5325], [3, 5325, 7652], [4, 7652, 8459], [5, 8459, 10957], [6, 10957, 12919], [7, 12919, 15502], [8, 15502, 18654], [9, 18654, 20423], [10, 20423, 22161], [11, 22161, 24441], [12, 24441, 25667], [13, 25667, 27560], [14, 27560, 28677], [15, 28677, 31147], [16, 31147, 32217], [17, 32217, 33613], [18, 33613, 35816], [19, 35816, 37879], [20, 37879, 40648], [21, 40648, 41331], [22, 41331, 43627], [23, 43627, 45163], [24, 45163, 46637], [25, 46637, 47320], [26, 47320, 48561], [27, 48561, 50221], [28, 50221, 51785], [29, 51785, 52561], [30, 52561, 54454], [31, 54454, 57591], [32, 57591, 59887], [33, 59887, 61857], [34, 61857, 63595], [35, 63595, 65875], [36, 65875, 67519], [37, 67519, 68884], [38, 68884, 70795], [39, 70795, 72905], [40, 72905, 74971], [41, 74971, 76957], [42, 76957, 78043], [43, 78043, 79781], [44, 79781, 81022], [45, 81022, 82092], [46, 82092, 83038], [47, 83038, 85384], [48, 85384, 87469]], "2": [[1, 400, 1101], [2, 1101, 3745], [3, 3745, 6325], [4, 6325, 7281], [5, 7281, 9944], [6, 9944, 13815], [7, 13815, 15631], [8, 15631, 17893], [9, 17893, 20665], [10, 20665, 23508], [11, 23508, 26009], [12, 26009, 26805], [13, 26805, 28876]], "3": [[1, 400, 925], [2, 925, 2551], [3, 2551, 4623], [4, 4623, 6370], [5, 6370, 8285], [6, 8285, 9334], [7, 9334, 11091], [8, 11091, 12350], [9, 12350, 13793], [10, 13793, 15223], [11, 15223, 16167], [12, 16167, 17924], [13, 17924, 19184]], "4": [[1, 400, 1290], [2, 1290, 2961], [3, 2961, 4051], [4, 4051, 5722], [5