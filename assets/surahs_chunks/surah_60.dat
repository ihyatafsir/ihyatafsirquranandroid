هُنَّۖ اَ۬للَّهُ أَعْلَمُ بِإِيمَٰنِهِنَّۖ فَإِنْ عَلِمْتُمُوهُنَّ مُومِنَٰتࣲ فَلَا تَرْجِعُوهُنَّ إِلَي اَ۬لْكُفّ۪ارِۖ لَا هُنَّ حِلࣱّ لَّهُمْ وَلَا هُمْ يَحِلُّونَ لَهُنَّۖ وَءَاتُوهُم مَّآ أَنفَقُواْۖ وَلَا جُنَاحَ عَلَيْكُمُۥٓ أَن تَنكِحُوهُنَّ إِذَآ ءَاتَيْتُمُوهُنَّ أُجُورَهُنَّۖ وَلَا تُمْسِكُواْ بِعِصَمِ اِ۬لْكَوَافِرِۖ وَسْـَٔلُواْ مَآ أَنفَقْتُمْ وَلْيَسْـَٔلُواْ مَآ أَنفَقُواْۖ ذَٰلِكُمْ حُكْمُ اُ۬للَّهِ يَحْكُمُ بَيْنَكُمْۖ وَاللَّهُ عَلِيمٌ حَكِيمࣱۖ", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓاْ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 5, "arabic": "جَآءَكُمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لْمُومِنَٰتُ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُهَٰجِرَٰتࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَامْتَحِنُوهُنَّۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَعْلَمُ", "translit": "", "root": ""}, {"id": 11, "arabic": "بِإِيمَٰنِهِنَّۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "فَإِنْ", "translit": "", "root": ""}, {"id": 13, "arabic": "عَلِمْتُمُوهُنَّ", "translit": "", "root": ""}, {"id": 14, "arabic": "مُومِنَٰتࣲ", "translit": "", "root": ""}, {"id": 15, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 16, "arabic": "تَرْجِعُوهُنَّ", "translit": "", "root": ""}, {"id": 17, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 18, "arabic": "اَ۬لْكُفّ۪ارِۖ", "translit": "", "root": ""}, {"id": 19, "arabic": "لَا", "translit": "", "root": ""}, {"id": 20, "arabic": "هُنَّ", "translit": "", "root": ""}, {"id": 21, "arabic": "حِلࣱّ", "translit": "", "root": ""}, {"id": 22, "arabic": "لَّهُمْ", "translit": "", "root": ""}, {"id": 23, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 24, "arabic": "هُمْ", "translit": "", "ro