on": "warsh"}, {"surah": 60, "ayah": 4, "text": "قَدْ كَانَتْ لَكُمُۥٓ إِسْوَةٌ حَسَنَةࣱ فِےٓ إِبْرَٰهِيمَ وَالذِينَ مَعَهُۥٓ إِذْ قَالُواْ لِقَوْمِهِمُۥٓ إِنَّا بُرَءَٰٓؤُاْ مِنكُمْ وَمِمَّا تَعْبُدُونَ مِن دُونِ اِ۬للَّهِ كَفَرْنَا بِكُمْ وَبَدَا بَيْنَنَا وَبَيْنَكُمُ اُ۬لْعَدَٰوَةُ وَالْبَغْضَآءُ اَ۬بَداً حَتَّيٰ تُومِنُواْ بِاللَّهِ وَحْدَهُۥٓ إِلَّا قَوْلَ إِبْرَٰهِيمَ لِأَبِيهِ لَأَسْتَغْفِرَنَّ لَكَ وَمَآ أَمْلِكُ لَكَ مِنَ اَ۬للَّهِ مِن شَےْءࣲۖ رَّبَّنَا عَلَيْكَ تَوَكَّلْنَا وَإِلَيْكَ أَنَبْنَا وَإِلَيْكَ اَ۬لْمَصِيرُۖ", "words": [{"id": 1, "arabic": "قَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانَتْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَكُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِسْوَةٌ", "translit": "", "root": ""}, {"id": 5, "arabic": "حَسَنَةࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِبْرَٰهِيمَ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَالذِينَ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَعَهُۥٓ", "translit": "", "root": ""}, {"id": 10, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 11, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 12, "arabic": "لِقَوْمِهِمُۥٓ", "translit": "", "root": ""}, {"id": 13, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 14, "arabic": "بُرَءَٰٓؤُاْ", "translit": "", "root": ""}, {"id": 15, "arabic": "مِنكُمْ", "translit": "", "root": ""}, {"id": 16, "arabic": "وَمِمَّا", "translit": "", "root": ""}, {"id": 17, "arabic": "تَعْبُدُونَ", "translit": "", "root": ""}, {"id": 18, "arabic": "مِن", "translit": "", "root": ""}, {"id": 19, "arabic": "دُونِ", "translit": "", "root": ""}, {"id": 20, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 21, "arabic": "كَفَرْنَا", "translit": "", "root": ""}, {"id": 22, "arabic": "بِكُمْ", "translit": "", "root": ""}, {"id": 23, "arabic": "وَبَدَا", "translit": "", "root": ""}, {"id": 24, "arabic": "