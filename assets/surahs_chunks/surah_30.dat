{"surah":30,"verses":[{"ayah":1,"text":"الٓمٓ ","translation":"Alif, Lām, Meem.[1]","words":[{"id":1,"arabic":"الٓمٓ","translit":"ٓmٓlā","root":""}],"hasIhya":true},{"ayah":2,"text":"غُلِبَتِ ٱلرُّومُ ","translation":"The Byzantines have been defeated[1]","words":[{"id":1,"arabic":"غُلِبَتِ","translit":"ِtَbِlُغ","root":"غلب"},{"id":2,"arabic":"ٱلرُّومُ","translit":"ُmwُّrlٱ","root":""}],"hasIhya":false},{"ayah":3,"text":"فِىٓ أَدْنَى ٱلْأَرْضِ وَهُم مِّنۢ بَعْدِ غَلَبِهِمْ سَيَغْلِبُونَ ","translation":"In the nearest land.[1] But they, after their defeat, will overcome","words":[{"id":1,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":2,"arabic":"أَدْنَى","translit":"àَnْdَaʾ","root":"دنو"},{"id":3,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":4,"arabic":"وَهُم","translit":"mُhَw","root":""},{"id":5,"arabic":"مِّنۢ","translit":"ۢnِّm","root":""},{"id":6,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":7,"arabic":"غَلَبِهِمْ","translit":"ْmِhِbَlَغ","root":"غلب"},{"id":8,"arabic":"سَيَغْلِبُونَ","translit":"َnwُbِlْغَyَs","root":"غلب"}],"hasIhya":false},{"ayah":4,"text":"فِى بِضْعِ سِنِينَۗ لِلَّهِ ٱلْأَمْرُ مِن قَبْلُ وَمِنۢ بَعْدُۚ وَيَوْمَئِذٍ يَفْرَحُ ٱلْمُؤْمِنُونَ ","translation":"Within three to nine years. To Allāh belongs the command [i.e., decree] before and after. And that day the believers will rejoice","words":[{"id":1,"arabic":"فِى","translit":"àِf","root":""},{"id":2,"arabic":"بِضْعِ","translit":"ِʿعْḍِb","root":"بضع"},{"id":3,"arabic":"سِنِينَ","translit":"َnyِnِs","root":"سنو"},{"id":4,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":5,"arabic":"ٱلْأَمْرُ","translit":"ُrْmَaʾْlٱ","root":"امر"},{"id":6,"arabic":"مِن","translit":"nِm","root":""},{"id":7,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":8,"arabic":"وَمِنۢ","translit":"ۢnِmَw","root":""},{"id":9,"arabic":"بَعْدُ","translit":"ُdْʿعَb","root":"بعد"},{"id":10,"arabic":"وَيَوْمَئِذٍ","translit":"ٍhdِyʾَmْwَyَw","root":"يوم"},{"id":11,"arabic":"يَفْرَحُ","translit":"ُḥَrْfَy","root":"فرح"},{"id":12,"arabic":"ٱلْمُؤْمِنُونَ","translit":"َnwُnِmْwʾُmْlٱ","root":"امن"}],"hasIhya":false},{"ayah":5,"text":"بِنَصْرِ ٱللَّهِۚ يَنصُرُ مَن يَشَآءُۖ وَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ ","translation":"In the victory of Allāh.[1] He gives victory to whom He wills, and He is the Exalted in Might, the Merciful.","words":[{"id":1,"arabic":"بِنَصْرِ","translit":"ِrْṣَnِb","root":"نصر"},{"id":2,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":3,"arabic":"يَنصُرُ","translit":"ُrُṣnَy","root":"نصر"},{"id":4,"arabic":"مَن","translit":"nَm","root":""},{"id":5,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":6,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":7,"arabic":"ٱلْعَزِيزُ","translit":"ُzyِzَʿعْlٱ","root":"عزز"},{"id":8,"arabic":"ٱلرَّحِيمُ","translit":"ُmyِḥَّrlٱ","root":"رحم"}],"hasIhya":false},{"ayah":6,"text":"وَعْدَ ٱللَّهِۖ لَا يُخْلِفُ ٱللَّهُ وَعْدَهُۥ وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَعْلَمُونَ ","translation":"[It is] the promise of Allāh. Allāh does not fail in His promise, but most of the people do not know.","words":[{"id":1,"arabic":"وَعْدَ","translit":"َdْʿعَw","root":"وعد"},{"id":2,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":3,"arabic":"لَا","translit":"āَl","root":""},{"id":4,"arabic":"يُخْلِفُ","translit":"ُfِlْhkُy","root":"خلف"},{"id":5,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":6,"arabic":"وَعْدَهُۥ","translit":"ۥُhَdْʿعَw","root":"وعد"},{"id":7,"arabic":"وَلَٰكِنَّ","translit":"َّnِkَٰlَw","root":""},{"id":8,"arabic":"أَكْثَرَ","translit":"َrَhtْkَaʾ","root":"كثر"},{"id":9,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":10,"arabic":"لَا","translit":"āَl","root":""},{"id":11,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":false},{"ayah":7,"text":"يَعْلَمُونَ ظَٰهِرًا مِّنَ ٱلْحَيَوٰةِ ٱلدُّنْيَا وَهُمْ عَنِ ٱلْءَاخِرَةِ هُمْ غَٰفِلُونَ ","translation":"They know what is apparent of the worldly life, but they, of the Hereafter, are unaware.","words":[{"id":1,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"},{"id":2,"arabic":"ظَٰهِرًا","translit":"āًrِhَٰẓ","root":"ظهر"},{"id":3,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":4,"arabic":"ٱلْحَيَوٰةِ","translit":"ِẗٰwَyَḥْlٱ","root":"حيي"},{"id":5,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":6,"arabic":"وَهُمْ","translit":"ْmُhَw","root":""},{"id":7,"arabic":"عَنِ","translit":"ِnَʿع","root":""},{"id":8,"arabic":"ٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱ","root":"اخر"},{"id":9,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":10,"arabic":"غَٰفِلُونَ","translit":"َnwُlِfَٰغ","root":"غفل"}],"hasIhya":true},{"ayah":8,"text":"أَوَلَمْ يَتَفَكَّرُوا۟ فِىٓ أَنفُسِهِمۗ مَّا خَلَقَ ٱللَّهُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَآ إِلَّا بِٱلْحَقِّ وَأَجَلٍ مُّسَمًّىۗ وَإِنَّ كَثِيرًا مِّنَ ٱلنَّاسِ بِلِقَآئِ رَبِّهِمْ لَكَٰفِرُونَ ","translation":"Do they not contemplate within themselves?[1] Allāh has not created the heavens and the earth and what is between them except in truth and for a specified term. And indeed, many of the people, in the meeting with their Lord, are disbelievers.","words":[{"id":1,"arabic":"أَوَلَمْ","translit":"ْmَlَwَaʾ","root":""},{"id":2,"arabic":"يَتَفَكَّرُوا۟","translit":"۟āwُrَّkَfَtَy","root":"فكر"},{"id":3,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":4,"arabic":"أَنفُسِهِم","translit":"mِhِsُfnَaʾ","root":"نفس"},{"id":5,"arabic":"مَّا","translit":"āَّm","root":""},{"id":6,"arabic":"خَلَقَ","translit":"َqَlَhk","root":"خلق"},{"id":7,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":8,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":9,"arabic":"وَٱلْأَرْضَ","translit":"َḍْrَaʾْlٱَw","root":"ارض"},{"id":10,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":11,"arabic":"بَيْنَهُمَآ","translit":"ٓāَmُhَnْyَb","root":"بين"},{"id":12,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":13,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":14,"arabic":"وَأَجَلٍ","translit":"ٍlَjgَaʾَw","root":"اجل"},{"id":15,"arabic":"مُّسَمًّى","translit":"àًّmَsُّm","root":"سمو"},{"id":16,"arabic":"وَإِنَّ","translit":"َّnِiʾَw","root":""},{"id":17,"arabic":"كَثِيرًا","translit":"āًryِhtَk","root":"كثر"},{"id":18,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":19,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":20,"arabic":"بِلِقَآئِ","translit":"ِyʾٓāَqِlِb","root":"لقي"},{"id":21,"arabic":"رَبِّهِمْ","translit":"ْmِhِّbَr","root":"ربب"},{"id":22,"arabic":"لَكَٰفِرُونَ","translit":"َnwُrِfَٰkَl","root":"كفر"}],"hasIhya":false},{"ayah":9,"text":"أَوَلَمْ يَسِيرُوا۟ فِى ٱلْأَرْضِ فَيَنظُرُوا۟ كَيْفَ كَانَ عَٰقِبَةُ ٱلَّذِينَ مِن قَبْلِهِمْۚ كَانُوٓا۟ أَشَدَّ مِنْهُمْ قُوَّةً وَأَثَارُوا۟ ٱلْأَرْضَ وَعَمَرُوهَآ أَكْثَرَ مِمَّا عَمَرُوهَا وَجَآءَتْهُمْ رُسُلُهُم بِٱلْبَيِّنَٰتِۖ فَمَا كَانَ ٱللَّهُ لِيَظْلِمَهُمْ وَلَٰكِن كَانُوٓا۟ أَنفُسَهُمْ يَظْلِمُونَ ","translation":"Have they not traveled through the earth and observed how was the end of those before them? They were greater than them in power, and they plowed [or excavated] the earth and built it up more than they [i.e., the Makkans] have built it up, and their messengers came to them with clear evidences. And Allāh would not ever have wronged them, but they were wronging themselves.","words":[{"id":1,"arabic":"أَوَلَمْ","translit":"ْmَlَwَaʾ","root":""},{"id":2,"arabic":"يَسِيرُوا۟","translit":"۟āwُryِsَy","root":"سير"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":5,"arabic":"فَيَنظُرُوا۟","translit":"۟āwُrُẓnَyَf","root":"نظر"},{"id":6,"arabic":"كَيْفَ","translit":"َfْyَk","root":"كيف"},{"id":7,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":8,"arabic":"عَٰقِبَةُ","translit":"ُẗَbِqَٰʿع","root":"عقب"},{"id":9,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":10,"arabic":"مِن","translit":"nِm","roo