 "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لرَّحِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 30, "ayah": 6, "text": "وَعْدَ اَ۬للَّهِ لَا يُخْلِفُ اُ۬للَّهُ وَعْدَهُۥۖ وَلَٰكِنَّ أَكْثَرَ اَ۬لنَّاسِ لَا يَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "وَعْدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يُخْلِفُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬للَّهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَعْدَهُۥۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَٰكِنَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَكْثَرَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لنَّاسِ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَا", "translit": "", "root": ""}, {"id": 11, "arabic": "يَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 30, "ayah": 7, "text": "يَعْلَمُونَ ظَٰهِراࣰ مِّنَ اَ۬لْحَيَوٰةِ اِ۬لدُّنْي۪ا وَهُمْ عَنِ اِ۬لَاخِرَةِ هُمْ غَٰفِلُونَۖ", "words": [{"id": 1, "arabic": "يَعْلَمُونَ", "translit": "", "root": ""}, {"id": 2, "arabic": "ظَٰهِراࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْحَيَوٰةِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لدُّنْي۪ا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَنِ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لَاخِرَةِ", "translit": "", "root": ""}, {"id": 9, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "غَٰفِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 30, "ayah": 8, "text": "أَوَلَمْ يَتَفَكَّرُواْ فِےٓ أَنفُسِهِمۖ مَّا خَلَقَ اَ۬للَّهُ اُ۬لسَّمَٰوَٰتِ وَالَارْضَ وَمَا بَيْنَهُمَآ إِلَّا بِالْحَقِّ وَأَجَلࣲ مُّسَمّيࣰۖ وَإِنَّ كَثِيراࣰ مِّنَ اَ۬لنَّاسِ بِلِقَآءِ رَبِّهِمْ لَكَٰفِرُونَ