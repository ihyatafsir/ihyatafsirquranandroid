َكُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 30, "ayah": 56, "text": "وَقَالَ اَ۬لذِينَ أُوتُواْ اُ۬لْعِلْمَ وَالِايمَٰنَ لَقَدْ لَبِثْتُمْ فِے كِتَٰبِ اِ۬للَّهِ إِلَيٰ يَوْمِ اِ۬لْبَعْثِۖ فَهَٰذَا يَوْمُ اُ۬لْبَعْثِ وَلَٰكِنَّكُمْ كُنتُمْ لَا تَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُوتُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْعِلْمَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَالِايمَٰنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَقَدْ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَبِثْتُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "كِتَٰبِ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 12, "arabic": "يَوْمِ", "translit": "", "root": ""}, {"id": 13, "arabic": "اِ۬لْبَعْثِۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "فَهَٰذَا", "translit": "", "root": ""}, {"id": 15, "arabic": "يَوْمُ", "translit": "", "root": ""}, {"id": 16, "arabic": "اُ۬لْبَعْثِ", "translit": "", "root": ""}, {"id": 17, "arabic": "وَلَٰكِنَّكُمْ", "translit": "", "root": ""}, {"id": 18, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 19, "arabic": "لَا", "translit": "", "root": ""}, {"id": 20, "arabic": "تَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 30, "ayah": 57, "text": "فَيَوْمَئِذࣲ لَّا تَنفَعُ اُ۬لذِينَ ظَلَمُواْ مَعْذِرَتُهُمْ وَلَا هُمْ يُسْتَعْتَبُونَۖ", "words": [{"id": 1, "arabic": "فَيَوْمَئِذࣲ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "تَنفَعُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "ظَلَمُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَعْذِرَتُهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 8, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "يُسْتَعْتَبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 30, "ayah": 58, "text": "وَلَقَد ضَّرَبْنَا لِلنَّاسِ فِے هَٰذَا اَ۬لْقُرْءَانِ مِن كُلِّ مَثَلࣲۖ وَلَئِن جِئْتَهُم بِـَٔايَةࣲ لَّيَقُولَنَّ اَ۬لذِينَ كَفَرُوٓاْ إِنَ اَنتُمُۥٓ إِلَّا مُبْطِلُونَۖ", "words": [{"id": 1, "arabic": "وَلَقَد", "translit": "", "root": ""}, {"id": 2, "arabic": "ضَّرَبْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لِلنَّاسِ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْقُرْءَانِ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِن", "translit": "", "root": ""}, {"id": 8, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَثَلࣲۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَلَئِن", "translit": "", "root": ""}, {"id": 11, "arabic": "جِئْتَهُم", "translit": "", "root": ""}, {"id": 12, "arabic": "بِـَٔايَةࣲ", "translit": "", "root": ""}, {"id": 13, "arabic": "لَّيَقُولَنَّ", "translit": "", "root": ""}, {"id": 14, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 15, "arabic": "كَفَرُوٓاْ", "translit": "", "root": ""}, {"id": 16, "arabic": "إِنَ", "translit": "", "root": ""}, {"id": 17, "arabic": "اَنتُمُۥٓ", "translit": "", "root": ""}, {"id": 18, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 19, "arabic": "مُبْطِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 30, "ayah": 59, "text": "كَذَٰلِكَ يَطْبَعُ اُ۬للَّهُ عَلَيٰ قُلُوبِ اِ۬لذِينَ لَا يَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "كَذَٰلِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَطْبَعُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬للَّهُ", "translit": "", "root":