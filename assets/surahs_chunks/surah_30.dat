:"لِيُذِيقَهُم","translit":"mُhَqyِhdُyِl","root":"ذوق"},{"id":11,"arabic":"بَعْضَ","translit":"َḍْʿعَb","root":"بعض"},{"id":12,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":13,"arabic":"عَمِلُوا۟","translit":"۟āwُlِmَʿع","root":"عمل"},{"id":14,"arabic":"لَعَلَّهُمْ","translit":"ْmُhَّlَʿعَl","root":""},{"id":15,"arabic":"يَرْجِعُونَ","translit":"َnwُʿعِjgْrَy","root":"رجع"}],"hasIhya":false},{"ayah":42,"text":"قُلْ سِيرُوا۟ فِى ٱلْأَرْضِ فَٱنظُرُوا۟ كَيْفَ كَانَ عَٰقِبَةُ ٱلَّذِينَ مِن قَبْلُۚ كَانَ أَكْثَرُهُم مُّشْرِكِينَ ","translation":"Say, [O Muḥammad], \"Travel through the land and observe how was the end of those before. Most of them were associators [of others with Allāh].","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"سِيرُوا۟","translit":"۟āwُryِs","root":"سير"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":5,"arabic":"فَٱنظُرُوا۟","translit":"۟āwُrُẓnٱَf","root":"نظر"},{"id":6,"arabic":"كَيْفَ","translit":"َfْyَk","root":"كيف"},{"id":7,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":8,"arabic":"عَٰقِبَةُ","translit":"ُẗَbِqَٰʿع","root":"عقب"},{"id":9,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":10,"arabic":"مِن","translit":"nِm","root":""},{"id":11,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":12,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":13,"arabic":"أَكْثَرُهُم","translit":"mُhُrَhtْkَaʾ","root":"كثر"},{"id":14,"arabic":"مُّشْرِكِينَ","translit":"َnyِkِrْhsُّm","root":"شرك"}],"hasIhya":false},{"ayah":43,"text":"فَأَقِمْ وَجْهَكَ لِلدِّينِ ٱلْقَيِّمِ مِن قَبْلِ أَن يَأْتِىَ يَوْمٌ لَّا مَرَدَّ لَهُۥ مِنَ ٱللَّهِۖ يَوْمَئِذٍ يَصَّدَّعُونَ ","translation":"So direct your face [i.e., self] toward the correct religion before a Day comes from Allāh of which there is no repelling. That Day, they will be divided.[1]","words":[{"id":1,"arabic":"فَأَقِمْ","translit":"ْmِqَaʾَf","root":"قوم"},{"id":2,"arabic":"وَجْهَكَ","translit":"َkَhْjgَw","root":"وجه"},{"id":3,"arabic":"لِلدِّينِ","translit":"ِnyِّdlِl","root":"دين"},{"id":4,"arabic":"ٱلْقَيِّمِ","translit":"ِmِّyَqْlٱ","root":"قوم"},{"id":5,"arabic":"مِن","translit":"nِm","root":""},{"id":6,"arabic":"قَبْلِ","translit":"ِlْbَq","root":"قبل"},{"id":7,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":8,"arabic":"يَأْتِىَ","translit":"َàِtْaʾَy","root":"اتي"},{"id":9,"arabic":"يَوْمٌ","translit":"ٌmْwَy","root":"يوم"},{"id":10,"arabic":"لَّا","translit":"āَّl","root":""},{"id":11,"arabic":"مَرَدَّ","translit":"َّdَrَm","root":"ردد"},{"id":12,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":13,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":14,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":15,"arabic":"يَوْمَئِذٍ","translit":"ٍhdِyʾَmْwَy","root":"يوم"},{"id":16,"arabic":"يَصَّدَّعُونَ","translit":"َnwُʿعَّdَّṣَy","root":"صدع"}],"hasIhya":true},{"ayah":44,"text":"مَن كَفَرَ فَعَلَيْهِ كُفْرُهُۥۖ وَمَنْ عَمِلَ صَٰلِحًا فَلِأَنفُسِهِمْ يَمْهَدُونَ ","translation":"Whoever disbelieves - upon him is [the consequence of] his disbelief. And whoever does righteousness - they are for themselves preparing,","words":[{"id":1,"arabic":"مَن","translit":"nَm","root":""},{"id":2,"arabic":"كَفَرَ","translit":"َrَfَk","root":"كفر"},{"id":3,"arabic":"فَعَلَيْهِ","translit":"ِhْyَlَʿعَf","root":""},{"id":4,"arabic":"كُفْرُهُۥ","translit":"ۥُhُrْfُk","root":"كفر"},{"id":5,"arabic":"وَمَنْ","translit":"ْnَmَw","root":""},{"id":6,"arabic":"عَمِلَ","translit":"َlِmَʿع","root":"عمل"},{"id":7,"arabic":"صَٰلِحًا","translit":"āًḥِlَٰṣ","root":"صلح"},{"id":8,"arabic":"فَلِأَنفُسِهِمْ","translit":"ْmِhِsُfnَaʾِlَf","root":"نفس"},{"id":9,"arabic":"يَمْهَدُونَ","translit":"َnwُdَhْmَy","root":"مهد"}],"hasIhya":false},{"ayah":45,"text":"لِيَجْزِىَ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ مِن فَضْلِهِۦٓۚ إِنَّهُۥ لَا يُحِبُّ ٱلْكَٰفِرِينَ ","translation":"That He may reward those who have believed and done righteous deeds out of His bounty. Indeed, He does not like the disbelievers.","words":[{"id":1,"arabic":"لِيَجْزِىَ","translit":"َàِzْjgَyِl","root":"جزي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":5,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":6,"arabic":"مِن","translit":"nِm","root":""},{"id":7,"arabic":"فَضْلِهِۦٓ","translit":"ٓۦِhِlْḍَf","root":"فضل"},{"id":8,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":9,"arabic":"لَا","translit":"āَl","root":""},{"id":10,"arabic":"يُحِبُّ","translit":"ُّbِḥُy","root":"حبب"},{"id":11,"arabic":"ٱلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlٱ","root":"كفر"}],"hasIhya":false},{"ayah":46,"text":"وَمِنْ ءَايَٰتِهِۦٓ أَن يُرْسِلَ ٱلرِّيَاحَ مُبَشِّرَٰتٍ وَلِيُذِيقَكُم مِّن رَّحْمَتِهِۦ وَلِتَجْرِىَ ٱلْفُلْكُ بِأَمْرِهِۦ وَلِتَبْتَغُوا۟ مِن فَضْلِهِۦ وَلَعَلَّكُمْ تَشْكُرُونَ ","translation":"And of His signs is that He sends the winds as bringers of good tidings and to let you taste His mercy [i.e., rain] and so the ships may sail at His command and so you may seek of His bounty, and perhaps you will be grateful.","words":[{"id":1,"arabic":"وَمِنْ","translit":"ْnِmَw","root":""},{"id":2,"arabic":"ءَايَٰتِهِۦٓ","translit":"ٓۦِhِtَٰyāَء","root":"ايي"},{"id":3,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":4,"arabic":"يُرْسِلَ","translit":"َlِsْrُy","root":"رسل"},{"id":5,"arabic":"ٱلرِّيَاحَ","translit":"َḥāَyِّrlٱ","root":"روح"},{"id":6,"arabic":"مُبَشِّرَٰتٍ","translit":"ٍtَٰrِّhsَbُm","root":"بشر"},{"id":7,"arabic":"وَلِيُذِيقَكُم","translit":"mُkَqyِhdُyِlَw","root":"ذوق"},{"id":8,"arabic":"مِّن","translit":"nِّm","root":""},{"id":9,"arabic":"رَّحْمَتِهِۦ","translit":"ۦِhِtَmْḥَّr","root":"رحم"},{"id":10,"arabic":"وَلِتَجْرِىَ","translit":"َàِrْjgَtِlَw","root":"جري"},{"id":11,"arabic":"ٱلْفُلْكُ","translit":"ُkْlُfْlٱ","root":"فلك"},{"id":12,"arabic":"بِأَمْرِهِۦ","translit":"ۦِhِrْmَaʾِb","root":"امر"},{"id":13,"arabic":"وَلِتَبْتَغُوا۟","translit":"۟āwُغَtْbَtِlَw","root":"بغي"},{"id":14,"arabic":"مِن","translit":"nِm","root":""},{"id":15,"arabic":"فَضْلِهِۦ","translit":"ۦِhِlْḍَf","root":"فضل"},{"id":16,"arabic":"وَلَعَلَّكُمْ","translit":"ْmُkَّlَʿعَlَw","root":""},{"id":17,"arabic":"تَشْكُرُونَ","translit":"َnwُrُkْhsَt","root":"شكر"}],"hasIhya":false},{"ayah":47,"text":"وَلَقَدْ أَرْسَلْنَا مِن قَبْلِكَ رُسُلًا إِلَىٰ قَوْمِهِمْ فَجَآءُوهُم بِٱلْبَيِّنَٰتِ فَٱنتَقَمْنَا مِنَ ٱلَّذِينَ أَجْرَمُوا۟ۖ وَكَانَ حَقًّا عَلَيْنَا نَصْرُ ٱلْمُؤْمِنِينَ ","translation":"And We have already sent messengers before you to their peoples, and they came to them with clear evidences; then We took retribution from those who committed crimes, and incumbent upon Us was support[1] of the believers.","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"أَرْسَلْنَا","translit":"āَnْlَsْrَaʾ","root":"رسل"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"قَبْلِكَ","translit":"َkِlْbَq","root":"قبل"},{"id":5,"arabic":"رُسُلًا","translit":"āًlُsُr","root":"رسل"},{"id":6,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":7,"arabic":"قَوْمِهِمْ","translit":"ْmِhِmْwَq","root":"قوم"},{"id":8,"arabic":"فَجَآءُوهُم","translit":"mُhwُءٓāَjgَf","root":"جيا"},{"id":9,"arabic":"بِٱلْبَيِّنَٰتِ","translit":"ِtَٰnِّyَbْlٱِb","root":"بين"},{"id":10,"arabic":"فَٱنتَقَمْنَا","translit":"āَnْmَqَtnٱَf","root":"نقم"},{"id":11,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":12,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":13,"arabic":"أَجْرَمُوا۟","translit":"۟āwُmَrْjgَaʾ","root":"جرم"},{"id":14,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":15,"arabic":"حَقًّا","translit":"āًّqَḥ","root":"حقق"},{"id":16,"arabic":"عَلَيْنَا","translit":"āَnْyَlَʿع","root":""},{"id":17,"arabic":"نَصْرُ","translit":"ُrْṣَn","root":"نصر"},{"id":18,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"}],"hasIhya":false},{"ayah":48,"text":"ٱللَّهُ ٱلَّذِى يُرْسِلُ ٱلرِّيَٰحَ فَتُثِيرُ سَحَابًا فَيَبْسُطُهُۥ فِى ٱلسَّمَآءِ كَيْفَ يَشَآءُ وَيَجْعَلُهُۥ كِسَفًا فَتَرَى ٱلْوَدْقَ يَخْرُجُ مِنْ خِلَٰلِهِۦۖ فَإِذَآ أَصَابَ بِهِۦ مَن يَشَآءُ مِنْ عِبَادِهِۦٓ إِذَا هُمْ يَسْتَبْشِرُونَ ","translation":"It is Allāh who sends the winds, and they stir the clouds and spread them in the sky however He wills, and He makes them fragments so you see the rain emerge from within them. And when He causes it to fall upon whom He wills of His servants, immediately they rejoice","words":[{"id":1,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"يُرْسِلُ","translit":"ُlِsْrُy","root":"رسل"},{"id":4,"arabic":"ٱلرِّيَٰحَ","translit":"َḥَٰyِّrlٱ","root":"روح"},{"id":5,"arabic":"فَتُثِيرُ","translit":"ُryِhtُtَf","root":"ثور"},{"id":6,"arabic":"سَحَابًا","translit":"āًbāَḥَs","root":"سحب"},{"id":7,"arabic":"فَيَبْسُطُهُۥ","translit":"ۥُhُṭُsْbَyَf","root":"بسط"},{"id":8,"arabic":"فِى","translit":"àِf","root":""},{"id":9,"arabic":"ٱلسَّمَآءِ","translit":"ِءٓāَmَّslٱ","root":"سمو"},{"id":10,"arabic":"كَيْفَ","translit":"َfْyَk","root":"كيف"},{"id":11,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":12,"arabic":"وَيَجْعَلُهُۥ","translit":"ۥُhُlَʿعْjgَyَw","root":"جعل"},{"id":13,"arabic":"كِسَفًا","translit":"āًfَsِk","root":"كسف"},{"id":14,"arabic":"فَتَرَى","translit":"àَrَtَf","root":"راي"},{"id":15,"arabic":"ٱلْوَدْقَ","translit":"َqْdَwْlٱ","root":"ودق"},{"id":16,"arabic":"يَخْرُجُ","translit":"ُjgُrْhkَy","root":"خرج"},{"id":17,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":18,"arabic":"خِلَٰلِهِۦ","translit":"ۦِhِlَٰlِhk","root":"خلل"},{"id":19,"arabic":"فَإِذَآ","translit":"ٓāَhdِiʾَf","root":""},{"id":20,"arabic":"أَصَابَ","translit":"َbāَṣَaʾ","root":"صوب"},{"id":21,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":22,"arabic":"مَن","translit":"nَm","root":""},{"id":23,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":24,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":25,"arabic":"عِبَادِهِۦٓ","translit":"ٓۦِhِdāَbِʿع","root":"عبد"},{"id":26,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":27,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":28,"arabic":"يَسْتَبْشِرُونَ","translit":"َnwُrِhsْbَtْsَy","root":"بشر"}],"hasIhya":false},{"ayah":49,"text":"وَإِن كَانُوا۟ مِن قَبْلِ أَن يُنَزَّلَ عَلَيْهِم مِّن قَبْلِهِۦ لَمُبْلِسِينَ ","translation":"Although they were, before it was sent down upon them - before that, in despair.","words":[{"id":1,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":2,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"قَبْلِ","translit":"ِlْbَq","root":"قبل"},{"id":5,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":6,"arabic":"يُنَزَّلَ","translit":"َlَّzَnُy","root":"نزل"},{"id":7,"arabic":"عَلَيْهِم","translit":"mِhْyَlَʿع","root":""},{"id":8,"arabic":"مِّن","translit":"nِّm","root":""},{"id":9,"arabic":"قَبْلِهِۦ","translit":"ۦِhِlْbَq","root":"قبل"},{"id":10,"arabic":"لَمُبْلِسِينَ","translit":"َnyِsِlْbُmَl","root":"بلس"}],"hasIhya":false},{"ayah":50,"text":"فَٱنظُرْ إِلَىٰٓ ءَاثَٰرِ رَحْمَتِ ٱللَّهِ كَيْفَ يُحْىِ ٱلْأَرْضَ بَعْدَ مَوْتِهَآۚ إِنَّ ذَٰلِكَ لَمُحْىِ ٱلْمَوْتَىٰۖ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ","translation":"So observe the effects of the mercy of Allāh - how He gives life to the earth after its lifelessness. Indeed, that [same one] will give life to the dead, and He is over all things competent.","words":[{"id":1,"arabic":"فَٱنظُرْ","translit":"ْrُẓnٱَf","root":"نظر"},{"id":2,"arabic":"إِلَىٰٓ","translit":"ٰٓàَlِiʾ","root":""},{"id":3,"arabic":"ءَاثَٰرِ","translit":"ِrَٰhtāَء","root":"اثر"},{"id":4,"arabic":"رَحْمَتِ","translit":"ِtَmْḥَr","root":"رحم"},{"id":5,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":6,"arabic":"كَيْفَ","translit":"َfْyَk","root":"كيف"},{"id":7,"arabic":"يُحْىِ","translit":"ِàْḥُy","root":"حيي"},{"id":8,"arabic":"ٱلْأَرْضَ","translit":"َḍْrَaʾْlٱ","root":"ارض"},{"id":9,"arabic":"بَعْدَ","translit":"َdْʿعَb","root":"بعد"},{"id":10,"arabic":"مَوْتِهَآ","translit":"ٓāَhِtْwَm","root":"موت"},{"id":11,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":12,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":13,"arabic":"لَمُحْىِ","translit":"ِàْḥُmَl","root":"حيي"},{"id":14,"arabic":"ٱلْمَوْتَىٰ","translit":"ٰàَtْwَmْlٱ","root":"موت"},{"id":15,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":16,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":17,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":18,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":19,"arabic":"قَدِيرٌ","translit":"ٌryِdَq","root":"قدر"}],"hasIhya":true},{"ayah":51,"text":"وَلَئِنْ أَرْسَلْنَا رِيحًا فَرَأَوْهُ مُصْفَرًّا لَّظَلُّوا۟ مِنۢ بَعْدِهِۦ يَكْفُرُونَ ","translation":"But if We should send a [bad] wind and they saw [their crops] turned yellow, they would remain thereafter disbelievers.[1]","words":[{"id":1,"arabic":"وَلَئِنْ","translit":"ْnِyʾَlَw","root":""},{"id":2,"arabic":"أَرْسَلْنَا","translit":"āَnْlَsْrَaʾ","root":"رسل"},{"id":3,"arabic":"رِيحًا","translit":"āًḥyِr","root":"روح"},{"id":4,"arabic":"فَرَأَوْهُ","translit":"ُhْwَaʾَrَf","root":"راي"},{"id":5,"arabic":"مُصْفَرًّا","translit":"āًّrَfْṣُm","root":"صفر"},{"id":6,"arabic":"لَّظَلُّوا۟","translit":"۟āwُّlَẓَّl","root":"ظلل"},{"id":7,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":8,"arabic":"بَعْدِهِۦ","translit":"ۦِhِdْʿعَb","root":"بعد"},{"id":9,"arabic":"يَكْفُرُونَ","translit":"َnwُrُfْkَy","root":"كفر"}],"hasIhya":false},{"ayah":52,"text":"فَإِنَّكَ لَا تُسْمِعُ ٱلْمَوْتَىٰ وَلَا تُسْمِعُ ٱلصُّمَّ ٱلدُّعَآءَ إِذَا وَلَّوْا۟ مُدْبِرِينَ ","translation":"So indeed, you will not make the dead hear, nor will you make the deaf hear the call when they turn their backs, retreating.","words":[{"id":1,"arabic":"فَإِنَّكَ","translit":"َkَّnِiʾَf","root":""},{"id":2,"arabic":"لَا","translit":"āَl","root":""},{"id":3,"arabic":"تُسْمِعُ","translit":"ُʿعِmْsُt","root":"سمع"},{"id":4,"arabic":"ٱلْمَوْتَىٰ","translit":"ٰàَtْwَmْlٱ","root":"موت"},{"id":5,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":6,"arabic":"تُسْمِعُ","translit":"ُʿعِmْsُt","root":"سمع"},{"id":7,"arabic":"ٱلصُّمَّ","translit":"َّmُّṣlٱ","root":"صمم"},{"id":8,"arabic":"ٱلدُّعَآءَ","translit":"َءٓāَʿعُّdlٱ","root":"دعو"},{"id":9,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":10,"arabic":"وَلَّوْا۟","translit":"۟āْwَّlَw","root":"ولي"},{"id":11,"arabic":"مُدْبِرِينَ","translit":"َnyِrِbْdُm","root":"دبر"}],"hasIhya":false},{"ayah":53,"text":"وَمَآ أَنتَ بِهَٰدِ ٱلْعُمْىِ عَن ضَلَٰلَتِهِمْۖ إِن تُسْمِعُ إِلَّا مَن يُؤْمِنُ بِـَٔايَٰتِنَا فَهُم مُّسْلِمُونَ ","translation":"And you cannot guide the blind away from their error. You will only make hear those who believe in Our verses so they are Muslims [in submission to Allāh].","words":[{"id":1,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":2,"arabic":"أَنتَ","translit":"َtnَaʾ","root":""},{"id":3,"arabic":"بِهَٰدِ","translit":"ِdَٰhِb","root":"هدي"},{"id":4,"arabic":"ٱلْعُمْىِ","translit":"ِàْmُʿعْlٱ","root":"عمي"},{"id":5,"arabic":"عَن","translit":"nَʿع","root":""},{"id":6,"arabic":"ضَلَٰلَتِهِمْ","translit":"ْmِhِtَlَٰlَḍ","root":"ضلل"},{"id":7,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":8,"arabic":"تُسْمِعُ","translit":"ُʿعِmْsُt","root":"سمع"},{"id":9,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":10,"arabic":"مَن","translit":"nَm","root":""},{"id":11,"arabic":"يُؤْمِنُ","translit":"ُnِmْwʾُy","root":"امن"},{"id":12,"arabic":"بِـَٔايَٰتِنَا","translit":"āَnِtَٰyāَٔـِb","root":"ايي"},{"id":13,"arabic":"فَهُم","translit":"mُhَf","root":""},{"id":14,"arabic":"مُّسْلِمُونَ","translit":"َnwُmِlْsُّm","root":"سلم"}],"hasIhya":false},{"ayah":54,"text":"ٱللَّهُ ٱلَّذِى خَلَقَكُم مِّن ضَعْفٍ ثُمَّ جَعَلَ مِنۢ بَعْدِ ضَعْفٍ قُوَّةً ثُمَّ جَعَلَ مِنۢ بَعْدِ قُوَّةٍ ضَعْفًا وَشَيْبَةًۚ يَخْلُقُ مَا يَشَآءُۖ وَهُوَ ٱلْعَلِيمُ ٱلْقَدِيرُ ","translation":"Allāh is the one who created you from weakness, then made after weakness strength, then made after strength weakness and white hair. He creates what He wills, and He is the Knowing, the Competent.","words":[{"id":1,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"خَلَقَكُم","translit":"mُkَqَlَhk","root":"خلق"},{"id":4,"arabic":"مِّن","translit":"nِّm","root":""},{"id":5,"arabic":"ضَعْفٍ","translit":"ٍfْʿعَḍ","root":"ضعف"},{"id":6,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":7,"arabic":"جَعَلَ","translit":"َlَʿعَjg","root":"جعل"},{"id":8,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":9,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":10,"arabic":"ضَعْفٍ","translit":"ٍfْʿعَḍ","root":"ضعف"},{"id":11,"arabic":"قُوَّةً","translit":"ًẗَّwُq","root":"قوي"},{"id":12,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":13,"arabic":"جَعَلَ","translit":"َlَʿعَjg","root":"جعل"},{"id":14,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":15,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":16,"arabic":"قُوَّةٍ","translit":"ٍẗَّwُq","root":"قوي"},{"id":17,"arabic":"ضَعْفًا","translit":"āًfْʿعَḍ","root":"ضعف"},{"id":18,"arabic":"وَشَيْبَةً","translit":"ًẗَbْyَhsَw","root":"شيب"},{"id":19,"arabic":"يَخْلُقُ","translit":"ُqُlْhkَy","root":"خلق"},{"id":20,"arabic":"مَا","translit":"āَm","root":""},{"id":21,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":22,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":23,"arabic":"ٱلْعَلِيمُ","translit":"ُmyِlَʿعْlٱ","root":"علم"},{"id":24,"arabic":"ٱلْقَدِيرُ","translit":"ُryِdَqْlٱ","root":"قدر"}],"hasIhya":false},{"ayah":55,"text":"وَيَوْمَ تَقُومُ ٱلسَّاعَةُ يُقْسِمُ ٱلْمُجْرِمُونَ مَا لَبِثُوا۟ غَيْرَ سَاعَةٍۚ كَذَٰلِكَ كَانُوا۟ يُؤْفَكُونَ ","translation":"And the Day the Hour appears the criminals will swear they had remained but an hour. Thus they were deluded.","words":[{"id":1,"arabic":"وَيَوْمَ","translit":"َmْwَyَw","root":"يوم"},{"id":2,"arabic":"تَقُومُ","translit":"ُmwُqَt","root":"قوم"},{"id":3,"arabic":"ٱلسَّاعَةُ","translit":"ُẗَʿعāَّslٱ","root":"سوع"},{"id":4,"arabic":"يُقْسِمُ","translit":"ُmِsْqُy","root":"قسم"},{"id":5,"arabic":"ٱلْمُجْرِمُونَ","translit":"َnwُmِrْjgُmْlٱ","root":"جرم"},{"id":6,"arabic":"مَا","translit":"āَm","root":""},{"id":7,"arabic":"لَبِثُوا۟","translit":"۟āwُhtِbَl","root":"لبث"},{"id":8,"arabic":"غَيْرَ","translit":"َrْyَغ","root":"غير"},{"id":9,"arabic":"سَاعَةٍ","translit":"ٍẗَʿعāَs","root":"سوع"},{"id":10,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":11,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":12,"arabic":"يُؤْفَكُونَ","translit":"َnwُkَfْwʾُy","root":"افك"}],"hasIhya":false},{"ayah":56,"text":"وَقَالَ ٱلَّذِينَ أُوتُوا۟ ٱلْعِلْمَ وَٱلْإِيمَٰنَ لَقَدْ لَبِثْتُمْ فِى كِتَٰبِ ٱللَّهِ إِلَىٰ يَوْمِ ٱلْبَعْثِۖ فَهَٰذَا يَوْمُ ٱلْبَعْثِ وَلَٰكِنَّكُمْ كُنتُمْ لَا تَعْلَمُونَ ","translation":"But those who were given knowledge and faith will say, \"You remained the extent of Allāh's decree until the Day of Resurrection, and this is the Day of Resurrection, but you did not used to know.\"[1]","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"أُوتُوا۟","translit":"۟āwُtwُaʾ","root":"اتي"},{"id":4,"arabic":"ٱلْعِلْمَ","translit":"َmْlِʿعْlٱ","root":"علم"},{"id":5,"arabic":"وَٱلْإِيمَٰنَ","translit":"َnَٰmyِiʾْlٱَw","root":"امن"},{"id":6,"arabic":"لَقَدْ","translit":"ْdَqَl","root":""},{"id":7,"arabic":"لَبِثْتُمْ","translit":"ْmُtْhtِbَl","root":"لبث"},{"id":8,"arabic":"فِى","translit":"àِf","root":""},{"id":9,"arabic":"كِتَٰبِ","translit":"ِbَٰtِk","root":"كتب"},{"id":10,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":11,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":12,"arabic":"يَوْمِ","translit":"ِmْwَy","root":"يوم"},{"id":13,"arabic":"ٱلْبَعْثِ","translit":"ِhtْʿعَbْlٱ","root":"بعث"},{"id":14,"arabic":"فَهَٰذَا","translit":"āَhdَٰhَf","root":""},{"id":15,"arabic":"يَوْمُ","translit":"ُmْwَy","root":"يوم"},{"id":16,"arabic":"ٱلْبَعْثِ","translit":"ِhtْʿعَbْlٱ","root":"بعث"},{"id":17,"arabic":"وَلَٰكِنَّكُمْ","translit":"ْmُkَّnِkَٰlَw","root":""},{"id":18,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":19,"arabic":"لَا","translit":"āَl","root":""},{"id":20,"arabic":"تَعْلَمُونَ","translit":"َnwُmَlْʿعَt","root":"علم"}],"hasIhya":false},{"ayah":57,"text":"فَيَوْمَئِذٍ لَّا يَنفَعُ ٱلَّذِينَ ظَلَمُوا۟ مَعْذِرَتُهُمْ وَلَا هُمْ يُسْتَعْتَبُونَ ","translation":"So that Day, their excuse will not benefit those who wronged, nor will they be asked to appease [Allāh].","words":[{"id":1,"arabic":"فَيَوْمَئِذٍ","translit":"ٍhdِyʾَmْwَyَf","root":"يوم"},{"id":2,"arabic":"لَّا","translit":"āَّl","root":""},{"id":3,"arabic":"يَنفَعُ","translit":"ُʿعَfnَy","root":"نفع"},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"ظَلَمُوا۟","translit":"۟āwُmَlَẓ","root":"ظلم"},{"id":6,"arabic":"مَعْذِرَتُهُمْ","translit":"ْmُhُtَrِhdْʿعَm","root":"عذر"},{"id":7,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":8,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":9,"arabic":"يُسْتَعْتَبُونَ","translit":"َnwُbَtْʿعَtْsُy","root":"عتب"}],"hasIhya":false},{"ayah":58,"text":"وَلَقَدْ ضَرَبْنَا لِلنَّاسِ فِى هَٰذَا ٱلْقُرْءَانِ مِن كُلِّ مَثَلٍۚ وَلَئِن جِئْتَهُم بِـَٔايَةٍ لَّيَقُولَنَّ ٱلَّذِينَ كَفَرُوٓا۟ إِنْ أَنتُمْ إِلَّا مُبْطِلُونَ ","translation":"And We have certainly presented to the people in this Qur’ān from every [kind of] example. But, [O Muḥammad], if you should bring them a sign, the disbelievers will surely say, \"You [believers] are but falsifiers.\"","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"ضَرَبْنَا","translit":"āَnْbَrَḍ","root":"ضرب"},{"id":3,"arabic":"لِلنَّاسِ","translit":"ِsāَّnlِl","root":"انس"},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":6,"arabic":"ٱلْقُرْءَانِ","translit":"ِnāَءْrُqْlٱ","root":"قرا"},{"id":7,"arabic":"مِن","translit":"nِm","root":""},{"id":8,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":9,"arabic":"مَثَلٍ","translit":"ٍlَhtَm","root":"مثل"},{"id":10,"arabic":"وَلَئِن","translit":"nِyʾَlَw","root":""},{"id":11,"arabic":"جِئْتَهُم","translit":"mُhَtْyʾِjg","root":"جيا"},{"id":12,"arabic":"بِـَٔايَةٍ","translit":"ٍẗَyāَٔـِb","root":"ايي"},{"id":13,"arabic":"لَّيَقُولَنَّ","translit":"َّnَlwُqَyَّl","root":"قول"},{"id":14,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":15,"arabic":"كَفَرُوٓا۟","translit":"۟āٓwُrَfَk","root":"كفر"},{"id":16,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":17,"arabic":"أَنتُمْ","translit":"ْmُtnَaʾ","root":""},{"id":18,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":19,"arabic":"مُبْطِلُونَ","translit":"َnwُlِṭْbُm","root":"بطل"}],"hasIhya":false},{"ayah":59,"text":"كَذَٰلِكَ يَطْبَعُ ٱللَّهُ عَلَىٰ قُلُوبِ ٱلَّذِينَ لَا يَعْلَمُونَ ","translation":"Thus does Allāh seal the hearts of those who do not know.[1]","words":[{"id":1,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":2,"arabic":"يَطْبَعُ","translit":"ُʿعَbْṭَy","root":"طبع"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":5,"arabic":"قُلُوبِ","translit":"ِbwُlُq","root":"قلب"},{"id":6,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":7,"arabic":"لَا","translit":"āَl","root":""},{"id":8,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":false},{"ayah":60,"text":"فَٱصْبِرْ إِنَّ وَعْدَ ٱللَّهِ حَقٌّۖ وَلَا يَسْتَخِفَّنَّكَ ٱلَّذِينَ لَا يُوقِنُونَ ","translation":"So be patient. Indeed, the promise of Allāh is truth. And let them not disquiet you who are not certain [in faith].","words":[{"id":1,"arabic":"فَٱصْبِرْ","translit":"ْrِbْṣٱَf","root":"صبر"},{"id":2,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":3,"arabic":"وَعْدَ","translit":"َdْʿعَw","root":"وعد"},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"حَقٌّ","translit":"ٌّqَḥ","root":"حقق"},{"id":6,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":7,"arabic":"يَسْتَخِفَّنَّكَ","translit":"َkَّnَّfِhkَtْsَy","root":"خفف"},{"id":8,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":9,"arabic":"لَا","translit":"āَl","root":""},{"id":10,"arabic":"يُوقِنُونَ","translit":"َnwُnِqwُy","root":"يقن"}],"hasIhya":false}],"tafsir":{"1":[{"arabic":"رؤوسكم ومقصرين وكقوله ألم غلبت الروم في أدنى الأرض وهم من بعد غلبهم سيغلبون في بضع سنين ووجه دلالة المعجزة على صدق الرسل أن كل ما عجز عنه البشر لم يكن إلا فعلا لله تعالى فمهما كان مقرونا بتحدي النبي صلى الله عليه وسلم ينزل منزلة قوله صدقت وذلك مثل القائل بين يدي 2 الملك المدعي على رعيته أنه رسول الملك إليهم فإنه مهما قال لذلك إن كنت صادقا فقم على سريرك ثلاثا واقعد على خلاف عادتك ففعل الملك ذلك حصل للحاضرين علم ضروري بأن ذلك نازل منزلة قوله صدقت الركن الرابع في السمعيات وتصديقه صلى الله عليه وسلم فيما أخبر عنه ومداره على عشرة أص","english":"For they, despite their distinction in eloquence and rhetorical perfection, aimed at reviling him, forbidding him, killing him, and expelling him — as God, Mighty and Majestic, informed us about them — yet they were unable to produce anything to rival the Qur'an. For it was not within the capacity of human beings to combine the grandeur of the Qur'an's diction with its harmonious order, especially given what it contains of the accounts of the ancients, while he was illiterate, never having practiced the study of books — and [given] its announcement of the unseen in matters whose truthfulness was verified in the future, such as His saying, Exalted is He: {«لَتَدْخُلُنَّ الْمَسْجِدَ الْحَرَامَ إِنْ شَاءَ اللَّهُ آمِنِينَ مُحَلِّقِينَ رُءُوسَكُمْ وَمُقَصِّرِينَ»} (You shall surely enter the Sacred Mosque, if God wills, secure, with your heads shaved and cut short) [Al-Fatḥ 48:27], and such as His saying: {«الم غُلِبَتِ الرُّومُ فِي أَدْنَى الْأَرْضِ وَهُمْ مِنْ بَعْدِ غَلَبِهِمْ سَيَغْلِبُونَ فِي بِضْعِ سِنِينَ»} (Alif Lām Mīm. The Romans have been defeated in the nearest land, and they, after their defeat, shall be victorious within a few years) [Al-Rūm 30:1-3].","book_title":"Foundations of Belief","section_title_ar":"Section 96","section_title_en":"The Fourth Pillar: On Matters of Hearing (al-Samʿiyyāt) and the Verification of the Prophet ﷺ in What He Reported — Comprising Ten Fundamental Principles","section_index":96,"anchors":"- Root: حشر (ḥ-sh-r)\n  * Lisan / Ayn: To gather, assemble, drive together; al-ḥashr is the gathering of creation on the Day of Resurrection.\n  * Al-Raghib (Mufradat): Al-ḥashr is the bringing together of a people from their various places of dispersal; it is used specifically for the resurrection gathering.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for driving cattle together; metaphorical (majāz) for the ingathering of souls for judgment.\n- Sibawayh Rule: Rule of Conditional Protasis (al-sharṭ) — \"If you are truthful, then rise...\" (fa-in kunta ṣādiqan fa-qum...) — the apodosis (jawāb al-sharṭ) functions as the proof of the protasis, establishing necessary knowledge (ʿilm ḍarūrī).\n\n- Root: نشر (n-sh-r)\n  * Lisan / Ayn: To spread, unfold, revive after death; al-nushūr is the revivification of the dead.\n  * Al-Raghib (Mufradat): Al-nashr is the spreading of the soul back into the body after death; it is the opposite of al-ṭayy (folding up).\n  * Al-Zamakhshari (Asas): Literal for unfolding a garment; metaphorical for the resurrection when the earth \"spreads forth\" what it contains.\n- Sibawayh Rule: Rule of Coordination (al-ʿaṭf) — \"al-ḥashr wa-l-nashr\" (the gathering and the spreading) — two coordinated nouns forming a single compound concept of resurrection.\n\n- Root: مكن (m-k-n)\n  * Lisan / Ayn: To establish, empower, give firm footing; makkana means to make something firm and stable.\n  * Al-Raghib (Mufradat): Al-makān is the place that contains a thing; tamakkun is the firm establishment of a thing in its place.\n  * Al-Zamakhshari (Asas): Literal for physical placement; metaphorical for divine power — \"God is able\" (qādir) means He has full capacity and authority over all things.\n- Sibawayh Rule: Rule of Possibility (al-imkān) — \"that is possible\" (dhālika mumkin) — the predicate of possibility is established by the absence of logical contradiction, not by empirical observation.\n\n- Root: عذب (ʿ-dh-b)\n  * Lisan / Ayn: Sweet, pleasant (of water); al-ʿadhāb is the punishment that is \"sweet\" to the inflictor but bitter to the recipient — used predominantly for divine chastisement.\n  * Al-Raghib (Mufradat): Al-ʿadhāb is the infliction of pain that deters; it is specifically the painful consequence of disobedience.\n  * Al-Zamakhshari (Asas): Literal for sweet water; metaphorical (majāz) for punishment that is \"appointed\" as a deterrent.\n- Sibawayh Rule: Rule of Exception (al-istithnāʾ) — \"except as God wills\" (illā mā shāʾa) — the exception clause restricts the scope of human perception, not divine action.","content_type":"general","topic":"Classical commentary from Al-Ghazali's Ihya Ulum al-Din, from 'Foundations of Belief'","badge":"Commentary"}],"7":[{"arabic":"ظاهرا من الحياة الدنيا وهم عن الآخرة هم غافلون} وما أريد بالسمع السمع الظاهر فإن الذينأريدوا به ما كانوا معزولين عنه وإنما أريد به السمع الباطن ولا يدرك بالسمع الظاهر إلا الأصوات ويشارك الإنسان فيه سائر الحيوانات فأما السمع الباطن فيدرك به لسان الحال الذي هو نطق وراء نطق المقال يشبه قول القائل حكاية لكلام الوتد والحائط قال الجدار للوتد لم تشقني فقال سل من يدقنى ولم يتركني ورائي الحجر الذي ورائي وما من ذرة في السماوات والأرض إلا ولها أنواع شاهدات لله تعالى بالوحدانية هي","english":"I say: As for the signs of God in His earth, in contemplating them there are benefits for the discerning seeker of insight. For in them are contiguous tracts, and in them are mountains, wildernesses, seas, and varieties of animals and plants. And there is not a single thing among them but that it bears witness to God of His Oneness and glorifies Him with an eloquent tongue (lisān dhalq) that none perceives save him who gives ear while being present as a witness {«وَأَلْقَى السَّمْعَ وَهُوَ شَهِيدٌ»} (And gives ear while he is a witness) [Q. 50:37].","book_title":"Love, Longing, Intimacy and Contentment","section_title_ar":"Section 466","section_title_en":"The Book of Seclusion — The Benefits of Association and Travel: Association with Increased Occupation and Endurance of Hardships","section_index":466,"anchors":"- Root: سمع (s-m-')\n  * Lisan / Ayn: The faculty of hearing in the ear; also used for the ear itself, and metaphorically for understanding or obedience.\n  * Al-Raghib (Mufradat): \"السمع\" denotes both the physical faculty and, in theological contexts, the inner hearing of the heart by which divine truths are apprehended — distinct from mere auditory perception.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): hearing sounds. Metaphorical (Majaz): \"سمع الله لمن حمده\" (God hears him who praises Him) means acceptance and response; \"ألقى السمع\" (gave ear) implies attentive presence of heart.\n- Root: سفر (s-f-r)\n  * Lisan / Ayn: To uncover, reveal, or travel; the traveler (musāfir) is one who uncovers new horizons.\n  * Al-Raghib (Mufradat): \"السفر: كشف الغطاء\" — uncovering the veil; journeying as a means of unveiling hidden realities.\n  * Al-Zamakhshari (Asas): Literal: physical travel. Metaphorical: \"وجه مسفر\" (a face radiant with joy); the inner journey from the narrow confines of outward perception to the expanse of inner vision.\n- Root: ظهر (ẓ-h-r)\n  * Lisan / Ayn: The back; outward or visible aspect.\n  * Al-Raghib (Mufradat): Used metaphorically for the outward, apparent dimension of things, as opposed to the inner (bāṭin).\n  * Al-Zamakhshari (Asas): Literal: the back of a beast. Metaphorical: \"قلبت الأمر ظهرا لبطن\" (turned the matter over, back and belly) — examining all aspects; the visible world (ʿālam al-shahādah) as the outward face of reality.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to distinguish the exclusive nature of inner hearing (al-samʿ al-bāṭin) as the sole means of apprehending the language of states (lisān al-ḥāl), in contrast to outward hearing shared with beasts.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Love, Longing, Intimacy and Contentment'","badge":"Ethics"},{"arabic":"يبصرون ولا يسمعون لأنهم عن السمع معزولون وعن آيات ربهم محجوبون {يعلمون ظاهرا من الحياة الدنيا وهم عن الآخرة هم غافلون} وما أريد بالسمع السمع الظاهر فإن الذينأريدوا به ما كانوا معزولين عنه وإنما أريد به السمع الباطن ولا يدرك بالسمع الظاهر إلا الأصوات ويشارك الإنسان فيه سائر الحيوانات فأما السمع الباطن فيدرك به لسان الحال الذي هو نطق وراء نطق المقال يشبه قول القائل حكاية لكلام الوتد والحائط قال الجدار للوتد لم تشقني فقال سل من يدقنى ولم يتركني ورائي الحجر الذي ورائي وما من ذرة في السماوات والأرض إلا ولها أنواع شاهدات لله تعالى بالوحدانية هي توحيدها وأنواع شاهدات ل","english":"I say: As for the signs of God in His earth, in contemplating them there are benefits for the discerning seeker of insight. For in them are contiguous tracts, and in them are mountains, wildernesses, seas, and varieties of animals and plants. And there is not a single thing among them but that it bears witness to God of His Oneness and glorifies Him with an eloquent tongue (lisān dhalq) that none perceives save him who gives ear while being present as a witness {«وَأَلْقَى السَّمْعَ وَهُوَ شَهِيدٌ»} (And gives ear while he is a witness) [Q. 50:37].","book_title":"Disciplining the Soul","section_title_ar":"Section 466","section_title_en":"The Book of Seclusion — The Benefits of Association and Travel: Association with Increased Occupation and Endurance of Hardships","section_index":466,"anchors":"- Root: سمع (s-m-')\n  * Lisan / Ayn: The faculty of hearing in the ear; also used for the ear itself, and metaphorically for understanding or obedience.\n  * Al-Raghib (Mufradat): \"السمع\" denotes both the physical faculty and, in theological contexts, the inner hearing of the heart by which divine truths are apprehended — distinct from mere auditory perception.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): hearing sounds. Metaphorical (Majaz): \"سمع الله لمن حمده\" (God hears him who praises Him) means acceptance and response; \"ألقى السمع\" (gave ear) implies attentive presence of heart.\n- Root: سفر (s-f-r)\n  * Lisan / Ayn: To uncover, reveal, or travel; the traveler (musāfir) is one who uncovers new horizons.\n  * Al-Raghib (Mufradat): \"السفر: كشف الغطاء\" — uncovering the veil; journeying as a means of unveiling hidden realities.\n  * Al-Zamakhshari (Asas): Literal: physical travel. Metaphorical: \"وجه مسفر\" (a face radiant with joy); the inner journey from the narrow confines of outward perception to the expanse of inner vision.\n- Root: ظهر (ẓ-h-r)\n  * Lisan / Ayn: The back; outward or visible aspect.\n  * Al-Raghib (Mufradat): Used metaphorically for the outward, apparent dimension of things, as opposed to the inner (bāṭin).\n  * Al-Zamakhshari (Asas): Literal: the back of a beast. Metaphorical: \"قلبت الأمر ظهرا لبطن\" (turned the matter over, back and belly) — examining all aspects; the visible world (ʿālam al-shahādah) as the outward face of reality.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to distinguish the exclusive nature of inner hearing (al-samʿ al-bāṭin) as the sole means of apprehending the language of states (lisān al-ḥāl), in contrast to outward hearing shared with beasts.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Disciplining the Soul'","badge":"Ethics"}],"17":[{"arabic":"الله مخلصين له الدين الحمد لله رب العالمين فسبحان الله حين تمسون وحين تصبحون وله الحمد في السموات والأرض وعشيا وحين تظهرون يخرج الحي من الميت ويخرج الميت من الحي ويحيي الأرض بعد موتها وكذلك تخرجون ومن آياته أن خلقكم من تراب ثم إذا أنتم بشر تنتشرون اللهم إني أسألك إيمانا دائما ويقينا صادقا وعلما نافعا وقلبا خاشعا ولسانا ذاكرا وأسألك العفو والعافية والمعافاة الدائمة في الدنيا والآخرة ويصلي على محمد صلى الله عليه وسلم ويدعو الله عز وجل بما شاء من حاجته عقيب هذا الدعاء ثم ينزل ويبتدىء السعي وهو يقول رب اغفر وارحم وتجاوز عما تعلم إنك أنت الأعز الأكرم اللهم آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار ويمشي على هينة حتى ينتهي إلى الميل الأخضر وهو أول ما يلقاه إذا نزل من الصفا وهو على زاوية الم","english":"Upon ascending al-Ṣafā, he should face the House (al-Bayt) and say: \"God is Greater, God is Greater. Praise be to God for what He has guided us to. Praise be to God with all His praises, for all His graces, all of them. There is no god but God alone, with no partner. His is the dominion, and His is the praise. He gives life and causes death; in His hand is all good, and He is over all things competent. There is no god but God alone; He fulfilled His promise, aided His servant, and honored His soldiers; He alone defeated the confederates. There is no god but God, devoting religion sincerely to Him, even if the disbelievers detest it. There is no god but God, devoting religion sincerely to Him. Praise be to God, Lord of the worlds. So exalted is God when you reach the evening and when you reach the morning. And His is the praise in the heavens and the earth, and at nightfall and when you are at noon. He brings forth the living from the dead and brings forth the dead from the living, and He revives the earth after its death, and thus shall you be brought forth. And of His signs is that He created you from dust; then, behold, you are humans spreading out. O God, I ask You for enduring faith, sincere certainty, beneficial knowledge, a humble heart, and a tongue that remembers You. And I ask You for pardon, well-being, and perpetual immunity in this world and the Hereafter.\" Then he sends blessings upon Muḥammad, may God bless him and grant him peace, and supplicates God, Mighty and Majestic, with whatever need he wishes, following this supplication.","book_title":"Mysteries of Hajj","section_title_ar":"Section 204","section_title_en":"The Yemeni Corner and the Stone — The Beginning of the Saʿy and Its Rites","section_index":204,"anchors":"- Root: سعي (Saʿy)\n  * Lisan / Ayn: The root denotes striving, running, or rapid walking; it is the exertion of effort in a matter, whether good or evil.\n  * Al-Raghib (Mufradat): \"السعي: المشي السريع، وهو دون العدو، ويستعمل للجد في الأمر\" — Saʿy is swift walking, less than running, and is used for earnest exertion in a matter. In the sacred rite, it signifies the ritual traversing between al-Ṣafā and al-Marwah, an act of devotional striving.\n  * Al-Zamakhshari (Asas): Literal (Ḥaqīqah): \"سعى إلى المسجد\" — physical exertion toward a goal. Metaphorical (Majāz): \"هو يسعى على عياله\" — he strives to provide for his family. In the ritual context, the physical traversing is the literal embodiment of devotional striving.\n- Root: حمد (Ḥamd)\n  * Lisan / Ayn: The root denotes praise, commendation, and the acknowledgment of beneficence; it is the opposite of blame (dhamm).\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence with reverence and love, and it is due to God alone in His absolute perfection.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — praising God with all His praises. Metaphorical: \"أحمدت صنيعه\" — I approved of his deed. In the supplications of the saʿy, the pilgrim's praise is both literal acknowledgment and the metaphorical \"approval\" of God's decree.\n- Root: رمل (Raml)\n  * Lisan / Ayn: The root denotes rapid walking with a slight trotting motion, a form of hastening in movement.\n  * Al-Raghib (Mufradat): Not a primary theological term, but in ritual context it signifies the prescribed hastening between the two green markers, emulating the Prophet's action.\n  * Al-Zamakhshari (Asas): Literal: physical hastening. Metaphorical: The rapid pace is a visible emblem of spiritual earnestness and the rejection of the polytheists' claim that the Muslims were weakened by fever.\n- Sibawayh Rule: Rule of Restriction and Specification (al-Ḥaṣr wa al-Taqyīd) — The phrase \"وإنما ذلك شرط في طواف الركن\" employs restriction to delimit a condition exclusively to the circumambulation of the pillar (ṭawāf al-rukn), thereby negating its applicability to the saʿy.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Hajj'","badge":"Du'a"}],"20":[{"arabic":"ويخرج الميت من الحي ويحيي الأرض بعد موتها وكذلك تخرجون ومن آياته أن خلقكم من تراب ثم إذا أنتم بشر تنتشرون اللهم إني أسألك إيمانا دائما ويقينا صادقا وعلما نافعا وقلبا خاشعا ولسانا ذاكرا وأسألك العفو والعافية والمعافاة الدائمة في الدنيا والآخرة ويصلي على محمد صلى الله عليه وسلم ويدعو الله عز وجل بما شاء من حاجته عقيب هذا الدعاء ثم ينزل ويبتدىء السعي وهو يقول رب اغفر وارحم وتجاوز عما تعلم إنك أنت الأعز الأكرم اللهم آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار ويمشي على هينة حتى ينتهي إلى الميل الأخضر وهو أول ما يلقاه إذا نزل من الصفا وهو على زا","english":"Upon ascending al-Ṣafā, he should face the House (al-Bayt) and say: \"God is Greater, God is Greater. Praise be to God for what He has guided us to. Praise be to God with all His praises, for all His graces, all of them. There is no god but God alone, with no partner. His is the dominion, and His is the praise. He gives life and causes death; in His hand is all good, and He is over all things competent. There is no god but God alone; He fulfilled His promise, aided His servant, and honored His soldiers; He alone defeated the confederates. There is no god but God, devoting religion sincerely to Him, even if the disbelievers detest it. There is no god but God, devoting religion sincerely to Him. Praise be to God, Lord of the worlds. So exalted is God when you reach the evening and when you reach the morning. And His is the praise in the heavens and the earth, and at nightfall and when you are at noon. He brings forth the living from the dead and brings forth the dead from the living, and He revives the earth after its death, and thus shall you be brought forth. And of His signs is that He created you from dust; then, behold, you are humans spreading out. O God, I ask You for enduring faith, sincere certainty, beneficial knowledge, a humble heart, and a tongue that remembers You. And I ask You for pardon, well-being, and perpetual immunity in this world and the Hereafter.\" Then he sends blessings upon Muḥammad, may God bless him and grant him peace, and supplicates God, Mighty and Majestic, with whatever need he wishes, following this supplication.","book_title":"Contemplation","section_title_ar":"Section 204","section_title_en":"The Yemeni Corner and the Stone — The Beginning of the Saʿy and Its Rites","section_index":204,"anchors":"- Root: سعي (Saʿy)\n  * Lisan / Ayn: The root denotes striving, running, or rapid walking; it is the exertion of effort in a matter, whether good or evil.\n  * Al-Raghib (Mufradat): \"السعي: المشي السريع، وهو دون العدو، ويستعمل للجد في الأمر\" — Saʿy is swift walking, less than running, and is used for earnest exertion in a matter. In the sacred rite, it signifies the ritual traversing between al-Ṣafā and al-Marwah, an act of devotional striving.\n  * Al-Zamakhshari (Asas): Literal (Ḥaqīqah): \"سعى إلى المسجد\" — physical exertion toward a goal. Metaphorical (Majāz): \"هو يسعى على عياله\" — he strives to provide for his family. In the ritual context, the physical traversing is the literal embodiment of devotional striving.\n- Root: حمد (Ḥamd)\n  * Lisan / Ayn: The root denotes praise, commendation, and the acknowledgment of beneficence; it is the opposite of blame (dhamm).\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence with reverence and love, and it is due to God alone in His absolute perfection.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — praising God with all His praises. Metaphorical: \"أحمدت صنيعه\" — I approved of his deed. In the supplications of the saʿy, the pilgrim's praise is both literal acknowledgment and the metaphorical \"approval\" of God's decree.\n- Root: رمل (Raml)\n  * Lisan / Ayn: The root denotes rapid walking with a slight trotting motion, a form of hastening in movement.\n  * Al-Raghib (Mufradat): Not a primary theological term, but in ritual context it signifies the prescribed hastening between the two green markers, emulating the Prophet's action.\n  * Al-Zamakhshari (Asas): Literal: physical hastening. Metaphorical: The rapid pace is a visible emblem of spiritual earnestness and the rejection of the polytheists' claim that the Muslims were weakened by fever.\n- Sibawayh Rule: Rule of Restriction and Specification (al-Ḥaṣr wa al-Taqyīd) — The phrase \"وإنما ذلك شرط في طواف الركن\" employs restriction to delimit a condition exclusively to the circumambulation of the pillar (ṭawāf al-rukn), thereby negating its applicability to the saʿy.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Contemplation'","badge":"Du'a"}],"26":[{"arabic":"وهو أحد والآصال التي ذكرها الله تعالى إذ قال ولله يسجد من في السموات والأرض طوعا وكرها وظلالهم بالغدو والآصال وإذا سجد لله عز وجل الجمادات فكيف يجوز أن يغفل العبد العاقل عن أنواع العبادات الورد السادس إذا دخل وقت العصر دخل وقت الورد السادس وهو الذي أقسم الله تعالى به فقال تعالى {والعصر} هذا أحد معنيي الآية وهو المراد بالآصال في أحد التفسيرين وهو العشي المذكور في قوله {وعشيا} وفي قوله {بالعشي والإشراق} وليس في هذا الورد صلاة إلا أربع ركعات بين الأذان والإقامة كما سبق في الظهر ثم يصلي الفرض ويشتغل بالأقسام الأربعة المذكورة","english":"I say: And just as knowledge and remembrance are the nourishment of the heart, which can never be cut off from it, so too the measure of moderation is this; and deficiency from it may lead to the disturbance of the body — except for one who accustoms himself to wakefulness gradually, for he may train himself upon it without disturbance. And this litany (wird) is among the longest of the litanies and the most delightful for the worshippers, and it is one of the \"evenings and mornings\" (al-āṣāl) which God Most High mentioned when He said: {«ولله يسجد من في السموات والأرض طوعا وكرها وظلالهم بالغدو والآصال»} \"And to God prostrates whoever is in the heavens and the earth, willingly or unwillingly, and their shadows, in the mornings and the evenings\" (Q. 13:15). And when inanimate objects prostrate to God, Mighty and Majestic, how then can the intelligent servant be heedless of the varieties of worship?","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 261","section_title_en":"The Seventh Daily Litany (Al-Wird al-Sābiʿ): The Time of Sunset — The Completion of the Day's Litanies and Self-Accounting","section_index":261,"anchors":"- Root: ورد (warada)\n  * Lisan / Ayn: The root denotes arriving at water, seeking it, and drinking from it; also the portion or share of water allotted for drinking at a specific time.\n  * Al-Raghib (Mufradat): \"الورود أصله: قصد الماء\" — the core meaning is the intentional approach to water; the litany (wird) is the appointed portion of devotional recitation, likened to the daily share of water that a person must take to sustain life.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): the act of arriving at water. Metaphorical (Majaz): \"ورد علي كتاب سرني مورده\" — a book arrived upon me whose arrival pleased me; likewise, the wird is the arrival of the appointed time for worship, and the soul's approach to the fountain of divine remembrance.\n- Root: عصر (ʿaṣr)\n  * Lisan / Ayn: The root denotes pressing, squeezing, and extracting; also the time of afternoon, so called because it is the pressing of the day's end.\n  * Al-Raghib (Mufradat): The ʿaṣr is the latter part of the day; God swore by it in {«والعصر»} (Q. 103:1), indicating its great merit.\n  * Al-Zamakhshari (Asas): Literal: the afternoon time. Metaphorical: the pressing of one's life — as the day is pressed at its end, so the life of man is pressed at its term.\n- Root: غرب (gharaba)\n  * Lisan / Ayn: The root denotes disappearance, absence, and setting; the sun's setting (ghurūb) is its concealment from the eye.\n  * Al-Raghib (Mufradat): The setting of the sun marks the boundary between the day's works and the night's; it is the terminus of the visible world's diurnal cycle.\n  * Al-Zamakhshari (Asas): Literal: the sun's descent below the horizon. Metaphorical: the setting of the sun of life — the death of man, after which there is no rising.\n- Root: حاسب (ḥāsaba)\n  * Lisan / Ayn: The root denotes reckoning, counting, and taking account; muḥāsabah is the mutual reckoning between two parties.\n  * Al-Raghib (Mufradat): Self-accounting (muḥāsabat al-nafs) is the soul's reckoning with itself over its deeds before the Day of Reckoning, for \"one who reckons himself before he is reckoned\" is among the wise.\n  * Al-Zamakhshari (Asas): Literal: the arithmetic counting of sums. Metaphorical: the soul's audit of its own works, weighing the day's deeds against the standard of the Sacred Law.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of the prepositional phrase from its governing verb, as in the construction \"فسبحان الله حين تمسون\" where the adverbial clause is interposed to emphasize the temporal specification of the act of glorification.","content_type":"dhikr","topic":"Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Remembrance of Death and Afterlife'","badge":"Dhikr"}],"30":[{"arabic":"تعالى فأقم وجهك للدين حنيفا فطرة الله التي","english":"The First Principle: the knowledge of His existence, the Exalted. The first thing by which one is illuminated from among the lights, and the path of reflection (ṭarīq al-iʿtibār) by which one proceeds, is that to which the Qurʾān has guided. For after the explanation of God, glorified be He, there is no explanation. He, the Exalted, has said: {«أَلَمْ نَجْعَلِ الْأَرْضَ مِهَادًا وَالْجِبَالَ أَوْتَادًا وَخَلَقْنَاكُمْ أَزْوَاجًا وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا وَجَعَلْنَا اللَّيْلَ لِبَاسًا وَجَعَلْنَا النَّهَارَ مَعَاشًا وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا وَجَعَلْنَا سِرَاجًا وَهَّاجًا وَأَنزَلْنَا مِنَ الْمُعْصِرَاتِ مَاءً ثَجَّاجًا لِّنُخْرِجَ بِهِ حَبًّا وَنَبَاتًا وَجَنَّاتٍ أَلْفَافًا»} — \"Have We not made the earth a resting place, and the mountains as pegs, and created you in pairs, and made your sleep a repose, and made the night a covering, and made the day for livelihood, and built above you seven strong heavens, and made a blazing lamp, and sent down from the rain-clouds pouring water, that We may bring forth thereby grain and vegetation, and gardens dense with foliage?\" (Q 78:6–16). And He, the Exalted, has said: {«إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافِ اللَّيْلِ وَالنَّهَارِ وَالْفُلْكِ الَّتِي تَجْرِي فِي الْبَحْرِ بِمَا يَنفَعُ النَّاسَ وَمَا أَنزَلَ اللَّهُ مِنَ السَّمَاءِ مِن مَّاءٍ فَأَحْيَا بِهِ الْأَرْضَ بَعْدَ مَوْتِهَا وَبَثَّ فِيهَا مِن كُلِّ دَابَّةٍ وَتَصْرِيفِ الرِّيَاحِ وَالسَّحَابِ الْمُسَخَّرِ بَيْنَ السَّمَاءِ وَالْأَرْضِ لَآيَاتٍ لِّقَوْمٍ يَعْقِلُونَ»} — \"Indeed, in the creation of the heavens and the earth, and the alternation of the night and the day, and the ships which sail through the sea with that which benefits people, and what God has sent down from the sky of water, thereby reviving the earth after its death, and dispersing therein every creature, and the directing of the winds, and the clouds subservient between the heaven and the earth — are signs for a people who reason\" (Q 2:164). And He, the Exalted, has said: {«أَلَمْ تَرَوْا كَيْفَ خَلَقَ اللَّهُ سَبْعَ سَمَاوَاتٍ طِبَاقًا وَجَعَلَ الْقَمَرَ فِيهِنَّ نُورًا وَجَعَلَ الشَّمْسَ سِرَاجًا وَاللَّهُ أَنبَتَكُم مِّنَ الْأَرْضِ نَبَاتًا ثُمَّ يُعِيدُكُمْ فِيهَا وَيُخْرِجُكُمْ إِخْرَاجًا»} — \"Have you not seen how God created seven heavens in layers, and made the moon therein a light, and made the sun a lamp? And God caused you to grow from the earth a growth; then He returns you into it, and brings you forth a bringing forth\" (Q 71:15–18). And He, the Exalted, has said: {«أَفَرَأَيْتُم مَّا تُمْنُونَ أَأَنتُمْ تَخْلُقُونَهُ أَمْ نَحْنُ الْخَالِقُونَ»} — \"Have you considered what you emit? Do you create it, or are We the Creator?\" — up to His saying: {«لِلْمُقْوِينَ»} — \"for the settlers\" (Q 56:58–73).","book_title":"Foundations of Belief","section_title_ar":"Section 87","section_title_en":"The Pillars of Faith: Knowledge of God, His Attributes, His Acts, and the Audibles — Section 87","section_index":87,"anchors":"- Root: وجود (w-j-d)\n  * Lisan / Ayn: [Core linguistic root meaning: to find, to perceive, to be; existence as that which is found or discovered]\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance: al-wujūd as necessary existence (wujūb) versus contingent existence (imkān); the self-evident reality of the Creator's being]\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction: haqīqah — existence as affirmed reality; majāz — \"finding\" as in discovery, not applicable to God's necessary being]\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: [Core linguistic root meaning: measuring, proportioning, fashioning; origination of a thing upon a measure]\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم، ويستعمل في إبداع الشيء من غير أصل ولا احتذاء\" — creation as origination from nothing without prior model\n  * Al-Zamakhshari (Asas): [Literal: خلق الله الخلق: أوجده على تقدير أوجبته الحكمة — brought into existence upon a measure necessitated by wisdom; Majaz: not applicable to God's act as pure origination]\n- Root: فطر (f-t-r)\n  * Lisan / Ayn: [Core linguistic root meaning: to split, cleave, rend; to originate, to bring forth as a new creation]\n  * Al-Raghib (Mufradat): \"فطر الله الخلق\" — God's origination of creation as a primordial act; \"الفطرة\" as the innate disposition\n  * Al-Zamakhshari (Asas): [Literal: فطر الله الخلق، وهو فاطر السموات: مبتدعها — originator without precedent; Majaz: \"رأيه فطير\" — immature opinion, not applicable to divine]\n- Root: ارض (ar-d)\n  * Lisan / Ayn: [Core linguistic root meaning: the earth, the lower sphere; that which is beneath]\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء\" — the body opposite the heaven\n  * Al-Zamakhshari (Asas): [Literal: the earth as a resting place (مهادا); Majaz: not applicable in this context of divine creation]\n- Root: ركن (r-k-n)\n  * Lisan / Ayn: [Core linguistic root meaning: corner, pillar, support; that to which one leans for strength]\n  * Al-Raghib (Mufradat): \"ركن الشيء: جانبه الذي يسكن إليه\" — the side of a thing to which one repairs; used metaphorically for strength\n  * Al-Zamakhshari (Asas): [Literal: physical pillar/corner; Majaz: \"فلان يأوي من عز قومه إلى ركن شديد\" — one who repairs to a mighty support; here, the \"pillars\" (أركان) of faith as structural supports]\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure \"مداره على عشرة أصول\" (its circuit revolves upon ten principles) employs a prepositional phrase governing the verbal noun, establishing the necessary grammatical dependency that mirrors the ontological dependency of the created upon the Creator.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Foundations of Belief'","badge":"Afterlife"},{"arabic":"شهدت بذلك نفوسهم وبواطنهم فطرة الله التي فطر الناس عليها أي كل آدمي فطر على الإيمان بالله عز وجل بل على معرفة الأشياء على ما هي عليه أعني أنها كالمضمنة فيها لقرب استعدادها للإدراك ثم لما كان الإيمان مركوزا في النفوس بالفطرة انقسم الناس إلى قسمين إلى من أعرض فنسي وهم الكفار وإلى من أجال خاطره فتذكر فكان كمن حمل شهادة فنسيها بغفلة ثم تذكرها ولذلك قال عز وجل لعلهم يتذكرون وليتذكر أولوا الألباب واذكروا نعمة الله عليكم وميثاقه الذي واثقكم به ولقد يسرنا القرآن للذكر فهل من مدكر وتسمية هذا النمط تذكرا لي","english":"I say: Know that the washing of the eye is forbidden — that is, the eye of insight (ʿayn al-baṣīrah) is not to be washed with the water of blind imitation and mere hearsay, for it is the organ by which the realities of the intellect are disclosed. And the divisions of what the name \"intellect\" (al-ʿaql) is applied to have become clear: it is said of the inborn faculty (al-gharīzah), and it is said of the knowledge that is acquired through that faculty, and it is said of the state of that knowledge when it governs the soul, and it is said of the very actions that proceed from that governance.","book_title":"Book of Knowledge","section_title_ar":"Section 68","section_title_en":"The Washing of the Eye is Forbidden — On the True Meaning of Intellect (ʿAql) and Its Divisions","section_index":68,"anchors":"- Root: عقل (ʿAql)\n  * Lisan / Ayn: The root denotes binding, restraining, and holding back — the intellect is that which restrains the soul from base desires and prevents it from straying.\n  * Al-Raghib (Mufradat): \"العقل يقال للقوة المتهيئة لقبول العلم، ويقال للعلم الذي يستفيده الإنسان بتلك القوة عقل\" — al-ʿaql is said of the faculty prepared to receive knowledge, and it is also said of the knowledge acquired by that faculty. It is the instrument of divine discernment and the locus of taklīf (moral responsibility).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): the inborn faculty of discernment. Metaphorical (Majaz): \"نخلة لا تعقل الإبار إذا لم تقبله\" — a palm tree that does not accept pollination is said to be \"not to ʿaqil\" the pollen, extending the root to the sense of \"accepting/receiving.\" Thus, knowledge is called ʿaql metaphorically as its fruit.\n- Root: بصر (Baṣar)\n  * Lisan / Ayn: Sight, perception — both of the eye and of the heart.\n  * Al-Raghib (Mufradat): \"البصر يقال للجارحة الناظرة... ويقال لقوة القلب المدركة: بصيرة وبصر\" — baṣar is said of the seeing organ, and of the perceiving power of the heart: baṣīrah and baṣar. The inner sight (baṣīrah) perceives immaterial realities.\n  * Al-Zamakhshari (Asas): Literal: ocular vision. Metaphorical: \"هذه آية مبصرة\" — this is an illuminating sign; \"واجعلني بصيرة عليهم أي رقيبا وشاهدا\" — make me a watcher over them. The inner eye perceives what the outer eye cannot.\n- Root: فطر (Faṭara)\n  * Lisan / Ayn: To split, cleave, originate, create — the primordial act of divine creation.\n  * Al-Raghib (Mufradat): \"أصل الفطر: الشق طولا... وفطر الله الخلق\" — the root is splitting lengthwise; God's \"fatr\" of creation is His originating of things. \"فطرة الله التي فطر الناس عليها\" — the primordial disposition upon which God originated mankind.\n  * Al-Zamakhshari (Asas): Literal: \"فطر الله الخلق، وهو فاطر السموات: مبتدعها\" — God originated creation; He is the Originator of the heavens. \"وكل مولود يولد على الفطرة\" — every newborn is born upon the fiṭrah, i.e., the innate disposition receptive to the religion of truth.\n- Root: نفس (Nafs)\n  * Lisan / Ayn: Self, soul, spirit; the innermost reality of a thing.\n  * Al-Raghib (Mufradat): \"النفس: الروح... وقوله: تعلم ما في نفسي ولا أعلم ما في نفسك\" — nafs is the spirit/soul; \"You know what is in my nafs and I know not what is in Your nafs\" — the nafs is the seat of inner assent and recognition.\n  * Al-Zamakhshari (Asas): Literal: the self. Metaphorical: \"دفق نفسه أي دمه\" — he poured out his nafs, i.e., his blood. The nafs is the locus of the primordial covenant (mīthāq).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The construction \"إنما العاقل من آمن بالله\" restricts the predicate: the intellect is not merely a faculty of cleverness but is defined by its fruit — faith and God-consciousness (taqwā).","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'","badge":"Insight"}],"32":[{"arabic":"وبذلك هلكت الأمم السالفة إذ افترقت فرقا فكل معجب برأيه وكل حزب بما لديهم فرحون وجميع أهل البدع والضلال إنما أصروا عليها لعجبهم بآرائهم والعجب بالبدعة هو استحسان ما يسوق إليه الهوى والشهوة مع ظن كونه حقا وعلاج هذا العجب أشد من علاج غيره لأن صاحب الرأي الخطأ جاهل بخطئه ولو عرفه لتركه ولا يعالج الداء الذي لا يعرف والجهل داء لا يعرف فتعسر مداواته جدا لأن العارف يقدر على أن يبين للجاهل جهله ويزيله عنه إلا إذا كان معجبا برأيه وجهله فإنه لا يصغي إلى العارف ويتهمه فقد سلط الله عله بلية تهلكه وهو يظنها نعمة فكيف يمك","english":"If you say: \"He, peace and blessings be upon him, said after his words to Fāṭimah and Ṣafiyyah: 'I cannot avail you against God in anything, except that you have a tie of kinship which I will moisten with its moisture'\" — a ḥadīth [reported as]: \"Do you hope for my intercession, while the Banū ʿAbd al-Muṭṭalib do not hope for it?\" — narrated by al-Ṭabarānī in al-Awsaṭ from the narration of ʿAbd Allāh ibn Jaʿfar, and in it is Uṣayrim ibn Ḥawshab from Isḥāq ibn Wāṣil, and both are extremely weak — so that indicates that he will single out his relatives for intercession.","book_title":"Condemnation of Pride and Conceit","section_title_ar":"Section 882","section_title_en":"Section 882 — On the Limits of Intercession, the Vices of Pride in Lineage, Numbers, Wealth, and Opinion, and Their Treatment","section_index":882,"anchors":"- Root: شفع (Sh-F-')\n  * Lisan / Ayn: Core meaning is pairing or joining; intercession (shafā'ah) is the joining of one's plea to another's cause.\n  * Al-Raghib (Mufradat): Intercession is the seeking of benefit for another; its acceptance is contingent upon divine permission and good pleasure, as restricted by the Qur'anic qualifiers.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) is the act of making a number even (from watr, odd); metaphorical (majāz) is the mediator's plea before authority.\n- Root: عجب (ʿ-J-B)\n  * Lisan / Ayn: Astonishment arising from an unknown cause; self-admiration (ʿujb) is a blameworthy state of being pleased with oneself.\n  * Al-Raghib (Mufradat): \"العجب والتعجب: حالة تعرض للإنسان عند الجهل بسبب الشيء\" — a state that overtakes a person due to ignorance of the cause; hence, it is impossible regarding God.\n  * Al-Zamakhshari (Asas): Literal: a wondrous thing; metaphorical: the one who performs marvels (taʿjābah). Self-admiration is the root of every error and innovation.\n- Root: رأي (R-'-Y)\n  * Lisan / Ayn: Opinion, view, or judgment formed through reflection.\n  * Al-Raghib (Mufradat): Ra'y is the considered opinion that may err or hit the mark; it is blameworthy when it becomes an object of ʿujb (self-admiration).\n  * Al-Zamakhshari (Asas): Literal: sight/vision; metaphorical: intellectual insight. The ḥadīth \"إعجاب كل ذي رأي برأيه\" (the admiration of every man of opinion for his own view) is cited as a sign of the age's corruption.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Qualification) — The conditional clauses (in-sharṭ) governing intercession, e.g., {إلا لمن ارتضى} and {إلا بإذنه}, impose necessary restrictions that negate any absolute reliance on intercession.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Pride and Conceit'","badge":"Ethics"}],"39":[{"arabic":"أكثر وتحت قوله تعالى وما آتيتم من ربا ليربوا في أموال الناس فإن الربا هو الزيادة وهذا طلب زيادة على الجملة وإن لم يكن في الأموال الربوية فكل ذلك مكروه وبدعة في النكاح يشبه التجارة والقمار ويفسد مقاصد النكاح الخامسة أن تكون المرأة ولودا فإن عرفت بالعقر فليمتنع عن تزوجها قال صلى الله عليه وسلم عليكم بالولود الودود (1) فإن لم يكن لها زوج ولم يعرف حالها فيراعي صحتها وشبابها فإنها تكون ولودا في الغالب مع هذين الوصفين السادسة أن تكون بكرا قال صلى الله عليه وسلم لجابر وقد نكح ثيبا هلا بكرا تلاعبها وتل","english":"...one of you sees a woman, let him look at her, for that is more likely to bring about harmony (iʾtilāf) between them — that is, to unite them — than the mere occurrence of the inner skin (al-adamah) upon the outer skin (al-basharah). He only mentioned that for emphasis on the union. And he, peace and blessings be upon him, said: \"Verily, in the eyes of the Ansar there is something, so when one of you wishes to marry from among them, let him look at them.\" It was said that there was a weakness of the eyes (ʿamash) in them, and it was said it was smallness of the eyes. And some of the scrupulous (al-warʿīn) would not marry their noble women except after looking, as a precaution against deception (al-ghurūr).","book_title":"Etiquette of Marriage","section_title_ar":"Section 301","section_title_en":"The Revival of the Religious Sciences — Book on the Etiquettes of Marriage: Section 301 — On the Recommended Attributes of the Wife (Continued)","section_index":301,"anchors":"- Root: أدم (ʾ-d-m)\n  * Lisan / Ayn: Core meaning of harmony, concord, and the inner skin (al-adamah) beneath the outer skin (al-basharah); also used for the reconciliation between two parties.\n  * Al-Raghib (Mufradat): Theological nuance of ʾulfah (intimate familiarity) as a divinely ordained bond between spouses, achieved through mutual sight and attraction.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) usage refers to the physical inner skin; metaphorical (majaz) usage denotes the spiritual and emotional union (iʾtilāf) between husband and wife.\n- Root: عقر (ʿ-q-r)\n  * Lisan / Ayn: Barrenness (ʿuqr) in women; also the root for cutting off, as in severing lineage or progeny.\n  * Al-Raghib (Mufradat): A state of incapacity to bear children, which in the context of marriage contracts negates a primary purpose of the union (procreation).\n  * Al-Zamakhshari (Asas): Literal: physical barrenness; metaphorical: the severance of the hoped-for continuity of offspring.\n- Root: ودد (w-d-d)\n  * Lisan / Ayn: Love, affection, and steadfast amity (wudd).\n  * Al-Raghib (Mufradat): A specific, enduring form of love (mahabbah) that is active and volitional, distinct from mere inclination.\n  * Al-Zamakhshari (Asas): Literal: the affection of the heart; metaphorical: the outward expression of that affection through service and companionship.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to isolate the exclusive purpose of a clause, e.g., \"إنما ذكر ذلك للمبالغة في الائتلاف\" (He only mentioned that for emphasis on union), restricting the reason to a single, specific cause.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Marriage'","badge":"Insight"}],"43":[{"arabic":"ينطقون ولا يؤذن لهم فيعتذرون يوم لا مرد له من الله يوم هم بارزون ويوم هم على النار يفتنون يوم لا ينفع مال ولا بنون يوم لا ينفع الظالمين معذرتهم ولهم اللعنة ولهم سوء الدار يوم ترد فيه المعاذير وتبلى السرائر وتظهر الضمائر وتكشف الأستار يوم تخشع فيه الأبصار وتسكن الأصوات ويقل فيه الالتفات وتبرز الخفيات وتظهر الخطيئات يوم يساق العباد ومعهم الأشهاد ويشيب الصغير ويسكر الكبير فيومئذ وضعت الموازين ونشرت الدواوين وبرزت الجحيم وأغلى الحميم وزفرت النار ويئس الكفار وسعرت النيران وتغيرت الألوان وخرس اللسان","english":"So prepare yourself, O wretched one, for this Day of immense magnitude, of prolonged duration, of overwhelming dominion, whose appointed time is near — a Day when you shall see the heaven split asunder, and the stars scattered in its terror, and the shining planets extinguished, and the sun folded up, and the mountains set in motion, and the pregnant camels neglected, and the wild beasts gathered together, and the seas set ablaze, and the souls paired with their bodies, and the Hellfire ignited, and Paradise brought near, and the mountains pulverized, and the earth stretched out — a Day when you shall see the earth shaken with its quaking, and the earth casts forth its burdens. On that Day shall people issue forth in scattered groups to be shown their deeds — a Day when the earth and the mountains are lifted and crushed with a single crushing. Then on that Day the Imminent Event shall come to pass, and the heaven shall split open, for on that Day it shall be frail, and the angels shall be at its edges, and eight shall bear the Throne of your Lord above them on that Day. On that Day you shall be presented — no secret of yours shall remain hidden. A Day when the mountains shall move and you shall see the earth laid bare — a Day when the earth shall be shaken with a violent shaking, and the mountains crumbled to dust, becoming scattered particles — a Day when people shall be like scattered moths, and the mountains like carded wool — a Day when every nursing mother shall forget what she nursed, and every pregnant female shall cast down her burden, and you shall see people drunk, yet they are not drunk, but the chastisement of God is severe — a Day when the earth shall be changed to other than this earth, and the heavens, and they shall appear before God, the One, the All-Compelling — a Day when the mountains shall be blown away as dust, leaving a level, bare plain, wherein you see no crookedness nor curve — a Day when you see the mountains and suppose them solid, yet they pass by like the passing of clouds — a Day when the heaven shall split open and become rosy like molten oil. Then on that Day no human nor jinn shall be asked about his sin. A Day when the disobedient shall be prevented from speech, and shall not be asked about their crimes, but shall be seized by their forelocks and their feet — a Day when every soul shall find what it did of good brought forth present, and what it did of evil, wishing that between it and that evil there were a far distance — a Day when every soul shall know what it has sent ahead, and shall witness what it has forwarded and what it has left behind — a Day when tongues shall be struck mute and the bodily members shall speak — a Day whose mention turned the hair of the Master of the Messengers white, when al-Ṣiddīq (may God be pleased with him) said to him: \"I see that you have turned white-haired, O Messenger of God.\" He said: \"Sūrat Hūd and its sisters have made me white-haired\" — namely, al-Wāqiʿah, al-Mursalāt, ʿAmma Yatasāʾalūn, and Idhā al-Shamsu Kuwwirat.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1339","section_title_en":"The Names and Attributes of the Day of Resurrection — An Exhortation to the Negligent","section_index":1339,"anchors":"- Root: يوم (yawm)\n  * Lisan / Ayn: \"اليوم: وقت طلوع الشمس إلى غروبها، وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day as a temporal span, extended metaphorically to any epoch or era.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — theological usage denotes the appointed time of reckoning, magnified by divine attribution (أيام الله).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): a measured solar period. Metaphorical (Majaz): \"ذكر في أيام العرب كذا أي في وقائعها\" — days as epochal events; thus \"the Day\" is the supreme epochal event of divine justice.\n- Root: نفس (nafs)\n  * Lisan / Ayn: النفس: الروح والذات — the self, soul, or very essence.\n  * Al-Raghib (Mufradat): \"النفس: الروح... وقوله: ويحذركم الله نفسه فنفسه: ذاته\" — nafs as the innermost reality of a being; in the eschatological context, souls are \"paired\" (زوجت) with bodies for judgment.\n  * Al-Zamakhshari (Asas): Literal: the soul as life-principle. Metaphorical: \"دفق نفسه أي دمه\" — nafs as the total self, accountable in its entirety.\n- Root: ارض (arḍ)\n  * Lisan / Ayn: الأرض: الجرم المقابل للسماء — the earth as the corporeal substratum beneath the heavens.\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء... ويعبر بها عن أسفل الشيء\" — the earth as the lowest register of creation, subject to total transformation on that Day.\n  * Al-Zamakhshari (Asas): Literal: the physical earth. Metaphorical: \"تأرض فلان: لزم الأرض\" — to cling low; on that Day the earth itself is leveled, flattened, and replaced.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated \"يوم\" clauses function as temporal restrictors (ẓurūf) binding each predicate to that single, all-encompassing moment; the accumulation of names (أسامي) serves not as mere repetition but as focused predication upon the multifarious realities of a single event.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"},{"arabic":"وسلم قال من كانت لأخيه عنده مظلمة في عرض أو مال فليستحللها منه من قبل أن يأتي يوم ليس هناك دينار ولا درهم إنما يؤخذ من حسناته فإن لم يكن له حسنات أخذ من سيئات صاحبه فزيدت على سيئاته (1) وقالت عائشة رضي الله عنها لامرأة قالت لأخرى أنها طويلة الذيل قد اغتبتيها فاستحليها فإذن لا بد من الاستحلال إن قدر عليه فإن كان غائبا أو ميتا فينبغي أن يكثر له الاستغفار والدعاء ويكثر من الحسنات فإن قلت فالتحليل هل يجب فأقول لا لأنه تبرع والتبرع فضل وليس بواجب ولكنه مستحسن وسبيل المعتذر أن يبالغ في الثناء عليه والتودد إليه","english":"- Root: غيب (gh-y-b)\n  * Lisan / Ayn: \"To be absent, hidden, concealed from sight; ghayb = that which is unseen/absent from perception\"\n  * Al-Raghib (Mufradat): \"الغيب: مصدر غابت الشمس وغيرها: إذا استترت عن العين — used of everything absent from the senses and from human knowledge; applied to things as ghayb/ghā'ib relative to people, not relative to God, for nothing is absent from Him\"\n  * Al-Zamakhshari (Asas): Haqiqah: \"تكلم بذلك عن ظهر الغيب\" (speaking of the unseen); Majaz: \"أتونا في غابة\" (metaphorical extension to dense/thick things)\n- Root: حسن (ḥ-s-n)\n  * Lisan / Ayn: \"Beauty, goodness, excellence; to be fair, comely, good\"\n  * Al-Raghib (Mufradat): \"الحسن: عبارة عن كل مبهج مرغوب فيه — three kinds: good by reason, good by desire, good by sense; ḥasanah = everything that delights one, whether in self, body, or circumstances\"\n  * Al-Zamakhshari (Asas): Haqiqah: \"أنظر إلى محاسن وجهه\" (physical beauty); Majaz: \"فلان لا يحسن شيئًا\" (to do well/excel — transferred to action)\n- Root: حرم (ḥ-r-m)\n  * Lisan / Ayn: \"To forbid, prohibit, make unlawful; ḥarām = that which is forbidden\"\n  * Al-Raghib (Mufradat): \"الحرام: الممنوع منه إما بتسخير إلهي وإما بشري — prohibition by divine decree, by human law, by coercive prevention, by reason, or by revelation\"\n  * Al-Zamakhshari (Asas): Haqiqah: \"هتك رحمته\" (violating sanctity); Majaz: \"جلد محرم: لم يدبغ\" (raw hide — metaphorical extension to \"untreated/unlawful\")\n- Root: ظلم (ẓ-l-m)\n  * Lisan / Ayn: \"Wrongdoing, injustice, oppression; to place something in other than its proper place\"\n  * Al-Raghib (Mufradat): \"الظلمة: عدم النور — darkness is absence of light; used metaphorically for ignorance, polytheism, and sin, just as light is used for their opposites\"\n  * Al-Zamakhshari (Asas): Haqiqah: \"فلان يظلم فيظلم\" (to wrong and be wronged); Majaz: \"أرض مظلومة\" (land never dug — metaphorical: \"wronged\" land)\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما يؤخذ من حسناته\" restricts the taking exclusively to good deeds, excluding any monetary compensation on that Day.","book_title":"Condemnation of Anger and Hatred","section_title_ar":"Section 690","section_title_en":"Section 690","section_index":690,"anchors":"*(Anchors established)*","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Anger and Hatred'","badge":"Hadith"}],"50":[{"arabic":"وهو مع ذلك قريب من كل موجود وهو أقرب إلى العبد من حبل الوريد وهو على كل شيء شهيد إذ لا يماثل قربه قرب الأجسام كما لا تماثل ذاته ذات الأجسام وأنه لا يحل في شيء ولا يحل فيه شيء تعالى عن أن يحويه مكان كما تقدس عن أن يحده زمان بل كان قبل أن خلق الزمان والمكان وهو الآن على ما عليه كان وأنه بائن عن خلقه بصفاته ليس في ذاته سواه ولا في سواه ذاته وأنه مقدس عن التغير والانتقال لا تحله الحوادث ولا تعتريه العوارض بل لا يزال في نعوت جلاله منزها عن الزوال وفي صفات كماله مستغنيا عن زيادة الاستكمال وأنه في ذاته معلوم الوجود بالعقول مرئ","english":"- **Root: خلق (khalaqa)**\n  - *Lisan / Ayn:* Core meaning of measuring, proportioning, and fashioning; al-Khalil notes the root's application to the act of creation as bringing forth upon a measured determination.\n  - *Al-Raghib (Mufradat):* \"الخلق أصله: التقدير المستقيم\" — Creation fundamentally signifies right/straight measurement; used for bringing into being from nothing (ibdāʿ) as in {خلق السماوات والأرض}, and for bringing forth from something as in {خلقكم من نفس واحدة}.\n  - *Al-Zamakhshari (Asas):* Literal (ḥaqīqah): the craftsman's measuring before cutting. Metaphorical (majāz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure necessitated by wisdom.","book_title":"On Invocations and Supplications","section_title_ar":"Section 72","section_title_en":"Section 72","section_index":72,"anchors":"*(Anchors established)*","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'","badge":"Insight"},{"arabic":"الأصل الأول العلم بأن صانع العالم قادر وأنه تعالى في قوله وهو على كل شيء قدير صادق لأن العالم محكم في صنعته مرتب في خلقته ومن رأى ثوبا من ديباج حسن النسج والتأليف متناسب التطريز والتطريف ثم توهم صدور نسجه عن ميت لا استطاعة له أو عن إنسان لا قدرة له كان منخلعا عن غريزة العقل ومنخرطا في سلك أهل الغباوة والجهل الأصل الثاني العلم بأنه تعالى عالم بجميع الموجودات ومحيط بكل المخلوقات لا يعزب عن علمه مثقال ذرة في الأرض ولا في السماء صادق في قوله وهو بكل شيء عليم ومرشد إلى صدقه بقوله تعالى ألا يعلم من خلق وهو اللطيف الخبير أرشدك","english":"**The Eighth Principle: Knowledge that He, Exalted is He, is established upon His Throne (mustawin ʿalā ʿarshihi) in the sense that God, Exalted is He, intended by istiwāʾ — which is the sense that does not contradict the attribute of Majesty, nor does any mark of origination (ḥudūth) or passing away (fanāʾ) attach to it. And it is the sense intended by His saying — istiwāʾ toward the heaven — where He said in the Qur'an: {«ثُمَّ اسْتَوَىٰ إِلَى السَّمَاءِ وَهِيَ دُخَانٌ»} (\"Then He directed Himself to the heaven, and it was smoke\") [Fussilat 41:11]. And that is only by way of subjugation (qahr) and dominion (istīlāʾ), as the poet said:","book_title":"On Invocations and Supplications","section_title_ar":"Section 90","section_title_en":"The Revival of the Religious Sciences — Section 90: The Ten Principles Concerning Knowledge of the Divine Attributes","section_index":90,"anchors":"- Root: ع ل م (ʿ-l-m)\n  * Lisan / Ayn: Core root denoting the faculty of perception and comprehension; the mark or trace by which something is known.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment upon it.\n  * Al-Zamakhshari (Asas): Distinguishes literal knowledge (ḥaqīqah) from awareness (shiʿr); here, it denotes certain, verified cognition of theological verities.\n- Root: س و ي (s-w-y)\n  * Lisan / Ayn: Root indicating straightness, equality, and levelness; from it derives istiwāʾ (establishing oneself upon, ascending to).\n  * Al-Raghib (Mufradat): Istiwāʾ upon the Throne (al-ʿArsh) is a divine act of sovereign dominion, not corporeal settlement.\n  * Al-Zamakhshari (Asas): Literal sense of physical sitting is impossible for God; metaphorical sense (majāz) of qahr (overpowering) and istīlāʾ (dominion) is necessitated by reason and consensus.\n- Root: ر أ ي (r-ʾ-y)\n  * Lisan / Ayn: Visual perception; also opinion and discernment.\n  * Al-Raghib (Mufradat): Ruʾyah (vision) of God in the Hereafter is a mode of disclosure (kashf) and knowledge (ʿilm), more complete than intellectual cognition, not conditioned by spatial direction.\n  * Al-Zamakhshari (Asas): Literal vision requires corporeality and direction; its application to God demands theological specification (takhṣīṣ) without nullifying the veracity of the scriptural promise.\n- Root: ق د ر (q-d-r)\n  * Lisan / Ayn: Power, measure, decree; the capacity to bring about an act.\n  * Al-Raghib (Mufradat): Divine power (qudrah) is the negation of incapacity (ʿajz); absolute power belongs to God alone, while creatures possess limited capacity.\n  * Al-Zamakhshari (Asas): Literal power over an object; metaphorically, God's power encompasses all things without exertion or instrument.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — governing the permissible separation between the preposition and its object for rhetorical emphasis, applied here to the parsing of \"إلى السماء\" in the verse on istiwāʾ, where the prepositional phrase is delayed to highlight the divine act of sovereign direction toward the heavens.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'","badge":"Hadith"}]},"wordTiming":{"abdulbasit":{"1":[[1,400,7612]],"2":[[1,250,1340],[2,1340,2816]],"3":[[1,400,1620],[2,1620,2852],[3,2852,4047],[4,4047,4893],[5,4893,5752],[6,5752,6548],[7,6548,7792],[8,7792,9833]],"4":[[1,400,1136],[2,1136,2166],[3,2166,3520],[4,3520,4594],[5,4594,5918],[6,5918,6507],[7,6507,7522],[8,7522,8552],[9,8552,9494],[10,9494,11819],[11,11819,13173],[12,13173,15554]],"5":[[1,400,1839],[2,1839,3161],[3,3161,4768],[4,4768,5437],[5,5437,8001],[6,8001,9306],[7,9306,11314],[8,11314,13542]],"6":[[1,400,1378],[2,1378,2422],[3,2422,3109],[4,3109,4325],[5,4325,5369],[6,5369,6585],[7,6585,8317],[8,8317,9454],[9,9454,11159],[10,11159,11846],[11,11846,13751]],"