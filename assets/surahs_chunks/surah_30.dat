, {"id": 9, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "غَٰفِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 30, "ayah": 8, "text": "أَوَلَمْ يَتَفَكَّرُواْ فِےٓ أَنفُسِهِمۖ مَّا خَلَقَ اَ۬للَّهُ اُ۬لسَّمَٰوَٰتِ وَالَارْضَ وَمَا بَيْنَهُمَآ إِلَّا بِالْحَقِّ وَأَجَلࣲ مُّسَمّيࣰۖ وَإِنَّ كَثِيراࣰ مِّنَ اَ۬لنَّاسِ بِلِقَآءِ رَبِّهِمْ لَكَٰفِرُونَۖ", "words": [{"id": 1, "arabic": "أَوَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَتَفَكَّرُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنفُسِهِمۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "خَلَقَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 11, "arabic": "بَيْنَهُمَآ", "translit": "", "root": ""}, {"id": 12, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 13, "arabic": "بِالْحَقِّ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَأَجَلࣲ", "translit": "", "root": ""}, {"id": 15, "arabic": "مُّسَمّيࣰۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "وَإِنَّ", "translit": "", "root": ""}, {"id": 17, "arabic": "كَثِيراࣰ", "translit": "", "root": ""}, {"id": 18, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 19, "arabic": "اَ۬لنَّاسِ", "translit": "", "root": ""}, {"id": 20, "arabic": "بِلِقَآءِ", "translit": "", "root": ""}, {"id": 21, "arabic": "رَبِّهِمْ", "translit": "", "root": ""}, {"id": 22, "arabic": "لَكَٰفِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 30, "ayah": 9, "text": "۞أَوَلَمْ يَسِيرُواْ فِے اِ۬لَارْضِ فَيَنظُرُواْ كَيْفَ كَانَ عَٰقِبَةُ اُ۬لذِينَ مِن قَبْلِهِمْ كَانُوٓاْ أَشَدَّ مِنْهُمْ قُوَّةࣰ وَأَثَارُواْ ا