id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"أَسَٰٓـُٔوا۟","translit":"۟āwُٔـَٰٓsَaʾ","root":"سوا"},{"id":6,"arabic":"ٱلسُّوٓأَىٰٓ","translit":"ٰٓàَaʾٓwُّslٱ","root":"سوا"},{"id":7,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":8,"arabic":"كَذَّبُوا۟","translit":"۟āwُbَّhdَk","root":"كذب"},{"id":9,"arabic":"بِـَٔايَٰتِ","translit":"ِtَٰyāَٔـِb","root":"ايي"},{"id":10,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":11,"arabic":"وَكَانُوا۟","translit":"۟āwُnāَkَw","root":"كون"},{"id":12,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":13,"arabic":"يَسْتَهْزِءُونَ","translit":"َnwُءِzْhَtْsَy","root":"هزا"}],"hasIhya":false},{"ayah":11,"text":"ٱللَّهُ يَبْدَؤُا۟ ٱلْخَلْقَ ثُمَّ يُعِيدُهُۥ ثُمَّ إِلَيْهِ تُرْجَعُونَ ","translation":"Allāh begins creation; then He will repeat it; then to Him you will be returned.","words":[{"id":1,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":2,"arabic":"يَبْدَؤُا۟","translit":"۟āُwʾَdْbَy","root":"بدا"},{"id":3,"arabic":"ٱلْخَلْقَ","translit":"َqْlَhkْlٱ","root":"خلق"},{"id":4,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":5,"arabic":"يُعِيدُهُۥ","translit":"ۥُhُdyِʿعُy","root":"عود"},{"id":6,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":7,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":8,"arabic":"تُرْجَعُونَ","translit":"َnwُʿعَjgْrُt","root":"رجع"}],"hasIhya":false},{"ayah":12,"text":"وَيَوْمَ تَقُومُ ٱلسَّاعَةُ يُبْلِسُ ٱلْمُجْرِمُونَ ","translation":"And the Day the Hour appears the criminals will be in despair.","words":[{"id":1,"arabic":"وَيَوْمَ","translit":"َmْwَyَw","root":"يوم"},{"id":2,"arabic":"تَقُومُ","translit":"ُmwُqَt","root":"قوم"},{"id":3,"arabic":"ٱلسَّاعَةُ","translit":"ُẗَʿعāَّslٱ","root":"سوع"},{"id":4,"arabic":"يُبْلِسُ","translit":"ُsِlْbُy","root":"بلس"},{"id":5,"arabic":"ٱلْمُجْرِمُونَ","translit":"َnwُmِrْjgُmْlٱ","root":"جرم"}],"hasIhya":false},{"ayah":13,"text":"وَلَمْ يَكُن لَّهُم مِّن شُرَكَآئِهِمْ شُفَعَٰٓؤُا۟ وَكَانُوا۟ بِشُرَكَآئِهِمْ كَٰفِرِينَ ","translation":"And there will not be for them among their [alleged] partners any intercessors, and they will [then] be disbelievers in their partners.","words":[{"id":1,"arabic":"وَلَمْ","translit":"ْmَlَw","root":""},{"id":2,"arabic":"يَكُن","translit":"nُkَy","root":"كون"},{"id":3,"arabic":"لَّهُم","translit":"mُhَّl","root":""},{"id":4,"arabic":"مِّن","translit":"nِّm","root":""},{"id":5,"arabic":"شُرَكَآئِهِمْ","translit":"ْmِhِyʾٓāَkَrُhs","root":"شرك"},{"id":6,"arabic":"شُفَعَٰٓؤُا۟","translit":"۟āُwʾَٰٓʿعَfُhs","root":"شفع"},{"id":7,"arabic":"وَكَانُوا۟","translit":"۟āwُnāَkَw","root":"كون"},{"id":8,"arabic":"بِشُرَكَآئِهِمْ","translit":"ْmِhِyʾٓāَkَrُhsِb","root":"شرك"},{"id":9,"arabic":"كَٰفِرِينَ","translit":"َnyِrِfَٰk","root":"كفر"}],"hasIhya":false},{"ayah":14,"text":"وَيَوْمَ تَقُومُ ٱلسَّاعَةُ يَوْمَئِذٍ يَتَفَرَّقُونَ ","translation":"And the Day the Hour appears - that Day they will become separated.","words":[{"id":1,"arabic":"وَيَوْمَ","translit":"َmْwَyَw","root":"يوم"},{"id":2,"arabic":"تَقُومُ","translit":"ُmwُqَt","root":"قوم"},{"id":3,"arabic":"ٱلسَّاعَةُ","translit":"ُẗَʿعāَّslٱ","root":"سوع"},{"id":4,"arabic":"يَوْمَئِذٍ","translit":"ٍhdِyʾَmْwَy","root":"يوم"},{"id":5,"arabic":"يَتَفَرَّقُونَ","translit":"َnwُqَّrَfَtَy","root":"فرق"}],"hasIhya":false},{"ayah":15,"text":"فَأَمَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَهُمْ فِى رَوْضَةٍ يُحْبَرُونَ ","translation":"And as for those who had believed and done righteous deeds, they will be in a garden [of Paradise], delighted.","words":[{"id":1,"arabic":"فَأَمَّا","translit":"āَّmَaʾَf","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":5,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":6,"arabic":"فَهُمْ","translit":"ْmُhَf","root":""},{"id":7,"arabic":"فِى","translit":"àِf","root":""},{"id":8,"arabic":"رَوْضَةٍ","translit":"ٍẗَḍْwَr","root":"روض"},{"id":9,"arabic":"يُحْبَرُونَ","translit":"َnwُrَbْḥُy","root":"حبر"}],"hasIhya":false},{"ayah":16,"text":"وَأَمَّا ٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَٰتِنَا وَلِقَآئِ ٱلْءَاخِرَةِ فَأُو۟لَٰٓئِكَ فِى ٱلْعَذَابِ مُحْضَرُونَ ","translation":"But as for those who disbelieved and denied Our verses and the meeting of the Hereafter, those will be brought into the punishment [to remain].","words":[{"id":1,"arabic":"وَأَمَّا","translit":"āَّmَaʾَw","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":4,"arabic":"وَكَذَّبُوا۟","translit":"۟āwُbَّhdَkَw","root":"كذب"},{"id":5,"arabic":"بِـَٔايَٰتِنَا","translit":"āَnِtَٰyāَٔـِb","root":"ايي"},{"id":6,"arabic":"وَلِقَآئِ","translit":"ِyʾٓāَqِlَw","root":"لقي"},{"id":7,"arabic":"ٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱ","root":"اخر"},{"id":8,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":9,"arabic":"فِى","translit":"àِf","root":""},{"id":10,"arabic":"ٱلْعَذَابِ","translit":"ِbāَhdَʿعْlٱ","root":"عذب"},{"id":11,"arabic":"مُحْضَرُونَ","translit":"َnwُrَḍْḥُm","root":"حضر"}],"hasIhya":false},{"ayah":17,"text":"فَسُبْحَٰنَ ٱللَّهِ حِينَ تُمْسُونَ وَحِينَ تُصْبِحُونَ ","translation":"So exalted is Allāh when you reach the evening and when you reach the morning.","words":[{"id":1,"arabic":"فَسُبْحَٰنَ","translit":"َnَٰḥْbُsَf","root":"سبح"},{"id":2,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":3,"arabic":"حِينَ","translit":"َnyِḥ","root":"حين"},{"id":4,"arabic":"تُمْسُونَ","translit":"َnwُsْmُt","root":"مسو"},{"id":5,"arabic":"وَحِينَ","translit":"َnyِḥَw","root":"حين"},{"id":6,"arabic":"تُصْبِحُونَ","translit":"َnwُḥِbْṣُt","root":"صبح"}],"hasIhya":true},{"ayah":18,"text":"وَلَهُ ٱلْحَمْدُ فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَعَشِيًّا وَحِينَ تُظْهِرُونَ ","translation":"And to Him is [due all] praise throughout the heavens and the earth. And [exalted is He] at night and when you are at noon.","words":[{"id":1,"arabic":"وَلَهُ","translit":"ُhَlَw","root":""},{"id":2,"arabic":"ٱلْحَمْدُ","translit":"ُdْmَḥْlٱ","root":"حمد"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":5,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":6,"arabic":"وَعَشِيًّا","translit":"āًّyِhsَʿعَw","root":"عشو"},{"id":7,"arabic":"وَحِينَ","translit":"َnyِḥَw","root":"حين"},{"id":8,"arabic":"تُظْهِرُونَ","translit":"َnwُrِhْẓُt","root":"ظهر"}],"hasIhya":false},{"ayah":19,"text":"يُخْرِجُ ٱلْحَىَّ مِنَ ٱلْمَيِّتِ وَيُخْرِجُ ٱلْمَيِّتَ مِنَ ٱلْحَىِّ وَيُحْىِ ٱلْأَرْضَ بَعْدَ مَوْتِهَاۚ وَكَذَٰلِكَ تُخْرَجُونَ ","translation":"He brings the living out of the dead and brings the dead out of the living and brings to life the earth after its lifelessness. And thus will you be brought out.[1]","words":[{"id":1,"arabic":"يُخْرِجُ","translit":"ُjgِrْhkُy","root":"خرج"},{"id":2,"arabic":"ٱلْحَىَّ","translit":"َّàَḥْlٱ","root":"حيي"},{"id":3,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":4,"arabic":"ٱلْمَيِّتِ","translit":"ِtِّyَmْlٱ","root":"موت"},{"id":5,"arabic":"وَيُخْرِجُ","translit":"ُjgِrْhkُyَw","root":"خرج"},{"id":6,"arabic":"ٱلْمَيِّتَ","translit":"َtِّyَmْlٱ","root":"موت"},{"id":7,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":8,"arabic":"ٱلْحَىِّ","translit":"ِّàَḥْlٱ","root":"حيي"},{"id":9,"arabic":"وَيُحْىِ","translit":"ِàْḥُyَw","root":"حيي"},{"id":10,"arabic":"ٱلْأَرْضَ","translit":"َḍْrَaʾْlٱ","root":"ارض"},{"id":11,"arabic":"بَعْدَ","translit":"َdْʿعَb","root":"بعد"},{"id":12,"arabic":"مَوْتِهَا","translit":"āَhِtْwَm","root":"موت"},{"id":13,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":14,"arabic":"تُخْرَجُونَ","translit":"َnwُjgَrْhkُt","root":"خرج"}],"hasIhya":false},{"ayah":20,"text":"وَمِنْ ءَايَٰتِهِۦٓ أَنْ خَلَقَكُم مِّن تُرَابٍ ثُمَّ إِذَآ أَنتُم بَشَرٌ تَنتَشِرُونَ ","translation":"And of His signs is that He created you from dust; then, suddenly you were human beings dispersing [throughout the earth].","words":[{"id":1,"arabic":"وَمِنْ","translit":"ْnِmَw","root":""},{"id":2,"arabic":"ءَايَٰتِهِۦٓ","translit":"ٓۦِhِtَٰyāَء","root":"ايي"},{"id":3,"arabic":"أَنْ","translit":"ْnَaʾ","root":""},{"id":4,"arabic":"خَلَقَكُم","translit":"mُkَqَlَhk","root":"خلق"},{"id":5,"arabic":"مِّن","translit":"nِّm","root":""},{"id":6,"arabic":"تُرَابٍ","translit":"ٍbāَrُt","root":"ترب"},{"id":7,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":8,"arabic":"إِذَآ","translit":"ٓāَhdِiʾ","root":""},{"id":9,"arabic":"أَنتُم","translit":"mُtnَaʾ","root":""},{"id":10,"arabic":"بَشَرٌ","translit":"ٌrَhsَb","root":"بشر"},{"id":11,"arabic":"تَنتَشِرُونَ","translit":"َnwُrِhsَtnَt","root":"نشر"}],"hasIhya":true},{"ayah":21,"text":"وَمِنْ ءَايَٰتِهِۦٓ أَنْ خَلَقَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَٰجًا لِّتَسْكُنُوٓا۟ إِلَيْهَا وَجَعَلَ بَيْنَكُم مَّوَدَّةً وَرَحْمَةًۚ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّقَوْمٍ يَتَفَكَّرُونَ ","translation":"And of His signs is that He created for you from yourselves mates that you may find tranquility in them; and He placed between you affection and mercy. Indeed in that are signs for a people who give thought.","words":[{"id":1,"arabic":"وَمِنْ","translit":"ْnِmَw","root":""},{"id":2,"arabic":"ءَايَٰتِهِۦٓ","translit":"ٓۦِhِtَٰyāَء","root":"ايي"},{"id":3,"arabic":"أَنْ","translit":"ْnَaʾ","root":""},{"id":4,"arabic":"خَلَقَ","translit":"َqَlَhk","root":"خلق"},{"id":5,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":6,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":7,"arabic":"أَنفُسِكُمْ","translit":"ْmُkِsُfnَaʾ","root":"نفس"},{"id":8,"arabic":"أَزْوَٰجًا","translit":"āًjgَٰwْzَaʾ","root":"زوج"},{"id":9,"arabic":"لِّتَسْكُنُوٓا۟","translit":"۟āٓwُnُkْsَtِّl","root":"سكن"},{"id":10,"arabic":"إِلَيْهَا","translit":"āَhْyَlِiʾ","root":""},{"id":11,"arabic":"وَجَعَلَ","translit":"َlَʿعَjgَw","root":"جعل"},{"id":12,"arabic":"بَيْنَكُم","translit":"mُkَnْyَb","root":"بين"},{"id":13,"arabic":"مَّوَدَّةً","translit":"ًẗَّdَwَّm","root":"ودد"},{"id":14,"arabic":"وَرَحْمَةً","translit":"ًẗَmْḥَrَw","root":"رحم"},{"id":15,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":16,"arabic":"فِى","translit":"àِf","root":""},{"id":17,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":18,"arabic":"لَءَايَٰتٍ","translit":"ٍtَٰyāَءَl","root":"ايي"},{"id":19,"arabic":"لِّقَوْمٍ","translit":"ٍmْwَqِّl","root":"قوم"},{"id":20,"arabic":"يَتَفَكَّرُونَ","translit":"َnwُrَّkَfَtَy","root":"فكر"}],"hasIhya":false},{"ayah":22,"text":"وَمِنْ ءَايَٰتِهِۦ خَلْقُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَٱخْتِلَٰفُ أَلْسِنَتِكُمْ وَأَلْوَٰنِكُمْۚ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّلْعَٰلِمِينَ ","translation":"And of His signs is the creation of the heavens and the earth and the diversity of your languages and your colors. Indeed in that are signs for those of knowledge.","words":[{"id":1,"arabic":"وَمِنْ","translit":"ْnِmَw","root":""},{"id":2,"arabic":"ءَايَٰتِهِۦ","translit":"ۦِhِtَٰyāَء","root":"ايي"},{"id":3,"arabic":"خَلْقُ","translit":"ُqْlَhk","root":"خلق"},{"id":4,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":5,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":6,"arabic":"وَٱخْتِلَٰفُ","translit":"ُfَٰlِtْhkٱَw","root":"خلف"},{"id":7,"arabic":"أَلْسِنَتِكُمْ","translit":"ْmُkِtَnِsْlَaʾ","root":"لسن"},{"id":8,"arabic":"وَأَلْوَٰنِكُمْ","translit":"ْmُkِnَٰwْlَaʾَw","root":"لون"},{"id":9,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":10,"arabic":"فِى","translit":"àِf","root":""},{"id":11,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":12,"arabic":"لَءَايَٰتٍ","translit":"ٍtَٰyāَءَl","root":"ايي"},{"id":13,"arabic":"لِّلْعَٰلِمِينَ","translit":"َnyِmِlَٰʿعْlِّl","root":"علم"}],"hasIhya":false},{"ayah":23,"text":"وَمِنْ ءَايَٰتِهِۦ مَنَامُكُم بِٱلَّيْلِ وَٱلنَّهَارِ وَٱبْتِغَآؤُكُم مِّن فَضْلِهِۦٓۚ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّقَوْمٍ يَسْمَعُونَ ","translation":"And of His signs is your sleep by night and day and your seeking of His bounty. Indeed in that are signs for a people who listen.","words":[{"id":1,"arabic":"وَمِنْ","translit":"ْnِmَw","root":""},{"id":2,"arabic":"ءَايَٰتِهِۦ","translit":"ۦِhِtَٰyāَء","root":"ايي"},{"id":3,"arabic":"مَنَامُكُم","translit":"mُkُmāَnَm","root":"نوم"},{"id":4,"arabic":"بِٱلَّيْلِ","translit":"ِlْyَّlٱِb","root":"ليل"},{"id":5,"arabic":"وَٱلنَّهَارِ","translit":"ِrāَhَّnlٱَw","root":"نهر"},{"id":6,"arabic":"وَٱبْتِغَآؤُكُم","translit":"mُkُwʾٓāَغِtْbٱَw","root":"بغي"},{"id":7,"arabic":"مِّن","translit":"nِّm","root":""},{"id":8,"arabic":"فَضْلِهِۦٓ","translit":"ٓۦِhِlْḍَf","root":"فضل"},{"id":9,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":10,"arabic":"فِى","translit":"àِf","root":""},{"id":11,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":12,"arabic":"لَءَايَٰتٍ","translit":"ٍtَٰyāَءَl","root":"ايي"},{"id":13,"arabic":"لِّقَوْمٍ","translit":"ٍmْwَqِّl","root":"قوم"},{"id":14,"arabic":"يَسْمَعُونَ","translit":"َnwُʿعَmْsَy","root":"سمع"}],"hasIhya":false},{"ayah":24,"text":"وَمِنْ ءَايَٰتِهِۦ يُرِيكُمُ ٱلْبَرْقَ خَوْفًا وَطَمَعًا وَيُنَزِّلُ مِنَ ٱلسَّمَآءِ مَآءً فَيُحْىِۦ بِهِ ٱلْأَرْضَ بَعْدَ مَوْتِهَآۚ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّقَوْمٍ يَعْقِلُونَ ","translation":"And of His signs is [that] He shows you the lightning [causing] fear and aspiration, and He sends down rain from the sky by which He brings to life the earth after its lifelessness. Indeed in that are signs for a people who use reason.","words":[{"id":1,"arabic":"وَمِنْ","translit":"ْnِmَw","root":""},{"id":2,"arabic":"ءَايَٰتِهِۦ","translit":"ۦِhِtَٰyāَء","root":"ايي"},{"id":3,"arabic":"يُرِيكُمُ","translit":"ُmُkyِrُy","root":"راي"},{"id":4,"arabic":"ٱلْبَرْقَ","translit":"َqْrَbْlٱ","root":"برق"},{"id":5,"arabic":"خَوْفًا","translit":"āًfْwَhk","root":"خوف"},{"id":6,"arabic":"وَطَمَعًا","translit":"āًʿعَmَṭَw","root":"طمع"},{"id":7,"arabic":"وَيُنَزِّلُ","translit":"ُlِّzَnُyَw","root":"نزل"},{"id":8,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":9,"arabic":"ٱلسَّمَآءِ","translit":"ِءٓāَmَّslٱ","root":"سمو"},{"id":10,"arabic":"مَآءً","translit":"ًءٓāَm","root":"موه"},{"id":11,"arabic":"فَيُحْىِۦ","translit":"ۦِàْḥُyَf","root":"حيي"},{"id":12,"arabic":"بِهِ","translit":"ِhِb","root":""},{"id":13,"arabic":"ٱلْأَرْضَ","translit":"َḍْrَaʾْlٱ","root":"ارض"},{"id":14,"arabic":"بَعْدَ","translit":"َdْʿعَb","root":"بعد"},{"id":15,"arabic":"مَوْتِهَآ","translit":"ٓāَhِtْwَm","root":"موت"},{"id":16,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":17,"arabic":"فِى","translit":"àِf","root":""},{"id":18,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":19,"arabic":"لَءَايَٰتٍ","translit":"ٍtَٰyāَءَl","root":"ايي"},{"id":20,"arabic":"لِّقَوْمٍ","translit":"ٍmْwَqِّl","root":"قوم"},{"id":21,"arabic":"يَعْقِلُونَ","translit":"َnwُlِqْʿعَy","root":"عقل"}],"hasIhya":false},{"ayah":25,"text":"وَمِنْ ءَايَٰتِهِۦٓ أَن تَقُومَ ٱلسَّمَآءُ وَٱلْأَرْضُ بِأَمْرِهِۦۚ ثُمَّ إِذَا دَعَاكُمْ دَعْوَةً مِّنَ ٱلْأَرْضِ إِذَآ أَنتُمْ تَخْرُجُونَ ","translation":"And of His signs is that the heaven and earth stand [i.e., remain] by His command. Then when He calls you with a [single] call from the earth, immediately you will come forth.","words":[{"id":1,"arabic":"وَمِنْ","translit":"ْnِmَw","root":""},{"id":2,"arabic":"ءَايَٰتِهِۦٓ","translit":"ٓۦِhِtَٰyāَء","root":"ايي"},{"id":3,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":4,"arabic":"تَقُومَ","translit":"َmwُqَt","root":"قوم"},{"id":5,"arabic":"ٱلسَّمَآءُ","translit":"ُءٓāَmَّslٱ","root":"سمو"},{"id":6,"arabic":"وَٱلْأَرْضُ","translit":"ُḍْrَaʾْlٱَw","root":"ارض"},{"id":7,"arabic":"بِأَمْرِهِۦ","translit":"ۦِhِrْmَaʾِb","root":"امر"},{"id":8,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":9,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":10,"arabic":"دَعَاكُمْ","translit":"ْmُkāَʿعَd","root":"دعو"},{"id":11,"arabic":"دَعْوَةً","translit":"ًẗَwْʿعَd","root":"دعو"},{"id":12,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":13,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":14,"arabic":"إِذَآ","translit":"ٓāَhdِiʾ","root":""},{"id":15,"arabic":"أَنتُمْ","translit":"ْmُtnَaʾ","root":""},{"id":16,"arabic":"تَخْرُجُونَ","translit":"َnwُjgُrْhkَt","root":"خرج"}],"hasIhya":false},{"ayah":26,"text":"وَلَهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ كُلٌّ لَّهُۥ قَٰنِتُونَ ","translation":"And to Him belongs whoever is in the heavens and earth. All are to Him devoutly obedient.","words":[{"id":1,"arabic":"وَلَهُۥ","translit":"ۥُhَlَw","root":""},{"id":2,"arabic":"مَن","translit":"nَm","root":""},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":5,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":6,"arabic":"كُلٌّ","translit":"ٌّlُk","root":"كلل"},{"id":7,"arabic":"لَّهُۥ","translit":"ۥُhَّl","root":""},{"id":8,"arabic":"قَٰنِتُونَ","translit":"َnwُtِnَٰq","root":"قنت"}],"hasIhya":true},{"ayah":27,"text":"وَهُوَ ٱلَّذِى يَبْدَؤُا۟ ٱلْخَلْقَ ثُمَّ يُعِيدُهُۥ وَهُوَ أَهْوَنُ عَلَيْهِۚ وَلَهُ ٱلْمَثَلُ ٱلْأَعْلَىٰ فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ ","translation":"And it is He who begins creation; then He repeats it, and that is [even] easier for Him. To Him belongs the highest description [i.e., attribute] in the heavens and earth. And He is the Exalted in Might, the Wise.","words":[{"id":1,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"يَبْدَؤُا۟","translit":"۟āُwʾَdْbَy","root":"بدا"},{"id":4,"arabic":"ٱلْخَلْقَ","translit":"َqْlَhkْlٱ","root":"خلق"},{"id":5,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":6,"arabic":"يُعِيدُهُۥ","translit":"ۥُhُdyِʿعُy","root":"عود"},{"id":7,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":8,"arabic":"أَهْوَنُ","translit":"ُnَwْhَaʾ","root":"هون"},{"id":9,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":10,"arabic":"وَلَهُ","translit":"ُhَlَw","root":""},{"id":11,"arabic":"ٱلْمَثَلُ","translit":"ُlَhtَmْlٱ","root":"مثل"},{"id":12,"arabic":"ٱلْأَعْلَىٰ","translit":"ٰàَlْʿعَaʾْlٱ","root":"علو"},{"id":13,"arabic":"فِى","translit":"àِf","root":""},{"id":14,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":15,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":16,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":17,"arabic":"ٱلْعَزِيزُ","translit":"ُzyِzَʿعْlٱ","root":"عزز"},{"id":18,"arabic":"ٱلْحَكِيمُ","translit":"ُmyِkَḥْlٱ","root":"حكم"}],"hasIhya":false},{"ayah":28,"text":"ضَرَبَ لَكُم مَّثَلًا مِّنْ أَنفُسِكُمْۖ هَل لَّكُم مِّن مَّا مَلَكَتْ أَيْمَٰنُكُم مِّن شُرَكَآءَ فِى مَا رَزَقْنَٰكُمْ فَأَنتُمْ فِيهِ سَوَآءٌ تَخَافُونَهُمْ كَخِيفَتِكُمْ أَنفُسَكُمْۚ كَذَٰلِكَ نُفَصِّلُ ٱلْءَايَٰتِ لِقَوْمٍ يَعْقِلُونَ ","translation":"He presents to you an example from yourselves. Do you have among those whom your right hands possess [i.e., slaves] any partners in what We have provided for you so that you are equal therein [and] would fear them as your fear of one another [within a partnership]?[1] Thus do We detail the verses for a people who use reason.","words":[{"id":1,"arabic":"ضَرَبَ","translit":"َbَrَḍ","root":"ضرب"},{"id":2,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":3,"arabic":"مَّثَلًا","translit":"āًlَhtَّm","root":"مثل"},{"id":4,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":5,"arabic":"أَنفُسِكُمْ","translit":"ْmُkِsُfnَaʾ","root":"نفس"},{"id":6,"arabic":"هَل","translit":"lَh","root":""},{"id":7,"arabic":"لَّكُم","translit":"mُkَّl","root":""},{"id":8,"arabic":"مِّن","translit":"nِّm","root":""},{"id":9,"arabic":"مَّا","translit":"āَّm","root":""},{"id":10,"arabic":"مَلَكَتْ","translit":"ْtَkَlَm","root":"ملك"},{"id":11,"arabic":"أَيْمَٰنُكُم","translit":"mُkُnَٰmْyَaʾ","root":"يمن"},{"id":12,"arabic":"مِّن","translit":"nِّm","root":""},{"id":13,"arabic":"شُرَكَآءَ","translit":"َءٓāَkَrُhs","root":"شرك"},{"id":14,"arabic":"فِى","translit":"àِf","root":""},{"id":15,"arabic":"مَا","translit":"āَm","root":""},{"id":16,"arabic":"رَزَقْنَٰكُمْ","translit":"ْmُkَٰnْqَzَr","root":"رزق"},{"id":17,"arabic":"فَأَنتُمْ","translit":"ْmُtnَaʾَf","root":""},{"id":18,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":19,"arabic":"سَوَآءٌ","translit":"ٌءٓāَwَs","root":"سوي"},{"id":20,"arabic":"تَخَافُونَهُمْ","translit":"ْmُhَnwُfāَhkَt","root":"خوف"},{"id":21,"arabic":"كَخِيفَتِكُمْ","translit":"ْmُkِtَfyِhkَk","root":"خوف"},{"id":22,"arabic":"أَنفُسَكُمْ","translit":"ْmُkَsُfnَaʾ","root":"نفس"},{"id":23,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":24,"arabic":"نُفَصِّلُ","translit":"ُlِّṣَfُn","root":"فصل"},{"id":25,"arabic":"ٱلْءَايَٰتِ","translit":"ِtَٰyāَءْlٱ","root":"ايي"},{"id":26,"arabic":"لِقَوْمٍ","translit":"ٍmْwَqِl","root":"قوم"},{"id":27,"arabic":"يَعْقِلُونَ","translit":"َnwُlِqْʿعَy","root":"عقل"}],"hasIhya":false},{"ayah":29,"text":"بَلِ ٱتَّبَعَ ٱلَّذِينَ ظَلَمُوٓا۟ أَهْوَآءَهُم بِغَيْرِ عِلْمٍۖ فَمَن يَهْدِى مَنْ أَضَلَّ ٱللَّهُۖ وَمَا لَهُم مِّن نَّٰصِرِينَ ","translation":"But those who wrong follow their [own] desires without knowledge. Then who can guide one whom Allāh has sent astray? And for them there are no helpers.","words":[{"id":1,"arabic":"بَلِ","translit":"ِlَb","root":""},{"id":2,"arabic":"ٱتَّبَعَ","translit":"َʿعَbَّtٱ","root":"تبع"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"ظَلَمُوٓا۟","translit":"۟āٓwُmَlَẓ","root":"ظلم"},{"id":5,"arabic":"أَهْوَآءَهُم","translit":"mُhَءٓāَwْhَaʾ","root":"هوي"},{"id":6,"arabic":"بِغَيْرِ","translit":"ِrْyَغِb","root":"غير"},{"id":7,"arabic":"عِلْمٍ","translit":"ٍmْlِʿع","root":"علم"},{"id":8,"arabic":"فَمَن","translit":"nَmَf","root":""},{"id":9,"arabic":"يَهْدِى","translit":"àِdْhَy","root":"هدي"},{"id":10,"arabic":"مَنْ","translit":"ْnَm","root":""},{"id":11,"arabic":"أَضَلَّ","translit":"َّlَḍَaʾ","root":"ضلل"},{"id":12,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":13,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":14,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":15,"arabic":"مِّن","translit":"nِّm","root":""},{"id":16,"arabic":"نَّٰصِرِينَ","translit":"َnyِrِṣَّٰn","root":"نصر"}],"hasIhya":false},{"ayah":30,"text":"فَأَقِمْ وَجْهَكَ لِلدِّينِ حَنِيفًاۚ فِطْرَتَ ٱللَّهِ ٱلَّتِى فَطَرَ ٱلنَّاسَ عَلَيْهَاۚ لَا تَبْدِيلَ لِخَلْقِ ٱللَّهِۚ ذَٰلِكَ ٱلدِّينُ ٱلْقَيِّمُ وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَعْلَمُونَ ","translation":"So direct your face [i.e., self] toward the religion, inclining to truth. [Adhere to] the fiṭrah[1] of Allāh upon which He has created [all] people. No change should there be in the creation of Allāh.[2] That is the correct religion, but most of the people do not know.","words":[{"id":1,"arabic":"فَأَقِمْ","translit":"ْmِqَaʾَf","root":"قوم"},{"id":2,"arabic":"وَجْهَكَ","translit":"َkَhْjgَw","root":"وجه"},{"id":3,"arabic":"لِلدِّينِ","translit":"ِnyِّdlِl","root":"دين"},{"id":4,"arabic":"حَنِيفًا","translit":"āًfyِnَḥ","root":"حنف"},{"id":5,"arabic":"فِطْرَتَ","translit":"َtَrْṭِf","root":"فطر"},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"ٱلَّتِى","translit":"àِtَّlٱ","root":""},{"id":8,"arabic":"فَطَرَ","translit":"َrَṭَf","root":"فطر"},{"id":9,"arabic":"ٱلنَّاسَ","translit":"َsāَّnlٱ","root":"انس"},{"id":10,"arabic":"عَلَيْهَا","translit":"āَhْyَlَʿع","root":""},{"id":11,"arabic":"لَا","translit":"āَl","root":""},{"id":12,"arabic":"تَبْدِيلَ","translit":"َlyِdْbَt","root":"بدل"},{"id":13,"arabic":"لِخَلْقِ","translit":"ِqْlَhkِl","root":"خلق"},{"id":14,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":15,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":16,"arabic":"ٱلدِّينُ","translit":"ُnyِّdlٱ","root":"دين"},{"id":17,"arabic":"ٱلْقَيِّمُ","translit":"ُmِّyَqْlٱ","root":"قوم"},{"id":18,"arabic":"وَلَٰكِنَّ","translit":"َّnِkَٰlَw","root":""},{"id":19,"arabic":"أَكْثَرَ","translit":"َrَhtْkَaʾ","root":"كثر"},{"id":20,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":21,"arabic":"لَا","translit":"āَl","root":""},{"id":22,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":true},{"ayah":31,"text":"مُنِيبِينَ إِلَيْهِ وَٱتَّقُوهُ وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَلَا تَكُونُوا۟ مِنَ ٱلْمُشْرِكِينَ ","translation":"[Adhere to it], turning in repentance to Him, and fear Him and establish prayer and do not be of those who associate others with Allāh","words":[{"id":1,"arabic":"مُنِيبِينَ","translit":"َnyِbyِnُm","root":"نوب"},{"id":2,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":3,"arabic":"وَٱتَّقُوهُ","translit":"ُhwُqَّtٱَw","root":"وقي"},{"id":4,"arabic":"وَأَقِيمُوا۟","translit":"۟āwُmyِqَaʾَw","root":"قوم"},{"id":5,"arabic":"ٱلصَّلَوٰةَ","translit":"َẗٰwَlَّṣlٱ","root":"صلو"},{"id":6,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":7,"arabic":"تَكُونُوا۟","translit":"۟āwُnwُkَt","root":"كون"},{"id":8,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":9,"arabic":"ٱلْمُشْرِكِينَ","translit":"َnyِkِrْhsُmْlٱ","root":"شرك"}],"hasIhya":false},{"ayah":32,"text":"مِنَ ٱلَّذِينَ فَرَّقُوا۟ دِينَهُمْ وَكَانُوا۟ شِيَعًاۖ كُلُّ حِزْبٍۭ بِمَا لَدَيْهِمْ فَرِحُونَ ","translation":"[Or] of those who have divided their religion and become sects, every faction rejoicing in what it has.[1]","words":[{"id":1,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"فَرَّقُوا۟","translit":"۟āwُqَّrَf","root":"فرق"},{"id":4,"arabic":"دِينَهُمْ","translit":"ْmُhَnyِd","root":"دين"},{"id":5,"arabic":"وَكَانُوا۟","translit":"۟āwُnāَkَw","root":"كون"},{"id":6,"arabic":"شِيَعًا","translit":"āًʿعَyِhs","root":"شيع"},{"id":7,"arabic":"كُلُّ","translit":"ُّlُk","root":"كلل"},{"id":8,"arabic":"حِزْبٍۭ","translit":"ٍۭbْzِḥ","root":"حزب"},{"id":9,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":10,"arabic":"لَدَيْهِمْ","translit":"ْmِhْyَdَl","root":""},{"id":11,"arabic":"فَرِحُونَ","translit":"َnwُḥِrَf","root":"فرح"}],"hasIhya":true},{"ayah":33,"text":"وَإِذَا مَسَّ ٱلنَّاسَ ضُرٌّ دَعَوْا۟ رَبَّهُم مُّنِيبِينَ إِلَيْهِ ثُمَّ إِذَآ أَذَاقَهُم مِّنْهُ رَحْمَةً إِذَا فَرِيقٌ مِّنْهُم بِرَبِّهِمْ يُشْرِكُونَ ","translation":"And when adversity touches the people, they call upon their Lord, turning in repentance to Him. Then when He lets them taste mercy from Him, at once a party of them associate others with their Lord,","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"مَسَّ","translit":"َّsَm","root":"مسس"},{"id":3,"arabic":"ٱلنَّاسَ","translit":"َsāَّnlٱ","root":"انس"},{"id":4,"arabic":"ضُرٌّ","translit":"ٌّrُḍ","root":"ضرر"},{"id":5,"arabic":"دَعَوْا۟","translit":"۟āْwَʿعَd","root":"دعو"},{"id":6,"arabic":"رَبَّهُم","translit":"mُhَّbَr","root":"ربب"},{"id":7,"arabic":"مُّنِيبِينَ","translit":"َnyِbyِnُّm","root":"نوب"},{"id":8,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":9,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":10,"arabic":"إِذَآ","translit":"ٓāَhdِiʾ","root":""},{"id":11,"arabic":"أَذَاقَهُم","translit":"mُhَqāَhdَaʾ","root":"ذوق"},{"id":12,"arabic":"مِّنْهُ","translit":"ُhْnِّm","root":""},{"id":13,"arabic":"رَحْمَةً","translit":"ًẗَmْḥَr","root":"رحم"},{"id":14,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":15,"arabic":"فَرِيقٌ","translit":"ٌqyِrَf","root":"فرق"},{"id":16,"arabic":"مِّنْهُم","translit":"mُhْnِّm","root":""},{"id":17,"arabic":"بِرَبِّهِمْ","translit":"ْmِhِّbَrِb","root":"ربب"},{"id":18,"arabic":"يُشْرِكُونَ","translit":"َnwُkِrْhsُy","root":"شرك"}],"hasIhya":false},{"ayah":34,"text":"لِيَكْفُرُوا۟ بِمَآ ءَاتَيْنَٰهُمْۚ فَتَمَتَّعُوا۟ فَسَوْفَ تَعْلَمُونَ ","translation":"So that they will deny what We have granted them.[1] Then enjoy yourselves, for you are going to know.","words":[{"id":1,"arabic":"لِيَكْفُرُوا۟","translit":"۟āwُrُfْkَyِl","root":"كفر"},{"id":2,"arabic":"بِمَآ","translit":"ٓāَmِb","root":""},{"id":3,"arabic":"ءَاتَيْنَٰهُمْ","translit":"ْmُhَٰnْyَtāَء","root":"اتي"},{"id":4,"arabic":"فَتَمَتَّعُوا۟","translit":"۟āwُʿعَّtَmَtَf","root":"متع"},{"id":5,"arabic":"فَسَوْفَ","translit":"َfْwَsَf","root":""},{"id":6,"arabic":"تَعْلَمُونَ","translit":"َnwُmَlْʿعَt","root":"علم"}],"hasIhya":false},{"ayah":35,"text":"أَمْ أَنزَلْنَا عَلَيْهِمْ سُلْطَٰنًا فَهُوَ يَتَكَلَّمُ بِمَا كَانُوا۟ بِهِۦ يُشْرِكُونَ ","translation":"Or have We sent down to them an authority [i.e., a proof or scripture], and it speaks of what they have been associating with Him?","words":[{"id":1,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":2,"arabic":"أَنزَلْنَا","translit":"āَnْlَznَaʾ","root":"نزل"},{"id":3,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":4,"arabic":"سُلْطَٰنًا","translit":"āًnَٰṭْlُs","root":"سلط"},{"id":5,"arabic":"فَهُوَ","translit":"َwُhَf","root":""},{"id":6,"arabic":"يَتَكَلَّمُ","translit":"ُmَّlَkَtَy","root":"كلم"},{"id":7,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":8,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":9,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":10,"arabic":"يُشْرِكُونَ","translit":"َnwُkِrْhsُy","root":"شرك"}],"hasIhya":false},{"ayah":36,"text":"وَإِذَآ أَذَقْنَا ٱلنَّاسَ رَحْمَةً فَرِحُوا۟ بِهَاۖ وَإِن تُصِبْهُمْ سَيِّئَةٌۢ بِمَا قَدَّمَتْ أَيْدِيهِمْ إِذَا هُمْ يَقْنَطُونَ ","translation":"And when We let the people taste mercy, they rejoice therein, but if evil afflicts them for what their hands have put forth, immediately they despair.","words":[{"id":1,"arabic":"وَإِذَآ","translit":"ٓāَhdِiʾَw","root":""},{"id":2,"arabic":"أَذَقْنَا","translit":"āَnْqَhdَaʾ","root":"ذوق"},{"id":3,"arabic":"ٱلنَّاسَ","translit":"َsāَّnlٱ","root":"انس"},{"id":4,"arabic":"رَحْمَةً","translit":"ًẗَmْḥَr","root":"رحم"},{"id":5,"arabic":"فَرِحُوا۟","translit":"۟āwُḥِrَf","root":"فرح"},{"id":6,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":7,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":8,"arabic":"تُصِبْهُمْ","translit":"ْmُhْbِṣُt","root":"صوب"},{"id":9,"arabic":"سَيِّئَةٌۢ","translit":"ٌۢẗَyʾِّyَs","root":"سوا"},{"id":10,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":11,"arabic":"قَدَّمَتْ","translit":"ْtَmَّdَq","root":"قدم"},{"id":12,"arabic":"أَيْدِيهِمْ","translit":"ْmِhyِdْyَaʾ","root":"يدي"},{"id":13,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":14,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":15,"arabic":"يَقْنَطُونَ","translit":"َnwُṭَnْqَy","root":"قنط"}],"hasIhya":false},{"ayah":37,"text":"أَوَلَمْ يَرَوْا۟ أَنَّ ٱللَّهَ يَبْسُطُ ٱلرِّزْقَ لِمَن يَشَآءُ وَيَقْدِرُۚ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّقَوْمٍ يُؤْمِنُونَ ","translation":"Do they not see that Allāh extends provision for whom He wills and restricts [it]? Indeed in that are signs for a people who believe.","words":[{"id":1,"arabic":"أَوَلَمْ","translit":"ْmَlَwَaʾ","root":""},{"id":2,"arabic":"يَرَوْا۟","translit":"۟āْwَrَy","root":"راي"},{"id":3,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":4,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":5,"arabic":"يَبْسُطُ","translit":"ُṭُsْbَy","root":"بسط"},{"id":6,"arabic":"ٱلرِّزْقَ","translit":"َqْzِّrlٱ","root":"رزق"},{"id":7,"arabic":"لِمَن","translit":"nَmِl","root":""},{"id":8,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":9,"arabic":"وَيَقْدِرُ","translit":"ُrِdْqَyَw","root":"قدر"},{"id":10,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":11,"arabic":"فِى","translit":"àِf","root":""},{"id":12,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":13,"arabic":"لَءَايَٰتٍ","translit":"ٍtَٰyāَءَl","root":"ايي"},{"id":14,"arabic":"لِّقَوْمٍ","translit":"ٍmْwَqِّl","root":"قوم"},{"id":15,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"}],"hasIhya":false},{"ayah":38,"text":"فَـَٔاتِ ذَا ٱلْقُرْبَىٰ حَقَّهُۥ وَٱلْمِسْكِينَ وَٱبْنَ ٱلسَّبِيلِۚ ذَٰلِكَ خَيْرٌ لِّلَّذِينَ يُرِيدُونَ وَجْهَ ٱللَّهِۖ وَأُو۟لَٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ ","translation":"So give the relative his right, as well as the needy and the traveler. That is best for those who desire the face [i.e., approval] of Allāh, and it is they who will be the successful.","words":[{"id":1,"arabic":"فَـَٔاتِ","translit":"ِtāَٔـَf","root":"اتي"},{"id":2,"arabic":"ذَا","translit":"āَhd","root":""},{"id":3,"arabic":"ٱلْقُرْبَىٰ","translit":"ٰàَbْrُqْlٱ","root":"قرب"},{"id":4,"arabic":"حَقَّهُۥ","translit":"ۥُhَّqَḥ","root":"حقق"},{"id":5,"arabic":"وَٱلْمِسْكِينَ","translit":"َnyِkْsِmْlٱَw","root":"سكن"},{"id":6,"arabic":"وَٱبْنَ","translit":"َnْbٱَw","root":"بني"},{"id":7,"arabic":"ٱلسَّبِيلِ","translit":"ِlyِbَّslٱ","root":"سبل"},{"id":8,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":9,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":10,"arabic":"لِّلَّذِينَ","translit":"َnyِhdَّlِّl","root":""},{"id":11,"arabic":"يُرِيدُونَ","translit":"َnwُdyِrُy","root":"رود"},{"id":12,"arabic":"وَجْهَ","translit":"َhْjgَw","root":"وجه"},{"id":13,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":14,"arabic":"وَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَw","root":""},{"id":15,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":16,"arabic":"ٱلْمُفْلِحُونَ","translit":"َnwُḥِlْfُmْlٱ","root":"فلح"}],"hasIhya":false},{"ayah":39,"text":"وَمَآ ءَاتَيْتُم مِّن رِّبًا لِّيَرْبُوَا۟ فِىٓ أَمْوَٰلِ ٱلنَّاسِ فَلَا يَرْبُوا۟ عِندَ ٱللَّهِۖ وَمَآ ءَاتَيْتُم مِّن زَكَوٰةٍ تُرِيدُونَ وَجْهَ ٱللَّهِ فَأُو۟لَٰٓئِكَ هُمُ ٱلْمُضْعِفُونَ ","translation":"And whatever you give for interest [i.e., advantage] to increase within the wealth of people[1] will not increase with Allāh. But what you give in zakāh,[2] desiring the face [i.e., approval] of Allāh - those are the multipliers.[3]","words":[{"id":1,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":2,"arabic":"ءَاتَيْتُم","translit":"mُtْyَtāَء","root":"اتي"},{"id":3,"arabic":"مِّن","translit":"nِّm","root":""},{"id":4,"arabic":"رِّبًا","translit":"āًbِّr","root":"ربو"},{"id":5,"arabic":"لِّيَرْبُوَا۟","translit":"۟āَwُbْrَyِّl","root":"ربو"},{"id":6,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":7,"arabic":"أَمْوَٰلِ","translit":"ِlَٰwْmَaʾ","root":"مول"},{"id":8,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":9,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":10,"arabic":"يَرْبُوا۟","translit":"۟āwُbْrَy","root":"ربو"},{"id":11,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":12,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":13,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":14,"arabic":"ءَاتَيْتُم","translit":"mُtْyَtāَء","root":"اتي"},{"id":15,"arabic":"مِّن","translit":"nِّm","root":""},{"id":16,"arabic":"زَكَوٰةٍ","translit":"ٍẗٰwَkَz","root":"زكو"},{"id":17,"arabic":"تُرِيدُونَ","translit":"َnwُdyِrُt","root":"رود"},{"id":18,"arabic":"وَجْهَ","translit":"َhْjgَw","root":"وجه"},{"id":19,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":20,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":21,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":22,"arabic":"ٱلْمُضْعِفُونَ","translit":"َnwُfِʿعْḍُmْlٱ","root":"ضعف"}],"hasIhya":true},{"ayah":40,"text":"ٱللَّهُ ٱلَّذِى خَلَقَكُمْ ثُمَّ رَزَقَكُمْ ثُمَّ يُمِيتُكُمْ ثُمَّ يُحْيِيكُمْۖ هَلْ مِن شُرَكَآئِكُم مَّن يَفْعَلُ مِن ذَٰلِكُم مِّن شَىْءٍۚ سُبْحَٰنَهُۥ وَتَعَٰلَىٰ عَمَّا يُشْرِكُونَ ","translation":"Allāh is the one who created you, then provided for you, then will cause you to die, and then will give you life. Are there any of your \"partners\" who does anything of that? Exalted is He and high above what they associate with Him.","words":[{"id":1,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"خَلَقَكُمْ","translit":"ْmُkَqَlَhk","root":"خلق"},{"id":4,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":5,"arabic":"رَزَقَكُمْ","translit":"ْmُkَqَzَr","root":"رزق"},{"id":6,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":7,"arabic":"يُمِيتُ