", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَكَذَّبُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِـَٔايَٰتِنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلِقَآءِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لَاخِرَةِ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَأُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 9, "arabic": "فِے", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لْعَذَابِ", "translit": "", "root": ""}, {"id": 11, "arabic": "مُحْضَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 30, "ayah": 17, "text": "فَسُبْحَٰنَ اَ۬للَّهِ حِينَ تُمْسُونَ وَحِينَ تُصْبِحُونَ", "words": [{"id": 1, "arabic": "فَسُبْحَٰنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "حِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "تُمْسُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَحِينَ", "translit": "", "root": ""}, {"id": 6, "arabic": "تُصْبِحُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 30, "ayah": 18, "text": "وَلَهُ اُ۬لْحَمْدُ فِے اِ۬لسَّمَٰوَٰتِ وَالَارْضِ وَعَشِيّاࣰ وَحِينَ تُظْهِرُونَۖ", "words": [{"id": 1, "arabic": "وَلَهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لْحَمْدُ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَالَارْضِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَعَشِيّاࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَحِينَ", "translit": "", "root": ""}, {"id": 8, "arabic": "تُظْهِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 30, "ayah": 19, "text": "يُخْرِجُ اُ۬لْحَيَّ مِنَ اَ۬لْمَيِّتِ وَيُخْرِجُ اُ۬لْمَيِّتَ مِنَ اَ۬لْحَي