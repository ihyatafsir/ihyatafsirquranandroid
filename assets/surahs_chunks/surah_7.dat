,"arabic":"حِطَّةٌ","translit":"ٌẗَّṭِḥ","root":"حطط"},{"id":13,"arabic":"وَٱدْخُلُوا۟","translit":"۟āwُlُhkْdٱَw","root":"دخل"},{"id":14,"arabic":"ٱلْبَابَ","translit":"َbāَbْlٱ","root":"بوب"},{"id":15,"arabic":"سُجَّدًا","translit":"āًdَّjgُs","root":"سجد"},{"id":16,"arabic":"نَّغْفِرْ","translit":"ْrِfْغَّn","root":"غفر"},{"id":17,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":18,"arabic":"خَطِيٓـَٰٔتِكُمْ","translit":"ْmُkِtَٰٔـٓyِṭَhk","root":"خطا"},{"id":19,"arabic":"سَنَزِيدُ","translit":"ُdyِzَnَs","root":"زيد"},{"id":20,"arabic":"ٱلْمُحْسِنِينَ","translit":"َnyِnِsْḥُmْlٱ","root":"حسن"}],"hasIhya":false},{"ayah":162,"text":"فَبَدَّلَ ٱلَّذِينَ ظَلَمُوا۟ مِنْهُمْ قَوْلًا غَيْرَ ٱلَّذِى قِيلَ لَهُمْ فَأَرْسَلْنَا عَلَيْهِمْ رِجْزًا مِّنَ ٱلسَّمَآءِ بِمَا كَانُوا۟ يَظْلِمُونَ ","translation":"But those who wronged among them changed [the words] to a statement other than that which had been said to them. So We sent upon them a punishment from the sky for the wrong that they were doing.","words":[{"id":1,"arabic":"فَبَدَّلَ","translit":"َlَّdَbَf","root":"بدل"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ظَلَمُوا۟","translit":"۟āwُmَlَẓ","root":"ظلم"},{"id":4,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":5,"arabic":"قَوْلًا","translit":"āًlْwَq","root":"قول"},{"id":6,"arabic":"غَيْرَ","translit":"َrْyَغ","root":"غير"},{"id":7,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":8,"arabic":"قِيلَ","translit":"َlyِq","root":"قول"},{"id":9,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":10,"arabic":"فَأَرْسَلْنَا","translit":"āَnْlَsْrَaʾَf","root":"رسل"},{"id":11,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":12,"arabic":"رِجْزًا","translit":"āًzْjgِr","root":"رجز"},{"id":13,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":14,"arabic":"ٱلسَّمَآءِ","translit":"ِءٓāَmَّslٱ","root":"سمو"},{"id":15,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":16,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":17,"arabic":"يَظْلِمُونَ","translit":"َnwُmِlْẓَy","root":"ظلم"}],"hasIhya":false},{"ayah":163,"text":"وَسْـَٔلْهُمْ عَنِ ٱلْقَرْيَةِ ٱلَّتِى كَانَتْ حَاضِرَةَ ٱلْبَحْرِ إِذْ يَعْدُونَ فِى ٱلسَّبْتِ إِذْ تَأْتِيهِمْ حِيتَانُهُمْ يَوْمَ سَبْتِهِمْ شُرَّعًا وَيَوْمَ لَا يَسْبِتُونَۙ لَا تَأْتِيهِمْۚ كَذَٰلِكَ نَبْلُوهُم بِمَا كَانُوا۟ يَفْسُقُونَ ","translation":"And ask them about the town that was by the sea - when they transgressed in [the matter of] the sabbath - when their fish came to them openly on their sabbath day, and the day they had no sabbath they did not come to them. Thus did We give them trial because they were defiantly disobedient.","words":[{"id":1,"arabic":"وَسْـَٔلْهُمْ","translit":"ْmُhْlَٔـْsَw","root":"سال"},{"id":2,"arabic":"عَنِ","translit":"ِnَʿع","root":""},{"id":3,"arabic":"ٱلْقَرْيَةِ","translit":"ِẗَyْrَqْlٱ","root":"قري"},{"id":4,"arabic":"ٱلَّتِى","translit":"àِtَّlٱ","root":""},{"id":5,"arabic":"كَانَتْ","translit":"ْtَnāَk","root":"كون"},{"id":6,"arabic":"حَاضِرَةَ","translit":"َẗَrِḍāَḥ","root":"حضر"},{"id":7,"arabic":"ٱلْبَحْرِ","translit":"ِrْḥَbْlٱ","root":"بحر"},{"id":8,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":9,"arabic":"يَعْدُونَ","translit":"َnwُdْʿعَy","root":"عدو"},{"id":10,"arabic":"فِى","translit":"àِf","root":""},{"id":11,"arabic":"ٱلسَّبْتِ","translit":"ِtْbَّslٱ","root":"سبت"},{"id":12,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":13,"arabic":"تَأْتِيهِمْ","translit":"ْmِhyِtْaʾَt","root":"اتي"},{"id":14,"arabic":"حِيتَانُهُمْ","translit":"ْmُhُnāَtyِḥ","root":"حوت"},{"id":15,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":16,"arabic":"سَبْتِهِمْ","translit":"ْmِhِtْbَs","root":"سبت"},{"id":17,"arabic":"شُرَّعًا","translit":"āًʿعَّrُhs","root":"شرع"},{"id":18,"arabic":"وَيَوْمَ","translit":"َmْwَyَw","root":"يوم"},{"id":19,"arabic":"لَا","translit":"āَl","root":""},{"id":20,"arabic":"يَسْبِتُونَ","translit":"َnwُtِbْsَy","root":"سبت"},{"id":21,"arabic":"لَا","translit":"āَl","root":""},{"id":22,"arabic":"تَأْتِيهِمْ","translit":"ْmِhyِtْaʾَt","root":"اتي"},{"id":23,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":24,"arabic":"نَبْلُوهُم","translit":"mُhwُlْbَn","root":"بلو"},{"id":25,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":26,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":27,"arabic":"يَفْسُقُونَ","translit":"َnwُqُsْfَy","root":"فسق"}],"hasIhya":false},{"ayah":164,"text":"وَإِذْ قَالَتْ أُمَّةٌ مِّنْهُمْ لِمَ تَعِظُونَ قَوْمًاۙ ٱللَّهُ مُهْلِكُهُمْ أَوْ مُعَذِّبُهُمْ عَذَابًا شَدِيدًاۖ قَالُوا۟ مَعْذِرَةً إِلَىٰ رَبِّكُمْ وَلَعَلَّهُمْ يَتَّقُونَ ","translation":"And when a community among them said, \"Why do you advise [or warn] a people whom Allāh is [about] to destroy or to punish with a severe punishment?\" they [the advisors] said, \"To be absolved before your Lord and perhaps they may fear Him.\"","words":[{"id":1,"arabic":"وَإِذْ","translit":"ْhdِiʾَw","root":""},{"id":2,"arabic":"قَالَتْ","translit":"ْtَlāَq","root":"قول"},{"id":3,"arabic":"أُمَّةٌ","translit":"ٌẗَّmُaʾ","root":"امم"},{"id":4,"arabic":"مِّنْهُمْ","translit":"ْmُhْnِّm","root":""},{"id":5,"arabic":"لِمَ","translit":"َmِl","root":""},{"id":6,"arabic":"تَعِظُونَ","translit":"َnwُẓِʿعَt","root":"وعظ"},{"id":7,"arabic":"قَوْمًا","translit":"āًmْwَq","root":"قوم"},{"id":8,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":9,"arabic":"مُهْلِكُهُمْ","translit":"ْmُhُkِlْhُm","root":"هلك"},{"id":10,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":11,"arabic":"مُعَذِّبُهُمْ","translit":"ْmُhُbِّhdَʿعُm","root":"عذب"},{"id":12,"arabic":"عَذَابًا","translit":"āًbāَhdَʿع","root":"عذب"},{"id":13,"arabic":"شَدِيدًا","translit":"āًdyِdَhs","root":"شدد"},{"id":14,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":15,"arabic":"مَعْذِرَةً","translit":"ًẗَrِhdْʿعَm","root":"عذر"},{"id":16,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":17,"arabic":"رَبِّكُمْ","translit":"ْmُkِّbَr","root":"ربب"},{"id":18,"arabic":"وَلَعَلَّهُمْ","translit":"ْmُhَّlَʿعَlَw","root":""},{"id":19,"arabic":"يَتَّقُونَ","translit":"َnwُqَّtَy","root":"وقي"}],"hasIhya":false},{"ayah":165,"text":"فَلَمَّا نَسُوا۟ مَا ذُكِّرُوا۟ بِهِۦٓ أَنجَيْنَا ٱلَّذِينَ يَنْهَوْنَ عَنِ ٱلسُّوٓءِ وَأَخَذْنَا ٱلَّذِينَ ظَلَمُوا۟ بِعَذَابٍۭ بَـِٔيسٍۭ بِمَا كَانُوا۟ يَفْسُقُونَ ","translation":"And when they [i.e., those advised] forgot that by which they had been reminded, We saved those who had forbidden evil and seized those who wronged, with a wretched punishment, because they were defiantly disobeying.","words":[{"id":1,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":2,"arabic":"نَسُوا۟","translit":"۟āwُsَn","root":"نسي"},{"id":3,"arabic":"مَا","translit":"āَm","root":""},{"id":4,"arabic":"ذُكِّرُوا۟","translit":"۟āwُrِّkُhd","root":"ذكر"},{"id":5,"arabic":"بِهِۦٓ","translit":"ٓۦِhِb","root":""},{"id":6,"arabic":"أَنجَيْنَا","translit":"āَnْyَjgnَaʾ","root":"نجو"},{"id":7,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":8,"arabic":"يَنْهَوْنَ","translit":"َnْwَhْnَy","root":"نهي"},{"id":9,"arabic":"عَنِ","translit":"ِnَʿع","root":""},{"id":10,"arabic":"ٱلسُّوٓءِ","translit":"ِءٓwُّslٱ","root":"سوا"},{"id":11,"arabic":"وَأَخَذْنَا","translit":"āَnْhdَhkَaʾَw","root":"اخذ"},{"id":12,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":13,"arabic":"ظَلَمُوا۟","translit":"۟āwُmَlَẓ","root":"ظلم"},{"id":14,"arabic":"بِعَذَابٍۭ","translit":"ٍۭbāَhdَʿعِb","root":"عذب"},{"id":15,"arabic":"بَـِٔيسٍۭ","translit":"ٍۭsyِٔـَb","root":"باس"},{"id":16,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":17,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":18,"arabic":"يَفْسُقُونَ","translit":"َnwُqُsْfَy","root":"فسق"}],"hasIhya":true},{"ayah":166,"text":"فَلَمَّا عَتَوْا۟ عَن مَّا نُهُوا۟ عَنْهُ قُلْنَا لَهُمْ كُونُوا۟ قِرَدَةً خَٰسِـِٔينَ ","translation":"So when they were insolent about that which they had been forbidden, We said to them, \"Be apes, despised.\"","words":[{"id":1,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":2,"arabic":"عَتَوْا۟","translit":"۟āْwَtَʿع","root":"عتو"},{"id":3,"arabic":"عَن","translit":"nَʿع","root":""},{"id":4,"arabic":"مَّا","translit":"āَّm","root":""},{"id":5,"arabic":"نُهُوا۟","translit":"۟āwُhُn","root":"نهي"},{"id":6,"arabic":"عَنْهُ","translit":"ُhْnَʿع","root":""},{"id":7,"arabic":"قُلْنَا","translit":"āَnْlُq","root":"قول"},{"id":8,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":9,"arabic":"كُونُوا۟","translit":"۟āwُnwُk","root":"كون"},{"id":10,"arabic":"قِرَدَةً","translit":"ًẗَdَrِq","root":"قرد"},{"id":11,"arabic":"خَٰسِـِٔينَ","translit":"َnyِٔـِsَٰhk","root":"خسا"}],"hasIhya":false},{"ayah":167,"text":"وَإِذْ تَأَذَّنَ رَبُّكَ لَيَبْعَثَنَّ عَلَيْهِمْ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ مَن يَسُومُهُمْ سُوٓءَ ٱلْعَذَابِۗ إِنَّ رَبَّكَ لَسَرِيعُ ٱلْعِقَابِۖ وَإِنَّهُۥ لَغَفُورٌ رَّحِيمٌ ","translation":"And [mention] when your Lord declared that He would surely [continue to] send upon them until the Day of Resurrection those who would afflict them with the worst torment. Indeed, your Lord is swift in penalty; but indeed, He is Forgiving and Merciful.","words":[{"id":1,"arabic":"وَإِذْ","translit":"ْhdِiʾَw","root":""},{"id":2,"arabic":"تَأَذَّنَ","translit":"َnَّhdَaʾَt","root":"اذن"},{"id":3,"arabic":"رَبُّكَ","translit":"َkُّbَr","root":"ربب"},{"id":4,"arabic":"لَيَبْعَثَنَّ","translit":"َّnَhtَʿعْbَyَl","root":"بعث"},{"id":5,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":6,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":7,"arabic":"يَوْمِ","translit":"ِmْwَy","root":"يوم"},{"id":8,"arabic":"ٱلْقِيَٰمَةِ","translit":"ِẗَmَٰyِqْlٱ","root":"قوم"},{"id":9,"arabic":"مَن","translit":"nَm","root":""},{"id":10,"arabic":"يَسُومُهُمْ","translit":"ْmُhُmwُsَy","root":"سوم"},{"id":11,"arabic":"سُوٓءَ","translit":"َءٓwُs","root":"سوا"},{"id":12,"arabic":"ٱلْعَذَابِ","translit":"ِbāَhdَʿعْlٱ","root":"عذب"},{"id":13,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":14,"arabic":"رَبَّكَ","translit":"َkَّbَr","root":"ربب"},{"id":15,"arabic":"لَسَرِيعُ","translit":"ُʿعyِrَsَl","root":"سرع"},{"id":16,"arabic":"ٱلْعِقَابِ","translit":"ِbāَqِʿعْlٱ","root":"عقب"},{"id":17,"arabic":"وَإِنَّهُۥ","translit":"ۥُhَّnِiʾَw","root":""},{"id":18,"arabic":"لَغَفُورٌ","translit":"ٌrwُfَغَl","root":"غفر"},{"id":19,"arabic":"رَّحِيمٌ","translit":"ٌmyِḥَّr","root":"رحم"}],"hasIhya":false},{"ayah":168,"text":"وَقَطَّعْنَٰهُمْ فِى ٱلْأَرْضِ أُمَمًاۖ مِّنْهُمُ ٱلصَّٰلِحُونَ وَمِنْهُمْ دُونَ ذَٰلِكَۖ وَبَلَوْنَٰهُم بِٱلْحَسَنَٰتِ وَٱلسَّيِّـَٔاتِ لَعَلَّهُمْ يَرْجِعُونَ ","translation":"And We divided them throughout the earth into nations. Of them some were righteous, and of them some were otherwise. And We tested them with good [times] and bad that perhaps they would return [to obedience].","words":[{"id":1,"arabic":"وَقَطَّعْنَٰهُمْ","translit":"ْmُhَٰnْʿعَّṭَqَw","root":"قطع"},{"id":2,"arabic":"فِى","translit":"àِf","root":""},{"id":3,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":4,"arabic":"أُمَمًا","translit":"āًmَmُaʾ","root":"امم"},{"id":5,"arabic":"مِّنْهُمُ","translit":"ُmُhْnِّm","root":""},{"id":6,"arabic":"ٱلصَّٰلِحُونَ","translit":"َnwُḥِlَّٰṣlٱ","root":"صلح"},{"id":7,"arabic":"وَمِنْهُمْ","translit":"ْmُhْnِmَw","root":""},{"id":8,"arabic":"دُونَ","translit":"َnwُd","root":"دون"},{"id":9,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":10,"arabic":"وَبَلَوْنَٰهُم","translit":"mُhَٰnْwَlَbَw","root":"بلو"},{"id":11,"arabic":"بِٱلْحَسَنَٰتِ","translit":"ِtَٰnَsَḥْlٱِb","root":"حسن"},{"id":12,"arabic":"وَٱلسَّيِّـَٔاتِ","translit":"ِtāَٔـِّyَّslٱَw","root":"سوا"},{"id":13,"arabic":"لَعَلَّهُمْ","translit":"ْmُhَّlَʿعَl","root":""},{"id":14,"arabic":"يَرْجِعُونَ","translit":"َnwُʿعِjgْrَy","root":"رجع"}],"hasIhya":false},{"ayah":169,"text":"فَخَلَفَ مِنۢ بَعْدِهِمْ خَلْفٌ وَرِثُوا۟ ٱلْكِتَٰبَ يَأْخُذُونَ عَرَضَ هَٰذَا ٱلْأَدْنَىٰ وَيَقُولُونَ سَيُغْفَرُ لَنَا وَإِن يَأْتِهِمْ عَرَضٌ مِّثْلُهُۥ يَأْخُذُوهُۚ أَلَمْ يُؤْخَذْ عَلَيْهِم مِّيثَٰقُ ٱلْكِتَٰبِ أَن لَّا يَقُولُوا۟ عَلَى ٱللَّهِ إِلَّا ٱلْحَقَّ وَدَرَسُوا۟ مَا فِيهِۗ وَٱلدَّارُ ٱلْءَاخِرَةُ خَيْرٌ لِّلَّذِينَ يَتَّقُونَۗ أَفَلَا تَعْقِلُونَ ","translation":"And there followed them successors who inherited the Scripture [while] taking the commodities[1] of this lower life and saying, \"It will be forgiven for us.\" And if an offer like it[2] comes to them, they will [again] take it. Was not the covenant of the Scripture [i.e., the Torah] taken from them that they would not say about Allāh except the truth, and they studied what was in it? And the home of the Hereafter is better for those who fear Allāh, so will you not use reason?","words":[{"id":1,"arabic":"فَخَلَفَ","translit":"َfَlَhkَf","root":"خلف"},{"id":2,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":3,"arabic":"بَعْدِهِمْ","translit":"ْmِhِdْʿعَb","root":"بعد"},{"id":4,"arabic":"خَلْفٌ","translit":"ٌfْlَhk","root":"خلف"},{"id":5,"arabic":"وَرِثُوا۟","translit":"۟āwُhtِrَw","root":"ورث"},{"id":6,"arabic":"ٱلْكِتَٰبَ","translit":"َbَٰtِkْlٱ","root":"كتب"},{"id":7,"arabic":"يَأْخُذُونَ","translit":"َnwُhdُhkْaʾَy","root":"اخذ"},{"id":8,"arabic":"عَرَضَ","translit":"َḍَrَʿع","root":"عرض"},{"id":9,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":10,"arabic":"ٱلْأَدْنَىٰ","translit":"ٰàَnْdَaʾْlٱ","root":"دنو"},{"id":11,"arabic":"وَيَقُولُونَ","translit":"َnwُlwُqَyَw","root":"قول"},{"id":12,"arabic":"سَيُغْفَرُ","translit":"ُrَfْغُyَs","root":"غفر"},{"id":13,"arabic":"لَنَا","translit":"āَnَl","root":""},{"id":14,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":15,"arabic":"يَأْتِهِمْ","translit":"ْmِhِtْaʾَy","root":"اتي"},{"id":16,"arabic":"عَرَضٌ","translit":"ٌḍَrَʿع","root":"عرض"},{"id":17,"arabic":"مِّثْلُهُۥ","translit":"ۥُhُlْhtِّm","root":"مثل"},{"id":18,"arabic":"يَأْخُذُوهُ","translit":"ُhwُhdُhkْaʾَy","root":"اخذ"},{"id":19,"arabic":"أَلَمْ","translit":"ْmَlَaʾ","root":""},{"id":20,"arabic":"يُؤْخَذْ","translit":