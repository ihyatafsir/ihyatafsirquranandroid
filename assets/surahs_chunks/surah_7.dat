[9,14250,15208],[10,15208,16749],[11,16749,18054],[12,18054,19636],[13,19636,21912],[14,21912,24272],[15,24272,27309],[16,27309,28572],[17,28572,30488],[18,30488,31154],[19,31154,33125],[20,33125,33680],[21,33680,34707],[22,34707,35429],[23,35429,37206],[24,37206,38663],[25,38663,40273],[26,40273,42938],[27,42938,45759],[28,45759,47522],[29,47522,48244],[30,48244,50270]],"28":[[1,400,1869],[2,1869,3583],[3,3583,4862],[4,4862,6739],[5,6739,8467],[6,8467,10850],[7,10850,13832],[8,13832,15315],[9,15315,16893],[10,16893,17845],[11,17845,18444],[12,18444,19437],[13,19437,20512],[14,20512,21219],[15,21219,22498],[16,22498,25371],[17,25371,27657],[18,27657,28664],[19,28664,29739],[20,29739,30446],[21,30446,31153],[22,31153,32977]],"29":[[1,400,1005],[2,1005,1885],[3,1885,3054],[4,3054,4677],[5,4677,7291],[6,7291,9189],[7,9189,10069],[8,10069,10826],[9,10826,11954],[10,11954,13784],[11,13784,15682],[12,15682,16205],[13,16205,17732],[14,17732,18723],[15,18723,20154],[16,20154,22136]],"30":[[1,400,2120],[2,2120,3294],[3,3294,5423],[4,5423,6296],[5,6296,7825],[6,7825,9729],[7,9729,11244],[8,11244,13250],[9,13250,15870],[10,15870,18643],[11,18643,19189],[12,19189,20144],[13,20144,21222],[14,21222,23597],[15,23597,25112],[16,25112,27256]],"31":[[1,400,2596],[2,2596,3760],[3,3760,5162],[4,5162,6882],[5,6882,7729],[6,7729,8457],[7,8457,9542],[8,9542,11288],[9,11288,13431],[10,13431,14516],[11,14516,17056],[12,17056,18260],[13,18260,18948],[14,18948,20099],[15,20099,22189]],"32":[[1,400,1002],[2,1002,1549],[3,1549,2602],[4,2602,3778],[5,3778,4859],[6,4859,6760],[7,6760,7936],[8,7936,9769],[9,9769,12587],[10,12587,13134],[11,13134,14570],[12,14570,15172],[13,15172,15829],[14,15829,17566],[15,17566,19618],[16,19618,20302],[17,20302,22244],[18,22244,24200],[19,24200,25787],[20,25787,26881],[21,26881,28714],[22,28714,30016],[23,30016,31459],[24,31459,33401],[25,33401,34687],[26,34687,36660]],"33":[[1,400,1110],[2,1110,3126],[3,3126,4368],[4,4368,5739],[5,5739,7997],[6,7997,8836],[7,883