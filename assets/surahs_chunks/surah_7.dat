, [9, 10169, 11789], [10, 11789, 13686], [11, 13686, 15180]], "7:9": [[1, 330, 1057], [2, 1057, 1702], [3, 1702, 3219], [4, 3219, 5103], [5, 5103, 6194], [6, 6194, 8367], [7, 8367, 9392], [8, 9392, 10169], [9, 10169, 11789], [10, 11789, 13686], [11, 13686, 15180]], "10": [[1, 970, 1997], [2, 1997, 3513], [3, 3513, 3965], [4, 3965, 4800], [5, 4800, 6427], [6, 6427, 6949], [7, 6949, 8167], [8, 8167, 9359], [9, 9359, 10803], [10, 10803, 11656], [11, 11656, 12980]], "7:10": [[1, 970, 1997], [2, 1997, 3513], [3, 3513, 3965], [4, 3965, 4800], [5, 4800, 6427], [6, 6427, 6949], [7, 6949, 8167], [8, 8167, 9359], [9, 9359, 10803], [10, 10803, 11656], [11, 11656, 12980]], "11": [[1, 1150, 2590], [2, 2590, 4423], [3, 4423, 5228], [4, 5228, 7729], [5, 7729, 8534], [6, 8534, 9974], [7, 9974, 12561], [8, 12561, 14647], [9, 14647, 16233], [10, 16233, 19649], [11, 19649, 22346], [12, 22346, 24054], [13, 24054, 24542], [14, 24542, 25616], [15, 25616, 26397], [16, 26397, 28890]], "7:11": [[1, 1150, 2590], [2, 2590, 4423], [3, 4423, 5228], [4, 5228, 7729], [5, 7729, 8534], [6, 8534, 9974], [7, 9974, 12561], [8, 12561, 14647], [9, 14647, 16233], [10, 16233, 19649], [11, 19649, 22346], [12, 22346, 24054], [13, 24054, 24542], [14, 24542, 25616], [15, 25616, 26397], [16, 26397, 28890]], "12": [[1, 1150, 2161], [2, 2161, 2925], [3, 2925, 3802], [4, 3802, 4968], [5, 4968, 5814], [6, 5814, 6289], [7, 6289, 7362], [8, 7362, 8373], [9, 8373, 9384], [10, 9384, 10158], [11, 10158, 11004], [12, 11004, 12513], [13, 12513, 12926], [14, 12926, 14144], [15, 14144, 15797], [16, 15797, 16210], [17, 16210, 17170]], "7:12": [[1, 1150, 2161], [2, 2161, 2925], [3, 2925, 3802], [4, 3802, 4968], [5, 4968, 5814], [6, 5814, 6289], [7, 6289, 7362], [8, 7362, 8373], [9, 8373, 9384], [10, 9384, 10158], [11, 10158, 11004], [12, 11004, 12513], [13, 12513, 12926], [14, 12926, 14144], [15, 14144, 15797], [16, 15797, 16210], [17, 16210, 17170]], "13": [[1, 10, 997], [2, 997, 1979], [3, 1979, 3107], [4, 3107, 4054], [5,