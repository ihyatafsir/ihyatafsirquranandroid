": "", "root": ""}, {"id": 3, "arabic": "مِنْهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يَكُونُ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَن", "translit": "", "root": ""}, {"id": 8, "arabic": "تَتَكَبَّرَ", "translit": "", "root": ""}, {"id": 9, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 10, "arabic": "فَاخْرُجِ", "translit": "", "root": ""}, {"id": 11, "arabic": "اِنَّكَ", "translit": "", "root": ""}, {"id": 12, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 13, "arabic": "اَ۬لصَّٰغِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 14, "text": "قَالَ أَنظِرْنِےٓ إِلَيٰ يَوْمِ يُبْعَثُونَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَنظِرْنِےٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَوْمِ", "translit": "", "root": ""}, {"id": 5, "arabic": "يُبْعَثُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 15, "text": "قَالَ إِنَّكَ مِنَ اَ۬لْمُنظَرِينَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمُنظَرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 16, "text": "قَالَ فَبِمَآ أَغْوَيْتَنِے لَأَقْعُدَنَّ لَهُمْ صِرَٰطَكَ اَ۬لْمُسْتَقِيمَ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَبِمَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَغْوَيْتَنِے", "translit": "", "root": ""}, {"id": 4, "arabic": "لَأَقْعُدَنَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "صِرَٰطَكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْمُسْتَقِيمَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 17, "text": "ثُمَّ لَأٓتِيَنَّهُم مِّنۢ بَيْنِ أَيْدِيهِمْ وَمِنْ خَلْفِهِمْ وَعَنَ اَيْمَٰنِهِمْ وَعَن شَمَآئِلِهِمْۖ وَلَا تَجِدُ أَكْثَرَهُمْ شَٰكِرِينَۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَأٓتِيَنَّهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّنۢ", "translit": "", "root": ""}, {"id": 4, "arabic": "بَيْنِ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَيْدِيهِمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمِنْ", "translit": "", "root": ""}, {"id": 7, "arabic": "خَلْفِهِمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَعَنَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَيْمَٰنِهِمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَعَن", "translit": "", "root": ""}, {"id": 11, "arabic": "شَمَآئِلِهِمْۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 13, "arabic": "تَجِدُ", "translit": "", "root": ""}, {"id": 14, "arabic": "أَكْثَرَهُمْ", "translit": "", "root": ""}, {"id": 15, "arabic": "شَٰكِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 18, "text": "قَالَ اَ۟خْرُجْ مِنْهَا مَذْءُوماࣰ مَّدْحُوراࣰۖ لَّمَن تَبِعَكَ مِنْهُمْ لَأَمْلَأَنَّ جَهَنَّمَ مِنكُمُۥٓ أَجْمَعِينَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۟خْرُجْ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنْهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مَذْءُوماࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَّدْحُوراࣰۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَّمَن", "translit": "", "root": ""}, {"id": 7, "arabic": "تَبِعَكَ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِنْهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَأَمْلَأَنَّ", "translit": "", "root": ""}, {"id": 10, "arabic": "جَهَنَّمَ", "translit": "", "root": ""}, {"id": 11, "arabic": "مِنكُمُۥٓ", "translit": "", "root": ""}, {"id": 12, "arabic": "أَجْمَعِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 19, "text": "وَيَٰٓـَٔادَمُ اُ۟سْكُنَ اَنتَ وَزَوْجُكَ اَ۬لْجَنَّةَ فَكُلَا مِنْ حَيْثُ شِئْتُمَاۖ وَلَا تَقْرَبَا هَٰذِهِ اِ۬لشَّجَرَةَ فَتَكُونَا مِنَ اَ۬لظَّٰلِمِينَۖ", "words": [{"id": 1, "arabic": "وَيَٰٓـَٔادَمُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۟سْكُنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَنتَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَزَوْجُكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْجَنَّةَ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَكُلَا", "translit": "", "root": ""}, {"id": 7, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 8, "arabic": "حَيْثُ", "translit": "", "root": ""}, {"id": 9, "arabic": "شِئْتُمَاۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 11, "arabic": "تَقْرَبَا", "translit": "", "root": ""}, {"id": 12, "arabic": "هَٰذِهِ", "translit": "", "root": ""}, {"id": 13, "arabic": "اِ۬لشَّجَرَةَ", "translit": "", "root": ""}, {"id": 14, "arabic": "فَتَكُونَا", "translit": "", "root": ""}, {"id": 15, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 16, "arabic": "اَ۬لظَّٰلِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 20, "text": "فَوَسْوَسَ لَهُمَا اَ۬لشَّيْطَٰنُ لِيُبْدِيَ لَهُمَا مَا وُۥرِيَ عَنْهُمَا مِن سَوْءَٰتِهِمَاۖ وَقَالَ مَا نَه۪يٰكُمَا رَبُّكُمَا عَنْ هَٰذِهِ اِ۬لشَّجَرَةِ إِلَّآ أَن تَكُونَا مَلَكَيْنِ أَوْ تَكُونَا مِنَ اَ۬لْخَٰلِدِينَۖ", "words": [{"id": 1, "arabic": "فَوَسْوَسَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُمَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لشَّيْطَٰنُ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِيُبْدِيَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَهُمَا", "translit": "", "root": ""}, {"id": 6, "a