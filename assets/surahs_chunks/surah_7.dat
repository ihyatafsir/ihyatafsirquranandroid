"translit":"َّnَdُʿعْqَaʾَl","root":"قعد"},{"id":5,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":6,"arabic":"صِرَٰطَكَ","translit":"َkَṭَٰrِṣ","root":"صرط"},{"id":7,"arabic":"ٱلْمُسْتَقِيمَ","translit":"َmyِqَtْsُmْlٱ","root":"قوم"}],"hasIhya":true},{"ayah":17,"text":"ثُمَّ لَءَاتِيَنَّهُم مِّنۢ بَيْنِ أَيْدِيهِمْ وَمِنْ خَلْفِهِمْ وَعَنْ أَيْمَٰنِهِمْ وَعَن شَمَآئِلِهِمْۖ وَلَا تَجِدُ أَكْثَرَهُمْ شَٰكِرِينَ ","translation":"Then I will come to them from before them and from behind them and on their right and on their left, and You will not find most of them grateful [to You].\"","words":[{"id":1,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":2,"arabic":"لَءَاتِيَنَّهُم","translit":"mُhَّnَyِtāَءَl","root":"اتي"},{"id":3,"arabic":"مِّنۢ","translit":"ۢnِّm","root":""},{"id":4,"arabic":"بَيْنِ","translit":"ِnْyَb","root":"بين"},{"id":5,"arabic":"أَيْدِيهِمْ","translit":"ْmِhyِdْyَaʾ","root":"يدي"},{"id":6,"arabic":"وَمِنْ","translit":"ْnِmَw","root":""},{"id":7,"arabic":"خَلْفِهِمْ","translit":"ْmِhِfْlَhk","root":"خلف"},{"id":8,"arabic":"وَعَنْ","translit":"ْnَʿعَw","root":""},{"id":9,"arabic":"أَيْمَٰنِهِمْ","translit":"ْmِhِnَٰmْyَaʾ","root":"يمن"},{"id":10,"arabic":"وَعَن","translit":"nَʿعَw","root":""},{"id":11,"arabic":"شَمَآئِلِهِمْ","translit":"ْmِhِlِyʾٓāَmَhs","root":"شمل"},{"id":12,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":13,"arabic":"تَجِدُ","translit":"ُdِjgَt","root":"وجد"},{"id":14,"arabic":"أَكْثَرَهُمْ","translit":"ْmُhَrَhtْkَaʾ","root":"كثر"},{"id":15,"arabic":"شَٰكِرِينَ","translit":"َnyِrِkَٰhs","root":"شكر"}],"hasIhya":true},{"ayah":18,"text":"قَالَ ٱخْرُجْ مِنْهَا مَذْءُومًا مَّدْحُورًاۖ لَّمَن تَبِعَكَ مِنْهُمْ لَأَمْلَأَنَّ جَهَنَّمَ مِنكُمْ أَجْمَعِينَ ","translation":"[Allāh] said, \"Depart from it [i.e., Paradise], reproached and expelled. Whoever follows you among them - I will surely fill Hell with you, all together.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"ٱخْرُجْ","translit":"ْjgُrْhkٱ","root":"خرج"},{"id":3,"arabic":"مِنْهَا","translit":"āَhْnِm","root":""},{"id":4,"arabic":"مَذْءُومًا","translit":"āًmwُءْhdَm","root":"ذام"},{"id":5,"arabic":"مَّدْحُورًا","translit":"āًrwُḥْdَّm","root":"دحر"},{"id":6,"arabic":"لَّمَن","translit":"nَmَّl","root":""},{"id":7,"arabic":"تَبِعَكَ","translit":"َkَʿعِbَt","root":"تبع"},{"id":8,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":9,"arabic":"لَأَمْلَأَنَّ","translit":"َّnَaʾَlْmَaʾَl","root":"ملا"},{"id":10,"arabic":"جَهَنَّمَ","translit":"َmَّnَhَjg","root":""},{"id":11,"arabic":"مِنكُمْ","translit":"ْmُknِm","root":""},{"id":12,"arabic":"أَجْمَعِينَ","translit":"َnyِʿعَmْjgَaʾ","root":"جمع"}],"hasIhya":false},{"ayah":19,"text":"وَيَٰٓـَٔادَمُ ٱسْكُنْ أَنتَ وَزَوْجُكَ ٱلْجَنَّةَ فَكُلَا مِنْ حَيْثُ شِئْتُمَا وَلَا تَقْرَبَا هَٰذِهِ ٱلشَّجَرَةَ فَتَكُونَا مِنَ ٱلظَّٰلِمِينَ ","translation":"And \"O Adam, dwell, you and your wife, in Paradise and eat from wherever you will but do not approach this tree, lest you be among the wrongdoers.\"","words":[{"id":1,"arabic":"وَيَٰٓـَٔادَمُ","translit":"ُmَdāَٔـَٰٓyَw","root":"ادم"},{"id":2,"arabic":"ٱسْكُنْ","translit":"ْnُkْsٱ","root":"سكن"},{"id":3,"arabic":"أَنتَ","translit":"َtnَaʾ","root":""},{"id":4,"arabic":"وَزَوْجُكَ","translit":"َkُjgْwَzَw","root":"زوج"},{"id":5,"arabic":"ٱلْجَنَّةَ","translit":"َẗَّnَjgْlٱ","root":"جنن"},{"id":6,"arabic":"فَكُلَا","translit":"āَlُkَf","root":"اكل"},{"id":7,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":8,"arabic":"حَيْثُ","translit":"ُhtْyَḥ","root":"حيث"},{"id":9,"arabic":"شِئْتُمَا","translit":"āَmُtْyʾِhs","root":"شيا"},{"id":10,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":11,"arabic":"تَقْرَبَا","translit":"āَbَrْqَt","root":"قرب"},{"id":12,"arabic":"هَٰذِهِ","translit":"ِhِhdَٰh","root":""},{"id":13,"arabic":"ٱلشَّجَرَةَ","translit":"َẗَrَjgَّhslٱ","root":"شجر"},{"id":14,"arabic":"فَتَكُونَا","translit":"āَnwُkَtَf","root":"كون"},{"id":15,"arabic":"مِنَ","translit":"َn