":"َnyِmِkَٰḥْlٱ","root":"حكم"}],"hasIhya":true},{"ayah":88,"text":"قَالَ ٱلْمَلَأُ ٱلَّذِينَ ٱسْتَكْبَرُوا۟ مِن قَوْمِهِۦ لَنُخْرِجَنَّكَ يَٰشُعَيْبُ وَٱلَّذِينَ ءَامَنُوا۟ مَعَكَ مِن قَرْيَتِنَآ أَوْ لَتَعُودُنَّ فِى مِلَّتِنَاۚ قَالَ أَوَلَوْ كُنَّا كَٰرِهِينَ ","translation":"Said the eminent ones who were arrogant among his people, \"We will surely evict you, O Shuʿayb, and those who have believed with you from our city, or you must return to our religion.\" He said, \"Even if we were unwilling?","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"ٱلْمَلَأُ","translit":"ُaʾَlَmْlٱ","root":"ملا"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"ٱسْتَكْبَرُوا۟","translit":"۟āwُrَbْkَtْsٱ","root":"كبر"},{"id":5,"arabic":"مِن","translit":"nِm","root":""},{"id":6,"arabic":"قَوْمِهِۦ","translit":"ۦِhِmْwَq","root":"قوم"},{"id":7,"arabic":"لَنُخْرِجَنَّكَ","translit":"َkَّnَjgِrْhkُnَl","root":"خرج"},{"id":8,"arabic":"يَٰشُعَيْبُ","translit":"ُbْyَʿعُhsَٰy","root":""},{"id":9,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":10,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":11,"arabic":"مَعَكَ","translit":"َkَʿعَm","root":""},{"id":12,"arabic":"مِن","translit":"nِm","root":""},{"id":13,"arabic":"قَرْيَتِنَآ","translit":"ٓāَnِtَyْrَq","root":"قري"},{"id":14,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":15,"arabic":"لَتَعُودُنَّ","translit":"َّnُdwُʿعَtَl","root":"عود"},{"id":16,"arabic":"فِى","translit":"àِf","root":""},{"id":17,"arabic":"مِلَّتِنَا","translit":"āَnِtَّlِm","root":"ملل"},{"id":18,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":19,"arabic":"أَوَلَوْ","translit":"ْwَlَwَaʾ","root":""},{"id":20,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":21,"arabic":"كَٰرِهِينَ","translit":"َnyِhِrَٰk","root":"كره"}],"hasIhya":false},{"ayah":89,"text":"قَدِ ٱفْتَرَيْنَا عَلَى ٱللَّهِ كَذِبًا إِنْ عُدْنَا فِى مِلَّتِكُم بَعْدَ إِذْ نَجَّىٰنَا ٱللَّهُ مِنْهَاۚ وَمَا يَكُونُ لَنَآ أَن نَّعُودَ فِيهَآ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّنَاۚ وَسِعَ رَبُّنَا كُلَّ شَىْءٍ عِلْمًاۚ عَلَى ٱللَّهِ تَوَكَّلْنَاۚ رَبَّنَا ٱفْتَحْ بَيْنَنَا وَبَيْنَ قَوْمِنَا بِٱلْحَقِّ وَأَنتَ خَيْرُ ٱلْفَٰتِحِينَ ","translation":"We would have invented against Allāh a lie if we returned to your religion after Allāh had saved us from it. And it is not for us to return to it except that Allāh, our Lord, should will. Our Lord has encompassed all things in knowledge. Upon Allāh we have relied. Our Lord, decide between us and our people in truth, and You are the best of those who give decision.\"","words":[{"id":1,"arabic":"قَدِ","translit":"ِdَq","root":""},{"id":2,"arabic":"ٱفْتَرَيْنَا","translit":"āَnْyَrَtْfٱ","root":"فري"},{"id":3,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"كَذِبًا","translit":"āًbِhdَk","root":"كذب"},{"id":6,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":7,"arabic":"عُدْنَا","translit":"āَnْdُʿع","root":"عود"},{"id":8,"arabic":"فِى","translit":"àِf","root":""},{"id":9,"arabic":"مِلَّتِكُم","translit":"mُkِtَّlِm","root":"ملل"},{"id":10,"arabic":"بَعْدَ","translit":"َdْʿعَb","root":"بعد"},{"id":11,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":12,"arabic":"نَجَّىٰنَا","translit":"āَnٰàَّjgَn","root":"نجو"},{"id":13,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":14,"arabic":"مِنْهَا","translit":"āَhْnِm","root":""},{"id":15,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":16,"arabic":"يَكُونُ","translit":"ُnwُkَy","root":"كون"},{"id":17,"arabic":"لَنَآ","translit":"ٓāَnَl","root":""},{"id":18,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":19,"arabic":"نَّعُودَ","translit":"َdwُʿعَّn","root":"عود"},{"id":20,"arabic":"فِيهَآ","translit":"ٓāَhyِf","root":""},{"id":21,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":22,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":23,"arabic":"يَشَآءَ","tr