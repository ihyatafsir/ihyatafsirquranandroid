: "وَأُلْقِيَ اَ۬لسَّحَرَةُ سَٰجِدِينَۖ", "words": [{"id": 1, "arabic": "وَأُلْقِيَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لسَّحَرَةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "سَٰجِدِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 121, "text": "قَالُوٓاْ ءَامَنَّا بِرَبِّ اِ۬لْعَٰلَمِينَ", "words": [{"id": 1, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "ءَامَنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "بِرَبِّ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْعَٰلَمِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 122, "text": "رَبِّ مُوس۪يٰ وَهَٰرُونَۖ", "words": [{"id": 1, "arabic": "رَبِّ", "translit": "", "root": ""}, {"id": 2, "arabic": "مُوس۪يٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَهَٰرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 123, "text": "قَالَ فِرْعَوْنُ ءَاٰ۬مَنتُم بِهِۦ قَبْلَ أَنَ اٰذَنَ لَكُمُۥٓ إِنَّ هَٰذَا لَمَكْرࣱ مَّكَرْتُمُوهُ فِے اِ۬لْمَدِينَةِ لِتُخْرِجُواْ مِنْهَآ أَهْلَهَاۖ فَسَوْفَ تَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِرْعَوْنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَاٰ۬مَنتُم", "translit": "", "root": ""}, {"id": 4, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَبْلَ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اٰذَنَ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَكُمُۥٓ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 10, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 11, "arabic": "لَمَكْرࣱ", "translit": "", "root": ""}, {"id": 12, "arabic": "مَّكَرْتُمُوهُ", "translit": "", "root": ""}, {"id": 13, "arabic": "فِے", "translit": "", "root": ""}, {"id": 14, "arabic": "اِ۬لْمَدِينَةِ", "translit": "", "root": ""}, {"id