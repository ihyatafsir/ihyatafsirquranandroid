"مَعَ","translit":"َʿعَm","root":""},{"id":12,"arabic":"ٱلْقَوْمِ","translit":"ِmْwَqْlٱ","root":"قوم"},{"id":13,"arabic":"ٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱ","root":"ظلم"}],"hasIhya":false},{"ayah":48,"text":"وَنَادَىٰٓ أَصْحَٰبُ ٱلْأَعْرَافِ رِجَالًا يَعْرِفُونَهُم بِسِيمَىٰهُمْ قَالُوا۟ مَآ أَغْنَىٰ عَنكُمْ جَمْعُكُمْ وَمَا كُنتُمْ تَسْتَكْبِرُونَ ","translation":"And the companions of the Elevations will call to men [within Hell] whom they recognize by their mark, saying, \"Of no avail to you was your gathering[1] and [the fact] that you were arrogant.\"","words":[{"id":1,"arabic":"وَنَادَىٰٓ","translit":"ٰٓàَdāَnَw","root":"ندي"},{"id":2,"arabic":"أَصْحَٰبُ","translit":"ُbَٰḥْṣَaʾ","root":"صحب"},{"id":3,"arabic":"ٱلْأَعْرَافِ","translit":"ِfāَrْʿعَaʾْlٱ","root":"عرف"},{"id":4,"arabic":"رِجَالًا","translit":"āًlāَjgِr","root":"رجل"},{"id":5,"arabic":"يَعْرِفُونَهُم","translit":"mُhَnwُfِrْʿعَy","root":"عرف"},{"id":6,"arabic":"بِسِيمَىٰهُمْ","translit":"ْmُhٰàَmyِsِb","root":"سوم"},{"id":7,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":8,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":9,"arabic":"أَغْنَىٰ","translit":"ٰàَnْغَaʾ","root":"غني"},{"id":10,"arabic":"عَنكُمْ","translit":"ْmُknَʿع","root":""},{"id":11,"arabic":"جَمْعُكُمْ","translit":"ْmُkُʿعْmَjg","root":"جمع"},{"id":12,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":13,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":14,"arabic":"تَسْتَكْبِرُونَ","translit":"َnwُrِbْkَtْsَt","root":"كبر"}],"hasIhya":false},{"ayah":49,"text":"أَهَٰٓؤُلَآءِ ٱلَّذِينَ أَقْسَمْتُمْ لَا يَنَالُهُمُ ٱللَّهُ بِرَحْمَةٍۚ ٱدْخُلُوا۟ ٱلْجَنَّةَ لَا خَوْفٌ عَلَيْكُمْ وَلَآ أَنتُمْ تَحْزَنُونَ ","translation":"[Allāh will say], \"Are these[1] the ones whom you [inhabitants of Hell] swore that Allāh would never offer them mercy? Enter Paradise, [O people of the Elevations]. No fear will there be concerning you, nor will you grieve.\"","words":[{"id":1,"arabic":"أَهَٰٓؤُلَآءِ","translit":"ِءٓāَlُwʾَٰٓhَaʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"أَقْسَمْتُمْ","translit":"ْmُtْmَsْqَaʾ","root":"قسم"},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"يَنَالُهُمُ","translit":"ُmُhُlāَnَy","root":"نيل"},{"id":6,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":7,"arabic":"بِرَحْمَةٍ","translit":"ٍẗَmْḥَrِb","root":"رحم"},{"id":8,"arabic":"ٱدْخُلُوا۟","translit":"۟āwُlُhkْdٱ","root":"دخل"},{"id":9,"arabic":"ٱلْجَنَّةَ","translit":"َẗَّnَjgْlٱ","root":"جنن"},{"id":10,"arabic":"لَا","translit":"āَl","root":""},{"id":11,"arabic":"خَوْفٌ","translit":"ٌfْwَhk","root":"خوف"},{"id":12,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":13,"arabic":"وَلَآ","translit":"ٓāَlَw","root":""},{"id":14,"arabic":"أَنتُمْ","translit":"ْmُtnَaʾ","root":""},{"id":15,"arabic":"تَحْزَنُونَ","translit":"َnwُnَzْḥَt","root":"حزن"}],"hasIhya":false},{"ayah":50,"text":"وَنَادَىٰٓ أَصْحَٰبُ ٱلنَّارِ أَصْحَٰبَ ٱلْجَنَّةِ أَنْ أَفِيضُوا۟ عَلَيْنَا مِنَ ٱلْمَآءِ أَوْ مِمَّا رَزَقَكُمُ ٱللَّهُۚ قَالُوٓا۟ إِنَّ ٱللَّهَ حَرَّمَهُمَا عَلَى ٱلْكَٰفِرِينَ ","translation":"And the companions of the Fire will call to the companions of Paradise, \"Pour upon us some water or from whatever Allāh has provided you.\" They will say, \"Indeed, Allāh has forbidden them both to the disbelievers","words":[{"id":1,"arabic":"وَنَادَىٰٓ","translit":"ٰٓàَdāَnَw","root":"ندي"},{"id":2,"arabic":"أَصْحَٰبُ","translit":"ُbَٰḥْṣَaʾ","root":"صحب"},{"id":3,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"},{"id":4,"arabic":"أَصْحَٰبَ","translit":"َbَٰḥْṣَaʾ","root":"صحب"},{"id":5,"arabic":"ٱلْجَنَّةِ","translit":"ِẗَّnَjgْlٱ","root":"جنن"},{"id":6,"arabic":"أَنْ","translit":"ْnَaʾ","root":""},{"id":7,"arabic":"أَفِيضُوا۟","translit":"۟āwُḍyِfَaʾ","root":"فيض"},{"id":8,"arabic":"عَلَيْنَا","translit":"āَnْyَlَʿع","root":""},{"id":9,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":10,"arabic":"ٱلْمَآءِ","translit":"ِءٓāَmْlٱ","root":"موه"},{"id":11,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":12,"arabic":"مِمَّا","translit":"āَّmِm","root":""},{"id":13,"arabic":"رَزَقَكُمُ","translit":"ُmُkَqَzَr","root":"رزق"},{"id":14,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":15,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":16,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":17,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":18,"arabic":"حَرَّمَهُمَا","translit":"āَmُhَmَّrَḥ","root":"حرم"},{"id":19,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":20,"arabic":"ٱلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlٱ","root":"كفر"}],"hasIhya":true},{"ayah":51,"text":"ٱلَّذِينَ ٱتَّخَذُوا۟ دِينَهُمْ لَهْوًا وَلَعِبًا وَغَرَّتْهُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَاۚ فَٱلْيَوْمَ نَنسَىٰهُمْ كَمَا نَسُوا۟ لِقَآءَ يَوْمِهِمْ هَٰذَا وَمَا كَانُوا۟ بِـَٔايَٰتِنَا يَجْحَدُونَ ","translation":"Who took their religion as distraction and amusement and whom the worldly life deluded.\" So today We will forget them just as they forgot the meeting of this Day of theirs and for having rejected Our verses.","words":[{"id":1,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":2,"arabic":"ٱتَّخَذُوا۟","translit":"۟āwُhdَhkَّtٱ","root":"اخذ"},{"id":3,"arabic":"دِينَهُمْ","translit":"ْmُhَnyِd","root":"دين"},{"id":4,"arabic":"لَهْوًا","translit":"āًwْhَl","root":"لهو"},{"id":5,"arabic":"وَلَعِبًا","translit":"āًbِʿعَlَw","root":"لعب"},{"id":6,"arabic":"وَغَرَّتْهُمُ","translit":"ُmُhْtَّrَغَw","root":"غرر"},{"id":7,"arabic":"ٱلْحَيَوٰةُ","translit":"ُẗٰwَyَḥْlٱ","root":"حيي"},{"id":8,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":9,"arabic":"فَٱلْيَوْمَ","translit":"َmْwَyْlٱَf","root":"يوم"},{"id":10,"arabic":"نَنسَىٰهُمْ","translit":"ْmُhٰàَsnَn","root":"نسي"},{"id":11,"arabic":"كَمَا","translit":"āَmَk","root":""},{"id":12,"arabic":"نَسُوا۟","translit":"۟āwُsَn","root":"نسي"},{"id":13,"arabic":"لِقَآءَ","translit":"َءٓāَqِl","root":"لقي"},{"id":14,"arabic":"يَوْمِهِمْ","translit":"ْmِhِmْwَy","root":"يوم"},{"id":15,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":16,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":17,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":18,"arabic":"بِـَٔايَٰتِنَا","translit":"āَnِtَٰyāَٔـِb","root":"ايي"},{"id":19,"arabic":"يَجْحَدُونَ","translit":"َnwُdَḥْjgَy","root":"جحد"}],"hasIhya":false},{"ayah":52,"text":"وَلَقَدْ جِئْنَٰهُم بِكِتَٰبٍ فَصَّلْنَٰهُ عَلَىٰ عِلْمٍ هُدًى وَرَحْمَةً لِّقَوْمٍ يُؤْمِنُونَ ","translation":"And We had certainly brought them a Book which We detailed by knowledge - as guidance and mercy to a people who believe.","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"جِئْنَٰهُم","translit":"mُhَٰnْyʾِjg","root":"جيا"},{"id":3,"arabic":"بِكِتَٰبٍ","translit":"ٍbَٰtِkِb","root":"كتب"},{"id":4,"arabic":"فَصَّلْنَٰهُ","translit":"ُhَٰnْlَّṣَf","root":"فصل"},{"id":5,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":6,"arabic":"عِلْمٍ","translit":"ٍmْlِʿع","root":"علم"},{"id":7,"arabic":"هُدًى","translit":"àًdُh","root":"هدي"},{"id":8,"arabic":"وَرَحْمَةً","translit":"ًẗَmْḥَrَw","root":"رحم"},{"id":9,"arabic":"لِّقَوْمٍ","translit":"ٍmْwَqِّl","root":"قوم"},{"id":10,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"}],"hasIhya":true},{"ayah":53,"text":"هَلْ يَنظُرُونَ إِلَّا تَأْوِيلَهُۥۚ يَوْمَ يَأْتِى تَأْوِيلُهُۥ يَقُولُ ٱلَّذِينَ نَسُوهُ مِن قَبْلُ قَدْ جَآءَتْ رُسُلُ رَبِّنَا بِٱلْحَقِّ فَهَل لَّنَا مِن شُفَعَآءَ فَيَشْفَعُوا۟ لَنَآ أَوْ نُرَدُّ فَنَعْمَلَ غَيْرَ ٱلَّذِى كُنَّا نَعْمَلُۚ قَدْ خَسِرُوٓا۟ أَنفُسَهُمْ وَضَلَّ عَنْهُم مَّا كَانُوا۟ يَفْتَرُونَ ","translation":"Do they await except its result?[1] The Day its result comes, those who had ignored it before will say, \"The messengers of our Lord had come with the truth, so are there [now] any intercessors to intercede for us or could we be sent back to do other than what we used to do?\" They will have lost themselves, and lost from them is what they used to invent.","words":[{"id":1,"arabic":"هَلْ","translit":"ْlَh","root":""},{"id":2,"arabic":"يَنظُرُونَ","translit":"َnwُrُẓnَy","root":"نظر"},{"id":3,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":4,"arabic":"تَأْوِيلَهُۥ","translit":"ۥُhَlyِwْaʾَt","root":"اول"},{"id":5,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":6,"arabic":"يَأْتِى","translit":"àِtْaʾَy","root":"اتي"},{"id":7,"arabic":"تَأْوِيلُهُۥ","translit":"ۥُhُlyِwْaʾَt","root":"اول"},{"id":8,"arabic":"يَقُولُ","translit":"ُlwُqَy","root":"قول"},{"id":9,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":10,"arabic":"نَسُوهُ","translit":"ُhwُsَn","root":"نسي"},{"id":11,"arabic":"مِن","translit":"nِm","root":""},{"id":12,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":13,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":14,"arabic":"جَآءَتْ","translit":"ْtَءٓāَjg","root":"جيا"},{"id":15,"arabic":"رُسُلُ","translit":"ُlُsُr","root":"رسل"},{"id":16,"arabic":"رَبِّنَا","translit":"āَnِّbَr","root":"ربب"},{"id":17,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":18,"arabic":"فَهَل","translit":"lَhَf","root":""},{"id":19,"arabic":"لَّنَا","translit":"āَnَّl","root":""},{"id":20,"arabic":"مِن","translit":"nِm","root":""},{"id":21,"arabic":"شُفَعَآءَ","translit":"َءٓāَʿعَfُhs","root":"شفع"},{"id":22,"arabic":"فَيَشْفَعُوا۟","translit":"۟āwُʿعَfْhsَyَf","root":"شفع"},{"id":23,"arabic":"لَنَآ","translit":"ٓāَnَl","root":""},{"id":24,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":25,"arabic":"نُرَدُّ","translit":"ُّdَrُn","root":"ردد"},{"id":26,"arabic":"فَنَعْمَلَ","translit":"َlَmْʿعَnَf","root":"عمل"},{"id":27,"arabic":"غَيْرَ","translit":"َrْyَغ","root":"غير"},{"id":28,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":29,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":30,"arabic":"نَعْمَلُ","translit":"ُlَmْʿعَn","root":"عمل"},{"id":31,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":32,"arabic":"خَسِرُوٓا۟","translit":"۟āٓwُrِsَhk","root":"خسر"},{"id":33,"arabic":"أَنفُسَهُمْ","translit":"ْmُhَsُfnَaʾ","root":"نفس"},{"id":34,"arabic":"وَضَلَّ","translit":"َّlَḍَw","root":"ضلل"},{"id":35,"arabic":"عَنْهُم","translit":"mُhْnَʿع","root":""},{"id":36,"arabic":"مَّا","translit":"āَّm","root":""},{"id":37,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":38,"arabic":"يَفْتَرُونَ","translit":"َnwُrَtْfَy","root":"فري"}],"hasIhya":false},{"ayah":54,"text":"إِنَّ رَبَّكُمُ ٱللَّهُ ٱلَّذِى خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ فِى سِتَّةِ أَيَّامٍ ثُمَّ ٱسْتَوَىٰ عَلَى ٱلْعَرْشِ يُغْشِى ٱلَّيْلَ ٱلنَّهَارَ يَطْلُبُهُۥ حَثِيثًا وَٱلشَّمْسَ وَٱلْقَمَرَ وَٱلنُّجُومَ مُسَخَّرَٰتٍۭ بِأَمْرِهِۦٓۗ أَلَا لَهُ ٱلْخَلْقُ وَٱلْأَمْرُۗ تَبَارَكَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ ","translation":"Indeed, your Lord is Allāh, who created the heavens and earth in six days and then established Himself above the Throne.[1] He covers the night with the day, [another night] chasing it rapidly; and [He created] the sun, the moon, and the stars, subjected by His command. Unquestionably, His is the creation and the command; blessed is Allāh, Lord of the worlds.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"رَبَّكُمُ","translit":"ُmُkَّbَr","root":"ربب"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":5,"arabic":"خَلَقَ","translit":"َqَlَhk","root":"خلق"},{"id":6,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":7,"arabic":"وَٱلْأَرْضَ","translit":"َḍْrَaʾْlٱَw","root":"ارض"},{"id":8,"arabic":"فِى","translit":"àِf","root":""},{"id":9,"arabic":"سِتَّةِ","translit":"ِẗَّtِs","root":"ستت"},{"id":10,"arabic":"أَيَّامٍ","translit":"ٍmāَّyَaʾ","root":"يوم"},{"id":11,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":12,"arabic":"ٱسْتَوَىٰ","translit":"ٰàَwَtْsٱ","root":"سوي"},{"id":13,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":14,"arabic":"ٱلْعَرْشِ","translit":"ِhsْrَʿعْlٱ","root":"عرش"},{"id":15,"arabic":"يُغْشِى","translit":"àِhsْغُy","root":"غشو"},{"id":16,"arabic":"ٱلَّيْلَ","translit":"َlْyَّlٱ","root":"ليل"},{"id":17,"arabic":"ٱلنَّهَارَ","translit":"َrāَhَّnlٱ","root":"نهر"},{"id":18,"arabic":"يَطْلُبُهُۥ","translit":"ۥُhُbُlْṭَy","root":"طلب"},{"id":19,"arabic":"حَثِيثًا","translit":"āًhtyِhtَḥ","root":"حثث"},{"id":20,"arabic":"وَٱلشَّمْسَ","translit":"َsْmَّhslٱَw","root":"شمس"},{"id":21,"arabic":"وَٱلْقَمَرَ","translit":"َrَmَqْlٱَw","root":"قمر"},{"id":22,"arabic":"وَٱلنُّجُومَ","translit":"َmwُjgُّnlٱَw","root":"نجم"},{"id":23,"arabic":"مُسَخَّرَٰتٍۭ","translit":"ٍۭtَٰrَّhkَsُm","root":"سخر"},{"id":24,"arabic":"بِأَمْرِهِۦٓ","translit":"ٓۦِhِrْmَaʾِb","root":"امر"},{"id":25,"arabic":"أَلَا","translit":"āَlَaʾ","root":""},{"id":26,"arabic":"لَهُ","translit":"ُhَl","root":""},{"id":27,"arabic":"ٱلْخَلْقُ","translit":"ُqْlَhkْlٱ","root":"خلق"},{"id":28,"arabic":"وَٱلْأَمْرُ","translit":"ُrْmَaʾْlٱَw","root":"امر"},{"id":29,"arabic":"تَبَارَكَ","translit":"َkَrāَbَt","root":"برك"},{"id":30,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":31,"arabic":"رَبُّ","translit":"ُّbَr","root":"ربب"},{"id":32,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":true},{"ayah":55,"text":"ٱدْعُوا۟ رَبَّكُمْ تَضَرُّعًا وَخُفْيَةًۚ إِنَّهُۥ لَا يُحِبُّ ٱلْمُعْتَدِينَ ","translation":"Call upon your Lord in humility and privately; indeed, He does not like transgressors.[1]","words":[{"id":1,"arabic":"ٱدْعُوا۟","translit":"۟āwُʿعْdٱ","root":"دعو"},{"id":2,"arabic":"رَبَّكُمْ","translit":"ْmُkَّbَr","root":"ربب"},{"id":3,"arabic":"تَضَرُّعًا","translit":"āًʿعُّrَḍَt","root":"ضرع"},{"id":4,"arabic":"وَخُفْيَةً","translit":"ًẗَyْfُhkَw","root":"خفي"},{"id":5,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":6,"arabic":"لَا","translit":"āَl","root":""},{"id":7,"arabic":"يُحِبُّ","translit":"ُّbِḥُy","root":"حبب"},{"id":8,"arabic":"ٱلْمُعْتَدِينَ","translit":"َnyِdَtْʿعُmْlٱ","root":"عدو"}],"hasIhya":true},{"ayah":56,"text":"وَلَا تُفْسِدُوا۟ فِى ٱلْأَرْضِ بَعْدَ إِصْلَٰحِهَا وَٱدْعُوهُ خَوْفًا وَطَمَعًاۚ إِنَّ رَحْمَتَ ٱللَّهِ قَرِيبٌ مِّنَ ٱلْمُحْسِنِينَ ","translation":"And cause not corruption upon the earth after its reformation. And invoke Him in fear and aspiration. Indeed, the mercy of Allāh is near to the doers of good.","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"تُفْسِدُوا۟","translit":"۟āwُdِsْfُt","root":"فسد"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":5,"arabic":"بَعْدَ","translit":"َdْʿعَb","root":"بعد"},{"id":6,"arabic":"إِصْلَٰحِهَا","translit":"āَhِḥَٰlْṣِiʾ","root":"صلح"},{"id":7,"arabic":"وَٱدْعُوهُ","translit":"ُhwُʿعْdٱَw","root":"دعو"},{"id":8,"arabic":"خَوْفًا","translit":"āًfْwَhk","root":"خوف"},{"id":9,"arabic":"وَطَمَعًا","translit":"āًʿعَmَṭَw","root":"طمع"},{"id":10,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":11,"arabic":"رَحْمَتَ","translit":"َtَmْḥَr","root":"رحم"},{"id":12,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":13,"arabic":"قَرِيبٌ","translit":"ٌbyِrَq","root":"قرب"},{"id":14,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":15,"arabic":"ٱلْمُحْسِنِينَ","translit":"َnyِnِsْḥُmْlٱ","root":"حسن"}],"hasIhya":true},{"ayah":57,"text":"وَهُوَ ٱلَّذِى يُرْسِلُ ٱلرِّيَٰحَ بُشْرًۢا بَيْنَ يَدَىْ رَحْمَتِهِۦۖ حَتَّىٰٓ إِذَآ أَقَلَّتْ سَحَابًا ثِقَالًا سُقْنَٰهُ لِبَلَدٍ مَّيِّتٍ فَأَنزَلْنَا بِهِ ٱلْمَآءَ فَأَخْرَجْنَا بِهِۦ مِن كُلِّ ٱلثَّمَرَٰتِۚ كَذَٰلِكَ نُخْرِجُ ٱلْمَوْتَىٰ لَعَلَّكُمْ تَذَكَّرُونَ ","translation":"And it is He who sends the winds as good tidings before His mercy [i.e., rainfall] until, when they have carried heavy rainclouds, We drive them to a dead land and We send down rain therein and bring forth thereby [some] of all the fruits. Thus will We bring forth the dead; perhaps you may be reminded.","words":[{"id":1,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"يُرْسِلُ","translit":"ُlِsْrُy","root":"رسل"},{"id":4,"arabic":"ٱلرِّيَٰحَ","translit":"َḥَٰyِّrlٱ","root":"روح"},{"id":5,"arabic":"بُشْرًۢا","translit":"āًۢrْhsُb","root":"بشر"},{"id":6,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":7,"arabic":"يَدَىْ","translit":"ْàَdَy","root":"يدي"},{"id":8,"arabic":"رَحْمَتِهِۦ","translit":"ۦِhِtَmْḥَr","root":"رحم"},{"id":9,"arabic":"حَتَّىٰٓ","translit":"ٰٓàَّtَḥ","root":""},{"id":10,"arabic":"إِذَآ","translit":"ٓāَhdِiʾ","root":""},{"id":11,"arabic":"أَقَلَّتْ","translit":"ْtَّlَqَaʾ","root":"قلل"},{"id":12,"arabic":"سَحَابًا","translit":"āًbāَḥَs","root":"سحب"},{"id":13,"arabic":"ثِقَالًا","translit":"āًlāَqِht","root":"ثقل"},{"id":14,"arabic":"سُقْنَٰهُ","translit":"ُhَٰnْqُs","root":"سوق"},{"id":15,"arabic":"لِبَلَدٍ","translit":"ٍdَlَbِl","root":"بلد"},{"id":16,"arabic":"مَّيِّتٍ","translit":"ٍtِّyَّm","root":"موت"},{"id":17,"arabic":"فَأَنزَلْنَا","translit":"āَnْlَznَaʾَf","root":"نزل"},{"id":18,"arabic":"بِهِ","translit":"ِhِb","root":""},{"id":19,"arabic":"ٱلْمَآءَ","translit":"َءٓāَmْlٱ","root":"موه"},{"id":20,"arabic":"فَأَخْرَجْنَا","translit":"āَnْjgَrْhkَaʾَf","root":"خرج"},{"id":21,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":22,"arabic":"مِن","translit":"nِm","root":""},{"id":23,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":24,"arabic":"ٱلثَّمَرَٰتِ","translit":"ِtَٰrَmَّhtlٱ","root":"ثمر"},{"id":25,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":26,"arabic":"نُخْرِجُ","translit":"ُjgِrْhkُn","root":"خرج"},{"id":27,"arabic":"ٱلْمَوْتَىٰ","translit":"ٰàَtْwَmْlٱ","root":"موت"},{"id":28,"arabic":"لَعَلَّكُمْ","translit":"ْmُkَّlَʿعَl","root":""},{"id":29,"arabic":"تَذَكَّرُونَ","translit":"َnwُrَّkَhdَt","root":"ذكر"}],"hasIhya":true},{"ayah":58,"text":"وَٱلْبَلَدُ ٱلطَّيِّبُ يَخْرُجُ نَبَاتُهُۥ بِإِذْنِ رَبِّهِۦۖ وَٱلَّذِى خَبُثَ لَا يَخْرُجُ إِلَّا نَكِدًاۚ كَذَٰلِكَ نُصَرِّفُ ٱلْءَايَٰتِ لِقَوْمٍ يَشْكُرُونَ ","translation":"And the good land - its vegetation emerges by permission of its Lord; but that which is bad - nothing emerges except sparsely, with difficulty. Thus do We diversify the signs for a people who are grateful.","words":[{"id":1,"arabic":"وَٱلْبَلَدُ","translit":"ُdَlَbْlٱَw","root":"بلد"},{"id":2,"arabic":"ٱلطَّيِّبُ","translit":"ُbِّyَّṭlٱ","root":"طيب"},{"id":3,"arabic":"يَخْرُجُ","translit":"ُjgُrْhkَy","root":"خرج"},{"id":4,"arabic":"نَبَاتُهُۥ","translit":"ۥُhُtāَbَn","root":"نبت"},{"id":5,"arabic":"بِإِذْنِ","translit":"ِnْhdِiʾِb","root":"اذن"},{"id":6,"arabic":"رَبِّهِۦ","translit":"ۦِhِّbَr","root":"ربب"},{"id":7,"arabic":"وَٱلَّذِى","translit":"àِhdَّlٱَw","root":""},{"id":8,"arabic":"خَبُثَ","translit":"َhtُbَhk","root":"خبث"},{"id":9,"arabic":"لَا","translit":"āَl","root":""},{"id":10,"arabic":"يَخْرُجُ","translit":"ُjgُrْhkَy","root":"خرج"},{"id":11,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":12,"arabic":"نَكِدًا","translit":"āًdِkَn","root":"نكد"},{"id":13,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":14,"arabic":"نُصَرِّفُ","translit":"ُfِّrَṣُn","root":"صرف"},{"id":15,"arabic":"ٱلْءَايَٰتِ","translit":"ِtَٰyāَءْlٱ","root":"ايي"},{"id":16,"arabic":"لِقَوْمٍ","translit":"ٍmْwَqِl","root":"قوم"},{"id":17,"arabic":"يَشْكُرُونَ","translit":"َnwُrُkْhsَy","root":"شكر"}],"hasIhya":false},{"ayah":59,"text":"لَقَدْ أَرْسَلْنَا نُوحًا إِلَىٰ قَوْمِهِۦ فَقَالَ يَٰقَوْمِ ٱعْبُدُوا۟ ٱللَّهَ مَا لَكُم مِّنْ إِلَٰهٍ غَيْرُهُۥٓ إِنِّىٓ أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَظِيمٍ ","translation":"We had certainly sent Noah to his people, and he said, \"O my people, worship Allāh; you have no deity other than Him. Indeed, I fear for you the punishment of a tremendous Day.\"","words":[{"id":1,"arabic":"لَقَدْ","translit":"ْdَqَl","root":""},{"id":2,"arabic":"أَرْسَلْنَا","translit":"āَnْlَsْrَaʾ","root":"رسل"},{"id":3,"arabic":"نُوحًا","translit":"āًḥwُn","root":""},{"id":4,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":5,"arabic":"قَوْمِهِۦ","translit":"ۦِhِmْwَq","root":"قوم"},{"id":6,"arabic":"فَقَالَ","translit":"َlāَqَf","root":"قول"},{"id":7,"arabic":"يَٰقَوْمِ","translit":"ِmْwَqَٰy","root":"قوم"},{"id":8,"arabic":"ٱعْبُدُوا۟","translit":"۟āwُdُbْʿعٱ","root":"عبد"},{"id":9,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":10,"arabic":"مَا","translit":"āَm","root":""},{"id":11,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":12,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":13,"arabic":"إِلَٰهٍ","translit":"ٍhَٰlِiʾ","root":"اله"},{"id":14,"arabic":"غَيْرُهُۥٓ","translit":"ٓۥُhُrْyَغ","root":"غير"},{"id":15,"arabic":"إِنِّىٓ","translit":"ٓàِّnِiʾ","root":""},{"id":16,"arabic":"أَخَافُ","translit":"ُfāَhkَaʾ","root":"خوف"},{"id":17,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":18,"arabic":"عَذَابَ","translit":"َbāَhdَʿع","root":"عذب"},{"id":19,"arabic":"يَوْمٍ","translit":"ٍmْwَy","root":"يوم"},{"id":20,"arabic":"عَظِيمٍ","translit":"ٍmyِẓَʿع","root":"عظم"}],"hasIhya":false},{"ayah":60,"text":"قَالَ ٱلْمَلَأُ مِن قَوْمِهِۦٓ إِنَّا لَنَرَىٰكَ فِى ضَلَٰلٍ مُّبِينٍ ","translation":"Said the eminent among his people, \"Indeed, we see you in clear error.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"ٱلْمَلَأُ","translit":"ُaʾَlَmْlٱ","root":"ملا"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"قَوْمِهِۦٓ","translit":"ٓۦِhِmْwَq","root":"قوم"},{"id":5,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":6,"arabic":"لَنَرَىٰكَ","translit":"َkٰàَrَnَl","root":"راي"},{"id":7,"arabic":"فِى","translit":"àِf","root":""},{"id":8,"arabic":"ضَلَٰلٍ","translit":"ٍlَٰlَḍ","root":"ضلل"},{"id":9,"arabic":"مُّبِينٍ","translit":"ٍnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":61,"text":"قَالَ يَٰقَوْمِ لَيْسَ بِى ضَلَٰلَةٌ وَلَٰكِنِّى رَسُولٌ مِّن رَّبِّ ٱلْعَٰلَمِينَ ","translation":"[Noah] said, \"O my people, there is not error in me, but I am a messenger from the Lord of the worlds.","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"يَٰقَوْمِ","translit":"ِmْwَqَٰy","root":"قوم"},{"id":3,"arabic":"لَيْسَ","translit":"َsْyَl","root":"ليس"},{"id":4,"arabic":"بِى","translit":"àِb","root":""},{"id":5,"arabic":"ضَلَٰلَةٌ","translit":"ٌẗَlَٰlَḍ","root":"ضلل"},{"id":6,"arabic":"وَلَٰكِنِّى","translit":"àِّnِkَٰlَw","root":""},{"id":7,"arabic":"رَسُولٌ","translit":"ٌlwُsَr","root":"رسل"},{"id":8,"arabic":"مِّن","translit":"nِّm","root":""},{"id":9,"arabic":"رَّبِّ","translit":"ِّbَّr","root":"ربب"},{"id":10,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":62,"text":"أُبَلِّغُكُمْ رِسَٰلَٰتِ رَبِّى وَأَنصَحُ لَكُمْ وَأَعْلَمُ مِنَ ٱللَّهِ مَا لَا تَعْلَمُونَ ","translation":"I convey to you the messages of my Lord and advise you; and I know from Allāh what you do not know.","words":[{"id":1,"arabic":"أُبَلِّغُكُمْ","translit":"ْmُkُغِّlَbُaʾ","root":"بلغ"},{"id":2,"arabic":"رِسَٰلَٰتِ","translit":"ِtَٰlَٰsِr","root":"رسل"},{"id":3,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":4,"arabic":"وَأَنصَحُ","translit":"ُḥَṣnَaʾَw","root":"نصح"},{"id":5,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":6,"arabic":"وَأَعْلَمُ","translit":"ُmَlْʿعَaʾَw","root":"علم"},{"id":7,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":8,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":9,"arabic":"مَا","translit":"āَm","root":""},{"id":10,"arabic":"لَا","translit":"āَl","root":""},{"id":11,"arabic":"تَعْلَمُونَ","translit":"َnwُmَlْʿعَt","root":"علم"}],"hasIhya":false},{"ayah":63,"text":"أَوَعَجِبْتُمْ أَن جَآءَكُمْ ذِكْرٌ مِّن رَّبِّكُمْ عَلَىٰ رَجُلٍ مِّنكُمْ لِيُنذِرَكُمْ وَلِتَتَّقُوا۟ وَلَعَلَّكُمْ تُرْحَمُونَ ","translation":"Then do you wonder that there has come to you a reminder from your Lord through a man from among you, that he may warn you and that you may fear Allāh so you might receive mercy?\"","words":[{"id":1,"arabic":"أَوَعَجِبْتُمْ","translit":"ْmُtْbِjgَʿعَwَaʾ","root":"عجب"},{"id":2,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":3,"arabic":"جَآءَكُمْ","translit":"ْmُkَءٓāَjg","root":"جيا"},{"id":4,"arabic":"ذِكْرٌ","translit":"ٌrْkِhd","root":"ذكر"},{"id":5,"arabic":"مِّن","translit":"nِّm","root":""},{"id":6,"arabic":"رَّبِّكُمْ","translit":"ْmُkِّbَّr","root":"ربب"},{"id":7,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":8,"arabic":"رَجُلٍ","translit":"ٍlُjgَr","root":"رجل"},{"id":9,"arabic":"مِّنكُمْ","translit":"ْmُknِّm","root":""},{"id":10,"arabic":"لِيُنذِرَكُمْ","translit":"ْmُkَrِhdnُyِl","root":"نذر"},{"id":11,"arabic":"وَلِتَتَّقُوا۟","translit":"۟āwُqَّtَtِlَw","root":"وقي"},{"id":12,"arabic":"وَلَعَلَّكُمْ","translit":"ْmُkَّlَʿعَlَw","root":""},{"id":13,"arabic":"تُرْحَمُونَ","translit":"َnwُmَḥْrُt","root":"رحم"}],"hasIhya":true},{"ayah":64,"text":"فَكَذَّبُوهُ فَأَنجَيْنَٰهُ وَٱلَّذِينَ مَعَهُۥ فِى ٱلْفُلْكِ وَأَغْرَقْنَا ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَآۚ إِنَّهُمْ كَانُوا۟ قَوْمًا عَمِينَ ","translation":"But they denied him, so We saved him and those who were with him in the ship. And We drowned those who denied Our signs. Indeed, they were a blind people.[1]","words":[{"id":1,"arabic":"فَكَذَّبُوهُ","translit":"ُhwُbَّhdَkَf","root":"كذب"},{"id":2,"arabic":"فَأَنجَيْنَٰهُ","translit":"ُhَٰnْyَjgnَaʾَf","root":"نجو"},{"id":3,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":4,"arabic":"مَعَهُۥ","translit":"ۥُhَʿعَm","root":""},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"ٱلْفُلْكِ","translit":"ِkْlُfْlٱ","root":"فلك"},{"id":7,"arabic":"وَأَغْرَقْنَا","translit":"āَnْqَrْغَaʾَw","root":"غرق"},{"id":8,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":9,"arabic":"كَذَّبُوا۟","translit":"۟āwُbَّhdَk","root":"كذب"},{"id":10,"arabic":"بِـَٔايَٰتِنَآ","translit":"ٓāَnِtَٰyāَٔـِb","root":"ايي"},{"id":11,"arabic":"إِنَّهُمْ","translit":"ْmُhَّnِiʾ","root":""},{"id":12,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":13,"arabic":"قَوْمًا","translit":"āًmْwَq","root":"قوم"},{"id":14,"arabic":"عَمِينَ","translit":"َnyِmَʿع","root":"عمي"}],"hasIhya":false},{"ayah":65,"text":"وَإِلَىٰ عَادٍ أَخَاهُمْ هُودًاۗ قَالَ يَٰقَوْمِ ٱعْبُدُوا۟ ٱللَّهَ مَا لَكُم مِّنْ إِلَٰهٍ غَيْرُهُۥٓۚ أَفَلَا تَتَّقُونَ ","translation":"And to the ʿAad [We sent] their brother Hūd. He said, \"O my people, worship Allāh; you have no deity other than Him. Then will you not fear Him?\"","words":[{"id":1,"arabic":"وَإِلَىٰ","translit":"ٰàَlِiʾَw","root":""},{"id":2,"arabic":"عَادٍ","translit":"ٍdāَʿع","root":"عود"},{"id":3,"arabic":"أَخَاهُمْ","translit":"ْmُhāَhkَaʾ","root":"اخو"},{"id":4,"arabic":"هُودًا","translit":"āًdwُh","root":"هود"},{"id":5,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":6,"arabic":"يَٰقَوْمِ","translit":"ِmْwَqَٰy","root":"قوم"},{"id":7,"arabic":"ٱعْبُدُوا۟","translit":"۟āwُdُbْʿعٱ","root":"عبد"},{"id":8,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":9,"arabic":"مَا","translit":"āَm","root":""},{"id":10,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":11,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":12,"arabic":"إِلَٰهٍ","translit":"ٍhَٰlِiʾ","root":"اله"},{"id":13,"arabic":"غَيْرُهُۥٓ","translit":"ٓۥُhُrْyَغ","root":"غير"},{"id":14,"arabic":"أَفَلَا","translit":"āَlَfَaʾ","root":""},{"id":15,"arabic":"تَتَّقُونَ","translit":"َnwُqَّtَt","root":"وقي"}],"hasIhya":false},{"ayah":66,"text":"قَالَ ٱلْمَلَأُ ٱلَّذِينَ كَفَرُوا۟ مِن قَوْمِهِۦٓ إِنَّا لَنَرَىٰكَ فِى سَفَاهَةٍ وَإِنَّا لَنَظُنُّكَ مِنَ ٱلْكَٰذِبِينَ ","translation":"Said the eminent ones who disbelieved among his people, \"Indeed, we see you in foolishness, and indeed, we think you are of the liars.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"ٱلْمَلَأُ","translit":"ُaʾَlَmْlٱ","root":"ملا"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"كَفَرُوا۟","translit":"۟āw