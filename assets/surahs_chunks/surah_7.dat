d":5,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":6,"arabic":"نَاصِحٌ","translit":"ٌḥِṣāَn","root":"نصح"},{"id":7,"arabic":"أَمِينٌ","translit":"ٌnyِmَaʾ","root":"امن"}],"hasIhya":false},{"ayah":69,"text":"أَوَعَجِبْتُمْ أَن جَآءَكُمْ ذِكْرٌ مِّن رَّبِّكُمْ عَلَىٰ رَجُلٍ مِّنكُمْ لِيُنذِرَكُمْۚ وَٱذْكُرُوٓا۟ إِذْ جَعَلَكُمْ خُلَفَآءَ مِنۢ بَعْدِ قَوْمِ نُوحٍ وَزَادَكُمْ فِى ٱلْخَلْقِ بَصْۜطَةًۖ فَٱذْكُرُوٓا۟ ءَالَآءَ ٱللَّهِ لَعَلَّكُمْ تُفْلِحُونَ ","translation":"Then do you wonder that there has come to you a reminder from your Lord through a man from among you, that he may warn you? And remember when He made you successors after the people of Noah and increased you in stature extensively. So remember the favors of Allāh that you might succeed.\"","words":[{"id":1,"arabic":"أَوَعَجِبْتُمْ","translit":"ْmُtْbِjgَʿعَwَaʾ","root":"عجب"},{"id":2,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":3,"arabic":"جَآءَكُمْ","translit":"ْmُkَءٓāَjg","root":"جيا"},{"id":4,"arabic":"ذِكْرٌ","translit":"ٌrْkِhd","root":"ذكر"},{"id":5,"arabic":"مِّن","translit":"nِّm","root":""},{"id":6,"arabic":"رَّبِّكُمْ","translit":"ْmُkِّbَّr","root":"ربب"},{"id":7,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":8,"arabic":"رَجُلٍ","translit":"ٍlُjgَr","root":"رجل"},{"id":9,"arabic":"مِّنكُمْ","translit":"ْmُknِّm","root":""},{"id":10,"arabic":"لِيُنذِرَكُمْ","translit":"ْmُkَrِhdnُyِl","root":"نذر"},{"id":11,"arabic":"وَٱذْكُرُوٓا۟","translit":"۟āٓwُrُkْhdٱَw","root":"ذكر"},{"id":12,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":13,"arabic":"جَعَلَكُمْ","translit":"ْmُkَlَʿعَjg","root":"جعل"},{"id":14,"arabic":"خُلَفَآءَ","translit":"َءٓāَfَlُhk","root":"خلف"},{"id":15,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":16,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":17,"arabic":"قَوْمِ","translit":"ِmْwَq","root":"قوم"},{"id":18,"arabic":"نُوحٍ","translit":"ٍḥwُn","root":""},{"id":19,"arabic":"وَزَادَكُمْ","translit":"ْmُkَdāَzَw","root":"زيد"},{"id":20,"arabic":"فِى","translit":"àِf","root":""},{"id":21,"arabic":"ٱلْخَلْقِ","translit":"ِqْlَhkْlٱ","root":"خلق"},{"id":22,"arabic":"بَصْۜطَةً","translit":"ًẗَṭْۜṣَb","root":"بسط"},{"id":23,"arabic":"فَٱذْكُرُوٓا۟","translit":"۟āٓwُrُkْhdٱَf","root":"ذكر"},{"id":24,"arabic":"ءَالَآءَ","translit":"َءٓāَlāَء","root":"الو"},{"id":25,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":26,"arabic":"لَعَلَّكُمْ","translit":"ْmُkَّlَʿعَl","root":""},{"id":27,"arabic":"تُفْلِحُونَ","translit":"َnwُḥِlْfُt","root":"فلح"}],"hasIhya":true},{"ayah":70,"text":"قَالُوٓا۟ أَجِئْتَنَا لِنَعْبُدَ ٱللَّهَ وَحْدَهُۥ وَنَذَرَ مَا كَانَ يَعْبُدُ ءَابَآؤُنَاۖ فَأْتِنَا بِمَا تَعِدُنَآ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ ","translation":"They said, \"Have you come to us that we should worship Allāh alone and leave what our fathers have worshipped? Then bring us what you promise us,[1] if you should be of the truthful.\"","words":[{"id":1,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":2,"arabic":"أَجِئْتَنَا","translit":"āَnَtْyʾِjgَaʾ","root":"جيا"},{"id":3,"arabic":"لِنَعْبُدَ","translit":"َdُbْʿعَnِl","root":"عبد"},{"id":4,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":5,"arabic":"وَحْدَهُۥ","translit":"ۥُhَdْḥَw","root":"وحد"},{"id":6,"arabic":"وَنَذَرَ","translit":"َrَhdَnَw","root":"وذر"},{"id":7,"arabic":"مَا","translit":"āَm","root":""},{"id":8,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":9,"arabic":"يَعْبُدُ","translit":"ُdُbْʿعَy","root":"عبد"},{"id":10,"arabic":"ءَابَآؤُنَا","translit":"āَnُwʾٓāَbāَء","root":"ابو"},{"id":11,"arabic":"فَأْتِنَا","translit":"āَnِtْaʾَf","root":"اتي"},{"id":12,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":13,"arabic":"تَعِدُنَآ","translit":"ٓāَnُdِʿعَt","root":"وعد"},{"id":14,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":15,"arabic":"كُنتَ","translit":"َtnُk","root":"كون"},{"id":16,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":17,"arabic":"ٱلصَّٰدِقِينَ","translit":"َnyِqِdَّٰṣlٱ","root":"صدق"}],"hasIhya":false},{"ayah":71,"text":"قَالَ قَدْ وَقَعَ عَلَيْكُم مِّن رَّبِّكُمْ رِجْسٌ وَغَضَبٌۖ أَتُجَٰدِلُونَنِى فِىٓ أَسْمَآءٍ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّا نَزَّلَ ٱللَّهُ بِهَا مِن سُلْطَٰنٍۚ فَٱنتَظِرُوٓا۟ إِنِّى مَعَكُم مِّنَ ٱلْمُنتَظِرِينَ ","translation":"[Hūd] said, \"Already have defilement and anger fallen upon you from your Lord. Do you dispute with me concerning [mere] names you have named them,[1] you and your fathers, for which Allāh has not sent down any authority? Then wait; indeed, I am with you among those who wait.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":3,"arabic":"وَقَعَ","translit":"َʿعَqَw","root":"وقع"},{"id":4,"arabic":"عَلَيْكُم","translit":"mُkْyَlَʿع","root":""},{"id":5,"arabic":"مِّن","translit":"nِّm","root":""},{"id":6,"arabic":"رَّبِّكُمْ","translit":"ْmُkِّbَّr","root":"ربب"},{"id":7,"arabic":"رِجْسٌ","translit":"ٌsْjgِr","root":"رجس"},{"id":8,"arabic":"وَغَضَبٌ","translit":"ٌbَḍَغَw","root":"غضب"},{"id":9,"arabic":"أَتُجَٰدِلُونَنِى","translit":"àِnَnwُlِdَٰjgُtَaʾ","root":"جدل"},{"id":10,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":11,"arabic":"أَسْمَآءٍ","translit":"ٍءٓāَmْsَaʾ","root":"سمو"},{"id":12,"arabic":"سَمَّيْتُمُوهَآ","translit":"ٓāَhwُmُtْyَّmَs","root":"سمو"},{"id":13,"arabic":"أَنتُمْ","translit":"ْmُtnَaʾ","root":""},{"id":14,"arabic":"وَءَابَآؤُكُم","translit":"mُkُwʾٓāَbāَءَw","root":"ابو"},{"id":15,"arabic":"مَّا","translit":"āَّm","root":""},{"id":16,"arabic":"نَزَّلَ","translit":"َlَّzَn","root":"نزل"},{"id":17,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":18,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":19,"arabic":"مِن","translit":"nِm","root":""},{"id":20,"arabic":"سُلْطَٰنٍ","translit":"ٍnَٰṭْlُs","root":"سلط"},{"id":21,"arabic":"فَٱنتَظِرُوٓا۟","translit":"۟āٓwُrِẓَtnٱَf","root":"نظر"},{"id":22,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":23,"arabic":"مَعَكُم","translit":"mُkَʿعَm","root":""},{"id":24,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":25,"arabic":"ٱلْمُنتَظِرِينَ","translit":"َnyِrِẓَtnُmْlٱ","root":"نظر"}],"hasIhya":false},{"ayah":72,"text":"فَأَنجَيْنَٰهُ وَٱلَّذِينَ مَعَهُۥ بِرَحْمَةٍ مِّنَّا وَقَطَعْنَا دَابِرَ ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَاۖ وَمَا كَانُوا۟ مُؤْمِنِينَ ","translation":"So We saved him and those with him by mercy from Us. And We eliminated those who denied Our signs, and they were not [at all] believers.","words":[{"id":1,"arabic":"فَأَنجَيْنَٰهُ","translit":"ُhَٰnْyَjgnَaʾَf","root":"نجو"},{"id":2,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":3,"arabic":"مَعَهُۥ","translit":"ۥُhَʿعَm","root":""},{"id":4,"arabic":"بِرَحْمَةٍ","translit":"ٍẗَmْḥَrِb","root":"رحم"},{"id":5,"arabic":"مِّنَّا","translit":"āَّnِّm","root":""},{"id":6,"arabic":"وَقَطَعْنَا","translit":"āَnْʿعَṭَqَw","root":"قطع"},{"id":7,"arabic":"دَابِرَ","translit":"َrِbāَd","root":"دبر"},{"id":8,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":9,"arabic":"كَذَّبُوا۟","translit":"۟āwُbَّhdَk","root":"كذب"},{"id":10,"arabic":"بِـَٔايَٰتِنَا","translit":"āَnِtَٰyāَٔـِb","root":"ايي"},{"id":11,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":12,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":13,"arabic":"مُؤْمِنِينَ","translit":"َnyِnِmْwʾُm","root":"امن"}],"hasIhya":false},{"ayah":73,"text":"وَإِلَىٰ ثَمُودَ أَخَاهُمْ صَٰلِحًاۗ قَالَ يَٰقَوْمِ ٱعْبُدُوا۟ ٱللَّهَ مَا لَكُم مِّنْ إِلَٰهٍ غَيْرُهُۥۖ قَدْ جَآءَتْكُم بَيِّنَةٌ مِّن رَّبِّكُمْۖ هَٰذِهِۦ نَاقَةُ ٱللَّهِ لَكُمْ ءَايَةًۖ فَذَرُوهَا تَأْكُلْ فِىٓ أَرْضِ ٱللَّهِۖ وَلَا تَمَسُّوهَا بِسُوٓءٍ فَيَأْخُذَكُمْ عَذَابٌ أَلِيمٌ ","translation":"And to the Thamūd [We sent] their brother Ṣāliḥ. He said, \"O my people, worship Allāh; you have no deity other than Him. There has come to you clear evidence from your Lord. This is the she-camel of Allāh [sent] to you as a sign. So leave her to eat within Allāh's land and do not touch her with harm, lest there seize you a painful punishment.","words":[{"id":1,"arabic":"وَإِلَىٰ","translit":"ٰàَlِiʾَw","root":""},{"id":2,"arabic":"ثَمُودَ","translit":"َdwُmَht","root":""},{"id":3,"arabic":"أَخَاهُمْ","translit":"ْmُhāَhkَaʾ","root":"اخو"},{"id":4,"arabic":"صَٰلِحًا","translit":"āًḥِlَٰṣ","root":"صلح"},{"id":5,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":6,"arabic":"يَٰقَوْمِ","translit":"ِmْwَqَٰy","root":"قوم"},{"id":7,"arabic":"ٱعْبُدُوا۟","translit":"۟āwُdُbْʿعٱ","root":"عبد"},{"id":8,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":9,"arabic":"مَا","translit":"āَm","root":""},{"id":10,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":11,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":12,"arabic":"إِلَٰهٍ","translit":"ٍhَٰlِiʾ","root":"اله"},{"id":13,"arabic":"غَيْرُهُۥ","translit":"ۥُhُrْyَغ","root":"غير"},{"id":14,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":15,"arabic":"جَآءَتْكُم","translit":"mُkْtَءٓāَjg","root":"جيا"},{"id":16,"arabic":"بَيِّنَةٌ","translit":"ٌẗَnِّyَb","root":"بين"},{"id":17,"arabic":"مِّن","translit":"nِّm","root":""},{"id":18,"arabic":"رَّبِّكُمْ","translit":"ْmُkِّbَّr","root":"ربب"},{"id":19,"arabic":"هَٰذِهِۦ","translit":"ۦِhِhdَٰh","root":""},{"id":20,"arabic":"نَاقَةُ","translit":"ُẗَqāَn","root":"نوق"},{"id":21,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":22,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":23,"arabic":"ءَايَةً","translit":"ًẗَyāَء","root":"ايي"},{"id":24,"arabic":"فَذَرُوهَا","translit":"āَhwُrَhdَf","root":"وذر"},{"id":25,"arabic":"تَأْكُلْ","translit":"ْlُkْaʾَt","root":"اكل"},{"id":26,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":27,"arabic":"أَرْضِ","translit":"ِḍْrَaʾ","root":"ارض"},{"id":28,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":29,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":30,"arabic":"تَمَسُّوهَا","translit":"āَhwُّsَmَt","root":"مسس"},{"id":31,"arabic":"بِسُوٓءٍ","translit":"ٍءٓwُsِb","root":"سوا"},{"id":32,"arabic":"فَيَأْخُذَكُمْ","translit":"ْmُkَhdُhkْaʾَyَf","root":"اخذ"},{"id":33,"arabic":"عَذَابٌ","translit":"ٌbāَhdَʿع","root":"عذب"},{"id":34,"arabic":"أَلِيمٌ","translit":"ٌmyِlَaʾ","root":"الم"}],"hasIhya":false},{"ayah":74,"text":"وَٱذْكُرُوٓا۟ إِذْ جَعَلَكُمْ خُلَفَآءَ مِنۢ بَعْدِ عَادٍ وَبَوَّأَكُمْ فِى ٱلْأَرْضِ تَتَّخِذُونَ مِن سُهُولِهَا قُصُورًا وَتَنْحِتُونَ ٱلْجِبَالَ بُيُوتًاۖ فَٱذْكُرُوٓا۟ ءَالَآءَ ٱللَّهِ وَلَا تَعْثَوْا۟ فِى ٱلْأَرْضِ مُفْسِدِينَ ","translation":"And remember when He made you successors after the ʿAad and settled you in the land, [and] you take for yourselves palaces from its plains and carve from the mountains, homes. Then remember the favors of Allāh and do not commit abuse on the earth, spreading corruption.\"","words":[{"id":1,"arabic":"وَٱذْكُرُوٓا۟","translit":"۟āٓwُrُkْhdٱَw","root":"ذكر"},{"id":2,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":3,"arabic":"جَعَلَكُمْ","translit":"ْmُkَlَʿعَjg","root":"جعل"},{"id":4,"arabic":"خُلَفَآءَ","translit":"َءٓāَfَlُhk","root":"خلف"},{"id":5,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":6,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":7,"arabic":"عَادٍ","translit":"ٍdāَʿع","root":"عود"},{"id":8,"arabic":"وَبَوَّأَكُمْ","translit":"ْmُkَaʾَّwَbَw","root":"بوا"},{"id":9,"arabic":"فِى","translit":"àِf","root":""},{"id":10,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":11,"arabic":"تَتَّخِذُونَ","translit":"َnwُhdِhkَّtَt","root":"اخذ"},{"id":12,"arabic":"مِن","translit":"nِm","root":""},{"id":13,"arabic":"سُهُولِهَا","translit":"āَhِlwُhُs","root":"سهل"},{"id":14,"arabic":"قُصُورًا","translit":"āًrwُṣُq","root":"قصر"},{"id":15,"arabic":"وَتَنْحِتُونَ","translit":"َnwُtِḥْnَtَw","root":"نحت"},{"id":16,"arabic":"ٱلْجِبَالَ","translit":"َlāَbِjgْlٱ","root":"جبل"},{"id":17,"arabic":"بُيُوتًا","translit":"āًtwُyُb","root":"بيت"},{"id":18,"arabic":"فَٱذْكُرُوٓا۟","translit":"۟āٓwُrُkْhdٱَf","root":"ذكر"},{"id":19,"arabic":"ءَالَآءَ","translit":"َءٓāَlāَء","root":"الو"},{"id":20,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":21,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":22,"arabic":"تَعْثَوْا۟","translit":"۟āْwَhtْʿعَt","root":"عثو"},{"id":23,"arabic":"فِى","translit":"àِf","root":""},{"id":24,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":25,"arabic":"مُفْسِدِينَ","translit":"َnyِdِsْfُm","root":"فسد"}],"hasIhya":false},{"ayah":75,"text":"قَالَ ٱلْمَلَأُ ٱلَّذِينَ ٱسْتَكْبَرُوا۟ مِن قَوْمِهِۦ لِلَّذِينَ ٱسْتُضْعِفُوا۟ لِمَنْ ءَامَنَ مِنْهُمْ أَتَعْلَمُونَ أَنَّ صَٰلِحًا مُّرْسَلٌ مِّن رَّبِّهِۦۚ قَالُوٓا۟ إِنَّا بِمَآ أُرْسِلَ بِهِۦ مُؤْمِنُونَ ","translation":"Said the eminent ones who were arrogant among his people to those who were oppressed - to those who believed among them, \"Do you [actually] know that Ṣāliḥ is sent from his Lord?\" They said, \"Indeed we, in that with which he was sent, are believers.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"ٱلْمَلَأُ","translit":"ُaʾَlَmْlٱ","root":"ملا"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"ٱسْتَكْبَرُوا۟","translit":"۟āwُrَbْkَtْsٱ","root":"كبر"},{"id":5,"arabic":"مِن","translit":"nِm","root":""},{"id":6,"arabic":"قَوْمِهِۦ","translit":"ۦِhِmْwَq","root":"قوم"},{"id":7,"arabic":"لِلَّذِينَ","translit":"َnyِhdَّlِl","root":""},{"id":8,"arabic":"ٱسْتُضْعِفُوا۟","translit":"۟āwُfِʿعْḍُtْsٱ","root":"ضعف"},{"id":9,"arabic":"لِمَنْ","translit":"ْnَmِl","root":""},{"id":10,"arabic":"ءَامَنَ","translit":"َnَmāَء","root":"امن"},{"id":11,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":12,"arabic":"أَتَعْلَمُونَ","translit":"َnwُmَlْʿعَtَaʾ","root":"علم"},{"id":13,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":14,"arabic":"صَٰلِحًا","translit":"āًḥِlَٰṣ","root":"صلح"},{"id":15,"arabic":"مُّرْسَلٌ","translit":"ٌlَsْrُّm","root":"رسل"},{"id":16,"arabic":"مِّن","translit":"nِّm","root":""},{"id":17,"arabic":"رَّبِّهِۦ","translit":"ۦِhِّbَّr","root":"ربب"},{"id":18,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":19,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":20,"arabic":"بِمَآ","translit":"ٓāَmِb","root":""},{"id":21,"arabic":"أُرْسِلَ","translit":"َlِsْrُaʾ","root":"رسل"},{"id":22,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":23,"arabic":"مُؤْمِنُونَ","translit":"َnwُnِmْwʾُm","root":"امن"}],"hasIhya":true},{"ayah":76,"text":"قَالَ ٱلَّذِينَ ٱسْتَكْبَرُوٓا۟ إِنَّا بِٱلَّذِىٓ ءَامَنتُم بِهِۦ كَٰفِرُونَ ","translation":"Said those who were arrogant, \"Indeed we, in that which you have believed, are disbelievers.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ٱسْتَكْبَرُوٓا۟","translit":"۟āٓwُrَbْkَtْsٱ","root":"كبر"},{"id":4,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":5,"arabic":"بِٱلَّذِىٓ","translit":"ٓàِhdَّlٱِb","root":""},{"id":6,"arabic":"ءَامَنتُم","translit":"mُtnَmāَء","root":"امن"},{"id":7,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":8,"arabic":"كَٰفِرُونَ","translit":"َnwُrِfَٰk","root":"كفر"}],"hasIhya":false},{"ayah":77,"text":"فَعَقَرُوا۟ ٱلنَّاقَةَ وَعَتَوْا۟ عَنْ أَمْرِ رَبِّهِمْ وَقَالُوا۟ يَٰصَٰلِحُ ٱئْتِنَا بِمَا تَعِدُنَآ إِن كُنتَ مِنَ ٱلْمُرْسَلِينَ ","translation":"So they hamstrung the she-camel and were insolent toward the command of their Lord and said, \"O Ṣāliḥ, bring us what you promise us, if you should be of the messengers.\"","words":[{"id":1,"arabic":"فَعَقَرُوا۟","translit":"۟āwُrَqَʿعَf","root":"عقر"},{"id":2,"arabic":"ٱلنَّاقَةَ","translit":"َẗَqāَّnlٱ","root":"نوق"},{"id":3,"arabic":"وَعَتَوْا۟","translit":"۟āْwَtَʿعَw","root":"عتو"},{"id":4,"arabic":"عَنْ","translit":"ْnَʿع","root":""},{"id":5,"arabic":"أَمْرِ","translit":"ِrْmَaʾ","root":"امر"},{"id":6,"arabic":"رَبِّهِمْ","translit":"ْmِhِّbَr","root":"ربب"},{"id":7,"arabic":"وَقَالُوا۟","translit":"۟āwُlāَqَw","root":"قول"},{"id":8,"arabic":"يَٰصَٰلِحُ","translit":"ُḥِlَٰṣَٰy","root":"صلح"},{"id":9,"arabic":"ٱئْتِنَا","translit":"āَnِtْyʾٱ","root":"اتي"},{"id":10,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":11,"arabic":"تَعِدُنَآ","translit":"ٓāَnُdِʿعَt","root":"وعد"},{"id":12,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":13,"arabic":"كُنتَ","translit":"َtnُk","root":"كون"},{"id":14,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":15,"arabic":"ٱلْمُرْسَلِينَ","translit":"َnyِlَsْrُmْlٱ","root":"رسل"}],"hasIhya":false},{"ayah":78,"text":"فَأَخَذَتْهُمُ ٱلرَّجْفَةُ فَأَصْبَحُوا۟ فِى دَارِهِمْ جَٰثِمِينَ ","translation":"So the earthquake seized them, and they became within their home [corpses] fallen prone.","words":[{"id":1,"arabic":"فَأَخَذَتْهُمُ","translit":"ُmُhْtَhdَhkَaʾَf","root":"اخذ"},{"id":2,"arabic":"ٱلرَّجْفَةُ","translit":"ُẗَfْjgَّrlٱ","root":"رجف"},{"id":3,"arabic":"فَأَصْبَحُوا۟","translit":"۟āwُḥَbْṣَaʾَf","root":"صبح"},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"دَارِهِمْ","translit":"ْmِhِrāَd","root":"دور"},{"id":6,"arabic":"جَٰثِمِينَ","translit":"َnyِmِhtَٰjg","root":"جثم"}],"hasIhya":false},{"ayah":79,"text":"فَتَوَلَّىٰ عَنْهُمْ وَقَالَ يَٰقَوْمِ لَقَدْ أَبْلَغْتُكُمْ رِسَالَةَ رَبِّى وَنَصَحْتُ لَكُمْ وَلَٰكِن لَّا تُحِبُّونَ ٱلنَّٰصِحِينَ ","translation":"And he [i.e., Ṣāliḥ] turned away from them and said, \"O my people, I had certainly conveyed to you the message of my Lord and advised you, but you do not like advisors.\"","words":[{"id":1,"arabic":"فَتَوَلَّىٰ","translit":"ٰàَّlَwَtَf","root":"ولي"},{"id":2,"arabic":"عَنْهُمْ","translit":"ْmُhْnَʿع","root":""},{"id":3,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":4,"arabic":"يَٰقَوْمِ","translit":"ِmْwَqَٰy","root":"قوم"},{"id":5,"arabic":"لَقَدْ","translit":"ْdَqَl","root":""},{"id":6,"arabic":"أَبْلَغْتُكُمْ","translit":"ْmُkُtْغَlْbَaʾ","root":"بلغ"},{"id":7,"arabic":"رِسَالَةَ","translit":"َẗَlāَsِr","root":"رسل"},{"id":8,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":9,"arabic":"وَنَصَحْتُ","translit":"ُtْḥَṣَnَw","root":"نصح"},{"id":10,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":11,"arabic":"وَلَٰكِن","translit":"nِkَٰlَw","root":""},{"id":12,"arabic":"لَّا","translit":"āَّl","root":""},{"id":13,"arabic":"تُحِبُّونَ","translit":"َnwُّbِḥُt","root":"حبب"},{"id":14,"arabic":"ٱلنَّٰصِحِينَ","translit":"َnyِḥِṣَّٰnlٱ","root":"نصح"}],"hasIhya":true},{"ayah":80,"text":"وَلُوطًا إِذْ قَالَ لِقَوْمِهِۦٓ أَتَأْتُونَ ٱلْفَٰحِشَةَ مَا سَبَقَكُم بِهَا مِنْ أَحَدٍ مِّنَ ٱلْعَٰلَمِينَ ","translation":"And [We had sent] Lot when he said to his people, \"Do you commit such immorality as no one has preceded you with from among the worlds [i.e., peoples]?","words":[{"id":1,"arabic":"وَلُوطًا","translit":"āًṭwُlَw","root":""},{"id":2,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":3,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":4,"arabic":"لِقَوْمِهِۦٓ","translit":"ٓۦِhِmْwَqِl","root":"قوم"},{"id":5,"arabic":"أَتَأْتُونَ","translit":"َnwُtْaʾَtَaʾ","root":"اتي"},{"id":6,"arabic":"ٱلْفَٰحِشَةَ","translit":"َẗَhsِḥَٰfْlٱ","root":"فحش"},{"id":7,"arabic":"مَا","translit":"āَm","root":""},{"id":8,"arabic":"سَبَقَكُم","translit":"mُkَqَbَs","root":"سبق"},{"id":9,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":10,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":11,"arabic":"أَحَدٍ","translit":"ٍdَḥَaʾ","root":"احد"},{"id":12,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":13,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":81,"text":"إِنَّكُمْ لَتَأْتُونَ ٱلرِّجَالَ شَهْوَةً مِّن دُونِ ٱلنِّسَآءِۚ بَلْ أَنتُمْ قَوْمٌ مُّسْرِفُونَ ","translation":"Indeed, you approach men with desire, instead of women. Rather, you are a transgressing people.\"","words":[{"id":1,"arabic":"إِنَّكُمْ","translit":"ْmُkَّnِiʾ","root":""},{"id":2,"arabic":"لَتَأْتُونَ","translit":"َnwُtْaʾَtَl","root":"اتي"},{"id":3,"arabic":"ٱلرِّجَالَ","translit":"َlāَjgِّrlٱ","root":"رجل"},{"id":4,"arabic":"شَهْوَةً","translit":"ًẗَwْhَhs","root":"شهو"},{"id":5,"arabic":"مِّن","translit":"nِّm","root":""},{"id":6,"arabic":"دُونِ","translit":"ِnwُd","root":"دون"},{"id":7,"arabic":"ٱلنِّسَآءِ","translit":"ِءٓāَsِّnlٱ","root":"نسو"},{"id":8,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":9,"arabic":"أَنتُمْ","translit":"ْmُtnَaʾ","root":""},{"id":10,"arabic":"قَوْمٌ","translit":"ٌmْwَq","root":"قوم"},{"id":11,"arabic":"مُّسْرِفُونَ","translit":"َnwُfِrْsُّm","root":"سرف"}],"hasIhya":false},{"ayah":82,"text":"وَمَا كَانَ جَوَابَ قَوْمِهِۦٓ إِلَّآ أَن قَالُوٓا۟ أَخْرِجُوهُم مِّن قَرْيَتِكُمْۖ إِنَّهُمْ أُنَاسٌ يَتَطَهَّرُونَ ","translation":"But the answer of his people was only that they said, \"Evict them from your city! Indeed, they are men who keep themselves pure.\"","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":3,"arabic":"جَوَابَ","translit":"َbāَwَjg","root":"جوب"},{"id":4,"arabic":"قَوْمِهِۦٓ","translit":"ٓۦِhِmْwَq","root":"قوم"},{"id":5,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":6,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":7,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":8,"arabic":"أَخْرِجُوهُم","translit":"mُhwُjgِrْhkَaʾ","root":"خرج"},{"id":9,"arabic":"مِّن","translit":"nِّm","root":""},{"id":10,"arabic":"قَرْيَتِكُمْ","translit":"ْmُkِtَyْrَq","root":"قري"},{"id":11,"arabic":"إِنَّهُمْ","translit":"ْmُhَّnِiʾ","root":""},{"id":12,"arabic":"أُنَاسٌ","translit":"ٌsāَnُaʾ","root":"انس"},{"id":13,"arabic":"يَتَطَهَّرُونَ","translit":"َnwُrَّhَṭَtَy","root":"طهر"}],"hasIhya":false},{"ayah":83,"text":"فَأَنجَيْنَٰهُ وَأَهْلَهُۥٓ إِلَّا ٱمْرَأَتَهُۥ كَانَتْ مِنَ ٱلْغَٰبِرِينَ ","translation":"So We saved him and his family, except for his wife; she was of those who remained [with the evildoers].","words":[{"id":1,"arabic":"فَأَنجَيْنَٰهُ","translit":"ُhَٰnْyَjgnَaʾَf","root":"نجو"},{"id":2,"arabic":"وَأَهْلَهُۥٓ","translit":"ٓۥُhَlْhَaʾَw","root":"اهل"},{"id":3,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":4,"arabic":"ٱمْرَأَتَهُۥ","translit":"ۥُhَtَaʾَrْmٱ","root":"مرا"},{"id":5,"arabic":"كَانَتْ","translit":"ْtَnāَk","root":"كون"},{"id":6,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":7,"arabic":"ٱلْغَٰبِرِينَ","translit":"َnyِrِbَٰغْlٱ","root":"غبر"}],"hasIhya":false},{"ayah":84,"text":"وَأَمْطَرْنَا عَلَيْهِم مَّطَرًاۖ فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُجْرِمِينَ ","translation":"And We rained upon them a rain [of stones]. Then see how was the end of the criminals.","words":[{"id":1,"arabic":"وَأَمْطَرْنَا","translit":"āَnْrَṭْmَaʾَw","root":"مطر"},{"id":2,"arabic":"عَلَيْهِم","translit":"mِhْyَlَʿع","root":""},{"id":3,"arabic":"مَّطَرًا","translit":"āًrَṭَّm","root":"مطر"},{"id":4,"arabic":"فَٱنظُرْ","translit":"ْrُẓnٱَf","root":"نظر"},{"id":5,"arabic":"كَيْفَ","translit":"َfْyَk","root":"كيف"},{"id":6,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":7,"arabic":"عَٰقِبَةُ","translit":"ُẗَbِqَٰʿع","root":"عقب"},{"id":8,"arabic":"ٱلْمُجْرِمِينَ","translit":"َnyِmِrْjgُmْlٱ","root":"جرم"}],"hasIhya":false},{"ayah":85,"text":"وَإِلَىٰ مَدْيَنَ أَخَاهُمْ شُعَيْبًاۗ قَالَ يَٰقَوْمِ ٱعْبُدُوا۟ ٱللَّهَ مَا لَكُم مِّنْ إِلَٰهٍ غَيْرُهُۥۖ قَدْ جَآءَتْكُم بَيِّنَةٌ مِّن رَّبِّكُمْۖ فَأَوْفُوا۟ ٱلْكَيْلَ وَٱلْمِيزَانَ وَلَا تَبْخَسُوا۟ ٱلنَّاسَ أَشْيَآءَهُمْ وَلَا تُفْسِدُوا۟ فِى ٱلْأَرْضِ بَعْدَ إِصْلَٰحِهَاۚ ذَٰلِكُمْ خَيْرٌ لَّكُمْ إِن كُنتُم مُّؤْمِنِينَ ","translation":"And to [the people of] Madyan [We sent] their brother Shuʿayb. He said, \"O my people, worship Allāh; you have no deity other than Him. There has come to you clear evidence from your Lord. So fulfill the measure and weight and do not deprive people of their due and cause not corruption upon the earth after its reformation. That is better for you, if you should be believers.","words":[{"id":1,"arabic":"وَإِلَىٰ","translit":"ٰàَlِiʾَw","root":""},{"id":2,"arabic":"مَدْيَنَ","translit":"َnَyْdَm","root":"مدن"},{"id":3,"arabic":"أَخَاهُمْ","translit":"ْmُhāَhkَaʾ","root":"اخو"},{"id":4,"arabic":"شُعَيْبًا","translit":"āًbْyَʿعُhs","root":""},{"id":5,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":6,"arabic":"يَٰقَوْمِ","translit":"ِmْwَqَٰy","root":"قوم"},{"id":7,"arabic":"ٱعْبُدُوا۟","translit":"۟āwُdُbْʿعٱ","root":"عبد"},{"id":8,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":9,"arabic":"مَا","translit":"āَm","root":""},{"id":10,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":11,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":12,"arabic":"إِلَٰهٍ","translit":"ٍhَٰlِiʾ","root":"اله"},{"id":13,"arabic":"غَيْرُهُۥ","translit":"ۥُhُrْyَغ","root":"غير"},{"id":14,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":15,"arabic":"جَآءَتْكُم","translit":"mُkْtَءٓāَjg","root":"جيا"},{"id":16,"arabic":"بَيِّنَةٌ","translit":"ٌẗَnِّyَb","root":"بين"},{"id":17,"arabic":"مِّن","translit":"nِّm","root":""},{"id":18,"arabic":"رَّبِّكُمْ","translit":"ْmُkِّbَّr","root":"ربب"},{"id":19,"arabic":"فَأَوْفُوا۟","translit":"۟āwُfْwَaʾَf","root":"وفي"},{"id":20,"arabic":"ٱلْكَيْلَ","translit":"َlْyَkْlٱ","root":"كيل"},{"id":21,"arabic":"وَٱلْمِيزَانَ","translit":"َnāَzyِmْlٱَw","root":"وزن"},{"id":22,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":23,"arabic":"تَبْخَسُوا۟","translit":"۟āwُsَhkْbَt","root":"بخس"},{"id":24,"arabic":"ٱلنَّاسَ","translit":"َsāَّnlٱ","root":"انس"},{"id":25,"arabic":"أَشْيَآءَهُمْ","translit":"ْmُhَءٓāَyْhsَaʾ","root":"شيا"},{"id":26,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":27,"arabic":"تُفْسِدُوا۟","translit":"۟āwُdِsْfُt","root":"فسد"},{"id":28,"arabic":"فِى","translit":"àِf","root":""},{"id":29,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":30,"arabic":"بَعْدَ","translit":"َdْʿعَb","root":"بعد"},{"id":31,"arabic":"إِصْلَٰحِهَا","translit":"āَhِḥَٰlْṣِiʾ","root":"صلح"},{"id":32,"arabic":"ذَٰلِكُمْ","translit":"ْmُkِlَٰhd","root":""},{"id":33,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":34,"arabic":"لَّكُمْ","translit":"ْmُkَّl","root":""},{"id":35,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":36,"arabic":"كُنتُم","translit":"mُtnُk","root":"كون"},{"id":37,"arabic":"مُّؤْمِنِينَ","translit":"َnyِnِmْwʾُّm","root":"امن"}],"hasIhya":false},{"ayah":86,"text":"وَلَا تَقْعُدُوا۟ بِكُلِّ صِرَٰطٍ تُوعِدُونَ وَتَصُدُّونَ عَن سَبِيلِ ٱللَّهِ مَنْ ءَامَنَ بِهِۦ وَتَبْغُونَهَا عِوَجًاۚ وَٱذْكُرُوٓا۟ إِذْ كُنتُمْ قَلِيلًا فَكَثَّرَكُمْۖ وَٱنظُرُوا۟ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُفْسِدِينَ ","translation":"And do not sit on every path, threatening and averting from the way of Allāh those who believe in Him, seeking to make it [seem] deviant. And remember when you were few and He increased you. And see how was the end of the corrupters.","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"تَقْعُدُوا۟","translit":"۟āwُdُʿعْqَt","root":"قعد"},{"id":3,"arabic":"بِكُلِّ","translit":"ِّlُkِb","root":"كلل"},{"id":4,"arabic":"صِرَٰطٍ","translit":"ٍṭَٰrِṣ","root":"صرط"},{"id":5,"arabic":"تُوعِدُونَ","translit":"َnwُdِʿعwُt","root":"وعد"},{"id":6,"arabic":"وَتَصُدُّونَ","translit":"َnwُّdُṣَtَw","root":"صدد"},{"id":7,"arabic":"عَن","translit":"nَʿع","root":""},{"id":8,"arabic":"سَبِيلِ","translit":"ِlyِbَs","root":"سبل"},{"id":9,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":10,"arabic":"مَنْ","translit":"ْnَm","root":""},{"id":11,"arabic":"ءَامَنَ","translit":"َnَmāَء","root":"امن"},{"id":12,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":13,"arabic":"وَتَبْغُونَهَا","translit":"āَhَnwُغْbَtَw","root":"بغي"},{"id":14,"arabic":"عِوَجًا","translit":"āًjgَwِʿع","root":"عوج"},{"id":15,"arabic":"وَٱذْكُرُوٓا۟","translit":"۟āٓwُrُkْhdٱَw","root":"ذكر"},{"id":16,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":17,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":18,"arabic":"قَلِيلًا","translit":"āًlyِlَq","root":"قلل"},{"id":19,"arabic":"فَكَثَّرَكُمْ","translit":"ْmُkَrَّhtَ