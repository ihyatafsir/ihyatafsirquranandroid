ic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "وَجَدْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لِأَكْثَرِهِم", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَهْدࣲۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَإِنْ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَّجَدْنَآ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَكْثَرَهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَفَٰسِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 103, "text": "ثُمَّ بَعَثْنَا مِنۢ بَعْدِهِم مُّوس۪يٰ بِـَٔايَٰتِنَآ إِلَيٰ فِرْعَوْنَ وَمَلَإِيْهِۦ فَظَلَمُواْ بِهَاۖ فَانظُرْ كَيْفَ كَانَ عَٰقِبَةُ اُ۬لْمُفْسِدِينَۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَعَثْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 4, "arabic": "بَعْدِهِم", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّوس۪يٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِـَٔايَٰتِنَآ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِرْعَوْنَ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَمَلَإِيْهِۦ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَظَلَمُواْ", "translit": "", "root": ""}, {"id": 11, "arabic": "بِهَاۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "فَانظُرْ", "translit": "", "root": ""}, {"id": 13, "arabic": "كَيْفَ", "translit": "", "root": ""}, {"id": 14, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 15, "arabic": "عَٰقِبَةُ", "translit": "", "root": ""}, {"id": 16, "arabic": "اُ۬لْمُفْسِدِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 104, "text": "وَقَالَ مُوس۪يٰ يَٰفِرْعَوْنُ إِنِّے رَسُولࣱ مِّن رَّبِّ اِ۬لْعَٰلَمِينَ", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "