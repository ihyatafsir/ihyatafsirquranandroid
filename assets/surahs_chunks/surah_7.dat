{"surah": 7, "verses": [{"ayah": 1, "text": "الٓمٓصٓ ", "translation": "Alif, Lām, Meem, Ṣād.[1]", "words": [{"id": 1, "arabic": "الٓمٓصٓ", "translit": "ٓṣٓmٓlā", "root": ""}], "hasIhya": false}, {"ayah": 2, "text": "كِتَٰبٌ أُنزِلَ إِلَيْكَ فَلَا يَكُن فِى صَدْرِكَ حَرَجٌ مِّنْهُ لِتُنذِرَ بِهِۦ وَذِكْرَىٰ لِلْمُؤْمِنِينَ ", "translation": "[This is] a Book revealed to you, [O Muḥammad] - so let there not be in your breast distress therefrom - that you may warn thereby and as a reminder to the believers.", "words": [{"id": 1, "arabic": "كِتَٰبٌ", "translit": "ٌbَٰtِk", "root": "كتب"}, {"id": 2, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 3, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 4, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 5, "arabic": "يَكُن", "translit": "nُkَy", "root": "كون"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "صَدْرِكَ", "translit": "َkِrْdَṣ", "root": "صدر"}, {"id": 8, "arabic": "حَرَجٌ", "translit": "ٌjgَrَḥ", "root": "حرج"}, {"id": 9, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 10, "arabic": "لِتُنذِرَ", "translit": "َrِhdnُtِl", "root": "نذر"}, {"id": 11, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 12, "arabic": "وَذِكْرَىٰ", "translit": "ٰàَrْkِhdَw", "root": "ذكر"}, {"id": 13, "arabic": "لِلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlِl", "root": "امن"}], "hasIhya": false}, {"ayah": 3, "text": "ٱتَّبِعُوا۟ مَآ أُنزِلَ إِلَيْكُم مِّن رَّبِّكُمْ وَلَا تَتَّبِعُوا۟ مِن دُونِهِۦٓ أَوْلِيَآءَۗ قَلِيلًا مَّا تَذَكَّرُونَ ", "translation": "Follow, [O mankind], what has been revealed to you from your Lord and do not follow other than Him any allies. Little do you remember.", "words": [{"id": 1, "arabic": "ٱتَّبِعُوا۟", "translit": "۟āwُʿعِbَّtٱ", "root": "تبع"}, {"id": 2, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 3, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 4, "arabic": "إِلَيْكُم", "translit": "mُkْyَlِiʾ", "root": ""}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 7, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 8, "arabic": "تَتَّبِعُوا۟", "translit": "۟āwُʿعِbَّtَt", "root": "تبع"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "دُونِهِۦٓ", "translit": "ٓۦِhِnwُd", "root": "دون"}, {"id": 11, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 12, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 13, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 14, "arabic": "تَذَكَّرُونَ", "translit": "َnwُrَّkَhdَt", "root": "ذكر"}], "hasIhya": false}, {"ayah": 4, "text": "وَكَم مِّن قَرْيَةٍ أَهْلَكْنَٰهَا فَجَآءَهَا بَأْسُنَا بَيَٰتًا أَوْ هُمْ قَآئِلُونَ ", "translation": "And how many cities have We destroyed, and Our punishment came to them at night or while they were sleeping at noon.", "words": [{"id": 1, "arabic": "وَكَم", "translit": "mَkَw", "root": ""}, {"id": 2, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 3, "arabic": "قَرْيَةٍ", "translit": "ٍẗَyْrَq", "root": "قري"}, {"id": 4, "arabic": "أَهْلَكْنَٰهَا", "translit": "āَhَٰnْkَlْhَaʾ", "root": "هلك"}, {"id": 5, "arabic": "فَجَآءَهَا", "translit": "āَhَءٓāَjgَf", "root": "جيا"}, {"id": 6, "arabic": "بَأْسُنَا", "translit": "āَnُsْaʾَb", "root": "باس"}, {"id": 7, "arabic": "بَيَٰتًا", "translit": "āًtَٰyَb", "root": "بيت"}, {"id": 8, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 9, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 10, "arabic": "قَآئِلُونَ", "translit": "َnwُlِyʾٓāَq", "root": "قيل"}], "hasIhya": false}, {"ayah": 5, "text": "فَمَا كَانَ دَعْوَىٰهُمْ إِذْ جَآءَهُم بَأْسُنَآ إِلَّآ أَن قَالُوٓا۟ إِنَّا كُنَّا ظَٰلِمِينَ ", "translation": "And their declaration when Our punishment came to them was only that they said, \"Indeed, we were wrongdoers!\"", "words": [{"id": 1, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "دَعْوَىٰهُمْ", "translit": "ْmُhٰàَwْʿعَd", "root": "دعو"}, {"id": 4, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 5, "arabic": "جَآءَهُم", "translit": "mُhَءٓāَjg", "root": "جيا"}, {"id": 6, "arabic": "بَأْسُنَآ", "translit": "ٓāَnُsْaʾَb", "root": "باس"}, {"id": 7, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 10, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 11, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 12, "arabic": "ظَٰلِمِينَ", "translit": "َnyِmِlَٰẓ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 6, "text": "فَلَنَسْـَٔلَنَّ ٱلَّذِينَ أُرْسِلَ إِلَيْهِمْ وَلَنَسْـَٔلَنَّ ٱلْمُرْسَلِينَ ", "translation": "Then We will surely question those to whom [a message] was sent, and We will surely question the messengers.", "words": [{"id": 1, "arabic": "فَلَنَسْـَٔلَنَّ", "translit": "َّnَlَٔـْsَnَlَf", "root": "سال"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "أُرْسِلَ", "translit": "َlِsْrُaʾ", "root": "رسل"}, {"id": 4, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 5, "arabic": "وَلَنَسْـَٔلَنَّ", "translit": "َّnَlَٔـْsَnَlَw", "root": "سال"}, {"id": 6, "arabic": "ٱلْمُرْسَلِينَ", "translit": "َnyِlَsْrُmْlٱ", "root": "رسل"}], "hasIhya": true}, {"ayah": 7, "text": "فَلَنَقُصَّنَّ عَلَيْهِم بِعِلْمٍۖ وَمَا كُنَّا غَآئِبِينَ ", "translation": "Then We will surely relate [their deeds] to them with knowledge, and We were not [at all] absent.", "words": [{"id": 1, "arabic": "فَلَنَقُصَّنَّ", "translit": "َّnَّṣُqَnَlَf", "root": "قصص"}, {"id": 2, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "بِعِلْمٍ", "translit": "ٍmْlِʿعِb", "root": "علم"}, {"id": 4, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 5, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 6, "arabic": "غَآئِبِينَ", "translit": "َnyِbِyʾٓāَغ", "root": "غيب"}], "hasIhya": false}, {"ayah": 8, "text": "وَٱلْوَزْنُ يَوْمَئِذٍ ٱلْحَقُّۚ فَمَن ثَقُلَتْ مَوَٰزِينُهُۥ فَأُو۟لَٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ ", "translation": "And the weighing [of deeds] that Day will be the truth. So those whose scales are heavy - it is they who will be the successful.", "words": [{"id": 1, "arabic": "وَٱلْوَزْنُ", "translit": "ُnْzَwْlٱَw", "root": "وزن"}, {"id": 2, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 3, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 4, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 5, "arabic": "ثَقُلَتْ", "translit": "ْtَlُqَht", "root": "ثقل"}, {"id": 6, "arabic": "مَوَٰزِينُهُۥ", "translit": "ۥُhُnyِzَٰwَm", "root": "وزن"}, {"id": 7, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 8, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 9, "arabic": "ٱلْمُفْلِحُونَ", "translit": "َnwُḥِlْfُmْlٱ", "root": "فلح"}], "hasIhya": true}, {"ayah": 9, "text": "وَمَنْ خَفَّتْ مَوَٰزِينُهُۥ فَأُو۟لَٰٓئِكَ ٱلَّذِينَ خَسِرُوٓا۟ أَنفُسَهُم بِمَا كَانُوا۟ بِـَٔايَٰتِنَا يَظْلِمُونَ ", "translation": "And those whose scales are light - they are the ones who will lose themselves for what injustice they were doing toward Our verses.", "words": [{"id": 1, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 2, "arabic": "خَفَّتْ", "translit": "ْtَّfَhk", "root": "خفف"}, {"id": 3, "arabic": "مَوَٰزِينُهُۥ", "translit": "ۥُhُnyِzَٰwَm", "root": "وزن"}, {"id": 4, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "خَسِرُوٓا۟", "translit": "۟āٓwُrِsَhk", "root": "خسر"}, {"id": 7, "arabic": "أَنفُسَهُم", "translit": "mُhَsُfnَaʾ", "root": "نفس"}, {"id": 8, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 9, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 10, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 11, "arabic": "يَظْلِمُونَ", "translit": "َnwُmِlْẓَy", "root": "ظلم"}], "hasIhya": false}, {"ayah": 10, "text": "وَلَقَدْ مَكَّنَّٰكُمْ فِى ٱلْأَرْضِ وَجَعَلْنَا لَكُمْ فِيهَا مَعَٰيِشَۗ قَلِيلًا مَّا تَشْكُرُونَ ", "translation": "And We have certainly established you upon the earth and made for you therein ways of livelihood. Little are you grateful.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "مَكَّنَّٰكُمْ", "translit": "ْmُkَّٰnَّkَm", "root": "مكن"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 5, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 6, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 7, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 8, "arabic": "مَعَٰيِشَ", "translit": "َhsِyَٰʿعَm", "root": "عيش"}, {"id": 9, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 10, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 11, "arabic": "تَشْكُرُونَ", "translit": "َnwُrُkْhsَt", "root": "شكر"}], "hasIhya": true}, {"ayah": 11, "text": "وَلَقَدْ خَلَقْنَٰكُمْ ثُمَّ صَوَّرْنَٰكُمْ ثُمَّ قُلْنَا لِلْمَلَٰٓئِكَةِ ٱسْجُدُوا۟ لِءَادَمَ فَسَجَدُوٓا۟ إِلَّآ إِبْلِيسَ لَمْ يَكُن مِّنَ ٱلسَّٰجِدِينَ ", "translation": "And We have certainly created you, [O mankind], and given you [human] form. Then We said to the angels, \"Prostrate to Adam\"; so they prostrated, except for Iblees.[1] He was not of those who prostrated.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "خَلَقْنَٰكُمْ", "translit": "ْmُkَٰnْqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 4, "arabic": "صَوَّرْنَٰكُمْ", "translit": "ْmُkَٰnْrَّwَṣ", "root": "صور"}, {"id": 5, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 6, "arabic": "قُلْنَا", "translit": "āَnْlُq", "root": "قول"}, {"id": 7, "arabic": "لِلْمَلَٰٓئِكَةِ", "translit": "ِẗَkِyʾَٰٓlَmْlِl", "root": "ملك"}, {"id": 8, "arabic": "ٱسْجُدُوا۟", "translit": "۟āwُdُjgْsٱ", "root": "سجد"}, {"id": 9, "arabic": "لِءَادَمَ", "translit": "َmَdāَءِl", "root": "ادم"}, {"id": 10, "arabic": "فَسَجَدُوٓا۟", "translit": "۟āٓwُdَjgَsَf", "root": "سجد"}, {"id": 11, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 12, "arabic": "إِبْلِيسَ", "translit": "َsyِlْbِiʾ", "root": ""}, {"id": 13, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 14, "arabic": "يَكُن", "translit": "nُkَy", "root": "كون"}, {"id": 15, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 16, "arabic": "ٱلسَّٰجِدِينَ", "translit": "َnyِdِjgَّٰslٱ", "root": "سجد"}], "hasIhya": false}, {"ayah": 12, "text": "قَالَ مَا مَنَعَكَ أَلَّا تَسْجُدَ إِذْ أَمَرْتُكَۖ قَالَ أَنَا۠ خَيْرٌ مِّنْهُ خَلَقْتَنِى مِن نَّارٍ وَخَلَقْتَهُۥ مِن طِينٍ ", "translation": "[Allāh] said, \"What prevented you from prostrating when I commanded you?\" [Satan] said, \"I am better than him. You created me from fire and created him from clay [i.e., earth].\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "مَنَعَكَ", "translit": "َkَʿعَnَm", "root": "منع"}, {"id": 4, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 5, "arabic": "تَسْجُدَ", "translit": "َdُjgْsَt", "root": "سجد"}, {"id": 6, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 7, "arabic": "أَمَرْتُكَ", "translit": "َkُtْrَmَaʾ", "root": "امر"}, {"id": 8, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 9, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 10, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 11, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 12, "arabic": "خَلَقْتَنِى", "translit": "àِnَtْqَlَhk", "root": "خلق"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "نَّارٍ", "translit": "ٍrāَّn", "root": "نور"}, {"id": 15, "arabic": "وَخَلَقْتَهُۥ", "translit": "ۥُhَtْqَlَhkَw", "root": "خلق"}, {"id": 16, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 17, "arabic": "طِينٍ", "translit": "ٍnyِṭ", "root": "طين"}], "hasIhya": true}, {"ayah": 13, "text": "قَالَ فَٱهْبِطْ مِنْهَا فَمَا يَكُونُ لَكَ أَن تَتَكَبَّرَ فِيهَا فَٱخْرُجْ إِنَّكَ مِنَ ٱلصَّٰغِرِينَ ", "translation": "[Allāh] said, \"Descend from it [i.e., Paradise], for it is not for you to be arrogant therein. So get out; indeed, you are of the debased.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "فَٱهْبِطْ", "translit": "ْṭِbْhٱَf", "root": "هبط"}, {"id": 3, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 4, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 5, "arabic": "يَكُونُ", "translit": "ُnwُkَy", "root": "كون"}, {"id": 6, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 7, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 8, "arabic": "تَتَكَبَّرَ", "translit": "َrَّbَkَtَt", "root": "كبر"}, {"id": 9, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 10, "arabic": "فَٱخْرُجْ", "translit": "ْjgُrْhkٱَf", "root": "خرج"}, {"id": 11, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 12, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 13, "arabic": "ٱلصَّٰغِرِينَ", "translit": "َnyِrِغَّٰṣlٱ", "root": "صغر"}], "hasIhya": false}, {"ayah": 14, "text": "قَالَ أَنظِرْنِىٓ إِلَىٰ يَوْمِ يُبْعَثُونَ ", "translation": "[Satan] said, \"Reprieve me until the Day they are resurrected.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "أَنظِرْنِىٓ", "translit": "ٓàِnْrِẓnَaʾ", "root": "نظر"}, {"id": 3, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 4, "arabic": "يَوْمِ", "translit": "ِmْwَy", "root": "يوم"}, {"id": 5, "arabic": "يُبْعَثُونَ", "translit": "َnwُhtَʿعْbُy", "root": "بعث"}], "hasIhya": false}, {"ayah": 15, "text": "قَالَ إِنَّكَ مِنَ ٱلْمُنظَرِينَ ", "translation": "[Allāh] said, \"Indeed, you are of those reprieved.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلْمُنظَرِينَ", "translit": "َnyِrَẓnُmْlٱ", "root": "نظر"}], "hasIhya": true}, {"ayah": 16, "text": "قَالَ فَبِمَآ أَغْوَيْتَنِى لَأَقْعُدَنَّ لَهُمْ صِرَٰطَكَ ٱلْمُسْتَقِيمَ ", "translation": "[Satan] said, \"Because You have put me in error, I will surely sit in wait for them [i.e., mankind] on Your straight path.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "فَبِمَآ", "translit": "ٓāَmِbَf", "root": ""}, {"id": 3, "arabic": "أَغْوَيْتَنِى", "translit": "àِnَtْyَwْغَaʾ", "root": "غوي"}, {"id": 4, "arabic": "لَأَقْعُدَنَّ", "translit": "َّnَdُʿعْqَaʾَl", "root": "قعد"}, {"id": 5, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 6, "arabic": "صِرَٰطَكَ", "translit": "َkَṭَٰrِṣ", "root": "صرط"}, {"id": 7, "arabic": "ٱلْمُسْتَقِيمَ", "translit": "َmyِqَtْsُmْlٱ", "root": "قوم"}], "hasIhya": true}, {"ayah": 17, "text": "ثُمَّ لَءَاتِيَنَّهُم مِّنۢ بَيْنِ أَيْدِيهِمْ وَمِنْ خَلْفِهِمْ وَعَنْ أَيْمَٰنِهِمْ وَعَن شَمَآئِلِهِمْۖ وَلَا تَجِدُ أَكْثَرَهُمْ شَٰكِرِينَ ", "translation": "Then I will come to them from before them and from behind them and on their right and on their left, and You will not find most of them grateful [to You].\"", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "لَءَاتِيَنَّهُم", "translit": "mُhَّnَyِtāَءَl", "root": "اتي"}, {"id": 3, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 4, "arabic": "بَيْنِ", "translit": "ِnْyَb", "root": "بين"}, {"id": 5, "arabic": "أَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾ", "root": "يدي"}, {"id": 6, "arabic": "وَمِنْ", "translit": "ْnِmَw", "root": ""}, {"id": 7, "arabic": "خَلْفِهِمْ", "translit": "ْmِhِfْlَhk", "root": "خلف"}, {"id": 8, "arabic": "وَعَنْ", "translit": "ْnَʿعَw", "root": ""}, {"id": 9, "arabic": "أَيْمَٰنِهِمْ", "translit": "ْmِhِnَٰmْyَaʾ", "root": "يمن"}, {"id": 10, "arabic": "وَعَن", "translit": "nَʿعَw", "root": ""}, {"id": 11, "arabic": "شَمَآئِلِهِمْ", "translit": "ْmِhِlِyʾٓāَmَhs", "root": "شمل"}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "تَجِدُ", "translit": "ُdِjgَt", "root": "وجد"}, {"id": 14, "arabic": "أَكْثَرَهُمْ", "translit": "ْmُhَrَhtْkَaʾ", "root": "كثر"}, {"id": 15, "arabic": "شَٰكِرِينَ", "translit": "َnyِrِkَٰhs", "root": "شكر"}], "hasIhya": true}, {"ayah": 18, "text": "قَالَ ٱخْرُجْ مِنْهَا مَذْءُومًا مَّدْحُورًاۖ لَّمَن تَبِعَكَ مِنْهُمْ لَأَمْلَأَنَّ جَهَنَّمَ مِنكُمْ أَجْمَعِينَ ", "translation": "[Allāh] said, \"Depart from it [i.e., Paradise], reproached and expelled. Whoever follows you among them - I will surely fill Hell with you, all together.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱخْرُجْ", "translit": "ْjgُrْhkٱ", "root": "خرج"}, {"id": 3, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 4, "arabic": "مَذْءُومًا", "translit": "āًmwُءْhdَm", "root": "ذام"}, {"id": 5, "arabic": "مَّدْحُورًا", "translit": "āًrwُḥْdَّm", "root": "دحر"}, {"id": 6, "arabic": "لَّمَن", "translit": "nَmَّl", "root": ""}, {"id": 7, "arabic": "تَبِعَكَ", "translit": "َkَʿعِbَt", "root": "تبع"}, {"id": 8, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 9, "arabic": "لَأَمْلَأَنَّ", "translit": "َّnَaʾَlْmَaʾَl", "root": "ملا"}, {"id": 10, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 11, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 12, "arabic": "أَجْمَعِينَ", "translit": "َnyِʿعَmْjgَaʾ", "root": "جمع"}], "hasIhya": false}, {"ayah": 19, "text": "وَيَٰٓـَٔادَمُ ٱسْكُنْ أَنتَ وَزَوْجُكَ ٱلْجَنَّةَ فَكُلَا مِنْ حَيْثُ شِئْتُمَا وَلَا تَقْرَبَا هَٰذِهِ ٱلشَّجَرَةَ فَتَكُونَا مِنَ ٱلظَّٰلِمِينَ ", "translation": "And \"O Adam, dwell, you and your wife, in Paradise and eat from wherever you will but do not approach this tree, lest you be among the wrongdoers.\"", "words": [{"id": 1, "arabic": "وَيَٰٓـَٔادَمُ", "translit": "ُmَdāَٔـَٰٓyَw", "root": "ادم"}, {"id": 2, "arabic": "ٱسْكُنْ", "translit": "ْnُkْsٱ", "root": "سكن"}, {"id": 3, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 4, "arabic": "وَزَوْجُكَ", "translit": "َkُjgْwَzَw", "root": "زوج"}, {"id": 5, "arabic": "ٱلْجَنَّةَ", "translit": "َẗَّnَjgْlٱ", "root": "جنن"}, {"id": 6, "arabic": "فَكُلَا", "translit": "āَlُkَf", "root": "اكل"}, {"id": 7, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 8, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 9, "arabic": "شِئْتُمَا", "translit": "āَmُtْyʾِhs", "root": "شيا"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "تَقْرَبَا", "translit": "āَbَrْqَt", "root": "قرب"}, {"id": 12, "arabic": "هَٰذِهِ", "translit": "ِhِhdَٰh", "root": ""}, {"id": 13, "arabic": "ٱلشَّجَرَةَ", "translit": "َẗَrَjgَّhslٱ", "root": "شجر"}, {"id": 14, "arabic": "فَتَكُونَا", "translit": "āَnwُkَtَf", "root": "كون"}, {"id": 15, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 16, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 20, "text": "فَوَسْوَسَ لَهُمَا ٱلشَّيْطَٰنُ لِيُبْدِىَ لَهُمَا مَا وُۥرِىَ عَنْهُمَا مِن سَوْءَٰتِهِمَا وَقَالَ مَا نَهَىٰكُمَا رَبُّكُمَا عَنْ هَٰذِهِ ٱلشَّجَرَةِ إِلَّآ أَن تَكُونَا مَلَكَيْنِ أَوْ تَكُونَا مِنَ ٱلْخَٰلِدِينَ ", "translation": "But Satan whispered to them to make apparent to them that which was concealed from them of their private parts. He said, \"Your Lord did not forbid you this tree except that you become angels or become of the immortal.\"", "words": [{"id": 1, "arabic": "فَوَسْوَسَ", "translit": "َsَwْsَwَf", "root": "وسوس"}, {"id": 2, "arabic": "لَهُمَا", "translit": "āَmُhَl", "root": ""}, {"id": 3, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 4, "arabic": "لِيُبْدِىَ", "translit": "َàِdْbُyِl", "root": "بدو"}, {"id": 5, "arabic": "لَهُمَا", "translit": "āَmُhَl", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "وُۥرِىَ", "translit": "َàِrۥُw", "root": "وري"}, {"id": 8, "arabic": "عَنْهُمَا", "translit": "āَmُhْnَʿع", "root": ""}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "سَوْءَٰتِهِمَا", "translit": "āَmِhِtَٰءْwَs", "root": "سوا"}, {"id": 11, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 12, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 13, "arabic": "نَهَىٰكُمَا", "translit": "āَmُkٰàَhَn", "root": "نهي"}, {"id": 14, "arabic": "رَبُّكُمَا", "translit": "āَmُkُّbَr", "root": "ربب"}, {"id": 15, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 16, "arabic": "هَٰذِهِ", "translit": "ِhِhdَٰh", "root": ""}, {"id": 17, "arabic": "ٱلشَّجَرَةِ", "translit": "ِẗَrَjgَّhslٱ", "root": "شجر"}, {"id": 18, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 19, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 20, "arabic": "تَكُونَا", "translit": "āَnwُkَt", "root": "كون"}, {"id": 21, "arabic": "مَلَكَيْنِ", "translit": "ِnْyَkَlَm", "root": "ملك"}, {"id": 22, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 23, "arabic": "تَكُونَا", "translit": "āَnwُkَt", "root": "كون"}, {"id": 24, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 25, "arabic": "ٱلْخَٰلِدِينَ", "translit": "َnyِdِlَٰhkْlٱ", "root": "خلد"}], "hasIhya": false}, {"ayah": 21, "text": "وَقَاسَمَهُمَآ إِنِّى لَكُمَا لَمِنَ ٱلنَّٰصِحِينَ ", "translation": "And he swore [by Allāh] to them, \"Indeed, I am to you from among the sincere advisors.\"", "words": [{"id": 1, "arabic": "وَقَاسَمَهُمَآ", "translit": "ٓāَmُhَmَsāَqَw", "root": "قسم"}, {"id": 2, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 3, "arabic": "لَكُمَا", "translit": "āَmُkَl", "root": ""}, {"id": 4, "arabic": "لَمِنَ", "translit": "َnِmَl", "root": ""}, {"id": 5, "arabic": "ٱلنَّٰصِحِينَ", "translit": "َnyِḥِṣَّٰnlٱ", "root": "نصح"}], "hasIhya": false}, {"ayah": 22, "text": "فَدَلَّىٰهُمَا بِغُرُورٍۚ فَلَمَّا ذَاقَا ٱلشَّجَرَةَ بَدَتْ لَهُمَا سَوْءَٰتُهُمَا وَطَفِقَا يَخْصِفَانِ عَلَيْهِمَا مِن وَرَقِ ٱلْجَنَّةِۖ وَنَادَىٰهُمَا رَبُّهُمَآ أَلَمْ أَنْهَكُمَا عَن تِلْكُمَا ٱلشَّجَرَةِ وَأَقُل لَّكُمَآ إِنَّ ٱلشَّيْطَٰنَ لَكُمَا عَدُوٌّ مُّبِينٌ ", "translation": "So he made them fall, through deception. And when they tasted of the tree, their private parts became apparent to them, and they began to fasten together over themselves from the leaves of Paradise. And their Lord called to them, \"Did I not forbid you from that tree and tell you that Satan is to you a clear enemy?\"", "words": [{"id": 1, "arabic": "فَدَلَّىٰهُمَا", "translit": "āَmُhٰàَّlَdَf", "root": "دلل"}, {"id": 2, "arabic": "بِغُرُورٍ", "translit": "ٍrwُrُغِb", "root": "غرر"}, {"id": 3, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 4, "arabic": "ذَاقَا", "translit": "āَqāَhd", "root": "ذوق"}, {"id": 5, "arabic": "ٱلشَّجَرَةَ", "translit": "َẗَrَjgَّhslٱ", "root": "شجر"}, {"id": 6, "arabic": "بَدَتْ", "translit": "ْtَdَb", "root": "بدو"}, {"id": 7, "arabic": "لَهُمَا", "translit": "āَmُhَl", "root": ""}, {"id": 8, "arabic": "سَوْءَٰتُهُمَا", "translit": "āَmُhُtَٰءْwَs", "root": "سوا"}, {"id": 9, "arabic": "وَطَفِقَا", "translit": "āَqِfَṭَw", "root": "طفق"}, {"id": 10, "arabic": "يَخْصِفَانِ", "translit": "ِnāَfِṣْhkَy", "root": "خصف"}, {"id": 11, "arabic": "عَلَيْهِمَا", "translit": "āَmِhْyَlَʿع", "root": ""}, {"id": 12, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 13, "arabic": "وَرَقِ", "translit": "ِqَrَw", "root": "ورق"}, {"id": 14, "arabic": "ٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱ", "root": "جنن"}, {"id": 15, "arabic": "وَنَادَىٰهُمَا", "translit": "āَmُhٰàَdāَnَw", "root": "ندي"}, {"id": 16, "arabic": "رَبُّهُمَآ", "translit": "ٓāَmُhُّbَr", "root": "ربب"}, {"id": 17, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 18, "arabic": "أَنْهَكُمَا", "translit": "āَmُkَhْnَaʾ", "root": "نهي"}, {"id": 19, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 20, "arabic": "تِلْكُمَا", "translit": "āَmُkْlِt", "root": ""}, {"id": 21, "arabic": "ٱلشَّجَرَةِ", "translit": "ِẗَrَjgَّhslٱ", "root": "شجر"}, {"id": 22, "arabic": "وَأَقُل", "translit": "lُqَaʾَw", "root": "قول"}, {"id": 23, "arabic": "لَّكُمَآ", "translit": "ٓāَmُkَّl", "root": ""}, {"id": 24, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 25, "arabic": "ٱلشَّيْطَٰنَ", "translit": "َnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 26, "arabic": "لَكُمَا", "translit": "āَmُkَl", "root": ""}, {"id": 27, "arabic": "عَدُوٌّ", "translit": "ٌّwُdَʿع", "root": "عدو"}, {"id": 28, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 23, "text": "قَالَا رَبَّنَا ظَلَمْنَآ أَنفُسَنَا وَإِن لَّمْ تَغْفِرْ لَنَا وَتَرْحَمْنَا لَنَكُونَنَّ مِنَ ٱلْخَٰسِرِينَ ", "translation": "They said, \"Our Lord, we have wronged ourselves, and if You do not forgive us and have mercy upon us, we will surely be among the losers.\"", "words": [{"id": 1, "arabic": "قَالَا", "translit": "āَlāَq", "root": "قول"}, {"id": 2, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 3, "arabic": "ظَلَمْنَآ", "translit": "ٓāَnْmَlَẓ", "root": "ظلم"}, {"id": 4, "arabic": "أَنفُسَنَا", "translit": "āَnَsُfnَaʾ", "root": "نفس"}, {"id": 5, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 6, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 7, "arabic": "تَغْفِرْ", "translit": "ْrِfْغَt", "root": "غفر"}, {"id": 8, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 9, "arabic": "وَتَرْحَمْنَا", "translit": "āَnْmَḥْrَtَw", "root": "رحم"}, {"id": 10, "arabic": "لَنَكُونَنَّ", "translit": "َّnَnwُkَnَl", "root": "كون"}, {"id": 11, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 12, "arabic": "ٱلْخَٰسِرِينَ", "translit": "َnyِrِsَٰhkْlٱ", "root": "خسر"}], "hasIhya": false}, {"ayah": 24, "text": "قَالَ ٱهْبِطُوا۟ بَعْضُكُمْ لِبَعْضٍ عَدُوٌّۖ وَلَكُمْ فِى ٱلْأَرْضِ مُسْتَقَرٌّ وَمَتَٰعٌ إِلَىٰ حِينٍ ", "translation": "[Allāh] said, \"Descend, being to one another enemies. And for you on the earth is a place of settlement and enjoyment [i.e., provision] for a time.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱهْبِطُوا۟", "translit": "۟āwُṭِbْhٱ", "root": "هبط"}, {"id": 3, "arabic": "بَعْضُكُمْ", "translit": "ْmُkُḍْʿعَb", "root": "بعض"}, {"id": 4, "arabic": "لِبَعْضٍ", "translit": "ٍḍْʿعَbِl", "root": "بعض"}, {"id": 5, "arabic": "عَدُوٌّ", "translit": "ٌّwُdَʿع", "root": "عدو"}, {"id": 6, "arabic": "وَلَكُمْ", "translit": "ْmُkَlَw", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "مُسْتَقَرٌّ", "translit": "ٌّrَqَtْsُm", "root": "قرر"}, {"id": 10, "arabic": "وَمَتَٰعٌ", "translit": "ٌʿعَٰtَmَw", "root": "متع"}, {"id": 11, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 12, "arabic": "حِينٍ", "translit": "ٍnyِḥ", "root": "حين"}], "hasIhya": false}, {"ayah": 25, "text": "قَالَ فِيهَا تَحْيَوْنَ وَفِيهَا تَمُوتُونَ وَمِنْهَا تُخْرَجُونَ ", "translation": "He said, \"Therein you will live, and therein you will die, and from it you will be brought forth.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "تَحْيَوْنَ", "translit": "َnْwَyْḥَt", "root": "حيي"}, {"id": 4, "arabic": "وَفِيهَا", "translit": "āَhyِfَw", "root": ""}, {"id": 5, "arabic": "تَمُوتُونَ", "translit": "َnwُtwُmَt", "root": "موت"}, {"id": 6, "arabic": "وَمِنْهَا", "translit": "āَhْnِmَw", "root": ""}, {"id": 7, "arabic": "تُخْرَجُونَ", "translit": "َnwُjgَrْhkُt", "root": "خرج"}], "hasIhya": false}, {"ayah": 26, "text": "يَٰبَنِىٓ ءَادَمَ قَدْ أَنزَلْنَا عَلَيْكُمْ لِبَاسًا يُوَٰرِى سَوْءَٰتِكُمْ وَرِيشًاۖ وَلِبَاسُ ٱلتَّقْوَىٰ ذَٰلِكَ خَيْرٌۚ ذَٰلِكَ مِنْ ءَايَٰتِ ٱللَّهِ لَعَلَّهُمْ يَذَّكَّرُونَ ", "translation": "O children of Adam, We have bestowed upon you clothing to conceal your private parts and as adornment. But the clothing of righteousness - that is best. That is from the signs of Allāh that perhaps they will remember.", "words": [{"id": 1, "arabic": "يَٰبَنِىٓ", "translit": "ٓàِnَbَٰy", "root": "بني"}, {"id": 2, "arabic": "ءَادَمَ", "translit": "َmَdāَء", "root": "ادم"}, {"id": 3, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 4, "arabic": "أَنزَلْنَا", "translit": "āَnْlَznَaʾ", "root": "نزل"}, {"id": 5, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 6, "arabic": "لِبَاسًا", "translit": "āًsāَbِl", "root": "لبس"}, {"id": 7, "arabic": "يُوَٰرِى", "translit": "àِrَٰwُy", "root": "وري"}, {"id": 8, "arabic": "سَوْءَٰتِكُمْ", "translit": "ْmُkِtَٰءْwَs", "root": "سوا"}, {"id": 9, "arabic": "وَرِيشًا", "translit": "āًhsyِrَw", "root": "ريش"}, {"id": 10, "arabic": "وَلِبَاسُ", "translit": "ُsāَbِlَw", "root": "لبس"}, {"id": 11, "arabic": "ٱلتَّقْوَىٰ", "translit": "ٰàَwْqَّtlٱ", "root": "وقي"}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 13, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 14, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 15, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 16, "arabic": "ءَايَٰتِ", "translit": "ِtَٰyāَء", "root": "ايي"}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 19, "arabic": "يَذَّكَّرُونَ", "translit": "َnwُrَّkَّhdَy", "root": "ذكر"}], "hasIhya": true}, {"ayah": 27, "text": "يَٰبَنِىٓ ءَادَمَ لَا يَفْتِنَنَّكُمُ ٱلشَّيْطَٰنُ كَمَآ أَخْرَجَ أَبَوَيْكُم مِّنَ ٱلْجَنَّةِ يَنزِعُ عَنْهُمَا لِبَاسَهُمَا لِيُرِيَهُمَا سَوْءَٰتِهِمَآۗ إِنَّهُۥ يَرَىٰكُمْ هُوَ وَقَبِيلُهُۥ مِنْ حَيْثُ لَا تَرَوْنَهُمْۗ إِنَّا جَعَلْنَا ٱلشَّيَٰطِينَ أَوْلِيَآءَ لِلَّذِينَ لَا يُؤْمِنُونَ ", "translation": "O children of Adam, let not Satan tempt you as he removed your parents from Paradise, stripping them of their clothing[1] to show them their private parts. Indeed, he sees you, he and his tribe, from where you do not see them. Indeed, We have made the devils allies to those who do not believe.", "words": [{"id": 1, "arabic": "يَٰبَنِىٓ", "translit": "ٓàِnَbَٰy", "root": "بني"}, {"id": 2, "arabic": "ءَادَمَ", "translit": "َmَdāَء", "root": "ادم"}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يَفْتِنَنَّكُمُ", "translit": "ُmُkَّnَnِtْfَy", "root": "فتن"}, {"id": 5, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 6, "arabic": "كَمَآ", "translit": "ٓāَmَk", "root": ""}, {"id": 7, "arabic": "أَخْرَجَ", "translit": "َjgَrْhkَaʾ", "root": "خرج"}, {"id": 8, "arabic": "أَبَوَيْكُم", "translit": "mُkْyَwَbَaʾ", "root": "ابو"}, {"id": 9, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 10, "arabic": "ٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱ", "root": "جنن"}, {"id": 11, "arabic": "يَنزِعُ", "translit": "ُʿعِznَy", "root": "نزع"}, {"id": 12, "arabic": "عَنْهُمَا", "translit": "āَmُhْnَʿع", "root": ""}, {"id": 13, "arabic": "لِبَاسَهُمَا", "translit": "āَmُhَsāَbِl", "root": "لبس"}, {"id": 14, "arabic": "لِيُرِيَهُمَا", "translit": "āَmُhَyِrُyِl", "root": "راي"}, {"id": 15, "arabic": "سَوْءَٰتِهِمَآ", "translit": "ٓāَmِhِtَٰءْwَs", "root": "سوا"}, {"id": 16, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 17, "arabic": "يَرَىٰكُمْ", "translit": "ْmُkٰàَrَy", "root": "راي"}, {"id": 18, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 19, "arabic": "وَقَبِيلُهُۥ", "translit": "ۥُhُlyِbَqَw", "root": "قبل"}, {"id": 20, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 21, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 22, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 23, "arabic": "تَرَوْنَهُمْ", "translit": "ْmُhَnْwَrَt", "root": "راي"}, {"id": 24, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 25, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 26, "arabic": "ٱلشَّيَٰطِينَ", "translit": "َnyِṭَٰyَّhslٱ", "root": "شطن"}, {"id": 27, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 28, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 29, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 30, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": true}, {"ayah": 28, "text": "وَإِذَا فَعَلُوا۟ فَٰحِشَةً قَالُوا۟ وَجَدْنَا عَلَيْهَآ ءَابَآءَنَا وَٱللَّهُ أَمَرَنَا بِهَاۗ قُلْ إِنَّ ٱللَّهَ لَا يَأْمُرُ بِٱلْفَحْشَآءِۖ أَتَقُولُونَ عَلَى ٱللَّهِ مَا لَا تَعْلَمُونَ ", "translation": "And when they commit an immorality, they say, \"We found our fathers doing it, and Allāh has ordered us to do it.\" Say, \"Indeed, Allāh does not order immorality. Do you say about Allāh that which you do not know?\"", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "فَعَلُوا۟", "translit": "۟āwُlَʿعَf", "root": "فعل"}, {"id": 3, "arabic": "فَٰحِشَةً", "translit": "ًẗَhsِḥَٰf", "root": "فحش"}, {"id": 4, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 5, "arabic": "وَجَدْنَا", "translit": "āَnْdَjgَw", "root": "وجد"}, {"id": 6, "arabic": "عَلَيْهَآ", "translit": "ٓāَhْyَlَʿع", "root": ""}, {"id": 7, "arabic": "ءَابَآءَنَا", "translit": "āَnَءٓāَbāَء", "root": "ابو"}, {"id": 8, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 9, "arabic": "أَمَرَنَا", "translit": "āَnَrَmَaʾ", "root": "امر"}, {"id": 10, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 11, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 12, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 13, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 15, "arabic": "يَأْمُرُ", "translit": "ُrُmْaʾَy", "root": "امر"}, {"id": 16, "arabic": "بِٱلْفَحْشَآءِ", "translit": "ِءٓāَhsْḥَfْlٱِb", "root": "فحش"}, {"id": 17, "arabic": "أَتَقُولُونَ", "translit": "َnwُlwُqَtَaʾ", "root": "قول"}, {"id": 18, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 19, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 21, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 22, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": true}, {"ayah": 29, "text": "قُلْ أَمَرَ رَبِّى بِٱلْقِسْطِۖ وَأَقِيمُوا۟ وُجُوهَكُمْ عِندَ كُلِّ مَسْجِدٍ وَٱدْعُوهُ مُخْلِصِينَ لَهُ ٱلدِّينَۚ كَمَا بَدَأَكُمْ تَعُودُونَ ", "translation": "Say, [O Muḥammad], \"My Lord has ordered justice and that you direct yourselves [to the Qiblah] at every place [or time] of prostration, and invoke Him, sincere to Him in religion.\" Just as He originated you, you will return [to life] -", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَمَرَ", "translit": "َrَmَaʾ", "root": "امر"}, {"id": 3, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 4, "arabic": "بِٱلْقِسْطِ", "translit": "ِṭْsِqْlٱِb", "root": "قسط"}, {"id": 5, "arabic": "وَأَقِيمُوا۟", "translit": "۟āwُmyِqَaʾَw", "root": "قوم"}, {"id": 6, "arabic": "وُجُوهَكُمْ", "translit": "ْmُkَhwُjgُw", "root": "وجه"}, {"id": 7, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 8, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 9, "arabic": "مَسْجِدٍ", "translit": "ٍdِjgْsَm", "root": "سجد"}, {"id": 10, "arabic": "وَٱدْعُوهُ", "translit": "ُhwُʿعْdٱَw", "root": "دعو"}, {"id": 11, "arabic": "مُخْلِصِينَ", "translit": "َnyِṣِlْhkُm", "root": "خلص"}, {"id": 12, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 13, "arabic": "ٱلدِّينَ", "translit": "َnyِّdlٱ", "root": "دين"}, {"id": 14, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 15, "arabic": "بَدَأَكُمْ", "translit": "ْmُkَaʾَdَb", "root": "بدا"}, {"id": 16, "arabic": "تَعُودُونَ", "translit": "َnwُdwُʿعَt", "root": "عود"}], "hasIhya": false}, {"ayah": 30, "text": "فَرِيقًا هَدَىٰ وَفَرِيقًا حَقَّ عَلَيْهِمُ ٱلضَّلَٰلَةُۗ إِنَّهُمُ ٱتَّخَذُوا۟ ٱلشَّيَٰطِينَ أَوْلِيَآءَ مِن دُونِ ٱللَّهِ وَيَحْسَبُونَ أَنَّهُم مُّهْتَدُونَ ", "translation": "A group [of you] He guided, and a group deserved [to be in] error. Indeed, they [i.e., the latter] had taken the devils as allies instead of Allāh while they thought that they were guided.", "words": [{"id": 1, "arabic": "فَرِيقًا", "translit": "āًqyِrَf", "root": "فرق"}, {"id": 2, "arabic": "هَدَىٰ", "translit": "ٰàَdَh", "root": "هدي"}, {"id": 3, "arabic": "وَفَرِيقًا", "translit": "āًqyِrَfَw", "root": "فرق"}, {"id": 4, "arabic": "حَقَّ", "translit": "َّqَḥ", "root": "حقق"}, {"id": 5, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلضَّلَٰلَةُ", "translit": "ُẗَlَٰlَّḍlٱ", "root": "ضلل"}, {"id": 7, "arabic": "إِنَّهُمُ", "translit": "ُmُhَّnِiʾ", "root": ""}, {"id": 8, "arabic": "ٱتَّخَذُوا۟", "translit": "۟āwُhdَhkَّtٱ", "root": "اخذ"}, {"id": 9, "arabic": "ٱلشَّيَٰطِينَ", "translit": "َnyِṭَٰyَّhslٱ", "root": "شطن"}, {"id": 10, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "وَيَحْسَبُونَ", "translit": "َnwُbَsْḥَyَw", "root": "حسب"}, {"id": 15, "arabic": "أَنَّهُم", "translit": "mُhَّnَaʾ", "root": ""}, {"id": 16, "arabic": "مُّهْتَدُونَ", "translit": "َnwُdَtْhُّm", "root": "هدي"}], "hasIhya": false}, {"ayah": 31, "text": "يَٰبَنِىٓ ءَادَمَ خُذُوا۟ زِينَتَكُمْ عِندَ كُلِّ مَسْجِدٍ وَكُلُوا۟ وَٱشْرَبُوا۟ وَلَا تُسْرِفُوٓا۟ۚ إِنَّهُۥ لَا يُحِبُّ ٱلْمُسْرِفِينَ ", "translation": "O children of Adam, take your adornment [i.e., wear your clothing] at every masjid,[1] and eat and drink, but be not excessive. Indeed, He likes not those who commit excess.", "words": [{"id": 1, "arabic": "يَٰبَنِىٓ", "translit": "ٓàِnَbَٰy", "root": "بني"}, {"id": 2, "arabic": "ءَادَمَ", "translit": "َmَdāَء", "root": "ادم"}, {"id": 3, "arabic": "خُذُوا۟", "translit": "۟āwُhdُhk", "root": "اخذ"}, {"id": 4, "arabic": "زِينَتَكُمْ", "translit": "ْmُkَtَnyِz", "root": "زين"}, {"id": 5, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 6, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 7, "arabic": "مَسْجِدٍ", "translit": "ٍdِjgْsَm", "root": "سجد"}, {"id": 8, "arabic": "وَكُلُوا۟", "translit": "۟āwُlُkَw", "root": "اكل"}, {"id": 9, "arabic": "وَٱشْرَبُوا۟", "translit": "۟āwُbَrْhsٱَw", "root": "شرب"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "تُسْرِفُوٓا۟", "translit": "۟āٓwُfِrْsُt", "root": "سرف"}, {"id": 12, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 13, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 14, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 15, "arabic": "ٱلْمُسْرِفِينَ", "translit": "َnyِfِrْsُmْlٱ", "root": "سرف"}], "hasIhya": true}, {"ayah": 32, "text": "قُلْ مَنْ حَرَّمَ زِينَةَ ٱللَّهِ ٱلَّتِىٓ أَخْرَجَ لِعِبَادِهِۦ وَٱلطَّيِّبَٰتِ مِنَ ٱلرِّزْقِۚ قُلْ هِىَ لِلَّذِينَ ءَامَنُوا۟ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا خَالِصَةً يَوْمَ ٱلْقِيَٰمَةِۗ كَذَٰلِكَ نُفَصِّلُ ٱلْءَايَٰتِ لِقَوْمٍ يَعْلَمُونَ ", "translation": "Say, \"Who has forbidden the adornment of [i.e., from] Allāh which He has produced for His servants and the good [lawful] things of provision?\" Say, \"They are for those who believed during the life of this world, exclusively [for them] on the Day of Resurrection.\" Thus do We detail the verses for a people who know.", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 3, "arabic": "حَرَّمَ", "translit": "َmَّrَḥ", "root": "حرم"}, {"id": 4, "arabic": "زِينَةَ", "translit": "َẗَnyِz", "root": "زين"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "ٱلَّتِىٓ", "translit": "ٓàِtَّlٱ", "root": ""}, {"id": 7, "arabic": "أَخْرَجَ", "translit": "َjgَrْhkَaʾ", "root": "خرج"}, {"id": 8, "arabic": "لِعِبَادِهِۦ", "translit": "ۦِhِdāَbِʿعِl", "root": "عبد"}, {"id": 9, "arabic": "وَٱلطَّيِّبَٰتِ", "translit": "ِtَٰbِّyَّṭlٱَw", "root": "طيب"}, {"id": 10, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 11, "arabic": "ٱلرِّزْقِ", "translit": "ِqْzِّrlٱ", "root": "رزق"}, {"id": 12, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 13, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 14, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 15, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 16, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 17, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 18, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 19, "arabic": "خَالِصَةً", "translit": "ًẗَṣِlāَhk", "root": "خلص"}, {"id": 20, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 21, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 22, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 23, "arabic": "نُفَصِّلُ", "translit": "ُlِّṣَfُn", "root": "فصل"}, {"id": 24, "arabic": "ٱلْءَايَٰتِ", "translit": "ِtَٰyāَءْlٱ", "root": "ايي"}, {"id": 25, "arabic": "لِقَوْمٍ", "translit": "ٍmْwَqِl", "root": "قوم"}, {"id": 26, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": true}, {"ayah": 33, "text": "قُلْ إِنَّمَا حَرَّمَ رَبِّىَ ٱلْفَوَٰحِشَ مَا ظَهَرَ مِنْهَا وَمَا بَطَنَ وَٱلْإِثْمَ وَٱلْبَغْىَ بِغَيْرِ ٱلْحَقِّ وَأَن تُشْرِكُوا۟ بِٱللَّهِ مَا لَمْ يُنَزِّلْ بِهِۦ سُلْطَٰنًا وَأَن تَقُولُوا۟ عَلَى ٱللَّهِ مَا لَا تَعْلَمُونَ ", "translation": "Say, \"My Lord has only forbidden immoralities - what is apparent of them and what is concealed - and sin,[1] and oppression without right, and that you associate with Allāh that for which He has not sent down authority, and that you say about Allāh that which you do not know.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 3, "arabic": "حَرَّمَ", "translit": "َmَّrَḥ", "root": "حرم"}, {"id": 4, "arabic": "رَبِّىَ", "translit": "َàِّbَr", "root": "ربب"}, {"id": 5, "arabic": "ٱلْفَوَٰحِشَ", "translit": "َhsِḥَٰwَfْlٱ", "root": "فحش"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "ظَهَرَ", "translit": "َrَhَẓ", "root": "ظهر"}, {"id": 8, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "بَطَنَ", "translit": "َnَṭَb", "root": "بطن"}, {"id": 11, "arabic": "وَٱلْإِثْمَ", "translit": "َmْhtِiʾْlٱَw", "root": "اثم"}, {"id": 12, "arabic": "وَٱلْبَغْىَ", "translit": "َàْغَbْlٱَw", "root": "بغي"}, {"id": 13, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 14, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 15, "arabic": "وَأَن", "translit": "nَaʾَw", "root": ""}, {"id": 16, "arabic": "تُشْرِكُوا۟", "translit": "۟āwُkِrْhsُt", "root": "شرك"}, {"id": 17, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 18, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 19, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 20, "arabic": "يُنَزِّلْ", "translit": "ْlِّzَnُy", "root": "نزل"}, {"id": 21, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 22, "arabic": "سُلْطَٰنًا", "translit": "āًnَٰṭْlُs", "root": "سلط"}, {"id": 23, "arabic": "وَأَن", "translit": "nَaʾَw", "root": ""}, {"id": 24, "arabic": "تَقُولُوا۟", "translit": "۟āwُlwُqَt", "root": "قول"}, {"id": 25, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 26, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 27, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 28, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 29, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": true}, {"ayah": 34, "text": "وَلِكُلِّ أُمَّةٍ أَجَلٌۖ فَإِذَا جَآءَ أَجَلُهُمْ لَا يَسْتَأْخِرُونَ سَاعَةًۖ وَلَا يَسْتَقْدِمُونَ ", "translation": "And for every nation is a [specified] term. So when their time has come, they will not remain behind an hour, nor will they precede [it].", "words": [{"id": 1, "arabic": "وَلِكُلِّ", "translit": "ِّlُkِlَw", "root": "كلل"}, {"id": 2, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 3, "arabic": "أَجَلٌ", "translit": "ٌlَjgَaʾ", "root": "اجل"}, {"id": 4, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 5, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 6, "arabic": "أَجَلُهُمْ", "translit": "ْmُhُlَjgَaʾ", "root": "اجل"}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يَسْتَأْخِرُونَ", "translit": "َnwُrِhkْaʾَtْsَy", "root": "اخر"}, {"id": 9, "arabic": "سَاعَةً", "translit": "ًẗَʿعāَs", "root": "سوع"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "يَسْتَقْدِمُونَ", "translit": "َnwُmِdْqَtْsَy", "root": "قدم"}], "hasIhya": false}, {"ayah": 35, "text": "يَٰبَنِىٓ ءَادَمَ إِمَّا يَأْتِيَنَّكُمْ رُسُلٌ مِّنكُمْ يَقُصُّونَ عَلَيْكُمْ ءَايَٰتِىۙ فَمَنِ ٱتَّقَىٰ وَأَصْلَحَ فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ ", "translation": "O children of Adam, if there come to you messengers from among you relating to you My verses [i.e., scriptures and laws], then whoever fears Allāh and reforms - there will be no fear concerning them, nor will they grieve.", "words": [{"id": 1, "arabic": "يَٰبَنِىٓ", "translit": "ٓàِnَbَٰy", "root": "بني"}, {"id": 2, "arabic": "ءَادَمَ", "translit": "َmَdāَء", "root": "ادم"}, {"id": 3, "arabic": "إِمَّا", "translit": "āَّmِiʾ", "root": ""}, {"id": 4, "arabic": "يَأْتِيَنَّكُمْ", "translit": "ْmُkَّnَyِtْaʾَy", "root": "اتي"}, {"id": 5, "arabic": "رُسُلٌ", "translit": "ٌlُsُr", "root": "رسل"}, {"id": 6, "arabic": "مِّنكُمْ", "translit": "ْmُknِّm", "root": ""}, {"id": 7, "arabic": "يَقُصُّونَ", "translit": "َnwُّṣُqَy", "root": "قصص"}, {"id": 8, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 9, "arabic": "ءَايَٰتِى", "translit": "àِtَٰyāَء", "root": "ايي"}, {"id": 10, "arabic": "فَمَنِ", "translit": "ِnَmَf", "root": ""}, {"id": 11, "arabic": "ٱتَّقَىٰ", "translit": "ٰàَqَّtٱ", "root": "وقي"}, {"id": 12, "arabic": "وَأَصْلَحَ", "translit": "َḥَlْṣَaʾَw", "root": "صلح"}, {"id": 13, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 14, "arabic": "خَوْفٌ", "translit": "ٌfْwَhk", "root": "خوف"}, {"id": 15, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 16, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 17, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 18, "arabic": "يَحْزَنُونَ", "translit": "َnwُnَzْḥَy", "root": "حزن"}], "hasIhya": false}, {"ayah": 36, "text": "وَٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَا وَٱسْتَكْبَرُوا۟ عَنْهَآ أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلنَّارِۖ هُمْ فِيهَا خَٰلِدُونَ ", "translation": "But the ones who deny Our verses and are arrogant toward them - those are the companions of the Fire; they will abide therein eternally.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 3, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 4, "arabic": "وَٱسْتَكْبَرُوا۟", "translit": "۟āwُrَbْkَtْsٱَw", "root": "كبر"}, {"id": 5, "arabic": "عَنْهَآ", "translit": "ٓāَhْnَʿع", "root": ""}, {"id": 6, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 7, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 8, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 9, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 10, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 11, "arabic": "خَٰلِدُونَ", "translit": "َnwُdِlَٰhk", "root": "خلد"}], "hasIhya": false}, {"ayah": 37, "text": "فَمَنْ أَظْلَمُ مِمَّنِ ٱفْتَرَىٰ عَلَى ٱللَّهِ كَذِبًا أَوْ كَذَّبَ بِـَٔايَٰتِهِۦٓۚ أُو۟لَٰٓئِكَ يَنَالُهُمْ نَصِيبُهُم مِّنَ ٱلْكِتَٰبِۖ حَتَّىٰٓ إِذَا جَآءَتْهُمْ رُسُلُنَا يَتَوَفَّوْنَهُمْ قَالُوٓا۟ أَيْنَ مَا كُنتُمْ تَدْعُونَ مِن دُونِ ٱللَّهِۖ قَالُوا۟ ضَلُّوا۟ عَنَّا وَشَهِدُوا۟ عَلَىٰٓ أَنفُسِهِمْ أَنَّهُمْ كَانُوا۟ كَٰفِرِينَ ", "translation": "And who is more unjust than one who invents about Allāh a lie or denies His verses? Those will attain their portion of the decree[1] until, when Our messengers [i.e., angels] come to them to take them in death, they will say, \"Where are those you used to invoke besides Allāh?\" They will say, \"They have departed from us,\" and will bear witness against themselves that they were disbelievers.", "words": [{"id": 1, "arabic": "فَمَنْ", "translit": "ْnَmَf", "root": ""}, {"id": 2, "arabic": "أَظْلَمُ", "translit": "ُmَlْẓَaʾ", "root": "ظلم"}, {"id": 3, "arabic": "مِمَّنِ", "translit": "ِnَّmِm", "root": ""}, {"id": 4, "arabic": "ٱفْتَرَىٰ", "translit": "ٰàَrَtْfٱ", "root": "فري"}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "كَذِبًا", "translit": "āًbِhdَk", "root": "كذب"}, {"id": 8, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 9, "arabic": "كَذَّبَ", "translit": "َbَّhdَk", "root": "كذب"}, {"id": 10, "arabic": "بِـَٔايَٰتِهِۦٓ", "translit": "ٓۦِhِtَٰyāَٔـِb", "root": "ايي"}, {"id": 11, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 12, "arabic": "يَنَالُهُمْ", "translit": "ْmُhُlāَnَy", "root": "نيل"}, {"id": 13, "arabic": "نَصِيبُهُم", "translit": "mُhُbyِṣَn", "root": "نصب"}, {"id": 14, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 15, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 16, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 17, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 18, "arabic": "جَآءَتْهُمْ", "translit": "ْmُhْtَءٓāَjg", "root": "جيا"}, {"id": 19, "arabic": "رُسُلُنَا", "translit": "āَnُlُsُr", "root": "رسل"}, {"id": 20, "arabic": "يَتَوَفَّوْنَهُمْ", "translit": "ْmُhَnْwَّfَwَtَy", "root": "وفي"}, {"id": 21, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 22, "arabic": "أَيْنَ", "translit": "َnْyَaʾ", "root": ""}, {"id": 23, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 24, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 25, "arabic": "تَدْعُونَ", "translit": "َnwُʿعْdَt", "root": "دعو"}, {"id": 26, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 27, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 28, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 29, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 30, "arabic": "ضَلُّوا۟", "translit": "۟āwُّlَḍ", "root": "ضلل"}, {"id": 31, "arabic": "عَنَّا", "translit": "āَّnَʿع", "root": ""}, {"id": 32, "arabic": "وَشَهِدُوا۟", "translit": "۟āwُdِhَhsَw", "root": "شهد"}, {"id": 33, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 34, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 35, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 36, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 37, "arabic": "كَٰفِرِينَ", "translit": "َnyِrِfَٰk", "root": "كفر"}], "hasIhya": true}, {"ayah": 38, "text": "قَالَ ٱدْخُلُوا۟ فِىٓ أُمَمٍ قَدْ خَلَتْ مِن قَبْلِكُم مِّنَ ٱلْجِنِّ وَٱلْإِنسِ فِى ٱلنَّارِۖ كُلَّمَا دَخَلَتْ أُمَّةٌ لَّعَنَتْ أُخْتَهَاۖ حَتَّىٰٓ إِذَا ٱدَّارَكُوا۟ فِيهَا جَمِيعًا قَالَتْ أُخْرَىٰهُمْ لِأُولَىٰهُمْ رَبَّنَا هَٰٓؤُلَآءِ أَضَلُّونَا فَـَٔاتِهِمْ عَذَابًا ضِعْفًا مِّنَ ٱلنَّارِۖ قَالَ لِكُلٍّ ضِعْفٌ وَلَٰكِن لَّا تَعْلَمُونَ ", "translation": "[Allāh] will say, \"Enter among nations which had passed on before you of jinn and mankind into the Fire.\" Every time a nation enters, it will curse its sister[1] until, when they have all overtaken one another therein, the last of them[2] will say about the first of them,[3] \"Our Lord, these had misled us, so give them a double punishment of the Fire.\" He will say, \"For each is double, but you do not know.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱدْخُلُوا۟", "translit": "۟āwُlُhkْdٱ", "root": "دخل"}, {"id": 3, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 4, "arabic": "أُمَمٍ", "translit": "ٍmَmُaʾ", "root": "امم"}, {"id": 5, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 6, "arabic": "خَلَتْ", "translit": "ْtَlَhk", "root": "خلو"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "قَبْلِكُم", "translit": "mُkِlْbَq", "root": "قبل"}, {"id": 9, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 10, "arabic": "ٱلْجِنِّ", "translit": "ِّnِjgْlٱ", "root": "جنن"}, {"id": 11, "arabic": "وَٱلْإِنسِ", "translit": "ِsnِiʾْlٱَw", "root": "انس"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 14, "arabic": "كُلَّمَا", "translit": "āَmَّlُk", "root": "كلل"}, {"id": 15, "arabic": "دَخَلَتْ", "translit": "ْtَlَhkَd", "root": "دخل"}, {"id": 16, "arabic": "أُمَّةٌ", "translit": "ٌẗَّmُaʾ", "root": "امم"}, {"id": 17, "arabic": "لَّعَنَتْ", "translit": "ْtَnَʿعَّl", "root": "لعن"}, {"id": 18, "arabic": "أُخْتَهَا", "translit": "āَhَtْhkُaʾ", "root": "اخو"}, {"id": 19, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 20, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 21, "arabic": "ٱدَّارَكُوا۟", "translit": "۟āwُkَrāَّdٱ", "root": "درك"}, {"id": 22, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 23, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 24, "arabic": "قَالَتْ", "translit": "ْtَlāَq", "root": "قول"}, {"id": 25, "arabic": "أُخْرَىٰهُمْ", "translit": "ْmُhٰàَrْhkُaʾ", "root": "اخر"}, {"id": 26, "arabic": "لِأُولَىٰهُمْ", "translit": "ْmُhٰàَlwُaʾِl", "root": "اول"}, {"id": 27, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 28, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 29, "arabic": "أَضَلُّونَا", "translit": "āَnwُّlَḍَaʾ", "root": "ضلل"}, {"id": 30, "arabic": "فَـَٔاتِهِمْ", "translit": "ْmِhِtāَٔـَf", "root": "اتي"}, {"id": 31, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 32, "arabic": "ضِعْفًا", "translit": "āًfْʿعِḍ", "root": "ضعف"}, {"id": 33, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 34, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 35, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 36, "arabic": "لِكُلٍّ", "translit": "ٍّlُkِl", "root": "كلل"}, {"id": 37, "arabic": "ضِعْفٌ", "translit": "ٌfْʿعِḍ", "root": "ضعف"}, {"id": 38, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 39, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 40, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": false}, {"ayah": 39, "text": "وَقَالَتْ أُولَىٰهُمْ لِأُخْرَىٰهُمْ فَمَا كَانَ لَكُمْ عَلَيْنَا مِن فَضْلٍ فَذُوقُوا۟ ٱلْعَذَابَ بِمَا كُنتُمْ تَكْسِبُونَ ", "translation": "And the first of them will say to the last of them, \"Then you had not any favor over us, so taste the punishment for what you used to earn.\"", "words": [{"id": 1, "arabic": "وَقَالَتْ", "translit": "ْtَlāَqَw", "root": "قول"}, {"id": 2, "arabic": "أُولَىٰهُمْ", "translit": "ْmُhٰàَlwُaʾ", "root": "اول"}, {"id": 3, "arabic": "لِأُخْرَىٰهُمْ", "translit": "ْmُhٰàَrْhkُaʾِl", "root": "اخر"}, {"id": 4, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 5, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 6, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 7, "arabic": "عَلَيْنَا", "translit": "āَnْyَlَʿع", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "فَضْلٍ", "translit": "ٍlْḍَf", "root": "فضل"}, {"id": 10, "arabic": "فَذُوقُوا۟", "translit": "۟āwُqwُhdَf", "root": "ذوق"}, {"id": 11, "arabic": "ٱلْعَذَابَ", "translit": "َbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 12, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 13, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 14, "arabic": "تَكْسِبُونَ", "translit": "َnwُbِsْkَt", "root": "كسب"}], "hasIhya": false}, {"ayah": 40, "text": "إِنَّ ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَا وَٱسْتَكْبَرُوا۟ عَنْهَا لَا تُفَتَّحُ لَهُمْ أَبْوَٰبُ ٱلسَّمَآءِ وَلَا يَدْخُلُونَ ٱلْجَنَّةَ حَتَّىٰ يَلِجَ ٱلْجَمَلُ فِى سَمِّ ٱلْخِيَاطِۚ وَكَذَٰلِكَ نَجْزِى ٱلْمُجْرِمِينَ ", "translation": "Indeed, those who deny Our verses and are arrogant toward them - the gates of Heaven will not be opened for them, nor will they enter Paradise until a camel enters into the eye of a needle [i.e., never]. And thus do We recompense the criminals.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 4, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 5, "arabic": "وَٱسْتَكْبَرُوا۟", "translit": "۟āwُrَbْkَtْsٱَw", "root": "كبر"}, {"id": 6, "arabic": "عَنْهَا", "translit": "āَhْnَʿع", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "تُفَتَّحُ", "translit": "ُḥَّtَfُt", "root": "فتح"}, {"id": 9, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 10, "arabic": "أَبْوَٰبُ", "translit": "ُbَٰwْbَaʾ", "root": "بوب"}, {"id": 11, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "يَدْخُلُونَ", "translit": "َnwُlُhkْdَy", "root": "دخل"}, {"id": 14, "arabic": "ٱلْجَنَّةَ", "translit": "َẗَّnَjgْlٱ", "root": "جنن"}, {"id": 15, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 16, "arabic": "يَلِجَ", "translit": "َjgِlَy", "root": "ولج"}, {"id": 17, "arabic": "ٱلْجَمَلُ", "translit": "ُlَmَjgْlٱ", "root": "جمل"}, {"id": 18, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 19, "arabic": "سَمِّ", "translit": "ِّmَs", "root": "سمم"}, {"id": 20, "arabic": "ٱلْخِيَاطِ", "translit": "ِṭāَyِhkْlٱ", "root": "خيط"}, {"id": 21, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 22, "arabic": "نَجْزِى", "translit": "àِzْjgَn", "root": "جزي"}, {"id": 23, "arabic": "ٱلْمُجْرِمِينَ", "translit": "َnyِmِrْjgُmْlٱ", "root": "جرم"}], "hasIhya": true}, {"ayah": 41, "text": "لَهُم مِّن جَهَنَّمَ مِهَادٌ وَمِن فَوْقِهِمْ غَوَاشٍۚ وَكَذَٰلِكَ نَجْزِى ٱلظَّٰلِمِينَ ", "translation": "They will have from Hell a bed and over them coverings [of fire]. And thus do We recompense the wrongdoers.", "words": [{"id": 1, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 2, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 3, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 4, "arabic": "مِهَادٌ", "translit": "ٌdāَhِm", "root": "مهد"}, {"id": 5, "arabic": "وَمِن", "translit": "nِmَw", "root": ""}, {"id": 6, "arabic": "فَوْقِهِمْ", "translit": "ْmِhِqْwَf", "root": "فوق"}, {"id": 7, "arabic": "غَوَاشٍ", "translit": "ٍhsāَwَغ", "root": "غشو"}, {"id": 8, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 9, "arabic": "نَجْزِى", "translit": "àِzْjgَn", "root": "جزي"}, {"id": 10, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 42, "text": "وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَا نُكَلِّفُ نَفْسًا إِلَّا وُسْعَهَآ أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْجَنَّةِۖ هُمْ فِيهَا خَٰلِدُونَ ", "translation": "But those who believed and did righteous deeds - We charge no soul except [within] its capacity. Those are the companions of Paradise; they will abide therein eternally.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 3, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 4, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "نُكَلِّفُ", "translit": "ُfِّlَkُn", "root": "كلف"}, {"id": 7, "arabic": "نَفْسًا", "translit": "āًsْfَn", "root": "نفس"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "وُسْعَهَآ", "translit": "ٓāَhَʿعْsُw", "root": "وسع"}, {"id": 10, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 11, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 12, "arabic": "ٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱ", "root": "جنن"}, {"id": 13, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 14, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 15, "arabic": "خَٰلِدُونَ", "translit": "َnwُdِlَٰhk", "root": "خلد"}], "hasIhya": true}, {"ayah": 43, "text": "وَنَزَعْنَا مَا فِى صُدُورِهِم مِّنْ غِلٍّ تَجْرِى مِن تَحْتِهِمُ ٱلْأَنْهَٰرُۖ وَقَالُوا۟ ٱلْحَمْدُ لِلَّهِ ٱلَّذِى هَدَىٰنَا لِهَٰذَا وَمَا كُنَّا لِنَهْتَدِىَ لَوْلَآ أَنْ هَدَىٰنَا ٱللَّهُۖ لَقَدْ جَآءَتْ رُسُلُ رَبِّنَا بِٱلْحَقِّۖ وَنُودُوٓا۟ أَن تِلْكُمُ ٱلْجَنَّةُ أُورِثْتُمُوهَا بِمَا كُنتُمْ تَعْمَلُونَ ", "translation": "And We will have removed whatever is within their breasts of resentment,[1] [while] flowing beneath them are rivers. And they will say, \"Praise to Allāh, who has guided us to this; and we would never have been guided if Allāh had not guided us. Certainly the messengers of our Lord had come with the truth.\" And they will be called, \"This is Paradise, which you have been made to inherit for what you used to do.\"", "words": [{"id": 1, "arabic": "وَنَزَعْنَا", "translit": "āَnْʿعَzَnَw", "root": "نزع"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "صُدُورِهِم", "translit": "mِhِrwُdُṣ", "root": "صدر"}, {"id": 5, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 6, "arabic": "غِلٍّ", "translit": "ٍّlِغ", "root": "غلل"}, {"id": 7, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "تَحْتِهِمُ", "translit": "ُmِhِtْḥَt", "root": "تحت"}, {"id": 10, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 11, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 12, "arabic": "ٱلْحَمْدُ", "translit": "ُdْmَḥْlٱ", "root": "حمد"}, {"id": 13, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 14, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 15, "arabic": "هَدَىٰنَا", "translit": "āَnٰàَdَh", "root": "هدي"}, {"id": 16, "arabic": "لِهَٰذَا", "translit": "āَhdَٰhِl", "root": ""}, {"id": 17, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 18, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 19, "arabic": "لِنَهْتَدِىَ", "translit": "َàِdَtْhَnِl", "root": "هدي"}, {"id": 20, "arabic": "لَوْلَآ", "translit": "ٓāَlْwَl", "root": ""}, {"id": 21, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 22, "arabic": "هَدَىٰنَا", "translit": "āَnٰàَdَh", "root": "هدي"}, {"id": 23, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 25, "arabic": "جَآءَتْ", "translit": "ْtَءٓāَjg", "root": "جيا"}, {"id": 26, "arabic": "رُسُلُ", "translit": "ُlُsُr", "root": "رسل"}, {"id": 27, "arabic": "رَبِّنَا", "translit": "āَnِّbَr", "root": "ربب"}, {"id": 28, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 29, "arabic": "وَنُودُوٓا۟", "translit": "۟āٓwُdwُnَw", "root": "ندي"}, {"id": 30, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 31, "arabic": "تِلْكُمُ", "translit": "ُmُkْlِt", "root": ""}, {"id": 32, "arabic": "ٱلْجَنَّةُ", "translit": "ُẗَّnَjgْlٱ", "root": "جنن"}, {"id": 33, "arabic": "أُورِثْتُمُوهَا", "translit": "āَhwُmُtْhtِrwُaʾ", "root": "ورث"}, {"id": 34, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 35, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 36, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": true}, {"ayah": 44, "text": "وَنَادَىٰٓ أَصْحَٰبُ ٱلْجَنَّةِ أَصْحَٰبَ ٱلنَّارِ أَن قَدْ وَجَدْنَا مَا وَعَدَنَا رَبُّنَا حَقًّا فَهَلْ وَجَدتُّم مَّا وَعَدَ رَبُّكُمْ حَقًّاۖ قَالُوا۟ نَعَمْۚ فَأَذَّنَ مُؤَذِّنٌۢ بَيْنَهُمْ أَن لَّعْنَةُ ٱللَّهِ عَلَى ٱلظَّٰلِمِينَ ", "translation": "And the companions of Paradise will call out to the companions of the Fire, \"We have already found what our Lord promised us to be true. Have you found what your Lord promised to be true?\" They will say, \"Yes.\" Then an announcer will announce among them, \"The curse of Allāh shall be upon the wrongdoers", "words": [{"id": 1, "arabic": "وَنَادَىٰٓ", "translit": "ٰٓàَdāَnَw", "root": "ندي"}, {"id": 2, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 3, "arabic": "ٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱ", "root": "جنن"}, {"id": 4, "arabic": "أَصْحَٰبَ", "translit": "َbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 5, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 8, "arabic": "وَجَدْنَا", "translit": "āَnْdَjgَw", "root": "وجد"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "وَعَدَنَا", "translit": "āَnَdَʿعَw", "root": "وعد"}, {"id": 11, "arabic": "رَبُّنَا", "translit": "āَnُّbَr", "root": "ربب"}, {"id": 12, "arabic": "حَقًّا", "translit": "āًّqَḥ", "root": "حقق"}, {"id": 13, "arabic": "فَهَلْ", "translit": "ْlَhَf", "root": ""}, {"id": 14, "arabic": "وَجَدتُّم", "translit": "mُّtdَjgَw", "root": "وجد"}, {"id": 15, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 16, "arabic": "وَعَدَ", "translit": "َdَʿعَw", "root": "وعد"}, {"id": 17, "arabic": "رَبُّكُمْ", "translit": "ْmُkُّbَr", "root": "ربب"}, {"id": 18, "arabic": "حَقًّا", "translit": "āًّqَḥ", "root": "حقق"}, {"id": 19, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 20, "arabic": "نَعَمْ", "translit": "ْmَʿعَn", "root": ""}, {"id": 21, "arabic": "فَأَذَّنَ", "translit": "َnَّhdَaʾَf", "root": "اذن"}, {"id": 22, "arabic": "مُؤَذِّنٌۢ", "translit": "ٌۢnِّhdَwʾُm", "root": "اذن"}, {"id": 23, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 24, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 25, "arabic": "لَّعْنَةُ", "translit": "ُẗَnْʿعَّl", "root": "لعن"}, {"id": 26, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 27, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 28, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": true}, {"ayah": 45, "text": "ٱلَّذِينَ يَصُدُّونَ عَن سَبِيلِ ٱللَّهِ وَيَبْغُونَهَا عِوَجًا وَهُم بِٱلْءَاخِرَةِ كَٰفِرُونَ ", "translation": "Who averted [people] from the way of Allāh and sought to make it [seem] deviant while they were, concerning the Hereafter, disbelievers.\"", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يَصُدُّونَ", "translit": "َnwُّdُṣَy", "root": "صدد"}, {"id": 3, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 4, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَيَبْغُونَهَا", "translit": "āَhَnwُغْbَyَw", "root": "بغي"}, {"id": 7, "arabic": "عِوَجًا", "translit": "āًjgَwِʿع", "root": "عوج"}, {"id": 8, "arabic": "وَهُم", "translit": "mُhَw", "root": ""}, {"id": 9, "arabic": "بِٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱِb", "root": "اخر"}, {"id": 10, "arabic": "كَٰفِرُونَ", "translit": "َnwُrِfَٰk", "root": "كفر"}], "hasIhya": false}, {"ayah": 46, "text": "وَبَيْنَهُمَا حِجَابٌۚ وَعَلَى ٱلْأَعْرَافِ رِجَالٌ يَعْرِفُونَ كُلًّۢا بِسِيمَىٰهُمْۚ وَنَادَوْا۟ أَصْحَٰبَ ٱلْجَنَّةِ أَن سَلَٰمٌ عَلَيْكُمْۚ لَمْ يَدْخُلُوهَا وَهُمْ يَطْمَعُونَ ", "translation": "And between them will be a partition [i.e., wall], and on [its] elevations are men[1] who recognize all[2] by their mark. And they call out to the companions of Paradise, \"Peace be upon you.\" They have not [yet] entered it, but they long intensely.", "words": [{"id": 1, "arabic": "وَبَيْنَهُمَا", "translit": "āَmُhَnْyَbَw", "root": "بين"}, {"id": 2, "arabic": "حِجَابٌ", "translit": "ٌbāَjgِḥ", "root": "حجب"}, {"id": 3, "arabic": "وَعَلَى", "translit": "àَlَʿعَw", "root": ""}, {"id": 4, "arabic": "ٱلْأَعْرَافِ", "translit": "ِfāَrْʿعَaʾْlٱ", "root": "عرف"}, {"id": 5, "arabic": "رِجَالٌ", "translit": "ٌlāَjgِr", "root": "رجل"}, {"id": 6, "arabic": "يَعْرِفُونَ", "translit": "َnwُfِrْʿعَy", "root": "عرف"}, {"id": 7, "arabic": "كُلًّۢا", "translit": "āًّۢlُk", "root": "كلل"}, {"id": 8, "arabic": "بِسِيمَىٰهُمْ", "translit": "ْmُhٰàَmyِsِb", "root": "سوم"}, {"id": 9, "arabic": "وَنَادَوْا۟", "translit": "۟āْwَdāَnَw", "root": "ندي"}, {"id": 10, "arabic": "أَصْحَٰبَ", "translit": "َbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 11, "arabic": "ٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱ", "root": "جنن"}, {"id": 12, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 13, "arabic": "سَلَٰمٌ", "translit": "ٌmَٰlَs", "root": "سلم"}, {"id": 14, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 15, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 16, "arabic": "يَدْخُلُوهَا", "translit": "āَhwُlُhkْdَy", "root": "دخل"}, {"id": 17, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 18, "arabic": "يَطْمَعُونَ", "translit": "َnwُʿعَmْṭَy", "root": "طمع"}], "hasIhya": false}, {"ayah": 47, "text": "وَإِذَا صُرِفَتْ أَبْصَٰرُهُمْ تِلْقَآءَ أَصْحَٰبِ ٱلنَّارِ قَالُوا۟ رَبَّنَا لَا تَجْعَلْنَا مَعَ ٱلْقَوْمِ ٱلظَّٰلِمِينَ ", "translation": "And when their eyes are turned toward the companions of the Fire, they say, \"Our Lord, do not place us with the wrongdoing people.\"", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "صُرِفَتْ", "translit": "ْtَfِrُṣ", "root": "صرف"}, {"id": 3, "arabic": "أَبْصَٰرُهُمْ", "translit": "ْmُhُrَٰṣْbَaʾ", "root": "بصر"}, {"id": 4, "arabic": "تِلْقَآءَ", "translit": "َءٓāَqْlِt", "root": "لقي"}, {"id": 5, "arabic": "أَصْحَٰبِ", "translit": "ِbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 6, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 7, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 8, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "تَجْعَلْنَا", "translit": "āَnْlَʿعْjgَt", "root": "جعل"}, {"id": 11, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 12, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 13, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 48, "text": "وَنَادَىٰٓ أَصْحَٰبُ ٱلْأَعْرَافِ رِجَالًا يَعْرِفُونَهُم بِسِيمَىٰهُمْ قَالُوا۟ مَآ أَغْنَىٰ عَنكُمْ جَمْعُكُمْ وَمَا كُنتُمْ تَسْتَكْبِرُونَ ", "translation": "And the companions of the Elevations will call to men [within Hell] whom they recognize by their mark, saying, \"Of no avail to you was your gathering[1] and [the fact] that you were arrogant.\"", "words": [{"id": 1, "arabic": "وَنَادَىٰٓ", "translit": "ٰٓàَdāَnَw", "root": "ندي"}, {"id": 2, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 3, "arabic": "ٱلْأَعْرَافِ", "translit": "ِfāَrْʿعَaʾْlٱ", "root": "عرف"}, {"id": 4, "arabic": "رِجَالًا", "translit": "āًlāَjgِr", "root": "رجل"}, {"id": 5, "arabic": "يَعْرِفُونَهُم", "translit": "mُhَnwُfِrْʿعَy", "root": "عرف"}, {"id": 6, "arabic": "بِسِيمَىٰهُمْ", "translit": "ْmُhٰàَmyِsِb", "root": "سوم"}, {"id": 7, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 8, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 9, "arabic": "أَغْنَىٰ", "translit": "ٰàَnْغَaʾ", "root": "غني"}, {"id": 10, "arabic": "عَنكُمْ", "translit": "ْmُknَʿع", "root": ""}, {"id": 11, "arabic": "جَمْعُكُمْ", "translit": "ْmُkُʿعْmَjg", "root": "جمع"}, {"id": 12, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 13, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 14, "arabic": "تَسْتَكْبِرُونَ", "translit": "َnwُrِbْkَtْsَt", "root": "كبر"}], "hasIhya": false}, {"ayah": 49, "text": "أَهَٰٓؤُلَآءِ ٱلَّذِينَ أَقْسَمْتُمْ لَا يَنَالُهُمُ ٱللَّهُ بِرَحْمَةٍۚ ٱدْخُلُوا۟ ٱلْجَنَّةَ لَا خَوْفٌ عَلَيْكُمْ وَلَآ أَنتُمْ تَحْزَنُونَ ", "translation": "[Allāh will say], \"Are these[1] the ones whom you [inhabitants of Hell] swore that Allāh would never offer them mercy? Enter Paradise, [O people of the Elevations]. No fear will there be concerning you, nor will you grieve.\"", "words": [{"id": 1, "arabic": "أَهَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓhَaʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "أَقْسَمْتُمْ", "translit": "ْmُtْmَsْqَaʾ", "root": "قسم"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "يَنَالُهُمُ", "translit": "ُmُhُlāَnَy", "root": "نيل"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "بِرَحْمَةٍ", "translit": "ٍẗَmْḥَrِb", "root": "رحم"}, {"id": 8, "arabic": "ٱدْخُلُوا۟", "translit": "۟āwُlُhkْdٱ", "root": "دخل"}, {"id": 9, "arabic": "ٱلْجَنَّةَ", "translit": "َẗَّnَjgْlٱ", "root": "جنن"}, {"id": 10, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 11, "arabic": "خَوْفٌ", "translit": "ٌfْwَhk", "root": "خوف"}, {"id": 12, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 13, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 14, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 15, "arabic": "تَحْزَنُونَ", "translit": "َnwُnَzْḥَt", "root": "حزن"}], "hasIhya": false}, {"ayah": 50, "text": "وَنَادَىٰٓ أَصْحَٰبُ ٱلنَّارِ أَصْحَٰبَ ٱلْجَنَّةِ أَنْ أَفِيضُوا۟ عَلَيْنَا مِنَ ٱلْمَآءِ أَوْ مِمَّا رَزَقَكُمُ ٱللَّهُۚ قَالُوٓا۟ إِنَّ ٱللَّهَ حَرَّمَهُمَا عَلَى ٱلْكَٰفِرِينَ ", "translation": "And the companions of the Fire will call to the companions of Paradise, \"Pour upon us some water or from whatever Allāh has provided you.\" They will say, \"Indeed, Allāh has forbidden them both to the di