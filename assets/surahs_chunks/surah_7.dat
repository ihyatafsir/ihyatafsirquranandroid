ranslit":"āَّnِiʾ","root":""},{"id":7,"arabic":"لَا","translit":"āَl","root":""},{"id":8,"arabic":"نُضِيعُ","translit":"ُʿعyِḍُn","root":"ضيع"},{"id":9,"arabic":"أَجْرَ","translit":"َrْjgَaʾ","root":"اجر"},{"id":10,"arabic":"ٱلْمُصْلِحِينَ","translit":"َnyِḥِlْṣُmْlٱ","root":"صلح"}],"hasIhya":false},{"ayah":171,"text":"وَإِذْ نَتَقْنَا ٱلْجَبَلَ فَوْقَهُمْ كَأَنَّهُۥ ظُلَّةٌ وَظَنُّوٓا۟ أَنَّهُۥ وَاقِعٌۢ بِهِمْ خُذُوا۟ مَآ ءَاتَيْنَٰكُم بِقُوَّةٍ وَٱذْكُرُوا۟ مَا فِيهِ لَعَلَّكُمْ تَتَّقُونَ ","translation":"And [mention] when We raised the mountain above them as if it was a dark cloud and they were certain that it would fall upon them,[1] [and Allāh said], \"Take what We have given you with determination and remember what is in it that you might fear Allāh.\"","words":[{"id":1,"arabic":"وَإِذْ","translit":"ْhdِiʾَw","root":""},{"id":2,"arabic":"نَتَقْنَا","translit":"āَnْqَtَn","root":"نتق"},{"id":3,"arabic":"ٱلْجَبَلَ","translit":"َlَbَjgْlٱ","root":"جبل"},{"id":4,"arabic":"فَوْقَهُمْ","translit":"ْmُhَqْwَf","root":"فوق"},{"id":5,"arabic":"كَأَنَّهُۥ","translit":"ۥُhَّnَaʾَk","root":""},{"id":6,"arabic":"ظُلَّةٌ","translit":"ٌẗَّlُẓ","root":"ظلل"},{"id":7,"arabic":"وَظَنُّوٓا۟","translit":"۟āٓwُّnَẓَw","root":"ظنن"},{"id":8,"arabic":"أَنَّهُۥ","translit":"ۥُhَّnَaʾ","root":""},{"id":9,"arabic":"وَاقِعٌۢ","translit":"ٌۢʿعِqāَw","root":"وقع"},{"id":10,"arabic":"بِهِمْ","translit":"ْmِhِb","root":""},{"id":11,"arabic":"خُذُوا۟","translit":"۟āwُhdُhk","root":"اخذ"},{"id":12,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":13,"arabic":"ءَاتَيْنَٰكُم","translit":"mُkَٰnْyَtāَء","root":"اتي"},{"id":14,"arabic":"بِقُوَّةٍ","translit":"ٍẗَّwُqِb","root":"قوي"},{"id":15,"arabic":"وَٱذْكُرُوا۟","translit":"۟āwُrُkْhdٱَw","root":"ذكر"},{"id":16,"arabic":"مَا","translit":"āَm","root":""},{"id":17,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":18,"arabic":"لَعَلَّكُمْ","translit":"ْmُkَّlَʿعَl","root":""},{"id":19,"arabic":"تَتَّقُونَ","translit":"َnwُqَّtَt","root":"وقي"}],"hasIhya":false},{"ayah":172,"text":"وَإِذْ أَخَذَ رَبُّكَ مِنۢ بَنِىٓ ءَادَمَ مِن ظُهُورِهِمْ ذُرِّيَّتَهُمْ وَأَشْهَدَهُمْ عَلَىٰٓ أَنفُسِهِمْ أَلَسْتُ بِرَبِّكُمْۖ قَالُوا۟ بَلَىٰۛ شَهِدْنَآۛ أَن تَقُولُوا۟ يَوْمَ ٱلْقِيَٰمَةِ إِنَّا كُنَّا عَنْ هَٰذَا غَٰفِلِينَ ","translation":"And [mention] when your Lord took from the children of Adam - from their loins - their descendants and made them testify of themselves, [saying to them], \"Am I not your Lord?\" They said, \"Yes, we have testified.\" [This] - lest you should say on the Day of Resurrection, \"Indeed, we were of this unaware.\"","words":[{"id":1,"arabic":"وَإِذْ","translit":"ْhdِiʾَw","root":""},{"id":2,"arabic":"أَخَذَ","translit":"َhdَhkَaʾ","root":"اخذ"},{"id":3,"arabic":"رَبُّكَ","translit":"َkُّbَr","root":"ربب"},{"id":4,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":5,"arabic":"بَنِىٓ","translit":"ٓàِnَb","root":"بني"},{"id":6,"arabic":"ءَادَمَ","translit":"َmَdāَء","root":"ادم"},{"id":7,"arabic":"مِن","translit":"nِm","root":""},{"id":8,"arabic":"ظُهُورِهِمْ","translit":"ْmِhِrwُhُẓ","root":"ظهر"},{"id":9,"arabic":"ذُرِّيَّتَهُمْ","translit":"ْmُhَtَّyِّrُhd","root":"ذرر"},{"id":10,"arabic":"وَأَشْهَدَهُمْ","translit":"ْmُhَdَhْhsَaʾَw","root":"شهد"},{"id":11,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":12,"arabic":"أَنفُسِهِمْ","translit":"ْmِhِsُfnَaʾ","root":"نفس"},{"id":13,"arabic":"أَلَسْتُ","translit":"ُtْsَlَaʾ","root":"ليس"},{"id":14,"arabic":"بِرَبِّكُمْ","translit":"ْmُkِّbَrِb","root":"ربب"},{"id":15,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":16,"arabic":"بَلَىٰ","translit":"ٰàَlَb","root":""},{"id":17,"arabic":"شَهِدْنَآ","translit":"ٓāَnْdِhَhs","root":"شهد"},{"id":18,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":19,"arabic":"تَقُولُوا۟","translit":"۟āwُlwُqَt","root":"قول"},{"id":20,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":21,"arabic":"ٱلْقِيَٰمَةِ","translit":"ِẗَmَٰyِqْlٱ","root":"قوم"},{"id":22,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":23,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":24,"arabic":"عَنْ","translit":"ْnَʿع","root":""},{"id":25,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":26,"arabic":"غَٰفِلِينَ","translit":"َnyِlِfَٰغ","root":"غفل"}],"hasIhya":true},{"ayah":173,"text":"أَوْ تَقُولُوٓا۟ إِنَّمَآ أَشْرَكَ ءَابَآؤُنَا مِن قَبْلُ وَكُنَّا ذُرِّيَّةً مِّنۢ بَعْدِهِمْۖ أَفَتُهْلِكُنَا بِمَا فَعَلَ ٱلْمُبْطِلُونَ ","translation":"Or [lest] you say, \"It was only that our fathers associated [others in worship] with Allāh before, and we were but descendants after them. Then would You destroy us for what the falsifiers have done?\"","words":[{"id":1,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":2,"arabic":"تَقُولُوٓا۟","translit":"۟āٓwُlwُqَt","root":"قول"},{"id":3,"arabic":"إِنَّمَآ","translit":"ٓāَmَّnِiʾ","root":""},{"id":4,"arabic":"أَشْرَكَ","translit":"َkَrْhsَaʾ","root":"شرك"},{"id":5,"arabic":"ءَابَآؤُنَا","translit":"āَnُwʾٓāَbāَء","root":"ابو"},{"id":6,"arabic":"مِن","translit":"nِm","root":""},{"id":7,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":8,"arabic":"وَكُنَّا","translit":"āَّnُkَw","root":"كون"},{"id":9,"arabic":"ذُرِّيَّةً","translit":"ًẗَّyِّrُhd","root":"ذرر"},{"id":10,"arabic":"مِّنۢ","translit":"ۢnِّm","root":""},{"id":11,"arabic":"بَعْدِهِمْ","translit":"ْmِhِdْʿعَb","root":"بعد"},{"id":12,"arabic":"أَفَتُهْلِكُنَا","translit":"āَnُkِlْhُtَfَaʾ","root":"هلك"},{"id":13,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":14,"arabic":"فَعَلَ","translit":"َlَʿعَf","root":"فعل"},{"id":15,"arabic":"ٱلْمُبْطِلُونَ","translit":"َnwُlِṭْbُmْlٱ","root":"بطل"}],"hasIhya":false},{"ayah":174,"text":"وَكَذَٰلِكَ نُفَصِّلُ ٱلْءَايَٰتِ وَلَعَلَّهُمْ يَرْجِعُونَ ","translation":"And thus do We [explain in] detail the verses, and perhaps they will return.[1]","words":[{"id":1,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":2,"arabic":"نُفَصِّلُ","translit":"ُlِّṣَfُn","root":"فصل"},{"id":3,"arabic":"ٱلْءَايَٰتِ","translit":"ِtَٰyāَءْlٱ","root":"ايي"},{"id":4,"arabic":"وَلَعَلَّهُمْ","translit":"ْmُhَّlَʿعَlَw","root":""},{"id":5,"arabic":"يَرْجِعُونَ","translit":"َnwُʿعِjgْrَy","root":"رجع"}],"hasIhya":false},{"ayah":175,"text":"وَٱتْلُ عَلَيْهِمْ نَبَأَ ٱلَّذِىٓ ءَاتَيْنَٰهُ ءَايَٰتِنَا فَٱنسَلَخَ مِنْهَا فَأَتْبَعَهُ ٱلشَّيْطَٰنُ فَكَانَ مِنَ ٱلْغَاوِينَ ","translation":"And recite to them, [O Muḥammad], the news of him[1] to whom We gave [knowledge of] Our signs, but he detached himself from them; so Satan pursued him, and he became of the deviators.[2]","words":[{"id":1,"arabic":"وَٱتْلُ","translit":"ُlْtٱَw","root":"تلو"},{"id":2,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":3,"arabic":"نَبَأَ","translit":"َaʾَbَn","root":"نبا"},{"id":4,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":5,"arabic":"ءَاتَيْنَٰهُ","translit":"ُhَٰnْyَtāَء","root":"اتي"},{"id":6,"arabic":"ءَايَٰتِنَا","translit":"āَnِtَٰyāَء","root":"ايي"},{"id":7,"arabic":"فَٱنسَلَخَ","translit":"َhkَlَsnٱَf","root":"سلخ"},{"id":8,"arabic":"مِنْهَا","translit":"āَhْnِm","root":""},{"id":9,"arabic":"فَأَتْبَعَهُ","translit":"ُhَʿعَbْtَaʾَf","root":"تبع"},{"id":10,"arabic":"ٱلشَّيْطَٰنُ","translit":"ُnَٰṭْyَّhslٱ","root":"شطن"},{"id":11,"arabic":"فَكَانَ","translit":"َnāَkَf","root":"كون"},{"id":12,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":13,"arabic":"ٱلْغَاوِينَ","translit":"َnyِwāَغْlٱ","root":"غوي"}],"hasIhya":true},{"ayah":176,"text":"وَلَوْ شِئْنَا لَرَفَعْنَٰهُ بِهَا وَلَٰكِنَّهُۥٓ أَخْلَدَ إِلَى ٱلْأَرْضِ وَٱتَّبَعَ هَوَىٰهُۚ فَمَثَلُهُۥ كَمَثَلِ ٱلْكَلْبِ إِن تَحْمِلْ عَلَيْهِ يَلْهَثْ أَوْ تَتْرُكْهُ يَلْهَثۚ ذَّٰلِكَ مَثَلُ ٱلْقَوْمِ ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَاۚ فَٱقْصُصِ ٱلْقَصَصَ لَعَلَّهُمْ يَتَفَكَّرُونَ ","translation":"And if We had willed, We could have elevated him thereby,[1] but he adhered [instead] to the earth[2] and followed his own desire. So his example is like that of the dog: if you chase him, he pants, or if you leave him, he [still] pants. That is the example of the people who denied Our signs.[3] So relate the stories that perhaps they will give thought.","words":[{"id":1,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":2,"arabic":"شِئْنَا","translit":"āَnْyʾِhs","root":"شيا"},{"id":3,"arabic":"لَرَفَعْنَٰهُ","translit":"ُhَٰnْʿعَfَrَl","root":"رفع"},{"id":4,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":5,"arabic":"وَلَٰكِنَّهُۥٓ","translit":"ٓۥُhَّnِkَٰlَw","root":""},{"id":6,"arabic":"أَخْلَدَ","translit":"َdَlْhkَaʾ","root":"خلد"},{"id":7,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":8,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":9,"arabic":"وَٱتَّبَعَ","translit":"َʿعَbَّtٱَw","root":"تبع"},{"id":10,"arabic":"هَوَىٰهُ","translit":"ُhٰàَwَh","root":"هوي"},{"id":11,"arabic":"فَمَثَلُهُۥ","translit":"ۥُhُlَhtَmَf","root":"مثل"},{"id":12,"arabic":"كَمَثَلِ","translit":"ِlَhtَmَk","root":"مثل"},{"id":13,"arabic":"ٱلْكَلْبِ","translit":"ِbْlَkْlٱ","root":"كلب"},{"id":14,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":15,"arabic":"تَحْمِلْ","translit":"ْlِmْḥَt","root":"حمل"},{"id":16,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":17,"arabic":"يَلْهَثْ","translit":"ْhtَhْlَy","root":"لهث"},{"id":18,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":19,"arabic":"تَتْرُكْهُ","translit":"ُhْkُrْtَt","root":"ترك"},{"id":20,"arabic":"يَلْهَث","translit":"htَhْlَy","root":"لهث"},{"id":21,"arabic":"ذَّٰلِكَ","translit":"َkِlَّٰhd","root":""},{"id":22,"arabic":"مَثَلُ","translit":"ُlَhtَm","root":"مثل"},{"id":23,"arabic":"ٱلْقَوْمِ","translit":"ِmْwَqْlٱ","root":"قوم"},{"id":24,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":25,"arabic":"كَذَّبُوا۟","translit":"۟āwُbَّhdَk","root":"كذب"},{"id":26,"arabic":"بِـَٔايَٰتِنَا","translit":"āَnِtَٰyāَٔـِb","root":"ايي"},{"id":27,"arabic":"فَٱقْصُصِ","translit":"ِṣُṣْqٱَf","root":"قصص"},{"id":28,"arabic":"ٱلْقَصَصَ","translit":"َṣَṣَqْlٱ","root":"قصص"},{"id":29,"arabic":"لَعَلَّهُمْ","translit":"ْmُhَّlَʿعَl","root":""},{"id":30,"arabic":"يَتَفَكَّرُونَ","translit":"َnwُrَّkَfَtَy","root":"فكر"}],"hasIhya":true},{"ayah":177,"text":"سَآءَ مَثَلًا ٱلْقَوْمُ ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَا وَأَنفُسَهُمْ كَانُوا۟ يَظْلِمُونَ ","translation":"How evil an example [is that of] the people who denied Our signs and used to wrong themselves.","words":[{"id":1,"arabic":"سَآءَ","translit":"َءٓāَs","root":"سوا"},{"id":2,"arabic":"مَثَلًا","translit":"āًlَhtَm","root":"مثل"},{"id":3,"arabic":"ٱلْقَوْمُ","translit":"ُmْwَqْlٱ","root":"قوم"},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"كَذَّبُوا۟","translit":"۟āwُbَّhdَk","root":"كذب"},{"id":6,"arabic":"بِـَٔايَٰتِنَا","translit":"āَnِtَٰyāَٔـِb","root":"ايي"},{"id":7,"arabic":"وَأَنفُسَهُمْ","translit":"ْmُhَsُfnَaʾَw","root":"نفس"},{"id":8,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":9,"arabic":"يَظْلِمُونَ","translit":"َnwُmِlْẓَy","root":"ظلم"}],"hasIhya":false},{"ayah":178,"text":"مَن يَهْدِ ٱللَّهُ فَهُوَ ٱلْمُهْتَدِىۖ وَمَن يُضْلِلْ فَأُو۟لَٰٓئِكَ هُمُ ٱلْخَٰسِرُونَ ","translation":"Whoever Allāh guides - he is the [rightly] guided; and whoever He sends astray[1] - it is those who are the losers.","words":[{"id":1,"arabic":"مَن","translit":"nَm","root":""},{"id":2,"arabic":"يَهْدِ","translit":"ِdْhَy","root":"هدي"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"فَهُوَ","translit":"َwُhَf","root":""},{"id":5,"arabic":"ٱلْمُهْتَدِى","translit":"àِdَtْhُmْlٱ","root":"هدي"},{"id":6,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":7,"arabic":"يُضْلِلْ","translit":"ْlِlْḍُy","root":"ضلل"},{"id":8,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":9,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":10,"arabic":"ٱلْخَٰسِرُونَ","translit":"َnwُrِsَٰhkْlٱ","root":"خسر"}],"hasIhya":false},{"ayah":179,"text":"وَلَقَدْ ذَرَأْنَا لِجَهَنَّمَ كَثِيرًا مِّنَ ٱلْجِنِّ وَٱلْإِنسِۖ لَهُمْ قُلُوبٌ لَّا يَفْقَهُونَ بِهَا وَلَهُمْ أَعْيُنٌ لَّا يُبْصِرُونَ بِهَا وَلَهُمْ ءَاذَانٌ لَّا يَسْمَعُونَ بِهَآۚ أُو۟لَٰٓئِكَ كَٱلْأَنْعَٰمِ بَلْ هُمْ أَضَلُّۚ أُو۟لَٰٓئِكَ هُمُ ٱلْغَٰفِلُونَ ","translation":"And We have certainly created for Hell many of the jinn and mankind. They have hearts with which they do not understand, they have eyes with which they do not see, and they have ears with which they do not hear. Those are like livestock; rather, they are more astray.[1] It is they who are the heedless.","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"ذَرَأْنَا","translit":"āَnْaʾَrَhd","root":"ذرا"},{"id":3,"arabic":"لِجَهَنَّمَ","translit":"َmَّnَhَjgِl","root":""},{"id":4,"arabic":"كَثِيرًا","translit":"āًryِhtَk","root":"كثر"},{"id":5,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":6,"arabic":"ٱلْجِنِّ","translit":"ِّnِjgْlٱ","root":"جنن"},{"id":7,"arabic":"وَٱلْإِنسِ","translit":"ِsnِiʾْlٱَw","root":"انس"},{"id":8,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":9,"arabic":"قُلُوبٌ","translit":"ٌbwُlُq","root":"قلب"},{"id":10,"arabic":"لَّا","translit":"āَّl","root":""},{"id":11,"arabic":"يَفْقَهُونَ","translit":"َnwُhَqْfَy","root":"فقه"},{"id":12,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":13,"arabic":"وَلَهُمْ","translit":"ْmُhَlَw","root":""},{"id":14,"arabic":"أَعْيُنٌ","translit":"ٌnُyْʿعَaʾ","root":"عين"},{"id":15,"arabic":"لَّا","translit":"āَّl","root":""},{"id":16,"arabic":"يُبْصِرُونَ","translit":"َnwُrِṣْbُy","root":"بصر"},{"id":17,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":18,"arabic":"وَلَهُمْ","translit":"ْmُhَlَw","root":""},{"id":19,"arabic":"ءَاذَانٌ","translit":"ٌnāَhdāَء","root":"اذن"},{"id":20,"arabic":"لَّا","translit":"āَّl","root":""},{"id":21,"arabic":"يَسْمَعُونَ","translit":"َnwُʿعَmْsَy","root":"سمع"},{"id":22,"arabic":"بِهَآ","translit":"ٓāَhِb","root":""},{"id":23,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":24,"arabic":"كَٱلْأَنْعَٰمِ","translit":"ِmَٰʿعْnَaʾْlٱَk","root":"نعم"},{"id":25,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":26,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":27,"arabic":"أَضَلُّ","translit":"ُّlَḍَaʾ","root":"ضلل"},{"id":28,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":29,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":30,"arabic":"ٱلْغَٰفِلُونَ","translit":"َnwُlِfَٰغْlٱ","root":"غفل"}],"hasIhya":true},{"ayah":180,"text":"وَلِلَّهِ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ فَٱدْعُوهُ بِهَاۖ وَذَرُوا۟ ٱلَّذِينَ يُلْحِدُونَ فِىٓ أَسْمَٰٓئِهِۦۚ سَيُجْزَوْنَ مَا كَانُوا۟ يَعْمَلُونَ ","translation":"And to Allāh belong the best names, so invoke Him by them. And leave [the company of] those who practice deviation concerning His names.[1] They will be recompensed for what they have been doing.","words":[{"id":1,"arabic":"وَلِلَّهِ","translit":"ِhَّlِlَw","root":"اله"},{"id":2,"arabic":"ٱلْأَسْمَآءُ","translit":"ُءٓāَmْsَaʾْlٱ","root":"سمو"},{"id":3,"arabic":"ٱلْحُسْنَىٰ","translit":"ٰàَnْsُḥْlٱ","root":"حسن"},{"id":4,"arabic":"فَٱدْعُوهُ","translit":"ُhwُʿعْdٱَf","root":"دعو"},{"id":5,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":6,"arabic":"وَذَرُوا۟","translit":"۟āwُrَhdَw","root":"وذر"},{"id":7,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":8,"arabic":"يُلْحِدُونَ","translit":"َnwُdِḥْlُy","root":"لحد"},{"id":9,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":10,"arabic":"أَسْمَٰٓئِهِۦ","translit":"ۦِhِyʾَٰٓmْsَaʾ","root":"سمو"},{"id":11,"arabic":"سَيُجْزَوْنَ","translit":"َnْwَzْjgُyَs","root":"جزي"},{"id":12,"arabic":"مَا","translit":"āَm","root":""},{"id":13,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":14,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":false},{"ayah":181,"text":"وَمِمَّنْ خَلَقْنَآ أُمَّةٌ يَهْدُونَ بِٱلْحَقِّ وَبِهِۦ يَعْدِلُونَ ","translation":"And among those We created is a community[1] which guides by truth and thereby establishes justice.","words":[{"id":1,"arabic":"وَمِمَّنْ","translit":"ْnَّmِmَw","root":""},{"id":2,"arabic":"خَلَقْنَآ","translit":"ٓāَnْqَlَhk","root":"خلق"},{"id":3,"arabic":"أُمَّةٌ","translit":"ٌẗَّmُaʾ","root":"امم"},{"id":4,"arabic":"يَهْدُونَ","translit":"َnwُdْhَy","root":"هدي"},{"id":5,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":6,"arabic":"وَبِهِۦ","translit":"ۦِhِbَw","root":""},{"id":7,"arabic":"يَعْدِلُونَ","translit":"َnwُlِdْʿعَy","root":"عدل"}],"hasIhya":false},{"ayah":182,"text":"وَٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَا سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ ","translation":"But those who deny Our signs - We will progressively lead them [to destruction][1] from where they do not know.","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"كَذَّبُوا۟","translit":"۟āwُbَّhdَk","root":"كذب"},{"id":3,"arabic":"بِـَٔايَٰتِنَا","translit":"āَnِtَٰyāَٔـِb","root":"ايي"},{"id":4,"arabic":"سَنَسْتَدْرِجُهُم","translit":"mُhُjgِrْdَtْsَnَs","root":"درج"},{"id":5,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":6,"arabic":"حَيْثُ","translit":"ُhtْyَḥ","root":"حيث"},{"id":7,"arabic":"لَا","translit":"āَl","root":""},{"id":8,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":true},{"ayah":183,"text":"وَأُمْلِى لَهُمْۚ إِنَّ كَيْدِى مَتِينٌ ","translation":"And I will give them time. Indeed, My plan is firm.","words":[{"id":1,"arabic":"وَأُمْلِى","translit":"àِlْmُaʾَw","root":"ملو"},{"id":2,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":3,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":4,"arabic":"كَيْدِى","translit":"àِdْyَk","root":"كيد"},{"id":5,"arabic":"مَتِينٌ","translit":"ٌnyِtَm","root":"متن"}],"hasIhya":false},{"ayah":184,"text":"أَوَلَمْ يَتَفَكَّرُوا۟ۗ مَا بِصَاحِبِهِم مِّن جِنَّةٍۚ إِنْ هُوَ إِلَّا نَذِيرٌ مُّبِينٌ ","translation":"Then do they not give thought? There is in their companion [i.e., Muḥammad (ﷺ)] no madness. He is not but a clear warner.","words":[{"id":1,"arabic":"أَوَلَمْ","translit":"ْmَlَwَaʾ","root":""},{"id":2,"arabic":"يَتَفَكَّرُوا۟","translit":"۟āwُrَّkَfَtَy","root":"فكر"},{"id":3,"arabic":"مَا","translit":"āَm","root":""},{"id":4,"arabic":"بِصَاحِبِهِم","translit":"mِhِbِḥāَṣِb","root":"صحب"},{"id":5,"arabic":"مِّن","translit":"nِّm","root":""},{"id":6,"arabic":"جِنَّةٍ","translit":"ٍẗَّnِjg","root":"جنن"},{"id":7,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":8,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":9,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":10,"arabic":"نَذِيرٌ","translit":"ٌryِhdَn","root":"نذر"},{"id":11,"arabic":"مُّبِينٌ","translit":"ٌnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":185,"text":"أَوَلَمْ يَنظُرُوا۟ فِى مَلَكُوتِ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا خَلَقَ ٱللَّهُ مِن شَىْءٍ وَأَنْ عَسَىٰٓ أَن يَكُونَ قَدِ ٱقْتَرَبَ أَجَلُهُمْۖ فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ ","translation":"Do they not look into the realm of the heavens and the earth and everything that Allāh has created and [think] that perhaps their appointed time has come near? So in what statement [i.e., message] hereafter will they believe?","words":[{"id":1,"arabic":"أَوَلَمْ","translit":"ْmَlَwَaʾ","root":""},{"id":2,"arabic":"يَنظُرُوا۟","translit":"۟āwُrُẓnَy","root":"نظر"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"مَلَكُوتِ","translit":"ِtwُkَlَm","root":"ملك"},{"id":5,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":6,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":7,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":8,"arabic":"خَلَقَ","translit":"َqَlَhk","root":"خلق"},{"id":9,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":10,"arabic":"مِن","translit":"nِm","root":""},{"id":11,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":12,"arabic":"وَأَنْ","translit":"ْnَaʾَw","root":""},{"id":13,"arabic":"عَسَىٰٓ","translit":"ٰٓàَsَʿع","root":"عسي"},{"id":14,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":15,"arabic":"يَكُونَ","translit":"َnwُkَy","root":"كون"},{"id":16,"arabic":"قَدِ","translit":"ِdَq","root":""},{"id":17,"arabic":"ٱقْتَرَبَ","translit":"َbَrَtْqٱ","root":"قرب"},{"id":18,"arabic":"أَجَلُهُمْ","translit":"ْmُhُlَjgَaʾ","root":"اجل"},{"id":19,"arabic":"فَبِأَىِّ","translit":"ِّàَaʾِbَf","root":"ايي"},{"id":20,"arabic":"حَدِيثٍۭ","translit":"ٍۭhtyِdَḥ","root":"حدث"},{"id":21,"arabic":"بَعْدَهُۥ","translit":"ۥُhَdْʿعَb","root":"بعد"},{"id":22,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"}],"hasIhya":true},{"ayah":186,"text":"مَن يُضْلِلِ ٱللَّهُ فَلَا هَادِىَ لَهُۥۚ وَيَذَرُهُمْ فِى طُغْيَٰنِهِمْ يَعْمَهُونَ ","translation":"Whoever Allāh sends astray - there is no guide for him. And He leaves them in their transgression, wandering blindly.","words":[{"id":1,"arabic":"مَن","translit":"nَm","root":""},{"id":2,"arabic":"يُضْلِلِ","translit":"ِlِlْḍُy","root":"ضلل"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":5,"arabic":"هَادِىَ","translit":"َàِdāَh","root":"هدي"},{"id":6,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":7,"arabic":"وَيَذَرُهُمْ","translit":"ْmُhُrَhdَyَw","root":"وذر"},{"id":8,"arabic":"فِى","translit":"àِf","root":""},{"id":9,"arabic":"طُغْيَٰنِهِمْ","translit":"ْmِhِnَٰyْغُṭ","root":"طغي"},{"id":10,"arabic":"يَعْمَهُونَ","translit":"َnwُhَmْʿعَy","root":"عمه"}],"hasIhya":false},{"ayah":187,"text":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَاۖ قُلْ إِنَّمَا عِلْمُهَا عِندَ رَبِّىۖ لَا يُجَلِّيهَا لِوَقْتِهَآ إِلَّا هُوَۚ ثَقُلَتْ فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ لَا تَأْتِيكُمْ إِلَّا بَغْتَةًۗ يَسْـَٔلُونَكَ كَأَنَّكَ حَفِىٌّ عَنْهَاۖ قُلْ إِنَّمَا عِلْمُهَا عِندَ ٱللَّهِ وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَعْلَمُونَ ","translation":"They ask you, [O Muḥammad], about the Hour: when is its arrival?[1] Say, \"Its knowledge is only with my Lord. None will reveal its time except Him. It lays heavily[2] upon the heavens and the earth. It will not come upon you except unexpectedly.\" They ask you as if you are familiar with it. Say, \"Its knowledge is only with Allāh, but most of the people do not know.\"","words":[{"id":1,"arabic":"يَسْـَٔلُونَكَ","translit":"َkَnwُlَٔـْsَy","root":"سال"},{"id":2,"arabic":"عَنِ","translit":"ِnَʿع","root":""},{"id":3,"arabic":"ٱلسَّاعَةِ","translit":"ِẗَʿعāَّslٱ","root":"سوع"},{"id":4,"arabic":"أَيَّانَ","translit":"َnāَّyَaʾ","root":""},{"id":5,"arabic":"مُرْسَىٰهَا","translit":"āَhٰàَsْrُm","root":"رسو"},{"id":6,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":7,"arabic":"إِنَّمَا","translit":"āَmَّnِiʾ","root":""},{"id":8,"arabic":"عِلْمُهَا","translit":"āَhُmْlِʿع","root":"علم"},{"id":9,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":10,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":11,"arabic":"لَا","translit":"āَl","root":""},{"id":12,"arabic":"يُجَلِّيهَا","translit":"āَhyِّlَjgُy","root":"جلو"},{"id":13,"arabic":"لِوَقْتِهَآ","translit":"ٓāَhِtْqَwِl","root":"وقت"},{"id":14,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":15,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":16,"arabic":"ثَقُلَتْ","translit":"ْtَlُqَht","root":"ثقل"},{"id":17,"arabic":"فِى","translit":"àِf","root":""},{"id":18,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":19,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":20,"arabic":"لَا","translit":"āَl","root":""},{"id":21,"arabic":"تَأْتِيكُمْ","translit":"ْmُkyِtْaʾَt","root":"اتي"},{"id":22,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":23,"arabic":"بَغْتَةً","translit":"ًẗَtْغَb","root":"بغت"},{"id":24,"arabic":"يَسْـَٔلُونَكَ","translit":"َkَnwُlَٔـْsَy","root":"سال"},{"id":25,"arabic":"كَأَنَّكَ","translit":"َkَّnَaʾَk","root":""},{"id":26,"arabic":"حَفِىٌّ","translit":"ٌّàِfَḥ","root":"حفو"},{"id":27,"arabic":"عَنْهَا","translit":"āَhْnَʿع","root":""},{"id":28,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":29,"arabic":"إِنَّمَا","translit":"āَmَّnِiʾ","root":""},{"id":30,"arabic":"عِلْمُهَا","translit":"āَhُmْlِʿع","root":"علم"},{"id":31,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":32,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":33,"arabic":"وَلَٰكِنَّ","translit":"َّnِkَٰlَw","root":""},{"id":34,"arabic":"أَكْثَرَ","translit":"َrَhtْkَaʾ","root":"كثر"},{"id":35,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":36,"arabic":"لَا","translit":"āَl","root":""},{"id":37,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":true},{"ayah":188,"text":"قُل لَّآ أَمْلِكُ لِنَفْسِى نَفْعًا وَلَا ضَرًّا إِلَّا مَا شَآءَ ٱللَّهُۚ وَلَوْ كُنتُ أَعْلَمُ ٱلْغَيْبَ لَٱسْتَكْثَرْتُ مِنَ ٱلْخَيْرِ وَمَا مَسَّنِىَ ٱلسُّوٓءُۚ إِنْ أَنَا۠ إِلَّا نَذِيرٌ وَبَشِيرٌ لِّقَوْمٍ يُؤْمِنُونَ ","translation":"Say, \"I hold not for myself [the power of] benefit or harm, except what Allāh has willed. And if I knew the unseen, I could have acquired much wealth, and no harm would have touched me. I am not except a warner and a bringer of good tidings to a people who believe.\"","words":[{"id":1,"arabic":"قُل","translit":"lُq","root":"قول"},{"id":2,"arabic":"لَّآ","translit":"ٓāَّl","root":""},{"id":3,"arabic":"أَمْلِكُ","translit":"ُkِlْmَaʾ","root":"ملك"},{"id":4,"arabic":"لِنَفْسِى","translit":"àِsْfَnِl","root":"نفس"},{"id":5,"arabic":"نَفْعًا","translit":"āًʿعْfَn","root":"نفع"},{"id":6,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":7,"arabic":"ضَرًّا","translit":"āًّrَḍ","root":"ضرر"},{"id":8,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":9,"arabic":"مَا","translit":"āَm","root":""},{"id":10,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":11,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":12,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":13,"arabic":"كُنتُ","translit":"ُtnُk","root":"كون"},{"id":14,"arabic":"أَعْلَمُ","translit":"ُmَlْʿعَaʾ","root":"علم"},{"id":15,"arabic":"ٱلْغَيْبَ","translit":"َbْyَغْlٱ","root":"غيب"},{"id":16,"arabic":"لَٱسْتَكْثَرْتُ","translit":"ُtْrَhtْkَtْsٱَl","root":"كثر"},{"id":17,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":18,"arabic":"ٱلْخَيْرِ","translit":"ِrْyَhkْlٱ","root":"خير"},{"id":19,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":20,"arabic":"مَسَّنِىَ","translit":"َàِnَّsَm","root":"مسس"},{"id":21,"arabic":"ٱلسُّوٓءُ","translit":"ُءٓwُّslٱ","root":"سوا"},{"id":22,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":23,"arabic":"أَنَا۠","translit":"۠āَnَaʾ","root":""},{"id":24,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":25,"arabic":"نَذِيرٌ","translit":"ٌryِhdَn","root":"نذر"},{"id":26,"arabic":"وَبَشِيرٌ","translit":"ٌryِhsَbَw","root":"بشر"},{"id":27,"arabic":"لِّقَوْمٍ","translit":"ٍmْwَqِّl","root":"قوم"},{"id":28,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"}],"hasIhya":true},{"ayah":189,"text":"هُوَ ٱلَّذِى خَلَقَكُم مِّن نَّفْسٍ وَٰحِدَةٍ وَجَعَلَ مِنْهَا زَوْجَهَا لِيَسْكُنَ إِلَيْهَاۖ فَلَمَّا تَغَشَّىٰهَا حَمَلَتْ حَمْلًا خَفِيفًا فَمَرَّتْ بِهِۦۖ فَلَمَّآ أَثْقَلَت دَّعَوَا ٱللَّهَ رَبَّهُمَا لَئِنْ ءَاتَيْتَنَا صَٰلِحًا لَّنَكُونَنَّ مِنَ ٱلشَّٰكِرِينَ ","translation":"It is He who created you from one soul and created from it its mate that he[1] might dwell in security with her. And when he [i.e., man] covers her,[2] she carries a light burden [i.e., a pregnancy] and continues therein. And when it becomes heavy, they both invoke Allāh, their Lord, \"If You should give us a good[3] [child], we will surely be among the grateful.\"","words":[{"id":1,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"خَلَقَكُم","translit":"mُkَqَlَhk","root":"خلق"},{"id":4,"arabic":"مِّن","translit":"nِّm","root":""},{"id":5,"arabic":"نَّفْسٍ","translit":"ٍsْfَّn","root":"نفس"},{"id":6,"arabic":"وَٰحِدَةٍ","translit":"ٍẗَdِḥَٰw","root":"وحد"},{"id":7,"arabic":"وَجَعَلَ","translit":"َlَʿعَjgَw","root":"جعل"},{"id":8,"arabic":"مِنْهَا","translit":"āَhْnِm","root":""},{"id":9,"arabic":"زَوْجَهَا","translit":"āَhَjgْwَz","root":"زوج"},{"id":10,"arabic":"لِيَسْكُنَ","translit":"َnُkْsَyِl","root":"سكن"},{"id":11,"arabic":"إِلَيْهَا","translit":"āَhْyَlِiʾ","root":""},{"id":12,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":13,"arabic":"تَغَشَّىٰهَا","translit":"āَhٰàَّhsَغَt","root":"غشو"},{"id":14,"arabic":"حَمَلَتْ","translit":"ْtَlَmَḥ","root":"حمل"},{"id":15,"arabic":"حَمْلًا","translit":"āًlْmَḥ","root":"حمل"},{"id":16,"arabic":"خَفِيفًا","translit":"āًfyِfَhk","root":"خفف"},{"id":17,"arabic":"فَمَرَّتْ","translit":"ْtَّrَmَf","root":"مرر"},{"id":18,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":19,"arabic":"فَلَمَّآ","translit":"ٓāَّmَlَf","root":""},{"id":20,"arabic":"أَثْقَلَت","translit":"tَlَqْhtَaʾ","root":"ثقل"},{"id":21,"arabic":"دَّعَوَا","translit":"āَwَʿعَّd","root":"دعو"},{"id":22,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":23,"arabic":"رَبَّهُمَا","translit":"āَmُhَّbَr","root":"ربب"},{"id":24,"arabic":"لَئِنْ","translit":"ْnِyʾَl","root":""},{"id":25,"arabic":"ءَاتَيْتَنَا","translit":"āَnَtْyَtāَء","root":"اتي"},{"id":26,"arabic":"صَٰلِحًا","translit":"āًḥِlَٰṣ","root":"صلح"},{"id":27,"arabic":"لَّنَكُونَنَّ","translit":"َّnَnwُkَnَّl","root":"كون"},{"id":28,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":29,"arabic":"ٱلشَّٰكِرِينَ","translit":"َnyِrِkَّٰhslٱ","root":"شكر"}],"hasIhya":false},{"ayah":190,"text":"فَلَمَّآ ءَاتَىٰهُمَا صَٰلِحًا جَعَلَا لَهُۥ شُرَكَآءَ فِيمَآ ءَاتَىٰهُمَاۚ فَتَعَٰلَى ٱللَّهُ عَمَّا يُشْرِكُونَ ","translation":"But when He gives them a good [child], they[1] ascribe partners to Him concerning that which He has given them. Exalted is Allāh above what they associate with Him.","words":[{"id":1,"arabic":"فَلَمَّآ","translit":"ٓāَّmَlَf","root":""},{"id":2,"arabic":"ءَاتَىٰهُمَا","translit":"āَmُhٰàَtāَء","root":"اتي"},{"id":3,"arabic":"صَٰلِحًا","translit":"āًḥِlَٰṣ","root":"صلح"},{"id":4,"arabic":"جَعَلَا","translit":"āَlَʿعَjg","root":"جعل"},{"id":5,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":6,"arabic":"شُرَكَآءَ","translit":"َءٓāَkَrُhs","root":"شرك"},{"id":7,"arabic":"فِيمَآ","translit":"ٓāَmyِf","root":""},{"id":8,"arabic":"ءَاتَىٰهُمَا","translit":"āَmُhٰàَtāَء","root":"اتي"},{"id":9,"arabic":"فَتَعَٰلَى","translit":"àَlَٰʿعَtَf","root":"علو"},{"id":10,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":11,"arabic":"عَمَّا","translit":"āَّmَʿع","root":""},{"id":12,"arabic":"يُشْرِكُونَ","translit":"َnwُkِrْhsُy","root":"شرك"}],"hasIhya":false},{"ayah":191,"text":"أَيُشْرِكُونَ مَا لَا يَخْلُقُ شَيْـًٔا وَهُمْ يُخْلَقُونَ ","translation":"Do they associate with Him those who create nothing and they are [themselves] created?","words":[{"id":1,"arabic":"أَيُشْرِكُونَ","translit":"َnwُkِrْhsُyَaʾ","root":"شرك"},{"id":2,"arabic":"مَا","translit":"āَm","root":""},{"id":3,"arabic":"لَا","translit":"āَl","root":""},{"id":4,"arabic":"يَخْلُقُ","translit":"ُqُlْhkَy","root":"خلق"},{"id":5,"arabic":"شَيْـًٔا","translit":"āًٔـْyَhs","root":"شيا"},{"id":6,"arabic":"وَهُمْ","translit":"ْmُhَw","root":""},{"id":7,"arabic":"يُخْلَقُونَ","translit":"َnwُqَlْhkُy","root":"خلق"}],"hasIhya":false},{"ayah":192,"text":"وَلَا يَسْتَطِيعُونَ لَهُمْ نَصْرًا وَلَآ أَنفُسَهُمْ يَنصُرُونَ ","translation":"And they [i.e., the false deities] are unable to [give] them help, nor can they help themselves.","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"يَسْتَطِيعُونَ","translit":"َnwُʿعyِṭَtْsَy","root":"طوع"},{"id":3,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":4,"arabic":"نَصْرًا","translit":"āًrْṣَn","root":"نصر"},{"id":5,"arabic":"وَلَآ","translit":"ٓāَlَw","root":""},{"id":6,"arabic":"أَنفُسَهُمْ","translit":"ْmُhَsُfnَaʾ","root":"نفس"},{"id":7,"arabic":"يَنصُرُونَ","translit":"َnwُrُṣnَy","root":"نصر"}],"hasIhya":false},{"ayah":193,"text":"وَإِن تَدْعُوهُمْ إِلَى ٱلْهُدَىٰ لَا يَتَّبِعُوكُمْۚ سَوَآءٌ عَلَيْكُمْ أَدَعَوْتُمُوهُمْ أَمْ أَنتُمْ صَٰمِتُونَ ","translation":"And if you [believers] invite them to guidance, they will not follow you. It is all the same for you whether you invite them or you are silent.","words":[{"id":1,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":2,"arabic":"تَدْعُوهُمْ","translit":"ْmُhwُʿعْdَt","root":"دعو"},{"id":3,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":4,"arabic":"ٱلْهُدَىٰ","translit":"ٰàَdُhْlٱ","root":"هدي"},{"id":5,"arabic":"لَا","translit":"āَl","root":""},{"id":6,"arabic":"يَتَّبِعُوكُمْ","translit":"ْmُkwُʿعِbَّtَy","root":"تبع"},{"id":7,"arabic":"سَوَآءٌ","translit":"ٌءٓāَwَs","root":"سوي"},{"id":8,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":9,"arabic":"أَدَعَوْتُمُوهُمْ","translit":"ْmُhwُmُtْwَʿعَdَaʾ","root":"دعو"},{"id":10,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":11,"arabic":"أَنتُمْ","translit":"ْmُtnَaʾ","root":""},{"id":12,"arabic":"صَٰمِتُونَ","translit":"َnwُtِmَٰṣ","root":"صمت"}],"hasIhya":false},{"ayah":194,"text":"إِنَّ ٱلَّذِينَ تَدْعُونَ مِن دُونِ ٱللَّهِ عِبَادٌ أَمْثَالُكُمْۖ فَٱدْعُوهُمْ فَلْيَسْتَجِيبُوا۟ لَكُمْ إِن كُنتُمْ صَٰدِقِينَ ","translation":"Indeed, those you [polytheists] call upon besides Allāh are servants [i.e., creations] like you. So call upon them and let them respond to you, if you should be truthful.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"تَدْعُونَ","translit":"َnwُʿعْdَt","root":"دعو"},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"دُونِ","translit":"ِnwُd","root":"دون"},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"عِبَادٌ","translit":"ٌdāَbِʿع","root":"عبد"},{"id":8,"arabic":"أَمْثَالُكُمْ","translit":"ْmُkُlāَhtْmَaʾ","root":"مثل"},{"id":9,"arabic":"فَٱدْعُوهُمْ","translit":"ْmُhwُʿعْdٱَf","root":"دعو"},{"id":10,"arabic":"فَلْيَسْتَجِيبُوا۟","translit":"۟āwُbyِjgَtْsَyْlَf","root":"جوب"},{"id":11,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":12,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":13,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":14,"arabic":"صَٰدِقِينَ","translit":"َnyِqِdَٰṣ","root":"صدق"}],"hasIhya":true},{"ayah":195,"text":"أَلَهُمْ أَرْجُلٌ يَمْشُونَ بِهَآۖ أَمْ لَهُمْ أَيْدٍ يَبْطِشُونَ بِهَآۖ أَمْ لَهُمْ أَعْيُنٌ يُبْصِرُونَ بِهَآۖ أَمْ لَهُمْ ءَاذَانٌ يَسْمَعُونَ بِهَاۗ قُلِ ٱدْعُوا۟ شُرَكَآءَكُمْ ثُمَّ كِيدُونِ فَلَا تُنظِرُونِ ","translation":"Do they have feet by which they walk? Or do they have hands by which they strike? Or do they have eyes by which they see? Or do they have ears by which they hear? Say, [O Muḥammad], \"Call your 'partners' and then conspire against me and give me no respite.","words":[{"id":1,"arabic":"أَلَهُمْ","translit":"ْmُhَlَaʾ","root":""},{"id":2,"arabic":"أَرْجُلٌ","translit":"ٌlُjgْrَaʾ","root":"رجل"},{"id":3,"arabic":"يَمْشُونَ","translit":"َnwُhsْmَy","root":"مشي"},{"id":4,"arabic":"بِهَآ","translit":"ٓāَhِb","root":""},{"id":5,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":6,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":7,"arabic":"أَيْدٍ","translit":"ٍdْyَaʾ","root":"يدي"},{"id":8,"arabic":"يَبْطِشُونَ","translit":"َnwُhsِṭْbَy","root":"بطش"},{"id":9,"arabic":"بِهَآ","translit":"ٓāَhِb","root":""},{"id":10,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":11,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":12,"arabic":"أَعْيُنٌ","translit":"ٌnُyْʿعَaʾ","root":"عين"},{"id":13,"arabic":"يُبْصِرُونَ","translit":"َnwُrِṣْbُy","root":"بصر"},{"id":14,"arabic":"بِهَآ","translit":"ٓāَhِb","root":""},{"id":15,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":16,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":17,"arabic":"ءَاذَانٌ","translit":"ٌnāَhdāَء","root":"اذن"},{"id":18,"arabic":"يَسْمَعُونَ","translit":"َnwُʿعَmْsَy","root":"سمع"},{"id":19,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":20,"arabic":"قُلِ","translit":"ِlُq","root":"قول"},{"id":21,"arabic":"ٱدْعُوا۟","translit":"۟āwُʿعْdٱ","root":"دعو"},{"id":22,"arabic":"شُرَكَآءَكُمْ","translit":"ْmُkَءٓāَkَrُhs","root":"شرك"},{"id":23,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":24,"arabic":"كِيدُونِ","translit":"ِnwُdyِk","root":"كيد"},{"id":25,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":26,"arabic":"تُنظِرُونِ","translit":"ِnwُrِẓnُt","root":"نظر"}],"hasIhya":false},{"ayah":196,"text":"إِنَّ وَلِۦِّىَ ٱللَّهُ ٱلَّذِى نَزَّلَ ٱلْكِتَٰبَۖ وَهُوَ يَتَوَلَّى ٱلصَّٰلِحِينَ ","translation":"Indeed, my protector is Allāh, who has sent down the Book; and He is an ally to the righteous.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"وَلِۦِّىَ","translit":"َàِّۦِlَw","root":"ولي"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":5,"arabic":"نَزَّلَ","translit":"َlَّzَn","root":"نزل"},{"id":6,"arabic":"ٱلْكِتَٰبَ","translit":"َbَٰtِkْlٱ","root":"كتب"},{"id":7,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":8,"arabic":"يَتَوَلَّى","translit":"àَّlَwَtَy","root":"ولي"},{"id":9,"arabic":"ٱلصَّٰلِحِينَ","translit":"َnyِḥِlَّٰṣlٱ","root":"صلح"}],"hasIhya":false},{"ayah":197,"text":"وَٱلَّذِينَ تَدْعُونَ مِن دُونِهِۦ لَا يَسْتَطِيعُونَ نَصْرَكُمْ وَلَآ أَنفُسَهُمْ يَنصُرُونَ ","translation":"And those you call upon besides Him are unable to help you, nor can they help themselves.\"","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"تَدْعُونَ","translit":"َnwُʿعْdَt","root":"دعو"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"دُونِهِۦ","translit":"ۦِhِnwُd","root":"دون"},{"id":5,"arabic":"لَا","translit":"āَl","root":""},{"id":6,"arabic":"يَسْتَطِيعُونَ","translit":"َnwُʿعyِṭَtْsَy","root":"طوع"},{"id":7,"arabic":"نَصْرَكُمْ","translit":"ْmُkَrْṣَn","root":"نصر"},{"id":8,"arabic":"وَلَآ","translit":"ٓāَlَw","root":""},{"id":9,"arabic":"أَنفُسَهُمْ","translit":"ْmُhَsُfnَaʾ","root":"نفس"},{"id":10,"arabic":"يَنصُرُونَ","translit":"َnwُrُṣnَy","root":"نصر"}],"hasIhya":false},{"ayah":198,"text":"وَإِن تَدْعُوهُمْ إِلَى ٱلْهُدَىٰ لَا يَسْمَعُوا۟ۖ وَتَرَىٰهُمْ يَنظُرُونَ إِلَيْكَ وَهُمْ لَا يُبْصِرُونَ ","translation":"And if you invite them to guidance, they do not hear; and you see them looking at you while they do not see.","words":[{"id":1,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":2,"arabic":"تَدْعُوهُمْ","translit":"ْmُhwُʿعْdَt","root":"دعو"},{"id":3,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":4,"arabic":"ٱلْهُدَىٰ","translit":"ٰàَdُhْlٱ","root":"هدي"},{"id":5,"arabic":"لَا","translit":"āَl","root":""},{"id":6,"arabic":"يَسْمَعُوا۟","translit":"۟āwُʿعَmْsَy","root":"سمع"},{"id":7,"arabic":"وَتَرَىٰهُمْ","translit":"ْmُhٰàَrَtَw","root":"راي"},{"id":8,"arabic":"يَنظُرُونَ","translit":"َnwُrُẓnَy","root":"نظر"},{"id":9,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":10,"arabic":"وَهُمْ","translit":"ْmُhَw","root":""},{"id":11,"arabic":"لَا","translit":"āَl","root":""},{"id":12,"arabic":"يُبْصِرُونَ","translit":"َnwُrِṣْbُy","root":"بصر"}],"hasIhya":false},{"ayah":199,"text":"خُذِ ٱلْعَفْوَ وَأْمُرْ بِٱلْعُرْفِ وَأَعْرِضْ عَنِ ٱلْجَٰهِلِينَ ","translation":"Take what is given freely,[1] enjoin what is good, and turn away from the ignorant.","words":[{"id":1,"arabic":"خُذِ","translit":"ِhdُhk","root":"اخذ"},{"id":2,"arabic":"ٱلْعَفْوَ","translit":"َwْfَʿعْlٱ","root":"عفو"},{"id":3,"arabic":"وَأْمُرْ","translit":"ْrُmْaʾَw","root":"امر"},{"id":4,"arabic":"بِٱلْعُرْفِ","translit":"ِfْrُʿعْlٱِb","root":"عرف"},{"id":5,"arabic":"وَأَعْرِضْ","translit":"ْḍِrْʿعَaʾَw","root":"عرض"},{"id":6,"arabic":"عَنِ","translit":"ِnَʿع","root":""},{"id":7,"arabic":"ٱلْجَٰهِلِينَ","translit":"َnyِlِhَٰjgْlٱ","root":"جهل"}],"hasIhya":true},{"ayah":200,"text":"وَإِمَّا يَنزَغَنَّكَ مِنَ ٱلشَّيْطَٰنِ نَزْغٌ فَٱسْتَعِذْ بِٱللَّهِۚ إِنَّهُۥ سَمِيعٌ عَلِيمٌ ","translation":"And if an evil suggestion comes to you from Satan, then seek refuge in Allāh. Indeed, He is Hearing and Knowing.","words":[{"id":1,"arabic":"وَإِمَّا","translit":"āَّmِiʾَw","root":""},{"id":2,"arabic":"يَنزَغَنَّكَ","translit":"َkَّnَغَznَy","root":"نزغ"},{"id":3,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":4,"arabic":"ٱلشَّيْطَٰنِ","translit":"ِnَٰṭْyَّhslٱ","root":"شطن"},{"id":5,"arabic":"نَزْغٌ","translit":"ٌغْzَn","root":"نزغ"},{"id":6,"arabic":"فَٱسْتَعِذْ","translit":"ْhdِʿعَtْsٱَf","root":"عوذ"},{"id":7,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":8,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":9,"arabic":"سَمِيعٌ","translit":"ٌʿعyِmَs","root":"سمع"},{"id":10,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"}],"hasIhya":true},{"ayah":201,"text":"إِنَّ ٱلَّذِينَ ٱتَّقَوْا۟ إِذَا مَسَّهُمْ طَٰٓئِفٌ مِّنَ ٱلشَّيْطَٰنِ تَذَكَّرُوا۟ فَإِذَا هُم مُّبْصِرُونَ ","translation":"Indeed, those who fear Allāh - when an impulse touches them from Satan, they remember [Him] and at once they have insight.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ٱتَّقَوْا۟","translit":"۟āْwَqَّtٱ","root":"وقي"},{"id":4,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":5,"arabic":"مَسَّهُمْ","translit":"ْmُhَّsَm","root":"مسس"},{"id":6,"arabic":"طَٰٓئِفٌ","translit":"ٌfِyʾَٰٓṭ","root":"طوف"},{"id":7,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":8,"arabic":"ٱلشَّيْطَٰنِ","translit":"ِnَٰṭْyَّhslٱ","root":"شطن"},{"id":9,"arabic":"تَذَكَّرُوا۟","translit":"۟āwُrَّkَhdَt","root":"ذكر"},{"id":10,"arabic":"فَإِذَا","translit":"āَhdِiʾَf","root":""},{"id":11,"arabic":"هُم","translit":"mُh","root":""},{"id":12,"arabic":"مُّبْصِرُونَ","translit":"َnwُrِṣْbُّm","root":"بصر"}],"hasIhya":true},{"ayah":202,"text":"وَإِخْوَٰنُهُمْ يَمُدُّونَهُمْ فِى ٱلْغَىِّ ثُمَّ لَا يُقْصِرُونَ ","translation":"But their brothers[1] - they [i.e., the devils] increase them in error; then they do not stop short.","words":[{"id":1,"arabic":"وَإِخْوَٰنُهُمْ","translit":"ْmُhُnَٰwْhkِiʾَw","root":"اخو"},{"id":2,"arabic":"يَمُدُّونَهُمْ","translit":"ْmُhَnwُّdُmَy","root":"مدد"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلْغَىِّ","translit":"ِّàَغْlٱ","root":"غوي"},{"id":5,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":6,"arabic":"لَا","translit":"āَl","root":""},{"id":7,"arabic":"يُقْصِرُونَ","translit":"َnwُrِṣْqُy","root":"قصر"}],"hasIhya":false},{"ayah":203,"text":"وَإِذَا لَمْ تَأْتِهِم بِـَٔايَةٍ قَالُوا۟ لَوْلَا ٱجْتَبَيْتَهَاۚ قُلْ إِنَّمَآ أَتَّبِعُ مَا يُوحَىٰٓ إِلَىَّ مِن رَّبِّىۚ هَٰذَا بَصَآئِرُ مِن رَّبِّكُمْ وَهُدًى وَرَحْمَةٌ لِّقَوْمٍ يُؤْمِنُونَ ","translation":"And when you, [O Muḥammad], do not bring them a sign [i.e., miracle], they say, \"Why have you not contrived it?\" Say, \"I only follow what is revealed to me from my Lord. This [Qur’ān] is enlightenment from your Lord and guidance and mercy for a people who believe.\"","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":3,"arabic":"تَأْتِهِم","translit":"mِhِtْaʾَt","root":"اتي"},{"id":4,"arabic":"بِـَٔايَةٍ","translit":"ٍẗَyāَٔـِb","root":"ايي"},{"id":5,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":6,"arabic":"لَوْلَا","translit":"āَlْwَl","root":""},{"id":7,"arabic":"ٱجْتَبَيْتَهَا","translit":"āَhَtْyَbَtْjgٱ","root":"جبي"},{"id":8,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":9,"arabic":"إِنَّمَآ","translit":"ٓāَmَّnِiʾ","root":""},{"id":10,"arabic":"أَتَّبِعُ","translit":"ُʿعِbَّtَaʾ","root":"تبع"},{"id":11,"arabic":"مَا","translit":"āَm","root":""},{"id":12,"arabic":"يُوحَىٰٓ","translit":"ٰٓàَḥwُy","root":"وحي"},{"id":13,"arabic":"إِلَىَّ","translit":"َّàَlِiʾ","root":""},{"id":14,"arabic":"مِن","translit":"nِm","root":""},{"id":15,"arabic":"رَّبِّى","translit":"àِّbَّr","root":"ربب"},{"id":16,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":17,"arabic":"بَصَآئِرُ","translit":"ُrِyʾٓāَṣَb","root":"بصر"},{"id":18,"arabic":"مِن","translit":"nِm","root":""},{"id":19,"arabic":"رَّبِّكُمْ","translit":"ْmُkِّbَّr","root":"ربب"},{"id":20,"arabic":"وَهُدًى","translit":"àًdُhَw","root":"هدي"},{"id":21,"arabic":"وَرَحْمَةٌ","translit":"ٌẗَmْḥَrَw","root":"رحم"},{"id":22,"arabic":"لِّقَوْمٍ","translit":"ٍmْwَqِّl","root":"قوم"},{"id":23,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"}],"hasIhya":false},{"ayah":204,"text":"وَإِذَا قُرِئَ ٱلْقُرْءَانُ فَٱسْتَمِعُوا۟ لَهُۥ وَأَنصِتُوا۟ لَعَلَّكُمْ تُرْحَمُونَ ","translation":"So when the Qur’ān is recited, then listen to it and pay attention that you may receive mercy.","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"قُرِئَ","translit":"َyʾِrُq","root":"قرا"},{"id":3,"arabic":"ٱلْقُرْءَانُ","translit":"ُnāَءْrُqْlٱ","root":"قرا"},{"id":4,"arabic":"فَٱسْتَمِعُوا۟","translit":"۟āwُʿعِmَtْsٱَf","root":"سمع"},{"id":5,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":6,"arabic":"وَأَنصِتُوا۟","translit":"۟āwُtِṣnَaʾَw","root":"نصت"},{"id":7,"arabic":"لَعَلَّكُمْ","translit":"ْmُkَّlَʿعَl","root":""},{"id":8,"arabic":"تُرْحَمُونَ","translit":"َnwُmَḥْrُt","root":"رحم"}],"hasIhya":false},{"ayah":205,"text":"وَٱذْكُر رَّبَّكَ فِى نَفْسِكَ تَضَرُّعًا وَخِيفَةً وَدُونَ ٱلْجَهْرِ مِنَ ٱلْقَوْلِ بِٱلْغُدُوِّ وَٱلْءَاصَالِ وَلَا تَكُن مِّنَ ٱلْغَٰفِلِينَ ","translation":"And remember your Lord within yourself in humility and in fear without being apparent in speech - in the mornings and the evenings. And do not be among the heedless.","words":[{"id":1,"arabic":"وَٱذْكُر","translit":"rُkْhdٱَw","root":"ذكر"},{"id":2,"arabic":"رَّبَّكَ","translit":"َkَّbَّr","root":"ربب"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"نَفْسِكَ","translit":"َkِsْfَn","root":"نفس"},{"id":5,"arabic":"تَضَرُّعًا","translit":"āًʿعُّrَḍَt","root":"ضرع"},{"id":6,"arabic":"وَخِيفَةً","translit":"ًẗَfyِhkَw","root":"خوف"},{"id":7,"arabic":"وَدُونَ","translit":"َnwُdَw","root":"دون"},{"id":8,"arabic":"ٱلْجَهْرِ","translit":"ِrْhَjgْlٱ","root":"جهر"},{"id":9,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":10,"arabic":"ٱلْقَوْلِ","translit":"ِlْwَqْlٱ","root":"قول"},{"id":11,"arabic":"بِٱلْغُدُوِّ","translit":"ِّwُdُغْlٱِb","root":"غدو"},{"id":12,"arabic":"وَٱلْءَاصَالِ","translit":"ِlāَṣāَءْlٱَw","root":"اصل"},{"id":13,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":14,"arabic":"تَكُن","translit":"nُkَt","root":"كون"},{"id":15,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":16,"arabic":"ٱلْغَٰفِلِينَ","translit":"َnyِlِfَٰغْlٱ","root":"غفل"}],"hasIhya":true},{"ayah":206,"text":"إِنَّ ٱلَّذِينَ عِندَ رَبِّكَ لَا يَسْتَكْبِرُونَ عَنْ عِبَادَتِهِۦ وَيُسَبِّحُونَهُۥ وَلَهُۥ يَسْجُدُونَ۩ ","translation":"Indeed, those who are near your Lord [i.e., the angels] are not prevented by arrogance from His worship, and they exalt Him, and to Him they prostrate.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":4,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":5,"arabic":"لَا","translit":"āَl","root":""},{"id":6,"arabic":"يَسْتَكْبِرُونَ","translit":"َnwُrِbْkَtْsَy","root":"كبر"},{"id":7,"arabic":"عَنْ","translit":"ْnَʿع","root":""},{"id":8,"arabic":"عِبَادَتِهِۦ","translit":"ۦِhِtَdāَbِʿع","root":"عبد"},{"id":9,"arabic":"وَيُسَبِّحُونَهُۥ","translit":"ۥُhَnwُḥِّbَsُyَw","root":"سبح"},{"id":10,"arabic":"وَلَهُۥ","translit":"ۥُhَlَw","root":""},{"id":11,"arabic":"يَسْجُدُونَ","translit":"َnwُdُjgْsَy","root":"سجد"}],"hasIhya":false}],"tafsir":{"6":[{"arabic":"وعند ذلك يصدق الله تعالى قوله {فلنسألن الذين أرسل إليهم ولنسألن المرسلين فلنقصن عليهم بعلم وما كنا غائبين} وقوله {فوربك لنسألنهم أجمعين عما كانوا يعملون} فيبدأ سبحانه بالأنبياء {يوم يجمع الله الرسل فيقول}","english":"Then reflect, O wretched one, after these states upon what is directed against you of the questioning — face to face, without any interpreter — and you shall be asked concerning the little and the much, the speck on a date-stone (al-naqīr) and the husk (al-qitmīr). For while you are amidst the distress of the Resurrection, its sweat, and the severity of its terrors, lo! the angels descend from the horizons of the heaven with immense bodies and gigantic forms — harsh, severe — commanded to seize the forelocks of the criminals and drag them to the standing-place of presentation (mawqif al-ʿarḍ) before the Omnipotent (al-Jabbār). The Messenger of Allah, may Allah bless him and grant him peace, said: \"Verily, Allah, Mighty and Majestic, has an angel between whose two eyelids is a distance of a hundred years' journey.\" So what is your assumption concerning yourself when you behold the likes of these angels — dispatched unto you to seize you and bring you to the station of presentation — and you see them, despite the enormity of their forms, broken in humility before the severity of that Day, filled with dread at what has become manifest of the Omnipotent's wrath upon His servants? And at their descent, there remains no prophet, no veracious one (ṣiddīq), no righteous soul, save that they fall upon their chins in fear, lest they themselves be the seized ones. Such is the state of those brought near (al-muqarrabūn) — so what is your assumption concerning the disobedient criminals?","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1340","section_title_en":"The Description of the Day of Resurrection, Its Calamities, and Its Names — The Description of the Questioning","section_index":1340,"anchors":"- Root: س-أ-ل (sa-ʾa-la)\n  * Lisan / Ayn: Core root denotes seeking, demanding, or interrogating; al-suʾāl is the act of asking, and musāʾalah implies reciprocal or formal interrogation.\n  * Al-Raghib (Mufradat): In theological context, al-suʾāl on the Day of Resurrection is a divine inquest (musāʾalah) demanding account of deeds, not for God's knowledge (as He is 'alīm) but for establishing proof (ḥujjah) against the creature.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage is verbal inquiry; metaphorical (majāz) extends to the juridical reckoning (muḥāsabah) where the tongue is made to testify without intermediary.\n- Root: ن-ز-ل (na-za-la)\n  * Lisan / Ayn: Core root signifies descent from a height; nuzūl is the act of alighting.\n  * Al-Raghib (Mufradat): When predicated of angels, it denotes their dispatch from the celestial realm to execute divine command — a descent of authority, not spatial movement in the divine essence.\n  * Al-Zamakhshari (Asas): Literal: physical descent; metaphorical: the advent of divine decree or angelic execution of wrath.\n- Root: ع-ر-ض (ʿa-ra-ḍa)\n  * Lisan / Ayn: Core root means to present, expose, or show; al-ʿarḍ is the exhibition of something before a viewer.\n  * Al-Raghib (Mufradat): In eschatological usage, mawqif al-ʿarḍ is the standing-place of presentation before God for judgment — a public display of deeds.\n  * Al-Zamakhshari (Asas): Literal: to show; metaphorical: the juridical tribunal of the Hereafter where all acts are exhibited.\n- Sibawayh Rule: Rule of Interrogative Scope (Bāb al-istifhām) — The rhetorical question \"فما ظنك\" (so what is your assumption?) functions as a periodic pause, redirecting the addressee's cognition from narrated events to self-projection, governed by the conditional-temporal particle \"إذ\" (when) that binds the apodosis to the protasis.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'","badge":"Hadith"}],"8":[{"arabic":"القيامة وقال تعالى فمن ثقلت موازينه فأولئك هم المفلحون ومن خفت موازينه الآية ووجهها أن الله تعالى يحدث في صحائف الأعمال وزنا بحسب درجات الأعمال عند الله تعالى فتصير مقادير أعمال العباد معلومة للعباد حتى يظهر لهم العدل في العقاب أو الفضل في العفو وتضعيف الثواب الأصل الخامس الصراط وهو جسر ممدود على متن جهنم أرق من الشعرة وأحد من السيف قال الله تعالى فاهدوهم إلى صراط الجحيم وقفوهم إنهم مسئولون وهذا ممكن فيجب التصديق به فإن القادر على أن يطير الطير في الهواء قادر على أن يسير الإنسان على الصراط الأصل السا","english":"For they, despite their distinction in eloquence and rhetorical perfection, aimed at reviling him, forbidding him, killing him, and expelling him — as God, Mighty and Majestic, informed us about them — yet they were unable to produce anything to rival the Qur'an. For it was not within the capacity of human beings to combine the grandeur of the Qur'an's diction with its harmonious order, especially given what it contains of the accounts of the ancients, while he was illiterate, never having practiced the study of books — and [given] its announcement of the unseen in matters whose truthfulness was verified in the future, such as His saying, Exalted is He: {«لَتَدْخُلُنَّ الْمَسْجِدَ الْحَرَامَ إِنْ شَاءَ اللَّهُ آمِنِينَ مُحَلِّقِينَ رُءُوسَكُمْ وَمُقَصِّرِينَ»} (You shall surely enter the Sacred Mosque, if God wills, secure, with your heads shaved and cut short) [Al-Fatḥ 48:27], and such as His saying: {«الم غُلِبَتِ الرُّومُ فِي أَدْنَى الْأَرْضِ وَهُمْ مِنْ بَعْدِ غَلَبِهِمْ سَيَغْلِبُونَ فِي بِضْعِ سِنِينَ»} (Alif Lām Mīm. The Romans have been defeated in the nearest land, and they, after their defeat, shall be victorious within a few years) [Al-Rūm 30:1-3].","book_title":"Foundations of Belief","section_title_ar":"Section 96","section_title_en":"The Fourth Pillar: On Matters of Hearing (al-Samʿiyyāt) and the Verification of the Prophet ﷺ in What He Reported — Comprising Ten Fundamental Principles","section_index":96,"anchors":"- Root: حشر (ḥ-sh-r)\n  * Lisan / Ayn: To gather, assemble, drive together; al-ḥashr is the gathering of creation on the Day of Resurrection.\n  * Al-Raghib (Mufradat): Al-ḥashr is the bringing together of a people from their various places of dispersal; it is used specifically for the resurrection gathering.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for driving cattle together; metaphorical (majāz) for the ingathering of souls for judgment.\n- Sibawayh Rule: Rule of Conditional Protasis (al-sharṭ) — \"If you are truthful, then rise...\" (fa-in kunta ṣādiqan fa-qum...) — the apodosis (jawāb al-sharṭ) functions as the proof of the protasis, establishing necessary knowledge (ʿilm ḍarūrī).\n\n- Root: نشر (n-sh-r)\n  * Lisan / Ayn: To spread, unfold, revive after death; al-nushūr is the revivification of the dead.\n  * Al-Raghib (Mufradat): Al-nashr is the spreading of the soul back into the body after death; it is the opposite of al-ṭayy (folding up).\n  * Al-Zamakhshari (Asas): Literal for unfolding a garment; metaphorical for the resurrection when the earth \"spreads forth\" what it contains.\n- Sibawayh Rule: Rule of Coordination (al-ʿaṭf) — \"al-ḥashr wa-l-nashr\" (the gathering and the spreading) — two coordinated nouns forming a single compound concept of resurrection.\n\n- Root: مكن (m-k-n)\n  * Lisan / Ayn: To establish, empower, give firm footing; makkana means to make something firm and stable.\n  * Al-Raghib (Mufradat): Al-makān is the place that contains a thing; tamakkun is the firm establishment of a thing in its place.\n  * Al-Zamakhshari (Asas): Literal for physical placement; metaphorical for divine power — \"God is able\" (qādir) means He has full capacity and authority over all things.\n- Sibawayh Rule: Rule of Possibility (al-imkān) — \"that is possible\" (dhālika mumkin) — the predicate of possibility is established by the absence of logical contradiction, not by empirical observation.\n\n- Root: عذب (ʿ-dh-b)\n  * Lisan / Ayn: Sweet, pleasant (of water); al-ʿadhāb is the punishment that is \"sweet\" to the inflictor but bitter to the recipient — used predominantly for divine chastisement.\n  * Al-Raghib (Mufradat): Al-ʿadhāb is the infliction of pain that deters; it is specifically the painful consequence of disobedience.\n  * Al-Zamakhshari (Asas): Literal for sweet water; metaphorical (majāz) for punishment that is \"appointed\" as a deterrent.\n- Sibawayh Rule: Rule of Exception (al-istithnāʾ) — \"except as God wills\" (illā mā shāʾa) — the exception clause restricts the scope of human perception, not divine action.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Foundations of Belief'","badge":"Afterlife"}],"10":[{"arabic":"وقال تعالى وجعلنا لكم فيها معايش قليلا ما تشكرون فجعلها ربك نعمة وطلب الشكر عليها وقال تعالى ليس عليكم جناح أن تبتغوا فضلا من ربكم وقال تعالى وآخرون يضربون في الأرض يبتغون من فضل الله وقال تعالى فانتشروا في الأرض وابتغوا من فضل الله وأما الأخبار فقد قال صلى الله عليه وسلم من الذنوب ذنوب لا يكفرها إلا الهم في طلب المعيشة (1) وقال صلى الله عليه وسلم التاجر الصدوق يحشر يوم القيامة مع الصديقين والشهداء (2) وقال صلى الله عليه وسلم من طلب الدنيا حلالا وتعففا عن المسئلة وسعيا على عياله وتعطفا","english":"As for what is [cited] from the Book [i.e., the Qur'an], there is His saying, the Exalted: «{وَجَعَلْنَا النَّهَارَ مَعَاشًا}» (\"And We have made the day a means of livelihood\" [al-Naba' 78:11]) — and He mentioned it in the context of bestowing favor (imtinān).","book_title":"Etiquette of Earning","section_title_ar":"Section 312","section_title_en":"Section 312","section_index":312,"anchors":"*(Anchors established)*","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Earning'","badge":"Insight"}],"12":[{"arabic":"فمن استفزته نار الغضب فقد قويت فيه قرابة الشيطان حيث قال {خلقتني من نار وخلقته من طين} فإن شأن الطين السكون والوقار وشأن النار التلظي والاستعار والحركة والاضطراب ومن نتائج الغضب الحقد والحسد وبهما هلك من هلك وفسد من فسد ومفيضهما مضغة إذا صلحت صلح معها سائر الجسد وإذا كان الحقد والحسد والغضب مما يسوق العبد إلى مواطن العطب فما أحوجه إلى معرفة معاطبه ومساويه ليحذر ذلك ويتقيه ويميطه عن القلب إن كان وينفيه ويعالجه إن رسخ في قلبه ويداويه فإن من لا يعرف الشر يقع فيه ومن عرفه فالمعرفة لا تكفيه ما لم يعرف الطريق الذي به يدفع الشر ويقصيه و","english":"In the name of God, the Most Merciful, the Most Compassionate. Praise be to God, upon whose pardon and mercy none rely except the hopeful, and from whose evil wrath and assault none fear except the fearful — He who gradually seizes His servants from whence they know not, and who has given dominion over them to their lusts, commanding them to abandon what they desire, and who has tried them with anger while charging them to swallow their rage in what provokes them. Then He surrounded them with hardships and pleasures, and granted them respite to see how they would act. He tested their love through them, to make known the truth of what they claim. He made known to them that nothing is hidden from Him of what they conceal or proclaim, and warned them lest He seize them suddenly while they are unaware. For He said: {«They await but a single blast which will seize them while they are disputing; so they will not be able to make a bequest, nor to their families will they return»} (Q. 36:49-50). And prayers and peace be upon Muhammad, His Messenger, beneath whose banner the prophets walk, and upon his family and companions — the rightly-guided imams and the pleasing masters — prayers whose number equals the number of what has been of God's creation and what will be, and by whose blessing the first and the last are favored — and abundant peace.","book_title":"Patience and Gratitude","section_title_ar":"Section 700","section_title_en":"The Book of Condemnation of Anger, Spite, and Envy — Book Five of the Quarter of Destroyers from The Revival of the Religious Sciences","section_index":700,"anchors":"- Root: غضب (ghadab)\n  * Lisan / Ayn: Core root meaning of anger, rage, fury; the boiling and agitation of the blood\n  * Al-Raghib (Mufradat): Theological nuance — when attributed to God, it means retribution (intiqām) alone, not emotional agitation; the Prophet described it as \"a live coal kindled in the heart of the son of Adam\"\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal anger is the boiling of the blood in living beings; metaphorical usage extends to inanimate things like fire and the reins of a mount\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart; also the turning, overturning, and transformation of a thing from one state to another\n  * Al-Raghib (Mufradat): Theological nuance — the heart is so named for its constant turning (taqallub) and fluctuation between states; it is the seat of understanding and the locus of divine address\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal is the physical organ; metaphorical is the subtle spiritual reality (laṭīfah rabbāniyyah) that is the locus of knowledge and will\n- Root: حسد (hasad)\n  * Lisan / Ayn: Envy; the wishing for removal of another's blessing\n  * Al-Raghib (Mufradat): Theological nuance — envy is the desire for the removal of a blessing from one who deserves it, sometimes accompanied by striving to remove it; the believer envies (ghibṭah) while the hypocrite envies (hasad)\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — \"Envy consumes the body as fire consumes wood\"; the envier is one who wishes evil upon the blessed\n- Root: هلك (halak)\n  * Lisan / Ayn: Perdition, destruction, ruin; death\n  * Al-Raghib (Mufradat): Theological nuance — three senses: (1) loss of a thing from one's possession while it exists elsewhere, (2) corruption and dissolution of a thing, (3) death; the Quran uses it for all three\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal is physical destruction; metaphorical is the ruin of one's religion and afterlife through spiritual corruption\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening material constitutes a complete, meaningful unit, as in the Quranic pattern of extended periodic sentences that delay resolution for rhetorical effect.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Patience and Gratitude'","badge":"Ethics"},{"arabic":"وهذه أقيسة فاسدة تشبه قياس إبليس حيث قال {أنا خير منه خلقتني من نار وخلقته من طين} وإلى هؤلاء الإشارة بقوله تعالى {أولئك الذين اشتروا الحياة الدنيا بالآخرة فلا يخفف عنهم العذاب ولا هم ينصرون} وعلاج هذا الغرور إما بتصديق الإيمان وإما بالبرهان أما التصديق بمجرد الإيمان فهو أن يصدق الله تعالى في قوله ما عندكم ينفذ وما عند الله باق وفي قوله عز وجل {وما عند الله خير} وقوله {والآخرة خير وأبقى} وقوله {وما الحياة الدنيا إلا متاع الغرور} وقوله {فلا تغرنكم الحياة الدنيا} وقد أخبر رسول الله صلى الله عليه وسلم بذلك طوائف من الكفار فقلدوه وصدقوه","english":"Know that the saying of God Most High — {«fa-lā taghurrannakum al-ḥayātu al-dunyā wa-lā yaghurrannakum billāhi al-gharūr»} (So let not the life of this world deceive you, nor let the Deceiver deceive you concerning God) — and His saying — {«wa-lākinnakum fatantum anfusakum wa-tarabbastum wa-irtabtum wa-gharratkum al-amānī»} (But ye tempted your own souls, and ye waited, and ye doubted, and vain desires deceived you) — is sufficient for the blameworthiness of self-deception (al-ghurūr). And the Messenger of God, may God's peace and blessing be upon him, has said: \"How excellent is the sleep of the intelligent and their breaking of the fast! How they outwit the wakefulness of the foolish and their striving! And verily a mustard-seed's weight [of faith] from a possessor of piety and certainty is better than the earth filled with the self-deceived.\" And the ḥadīth: \"The intelligent man (al-kayyis) is he who takes account of his own soul and works for what is after death\" — this ḥadīth was transmitted by al-Tirmidhī and Ibn Mājah from the ḥadīth of Shaddād ibn Aws.","book_title":"Condemnation of Delusion","section_title_ar":"Section 884","section_title_en":"Exposition of the Blameworthiness of Self-Deception (Al-Ghurūr), Its Reality, and Its Examples","section_index":884,"anchors":"- Root: غرر (Gh-R-R)\n  * Lisan / Ayn: The core meaning is \"an apparent trace or mark of a thing\" (al-athar al-ẓāhir), from which derives \"the blaze of a horse\" (ghurrat al-faras). To deceive (gharra) is to strike one's heedlessness (ghirrah) and attain one's sought desire from him, as if folding a garment upon its original crease (ṭawāhu ʿalā gharrihi).\n  * Al-Raghib (Mufradat): \"Ghurrah is heedlessness in wakefulness, and ghirār is heedlessness with drowsiness.\" Theologically, it is the soul's repose upon a false semblance (shubhah) that pleases the caprice (hawā), rendering one oblivious to the true state of affairs—as in {«mā gharraka bi-rabbika al-karīm»} (What deceived thee concerning thy Generous Lord?).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"A gazelle in a moonlit night is called agharr\" because it ventures out thinking it is day and is devoured by beasts—heedlessness in perception. Metaphorical (majāz): \"A day agharr muḥajjal\" (a white-browed, white-legged day) for intense heat, transferring the blaze of a horse to the day's visible intensity.\n- Root: جهل (J-H-L)\n  * Lisan / Ayn: \"Jahila bihi\" — to be ignorant of it; \"jāhala ʿalā qawmihi\" — to act foolishly/insolently against one's people. The pre-Islamic era is \"al-jāhiliyyah al-jahlā'\" (the utterly ignorant age).\n  * Al-Raghib (Mufradat): Ignorance (jahl) is of three kinds: (1) the soul's emptiness of knowledge (this is the root); (2) believing a thing contrary to what it is; (3) doing a thing contrary to what it ought to be, whether one's belief is sound or corrupt. Ghurūr is a species of the second kind—a false belief arising from a corrupt semblance.\n  * Al-Zamakhshari (Asas): Literal: \"Kafā bil-shakki jahlā\" (Sufficient is doubt as ignorance). Metaphorical: \"Istajhalat al-rīḥ al-ghuṣn\" (The wind made the branch sway violently) — transferred from mental foolishness to physical agitation.\n- Root: حدث (Ḥ-D-TH)\n  * Lisan / Ayn: \"Al-ḥudūth: the coming-to-be of a thing after it was not.\" \"Al-ḥadath: the novel event.\" \"Ḥaddatha: to speak/communicate.\"\n  * Al-Raghib (Mufradat): \"Ḥudūth is the existence of a thing after non-existence, whether accident or substance. Iḥdāth is bringing it into existence. The iḥdāth of substances belongs to God alone.\" The \"ḥadīth\" (report/speech) is so-called for its temporal novelty.\n  * Al-Zamakhshari (Asas): Literal: \"Nazalat bihi ḥawādith al-dahr\" (The vicissitudes of time befell him). Metaphorical: \"Kāna ʿUmar muḥaddathan\" (Umar was one inspired with true discernment) — as if he were spoken to (ḥudditha) by what he conjectured.\n- Root: دنا (D-N-W)\n  * Lisan / Ayn: \"Danā fa-huwa dānin\" — he drew near. \"Al-dunyā\" (the lower world) is so named because it is nearer (danat) and precedes the Hereafter.\n  * Al-Raghib (Mufradat): \"Al-dunūw: proximity by essence or by judgment, used of place, time, and station.\" The \"adnā\" (lower/nearer) is contrasted with the greater and with the better: {«a-tastabdilūna alladhī huwa adnā billadhī huwa khayr»} (Will ye take the lower in exchange for what is better?).\n  * Al-Zamakhshari (Asas): Literal: \"Huwa danī' min al-adniyā'\" (He is base, of the base ones) — but this is the homonym danu'a (baseness), distinct from danā (nearness). The dunyā's \"nearness\" is its temporal immediacy versus the Hereafter's deferral.\n- Sibawayh Rule: Bab al-faṣl bayna al-jār wa-al-majrūr (Prepositional Interposition) — The particle \"bi\" in {«wa-lā yaghurrannakum billāhi al-gharūr»} governs the deceiver (al-gharūr) as the agent of deception, while \"billāh\" (concerning God) is the object of the deception. The syntactic structure permits the deceiver to be named after the prepositional phrase, indicating that the deception is *about* God's attributes (His forbearance, His respite) — a grammatical subtlety showing the ghurūr deceives *by means of* false notions of God, not that God Himself deceives.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Delusion'","badge":"Afterlife"}],"15":[{"arabic":"لعنه الله إذ قال رب فانظرني إلى يوم يبعثون قال إنك من المنظرين الثامن أن يلح في الدعاء ويكرره ثلاثا قال ابن مسعود كان صلى الله عليه وسلم إذا دعا دعا ثلاثا وإذا سال سأل ثلاثا (1) وينبغي أن لا يستبطىء الإجابة لقوله صلى الله عليه وسلم يستجاب لأحدكم ما لم يعجل فيقول قد دعوت فلم يستجب لي فإذا دعوت فاسأل الله كثيرا فإنك تدعو كريما (2) وقال بعضهم إني أسأل الله عز وجل منذ عشرين سنة حاجة وما أجابني وأنا أرجو الإجابة سألت الله تعالى أن يوفقني لترك ما لا يعنيني وقال صلى الله عليه وسلم","english":"[Root: دعو]\n  • Lisan al-Arab: \"الدعاء: الرغبة إلى الله تعالى، والابتهال في المسألة. والدعوة: الكلمة التي يدعو بها. وأصل الدعاء: طلب الإقبال من الغير.\"\n  • Al-Raghib (Mufradat): \"الدعاء: ضربان: أحدهما دعاء العبادة، والآخر دعاء المسألة. فدعاء العبادة: هو توجه العبد إلى الله تعالى بالطاعة. ودعاء المسألة: طلب الحاجة من الله تعالى. قال تعالى: {وقال ربكم ادعوني أستجب لكم}.\"\n  • Al-Zamakhshari (Asas - Haqiqah/Literal): \"دعا فلان ربه: ابتهل إليه بالسؤال. ودعا الله: عبده. ومنه قوله تعالى: {إن الذين يستكبرون عن عبادتي} أي عن دعائي.\"\n  • Al-Zamakhshari (Asas - Majaz/Metaphorical): \"دعا عليه: سأل الله أن يصيبه بمكروه. ودعا له: سأل الله أن يحسن إليه. ومن المجاز: دعا الأمر إلى كذا، أي أدى إليه.\"","book_title":"On Invocations and Supplications","section_title_ar":"Section 242","section_title_en":"Section 242","section_index":242,"anchors":"*(Anchors established)*","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'On Invocations and Supplications'","badge":"Afterlife"}],"16":[{"arabic":"الشهوات للقلب من جوانبه قال الله تعالى إخبارا عن إبليس لأقعدن لهم صراطك المستقيم ثم لآتينهم من بين أيديهم ومن خلفهم وعن أيمانهم وعن شمائلهم وقال صلى الله عليه وسلم إن الشيطان قعد لابن آدم بطرق فقعد له بطريق الإسلام فقال أتسلم وتترك دينك ودين آبائك فعصاه وأسلم ثم قعد له بطريق الهجرة فقال أتهاجر أتدع أرضك وسمائك فعصاه وهاجر هو قعد له بطريق الجهاد فقال أتجاهد وهو تلف النفس والمال فتقاتل فتقتل فتنكح نساؤك ويقسم مالك فعصاه وجاهد (2) حديث ما من أحد إلا له شيطان الحديث تقدم فقد اتضح بهذا النوع من الاستبصار معنى الوسوسة والإلهام والملك والشيطان والتوفيق والخذلان فبعد هذا نظر من ينظر في ذات ا","english":"He said — and by my father, a face that will not prosper (1) — the hadith that Satan runs through the son of Adam like the running of blood has already been mentioned. That is because hunger breaks the appetite, and the course of Satan is through the appetites. And because the appetites surround the heart from all its sides, God—exalted is He—said, informing of Iblis: {«I will surely sit in wait for them on Your straight path. Then I will come to them from before them and from behind them and from their right and from their left»} (7:16-17). And he—peace and blessings be upon him—said: \"Verily, Satan sat in wait for the son of Adam on his paths. He sat for him on the path of Islam and said: 'Will you submit and abandon your religion and the religion of your forefathers?' But he disobeyed him and submitted. Then he sat for him on the path of emigration (hijrah) and said: 'Will you emigrate and abandon your land and your sky?' But he disobeyed him and emigrated. Then he sat for him on the path of jihad and said: 'Will you strive? For it is the destruction of the soul and wealth — you will fight and be killed, your women will be married and your wealth divided.' But he disobeyed him and strove.\" (2) The hadith \"There is no one among you except that he has a companion from the jinn\" has already been mentioned.","book_title":"Disciplining the Soul","section_title_ar":"Section 598","section_title_en":"The Revival of the Religious Sciences — Section 598: On the Whisperings of Satan, the Divine Subtleties, and the Means of Defense","section_index":598,"anchors":"- Root: شيط (Shayṭ)\n  * Lisan / Ayn: Core meaning of burning, scorching, or being consumed by fire; also one who is destroyed or perishes.\n  * Al-Raghib (Mufradat): الشيطان refers to the rebellious one among jinn and mankind who leads astray; the term denotes one distanced from divine mercy.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): burning or scorching of meat. Metaphorical (Majaz): \"شاط دمه\" — his blood was spilled in vain; \"أشاط السلطان دمه\" — the ruler declared his blood forfeit. Thus Satan is so named for his being consumed by divine wrath and for his causing others to perish.\n- Root: لهم (Lahm)\n  * Lisan / Ayn: Swallowing or devouring greedily; the larynx or throat (al-lahāt).\n  * Al-Raghib (Mufradat): الإلهام is the casting of something into the heart (al-rawʿ), specifically from God or the higher assembly (al-malaʾ al-aʿlā). It is akin to the \"touch\" (lamah) of the angel or the \"breathing\" (nafth) into the heart.\n  * Al-Zamakhshari (Asas): Literal: to swallow or gulp down. Metaphorical: a horse that \"swallows the ground\" (i.e., devours distance with speed); a generous man who \"swallows\" the needs of others. Thus ilhām is the soul's swift reception of divine inspiration, like swallowing.\n- Root: علم (ʿAlima)\n  * Lisan / Ayn: Knowledge as the mark or trace by which something is known; a signpost (ʿalam).\n  * Al-Raghib (Mufradat): العلم is the apprehension of a thing in its true reality (idrāk al-shayʾ bi-ḥaqīqatihi), divided into apprehension of the essence and judgment upon it.\n  * Al-Zamakhshari (Asas): Literal: knowledge as direct cognition. Metaphorical: \"أعلام الدين\" — the towering landmarks of the religion; \"معالم الطريق\" — the traces by which the road is recognized. Thus knowledge is the signpost illuminating the path of salvation.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Specification) — The particle \"إنما\" restricts the predicate to the subject alone, excluding all else. This is crucial for understanding statements like \"إنما يدعو حزبه\" — Satan calls only his party, restricting his influence to those who follow him.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'","badge":"Insight"},{"arabic":"ولما سمع بعض السلف هذا قال غفر لهم ورب الكعبة وقيل في تفسير قوله عز وجل {لأقعدن لهم صراطك المستقيم} أي طريق مكة يقعد الشيطان عليها ليمنع الناس منها وقال صلى الله عليه وسلم من حج البيت فلم يرفث ولم يفسق خرج من ذنوبه كيوم ولدته أمه (2) وقال أيضا صلى الله عليه وسلم ما رؤي الشيطان في يوم أصغر ولا أدحر ولا أحقر ولا أغيظ منه يوم عرفة (1) وما ذلك إلا لما يرى من نزول الرحمة وتجاوز الله سبحانه عن الذنوب العظام إذ يقال إن من الذنوب ذنوبا لا يكفرها إلا الوقوف بعرفة (2) وقد أسنده جعفر بن محمد إلى رسول الله صلى الله عليه وسلم وذكر بعض","english":"I say: The first [matter] concerning the virtue of the pilgrimage — God Most High said: {«وَأَذِّن فِي النَّاسِ بِالْحَجِّ يَأْتُوكَ رِجَالًا وَعَلَىٰ كُلِّ ضَامِرٍ يَأْتِينَ مِن كُلِّ فَجٍّ عَمِيقٍ»} (And proclaim to the people the pilgrimage; they will come to you on foot and on every lean camel, coming from every deep and distant highway). Qatādah said: When God Most High commanded Ibrāhīm (peace be upon him — and upon our Prophet and upon every chosen servant) to proclaim the pilgrimage to the people, he called out: \"O people! God Most High has built a House, so perform the pilgrimage to it.\" And He Most High said: {«لِيَشْهَدُوا مَنَافِعَ لَهُمْ»} (That they may witness benefits for them) — it is said [these benefits are] commerce during the season and reward in the Hereafter.","book_title":"Patience and Gratitude","section_title_ar":"Section 192","section_title_en":"The Virtue of the Pilgrimage (Faḍīlat al-Ḥajj)","section_index":192,"anchors":"- Root: ح ج ج (ḥ-j-j)\n  * Lisan / Ayn: Core meaning is \"to repair to a place repeatedly, to seek a thing, to overcome in argument.\" Al-Ayn: \"الحج: القصد والتردد إلى الشيء.\"\n  * Al-Raghib (Mufradat): \"الحج: القصد إلى البيت الحرام للنسك، وأصله من قصدت الشيء وأقبلت عليه.\"\n  * Al-Zamakhshari (Asas): Literal: \"قصدت فلانا وحججت إليه.\" Metaphorical: \"حاججته فحججته\" — to overcome in disputation, from the idea of repeatedly pressing one's point.\n- Root: غ ف ر (gh-f-r)\n  * Lisan / Ayn: \"الغفر: الستر والتغطية.\" Al-Ayn: \"غفرت الشيء: سترته.\"\n  * Al-Raghib (Mufradat): \"الغفران والمغفرة من الله هو أن يصون العبد من أن يمسه العذاب.\"\n  * Al-Zamakhshari (Asas): Literal: \"اغفر ثوبك في الوعاء\" (cover/protect your garment). Metaphorical: Divine forgiveness as protective covering of sins.\n- Root: و ف د (w-f-d)\n  * Lisan / Ayn: \"الوفد: القوم يأتون السلطان أو الرئيس زائرين أو مستعطفين.\"\n  * Al-Raghib (Mufradat): \"الوفد: القوم المجتمعون القاصدون إلى رئيس.\"\n  * Al-Zamakhshari (Asas): Literal: \"وفد فلان على الأمير\" — he came as a delegate. Metaphorical: The pilgrims as \"delegation of God\" (وفد الله) — those who come to Him seeking honor and bounty.\n- Root: ر ح م (r-ḥ-m)\n  * Lisan / Ayn: \"الرحمة: الرقة والتعطف.\" Al-Ayn: \"الرحمة: رقة القلب.\"\n  * Al-Raghib (Mufradat): \"الرحمة: رقة تقتضي الإحسان إلى المرحوم.\"\n  * Al-Zamakhshari (Asas): Literal: \"رحمت فلانا\" — I felt compassion. Metaphorical: Divine mercy as the descent of blessing and pardon upon creation.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the placement of prepositional phrases and their objects, particularly relevant in the verse {«يأتين من كل فج عميق»} where the prepositional phrase \"من كل فج\" is interposed between the verb and its subject, demonstrating the rhetorical emphasis on the vastness of the routes of pilgrimage.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Patience and Gratitude'","badge":"Hadith"}],"17":[{"arabic":"قوله تعالى {وقليل من عبادي الشكور} وفرح إبليس لعنه الله بقوله {ولا تجد أكثرهم شاكرين} فلا يعرف معنى هذه الآية من لم يعرف معنى هذا كله وأمورا أخر وراء ذلك تنقضي الأعمار دون استقصاء مباديها فأما تفسير الآية ومعنى لفظها فيعرفه كل من يعرف اللغة وبهذا يتبين لك الفرق بين المعنى والتفسير فإن قلت فقد رجع حاصل هذا الكلام إلى أن الله تعالى حكمه في كل شيء وأنه جعل بعض أفعال العباد سببا لتمام الحكمة وبلوغها غاية المراد منها وجعل بعض أفعالها مانعا من تمام الحكمة فكل فعل وافق مقتضى الحكمة حتى انساقت الحكمة إلى غايتها فهو شكر وكل ما خالف ومن","english":"...from his hand, it could not be taken from him — not because the morsel became his property by the mere taking of the hand, for the hand and its owner are also owned [by God]. But rather, since every single morsel in its particularity does not suffice for the need of all the servants, justice in the specification (takhṣīṣ) [of provision] lies in the occurrence of a certain kind of preponderance and particularization; and the taking [by the hand] is a particularization (ikhtiṣāṣ) that the servant uniquely performs. Thus, whoever does not put forward that particularization is prevented from contesting him [who has taken it]. In this manner, you ought to understand the command of God — exalted — regarding His servants. And for this reason, we say: whoever takes from the wealth of this world more than his need, and hoards it and withholds it, while among the servants of God there are those who are in need of it — he is a wrongdoer (ẓālim), and he is among those who \"hoard gold and silver and do not spend them in the way of God\" {«يكنزون الذهب والفضة ولا ينفقونها في سبيل الله»}. And the \"way of God\" (sabīl Allāh) is only His obedience; and the means of creation to His obedience are the wealth of this world, for through it their necessities are repelled and their needs are lifted. Yes — this does not enter into the scope of the legal rulings (fatāwā) of jurisprudence, because the measures of needs are hidden, and souls differ in their anticipation of future poverty, and the ends of lifespans are unknown. Thus, charging the common folk with this would be like charging children with dignity, deliberateness, and silence from unimportant speech — which, by virtue of their deficiency, they cannot bear. So we have left off objecting to them regarding play and amusement, and our permitting that to them does not indicate that amusement and play are the truth. Likewise, our permitting the common folk to preserve wealth and to restrict spending to the amount of the alms-tax (zakāh), due to the necessity of the avarice they are naturally formed upon, does not indicate that this is the ultimate limit of truth. Indeed, the Qur'an has pointed to this when He — exalted — said: {«إن يسألكموها فيحفكم تبخلوا»} \"If He asks you for them and presses you, you would be miserly.\" Rather, the truth that has no turbidity in it, and the justice that has no injustice in it, is that no one should take from the servants of God, from the wealth of God, except to the measure of the provision of a rider (zād al-rākib). For all the servants of God are riders upon the mounts of their bodies, journeying to the presence of the King, the Reckoner (al-Malik al-Dayyān). So whoever takes more than that, and then withholds it from another rider who is in need of it — he is a wrongdoer, abandoning justice, departing from the purpose of wisdom (ḥikmah), and ungrateful for the blessing of God — exalted — upon him, through the Qur'an, the Messenger, the intellect, and all the other means by which he came to know that whatever exceeds the rider's provision is a burden upon him in this world and the Hereafter. So whoever understands the wisdom of God — exalted — in all the kinds of existent things is able to undertake the duty of thankfulness (shukr). And exhausting that [understanding] requires volumes, and even then they would not suffice except for a little. And we have only mentioned this much so that the cause of the truthfulness in His saying — exalted: {«وقليل من عبادي الشكور»} \"And few of My servants are thankful\" — may be known, and the rejoicing of Iblis — may God curse him — in his saying: {«ولا تجد أكثرهم شاكرين»} \"And you will not find most of them thankful.\" For no one knows the meaning of this verse who does not know the meaning of all of this, along with other matters beyond it, the lifetimes expiring without exhausting their principles. As for the interpretation (tafsīr) of the verse and the meaning of its wording, everyone who knows the language knows that. And by this, the difference between meaning (maʿnā) and interpretation (tafsīr) becomes clear to you. For if you say: \"The sum of this discourse has returned to the claim that God — exalted — His judgment (ḥukm) is in everything, and that He made some acts of His servants a cause for the completion of wisdom and its reaching the ultimate purpose intended from it, and He made some of their acts a barrier to the completion of wisdom. So every act that conforms to the requirement of wisdom, such that wisdom flows on to its end, is thankfulness (shukr); and everything that opposes it and prevents the causes from flowing to the purpose intended by them is ungratefulness (kufrān). And all of this is understood. But the difficulty remains: the servant's act — divided into what completes wisdom and what lifts it — is itself also from the act of God — exalted. So where is the servant in between, such that he is thankful at one time and ungrateful at another?\" — Know that the full realization of this draws its source from the current of a mighty sea of the sciences of unveiling (ʿulūm al-mukāshafāt). We have already alluded, in what preceded, to intimations of its principles. And now we shall express, with a concise utterance, its final end and ultimate goal — understood by whoever knows the logic of the birds (manṭiq al-ṭayr), and denied by whoever is incapable of quickening his pace in the journey, let alone soaring in the atmosphere of the Kingdom (malakūt) with the flight of birds. So we say: God — mighty and majestic — in His glory and supremacy, has an attribute from which creation and invention issue forth. And that attribute is higher and more exalted than that the eye of the language-coiner could perceive it, so as to express it with an utterance indicating the essence of its glory and the specificity of its reality. Thus, there is no expression for it in the world, due to the loftiness of its station and the lowness of the rank of the language-coiners from extending the reach of their understanding to the principles of its radiance. Their sights have fallen from its summit, just as the sights of bats fall from the light of the sun — not due to its obscurity...","book_title":"Patience and Gratitude","section_title_ar":"Section 987","section_title_en":"The Reality of Shukr (Thankfulness) and the Distinction Between Meaning (Maʿnā) and Interpretation (Tafsīr)","section_index":987,"anchors":"- Root: شكر (Sh-K-R)\n  * Lisan / Ayn: Core root denotes fullness (as in a brimming udder, ضرة شكرى) and the manifestation of increase; cognate with the notion of an animal thriving on little fodder.\n  * Al-Raghib (Mufradat): \"الشكر: تصور النعمة وإظهارها\" — Thankfulness is the conceptualization of the blessing and its outward manifestation. It is divided into three kinds: gratitude of the heart (perception of the blessing), of the tongue (praise of the Benefactor), and of the limbs (rewarding the blessing through obedience).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"شكرت لله تعالى نعمته\" — verbal acknowledgment. Metaphorical (Majaz): \"دابة شكور\" — a beast that suffices on little fodder yet grows fat, symbolizing the one who fulfills the duty of gratitude with minimal worldly means.\n- Root: ظلم (Ẓ-L-M)\n  * Lisan / Ayn: Root denotes darkness (absence of light); placing something in other than its proper place.\n  * Al-Raghib (Mufradat): Darkness is used metaphorically for ignorance, polytheism, and transgression, as opposed to light (nūr) which signifies knowledge and justice.\n  * Al-Zamakhshari (Asas): Literal: \"الظلم ظلمات يوم القيامة\" — injustice is darkness on the Day of Resurrection. Metaphorical: \"أرض مظلومة\" — land never before dug, i.e., one who hoards wealth without prior right or need.\n- Root: حكم (H-K-M)\n  * Lisan / Ayn: Root meaning: to prevent for the sake of correction; hence the reins (ḥikmah) of a horse.\n  * Al-Raghib (Mufradat): \"حكم أصله: منع منعا لإصلاح\" — judgment/wise purpose is a restraining for rectification; God's ḥikmah is His ordering of creation toward its intended perfection.\n  * Al-Zamakhshari (Asas): Literal: \"أحكم الشيء فاستحكم\" — to make a thing firm and sound; God's wisdom is the firm ordering of all existents toward their ends.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to restrict the meaning of \"سبيل الله\" (the path of God) exclusively to obedience, and to delimit the true and unclouded justice as that of the traveler's provision (zād al-rākib).","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'","badge":"Insight"}],"26":[{"arabic":"وقيل في قوله تعالى يا بني آدم قد أنزلنا عليكم لباسا يواري سوءاتكم يعني العلم وريشا يعني اليقين ولباس التقوى يعني الحياء وقال عز وجل {ولقد جئناهم بكتاب فصلناه على علم} وقال تعالى {فلنقصن عليهم بعلم} وقال عز وجل {بل هو آيات بينات في صدور الذين أوتوا العلم} وقال تعالى {خلق الإنسان علمه البيان} وإنما ذكر ذلك في معرض الامتنان وأما الأخبار فقال رسول الله صلى الله عليه وسلم من يرد الله به خيرا يفقهه في الدين ويلهمه رشده (1) وقال صلى الله عليه وسلم العلماء ورثة الأنبياء (2) ومعلوم أنه لا رتبة فوق النبوة ولا شرف فوق شر","english":"How He, Glorified and Exalted, began with Himself, then seconded with the angels, and thirded with the people of knowledge — and sufficient for you is this as honor, excellence, splendor, and nobility. And God, Exalted, said: {«يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات»} — \"God will raise those who have believed among you and those who have been given knowledge, in degrees.\" Ibn ʿAbbās, may God be pleased with them both, said: For the scholars there are degrees above the believers, seven hundred degrees, and between each two degrees is a distance of five hundred years' journey.","book_title":"Book of Knowledge","section_title_ar":"Section 4","section_title_en":"The Book of Knowledge — Section 4: The Excellence of Knowledge and the Scholars","section_index":4,"anchors":"- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Core root meaning of knowing, perceiving a thing in its true reality; the act of apprehension and judgment.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment of existence or non-existence.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes genuine knowing; metaphorical (majāz) usage extends to signs, landmarks, and traces that guide to knowledge.\n- Root: درج (d-r-j)\n  * Lisan / Ayn: Degrees, steps, ascending stations; the root denotes gradation and progressive elevation.\n  * Al-Raghib (Mufradat): \"الدرجة نحو المنزلة، لكن يقال للمنزلة: درجة إذا اعتبرت بالصعود\" — a degree is a station considered by ascent, not horizontal extension.\n  * Al-Zamakhshari (Asas): Literal: physical steps of ascent. Metaphorical: \"لفلان درجة رفيعة\" — lofty rank; \"امش في مدارج الحق\" — walk in the paths of truth.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day denotes the time of the sun's rising to its setting, and may denote any period of time whatsoever.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"ذكر في أيام العرب كذا\" — historical battles and events; \"وذكرهم بأيام الله\" — His mighty deeds against the disbelievers.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication) — The particle \"innamā\" restricts and confines the predicate to the subject alone, as in {«إنما يخشى الله من عباده العلماء»}, where fear of God is restricted exclusively to the scholars.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'","badge":"Insight"}],"27":[{"arabic":"منه جميع الخلق فقال الله تعالى يا بني آدم لا يفتننكم الشيطان كما أخرج أبويكم من الجنة وقال عز وجل إنه يراكم هو وقبيله من حيث لا ترونهم والقرآن من أوله إلى آخره تحذير من الشيطان فكيف يدع الأمن منه وأخذ الحذر من حيث أمر الله به لا ينافي الاشتغال بحب الله فإن من الحب له امتثال أمره وقد أمر بالحذر من العدو كما أمر بالحذر من الكفار فقال تعالى وليأخذوا حذرهم وأسلحتهم وقال تعالى وأعدوا لهم ما استطعتم من قوة ومن رباط الخيل فإذا لزمك بأمر الله الحذر من العدو الكافر وأنت تراه فبأن يلزمك الحذر من عدو يراك ولا تراه أولى ولذلك قال ابن محيريز صي","english":"...and the world, which is the source of trials and tribulations, the mine of forbidden pleasures and lusts. And Moses, peace be upon him, said—as God Most High has related concerning him—{«هذا من عمل الشيطان»} (\"This is of Satan's doing\" — Qur'an 28:15). For this reason, God warned all of creation against him, saying: {«يا بني آدم لا يفتننكم الشيطان كما أخرج أبويكم من الجنة»} (\"O children of Adam, let not Satan tempt you as he brought your parents out of Paradise\" — Qur'an 7:27). And He, Glorified and Exalted, said: {«إنه يراكم هو وقبيله من حيث لا ترونهم»} (\"Indeed, he sees you, he and his tribe, from where you do not see them\" — Qur'an 7:27). The Qur'an, from its beginning to its end, is a warning against Satan. So how could one claim security from him? And taking precaution against him, in the manner God has commanded, does not contradict occupation with the love of God. For part of loving Him is obeying His command. He has commanded vigilance against the enemy just as He commanded vigilance against the disbelievers, saying: {«وليعأخذوا حذرهم وأسلحتهم»} (\"And let them take their precautions and their weapons\" — Qur'an 4:102), and saying: {«وأعدوا لهم ما استطعتم من قوة ومن رباط الخيل»} (\"And prepare against them whatever you are able of power and of steeds of war\" — Qur'an 8:60). So if, by God's command, you are obligated to be wary of a disbelieving enemy whom you can see, then it is all the more fitting that you be obligated to be wary of an enemy who sees you while you do not see him.","book_title":"Condemnation of Status and Ostentation","section_title_ar":"Section 830","section_title_en":"On the Necessity of Vigilance Against Satan and Its Harmony with Trust in God and Remembrance of Him","section_index":830,"anchors":"- Root: شيط (Shayṭ)\n  * Lisan / Ayn: Core root denotes burning, scorching, or spoiling (as meat over a fire), and by extension, perishing or being ruined.\n  * Al-Raghib (Mufradat): \"الشيطان\" (Satan) is derived from this root, signifying one who is burned, ruined, or cast away from mercy—the archetype of the adversary who destroys through temptation.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"شاط دمه\" — his blood went in vain (was wasted). Metaphorical (Majaz): \"أشاط السلطان دمه\" — the ruler declared his blood permissible (wasted). Thus, Satan is the one who causes spiritual ruin and waste.\n- Root: حذر (Ḥadhar)\n  * Lisan / Ayn: Caution, wariness, and taking precautions against a feared harm.\n  * Al-Raghib (Mufradat): \"الحذر: احتراز من مخيف\" — vigilance is a protective withdrawal from what is frightening. It is a commanded state, as in {«خذوا حذركم»} (Take your precautions — Qur'an 4:71).\n  * Al-Zamakhshari (Asas): Literal: \"حذرته وحاذرته\" — I was wary of him. Metaphorical: \"حذار من أرماحنا حذار\" — a poetic imperative to beware. Vigilance is both a physical and spiritual act of self-preservation.\n- Root: قلب (Qalb)\n  * Lisan / Ayn: To turn, overturn, or flip something from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart (qalb) is so named for its constant turning and fluctuation between states.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — to turn a thing from its face. Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and devises stratagems. The heart's occupation is decisive: it turns either toward God or toward the enemy.\n- Root: وكل (Wakal)\n  * Lisan / Ayn: To entrust, delegate, or rely upon another.\n  * Al-Raghib (Mufradat): \"التوكيل: أن تعتمد على غيرك وتجعله نائبا عنك\" — trust (tawakkul) is reliance upon another as your deputy. God says: {«وكفى بالله وكيلا»} (And sufficient is Allah as Disposer of affairs — Qur'an 4:81).\n  * Al-Zamakhshari (Asas): Literal: \"وكل إليه الأمر\" — he delegated the matter to him. Metaphorical: \"فلان وكل\" — a weak man who leans on others. True tawakkul does not negate taking means; it purifies the heart's reliance.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The particle \"إنما\" and restrictive constructions (e.g., \"ليس ... إلا\") are used to delimit predicates, as in the author's argument that vigilance is not a contradiction of love or trust but a fulfillment of the divine command.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Status and Ostentation'","badge":"Afterlife"},{"arabic":"أبويكم من الجنة وقال عز وجل إنه يراكم هو وقبيله من حيث لا ترونهم والقرآن من أوله إلى آخره تحذير من الشيطان فكيف يدع الأمن منه وأخذ الحذر من حيث أمر الله به لا ينافي الاشتغال بحب الله فإن من الحب له امتثال أمره وقد أمر بالحذر من العدو كما أمر بالحذر من الكفار فقال تعالى وليأخذوا حذرهم وأسلحتهم وقال تعالى وأعدوا لهم ما استطعتم من قوة ومن رباط الخيل فإذا لزمك بأمر الله الحذر من العدو الكافر وأنت تراه فبأن يلزمك الحذر من عدو يراك ولا تراه أولى ولذلك قال ابن محيريز صيد تراه ولا يراك يوشك أن تظفر به وصيد يراك ولا تر","english":"...and the world, which is the source of trials and tribulations, the mine of forbidden pleasures and lusts. And Moses, peace be upon him, said—as God Most High has related concerning him—{«هذا من عمل الشيطان»} (\"This is of Satan's doing\" — Qur'an 28:15). For this reason, God warned all of creation against him, saying: {«يا بني آدم لا يفتننكم الشيطان كما أخرج أبويكم من الجنة»} (\"O children of Adam, let not Satan tempt you as he brought your parents out of Paradise\" — Qur'an 7:27). And He, Glorified and Exalted, said: {«إنه يراكم هو وقبيله من حيث لا ترونهم»} (\"Indeed, he sees you, he and his tribe, from where you do not see them\" — Qur'an 7:27). The Qur'an, from its beginning to its end, is a warning against Satan. So how could one claim security from him? And taking precaution against him, in the manner God has commanded, does not contradict occupation with the love of God. For part of loving Him is obeying His command. He has commanded vigilance against the enemy just as He commanded vigilance against the disbelievers, saying: {«وليعأخذوا حذرهم وأسلحتهم»} (\"And let them take their precautions and their weapons\" — Qur'an 4:102), and saying: {«وأعدوا لهم ما استطعتم من قوة ومن رباط الخيل»} (\"And prepare against them whatever you are able of power and of steeds of war\" — Qur'an 8:60). So if, by God's command, you are obligated to be wary of a disbelieving enemy whom you can see, then it is all the more fitting that you be obligated to be wary of an enemy who sees you while you do not see him.","book_title":"Condemnation of Status and Ostentation","section_title_ar":"Section 830","section_title_en":"On the Necessity of Vigilance Against Satan and Its Harmony with Trust in God and Remembrance of Him","section_index":830,"anchors":"- Root: شيط (Shayṭ)\n  * Lisan / Ayn: Core root denotes burning, scorching, or spoiling (as meat over a fire), and by extension, perishing or being ruined.\n  * Al-Raghib (Mufradat): \"الشيطان\" (Satan) is derived from this root, signifying one who is burned, ruined, or cast away from mercy—the archetype of the adversary who destroys through temptation.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"شاط دمه\" — his blood went in vain (was wasted). Metaphorical (Majaz): \"أشاط السلطان دمه\" — the ruler declared his blood permissible (wasted). Thus, Satan is the one who causes spiritual ruin and waste.\n- Root: حذر (Ḥadhar)\n  * Lisan / Ayn: Caution, wariness, and taking precautions against a feared harm.\n  * Al-Raghib (Mufradat): \"الحذر: احتراز من مخيف\" — vigilance is a protective withdrawal from what is frightening. It is a commanded state, as in {«خذوا حذركم»} (Take your precautions — Qur'an 4:71).\n  * Al-Zamakhshari (Asas): Literal: \"حذرته وحاذرته\" — I was wary of him. Metaphorical: \"حذار من أرماحنا حذار\" — a poetic imperative to beware. Vigilance is both a physical and spiritual act of self-preservation.\n- Root: قلب (Qalb)\n  * Lisan / Ayn: To turn, overturn, or flip something from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart (qalb) is so named for its constant turning and fluctuation between states.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — to turn a thing from its face. Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and devises stratagems. The heart's occupation is decisive: it turns either toward God or toward the enemy.\n- Root: وكل (Wakal)\n  * Lisan / Ayn: To entrust, delegate, or rely upon another.\n  * Al-Raghib (Mufradat): \"التوكيل: أن تعتمد على غيرك وتجعله نائبا عنك\" — trust (tawakkul) is reliance upon another as your deputy. God says: {«وكفى بالله وكيلا»} (And sufficient is Allah as Disposer of affairs — Qur'an 4:81).\n  * Al-Zamakhshari (Asas): Literal: \"وكل إليه الأمر\" — he delegated the matter to him. Metaphorical: \"فلان وكل\" — a weak man who leans on others. True tawakkul does not negate taking means; it purifies the heart's reliance.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The particle \"إنما\" and restrictive constructions (e.g., \"ليس ... إلا\") are used to delimit predicates, as in the author's argument that vigilance is not a contradiction of love or trust but a fulfillment of the divine command.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Status and Ostentation'","badge":"Afterlife"}],"28":[{"arabic":"الله عنه ليس ذلك لك إذا يقام عليك الحد إن الله لم يأمن على هذا الأمر أقل من أربعة شهود ثم تركهم ما شاء الله أن يتركهم ثم سألهم فقال القوم مقالتهم الأولى فقال علي رضي الله عنه مثل مقالته الأولى وهذا يشير إلى أن عمر رضي الله عنه كان مترددا في أن الوالي هل له أن يقضي بعلمه في حدود الله فلذلك راجعهم في معرض التقدير لا في معرض الإخبار خيفة من أن لا يكون له ذلك فيكون قاذفا بإخباره ومال رأي علي إلى أنه ليس له ذلك وهذا من أعظم الأدلة على طلب الشرع لستر الفواحش فإن أفحشها الزنا وقد نيط بأربعة من العدول يشاهدون ذلك","english":"**First**: That you greet him with peace (*salām*) when you meet him, and respond to his invitation when he invites you, and say \"may Allah have mercy on you\" (*tashmīt*) when he sneezes, and visit him when he is ill, and attend his funeral procession when he dies, and fulfill his oath when he swears by you, and give him sincere counsel when he seeks your advice, and protect him in his absence when he is away from you, and love for him what you love for yourself, and dislike for him what you dislike for yourself. (1)","book_title":"Duties of Brotherhood","section_title_ar":"Section 433","section_title_en":"The Rights of Brotherhood — Section 433: The Duties of a Muslim Toward His Fellow Muslims","section_index":433,"anchors":"- Root: سلم (s-l-m)\n  * Lisan / Ayn: Core meaning of safety, security, freedom from harm; the root from which *islām* (submission/surrender) and *salām* (peace) derive\n  * Al-Raghib (Mufradat): *Salām* as the theological state of being secure from harm — both giving and receiving safety; *islām* as the total surrender of the heart to Allah\n  * Al-Zamakhshari (Asas): Literal (*ḥaqīqah*): physical safety from tongue and hand; Metaphorical (*majāz*): the comprehensive spiritual safety that defines true Muslim brotherhood\n- Root: عون (ʿ-w-n)\n  * Lisan / Ayn: Assistance, aid, helping another in need\n  * Al-Raghib (Mufradat): Mutual assistance as a divine ordinance among believers\n  * Al-Zamakhshari (Asas): Literal: physical aid; Metaphorical: intercession (*shafāʿah*) and advocacy on behalf of others\n- Root: ستر (s-t-r)\n  * Lisan / Ayn: Covering, concealing, veiling; protection from exposure\n  * Al-Raghib (Mufradat): *Sitr* as the divine attribute of concealment — Allah's covering of sins in this world and the next\n  * Al-Zamakhshari (Asas): Literal: covering a physical defect; Metaphorical: concealing another's faults and sins — a cardinal virtue of brotherhood\n- Root: عذر (ʿ-dh-r)\n  * Lisan / Ayn: Excuse, pardon, acceptance of apology\n  * Al-Raghib (Mufradat): *ʿAfw* (pardon) as the higher station of forgiveness that elevates the forgiver\n  * Al-Zamakhshari (Asas): Literal: releasing from obligation; Metaphorical: the noble trait of overlooking others' offenses\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated use of restrictive constructions (e.g., \"المسلم من سلم المسلمون\") establishes definitional boundaries through predicate restriction, indicating that the *ḥaqīqah* of faith is manifested through specific observable actions.\n\n---\n\n##","content_type":"general","topic":"Classical commentary from Al-Ghazali's Ihya Ulum al-Din, from 'Duties of Brotherhood'","badge":"Commentary"}],"31":[{"arabic":"قال تعالى {وكلوا واشربوا ولا تسرفوا} وقال تعالى {ولا تجعل يدك مغلولة إلى عنقك ولا تبسطها كل البسط} وقد قال رسول الله صلى الله عليه وسلم خيركم خيركم لأهله (5) وقال صلى الله عليه وسلم دينار أنفقته في سبيل الله ودينار أنفقته في رقبة ودينار تصدقت به على مسكين ودينار أنفقته على أهلك أعظمها أجرا الذي أنفقته على أهلك (6) وقيل كان لعلي رضي الله عنه أربع نسوة فكان يشتري لكل واحدة في كل أربعة أيام لحما بدرهم وقال الحسن رضي الله عنه كانوا في الرجال مخاصيب والإناث والثياب مجاديب وقال ابن سيرين يستحب للرجل أن ي","english":"The first point of etiquette is the wedding feast (walīmah), and it is recommended (mustaḥabbah). Anas, may God be pleased with him, said: The Messenger of God, may God bless him and grant him peace, saw upon ʿAbd al-Raḥmān ibn ʿAwf, may God be pleased with him, a trace of yellow dye, so he said: {«What is this?»} He replied: \"I have married a woman for the weight of a date-stone in gold.\" He said: \"May God bless you. Hold a wedding feast, even if with a single sheep.\" {«...»} And the Messenger of God, may God bless him and grant him peace, held a wedding feast for Ṣafiyyah with dates and sawīq (barley porridge). {«...»} And he, may God bless him and grant him peace, said: \"The food of the first day is an obligation (ḥaqq), the food of the second day is a Sunnah, and the food of the third day is for show (sumʿah); and whoever seeks to be heard, God will make his deeds heard.\" {«...»} None raised this hadith except Ziyād ibn ʿAbd Allāh, and it is anomalous (gharīb). It is recommended to offer congratulations to him, and the one who enters upon the husband should say: \"May God bless you and shower blessings upon you, and may He bring you both together in goodness.\" {«...»} Abū Hurayrah, may God be pleased with him, reported that he, may God bless him and grant him peace, commanded this. It is also recommended to make the marriage public (iẓhār al-nikāḥ). He, may God bless him and grant him peace, said: \"The distinction between the lawful and the unlawful is the drum and the voice.\" {«...»} The Messenger of God, may God bless him and grant him peace, said: \"Announce this marriage, hold it in the mosques, and beat drums for it.\" {«...»} And on the authority of al-Rubayyiʿ bint Muʿawwidh, she said: The Messenger of God, may God bless him and grant him peace, came and entered on the morning of my wedding night, and he sat upon my bedding, and we had young girls with us who were beating their drums and lamenting those of my forefathers who had been killed—until one of them said: \"And among us is a Prophet who knows what will be tomorrow.\" He said to her: \"Stop this, and say what you were saying before.\" {«...»}","book_title":"Breaking the Two Desires","section_title_ar":"Section 303","section_title_en":"On What is Incumbent Upon the Husband and What is Incumbent Upon the Wife","section_index":303,"anchors":"- Root: و ل م (w-l-m)\n  * Lisan / Ayn: The core meaning pertains to the wedding feast (walīmah), derived from the concept of gathering and union.\n  * Al-Raghib (Mufradat): In theological usage, it signifies the communal meal marking the consummation of a marriage contract, a recommended act of public gratitude.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the specific feast; metaphorical (Majaz) extension applies to any act of publicizing a joyous occasion.\n- Root: ع ش ر (ʿ- sh-r)\n  * Lisan / Ayn: The root denotes association, companionship, and intimacy; the tenth (ʿasharah) of a thing is related, but the primary social sense is cohabitation and mutual dealing.\n  * Al-Raghib (Mufradat): In the Quranic context of {وَعَاشِرُوهُنَّ بِالْمَعْرُوفِ}, it signifies a sustained, equitable mode of social intercourse grounded in moral rectitude, not mere physical proximity.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is the act of living together; metaphorical (Majaz) usage elevates it to a standard of ethical conduct (maʿrūf) that defines the marital bond.\n- Root: ق س م (q-s-m)\n  * Lisan / Ayn: The root indicates division, apportionment, and distribution; in the marital context, it refers to the equitable division of time among co-wives.\n  * Al-Raghib (Mufradat): Theologically, it is tied to justice (ʿadl) as a divine attribute; for the husband, it is a legal obligation to maintain fairness in material and temporal allotments.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is the physical act of dividing; metaphorical (Majaz) usage applies to the moral duty of impartiality in affection and provision.\n- Root: غ ي ر (gh-y-r)\n  * Lisan / Ayn: The root conveys alteration and change, but in the moral register, it denotes protective jealousy (ghayrah), a state of aversion to the violation of honor.\n  * Al-Raghib (Mufradat): In Kalam, ghayrah is a praiseworthy emotion when aligned with divine law—jealousy for the sanctity of the family—and blameworthy when it stems from unjust suspicion (sūʾ al-ẓann).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is the emotional state; metaphorical (Majaz) usage is attributed to God (al-Ghayyār) as a figure for His prohibition of indecencies, distinguishing human passion from divine will.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to isolate specific obligations (e.g., \"the third is that he should increase...\") and to distinguish categories of jealousy and pride, ensuring precise legal and moral demarcation.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Breaking the Two Desires'","badge":"Hadith"}],"32":[{"arabic":"تعالى فقد قال الله تعالى {قل من حرم زينة الله التي أخرج لعباده والطيبات من الرزق} وإني لأعلم أن ترك ذلك خير من الدخول فيه ولا تدعنا من كتابك فلسنا ندعك من كتابنا والسلام فانظر إلى إنصاف مالك إذ اعترف أن","english":"...that he intended that (i.e., the debate) rather than formal learning. So he entered his house and did not come out to the people for forty days. When Hātim entered Baghdad, the people of Baghdad gathered around him and said: \"O Abā ʿAbd al-Raḥmān, you are a man, but you are a foreigner (aʿjamī), and no one speaks with you except that you cut him off (in argument).\" He said: \"I have three traits (khiṣāl) by which I overcome my opponent: I rejoice when my opponent is correct, I grieve when he errs, and I guard myself from acting ignorantly toward him.\"","book_title":"Book of Knowledge","section_title_ar":"Section 55","section_title_en":"The Story of Hātim al-Aṣamm and the Letter of Mālik ibn Anas — On Renunciation of Worldly Adornment","section_index":55,"anchors":"- Root: ع-ج-م (ʿ-j-m)\n  * Lisan / Ayn: The core meaning denotes one who is non-Arab, or one whose speech is unclear/ungrammatical; also used for the unintelligible.\n  * Al-Raghib (Mufradat): In theological contexts, it distinguishes the foreigner (aʿjamī) who lacks the eloquence of the Arabs, yet may possess wisdom.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for non-Arab; metaphorical (majāz) for one who is silent or whose argument is weak.\n- Root: خ-ص-ل (kh-ṣ-l)\n  * Lisan / Ayn: A trait, quality, or characteristic (khiṣāl) inherent in a person, whether praiseworthy or blameworthy.\n  * Al-Raghib (Mufradat): Used for moral and spiritual attributes that define one's character in the path of salvation.\n  * Al-Zamakhshari (Asas): Literal for a natural or acquired quality; metaphorical for a portion of good or evil.\n- Root: ز-ي-ن (z-y-n)\n  * Lisan / Ayn: Adornment, ornament, or beautification (zīnah); to decorate.\n  * Al-Raghib (Mufradat): In the Quranic verse {قل من حرم زينة الله} it refers to permissible worldly beautification, which is not forbidden but can distract from the Hereafter.\n  * Al-Zamakhshari (Asas): Literal for physical ornament; metaphorical for spiritual adornment through piety.\n- Sibawayh Rule: باب الحكاية والمحكي (Narration and the Quoted) — When quoting speech, the syntactic case of the original utterance is preserved, as seen in the direct quotes of Hātim and the letters exchanged.","content_type":"general","topic":"Classical commentary from Al-Ghazali's Ihya Ulum al-Din, from 'Book of Knowledge'","badge":"Commentary"}],"33":[{"arabic":"ولأجل غيرة الله تعالى حرم الفواحش ما ظهر منها وما بطن ولا أحد أحب إليه العذر من الله ولذلك بعث المنذرين والمبشرين ولا أحد أحب إليه المدح من الله ولأجل ذلك وعد الجنة وقال رسول الله صلى الله عليه وسلم رأيت ليلة أسري بي في الجنة قصرا وبفنائه جارية فقلت لمن هذا القصر فقيل لعمر فأردت أن أنظر إليها فذكرت غيرتك يا عمر فبكى عمر وقال أعليك أغار يا رسول الله (6) وكان الحسن يقول أتدعون نساءكم ليزاحمن العلوج في الأسواق قبح الله من لا يغار وقال عليه الصلاة والسلام إن من الغيرة ما يحبه الله ومنها ما يبغ","english":"The first point of etiquette is the wedding feast (walīmah), and it is recommended (mustaḥabbah). Anas, may God be pleased with him, said: The Messenger of God, may God bless him and grant him peace, saw upon ʿAbd al-Raḥmān ibn ʿAwf, may God be pleased with him, a trace of yellow dye, so he said: {«What is this?»} He replied: \"I have married a woman for the weight of a date-stone in gold.\" He said: \"May God bless you. Hold a wedding feast, even if with a single sheep.\" {«...»} And the Messenger of God, may God bless him and grant him peace, held a wedding feast for Ṣafiyyah with dates and sawīq (barley porridge). {«...»} And he, may God bless him and grant him peace, said: \"The food of the first day is an obligation (ḥaqq), the food of the second day is a Sunnah, and the food of the third day is for show (sumʿah); and whoever seeks to be heard, God will make his deeds heard.\" {«...»} None raised this hadith except Ziyād ibn ʿAbd Allāh, and it is anomalous (gharīb). It is recommended to offer congratulations to him, and the one who enters upon the husband should say: \"May God bless you and shower blessings upon you, and may He bring you both together in goodness.\" {«...»} Abū Hurayrah, may God be pleased with him, reported that he, may God bless him and grant him peace, commanded this. It is also recommended to make the marriage public (iẓhār al-nikāḥ). He, may God bless him and grant him peace, said: \"The distinction between the lawful and the unlawful is the drum and the voice.\" {«...»} The Messenger of God, may God bless him and grant him peace, said: \"Announce this marriage, hold it in the mosques, and beat drums for it.\" {«...»} And on the authority of al-Rubayyiʿ bint Muʿawwidh, she said: The Messenger of God, may God bless him and grant him peace, came and entered on the morning of my wedding night, and he sat upon my bedding, and we had young girls with us who were beating their drums and lamenting those of my forefathers who had been killed—until one of them said: \"And among us is a Prophet who knows what will be tomorrow.\" He said to her: \"Stop this, and say what you were saying before.\" {«...»}","book_title":"Etiquette of Marriage","section_title_ar":"Section 303","section_title_en":"On What is Incumbent Upon the Husband and What is Incumbent Upon the Wife","section_index":303,"anchors":"- Root: و ل م (w-l-m)\n  * Lisan / Ayn: The core meaning pertains to the wedding feast (walīmah), derived from the concept of gathering and union.\n  * Al-Raghib (Mufradat): In theological usage, it signifies the communal meal marking the consummation of a marriage contract, a recommended act of public gratitude.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the specific feast; metaphorical (Majaz) extension applies to any act of publicizing a joyous occasion.\n- Root: ع ش ر (ʿ- sh-r)\n  * Lisan / Ayn: The root denotes association, companionship, and intimacy; the tenth (ʿasharah) of a thing is related, but the primary social sense is cohabitation and mutual dealing.\n  * Al-Raghib (Mufradat): In the Quranic context of {وَعَاشِرُوهُنَّ بِالْمَعْرُوفِ}, it signifies a sustained, equitable mode of social intercourse grounded in moral rectitude, not mere physical proximity.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is the act of living together; metaphorical (Majaz) usage elevates it to a standard of ethical conduct (maʿrūf) that defines the marital bond.\n- Root: ق س م (q-s-m)\n  * Lisan / Ayn: The root indicates division, apportionment, and distribution; in the marital context, it refers to the equitable division of time among co-wives.\n  * Al-Raghib (Mufradat): Theologically, it is tied to justice (ʿadl) as a divine attribute; for the husband, it is a legal obligation to maintain fairness in material and temporal allotments.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is the physical act of dividing; metaphorical (Majaz) usage applies to the moral duty of impartiality in affection and provision.\n- Root: غ ي ر (gh-y-r)\n  * Lisan / Ayn: The root conveys alteration and change, but in the moral register, it denotes protective jealousy (ghayrah), a state of aversion to the violation of honor.\n  * Al-Raghib (Mufradat): In Kalam, ghayrah is a praiseworthy emotion when aligned with divine law—jealousy for the sanctity of the family—and blameworthy when it stems from unjust suspicion (sūʾ al-ẓann).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is the emotional state; metaphorical (Majaz) usage is attributed to God (al-Ghayyār) as a figure for His prohibition of indecencies, distinguishing human passion from divine will.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to isolate specific obligations (e.g., \"the third is that he should increase...\") and to distinguish categories of jealousy and pride, ensuring precise legal and moral demarcation.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Marriage'","badge":"Hadith"}],"37":[{"arabic":"الله تعالى بين من افترى على الله كذبا وبين من كذب بالحق فقال تعالى ومن أظلم ممن افترى على الله كذبا أو كذب بالحق لما جاءه وقال تعالى فمن أظلم ممن كذب على الله وكذب بالصدق إذ جاءه ومنها الرياء وملاحظة الخلق والجهد في استمالة قلوبهم وصرف وجوههم والرياء هو الداء العضال الذي يدعو إلى أكبر الكبائر كما سيأتي في كتاب الرياء والمناظر لا يقصد إلا الظهور عند الخلق وانطلاق ألسنتهم بالثناء عليه فهذه عشر خصال من أمهات الفواحش الباطنة سوى ما يتفق لغير المتماسكين منهم من الخصام المؤدي إلى الضرب","english":"**QUAD_ANCHORS:**\n- Root: نظر (naẓara)\n  * Lisan / Ayn: Core meaning: to look, to examine, to consider; al-munāẓarah is mutual examination/argumentation between two parties.\n  * Al-Raghib (Mufradat): Theological nuance: naẓar as intellectual contemplation (taʾammul bi-l-baṣīrah); munāẓarah as dialectical exchange.\n  * Al-Zamakhshari (Asas): Literal: sitting face-to-face in debate; Metaphorical: disputation for victory.\n- Root: غلب (ghalaba)\n  * Lisan / Ayn: Core meaning: to overcome, to conquer, to prevail.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghalabah as seeking to dominate another in argument.\n  * Al-Zamakhshari (Asas): Literal: victory in combat; Metaphorical: intellectual supremacy.\n- Root: حسد (ḥasada)\n  * Lisan / Ayn: Core meaning: to envy, to wish removal of blessings from another.\n  * Al-Raghib (Mufradat): Theological nuance: envy as wishing deprivation of blessings from the deserving — among the basest traits.\n  * Al-Zamakhshari (Asas): Literal: envy of another's blessing; Metaphorical: consuming fire of the soul.\n- Root: كبر (kabura)\n  * Lisan / Ayn: Core meaning: to be great, to be haughty.\n  * Al-Raghib (Mufradat): Theological nuance: al-kibr as self-elevation above others; condemned by God.\n  * Al-Zamakhshari (Asas): Literal: greatness; Metaphorical: arrogance and pride.\n- Root: غيب (ghāba)\n  * Lisan / Ayn: Core meaning: to be absent, to be hidden.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghībah as mentioning another with what he dislikes in his absence — likened to eating carrion.\n  * Al-Zamakhshari (Asas): Literal: backbiting; Metaphorical: consuming the flesh of one's brother.\n- Root: راءى (rāʾā)\n  * Lisan / Ayn: Core meaning: to show off, to display.\n  * Al-Raghib (Mufradat): Theological nuance: al-riyāʾ as performing acts for the sake of being seen — hidden shirk.\n  * Al-Zamakhshari (Asas): Literal: showing good deeds; Metaphorical: seeking reputation.\n- Root: نفس (nafs)\n  * Lisan / Ayn: Core meaning: self, soul, spirit.\n  * Al-Raghib (Mufradat): Theological nuance: tazkiyat al-nafs as self-praise and self-purification — forbidden by God.\n  * Al-Zamakhshari (Asas): Literal: self; Metaphorical: self-commendation.\n- Root: حقd (ḥaqida)\n  * Lisan / Ayn: Core meaning: to bear malice, to harbor resentment.\n  * Al-Raghib (Mufradat): Theological nuance: al-ḥiqd as nursing enmity in the heart — negated from the believer.\n  * Al-Zamakhshari (Asas): Literal: bearing grudge; Metaphorical: hidden rancor.\n- Root: نفاق (nifāq)\n  * Lisan / Ayn: Core meaning: hypocrisy, showing contrary to what one conceals.\n  * Al-Raghib (Mufradat): Theological nuance: hypocrisy in deeds — outward display contrary to inward state.\n  * Al-Zamakhshari (Asas): Literal: hypocrisy in faith; Metaphorical: hypocrisy in character.\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning: to know, to perceive.\n  * Al-Raghib (Mufradat): Theological nuance: knowledge as apprehension of reality — its pursuit for other than God is destructive.\n  * Al-Zamakhshari (Asas): Literal: knowledge; Metaphorical: the dangerous burden of the scholar.\n- Root: جدل (jadala)\n  * Lisan / Ayn: Core meaning: to argue, to dispute.\n  * Al-Raghib (Mufradat): Theological nuance: al-jidāl as contention; al-mirāʾ as disputation with falsehood — condemned.\n  * Al-Zamakhshari (Asas): Literal: argumentation; Metaphorical: obstinate disputation.\n- Root: شرك (sharaka)\n  * Lisan / Ayn: Core meaning: to associate, to share.\n  * Al-Raghib (Mufradat): Theological nuance: al-riyāʾ as hidden shirk — associating others with God in intention.\n  * Al-Zamakhshari (Asas): Literal: polytheism; Metaphorical: hidden association in deeds.\n- Root: موت (māta)\n  * Lisan / Ayn: Core meaning: to die.\n  * Al-Raghib (Mufradat): Theological nuance: death as separation of soul from body; spiritual death as ruin of the soul.\n  * Al-Zamakhshari (Asas): Literal: physical death; Metaphorical: spiritual destruction.\n- Root: حيى (ḥayiya)\n  * Lisan / Ayn: Core meaning: to live.\n  * Al-Raghib (Mufradat): Theological nuance: life as the power of perception; eternal life as the reward of the righteous.\n  * Al-Zamakhshari (Asas): Literal: physical life; Metaphorical: spiritual vitality.\n- Root: هلك (halaka)\n  * Lisan / Ayn: Core meaning: to perish, to be destroyed.\n  * Al-Raghib (Mufradat): Theological nuance: al-halāk as ruin; eternal destruction as everlasting punishment.\n  * Al-Zamakhshari (Asas): Literal: destruction; Metaphorical: eternal ruin.\n- Root: رياء (riyāʾ)\n  * Lisan / Ayn: Core meaning: showing off, ostentation.\n  * Al-Raghib (Mufradat): Theological nuance: riyāʾ as the incurable disease calling to the greatest sins.\n  * Al-Zamakhshari (Asas): Literal: ostentation; Metaphorical: spiritual disease.\n- Root: جاه (jāh)\n  * Lisan / Ayn: Core meaning: rank, status, prestige.\n  * Al-Raghib (Mufradat): Theological nuance: love of status (ḥubb al-jāh) among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: position; Metaphorical: seeking prestige.\n- Root: مباهاة (mubāhāh)\n  * Lisan / Ayn: Core meaning: mutual boasting, vying in splendor.\n  * Al-Raghib (Mufradat): Theological nuance: mubāhāh as each seeking to display superiority over the other.\n  * Al-Zamakhshari (Asas): Literal: mutual boasting; Metaphorical: rivalry in honor.\n- Root: مماراة (mumārāh)\n  * Lisan / Ayn: Core meaning: disputation, wrangling.\n  * Al-Raghib (Mufradat): Theological nuance: al-mirāʾ as contentious argument — condemned by the Prophet.\n  * Al-Zamakhshari (Asas): Literal: disputation; Metaphorical: obstinate wrangling.\n- Root: فخر (fakhara)\n  * Lisan / Ayn: Core meaning: to boast, to pride oneself.\n  * Al-Raghib (Mufradat): Theological nuance: al-fakhr as self-glorification — among the blameworthy traits.\n  * Al-Zamakhshari (Asas): Literal: boasting; Metaphorical: vainglory.\n- Root: عجب (ʿajiba)\n  * Lisan / Ayn: Core meaning: to wonder, to be amazed.\n  * Al-Raghib (Mufradat): Theological nuance: al-ʿujb as self-admiration — among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: wonder; Metaphorical: self-conceit.\n- Root: بغض (baghiḍa)\n  * Lisan / Ayn: Core meaning: to hate, to detest.\n  * Al-Raghib (Mufradat): Theological nuance: al-baghdāʾ as mutual hatred — contrary to brotherhood.\n  * Al-Zamakhshari (Asas): Literal: hatred; Metaphorical: mutual enmity.\n- Root: غضب (ghaḍiba)\n  * Lisan / Ayn: Core meaning: to be angry.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghaḍab as anger — among the blameworthy traits.\n  * Al-Zamakhshari (Asas): Literal: anger; Metaphorical: rage.\n- Root: طمع (ṭamiʿa)\n  * Lisan / Ayn: Core meaning: to covet, to desire.\n  * Al-Raghib (Mufradat): Theological nuance: al-ṭamaʿ as covetousness — among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: desire; Metaphorical: greed.\n- Root: أشر (ashira)\n  * Lisan / Ayn: Core meaning: to be exultant, to be insolent.\n  * Al-Raghib (Mufradat): Theological nuance: al-ashar as excessive joy and insolence — blameworthy.\n  * Al-Zamakhshari (Asas): Literal: exultation; Metaphorical: insolence.\n- Root: بطر (baṭira)\n  * Lisan / Ayn: Core meaning: to be arrogant, to be ungrateful.\n  * Al-Raghib (Mufradat): Theological nuance: al-baṭar as arrogance in prosperity — among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: arrogance; Metaphorical: ingratitude for blessings.\n- Root: خيلاء (khuyalāʾ)\n  * Lisan / Ayn: Core meaning: pride, haughtiness.\n  * Al-Raghib (Mufradat): Theological nuance: al-khuyalāʾ as pride and conceit — blameworthy.\n  * Al-Zamakhshari (Asas): Literal: pride; Metaphorical: haughty bearing.\n- Root: خشية (khashyah)\n  * Lisan / Ayn: Core meaning: fear, awe.\n  * Al-Raghib (Mufradat): Theological nuance: al-khashyah as reverential fear — among the traits of the believers.\n  * Al-Zamakhshari (Asas): Literal: fear; Metaphorical: reverential awe.\n- Root: رحمة (raḥmah)\n  * Lisan / Ayn: Core meaning: mercy, compassion.\n  * Al-Raghib (Mufradat): Theological nuance: al-raḥmah as tenderness of heart — among the traits of the believers.\n  * Al-Zamakhshari (Asas): Literal: mercy; Metaphorical: compassion.\n- Root: غفلة (ghaflah)\n  * Lisan / Ayn: Core meaning: heedlessness, inattention.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghaflah as heedlessness — contrary to vigilance.\n  * Al-Zamakhshari (Asas): Literal: inattention; Metaphorical: spiritual heedlessness.\n- Root: خشوع (khushūʿ)\n  * Lisan / Ayn: Core meaning: humility, submissiveness.\n  * Al-Raghib (Mufradat): Theological nuance: al-khushūʿ as humility — among the traits of the believers.\n  * Al-Zamakhshari (Asas): Literal: humility; Metaphorical: devotional submission.\n- Root: تذكير (tadhkīr)\n  * Lisan / Ayn: Core meaning: reminding, admonishing.\n  * Al-Raghib (Mufradat): Theological nuance: al-tadhkīr as reminding of God — a righteous act.\n  * Al-Zamakhshari (Asas): Literal: reminding; Metaphorical: preaching.\n- Root: وعظ (waʿaẓa)\n  * Lisan / Ayn: Core meaning: to admonish, to exhort.\n  * Al-Raghib (Mufradat): Theological nuance: al-waʿẓ as exhortation to obedience and warning against disobedience.\n  * Al-Zamakhshari (Asas): Literal: admonition; Metaphorical: sermonizing.\n- Root: فتوى (fatwā)\n  * Lisan / Ayn: Core meaning: legal ruling, formal opinion.\n  * Al-Raghib (Mufradat): Theological nuance: al-fatwā as clarification of legal rulings.\n  * Al-Zamakhshari (Asas): Literal: legal opinion; Metaphorical: religious authority.\n- Root: قضاء (qaḍāʾ)\n  * Lisan / Ayn: Core meaning: judgment, decree.\n  * Al-Raghib (Mufradat): Theological nuance: al-qaḍāʾ as judgment between people.\n  * Al-Zamakhshari (Asas): Literal: judgment; Metaphorical: judicial authority.\n- Root: وقف (waqafa)\n  * Lisan / Ayn: Core meaning: to stop, to stand.\n  * Al-Raghib (Mufradat): Theological nuance: al-waqf as endowment of property for charitable purposes.\n  * Al-Zamakhshari (Asas): Literal: standing; Metaphorical: religious endowment.\n- Root: ثواب (thawāb)\n  * Lisan / Ayn: Core meaning: reward, recompense.\n  * Al-Raghib (Mufradat): Theological nuance: al-thawāb as divine recompense for righteous deeds.\n  * Al-Zamakhshari (Asas): Literal: reward; Metaphorical: divine recompense.\n- Root: عذاب (ʿadhāb)\n  * Lisan / Ayn: Core meaning: punishment, torment.\n  * Al-Raghib (Mufradat): Theological nuance: al-ʿadhāb as divine punishment for the disobedient.\n  * Al-Zamakhshari (Asas): Literal: punishment; Metaphorical: divine chastisement.\n- Root: ملك (malaka)\n  * Lisan / Ayn: Core meaning: to possess, to rule.\n  * Al-Raghib (Mufradat): Theological nuance: al-mulk as sovereignty; al-mulk al-muʾabbad as eternal sovereignty in Paradise.\n  * Al-Zamakhshari (Asas): Literal: dominion; Metaphorical: eternal kingdom.\n- Root: نعيم (naʿīm)\n  * Lisan / Ayn: Core meaning: bliss, delight.\n  * Al-Raghib (Mufradat): Theological nuance: al-naʿīm as bliss; al-naʿīm al-sarmad as everlasting bliss.\n  * Al-Zamakhshari (Asas): Literal: delight; Metaphorical: eternal bliss.\n- Root: رخصة (rukhaṣah)\n  * Lisan / Ayn: Core meaning: concession, dispensation.\n  * Al-Raghib (Mufradat): Theological nuance: al-rukhaṣah as legal concession.\n  * Al-Zamakhshari (Asas): Literal: concession; Metaphorical: legal dispensation.\n- Root: رياسة (riyāsah)\n  * Lisan / Ayn: Core meaning: leadership, headship.\n  * Al-Raghib (Mufradat): Theological nuance: love of leadership among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: leadership; Metaphorical: seeking authority.\n- Root: اندراس (indirās)\n  * Lisan / Ayn: Core meaning: effacement, obliteration.\n  * Al-Raghib (Mufradat): Theological nuance: indirās al-ʿulūm as the obliteration of the sciences.\n  * Al-Zamakhshari (Asas): Literal: effacement; Metaphorical: extinction of knowledge.\n- Root: صبيان (ṣibyān)\n  * Lisan / Ayn: Core meaning: boys, children.\n  * Al-Raghib (Mufradat): Theological nuance: children's motivation for learning through play.\n  * Al-Zamakhshari (Asas): Literal: boys; Metaphorical: pupils.\n- Root: مكتب (maktab)\n  * Lisan / Ayn- Root: مكتب (maktab)\n  * Lisan / Ayn: Core meaning: place of instruction, school for boys.\n  * Al-Raghib (Mufradat): Theological nuance: the elementary school where children are taught.\n  * Al-Zamakhshari (Asas): Literal: school; Metaphorical: place of elementary learning.\n- Root: خلاق (khilāq)\n  * Lisan / Ayn: Core meaning: portion, share, lot.\n  * Al-Raghib (Mufradat): Theological nuance: \"no portion\" (lā khilāq) in the Hereafter — utter deprivation of divine reward.\n  * Al-Zamakhshari (Asas): Literal: share; Metaphorical: spiritual allotment in the afterlife.\n- Root: فاجر (fājir)\n  * Lisan / Ayn: Core meaning: wicked, immoral, profligate.\n  * Al-Raghib (Mufradat): Theological nuance: the dissolute one who commits sins openly.\n  * Al-Zamakhshari (Asas): Literal: sinner; Metaphorical: one through whom God nonetheless supports religion.\n- Root: شمع (shamʿ)\n  * Lisan / Ayn: Core meaning: candle, wax taper.\n  * Al-Raghib (Mufradat): Theological nuance: the candle as parable — consuming itself while giving light to others.\n  * Al-Zamakhshari (Asas): Literal: candle; Metaphorical: one who destroys himself but benefits others.\n- Root: نار (nār)\n  * Lisan / Ayn: Core meaning: fire.\n  * Al-Raghib (Mufradat): Theological nuance: fire as parable — consuming itself and all around it.\n  * Al-Zamakhshari (Asas): Literal: fire; Metaphorical: one who destroys himself and others.\n- Root: سعد (saʿida)\n  * Lisan / Ayn: Core meaning: to be fortunate, to prosper.\n  * Al-Raghib (Mufradat): Theological nuance: saʿādah as felicity — success in the Hereafter.\n  * Al-Zamakhshari (Asas): Literal: good fortune; Metaphorical: eternal felicity.\n- Root: شقي (shaqiya)\n  * Lisan / Ayn: Core meaning: to be wretched, to be miserable.\n  * Al-Raghib (Mufradat): Theological nuance: shaqāwah as wretchedness — ruin in the Hereafter.\n  * Al-Zamakhshari (Asas): Literal: misery; Metaphorical: eternal ruin.\n- Root: أخلص (akhlaṣa)\n  * Lisan / Ayn: Core meaning: to purify, to be sincere.\n  * Al-Raghib (Mufradat): Theological nuance: ikhlāṣ as purifying intention for God alone — the condition of acceptance.\n  * Al-Zamakhshari (Asas): Literal: sincerity; Metaphorical: pure devotion.\n- Root: ريب (rāba)\n  * Lisan / Ayn: Core meaning: to doubt, to suspect.\n  * Al-Raghib (Mufradat): Theological nuance: al-rayb as doubt and uncertainty — to be dispelled by evidence.\n  * Al-Zamakhshari (Asas): Literal: doubt; Metaphorical: skepticism.","book_title":"Book of Knowledge","section_title_ar":"Section 39","section_title_en":"Section 39","section_index":39,"anchors":"*(Anchors established)*","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Book of Knowledge'","badge":"Ethics"}],"40":[{"arabic":"الدنس ثيابا الذين لا ينكحون المتنعمات ولا تفتح لهم أبواب السدد (5) فقال عمر بن عبد العزيز والله لقد نكحت المتنعمات فاطمة بنت عبد الملك وفتحت لي أبواب السدد إلا أن يرحمني الله لا جرم لا أدهن رأسي حتى يشعث ولا أغسل ثوبي الذي على جسدي حتى يتسخ وعن أبي ذر قال قلت يا رسول الله ما آنية الحوض قال والذي نفس محمد بيده لآنيته أكثر من عدد نجوم السماء وكواكبها في الليلة المظلمة المضحية من شرب منه لم يظمأ آخر ما عليه يشخب فيه ميزابان من الجنة عرضه مثل طوله ما بين عمان وأيلة ماؤه أشد بياضا من اللبن وأحلى م","english":"Know that the Basin (al-Ḥawḍ) is a magnificent honor (mukramah ʿaẓīmah) which God—exalted is He—has singled out for our Prophet, peace and blessings be upon him. The reports (akhbār) have encompassed its description, and we—PageV04P528—hope that God—exalted is He—will grant us knowledge of it in this world and its tasting (dhawq) in the Hereafter. For among its attributes is that whoever drinks from it will never thirst again. Anas said: The Messenger of God, peace and blessings be upon him, dozed a light slumber, then raised his head smiling. They said to him: \"O Messenger of God, why did you laugh?\" He said: \"A verse was just revealed to me,\" and he recited {In the name of God, the Most Merciful, the Most Compassionate: {إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ} [Verily, We have given you the Abundance]} until he completed it. Then he said: \"Do you know what al-Kawthar is?\" They said: \"God and His Messenger know best.\" He said: \"It is a river which my Lord—mighty and majestic is He—has promised me in Paradise, upon which is abundant good. Upon it is a Basin (ḥawḍ) which my community will approach on the Day of Resurrection; its vessels (āniyah) are as numerous as the stars of the sky.\" (1) And Anas said: The Messenger of God, peace and blessings be upon him, said: \"While I was walking in Paradise, behold, there was a river whose banks were domes of hollowed pearl. I said: 'What is this, O Gabriel?' He said: 'This is al-Kawthar which your Lord has given you.' Then the angel struck his hand, and lo, its clay was pure musk (misk adhfar).\" (2) And he said: The Messenger of God, peace and blessings be upon him, used to say: \"The distance between the two banks of my Basin is like that between Medina and Ṣanʿāʾ, or like that between Medina and ʿAmmān.\" (3) And Ibn ʿUmar narrated that when the saying of God—exalted is He—{إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ} was revealed, the Messenger of God, peace and blessings be upon him, said: \"It is a river in Paradise; its two banks are of gold, its drink is whiter than milk, sweeter than honey, and more fragrant than musk; it flows over pebbles of pearl and ruby (marjān).\" (4) And Thawbān, the freed slave of the Messenger of God, peace and blessings be upon him, said: The Messenger of God, peace and blessings be upon him, said: \"My Basin extends from ʿAdan to ʿAmmān of al-Balqāʾ; its water is whiter than milk and sweeter than honey; its cups (akwāb) are as numerous as the stars of the sky. Whoever drinks from it a single drink will never thirst after it ever. The first people to arrive at it are the poor among the Emigrants (fuqarāʾ al-muhājirīn).\" ʿUmar ibn al-Khaṭṭāb said: \"And who are they, O Messenger of God?\" He said: \"They are those with disheveled heads (shaʿth) and dusty garments, who do not marry the pampered beauties (al-mutannaʿimāt), nor are the doors of the great mansions (al-sudad) opened for them.\" (5) Then ʿUmar ibn ʿAbd al-ʿAzīz said: \"By God, I have married the pampered beauties—Fāṭimah bint ʿAbd al-Malik—and the doors of the great mansions have been opened for me, unless God has mercy on me. No doubt! I will not oil my head until it becomes disheveled, nor will I wash the garment upon my body until it becomes soiled.\" And on the authority of Abū Dharr, he said: I said: \"O Messenger of God, what are the vessels of the Basin?\" He said: \"By Him in whose hand is the soul of Muḥammad, its vessels are more numerous than the number of the stars of the sky and its planets on a dark, moonless night (al-muḍḥiyah). Whoever drinks from it will never thirst at the end of his affair. Two spouts (mīzābān) pour into it from Paradise, each as wide as its length, between ʿAmmān and Aylah; its water is whiter than milk and sweeter than honey.\" (6) And on the authority of Samurah, he said: The Messenger of God, peace and blessings be upon him, said: \"Every prophet has a Basin, and they vie in glory over which of them has the most arrivals (wāridah). And I indeed hope that I will be the most numerous of them in arrivals.\" (7) This, then, is the hope (rajāʾ) of the Messenger of God, peace and blessings be upon him. Let every servant hope to be among the number of those who arrive (al-wāridīn), and let him beware of being merely a wishful thinker (mutamanniyan) and self-deluded (mughtarran) while supposing himself to be a hopeful one (rājin). For the one who truly hopes for the harvest is he who sows the seed, clears the earth, and waters it, then sits hoping for God's bounty in causing it to sprout and in warding off calamities (ṣawāʿiq) until the time of harvest. As for the one who abandons tilling, sowing, clearing the earth, and watering it, and then takes to hoping for God's bounty to grow for him grain and fruit—this one is deluded (mughtarr) and a wishful thinker (mutamannin), PageV04P529—and is not among the hopeful in any way. And such is the hope of most creatures, and it is the delusion of fools (ghurūr al-ḥumaqāʾ). We seek refuge in God from delusion (al-ghurūr) and heedlessness (al-ghaflah). For self-delusion regarding God (al-ightirār billāh) is greater than self-delusion regarding this world. God—exalted is He—said: {فَلَا تَغُرَّنَّكُمُ الْحَيَاةُ الدُّنْيَا وَلَا يَغُرَّنَّكُمْ بِاللَّهِ الْغَرُورُ} [So let not the life of this world delude you, nor let the Deluder (al-Gharūr) delude you concerning God] {Luqmān: 33}.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1347","section_title_en":"The Description of the Intercession and the Description of the Basin (Ḥawḍ)","section_index":1347,"anchors":"- Root: حوض (Ḥ-W-Ḍ)\n  * Lisan / Ayn: The basin or cistern where water collects; a place of gathering for drinking.\n  * Al-Raghib (Mufradat): In the eschatological context, it signifies the Prophet's (ﷺ) designated watering-place, a divine honor (mukramah) granted specifically to him, embodying spiritual sustenance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for a physical water-trough; here used literally as a corporeal reality of the Hereafter, yet its description transcends earthly analogies.\n- Root: ورد (W-R-D)\n  * Lisan / Ayn: To arrive at water; to come to a watering-place.\n  * Al-Raghib (Mufradat): The act of approaching the Ḥawḍ denotes the believer's arrival at the source of spiritual quench, contrasting with thirst as deprivation.\n  * Al-Zamakhshari (Asas): Literal for seeking water; metaphorically, the \"ward\" (those arriving) are the faithful community seeking the Prophet's intercession.\n- Root: غرر (Gh-R-R)\n  * Al-Raghib (Mufradat): \"الاغترار\" is self-deception through heedlessness (ghiflah), as in {لَا يَغُرَّنَّكُمْ بِاللَّهِ الْغَرُورُ} — the delusion of assuming divine favor without due action.\n  * Al-Zamakhshari (Asas): Literal: a state of being deceived by a mirage; metaphorical: the fool's reliance on hope (rajā') without labor, akin to a farmer who neglects sowing yet expects harvest.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic structure in \"عليه خير كثير\" and \"عليه حوض\" allows fronting of the prepositional phrase for emphasis, highlighting the abundance and honor bestowed upon the Prophet (ﷺ).","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"}],"42":[{"arabic":"دونه وادعى الإجماع فيه واستدل بأدلة تشعر بنقيض غرضه كقوله تعالى {الذين آمنوا وعملوا الصالحات} إذ هذا يدل على أن العمل وراء الإيمان لا من نفس الإيمان وإلا فيكون العمل في حكم المعاد والعجب أنه ادعى الإجماع في هذا وهو مع ذلك ينقل قوله صلى الله عليه وسلم لا يكفر أحد إلا بعد جحوده لما أقر به (1) وينكر على المعتزلة قولهم بالتخليد في النار بسبب الكبائر والقائل بهذا قائل بنفس مذهب المعتزلة إذ يقال له من صدق بقلبه وشهد بلسانه ومات في الحال فهل هو في الجنة فلا بد أن يقول نعم وفيه حكم بوجود الإيمان دون العمل فنزيد ونقول لو بقي حيا حتى دخل عليه وقت","english":"He was asked, \"Which deed is most excellent?\" The Prophet (peace and blessings be upon him) said: \"Islam.\" It was then asked, \"Which aspect of Islam is most excellent?\" He (peace and blessings be upon him) said: \"Faith (Īmān).\" This is evidence for both the distinction (ikhtilāf) between the two terms and their overlap (tadākhul). This usage is the most consistent with the conventions of the language, because faith is a deed among deeds, and it is the most excellent of them. Islam is submission (taslīm), whether by the heart, by the tongue, or by the limbs. The most excellent of these is that which is by the heart, which is the assent (taṣdīq) that is called faith. Using the two terms in a way that indicates distinction, overlap, or even complete synonymy (tarāduf) is all within the bounds of metaphorical usage (tajawwuz) in the language.","book_title":"Foundations of Belief","section_title_ar":"Section 99","section_title_en":"The Book of the Revival of the Religious Sciences — Section 99: On the Distinction, Overlap, and Synonymy of Faith (Īmān) and Submission (Islām), and Their Worldly and Otherworldly Judgments","section_index":99,"anchors":"- Root: ايم (A-Y-M)\n  * Lisan / Ayn: Core meaning of remaining unmarried, or a state of being without a spouse; extended metaphorically to describe one who is solitary or without support.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها... والحرب مأيمة، أي: يفرق بين الزوج والزوجة.\" The root carries the sense of separation or a state of lacking union, which informs the theological discussion of what constitutes the essential bond of faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the state of being unmarried; metaphorical (Majaz) usage extends to anything that separates or leaves one bereft. This distinction between literal and metaphorical application is central to the chapter's method.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه... والانقلاب: الانصراف.\" The heart (qalb) is so named for its constant fluctuation and turning. In theological terms, it is the seat of taṣdīq (assent), the immaterial faculty of cognition and conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is physical turning; metaphorical (Majaz) usage is \"قلب الأمور\" — to deliberate, scrutinize, and manage affairs. This supports the distinction between the heart's internal act of assent and the external acts of the limbs.\n- Root: عمل (ʿ-A-M-L)\n  * Lisan / Ayn: Any deed or action performed with purpose and intent.\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد، فهو أخص من الفعل.\" Work is more specific than mere action, as it implies deliberate, intentional agency. It is used for both righteous and sinful deeds, and is the external manifestation of internal conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to physical labor or deeds. The chapter explores whether \"work\" is an integral part of the reality of faith or a separate, consequent requirement.\n- Root: صدق (S-D-Q)\n  * Lisan / Ayn: To be truthful, to speak the truth, to verify.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول.\" Truth and falsehood are primarily properties of speech and reports. Taṣdīq (assent) is the heart's affirmation of the truth of a report, which is the core reality of Īmān.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is truthful speech; metaphorical (Majaz) usage is \"صادق الحملة\" — one who is true and firm in battle or resolve. This shows that taṣdīq is not merely verbal but a firm, internal resolution.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication). This rule governs how restriction (ḥaṣr) is achieved in Arabic, often through particles like \"innamā\" or through contextual specification (takhṣīṣ). The chapter's core argument hinges on how terms like Īmān and Islām are semantically restricted, expanded, or made synonymous through contextual usage (majāz), requiring precise parsing of the predicate and its scope.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'","badge":"Insight"}],"43":[{"arabic":"تنعموا فلا تبأسوا أبدا فذلك قوله عز وجل ونودوا أن تلكم الجنة أورثتموها بما كنتم تعلمون (1) ومهما أردت أن تعرف صفة الجنة فاقرأ القرآن فليس وراء بيان الله تعالى بيان واقرأ من قوله تعالى لمن خاف مقام ربه جنتان إلى آخر سورة الرحمن واقرأ سورة الواقعة وغيرها من السور وإن أردت أن تعرف تفصيل صفاتها من الأخبار فتأمل الآن تفصليها بعد أن اطلعت على جملتها وتأمل أولا عدد الجنان قال رسول الله صلى الله عليه وسلم في قوله تعالى {ولمن خاف مقام ربه جنتان} قال جنتان من فضة آنيتهما وما فيهما وجنتان من ذهب آنيتهما وما فيهما وما بين القوم وبين أن ين","english":"...of death, hunger, thirst, and all other kinds of calamities, he would be worthy of abandoning this world because of them, and of not preferring it over that whose cutting-off and vexation are of its very necessity. How [could he prefer it], when its people — the kings — are secure, and in varieties of joy are delighting? For them therein is all they desire, and every day they attend at the courtyard of the Throne, and gaze upon the noble Face of Allah. They attain, through that gazing upon Allah, that which makes them not look, along with it, at the rest of the delights of the Gardens, nor do they turn aside. They are perpetually moving among these kinds of blessings, and they are secure from their passing away. Abu Hurayrah said: The Messenger of Allah, peace and blessings be upon him, said: \"A herald will call out: 'O People of Paradise! Verily for you is that you be healthy and never be ill; and for you is that you live and never die; and for you is that you be young and never grow old; and for you is that you be in bliss and never suffer misery.'\" That is the saying of Allah, Mighty and Majestic: {«And they will be called: 'This is the Paradise which you have been made to inherit for what you used to do'»} (7:43).","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1352","section_title_en":"The Description of Paradise: Its Gates, Rivers, and the Bliss of Its Inhabitants","section_index":1352,"anchors":"- Root: نعم (n-'-m)\n  * Lisan / Ayn: Core root denotes ease, comfort, and the state of well-being; al-Ayn notes it is also a name for the leopard and panther, indicating swiftness and grace.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — the goodly state; \"النعيم\" is the enduring, perfect form of bliss, specifically tied to divine reward in the afterlife.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"نعم عيشه\" — a life of ease and pleasantness. Metaphorical (Majaz): \"خفّت نعامتهم\" — their prosperity departed, showing the root's extension to transient worldly goods, contrasted here with eternal Paradise.\n- Root: اهل (a-h-l)\n  * Lisan / Ayn: Core root signifies those united by kinship, dwelling, or faith; al-Ayn notes it also refers to the prominent part of a beast's back, implying a place of honor and rest.\n  * Al-Raghib (Mufradat): \"أهل الرجل: من يجمعه وإياهم نسب أو دين\" — the people of a man are those joined by lineage or religion; \"أهل الجنة\" (the People of Paradise) are thus bound by the covenant of faith and divine favor.\n  * Al-Zamakhshari (Asas): Literal: \"رجعوا إلى أهاليهم\" — returning to one's family. Here, the \"أهل الجنة\" are the inhabitants of Paradise, addressed by the herald as a household of eternal blessedness.\n- Root: باب (b-a-b)\n  * Lisan / Ayn: Core root denotes a door or gateway; al-Ayn links it to \"إبهام\" (obscurity/concealment), as a door hides what lies within until opened.\n  * Al-Raghib (Mufradat): \"الباب\" is the means of access to a thing; in the Quranic context, the gates of Paradise are the entry points to divine mercy, each corresponding to a specific act of obedience.\n  * Al-Zamakhshari (Asas): Literal: physical gates of a city or house. Metaphorical: \"أبواب الجنة\" are the spiritual avenues of righteous deeds (prayer, fasting, charity, jihad) through which the believer enters divine reward.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule permits separation between a preposition and its governed noun for rhetorical emphasis, as seen in \"لهم فيها كل ما يشتهون\" (for them therein is all they desire), where \"لهم\" is fronted for exclusivity and \"فيها\" interposed to stress the locus of bliss.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'","badge":"Afterlife"},{"arabic":"إلا الله والله أكبر سبع مرات وقال الحمد لله الذي هدانا لهذا وما كنا لنهتدي لولا أن هدانا الله اللهم أنت الحامل على الظهر وأنت المستعان على الأمور السادسة في النزول والسنة أن لا ينزل حتى يحمى النهار ويكون أكثر سيره بالليل قال صلى الله عليه وسلم عليكم بالدلجة فإن الأرض تطوي بالليل ما لا تطوي بالنهار (3) وليقلل نومه بالليل حتى يكون عونا على السير ومهما أشرف على المنزل فليقل اللهم رب السموات السبع وما أظللن ورب الأرضين السبع وما أقللن ورب الشياطين وما أضللن ورب الرياح وما ذرين ورب البحار وما جرين أسالك خير هذا ا","english":"He ought to seek out a righteous companion, one who loves goodness and assists in it: if he forgets, the companion reminds him; if he remembers, the companion aids him; if he fears, the companion emboldens him; if he weakens, the companion strengthens him; if his breast narrows, the companion enlarges his patience. He should bid farewell to his resident companions, his brothers, and his neighbors — taking leave of them and seeking their supplications, for God Most High places goodness in their prayers. The Sunnah of farewell is to say: «أستودع الله دينك وأمانتك وخواتيم عملك» — \"I entrust to God your religion, your trustworthiness, and the seal of your deeds.\" And he, peace and blessings be upon him, used to say to one intending travel: \"In God's protection and His care — may God provide you with piety, forgive your sin, and direct you toward goodness wherever you may be.\"","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 199","section_title_en":"The Book of the Etiquette of Travel — Section 199: On the Comprehensive Etiquette of the Journey (From Provisioning to Guarding)","section_index":199,"anchors":"- Root: س ف ر (S-F-R)\n  * Lisan / Ayn: \"السفر: كشف الغطاء\" — unveiling, uncovering; the traveler is one who uncovers the veils of distant lands.\n  * Al-Raghib (Mufradat): \"السفر: كشف الغطاء، ويختص ذلك بالأعيان\" — the journey is a literal uncovering of horizons, yet the spiritual journey unveils the soul's veils.\n  * Al-Zamakhshari (Asas): Haqiqah: \"سافر سفرا بعيدا\" (to travel far); Majaz: \"وجه مسفر: مشرق سرورا\" — a face radiant with joy, as the traveler's face brightens with divine trust.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — governing the permissible separation between the preposition and its object for rhetorical emphasis, as in the supplications' structural pauses.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Remembrance of Death and Afterlife'","badge":"Du'a"}],"44":[{"arabic":"فلان ويا فلان وقد سماهم النبي صلى الله عليه وسلم هل وجدتم ما وعد ربكم حقا فإني وجدت ما وعدني ربي حقا (4) فسمع عمر رضي الله عنه قوله صلى الله عليه وسلم فقال يا رسول الله كيف يسمعون وأنى يجيبون وقد جيفوا فقال صلى الله عليه وسلم والذي نفسي بيده ما أنتم بأسمع لكلامي منهم ولكنهم لا يقدرون أن يجيبوا والحديث في الصحيح هذا قوله صلى الله عليه وسلم في المشركين فأما المؤمنون والشهداء فقد قال صلى الله عليه وسلم أرواحهم في حواصل طيور خضر معلقة تحت العرش (5) وهذه الحالة وما أشير بهذه الألفاظ إليه لا ينافي ذكر الله عز وجل وقال تعالى","english":"If, therefore, he had grown intimate with it, he delights in it and takes pleasure in the cessation of the impediments that had diverted him from it. For the pressing necessities of needs in this worldly life divert one from the remembrance of God, may He be mighty and majestic, and after death no impediment remains. It is as if he has been left alone with his Beloved, and so his joy is immense, and he is delivered from the prison in which he had been prevented from that which was his source of intimacy. For this reason, he, peace and blessings be upon him, said: \"The Holy Spirit (Rūḥ al-Qudus) breathed into my heart: Love whom you will, for you shall surely part from him.\" {«أحبب من أحببت فإنك مفارقه»} By this he intended everything connected to this world, for that perishes with respect to him at death. For {«كل من عليها فان * ويبقى وجه ربك ذو الجلال والإكرام»} [Everything upon it is perishing, and there remains the Face of your Lord, Possessor of Majesty and Honor]. And this world only perishes with respect to him at death, until it perishes in itself when the Book reaches its appointed term.","book_title":"On Invocations and Supplications","section_title_ar":"Section 240","section_title_en":"Section 240 — The Station of Remembrance (Dhikr): On the Transformation of Habit into Nature, the Intimacy of Remembrance After Death, and the Excellence of Martyrdom as the Seal of One's State","section_index":240,"anchors":"- Root: ألف (Alifa)\n  * Lisan / Ayn: Core meaning of reconciliation, familiarity, and the formation of habit through repeated engagement.\n  * Al-Raghib (Mufradat): The theological nuance of 'uns' (intimacy) as the soul's acquired disposition of comfort in the presence of its Beloved, contrasting with 'wahsha' (estrangement).\n  * Al-Zamakhshari (Asas): Distinguishes the literal sense of social familiarity from the metaphorical (majaz) sense of the heart's deep-seated repose in the remembrance of God, which becomes a 'second nature' (ṭabʿan ākhara).\n- Root: ختم (Khatama)\n  * Lisan / Ayn: To seal, stamp, or conclude; the final impression left upon a thing.\n  * Al-Raghib (Mufradat): The theological sense of the 'seal' (khātima) of one's life—the terminal state upon which one departs from the world and which determines the nature of the afterlife.\n  * Al-Zamakhshari (Asas): The literal act of sealing a document versus the metaphorical designation of one's final spiritual condition as the determining factor of one's eternal outcome.\n- Root: شهد (Shahida)\n  * Lisan / Ayn: To witness, to be present, to testify.\n  * Al-Raghib (Mufradat): The specific theological elevation of 'shahāda' (martyrdom) as the ultimate act of witnessing the truth of God through the sacrifice of one's own life, rendering the martyr a living witness (shahīd).\n  * Al-Zamakhshari (Asas): The literal sense of legal testimony versus the metaphorical reality of the martyr whose very being testifies to the sincerity of his devotion, being 'alive' with his Lord.\n- Root: قطع (Qata'a)\n  * Lisan / Ayn: To sever, cut off, or detach.\n  * Al-Raghib (Mufradat): The essential spiritual operation of severing worldly attachments ('alā'iq) to achieve the unadulterated focus of the heart upon God.\n  * Al-Zamakhshari (Asas): The literal cutting of a physical tie versus the metaphorical severance of all internal and external impediments that distract the soul from its sole Beloved.\n- Sibawayh Rule: Rule of Restriction and Specification (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — Governing how the exclusive focus of the martyr's intention is syntactically and logically restricted to God alone, as exemplified in the phrase \"no god but God\" (lā ilāha illā Allāh), which requires the complete negation of all other objects of intention before affirming the sole Divine Object.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'","badge":"Insight"},{"arabic":"وقال بعض العلماء إن العبد ليتلو القرآن فيلعن نفسه وهو لا يعلم يقول {ألا لعنة الله على الظالمين} وهو ظالم نفسه ألا لعنة الله على الكاذبين وهو منهم وقال الحسن إنكم اتخذتم قراءة القرآن مراحل وجعلتم الليل جملا فأنتم تركبونه فتقطعون به مراحله وإن من كان قبلكم رأوه رسائل من ربهم فكانوا يتدبرونها بالليل وينفذونها بالنهار وقال ابن مسعود أنزل القرآن عليهم ليعملوا به فاتخذوا دراسته عملا إن أحدكم ليقرأ القرآن من فاتحته إلى خاتمته ما يسقط منه حرفا وقد أسقط العمل به وفي حديث ابن عمر وحديث جندب رضي الله عنهما لقد عشنا دهرا طويلا وأحدنا يؤتى الإي","english":"Anas ibn Mālik said: \"How many a reciter of the Qur'an there is, while the Qur'an curses him!\" And Maysarah al-Gharīb said: \"It is the Qur'an in the belly of the wicked one.\" And Abū Sulaymān al-Dārānī said: \"The Zabāniyah (the stern keepers of Hell) are swifter to seize the carriers of the Qur'an who disobey God — Mighty and Majestic is He — than they are to seize the worshippers of idols, when they disobey God — Glorified is He — after having received the Qur'an.\"","book_title":"Condemnation of Anger and Hatred","section_title_ar":"Section 222","section_title_en":"Section 222 — On the Condemnation of the Recitation of the Negligent","section_index":222,"anchors":"- Root: تلا (t-l-w)\n  * Lisan / Ayn: Core meaning of following in sequence, tracing footsteps; recitation as sequential articulation of words.\n  * Al-Raghib (Mufradat): Tilāwah implies following with obedience — the reciter who does not follow the recited command is not truly a tālī.\n  * Al-Zamakhshari (Asas): Literal: to follow behind. Metaphorical: the Qur'an \"follows\" or \"pursues\" its reciter — either blessing him or cursing him on the Day of Judgment.\n- Root: لعل (l-ʿ-n)\n  * Lisan / Ayn: To curse, to drive away from mercy, to banish.\n  * Al-Raghib (Mufradat): Laʿnah is expulsion from divine mercy; the Qur'an itself \"cursing\" its reciter is a metaphorical (majāz) attribution of the act to the Book, the actual agent being God.\n  * Al-Zamakhshari (Asas): Literal: imprecation. Metaphorical: the Qur'an's letters and verses standing as witnesses against the negligent reciter.\n- Root: حمل (ḥ-m-l)\n  * Lisan / Ayn: To carry, to bear; ḥāmil al-Qurʾān is one who bears the Qur'an by memorization.\n  * Al-Raghib (Mufradat): Carrying implies bearing its obligations, not merely its letters — the true carrier is he who carries its commands into action.\n  * Al-Zamakhshari (Asas): Literal: physical carrying. Metaphorical: bearing its legal responsibilities (takālīf).\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rhetorical structure of \"the Qur'an curses him\" employs an implied agentive construction where the grammatical subject is the Book itself, requiring the reader to parse the metaphorical agency without literal attribution.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Anger and Hatred'","badge":"Hadith"}],"50":[{"arabic":"ونكير وفي الميزان والصراط والحساب ومناظرات أهل النار وأهل الجنة في قولهم أفيضوا علينا من الماء أو مما رزقكم الله زعموا أن ذلك كله بلسان الحال وغلا آخرون في حسم الباب منهم أحمد بن حنبل رضي الله عنه حتى منع تأويل قوله كن فيكون وزعموا أن ذلك خطاب بحرف وصوت يوجد من الله تعالى في كل لحظة بعدد كون مكون حتى سمعت بعض أصحابه يقول إنه حسم باب التأويل إلا لثلاثة ألفاظ قوله","english":"The fifth [division] is that one expresses by the tongue of explicit statement (lisān al-maqāl) what belongs to the tongue of state (lisān al-ḥāl). The one of deficient understanding stops at the outward and believes it to be literal speech, while the one with insight into realities perceives the secret within it. This is like the saying of one who said: \"The wall said to the peg: 'Why have you split me?' It replied: 'Ask the one who strikes me — he did not leave me behind the stone that is behind me.'\" This is an expression of the tongue of state by the tongue of explicit statement.","book_title":"Foundations of Belief","section_title_ar":"Section 85","section_title_en":"The Fourth Division — Comprehension by Encounter and Taste (Al-Dhawq), and the Fifth Division — The Tongue of State (Lisān al-Ḥāl)","section_index":85,"anchors":"- Root: علم (ʿalima)\n  * Lisan / Ayn: Core root denotes the faculty of knowing, perceiving a thing's reality; encompasses both direct apprehension and judgment about existence.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence itself and judgment concerning it.\n  * Al-Zamakhshari (Asas): Distinguishes literal knowledge (maʿrifah) from awareness (shuʿūr); here, the distinction between superficial knowledge (ẓāhir) and realized knowledge (bāṭin) is rhetorical-metaphorical, not contradictory.\n- Root: ظهر (ẓahara)\n  * Lisan / Ayn: Core root denotes outwardness, visibility, strength of back; the ẓāhir is what is manifest and apparent.\n  * Al-Raghib (Mufradat): The ẓāhir is used metaphorically for the outward aspect of a thing, as opposed to its inner reality (bāṭin); the back (ẓahr) carries what is loaded upon it.\n  * Al-Zamakhshari (Asas - Majaz): \"قلبت الأمر ظهرا لبطن\" — turning a matter over, examining its outward and inward aspects; the ẓāhir is the shell (qishr) that contains and is completed by the inner kernel (lubb).\n- Root: وقع (waqaʿa)\n  * Lisan / Ayn: Core root denotes falling, occurring, befalling; a thing's occurrence and realization.\n  * Al-Raghib (Mufradat): \"الوقوع: ثبوت الشيء وسقوطه\" — occurrence is the establishment and falling of a thing; in Quranic usage, often associated with calamities and inevitable events.\n  * Al-Zamakhshari (Asas - Majaz): \"وقع الأمر حصل ووجد\" — the matter occurred, i.e., it became realized and existent; here, the \"occurrence\" of a state (ḥāl) is its actual realization in the soul, as opposed to mere intellectual assent before its descent.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure allows for separation between the operative word and its object to achieve rhetorical emphasis, mirroring the semantic distinction between outward apprehension and inward realization.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Foundations of Belief'","badge":"Afterlife"}],"52":[{"arabic":"وقال عز وجل {ولقد جئناهم بكتاب فصلناه على علم} وقال تعالى {فلنقصن عليهم بعلم} وقال عز وجل {بل هو آيات بينات في صدور الذين أوتوا العلم} وقال تعالى {خلق الإنسان علمه البيان} وإنما ذكر ذلك في معرض الامتنان وأما الأخبار فقال رسول الله صلى الله عليه وسلم من يرد الله به خيرا يفقهه في الدين ويلهمه رشده (1) وقال صلى الله عليه وسلم العلماء ورثة الأنبياء (2) ومعلوم أنه لا رتبة فوق النبوة ولا شرف فوق شرف الوراثة لتلك الرتبة وقال صلى الله عليه وسلم يستغفر للعالم ما في السموات والأرض (3) وأي منصب يزيد على","english":"How He, Glorified and Exalted, began with Himself, then seconded with the angels, and thirded with the people of knowledge — and sufficient for you is this as honor, excellence, splendor, and nobility. And God, Exalted, said: {«يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات»} — \"God will raise those who have believed among you and those who have been given knowledge, in degrees.\" Ibn ʿAbbās, may God be pleased with them both, said: For the scholars there are degrees above the believers, seven hundred degrees, and between each two degrees is a distance of five hundred years' journey.","book_title":"Book of Knowledge","section_title_ar":"Section 4","section_title_en":"The Book of Knowledge — Section 4: The Excellence of Knowledge and the Scholars","section_index":4,"anchors":"- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Core root meaning of knowing, perceiving a thing in its true reality; the act of apprehension and judgment.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment of existence or non-existence.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes genuine knowing; metaphorical (majāz) usage extends to signs, landmarks, and traces that guide to knowledge.\n- Root: درج (d-r-j)\n  * Lisan / Ayn: Degrees, steps, ascending stations; the root denotes gradation and progressive elevation.\n  * Al-Raghib (Mufradat): \"الدرجة نحو المنزلة، لكن يقال للمنزلة: درجة إذا اعتبرت بالصعود\" — a degree is a station considered by ascent, not horizontal extension.\n  * Al-Zamakhshari (Asas): Literal: physical steps of ascent. Metaphorical: \"لفلان درجة رفيعة\" — lofty rank; \"امش في مدارج الحق\" — walk in the paths of truth.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day denotes the time of the sun's rising to its setting, and may denote any period of time whatsoever.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"ذكر في أيام العرب كذا\" — historical battles and events; \"وذكرهم بأيام الله\" — His mighty deeds against the disbelievers.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication) — The particle \"innamā\" restricts and confines the predicate to the subject alone, as in {«إنما يخشى الله من عباده العلماء»}, where fear of God is restricted exclusively to the scholars.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'","badge":"Insight"}],"54":[{"arabic":"عليه القرآن فلم ينسه ويقرأ من سورة الأعراف هذه الآية إن ربكم الله الذي خلق السموات والأرض في ستة أيام إلى قوله قريب من المحسنين وآخر بني آسرائيل قل ادعوا الله الآيتين فإنه يدخل في شعاره ملك يوكل بحفظه فيستغفر له ويقرأ المعوذتين وينفث بهن في يديه ويمسح بهما وجهه وسائر جسده كذلك روي من فعل رسول الله صلى الله عليه وسلم (1) وليقرأ عشرا من أول الكهف وعشرا من آخرها وهذه الآي للاستيقاظ لقيام الليل وكان علي كرم الله وجهه يقول ما أرى أن رجلا مستكملا عقله ينام قبل أن يقرأ الآيتين من آخر سورة البقرة وليقل خمسا وعشرين مرة سبحان الله والحم","english":"Then it is recommended, after the salutation of the witr, that he say: \"Glory be to the King, the Most Holy, the Lord of the angels and the Spirit. You have enveloped the heavens and the earth with majesty and dominion. You have manifested Your might through power, and You have subdued the servants through death.\" It is related that he (peace and blessings be upon him) — until he died — most of his prayer was seated, except for the obligatory prayers (1). And he said to the one who prays seated: \"Half the reward of the one who prays standing,\" and to the one who sleeps: \"Half the reward of the one who prays seated\" (2). This indicates the validity of the supererogatory prayer in all states.","book_title":"Arrangement of Litanies","section_title_ar":"Section 264","section_title_en":"The Fourth and Fifth Wirds (Portions of Night Devotion): On Sleep and the Final Sixth of the Night","section_index":264,"anchors":"- Root: ليل (Layl)\n  * Lisan / Ayn: Night; the period of darkness from sunset to dawn; its plural forms include layālī and layalāt.\n  * Al-Raghib (Mufradat): Night is a divinely ordained sign (āyah) of Allah's power; sleep is described as a form of death (tawaffā) in the Qur'an, linking the nightly cycle to resurrection.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) for the astronomical night; metaphorical (majāz) for spiritual darkness or heedlessness.\n- Root: نوم (Nawm)\n  * Lisan / Ayn: Sleep; slumber; a state of rest.\n  * Al-Raghib (Mufradat): Sleep is \"death in a light form\" (al-mawt al-khafīf), and death is \"sleep in a heavy form\" (al-nawm al-thaqīl). Allah says: {«Allah takes the souls at the time of their death, and those that die not during their sleep»} (Q. 39:42).\n  * Al-Zamakhshari (Asas): Literal: bodily rest. Metaphorical: heedlessness (ghaflah) or spiritual inertia; \"the market slept\" means it stagnated.\n- Root: عله (Alaha/Ilah)\n  * Lisan / Ayn: To worship; to seek refuge; the root for ilāh (deity) and Allāh (the Supreme Deity).\n  * Al-Raghib (Mufradat): The root denotes the act of devotion and the object of ultimate veneration; al-ulūhiyyah is the state of being worshipped.\n  * Al-Zamakhshari (Asas): Literal: deity. Metaphorical: that which one is utterly devoted to or enslaved by (e.g., one's desires).\n- Root: الي (Alā/Yalū)\n  * Lisan / Ayn: To be occupied with; to manage; related to al-ālah (instrument) and ma'ālah (consequence).\n  * Al-Raghib (Mufradat): The root conveys the idea of returning to a state or being entrusted with a matter; al-ālah is that by which one accomplishes an affair.\n  * Al-Zamakhshari (Asas): Literal: instrumentality. Metaphorical: the means by which one draws near to Allah.\n- Sibawayh Rule: Restriction and Focused Predication (al-Ḥaṣr wa al-Taqyīd bi-innamā) — Used to distinguish the specific legal scope of actions (e.g., the witr prayer's status) and to restrict general statements to their precise conditions.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'","badge":"Du'a"},{"arabic":"والعالم الراسخ هو الذي يطلع على أن الشمس والقمر والنجوم مسخرات بأمره سبحانه وتعالى ومثال نظر الضعيف إلى حصول ضوء الشمس عقيب طلوع الشمس مثال النملة لو خلق لها عقل وكانت على سطح قرطاس وهي تنظر إلى سواد الخط يتجدد فتعتقد أنه فعل القلم ولا تترقى في نظرها إلى مشاهدة الأصابع ثم منها إلى اليد ثم منها إلى الإرادة المحركة اليد ثم منها إلى الكاتب القادر المريد ثم منه إلى خالق اليد والقدرة والإرادة فأكثر نظر الخلق مقصور على الأسباب القريبة السافلة مقطوع من الترقي إلى مسبب الأسباب فهذا أحد أسباب النهي عن النجوم وثانيها","english":"You may say: \"Knowledge is the apprehension of a thing as it is, and it is among the attributes of God, exalted be He. How then can a thing be knowledge, and while being knowledge, be blameworthy?\"","book_title":"Book of Knowledge","section_title_ar":"Section 25","section_title_en":"Section 25 — On the Exposition of the Manner in Which Some Sciences May Be Blameworthy, and the Exposition of the Alteration of the Names of the Sciences — Namely Jurisprudence (Fiqh), Knowledge (ʿIlm), Divine Unity (Tawḥīd), Reminder (Tadhkīr), and Wisdom (Ḥikmah) — and the Exposition of the Praiseworthy Measure of the Religious Sciences and the Blameworthy Measure Thereof","section_index":25,"anchors":"- Root: ع ل م (ʿ-l-m)\n  * Lisan / Ayn: Core root denotes the trace or mark by which a thing is known; ʿilm is the apprehension of a thing as it is (idrāk al-shayʾ ʿalā mā huwa bihi), encompassing both the perception of the thing's essence and the judgment of its attributes.\n  * Al-Raghib (Mufradat): ʿIlm is \"the apprehension of a thing by its reality\" (إدراك الشيء بحقيقته), divided into the apprehension of the thing's essence and the judgment upon it. As a divine attribute, it is not blameworthy in itself; blame attaches only to its relation to human subjects.\n  * Al-Zamakhshari (Asas): Distinguishes literal knowledge (ḥaqīqah) from the metaphorical extension whereby a \"learned\" man may be called ignorant when his knowledge harms him — the term ʿilm is transferred (manqūl) in blame contexts to denote what is not truly beneficial knowledge.\n- Root: س ب ب (s-b-b)\n  * Lisan / Ayn: The rope by which one climbs to the palm-tree; extended to any means by which one reaches a thing.\n  * Al-Raghib (Mufradat): \"Every means by which one arrives at a thing is called a sabab\" — thus the science of the properties of substances and stellar computations is a \"cause\" (sabab) that may lead to harm, and the means to evil is evil.\n  * Al-Zamakhshari (Asas): Literal usage denotes a physical cord or tie; metaphorical usage (majāz) extends to any instrumental cause, whether beneficial or harmful.\n- Root: ع ق ل (ʿ-q-l)\n  * Lisan / Ayn: The intellect as that which binds and restrains; its root sense is of a fetter or halter that prevents the soul from straying.\n  * Al-Raghib (Mufradat): The intellect is that by which one apprehends realities; its proper function is to lead one to the truth of prophecy, after which it must be restrained from independent speculation in matters beyond its scope.\n  * Al-Zamakhshari (Asas): Literal usage denotes the binding of the camel; metaphorical usage denotes the restraint of the soul from error.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (باب الحصر والتقييد بإنما) — When the author states \"knowledge is not blamed for its essence but only in relation to servants for one of three causes,\" the restriction (ḥaṣr) via \"innamā\" confines blame to the relational aspect, not the essence, requiring the translator to preserve this precise logical scope.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Book of Knowledge'","badge":"Hadith"}],"55":[{"arabic":"فليستجيبوا لي} وقال تعالى {ادعوا ربكم تضرعا وخفية إنه لا يحب المعتدين} وقال تعالى {وقال ربكم ادعوني أستجب لكم إن الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين} وقال عز وجل {قل ادعوا الله أو ادعوا الرحمن أيا ما تدعوا فله الأسماء الحسنى} وروى النعمان بن بشير عن النبي صلى الله عليه وسلم أنه قال إن الدعاء هو العبادة ثم قرأ ادعوني أستجب لكم (1) الآية وقال صلى الله عليه وسلم الدعاء مخ العبادة (2) وروى أبو هريرة أنه صلى الله عليه وسلم قال ليس شيء أكرم على الله عز وجل من الدعاء (3) وقال صلى الله عليه وسلم إ","english":"Allah the Exalted has said: {«وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ فَلْيَسْتَجِيبُوا لِي»} (And when My servants ask you concerning Me — indeed I am near. I respond to the invocation of the supplicant when he calls upon Me. So let them respond to Me — Qurʾan 2:186). And He the Exalted said: {«ادْعُوا رَبَّكُمْ تَضَرُّعًا وَخُفْيَةً إِنَّهُ لَا يُحِبُّ الْمُعْتَدِينَ»} (Call upon your Lord in humility and privately; indeed, He does not like transgressors — Qurʾan 7:55). And He the Exalted said: {«وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ إِنَّ الَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِي سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ»} (And your Lord said: Call upon Me; I will respond to you. Indeed, those who disdain My worship will enter Hell humiliated — Qurʾan 40:60). And He, Glorified and Exalted, said: {«قُلِ ادْعُوا اللَّهَ أَوِ ادْعُوا الرَّحْمَنَ أَيًّا مَا تَدْعُوا فَلَهُ الْأَسْمَاءُ الْحُسْنَى»} (Say: Call upon Allah or call upon the Most Merciful. Whichever [name] you call — to Him belong the Most Beautiful Names — Qurʾan 17:110).","book_title":"On Invocations and Supplications","section_title_ar":"Section 241","section_title_en":"The Book of Invocation — Section 241: The Second Chapter on the Etiquette of Supplication (Duʿāʾ), Its Virtue, the Virtue of Certain Transmitted Supplications, the Virtue of Seeking Forgiveness (Istighfār), and Invoking Blessings upon the Messenger of Allah (Peace Be Upon Him)","section_index":241,"anchors":"- Root: دعو (Daʿā)\n  * Lisan / Ayn: \"الدعاء: الرغبة إلى الله تعالى، والاستعانة به. وأصل الدعو: الإقبال على الشيء بالرغبة والطلب. والدعوة: الكلمة التي يدعو بها. والمدعوّ: الذي يجيب. والداعي: الفاعل. واستدعاه: طلب منه الدعاء.\"\n  * Al-Raghib (Mufradat): \"الدعاء: الرغبة إلى الله تعالى في قضاء الحاجة، وهو ضربان: دعاء عبادة، ودعاء مسألة. فدعاء العبادة: هو التوجه إلى الله تعالى بالطاعة والإخلاص، ودعاء المسألة: هو طلب الحاجة. قال تعالى: {وقال ربكم ادعوني أستجب لكم} — فجعل الدعاء عبادة، إذ قال: {إن الذين يستكبرون عن عبادتي} فعطف العبادة على الدعاء، فدلّ على أنهما واحد.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"دعوته دعواً ودعاءً: ناديته وصحت به. ودعا الله: ابتهل إليه بالسؤال. ودعا الرجل: استنصره. ودعا الناقة: استدبرها.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"الدعاء في العبادة: استعارة من دعاء المسألة، لأن العابد كأنه يسأل الله الثواب والقبول. ومنه قوله تعالى: {إن الذين يستكبرون عن عبادتي} — أي عن دعائي، فسمّى العبادة دعاءً.\"\n\n- Root: سحر (Saḥara)\n  * Lisan / Ayn: \"السحر: طرف الحلقوم والرئة. وقيل: السحر: آخر الليل عند الصبح. والسحور: الأكل في السحر. والسحرة: السحر الأخير من الليل.\"\n  * Al-Raghib (Mufradat): \"السحر يقال على معان: الأول: الخداع وتخييلات لا حقيقة لها... والثاني: وقت السحر، وهو آخر الليل، سمي بذلك لأنه وقت يكون فيه تنفس الصعداء واسترواح من ظلمة الليل، أو لأنه وقت خفاء الناس وسكون الأصوات.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"لقيته سحراً وسحرة وبالسحر وفي أعلى السحرين وهما سحر مع الصبح وسحر قبله.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"السحر في قوله تعالى: {وبالأسحار هم يستغفرون} — هو الوقت الأخير من الليل، وهو أشرف الأوقات للدعاء، لأنه وقت غفلة الناس وخلوة القلب.\"\n\n- Root: عرف (ʿArafa)\n  * Lisan / Ayn: \"العرف: الطيب. والمعرفة: العلم بالشيء على وجه التدبر. وعرفة: جبل بمكة، سمي بذلك لأن الناس يتعارفون فيه، أو لأن جبريل عليه السلام عرّف إبراهيم المناسك فيه.\"\n  * Al-Raghib (Mufradat): \"عرفة: اسم للموقف الذي يقف فيه الحجاج، سمي بذلك لأن آدم وحواء تعارفا فيه بعد الهبوط، وقيل: لأن جبريل عرّف إبراهيم المناسك فيه.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"يوم عرفة: اليوم التاسع من ذي الحجة، وهو يوم الموقف.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"عرفة في قولهم: يوم عرفة — اسم للموقف، سمي بذلك لتعارف الناس فيه، أو لتعريف جبريل إبراهيم المناسك.\"\n\n- Root: غفر (Ghafara)\n  * Lisan / Ayn: \"المغفرة: ستر الذنب والتجاوز عنه. والغفر: الستر. والمغفر: ما يستر الرأس في الحرب. والغفور: الكثير المغفرة.\"\n  * Al-Raghib (Mufradat): \"الغفران: ستر الذنب والتجاوز عنه، وأصله من الغفر وهو الستر. قال تعالى: {وإن تغفر لهم فإنك أنت العزيز الحكيم}. والاستغفار: طلب المغفرة، وهو ضربان: استغفار باللسان، واستغفار بالقلب واللسان معاً، وهو النافع.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"غفرت الذنب غفراً ومغفرة: سترته وتجاوزت عنه. واستغفرت الله: طلبت مغفرته.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"الاستغفار باللسان مع الإصرار: استعارة للكذب، لأن المستغفر الحقيقي هو التائب المقلع عن الذنب.\"\n\n- Root: صلو (Ṣalā)\n  * Lisan / Ayn: \"الصلاة: الدعاء، وقيل: العبادة، وقيل: الرحمة من الله، والاستغفار من الملائكة. والصلاة من الله: الرحمة، ومن الملائكة: الاستغفار، ومن المؤمنين: الدعاء.\"\n  * Al-Raghib (Mufradat): \"الصلاة في الأصل: الدعاء، قال تعالى: {صلوا عليه وسلموا تسليماً} — أي ادعوا له. ثم غلب استعمالها في العبادة المخصوصة، والصلاة من الله: الرحمة، ومن الملائكة: الاستغفار.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"الصلاة: الدعاء. ومنه قوله تعالى: {وصل عليهم إن صلاتك سكن لهم} — أي ادع لهم.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"الصلاة على النبي صلى الله عليه وسلم: استعارة للدعاء له بالرحمة والتعظيم، لأن أصل الصلاة الدعاء.\"\n\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication)\n  * Governing Rule: \"إنما\" تفيد الحصر والقصر، فإذا قيل: \"إن الدعاء هو العبادة\" — فالمبتدأ والخبر معرفتان، والجملة تفيد الحصر والتأكيد. وإذا قيل: \"الدعاء مخ العبادة\" — فالإسناد فيه تشبيه بليغ، حيث شبه الدعاء بالمخ الذي هو لبّ العظم وجوهره، فالدعاء هو اللبّ والجوهر الحقيقي للعبادة.\n\n---\n\n##","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'","badge":"Hadith"}],"56":[{"arabic":"والإحسان وقال سبحانه إن رحمت الله قريب من المحسنين ونعني بالإحسان فعل ما ينتفع به المعامل وهو غير واجب عليه ولكنه تفضل منه فإن الواجب يدخل في باب العدل وترك الظلم وقد ذكرناه وتنال رتبة الإحسان بواحد من ستة أمور الأول في المغابنة فينبغي أن لا يغبن صاحبه بما لا يتغابن به في العادة فأما أصل المغابنة فمأذون فيه لأن البيع للربح ولا يمكن ذلك إلا بغبن ما ولكن يراعي فيه التقريب فإن بذل المشتري زيادة على الربح المعتاد إما لشدة رغبته أو لشدة حاجته في الحال إليه فينبغي أن يمتنع من قبوله فذلك من الإح","english":"God (Exalted is He) has commanded both justice (al-ʿadl) and excellence (al-iḥsān) together. Justice is only the cause of deliverance (al-najāh), and it runs in trade as the course of capital (raʾs al-māl). Excellence is the cause of triumph (al-fawz) and the attainment of felicity (al-saʿādah), and it runs in trade as the course of profit (al-ribḥ). None is counted among the heedless who is content in his worldly transactions with merely his capital — and so likewise in the transactions of the Hereafter. Thus it behooves the religious person not to restrict himself to justice and the avoidance of wrongdoing (ẓulm), abandoning the doors of excellence. God has said: {«وَأَحْسِنْ كَمَا أَحْسَنَ اللَّهُ إِلَيْكَ»} (\"And do good as God has done good to you\") {«إِنَّ اللَّهَ يَأْمُرُ بِالْعَدْلِ وَالْإِحْسَانِ»} (\"Indeed, God commands justice and excellence\"), and He (Exalted is He) has said: {«إِنَّ رَحْمَتَ اللَّهِ قَرِيبٌ مِنَ الْمُحْسِنِينَ»} (\"Indeed, the mercy of God is near to the doers of excellence\").","book_title":"Etiquette of Earning","section_title_ar":"Section 328","section_title_en":"Chapter Four: On Excellence (Iḥsān) in Transactional Dealings","section_index":328,"anchors":"- Root: ع د ل (ʿadala)\n  * Lisan / Ayn: Core meaning of equality, straightness, and balance; the root denotes that which is level and even, without crookedness or deviation.\n  * Al-Raghib (Mufradat): \"العدالة والمعادلة: لفظ يقتضي معنى المساواة\" — justice is that which is perceived by inner insight (al-baṣīrah), pertaining to judgments and rulings; it is the equitable apportioning of things on an even scale.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage pertains to physical evenness and moderation (e.g., a horse with an even blaze); metaphorical (majāz) extension applies to moral and legal equity.\n- Root: ر ب ح (rabiḥa)\n  * Lisan / Ayn: Gain, profit, increase in trade; the root signifies surplus and augmentation.\n  * Al-Raghib (Mufradat): \"الربح: الزيادة الحاصلة في المبايعة، ثم يتجوز به في كل ما يعود من ثمرة عمل\" — profit is the increase occurring in exchange, then metaphorically extended to every fruit that returns from a deed.\n  * Al-Zamakhshari (Asas): Literal usage in commerce; metaphorical usage: \"تجارة رابحة\" — a profitable transaction, extended to spiritual commerce.\n- Root: و ق د (waqada)\n  * Lisan / Ayn: Fire blazing and burning fiercely; kindling.\n  * Al-Raghib (Mufradat): Fire that burns; used in the Qur'an for the fuel of Hellfire.\n  * Al-Zamakhshari (Asas): Literal: fire blazing; Metaphorical: \"قلب وقاد\" — a blazing, keen intellect; \"وقدة الصيف\" — the intense heat of summer.\n- Sibawayh Rule: Chapter on the Interposition between the Preposition and its Object (Bāb al-Faṣl bayn al-Jār wa al-Majrūr) — governing the permissible separation between grammatical operators and their operands for rhetorical emphasis, as in the periodic construction of conditional and exceptive clauses.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Earning'","badge":"Insight"},{"arabic":"اقتصر ذكر شرطا جامعا فقال تعالى إن رحمة الله قريب من المحسنين فالإحسان يجمع الكل وهكذا من يتصفح القرآن من أوله إلى آخره ومن فهم ذلك فجدير بأن يكون حاله الخشية والحزن ولذلك قال الحسن والله ما أصبح اليوم عبد يتلو القرآن يؤمن به إلا كثر حزنه وقل فرحه وكثر بكاؤه وقل ضحكه وكثر نصبه وشغله وقلت راحته وبطالته وقال وهيب بن الورد نظرنا في هذه الأحاديث والمواعظ فلم نجد شيئا أرق للقلوب ولا أشد استجلابا للحزن من قراءة القرآن وتفهمه وتدبره فتأثر العبد بالتلاوة أن يصير بصفة الآية المتلوة فعند الوعيد وتقييد المغفرة بالشر","english":"[Root: ذكر]\n  • Al-Raghib (Al-Mufradat): \"الذكر: حضور الشيء القلب أو القول، ويكون تارة بالقلب وتارة باللسان، والذكر باللسان تارة يكون حضور المعنى وبعده، وقد يقال: ذكرته إذا جرى على لسانه وإن لم يحضره قلبه، والذكر بالقلب هو حضور المعنى، قال تعالى: ولا تطع من أغفلنا قلبه عن ذكرنا [الكهف/ 28]\"\n  • Al-Zamakhshari (Asas - Haqiqah/Literal): \"ذكرت الشيء: نطقت به أو استحضرته بقلبك. وذكرت فلانا بخير وشر. واذكروا الله ذكرا كثيرا. والذكر: الشرف والصيت، قال تعالى: وإنه لذكر لك ولقومك [الزخرف/ 44]\"\n  • Al-Zamakhshari (Asas - Majaz/Metaphorical): \"الذكر: الكتاب الذي فيه تذكير الناس، قال تعالى: وأنزلنا إليك الذكر لتبين للناس ما نزل إليهم [النحل/ 44]، والذكر: القرآن، قال تعالى: إنا نحن نزلنا الذكر وإنا له لحافظون [الحجر/ 9]\"","book_title":"Etiquette of Quran Recitation","section_title_ar":"Section 229","section_title_en":"Section 229","section_index":229,"anchors":"*(Anchors established)*","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'","badge":"Insight"}],"57":[{"arabic":"فأغاروا بجمعهم وقوله تعالى فأنزلنا به الماء يعني السحاب فأخرجنا به من كل الثمرات يعني الماء وأمثال هذا في القرآن لا ينحصر ومنها التدريج في البيان كقوله عز وجل شهر رمضان الذي أنزل فيه القرآن إذ لم يظهر به أنه ليل أو نهار وبان بقوله عز وجل إنا أنزلناه في ليلة مباركة ولم يظهر به أي ليلة فظهر بقوله تعالى إنا أنزلناه في ليلة القدر وربما يظن في الظاهر الاختلاف بين هذه الآيات فهذا وأمثاله مما لا يغني فيه إلا النقل والسماع فالقرآن من أوله إلى آخره غير خال عن هذا الجنس لأنه أنزل بلغة العرب فكان مشتملا على أصناف كلامهم من إيجاز وتطو","english":"I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"","book_title":"Etiquette of Quran Recitation","section_title_ar":"Section 233","section_title_en":"The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation","section_index":233,"anchors":"- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Quran Recitation'","badge":"Hadith"}],"59":[{"arabic":"إلى قومه فقال يا قوم أسلموا فإن محمدا يعطي عطاء من لا يخاف الفاقة (1) وقال ابن عمر قال صلى الله عليه وسلم إن لله عبادا يخصهم بالنعم لمنافع العباد فمن بخل بتلك المنافع على العباد نقلها الله تعالى عنه وحولها إلى غيره (2) حديث الهلالي أتى النبي صلى الله عليه وسلم بأسرى من بني العنبر فأمر بقتلهم وأفرد منهم رجلا الحديث وفيه فإن الله شكر له سخاء فيه لم أجد له أصلا (3) حديث إن لكل شيء ثمرة وثمرة المعروف تعجيل السراح لم أقف له على أصل (4) حديث نافع عن ابن عمر طعام الجواد دوا","english":"I say: Know that the Prophet (peace be upon him) was asked by a man, and he gave him and bestowed upon him. Then another man came and asked him, and he ordered that he be given abundant sheep filling the space between two mountains, from the sheep of the alms-collection. The man returned to his people and said: \"O my people, embrace Islam, for Muhammad gives the gift of one who does not fear poverty.\" (1)","book_title":"Condemnation of Miserliness and Love of Wealth","section_title_ar":"Section 764","section_title_en":"The Revival of the Religious Sciences — Section 764: On Generosity and the Bounty of God","section_index":764,"anchors":"- Root: ع ط و (ʿ-ṭ-w)\n  * Lisan / Ayn: Core meaning of giving, bestowing, and extending; al-ʿaṭāʾ is the gift itself, and the verb ʿaṭā signifies the act of reaching out with something to another.\n  * Al-Raghib (Mufradat): Theological nuance: al-ʿaṭāʾ in the divine context is the emanation of bounty (al-jūd) from the Creator to creation, unconstrained by need or requital; it is an act of pure beneficence.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): physical extension of the hand in giving. Metaphorical (majāz): the bestowal of favor, rank, or mercy, as in \"the king gave to the petitioner.\"\n- Root: س خ و (s-kh-w)\n  * Lisan / Ayn: Core meaning of liberality and open-handedness; al-sakhāʾ is the natural disposition of giving freely without reluctance.\n  * Al-Raghib (Mufradat): Theological nuance: al-sakhāʾ is the virtue opposed to al-bukhl (miserliness); it is the soul's readiness to part with what it possesses for the sake of another, mirroring divine generosity.\n  * Al-Zamakhshari (Asas): Literal: spending wealth readily. Metaphorical: the heart's expansiveness and freedom from attachment to possessions.\n- Root: ب خ ل (b-kh-l)\n  * Lisan / Ayn: Core meaning of withholding and hoarding; al-bukhl is the restraint of what one owns from those who have a claim upon it.\n  * Al-Raghib (Mufradat): Theological nuance: al-bukhl is of two kinds—withholding one's own goods, and withholding what belongs to others (e.g., knowledge or authority); the latter is more blameworthy, as in {«Who are miserly and command people to miserliness»} (4:37).\n  * Al-Zamakhshari (Asas): Literal: refusal to give wealth. Metaphorical: the sky \"withholding\" rain, as in the verse of Abū Najm: \"when the sky is miserly with its rain.\"\n- Root: ن ع م (n-ʿ-m)\n  * Lisan / Ayn: Core meaning of ease, well-being, and bounty; al-niʿmah is the state of being in a favorable condition, and al-naʿīm is the abundance of such states.\n  * Al-Raghib (Mufradat): Theological nuance: al-niʿmah is the goodly state (al-ḥālah al-ḥasanah) bestowed by God; it is a genus term covering both the little and the much, as in {«If you count the blessings of God, you cannot number them»} (16:18).\n  * Al-Zamakhshari (Asas): Literal: pleasant living and comfort. Metaphorical: \"their ostriches have departed\" (khafat naʿāmatuhum)—i.e., their prosperity has vanished, using the ostrich as a symbol of swift departure.\n- Sibawayh Rule: Rule of Prepositional Interposition (bāb al-faṣl bayna al-jār wa-al-majrūr) — The permissibility of separating the preposition from its object for rhetorical emphasis, as in the prophetic idiom \"giving the gift of one who does not fear poverty,\" where the syntactic structure underscores the absolute nature of the act.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Miserliness and Love of Wealth'","badge":"Hadith"}],"61":[{"arabic":"هبيرة اتق الله فإنه يوشك أن يأتيك رسول من رب العالمين يزيلك عن سريرك ويخرجك من سعة قصرك إلى ضيق قبرك فتدع سلطانك ودنياك خلف ظهرك وتقدم على ربك وتنزل على عملك يا ابن هبيرة إن الله ليمنعك من يزيد ولا يمنعك يزيد من الله وإن أمر الله فوق كل أمر وإنه لا طاعة في معصية الله وإني أحذرك بأسه الذي لا يرد عن القوم المجرمين فقال ابن هبيرة أربع على ظلعك أيها الشيخ وأعرض عن ذكر أمير المؤمنين فإن أمير المؤمنين صاحب العلم وصاحب الحكم وصاحب الفضل وإنما ولاه الله تعالى ما ولاه من أمر هذه الأمة لعلمه به وما يعلمه من ف","english":"He turned to al-Shaʿbī and said: \"O Abā ʿAmr! I am the trustee of the Commander of the Faithful over Iraq and his governor over it, and a man commanded to obedience. I have been tried with the subjects, and their right has become incumbent upon me. So I love to preserve them and to attend to what sets them right, along with sincere counsel (naṣīḥah) to them. And reports may reach me about a band of people from the regions concerning a matter, and I find myself severe against them therein, so I withhold a portion of their stipends and place it in the treasury (bayt al-māl), with the intention in myself that I shall return it to them. Then it reaches the Commander of the Faithful that I have withheld it in that manner, so he writes to me that I must not return it. I cannot then countermand his order, nor can I execute his letter [against my better judgment]. I am but a man commanded to obedience. Is there any liability upon me in this, and in similar matters, where the intention is as I have described?\"","book_title":"Enjoining Good and Forbidding Evil","section_title_ar":"Section 553","section_title_en":"The Upright Scholars Before the Tyrannical Rulers — Counsel and Fearless Truth-Telling","section_index":553,"anchors":"- Root: نصح (naṣaḥa)\n  * Lisan / Ayn: Core meaning is sincerity, faithfulness, and pure counsel free from deceit; the root denotes the act of seeking the welfare of another with complete integrity.\n  * Al-Raghib (Mufradat): In theological context, naṣīḥah is the obligation of the sincere advisor to guide the ruler toward divine truth, even at personal peril, as it is a form of worship (ʿibādah) and a trust (amānah).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes pure honey (ʿasal naṣīḥ) free from admixture; metaphorical (majāz) usage applies to counsel that is untainted by flattery or self-interest.\n- Root: سلط (sulṭ)\n  * Lisan / Ayn: Denotes authority, power, and dominion; the ruler (sulṭān) is one who has been given sway over affairs.\n  * Al-Raghib (Mufradat): In Kalam, sulṭān is a trial (ibtilāʾ) and a trust (amānah) from God, whose exercise demands justice (ʿadl) and whose neglect invites divine wrath.\n  * Al-Zamakhshari (Asas): Literal usage refers to physical power or a governing authority; metaphorical usage extends to the authority of proof (sulṭān al-burhān) that compels assent.\n- Root: عظ (waʿaẓa)\n  * Lisan / Ayn: Root denotes admonition, exhortation, and reminding of consequences; it implies softening the heart through remembrance of God and the Hereafter.\n  * Al-Raghib (Mufradat): In theological terms, ʿiẓah is the act of turning the soul away from transgression through a blend of fear (tarhīb) and hope (targhīb), grounded in revealed truth.\n  * Al-Zamakhshari (Asas): Literal usage is the verbal admonition; metaphorical usage is the admonition of circumstance (ʿiẓah al-ḥāl) when events themselves teach a lesson.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (bāb al-ḥaṣr wa al-taqyīd bi-innamā) — Governing the emphasis of exclusive predication in statements of counsel, such as \"No obedience to a creature in disobedience of the Creator,\" where the restriction (ḥaṣr) is achieved through negation and exception (nafy wa istithnāʾ).","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Enjoining Good and Forbidding Evil'","badge":"Insight"}],"63":[{"arabic":"الملائكة وقال تعالى أو عجبتم أن جاءكم ذكر من ربكم على رجل منكم الآية السبب الخامس الخوف من فوت المقاصد وذلك يختص بمتزاحمين على مقصود واحد فإن كان واحد يحسد صاحبه في كل نعمة تكون عونا له في الانفراد بمقصوده ومن هذا الجنس تحاسد الضرات في التزاحم على مقاصد الزوجية وتحاسد الأخوة في التزاحم على نيل المنزلة في قلب الأبوين للتوصل به إلى مقاصد الكرامة والمال وكذلك تحاسد التلميذين لأستاذ واحد على نيل المرتبة من قلب الأستاذ وتحاسد ندماء الملك وخواصه في نيل المنزلة من قلبه للتوصل به إلى المال والجاه وكذلك تحاسد الوا","english":"I say: God is Knower of what is in the breasts. {«إِنْ تَمْسَسْكُمْ حَسَنَةٌ تَسُؤْهُمْ»} — \"If good touches you, it grieves them\" {«وَدُّوا مَا عَنِتُّمْ قَدْ بَدَتِ الْبَغْضَاءُ مِنْ أَفْوَاهِهِمْ وَمَا تُخْفِي صُدُورُهُمْ أَكْبَرُ»} — \"They wish for your hardship; hatred has already appeared from their mouths, and what their breasts conceal is greater.\" And envy (ḥasad), arising from hatred, may lead to contention, mutual fighting, and the spending of one's entire life in removing another's blessing through stratagems, slander, the tearing of veils, and whatever runs in that course.","book_title":"Condemnation of Envy","section_title_ar":"Section 722","section_title_en":"The Revival of the Religious Sciences — Book on the Rebuke of the Self: The Seven Causes of Envy (Section 722)","section_index":722,"anchors":"- Root: سبب (sabab)\n  * Lisan / Ayn: The rope by which one climbs; every means by which one reaches a thing.\n  * Al-Raghib (Mufradat): \"Every means by which one arrives at something is called a sabab\" — thus the causes enumerated here are the psychological \"ropes\" by which envy ascends in the soul.\n  * Al-Zamakhshari (Asas): Literal: a physical cord. Metaphorical: any linkage or occasion — here, the inward occasions (asbāb) that give rise to ḥasad.\n- Root: بغض (bughḍ)\n  * Lisan / Ayn: Hatred, aversion of the heart.\n  * Al-Raghib (Mufradat): The opposite of love (maḥabbah); a disposition of the heart toward another's harm.\n  * Al-Zamakhshari (Asas): Literal: inner aversion. Metaphorical: its \"appearance from the mouths\" (Quranic) as outward speech betraying the concealed hatred.\n- Root: كبر (kibr)\n  * Lisan / Ayn: Greatness; pride; disdain.\n  * Al-Raghib (Mufradat): \"Al-kabīr and al-ṣaghīr are relative terms\" — pride is the claim to greatness relative to another, deeming oneself above him.\n  * Al-Zamakhshari (Asas): Literal: bigness in stature or age. Metaphorical: \"takabbara 'alayhi\" — to deem oneself greater than another and refuse submission to him.\n- Root: قصد (qaṣd)\n  * Lisan / Ayn: Straightness of path; intending a goal.\n  * Al-Raghib (Mufradat): \"Al-qaṣd: istiqāmat al-ṭarīq\" — the straight road; also moderation between extremes.\n  * Al-Zamakhshari (Asas): Literal: to head toward a place. Metaphorical: \"maqāṣid\" — the aims and objectives toward which one directs oneself; here, the worldly goals whose pursuit breeds rivalry and envy.\n- Root: نزل (nazal)\n  * Lisan / Ayn: To descend from a height; to alight.\n  * Al-Raghib (Mufradat): \"Al-nuzūl fī al-aṣl huwa inḥiṭāṭ min 'uluww\" — descent from above; the sending down of revelation.\n  * Al-Zamakhshari (Asas): Literal: descending from a high place. Metaphorical: \"anzala Allāhu al-kitāb\" — God's sending down of the Quran; and \"mā unzila\" — what was revealed, as in the Quranic citation regarding the Qurashites' objection to revelation upon a mere human.\n- Sibawayh Rule: Rule of Causal Coordination (al-'aṭf al-sababī) — The enumeration of the seven causes proceeds by coordinated clauses (fa-... thumma ...), each introduced as an independent proposition linked by causation (sabab), requiring the translator to preserve the logical sequence of psychological motivations without collapsing them into one another.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Envy'","badge":"Ethics"}],"67":[{"arabic":"هبيرة اتق الله فإنه يوشك أن يأتيك رسول من رب العالمين يزيلك عن سريرك ويخرجك من سعة قصرك إلى ضيق قبرك فتدع سلطانك ودنياك خلف ظهرك وتقدم على ربك وتنزل على عملك يا ابن هبيرة إن الله ليمنعك من يزيد ولا يمنعك يزيد من الله وإن أمر الله فوق كل أمر وإنه لا طاعة في معصية الله وإني أحذرك بأسه الذي لا يرد عن القوم المجرمين فقال ابن هبيرة أربع على ظلعك أيها الشيخ وأعرض عن ذكر أمير المؤمنين فإن أمير المؤمنين صاحب العلم وصاحب الحكم وصاحب الفضل وإنما ولاه الله تعالى ما ولاه من أمر هذه الأمة لعلمه به وما يعلمه من ف","english":"He turned to al-Shaʿbī and said: \"O Abā ʿAmr! I am the trustee of the Commander of the Faithful over Iraq and his governor over it, and a man commanded to obedience. I have been tried with the subjects, and their right has become incumbent upon me. So I love to preserve them and to attend to what sets them right, along with sincere counsel (naṣīḥah) to them. And reports may reach me about a band of people from the regions concerning a matter, and I find myself severe against them therein, so I withhold a portion of their stipends and place it in the treasury (bayt al-māl), with the intention in myself that I shall return it to them. Then it reaches the Commander of the Faithful that I have withheld it in that manner, so he writes to me that I must not return it. I cannot then countermand his order, nor can I execute his letter [against my better judgment]. I am but a man commanded to obedience. Is there any liability upon me in this, and in similar matters, where the intention is as I have described?\"","book_title":"Enjoining Good and Forbidding Evil","section_title_ar":"Section 553","section_title_en":"The Upright Scholars Before the Tyrannical Rulers — Counsel and Fearless Truth-Telling","section_index":553,"anchors":"- Root: نصح (naṣaḥa)\n  * Lisan / Ayn: Core meaning is sincerity, faithfulness, and pure counsel free from deceit; the root denotes the act of seeking the welfare of another with complete integrity.\n  * Al-Raghib (Mufradat): In theological context, naṣīḥah is the obligation of the sincere advisor to guide the ruler toward divine truth, even at personal peril, as it is a form of worship (ʿibādah) and a trust (amānah).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes pure honey (ʿasal naṣīḥ) free from admixture; metaphorical (majāz) usage applies to counsel that is untainted by flattery or self-interest.\n- Root: سلط (sulṭ)\n  * Lisan / Ayn: Denotes authority, power, and dominion; the ruler (sulṭān) is one who has been given sway over affairs.\n  * Al-Raghib (Mufradat): In Kalam, sulṭān is a trial (ibtilāʾ) and a trust (amānah) from God, whose exercise demands justice (ʿadl) and whose neglect invites divine wrath.\n  * Al-Zamakhshari (Asas): Literal usage refers to physical power or a governing authority; metaphorical usage extends to the authority of proof (sulṭān al-burhān) that compels assent.\n- Root: عظ (waʿaẓa)\n  * Lisan / Ayn: Root denotes admonition, exhortation, and reminding of consequences; it implies softening the heart through remembrance of God and the Hereafter.\n  * Al-Raghib (Mufradat): In theological terms, ʿiẓah is the act of turning the soul away from transgression through a blend of fear (tarhīb) and hope (targhīb), grounded in revealed truth.\n  * Al-Zamakhshari (Asas): Literal usage is the verbal admonition; metaphorical usage is the admonition of circumstance (ʿiẓah al-ḥāl) when events themselves teach a lesson.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (bāb al-ḥaṣr wa al-taqyīd bi-innamā) — Governing the emphasis of exclusive predication in statements of counsel, such as \"No obedience to a creature in disobedience of the Creator,\" where the restriction (ḥaṣr) is achieved through negation and exception (nafy wa istithnāʾ).","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Enjoining Good and Forbidding Evil'","badge":"Insight"}],"69":[{"arabic":"الملائكة وقال تعالى أو عجبتم أن جاءكم ذكر من ربكم على رجل منكم الآية السبب الخامس الخوف من فوت المقاصد وذلك يختص بمتزاحمين على مقصود واحد فإن كان واحد يحسد صاحبه في كل نعمة تكون عونا له في الانفراد بمقصوده ومن هذا الجنس تحاسد الضرات في التزاحم على مقاصد الزوجية وتحاسد الأخوة في التزاحم على نيل المنزلة في قلب الأبوين للتوصل به إلى مقاصد الكرامة والمال وكذلك تحاسد التلميذين لأستاذ واحد على نيل المرتبة من قلب الأستاذ وتحاسد ندماء الملك وخواصه في نيل المنزلة من قلبه للتوصل به إلى المال والجاه وكذلك تحاسد الوا","english":"I say: God is Knower of what is in the breasts. {«إِنْ تَمْسَسْكُمْ حَسَنَةٌ تَسُؤْهُمْ»} — \"If good touches you, it grieves them\" {«وَدُّوا مَا عَنِتُّمْ قَدْ بَدَتِ الْبَغْضَاءُ مِنْ أَفْوَاهِهِمْ وَمَا تُخْفِي صُدُورُهُمْ أَكْبَرُ»} — \"They wish for your hardship; hatred has already appeared from their mouths, and what their breasts conceal is greater.\" And envy (ḥasad), arising from hatred, may lead to contention, mutual fighting, and the spending of one's entire life in removing another's blessing through stratagems, slander, the tearing of veils, and whatever runs in that course.","book_title":"Condemnation of Envy","section_title_ar":"Section 722","section_title_en":"The Revival of the Religious Sciences — Book on the Rebuke of the Self: The Seven Causes of Envy (Section 722)","section_index":722,"anchors":"- Root: سبب (sabab)\n  * Lisan / Ayn: The rope by which one climbs; every means by which one reaches a thing.\n  * Al-Raghib (Mufradat): \"Every means by which one arrives at something is called a sabab\" — thus the causes enumerated here are the psychological \"ropes\" by which envy ascends in the soul.\n  * Al-Zamakhshari (Asas): Literal: a physical cord. Metaphorical: any linkage or occasion — here, the inward occasions (asbāb) that give rise to ḥasad.\n- Root: بغض (bughḍ)\n  * Lisan / Ayn: Hatred, aversion of the heart.\n  * Al-Raghib (Mufradat): The opposite of love (maḥabbah); a disposition of the heart toward another's harm.\n  * Al-Zamakhshari (Asas): Literal: inner aversion. Metaphorical: its \"appearance from the mouths\" (Quranic) as outward speech betraying the concealed hatred.\n- Root: كبر (kibr)\n  * Lisan / Ayn: Greatness; pride; disdain.\n  * Al-Raghib (Mufradat): \"Al-kabīr and al-ṣaghīr are relative terms\" — pride is the claim to greatness relative to another, deeming oneself above him.\n  * Al-Zamakhshari (Asas): Literal: bigness in stature or age. Metaphorical: \"takabbara 'alayhi\" — to deem oneself greater than another and refuse submission to him.\n- Root: قصد (qaṣd)\n  * Lisan / Ayn: Straightness of path; intending a goal.\n  * Al-Raghib (Mufradat): \"Al-qaṣd: istiqāmat al-ṭarīq\" — the straight road; also moderation between extremes.\n  * Al-Zamakhshari (Asas): Literal: to head toward a place. Metaphorical: \"maqāṣid\" — the aims and objectives toward which one directs oneself; here, the worldly goals whose pursuit breeds rivalry and envy.\n- Root: نزل (nazal)\n  * Lisan / Ayn: To descend from a height; to alight.\n  * Al-Raghib (Mufradat): \"Al-nuzūl fī al-aṣl huwa inḥiṭāṭ min 'uluww\" — descent from above; the sending down of revelation.\n  * Al-Zamakhshari (Asas): Literal: descending from a high place. Metaphorical: \"anzala Allāhu al-kitāb\" — God's sending down of the Quran; and \"mā unzila\" — what was revealed, as in the Quranic citation regarding the Qurashites' objection to revelation upon a mere human.\n- Sibawayh Rule: Rule of Causal Coordination (al-'aṭf al-sababī) — The enumeration of the seven causes proceeds by coordinated clauses (fa-... thumma ...), each introduced as an independent proposition linked by causation (sabab), requiring the translator to preserve the logical sequence of psychological motivations without collapsing them into one another.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Envy'","badge":"Ethics"}],"75":[{"arabic":"وما يتبع الذين يدعون من دون الله شركاء إن يتبعون إلا الظن وقوله عز وجل قال الملأ الذين استكبروا من قومه للذين استضعفوا لمن آمن منهم معناه الذين استكبروا لمن آمن من الذين استضعفوا ومنها المقدم والمؤخر وهو مظنة الغلط كقوله عز وجل ولولا كلمة سبقت من ربك لكان لزاما وأجل مسمى معناه لولا الكلمة وأجل مسمى لكان لزاما ولولاه لكان نصبا كاللزام وقوله تعالى يسألونك كأنك حفي عنها أي يسألونك عنها كأنك حفي بها وقوله عز وجل لهم مغفرة ورزق كريم كما أخرجك ربك من بيتك بالحق فهذا الكلام غير متصل وإنما هو عائد إلى قوله السابق قل الأنفال لله والرسول كما أخرجك ربك من بيتك بالحق أي فصارت أنفال الغن","english":"I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"","book_title":"Etiquette of Quran Recitation","section_title_ar":"Section 233","section_title_en":"The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation","section_index":233,"anchors":"- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Etiquette of Quran Recitation'","badge":"Ethics"}],"79":[{"arabic":"وصف الله تعالى الكاذبين ببعضهم للناصحين إذ قال {ولكن لا تحبون الناصحين} وهذا في عيب هو غافل عنه فأما ما علمت أنه يعلمه من نفسه فإنما هو مقهور عليه من طبعه فلا ينبغي أن يكشف فيه ستره إن كان يخفيه وإن كان يظهره فلا بد من التلطف في النصح بالتعريض مرة وبالتصريح أخرى إلى حد لا يؤدي إلى الإيحاش فإن علمت أن النصح غير مؤثر فيه وأنه مضطر من طبعه إلى الإصرار عليه فالسكوت عنه أولى وهذا كله فيما يتعلق بمصالح أخيك في دينه أو دنياه أما ما يتعلق بتقصيره في حقك فالواجب فيه الاحتمال والعفو والصفح والتعامي عنه والتعرض لذلك ليس من","english":"The meaning of brotherhood is thus participation (musāhamah) in prosperity and adversity. The Prophet (peace be upon him) said: {«إذا أحب أحدكم أخاه فليخبره»} (When one of you loves his brother, let him inform him). (1) He commanded the informing only because it necessitates an increase of love. For if he knows that you love him, he will love you by nature, inevitably. And when you know that he also loves you, your love increases, inevitably. Thus love continues to increase from both sides and to multiply.","book_title":"Duties of Brotherhood","section_title_ar":"Section 422","section_title_en":"On the Duties of Brotherhood: Speech, Praise, Defense, and Sincere Counsel (Section 422 of the Revival of the Religious Sciences)","section_index":422,"anchors":"- Root: نصح (naṣaḥa)\n  * Lisan / Ayn: Core meaning of sincerity, purity, and the opposite of deceit; also \"to sew\" (naṣaḥa al-jild), indicating a mending of what is torn.\n  * Al-Raghib (Mufradat): \"النصح: تحري فعل أو قول فيه صلاح صاحبه\" — Sincere counsel is the seeking of an act or saying in which lies the well-being of the other. It is the purification of one's intent (ikhlāṣ) toward the brother.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"نصحته ونصحت له نصحا ونصيحة\" — to advise sincerely. Metaphorical (Majaz): \"هو ناصح الجيب\" (pure of pocket/garment) and \"نصح الغيث البلاد\" (the rain fulfilled the land), indicating that true counsel is a complete and sincere pouring forth that benefits the recipient.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to distinguish the precise nature of acts (e.g., \"إنما أمر بالإخبار\" restricts the command's purpose to a specific cause: the increase of love).","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'","badge":"Insight"}],"87":[{"arabic":"والقيامة تجمعنا والله تعالى يحكم بيننا وهو خير الحاكمين ورفع بعض السعاة إلى الصاحب بن عباد رقعة نبه فيها على مال يتيم يحمله على أخذه لكثرته فوقع على ظهرها السعاية قبيحة وإن كانت صحيحة فإن كنت أجريتها مجرى النصح فخسرانك فيها افضل من الربح ومعاذ الله أن نقبل مهتوكا في مستور ولولا أنك في خفارة شيبتك لقابلناك بما يقتضيه فعلك في مثلك فتوق يا ملعون العيب فإن الله أعلم بالغيب الميت رحمه الله واليتيم جبره الله والمال ثمره الله والساعي لعنه الله وقال لقمان لابنه يا بني أوصيك بخلال إن تمسكت بهن لم تزل","english":"A man said to ʿAmr ibn ʿUbayd: \"The teacher (al-Uswārī) continues to mention you in his discourses with evil.\" So ʿAmr said to him: \"O this man, you have not observed the right of companionship with the man, for you have transmitted his speech to me; nor have you fulfilled my right, for you have informed me of what I dislike concerning my brother. But I shall inform him that death encompasses us all, the grave gathers us, the Resurrection assembles us, and Allah — Most High — shall judge between us, and He is the Best of Judges.\"","book_title":"Condemnation of Anger and Hatred","section_title_ar":"Section 694","section_title_en":"On the Gravity of Slander (Namīmah) and Its Consequences","section_index":694,"anchors":"- Root: ن م م (N-M-M)\n  * Lisan / Ayn: Core meaning of \"to carry tales, to slander, to stir up enmity through speech\" — the carrier of tales (nammām) is one who transmits speech to cause discord.\n  * Al-Raghib (Mufradat): The theological nuance — namīmah is a moral corruption rooted in the intention to sever bonds of brotherhood, which the Sacred Law (Sharʿ) universally condemns.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — the act of carrying speech from one party to another with corruptive intent; metaphorical (majāz) — the \"slanderer\" is one whose very presence breeds division, even if his report is factually true.\n- Root: خ و ن (Kh-W-N)\n  * Lisan / Ayn: Betrayal of trust (khiyānah) — the antithesis of amānah (fidelity); to act treacherously in what has been entrusted.\n  * Al-Raghib (Mufradat): Khiyānah is the violation of a covenant or trust, whether overt or concealed; its opposite is amānah, which is the foundation of social contracts.\n  * Al-Zamakhshari (Asas): Literal — breach of trust in material or moral matters; metaphorical — the slanderer betrays the trust of both the speaker and the subject of speech.\n- Root: ي ت م (Y-T-M)\n  * Al-Raghib (Mufradat): Orphanhood — the severance of a child from his father before maturity; metaphorically, any isolated or defenseless entity (e.g., a \"unique pearl\").\n  * Al-Zamakhshari (Asas): Literal — a minor bereft of his father; metaphorical — the orphan's vulnerability as a test of the guardian's integrity, where betrayal is magnified.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic structure of the narrative (e.g., the tale of the slave and the two spouses) demonstrates how clauses are interposed to build suspense and moral consequence, each element grammatically dependent on the governing verb of intention or action.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Anger and Hatred'","badge":"Afterlife"}],"89":[{"arabic":"ولا تقولن لشيء إني فاعل ذلك غدا إلا أن يشاء الله ثم لم يقتصر على ذلك فيما لا يشك فيه بل قال تعالى لتدخلن المسجد الحرام إن شاء الله آمنين محلقين رءؤسكم ومقصرين وكان الله سبحانه عالما بأنهم يدخلون لا محالة وأنه شاءه ولكن المقصود تعليمه ذلك فتأدب رسول الله صلى الله عليه وسلم في ما كان يخبر عنه معلوما كان أو مشكوكا حتى قال صلى الله عليه وسلم لما دخل المقابر السلام عليكم دار قوم مؤمنين وإنا إن شاء الله بكم لاحقون (1) واللحوق بهم غير مشكوك فيه ولكن مقتضى الأدب ذكر الله تعالى وربط الأمور به وهذه الصيغ","english":"If you say: \"What is the meaning of the Salaf's statement, 'I am a believer, if God wills' — given that the exception (istithnā') implies doubt, and doubt in faith is unbelief? Yet they all refrained from giving an unqualified answer affirming faith and were cautious about it.\"","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 102","section_title_en":"On the Meaning of the Salaf's Statement \"I am a Believer, If God Wills\" — Section 102","section_index":102,"anchors":"- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which is breathed; the innermost reality of a person.\n  * Al-Raghib (Mufradat): النفس is used for the rūḥ (spirit), for the dhāt (essence/self), and for the seat of intention and knowledge. When one says \"he knows in himself (nafsihi) that he is a believer,\" it denotes certitude residing in the very core of one's being, not a corporeal faculty.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the soul's reflexive self-awareness; metaphorical (majāz) usage extends to \"blood\" (dam) or \"the eye\" (ʿayn) of envy. Here, \"in himself\" (fī nafsihi) is literal self-knowledge, not mere outward profession.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: Face, countenance; the foremost part; a mode, aspect, or direction.\n  * Al-Raghib (Mufradat): The face is the most noble apparent part of a thing; hence it is used for the \"aspect\" or \"manner\" (wajh) of an affair. \"Four aspects\" (wujūh) means four distinct modes of interpretation or rational grounds.\n  * Al-Zamakhshari (Asas): Literal: the face of a person or object. Metaphorical: \"the face of the matter\" (wajh al-amr) — its most salient and honorable dimension. Here, the \"aspects\" are hermeneutical angles, not physical parts.\n- Root: ايم (a-y-m)\n  * Al-Raghib (Mufradat): The unmarried state (aym); one who has no spouse. Not applicable here directly, but the root's semantic field of \"being alone/without attachment\" contrasts with īmān's root (a-m-n) — security and trust — which is the operative term in this text.\n  * Al-Zamakhshari (Asas): Not directly relevant; the operative root is أمن (a-m-n), meaning security from fear, and by extension, faith (īmān) as the state of being secure in God's truth.\n- Root: كان (k-w-n)\n  * Lisan / Ayn: To be, to exist; the copula of predication.\n  * Al-Raghib (Mufradat): Kāna denotes existence and becoming; in theological usage, it grounds the distinction between what is (mawjūd) and what is merely asserted. The question \"Are you a believer?\" (a-mu'min anta?) uses kāna implicitly to ask about actual, present state — not future contingency.\n  * Al-Zamakhshari (Asas): Literal: existence. Metaphorical: the \"being-so\" of a predicate. The istithnā' (exception) with \"in shā' Allāh\" suspends the copula's certainty, shifting from assertive existence to contingent hope.\n- Sibawayh Rule: باب الاستثناء والتعليق بالمشيئة (The Chapter of Exception and Suspension by the Divine Will) — When an exception clause (istithnā') follows a positive assertion, it grammatically suspends the universality or certainty of the predication. In theological discourse, this suspension may be semantic (doubt) or pragmatic (deference, etiquette, or self-deprecation), and Sibawayh's parsing of conditional suspension (taʿlīq) shows that the apodosis need not be negated — only its absolute, unqualified force is tempered.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"}],"95":[{"arabic":"عليه شيء مما يسرون وما يعلنون وحذرهم أن يأخذهم بغتة وهم لا يشعرون فقال {ما ينظرون إلا صيحة واحدة تأخذهم وهم يخصمون فلا يستطيعون توصية ولا إلى أهلهم يرجعون} والصلاة والسلام على محمد رسوله الذي يسير تحت لوائه النبيون وعلى آله وأصحابه الأئمة المهديين والسادة المرضيين صلاة يوازي عددها عدد ما كان من خلق الله وما سيكون ويحظى ببركتها الأولون والآخرون وسلم تسليما كثيرا أما بعد فإن الغضب شعلة نار اقتبست من نار الله الموقدة التي تطلع على الأفئدة وإنها لمستكنة في طي الفؤاد استكنان الجمر تحت الرماد ويستخرجه الكبر الدفي","english":"In the name of God, the Most Merciful, the Most Compassionate. Praise be to God, upon whose pardon and mercy none rely except the hopeful, and from whose evil wrath and assault none fear except the fearful — He who gradually seizes His servants from whence they know not, and who has given dominion over them to their lusts, commanding them to abandon what they desire, and who has tried them with anger while charging them to swallow their rage in what provokes them. Then He surrounded them with hardships and pleasures, and granted them respite to see how they would act. He tested their love through them, to make known the truth of what they claim. He made known to them that nothing is hidden from Him of what they conceal or proclaim, and warned them lest He seize them suddenly while they are unaware. For He said: {«They await but a single blast which will seize them while they are disputing; so they will not be able to make a bequest, nor to their families will they return»} (Q. 36:49-50). And prayers and peace be upon Muhammad, His Messenger, beneath whose banner the prophets walk, and upon his family and companions — the rightly-guided imams and the pleasing masters — prayers whose number equals the number of what has been of God's creation and what will be, and by whose blessing the first and the last are favored — and abundant peace.","book_title":"Condemnation of Envy","section_title_ar":"Section 700","section_title_en":"The Book of Condemnation of Anger, Spite, and Envy — Book Five of the Quarter of Destroyers from The Revival of the Religious Sciences","section_index":700,"anchors":"- Root: غضب (ghadab)\n  * Lisan / Ayn: Core root meaning of anger, rage, fury; the boiling and agitation of the blood\n  * Al-Raghib (Mufradat): Theological nuance — when attributed to God, it means retribution (intiqām) alone, not emotional agitation; the Prophet described it as \"a live coal kindled in the heart of the son of Adam\"\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal anger is the boiling of the blood in living beings; metaphorical usage extends to inanimate things like fire and the reins of a mount\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart; also the turning, overturning, and transformation of a thing from one state to another\n  * Al-Raghib (Mufradat): Theological nuance — the heart is so named for its constant turning (taqallub) and fluctuation between states; it is the seat of understanding and the locus of divine address\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal is the physical organ; metaphorical is the subtle spiritual reality (laṭīfah rabbāniyyah) that is the locus of knowledge and will\n- Root: حسد (hasad)\n  * Lisan / Ayn: Envy; the wishing for removal of another's blessing\n  * Al-Raghib (Mufradat): Theological nuance — envy is the desire for the removal of a blessing from one who deserves it, sometimes accompanied by striving to remove it; the believer envies (ghibṭah) while the hypocrite envies (hasad)\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — \"Envy consumes the body as fire consumes wood\"; the envier is one who wishes evil upon the blessed\n- Root: هلك (halak)\n  * Lisan / Ayn: Perdition, destruction, ruin; death\n  * Al-Raghib (Mufradat): Theological nuance — three senses: (1) loss of a thing from one's possession while it exists elsewhere, (2) corruption and dissolution of a thing, (3) death; the Quran uses it for all three\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal is physical destruction; metaphorical is the ruin of one's religion and afterlife through spiritual corruption\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening material constitutes a complete, meaningful unit, as in the Quranic pattern of extended periodic sentences that delay resolution for rhetorical effect.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Envy'","badge":"Ethics"}],"99":[{"arabic":"واستدراجه فقال فلا يأمن مكر الله إلا القوم الخاسرون وقال تعالى ومكروا مكرا ومكرنا مكرا وهم لا يشعرون وقال عز وجل ومكروا ومكر الله والله خير الماكرين وقال تعالى إنهم يكيدون كيدا وأكيد كيدا فمهل الكافرين أمهلهم رويدا فكما لا يجوز للعبد المهمل أن يستدل بإهمال السيد إياه وتمكينه من النعم على حب السيد بل ينبغي أن يحذر أن يكون ذلك مكرا منه وكيدا مع أن السيد لم يحذره مكر نفسه فبأن يجب ذلك في حق الله تعالى مع تحذيره استدراجه أولى فإذن من أمن مكر الله فهو مغتر ومنشأ هذا الغرور أنه استدل بنعم الدنيا على أنه","english":"As for knowing it by way of authoritative transmission and affirmation (taṣdīq): it is that one believes in the Book of God — exalted is He — and affirms His Messenger. For God — exalted is He — has said: {«أيحسبون أن ما نمدهم به من مال وبنين * نسارع لهم في الخيرات بل لا يشعرون»} — \"Do they reckon that what We extend to them of wealth and sons — [that] We hasten for them good things? Nay, but they do not perceive\" (Q. 23:55-56). And He said — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — \"We shall draw them on by degrees from whence they do not know\" (Q. 7:182). And He said — exalted is He: {«فتحنا عليهم أبواب كل شيء حتى إذا فرحوا بما أوتوا أخذناهم بغتة فإذا هم مبلسون»} — \"We opened upon them the gates of everything, until when they rejoiced in what they were given, We seized them suddenly, and behold, they were in despair\" (Q. 6:44). And in the interpretation of His saying — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — it is said: \"Whenever they innovated a sin, We innovated for them a blessing, to increase their self-deception.\" And He said — exalted is He: {«إنما نملي لهم ليزدادوا إثما»} — \"We only grant them respite that they may increase in sin\" (Q. 3:178). And He said — exalted is He: {«ولا تحسبن الله غافلا عما يعمل الظالمون إنما يؤخرهم ليوم تشخص فيه الأبصار»} — \"And do not reckon God heedless of what the wrongdoers do; He only delays them to a Day when eyes will stare fixedly\" (Q. 14:42). And [there is] more of that kind which has come in the Book of God — exalted is He — and in the Sunnah of His Messenger. So whoever believes in it is delivered from this self-deception. For the origin of this self-deception is ignorance of God and of His attributes; for whoever knows Him does not feel secure from His stratagem (makr) and is not deceived by such corrupt fancies.","book_title":"Fear and Hope","section_title_ar":"Section 888","section_title_en":"Section 888 — On the Remedy for Self-Deception (Ghurūr): Recognizing the Signs of Divine Honor (Karāmah) and Humiliation (Hawān)","section_index":888,"anchors":"- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Core meaning of an outward trace or mark; heedlessness in wakefulness; the blaze on a horse's forehead.\n  * Al-Raghib (Mufradat): \"Ghurūr\" is delusion stemming from heedlessness — the soul's being overtaken while imagining security, as in {«ما غرك بربك الكريم»} (Q. 82:6). It is the state of one who is deceived by apparent favors while blind to their underlying test.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): heedlessness and exposure to predation, like a gazelle deceived by moonlight. Metaphorical (Majaz): being \"deceived by God\" (ightirār billāh) — trusting in His mercy while persisting in disobedience.\n- Root: لهم (l-h-m)\n  * Lisan / Ayn: Swallowing whole; the gullet.\n  * Al-Raghib (Mufradat): \"Ilhām\" — God's casting a meaning into the heart (al-raw'), distinct from demonic whispering; the channel of inner vision for the knowers (ʿārifūn).\n  * Al-Zamakhshari (Asas): Literal: to swallow. Metaphorical: the heart's receptive \"swallowing\" of divine inspiration.\n- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: Origination after non-existence; newness.\n  * Al-Raghib (Mufradat): \"Ḥudūth\" — a thing's coming to be after it was not; \"muḥdith\" — the originator, exclusively God for substances (jawāhir). \"Iḥdāth\" — bringing about a novel state or act.\n  * Al-Zamakhshari (Asas): Literal: temporal newness. Metaphorical: \"muḥaddath\" — one inspired with correct discernment, as if newly spoken-to.\n- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Softness, ease, well-being; a state of comfort.\n  * Al-Raghib (Mufradat): \"Niʿmah\" — the good state one inhabits; \"naʿīm\" — the act of living pleasantly. Blessings are both a test and a sign, per {«وإن تعدوا نعمة الله لا تحصوها»} (Q. 16:18).\n  * Al-Zamakhshari (Asas): Literal: bounty and comfort. Metaphorical: \"khafat naʿāmatuhum\" — their prosperity vanished; blessings may signal either favor or gradual ruin (istidrāj).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication with \"innamā\")\n  * In {«إنما نملي لهم ليزدادوا إثما»} (Q. 3:178) and {«إنما يؤخرهم ليوم تشخص فيه الأبصار»} (Q. 14:42), \"innamā\" restricts the purpose of divine respite exclusively to increase of sin and deferred reckoning — negating any reading of it as benevolent indulgence.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Fear and Hope'","badge":"Ethics"}],"100":[{"arabic":"كانوا يكسبون وقال عز وجل أن لو نشاء أصبناهم بذنبوهم ونطبع على قلوبهم فهم لا يسمعون فربط عدم السماع بالطبع بالذنوب كما ربط السماع بالتقوى فقال تعالى واتقوا الله واسمعوا واتقوا الله ويعلمكم الله ومهما تراكمت الذنوب طبع على القلوب وعند ذلك يعمى القلب عن إدراك الحق وصلاح الدين ويستهين بأمر الآخرة ويستعظم أمر الدنيا ويصير مقصور الهم عليها فإذا قرع سمعه أمر الآخرة وما فيها من الأخطار دخل من أذن وخرج من أذن ولم يستقر في القلب ولم يحركه إلى التوبة والتدارك أولئك يئسوا من الآخرة كما يئس الكفار من","english":"As for the praiseworthy effects that we have mentioned, they increase the mirror of the heart in clarity (jalā'), radiance (ishrāq), light (nūr), and brilliance (ḍiyā'), until the clear truth (jalīyat al-ḥaqq) gleams within it and the reality of the sought-after matter in religion is unveiled in it. And it is to such a heart that the Prophet, peace and blessings be upon him, pointed when he said: \"When God desires good for a servant, He appoints for him an admonisher from his own heart.\" (1) The hadith: \"Whoever has from his heart an admonisher, upon him is from God a protector\" — I have not found for it a source (aṣl).","book_title":"Disciplining the Soul","section_title_ar":"Section 582","section_title_en":"The Heart as a Mirror: The Effects of Virtues and Vices upon Spiritual Perception","section_index":582,"anchors":"- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn over, to overturn, to transform from one state to another; the heart as that which is constantly fluctuating and turning between states.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — The heart is that which is perpetually turned about, and its rectitude or corruption depends upon the direction of its turning.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): physical turning over. Metaphorical (Majaz): \"قلب المعلم الصبيان: صرفهم إلى بيوتهم\" — the turning of a thing toward its proper end. Here, the heart is a mirror (مرآة) turned toward either the light of truth or the darkness of sin.\n- Root: رين (r-y-n)\n  * Lisan / Ayn: Rust, tarnish, or filth that overcomes a polished surface, veiling its original brightness.\n  * Al-Raghib (Mufradat): The covering of the heart by accumulated sin, such that it becomes rusted over and incapable of receiving the light of truth.\n  * Al-Zamakhshari (Asas): Literal: the tarnishing of a blade or mirror. Metaphorical: the veiling of the heart's perceptive faculty by the accumulation of transgressions, as in {«كلا بل ران على قلوبهم ما كانوا يكسبون»} (The Mutaffifin: 14).\n- Root: طبع (t-b-')\n  * Lisan / Ayn: To stamp, to seal, to impress upon; the imprinting of a seal that renders the surface impermeable to further impression.\n  * Al-Raghib (Mufradat): The sealing of the heart by God as a consequence of persistent sin, rendering it deaf to admonition and blind to truth.\n  * Al-Zamakhshari (Asas): Literal: the physical stamping of a seal. Metaphorical: the divine sealing of the heart as a just consequence of willful persistence in transgression.\n- Root: ذكر (dh-k-r)\n  * Lisan / Ayn: Remembrance, recollection, mindfulness; the opposite of forgetfulness (نسيان).\n  * Al-Raghib (Mufradat): The presence of the thing remembered in the mind; the highest form being the remembrance of God which brings tranquility to the heart.\n  * Al-Zamakhshari (Asas): Literal: verbal invocation. Metaphorical: the state of spiritual presence and awareness that polishes the heart's mirror and unveils the reality of truth.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic connection between cause and effect, as in the verse {«واتقوا الله واسمعوا»}, where hearing (spiritual perception) is grammatically and semantically linked to piety (تقوى), just as the sealing of the heart (طبع) is linked to the accumulation of sins (ذنوب).","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'","badge":"Insight"}],"104":[{"arabic":"هبيرة اتق الله فإنه يوشك أن يأتيك رسول من رب العالمين يزيلك عن سريرك ويخرجك من سعة قصرك إلى ضيق قبرك فتدع سلطانك ودنياك خلف ظهرك وتقدم على ربك وتنزل على عملك يا ابن هبيرة إن الله ليمنعك من يزيد ولا يمنعك يزيد من الله وإن أمر الله فوق كل أمر وإنه لا طاعة في معصية الله وإني أحذرك بأسه الذي لا يرد عن القوم المجرمين فقال ابن هبيرة أربع على ظلعك أيها الشيخ وأعرض عن ذكر أمير المؤمنين فإن أمير المؤمنين صاحب العلم وصاحب الحكم وصاحب الفضل وإنما ولاه الله تعالى ما ولاه من أمر هذه الأمة لعلمه به وما يعلمه من ف","english":"He turned to al-Shaʿbī and said: \"O Abā ʿAmr! I am the trustee of the Commander of the Faithful over Iraq and his governor over it, and a man commanded to obedience. I have been tried with the subjects, and their right has become incumbent upon me. So I love to preserve them and to attend to what sets them right, along with sincere counsel (naṣīḥah) to them. And reports may reach me about a band of people from the regions concerning a matter, and I find myself severe against them therein, so I withhold a portion of their stipends and place it in the treasury (bayt al-māl), with the intention in myself that I shall return it to them. Then it reaches the Commander of the Faithful that I have withheld it in that manner, so he writes to me that I must not return it. I cannot then countermand his order, nor can I execute his letter [against my better judgment]. I am but a man commanded to obedience. Is there any liability upon me in this, and in similar matters, where the intention is as I have described?\"","book_title":"Enjoining Good and Forbidding Evil","section_title_ar":"Section 553","section_title_en":"The Upright Scholars Before the Tyrannical Rulers — Counsel and Fearless Truth-Telling","section_index":553,"anchors":"- Root: نصح (naṣaḥa)\n  * Lisan / Ayn: Core meaning is sincerity, faithfulness, and pure counsel free from deceit; the root denotes the act of seeking the welfare of another with complete integrity.\n  * Al-Raghib (Mufradat): In theological context, naṣīḥah is the obligation of the sincere advisor to guide the ruler toward divine truth, even at personal peril, as it is a form of worship (ʿibādah) and a trust (amānah).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes pure honey (ʿasal naṣīḥ) free from admixture; metaphorical (majāz) usage applies to counsel that is untainted by flattery or self-interest.\n- Root: سلط (sulṭ)\n  * Lisan / Ayn: Denotes authority, power, and dominion; the ruler (sulṭān) is one who has been given sway over affairs.\n  * Al-Raghib (Mufradat): In Kalam, sulṭān is a trial (ibtilāʾ) and a trust (amānah) from God, whose exercise demands justice (ʿadl) and whose neglect invites divine wrath.\n  * Al-Zamakhshari (Asas): Literal usage refers to physical power or a governing authority; metaphorical usage extends to the authority of proof (sulṭān al-burhān) that compels assent.\n- Root: عظ (waʿaẓa)\n  * Lisan / Ayn: Root denotes admonition, exhortation, and reminding of consequences; it implies softening the heart through remembrance of God and the Hereafter.\n  * Al-Raghib (Mufradat): In theological terms, ʿiẓah is the act of turning the soul away from transgression through a blend of fear (tarhīb) and hope (targhīb), grounded in revealed truth.\n  * Al-Zamakhshari (Asas): Literal usage is the verbal admonition; metaphorical usage is the admonition of circumstance (ʿiẓah al-ḥāl) when events themselves teach a lesson.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (bāb al-ḥaṣr wa al-taqyīd bi-innamā) — Governing the emphasis of exclusive predication in statements of counsel, such as \"No obedience to a creature in disobedience of the Creator,\" where the restriction (ḥaṣr) is achieved through negation and exception (nafy wa istithnāʾ).","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Enjoining Good and Forbidding Evil'","badge":"Insight"}],"124":[{"arabic":"حقيقة الأمر فلم يكترثوا بقول فرعون لأقطعن أيديكم وأرجلكم من خلاف {بل} قالوا لن نؤثرك على ما جاءنا من البينات والذي فطرنا قاقض ما أنت قاض إنما تقضي هذه الحياة الدنيا فإن البيان والكشف يمنع التغيير وأما أصحاب السامري لما كان إيمانهم عن النظر إلى ظاهر الثعبان فلما نظروا إلى عجل السامري وسمعوا خواره تغيروا وسمعوا قوله هذا إلهكم وإله موسى ونسوا أنه لا يرجع إليهم قولا ولا يملك لهم ضرا ولا نفعا فكل من آمن بالنظر إلى ثعبان يكفر لا محالة إذا نظر إلى عجل لأن كليهما من عالم الشهادة والاختلاف والتضاد في عالم الشهادة كثير","english":"...its mover is Power (al-qudrah) without any doubt. So the seeker (al-sālik) journeyed on to the world of Power, and there he beheld wonders before which all that had preceded seemed contemptible. He asked Power concerning the movement of the right hand, and it said: \"I am but an attribute (innamā anā ṣifah) — ask the Powerful One (al-Qādir), for the reliance is upon the described substances (al-mawṣūfāt), not upon the attributes.\" At that point he almost deviated and unleashed the tongue of questioning with audacity, but he was steadied by the firm word (al-qawl al-thābit), and a caller cried out from behind the veils of the pavilions of the Divine Presence: \"He is not asked about what He does, but they shall be asked\" {«لَا يُسْأَلُ عَمَّا يَفْعَلُ وَهُمْ يُسْأَلُونَ»}. Then the awe of the Presence overwhelmed him, and he fell down stricken, convulsing in his swoon. When he regained consciousness, he said: \"Glory be to You — how magnificent is Your majesty! I repent unto You, and I place my trust in You, and I believe that You are the Sovereign, the Compeller, the One, the Subduer. I fear none but You, I hope for none other than You, and I seek refuge only in Your pardon from Your punishment, and in Your good pleasure from Your wrath. I have nothing but to ask of You and to supplicate before You, and to plead humbly in Your presence, saying: 'Expand my breast that I may know You, and loosen the knot from my tongue that I may praise You.'\"","book_title":"Monotheism and Reliance","section_title_ar":"Section 1111","section_title_en":"The Unification of the Acts — The Journey of the Seekers to the Oneness of the Agent","section_index":1111,"anchors":"- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core meaning of measuring, determining, and empowering; al-Qadir as the One whose power is absolute and unbounded.\n  * Al-Raghib (Mufradat): Power (qudrah) when ascribed to God is the negation of incapacity ('ajz); when ascribed to man it is a contingent capacity limited by divine ordainment.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) — \"He is Qadir, Muqtadir, possessor of power\"; metaphorical (majaz) — \"a far-reaching steed\" (ba'id al-qadr), indicating extension of effect.\n- Root: وحد (w-ḥ-d)\n  * Lisan / Ayn: Oneness and singularity; al-Wahid as that which has no part whatsoever.\n  * Al-Raghib (Mufradat): True unity (wahdah) is absolute indivisibility; applied to God exclusively in the sense of unique sovereignty.\n  * Al-Zamakhshari (Asas): \"He is one (wahid), and they are singular (wuhdan)\"; literal unity versus numerical oneness.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as perception of a thing's reality; the mark or sign by which something is known.\n  * Al-Raghib (Mufradat): Knowledge ('ilm) is the apprehension of a thing in its true reality — either grasping the essence or judging its attributes.\n  * Al-Zamakhshari (Asas): Literal — \"I knew not of your news\" (ma 'alimtu bi-khabarika); the knower as one marked by discernment.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — \"Innamā anā ṣifah\" (I am but an attribute) restricts the speaker's essence to being a mere accident, redirecting inquiry to the substantive subject (al-mawṣūf).","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monotheism and Reliance'","badge":"Insight"}],"126":[{"arabic":"المغفرة هب لي ما لا يضرك وأعطني ما لا ينقصك ربنا أفرغ علينا صبرا وتوفنا مسلمين أنت ولي في الدنيا والآخرة توفني مسلما وألحقني بالصالحين أنت ولينا فاغفر لنا وارحمنا وأنت خير الغافرين واكتب لنا في هذه الدنيا حسنة وفي الآخرة إنا هدنا إليك ربنا عليك توكلنا وإليك أنبنا وإليك المصير ربنا لا تجعلنا فتنة للقوم الظالمين ربنا لا تجعلنا فتنة للذين كفروا واغفر لنا ربنا إنك أنت العزيز الحكيم ربنا اغفر لنا ذنوبنا وإسرافنا في أمرنا وثبت أقدامنا وانصرنا على القوم الكافرين ربنا اغفر لنا ولإخواننا الذين سبقونا بالإيمان ولا تجعل في قلوبنا","english":"And employ me in righteous deeds which You will accept from me. (1) O God, I ask You for pardon, well-being, good certainty, and soundness in this world and the next. (2) O You Whom sins do not harm and from Whom forgiveness does not diminish anything — grant me that which will not harm You, and give me that which will not diminish You. Our Lord, pour upon us patience and cause us to die as Muslims. You are our Protector in this world and the next; cause me to die as a Muslim and join me with the righteous. You are our Protector, so forgive us and have mercy upon us, and You are the Best of forgivers. And write for us good in this world and in the Hereafter — indeed, we have turned to You in repentance. Our Lord, upon You we rely, to You we turn in repentance, and to You is the final return. Our Lord, make us not a trial for the wrongdoing people. Our Lord, make us not a trial for those who disbelieve, and forgive us, our Lord — indeed, You are the Mighty, the Wise. Our Lord, forgive us our sins and our excesses in our affairs, make firm our feet, and grant us victory over the disbelieving people. Our Lord, forgive us and our brothers who preceded us in faith, and place not in our hearts any rancor toward those who believe — our Lord, indeed You are Kind, Merciful. Our Lord, grant us from Yourself mercy and prepare for us from our affair right guidance. Our Lord, give us good in this world and good in the Hereafter, and protect us from the chastisement of the Fire. Our Lord, indeed we have heard a caller calling to faith — to His saying, Mighty and Majestic: {«إنك لا تخلف الميعاد»} [آل عمران/ 194] — Our Lord, do not take us to task if we forget or err. Our Lord, to the end of the surah. (3) My Lord, forgive me and my parents, and have mercy upon them as they raised me when I was small; and forgive the believing men and the believing women, and the Muslim men and the Muslim women, the living among them and the dead. (4) My Lord, forgive, have mercy, and overlook what You know — and You are the Most Exalted, the Most Generous, the Best of the merciful, and the Best of the forgivers. And indeed, to God we belong and to Him we return; and there is no might and no power except through God, the Exalted, the Magnificent; and God suffices us, and He is the Best Disposer of affairs. And may God send blessings upon Muhammad, the Seal of the Prophets, and upon his family and his companions, and grant them abundant peace. (5)","book_title":"On Invocations and Supplications","section_title_ar":"Section 252","section_title_en":"Section 252 — Supplications for Morning and Evening: Comprehensive Prayers of the Prophet (ﷺ)","section_index":252,"anchors":"- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core meaning of swallowing/ingesting (iltihām); from this derives the sense of something being cast directly into the innermost recess of the heart (al-rawʿ).\n  * Al-Raghib (Mufradat): \"الإلهام: إلقاء الشيء في الروع\" — ilhām is the casting of a thing into the innermost consciousness, specifically from God or the higher assembly (al-malaʾ al-aʿlā). It is that which the Prophet (ﷺ) called \"the touch of the angel\" (limat al-malak) and \"the breath of the Holy Spirit in my innermost heart\" (nafth rūḥ al-qudus fī rawʿī).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ألهمه الله الخير: ألقاه في روعه\" — God inspired him with good: He cast it into his innermost consciousness. Metaphorical (majāz): A horse that \"swallows the ground\" (yaltaḥimu al-arḍ) in swiftness; thus ilhām is the swift, direct ingress of divine guidance into the soul without intermediary effort.\n- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: The root denotes praise arising from recognition of voluntary excellence and beneficence; al-ḥamd is commendation of the beloved for their attributes and acts of goodness.\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence (niʿmah) with reverence and love; it is distinguished from mere thanks (shukr) in that it is directed to the essence and attributes of the praised one, not solely to the benefit received.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — I praise God with all His praiseworthy attributes. Metaphorical: \"أحمدت صنيعه\" — I found his deed praiseworthy; thus the tongue's praise must be matched by the heart's recognition of the praised one's perfection.\n- Root: غفر (gh-f-r)\n  * Lisan / Ayn: The root denotes covering and shielding; al-mighfar is the helmet that protects the head in battle.\n  * Al-Raghib (Mufradat): \"الغفر: إلباس ما يصونه عن الدنس\" — Forgiveness is the clothing of that which shields from filth. God's forgiveness (maghfirah) is His shielding of the servant from the touch of chastisement, covering the sin so that it is as though it never were.\n  * Al-Zamakhshari (Asas): Literal: \"اللهم غفرًا\" — O God, forgive. Metaphorical: The she-beasts that \"did not forgive\" their heedlessness (lam taghfir la-hā ghaflātuhā) — i.e., they did not shield their young from destruction; thus forgiveness is active protection, not mere erasure.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which breathes and has vital spirit; also used for the very essence of a thing.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul is the spirit; and in God's saying {«ويحذركم الله نفسه»} [آل عمران/ 28], \"His Self\" means His very essence (dhāt), which — though grammatically expressed as an annexation implying distinction — is in reality identical, with no multiplicity in the Divine Essence.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس\" — a precious thing. Metaphorical: \"دفق نفسه\" — he poured out his blood/life; thus nafs is the seat of life, passion, and moral responsibility.\n- Sibawayh Rule: باب الدعاء والخبر (The Chapter of Supplication and Assertion) — Supplications (duʿāʾ) are grammatically constructed as optative sentences (inshāʾ ṭalabī) using the imperative (rabbighfir), the jussive (lā tuʾākhidhnā), and the vocative (rabbanā), yet they may embed assertive clauses (khabar) of praise (al-ḥamdu lillāh) and attestation (lā ilāha illā anta). The periodic structure of these prayers alternates between direct address to God (munādāh) and self-referential confession, requiring the translator to preserve the vocative force of \"O God\" and \"Our Lord\" without flattening into mere description.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'","badge":"Hadith"}],"137":[{"arabic":"وقال تعالى وتمت كلمة ربك الحسنى على بني إسرائيل بما صبروا وقال تعالى ولنجزين الذين صبروا أجرهم بأحسن ما كانوا يعملون وقال تعالى أولئك يؤتون أجرهم مرتين بما صبروا وقال تعالى إنما يوفى الصابرون أجرهم بغير حساب فما من قربة إلا وأجرها بتقدير وحساب إلا الصبر ولأجل كون الصوم من الصبر وأنه نصف الصبر قال الله تعالى الصوم لي وأنا أجزي به فأضافه إلى نفسه من بين سائر العبادات ووعد الصابرين بأنه معهم فقال تعالى واصبروا إن الله مع الصابرين وعلق النصرة على الصبر فقال تعالى بلى إن تصبروا وتتقوا ويأتوكم من فورهم هذا يم","english":"Allah — exalted be He — has described the patient (al-ṣābirīn) with attributes, and He mentioned patience (al-ṣabr) in the Qur’an in upwards of seventy places. He attached most of the degrees and goods to patience, making them its fruit. For He said — majestic is His utterance: {«وَجَعَلْنَا مِنْهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا لَمَّا صَبَرُوا»} — “And We made from among them imams guiding by Our command, when they were patient” (Q 32:24). And He said — exalted be He: {«وَتَمَّتْ كَلِمَتُ رَبِّكَ الْحُسْنَىٰ عَلَىٰ بَنِي إِسْرَائِيلَ بِمَا صَبَرُوا»} — “And the good word of your Lord was fulfilled upon the Children of Israel, because they were patient” (Q 7:137). And He said — exalted be He: {«وَلَنَجْزِيَنَّ الَّذِينَ صَبَرُوا أَجْرَهُم بِأَحْسَنِ مَا كَانُوا يَعْمَلُونَ»} — “And We shall surely recompense those who were patient their wage according to the best of what they used to do” (Q 16:96). And He said — exalted be He: {«أُولَٰئِكَ يُؤْتَوْنَ أَجْرَهُم مَّرَّتَيْنِ بِمَا صَبَرُوا»} — “Those shall be given their wage twice, because they were patient” (Q 28:54). And He said — exalted be He: {«إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ»} — “Only the patient shall be paid their wage without reckoning” (Q 39:10). Thus there is no act of nearness (qurbah) whose wage is not meted out by measure and account — except patience. And because fasting (al-ṣawm) is of patience, and it is half of patience, Allah — exalted be He — said: “Fasting is Mine, and I recompense it” — so He attributed it to Himself, to the exclusion of all other acts of worship. And He promised the patient that He is with them, saying — exalted be He: {«وَاصْبِرُوا إِنَّ اللَّهَ مَعَ الصَّابِرِينَ»} — “And be patient; indeed Allah is with the patient” (Q 8:46). And He made victory contingent upon patience, saying — exalted be He: {«بَلَىٰ إِن تَصْبِرُوا وَتَتَّقُوا وَيَأْتُوكُم مِّن فَوْرِهِمْ هَٰذَا يُمْدِدْكُمْ رَبُّكُم بِخَمْسَةِ آلَافٍ مِّنَ الْمَلَائِكَةِ مُسَوِّمِينَ»} — “Yes, if you are patient and God-fearing, and they come upon you in their rush, your Lord will reinforce you with five thousand marked angels” (Q 3:125). And He gathered for the patient things He gathered for no others, saying — exalted be He: {«أُولَٰئِكَ عَلَيْهِمْ صَلَوَاتٌ مِّن رَّبِّهِمْ وَرَحْمَةٌ وَأُولَٰئِكَ هُمُ الْمُهْتَدُونَ»} — “Those — upon them are blessings from their Lord, and mercy; and those — they are the rightly guided” (Q 2:157). So guidance, mercy, and blessings are all gathered for the patient. And to exhaust all the verses concerning the station of patience would be lengthy.","book_title":"Patience and Gratitude","section_title_ar":"Section 954","section_title_en":"The Virtue of Patience (Ṣabr) — Its Excellence in the Qur’an, Sunnah, and Reports of the Salaf","section_index":954,"anchors":"- Root: صبر (Ṣ-B-R)\n  * Lisan / Ayn: Core meaning is “to restrain, to hold back, to bind firmly” — as in holding an animal by its halter or confining someone against departure.\n  * Al-Raghib (Mufradat): Patience is “the self’s restraint upon what reason and Sacred Law require, or from what they require it to abstain from.” It is a generic term whose specific names vary by context: in calamity it is ṣabr (opposed to jazaʿ); in battle it is courage (shajāʿah); in vexation it is forbearance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): “I bore patiently what I disliked, and I refrained patiently from what I loved.” Metaphorical (majāz): “His right hand was made to swear patiently” (i.e., bound by an emphatic oath), and “this tree is patient against cold” (i.e., unaffected by it).\n- Root: عله (ʿ-L-H) — [Noted as a rare root; no direct bearing on this passage’s core terms, but included per lexical apparatus.]\n- Root: ايم (A-Y-M) — [Noted as a rare root; no direct bearing on this passage’s core terms, but included per lexical apparatus.]\n- Root: نفس (N-F-S)\n  * Al-Raghib (Mufradat): The self (nafs) as the locus of volitional restraint — patience is an act of the nafs holding itself back, distinguishing it from mere physical endurance.\n  * Al-Zamakhshari (Asas): Literal: “a precious thing” (nafīs). Metaphorical: “he poured out his soul” (i.e., his blood), and “everything that has no flowing soul does not defile water.”\n- Sibawayh Rule: Restriction and Focused Predication (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — Governing the exclusive clause {«إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ»}, where innamā restricts the reward-without-account solely to the patient, and {«الصَّوْمُ لِي وَأَنَا أَجْزِي بِهِ»}, where the predicate is focused to Allah alone.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'","badge":"Insight"}],"143":[{"arabic":"يضطرب في غشيته فلما أفاق قال سبحانك ما أعظم شأنك تبت إليك وتوكلت عليك وآمنت بأنك الملك الجبار الواحد القهار فلا أخاف غيرك ولا أرجو سواك ولا أعوذ إلا بعفوك من عقابك وبرضاك من سخطك وما لي إلا أن أسألك وأتضرع إليك وأبتهل بين يديك فأقول اشرح لي صدري لأعرفك واحلل عقدة من لساني لأثني عليك فنودي من وراء الحجاب إياك أن تطمع في الثناء وتزيد على سيد الأنبياء بل ارجع إليه فما آتاك فخذه وما نهاك عنه فانته عنه وما قاله لك فقله فإنه ما زاد في هذه الحضرة على أن قال سبحانك لا أحصي ثناء عليك أنت ك","english":"...its mover is Power (al-qudrah) without any doubt. So the seeker (al-sālik) journeyed on to the world of Power, and there he beheld wonders before which all that had preceded seemed contemptible. He asked Power concerning the movement of the right hand, and it said: \"I am but an attribute (innamā anā ṣifah) — ask the Powerful One (al-Qādir), for the reliance is upon the described substances (al-mawṣūfāt), not upon the attributes.\" At that point he almost deviated and unleashed the tongue of questioning with audacity, but he was steadied by the firm word (al-qawl al-thābit), and a caller cried out from behind the veils of the pavilions of the Divine Presence: \"He is not asked about what He does, but they shall be asked\" {«لَا يُسْأَلُ عَمَّا يَفْعَلُ وَهُمْ يُسْأَلُونَ»}. Then the awe of the Presence overwhelmed him, and he fell down stricken, convulsing in his swoon. When he regained consciousness, he said: \"Glory be to You — how magnificent is Your majesty! I repent unto You, and I place my trust in You, and I believe that You are the Sovereign, the Compeller, the One, the Subduer. I fear none but You, I hope for none other than You, and I seek refuge only in Your pardon from Your punishment, and in Your good pleasure from Your wrath. I have nothing but to ask of You and to supplicate before You, and to plead humbly in Your presence, saying: 'Expand my breast that I may know You, and loosen the knot from my tongue that I may praise You.'\"","book_title":"Monotheism and Reliance","section_title_ar":"Section 1111","section_title_en":"The Unification of the Acts — The Journey of the Seekers to the Oneness of the Agent","section_index":1111,"anchors":"- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core meaning of measuring, determining, and empowering; al-Qadir as the One whose power is absolute and unbounded.\n  * Al-Raghib (Mufradat): Power (qudrah) when ascribed to God is the negation of incapacity ('ajz); when ascribed to man it is a contingent capacity limited by divine ordainment.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) — \"He is Qadir, Muqtadir, possessor of power\"; metaphorical (majaz) — \"a far-reaching steed\" (ba'id al-qadr), indicating extension of effect.\n- Root: وحد (w-ḥ-d)\n  * Lisan / Ayn: Oneness and singularity; al-Wahid as that which has no part whatsoever.\n  * Al-Raghib (Mufradat): True unity (wahdah) is absolute indivisibility; applied to God exclusively in the sense of unique sovereignty.\n  * Al-Zamakhshari (Asas): \"He is one (wahid), and they are singular (wuhdan)\"; literal unity versus numerical oneness.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as perception of a thing's reality; the mark or sign by which something is known.\n  * Al-Raghib (Mufradat): Knowledge ('ilm) is the apprehension of a thing in its true reality — either grasping the essence or judging its attributes.\n  * Al-Zamakhshari (Asas): Literal — \"I knew not of your news\" (ma 'alimtu bi-khabarika); the knower as one marked by discernment.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — \"Innamā anā ṣifah\" (I am but an attribute) restricts the speaker's essence to being a mere accident, redirecting inquiry to the substantive subject (al-mawṣūf).","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Monotheism and Reliance'","badge":"Ethics"}],"146":[{"arabic":"قد ذم الله الكبر في مواضع من كتابه وذم كل جبار متكبر فقال تعالى {سأصرف عن آياتي الذين يتكبرون في الأرض بغير الحق} وقال عز وجل {كذلك يطبع الله على كل قلب متكبر جبار} وقال تعالى {واستفتحوا وخاب كل جبار عنيد} وقال تعالى {إنه لا يحب المستكبرين} وقال تعالى {لقد استكبروا في أنفسهم وعتوا عتوا كبيرا} وقال تعالى {إن الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين} وذم الكبر في القرآن كثير وقد قال رسول الله صلى الله عليه وسلم لا يدخل الجنة من كان في قلبه مثقال حبة من خردل من كبر ولا يدخل الجنة من كان في قلبه مثقال حبة من خردل من إيمان (1) حديث أبي هريرة يقول ال","english":"To proceed: The Messenger of God, may God bless him and grant him peace, said — God, exalted be He, said: \"Pride (al-kibriyāʾ) is My cloak, and greatness (al-ʿaẓamah) is My wrapper; whoever contends with Me over either of them, I crush him.\" {«الكبرياء ردائي والعظمة إزاري فمن نازعني فيهما قصمته»} (1) — A hadith of the three destructive matters, related by al-Bazzār, al-Ṭabarānī, and al-Bayhaqī in al-Shuʿab, from Anas with a weak chain, and it has also been mentioned previously.","book_title":"Condemnation of Pride and Conceit","section_title_ar":"Section 847","section_title_en":"The Book of Condemnation of Pride and Self-Admiration — Being the Ninth Book of the Quarter of Destructive Matters from The Revival of the Religious Sciences","section_index":847,"anchors":"- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core root denotes magnitude, whether physical size, age, or rank; \"al-kibriyā'\" is the supreme majesty exclusive to God.\n  * Al-Raghib (Mufradat): \"al-kabīr wa al-ṣaghīr\" are relative terms; used for quantity, quality, and dignity. \"al-kibriyā'\" is a divine attribute signifying His exclusive greatness, which none may contest.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"kabura al-amr\" (the matter became grave); \"kabura ʿalayhi\" (it weighed heavily upon him). Metaphorical (Majaz): \"takabbara\" (to act haughtily) is a figurative extension of claiming a magnitude one does not possess, as in the divine saying.\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: Astonishment at something extraordinary; \"al-ʿujb\" is self-amazement, a state where one marvels at his own qualities.\n  * Al-Raghib (Mufradat): Astonishment arises from ignorance of the true cause; self-admiration (ʿujb) blinds one to one's own defects and to the divine origin of all good.\n  * Al-Zamakhshari (Asas): Literal: \"ʿajiba minhu\" (he marveled at it). Metaphorical: \"iʿjāb al-nafs\" is the soul's complacency with itself, a hidden form of pride that does not require another object.\n- Root: هلك (h-l-k)\n  * Lisan / Ayn: Perishing, destruction, ruin; \"al-muhlikāt\" are the things that cause perdition.\n  * Al-Raghib (Mufradat): Destruction is of three kinds: loss, corruption, and death. Here it is spiritual perdition — the ruin of the soul's eternal felicity.\n  * Al-Zamakhshari (Asas): Literal: physical ruin. Metaphorical: \"tahālaka ʿalayhi\" (to be consumed with craving for something); the soul's destruction through vice is a figurative death.\n- Sibawayh Rule: Rule of Apposition and Parenthetical Clauses (al-badal wa al-iʿtirāḍ) — The opening doxology employs extended appositional chains (badal) and parenthetical invocations that delay the main clause, requiring the translator to preserve the periodic structure without collapsing the theological weight of each divine epithet.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Pride and Conceit'","badge":"Hadith"},{"arabic":"ومن لم يكن نظره اعتبارا فهو لهو وفي قوله تعالى سأصرف عن آياتي الذين يتكبرون في الأرض يغير الحق قال أمنع قلوبهم التفكر في أمرى وعن أبى سعيدى الخدري قال قال رسول الله صلى الله عليه وسلم أعطوا أعينكم حظها من العبادة فقالوا يا رسول الله وما حظها من العبادة قال النظر في المصحف والتفكر فيه والاعتبار عند عجائبه (4) وعن امرأة كانت تسكن البادية قريبا من مكة أنها قالت لو تطالعت قلوب المتقين بفكرها إلى ما قد ادخر لها في حجب الغيب من خير الآخرة لم يصف لهم في الدنيا عيش ولم تقر لهم في الدنيا عين وكان لقمان يطيل الجلوس وحده فكان يمر به مولاه فيقول يا لقمان","english":"And it is related from Ṭāwūs that he said: The disciples (al-Ḥawāriyyūn) said to Jesus son of Mary (ʿalayhi al-salām): \"O Spirit of God, is there upon the earth today anyone like you?\" He said: \"Yes — whoever's speech is remembrance (dhikr), whose silence is reflection (fikr), and whose gaze is a lesson (ʿibrah) — then he is like me.\"","book_title":"Contemplation","section_title_ar":"Section 1258","section_title_en":"The Virtue of Reflection (Faḍīlat al-Tafakkur) — Section 1258","section_index":1258,"anchors":"- Root: فكر (F-K-R)\n  * Lisan / Ayn: Core root denotes the power of intellective search; \"الفكرة: قوة مطرقة للعلم إلى المعلوم\" — a force driving knowledge toward the known.\n  * Al-Raghib (Mufradat): \"التفكر: جولان تلك القوة بحسب نظر العقل\" — reflection is the circulation of that force according to rational consideration; exclusive to humans, not animals; only said of what can be imaged in the heart.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"ما دار حوله فكري\" — what revolves around one's reflection. Metaphorical (Majaz): \"لفلان فكر، كلها فقر\" — reflection likened to diving for pearls (مغاص الدرر).\n- Root: جلس (J-L-S)\n  * Lisan / Ayn: \"ناقة جَلْس\" — firm/robust she-camel; \"الجُلْسان: ما حول الحدقة\" — what surrounds the pupil (eye-socket).\n  * Al-Raghib (Mufradat): \"أصل الجلس: الغليظ من الأرض\" — origin: elevated firm ground; then generalized to any sitting (قعود).\n  * Al-Zamakhshari (Asas): Literal: \"هو حسن الجلسة\" — good posture in sitting. Metaphorical: \"فلان جليس نفسه\" — one who is companion to himself (solitary by choice).\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — turning a thing from one face to another.\n  * Al-Raghib (Mufradat): \"قلب الإنسان: صرفه عن طريقته\" — turning the heart from its course; \"الانقلاب: الانصراف\" — reversion.\n  * Al-Zamakhshari (Asas): Literal: \"قلب رداءه\" — turning one's garment. Metaphorical: \"قلب المعلم الصبيان: صرفهم إلى بيوتهم\" — the teacher turning the boys back home; \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and devises.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — Permissibility of interposing elements between a governing word and its governed prepositional phrase when the interposed material is syntactically complete, as in \"إن به\" constructions; here governing the periodic structure of reported sayings (e.g., \"قال الحسن: من لم يكن...\") where the conditional clauses are interposed between the verb of saying and its content.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'","badge":"Insight"}],"154":[{"arabic":"والعلم والرضوان وهي مجامع مقامات أهل الجنان وقال الله تعالى وهدى ورحمة للذين هم لربهم يرهبون وقال تعالى {إنما يخشى الله من عباده العلماء} وصفهم بالعلم لخشيتهم وقال عز وجل {رضي الله عنهم ورضوا عنه ذلك لمن خشي ربه} وكل ما دل على فضيلة العلم دل على فضيلة الخوف لأن الخوف ثمرة العلم ولذلك جاء في خبر موسى عليه أفضل الصلاة والسلام وأما الخائفون","english":"As for the path of derivation (iqtibās) from the verses and reports, what has been transmitted concerning the virtue of fear is beyond enumeration. And sufficient as an indication of its virtue is that God—may He be exalted—has gathered together for the fearful (khāʾifūn) guidance (hudā), mercy (raḥmah), knowledge (ʿilm), and good pleasure (riḍwān)—and these are the sum total of the stations of the people of Paradise. God—may He be exalted—said: {وهدى ورحمة للذين هم لربهم يرهبون} \"And guidance and mercy for those who of their Lord are fearful\" [Al-Aʿrāf: 154]. And He—exalted is He—said: {إنما يخشى الله من عباده العلماء} \"Only those of His servants who possess knowledge fear God\" [Fāṭir: 28]—describing them with knowledge on account of their fear [of Him].","book_title":"Fear and Hope","section_title_ar":"Section 1041","section_title_en":"Exposition of the Virtue of Fear (Khawf) and Encouragement Thereof","section_index":1041,"anchors":"- Root: خوف (Khawf)\n  * Lisan / Ayn: Core root denotes trepidation, apprehension, and the state of being overtaken by dread of a feared outcome.\n  * Al-Raghib (Mufradat): \"الخوف: توقع مكروه عن أمارة مظنونة، أو معلومة\" — the anticipation of something detestable based on a probable or certain indication; it is the direct opposite of amn (security) and applies to both worldly and otherworldly matters.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"خفته على مالي خوفا وخيفة\" — fearing for something. Metaphorical (Majaz): \"تخوفه: تنقصه\" — to diminish gradually, as fear consumes the soul piecemeal.\n- Root: فضل (Fadl)\n  * Lisan / Ayn: Excess, superiority, or merit beyond the baseline of sufficiency.\n  * Al-Raghib (Mufradat): \"الفضل: الزيادة عن الاقتصاد\" — increase beyond moderation; the praiseworthy type is like the surplus of knowledge and forbearance, and it is measured by its end (ghāyah).\n  * Al-Zamakhshari (Asas): Literal: \"مال فلان فاضل: كثير يفضل عن القوت\" — surplus wealth exceeding necessity. The virtue of a thing is gauged by its instrumental efficacy toward a noble goal.\n- Root: علم (ʿIlm)\n  * Lisan / Ayn: Certain cognition and apprehension of a thing as it truly is.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — apprehension of a thing's reality; it is the root from which khawf branches as its fruit.\n  * Al-Zamakhshari (Asas): Literal: \"ما علمت بخبرك: ما شعرت به\" — to have cognizance. The scholars (ʿulamāʾ) are so named for their knowledge, which necessarily engenders fear of God.\n- Sibawayh Rule: Restriction and Focused Predication (باب الحصر والتقييد) — governing the exclusive attribution in {إنما يخشى الله من عباده العلماء}, where the predicate restricts fear to the knowledgeable, and the syntactic fronting of \"whom they fear\" (لربهم يرهبون) emphasizes the object of reverential dread.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'","badge":"Insight"}],"155":[{"arabic":"مسلمين أنت ولي في الدنيا والآخرة توفني مسلما وألحقني بالصالحين أنت ولينا فاغفر لنا وارحمنا وأنت خير الغافرين واكتب لنا في هذه الدنيا حسنة وفي الآخرة إنا هدنا إليك ربنا عليك توكلنا وإليك أنبنا وإليك المصير ربنا لا تجعلنا فتنة للقوم الظالمين ربنا لا تجعلنا فتنة للذين كفروا واغفر لنا ربنا إنك أنت العزيز الحكيم ربنا اغفر لنا ذنوبنا وإسرافنا في أمرنا وثبت أقدامنا وانصرنا على القوم الكافرين ربنا اغفر لنا ولإخواننا الذين سبقونا بالإيمان ولا تجعل في قلوبنا غلا للذين آمنوا ربنا إنك رؤوف رحيم ربنا آتنا من لدنك رحمة وهيئ لنا من أمرنا رشدا ربنا آتنا في الدني","english":"And employ me in righteous deeds which You will accept from me. (1) O God, I ask You for pardon, well-being, good certainty, and soundness in this world and the next. (2) O You Whom sins do not harm and from Whom forgiveness does not diminish anything — grant me that which will not harm You, and give me that which will not diminish You. Our Lord, pour upon us patience and cause us to die as Muslims. You are our Protector in this world and the next; cause me to die as a Muslim and join me with the righteous. You are our Protector, so forgive us and have mercy upon us, and You are the Best of forgivers. And write for us good in this world and in the Hereafter — indeed, we have turned to You in repentance. Our Lord, upon You we rely, to You we turn in repentance, and to You is the final return. Our Lord, make us not a trial for the wrongdoing people. Our Lord, make us not a trial for those who disbelieve, and forgive us, our Lord — indeed, You are the Mighty, the Wise. Our Lord, forgive us our sins and our excesses in our affairs, make firm our feet, and grant us victory over the disbelieving people. Our Lord, forgive us and our brothers who preceded us in faith, and place not in our hearts any rancor toward those who believe — our Lord, indeed You are Kind, Merciful. Our Lord, grant us from Yourself mercy and prepare for us from our affair right guidance. Our Lord, give us good in this world and good in the Hereafter, and protect us from the chastisement of the Fire. Our Lord, indeed we have heard a caller calling to faith — to His saying, Mighty and Majestic: {«إنك لا تخلف الميعاد»} [آل عمران/ 194] — Our Lord, do not take us to task if we forget or err. Our Lord, to the end of the surah. (3) My Lord, forgive me and my parents, and have mercy upon them as they raised me when I was small; and forgive the believing men and the believing women, and the Muslim men and the Muslim women, the living among them and the dead. (4) My Lord, forgive, have mercy, and overlook what You know — and You are the Most Exalted, the Most Generous, the Best of the merciful, and the Best of the forgivers. And indeed, to God we belong and to Him we return; and there is no might and no power except through God, the Exalted, the Magnificent; and God suffices us, and He is the Best Disposer of affairs. And may God send blessings upon Muhammad, the Seal of the Prophets, and upon his family and his companions, and grant them abundant peace. (5)","book_title":"On Invocations and Supplications","section_title_ar":"Section 252","section_title_en":"Section 252 — Supplications for Morning and Evening: Comprehensive Prayers of the Prophet (ﷺ)","section_index":252,"anchors":"- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core meaning of swallowing/ingesting (iltihām); from this derives the sense of something being cast directly into the innermost recess of the heart (al-rawʿ).\n  * Al-Raghib (Mufradat): \"الإلهام: إلقاء الشيء في الروع\" — ilhām is the casting of a thing into the innermost consciousness, specifically from God or the higher assembly (al-malaʾ al-aʿlā). It is that which the Prophet (ﷺ) called \"the touch of the angel\" (limat al-malak) and \"the breath of the Holy Spirit in my innermost heart\" (nafth rūḥ al-qudus fī rawʿī).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ألهمه الله الخير: ألقاه في روعه\" — God inspired him with good: He cast it into his innermost consciousness. Metaphorical (majāz): A horse that \"swallows the ground\" (yaltaḥimu al-arḍ) in swiftness; thus ilhām is the swift, direct ingress of divine guidance into the soul without intermediary effort.\n- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: The root denotes praise arising from recognition of voluntary excellence and beneficence; al-ḥamd is commendation of the beloved for their attributes and acts of goodness.\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence (niʿmah) with reverence and love; it is distinguished from mere thanks (shukr) in that it is directed to the essence and attributes of the praised one, not solely to the benefit received.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — I praise God with all His praiseworthy attributes. Metaphorical: \"أحمدت صنيعه\" — I found his deed praiseworthy; thus the tongue's praise must be matched by the heart's recognition of the praised one's perfection.\n- Root: غفر (gh-f-r)\n  * Lisan / Ayn: The root denotes covering and shielding; al-mighfar is the helmet that protects the head in battle.\n  * Al-Raghib (Mufradat): \"الغفر: إلباس ما يصونه عن الدنس\" — Forgiveness is the clothing of that which shields from filth. God's forgiveness (maghfirah) is His shielding of the servant from the touch of chastisement, covering the sin so that it is as though it never were.\n  * Al-Zamakhshari (Asas): Literal: \"اللهم غفرًا\" — O God, forgive. Metaphorical: The she-beasts that \"did not forgive\" their heedlessness (lam taghfir la-hā ghaflātuhā) — i.e., they did not shield their young from destruction; thus forgiveness is active protection, not mere erasure.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which breathes and has vital spirit; also used for the very essence of a thing.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul is the spirit; and in God's saying {«ويحذركم الله نفسه»} [آل عمران/ 28], \"His Self\" means His very essence (dhāt), which — though grammatically expressed as an annexation implying distinction — is in reality identical, with no multiplicity in the Divine Essence.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس\" — a precious thing. Metaphorical: \"دفق نفسه\" — he poured out his blood/life; thus nafs is the seat of life, passion, and moral responsibility.\n- Sibawayh Rule: باب الدعاء والخبر (The Chapter of Supplication and Assertion) — Supplications (duʿāʾ) are grammatically constructed as optative sentences (inshāʾ ṭalabī) using the imperative (rabbighfir), the jussive (lā tuʾākhidhnā), and the vocative (rabbanā), yet they may embed assertive clauses (khabar) of praise (al-ḥamdu lillāh) and attestation (lā ilāha illā anta). The periodic structure of these prayers alternates between direct address to God (munādāh) and self-referential confession, requiring the translator to preserve the vocative force of \"O God\" and \"Our Lord\" without flattening into mere description.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'","badge":"Hadith"},{"arabic":"أنت ولينا فاغفر لنا وارحمنا وأنت خير الغافرين واكتب لنا في هذه الدنيا حسنة وفي الآخرة إنا هدنا إليك ربنا عليك توكلنا وإليك أنبنا وإليك المصير ربنا لا تجعلنا فتنة للقوم الظالمين ربنا لا تجعلنا فتنة للذين كفروا واغفر لنا ربنا إنك أنت العزيز الحكيم ربنا اغفر لنا ذنوبنا وإسرافنا في أمرنا وثبت أقدامنا وانصرنا على القوم الكافرين ربنا اغفر لنا ولإخواننا الذين سبقونا بالإيمان ولا تجعل في قلوبنا غلا للذين آمنوا ربنا إنك رؤوف رحيم ربنا آتنا من لدنك رحمة وهيئ لنا من أمرنا رشدا ربنا آتنا في الدن","english":"And employ me in righteous deeds which You will accept from me. (1) O God, I ask You for pardon, well-being, good certainty, and soundness in this world and the next. (2) O You Whom sins do not harm and from Whom forgiveness does not diminish anything — grant me that which will not harm You, and give me that which will not diminish You. Our Lord, pour upon us patience and cause us to die as Muslims. You are our Protector in this world and the next; cause me to die as a Muslim and join me with the righteous. You are our Protector, so forgive us and have mercy upon us, and You are the Best of forgivers. And write for us good in this world and in the Hereafter — indeed, we have turned to You in repentance. Our Lord, upon You we rely, to You we turn in repentance, and to You is the final return. Our Lord, make us not a trial for the wrongdoing people. Our Lord, make us not a trial for those who disbelieve, and forgive us, our Lord — indeed, You are the Mighty, the Wise. Our Lord, forgive us our sins and our excesses in our affairs, make firm our feet, and grant us victory over the disbelieving people. Our Lord, forgive us and our brothers who preceded us in faith, and place not in our hearts any rancor toward those who believe — our Lord, indeed You are Kind, Merciful. Our Lord, grant us from Yourself mercy and prepare for us from our affair right guidance. Our Lord, give us good in this world and good in the Hereafter, and protect us from the chastisement of the Fire. Our Lord, indeed we have heard a caller calling to faith — to His saying, Mighty and Majestic: {«إنك لا تخلف الميعاد»} [آل عمران/ 194] — Our Lord, do not take us to task if we forget or err. Our Lord, to the end of the surah. (3) My Lord, forgive me and my parents, and have mercy upon them as they raised me when I was small; and forgive the believing men and the believing women, and the Muslim men and the Muslim women, the living among them and the dead. (4) My Lord, forgive, have mercy, and overlook what You know — and You are the Most Exalted, the Most Generous, the Best of the merciful, and the Best of the forgivers. And indeed, to God we belong and to Him we return; and there is no might and no power except through God, the Exalted, the Magnificent; and God suffices us, and He is the Best Disposer of affairs. And may God send blessings upon Muhammad, the Seal of the Prophets, and upon his family and his companions, and grant them abundant peace. (5)","book_title":"Arrangement of Litanies","section_title_ar":"Section 252","section_title_en":"Section 252 — Supplications for Morning and Evening: Comprehensive Prayers of the Prophet (ﷺ)","section_index":252,"anchors":"- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core meaning of swallowing/ingesting (iltihām); from this derives the sense of something being cast directly into the innermost recess of the heart (al-rawʿ).\n  * Al-Raghib (Mufradat): \"الإلهام: إلقاء الشيء في الروع\" — ilhām is the casting of a thing into the innermost consciousness, specifically from God or the higher assembly (al-malaʾ al-aʿlā). It is that which the Prophet (ﷺ) called \"the touch of the angel\" (limat al-malak) and \"the breath of the Holy Spirit in my innermost heart\" (nafth rūḥ al-qudus fī rawʿī).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ألهمه الله الخير: ألقاه في روعه\" — God inspired him with good: He cast it into his innermost consciousness. Metaphorical (majāz): A horse that \"swallows the ground\" (yaltaḥimu al-arḍ) in swiftness; thus ilhām is the swift, direct ingress of divine guidance into the soul without intermediary effort.\n- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: The root denotes praise arising from recognition of voluntary excellence and beneficence; al-ḥamd is commendation of the beloved for their attributes and acts of goodness.\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence (niʿmah) with reverence and love; it is distinguished from mere thanks (shukr) in that it is directed to the essence and attributes of the praised one, not solely to the benefit received.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — I praise God with all His praiseworthy attributes. Metaphorical: \"أحمدت صنيعه\" — I found his deed praiseworthy; thus the tongue's praise must be matched by the heart's recognition of the praised one's perfection.\n- Root: غفر (gh-f-r)\n  * Lisan / Ayn: The root denotes covering and shielding; al-mighfar is the helmet that protects the head in battle.\n  * Al-Raghib (Mufradat): \"الغفر: إلباس ما يصونه عن الدنس\" — Forgiveness is the clothing of that which shields from filth. God's forgiveness (maghfirah) is His shielding of the servant from the touch of chastisement, covering the sin so that it is as though it never were.\n  * Al-Zamakhshari (Asas): Literal: \"اللهم غفرًا\" — O God, forgive. Metaphorical: The she-beasts that \"did not forgive\" their heedlessness (lam taghfir la-hā ghaflātuhā) — i.e., they did not shield their young from destruction; thus forgiveness is active protection, not mere erasure.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which breathes and has vital spirit; also used for the very essence of a thing.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul is the spirit; and in God's saying {«ويحذركم الله نفسه»} [آل عمران/ 28], \"His Self\" means His very essence (dhāt), which — though grammatically expressed as an annexation implying distinction — is in reality identical, with no multiplicity in the Divine Essence.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس\" — a precious thing. Metaphorical: \"دفق نفسه\" — he poured out his blood/life; thus nafs is the seat of life, passion, and moral responsibility.\n- Sibawayh Rule: باب الدعاء والخبر (The Chapter of Supplication and Assertion) — Supplications (duʿāʾ) are grammatically constructed as optative sentences (inshāʾ ṭalabī) using the imperative (rabbighfir), the jussive (lā tuʾākhidhnā), and the vocative (rabbanā), yet they may embed assertive clauses (khabar) of praise (al-ḥamdu lillāh) and attestation (lā ilāha illā anta). The periodic structure of these prayers alternates between direct address to God (munādāh) and self-referential confession, requiring the translator to preserve the vocative force of \"O God\" and \"Our Lord\" without flattening into mere description.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Arrangement of Litanies'","badge":"Hadith"},{"arabic":"تكون مغفرتك إلا لمثلنا اللهم فاغفر لنا وارحمنا واسقنا فرفع يديه ورفعوا أيديهم فسقوا وقيل لمالك بن دينار ادع لنا ربك فقال إنكم تستبطئون المطر وأنا أستبطىء الحجارة وروي أن عيسى صلوات الله عليه وسلامه خرج يستسقي فلما ضجروا قال لهم عيسى عليه السلام من أصاب منكم ذنبا فليرجع فرجعوا كلهم ولم يبق معه في المفازة إلا واحد فقال له عيسى عليهم السلام أما لك من ذنب فقال والله ما علمت من شيء غير أني كنت ذات يوم أصلي فمرت بي امرأة فنظرت إليها بعيني هذه فلما جاوزتني أدخلت أصبعي في عيني فانتزعتها وتبعت المرأة بها فقال له عيسى عليه السلام فادع الله حتى أؤمن على دعائك قال فدعا فتجللت السماء سحابا ثم صبت فسقوا وقال يحيى الغساني أصاب الناس قحط على عهد داود عليه السلام فاختاروا ثلاثة من علمائهم فخرجوا حتى يستسقوا بهم فقال أحدهم اللهم إنك أنزلت في توراتك أن نعفو عمن ظلمنا اللهم إنا قد ظلمنا أنفسنا فاعف عنا وقال الثاني اللهم إنك أنزلت في توراتك أن نعتق أرقاءنا اللهم إنا أرقاؤك فأعتقنا وقال الثالث اللهم إنك أنزلت في توراتك أن لا نرد المساكين إذا وقفوا بأبوابنا اللهم إنا مساكينك وقفنا ببابك فلا ترد دعاءنا فسقوا وقال عطاء السلمي منعنا الغيث فخرجنا نستسقي فإذا نحن بسعدون المجنون في المقابر فنظر إلي فقال يا عطاء أهذا يوم النشور أوبعثر ما في القبور فقلت لا ولكنا منعنا الغيث فخرجنا نستسقي فقال يا عطاء بقلوب أرضية أم بقلوب سماوية فقلت بل بقلوب سماوية فقال هيهات يا عطاء قل للمتبهرجين لا تتبهرجوا فإن الناقد بصير ثم رمق السماء بطرفه وقال إلهي وسيدي ومولاي لا تهلك بلادك بذنوب عبادك ولكن بالسر المكنون من أسمائك وما وارت الحجب من آلائك إلا ما سقيتنا ماء غدقا فراتا تحيي به العباد وتروي به البلاد يا من هو على كل شيء قدير قال عطاء فما استتم الكلام حتى أرعدت السماء وأبرقت وجادت بمطر كأفواه القرب فولى وهو يقول أفلح الزاهدون والعابدونا ...","english":"[Root: دعو]\n  • Lisan al-Arab: \"الدعاء: الرغبة إلى الله تعالى، والابتهال في المسألة. والدعوة: الكلمة التي يدعو بها. وأصل الدعاء: طلب الإقبال من الغير.\"\n  • Al-Raghib (Mufradat): \"الدعاء: ضربان: أحدهما دعاء العبادة، والآخر دعاء المسألة. فدعاء العبادة: هو توجه العبد إلى الله تعالى بالطاعة. ودعاء المسألة: طلب الحاجة من الله تعالى. قال تعالى: {وقال ربكم ادعوني أستجب لكم}.\"\n  • Al-Zamakhshari (Asas - Haqiqah/Literal): \"دعا فلان ربه: ابتهل إليه بالسؤال. ودعا الله: عبده. ومنه قوله تعالى: {إن الذين يستكبرون عن عبادتي} أي عن دعائي.\"\n  • Al-Zamakhshari (Asas - Majaz/Metaphorical): \"دعا عليه: سأل الله أن يصيبه بمكروه. ودعا له: سأل الله أن يحسن إليه. ومن المجاز: دعا الأمر إلى كذا، أي أدى إليه.\"","book_title":"On Invocations and Supplications","section_title_ar":"Section 242","section_title_en":"Section 242","section_index":242,"anchors":"*(Anchors established)*","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'On Invocations and Supplications'","badge":"Afterlife"},{"arabic":"قول موسى عليه السلام إن هي إلا فتنتك تضل بها من تشاء وتهدي من تشاء وقوله في التعليل والاعتذار لما قيل له اذهب إلى فرعون {فقال} ولهم على ذنب وقوله إني أخاف أن يكذبون ويضيق صدري ولا ينطلق لساني وقوله إننا نخاف أن يفرط علينا أو أن يطغى وهذا من غير موسى عليه السلام من سوء الأدب لأن الذي أقيم مقام الأنس يلاطف ويحتمل ولم يحتمل ليونس عليه السلام ما دون هذا لما أقيم مقام القبض والهيبة فعوقب بالسجن في بطن الحوت في ظلمات ثلاث ونودي عليه إلى يوم القيامة لولا أن تداركه نعمة من ربه لنبذ بالعراء وهو مذموم قال الحسن العراء هو","english":"As for Adam (peace be upon him), it was said concerning him: {«وعصى آدم ربه فغوى»} \"And Adam disobeyed his Lord, so he went astray\" (Q. 20:121), then {«اجتباه ربه فتاب عليه وهدى»} \"his Lord chose him, and turned to him in forgiveness, and guided him\" (Q. 20:122).","book_title":"Love, Longing, Intimacy and Contentment","section_title_ar":"Section 1187","section_title_en":"On the Varieties of Divine Proximity (Al-Inbisāṭ) and Awe (Al-Haybah) in the States of the Prophets and Saints","section_index":1187,"anchors":"- Root: بسط (B-S-T)\n  * Lisan / Ayn: Core meaning is \"to spread out, extend, expand\" — both physically (basting a garment) and metaphorically.\n  * Al-Raghib (Mufradat): Theological nuance: \"بسط الشيء: نشره وتوسيعه\" — used for expansion of mercy, favor, and the soul's comfort. In Kalam, it contrasts with *qabḍ* (contraction/withholding).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"بسط الثوب والفراش إذا نشره.\" Metaphorical (Majaz): \"بسطني ما بسطك\" (what pleases you pleases me) — hence *inbisāṭ* here denotes the soul's expansive intimacy with God, a spiritual state, not a physical act.\n- Root: أبلس (B-L-S)\n  * Lisan / Ayn: \"أبلس: انقطعت حجته ويئس\" — to be reduced to silence, to despair.\n  * Al-Raghib (Mufradat): \"الإبلاس: الحزن المعترض من شدة اليأس\" — the despair of Iblis is a theological state of being cut off from mercy.\n  * Al-Zamakhshari (Asas): Literal: despair/silence. Metaphorical: Iblis (the proper name) is derived from this root — he is the one \"despairing\" of divine mercy.\n- Root: عله (not used; avoided per instruction) — *Note: The text's key term \"الإدلال\" (al-idlāl) is from root دلو (D-L-W).*\n- Root: دلو (D-L-W)\n  * Lisan / Ayn: \"دلا الدلو: أخرجها من البئر\" — to draw water from a well; hence *iddalā'a* (إدلال) means to advance boldly, relying on a familiar bond.\n  * Al-Raghib (Mufradat): Not a primary Quranic term, but lexically implies confident approach based on prior intimacy.\n  * Al-Zamakhshari (Asas): Literal: lowering the bucket. Metaphorical: \"أدلّ عليه\" — to act with bold familiarity toward someone who loves you, trusting in their affection.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Applied in the phrase \"فإنما هي عند ذوي الاعتبار من الأسماء\" (they are but names to those who reflect), restricting the ontological status of stories to mere signifiers for the discerning.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'","badge":"Insight"}],"157":[{"arabic":"في الناس يأمرهم بالمعروف وينهاهم عن المنكر ولم يكن مأمورا من عنده بذلك فأمر بأن يدل عليه فلما صار بين يديه قال له إنني بلغني أنك رأيت نفسك أهلا للأمر بالمعروف والنهي عن المنكر من غير أن نأمرك وكان المأمون جالسا على كرسي ينظر في","english":"Allah has condemned pride in numerous places of His Book, and has condemned every tyrant (jabbār) and arrogant one. He, exalted, said: {«سأصرف عن آياتي الذين يتكبرون في الأرض بغير الحق»} — \"I shall turn away from My signs those who behave arrogantly upon the earth without right.\" And He, mighty and majestic, said: {«كذلك يطبع الله على كل قلب متكبر جبار»} — \"Thus does Allah seal the heart of every arrogant tyrant.\" And He said: {«واستفتحوا وخاب كل جبار عنيد»} — \"And they sought victory, and every obstinate tyrant was disappointed.\" And He said: {«إنه لا يحب المستكبرين»} — \"Truly He does not love the arrogant.\" And He said: {«لقد استكبروا في أنفسهم وعتوا عتوا كبيرا»} — \"They were arrogant within themselves and transgressed with great transgression.\" And He said: {«إن الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين»} — \"Those who are too proud to worship Me shall enter Hell, humiliated.\" The condemnation of pride in the Qur'an is abundant.","book_title":"Enjoining Good and Forbidding Evil","section_title_ar":"Section 527","section_title_en":"Section 527 — On the Condemnation of Pride: Narrations of the Pious Predecessors and Enjoining Good Before Rulers","section_index":527,"anchors":"- Root: كرم (karuma)\n  * Lisan / Ayn: Core meaning of nobility, generosity, and honor; the root denotes the quality of being noble in character and action.\n  * Al-Raghib (Mufradat): When attributed to Allah, it signifies His manifest beneficence and grace; when attributed to humans, it denotes praiseworthy character traits and deeds that appear from them — one is not called \"noble\" (karīm) until such virtue manifests.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"كرم علينا فلان كرامة\" — he showed us honor. Metaphorical (Majaz): \"كرم السحاب تكريما: جاد بمطره\" — the cloud was generous with its rain; the term extends to any abundant giving.\n- Root: حسن (ḥasuna)\n  * Lisan / Ayn: Beauty, goodness, and excellence in form and character.\n  * Al-Raghib (Mufradat): \"الحسن: عبارة عن كل مبهج مرغوب فيه\" — that which is pleasing and desirable, divided into what is deemed good by intellect, by desire, and by sense-perception.\n  * Al-Zamakhshari (Asas): Literal: \"أنظر إلى محاسن وجهه\" — behold the beauties of his face. Metaphorical: \"فلان لا يحسن شيئا\" — he does not do anything well; \"قيمة المرء ما يحسن\" — a man's worth is what he does well.\n- Root: وجه (wajaha)\n  * Lisan / Ayn: The face; the foremost and most honored part of a thing.\n  * Al-Raghib (Mufradat): The face is the first thing one encounters and the noblest of the outward body; hence it is used for the essence and the foremost aspect of every matter.\n  * Al-Zamakhshari (Asas): Literal: \"واجهته مواجهة\" — I faced him directly. Metaphorical: \"هؤلاء وجوه البلد\" — these are the notables of the land; \"رجل وجيه\" — a man of standing and honor.\n- Root: نصر (naṣara)\n  * Lisan / Ayn: Aid, assistance, and victory.\n  * Al-Raghib (Mufradat): \"النصر والنصرة: العون\" — help and support; used of Allah's aid to His prophets and believers.\n  * Al-Zamakhshari (Asas): Literal: \"نصره الله تعالى على عدوه\" — Allah aided him against his enemy. Metaphorical: \"أرض منصورة: مغيثة\" — a land watered by rain; rain itself is called \"نصر\" (aid) as it brings life to the earth.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening phrase is complete and the meaning remains clear, as in the rhetorical constructions of admonition and rebuke found in these narrations.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Enjoining Good and Forbidding Evil'","badge":"Insight"},{"arabic":"الله تعالى للمؤمنين في قولهم {ولا تحمل علينا إصرا} وقال تعالى {ويضع عنهم إصرهم والأغلال التي كانت عليهم} وروى محمد بن الحنفية عن علي رضي الله تعالى عنهما أنه قال لما نزل قوله تعالى {فاصفح الصفح الجميل} قال يا جبريل وما الصفح الجميل قال عليه السلام إذا عفوت عمن ظلمك فلا تعاتبه فقال يا جبريل فالله تعالى أكرم من أن يعاتب من عفا عنه فبكى جبريل وبكى النبي صلى الله عليه وسلم فبعث الله تعالى إليهما ميكائيل عليه السلام وقال إن ربكما يقرئكما السلام ويقول كيف أعاتب من عفوت عنه هذا ما لا يشبه كرمي (1) والأخبار الواردة في أسباب ال","english":"In the report (khabar): \"Were you not to sin, God would create a creation who would sin, and He would forgive them.\" (1) In another wording: \"He would take you away and bring a creation who would sin, and He would forgive them — verily, He is the Forgiving, the Merciful.\" And in the report: \"Were you not to sin, I would fear for you what is worse than sins.\" It was said: \"And what is that?\" He said: \"Self-amazement (al-ʿujb).\" (2)","book_title":"Fear and Hope","section_title_ar":"Section 1034","section_title_en":"The Completion of the Matter — On the Preacher's Gentleness in Employing Reports of Fear and Hope","section_index":1034,"anchors":"- Root: لطف (luṭf)\n  * Lisan / Ayn: Gentleness, subtlety, kindness in approach; to be gracious and delicate in manner.\n  * Al-Raghib (Mufradat): Divine gentleness (luṭf) as an attribute of God's subtle providence; here, the preacher's emulation of prophetic gentleness in spiritual counsel.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — physical softness; metaphorical (majāz) — refinement of speech and manner suited to the spiritual state of the listener.\n- Root: رجا (rajā')\n  * Lisan / Ayn: Hope, expectation of good; the opposite of despair (ya's).\n  * Al-Raghib (Mufradat): Hope in God's mercy as a theological virtue balancing fear (khawf); the state of the believer who relies on divine generosity over personal merit.\n  * Al-Zamakhshari (Asas): Literal — anticipation of a future good; metaphorical — the soul's reliance on God's pardon despite sin.\n- Root: عجب (ʿajab)\n  * Lisan / Ayn: Self-amazement, vanity, wonder at oneself.\n  * Al-Raghib (Mufradat): Spiritual pride (ʿujb) — a hidden sin worse than overt transgression, as it nullifies deeds.\n  * Al-Zamakhshari (Asas): Literal — astonishment; metaphorical — the heart's complacency in its own obedience, leading to ruin.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Specification) — The conditional and exceptive structures (law lā... la-khalaqa, illā an yataghammadani) govern the precise scope of divine mercy and human agency.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Fear and Hope'","badge":"Ethics"},{"arabic":"لله وأوصلهم لرحمه وآمرهم بالمعروف وأنهاهم عن المنكر (4) وقال أبو ذر رضي الله عنه أوصاني خليلي عليه السلام بصلة الرحم وإن أدبرت وأمرني أن أقول الحق وإن كان مرا (5) وقال صلى الله عليه وسلم إن الرحم معلقة بالعرش وليس الواصل بالمكافئ ولكن الواصل الذي إذا انقطعت رحمه وصلها (6) وقال صلى الله عليه وسلم إن أعجل الطاعة ثوابا صلة الرحم حتى إن أهل البيت ليكونون فجارا فتنموا أموالهم ويكثر عددهم إذا وصلوا أرحامهم (7) وقال زيد بن أسلم لما خرج رسول الله صلى الله عليه وسلم إلى مكة عرض له رجل فقال إن كنت تر","english":"The Messenger of Allah ﷺ said — Allah Most High declares: \"I am al-Raḥmān (the Merciful), and this is the raḥim (womb-relationship). I have split for it a name from My name. Whoever joins it, I join him; and whoever cuts it, I cut him off.\" (1)","book_title":"Duties of Brotherhood","section_title_ar":"Section 438","section_title_en":"The Rights of Kinsfolk and the Womb-Relationship (Ḥuqūq al-Aqārib wa al-Raḥim)","section_index":438,"anchors":"- Root: رحم (Ra-Ḥa-Mīm)\n  * Lisan / Ayn: The womb, the organ of gestation; by extension, the bond of kinship that issues from shared uterine origin. Al-Farahidi notes its derivation from mercy (raḥmah), as the womb is the locus of compassion's first manifestation.\n  * Al-Raghib (Mufradat): Raḥim denotes both the physical womb and the relational bond of consanguinity. Allah's attribute al-Raḥmān is that mercy which encompasses all creation, while the raḥim is that specific bond which He has named from His own name, indicating a divinely instituted correspondence between human kinship-ties and divine mercy.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): the womb as physical organ. Metaphorical (majāz): the kinship-bond itself, as in \"waṣala raḥimahu\" (he joined his womb-relation), meaning he maintained the ties of kinship. The prophetic ḥadīth \"al-raḥim muʿallaqah bi-al-ʿarsh\" employs personification as rhetorical emphasis of its cosmic significance.\n- Sibawayh Rule: باب الإضافة والمعنى الإسنادي (Construct Phrase & Predicative Meaning) — The phrase \"ḥuqūq al-aqārib\" is an annexation (iḍāfah) where the first term (ḥuqūq) is unspecified in definiteness by the second (al-aqārib), yielding \"rights of the kinsfolk\" — a genitive construction indicating that these rights inhere in the very nature of the kinship relation itself.","content_type":"general","topic":"Classical commentary from Al-Ghazali's Ihya Ulum al-Din, from 'Duties of Brotherhood'","badge":"Commentary"},{"arabic":"وقيل لداود الطائي رحمه الله أرأيت رجلا دخل على هؤلاء الأمراء فأمرهم بالمعروف ونهاهم عن المنكر فقال أخاف عليه السوط قال إنه يقوى عليه قال أخاف عليه السيف قال إنه يقوى عليه قال أخاف عليه الداء الدفين وهو العجب الدرجة الرابعة السب والتعنيف بالقول الغليظ الخشن وذلك يعدل إليه عند العجز عن المنع باللطف وظهور مبادىء الإصرار والاستهزاء بالوعظ والنصح وذلك مثل قول إبراهيم عليه السلام أف لكم ولما تعبدون من دون الله أفلا تعقلون ولسنا نعني بالسب والفحش بما فيه نسبة إلى الزنا ومقدماته ولا الكذب بل أن يخاطبه بما فيه مما لا يعد من جملة الفحش كقوله يا ف","english":"And at this point it is said to him what was said to Jesus, peace be upon him: \"O son of Mary, exhort yourself; if you are admonished, then exhort the people — and if not, then be ashamed before Me.\"","book_title":"Enjoining Good and Forbidding Evil","section_title_ar":"Section 540","section_title_en":"The Revival of the Religious Sciences — Section 540: On Gentleness in Forbidding Wrong and the Hidden Diseases of the Enjoiner","section_index":540,"anchors":"- Root: لطف (luṭf)\n  * Lisan / Ayn: Gentleness, subtlety, refinement; the opposite of harshness and roughness\n  * Al-Raghib (Mufradat): Divine gentleness (luṭf) as that which draws the servant toward obedience through kindness rather than compulsion\n  * Al-Zamakhshari (Asas): Literal: physical softness/delicacy; Metaphorical: kindness of manner and speech in dealing with others\n- Root: عجب (ʿujb)\n  * Lisan / Ayn: Self-admiration; the soul's being pleased with itself and its own states\n  * Al-Raghib (Mufradat): A hidden disease of the heart wherein one admires his own qualities, forgetting that they are divine gifts\n  * Al-Zamakhshari (Asas): Literal: wonder/astonishment; Metaphorical: the soul's complacent delight in its own excellence\n- Root: حسب (ḥasaba)\n  * Lisan / Ayn: To reckon, count, account; the one who enjoins right and forbids wrong (muḥtasib)\n  * Al-Raghib (Mufradat): The act of calling to account; the muḥtasib as one who holds himself and others to divine standards\n  * Al-Zamakhshari (Asas): Literal: numerical reckoning; Metaphorical: moral accountability and the office of the public censor\n- Sibawayh Rule: باب التدرج في الأحكام (Graduated Progression of Rulings) — The text moves through ascending degrees of severity in forbidding wrong, each stage conditional upon the failure of the preceding, requiring precise syntactic parsing of conditional and concessive clauses.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Enjoining Good and Forbidding Evil'","badge":"Ethics"}],"158":[{"arabic":"عز وجل فلما نظروا إلى داود عليه السلام نهضوا ليتفرقوا عنه فقال داود إني رسول الله إليكم جئتكم لأبلغكم رسالة ربكم فأقبلوا نحوه وألقوا أسماعهم نحو قوله وألقوا أبصارهم إلى الأرض فقال داود إني رسول الله إليكم يقرئكم السلام ويقول لكم ألا تسألون حاجة ألا تنادوني أسمع صوتكم وكلامكم فإنكم أحبائي وأصفيائي وأوليائي أفرح لفرحكم وأسارع إلى محبتكم وأنظر إليكم في كل ساعة نظر الوالدة الشفيقة الرفيقة قال فجرت الدموع على خدودهم فقال شيخهم سبحانك سبحانك نحن عبيدك وبنو عبيدك فاغفر لنا ما قطع قلوبنا عن ذكرك فيما مضى من أعمارنا وقال الآخر سبحانك سبح","english":"And His saying, Glorified and Exalted is He: {نُورُهُمْ يَسْعَىٰ بَيْنَ أَيْدِيهِمْ وَبِأَيْمَانِهِمْ يَقُولُونَ رَبَّنَا أَتْمِمْ لَنَا نُورَنَا} [\"Their light will run before them and on their right hands; they will say, 'Our Lord, perfect for us our light'\"] (Q 66:8) — this is susceptible to the meaning that He bestows upon them the perfection of light whenever they had provisioned from the world the origin of light. And it is also susceptible that the intended meaning is the perfection of light in what was not illuminated in this world with an illumination that stands in need of further completion and radiance — so that this is what is meant by its perfection. And His saying, Exalted is He: {انْظُرُونَا نَقْتَبِسْ مِنْ نُورِكُمْ قِيلَ ارْجِعُوا وَرَاءَكُمْ فَالْتَمِسُوا نُورًا} [\"Look upon us so we may borrow from your light. It will be said, 'Return behind you and seek light'\"] (Q 57:13) — this indicates that the lights must have their origin provisioned in this world, then in the Hereafter they increase in radiance. But as for a light being newly generated [there without prior origin] — no. And the judgment in this matter is a venture of conjecture, perilous, and there has not been unveiled to us therein anything trustworthy. So we ask God, Exalted is He, to increase us in knowledge and right guidance, and to show us the truth as truth.","book_title":"Love, Longing, Intimacy and Contentment","section_title_ar":"Section 1171","section_title_en":"On the Ever-Replenished Delights of the Hereafter and the Yearning (Shawq) for the Divine Vision","section_index":1171,"anchors":"- Root: لذذ (Ladhdhah — Pleasure/Delight)\n  * Lisan / Ayn: Core root denotes the sweetness of taste and the experience of sensory gratification; its verbal form (ladhdha) implies direct apprehension of what is agreeable.\n  * Al-Raghib (Mufradat): In theological usage, true pleasure (al-ladhdhah al-ʿuẓmā) is the soul's perception of what is conformable to its nature — the highest being the vision of God (ru'yat Allāh) and the bliss of proximity to Him.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for sensory delight; metaphorical (majāz) for intellectual and spiritual joys, where the \"taste\" is of gnosis (maʿrifah), not of the palate.\n\n- Root: شوق (Shawq — Yearning/Longing)\n  * Lisan / Ayn: The root signifies the soul's restless inclination toward a beloved; the \"spurring on\" of the heart toward reunion.\n  * Al-Raghib (Mufradat): Shawq is the movement of the heart toward its ultimate Beloved (al-maḥbūb al-aʿlā) — a yearning that persists even in bliss, for the unveiling (kashf) of ever-greater divine self-disclosure.\n  * Al-Zamakhshari (Asas): Literal for human longing; metaphorical for the divine \"yearning\" attributed to God (as in the sacred reports), which is an expression of His loving acceptance and bestowal of grace, not an emotional lack.\n\n- Root: نور (Nūr — Light)\n  * Lisan / Ayn: Core root denotes illumination, radiance, and that by which one sees and is seen.\n  * Al-Raghib (Mufradat): Twofold: sensory light (of the sun, stars) and intellectual/spiritual light (of reason, faith, and the Qur'an). The \"light of the believers\" on the Day of Resurrection is the latter — the radiance of their faith and works in the world.\n  * Al-Zamakhshari (Asas): Literal for physical luminosity; metaphorical (majāz) for guidance, clarity, and the illuminating power of divine truth in the heart.\n\n- Root: قلب (Qalb — Heart)\n  * Lisan / Ayn: Core root means to turn over, to flip, to transform — hence the heart is so-named for its constant fluctuation (taqallub) of states.\n  * Al-Raghib (Mufradat): The heart is the seat of perception and understanding (al-ʿaql wa al-fahm); it is the subtle divine reality (al-laṭīfah al-rabbāniyyah) that apprehends God, not the physical organ.\n  * Al-Zamakhshari (Asas): Literal for the physical organ; metaphorical for the spiritual faculty of cognition and volition that turns toward or away from God.\n\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Governing the precise scope of statements like \"the pleasure of what is renewed is only a distraction from the ache of yearning,\" ensuring the predicate is confined to the subject without overextension.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Love, Longing, Intimacy and Contentment'","badge":"Du'a"},{"arabic":"يسمع أدناهم فيقول يا أيها الناس إني قد أنصت لكم مند خلقتكم إلى يومكم هذا فانصتوا إلي اليوم إنما هي أعمالكم ترد عليكم أيها الناس إني قد جعلت نسبا وجعلتم نسبا فوضعتم نسبي ورفعتم نسبكم قلت إن أكرمكم عند الله أتقاكم وأبيتم إلا أن تقولوا فلان بن فلان وفلان أغنى من فلان فاليوم أضع نسبكم وأرفع نسبي أين المتقون فيرفع للقوم لواء فيتبع القوم لواءهم إلى منازلهم فيدخلون الجنة بغير حساب (2) حديث رأس الحكمة مخافة الله رواه أبو بكر بن لال الفقيه في مكارم الأخلاق والبيهقي في الشعب وضعفه من حديث","english":"For they possess the Highest Companion (al-Rafīq al-Aʿlā) in which none share with them. Consider how He singled them out for the companionship of the Highest Companion — and that is because they are the scholars (ʿulamāʾ), and the scholars hold the rank of companionship with the prophets, for they are the heirs of the prophets. And the companionship of the Highest Companion belongs to the prophets and to those who attach themselves to them. For this reason, when the Messenger of God — may God's blessings and peace be upon him — was given the choice during his death-illness between remaining in this world and proceeding to God — may He be exalted — he would say: \"I ask of Thee the Highest Companion\" {«الرفيق الأعلى»}.","book_title":"Fear and Hope","section_title_ar":"Section 1042","section_title_en":"On the Excellence of Fear (Khawf) and Its Inseparability from Faith — Section 1042","section_index":1042,"anchors":"- Root: خوف (Khawf)\n  * Lisan / Ayn: Core root denotes trepidation, apprehension, and the state of being afraid; its opposite is amn (security).\n  * Al-Raghib (Mufradat): \"الخوف: توقع مكروه عن أمارة مظنونة، أو معلومة\" — anticipation of something disliked based on an indication, whether conjectural or certain; it is the direct opposite of amn (security), and applies to both worldly and otherworldly matters.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"خفته على مالي خوفا وخيفة\" — to fear for something. Metaphorical (Majaz): \"تخوفه: تنقصه\" — to diminish gradually, as fear erodes the soul's complacency.\n- Root: حدث (Hadath)\n  * Lisan / Ayn: Newness, origination after non-existence; also that which is recent in time.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — the coming-to-be of a thing after it was not; true origination belongs to God alone.\n  * Al-Zamakhshari (Asas): Literal: \"هو حدث من الأحداث\" — one who is recent/young. Metaphorical: \"كان عمر محدثا أي صادق الحدس\" — one whose intuition is true, as if divinely inspired.\n- Root: يوم (Yawm)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — used for the day proper or any extended period; \"أيام الله\" refers to His mighty deeds and visitations upon the wicked.\n  * Al-Zamakhshari (Asas): Literal: \"ما رأيته اليوم\" — temporal designation. Metaphorical: \"ذكر في أيام العرب كذا أي في وقائعها\" — \"days\" as battles and momentous events.\n- Root: قوي (Quwwa)\n  * Lisan / Ayn: Strength, power, capability; the opposite of weakness.\n  * Al-Raghib (Mufradat): \"القوة تستعمل تارة في معنى القدرة\" — power as capability; also potentiality, as when a date-stone is said to be \"potentially\" a palm-tree.\n  * Al-Zamakhshari (Asas): Literal: \"هو قوي مقو\" — physically strong. Metaphorical: strength of heart, of conviction, and of allies.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — When the particle innamā is employed, it restricts the predicate exclusively to the subject mentioned, negating it for all others. This governs the author's argument that taqwā is exclusively attributed to God's nearness and that the \"Highest Companion\" (al-Rafīq al-Aʿlā) is uniquely reserved for the prophets and their heirs.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Fear and Hope'","badge":"Hadith"}],"160":[{"arabic":"ولذلك قال صلى الله عليه وسلم سيد الإدام اللحم ثم قال بعد ذكر المن والسلوى كلوا من طيبات ما رزقناكم فاللحم والحلاوة من الطيبات قال أبو سليمان الداراني رضي الله عنه أكل الطيبات يورث الرضا عن الله وتتم هذه الطيبات بشرب الماء البارد وصب الماء الفاتر على اليد عند الغسل قال المأمون شرب الماء بثلج يخلص الشكر وقال بعض الأدباء إذا دعوت إخوانك فأطعمتهم حصرمية وبورانية وسقيتهم ماء باردا فقد أكملت الضيافة وأنفق بعضهم دراهم في ضيافة فقال بعض الحكماء لم نكن نحتاج إلى هذا إذا كان خبزك جيدا وماؤك باردا وخلك حامضا فهو كفاية وقال بعضهم الحلاوة ب","english":"The Prophet (peace and blessings be upon him) said: \"Do not burden your guest so that you make him hate you, for whoever hates his guest has hated Allah, and whoever hates Allah, Allah hates him.\"","book_title":"Manners of Eating","section_title_ar":"Section 290","section_title_en":"The Etiquettes of Hospitality: Invitation, Response, Attendance, and the Serving of Food — Section 290 of The Revival of the Religious Sciences","section_index":290,"anchors":"- Root: ضيف (ḍ-y-f)\n  * Lisan / Ayn: Core meaning is \"to incline, to lean toward.\" The guest (al-ḍayf) is one who inclines toward you, alighting as a visitor; the root carries the sense of leaning or bending.\n  * Al-Raghib (Mufradat): The guest is \"one who inclines to you, alighting with you\"; hospitality (al-ḍiyāfah) became customary in the sense of receiving such a one. The word is originally a verbal noun, hence one and many are equal in most usage.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ḍāfa ilayhi: he inclined toward him\"; \"ḍāfat al-shams: the sun inclined toward setting.\" Metaphorical (majāz): \"aḍāfa ilayhi amran: he attributed a matter to him, leaning it upon him\"; \"al-muḍāf: the one constrained, hemmed in, in distress.\"\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the Prophet's statement \"innamā hādhihi al-akhlāq bi-yad Allāh\" (these morals are only in the hand of Allah), where innamā restricts the attribution of moral character exclusively to divine bestowal.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Manners of Eating'","badge":"Insight"}],"165":[{"arabic":"فلما نسوا ما ذكروا به أنجينا الذين ينهون عن السوء وأخذنا الذين ظلموا بعذاب بئيس بما كانوا يفسقون فبين أنهم استفادوا النجاة بالنهي عن السوء ويدل ذلك على الوجوب أيضا وقال تعالى الذين إن مكناهم في الأرض أقاموا الصلاة وآتوا الزكاة وأمروا بالمعروف ونهوا عن المنكر فقرن ذلك بالصلاة والزكاة في نعت الصالحين والمؤمنين وقال تعالى وتعاونوا على البر والتقوى ولا تعاونوا على الإثم والعدوان وهو أمر جزم ومعنى التعاون الحث عليه وتسهيل طرق الخير وسد سبل الشر والعدوان بحسب الإمكان وقال تعالى لولا ينهاهم الربانيون والأحبار عن قولهم الإثم وأكلهم السحت لبئس ما كانوا يصنعون ف","english":"Know that the verses indicating the obligation of commanding right and forbidding wrong are numerous. Among them is His saying, may He be exalted: {«Let there arise from among you a nation inviting to good, commanding right and forbidding wrong — and those are the successful»} (Āl ʿImrān 3:104). In this verse is the declaration of obligation, for His saying, may He be exalted, \"Let there be\" (wal-takun) is a command, and the apparent meaning of a command is obligation. In it also is the declaration that success (falāḥ) is contingent upon it, for He restricted it and said: {«And those are the successful»}. In it also is the declaration that it is a collective obligation (farḍ kifāyah), not an individual obligation (farḍ ʿayn), and that when a group undertakes it, the obligation falls from the rest — for He did not say, \"Let all of you be commanders of right,\" but rather said: {«Let there arise from among you a nation»}. Thus, whenever one person or a group undertakes it, the burden falls from the others, and success is particularized to those who undertake it and directly perform it. But if all of creation were to hold back from it, the burden would encompass all those capable of it without exception.","book_title":"Enjoining Good and Forbidding Evil","section_title_ar":"Section 521","section_title_en":"Section 521","section_index":521,"anchors":"*(Anchors established)*","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Enjoining Good and Forbidding Evil'","badge":"Insight"}],"169":[{"arabic":"وبمثله أخبر عن النصارى إذ قال تعالى فخلف من بعدهم خلف ورثوا الكتاب يأخذون عرض هذا الأدنى ويقولون سيغفر لنا ومعناه أنهم ورثوا الكتاب أي هم علماء ويأخذون عرض هذا الأدنى أي شهواتهم من الدنيا حراما كان أو حلالا وقد قال تعالى ولمن خاف مقام ربه جنتان ذلك لمن خاف مقامي وخاف وعيد والقرآن من أوله إلى آخره تحذير وتخويف لا يتفكر فيه متفكر إلا ويطول حزنه ويعظم خوفه إن كان مؤمنا بما فيه وترى الناس يهذونه هذا يخرجون الحروف من مخارجها ويتناظرون على خفضها ورفعها ونصبها وكأنهم يقرءون شعرا من أشعار العرب لا يهمهم الالتفات إلى معانيه والعمل بما فيه وهل في العالم غرور يز","english":"For if this matter were attained by wishful longing and reached by idle desire, then what was the meaning of the weeping of those [early believers], their fear, and their grief? We have already expounded the reality of these matters in the Book of Fear and Hope (Kitāb al-Khawf wa al-Rajā'). And the Messenger of God, peace and blessings be upon him, said — in what Muʿqil ibn Yasār narrated: \"A time will come upon the people in which the Qur'an will wear out in the hearts of men just as garments wear out upon bodies. Their entire affair will be [one of] covetousness with no fear accompanying it. If one of them does good, he says: 'It will be accepted from me'; and if he does evil, he says: 'I will be forgiven.'\" // The hadith of Muʿqil ibn Yasār: \"A time will come upon the people in which the Qur'an will wear out in the hearts of men...\" — This hadith was transmitted by Abu Mansur al-Daylami in Musnad al-Firdaws from Ibn ʿAbbas with similar wording, through a chain containing unknown narrators; I have not seen it from the hadith of Muʿqil.","book_title":"Fear and Hope","section_title_ar":"Section 891","section_title_en":"The Reality of False Hope (Ghurūr) and Its Distinction from True Hope (Rajā') — Section 891","section_index":891,"anchors":"- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Core meaning — an outward trace or mark; heedlessness in wakefulness; the blaze on a horse's forehead.\n  * Al-Raghib (Mufradat): \"Ghurūr\" is delusion arising from heedlessness — one is \"folded upon his heedlessness\" (ṭawāhu ʿalā gharrihi), as in {«ما غرك بربك الكريم»} (Q 82:6). It is the state of being deceived by wishful thinking while blind to warning.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): heedlessness/negligence. Metaphorical (Majaz): being deceived by false appearances — e.g., \"a day white and blazing\" (yawm agharr muḥajjal) for intense heat; the gazelle deceived by moonlight (agharr min ẓaby muqmir) that exposes it to predators.\n- Root: خوف (kh-w-f)\n  * Al-Raghib (Mufradat): \"Al-Khawf\" is the anticipation of something disliked based on a probable or certain indicator — the opposite of amn (security). It is paired with rajā' (hope) in {«يدعون ربهم خوفا وطمعا»} (Q 32:16).\n  * Al-Zamakhshari (Asas): Literal: fear of loss or harm. Metaphorical: gradual diminishment — \"takhawwafa al-sayr\" (the journey wore away the camel's hump little by little), as if fearing it.\n- Root: وقد (w-q-d)\n  * Al-Raghib (Mufradat): Fire blazing with fuel — {«وقودها الناس والحجارة»} (Q 2:24). Used for both the fuel and the flame.\n  * Al-Zamakhshari (Asas): Literal: kindling fire. Metaphorical: \"qalb waqqād\" (a blazing, penetrating intellect); \"waqada al-ḥaṣā\" (pebbles becoming scorching hot).\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a governing word and its governed prepositional phrase, provided the intervening clause is complete in itself; here, the periodic structure of Ghazali's condemnation (\"فترى الواحد...\") suspends the subject across multiple clauses before resolution.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'","badge":"Insight"},{"arabic":"علماء ويأخذون عرض هذا الأدنى أي شهواتهم من الدنيا حراما كان أو حلالا وقد قال تعالى ولمن خاف مقام ربه جنتان ذلك لمن خاف مقامي وخاف وعيد والقرآن من أوله إلى آخره تحذير وتخويف لا يتفكر فيه متفكر إلا ويطول حزنه ويعظم خوفه إن كان مؤمنا بما فيه وترى الناس يهذونه هذا يخرجون الحروف من مخارجها ويتناظرون على خفضها ورفعها ونصبها وكأنهم يقرءون شعرا من أشعار العرب لا يهمهم الالتفات إلى معانيه والعمل بما فيه وهل في العالم غرور يزيد على هذا فهذه أمثلة الغرور بالله وبيان الفرق بين الرجاء","english":"For if this matter were attained by wishful longing and reached by idle desire, then what was the meaning of the weeping of those [early believers], their fear, and their grief? We have already expounded the reality of these matters in the Book of Fear and Hope (Kitāb al-Khawf wa al-Rajā'). And the Messenger of God, peace and blessings be upon him, said — in what Muʿqil ibn Yasār narrated: \"A time will come upon the people in which the Qur'an will wear out in the hearts of men just as garments wear out upon bodies. Their entire affair will be [one of] covetousness with no fear accompanying it. If one of them does good, he says: 'It will be accepted from me'; and if he does evil, he says: 'I will be forgiven.'\" // The hadith of Muʿqil ibn Yasār: \"A time will come upon the people in which the Qur'an will wear out in the hearts of men...\" — This hadith was transmitted by Abu Mansur al-Daylami in Musnad al-Firdaws from Ibn ʿAbbas with similar wording, through a chain containing unknown narrators; I have not seen it from the hadith of Muʿqil.","book_title":"Condemnation of Delusion","section_title_ar":"Section 891","section_title_en":"The Reality of False Hope (Ghurūr) and Its Distinction from True Hope (Rajā') — Section 891","section_index":891,"anchors":"- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Core meaning — an outward trace or mark; heedlessness in wakefulness; the blaze on a horse's forehead.\n  * Al-Raghib (Mufradat): \"Ghurūr\" is delusion arising from heedlessness — one is \"folded upon his heedlessness\" (ṭawāhu ʿalā gharrihi), as in {«ما غرك بربك الكريم»} (Q 82:6). It is the state of being deceived by wishful thinking while blind to warning.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): heedlessness/negligence. Metaphorical (Majaz): being deceived by false appearances — e.g., \"a day white and blazing\" (yawm agharr muḥajjal) for intense heat; the gazelle deceived by moonlight (agharr min ẓaby muqmir) that exposes it to predators.\n- Root: خوف (kh-w-f)\n  * Al-Raghib (Mufradat): \"Al-Khawf\" is the anticipation of something disliked based on a probable or certain indicator — the opposite of amn (security). It is paired with rajā' (hope) in {«يدعون ربهم خوفا وطمعا»} (Q 32:16).\n  * Al-Zamakhshari (Asas): Literal: fear of loss or harm. Metaphorical: gradual diminishment — \"takhawwafa al-sayr\" (the journey wore away the camel's hump little by little), as if fearing it.\n- Root: وقد (w-q-d)\n  * Al-Raghib (Mufradat): Fire blazing with fuel — {«وقودها الناس والحجارة»} (Q 2:24). Used for both the fuel and the flame.\n  * Al-Zamakhshari (Asas): Literal: kindling fire. Metaphorical: \"qalb waqqād\" (a blazing, penetrating intellect); \"waqada al-ḥaṣā\" (pebbles becoming scorching hot).\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a governing word and its governed prepositional phrase, provided the intervening clause is complete in itself; here, the periodic structure of Ghazali's condemnation (\"فترى الواحد...\") suspends the subject across multiple clauses before resolution.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Delusion'","badge":"Insight"}],"172":[{"arabic":"اللوز وماء الورد في الورد ولذلك قال تعالى وإذ أخذ ربك من بني آدم من ظهورهم ذريتهم وأشهدهم على أنفسهم ألست بربكم قالوا بلى فالمراد به إقرار نفوسهم لا إقرار الألسنة فإنهم انقسموا في إقرار الألسنة حيث وجدت الألسنة والأشخاص إلى مقر وإلى جاحد ولذلك قال تعالى ولئن سألتهم من خلقهم ليقولن الله معناه إن اعتبرت أحوالهم شهدت بذلك نفوسهم وبواطنهم فطرة الله التي فطر الناس عليها أي كل آدمي فطر على الإيمان بالله عز وجل بل على معرفة الأشياء على ما هي عليه أعني أنها كالمضمنة فيها لقرب استعدادها للإدراك ثم لما كان الإيمان مركوزا في النفوس بالفطرة انقسم الناس إلى قسمين","english":"I say: Know that the washing of the eye is forbidden — that is, the eye of insight (ʿayn al-baṣīrah) is not to be washed with the water of blind imitation and mere hearsay, for it is the organ by which the realities of the intellect are disclosed. And the divisions of what the name \"intellect\" (al-ʿaql) is applied to have become clear: it is said of the inborn faculty (al-gharīzah), and it is said of the knowledge that is acquired through that faculty, and it is said of the state of that knowledge when it governs the soul, and it is said of the very actions that proceed from that governance.","book_title":"Book of Knowledge","section_title_ar":"Section 68","section_title_en":"The Washing of the Eye is Forbidden — On the True Meaning of Intellect (ʿAql) and Its Divisions","section_index":68,"anchors":"- Root: عقل (ʿAql)\n  * Lisan / Ayn: The root denotes binding, restraining, and holding back — the intellect is that which restrains the soul from base desires and prevents it from straying.\n  * Al-Raghib (Mufradat): \"العقل يقال للقوة المتهيئة لقبول العلم، ويقال للعلم الذي يستفيده الإنسان بتلك القوة عقل\" — al-ʿaql is said of the faculty prepared to receive knowledge, and it is also said of the knowledge acquired by that faculty. It is the instrument of divine discernment and the locus of taklīf (moral responsibility).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): the inborn faculty of discernment. Metaphorical (Majaz): \"نخلة لا تعقل الإبار إذا لم تقبله\" — a palm tree that does not accept pollination is said to be \"not to ʿaqil\" the pollen, extending the root to the sense of \"accepting/receiving.\" Thus, knowledge is called ʿaql metaphorically as its fruit.\n- Root: بصر (Baṣar)\n  * Lisan / Ayn: Sight, perception — both of the eye and of the heart.\n  * Al-Raghib (Mufradat): \"البصر يقال للجارحة الناظرة... ويقال لقوة القلب المدركة: بصيرة وبصر\" — baṣar is said of the seeing organ, and of the perceiving power of the heart: baṣīrah and baṣar. The inner sight (baṣīrah) perceives immaterial realities.\n  * Al-Zamakhshari (Asas): Literal: ocular vision. Metaphorical: \"هذه آية مبصرة\" — this is an illuminating sign; \"واجعلني بصيرة عليهم أي رقيبا وشاهدا\" — make me a watcher over them. The inner eye perceives what the outer eye cannot.\n- Root: فطر (Faṭara)\n  * Lisan / Ayn: To split, cleave, originate, create — the primordial act of divine creation.\n  * Al-Raghib (Mufradat): \"أصل الفطر: الشق طولا... وفطر الله الخلق\" — the root is splitting lengthwise; God's \"fatr\" of creation is His originating of things. \"فطرة الله التي فطر الناس عليها\" — the primordial disposition upon which God originated mankind.\n  * Al-Zamakhshari (Asas): Literal: \"فطر الله الخلق، وهو فاطر السموات: مبتدعها\" — God originated creation; He is the Originator of the heavens. \"وكل مولود يولد على الفطرة\" — every newborn is born upon the fiṭrah, i.e., the innate disposition receptive to the religion of truth.\n- Root: نفس (Nafs)\n  * Lisan / Ayn: Self, soul, spirit; the innermost reality of a thing.\n  * Al-Raghib (Mufradat): \"النفس: الروح... وقوله: تعلم ما في نفسي ولا أعلم ما في نفسك\" — nafs is the spirit/soul; \"You know what is in my nafs and I know not what is in Your nafs\" — the nafs is the seat of inner assent and recognition.\n  * Al-Zamakhshari (Asas): Literal: the self. Metaphorical: \"دفق نفسه أي دمه\" — he poured out his nafs, i.e., his blood. The nafs is the locus of the primordial covenant (mīthāq).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The construction \"إنما العاقل من آمن بالله\" restricts the predicate: the intellect is not merely a faculty of cleverness but is defined by its fruit — faith and God-consciousness (taqwā).","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'","badge":"Insight"}],"175":[{"arabic":"الله على الكافرين وقال تعالى في قصة بلعام بن باعوراء واتل عليهم نبأ الذي آتيناه آياتنا فانسلخ منها فأتبعه الشيطان فكان من الغاوين حتى قال فمثله كمثل الكلب إن تحمل عليه يلهث أو تتركه يلهث فكذلك العالم الفاجر فإن بلعام أوتي كتاب الله تعالى فأخلد إلى الشهوات فشبه بالكلب أي سواء أوتي الحكمة أو لم يؤت فهو يلهث إلى الشهوات وقال عيسى عليه السلام مثل علماء السوء كمثل صخرة وقعت على فم النهر لا هي تشرب الماء ولا هي تترك الماء يخلص إلى الزرع ومثل علماء السوء مثل قناة الحش ظاهرها جص وباطنها نتن ومثل القبور ظاهرها عامر وباطنها عظام الموتى فهذه الأخبار والآثار تبين أن العالم الذي هو من أبناء","english":"I say: The Prophet — peace and blessings be upon him — said: \"The scholar will indeed be tormented with a torment at which the inhabitants of the Fire will circle around, marveling at the severity of his punishment.\" By it he meant the wicked scholar.","book_title":"Book of Knowledge","section_title_ar":"Section 50","section_title_en":"The Worldly Scholar's Punishment and the Marks of the Hereafter-Scholars","section_index":50,"anchors":"- Root: فجر (fajara)\n  * Lisan / Ayn: To split, cleave, or rend something widely; to break open\n  * Al-Raghib (Mufradat): The splitting of something with wide rupture — from which the dawn (al-fajr) is named, as it splits the night; used for both physical and moral rupture\n  * Al-Zamakhshari (Asas): Literal: the cleaving of water or the breaking of dawn. Metaphorical: the eruption of punishment upon one suddenly and overwhelmingly\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Knowledge; the faculty of apprehending a thing as it truly is\n  * Al-Raghib (Mufradat): Twofold: (1) apprehension of a thing's essence; (2) judgment upon a thing affirming or denying something of it. The scholar (al-ʿālim) is one who possesses such apprehension\n  * Al-Zamakhshari (Asas): Literal: knowledge as certain apprehension. Metaphorical: the \"signs\" (maʿālim) of the path — that by which one is guided; the scholar is a \"sign\" pointing either to guidance or to ruin\n- Root: دنا (dana)\n  * Lisan / Ayn: To be near, to draw close; al-dunyā (the nearer world) as that which is immediate and low\n  * Al-Raghib (Mufradat): Proximity by essence or by judgment; used of place, time, and station. The \"nearer\" (al-adnā) is contrasted with the greater and the better\n  * Al-Zamakhshari (Asas): Literal: nearness. Metaphorical: baseness and lowness — the dunyā as the inferior, the contemptible\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle innamā restricts the predicate exclusively to its subject, as in \"the winners and the brought-near are only the scholars of the Hereafter,\" effecting complete exclusion of all else.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Book of Knowledge'","badge":"Hadith"}],"176":[{"arabic":"إلهه هواه وأضله الله على علم وقال تعالى واتبع هواه فمثله كمثل الكلب إن تحمل عليه يلهث أو تتركه يلهث وقال عز وجل فيمن نهى النفس عن الهوى وأما من خاف مقام ربه ونهى النفس عن الهوى فإن الجنة هي المأوى وسيأتي كيفية مجاهدة هذه الجنود وتسليط بعضها على بعض في كتاب رياضة النفس إن شاء الله تعالى المثال الثاني اعلم أن البدن كالمدينة والعقل أعني المدرك من الإنسان كملك مدبر لها وقواه المدركة من الحواس الظاهرة والباطنة كجنوده وأعوانه وأعضاؤه كرعيته والنفس الأمارة بالسوء التي هي الشهوة والغضب كعدو ينازعه في مملكته ويسعى في إهلاك رعيته فصار بدنه كرباط وثغر ونف","english":"But whoever turns away from this path is like the one of whom Allah, the Exalted, said: {أفرأيت من اتخذ إلهه هواه وأضله الله على علم} — \"Have you seen the one who takes as his god his own desire, and Allah has led him astray out of knowledge?\" (Q 45:23). And He, the Exalted, said: {واتبع هواه فمثله كمثل الكلب إن تحمل عليه يلهث أو تتركه يلهث} — \"And he followed his desire, so his example is like the example of a dog: if you drive him away, he pants, or if you leave him, he pants\" (Q 7:176). And He, the Exalted and Glorious, said concerning the one who restrains the soul from passion: {وأما من خاف مقام ربه ونهى النفس عن الهوى فإن الجنة هي المأوى} — \"But as for he who feared the standing before his Lord and restrained the soul from passion, then indeed, Paradise will be the refuge\" (Q 79:40-41).","book_title":"Disciplining the Soul","section_title_ar":"Section 577","section_title_en":"** The Body as Kingdom: The Governance of the Soul's Faculties — Section 577","section_index":577,"anchors":"**\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, breath; that which is breathed forth; the essence of a thing\n  * Al-Raghib (Mufradat): النفس: الروح — the soul as the immaterial spiritual reality; when attributed to Allah, denotes His very essence (al-dhāt), not a separate entity\n  * Al-Zamakhshari (Asas): Literal: the self/essence; Metaphorical: نفس سائلة — a \"flowing self\" (blood) as the criterion for ritual purity\n- Root: عقل (ʿ-q-l)\n  * Lisan / Ayn: Intellect, reason; that which restrains and binds\n  * Al-Raghib (Mufradat): العقل يقال للقوة المتهيئة لقبول العلم — the faculty prepared for receiving knowledge; and the knowledge acquired through that faculty\n  * Al-Zamakhshari (Asas): Literal: intellectual apprehension; Metaphorical: نخلة لا تعقل الإبار — a palm that does not \"accept\" pollination (i.e., does not receive)\n- Root: غضب (gh-d-b)\n  * Lisan / Ayn: Anger, wrath; the boiling of the blood of the heart desiring vengeance\n  * Al-Raghib (Mufradat): ثوران دم القلب إرادة الانتقام — when attributed to Allah, it means retribution alone, not an emotional state\n  * Al-Zamakhshari (Asas): Literal: anger toward the living (غضبت لفلان); Metaphorical: anger toward the dead (غضبت به) — the preposition shift marking the distinction\n- Root: نصح (n-s-ḥ)\n  * Lisan / Ayn: Sincere counsel; to be pure and unadulterated; to sew (as a tailor)\n  * Al-Raghib (Mufradat): تحري فعل أو قول فيه صلاح صاحبه — the earnest pursuit of action or speech containing the welfare of its recipient\n  * Al-Zamakhshari (Asas): Literal: sincere advice; Metaphorical: نصح الغيث البلاد — rain \"counseling\" the land (i.e., giving it its due generously)\n- Sibawayh Rule: باب التشبيه التمثيلي (The Chapter of Illustrative Simile) — extended analogical comparisons (tamthīl) where multiple relations are mapped across domains, governed by the syntactic pattern of predicate assignment (isnād) to establish parallel structures\n\n---\n\n**","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'","badge":"Insight"},{"arabic":"آتيناه آياتنا فانسلخ منها فأتبعه الشيطان فكان من الغاوين حتى قال فمثله كمثل الكلب إن تحمل عليه يلهث أو تتركه يلهث فكذلك العالم الفاجر فإن بلعام أوتي كتاب الله تعالى فأخلد إلى الشهوات فشبه بالكلب أي سواء أوتي الحكمة أو لم يؤت فهو يلهث إلى الشهوات وقال عيسى عليه السلام مثل علماء السوء كمثل صخرة وقعت على فم النهر لا هي تشرب الماء ولا هي تترك الماء يخلص إلى الزرع ومثل علماء السوء مثل قناة الحش ظاهرها جص وباطنها نتن ومثل القبور ظاهرها عامر وباطنها عظام الموتى فهذه الأخبار والآثار تبين أن العالم الذي هو من أبناء الدنيا أخس حالا وأشد عذابا من الجاهل وأن الفائزين المقربين هم عل","english":"I say: The Prophet — peace and blessings be upon him — said: \"The scholar will indeed be tormented with a torment at which the inhabitants of the Fire will circle around, marveling at the severity of his punishment.\" By it he meant the wicked scholar.","book_title":"Book of Knowledge","section_title_ar":"Section 50","section_title_en":"The Worldly Scholar's Punishment and the Marks of the Hereafter-Scholars","section_index":50,"anchors":"- Root: فجر (fajara)\n  * Lisan / Ayn: To split, cleave, or rend something widely; to break open\n  * Al-Raghib (Mufradat): The splitting of something with wide rupture — from which the dawn (al-fajr) is named, as it splits the night; used for both physical and moral rupture\n  * Al-Zamakhshari (Asas): Literal: the cleaving of water or the breaking of dawn. Metaphorical: the eruption of punishment upon one suddenly and overwhelmingly\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Knowledge; the faculty of apprehending a thing as it truly is\n  * Al-Raghib (Mufradat): Twofold: (1) apprehension of a thing's essence; (2) judgment upon a thing affirming or denying something of it. The scholar (al-ʿālim) is one who possesses such apprehension\n  * Al-Zamakhshari (Asas): Literal: knowledge as certain apprehension. Metaphorical: the \"signs\" (maʿālim) of the path — that by which one is guided; the scholar is a \"sign\" pointing either to guidance or to ruin\n- Root: دنا (dana)\n  * Lisan / Ayn: To be near, to draw close; al-dunyā (the nearer world) as that which is immediate and low\n  * Al-Raghib (Mufradat): Proximity by essence or by judgment; used of place, time, and station. The \"nearer\" (al-adnā) is contrasted with the greater and the better\n  * Al-Zamakhshari (Asas): Literal: nearness. Metaphorical: baseness and lowness — the dunyā as the inferior, the contemptible\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle innamā restricts the predicate exclusively to its subject, as in \"the winners and the brought-near are only the scholars of the Hereafter,\" effecting complete exclusion of all else.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'","badge":"Insight"}],"179":[{"arabic":"وقال تعالى {لهم قلوب لا يفقهون بها} وأراد به معاني الإيمان دون الفتاوى ولعمري إن الفقه والفهم في اللغة اسمان بمعنى واحد وإنما يتكلم في عادة الاستعمال به قديما وحديثا قال تعالى {لأنتم أشد رهبة في صدورهم من الله} الآية فأحال قلة خوفهم من الله واستعظامهم سطوة الخلق على قلة الفقه فانظر إن كان ذلك نتيجة عدم الحفظ لتفريعات الفتاوى أو هو نتيجة عدم ما ذكرناه من العلوم وقال صلى الله عليه وسلم علماء فقهاء (1) للذين وفدوا عليه وسئل سعد بن إبراهيم الزهري رحمه الله أي أهل المدينة أفقه فقال أتقا","english":"They have manipulated this term through specification (takhṣīṣ), not through transfer (naql) or conversion (taḥwīl), for they have restricted it to knowledge of obscure legal branches (furūʿ gharībah) in legal opinions (fatāwā), to grasping the subtleties of their underlying causes (ʿilal), to multiplying discourse concerning them, and to memorizing the doctrinal positions related to them. Whoever is more profound in this and more occupied with it is called \"the most learned in fiqh\" (al-afqah). Yet in the first era, the name fiqh was applied absolutely to knowledge of the path of the Hereafter, to knowing the subtleties of the maladies of the souls (āfāt al-nufūs), to the corrupters of deeds (mufsidāt al-aʿmāl), to the power of encompassing the pettiness of this world, to intense longing for the bliss of the Hereafter, and to the dominance of fear over the heart. What indicates this to you is His saying, Mighty and Majestic: {«ليتفقهوا في الدين ولينذروا قومهم إذا رجعوا إليهم»} [“That they may gain understanding in the religion and warn their people when they return to them”] (Q 9:122). What effects warning and intimidation is this very fiqh — not the subdivisions of divorce (ṭalāq), manumission (ʿitāq), imprecation (liʿān), salam contracts, and leases (ijārah). For that (latter) does not produce warning or intimidation; rather, total devotion to it perpetually hardens the heart and strips away godly fear (khashyah) from it, as we now observe in those wholly devoted to it.","book_title":"Book of Knowledge","section_title_ar":"Section 27","section_title_en":"The Revival of the Religious Sciences — Section 27: The Corruption of the Praiseworthy Names (Taḥrīf al-Asāmī al-Maḥmūdah)","section_index":27,"anchors":"- Root: فقه (Fiqh)\n  * Lisan / Ayn: Core linguistic meaning of \"understanding\" (al-fahm) and \"comprehension\" (al-fahm ʿan al-shayʾ)\n  * Al-Raghib (Mufradat): \"Al-fiqh: attainment of knowledge of the unseen through a witnessed sign — it is more specific than ʿilm.\" Theological nuance: true fiqh is knowledge of the heart's maladies and the path to the Hereafter.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"afqih ʿannī mā aqūl\" — understand what I say. Metaphorical (majāz): technical restriction to legal rulings (furūʿ al-fatāwā) is a later convention, not the lexical or prophetic norm.\n- Root: علم (ʿIlm)\n  * Lisan / Ayn: Perception of a thing as it truly is; knowledge of the essence of a thing.\n  * Al-Raghib (Mufradat): Two types: (1) perception of the essence of a thing; (2) judgment upon a thing affirming or negating something of it. The highest ʿilm is knowledge of God, His verses, and His acts.\n  * Al-Zamakhshari (Asas): Literal: \"He is from the banners (aʿlām) of knowledge.\" Metaphorical: restriction of the title \"scholar\" (al-ʿālim) to the dialectician (al-munāẓir) is a corrupt specification (takhṣīṣ fāsid).\n- Root: وحد (Waḥḥada)\n  * Lisan / Ayn: To make one; to affirm unity.\n  * Al-Raghib (Mufradat): Tawḥīd is affirming God's unity in essence, attributes, and acts — the highest degree being the vision that all things proceed from Him alone.\n  * Al-Zamakhshari (Asas): Literal: utterance of \"Lā ilāha illā Allāh.\" Metaphorical: the inner reality (al-lubāb) — seeing all affairs from God, cutting off attention from secondary causes.\n- Sibawayh Rule: باب التخصيص والتقييد (Restriction and Specification) — The corruption of names occurs through takhṣīṣ (semantic restriction), not naql (lexical transfer). The grammarians' principle: a general term (al-ism al-ʿāmm) retains its full semantic range unless a valid sharʿī or linguistic evidence restricts it; arbitrary restriction by custom (ʿādat al-istimāl) is a rhetorical device of the devils among men and jinn.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'","badge":"Insight"},{"arabic":"يقال فيهم {أولئك كالأنعام بل هم أضل} وإنما كانوا أضل لأن الأنعام ليس في قوتها طلب درجة الملائكة فتركها الطلب للعجز وأما الإنسان ففي قوته ذلك والقادر على نيل الكمال أحرى بالذم وأجدر بالنسبة إلى الضلال مهما تقاعد عن طلب الكمال وإذا كان هذا كلاما معترضا فلنرجع إلى المقصود فقد بينا معنى قول {لا إله إلا الله} ومعنى قول لا حول ولا قوة إلا بالله وإن من ليس قائلا بهما عن مشاهدة فلا يتصور منه حال التوكل فإن قلت ليس في قولك لا حول ولا قوة إلا بالله إلا نسبة شيئين إلى الله فلو قال قائل السم","english":"If you say: \"Does there remain with the servant any management (tadbir) or attachment to causes (asbab) in these states?\" — Know that the third station negates management entirely (rafʿan li-l-tadbir), so long as the state persists; rather, its possessor becomes like one stupefied (mabhut). The second station negates every management except that which pertains to fleeing unto Allah through supplication (duʿa) and earnest entreaty (ibtihal) — like the management of an infant in clinging to its mother alone. The first station does not negate the root of management and choice (ikhtiyar), but negates certain managements — like one who relies on his deputy (wakil) in a lawsuit: he abandons his own management with respect to what is not the deputy's concern, but he does not abandon the management which his deputy has indicated to him, nor the management which he knows from the deputy's custom and established practice (sunnah), apart from his explicit indication.","book_title":"Monotheism and Reliance","section_title_ar":"Section 1119","section_title_en":"The Reality of Reliance (Haqiqat al-Tawakkul) — Degrees of Trust and the Station of Witnessing","section_index":1119,"anchors":"- Root: دبر (d-b-r)\n  * Lisan / Ayn: \"دبر الشيء: خلاف القبل\" — the rear, the back; by extension, the management of affairs as one turns away from one thing toward another (tadbir: to manage, to deliberate over outcomes).\n  * Al-Raghib (Mufradat): \"دبر الشيء: خلاف القبل، وكني بهما عن العضوين المخصوصين\" — used literally for spatial orientation; metaphorically for the ordering of one's own affairs (tadbir al-amr), which is the very faculty that tawakkul suspends or redirects.\n  * Al-Zamakhshari (Asas): Literal: \"أدبر النهار ودبر دبورا\" (the day passed away). Metaphorical: \"ما يعرف قبيلا من دبير\" — one who cannot distinguish front from back, i.e., total loss of self-direction; relevant to the state of the \"bewildered\" (mabhut) one.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — applies to the phrase \"لا حول ولا قوة إلا بالله\" where the restriction (hasr) confines all power (hawl) and strength (quwwah) exclusively to Allah, negating any independent creaturely agency.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Monotheism and Reliance'","badge":"Du'a"}],"182":[{"arabic":"الخيرات بل لا يشعرون وقال تعالى سنستدرجهم من حيث لا يعلمون وقال تعالى فتحنا عليهم أبواب كل شيء حتى إذا فرحوا بما أوتوا أخذناهم بغتة فإذا هم مبلسون وفي تفسير قوله تعالى سنستدرجهم من حيث لا يعلمون أنهم كلما أحدثوا ذنبا أحدثنا لهم نعمة ليزيد غرورهم وقال تعالى إنما نملي لهم ليزدادوا إثما وقال تعالى ولا تحسبن الله غافلا عما يعمل الظالمون إنما يؤخرهم ليوم تشخص فيه الأبصار إلى غير ذلك مما ورد في كتاب الله تعالى وسنة رسوله فمن آمن به تخلص من هذا الغرور فإن منشأ هذا الغرور الجهل بالله وبصفاته فإن من عرفه لا يأمن م","english":"As for knowing it by way of authoritative transmission and affirmation (taṣdīq): it is that one believes in the Book of God — exalted is He — and affirms His Messenger. For God — exalted is He — has said: {«أيحسبون أن ما نمدهم به من مال وبنين * نسارع لهم في الخيرات بل لا يشعرون»} — \"Do they reckon that what We extend to them of wealth and sons — [that] We hasten for them good things? Nay, but they do not perceive\" (Q. 23:55-56). And He said — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — \"We shall draw them on by degrees from whence they do not know\" (Q. 7:182). And He said — exalted is He: {«فتحنا عليهم أبواب كل شيء حتى إذا فرحوا بما أوتوا أخذناهم بغتة فإذا هم مبلسون»} — \"We opened upon them the gates of everything, until when they rejoiced in what they were given, We seized them suddenly, and behold, they were in despair\" (Q. 6:44). And in the interpretation of His saying — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — it is said: \"Whenever they innovated a sin, We innovated for them a blessing, to increase their self-deception.\" And He said — exalted is He: {«إنما نملي لهم ليزدادوا إثما»} — \"We only grant them respite that they may increase in sin\" (Q. 3:178). And He said — exalted is He: {«ولا تحسبن الله غافلا عما يعمل الظالمون إنما يؤخرهم ليوم تشخص فيه الأبصار»} — \"And do not reckon God heedless of what the wrongdoers do; He only delays them to a Day when eyes will stare fixedly\" (Q. 14:42). And [there is] more of that kind which has come in the Book of God — exalted is He — and in the Sunnah of His Messenger. So whoever believes in it is delivered from this self-deception. For the origin of this self-deception is ignorance of God and of His attributes; for whoever knows Him does not feel secure from His stratagem (makr) and is not deceived by such corrupt fancies.","book_title":"Condemnation of Delusion","section_title_ar":"Section 888","section_title_en":"Section 888 — On the Remedy for Self-Deception (Ghurūr): Recognizing the Signs of Divine Honor (Karāmah) and Humiliation (Hawān)","section_index":888,"anchors":"- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Core meaning of an outward trace or mark; heedlessness in wakefulness; the blaze on a horse's forehead.\n  * Al-Raghib (Mufradat): \"Ghurūr\" is delusion stemming from heedlessness — the soul's being overtaken while imagining security, as in {«ما غرك بربك الكريم»} (Q. 82:6). It is the state of one who is deceived by apparent favors while blind to their underlying test.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): heedlessness and exposure to predation, like a gazelle deceived by moonlight. Metaphorical (Majaz): being \"deceived by God\" (ightirār billāh) — trusting in His mercy while persisting in disobedience.\n- Root: لهم (l-h-m)\n  * Lisan / Ayn: Swallowing whole; the gullet.\n  * Al-Raghib (Mufradat): \"Ilhām\" — God's casting a meaning into the heart (al-raw'), distinct from demonic whispering; the channel of inner vision for the knowers (ʿārifūn).\n  * Al-Zamakhshari (Asas): Literal: to swallow. Metaphorical: the heart's receptive \"swallowing\" of divine inspiration.\n- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: Origination after non-existence; newness.\n  * Al-Raghib (Mufradat): \"Ḥudūth\" — a thing's coming to be after it was not; \"muḥdith\" — the originator, exclusively God for substances (jawāhir). \"Iḥdāth\" — bringing about a novel state or act.\n  * Al-Zamakhshari (Asas): Literal: temporal newness. Metaphorical: \"muḥaddath\" — one inspired with correct discernment, as if newly spoken-to.\n- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Softness, ease, well-being; a state of comfort.\n  * Al-Raghib (Mufradat): \"Niʿmah\" — the good state one inhabits; \"naʿīm\" — the act of living pleasantly. Blessings are both a test and a sign, per {«وإن تعدوا نعمة الله لا تحصوها»} (Q. 16:18).\n  * Al-Zamakhshari (Asas): Literal: bounty and comfort. Metaphorical: \"khafat naʿāmatuhum\" — their prosperity vanished; blessings may signal either favor or gradual ruin (istidrāj).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication with \"innamā\")\n  * In {«إنما نملي لهم ليزدادوا إثما»} (Q. 3:178) and {«إنما يؤخرهم ليوم تشخص فيه الأبصار»} (Q. 14:42), \"innamā\" restricts the purpose of divine respite exclusively to increase of sin and deferred reckoning — negating any reading of it as benevolent indulgence.","content_type":"dhikr","topic":"Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Condemnation of Delusion'","badge":"Dhikr"},{"arabic":"بأن يخطر لهم على سبيل الورود عليهم من حيث لا يعلمون وتارة على سبيل الرؤيا الصادقة وتارة في اليقظة على سبيل كشف المعاني بمشاهدة الأمثلة كما يكون في المنام وهذا أعلى الدرجات وهي من درجات النبوة العالية كما أن الرؤيا الصادقة جزء من ستة وأربعين جزءا من النبوة فإياك أن يكون حظك من هذا العلم إنكار ما جاوز حد قصورك ففيه هلك المتحذلقون من العلماء الزاعمون أنهم أحاطوا بعلوم العقول فالجهل خير من عقل يدعو إلى إنكار مثل هذه الأمور لأولياء الله تعالى ومن أنكر ذلك للأولياء لزمه إنكار الأنبياء وكان خارجا عن","english":"For this reason ʿAlī, may God be pleased with him, said — when it was said to him, \"You have opposed so-and-so\" — \"The best of us is the most following of us of this religion.\" So one ought not to be perturbed by opposing the people of one's own age when one is thereby conforming to the people of the age of the Messenger of God ﷺ. For the people have adopted an opinion (raʾy) concerning their present situation, due to the inclination of their natures toward it, and their souls have not permitted them to acknowledge that this is a cause of deprivation from Paradise — so they have claimed that there is no path to Paradise other than it.","book_title":"Book of Knowledge","section_title_ar":"Section 64","section_title_en":"** Section 64 — On the Sciences of the Inner Life: The Obligation to Follow the Salaf and the Condemnation of Innovation (Bidʿah)","section_index":64,"anchors":"**\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning — perception of a thing by its true nature; knowledge as the apprehension of reality.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment upon the thing.\n  * Al-Zamakhshari (Asas): Literal usage — \"ما علمت بخبرك: ما شعرت به\" (I did not know of your news: I had no awareness of it). The scholar (ʿālim) is one whose knowledge is manifest in action.\n- Root: بدع (badaʿa)\n  * Lisan / Ayn: Core meaning — to originate, to create something new without prior example.\n  * Al-Raghib (Mufradat): \"الإبداع: إنشاء صنعة بلا احتذاء واقتداء\" — origination of a thing without model or precedent. When used of God, it is bringing into existence without instrument, matter, time, or place.\n  * Al-Zamakhshari (Asas): Literal — \"أبدع الشيء وابتدعه: اخترعه\" (he originated it and innovated it: he invented it). Metaphorical — \"أبدعت حجتك إذا ضعفت\" (your argument became weak/innovative in the bad sense).\n- Root: حدث (ḥadatha)\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — coming-to-be of a thing after it was not. \"المحدث: ما أوجد بعد أن لم يكن\" — the originated thing.\n  * Al-Zamakhshari (Asas): Literal — \"هو حدث من الأحداث\" (he is a youth among youths). Metaphorical — \"صاروا أحاديث\" (they became [mere] tales). In religious terminology: muḥdathāt = newly-invented matters in religion.\n- Root: هدى (hadā)\n  * Al-Raghib (Mufradat): Guidance — directing to the path with gentleness; al-hudā is the guidance of the Prophet ﷺ in matters of religion.\n  * Al-Zamakhshari (Asas): \"حسن الهدى\" — excellent guidance, the prophetic way (sunnah) as opposed to innovation.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما هما اثنتان: الكلام والهدى\" restricts the two matters exclusively to speech and guidance, excluding all else.\n\n---\n\n#","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'","badge":"Insight"}],"185":[{"arabic":"وفي أنفسهم حتى يتبين لهم أنه الحق} الآية وبقوله عز وجل أولم ينظروا في ملكوت السموات والأرض وبقوله تعالى قل انظروا ماذا في السموات والأرض وبقوله تعالى الذي خلق سبع سموات طباقا ما ترى في خلق الرحمن من تفاوت فارجع البصر هل ترى من فطور ثم ارجع البصر كرتين ينقلب إليك البصر خاسئا وهو حسير وهذا الطريق هو الأسهل على الأكثرين وهو الأوسع على السالكين وإليه أكثر دعوة القرآن عند الأمر بالتدبر والتفكر والاعتبار والنظر في آيات خارجة عن الحصر فإن قلت كلا الطريقين مشكل فأوضح لنا منهما ما يستعان به على تحصيل المعرفة والتوصل به إلى المحبة فاعلم أن الط","english":"Those who arrive at this rank divide into two groups: the strong, whose first knowledge is of God, exalted be He, and then through Him they come to know other than Him; and the weak, whose first knowledge is of [His] acts, and then they ascend from them to the Agent. To the first points His saying, exalted be He: {أو لم يكف بربك أنه على كل شيء شهيد} [Is it not sufficient concerning your Lord that He is over all things a Witness], and His saying, exalted be He: {«شهد الله أنه لا إله إلا هو»} [God bears witness that there is no god but He]. And of this kind is the saying of one of them, when it was said to him: \"By what have you known your Lord?\" He said: \"I have known my Lord — and were it not for my Lord, I would not have known my Lord.\"","book_title":"Love, Longing, Intimacy and Contentment","section_title_ar":"Section 1165","section_title_en":"The Two Paths to Knowledge and Love: The Higher Way of Witnessing the Truth and the Easier Way of Contemplating Creation","section_index":1165,"anchors":"- Root: طيب (ṭ-y-b)\n  * Lisan / Ayn: Pure, good, wholesome; free from defilement\n  * Al-Raghib (Mufradat): That which is pure and agreeable in both sensory and intellectual registers; the \"good word\" (al-kalim al-ṭayyib) is the declaration of divine unity\n  * Al-Zamakhshari (Asas): Literal for sensory purity; metaphorical for spiritual purity of heart and speech\n- Root: عرف (ʿ-r-f)\n  * Lisan / Ayn: To know by reflection and discernment of traces/effects\n  * Al-Raghib (Mufradat): Maʿrifah is knowledge of God attained through contemplation of His effects, not through direct apprehension of His essence; it is more specific than ʿilm\n  * Al-Zamakhshari (Asas): Literal: to recognize someone; metaphorical: knowledge of God through His signs\n- Root: شهد (sh-h-d)\n  * Lisan / Ayn: To witness, testify, be present\n  * Al-Raghib (Mufradat): Bearing witness to the truth of something based on direct presence or evidence\n  * Al-Zamakhshari (Asas): Literal: ocular presence; metaphorical: intellectual certitude\n- Root: نظر (n-ẓ-r)\n  * Lisan / Ayn: To look, gaze, contemplate\n  * Al-Raghib (Mufradat): Contemplative reflection (naẓar) directed toward creation to derive knowledge of the Creator\n  * Al-Zamakhshari (Asas): Literal: visual perception; metaphorical: intellectual consideration and inference\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — used to restrict the purpose of works to purification of the heart, and to restrict the ultimate end to knowledge of unveiling","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'","badge":"Insight"},{"arabic":"عظيم به حجب أكثر المتكلمين والمتعصبين للمذاهب بل أكثر الصالحين المتفكرين في ملكوت السموات والأرض لأنهم محجوبون باعتقادات تقليدية جمدت في نفوسهم ورسخت في قلوبهم وصارت حجابا بينهم وبين درك الحقائق الخامس الجهل بالجهة التي يقع منها العثور على المطلوب فإن طالب العلم ليس يمكنه أن يحصل العلم بالمجهول إلا بالتذكر للعلوم التي تناسب مطلوبه حتى إذا تذكرها ورتبها في نفسه ترتيبا مخصوصا يعرفه العلماء بطرق الاعتبار فعند ذلك يكون قد عثر على جهة المطلوب فتنجلى حقيقة المطلوب لقلبه فإن العلوم المطلوبة التي ليست فطرية لا تقتنص إلا بشبكة العلوم الحاصلة بل كل","english":"The second is the turbidity of disobedience and the foulness that accumulates upon the face of the heart from the abundance of lusts. For that prevents the heart's purity and clarity, and thus the appearance of truth within it is prevented by its darkness and accumulation. To this points his saying, peace be upon him: \"Whoever commits a sin departs from him an intellect that never returns to him\" {«حديث»} — and his saying, peace be upon him: \"Whoever acts upon what he knows, God bequeaths to him knowledge of what he does not know,\" narrated by Abū Nuʿaym in al-Ḥilyah from the hadith of Anas, and it has preceded in the Book of Knowledge.","book_title":"Contemplation","section_title_ar":"Section 583","section_title_en":"The Heart as a Mirror: The Five Obstacles to Knowledge and the Path to Unveiling","section_index":583,"anchors":"- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn, overturn, transform from one state to another; the heart as that which constantly fluctuates and turns.\n  * Al-Raghib (Mufradat): The heart is the subtle center of perception and understanding, that which turns toward matters and apprehends their realities.\n  * Al-Zamakhshari (Asas): Literal: turning a thing over. Metaphorical: the heart as the seat of understanding that \"turns over\" matters to grasp their true nature.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: To know, to perceive a thing's reality; knowledge as the impression of the form of a thing.\n  * Al-Raghib (Mufradat): Knowledge is the apprehension of a thing by its true reality (idrāk al-shayʾ bi-ḥaqīqatihi) — either the perception of the thing's essence or the judgment of its attributes.\n  * Al-Zamakhshari (Asas): Literal: knowledge as direct perception. Metaphorical: knowledge as the \"arrival\" of the known's form in the heart.\n- Root: صور (ṣ-w-r)\n  * Lisan / Ayn: Form, shape, image; that by which a thing is distinguished.\n  * Al-Raghib (Mufradat): Form is twofold: sensible (perceived by all) and intelligible (perceived by the discerning) — the latter being the form of the intellect and meanings.\n  * Al-Zamakhshari (Asas): Literal: physical shape. Metaphorical: the \"form\" of a thing's reality that imprints upon the heart.\n- Root: مرا (m-r-ʾ)\n  * Lisan / Ayn: A person, a human being; also mirror (mirʾāh).\n  * Al-Raghib (Mufradat): The mirror as that which reflects forms without itself being altered.\n  * Al-Zamakhshari (Asas): Literal: mirror as reflective surface. Metaphorical: the heart as a mirror reflecting the realities of things.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to establish precise definitions of knowledge, known, and knower through restrictive predication.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'","badge":"Insight"},{"arabic":"من الملائكة بعدد جميع ما خلق الله من شيء فقلت من أنتم فقالوا نحن المحبون لله عز وجل نعبده ههنا منذ ثلثمائة ألف سنة ما خطر على قلوبنا قط سواه ولا ذكرنا غيره قال فاستحييت من أعمالي فوهبتها لمن حق عليه الوعيد تخفيفا عنه في جهنم فإذن من عرف نفسه وعرف ربه واستحيا منه حق الحياء خرس لسانه عن التظاهر بالدعوى نعم يشهد على حبه حركاته وسكناته وإقدامه وإحجامه وتردداته كما حكي عن الجنيد أنه قال مرض أستاذنا السري رحمه الله فلم نعرف لعلته دواء ولا عرفنا لها سببا فوصف لنا طبيب حاذق فأخذ قارورة مائه ف","english":"It is related that a man saw something from one of the madmen that made him deem him foolish, and he reported that to Maʿrūf al-Karkhī — may Allah have mercy on him. He smiled, then said: \"O my brother, he has lovers, both young and old, both rational and mad. So this one you saw is among their madmen.\"","book_title":"Love, Longing, Intimacy and Contentment","section_title_ar":"Section 1183","section_title_en":"On the Concealment of Love and Its True Signs — Section 1183","section_index":1183,"anchors":"- Root: خفي (khafā)\n  * Lisan / Ayn: To be hidden, concealed, imperceptible to the senses.\n  * Al-Raghib (Mufradat): Al-Khafī is that which is not perceived by the senses; its theological nuance relates to Allah's knowledge of the unseen (ghayb) and the inner conscience (sirr).\n  * Al-Zamakhshari (Asas): Literal (haqīqah) refers to physical concealment; metaphorical (majāz) applies to the heart's hidden states, as in \"the secret\" (al-sirr) which only Allah perceives.\n- Root: حب (ḥubb)\n  * Lisan / Ayn: Core meaning: to love, to be steadfast upon something; also a jar (ḥubb) that holds water — implying that love is a vessel containing the lover's entire being.\n  * Al-Raghib (Mufradat): Al-Maḥabbah is the will directed toward what is perceived as agreeable; in theological terms, love of Allah is the soul's inclination toward Him due to His perfection, not due to benefit or harm.\n  * Al-Zamakhshari (Asas): Literal: inclination of the heart. Metaphorical: the bodily movements and stillness that testify to an inward state, as the physician's diagnosis of the lover's urine.\n- Root: وجد (wajd)\n  * Lisan / Ayn: To find; also intense emotion, ecstasy, or passionate yearning that overwhelms the lover.\n  * Al-Raghib (Mufradat): Al-Wajd is the arrival of a spiritual state (ḥāl) that dominates the heart, often leading to loss of self-control (ghashyah).\n  * Al-Zamakhshari (Asas): Literal: finding something lost. Metaphorical: the overpowering of the heart by love, such that the lover falls unconscious — as related of al-Sarī.\n- Sibawayh Rule: Rule of Interposition (al-Faṣl bayna al-Jār wa al-Majrūr) — The syntactic principle that a clause may be interrupted by an explanatory parenthetical without breaking grammatical cohesion, as seen in the narrative digressions (e.g., the story of the madman and al-Karkhī) that serve as illustrative asides within the main argument.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'","badge":"Insight"}],"187":[{"arabic":"العير فالأهل فيهما محذوف مضمر وقوله عز وجل ثقلت في السموات والأرض معناه خفيت على أهل السموات والأرض والشيء إذا خفي ثقل فأبدل اللفظ به وأقيم في مقام على وأضمر الأهل وحذف وقوله تعالى وتجعلون رزقكم أنكم تكذبون أي شكر رزقكم وقوله عز وجل وآتنا ما وعدتنا على رسلك أي على ألسنة رسلك فحذف ألسنة وقوله تعالى إنا أنزلناه في ليلة القدر أراد القرآن وما سبق له ذكر وقال عز وجل حتى توارت الحجاب أراد الشمس وما سبق لها ذكر وقوله تعالى والذين اتخذوا من دونه أولياء ما نعبدهم إلا ليقربونا إلى الله زلفى أي يقولون ما نعبدهم وقوله","english":"I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"","book_title":"Etiquette of Quran Recitation","section_title_ar":"Section 233","section_title_en":"The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation","section_index":233,"anchors":"- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'","badge":"Insight"},{"arabic":"الكلمة وأجل مسمى لكان لزاما ولولاه لكان نصبا كاللزام وقوله تعالى يسألونك كأنك حفي عنها أي يسألونك عنها كأنك حفي بها وقوله عز وجل لهم مغفرة ورزق كريم كما أخرجك ربك من بيتك بالحق فهذا الكلام غير متصل وإنما هو عائد إلى قوله السابق قل الأنفال لله والرسول كما أخرجك ربك من بيتك بالحق أي فصارت أنفال الغنائم لك إذ أنت راض بخروجك وهم كارهون فاعترض بين الكلام الأمر بالتقوى وغيره ومن هذا النوع قوله عز وجل حتى تؤمنوا بالله وحده إلا قول إبراهيم لأبيه الآية ومنها المبهم وهو اللفظ المشترك بين معن من كلمة أو حرف أما الكلمة فكالشيء والقرين والأم","english":"I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"","book_title":"Etiquette of Quran Recitation","section_title_ar":"Section 233","section_title_en":"The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation","section_index":233,"anchors":"- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Quran Recitation'","badge":"Hadith"}],"188":[{"arabic":"علامات المرض وبهذا يعرف أن القلوب كلها مريضة إلا ما شاء الله إلا أن من الأمراض ما لا يعرفها صاحبها ومرض القلب مما لا يعرفه صاحبه فلذلك يغفل عنه وإن عرفه صعب عليه الصبر على مرارة دوائه فإن دواءه مخالفة الشهوات وهو نزع الروح فإن وجد من نفسه قوة الصبر عليه لم يجد طبيبا حاذقا يعالجه فإن الأطباء هم العلماء وقد استولى عليهم المرض فالطبيب المريض قلما يلتفت إلى علاجه فلهذا صار الداء عضالا والمرض مزمنا واندرس هذا العلم وأنكر بالكلية طب القلوب وأنكر مرضها وأقبل الخلق على حب الدنيا وعلى أعمال ظاهرها عبادات وباطنها","english":"I say: The soul (nafs) that belongs to the human being — that by which he is distinguished from the beasts — for he is not distinguished from them by the power of eating, copulation, sight, or any other such thing. Rather, he is distinguished by the knowledge of things as they truly are. And the Origin of all things, their Existentiator and their Inventor, is God, Mighty and Majestic — He who made them things. So if one knew everything but did not know God, Mighty and Majestic, it would be as though he knew nothing at all. And the sign of knowledge is love: whoever knows God Most High loves Him. And the sign of love is that one does not prefer over Him this world nor any other beloved thing. As God Most High said: {«Say: If your fathers, your sons, your brothers, your spouses, your clans — the wealth you have acquired, commerce whose decline you fear, and dwellings you find pleasing — are more beloved to you than God and His Messenger and striving in His cause, then wait until God brings about His command»} [Q 9:24]. So whoever possesses something more beloved to him than God — his heart is sick. Just as any stomach to which clay has become more beloved than bread and water, or whose appetite for bread and water has fallen away — it is sick. These are the signs of sickness. And by this it is known that all hearts are sick — except what God wills. Yet among sicknesses there are those the sufferer does not recognize; and the sickness of the heart is among those the sufferer does not recognize. For this reason he is heedless of it. And even if he recognized it, patience upon the bitterness of its medicine would be difficult for him — for its medicine is opposing the appetites, and that is the tearing out of the spirit (nafs). And if he found in himself the strength of patience upon it, he would not find a skillful physician to treat him — for the physicians are the scholars, and sickness has overcome them. So the sick physician rarely attends to his own cure. For this reason the malady has become chronic and the sickness chronic. This science has become effaced, and the medicine of hearts is denied entirely, and the sickness of the heart is denied. And creation has turned to the love of this world and to deeds whose outward form is acts of worship but whose inward reality is habit and ostentation. These are the signs of the roots of sicknesses.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 624","section_title_en":"The Soul's Distinction, the Sickness of the Heart, and the Path of Moderation","section_index":624,"anchors":"- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that by which a thing is distinguished in its essential reality\n  * Al-Raghib (Mufradat): The soul (nafs) as the principle of rational discrimination and knowledge, distinguishing humans from beasts\n  * Al-Zamakhshari (Asas): Literal: the self or person; Metaphorical: the rational soul as the seat of knowledge and moral responsibility\n- Root: مرض (m-r-d)\n  * Lisan / Ayn: Departure from the state of health and equilibrium\n  * Al-Raghib (Mufradat): Sickness of the heart as a metaphor for moral and spiritual vices — ignorance, cowardice, avarice, hypocrisy\n  * Al-Zamakhshari (Asas): Literal: bodily illness; Metaphorical: spiritual malady whereby the heart inclines toward what is harmful and away from what is beneficial\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: The heart; that which is ever-turning and fluctuating between states\n  * Al-Raghib (Mufradat): The heart as the seat of understanding and moral perception; its \"turning\" (taqlīb) signifies its instability between soundness and sickness\n  * Al-Zamakhshari (Asas): Literal: the physical organ; Metaphorical: the spiritual faculty of cognition and moral discernment\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Measured, proportioned disposition; character and temperament\n  * Al-Raghib (Mufradat): Moral character as the inward form (ṣūrah bāṭinah) corresponding to the outward physical form\n  * Al-Zamakhshari (Asas): Literal: measuring and proportioning; Metaphorical: the ingrained disposition that governs action\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The use of restrictive constructions to isolate the defining characteristic of the human soul as knowledge of God, not animal appetites","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"},{"arabic":"محمد بن إدريس قل اللهم إني لا أملك لنفسي نفعا ولا ضرا ولا موتا ولا حياة ولا نشورا ولا أستطيع أن آخذ إلا ما أعطيتني ولا أتقي إلا ما وقيتني اللهم فوفقني لما تحب وترضى من القول والعمل في عافية فلما أصبحت أعدت ذلك فلما ترحل النهار أعطاني الله عز وجل طلبتي وسهل لي الخلاص مما كنت فيه فعليكم بهذه الدعوات لا تغفلوا عنها فهذه جملة من المكاشفات تدل على أحوال الموتى وعلى الأعمال المقربة إلى الله زلفى فلنذكر بعدها ما بين يدى الموتى من ابتداء نفخة الصور إلى آخر القرار إما فى الجنة أو فى النار والحم","english":"Abu Sa'id al-Shahham said: I saw Sahl al-Sa'luki in a dream and said, \"O Shaykh!\" He said, \"Leave off this addressing me as shaykh.\" I said, \"Those spiritual states (aḥwāl) which you witnessed [in life]?\" He said, \"They availed us nothing.\" I said, \"What did God do with you?\" He said, \"He forgave me on account of the questions about which the incapable ones used to ask.\"","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1333","section_title_en":"Section 1333 — Visions of the Deceased and Their States After Death","section_index":1333,"anchors":"- Root: م و ت (m-w-t)\n  * Lisan / Ayn: Death as the cessation of vital faculty; the state of the deceased (mayyit) contrasted with the living (ḥayy).\n  * Al-Raghib (Mufradat): Death as separation of the soul from the body, a transition to the Barzakh; visions of the dead (ru'yā) reveal their post-mortem states.\n  * Al-Zamakhshari (Asas): Literal death (ḥaqīqah) vs. metaphorical \"death\" of the heart; here, actual death and its aftermath.\n- Root: غ ف ر (gh-f-r)\n  * Lisan / Ayn: Covering, protection from defilement; forgiveness as divine concealment of sin.\n  * Al-Raghib (Mufradat): Divine forgiveness (maghfirah) as God's safeguarding the servant from punishment.\n  * Al-Zamakhshari (Asas): Literal: covering a garment; metaphorical: God's pardon enveloping all sins, as in the vision of Ibn al-Mubarak.\n- Root: ر أ ي (r-'-y)\n  * Lisan / Ayn: Seeing, perceiving; in dreams (ru'yā), a mode of non-sensory perception.\n  * Al-Raghib (Mufradat): Vision as a form of divine disclosure (mukāshafah) granted to the righteous.\n  * Al-Zamakhshari (Asas): Literal sight vs. dream-vision as a vehicle for veridical reports of the unseen.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the placement of prepositional phrases and their objects, ensuring syntactic coherence in complex narrative chains, as applied here to the sequence of reported dream-visions.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"}],"194":[{"arabic":"{إن الذين تدعون من دون الله عباد أمثالكم} فالشكر باللسان من جملة الشكر وقد روي أن وفدا قدموا على عمر بن عبد العزيز رحمه الله فقام شاب ليتكلم فقال عمر الكبر الكبر فقال يا أمير المؤمنين لو كان الأمر بالسن لكان في المسلمين من هو أسكن منك فقال تكلم فقال لسنا وفد الرغبة ولا وفد الرهبة أما الرغبة فقد أوصلها إلينا فضلك وأما الرهبة فقد آمننا منها عدلك وإنما نحن وقد الشكر جئناك نشكرك باللسان وننصرف فهذه هي أصول معاني الشكر المحيطة بمجموع حقيقته فأما قول من قال إن الشكر هو الاعتراف بنعمة المنعم","english":"...not the vision of the blessing. And al-Khawwāṣ — God's mercy upon him — said: \"The gratitude of the common folk is for food, clothing, and drink; the gratitude of the elite is for the arrivals upon the hearts [of divine gnosis].\" This is a station that not everyone apprehends — those whose pleasures are confined to the belly, the loins, and the sensory perceptions of colors and sounds, and who are devoid of the heart's pleasure. For the heart, in a state of health, takes delight only in the remembrance of God — exalted is He — in knowledge of Him, and in the hope of meeting Him. It only delights in other than Him when it has fallen ill through evil habits — just as some people take pleasure in eating clay, and just as some of the sick find sweet things repugnant and bitter things sweet, as it was said:","book_title":"Patience and Gratitude","section_title_ar":"Section 976","section_title_en":"The Reality of Gratitude (Shukr) — Its Three Pillars and the Degrees of the Thankful","section_index":976,"anchors":"- Root: شكر (Sh-K-R)\n  * Lisan / Ayn: Core meaning is \"to open, reveal, or fill\"; a beast that thrives on little fodder is called *shakūr* — its fullness of body manifests its owner's care.\n  * Al-Raghib (Mufradat): Gratitude is \"the conceptualization of the blessing and its manifestation\" (*taṣawwur al-niʿmah wa-iẓhāruhā*). It is the inverse of *kufr* (disbelief/ingratitude), which is forgetting and concealing the blessing. It has three kinds: gratitude of the heart (perceiving the blessing), of the tongue (praising the Benefactor), and of the limbs (requiting the blessing through obedience).\n  * Al-Zamakhshari (Asas): Literal (*ḥaqīqah*): \"I thanked God for His blessing.\" Metaphorical (*majāz*): A beast is called *shakūr* when little fodder suffices it and it fattens — the gratitude is manifest in its condition, not uttered by a tongue.\n- Root: نعم (N-ʿ-M)\n  * Lisan / Ayn: *Niʿmah* denotes a state of well-being and ease; *naʿīm* is the felicitous life therein.\n  * Al-Raghib (Mufradat): *Niʿmah* is \"the good state\" (*al-ḥālah al-ḥasanah*), built on the pattern of states like sitting (*jilsah*) and riding (*rikbah*). It applies to both little and much, as in {«وَإِن تَعُدُّوا نِعْمَتَ اللَّهِ لَا تُحْصُوهَا»} (Ibrahim: 34).\n  * Al-Zamakhshari (Asas): Literal: \"God's blessing and His bounties are immense.\" Metaphorical: \"Their ostriches departed\" (*khafat naʿāmatuhum*) — meaning they fled, a metaphor for the vanishing of comfort.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn a thing over, to rotate it from one face to another.\n  * Al-Raghib (Mufradat): \"The turning of a thing: directing it and moving it from one aspect to another.\" The heart is so named for its constant fluctuation (*taqallub*).\n  * Al-Zamakhshari (Asas): Literal: \"I turned the thing over.\" Metaphorical: \"A man *qalb ḥawal*\" — one who turns matters over and devises stratagems; \"they turned the matters over for you\" (Quran 9:48), i.e., they examined and contrived.\n- Sibawayh Rule: Restriction and Focused Predication (*al-ḥaṣr wa-al-taqyīd bi-innamā*) — The particle *innamā* restricts the predicate to the subject alone, as in the author's formulation \"Gratitude is only the acknowledgment of the Benefactor's blessing in a posture of humility\" — a definition that confines the reality to one part (the tongue with a state of the heart) rather than the whole.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'","badge":"Insight"}],"199":[{"arabic":"ثم إن تفاخر عليه غيره فليحتمل قال الله تعالى لنبيه صلى الله عليه وسلم {خذ العفو وأمر بالعرف وأعرض عن الجاهلين} وعن ابن أبي أوفى كان رسول الله صلى الله عليه وسلم يتواضع لكل مسلم ولا يأنف ولا يتكبر أن يمشي مع الأرملة والمسكين فيقضي حاجته (7) ومنها أن لا يسمع بلاغات الناس بعضهم على بعض ولا يبلغ بعضهم ما يسمع من بعض قال صلى الله عليه وسلم لا يدخل الجنة قتات (8) وقال الخليل بن أحمد من نم لك نم عليك ومن أخبرك بخير غيرك أخبر غيرك بخبرك ومنها أن لا يزيد في الهجر لمن يعرفه على ثلاثة أيام مهما غضب عليه قال أبو أيوب الأنصاري قال صلى الله عليه وسلم لا يحل لمسلم","english":"**First**: That you greet him with peace (*salām*) when you meet him, and respond to his invitation when he invites you, and say \"may Allah have mercy on you\" (*tashmīt*) when he sneezes, and visit him when he is ill, and attend his funeral procession when he dies, and fulfill his oath when he swears by you, and give him sincere counsel when he seeks your advice, and protect him in his absence when he is away from you, and love for him what you love for yourself, and dislike for him what you dislike for yourself. (1)","book_title":"Condemnation of Anger and Hatred","section_title_ar":"Section 433","section_title_en":"The Rights of Brotherhood — Section 433: The Duties of a Muslim Toward His Fellow Muslims","section_index":433,"anchors":"- Root: سلم (s-l-m)\n  * Lisan / Ayn: Core meaning of safety, security, freedom from harm; the root from which *islām* (submission/surrender) and *salām* (peace) derive\n  * Al-Raghib (Mufradat): *Salām* as the theological state of being secure from harm — both giving and receiving safety; *islām* as the total surrender of the heart to Allah\n  * Al-Zamakhshari (Asas): Literal (*ḥaqīqah*): physical safety from tongue and hand; Metaphorical (*majāz*): the comprehensive spiritual safety that defines true Muslim brotherhood\n- Root: عون (ʿ-w-n)\n  * Lisan / Ayn: Assistance, aid, helping another in need\n  * Al-Raghib (Mufradat): Mutual assistance as a divine ordinance among believers\n  * Al-Zamakhshari (Asas): Literal: physical aid; Metaphorical: intercession (*shafāʿah*) and advocacy on behalf of others\n- Root: ستر (s-t-r)\n  * Lisan / Ayn: Covering, concealing, veiling; protection from exposure\n  * Al-Raghib (Mufradat): *Sitr* as the divine attribute of concealment — Allah's covering of sins in this world and the next\n  * Al-Zamakhshari (Asas): Literal: covering a physical defect; Metaphorical: concealing another's faults and sins — a cardinal virtue of brotherhood\n- Root: عذر (ʿ-dh-r)\n  * Lisan / Ayn: Excuse, pardon, acceptance of apology\n  * Al-Raghib (Mufradat): *ʿAfw* (pardon) as the higher station of forgiveness that elevates the forgiver\n  * Al-Zamakhshari (Asas): Literal: releasing from obligation; Metaphorical: the noble trait of overlooking others' offenses\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated use of restrictive constructions (e.g., \"المسلم من سلم المسلمون\") establishes definitional boundaries through predicate restriction, indicating that the *ḥaqīqah* of faith is manifested through specific observable actions.\n\n---\n\n##","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Anger and Hatred'","badge":"Ethics"}],"200":[{"arabic":"إليه ليدفعه عنه كما قال الله تعالى {وإما ينزغنك من الشيطان نزغ فاستعذ بالله إنه سميع عليم} وقال تعالى {إن الذين اتقوا إذا مسهم طائف من الشيطان تذكروا فإذا هم مبصرون} وإلى ما يشك فيه فينبغي أن يعرض ذلك على شيخه بل كل ما يجد في قلبه من الأحوال من فترة أو نشاط أو التفات إلى علقة أو صدق في إرادة فينبغي أن يظهر ذلك لشيخه وأن يستره عن غيره فلا يطلع عليه أحدا ثم إن شيخه ينظر في حاله ويتأمل في ذكائه وكياسته فلو علم أنه لو تركه وأمره بالفكر تنبه من نفسه على حقيقة الحق فينبغي أن يحيله على الفكر ويأمره بملازمته حتى يقذف في قلبه من النور ما يكشف له حق","english":"As for hunger — it diminishes the blood of the heart and whitens it, and in its whiteness is its light; it melts the fat of the heart (shahm al-fuʾād), and in its melting is its tenderness; and its tenderness is the key to unveiling (mukāshafah), just as its hardness is the cause of the veil. And whenever the blood of the heart diminishes, the passage of the enemy narrows, for his channels are the veins filled with desires. Jesus, peace be upon him, said: \"O company of disciples, hunger your bellies, that perhaps your hearts may see your Lord.\" And Sahl ibn ʿAbd Allāh al-Tustarī said: \"The substitutes (abdāl) became substitutes only through four qualities: emptying the bellies, vigil, silence, and withdrawal from people.\" The benefit of hunger in illuminating the heart is a manifest matter to which experience bears witness, and the explanation of the gradual method in it will come in the Book of Breaking the Two Desires.","book_title":"Breaking the Two Desires","section_title_ar":"Section 636","section_title_en":"The Path of the Seeker: On the Four Fortresses of Solitude, Silence, Hunger, and Vigilance","section_index":636,"anchors":"- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn over, to revolve, to transform from one state to another; the heart as that which constantly fluctuates and turns.\n  * Al-Raghib (Mufradat): تصريفه وصرفه عن وجه إلى وجه — the heart's perpetual turning and overturning; its rectification (إصلاح) is the seeker's sole aim, that it might witness its Lord.\n  * Al-Zamakhshari (Asas): Haqiqah: turning a thing over; Majaz: the heart's disposition and its being veiled or illumined.\n- Root: طرق (t-r-q)\n  * Lisan / Ayn: To strike, to beat upon; the road (طريق) that is beaten by feet.\n  * Al-Raghib (Mufradat): The path trodden; metaphorically, every course a man pursues, whether praiseworthy or blameworthy.\n  * Al-Zamakhshari (Asas): Haqiqah: striking iron with a hammer; Majaz: the \"strikers of the road\" (قواطع الطريق) — the highway robbers who cut off the seeker's passage.\n- Root: كان (k-w-n)\n  * Lisan / Ayn: To be, to come into existence; the copula of being.\n  * Al-Raghib (Mufradat): Existence and becoming; the states (أحوال) that befall the heart.\n  * Al-Zamakhshari (Asas): Haqiqah: being; Majaz: the continuous state of the servant before his Lord.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The conditional and restrictive constructions (إنما، لا...إلا) governing the exclusive means of spiritual purification.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Breaking the Two Desires'","badge":"Insight"}],"201":[{"arabic":"قال الله تعالى إن الذين اتقوا إذا مسهم طائف من الشيطان تذكروا فإذا هم مبصرون فأخبر أن جلاء القلب وإبصاره يحصل بالذكر وأنه لا يتمكن منه إلا الذين اتقوا فالتقوى باب الذكر والذكر باب الكشف والكشف باب الفوز الأكبر وهو الفوز بلقاء الله تعالى","english":"As for the praiseworthy effects that we have mentioned, they increase the mirror of the heart in clarity (jalā'), radiance (ishrāq), light (nūr), and brilliance (ḍiyā'), until the clear truth (jalīyat al-ḥaqq) gleams within it and the reality of the sought-after matter in religion is unveiled in it. And it is to such a heart that the Prophet, peace and blessings be upon him, pointed when he said: \"When God desires good for a servant, He appoints for him an admonisher from his own heart.\" (1) The hadith: \"Whoever has from his heart an admonisher, upon him is from God a protector\" — I have not found for it a source (aṣl).","book_title":"Breaking the Two Desires","section_title_ar":"Section 582","section_title_en":"The Heart as a Mirror: The Effects of Virtues and Vices upon Spiritual Perception","section_index":582,"anchors":"- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn over, to overturn, to transform from one state to another; the heart as that which is constantly fluctuating and turning between states.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — The heart is that which is perpetually turned about, and its rectitude or corruption depends upon the direction of its turning.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): physical turning over. Metaphorical (Majaz): \"قلب المعلم الصبيان: صرفهم إلى بيوتهم\" — the turning of a thing toward its proper end. Here, the heart is a mirror (مرآة) turned toward either the light of truth or the darkness of sin.\n- Root: رين (r-y-n)\n  * Lisan / Ayn: Rust, tarnish, or filth that overcomes a polished surface, veiling its original brightness.\n  * Al-Raghib (Mufradat): The covering of the heart by accumulated sin, such that it becomes rusted over and incapable of receiving the light of truth.\n  * Al-Zamakhshari (Asas): Literal: the tarnishing of a blade or mirror. Metaphorical: the veiling of the heart's perceptive faculty by the accumulation of transgressions, as in {«كلا بل ران على قلوبهم ما كانوا يكسبون»} (The Mutaffifin: 14).\n- Root: طبع (t-b-')\n  * Lisan / Ayn: To stamp, to seal, to impress upon; the imprinting of a seal that renders the surface impermeable to further impression.\n  * Al-Raghib (Mufradat): The sealing of the heart by God as a consequence of persistent sin, rendering it deaf to admonition and blind to truth.\n  * Al-Zamakhshari (Asas): Literal: the physical stamping of a seal. Metaphorical: the divine sealing of the heart as a just consequence of willful persistence in transgression.\n- Root: ذكر (dh-k-r)\n  * Lisan / Ayn: Remembrance, recollection, mindfulness; the opposite of forgetfulness (نسيان).\n  * Al-Raghib (Mufradat): The presence of the thing remembered in the mind; the highest form being the remembrance of God which brings tranquility to the heart.\n  * Al-Zamakhshari (Asas): Literal: verbal invocation. Metaphorical: the state of spiritual presence and awareness that polishes the heart's mirror and unveils the reality of truth.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic connection between cause and effect, as in the verse {«واتقوا الله واسمعوا»}, where hearing (spiritual perception) is grammatically and semantically linked to piety (تقوى), just as the sealing of the heart (طبع) is linked to the accumulation of sins (ذنوب).","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Breaking the Two Desires'","badge":"Insight"}],"205":[{"arabic":"وقال تعالى في ذم المنافقين ولا يذكرون الله إلا قليلا وقال عز وجل واذكر ربك في نفسك تضرعا وخيفة ودون الجهر من القول بالغدو والآصال ولا تكن من الغافلين وقال تعالى ولذكر الله أكبر قال ابن عباس رضي الله عنهما له وجهان أحدهما أن ذكر الله تعالى لكم أعظم من ذكرككم إياه والآخر أن ذكر الله أعظم من كل عبادة سواه إلى غير ذلك من الآيات وأما الأخبار فقد قال رسول الله صلى الله عليه وسلم ذاكر الله في الغافلين كالشجرة في وسط الهشيم (1) وقال صلى الله عليه وسلم ذاكر الله في الغافلين كالمقاتل بين الفارين وقال صلى الله عليه وسلم يقول الله عز وجل أنا مع عبدي ما ذكرني وتحركت شفتاه بي (2) وقال صلى الله عليه وسلم ما عمل","english":"- Root: ذكر (dhakara)\n  * Lisan / Ayn: Core meaning is \"to remember, to mention, to recollect.\" The root carries the dual sense of mental recollection and verbal utterance. In Kitab al-Ayn, the root denotes the opposite of forgetfulness (nisyan), and its verbal form encompasses both the internal act of remembrance and the external act of mentioning.\n  * Al-Raghib (Mufradat): \"الذكر: حضور المعنى في النفس، وقد يطلق على إبقاء المعنى باللسان. والذكر ضربان: ذكر بالقلب، وذكر باللسان. وقال تعالى: {فاذكروني أذكركم} [البقرة/152] — فذكر العبد ربه بالتعظيم والثناء، وذكر الله عبده بالإنعام والإكرام.\" The theological nuance distinguishes between the creature's remembrance (which is petition and praise) and the Creator's remembrance (which is response and reward).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"ذكرت الشيء: حفظته ووعيته. وذكرت فلانا: جريت بذكره على لسانك.\" Metaphorical (Majaz): \"ذكر الله العبد: أثنى عليه وأجزل له الثواب. ومن المجاز: قوله تعالى {ولذكر الله أكبر} — أي ذكر الله إياكم أعظم من ذكركم إياه.\" The rhetorical distinction is crucial here: when Allah \"remembers\" His servant, it is an act of grace, not cognition.\n- Sibawayh Rule: باب الفصل بين المبتدأ والخبر (Interposition between Subject and Predicate) — In the verse {ولذكر الله أكبر}, the grammatical structure allows for the subject (ذكر الله) to be read as either the creature's remembrance of Allah or Allah's remembrance of the creature, with the predicate (أكبر) applying to whichever reading is adopted. This syntactic ambiguity is deliberate and productive of multiple valid interpretations.","book_title":"On Invocations and Supplications","section_title_ar":"Section 235","section_title_en":"Section 235","section_index":235,"anchors":"*(Anchors established)*","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'","badge":"Insight"},{"arabic":"قال الله تعالى وأقم الصلاة لذكري وقال تعالى ولا تكن من الغافلين وقال عز وجل لا تقربوا الصلاة وأنتم سكارى حتى تعلموا ما تقولون قيل سكارى من كثرة الهم وقيل من حب الدنيا وقال وهب المراد به ظاهره ففيه تنبيه على سكر الدنيا إذ بين فيه العلة فقال حتى تعلموا ما تقولون وكم من مصل لم يشرب خمرا وهو لا يعلم ما يقول في صلاته وقال النبي صلى الله عليه وسلم من صلى ركعتين لم يحدث نفسه فيهما بشيء من الدنيا غفر له ما تقدم من ذنبه (1) وقال صلى الله عليه وسلم إنما الصلاة تمسكن وتواضع وتضرع وتأوه وتنادم وتضع يديك فتقول","english":"God—Exalted is He—said: {«And establish prayer for My remembrance»} (Q 20:14). And He—Exalted is He—said: {«And be not among the heedless»} (Q 7:205). And He—Mighty and Majestic—said: {«Do not approach prayer while you are intoxicated until you know what you are saying»} (Q 4:43). It was said: \"intoxicated\" from the excess of worldly concern (al-hamm), and it was said: from love of this world.","book_title":"Mysteries of Prayer","section_title_ar":"Section 124","section_title_en":"The Virtue of Humble Devotion (Khusḥūʿ) in Prayer","section_index":124,"anchors":"- Root: خشع (Khashaʿa)\n  * Lisan / Ayn: \"الخشوع: التواضع والسكون، وخشع بصره: غضه وأطرقه، وخشعت الأصوات: سكنت وخفضت\"\n  * Al-Raghib (Mufradat): \"الخشوع: الضراعة والاستكانة، وأصله الانخفاض والتطامن، ويقال للصوت الخفيض والطرف المنكسر\"\n  * Al-Zamakhshari (Asas): \"Literal: خشع الرجل: خفض رأسه وتواضع. Metaphorical: خشع القلب: خضع وذل وسكن لله\"\n- Root: سكر (Sukr)\n  * Lisan / Ayn: \"السكر: نقيض الصحو، والسكران: الذي غطى عقله، وكل شيء غطى فقد سكر\"\n  * Al-Raghib (Mufradat): \"السكر: حالة تعرض بين العقل وبين إدراكه، ويستعار لما يغطي العقل من الهم وحب الدنيا\"\n  * Al-Zamakhshari (Asas): \"Literal: سكر من الشراب. Metaphorical: سكر الهم وحب الدنيا — ما يغطي العقل عن إدراك المقام\"\n- Root: ندم (Nadama)\n  * Lisan / Ayn: \"الندم: التحسر على ما فات، والندامة: التوبة، والنادم: المتحسر\"\n  * Al-Raghib (Mufradat): \"الندم: انكسار النفس لما فرط، وهو من لوازم التوبة\"\n  * Al-Zamakhshari (Asas): \"Literal: ندم على الشيء: تحسر. Metaphorical: تنادم في الصلاة: استحضار التقصير والانكسار بين يدي الله\"\n- Root: وجب (Wajaba)\n  * Lisan / Ayn: \"وجب القلب: اضطرب وخفق، ووجب الشيء: ثبت ولزم، والوجيب: صوت خفقان القلب\"\n  * Al-Raghib (Mufradat): \"الوجيب: اضطراب القلب من هيبة الأمر وعظمته\"\n  * Al-Zamakhshari (Asas): \"Literal: وجب الباب: أغلقه. Metaphorical: وجيب القلب: خفقانه من الخوف والهيبة\"\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما الصلاة تمسكن\" restricts prayer's essence to humility, excluding distraction and heedlessness.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Prayer'","badge":"Insight"}]},"wordTiming":{"abdulbasit":{"1":[[1,400,9389]],"2":[[1,400,1579],[2,1579,2954],[3,2954,4493],[4,4493,5672],[5,5672,6818],[6,6818,7636],[7,7636,9126],[8,9126,10141],[9,10141,11565],[10,11565,13235],[11,13235,13857],[12,13857,16149],[13,16149,19028]],"3":[[1,400,2691],[2,2691,4299],[3,4299,5608],[4,5608,7385],[5,7385,8460],[6,8460,10174],[7,10174,11452],[8,11452,13961],[9,13961,14584],[10,14584,16404],[11,16404,19571],[12,19571,21535],[13,21535,22797],[14,22797,25088]],"4":[[1,400,1428],[2,1428,2441],[3,2441,3763],[4,3763,6172],[5,6172,8951],[6,8951,10684],[7,10684,12446],[8,12446,13239],[9,13239,13797],[10,13797,16781]],"5":[[1,400,1460],[2,1460,2520],[3,2520,4875],[4,4875,5552],[5,5552,7866],[6,7866,10357],[7,10357,12450],[8,12450,13098],[9,13098,15836],[10,15836,17382],[11,17382,18869],[12,18869,20804]],"6":[[1,400,2635],[2,2635,4243],[3,4243,5467],[4,5467,7061],[5,7061,9438],[6,9438,11687]],"7":[[1,400,3443],[2,3443,5352],[3,5352,6784],[4,6784,8182],[5,8182,9904],[6,9904,1333