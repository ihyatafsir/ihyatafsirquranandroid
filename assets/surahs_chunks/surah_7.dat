َ يَطْلُبُهُۥ حَثِيثًا وَٱلشَّمْسَ وَٱلْقَمَرَ وَٱلنُّجُومَ مُسَخَّرَٰتٍۭ بِأَمْرِهِۦٓۗ أَلَا لَهُ ٱلْخَلْقُ وَٱلْأَمْرُۗ تَبَارَكَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ ", "translation": "Indeed, your Lord is Allāh, who created the heavens and earth in six days and then established Himself above the Throne.[1] He covers the night with the day, [another night] chasing it rapidly; and [He created] the sun, the moon, and the stars, subjected by His command. Unquestionably, His is the creation and the command; blessed is Allāh, Lord of the worlds.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "رَبَّكُمُ", "translit": "ُmُkَّbَr", "root": "ربب"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 6, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 7, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "سِتَّةِ", "translit": "ِẗَّtِs", "root": "ستت"}, {"id": 10, "arabic": "أَيَّامٍ", "translit": "ٍmāَّyَaʾ", "root": "يوم"}, {"id": 11, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 12, "arabic": "ٱسْتَوَىٰ", "translit": "ٰàَwَtْsٱ", "root": "سوي"}, {"id": 13, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 14, "arabic": "ٱلْعَرْشِ", "translit": "ِhsْrَʿعْlٱ", "root": "عرش"}, {"id": 15, "arabic": "يُغْشِى", "translit": "àِhsْغُy", "root": "غشو"}, {"id": 16, "arabic": "ٱلَّيْلَ", "translit": "َlْyَّlٱ", "root": "ليل"}, {"id": 17, "arabic": "ٱلنَّهَارَ", "translit": "َrāَhَّnlٱ", "root": "نهر"}, {"id": 18, "arabic": "يَطْلُبُهُۥ", "translit": "ۥُhُbُlْṭَy", "root": "طلب"}, {"id": 19, "arabic": "حَثِيثًا", "translit": "āًhtyِhtَḥ", "root": "حثث"}, {"id": 20, "arabic": "وَٱلشَّمْسَ", "translit": "َsْmَّhslٱَw", "root": "شمس"}, {"id": 21, "arabic": "وَٱلْقَمَرَ", "translit": "َrَmَqْlٱَw", "root": "قمر"}, {"id": 22, "arabic": "وَٱلنُّجُومَ", "translit": "َmwُjgُّnlٱَw", "root": "نجم"}, {"id": 23, "arabic": "مُسَخَّرَٰتٍۭ", "translit": "ٍۭtَٰrَّhkَsُm", "root": "سخر"}, {"id": 24, "arabic": "بِأَمْرِهِۦٓ", "translit": "ٓۦِhِrْmَaʾِb", "root": "امر"}, {"id": 25, "arabic": "أَلَا", "translit": "āَlَaʾ", "root": ""}, {"id": 26, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 27, "arabic": "ٱلْخَلْقُ", "translit": "ُqْlَhkْlٱ", "root": "خلق"}, {"id": 28, "arabic": "وَٱلْأَمْرُ", "translit": "ُrْmَaʾْlٱَw", "root": "امر"}, {"id": 29, "arabic": "تَبَارَكَ", "translit": "َkَrāَbَt", "root": "برك"}, {"id": 30, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 31, "arabic": "رَبُّ", "translit": "ُّbَr", "root": "ربب"}, {"id": 32, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": true}, {"ayah": 55, "text": "ٱدْعُوا۟ رَبَّكُمْ تَضَرُّعًا وَخُفْيَةًۚ إِنَّهُۥ لَا يُحِبُّ ٱلْمُعْتَدِينَ ", "translation": "Call upon your Lord in humility and privately; indeed, He does not like transgressors.[1]", "words": [{"id": 1, "arabic": "ٱدْعُوا۟", "translit": "۟āwُʿعْdٱ", "root": "دعو"}, {"id": 2, "arabic": "رَبَّكُمْ", "translit": "ْmُkَّbَr", "root": "ربب"}, {"id": 3, "arabic": "تَضَرُّعًا", "translit": "āًʿعُّrَḍَt", "root": "ضرع"}, {"id": 4, "arabic": "وَخُفْيَةً", "translit": "ًẗَyْfُhkَw", "root": "خفي"}, {"id": 5, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 8, "arabic": "ٱلْمُعْتَدِينَ", "translit": "َnyِdَtْʿعُmْlٱ", "root": "عدو"}], "hasIhya": true}, {"ayah": 56, "text": "وَلَا تُفْسِدُوا۟ فِى ٱلْأَرْضِ بَعْدَ إِصْلَٰحِهَا وَٱدْعُوهُ خَوْفًا وَطَمَعًاۚ إِنَّ رَحْمَتَ ٱللَّهِ قَرِيبٌ مِّنَ ٱلْمُحْسِنِينَ ", "translation": "And cause not corruption upon the earth after its reformation. And invoke Him in fear and aspiration. Indeed, the mercy of Allāh is near to the doers of good.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تُفْسِدُوا۟", "translit": "۟āwُdِsْfُt", "root": "فسد"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 5, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 6, "arabic": "إِصْلَٰحِهَا", "translit": "āَhِḥَٰlْṣِiʾ", "root": "صلح"}, {"id": 7, "arabic": "وَٱدْعُوهُ", "translit": "ُhwُʿعْdٱَw", "root": "دعو"}, {"id": 8, "arabic": "خَوْفًا", "translit": "āًfْwَhk", "root": "خوف"}, {"id": 9, "arabic": "وَطَمَعًا", "translit": "āًʿعَmَṭَw", "root": "طمع"}, {"id": 10, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 11, "arabic": "رَحْمَتَ", "translit": "َtَmْḥَr", "root": "رحم"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "قَرِيبٌ", "translit": "ٌbyِrَq", "root": "قرب"}, {"id": 14, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 15, "arabic": "ٱلْمُحْسِنِينَ", "translit": "َnyِnِsْḥُmْlٱ", "root": "حسن"}], "hasIhya": true}, {"ayah": 57, "text": "وَهُوَ ٱلَّذِى يُرْسِلُ ٱلرِّيَٰحَ بُشْرًۢا بَيْنَ يَدَىْ رَحْمَتِهِۦۖ حَتَّىٰٓ إِذَآ أَقَلَّتْ سَحَابًا ثِقَالًا سُقْنَٰهُ لِبَلَدٍ مَّيِّتٍ فَأَنزَلْنَا بِهِ ٱلْمَآءَ فَأَخْرَجْنَا بِهِۦ مِن كُلِّ ٱلثَّمَرَٰتِۚ كَذَٰلِكَ نُخْرِجُ ٱلْمَوْتَىٰ لَعَلَّكُمْ تَذَكَّرُونَ ", "translation": "And it is He who sends the winds as good tidings before His mercy [i.e., rainfall] until, when they have carried heavy rainclouds, We drive them to a dead land and We send down rain therein and bring forth thereby [some] of all the fruits. Thus will We bring forth the dead; perhaps you may be reminded.", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يُرْسِلُ", "translit": "ُlِsْrُy", "root": "رسل"}, {"id": 4, "arabic": "ٱلرِّيَٰحَ", "translit": "َḥَٰyِّrlٱ", "root": "روح"}, {"id": 5, "arabic": "بُشْرًۢا", "translit": "āًۢrْhsُb", "root": "بشر"}, {"id": 6, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 7, "arabic": "يَدَىْ", "translit": "ْàَdَy", "root": "يدي"}, {"id": 8, "arabic": "رَحْمَتِهِۦ", "translit": "ۦِhِtَmْḥَr", "root": "رحم"}, {"id": 9, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 10, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 11, "arabic": "أَقَلَّتْ", "translit": "ْtَّlَqَaʾ", "root": "قلل"}, {"id": 12, "arabic": "سَحَابًا", "translit": "āًbāَḥَs", "root": "سحب"}, {"id": 13, "arabic": "ثِقَالًا", "translit": "āًlāَqِht", "root": "ثقل"}, {"id": 14, "arabic": "سُقْنَٰهُ", "translit": "ُhَٰnْqُs", "root": "سوق"}, {"id": 15, "arabic": "لِبَلَدٍ", "translit": "ٍdَlَbِl", "root": "بلد"}, {"id": 16, "arabic": "مَّيِّتٍ", "translit": "ٍtِّyَّm", "root": "موت"}, {"id": 17, "arabic": "فَأَنزَلْنَا", "translit": "āَnْlَznَaʾَf", "root": "نزل"}, {"id": 18, "arabic": "بِهِ", "translit": "ِhِb", "root": ""}, {"id": 19, "arabic": "ٱلْمَآءَ", "translit": "َءٓāَmْlٱ", "root": "موه"}, {"id": 20, "arabic": "فَأَخْرَجْنَا", "translit": "āَnْjgَrْhkَaʾَf", "root": "خرج"}, {"id": 21, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 22, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 23, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 24, "arabic": "ٱلثَّمَرَٰتِ", "translit": "ِtَٰrَmَّhtlٱ", "root": "ثمر"}, {"id": 25, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 26, "arabic": "نُخْرِجُ", "translit": "ُjgِrْhkُn", "root": "خرج"}, {"id": 27, "arabic": "ٱلْمَوْتَىٰ", "translit": "ٰàَtْwَmْlٱ", "root": "موت"}, {"id": 28, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 29, "arabic": "تَذَكَّرُونَ", "translit": "َnwُrَّkَhdَt", "root": "ذكر"}], "hasIhya": true}, {"ayah": 58, "text": "وَٱلْبَلَدُ ٱلطَّيِّبُ يَخْرُجُ نَبَاتُهُۥ بِإِذْنِ رَبِّهِۦۖ وَٱلَّذِى خَبُثَ لَا يَخْرُجُ إِلَّا نَكِدًاۚ كَذَٰلِكَ نُصَرِّفُ ٱلْءَايَٰتِ لِقَوْمٍ يَشْكُرُونَ ", "translation": "And the good land - its vegetation emerges by permission of its Lord; but that which is bad - nothing emerges except sparsely, with difficulty. Thus do We diversify the signs for a people who are grateful.", "words": [{"id": 1, "arabic": "وَٱلْبَلَدُ", "translit": "ُdَlَbْlٱَw", "root": "بلد"}, {"id": 2, "arabic": "ٱلطَّيِّبُ", "translit": "ُbِّyَّṭlٱ", "root": "طيب"}, {"id": 3, "arabic": "يَخْرُجُ", "translit": "ُjgُrْhkَy", "root": "خرج"}, {"id": 4, "arabic": "نَبَاتُهُۥ", "translit": "ۥُhُtāَbَn", "root": "نبت"}, {"id": 5, "arabic": "بِإِذْنِ", "translit": "ِnْhdِiʾِb", "root": "اذن"}, {"id": 6, "arabic": "رَبِّهِۦ", "translit": "ۦِhِّbَr", "root": "ربب"}, {"id": 7, "arabic": "وَٱلَّذِى", "translit": "àِhdَّlٱَw", "root": ""}, {"id": 8, "arabic": "خَبُثَ", "translit": "َhtُbَhk", "root": "خبث"}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "يَخْرُجُ", "translit": "ُjgُrْhkَy", "root": "خرج"}, {"id": 11, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 12, "arabic": "نَكِدًا", "translit": "āًdِkَn", "root": "نكد"}, {"id": 13, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 14, "arabic": "نُصَرِّفُ", "translit": "ُfِّrَṣُn", "root": "صرف"}, {"id": 15, "arabic": "ٱلْءَايَٰتِ", "translit": "ِtَٰyāَءْlٱ", "root": "ايي"}, {"id": 16, "arabic": "لِقَوْمٍ", "translit": "ٍmْwَqِl", "root": "قوم"}, {"id": 17, "arabic": "يَشْكُرُونَ", "translit": "َnwُrُkْhsَy", "root": "شكر"}], "hasIhya": false}, {"ayah": 59, "text": "لَقَدْ أَرْسَلْنَا نُوحًا إِلَىٰ قَوْمِهِۦ فَقَالَ يَٰقَوْمِ ٱعْبُدُوا۟ ٱللَّهَ مَا لَكُم مِّنْ إِلَٰهٍ غَيْرُهُۥٓ إِنِّىٓ أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَظِيمٍ ", "translation": "We had certainly sent Noah to his people, and he said, \"O my people, worship Allāh; you have no deity other than Him. Indeed, I fear for you the punishment of a tremendous Day.\"", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "نُوحًا", "translit": "āًḥwُn", "root": ""}, {"id": 4, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 5, "arabic": "قَوْمِهِۦ", "translit": "ۦِhِmْwَq", "root": "قوم"}, {"id": 6, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 7, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 8, "arabic": "ٱعْبُدُوا۟", "translit": "۟āwُdُbْʿعٱ", "root": "عبد"}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 11, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 12, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 13, "arabic": "إِلَٰهٍ", "translit": "ٍhَٰlِiʾ", "root": "اله"}, {"id": 14, "arabic": "غَيْرُهُۥٓ", "translit": "ٓۥُhُrْyَغ", "root": "غير"}, {"id": 15, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 16, "arabic": "أَخَافُ", "translit": "ُfāَhkَaʾ", "root": "خوف"}, {"id": 17, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 18, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 19, "arabic": "يَوْمٍ", "translit": "ٍmْwَy", "root": "يوم"}, {"id": 20, "arabic": "عَظِيمٍ", "translit": "ٍmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 60, "text": "قَالَ ٱلْمَلَأُ مِن قَوْمِهِۦٓ إِنَّا لَنَرَىٰكَ فِى ضَلَٰلٍ مُّبِينٍ ", "translation": "Said the eminent among his people, \"Indeed, we see you in clear error.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱلْمَلَأُ", "translit": "ُaʾَlَmْlٱ", "root": "ملا"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "قَوْمِهِۦٓ", "translit": "ٓۦِhِmْwَq", "root": "قوم"}, {"id": 5, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 6, "arabic": "لَنَرَىٰكَ", "translit": "َkٰàَrَnَl", "root": "راي"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ضَلَٰلٍ", "translit": "ٍlَٰlَḍ", "root": "ضلل"}, {"id": 9, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 61, "text": "قَالَ يَٰقَوْمِ لَيْسَ بِى ضَلَٰلَةٌ وَلَٰكِنِّى رَسُولٌ مِّن رَّبِّ ٱلْعَٰلَمِينَ ", "translation": "[Noah] said, \"O my people, there is not error in me, but I am a messenger from the Lord of the worlds.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 3, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 4, "arabic": "بِى", "translit": "àِb", "root": ""}, {"id": 5, "arabic": "ضَلَٰلَةٌ", "translit": "ٌẗَlَٰlَḍ", "root": "ضلل"}, {"id": 6, "arabic": "وَلَٰكِنِّى", "translit": "àِّnِkَٰlَw", "root": ""}, {"id": 7, "arabic": "رَسُولٌ", "translit": "ٌlwُsَr", "root": "رسل"}, {"id": 8, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 9, "arabic": "رَّبِّ", "translit": "ِّbَّr", "root": "ربب"}, {"id": 10, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 62, "text": "أُبَلِّغُكُمْ رِسَٰلَٰتِ رَبِّى وَأَنصَحُ لَكُمْ وَأَعْلَمُ مِنَ ٱللَّهِ مَا لَا تَعْلَمُونَ ", "translation": "I convey to you the messages of my Lord and advise you; and I know from Allāh what you do not know.", "words": [{"id": 1, "arabic": "أُبَلِّغُكُمْ", "translit": "ْmُkُغِّlَbُaʾ", "root": "بلغ"}, {"id": 2, "arabic": "رِسَٰلَٰتِ", "translit": "ِtَٰlَٰsِr", "root": "رسل"}, {"id": 3, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 4, "arabic": "وَأَنصَحُ", "translit": "ُḥَṣnَaʾَw", "root": "نصح"}, {"id": 5, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 6, "arabic": "وَأَعْلَمُ", "translit": "ُmَlْʿعَaʾَw", "root": "علم"}, {"id": 7, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 11, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": false}, {"ayah": 63, "text": "أَوَعَجِبْتُمْ أَن جَآءَكُمْ ذِكْرٌ مِّن رَّبِّكُمْ عَلَىٰ رَجُلٍ مِّنكُمْ لِيُنذِرَكُمْ وَلِتَتَّقُوا۟ وَلَعَلَّكُمْ تُرْحَمُونَ ", "translation": "Then do you wonder that there has come to you a reminder from your Lord through a man from among you, that he may warn you and that you may fear Allāh so you might receive mercy?\"", "words": [{"id": 1, "arabic": "أَوَعَجِبْتُمْ", "translit": "ْmُtْbِjgَʿعَwَaʾ", "root": "عجب"}, {"id": 2, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 3, "arabic": "جَآءَكُمْ", "translit": "ْmُkَءٓāَjg", "root": "جيا"}, {"id": 4, "arabic": "ذِكْرٌ", "translit": "ٌrْkِhd", "root": "ذكر"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 7, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 8, "arabic": "رَجُلٍ", "translit": "ٍlُjgَr", "root": "رجل"}, {"id": 9, "arabic": "مِّنكُمْ", "translit": "ْmُknِّm", "root": ""}, {"id": 10, "arabic": "لِيُنذِرَكُمْ", "translit": "ْmُkَrِhdnُyِl", "root": "نذر"}, {"id": 11, "arabic": "وَلِتَتَّقُوا۟", "translit": "۟āwُqَّtَtِlَw", "root": "وقي"}, {"id": 12, "arabic": "وَلَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَlَw", "root": ""}, {"id": 13, "arabic": "تُرْحَمُونَ", "translit": "َnwُmَḥْrُt", "root": "رحم"}], "hasIhya": true}, {"ayah": 64, "text": "فَكَذَّبُوهُ فَأَنجَيْنَٰهُ وَٱلَّذِينَ مَعَهُۥ فِى ٱلْفُلْكِ وَأَغْرَقْنَا ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَآۚ إِنَّهُمْ كَانُوا۟ قَوْمًا عَمِينَ ", "translation": "But they denied him, so We saved him and those who were with him in the ship. And We drowned those who denied Our signs. Indeed, they were a blind people.[1]", "words": [{"id": 1, "arabic": "فَكَذَّبُوهُ", "translit": "ُhwُbَّhdَkَf", "root": "كذب"}, {"id": 2, "arabic": "فَأَنجَيْنَٰهُ", "translit": "ُhَٰnْyَjgnَaʾَf", "root": "نجو"}, {"id": 3, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 4, "arabic": "مَعَهُۥ", "translit": "ۥُhَʿعَm", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلْفُلْكِ", "translit": "ِkْlُfْlٱ", "root": "فلك"}, {"id": 7, "arabic": "وَأَغْرَقْنَا", "translit": "āَnْqَrْغَaʾَw", "root": "غرق"}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 10, "arabic": "بِـَٔايَٰتِنَآ", "translit": "ٓāَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 11, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 12, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 13, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 14, "arabic": "عَمِينَ", "translit": "َnyِmَʿع", "root": "عمي"}], "hasIhya": false}, {"ayah": 65, "text": "وَإِلَىٰ عَادٍ أَخَاهُمْ هُودًاۗ قَالَ يَٰقَوْمِ ٱعْبُدُوا۟ ٱللَّهَ مَا لَكُم مِّنْ إِلَٰهٍ غَيْرُهُۥٓۚ أَفَلَا تَتَّقُونَ ", "translation": "And to the ʿAad [We sent] their brother Hūd. He said, \"O my people, worship Allāh; you have no deity other than Him. Then will you not fear Him?\"", "words": [{"id": 1, "arabic": "وَإِلَىٰ", "translit": "ٰàَlِiʾَw", "root": ""}, {"id": 2, "arabic": "عَادٍ", "translit": "ٍdāَʿع", "root": "عود"}, {"id": 3, "arabic": "أَخَاهُمْ", "translit": "ْmُhāَhkَaʾ", "root": "اخو"}, {"id": 4, "arabic": "هُودًا", "translit": "āًdwُh", "root": "هود"}, {"id": 5, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 6, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 7, "arabic": "ٱعْبُدُوا۟", "translit": "۟āwُdُbْʿعٱ", "root": "عبد"}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 11, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 12, "arabic": "إِلَٰهٍ", "translit": "ٍhَٰlِiʾ", "root": "اله"}, {"id": 13, "arabic": "غَيْرُهُۥٓ", "translit": "ٓۥُhُrْyَغ", "root": "غير"}, {"id": 14, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 15, "arabic": "تَتَّقُونَ", "translit": "َnwُqَّtَt", "root": "وقي"}], "hasIhya": false}, {"ayah": 66, "text": "قَالَ ٱلْمَلَأُ ٱلَّذِينَ كَفَرُوا۟ مِن قَوْمِهِۦٓ إِنَّا لَنَرَىٰكَ فِى سَفَاهَةٍ وَإِنَّا لَنَظُنُّكَ مِنَ ٱلْكَٰذِبِينَ ", "translation": "Said the eminent ones who disbelieved among his people, \"Indeed, we see you in foolishness, and indeed, we think you are of the liars.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱلْمَلَأُ", "translit": "ُaʾَlَmْlٱ", "root": "ملا"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "قَوْمِهِۦٓ", "translit": "ٓۦِhِmْwَq", "root": "قوم"}, {"id": 7, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 8, "arabic": "لَنَرَىٰكَ", "translit": "َkٰàَrَnَl", "root": "راي"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "سَفَاهَةٍ", "translit": "ٍẗَhāَfَs", "root": "سفه"}, {"id": 11, "arabic": "وَإِنَّا", "translit": "āَّnِiʾَw", "root": ""}, {"id": 12, "arabic": "لَنَظُنُّكَ", "translit": "َkُّnُẓَnَl", "root": "ظنن"}, {"id": 13, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 14, "arabic": "ٱلْكَٰذِبِينَ", "translit": "َnyِbِhdَٰkْlٱ", "root": "كذب"}], "hasIhya": false}, {"ayah": 67, "text": "قَالَ يَٰقَوْمِ لَيْسَ بِى سَفَاهَةٌ وَلَٰكِنِّى رَسُولٌ مِّن رَّبِّ ٱلْعَٰلَمِينَ ", "translation": "[Hūd] said, \"O my people, there is not foolishness in me, but I am a messenger from the Lord of the worlds.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 3, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 4, "arabic": "بِى", "translit": "àِb", "root": ""}, {"id": 5, "arabic": "سَفَاهَةٌ", "translit": "ٌẗَhāَfَs", "root": "سفه"}, {"id": 6, "arabic": "وَلَٰكِنِّى", "translit": "àِّnِkَٰlَw", "root": ""}, {"id": 7, "arabic": "رَسُولٌ", "translit": "ٌlwُsَr", "root": "رسل"}, {"id": 8, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 9, "arabic": "رَّبِّ", "translit": "ِّbَّr", "root": "ربب"}, {"id": 10, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 68, "text": "أُبَلِّغُكُمْ رِسَٰلَٰتِ رَبِّى وَأَنَا۠ لَكُمْ نَاصِحٌ أَمِينٌ ", "translation": "I convey to you the messages of my Lord, and I am to you a trustworthy adviser.", "words": [{"id": 1, "arabic": "أُبَلِّغُكُمْ", "translit": "ْmُkُغِّlَbُaʾ", "root": "بلغ"}, {"id": 2, "arabic": "رِسَٰلَٰتِ", "translit": "ِtَٰlَٰsِr", "root": "رسل"}, {"id": 3, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 4, "arabic": "وَأَنَا۠", "translit": "۠āَnَaʾَw", "root": ""}, {"id": 5, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 6, "arabic": "نَاصِحٌ", "translit": "ٌḥِṣāَn", "root": "نصح"}, {"id": 7, "arabic": "أَمِينٌ", "translit": "ٌnyِmَaʾ", "root": "امن"}], "hasIhya": false}, {"ayah": 69, "text": "أَوَعَجِبْتُمْ أَن جَآءَكُمْ ذِكْرٌ مِّن رَّبِّكُمْ عَلَىٰ رَجُلٍ مِّنكُمْ لِيُنذِرَكُمْۚ وَٱذْكُرُوٓا۟ إِذْ جَعَلَكُمْ خُلَفَآءَ مِنۢ بَعْدِ قَوْمِ نُوحٍ وَزَادَكُمْ فِى ٱلْخَلْقِ بَصْۜطَةًۖ فَٱذْكُرُوٓا۟ ءَالَآءَ ٱللَّهِ لَعَلَّكُمْ تُفْلِحُونَ ", "translation": "Then do you wonder that there has come to you a reminder from your Lord through a man from among you, that he may warn you? And remember when He made you successors after the people of Noah and increased you in stature extensively. So remember the favors of Allāh that you might succeed.\"", "words": [{"id": 1, "arabic": "أَوَعَجِبْتُمْ", "translit": "ْmُtْbِjgَʿعَwَaʾ", "root": "عجب"}, {"id": 2, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 3, "arabic": "جَآءَكُمْ", "translit": "ْmُkَءٓāَjg", "root": "جيا"}, {"id": 4, "arabic": "ذِكْرٌ", "translit": "ٌrْkِhd", "root": "ذكر"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 7, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 8, "arabic": "رَجُلٍ", "translit": "ٍlُjgَr", "root": "رجل"}, {"id": 9, "arabic": "مِّنكُمْ", "translit": "ْmُknِّm", "root": ""}, {"id": 10, "arabic": "لِيُنذِرَكُمْ", "translit": "ْmُkَrِhdnُyِl", "root": "نذر"}, {"id": 11, "arabic": "وَٱذْكُرُوٓا۟", "translit": "۟āٓwُrُkْhdٱَw", "root": "ذكر"}, {"id": 12, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 13, "arabic": "جَعَلَكُمْ", "translit": "ْmُkَlَʿعَjg", "root": "جعل"}, {"id": 14, "arabic": "خُلَفَآءَ", "translit": "َءٓāَfَlُhk", "root": "خلف"}, {"id": 15, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 16, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 17, "arabic": "قَوْمِ", "translit": "ِmْwَq", "root": "قوم"}, {"id": 18, "arabic": "نُوحٍ", "translit": "ٍḥwُn", "root": ""}, {"id": 19, "arabic": "وَزَادَكُمْ", "translit": "ْmُkَdāَzَw", "root": "زيد"}, {"id": 20, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 21, "arabic": "ٱلْخَلْقِ", "translit": "ِqْlَhkْlٱ", "root": "خلق"}, {"id": 22, "arabic": "بَصْۜطَةً", "translit": "ًẗَṭْۜṣَb", "root": "بسط"}, {"id": 23, "arabic": "فَٱذْكُرُوٓا۟", "translit": "۟āٓwُrُkْhdٱَf", "root": "ذكر"}, {"id": 24, "arabic": "ءَالَآءَ", "translit": "َءٓāَlāَء", "root": "الو"}, {"id": 25, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 27, "arabic": "تُفْلِحُونَ", "translit": "َnwُḥِlْfُt", "root": "فلح"}], "hasIhya": true}, {"ayah": 70, "text": "قَالُوٓا۟ أَجِئْتَنَا لِنَعْبُدَ ٱللَّهَ وَحْدَهُۥ وَنَذَرَ مَا كَانَ يَعْبُدُ ءَابَآؤُنَاۖ فَأْتِنَا بِمَا تَعِدُنَآ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ ", "translation": "They said, \"Have you come to us that we should worship Allāh alone and leave what our fathers have worshipped? Then bring us what you promise us,[1] if you should be of the truthful.\"", "words": [{"id": 1, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 2, "arabic": "أَجِئْتَنَا", "translit": "āَnَtْyʾِjgَaʾ", "root": "جيا"}, {"id": 3, "arabic": "لِنَعْبُدَ", "translit": "َdُbْʿعَnِl", "root": "عبد"}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَحْدَهُۥ", "translit": "ۥُhَdْḥَw", "root": "وحد"}, {"id": 6, "arabic": "وَنَذَرَ", "translit": "َrَhdَnَw", "root": "وذر"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 9, "arabic": "يَعْبُدُ", "translit": "ُdُbْʿعَy", "root": "عبد"}, {"id": 10, "arabic": "ءَابَآؤُنَا", "translit": "āَnُwʾٓāَbāَء", "root": "ابو"}, {"id": 11, "arabic": "فَأْتِنَا", "translit": "āَnِtْaʾَf", "root": "اتي"}, {"id": 12, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 13, "arabic": "تَعِدُنَآ", "translit": "ٓāَnُdِʿعَt", "root": "وعد"}, {"id": 14, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 15, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 16, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 17, "arabic": "ٱلصَّٰدِقِينَ", "translit": "َnyِqِdَّٰṣlٱ", "root": "صدق"}], "hasIhya": false}, {"ayah": 71, "text": "قَالَ قَدْ وَقَعَ عَلَيْكُم مِّن رَّبِّكُمْ رِجْسٌ وَغَضَبٌۖ أَتُجَٰدِلُونَنِى فِىٓ أَسْمَآءٍ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّا نَزَّلَ ٱللَّهُ بِهَا مِن سُلْطَٰنٍۚ فَٱنتَظِرُوٓا۟ إِنِّى مَعَكُم مِّنَ ٱلْمُنتَظِرِينَ ", "translation": "[Hūd] said, \"Already have defilement and anger fallen upon you from your Lord. Do you dispute with me concerning [mere] names you have named them,[1] you and your fathers, for which Allāh has not sent down any authority? Then wait; indeed, I am with you among those who wait.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 3, "arabic": "وَقَعَ", "translit": "َʿعَqَw", "root": "وقع"}, {"id": 4, "arabic": "عَلَيْكُم", "translit": "mُkْyَlَʿع", "root": ""}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 7, "arabic": "رِجْسٌ", "translit": "ٌsْjgِr", "root": "رجس"}, {"id": 8, "arabic": "وَغَضَبٌ", "translit": "ٌbَḍَغَw", "root": "غضب"}, {"id": 9, "arabic": "أَتُجَٰدِلُونَنِى", "translit": "àِnَnwُlِdَٰjgُtَaʾ", "root": "جدل"}, {"id": 10, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 11, "arabic": "أَسْمَآءٍ", "translit": "ٍءٓāَmْsَaʾ", "root": "سمو"}, {"id": 12, "arabic": "سَمَّيْتُمُوهَآ", "translit": "ٓāَhwُmُtْyَّmَs", "root": "سمو"}, {"id": 13, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 14, "arabic": "وَءَابَآؤُكُم", "translit": "mُkُwʾٓāَbāَءَw", "root": "ابو"}, {"id": 15, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 16, "arabic": "نَزَّلَ", "translit": "َlَّzَn", "root": "نزل"}, {"id": 17, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 19, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 20, "arabic": "سُلْطَٰنٍ", "translit": "ٍnَٰṭْlُs", "root": "سلط"}, {"id": 21, "arabic": "فَٱنتَظِرُوٓا۟", "translit": "۟āٓwُrِẓَtnٱَf", "root": "نظر"}, {"id": 22, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 23, "arabic": "مَعَكُم", "translit": "mُkَʿعَm", "root": ""}, {"id": 24, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 25, "arabic": "ٱلْمُنتَظِرِينَ", "translit": "َnyِrِẓَtnُmْlٱ", "root": "نظر"}], "hasIhya": false}, {"ayah": 72, "text": "فَأَنجَيْنَٰهُ وَٱلَّذِينَ مَعَهُۥ بِرَحْمَةٍ مِّنَّا وَقَطَعْنَا دَابِرَ ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَاۖ وَمَا كَانُوا۟ مُؤْمِنِينَ ", "translation": "So We saved him and those with him by mercy from Us. And We eliminated those who denied Our signs, and they were not [at all] believers.", "words": [{"id": 1, "arabic": "فَأَنجَيْنَٰهُ", "translit": "ُhَٰnْyَjgnَaʾَf", "root": "نجو"}, {"id": 2, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 3, "arabic": "مَعَهُۥ", "translit": "ۥُhَʿعَm", "root": ""}, {"id": 4, "arabic": "بِرَحْمَةٍ", "translit": "ٍẗَmْḥَrِb", "root": "رحم"}, {"id": 5, "arabic": "مِّنَّا", "translit": "āَّnِّm", "root": ""}, {"id": 6, "arabic": "وَقَطَعْنَا", "translit": "āَnْʿعَṭَqَw", "root": "قطع"}, {"id": 7, "arabic": "دَابِرَ", "translit": "َrِbāَd", "root": "دبر"}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 10, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 11, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 12, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 13, "arabic": "مُؤْمِنِينَ", "translit": "َnyِnِmْwʾُm", "root": "امن"}], "hasIhya": false}, {"ayah": 73, "text": "وَإِلَىٰ ثَمُودَ أَخَاهُمْ صَٰلِحًاۗ قَالَ يَٰقَوْمِ ٱعْبُدُوا۟ ٱللَّهَ مَا لَكُم مِّنْ إِلَٰهٍ غَيْرُهُۥۖ قَدْ جَآءَتْكُم بَيِّنَةٌ مِّن رَّبِّكُمْۖ هَٰذِهِۦ نَاقَةُ ٱللَّهِ لَكُمْ ءَايَةًۖ فَذَرُوهَا تَأْكُلْ فِىٓ أَرْضِ ٱللَّهِۖ وَلَا تَمَسُّوهَا بِسُوٓءٍ فَيَأْخُذَكُمْ عَذَابٌ أَلِيمٌ ", "translation": "And to the Thamūd [We sent] their brother Ṣāliḥ. He said, \"O my people, worship Allāh; you have no deity other than Him. There has come to you clear evidence from your Lord. This is the she-camel of Allāh [sent] to you as a sign. So leave her to eat within Allāh's land and do not touch her with harm, lest there seize you a painful punishment.", "words": [{"id": 1, "arabic": "وَإِلَىٰ", "translit": "ٰàَlِiʾَw", "root": ""}, {"id": 2, "arabic": "ثَمُودَ", "translit": "َdwُmَht", "root": ""}, {"id": 3, "arabic": "أَخَاهُمْ", "translit": "ْmُhāَhkَaʾ", "root": "اخو"}, {"id": 4, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 5, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 6, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 7, "arabic": "ٱعْبُدُوا۟", "translit": "۟āwُdُbْʿعٱ", "root": "عبد"}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 11, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 12, "arabic": "إِلَٰهٍ", "translit": "ٍhَٰlِiʾ", "root": "اله"}, {"id": 13, "arabic": "غَيْرُهُۥ", "translit": "ۥُhُrْyَغ", "root": "غير"}, {"id": 14, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 15, "arabic": "جَآءَتْكُم", "translit": "mُkْtَءٓāَjg", "root": "جيا"}, {"id": 16, "arabic": "بَيِّنَةٌ", "translit": "ٌẗَnِّyَb", "root": "بين"}, {"id": 17, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 18, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 19, "arabic": "هَٰذِهِۦ", "translit": "ۦِhِhdَٰh", "root": ""}, {"id": 20, "arabic": "نَاقَةُ", "translit": "ُẗَqāَn", "root": "نوق"}, {"id": 21, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 23, "arabic": "ءَايَةً", "translit": "ًẗَyāَء", "root": "ايي"}, {"id": 24, "arabic": "فَذَرُوهَا", "translit": "āَhwُrَhdَf", "root": "وذر"}, {"id": 25, "arabic": "تَأْكُلْ", "translit": "ْlُkْaʾَt", "root": "اكل"}, {"id": 26, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 27, "arabic": "أَرْضِ", "translit": "ِḍْrَaʾ", "root": "ارض"}, {"id": 28, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 29, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 30, "arabic": "تَمَسُّوهَا", "translit": "āَhwُّsَmَt", "root": "مسس"}, {"id": 31, "arabic": "بِسُوٓءٍ", "translit": "ٍءٓwُsِb", "root": "سوا"}, {"id": 32, "arabic": "فَيَأْخُذَكُمْ", "translit": "ْmُkَhdُhkْaʾَyَf", "root": "اخذ"}, {"id": 33, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 34, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 74, "text": "وَٱذْكُرُوٓا۟ إِذْ جَعَلَكُمْ خُلَفَآءَ مِنۢ بَعْدِ عَادٍ وَبَوَّأَكُمْ فِى ٱلْأَرْضِ تَتَّخِذُونَ مِن سُهُولِهَا قُصُورًا وَتَنْحِتُونَ ٱلْجِبَالَ بُيُوتًاۖ فَٱذْكُرُوٓا۟ ءَالَآءَ ٱللَّهِ وَلَا تَعْثَوْا۟ فِى ٱلْأَرْضِ مُفْسِدِينَ ", "translation": "And remember when He made you successors after the ʿAad and settled you in the land, [and] you take for yourselves palaces from its plains and carve from the mountains, homes. Then remember the favors of Allāh and do not commit abuse on the earth, spreading corruption.\"", "words": [{"id": 1, "arabic": "وَٱذْكُرُوٓا۟", "translit": "۟āٓwُrُkْhdٱَw", "root": "ذكر"}, {"id": 2, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 3, "arabic": "جَعَلَكُمْ", "translit": "ْmُkَlَʿعَjg", "root": "جعل"}, {"id": 4, "arabic": "خُلَفَآءَ", "translit": "َءٓāَfَlُhk", "root": "خلف"}, {"id": 5, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 6, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 7, "arabic": "عَادٍ", "translit": "ٍdāَʿع", "root": "عود"}, {"id": 8, "arabic": "وَبَوَّأَكُمْ", "translit": "ْmُkَaʾَّwَbَw", "root": "بوا"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 11, "arabic": "تَتَّخِذُونَ", "translit": "َnwُhdِhkَّtَt", "root": "اخذ"}, {"id": 12, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 13, "arabic": "سُهُولِهَا", "translit": "āَhِlwُhُs", "root": "سهل"}, {"id": 14, "arabic": "قُصُورًا", "translit": "āًrwُṣُq", "root": "قصر"}, {"id": 15, "arabic": "وَتَنْحِتُونَ", "translit": "َnwُtِḥْnَtَw", "root": "نحت"}, {"id": 16, "arabic": "ٱلْجِبَالَ", "translit": "َlāَbِjgْlٱ", "root": "جبل"}, {"id": 17, "arabic": "بُيُوتًا", "translit": "āًtwُyُb", "root": "بيت"}, {"id": 18, "arabic": "فَٱذْكُرُوٓا۟", "translit": "۟āٓwُrُkْhdٱَf", "root": "ذكر"}, {"id": 19, "arabic": "ءَالَآءَ", "translit": "َءٓāَlāَء", "root": "الو"}, {"id": 20, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 22, "arabic": "تَعْثَوْا۟", "translit": "۟āْwَhtْʿعَt", "root": "عثو"}, {"id": 23, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 24, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 25, "arabic": "مُفْسِدِينَ", "translit": "َnyِdِsْfُm", "root": "فسد"}], "hasIhya": false}, {"ayah": 75, "text": "قَالَ ٱلْمَلَأُ ٱلَّذِينَ ٱسْتَكْبَرُوا۟ مِن قَوْمِهِۦ لِلَّذِينَ ٱسْتُضْعِفُوا۟ لِمَنْ ءَامَنَ مِنْهُمْ أَتَعْلَمُونَ أَنَّ صَٰلِحًا مُّرْسَلٌ مِّن رَّبِّهِۦۚ قَالُوٓا۟ إِنَّا بِمَآ أُرْسِلَ بِهِۦ مُؤْمِنُونَ ", "translation": "Said the eminent ones who were arrogant among his people to those who were oppressed - to those who believed among them, \"Do you [actually] know that Ṣāliḥ is sent from his Lord?\" They said, \"Indeed we, in that with which he was sent, are believers.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱلْمَلَأُ", "translit": "ُaʾَlَmْlٱ", "root": "ملا"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ٱسْتَكْبَرُوا۟", "translit": "۟āwُrَbْkَtْsٱ", "root": "كبر"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "قَوْمِهِۦ", "translit": "ۦِhِmْwَq", "root": "قوم"}, {"id": 7, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 8, "arabic": "ٱسْتُضْعِفُوا۟", "translit": "۟āwُfِʿعْḍُtْsٱ", "root": "ضعف"}, {"id": 9, "arabic": "لِمَنْ", "translit": "ْnَmِl", "root": ""}, {"id": 10, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 11, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 12, "arabic": "أَتَعْلَمُونَ", "translit": "َnwُmَlْʿعَtَaʾ", "root": "علم"}, {"id": 13, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 14, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 15, "arabic": "مُّرْسَلٌ", "translit": "ٌlَsْrُّm", "root": "رسل"}, {"id": 16, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 17, "arabic": "رَّبِّهِۦ", "translit": "ۦِhِّbَّr", "root": "ربب"}, {"id": 18, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 19, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 20, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 21, "arabic": "أُرْسِلَ", "translit": "َlِsْrُaʾ", "root": "رسل"}, {"id": 22, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 23, "arabic": "مُؤْمِنُونَ", "translit": "َnwُnِmْwʾُm", "root": "امن"}], "hasIhya": true}, {"ayah": 76, "text": "قَالَ ٱلَّذِينَ ٱسْتَكْبَرُوٓا۟ إِنَّا بِٱلَّذِىٓ ءَامَنتُم بِهِۦ كَٰفِرُونَ ", "translation": "Said those who were arrogant, \"Indeed we, in that which you have believed, are disbelievers.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ٱسْتَكْبَرُوٓا۟", "translit": "۟āٓwُrَbْkَtْsٱ", "root": "كبر"}, {"id": 4, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 5, "arabic": "بِٱلَّذِىٓ", "translit": "ٓàِhdَّlٱِb", "root": ""}, {"id": 6, "arabic": "ءَامَنتُم", "translit": "mُtnَmāَء", "root": "امن"}, {"id": 7, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 8, "arabic": "كَٰفِرُونَ", "translit": "َnwُrِfَٰk", "root": "كفر"}], "hasIhya": false}, {"ayah": 77, "text": "فَعَقَرُوا۟ ٱلنَّاقَةَ وَعَتَوْا۟ عَنْ أَمْرِ رَبِّهِمْ وَقَالُوا۟ يَٰصَٰلِحُ ٱئْتِنَا بِمَا تَعِدُنَآ إِن كُنتَ مِنَ ٱلْمُرْسَلِينَ ", "translation": "So they hamstrung the she-camel and were insolent toward the command of their Lord and said, \"O Ṣāliḥ, bring us what you promise us, if you should be of the messengers.\"", "words": [{"id": 1, "arabic": "فَعَقَرُوا۟", "translit": "۟āwُrَqَʿعَf", "root": "عقر"}, {"id": 2, "arabic": "ٱلنَّاقَةَ", "translit": "َẗَqāَّnlٱ", "root": "نوق"}, {"id": 3, "arabic": "وَعَتَوْا۟", "translit": "۟āْwَtَʿعَw", "root": "عتو"}, {"id": 4, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 5, "arabic": "أَمْرِ", "translit": "ِrْmَaʾ", "root": "امر"}, {"id": 6, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 7, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 8, "arabic": "يَٰصَٰلِحُ", "translit": "ُḥِlَٰṣَٰy", "root": "صلح"}, {"id": 9, "arabic": "ٱئْتِنَا", "translit": "āَnِtْyʾٱ", "root": "اتي"}, {"id": 10, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 11, "arabic": "تَعِدُنَآ", "translit": "ٓāَnُdِʿعَt", "root": "وعد"}, {"id": 12, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 13, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 14, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 15, "arabic": "ٱلْمُرْسَلِينَ", "translit": "َnyِlَsْrُmْlٱ", "root": "رسل"}], "hasIhya": false}, {"ayah": 78, "text": "فَأَخَذَتْهُمُ ٱلرَّجْفَةُ فَأَصْبَحُوا۟ فِى دَارِهِمْ جَٰثِمِينَ ", "translation": "So the earthquake seized them, and they became within their home [corpses] fallen prone.", "words": [{"id": 1, "arabic": "فَأَخَذَتْهُمُ", "translit": "ُmُhْtَhdَhkَaʾَf", "root": "اخذ"}, {"id": 2, "arabic": "ٱلرَّجْفَةُ", "translit": "ُẗَfْjgَّrlٱ", "root": "رجف"}, {"id": 3, "arabic": "فَأَصْبَحُوا۟", "translit": "۟āwُḥَbْṣَaʾَf", "root": "صبح"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "دَارِهِمْ", "translit": "ْmِhِrāَd", "root": "دور"}, {"id": 6, "arabic": "جَٰثِمِينَ", "translit": "َnyِmِhtَٰjg", "root": "جثم"}], "hasIhya": false}, {"ayah": 79, "text": "فَتَوَلَّىٰ عَنْهُمْ وَقَالَ يَٰقَوْمِ لَقَدْ أَبْلَغْتُكُمْ رِسَالَةَ رَبِّى وَنَصَحْتُ لَكُمْ وَلَٰكِن لَّا تُحِبُّونَ ٱلنَّٰصِحِينَ ", "translation": "And he [i.e., Ṣāliḥ] turned away from them and said, \"O my people, I had certainly conveyed to you the message of my Lord and advised you, but you do not like advisors.\"", "words": [{"id": 1, "arabic": "فَتَوَلَّىٰ", "translit": "ٰàَّlَwَtَf", "root": "ولي"}, {"id": 2, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 3, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 4, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 5, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 6, "arabic": "أَبْلَغْتُكُمْ", "translit": "ْmُkُtْغَlْbَaʾ", "root": "بلغ"}, {"id": 7, "arabic": "رِسَالَةَ", "translit": "َẗَlāَsِr", "root": "رسل"}, {"id": 8, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 9, "arabic": "وَنَصَحْتُ", "translit": "ُtْḥَṣَnَw", "root": "نصح"}, {"id": 10, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 11, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 12, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 13, "arabic": "تُحِبُّونَ", "translit": "َnwُّbِḥُt", "root": "حبب"}, {"id": 14, "arabic": "ٱلنَّٰصِحِينَ", "translit": "َnyِḥِṣَّٰnlٱ", "root": "نصح"}], "hasIhya": true}, {"ayah": 80, "text": "وَلُوطًا إِذْ قَالَ لِقَوْمِهِۦٓ أَتَأْتُونَ ٱلْفَٰحِشَةَ مَا سَبَقَكُم بِهَا مِنْ أَحَدٍ مِّنَ ٱلْعَٰلَمِينَ ", "translation": "And [We had sent] Lot when he said to his people, \"Do you commit such immorality as no one has preceded you with from among the worlds [i.e., peoples]?", "words": [{"id": 1, "arabic": "وَلُوطًا", "translit": "āًṭwُlَw", "root": ""}, {"id": 2, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 3, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 4, "arabic": "لِقَوْمِهِۦٓ", "translit": "ٓۦِhِmْwَqِl", "root": "قوم"}, {"id": 5, "arabic": "أَتَأْتُونَ", "translit": "َnwُtْaʾَtَaʾ", "root": "اتي"}, {"id": 6, "arabic": "ٱلْفَٰحِشَةَ", "translit": "َẗَhsِḥَٰfْlٱ", "root": "فحش"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "سَبَقَكُم", "translit": "mُkَqَbَs", "root": "سبق"}, {"id": 9, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 10, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 11, "arabic": "أَحَدٍ", "translit": "ٍdَḥَaʾ", "root": "احد"}, {"id": 12, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 13, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 81, "text": "إِنَّكُمْ لَتَأْتُونَ ٱلرِّجَالَ شَهْوَةً مِّن دُونِ ٱلنِّسَآءِۚ بَلْ أَنتُمْ قَوْمٌ مُّسْرِفُونَ ", "translation": "Indeed, you approach men with desire, instead of women. Rather, you are a transgressing people.\"", "words": [{"id": 1, "arabic": "إِنَّكُمْ", "translit": "ْmُkَّnِiʾ", "root": ""}, {"id": 2, "arabic": "لَتَأْتُونَ", "translit": "َnwُtْaʾَtَl", "root": "اتي"}, {"id": 3, "arabic": "ٱلرِّجَالَ", "translit": "َlāَjgِّrlٱ", "root": "رجل"}, {"id": 4, "arabic": "شَهْوَةً", "translit": "ًẗَwْhَhs", "root": "شهو"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 7, "arabic": "ٱلنِّسَآءِ", "translit": "ِءٓāَsِّnlٱ", "root": "نسو"}, {"id": 8, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 9, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 10, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 11, "arabic": "مُّسْرِفُونَ", "translit": "َnwُfِrْsُّm", "root": "سرف"}], "hasIhya": false}, {"ayah": 82, "text": "وَمَا كَانَ جَوَابَ قَوْمِهِۦٓ إِلَّآ أَن قَالُوٓا۟ أَخْرِجُوهُم مِّن قَرْيَتِكُمْۖ إِنَّهُمْ أُنَاسٌ يَتَطَهَّرُونَ ", "translation": "But the answer of his people was only that they said, \"Evict them from your city! Indeed, they are men who keep themselves pure.\"", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "جَوَابَ", "translit": "َbāَwَjg", "root": "جوب"}, {"id": 4, "arabic": "قَوْمِهِۦٓ", "translit": "ٓۦِhِmْwَq", "root": "قوم"}, {"id": 5, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 8, "arabic": "أَخْرِجُوهُم", "translit": "mُhwُjgِrْhkَaʾ", "root": "خرج"}, {"id": 9, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 10, "arabic": "قَرْيَتِكُمْ", "translit": "ْmُkِtَyْrَq", "root": "قري"}, {"id": 11, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 12, "arabic": "أُنَاسٌ", "translit": "ٌsāَnُaʾ", "root": "انس"}, {"id": 13, "arabic": "يَتَطَهَّرُونَ", "translit": "َnwُrَّhَṭَtَy", "root": "طهر"}], "hasIhya": false}, {"ayah": 83, "text": "فَأَنجَيْنَٰهُ وَأَهْلَهُۥٓ إِلَّا ٱمْرَأَتَهُۥ كَانَتْ مِنَ ٱلْغَٰبِرِينَ ", "translation": "So We saved him and his family, except for his wife; she was of those who remained [with the evildoers].", "words": [{"id": 1, "arabic": "فَأَنجَيْنَٰهُ", "translit": "ُhَٰnْyَjgnَaʾَf", "root": "نجو"}, {"id": 2, "arabic": "وَأَهْلَهُۥٓ", "translit": "ٓۥُhَlْhَaʾَw", "root": "اهل"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱمْرَأَتَهُۥ", "translit": "ۥُhَtَaʾَrْmٱ", "root": "مرا"}, {"id": 5, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱلْغَٰبِرِينَ", "translit": "َnyِrِbَٰغْlٱ", "root": "غبر"}], "hasIhya": false}, {"ayah": 84, "text": "وَأَمْطَرْنَا عَلَيْهِم مَّطَرًاۖ فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُجْرِمِينَ ", "translation": "And We rained upon them a rain [of stones]. Then see how was the end of the criminals.", "words": [{"id": 1, "arabic": "وَأَمْطَرْنَا", "translit": "āَnْrَṭْmَaʾَw", "root": "مطر"}, {"id": 2, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "مَّطَرًا", "translit": "āًrَṭَّm", "root": "مطر"}, {"id": 4, "arabic": "فَٱنظُرْ", "translit": "ْrُẓnٱَf", "root": "نظر"}, {"id": 5, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 6, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 7, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 8, "arabic": "ٱلْمُجْرِمِينَ", "translit": "َnyِmِrْjgُmْlٱ", "root": "جرم"}], "hasIhya": false}, {"ayah": 85, "text": "وَإِلَىٰ مَدْيَنَ أَخَاهُمْ شُعَيْبًاۗ قَالَ يَٰقَوْمِ ٱعْبُدُوا۟ ٱللَّهَ مَا لَكُم مِّنْ إِلَٰهٍ غَيْرُهُۥۖ قَدْ جَآءَتْكُم بَيِّنَةٌ مِّن رَّبِّكُمْۖ فَأَوْفُوا۟ ٱلْكَيْلَ وَٱلْمِيزَانَ وَلَا تَبْخَسُوا۟ ٱلنَّاسَ أَشْيَآءَهُمْ وَلَا تُفْسِدُوا۟ فِى ٱلْأَرْضِ بَعْدَ إِصْلَٰحِهَاۚ ذَٰلِكُمْ خَيْرٌ لَّكُمْ إِن كُنتُم مُّؤْمِنِينَ ", "translation": "And to [the people of] Madyan [We sent] their brother Shuʿayb. He said, \"O my people, worship Allāh; you have no deity other than Him. There has come to you clear evidence from your Lord. So fulfill the measure and weight and do not deprive people of their due and cause not corruption upon the earth after its reformation. That is better for you, if you should be believers.", "words": [{"id": 1, "arabic": "وَإِلَىٰ", "translit": "ٰàَlِiʾَw", "root": ""}, {"id": 2, "arabic": "مَدْيَنَ", "translit": "َnَyْdَm", "root": "مدن"}, {"id": 3, "arabic": "أَخَاهُمْ", "translit": "ْmُhāَhkَaʾ", "root": "اخو"}, {"id": 4, "arabic": "شُعَيْبًا", "translit": "āًbْyَʿعُhs", "root": ""}, {"id": 5, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 6, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 7, "arabic": "ٱعْبُدُوا۟", "translit": "۟āwُdُbْʿعٱ", "root": "عبد"}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 11, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 12, "arabic": "إِلَٰهٍ", "translit": "ٍhَٰlِiʾ", "root": "اله"}, {"id": 13, "arabic": "غَيْرُهُۥ", "translit": "ۥُhُrْyَغ", "root": "غير"}, {"id": 14, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 15, "arabic": "جَآءَتْكُم", "translit": "mُkْtَءٓāَjg", "root": "جيا"}, {"id": 16, "arabic": "بَيِّنَةٌ", "translit": "ٌẗَnِّyَb", "root": "بين"}, {"id": 17, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 18, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 19, "arabic": "فَأَوْفُوا۟", "translit": "۟āwُfْwَaʾَf", "root": "وفي"}, {"id": 20, "arabic": "ٱلْكَيْلَ", "translit": "َlْyَkْlٱ", "root": "كيل"}, {"id": 21, "arabic": "وَٱلْمِيزَانَ", "translit": "َnāَzyِmْlٱَw", "root": "وزن"}, {"id": 22, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 23, "arabic": "تَبْخَسُوا۟", "translit": "۟āwُsَhkْbَt", "root": "بخس"}, {"id": 24, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 25, "arabic": "أَشْيَآءَهُمْ", "translit": "ْmُhَءٓāَyْhsَaʾ", "root": "شيا"}, {"id": 26, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 27, "arabic": "تُفْسِدُوا۟", "translit": "۟āwُdِsْfُt", "root": "فسد"}, {"id": 28, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 29, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 30, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 31, "arabic": "إِصْلَٰحِهَا", "translit": "āَhِḥَٰlْṣِiʾ", "root": "صلح"}, {"id": 32, "arabic": "ذَٰلِكُمْ", "translit": "ْmُkِlَٰhd", "root": ""}, {"id": 33, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 34, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 35, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 36, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 37, "arabic": "مُّؤْمِنِينَ", "translit": "َnyِnِmْwʾُّm", "root": "امن"}], "hasIhya": false}, {"ayah": 86, "text": "وَلَا تَقْعُدُوا۟ بِكُلِّ صِرَٰطٍ تُوعِدُونَ وَتَصُدُّونَ عَن سَبِيلِ ٱللَّهِ مَنْ ءَامَنَ بِهِۦ وَتَبْغُونَهَا عِوَجًاۚ وَٱذْكُرُوٓا۟ إِذْ كُنتُمْ قَلِيلًا فَكَثَّرَكُمْۖ وَٱنظُرُوا۟ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُفْسِدِينَ ", "translation": "And do not sit on every path, threatening and averting from the way of Allāh those who believe in Him, seeking to make it [seem] deviant. And remember when you were few and He increased you. And see how was the end of the corrupters.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَقْعُدُوا۟", "translit": "۟āwُdُʿعْqَt", "root": "قعد"}, {"id": 3, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 4, "arabic": "صِرَٰطٍ", "translit": "ٍṭَٰrِṣ", "root": "صرط"}, {"id": 5, "arabic": "تُوعِدُونَ", "translit": "َnwُdِʿعwُt", "root": "وعد"}, {"id": 6, "arabic": "وَتَصُدُّونَ", "translit": "َnwُّdُṣَtَw", "root": "صدد"}, {"id": 7, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 8, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 11, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 12, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 13, "arabic": "وَتَبْغُونَهَا", "translit": "āَhَnwُغْbَtَw", "root": "بغي"}, {"id": 14, "arabic": "عِوَجًا", "translit": "āًjgَwِʿع", "root": "عوج"}, {"id": 15, "arabic": "وَٱذْكُرُوٓا۟", "translit": "۟āٓwُrُkْhdٱَw", "root": "ذكر"}, {"id": 16, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 17, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 18, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 19, "arabic": "فَكَثَّرَكُمْ", "translit": "ْmُkَrَّhtَkَf", "root": "كثر"}, {"id": 20, "arabic": "وَٱنظُرُوا۟", "translit": "۟āwُrُẓnٱَw", "root": "نظر"}, {"id": 21, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 22, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 23, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 24, "arabic": "ٱلْمُفْسِدِينَ", "translit": "َnyِdِsْfُmْlٱ", "root": "فسد"}], "hasIhya": false}, {"ayah": 87, "text": "وَإِن كَانَ طَآئِفَةٌ مِّنكُمْ ءَامَنُوا۟ بِٱلَّذِىٓ أُرْسِلْتُ بِهِۦ وَطَآئِفَةٌ لَّمْ يُؤْمِنُوا۟ فَٱصْبِرُوا۟ حَتَّىٰ يَحْكُمَ ٱللَّهُ بَيْنَنَاۚ وَهُوَ خَيْرُ ٱلْحَٰكِمِينَ ", "translation": "And if there should be a group among you who has believed in that with which I have been sent and a group that has not believed, then be patient until Allāh judges between us. And He is the best of judges.\"", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "طَآئِفَةٌ", "translit": "ٌẗَfِyʾٓāَṭ", "root": "طوف"}, {"id": 4, "arabic": "مِّنكُمْ", "translit": "ْmُknِّm", "root": ""}, {"id": 5, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 6, "arabic": "بِٱلَّذِىٓ", "translit": "ٓàِhdَّlٱِb", "root": ""}, {"id": 7, "arabic": "أُرْسِلْتُ", "translit": "ُtْlِsْrُaʾ", "root": "رسل"}, {"id": 8, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 9, "arabic": "وَطَآئِفَةٌ", "translit": "ٌẗَfِyʾٓāَṭَw", "root": "طوف"}, {"id": 10, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 11, "arabic": "يُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُy", "root": "امن"}, {"id": 12, "arabic": "فَٱصْبِرُوا۟", "translit": "۟āwُrِbْṣٱَf", "root": "صبر"}, {"id": 13, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 14, "arabic": "يَحْكُمَ", "translit": "َmُkْḥَy", "root": "حكم"}, {"id": 15, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "بَيْنَنَا", "translit": "āَnَnْyَb", "root": "بين"}, {"id": 17, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 18, "arabic": "خَيْرُ", "translit": "ُrْyَhk", "root": "خير"}, {"id": 19, "arabic": "ٱلْحَٰكِمِينَ", "translit": "َnyِmِkَٰḥْlٱ", "root": "حكم"}], "hasIhya": true}, {"ayah": 88, "text": "قَالَ ٱلْمَلَأُ ٱلَّذِينَ ٱسْتَكْبَرُوا۟ مِن قَوْمِهِۦ لَنُخْرِجَنَّكَ يَٰشُعَيْبُ وَٱلَّذِينَ ءَامَنُوا۟ مَعَكَ مِن قَرْيَتِنَآ أَوْ لَتَعُودُنَّ فِى مِلَّتِنَاۚ قَالَ أَوَلَوْ كُنَّا كَٰرِهِينَ ", "translation": "Said the eminent ones who were arrogant among his people, \"We will surely evict you, O Shuʿayb, and those who have believed with you from our city, or you must return to our religion.\" He said, \"Even if we were unwilling?", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱلْمَلَأُ", "translit": "ُaʾَlَmْlٱ", "root": "ملا"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ٱسْتَكْبَرُوا۟", "translit": "۟āwُrَbْkَtْsٱ", "root": "كبر"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "قَوْمِهِۦ", "translit": "ۦِhِmْwَq", "root": "قوم"}, {"id": 7, "arabic": "لَنُخْرِجَنَّكَ", "translit": "َkَّnَjgِrْhkُnَl", "root": "خرج"}, {"id": 8, "arabic": "يَٰشُعَيْبُ", "translit": "ُbْyَʿعُhsَٰy", "root": ""}, {"id": 9, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 10, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 11, "arabic": "مَعَكَ", "translit": "َkَʿعَm", "root": ""}, {"id": 12, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 13, "arabic": "قَرْيَتِنَآ", "translit": "ٓāَnِtَyْrَq", "root": "قري"}, {"id": 14, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 15, "arabic": "لَتَعُودُنَّ", "translit": "َّnُdwُʿعَtَl", "root": "عود"}, {"id": 16, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 17, "arabic": "مِلَّتِنَا", "translit": "āَnِtَّlِm", "root": "ملل"}, {"id": 18, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 19, "arabic": "أَوَلَوْ", "translit": "ْwَlَwَaʾ", "root": ""}, {"id": 20, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 21, "arabic": "كَٰرِهِينَ", "translit": "َnyِhِrَٰk", "root": "كره"}], "hasIhya": false}, {"ayah": 89, "text": "قَدِ ٱفْتَرَيْنَا عَلَى ٱللَّهِ كَذِبًا إِنْ عُدْنَا فِى مِلَّتِكُم بَعْدَ إِذْ نَجَّىٰنَا ٱللَّهُ مِنْهَاۚ وَمَا يَكُونُ لَنَآ أَن نَّعُودَ فِيهَآ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّنَاۚ وَسِعَ رَبُّنَا كُلَّ شَىْءٍ عِلْمًاۚ عَلَى ٱللَّهِ تَوَكَّلْنَاۚ رَبَّنَا ٱفْتَحْ بَيْنَنَا وَبَيْنَ قَوْمِنَا بِٱلْحَقِّ وَأَنتَ خَيْرُ ٱلْفَٰتِحِينَ ", "translation": "We would have invented against Allāh a lie if we returned to your religion after Allāh had saved us from it. And it is not for us to return to it except that Allāh, our Lord, should will. Our Lord has encompassed all things in knowledge. Upon Allāh we have relied. Our Lord, decide between us and our people in truth, and You are the best of those who give decision.\"", "words": [{"id": 1, "arabic": "قَدِ", "translit": "ِdَq", "root": ""}, {"id": 2, "arabic": "ٱفْتَرَيْنَا", "translit": "āَnْyَrَtْfٱ", "root": "فري"}, {"id": 3, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "كَذِبًا", "translit": "āًbِhdَk", "root": "كذب"}, {"id": 6, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 7, "arabic": "عُدْنَا", "translit": "āَnْdُʿع", "root": "عود"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "مِلَّتِكُم", "translit": "mُkِtَّlِm", "root": "ملل"}, {"id": 10, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 11, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 12, "arabic": "نَجَّىٰنَا", "translit": "āَnٰàَّjgَn", "root": "نجو"}, {"id": 13, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 15, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 16, "arabic": "يَكُونُ", "translit": "ُnwُkَy", "root": "كون"}, {"id": 17, "arabic": "لَنَآ", "translit": "ٓāَnَl", "root": ""}, {"id": 18, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 19, "arabic": "نَّعُودَ", "translit": "َdwُʿعَّn", "root": "عود"}, {"id": 20, "arabic": "فِيهَآ", "translit": "ٓāَhyِf", "root": ""}, {"id": 21, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 22, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 23, "arabic": "يَشَآءَ", "translit": "َءٓāَhsَy", "root": "شيا"}, {"id": 24, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 25, "arabic": "رَبُّنَا", "translit": "āَnُّbَr", "root": "ربب"}, {"id": 26, "arabic": "وَسِعَ", "translit": "َʿعِsَw", "root": "وسع"}, {"id": 27, "arabic": "رَبُّنَا", "translit": "āَnُّbَr", "root": "ربب"}, {"id": 28, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 29, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 30, "arabic": "عِلْمًا", "translit": "āًmْlِʿع", "root": "علم"}, {"id": 31, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 32, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 33, "arabic": "تَوَكَّلْنَا", "translit": "āَnْlَّkَwَt", "root": "وكل"}, {"id": 34, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 35, "arabic": "ٱفْتَحْ", "translit": "ْḥَtْfٱ", "root": "فتح"}, {"id": 36, "arabic": "بَيْنَنَا", "translit": "āَnَnْyَb", "root": "بين"}, {"id": 37, "arabic": "وَبَيْنَ", "translit": "َnْyَbَw", "root": "بين"}, {"id": 38, "arabic": "قَوْمِنَا", "translit": "āَnِmْwَq", "root": "قوم"}, {"id": 39, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 40, "arabic": "وَأَنتَ", "translit": "َtnَaʾَw", "root": ""}, {"id": 41, "arabic": "خَيْرُ", "translit": "ُrْyَhk", "root": "خير"}, {"id": 42, "arabic": "ٱلْفَٰتِحِينَ", "translit": "َnyِḥِtَٰfْlٱ", "root": "فتح"}], "hasIhya": false}, {"ayah": 90, "text": "وَقَالَ ٱلْمَلَأُ ٱلَّذِينَ كَفَرُوا۟ مِن قَوْمِهِۦ لَئِنِ ٱتَّبَعْتُمْ شُعَيْبًا إِنَّكُمْ إِذًا لَّخَٰسِرُونَ ", "translation": "Said the eminent ones who disbelieved among his people, \"If you should follow Shuʿayb, indeed, you would then be losers.\"", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلْمَلَأُ", "translit": "ُaʾَlَmْlٱ", "root": "ملا"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "قَوْمِهِۦ", "translit": "ۦِhِmْwَq", "root": "قوم"}, {"id": 7, "arabic": "لَئِنِ", "translit": "ِnِyʾَl", "root": ""}, {"id": 8, "arabic": "ٱتَّبَعْتُمْ", "translit": "ْmُtْʿعَbَّtٱ", "root": "تبع"}, {"id": 9, "arabic": "شُعَيْبًا", "translit": "āًbْyَʿعُhs", "root": ""}, {"id": 10, "arabic": "إِنَّكُمْ", "translit": "ْmُkَّnِiʾ", "root": ""}, {"id": 11, "arabic": "إِذًا", "translit": "āًhdِiʾ", "root": ""}, {"id": 12, "arabic": "لَّخَٰسِرُونَ", "translit": "َnwُrِsَٰhkَّl", "root": "خسر"}], "hasIhya": false}, {"ayah": 91, "text": "فَأَخَذَتْهُمُ ٱلرَّجْفَةُ فَأَصْبَحُوا۟ فِى دَارِهِمْ جَٰثِمِينَ ", "translation": "So the earthquake seized them, and they became within their home [corpses] fallen prone.", "words": [{"id": 1, "arabic": "فَأَخَذَتْهُمُ", "translit": "ُmُhْtَhdَhkَaʾَf", "root": "اخذ"}, {"id": 2, "arabic": "ٱلرَّجْفَةُ", "translit": "ُẗَfْjgَّrlٱ", "root": "رجف"}, {"id": 3, "arabic": "فَأَصْبَحُوا۟", "translit": "۟āwُḥَbْṣَaʾَf", "root": "صبح"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "دَارِهِمْ", "translit": "ْmِhِrāَd", "root": "دور"}, {"id": 6, "arabic": "جَٰثِمِينَ", "translit": "َnyِmِhtَٰjg", "root": "جثم"}], "hasIhya": false}, {"ayah": 92, "text": "ٱلَّذِينَ كَذَّبُوا۟ شُعَيْبًا كَأَن لَّمْ يَغْنَوْا۟ فِيهَاۚ ٱلَّذِينَ كَذَّبُوا۟ شُعَيْبًا كَانُوا۟ هُمُ ٱلْخَٰسِرِينَ ", "translation": "Those who denied Shuʿayb - it was as though they had never resided there. Those who denied Shuʿayb - it was they who were the losers.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 3, "arabic": "شُعَيْبًا", "translit": "āًbْyَʿعُhs", "root": ""}, {"id": 4, "arabic": "كَأَن", "translit": "nَaʾَk", "root": ""}, {"id": 5, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 6, "arabic": "يَغْنَوْا۟", "translit": "۟āْwَnْغَy", "root": "غني"}, {"id": 7, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 10, "arabic": "شُعَيْبًا", "translit": "āًbْyَʿعُhs", "root": ""}, {"id": 11, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 12, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 13, "arabic": "ٱلْخَٰسِرِينَ", "translit": "َnyِrِsَٰhkْlٱ", "root": "خسر"}], "hasIhya": false}, {"ayah": 93, "text": "فَتَوَلَّىٰ عَنْهُمْ وَقَالَ يَٰقَوْمِ لَقَدْ أَبْلَغْتُكُمْ رِسَٰلَٰتِ رَبِّى وَنَصَحْتُ لَكُمْۖ فَكَيْفَ ءَاسَىٰ عَلَىٰ قَوْمٍ كَٰفِرِينَ ", "translation": "And he [i.e., Shuʿayb] turned away from them and said, \"O my people, I had certainly conveyed to you the messages of my Lord and advised you, so how could I grieve for a disbelieving people?\"", "words": [{"id": 1, "arabic": "فَتَوَلَّىٰ", "translit": "ٰàَّlَwَtَf", "root": "ولي"}, {"id": 2, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 3, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 4, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 5, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 6, "arabic": "أَبْلَغْتُكُمْ", "translit": "ْmُkُtْغَlْbَaʾ", "root": "بلغ"}, {"id": 7, "arabic": "رِسَٰلَٰتِ", "translit": "ِtَٰlَٰsِr", "root": "رسل"}, {"id": 8, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 9, "arabic": "وَنَصَحْتُ", "translit": "ُtْḥَṣَnَw", "root": "نصح"}, {"id": 10, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 11, "arabic": "فَكَيْفَ", "translit": "َfْyَkَf", "root": "كيف"}, {"id": 12, "arabic": "ءَاسَىٰ", "translit": "ٰàَsāَء", "root": "اسو"}, {"id": 13, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 14, "arabic": "قَوْمٍ", "translit": "ٍmْwَq", "root": "قوم"}, {"id": 15, "arabic": "كَٰفِرِينَ", "translit": "َnyِrِfَٰk", "root": "كفر"}], "hasIhya": false}, {"ayah": 94, "text": "وَمَآ أَرْسَلْنَا فِى قَرْيَةٍ مِّن نَّبِىٍّ إِلَّآ أَخَذْنَآ أَهْلَهَا بِٱلْبَأْسَآءِ وَٱلضَّرَّآءِ لَعَلَّهُمْ يَضَّرَّعُونَ ", "translation": "And We sent to no city a prophet [who was denied] except that We seized its people with poverty and hardship that they might humble themselves [to Allāh].", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "قَرْيَةٍ", "translit": "ٍẗَyْrَq", "root": "قري"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "نَّبِىٍّ", "translit": "ٍّàِbَّn", "root": "نبا"}, {"id": 7, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 8, "arabic": "أَخَذْنَآ", "translit": "ٓāَnْhdَhkَaʾ", "root": "اخذ"}, {"id": 9, "arabic": "أَهْلَهَا", "translit": "āَhَlْhَaʾ", "root": "اهل"}, {"id": 10, "arabic": "بِٱلْبَأْسَآءِ", "translit": "ِءٓāَsْaʾَbْlٱِb", "root": "باس"}, {"id": 11, "arabic": "وَٱلضَّرَّآءِ", "translit": "ِءٓāَّrَّḍlٱَw", "root": "ضرر"}, {"id": 12, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 13, "arabic": "يَضَّرَّعُونَ", "translit": "َnwُʿعَّrَّḍَy", "root": "ضرع"}], "hasIhya": false}, {"ayah": 95, "text": "ثُمَّ بَدَّلْنَا مَكَانَ ٱلسَّيِّئَةِ ٱلْحَسَنَةَ حَتَّىٰ عَفَوا۟ وَّقَالُوا۟ قَدْ مَسَّ ءَابَآءَنَا ٱلضَّرَّآءُ وَٱلسَّرَّآءُ فَأَخَذْنَٰهُم بَغْتَةً وَهُمْ لَا يَشْعُرُونَ ", "translation": "Then We exchanged in place of the bad [condition], good, until they increased [and prospered] and said, \"Our fathers [also] were touched with hardship and ease.\"[1] So We seized them suddenly while they did not perceive.[2]", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "بَدَّلْنَا", "translit": "āَnْlَّdَb", "root": "بدل"}, {"id": 3, "arabic": "مَكَانَ", "translit": "َnāَkَm", "root": "كون"}, {"id": 4, "arabic": "ٱلسَّيِّئَةِ", "translit": "ِẗَyʾِّyَّslٱ", "root": "سوا"}, {"id": 5, "arabic": "ٱلْحَسَنَةَ", "translit": "َẗَnَsَḥْlٱ", "root": "حسن"}, {"id": 6, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 7, "arabic": "عَفَوا۟", "translit": "۟āwَfَʿع", "root": "عفو"}, {"id": 8, "arabic": "وَّقَالُوا۟", "translit": "۟āwُlāَqَّw", "root": "قول"}, {"id": 9, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 10, "arabic": "مَسَّ", "translit": "َّsَm", "root": "مسس"}, {"id": 11, "arabic": "ءَابَآءَنَا", "translit": "āَnَءٓāَbāَء", "root": "ابو"}, {"id": 12, "arabic": "ٱلضَّرَّآءُ", "translit": "ُءٓāَّrَّḍlٱ", "root": "ضرر"}, {"id": 13, "arabic": "وَٱلسَّرَّآءُ", "translit": "ُءٓāَّrَّslٱَw", "root": "سرر"}, {"id": 14, "arabic": "فَأَخَذْنَٰهُم", "translit": "mُhَٰnْhdَhkَaʾَf", "root": "اخذ"}, {"id": 15, "arabic": "بَغْتَةً", "translit": "ًẗَtْغَb", "root": "بغت"}, {"id": 16, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 17, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 18, "arabic": "يَشْعُرُونَ", "translit": "َnwُrُʿعْhsَy", "root": "شعر"}], "hasIhya": true}, {"ayah": 96, "text": "وَلَوْ أَنَّ أَهْلَ ٱلْقُرَىٰٓ ءَامَنُوا۟ وَٱتَّقَوْا۟ لَفَتَحْنَا عَلَيْهِم بَرَكَٰتٍ مِّنَ ٱلسَّمَآءِ وَٱلْأَرْضِ وَلَٰكِن كَذَّبُوا۟ فَأَخَذْنَٰهُم بِمَا كَانُوا۟ يَكْسِبُونَ ", "translation": "And if only the people of the cities had believed and feared Allāh, We would have opened [i.e., bestowed] upon them blessings from the heaven and the earth; but they denied [the messengers], so We seized them for what they were earning.[1]", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 3, "arabic": "أَهْلَ", "translit": "َlْhَaʾ", "root": "اهل"}, {"id": 4, "arabic": "ٱلْقُرَىٰٓ", "translit": "ٰٓàَrُqْlٱ", "root": "قري"}, {"id": 5, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 6, "arabic": "وَٱتَّقَوْا۟", "translit": "۟āْwَqَّtٱَw", "root": "وقي"}, {"id": 7, "arabic": "لَفَتَحْنَا", "translit": "āَnْḥَtَfَl", "root": "فتح"}, {"id": 8, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "بَرَكَٰتٍ", "translit": "ٍtَٰkَrَb", "root": "برك"}, {"id": 10, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 11, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 12, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 13, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 14, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 15, "arabic": "فَأَخَذْنَٰهُم", "translit": "mُhَٰnْhdَhkَaʾَf", "root": "اخذ"}, {"id": 16, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 17, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 18, "arabic": "يَكْسِبُونَ", "translit": "َnwُbِsْkَy", "root": "كسب"}], "hasIhya": false}, {"ayah": 97, "text": "أَفَأَمِنَ أَهْلُ ٱلْقُرَىٰٓ أَن يَأْتِيَهُم بَأْسُنَا بَيَٰتًا وَهُمْ نَآئِمُونَ ", "translation": "Then, did the people of the cities feel secure from Our punishment coming to them at night while they were asleep?", "words": [{"id": 1, "arabic": "أَفَأَمِنَ", "translit": "َnِmَaʾَfَaʾ", "root": "امن"}, {"id": 2, "arabic": "أَهْلُ", "translit": "ُlْhَaʾ", "root": "اهل"}, {"id": 3, "arabic": "ٱلْقُرَىٰٓ", "translit": "ٰٓàَrُqْlٱ", "root": "قري"}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يَأْتِيَهُم", "translit": "mُhَyِtْaʾَy", "root": "اتي"}, {"id": 6, "arabic": "بَأْسُنَا", "translit": "āَnُsْaʾَb", "root": "باس"}, {"id": 7, "arabic": "بَيَٰتًا", "translit": "āًtَٰyَb", "root": "بيت"}, {"id": 8, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 9, "arabic": "نَآئِمُونَ", "translit": "َnwُmِyʾٓāَn", "root": "نوم"}], "hasIhya": false}, {"ayah": 98, "text": "أَوَأَمِنَ أَهْلُ ٱلْقُرَىٰٓ أَن يَأْتِيَهُم بَأْسُنَا ضُحًى وَهُمْ يَلْعَبُونَ ", "translation": "Or did the people of the cities feel secure from Our punishment coming to them in the morning while they were at play?[1]", "words": [{"id": 1, "arabic": "أَوَأَمِنَ", "translit": "َnِmَaʾَwَaʾ", "root": "امن"}, {"id": 2, "arabic": "أَهْلُ", "translit": "ُlْhَaʾ", "root": "اهل"}, {"id": 3, "arabic": "ٱلْقُرَىٰٓ", "translit": "ٰٓàَrُqْlٱ", "root": "قري"}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يَأْتِيَهُم", "translit": "mُhَyِtْaʾَy", "root": "اتي"}, {"id": 6, "arabic": "بَأْسُنَا", "translit": "āَnُsْaʾَb", "root": "باس"}, {"id": 7, "arabic": "ضُحًى", "translit": "àًḥُḍ", "root": "ضحو"}, {"id": 8, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 9, "arabic": "يَلْعَبُونَ", "translit": "َnwُbَʿعْlَy", "root": "لعب"}], "hasIhya": false}, {"ayah": 99, "text": "أَفَأَمِنُوا۟ مَكْرَ ٱللَّهِۚ فَلَا يَأْمَنُ مَكْرَ ٱللَّهِ إِلَّا ٱلْقَوْمُ ٱلْخَٰسِرُونَ ", "translation": "Then, did they feel secure from the plan of Allāh? But no one feels secure from the plan of Allāh except the losing people.", "words": [{"id": 1, "arabic": "أَفَأَمِنُوا۟", "translit": "۟āwُnِmَaʾَfَaʾ", "root": "امن"}, {"id": 2, "arabic": "مَكْرَ", "translit": "َrْkَm", "root": "مكر"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 5, "arabic": "يَأْمَنُ", "translit": "ُnَmْaʾَy", "root": "امن"}, {"id": 6, "arabic": "مَكْرَ", "translit": "َrْkَm", "root": "مكر"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "ٱلْقَوْمُ", "translit": "ُmْwَqْlٱ", "root": "قوم"}, {"id": 10, "arabic": "ٱلْخَٰسِرُونَ", "translit": "َnwُrِsَٰhkْlٱ", "root": "خسر"}], "hasIhya": true}, {"ayah": 100, "text": "أَوَلَمْ يَهْدِ لِلَّذِينَ يَرِثُونَ ٱلْأَرْضَ مِنۢ بَعْدِ أَهْلِهَآ أَن لَّوْ نَشَآءُ أَصَبْنَٰهُم بِذُنُوبِهِمْۚ وَنَطْبَعُ عَلَىٰ قُلُوبِهِمْ فَهُمْ لَا يَسْمَعُونَ ", "translation": "Has it not become clear to those who inherited the earth after its [previous] people that if We willed, We could afflict them for their sins? But We seal over their hearts so they do not hear.[1]", "words": [{"id": 1, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 2, "arabic": "يَهْدِ", "translit": "ِdْhَy", "root": "هدي"}, {"id": 3, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 4, "arabic": "يَرِثُونَ", "translit": "َnwُhtِrَy", "root": "ورث"}, {"id": 5, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 7, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 8, "arabic": "أَهْلِهَآ", "translit": "ٓāَhِlْhَaʾ", "root": "اهل"}, {"id": 9, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 10, "arabic": "لَّوْ", "translit": "ْwَّl", "root": ""}, {"id": 11, "arabic": "نَشَآءُ", "translit": "ُءٓāَhsَn", "root": "شيا"}, {"id": 12, "arabic": "أَصَبْنَٰهُم", "translit": "mُhَٰnْbَṣَaʾ", "root": "صوب"}, {"id": 13, "arabic": "بِذُنُوبِهِمْ", "translit": "ْmِhِbwُnُhdِb", "root": "ذنب"}, {"id": 14, "arabic": "وَنَطْبَعُ", "translit": "ُʿعَbْṭَnَw", "root": "طبع"}, {"id": 15, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 16, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب"}, {"id": 17, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 18, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 19, "arabic": "يَسْمَعُونَ", "translit": "َnwُʿعَmْsَy", "root": "سمع"}], "hasIhya": true}, {"ayah": 101, "text": "تِلْكَ ٱلْقُرَىٰ نَقُصُّ عَلَيْكَ مِنْ أَنۢبَآئِهَاۚ وَلَقَدْ جَآءَتْهُمْ رُسُلُهُم بِٱلْبَيِّنَٰتِ فَمَا كَانُوا۟ لِيُؤْمِنُوا۟ بِمَا كَذَّبُوا۟ مِن قَبْلُۚ كَذَٰلِكَ يَطْبَعُ ٱللَّهُ عَلَىٰ قُلُوبِ ٱلْكَٰفِرِينَ ", "translation": "Those cities - We relate to you, [O Muḥammad], some of their news. And certainly did their messengers come to them with clear proofs, but they were not to believe in that which they had denied before.[1] Thus does Allāh seal over the hearts of the disbelievers.", "words": [{"id": 1, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 2, "arabic": "ٱلْقُرَىٰ", "translit": "ٰàَrُqْlٱ", "root": "قري"}, {"id": 3, "arabic": "نَقُصُّ", "translit": "ُّṣُqَn", "root": "قصص"}, {"id": 4, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 5, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 6, "arabic": "أَنۢبَآئِهَا", "translit": "āَhِyʾٓāَbۢnَaʾ", "root": "نبا"}, {"id": 7, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 8, "arabic": "جَآءَتْهُمْ", "translit": "ْmُhْtَءٓāَjg", "root": "جيا"}, {"id": 9, "arabic": "رُسُلُهُم", "translit": "mُhُlُsُr", "root": "رسل"}, {"id": 10, "arabic": "بِٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱِb", "root": "بين"}, {"id": 11, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 12, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 13, "arabic": "لِيُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُyِl", "root": "امن"}, {"id": 14, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 15, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 16, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 17, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 18, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 19, "arabic": "يَطْبَعُ", "translit": "ُʿعَbْṭَy", "root": "طبع"}, {"id": 20, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 22, "arabic": "قُلُوبِ", "translit": "ِbwُlُq", "root": "قلب"}, {"id": 23, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": false}, {"ayah": 102, "text": "وَمَا وَجَدْنَا لِأَكْثَرِهِم مِّنْ عَهْدٍۖ وَإِن وَجَدْنَآ أَكْثَرَهُمْ لَفَٰسِقِينَ ", "translation": "And We did not find for most of them any covenant;[1] but indeed, We found most of them defiantly disobedient.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "وَجَدْنَا", "translit": "āَnْdَjgَw", "root": "وجد"}, {"id": 3, "arabic": "لِأَكْثَرِهِم", "translit": "mِhِrَhtْkَaʾِl", "root": "كثر"}, {"id": 4, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 5, "arabic": "عَهْدٍ", "translit": "ٍdْhَʿع", "root": "عهد"}, {"id": 6, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 7, "arabic": "وَجَدْنَآ", "translit": "ٓāَnْdَjgَw", "root": "وجد"}, {"id": 8, "arabic": "أَكْثَرَهُمْ", "translit": "ْmُhَrَhtْkَaʾ", "root": "كثر"}, {"id": 9, "arabic": "لَفَٰسِقِينَ", "translit": "َnyِqِsَٰfَl", "root": "فسق"}], "hasIhya": false}, {"ayah": 103, "text": "ثُمَّ بَعَثْنَا مِنۢ بَعْدِهِم مُّوسَىٰ بِـَٔايَٰتِنَآ إِلَىٰ فِرْعَوْنَ وَمَلَإِي۟هِۦ فَظَلَمُوا۟ بِهَاۖ فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُفْسِدِينَ ", "translation": "Then We sent after them Moses with Our signs to Pharaoh and his establishment, but they were unjust toward them.[1] So see how was the end of the corrupters.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "بَعَثْنَا", "translit": "āَnْhtَʿعَb", "root": "بعث"}, {"id": 3, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 4, "arabic": "بَعْدِهِم", "translit": "mِhِdْʿعَb", "root": "بعد"}, {"id": 5, "arabic": "مُّوسَىٰ", "translit": "ٰàَswُّm", "root": ""}, {"id": 6, "arabic": "بِـَٔايَٰتِنَآ", "translit": "ٓāَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 7, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 8, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 9, "arabic": "وَمَلَإِي۟هِۦ", "translit": "ۦِh۟yِiʾَlَmَw", "root": "ملا"}, {"id": 10, "arabic": "فَظَلَمُوا۟", "translit": "۟āwُmَlَẓَf", "root": "ظلم"}, {"id": 11, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 12, "arabic": "فَٱنظُرْ", "translit": "ْrُẓnٱَf", "root": "نظر"}, {"id": 13, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 14, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 15, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 16, "arabic": "ٱلْمُفْسِدِينَ", "translit": "َnyِdِsْfُmْlٱ", "root": "فسد"}], "hasIhya": false}, {"ayah": 104, "text": "وَقَالَ مُوسَىٰ يَٰفِرْعَوْنُ إِنِّى رَسُولٌ مِّن رَّبِّ ٱلْعَٰلَمِينَ ", "translation": "And Moses said, \"O Pharaoh, I am a messenger from the Lord of the worlds", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 3, "arabic": "يَٰفِرْعَوْنُ", "translit": "ُnْwَʿعْrِfَٰy", "root": ""}, {"id": 4, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 5, "arabic": "رَسُولٌ", "translit": "ٌlwُsَr", "root": "رسل"}, {"id": 6, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 7, "arabic": "رَّبِّ", "translit": "ِّbَّr", "root": "ربب"}, {"id": 8, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": true}, {"ayah": 105, "text": "حَقِيقٌ عَلَىٰٓ أَن لَّآ أَقُولَ عَلَى ٱللَّهِ إِلَّا ٱلْحَقَّۚ قَدْ جِئْتُكُم بِبَيِّنَةٍ مِّن رَّبِّكُمْ فَأَرْسِلْ مَعِىَ بَنِىٓ إِسْرَٰٓءِيلَ ", "translation": "[Who is] obligated not to say about Allāh except the truth. I have come to you with clear evidence from your Lord, so send with me the Children of Israel.\"[1]", "words": [{"id": 1, "arabic": "حَقِيقٌ", "translit": "ٌqyِqَḥ", "root": "حقق"}, {"id": 2, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "لَّآ", "translit": "ٓāَّl", "root": ""}, {"id": 5, "arabic": "أَقُولَ", "translit": "َlwُqَaʾ", "root": "قول"}, {"id": 6, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "ٱلْحَقَّ", "translit": "َّqَḥْlٱ", "root": "حقق"}, {"id": 10, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 11, "arabic": "جِئْتُكُم", "translit": "mُkُtْyʾِjg", "root": "جيا"}, {"id": 12, "arabic": "بِبَيِّنَةٍ", "translit": "ٍẗَnِّyَbِb", "root": "بين"}, {"id": 13, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 14, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 15, "arabic": "فَأَرْسِلْ", "translit": "ْlِsْrَaʾَf", "root": "رسل"}, {"id": 16, "arabic": "مَعِىَ", "translit": "َàِʿعَm", "root": ""}, {"id": 17, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 18, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}], "hasIhya": false}, {"ayah": 106, "text": "قَالَ إِن كُنتَ جِئْتَ بِـَٔايَةٍ فَأْتِ بِهَآ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ ", "translation": "[Pharaoh] said, \"If you have come with a sign, then bring it forth, if you should be of the truthful.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 3, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 4, "arabic": "جِئْتَ", "translit": "َtْyʾِjg", "root": "جيا"}, {"id": 5, "arabic": "بِـَٔايَةٍ", "translit": "ٍẗَyāَٔـِb", "root": "ايي"}, {"id": 6, "arabic": "فَأْتِ", "translit": "ِtْaʾَf", "root": "اتي"}, {"id": 7, "arabic": "بِهَآ", "translit": "ٓāَhِb", "root": ""}, {"id": 8, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 9, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 10, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 11, "arabic": "ٱلصَّٰدِقِينَ", "translit": "َnyِqِdَّٰṣlٱ", "root": "صدق"}], "hasIhya": false}, {"ayah": 107, "text": "فَأَلْقَىٰ عَصَاهُ فَإِذَا هِىَ ثُعْبَانٌ مُّبِينٌ ", "translation": "So he [i.e., Moses] threw his staff, and suddenly it was a serpent, manifest.[1]", "words": [{"id": 1, "arabic": "فَأَلْقَىٰ", "translit": "ٰàَqْlَaʾَf", "root": "لقي"}, {"id": 2, "arabic": "عَصَاهُ", "translit": "ُhāَṣَʿع", "root": "عصو"}, {"id": 3, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 4, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 5, "arabic": "ثُعْبَانٌ", "translit": "ٌnāَbْʿعُht", "root": "ثعب"}, {"id": 6, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 108, "text": "وَنَزَعَ يَدَهُۥ فَإِذَا هِىَ بَيْضَآءُ لِلنَّٰظِرِينَ ", "translation": "And he drew out his hand; thereupon it was white [with radiance] for the observers.", "words": [{"id": 1, "arabic": "وَنَزَعَ", "translit": "َʿعَzَnَw", "root": "نزع"}, {"id": 2, "arabic": "يَدَهُۥ", "translit": "ۥُhَdَy", "root": "يدي"}, {"id": 3, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 4, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 5, "arabic": "بَيْضَآءُ", "translit": "ُءٓāَḍْyَb", "root": "بيض"}, {"id": 6, "arabic": "لِلنَّٰظِرِينَ", "translit": "َnyِrِẓَّٰnlِl", "root": "نظر"}], "hasIhya": false}, {"ayah": 109, "text": "قَالَ ٱلْمَلَأُ مِن قَوْمِ فِرْعَوْنَ إِنَّ هَٰذَا لَسَٰحِرٌ عَلِيمٌ ", "translation": "Said the eminent among the people of Pharaoh, \"Indeed, this is a learned magician", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱلْمَلَأُ", "translit": "ُaʾَlَmْlٱ", "root": "ملا"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "قَوْمِ", "translit": "ِmْwَq", "root": "قوم"}, {"id": 5, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 6, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 7, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 8, "arabic": "لَسَٰحِرٌ", "translit": "ٌrِḥَٰsَl", "root": "سحر"}, {"id": 9, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 110, "text": "يُرِيدُ أَن يُخْرِجَكُم مِّنْ أَرْضِكُمْۖ فَمَاذَا تَأْمُرُونَ ", "translation": "Who wants to expel you from your land [through magic], so what do you instruct?\"", "words": [{"id": 1, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 2, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 3, "arabic": "يُخْرِجَكُم", "translit": "mُkَjgِrْhkُy", "root": "خرج"}, {"id": 4, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 5, "arabic": "أَرْضِكُمْ", "translit": "ْmُkِḍْrَaʾ", "root": "ارض"}, {"id": 6, "arabic": "فَمَاذَا", "translit": "āَhdāَmَf", "root": ""}, {"id": 7, "arabic": "تَأْمُرُونَ", "translit": "َnwُrُmْaʾَt", "root": "امر"}], "hasIhya": false}, {"ayah": 111, "text": "قَالُوٓا۟ أَرْجِهْ وَأَخَاهُ وَأَرْسِلْ فِى ٱلْمَدَآئِنِ حَٰشِرِينَ ", "translation": "They said,[1] \"Postpone [the matter of] him and his brother and send among the cities gatherers", "words": [{"id": 1, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 2, "arabic": "أَرْجِهْ", "translit": "ْhِjgْrَaʾ", "root": "رجو"}, {"id": 3, "arabic": "وَأَخَاهُ", "translit": "ُhāَhkَaʾَw", "root": "اخو"}, {"id": 4, "arabic": "وَأَرْسِلْ", "translit": "ْlِsْrَaʾَw", "root": "رسل"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلْمَدَآئِنِ", "translit": "ِnِyʾٓāَdَmْlٱ", "root": "مدن"}, {"id": 7, "arabic": "حَٰشِرِينَ", "translit": "َnyِrِhsَٰḥ", "root": "حشر"}], "hasIhya": false}, {"ayah": 112, "text": "يَأْتُوكَ بِكُلِّ سَٰحِرٍ عَلِيمٍ ", "translation": "Who will bring you every learned magician.\"", "words": [{"id": 1, "arabic": "يَأْتُوكَ", "translit": "َkwُtْaʾَy", "root": "اتي"}, {"id": 2, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 3, "arabic": "سَٰحِرٍ", "translit": "ٍrِḥَٰs", "root": "سحر"}, {"id": 4, "arabic": "عَلِيمٍ", "translit": "ٍmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 113, "text": "وَجَآءَ ٱلسَّحَرَةُ فِرْعَوْنَ قَالُوٓا۟ إِنَّ لَنَا لَأَجْرًا إِن كُنَّا نَحْنُ ٱلْغَٰلِبِينَ ", "translation": "And the magicians came to Pharaoh. They said, \"Indeed for us is a reward if we are the predominant.\"", "words": [{"id": 1, "arabic": "وَجَآءَ", "translit": "َءٓāَjgَw", "root": "جيا"}, {"id": 2, "arabic": "ٱلسَّحَرَةُ", "translit": "ُẗَrَḥَّslٱ", "root": "سحر"}, {"id": 3, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 4, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 5, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 6, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 7, "arabic": "لَأَجْرًا", "translit": "āًrْjgَaʾَl", "root": "اجر"}, {"id": 8, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 9, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 10, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 11, "arabic": "ٱلْغَٰلِبِينَ", "translit": "َnyِbِlَٰغْlٱ", "root": "غلب"}], "hasIhya": false}, {"ayah": 114, "text": "قَالَ نَعَمْ وَإِنَّكُمْ لَمِنَ ٱلْمُقَرَّبِينَ ", "translation": "He said, \"Yes, and, [moreover], you will be among those made near [to me].\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "نَعَمْ", "translit": "ْmَʿعَn", "root": ""}, {"id": 3, "arabic": "وَإِنَّكُمْ", "translit": "ْmُkَّnِiʾَw", "root": ""}, {"id": 4, "arabic": "لَمِنَ", "translit": "َnِmَl", "root": ""}, {"id": 5, "arabic": "ٱلْمُقَرَّبِينَ", "translit": "َnyِbَّrَqُmْlٱ", "root": "قرب"}], "hasIhya": false}, {"ayah": 115, "text": "قَالُوا۟ يَٰمُوسَىٰٓ إِمَّآ أَن تُلْقِىَ وَإِمَّآ أَن نَّكُونَ نَحْنُ ٱلْمُلْقِينَ ", "translation": "They said, \"O Moses, either you throw [your staff], or we will be the ones to throw [first].\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰمُوسَىٰٓ", "translit": "ٰٓàَswُmَٰy", "root": ""}, {"id": 3, "arabic": "إِمَّآ", "translit": "ٓāَّmِiʾ", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "تُلْقِىَ", "translit": "َàِqْlُt", "root": "لقي"}, {"id": 6, "arabic": "وَإِمَّآ", "translit": "ٓāَّmِiʾَw", "root": ""}, {"id": 7, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 8, "arabic": "نَّكُونَ", "translit": "َnwُkَّn", "root": "كون"}, {"id": 9, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 10, "arabic": "ٱلْمُلْقِينَ", "translit": "َnyِqْlُmْlٱ", "root": "لقي"}], "hasIhya": false}, {"ayah": 116, "text": "قَالَ أَلْقُوا۟ۖ فَلَمَّآ أَلْقَوْا۟ سَحَرُوٓا۟ أَعْيُنَ ٱلنَّاسِ وَٱسْتَرْهَبُوهُمْ وَجَآءُو بِسِحْرٍ عَظِيمٍ ", "translation": "He said, \"Throw,\" and when they threw, they bewitched the eyes of the people and struck terror into them, and they presented a great [feat of] magic.[1]", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "أَلْقُوا۟", "translit": "۟āwُqْlَaʾ", "root": "لقي"}, {"id": 3, "arabic": "فَلَمَّآ", "translit": "ٓāَّmَlَf", "root": ""}, {"id": 4, "arabic": "أَلْقَوْا۟", "translit": "۟āْwَqْlَaʾ", "root": "لقي"}, {"id": 5, "arabic": "سَحَرُوٓا۟", "translit": "۟āٓwُrَḥَs", "root": "سحر"}, {"id": 6, "arabic": "أَعْيُنَ", "translit": "َnُyْʿعَaʾ", "root": "عين"}, {"id": 7, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 8, "arabic": "وَٱسْتَرْهَبُوهُمْ", "translit": "ْmُhwُbَhْrَtْsٱَw", "root": "رهب"}, {"id": 9, "arabic": "وَجَآءُو", "translit": "wُءٓāَjgَw", "root": "جيا"}, {"id": 10, "arabic": "بِسِحْرٍ", "translit": "ٍrْḥِsِb", "root": "سحر"}, {"id": 11, "arabic": "عَظِيمٍ", "translit": "ٍmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 117, "text": "وَأَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ أَنْ أَلْقِ عَصَاكَۖ فَإِذَا هِىَ تَلْقَفُ مَا يَأْفِكُونَ ", "translation": "And We inspired to Moses, \"Throw your staff,\" and at once it devoured what they were falsifying.", "words": [{"id": 1, "arabic": "وَأَوْحَيْنَآ", "translit": "ٓāَnْyَḥْwَaʾَw", "root": "وحي"}, {"id": 2, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 3, "arabic": "مُوسَىٰٓ", "translit": "ٰٓàَswُm", "root": ""}, {"id": 4, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 5, "arabic": "أَلْقِ", "translit": "ِqْlَaʾ", "root": "لقي"}, {"id": 6, "arabic": "عَصَاكَ", "translit": "َkāَṣَʿع", "root": "عصو"}, {"id": 7, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 8, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 9, "arabic": "تَلْقَفُ", "translit": "ُfَqْlَt", "root": "لقف"}, {"id": 10, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 11, "arabic": "يَأْفِكُونَ", "translit": "َnwُkِfْaʾَy", "root": "افك"}], "hasIhya": false}, {"ayah": 118, "text": "فَوَقَعَ ٱلْحَقُّ وَبَطَلَ مَا كَانُوا۟ يَعْمَلُونَ ", "translation": "So the truth was established, and abolished was what they were doing.", "words": [{"id": 1, "arabic": "فَوَقَعَ", "translit": "َʿعَqَwَf", "root": "وقع"}, {"id": 2, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 3, "arabic": "وَبَطَلَ", "translit": "َlَṭَbَw", "root": "بطل"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 6, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 119, "text": "فَغُلِبُوا۟ هُنَالِكَ وَٱنقَلَبُوا۟ صَٰغِرِينَ ", "translation": "And they [i.e., Pharaoh and his people] were overcome right there and became debased.", "words": [{"id": 1, "arabic": "فَغُلِبُوا۟", "translit": "۟āwُbِlُغَf", "root": "غلب"}, {"id": 2, "arabic": "هُنَالِكَ", "translit": "َkِlāَnُh", "root": ""}, {"id": 3, "arabic": "وَٱنقَلَبُوا۟", "translit": "۟āwُbَlَqnٱَw", "root": "قلب"}, {"id": 4, "arabic": "صَٰغِرِينَ", "translit": "َnyِrِغَٰṣ", "root": "صغر"}], "hasIhya": false}, {"ayah": 120, "text": "وَأُلْقِىَ ٱلسَّحَرَةُ سَٰجِدِينَ ", "translation": "And the magicians fell down in prostration [to Allāh].", "words": [{"id": 1, "arabic": "وَأُلْقِىَ", "translit": "َàِqْlُaʾَw", "root": "لقي"}, {"id": 2, "arabic": "ٱلسَّحَرَةُ", "translit": "ُẗَrَḥَّslٱ", "root": "سحر"}, {"id": 3, "arabic": "سَٰجِدِينَ", "translit": "َnyِdِjgَٰs", "root": "سجد"}], "hasIhya": false}, {"ayah": 121, "text": "قَالُوٓا۟ ءَامَنَّا بِرَبِّ ٱلْعَٰلَمِينَ ", "translation": "They said, \"We have believed in the Lord of the worlds,", "words": [{"id": 1, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 2, "arabic": "ءَامَنَّا", "translit": "āَّnَmāَء", "root": "امن"}, {"id": 3, "arabic": "بِرَبِّ", "translit": "ِّbَrِb", "root": "ربب"}, {"id": 4, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 122, "text": "رَبِّ مُوسَىٰ وَهَٰرُونَ ", "translation": "The Lord of Moses and Aaron.\"", "words": [{"id": 1, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 2, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 3, "arabic": "وَهَٰرُونَ", "translit": "َnwُrَٰhَw", "root": ""}], "hasIhya": false}, {"ayah": 123, "text": "قَالَ فِرْعَوْنُ ءَامَنتُم بِهِۦ قَبْلَ أَنْ ءَاذَنَ لَكُمْۖ إِنَّ هَٰذَا لَمَكْرٌ مَّكَرْتُمُوهُ فِى ٱلْمَدِينَةِ لِتُخْرِجُوا۟ مِنْهَآ أَهْلَهَاۖ فَسَوْفَ تَعْلَمُونَ ", "translation": "Said Pharaoh, \"You believed in him[1] before I gave you permission. Indeed, this is a conspiracy which you conspired in the city to expel therefrom its people. But you are going to know.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "فِرْعَوْنُ", "translit": "ُnْwَʿعْrِf", "root": ""}, {"id": 3, "arabic": "ءَامَنتُم", "translit": "mُtnَmāَء", "root": "امن"}, {"id": 4, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 5, "arabic": "قَبْلَ", "translit": "َlْbَq", "root": "قبل"}, {"id": 6, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 7, "arabic": "ءَاذَنَ", "translit": "َnَhdāَء", "root": "اذن"}, {"id": 8, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 9, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 10, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 11, "arabic": "لَمَكْرٌ", "translit": "ٌrْkَmَl", "root": "مكر"}, {"id": 12, "arabic": "مَّكَرْتُمُوهُ", "translit": "ُhwُmُtْrَkَّm", "root": "مكر"}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "ٱلْمَدِينَةِ", "translit": "ِẗَnyِdَmْlٱ", "root": "مدن"}, {"id": 15, "arabic": "لِتُخْرِجُوا۟", "translit": "۟āwُjgِrْhkُtِl", "root": "خرج"}, {"id": 16, "arabic": "مِنْهَآ", "translit": "ٓāَhْnِm", "root": ""}, {"id": 17, "arabic": "أَهْلَهَا", "translit": "āَhَlْhَaʾ", "root": "اهل"}, {"id": 18, "arabic": "فَسَوْفَ", "translit": "َfْwَsَf", "root": ""}, {"id": 19, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": false}, {"ayah": 124, "text": "لَأُقَطِّعَنَّ أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ خِلَٰفٍ ثُمَّ لَأُصَلِّبَنَّكُمْ أَجْمَعِينَ ", "translation": "I will surely cut off your hands and your feet on opposite sides; then I will surely crucify you all.\"", "words": [{"id": 1, "arabic": "لَأُقَطِّعَنَّ", "translit": "َّnَʿعِّṭَqُaʾَl", "root": "قطع"}, {"id": 2, "arabic": "أَيْدِيَكُمْ", "translit": "ْmُkَyِdْyَaʾ", "root": "يدي"}, {"id": 3, "arabic": "وَأَرْجُلَكُم", "translit": "mُkَlُjgْrَaʾَw", "root": "رجل"}, {"id": 4, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 5, "arabic": "خِلَٰفٍ", "translit": "ٍfَٰlِhk", "root": "خلف"}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "لَأُصَلِّبَنَّكُمْ", "translit": "ْmُkَّnَbِّlَṣُaʾَl", "root": "صلب"}, {"id": 8, "arabic": "أَجْمَعِينَ", "translit": "َnyِʿعَmْjgَaʾ", "root": "جمع"}], "hasIhya": true}, {"ayah": 125, "text": "قَالُوٓا۟ إِنَّآ إِلَىٰ رَبِّنَا مُنقَلِبُونَ ", "translation": "They said, \"Indeed, to our Lord we will return.", "words": [{"id": 1, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 2, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 3, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 4, "arabic": "رَبِّنَا", "translit": "āَnِّbَr", "root": "ربب"}, {"id": 5, "arabic": "مُنقَلِبُونَ", "translit": "َnwُbِlَqnُm", "root": "قلب"}], "hasIhya": false}, {"ayah": 126, "text": "وَمَا تَنقِمُ مِنَّآ إِلَّآ أَنْ ءَامَنَّا بِـَٔايَٰتِ رَبِّنَا لَمَّا جَآءَتْنَاۚ رَبَّنَآ أَفْرِغْ عَلَيْنَا صَبْرًا وَتَوَفَّنَا مُسْلِمِينَ ", "translation": "And you do not resent us except because we believed in the signs of our Lord when they came to us. Our Lord, pour upon us patience[1] and let us die as Muslims [in submission to You].\"", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "تَنقِمُ", "translit": "ُmِqnَt", "root": "نقم"}, {"id": 3, "arabic": "مِنَّآ", "translit": "ٓāَّnِm", "root": ""}, {"id": 4, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 5, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 6, "arabic": "ءَامَنَّا", "translit": "āَّnَmāَء", "root": "امن"}, {"id": 7, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 8, "arabic": "رَبِّنَا", "translit": "āَnِّbَr", "root": "ربب"}, {"id": 9, "arabic": "لَمَّا", "translit": "āَّmَl", "root": ""}, {"id": 10, "arabic": "جَآءَتْنَا", "translit": "āَnْtَءٓāَjg", "root": "جيا"}, {"id": 11, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 12, "arabic": "أَفْرِغْ", "translit": "ْغِrْfَaʾ", "root": "فرغ"}, {"id": 13, "arabic": "عَلَيْنَا", "translit": "āَnْyَlَʿع", "root": ""}, {"id": 14, "arabic": "صَبْرًا", "translit": "āًrْbَṣ", "root": "صبر"}, {"id": 15, "arabic": "وَتَوَفَّنَا", "translit": "āَnَّfَwَtَw", "root": "وفي"}, {"id": 16, "arabic": "مُسْلِمِينَ", "translit": "َnyِmِlْsُm", "root": "سلم"}], "hasIhya": true}, {"ayah": 127, "text": "وَقَالَ ٱلْمَلَأُ مِن قَوْمِ فِرْعَوْنَ أَتَذَرُ مُوسَىٰ وَقَوْمَهُۥ لِيُفْسِدُوا۟ فِى ٱلْأَرْضِ وَيَذَرَكَ وَءَالِهَتَكَۚ قَالَ سَنُقَتِّلُ أَبْنَآءَهُمْ وَنَسْتَحْىِۦ نِسَآءَهُمْ وَإِنَّا فَوْقَهُمْ قَٰهِرُونَ ", "translation": "And the eminent among the people of Pharaoh said, \"Will you leave Moses and his people to cause corruption in the land and abandon you and your gods?\" [Pharaoh] said, \"We will kill their sons and keep their women alive; and indeed, we are subjugators over them.\"", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلْمَلَأُ", "translit": "ُaʾَlَmْlٱ", "root": "ملا"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "قَوْمِ", "translit": "ِmْwَq", "root": "قوم"}, {"id": 5, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 6, "arabic": "أَتَذَرُ", "translit": "ُrَhdَtَaʾ", "root": "وذر"}, {"id": 7, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 8, "arabic": "وَقَوْمَهُۥ", "translit": "ۥُhَmْwَqَw", "root": "قوم"}, {"id": 9, "arabic": "لِيُفْسِدُوا۟", "translit": "۟āwُdِsْfُyِl", "root": "فسد"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 12, "arabic": "وَيَذَرَكَ", "translit": "َkَrَhdَyَw", "root": "وذر"}, {"id": 13, "arabic": "وَءَالِهَتَكَ", "translit": "َkَtَhِlāَءَw", "root": "اله"}, {"id": 14, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 15, "arabic": "سَنُقَتِّلُ", "translit": "ُlِّtَqُnَs", "root": "قتل"}, {"id": 16, "arabic": "أَبْنَآءَهُمْ", "translit": "ْmُhَءٓāَnْbَaʾ", "root": "بني"}, {"id": 17, "arabic": "وَنَسْتَحْىِۦ", "translit": "ۦِàْḥَtْsَnَw", "root": "حيي"}, {"id": 18, "arabic": "نِسَآءَهُمْ", "translit": "ْmُhَءٓāَsِn", "root": "نسو"}, {"id": 19, "arabic": "وَإِنَّا", "translit": "āَّnِiʾَw", "root": ""}, {"id": 20, "arabic": "فَوْقَهُمْ", "translit": "ْmُhَqْwَf", "root": "فوق"}, {"id": 21, "arabic": "قَٰهِرُونَ", "translit": "َnwُrِhَٰq", "root": "قهر"}], "hasIhya": false}, {"ayah": 128, "text": "قَالَ مُوسَىٰ لِقَوْمِهِ ٱسْتَعِينُوا۟ بِٱللَّهِ وَٱصْبِرُوٓا۟ۖ إِنَّ ٱلْأَرْضَ لِلَّهِ يُورِثُهَا مَن يَشَآءُ مِنْ عِبَادِهِۦۖ وَٱلْعَٰقِبَةُ لِلْمُتَّقِينَ ", "translation": "Said Moses to his people, \"Seek help through Allāh and be patient. Indeed, the earth belongs to Allāh. He causes to inherit it whom He wills of His servants. And the [best] outcome is for the righteous.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 3, "arabic": "لِقَوْمِهِ", "translit": "ِhِmْwَqِl", "root": "قوم"}, {"id": 4, "arabic": "ٱسْتَعِينُوا۟", "translit": "۟āwُnyِʿعَtْsٱ", "root": "عون"}, {"id": 5, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 6, "arabic": "وَٱصْبِرُوٓا۟", "translit": "۟āٓwُrِbْṣٱَw", "root": "صبر"}, {"id": 7, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 10, "arabic": "يُورِثُهَا", "translit": "āَhُhtِrwُy", "root": "ورث"}, {"id": 11, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 12, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 13, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 14, "arabic": "عِبَادِهِۦ", "translit": "ۦِhِdāَbِʿع", "root": "عبد"}, {"id": 15, "arabic": "وَٱلْعَٰقِبَةُ", "translit": "ُẗَbِqَٰʿعْlٱَw", "root": "عقب"}, {"id": 16, "arabic": "لِلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlِl", "root": "وقي"}], "hasIhya": false}, {"ayah": 129, "text": "قَالُوٓا۟ أُوذِينَا مِن قَبْلِ أَن تَأْتِيَنَا وَمِنۢ بَعْدِ مَا جِئْتَنَاۚ قَالَ عَسَىٰ رَبُّكُمْ أَن يُهْلِكَ عَدُوَّكُمْ وَيَسْتَخْلِفَكُمْ فِى ٱلْأَرْضِ فَيَنظُرَ كَيْفَ تَعْمَلُونَ ", "translation": "They said, \"We have been harmed before you came to us and after you have come to us.\" He said, \"Perhaps your Lord will destroy your enemy and grant you succession in the land and see how you will do.\"", "words": [{"id": 1, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 2, "arabic": "أُوذِينَا", "translit": "āَnyِhdwُaʾ", "root": "اذي"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "قَبْلِ", "translit": "ِlْbَq", "root": "قبل"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "تَأْتِيَنَا", "translit": "āَnَyِtْaʾَt", "root": "اتي"}, {"id": 7, "arabic": "وَمِنۢ", "translit": "ۢnِmَw", "root": ""}, {"id": 8, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "جِئْتَنَا", "translit": "āَnَtْyʾِjg", "root": "جيا"}, {"id": 11, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 12, "arabic": "عَسَىٰ", "translit": "ٰàَsَʿع", "root": "عسي"}, {"id": 13, "arabic": "رَبُّكُمْ", "translit": "ْmُkُّbَr", "root": "ربب"}, {"id": 14, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 15, "arabic": "يُهْلِكَ", "translit": "َkِlْhُy", "root": "هلك"}, {"id": 16, "arabic": "عَدُوَّكُمْ", "translit": "ْmُkَّwُdَʿع", "root": "عدو"}, {"id": 17, "arabic": "وَيَسْتَخْلِفَكُمْ", "translit": "ْmُkَfِlْhkَtْsَyَw", "root": "خلف"}, {"id": 18, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 19, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 20, "arabic": "فَيَنظُرَ", "translit": "َrُẓnَyَf", "root": "نظر"}, {"id": 21, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 22, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 130, "text": "وَلَقَدْ أَخَذْنَآ ءَالَ فِرْعَوْنَ بِٱلسِّنِينَ وَنَقْصٍ مِّنَ ٱلثَّمَرَٰتِ لَعَلَّهُمْ يَذَّكَّرُونَ ", "translation": "And We certainly seized[1] the people of Pharaoh with years of famine and a deficiency in fruits that perhaps they would be reminded.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "أَخَذْنَآ", "translit": "ٓāَnْhdَhkَaʾ", "root": "اخذ"}, {"id": 3, "arabic": "ءَالَ", "translit": "َlāَء", "root": "اول"}, {"id": 4, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 5, "arabic": "بِٱلسِّنِينَ", "translit": "َnyِnِّslٱِb", "root": "سنو"}, {"id": 6, "arabic": "وَنَقْصٍ", "translit": "ٍṣْqَnَw", "root": "نقص"}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلثَّمَرَٰتِ", "translit": "ِtَٰrَmَّhtlٱ", "root": "ثمر"}, {"id": 9, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 10, "arabic": "يَذَّكَّرُونَ", "translit": "َnwُrَّkَّhdَy", "root": "ذكر"}], "hasIhya": false}, {"ayah": 131, "text": "فَإِذَا جَآءَتْهُمُ ٱلْحَسَنَةُ قَالُوا۟ لَنَا هَٰذِهِۦۖ وَإِن تُصِبْهُمْ سَيِّئَةٌ يَطَّيَّرُوا۟ بِمُوسَىٰ وَمَن مَّعَهُۥٓۗ أَلَآ إِنَّمَا طَٰٓئِرُهُمْ عِندَ ٱللَّهِ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ ", "translation": "But when good [i.e., provision] came to them, they said, \"This is ours [by right].\" And if a bad [condition] struck them, they saw an evil omen in Moses and those with him. Unquestionably, their fortune is with Allāh, but most of them do not know.", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 2, "arabic": "جَآءَتْهُمُ", "translit": "ُmُhْtَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "ٱلْحَسَنَةُ", "translit": "ُẗَnَsَḥْlٱ", "root": "حسن"}, {"id": 4, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 5, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 6, "arabic": "هَٰذِهِۦ", "translit": "ۦِhِhdَٰh", "root": ""}, {"id": 7, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 8, "arabic": "تُصِبْهُمْ", "translit": "ْmُhْbِṣُt", "root": "صوب"}, {"id": 9, "arabic": "سَيِّئَةٌ", "translit": "ٌẗَyʾِّyَs", "root": "سوا"}, {"id": 10, "arabic": "يَطَّيَّرُوا۟", "translit": "۟āwُrَّyَّṭَy", "root": "طير"}, {"id": 11, "arabic": "بِمُوسَىٰ", "translit": "ٰàَswُmِb", "root": ""}, {"id": 12, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 13, "arabic": "مَّعَهُۥٓ", "translit": "ٓۥُhَʿعَّm", "root": ""}, {"id": 14, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 15, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 16, "arabic": "طَٰٓئِرُهُمْ", "translit": "ْmُhُrِyʾَٰٓṭ", "root": "طير"}, {"id": 17, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 18, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 20, "arabic": "أَكْثَرَهُمْ", "translit": "ْmُhَrَhtْkَaʾ", "root": "كثر"}, {"id": 21, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 22, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 132, "text": "وَقَالُوا۟ مَهْمَا تَأْتِنَا بِهِۦ مِنْ ءَايَةٍ لِّتَسْحَرَنَا بِهَا فَمَا نَحْنُ لَكَ بِمُؤْمِنِينَ ", "translation": "And they said, \"No matter what sign you bring us with which to bewitch us, we will not be believers in you.\"", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "مَهْمَا", "translit": "āَmْhَm", "root": ""}, {"id": 3, "arabic": "تَأْتِنَا", "translit": "āَnِtْaʾَt", "root": "اتي"}, {"id": 4, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 5, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 6, "arabic": "ءَايَةٍ", "translit": "ٍẗَyāَء", "root": "ايي"}, {"id": 7, "arabic": "لِّتَسْحَرَنَا", "translit": "āَnَrَḥْsَtِّl", "root": "سحر"}, {"id": 8, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 9, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 10, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 11, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 12, "arabic": "بِمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmِb", "root": "امن"}], "hasIhya": false}, {"ayah": 133, "text": "فَأَرْسَلْنَا عَلَيْهِمُ ٱلطُّوفَانَ وَٱلْجَرَادَ وَٱلْقُمَّلَ وَٱلضَّفَادِعَ وَٱلدَّمَ ءَايَٰتٍ مُّفَصَّلَٰتٍ فَٱسْتَكْبَرُوا۟ وَكَانُوا۟ قَوْمًا مُّجْرِمِينَ ", "translation": "So We sent upon them the flood and locusts and lice and frogs and blood as distinct signs, but they were arrogant and were a criminal people.", "words": [{"id": 1, "arabic": "فَأَرْسَلْنَا", "translit": "āَnْlَsْrَaʾَf", "root": "رسل"}, {"id": 2, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلطُّوفَانَ", "translit": "َnāَfwُّṭlٱ", "root": "طوف"}, {"id": 4, "arabic": "وَٱلْجَرَادَ", "translit": "َdāَrَjgْlٱَw", "root": "جرد"}, {"id": 5, "arabic": "وَٱلْقُمَّلَ", "translit": "َlَّmُqْlٱَw", "root": "قمل"}, {"id": 6, "arabic": "وَٱلضَّفَادِعَ", "translit": "َʿعِdāَfَّḍlٱَw", "root": "ضفدع"}, {"id": 7, "arabic": "وَٱلدَّمَ", "translit": "َmَّdlٱَw", "root": "دمو"}, {"id": 8, "arabic": "ءَايَٰتٍ", "translit": "ٍtَٰyāَء", "root": "ايي"}, {"id": 9, "arabic": "مُّفَصَّلَٰتٍ", "translit": "ٍtَٰlَّṣَfُّm", "root": "فصل"}, {"id": 10, "arabic": "فَٱسْتَكْبَرُوا۟", "translit": "۟āwُrَbْkَtْsٱَf", "root": "كبر"}, {"id": 11, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 12, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 13, "arabic": "مُّجْرِمِينَ", "translit": "َnyِmِrْjgُّm", "root": "جرم"}], "hasIhya": false}, {"ayah": 134, "text": "وَلَمَّا وَقَعَ عَلَيْهِمُ ٱلرِّجْزُ قَالُوا۟ يَٰمُوسَى ٱدْعُ لَنَا رَبَّكَ بِمَا عَهِدَ عِندَكَۖ لَئِن كَشَفْتَ عَنَّا ٱلرِّجْزَ لَنُؤْمِنَنَّ لَكَ وَلَنُرْسِلَنَّ مَعَكَ بَنِىٓ إِسْرَٰٓءِيلَ ", "translation": "And when the punishment descended upon them, they said, \"O Moses, invoke for us your Lord by what He has promised you. If you [can] remove the punishment from us, we will surely believe you, and we will send with you the Children of Israel.\"", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 2, "arabic": "وَقَعَ", "translit": "َʿعَqَw", "root": "وقع"}, {"id": 3, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلرِّجْزُ", "translit": "ُzْjgِّrlٱ", "root": "رجز"}, {"id": 5, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 6, "arabic": "يَٰمُوسَى", "translit": "àَswُmَٰy", "root": ""}, {"id": 7, "arabic": "ٱدْعُ", "translit": "ُʿعْdٱ", "root": "دعو"}, {"id": 8, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 9, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 10, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 11, "arabic": "عَهِدَ", "translit": "َdِhَʿع", "root": "عهد"}, {"id": 12, "arabic": "عِندَكَ", "translit": "َkَdnِʿع", "root": "عند"}, {"id": 13, "arabic": "لَئِن", "translit": "nِyʾَl", "root": ""}, {"id": 14, "arabic": "كَشَفْتَ", "translit": "َtْfَhsَk", "root": "كشف"}, {"id": 15, "arabic": "عَنَّا", "translit": "āَّnَʿع", "root": ""}, {"id": 16, "arabic": "ٱلرِّجْزَ", "translit": "َzْjgِّrlٱ", "root": "رجز"}, {"id": 17, "arabic": "لَنُؤْمِنَنَّ", "translit": "َّnَnِmْwʾُnَl", "root": "امن"}, {"id": 18, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 19, "arabic": "وَلَنُرْسِلَنَّ", "translit": "َّnَlِsْrُnَlَw", "root": "رسل"}, {"id": 20, "arabic": "مَعَكَ", "translit": "َkَʿعَm", "root": ""}, {"id": 21, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 22, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}], "hasIhya": false}, {"ayah": 135, "text": "فَلَمَّا كَشَفْنَا عَنْهُمُ ٱلرِّجْزَ إِلَىٰٓ أَجَلٍ هُم بَٰلِغُوهُ إِذَا هُمْ يَنكُثُونَ ", "translation": "But when We removed the punishment from them until a term which they were to reach,[1] then at once they broke their word.", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "كَشَفْنَا", "translit": "āَnْfَhsَk", "root": "كشف"}, {"id": 3, "arabic": "عَنْهُمُ", "translit": "ُmُhْnَʿع", "root": ""}, {"id": 4, "arabic": "ٱلرِّجْزَ", "translit": "َzْjgِّrlٱ", "root": "رجز"}, {"id": 5, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 6, "arabic": "أَجَلٍ", "translit": "ٍlَjgَaʾ", "root": "اجل"}, {"id": 7, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 8, "arabic": "بَٰلِغُوهُ", "translit": "ُhwُغِlَٰb", "root": "بلغ"}, {"id": 9, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 10, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 11, "arabic": "يَنكُثُونَ", "translit": "َnwُhtُknَy", "root": "نكث"}], "hasIhya": false}, {"ayah": 136, "text": "فَٱنتَقَمْنَا مِنْهُمْ فَأَغْرَقْنَٰهُمْ فِى ٱلْيَمِّ بِأَنَّهُمْ كَذَّبُوا۟ بِـَٔايَٰتِنَا وَكَانُوا۟ عَنْهَا غَٰفِلِينَ ", "translation": "So We took retribution from them, and We drowned them in the sea because they denied Our signs and were heedless of them.", "words": [{"id": 1, "arabic": "فَٱنتَقَمْنَا", "translit": "āَnْmَqَtnٱَf", "root": "نقم"}, {"id": 2, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 3, "arabic": "فَأَغْرَقْنَٰهُمْ", "translit": "ْmُhَٰnْqَrْغَaʾَf", "root": "غرق"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْيَمِّ", "translit": "ِّmَyْlٱ", "root": "يمم"}, {"id": 6, "arabic": "بِأَنَّهُمْ", "translit": "ْmُhَّnَaʾِb", "root": ""}, {"id": 7, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 8, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 9, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 10, "arabic": "عَنْهَا", "translit": "āَhْnَʿع", "root": ""}, {"id": 11, "arabic": "غَٰفِلِينَ", "translit": "َnyِlِfَٰغ", "root": "غفل"}], "hasIhya": false}, {"ayah": 137, "text": "وَأَوْرَثْنَا ٱلْقَوْمَ ٱلَّذِينَ كَانُوا۟ يُسْتَضْعَفُونَ مَشَٰرِقَ ٱلْأَرْضِ وَمَغَٰرِبَهَا ٱلَّتِى بَٰرَكْنَا فِيهَاۖ وَتَمَّتْ كَلِمَتُ رَبِّكَ ٱلْحُسْنَىٰ عَلَىٰ بَنِىٓ إِسْرَٰٓءِيلَ بِمَا صَبَرُوا۟ۖ وَدَمَّرْنَا مَا كَانَ يَصْنَعُ فِرْعَوْنُ وَقَوْمُهُۥ وَمَا كَانُوا۟ يَعْرِشُونَ ", "translation": "And We caused the people who had been oppressed to inherit the eastern regions of the land and the western ones, which We had blessed. And the good word [i.e., decree] of your Lord was fulfilled for the Children of Israel because of what they had patiently endured. And We destroyed [all] that Pharaoh and his people were producing and what they had been building.", "words": [{"id": 1, "arabic": "وَأَوْرَثْنَا", "translit": "āَnْhtَrْwَaʾَw", "root": "ورث"}, {"id": 2, "arabic": "ٱلْقَوْمَ", "translit": "َmْwَqْlٱ", "root": "قوم"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 5, "arabic": "يُسْتَضْعَفُونَ", "translit": "َnwُfَʿعْḍَtْsُy", "root": "ضعف"}, {"id": 6, "arabic": "مَشَٰرِقَ", "translit": "َqِrَٰhsَm", "root": "شرق"}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "وَمَغَٰرِبَهَا", "translit": "āَhَbِrَٰغَmَw", "root": "غرب"}, {"id": 9, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 10, "arabic": "بَٰرَكْنَا", "translit": "āَnْkَrَٰb", "root": "برك"}, {"id": 11, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 12, "arabic": "وَتَمَّتْ", "translit": "ْtَّmَtَw", "root": "تمم"}, {"id": 13, "arabic": "كَلِمَتُ", "translit": "ُtَmِlَk", "root": "كلم"}, {"id": 14, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 15, "arabic": "ٱلْحُسْنَىٰ", "translit": "ٰàَnْsُḥْlٱ", "root": "حسن"}, {"id": 16, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 17, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 18, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 19, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 20, "arabic": "صَبَرُوا۟", "translit": "۟āwُrَbَṣ", "root": "صبر"}, {"id": 21, "arabic": "وَدَمَّرْنَا", "translit": "āَnْrَّmَdَw", "root": "دمر"}, {"id": 22, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 23, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 24, "arabic": "يَصْنَعُ", "translit": "ُʿعَnْṣَy", "root": "صنع"}, {"id": 25, "arabic": "فِرْعَوْنُ", "translit": "ُnْwَʿعْrِf", "root": ""}, {"id": 26, "arabic": "وَقَوْمُهُۥ", "translit": "ۥُhُmْwَqَw", "root": "قوم"}, {"id": 27, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 28, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 29, "arabic": "يَعْرِشُونَ", "translit": "َnwُhsِrْʿعَy", "root": "عرش"}], "hasIhya": true}, {"ayah": 138, "text": "وَجَٰوَزْنَا بِبَنِىٓ إِسْرَٰٓءِيلَ ٱلْبَحْرَ فَأَتَوْا۟ عَلَىٰ قَوْمٍ يَعْكُفُونَ عَلَىٰٓ أَصْنَامٍ لَّهُمْۚ قَالُوا۟ يَٰمُوسَى ٱجْعَل لَّنَآ إِلَٰهًا كَمَا لَهُمْ ءَالِهَةٌۚ قَالَ إِنَّكُمْ قَوْمٌ تَجْهَلُونَ ", "translation": "And We took the Children of Israel across the sea; then they came upon a people intent in devotion to [some] idols of theirs. They [the Children of Israel] said, \"O Moses, make for us a god just as they have gods.\" He said, \"Indeed, you are a people behaving ignorantly.", "words": [{"id": 1, "arabic": "وَجَٰوَزْنَا", "translit": "āَnْzَwَٰjgَw", "root": "جوز"}, {"id": 2, "arabic": "بِبَنِىٓ", "translit": "ٓàِnَbِb", "root": "بني"}, {"id": 3, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلْبَحْرَ", "translit": "َrْḥَbْlٱ", "root": "بحر"}, {"id": 5, "arabic": "فَأَتَوْا۟", "translit": "۟āْwَtَaʾَf", "root": "اتي"}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "قَوْمٍ", "translit": "ٍmْwَq", "root": "قوم"}, {"id": 8, "arabic": "يَعْكُفُونَ", "translit": "َnwُfُkْʿعَy", "root": "عكف"}, {"id": 9, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 10, "arabic": "أَصْنَامٍ", "translit": "ٍmāَnْṣَaʾ", "root": "صنم"}, {"id": 11, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 12, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 13, "arabic": "يَٰمُوسَى", "translit": "àَswُmَٰy", "root": ""}, {"id": 14, "arabic": "ٱجْعَل", "translit": "lَʿعْjgٱ", "root": "جعل"}, {"id": 15, "arabic": "لَّنَآ", "translit": "ٓāَnَّl", "root": ""}, {"id": 16, "arabic": "إِلَٰهًا", "translit": "āًhَٰlِiʾ", "root": "اله"}, {"id": 17, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 18, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 19, "arabic": "ءَالِهَةٌ", "translit": "ٌẗَhِlāَء", "root": "اله"}, {"id": 20, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 21, "arabic": "إِنَّكُمْ", "translit": "ْmُkَّnِiʾ", "root": ""}, {"id": 22, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 23, "arabic": "تَجْهَلُونَ", "translit": "َnwُlَhْjgَt", "root": "جهل"}], "hasIhya": false}, {"ayah": 139, "text": "إِنَّ هَٰٓؤُلَآءِ مُتَبَّرٌ مَّا هُمْ فِيهِ وَبَٰطِلٌ مَّا كَانُوا۟ يَعْمَلُونَ ", "translation": "Indeed, those [worshippers] - destroyed is that in which they are [engaged], and worthless is whatever they were doing.\"", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 3, "arabic": "مُتَبَّرٌ", "translit": "ٌrَّbَtُm", "root": "تبر"}, {"id": 4, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 5, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 6, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 7, "arabic": "وَبَٰطِلٌ", "translit": "ٌlِṭَٰbَw", "root": "بطل"}, {"id": 8, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 9, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 10, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 140, "text": "قَالَ أَغَيْرَ ٱللَّهِ أَبْغِيكُمْ إِلَٰهًا وَهُوَ فَضَّلَكُمْ عَلَى ٱلْعَٰلَمِينَ ", "translation": "He said, \"Is it other than Allāh I should desire for you as a god[1] while He has preferred you over the worlds?\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "أَغَيْرَ", "translit": "َrْyَغَaʾ", "root": "غير"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "أَبْغِيكُمْ", "translit": "ْmُkyِغْbَaʾ", "root": "بغي"}, {"id": 5, "arabic": "إِلَٰهًا", "translit": "āًhَٰlِiʾ", "root": "اله"}, {"id": 6, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 7, "arabic": "فَضَّلَكُمْ", "translit": "ْmُkَlَّḍَf", "root": "فضل"}, {"id": 8, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 9, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 141, "text": "وَإِذْ أَنجَيْنَٰكُم مِّنْ ءَالِ فِرْعَوْنَ يَسُومُونَكُمْ سُوٓءَ ٱلْعَذَابِۖ يُقَتِّلُونَ أَبْنَآءَكُمْ وَيَسْتَحْيُونَ نِسَآءَكُمْۚ وَفِى ذَٰلِكُم بَلَآءٌ مِّن رَّبِّكُمْ عَظِيمٌ ", "translation": "And [recall, O Children of Israel], when We saved you from the people of Pharaoh, [who were] afflicting you with the worst torment - killing your sons and keeping your women alive. And in that was a great trial from your Lord.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "أَنجَيْنَٰكُم", "translit": "mُkَٰnْyَjgnَaʾ", "root": "نجو"}, {"id": 3, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 4, "arabic": "ءَالِ", "translit": "ِlāَء", "root": "اول"}, {"id": 5, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 6, "arabic": "يَسُومُونَكُمْ", "translit": "ْmُkَnwُmwُsَy", "root": "سوم"}, {"id": 7, "arabic": "سُوٓءَ", "translit": "َءٓwُs", "root": "سوا"}, {"id": 8, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 9, "arabic": "يُقَتِّلُونَ", "translit": "َnwُlِّtَqُy", "root": "قتل"}, {"id": 10, "arabic": "أَبْنَآءَكُمْ", "translit": "ْmُkَءٓāَnْbَaʾ", "root": "بني"}, {"id": 11, "arabic": "وَيَسْتَحْيُونَ", "translit": "َnwُyْḥَtْsَyَw", "root": "حيي"}, {"id": 12, "arabic": "نِسَآءَكُمْ", "translit": "ْmُkَءٓāَsِn", "root": "نسو"}, {"id": 13, "arabic": "وَفِى", "translit": "àِfَw", "root": ""}, {"id": 14, "arabic": "ذَٰلِكُم", "translit": "mُkِlَٰhd", "root": ""}, {"id": 15, "arabic": "بَلَآءٌ", "translit": "ٌءٓāَlَb", "root": "بلو"}, {"id": 16, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 17, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 18, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 142, "text": "وَوَٰعَدْنَا مُوسَىٰ ثَلَٰثِينَ لَيْلَةً وَأَتْمَمْنَٰهَا بِعَشْرٍ فَتَمَّ مِيقَٰتُ رَبِّهِۦٓ أَرْبَعِينَ لَيْلَةًۚ وَقَالَ مُوسَىٰ لِأَخِيهِ هَٰرُونَ ٱخْلُفْنِى فِى قَوْمِى وَأَصْلِحْ وَلَا تَتَّبِعْ سَبِيلَ ٱلْمُفْسِدِينَ ", "translation": "And We made an appointment with Moses for thirty nights and perfected them by [the addition of] ten; so the term of his Lord was completed as forty nights. And Moses said to his brother Aaron, \"Take my place among my people, do right [by them],[1] and do not follow the way of the corrupters.\"", "words": [{"id": 1, "arabic": "وَوَٰعَدْنَا", "translit": "āَnْdَʿعَٰwَw", "root": "وعد"}, {"id": 2, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 3, "arabic": "ثَلَٰثِينَ", "translit": "َnyِhtَٰlَht", "root": "ثلث"}, {"id": 4, "arabic": "لَيْلَةً", "translit": "ًẗَlْyَl", "root": "ليل"}, {"id": 5, "arabic": "وَأَتْمَمْنَٰهَا", "translit": "āَhَٰnْmَmْtَaʾَw", "root": "تمم"}, {"id": 6, "arabic": "بِعَشْرٍ", "translit": "ٍrْhsَʿعِb", "root": "عشر"}, {"id": 7, "arabic": "فَتَمَّ", "translit": "َّmَtَf", "root": "تمم"}, {"id": 8, "arabic": "مِيقَٰتُ", "translit": "ُtَٰqyِm", "root": "وقت"}, {"id": 9, "arabic": "رَبِّهِۦٓ", "translit": "ٓۦِhِّbَr", "root": "ربب"}, {"id": 10, "arabic": "أَرْبَعِينَ", "translit": "َnyِʿعَbْrَaʾ", "root": "ربع"}, {"id": 11, "arabic": "لَيْلَةً", "translit": "ًẗَlْyَl", "root": "ليل"}, {"id": 12, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 13, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 14, "arabic": "لِأَخِيهِ", "translit": "ِhyِhkَaʾِl", "root": "اخو"}, {"id": 15, "arabic": "هَٰرُونَ", "translit": "َnwُrَٰh", "root": ""}, {"id": 16, "arabic": "ٱخْلُفْنِى", "translit": "àِnْfُlْhkٱ", "root": "خلف"}, {"id": 17, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 18, "arabic": "قَوْمِى", "translit": "àِmْwَq", "root": "قوم"}, {"id": 19, "arabic": "وَأَصْلِحْ", "translit": "ْḥِlْṣَaʾَw", "root": "صلح"}, {"id": 20, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 21, "arabic": "تَتَّبِعْ", "translit": "ْʿعِbَّtَt", "root": "تبع"}, {"id": 22, "arabic": "سَبِيلَ", "translit": "َlyِbَs", "root": "سبل"}, {"id": 23, "arabic": "ٱلْمُفْسِدِينَ", "translit": "َnyِdِsْfُmْlٱ", "root": "فسد"}], "hasIhya": false}, {"ayah": 143, "text": "وَلَمَّا جَآءَ مُوسَىٰ لِمِيقَٰتِنَا وَكَلَّمَهُۥ رَبُّهُۥ قَالَ رَبِّ أَرِنِىٓ أَنظُرْ إِلَيْكَۚ قَالَ لَن تَرَىٰنِى وَلَٰكِنِ ٱنظُرْ إِلَى ٱلْجَبَلِ فَإِنِ ٱسْتَقَرَّ مَكَانَهُۥ فَسَوْفَ تَرَىٰنِىۚ فَلَمَّا تَجَلَّىٰ رَبُّهُۥ لِلْجَبَلِ جَعَلَهُۥ دَكًّا وَخَرَّ مُوسَىٰ صَعِقًاۚ فَلَمَّآ أَفَاقَ قَالَ سُبْحَٰنَكَ تُبْتُ إِلَيْكَ وَأَنَا۠ أَوَّلُ ٱلْمُؤْمِنِينَ ", "translation": "And when Moses arrived at Our appointed time and his Lord spoke to him, he said, \"My Lord, show me [Yourself] that I may look at You.\" [Allāh] said, \"You will not see Me,[1] but look at the mountain; if it should remain in place, then you will see Me.\" But when his Lord appeared to the mountain, He rendered it level,[2] and Moses fell unconscious. And when he awoke, he said, \"Exalted are You! I have repented to You, and I am the first [among my people] of the believers.\"[3]", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 4, "arabic": "لِمِيقَٰتِنَا", "translit": "āَnِtَٰqyِmِl", "root": "وقت"}, {"id": 5, "arabic": "وَكَلَّمَهُۥ", "translit": "ۥُhَmَّlَkَw", "root": "كلم"}, {"id": 6, "arabic": "رَبُّهُۥ", "translit": "ۥُhُّbَr", "root": "ربب"}, {"id": 7, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 8, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 9, "arabic": "أَرِنِىٓ", "translit": "ٓàِnِrَaʾ", "root": "راي"}, {"id": 10, "arabic": "أَنظُرْ", "translit": "ْrُẓnَaʾ", "root": "نظر"}, {"id": 11, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 12, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 13, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 14, "arabic": "تَرَىٰنِى", "translit": "àِnٰàَrَt", "root": "راي"}, {"id": 15, "arabic": "وَلَٰكِنِ", "translit": "ِnِkَٰlَw", "root": ""}, {"id": 16, "arabic": "ٱنظُرْ", "translit": "ْrُẓnٱ", "root": "نظر"}, {"id": 17, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 18, "arabic": "ٱلْجَبَلِ", "translit": "ِlَbَjgْlٱ", "root": "جبل"}, {"id": 19, "arabic": "فَإِنِ", "translit": "ِnِiʾَf", "root": ""}, {"id": 20, "arabic": "ٱسْتَقَرَّ", "translit": "َّrَqَtْsٱ", "root": "قرر"}, {"id": 21, "arabic": "مَكَانَهُۥ", "translit": "ۥُhَnāَkَm", "root": "كون"}, {"id": 22, "arabic": "فَسَوْفَ", "translit": "َfْwَsَf", "root": ""}, {"id": 23, "arabic": "تَرَىٰنِى", "translit": "àِnٰàَrَt", "root": "راي"}, {"id": 24, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 25, "arabic": "تَجَلَّىٰ", "translit": "ٰàَّlَjgَt", "root": "جلو"}, {"id": 26, "arabic": "رَبُّهُۥ", "translit": "ۥُhُّbَr", "root": "ربب"}, {"id": 27, "arabic": "لِلْجَبَلِ", "translit": "ِlَbَjgْlِl", "root": "جبل"}, {"id": 28, "arabic": "جَعَلَهُۥ", "translit": "ۥُhَlَʿعَjg", "root": "جعل"}, {"id": 29, "arabic": "دَكًّا", "translit": "āًّkَd", "root": "دكك"}, {"id": 30, "arabic": "وَخَرَّ", "translit": "َّrَhkَw", "root": "خرر"}, {"id": 31, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 32, "arabic": "صَعِقًا", "translit": "āًqِʿعَṣ", "root": "صعق"}, {"id": 33, "arabic": "فَلَمَّآ", "translit": "ٓāَّmَlَf", "root": ""}, {"id": 34, "arabic": "أَفَاقَ", "translit": "َqāَfَaʾ", "root": "فوق"}, {"id": 35, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 36, "arabic": "سُبْحَٰنَكَ", "translit": "َkَnَٰḥْbُs", "root": "سبح"}, {"id": 37, "arabic": "تُبْتُ", "translit": "ُtْbُt", "root": "توب"}, {"id": 38, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 39, "arabic": "وَأَنَا۠", "translit": "۠āَnَaʾَw", "root": ""}, {"id": 40, "arabic": "أَوَّلُ", "translit": "ُlَّwَaʾ", "root": "اول"}, {"id": 41, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}], "hasIhya": true}, {"ayah": 144, "text": "قَالَ يَٰمُوسَىٰٓ إِنِّى ٱصْطَفَيْتُكَ عَلَى ٱلنَّاسِ بِرِسَٰلَٰتِى وَبِكَلَٰمِى فَخُذْ مَآ ءَاتَيْتُكَ وَكُن مِّنَ ٱلشَّٰكِرِينَ ", "translation": "[Allāh] said, \"O Moses, I have chosen you over the people with My messages and My words [to you]. So take what I have given you and be among the grateful.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰمُوسَىٰٓ", "translit": "ٰٓàَswُmَٰy", "root": ""}, {"id": 3, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 4, "arabic": "ٱصْطَفَيْتُكَ", "translit": "َkُtْyَfَṭْṣٱ", "root": "صفو"}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 7, "arabic": "بِرِسَٰلَٰتِى", "translit": "àِtَٰlَٰsِrِb", "root": "رسل"}, {"id": 8, "arabic": "وَبِكَلَٰمِى", "translit": "àِmَٰlَkِbَw", "root": "كلم"}, {"id": 9, "arabic": "فَخُذْ", "translit": "ْhdُhkَf", "root": "اخذ"}, {"id": 10, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 11, "arabic": "ءَاتَيْتُكَ", "translit": "َkُtْyَtāَء", "root": "اتي"}, {"id": 12, "arabic": "وَكُن", "translit": "nُkَw", "root": "كون"}, {"id": 13, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 14, "arabic": "ٱلشَّٰكِرِينَ", "translit": "َnyِrِkَّٰhslٱ", "root": "شكر"}], "hasIhya": false}, {"ayah": 145, "text": "وَكَتَبْنَا لَهُۥ فِى ٱلْأَلْوَاحِ مِن كُلِّ شَىْءٍ مَّوْعِظَةً وَتَفْصِيلًا لِّكُلِّ شَىْءٍ فَخُذْهَا بِقُوَّةٍ وَأْمُرْ قَوْمَكَ يَأْخُذُوا۟ بِأَحْسَنِهَاۚ سَأُو۟رِيكُمْ دَارَ ٱلْفَٰسِقِينَ ", "translation": "And We wrote for him on the tablets [something] of all things - instruction and explanation for all things, [saying], \"Take them with determination and order your people to take the best of it. I will show you the home of the defiantly disobedient.\"[1]", "words": [{"id": 1, "arabic": "وَكَتَبْنَا", "translit": "āَnْbَtَkَw", "root": "كتب"}, {"id": 2, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْأَلْوَاحِ", "translit": "ِḥāَwْlَaʾْlٱ", "root": "لوح"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 7, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 8, "arabic": "مَّوْعِظَةً", "translit": "ًẗَẓِʿعْwَّm", "root": "وعظ"}, {"id": 9, "arabic": "وَتَفْصِيلًا", "translit": "āًlyِṣْfَtَw", "root": "فصل"}, {"id": 10, "arabic": "لِّكُلِّ", "translit": "ِّlُkِّl", "root": "كلل"}, {"id": 11, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 12, "arabic": "فَخُذْهَا", "translit": "āَhْhdُhkَf", "root": "اخذ"}, {"id": 13, "arabic": "بِقُوَّةٍ", "translit": "ٍẗَّwُqِb", "root": "قوي"}, {"id": 14, "arabic": "وَأْمُرْ", "translit": "ْrُmْaʾَw", "root": "امر"}, {"id": 15, "arabic": "قَوْمَكَ", "translit": "َkَmْwَq", "root": "قوم"}, {"id": 16, "arabic": "يَأْخُذُوا۟", "translit": "۟āwُhdُhkْaʾَy", "root": "اخذ"}, {"id": 17, "arabic": "بِأَحْسَنِهَا", "translit": "āَhِnَsْḥَaʾِb", "root": "حسن"}, {"id": 18, "arabic": "سَأُو۟رِيكُمْ", "translit": "ْmُkyِr۟wُaʾَs", "root": "راي"}, {"id": 19, "arabic": "دَارَ", "translit": "َrāَd", "root": "دور"}, {"id": 20, "arabic": "ٱلْفَٰسِقِينَ", "translit": "َnyِqِsَٰfْlٱ", "root": "فسق"}], "hasIhya": false}, {"ayah": 146, "text": "سَأَصْرِفُ عَنْ ءَايَٰتِىَ ٱلَّذِينَ يَتَكَبَّرُونَ فِى ٱلْأَرْضِ بِغَيْرِ ٱلْحَقِّ وَإِن يَرَوْا۟ كُلَّ ءَايَةٍ لَّا يُؤْمِنُوا۟ بِهَا وَإِن يَرَوْا۟ سَبِيلَ ٱلرُّشْدِ لَا يَتَّخِذُوهُ سَبِيلًا وَإِن يَرَوْا۟ سَبِيلَ ٱلْغَىِّ يَتَّخِذُوهُ سَبِيلًاۚ ذَٰلِكَ بِأَنَّهُمْ كَذَّبُوا۟ بِـَٔايَٰتِنَا وَكَانُوا۟ عَنْهَا غَٰفِلِينَ ", "translation": "I will turn away from My signs those who are arrogant upon the earth without right; and if they should see every sign, they will not believe in it. And if they see the way of consciousness,[1] they will not adopt it as a way; but if they see the way of error, they will adopt it as a way. That is because they have denied Our signs and they were heedless of them.", "words": [{"id": 1, "arabic": "سَأَصْرِفُ", "translit": "ُfِrْṣَaʾَs", "root": "صرف"}, {"id": 2, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 3, "arabic": "ءَايَٰتِىَ", "translit": "َàِtَٰyāَء", "root": "ايي"}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "يَتَكَبَّرُونَ", "translit": "َnwُrَّbَkَtَy", "root": "كبر"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 9, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 10, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 11, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 12, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 13, "arabic": "ءَايَةٍ", "translit": "ٍẗَyāَء", "root": "ايي"}, {"id": 14, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 15, "arabic": "يُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُy", "root": "امن"}, {"id": 16, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 17, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 18, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 19, "arabic": "سَبِيلَ", "translit": "َlyِbَs", "root": "سبل"}, {"id": 20, "arabic": "ٱلرُّشْدِ", "translit": "ِdْhsُّrlٱ", "root": "رشد"}, {"id": 21, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 22, "arabic": "يَتَّخِذُوهُ", "translit": "ُhwُhdِhkَّtَy", "root": "اخذ"}, {"id": 23, "arabic": "سَبِيلًا", "translit": "āًlyِbَs", "root": "سبل"}, {"id": 24, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 25, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 26, "arabic": "سَبِيلَ", "translit": "َlyِbَs", "root": "سبل"}, {"id": 27, "arabic": "ٱلْغَىِّ", "translit": "ِّàَغْlٱ", "root": "غوي"}, {"id": 28, "arabic": "يَتَّخِذُوهُ", "translit": "ُhwُhdِhkَّtَy", "root": "اخذ"}, {"id": 29, "arabic": "سَبِيلًا", "translit": "āًlyِbَs", "root": "سبل"}, {"id": 30, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 31, "arabic": "بِأَنَّهُمْ", "translit": "ْmُhَّnَaʾِb", "root": ""}, {"id": 32, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 33, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 34, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 35, "arabic": "عَنْهَا", "translit": "āَhْnَʿع", "root": ""}, {"id": 36, "arabic": "غَٰفِلِينَ", "translit": "َnyِlِfَٰغ", "root": "غفل"}], "hasIhya": true}, {"ayah": 147, "text": "وَٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَا وَلِقَآءِ ٱلْءَاخِرَةِ حَبِطَتْ أَعْمَٰلُهُمْۚ هَلْ يُجْزَوْنَ إِلَّا مَا كَانُوا۟ يَعْمَلُونَ ", "translation": "Those who denied Our signs and the meeting of the Hereafter - their deeds have become worthless. Are they recompensed except for what they used to do?", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 3, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 4, "arabic": "وَلِقَآءِ", "translit": "ِءٓāَqِlَw", "root": "لقي"}, {"id": 5, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 6, "arabic": "حَبِطَتْ", "translit": "ْtَṭِbَḥ", "root": "حبط"}, {"id": 7, "arabic": "أَعْمَٰلُهُمْ", "translit": "ْmُhُlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 8, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 9, "arabic": "يُجْزَوْنَ", "translit": "َnْwَzْjgُy", "root": "جزي"}, {"id": 10, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 13, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 148, "text": "وَٱتَّخَذَ قَوْمُ مُوسَىٰ مِنۢ بَعْدِهِۦ مِنْ حُلِيِّهِمْ عِجْلًا جَسَدًا لَّهُۥ خُوَارٌۚ أَلَمْ يَرَوْا۟ أَنَّهُۥ لَا يُكَلِّمُهُمْ وَلَا يَهْدِيهِمْ سَبِيلًاۘ ٱتَّخَذُوهُ وَكَانُوا۟ ظَٰلِمِينَ ", "translation": "And the people of Moses made, after [his departure], from their ornaments a calf - an image having a lowing sound. Did they not see that it could neither speak to them nor guide them to a way? They took it [for worship], and they were wrongdoers.", "words": [{"id": 1, "arabic": "وَٱتَّخَذَ", "translit": "َhdَhkَّtٱَw", "root": "اخذ"}, {"id": 2, "arabic": "قَوْمُ", "translit": "ُmْwَq", "root": "قوم"}, {"id": 3, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 4, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 5, "arabic": "بَعْدِهِۦ", "translit": "ۦِhِdْʿعَb", "root": "بعد"}, {"id": 6, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 7, "arabic": "حُلِيِّهِمْ", "translit": "ْmِhِّyِlُḥ", "root": "حلي"}, {"id": 8, "arabic": "عِجْلًا", "translit": "āًlْjgِʿع", "root": "عجل"}, {"id": 9, "arabic": "جَسَدًا", "translit": "āًdَsَjg", "root": "جسد"}, {"id": 10, "arabic": "لَّهُۥ", "translit": "ۥُhَّl", "root": ""}, {"id": 11, "arabic": "خُوَارٌ", "translit": "ٌrāَwُhk", "root": "خور"}, {"id": 12, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 13, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 14, "arabic": "أَنَّهُۥ", "translit": "ۥُhَّnَaʾ", "root": ""}, {"id": 15, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 16, "arabic": "يُكَلِّمُهُمْ", "translit": "ْmُhُmِّlَkُy", "root": "كلم"}, {"id": 17, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 18, "arabic": "يَهْدِيهِمْ", "translit": "ْmِhyِdْhَy", "root": "هدي"}, {"id": 19, "arabic": "سَبِيلًا", "translit": "āًlyِbَs", "root": "سبل"}, {"id": 20, "arabic": "ٱتَّخَذُوهُ", "translit": "ُhwُhdَhkَّtٱ", "root": "اخذ"}, {"id": 21, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 22, "arabic": "ظَٰلِمِينَ", "translit": "َnyِmِlَٰẓ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 149, "text": "وَلَمَّا سُقِطَ فِىٓ أَيْدِيهِمْ وَرَأَوْا۟ أَنَّهُمْ قَدْ ضَلُّوا۟ قَالُوا۟ لَئِن لَّمْ يَرْحَمْنَا رَبُّنَا وَيَغْفِرْ لَنَا لَنَكُونَنَّ مِنَ ٱلْخَٰسِرِينَ ", "translation": "And when regret overcame them[1] and they saw that they had gone astray, they said, \"If our Lord does not have mercy upon us and forgive us, we will surely be among the losers.\"", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 2, "arabic": "سُقِطَ", "translit": "َṭِqُs", "root": "سقط"}, {"id": 3, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 4, "arabic": "أَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾ", "root": "يدي"}, {"id": 5, "arabic": "وَرَأَوْا۟", "translit": "۟āْwَaʾَrَw", "root": "راي"}, {"id": 6, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 7, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 8, "arabic": "ضَلُّوا۟", "translit": "۟āwُّlَḍ", "root": "ضلل"}, {"id": 9, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 10, "arabic": "لَئِن", "translit": "nِyʾَl", "root": ""}, {"id": 11, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 12, "arabic": "يَرْحَمْنَا", "translit": "āَnْmَḥْrَy", "root": "رحم"}, {"id": 13, "arabic": "رَبُّنَا", "translit": "āَnُّbَr", "root": "ربب"}, {"id": 14, "arabic": "وَيَغْفِرْ", "translit": "ْrِfْغَyَw", "root": "غفر"}, {"id": 15, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 16, "arabic": "لَنَكُونَنَّ", "translit": "َّnَnwُkَnَl", "root": "كون"}, {"id": 17, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 18, "arabic": "ٱلْخَٰسِرِينَ", "translit": "َnyِrِsَٰhkْlٱ", "root": "خسر"}], "hasIhya": false}, {"ayah": 150, "text": "وَلَمَّا رَجَعَ مُوسَىٰٓ إِلَىٰ قَوْمِهِۦ غَضْبَٰنَ أَسِفًا قَالَ بِئْسَمَا خَلَفْتُمُونِى مِنۢ بَعْدِىٓۖ أَعَجِلْتُمْ أَمْرَ رَبِّكُمْۖ وَأَلْقَى ٱلْأَلْوَاحَ وَأَخَذَ بِرَأْسِ أَخِيهِ يَجُرُّهُۥٓ إِلَيْهِۚ قَالَ ٱبْنَ أُمَّ إِنَّ ٱلْقَوْمَ ٱسْتَضْعَفُونِى وَكَادُوا۟ يَقْتُلُونَنِى فَلَا تُشْمِتْ بِىَ ٱلْأَعْدَآءَ وَلَا تَجْعَلْنِى مَعَ ٱلْقَوْمِ ٱلظَّٰلِمِينَ ", "translation": "And when Moses returned to his people, angry and grieved, he said, \"How wretched is that by which you have replaced me after [my departure]. Were you impatient over the matter of your Lord?\" And he threw down the tablets and seized his brother by [the hair of] his head, pulling him toward him. [Aaron] said, \"O son of my mother, indeed the people overpowered me and were about to kill me, so let not the enemies rejoice over me[1] and do not place me among the wrongdoing people.\"", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 2, "arabic": "رَجَعَ", "translit": "َʿعَjgَr", "root": "رجع"}, {"id": 3, "arabic": "مُوسَىٰٓ", "translit": "ٰٓàَswُm", "root": ""}, {"id": 4, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 5, "arabic": "قَوْمِهِۦ", "translit": "ۦِhِmْwَq", "root": "قوم"}, {"id": 6, "arabic": "غَضْبَٰنَ", "translit": "َnَٰbْḍَغ", "root": "غضب"}, {"id": 7, "arabic": "أَسِفًا", "translit": "āًfِsَaʾ", "root": "اسف"}, {"id": 8, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 9, "arabic": "بِئْسَمَا", "translit": "āَmَsْyʾِb", "root": "باس"}, {"id": 10, "arabic": "خَلَفْتُمُونِى", "translit": "àِnwُmُtْfَlَhk", "root": "خلف"}, {"id": 11, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 12, "arabic": "بَعْدِىٓ", "translit": "ٓàِdْʿعَb", "root": "بعد"}, {"id": 13, "arabic": "أَعَجِلْتُمْ", "translit": "ْmُtْlِjgَʿعَaʾ", "root": "عجل"}, {"id": 14, "arabic": "أَمْرَ", "translit": "َrْmَaʾ", "root": "امر"}, {"id": 15, "arabic": "رَبِّكُمْ", "translit": "ْmُkِّbَr", "root": "ربب"}, {"id": 16, "arabic": "وَأَلْقَى", "translit": "àَqْlَaʾَw", "root": "لقي"}, {"id": 17, "arabic": "ٱلْأَلْوَاحَ", "translit": "َḥāَwْlَaʾْlٱ", "root": "لوح"}, {"id": 18, "arabic": "وَأَخَذَ", "translit": "َhdَhkَaʾَw", "root": "اخذ"}, {"id": 19, "arabic": "بِرَأْسِ", "translit": "ِsْaʾَrِb", "root": "راس"}, {"id": 20, "arabic": "أَخِيهِ", "translit": "ِhyِhkَaʾ", "root": "اخو"}, {"id": 21, "arabic": "يَجُرُّهُۥٓ", "translit": "ٓۥُhُّrُjgَy", "root": "جرر"}, {"id": 22, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 23, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 24, "arabic": "ٱبْنَ", "translit": "َnْbٱ", "root": "بني"}, {"id": 25, "arabic": "أُمَّ", "translit": "َّmُaʾ", "root": "امم"}, {"id": 26, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 27, "arabic": "ٱلْقَوْمَ", "translit": "َmْwَqْlٱ", "root": "قوم"}, {"id": 28, "arabic": "ٱسْتَضْعَفُونِى", "translit": "àِnwُfَʿعْḍَtْsٱ", "root": "ضعف"}, {"id": 29, "arabic": "وَكَادُوا۟", "translit": "۟āwُdāَkَw", "root": "كود"}, {"id": 30, "arabic": "يَقْتُلُونَنِى", "translit": "àِnَnwُlُtْqَy", "root": "قتل"}, {"id": 31, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 32, "arabic": "تُشْمِتْ", "translit": "ْtِmْhsُt", "root": "شمت"}, {"id": 33, "arabic": "بِىَ", "translit": "َàِb", "root": ""}, {"id": 34, "arabic": "ٱلْأَعْدَآءَ", "translit": "َءٓāَdْʿعَaʾْlٱ", "root": "عدو"}, {"id": 35, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 36, "arabic": "تَجْعَلْنِى", "translit": "àِnْlَʿعْjgَt", "root": "جعل"}, {"id": 37, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 38, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 39, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 151, "text": "قَالَ رَبِّ ٱغْفِرْ لِى وَلِأَخِى وَأَدْخِلْنَا فِى رَحْمَتِكَۖ وَأَنتَ أَرْحَمُ ٱلرَّٰحِمِينَ ", "translation": "[Moses] said, \"My Lord, forgive me and my brother and admit us into Your mercy, for You are the most merciful of the merciful.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 3, "arabic": "ٱغْفِرْ", "translit": "ْrِfْغٱ", "root": "غفر"}, {"id": 4, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 5, "arabic": "وَلِأَخِى", "translit": "àِhkَaʾِlَw", "root": "اخو"}, {"id": 6, "arabic": "وَأَدْخِلْنَا", "translit": "āَnْlِhkْdَaʾَw", "root": "دخل"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "رَحْمَتِكَ", "translit": "َkِtَmْḥَr", "root": "رحم"}, {"id": 9, "arabic": "وَأَنتَ", "translit": "َtnَaʾَw", "root": ""}, {"id": 10, "arabic": "أَرْحَمُ", "translit": "ُmَḥْrَaʾ", "root": "رحم"}, {"id": 11, "arabic": "ٱلرَّٰحِمِينَ", "translit": "َnyِmِḥَّٰrlٱ", "root": "رحم"}], "hasIhya": false}, {"ayah": 152, "text": "إِنَّ ٱلَّذِينَ ٱتَّخَذُوا۟ ٱلْعِجْلَ سَيَنَالُهُمْ غَضَبٌ مِّن رَّبِّهِمْ وَذِلَّةٌ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَاۚ وَكَذَٰلِكَ نَجْزِى ٱلْمُفْتَرِينَ ", "translation": "Indeed, those who took the calf [for worship] will obtain anger from their Lord and humiliation in the life of this world, and thus do We recompense the inventors [of falsehood].", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ٱتَّخَذُوا۟", "translit": "۟āwُhdَhkَّtٱ", "root": "اخذ"}, {"id": 4, "arabic": "ٱلْعِجْلَ", "translit": "َlْjgِʿعْlٱ", "root": "عجل"}, {"id": 5, "arabic": "سَيَنَالُهُمْ", "translit": "ْmُhُlāَnَyَs", "root": "نيل"}, {"id": 6, "arabic": "غَضَبٌ", "translit": "ٌbَḍَغ", "root": "غضب"}, {"id": 7, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 8, "arabic": "رَّبِّهِمْ", "translit": "ْmِhِّbَّr", "root": "ربب"}, {"id": 9, "arabic": "وَذِلَّةٌ", "translit": "ٌẗَّlِhdَw", "root": "ذلل"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 12, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 13, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 14, "arabic": "نَجْزِى", "translit": "àِzْjgَn", "root": "جزي"}, {"id": 15, "arabic": "ٱلْمُفْتَرِينَ", "translit": "َnyِrَtْfُmْlٱ", "root": "فري"}], "hasIhya": false}, {"ayah": 153, "text": "وَٱلَّذِينَ عَمِلُوا۟ ٱلسَّيِّـَٔاتِ ثُمَّ تَابُوا۟ مِنۢ بَعْدِهَا وَءَامَنُوٓا۟ إِنَّ رَبَّكَ مِنۢ بَعْدِهَا لَغَفُورٌ رَّحِيمٌ ", "translation": "But those who committed misdeeds and then repented after them and believed - indeed your Lord, thereafter, is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "عَمِلُوا۟", "translit": "۟āwُlِmَʿع", "root": "عمل"}, {"id": 3, "arabic": "ٱلسَّيِّـَٔاتِ", "translit": "ِtāَٔـِّyَّslٱ", "root": "سوا"}, {"id": 4, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 5, "arabic": "تَابُوا۟", "translit": "۟āwُbāَt", "root": "توب"}, {"id": 6, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 7, "arabic": "بَعْدِهَا", "translit": "āَhِdْʿعَb", "root": "بعد"}, {"id": 8, "arabic": "وَءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَءَw", "root": "امن"}, {"id": 9, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 10, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 11, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 12, "arabic": "بَعْدِهَا", "translit": "āَhِdْʿعَb", "root": "بعد"}, {"id": 13, "arabic": "لَغَفُورٌ", "translit": "ٌrwُfَغَl", "root": "غفر"}, {"id": 14, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 154, "text": "وَلَمَّا سَكَتَ عَن مُّوسَى ٱلْغَضَبُ أَخَذَ ٱلْأَلْوَاحَۖ وَفِى نُسْخَتِهَا هُدًى وَرَحْمَةٌ لِّلَّذِينَ هُمْ لِرَبِّهِمْ يَرْهَبُونَ ", "translation": "And when the anger subsided in Moses, he took up the tablets; and in their inscription was guidance and mercy for those who are fearful of their Lord.", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 2, "arabic": "سَكَتَ", "translit": "َtَkَs", "root": "سكت"}, {"id": 3, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 4, "arabic": "مُّوسَى", "translit": "àَswُّm", "root": ""}, {"id": 5, "arabic": "ٱلْغَضَبُ", "translit": "ُbَḍَغْlٱ", "root": "غضب"}, {"id": 6, "arabic": "أَخَذَ", "translit": "َhdَhkَaʾ", "root": "اخذ"}, {"id": 7, "arabic": "ٱلْأَلْوَاحَ", "translit": "َḥāَwْlَaʾْlٱ", "root": "لوح"}, {"id": 8, "arabic": "وَفِى", "translit": "àِfَw", "root": ""}, {"id": 9, "arabic": "نُسْخَتِهَا", "translit": "āَhِtَhkْsُn", "root": "نسخ"}, {"id": 10, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 11, "arabic": "وَرَحْمَةٌ", "translit": "ٌẗَmْḥَrَw", "root": "رحم"}, {"id": 12, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 13, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 14, "arabic": "لِرَبِّهِمْ", "translit": "ْmِhِّbَrِl", "root": "ربب"}, {"id": 15, "arabic": "يَرْهَبُونَ", "translit": "َnwُbَhْrَy", "root": "رهب"}], "hasIhya": true}, {"ayah": 155, "text": "وَٱخْتَارَ مُوسَىٰ قَوْمَهُۥ سَبْعِينَ رَجُلًا لِّمِيقَٰتِنَاۖ فَلَمَّآ أَخَذَتْهُمُ ٱلرَّجْفَةُ قَالَ رَبِّ لَوْ شِئْتَ أَهْلَكْتَهُم مِّن قَبْلُ وَإِيَّٰىَۖ أَتُهْلِكُنَا بِمَا فَعَلَ ٱلسُّفَهَآءُ مِنَّآۖ إِنْ هِىَ إِلَّا فِتْنَتُكَ تُضِلُّ بِهَا مَن تَشَآءُ وَتَهْدِى مَن تَشَآءُۖ أَنتَ وَلِيُّنَا فَٱغْفِرْ لَنَا وَٱرْحَمْنَاۖ وَأَنتَ خَيْرُ ٱلْغَٰفِرِينَ ", "translation": "And Moses chose from his people seventy men for Our appointment.[1] And when the earthquake seized them,[2] he said, \"My Lord, if You had willed, You could have destroyed them before and me [as well]. Would You destroy us for what the foolish among us have done? This is not but Your trial by which You send astray whom You will and guide whom You will. You are our Protector, so forgive us and have mercy upon us; and You are the best of forgivers.", "words": [{"id": 1, "arabic": "وَٱخْتَارَ", "translit": "َrāَtْhkٱَw", "root": "خير"}, {"id": 2, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 3, "arabic": "قَوْمَهُۥ", "translit": "ۥُhَmْwَq", "root": "قوم"}, {"id": 4, "arabic": "سَبْعِينَ", "translit": "َnyِʿعْbَs", "root": "سبع"}, {"id": 5, "arabic": "رَجُلًا", "translit": "āًlُjgَr", "root": "رجل"}, {"id": 6, "arabic": "لِّمِيقَٰتِنَا", "translit": "āَnِtَٰqyِmِّl", "root": "وقت"}, {"id": 7, "arabic": "فَلَمَّآ", "translit": "ٓāَّmَlَf", "root": ""}, {"id": 8, "arabic": "أَخَذَتْهُمُ", "translit": "ُmُhْtَhdَhkَaʾ", "root": "اخذ"}, {"id": 9, "arabic": "ٱلرَّجْفَةُ", "translit": "ُẗَfْjgَّrlٱ", "root": "رجف"}, {"id": 10, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 11, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 12, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 13, "arabic": "شِئْتَ", "translit": "َtْyʾِhs", "root": "شيا"}, {"id": 14, "arabic": "أَهْلَكْتَهُم", "translit": "mُhَtْkَlْhَaʾ", "root": "هلك"}, {"id": 15, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 16, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 17, "arabic": "وَإِيَّٰىَ", "translit": "َàَّٰyِiʾَw", "root": ""}, {"id": 18, "arabic": "أَتُهْلِكُنَا", "translit": "āَnُkِlْhُtَaʾ", "root": "هلك"}, {"id": 19, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 20, "arabic": "فَعَلَ", "translit": "َlَʿعَf", "root": "فعل"}, {"id": 21, "arabic": "ٱلسُّفَهَآءُ", "translit": "ُءٓāَhَfُّslٱ", "root": "سفه"}, {"id": 22, "arabic": "مِنَّآ", "translit": "ٓāَّnِm", "root": ""}, {"id": 23, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 24, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 25, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 26, "arabic": "فِتْنَتُكَ", "translit": "َkُtَnْtِf", "root": "فتن"}, {"id": 27, "arabic": "تُضِلُّ", "translit": "ُّlِḍُt", "root": "ضلل"}, {"id": 28, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 29, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 30, "arabic": "تَشَآءُ", "translit": "ُءٓāَhsَt", "root": "شيا"}, {"id": 31, "arabic": "وَتَهْدِى", "translit": "àِdْhَtَw", "root": "هدي"}, {"id": 32, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 33, "arabic": "تَشَآءُ", "translit": "ُءٓāَhsَt", "root": "شيا"}, {"id": 34, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 35, "arabic": "وَلِيُّنَا", "translit": "āَnُّyِlَw", "root": "ولي"}, {"id": 36, "arabic": "فَٱغْفِرْ", "translit": "ْrِfْغٱَf", "root": "غفر"}, {"id": 37, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 38, "arabic": "وَٱرْحَمْنَا", "translit": "āَnْmَḥْrٱَw", "root": "رحم"}, {"id": 39, "arabic": "وَأَنتَ", "translit": "َtnَaʾَw", "root": ""}, {"id": 40, "arabic": "خَيْرُ", "translit": "ُrْyَhk", "root": "خير"}, {"id": 41, "arabic": "ٱلْغَٰفِرِينَ", "translit": "َnyِrِfَٰغْlٱ", "root": "غفر"}], "hasIhya": true}, {"ayah": 156, "text": "وَٱكْتُبْ لَنَا فِى هَٰذِهِ ٱلدُّنْيَا حَسَنَةً وَفِى ٱلْءَاخِرَةِ إِنَّا هُدْنَآ إِلَيْكَۚ قَالَ عَذَابِىٓ أُصِيبُ بِهِۦ مَنْ أَشَآءُۖ وَرَحْمَتِى وَسِعَتْ كُلَّ شَىْءٍۚ فَسَأَكْتُبُهَا لِلَّذِينَ يَتَّقُونَ وَيُؤْتُونَ ٱلزَّكَوٰةَ وَٱلَّذِينَ هُم بِـَٔايَٰتِنَا يُؤْمِنُونَ ", "translation": "And decree for us in this world [that which is] good and [also] in the Hereafter; indeed, we have turned back to You.\" [Allāh] said, \"My punishment - I afflict with it whom I will, but My mercy encompasses all things.\" So I will decree it [especially] for those who fear Me and give zakāh and those who believe in Our verses-", "words": [{"id": 1, "arabic": "وَٱكْتُبْ", "translit": "ْbُtْkٱَw", "root": "كتب"}, {"id": 2, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "هَٰذِهِ", "translit": "ِhِhdَٰh", "root": ""}, {"id": 5, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 6, "arabic": "حَسَنَةً", "translit": "ًẗَnَsَḥ", "root": "حسن"}, {"id": 7, "arabic": "وَفِى", "translit": "àِfَw", "root": ""}, {"id": 8, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 9, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 10, "arabic": "هُدْنَآ", "translit": "ٓāَnْdُh", "root": "هود"}, {"id": 11, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 12, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 13, "arabic": "عَذَابِىٓ", "translit": "ٓàِbāَhdَʿع", "root": "عذب"}, {"id": 14, "arabic": "أُصِيبُ", "translit": "ُbyِṣُaʾ", "root": "صوب"}, {"id": 15, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 16, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 17, "arabic": "أَشَآءُ", "translit": "ُءٓāَhsَaʾ", "root": "شيا"}, {"id": 18, "arabic": "وَرَحْمَتِى", "translit": "àِtَmْḥَrَw", "root": "رحم"}, {"id": 19, "arabic": "وَسِعَتْ", "translit": "ْtَʿعِsَw", "root": "وسع"}, {"id": 20, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 21, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 22, "arabic": "فَسَأَكْتُبُهَا", "translit": "āَhُbُtْkَaʾَsَf", "root": "كتب"}, {"id": 23, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 24, "arabic": "يَتَّقُونَ", "translit": "َnwُqَّtَy", "root": "وقي"}, {"id": 25, "arabic": "وَيُؤْتُونَ", "translit": "َnwُtْwʾُyَw", "root": "اتي"}, {"id": 26, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 27, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 28, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 29, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 30, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 157, "text": "ٱلَّذِينَ يَتَّبِعُونَ ٱلرَّسُولَ ٱلنَّبِىَّ ٱلْأُمِّىَّ ٱلَّذِى يَجِدُونَهُۥ مَكْتُوبًا عِندَهُمْ فِى ٱلتَّوْرَىٰةِ وَٱلْإِنجِيلِ يَأْمُرُهُم بِٱلْمَعْرُوفِ وَيَنْهَىٰهُمْ عَنِ ٱلْمُنكَرِ وَيُحِلُّ لَهُمُ ٱلطَّيِّبَٰتِ وَيُحَرِّمُ عَلَيْهِمُ ٱلْخَبَٰٓئِثَ وَيَضَعُ عَنْهُمْ إِصْرَهُمْ وَٱلْأَغْلَٰلَ ٱلَّتِى كَانَتْ عَلَيْهِمْۚ فَٱلَّذِينَ ءَامَنُوا۟ بِهِۦ وَعَزَّرُوهُ وَنَصَرُوهُ وَٱتَّبَعُوا۟ ٱلنُّورَ ٱلَّذِىٓ أُنزِلَ مَعَهُۥٓۙ أُو۟لَٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ ", "translation": "Those who follow the Messenger, the unlettered prophet, whom they find written [i.e., described] in what they have of the Torah and the Gospel, who enjoins upon them what is right and prohibits them from what is wrong and makes lawful for them what is good and forbids them from what is evil and relieves them of their burden[1] and the shackles which were upon them.[2] So they who have believed in him, honored him, supported him and followed the light which was sent down with him - it is those who will be the successful.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يَتَّبِعُونَ", "translit": "َnwُʿعِbَّtَy", "root": "تبع"}, {"id": 3, "arabic": "ٱلرَّسُولَ", "translit": "َlwُsَّrlٱ", "root": "رسل"}, {"id": 4, "arabic": "ٱلنَّبِىَّ", "translit": "َّàِbَّnlٱ", "root": "نبا"}, {"id": 5, "arabic": "ٱلْأُمِّىَّ", "translit": "َّàِّmُaʾْlٱ", "root": "امم"}, {"id": 6, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "يَجِدُونَهُۥ", "translit": "ۥُhَnwُdِjgَy", "root": "وجد"}, {"id": 8, "arabic": "مَكْتُوبًا", "translit": "āًbwُtْkَm", "root": "كتب"}, {"id": 9, "arabic": "عِندَهُمْ", "translit": "ْmُhَdnِʿع", "root": "عند"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلتَّوْرَىٰةِ", "translit": "ِẗٰàَrْwَّtlٱ", "root": ""}, {"id": 12, "arabic": "وَٱلْإِنجِيلِ", "translit": "ِlyِjgnِiʾْlٱَw", "root": ""}, {"id": 13, "arabic": "يَأْمُرُهُم", "translit": "mُhُrُmْaʾَy", "root": "امر"}, {"id": 14, "arabic": "بِٱلْمَعْرُوفِ", "translit": "ِfwُrْʿعَmْlٱِb", "root": "عرف"}, {"id": 15, "arabic": "وَيَنْهَىٰهُمْ", "translit": "ْmُhٰàَhْnَyَw", "root": "نهي"}, {"id": 16, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 17, "arabic": "ٱلْمُنكَرِ", "translit": "ِrَknُmْlٱ", "root": "نكر"}, {"id": 18, "arabic": "وَيُحِلُّ", "translit": "ُّlِḥُyَw", "root": "حلل"}, {"id": 19, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 20, "arabic": "ٱلطَّيِّبَٰتِ", "translit": "ِtَٰbِّyَّṭlٱ", "root": "طيب"}, {"id": 21, "arabic": "وَيُحَرِّمُ", "translit": "ُmِّrَḥُyَw", "root": "حرم"}, {"id": 22, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 23, "arabic": "ٱلْخَبَٰٓئِثَ", "translit": "َhtِyʾَٰٓbَhkْlٱ", "root": "خبث"}, {"id": 24, "arabic": "وَيَضَعُ", "translit": "ُʿعَḍَyَw", "root": "وضع"}, {"id": 25, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 26, "arabic": "إِصْرَهُمْ", "translit": "ْmُhَrْṣِiʾ", "root": "اصر"}, {"id": 27, "arabic": "وَٱلْأَغْلَٰلَ", "translit": "َlَٰlْغَaʾْlٱَw", "root": "غلل"}, {"id": 28, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 29, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 30, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 31, "arabic": "فَٱلَّذِينَ", "translit": "َnyِhdَّlٱَf", "root": ""}, {"id": 32, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 33, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 34, "arabic": "وَعَزَّرُوهُ", "translit": "ُhwُrَّzَʿعَw", "root": "عزر"}, {"id": 35, "arabic": "وَنَصَرُوهُ", "translit": "ُhwُrَṣَnَw", "root": "نصر"}, {"id": 36, "arabic": "وَٱتَّبَعُوا۟", "translit": "۟āwُʿعَbَّtٱَw", "root": "تبع"}, {"id": 37, "arabic": "ٱلنُّورَ", "translit": "َrwُّnlٱ", "root": "نور"}, {"id": 38, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 39, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 40, "arabic": "مَعَهُۥٓ", "translit": "ٓۥُhَʿعَm", "root": ""}, {"id": 41, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 42, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 43, "arabic": "ٱلْمُفْلِحُونَ", "translit": "َnwُḥِlْfُmْlٱ", "root": "فلح"}], "hasIhya": true}, {"ayah": 158, "text": "قُلْ يَٰٓأَيُّهَا ٱلنَّاسُ إِنِّى رَسُولُ ٱللَّهِ إِلَيْكُمْ جَمِيعًا ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ لَآ إِلَٰهَ إِلَّا هُوَ يُحْىِۦ وَيُمِيتُۖ فَـَٔامِنُوا۟ بِٱللَّهِ وَرَسُولِهِ ٱلنَّبِىِّ ٱلْأُمِّىِّ ٱلَّذِى يُؤْمِنُ بِٱللَّهِ وَكَلِمَٰتِهِۦ وَٱتَّبِعُوهُ لَعَلَّكُمْ تَهْتَدُونَ ", "translation": "Say, [O Muḥammad], \"O mankind, indeed I am the Messenger of Allāh to you all, [from Him] to whom belongs the dominion of the heavens and the earth. There is no deity except Him; He gives life and causes death.\" So believe in Allāh and His Messenger, the unlettered prophet, who believes in Allāh and His words, and follow him that you may be guided.", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 3, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 4, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 5, "arabic": "رَسُولُ", "translit": "ُlwُsَr", "root": "رسل"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "إِلَيْكُمْ", "translit": "ْmُkْyَlِiʾ", "root": ""}, {"id": 8, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 9, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 11, "arabic": "مُلْكُ", "translit": "ُkْlُm", "root": "ملك"}, {"id": 12, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 13, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 14, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 15, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 16, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 17, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 18, "arabic": "يُحْىِۦ", "translit": "ۦِàْḥُy", "root": "حيي"}, {"id": 19, "arabic": "وَيُمِيتُ", "translit": "ُtyِmُyَw", "root": "موت"}, {"id": 20, "arabic": "فَـَٔامِنُوا۟", "translit": "۟āwُnِmāَٔـَf", "root": "امن"}, {"id": 21, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 22, "arabic": "وَرَسُولِهِ", "translit": "ِhِlwُsَrَw", "root": "رسل"}, {"id": 23, "arabic": "ٱلنَّبِىِّ", "translit": "ِّàِbَّnlٱ", "root": "نبا"}, {"id": 24, "arabic": "ٱلْأُمِّىِّ", "translit": "ِّàِّmُaʾْlٱ", "root": "امم"}, {"id": 25, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 26, "arabic": "يُؤْمِنُ", "translit": "ُnِmْwʾُy", "root": "امن"}, {"id": 27, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 28, "arabic": "وَكَلِمَٰتِهِۦ", "translit": "ۦِhِtَٰmِlَkَw", "root": "كلم"}, {"id": 29, "arabic": "وَٱتَّبِعُوهُ", "translit": "ُhwُʿعِbَّtٱَw", "root": "تبع"}, {"id": 30, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 31, "arabic": "تَهْتَدُونَ", "translit": "َnwُdَtْhَt", "root": "هدي"}], "hasIhya": true}, {"ayah": 159, "text": "وَمِن قَوْمِ مُوسَىٰٓ أُمَّةٌ يَهْدُونَ بِٱلْحَقِّ وَبِهِۦ يَعْدِلُونَ ", "translation": "And among the people of Moses is a community[1] which guides by truth and by it establishes justice.", "words": [{"id": 1, "arabic": "وَمِن", "translit": "nِmَw", "root": ""}, {"id": 2, "arabic": "قَوْمِ", "translit": "ِmْwَq", "root": "قوم"}, {"id": 3, "arabic": "مُوسَىٰٓ", "translit": "ٰٓàَswُm", "root": ""}, {"id": 4, "arabic": "أُمَّةٌ", "translit": "ٌẗَّmُaʾ", "root": "امم"}, {"id": 5, "arabic": "يَهْدُونَ", "translit": "َnwُdْhَy", "root": "هدي"}, {"id": 6, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 7, "arabic": "وَبِهِۦ", "translit": "ۦِhِbَw", "root": ""}, {"id": 8, "arabic": "يَعْدِلُونَ", "translit": "َnwُlِdْʿعَy", "root": "عدل"}], "hasIhya": false}, {"ayah": 160, "text": "وَقَطَّعْنَٰهُمُ ٱثْنَتَىْ عَشْرَةَ أَسْبَاطًا أُمَمًاۚ وَأَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ إِذِ ٱسْتَسْقَىٰهُ قَوْمُهُۥٓ أَنِ ٱضْرِب بِّعَصَاكَ ٱلْحَجَرَۖ فَٱنۢبَجَسَتْ مِنْهُ ٱثْنَتَا عَشْرَةَ عَيْنًاۖ قَدْ عَلِمَ كُلُّ أُنَاسٍ مَّشْرَبَهُمْۚ وَظَلَّلْنَا عَلَيْهِمُ ٱلْغَمَٰمَ وَأَنزَلْنَا عَلَيْهِمُ ٱلْمَنَّ وَٱلسَّلْوَىٰۖ كُلُوا۟ مِن طَيِّبَٰتِ مَا رَزَقْنَٰكُمْۚ وَمَا ظَلَمُونَا وَلَٰكِن كَانُوٓا۟ أَنفُسَهُمْ يَظْلِمُونَ ", "translation": "And We divided them into twelve descendant tribes[1] [as distinct] nations. And We inspired to Moses when his people implored him for water, \"Strike with your staff the stone,\" and there gushed forth from it twelve springs. Every people [i.e., tribe] knew its watering place. And We shaded them with clouds and sent down upon them manna and quails, [saying], \"Eat from the good things with which We have provided you.\" And they wronged Us not, but they were [only] wronging themselves.", "words": [{"id": 1, "arabic": "وَقَطَّعْنَٰهُمُ", "translit": "ُmُhَٰnْʿعَّṭَqَw", "root": "قطع"}, {"id": 2, "arabic": "ٱثْنَتَىْ", "translit": "ْàَtَnْhtٱ", "root": "ثني"}, {"id": 3, "arabic": "عَشْرَةَ", "translit": "َẗَrْhsَʿع", "root": "عشر"}, {"id": 4, "arabic": "أَسْبَاطًا", "translit": "āًṭāَbْsَaʾ", "root": "سبط"}, {"id": 5, "arabic": "أُمَمًا", "translit": "āًmَmُaʾ", "root": "امم"}, {"id": 6, "arabic": "وَأَوْحَيْنَآ", "translit": "ٓāَnْyَḥْwَaʾَw", "root": "وحي"}, {"id": 7, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 8, "arabic": "مُوسَىٰٓ", "translit": "ٰٓàَswُm", "root": ""}, {"id": 9, "arabic": "إِذِ", "translit": "ِhdِiʾ", "root": ""}, {"id": 10, "arabic": "ٱسْتَسْقَىٰهُ", "translit": "ُhٰàَqْsَtْsٱ", "root": "سقي"}, {"id": 11, "arabic": "قَوْمُهُۥٓ", "translit": "ٓۥُhُmْwَq", "root": "قوم"}, {"id": 12, "arabic": "أَنِ", "translit": "ِnَaʾ", "root": ""}, {"id": 13, "arabic": "ٱضْرِب", "translit": "bِrْḍٱ", "root": "ضرب"}, {"id": 14, "arabic": "بِّعَصَاكَ", "translit": "َkāَṣَʿعِّb", "root": "عصو"}, {"id": 15, "arabic": "ٱلْحَجَرَ", "translit": "َrَjgَḥْlٱ", "root": "حجر"}, {"id": 16, "arabic": "فَٱنۢبَجَسَتْ", "translit": "ْtَsَjgَbۢnٱَf", "root": "بجس"}, {"id": 17, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 18, "arabic": "ٱثْنَتَا", "translit": "āَtَnْhtٱ", "root": "ثني"}, {"id": 19, "arabic": "عَشْرَةَ", "translit": "َẗَrْhsَʿع", "root": "عشر"}, {"id": 20, "arabic": "عَيْنًا", "translit": "āًnْyَʿع", "root": "عين"}, {"id": 21, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 22, "arabic": "عَلِمَ", "translit": "َmِlَʿع", "root": "علم"}, {"id": 23, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 24, "arabic": "أُنَاسٍ", "translit": "ٍsāَnُaʾ", "root": "انس"}, {"id": 25, "arabic": "مَّشْرَبَهُمْ", "translit": "ْmُhَbَrْhsَّm", "root": "شرب"}, {"id": 26, "arabic": "وَظَلَّلْنَا", "translit": "āَnْlَّlَẓَw", "root": "ظلل"}, {"id": 27, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 28, "arabic": "ٱلْغَمَٰمَ", "translit": "َmَٰmَغْlٱ", "root": "غمم"}, {"id": 29, "arabic": "وَأَنزَلْنَا", "translit": "āَnْlَznَaʾَw", "root": "نزل"}, {"id": 30, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 31, "arabic": "ٱلْمَنَّ", "translit": "َّnَmْlٱ", "root": "منن"}, {"id": 32, "arabic": "وَٱلسَّلْوَىٰ", "translit": "ٰàَwْlَّslٱَw", "root": "سلو"}, {"id": 33, "arabic": "كُلُوا۟", "translit": "۟āwُlُk", "root": "اكل"}, {"id": 34, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 35, "arabic": "طَيِّبَٰتِ", "translit": "ِtَٰbِّyَṭ", "root": "طيب"}, {"id": 36, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 37, "arabic": "رَزَقْنَٰكُمْ", "translit": "ْmُkَٰnْqَzَr", "root": "رزق"}, {"id": 38, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 39, "arabic": "ظَلَمُونَا", "translit": "āَnwُmَlَẓ", "root": "ظلم"}, {"id": 40, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 41, "arabic": "كَانُوٓا۟", "translit": "۟āٓwُnāَk", "root": "كون"}, {"id": 42, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 43, "arabic": "يَظْلِمُونَ", "translit": "َnwُmِlْẓَy", "root": "ظلم"}], "hasIhya": true}, {"ayah": 161, "text": "وَإِذْ قِيلَ لَهُمُ ٱسْكُنُوا۟ هَٰذِهِ ٱلْقَرْيَةَ وَكُلُوا۟ مِنْهَا حَيْثُ شِئْتُمْ وَقُولُوا۟ حِطَّةٌ وَٱدْخُلُوا۟ ٱلْبَابَ سُجَّدًا نَّغْفِرْ لَكُمْ خَطِيٓـَٰٔتِكُمْۚ سَنَزِيدُ ٱلْمُحْسِنِينَ ", "translation": "And [mention, O Muḥammad], when it was said to them, \"Dwell in this city [i.e., Jerusalem] and eat from it wherever you will and say, 'Relieve us of our burdens [i.e., sins],' and enter the gate bowing humbly; We will [then] forgive you your sins. We will increase the doers of good [in goodness and reward].\"", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 3, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 4, "arabic": "ٱسْكُنُوا۟", "translit": "۟āwُnُkْsٱ", "root": "سكن"}, {"id": 5, "arabic": "هَٰذِهِ", "translit": "ِhِhdَٰh", "root": ""}, {"id": 6, "arabic": "ٱلْقَرْيَةَ", "translit": "َẗَyْrَqْlٱ", "root": "قري"}, {"id": 7, "arabic": "وَكُلُوا۟", "translit": "۟āwُlُkَw", "root": "اكل"}, {"id": 8, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 9, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 10, "arabic": "شِئْتُمْ", "translit": "ْmُtْyʾِhs", "root": "شيا"}, {"id": 11, "arabic": "وَقُولُوا۟", "translit": "۟āwُlwُqَw", "root": "قول"}, {"id": 12, "arabic": "حِطَّةٌ", "translit": "ٌẗَّṭِḥ", "root": "حطط"}, {"id": 13, "arabic": "وَٱدْخُلُوا۟", "translit": "۟āwُlُhkْdٱَw", "root": "دخل"}, {"id": 14, "arabic": "ٱلْبَابَ", "translit": "َbāَbْlٱ", "root": "بوب"}, {"id": 15, "arabic": "سُجَّدًا", "translit": "āًdَّjgُs", "root": "سجد"}, {"id": 16, "arabic": "نَّغْفِرْ", "translit": "ْrِfْغَّn", "root": "غفر"}, {"id": 17, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 18, "arabic": "خَطِيٓـَٰٔتِكُمْ", "translit": "ْmُkِtَٰٔـٓyِṭَhk", "root": "خطا"}, {"id": 19, "arabic": "سَنَزِيدُ", "translit": "ُdyِzَnَs", "root": "زيد"}, {"id": 20, "arabic": "ٱلْمُحْسِنِينَ", "translit": "َnyِnِsْḥُmْlٱ", "root": "حسن"}], "hasIhya": false}, {"ayah": 162, "text": "فَبَدَّلَ ٱلَّذِينَ ظَلَمُوا۟ مِنْهُمْ قَوْلًا غَيْرَ ٱلَّذِى قِيلَ لَهُمْ فَأَرْسَلْنَا عَلَيْهِمْ رِجْزًا مِّنَ ٱلسَّمَآءِ بِمَا كَانُوا۟ يَظْلِمُونَ ", "translation": "But those who wronged among them changed [the words] to a statement other than that which had been said to them. So We sent upon them a punishment from the sky for the wrong that they were doing.", "words": [{"id": 1, "arabic": "فَبَدَّلَ", "translit": "َlَّdَbَf", "root": "بدل"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ظَلَمُوا۟", "translit": "۟āwُmَlَẓ", "root": "ظلم"}, {"id": 4, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 5, "arabic": "قَوْلًا", "translit": "āًlْwَq", "root": "قول"}, {"id": 6, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 7, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 9, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 10, "arabic": "فَأَرْسَلْنَا", "translit": "āَnْlَsْrَaʾَf", "root": "رسل"}, {"id": 11, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 12, "arabic": "رِجْزًا", "translit": "āًzْjgِr", "root": "رجز"}, {"id": 13, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 14, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 15, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 16, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 17, "arabic": "يَظْلِمُونَ", "translit": "َnwُmِlْẓَy", "root": "ظلم"}], "hasIhya": false}, {"ayah": 163, "text": "وَسْـَٔلْهُمْ عَنِ ٱلْقَرْيَةِ ٱلَّتِى كَانَتْ حَاضِرَةَ ٱلْبَحْرِ إِذْ يَعْدُونَ فِى ٱلسَّبْتِ إِذْ تَأْتِيهِمْ حِيتَانُهُمْ يَوْمَ سَبْتِهِمْ شُرَّعًا وَيَوْمَ لَا يَسْبِتُونَۙ لَا تَأْتِيهِمْۚ كَذَٰلِكَ نَبْلُوهُم بِمَا كَانُوا۟ يَفْسُقُونَ ", "translation": "And ask them about the town that was by the sea - when they transgressed in [the matter of] the sabbath - when their fish came to them openly on their sabbath day, and the day they had no sabbath they did not come to them. Thus did We give them trial because they were defiantly disobedient.", "words": [{"id": 1, "arabic": "وَسْـَٔلْهُمْ", "translit": "ْmُhْlَٔـْsَw", "root": "سال"}, {"id": 2, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 3, "arabic": "ٱلْقَرْيَةِ", "translit": "ِẗَyْrَqْlٱ", "root": "قري"}, {"id": 4, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 5, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 6, "arabic": "حَاضِرَةَ", "translit": "َẗَrِḍāَḥ", "root": "حضر"}, {"id": 7, "arabic": "ٱلْبَحْرِ", "translit": "ِrْḥَbْlٱ", "root": "بحر"}, {"id": 8, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 9, "arabic": "يَعْدُونَ", "translit": "َnwُdْʿعَy", "root": "عدو"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلسَّبْتِ", "translit": "ِtْbَّslٱ", "root": "سبت"}, {"id": 12, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 13, "arabic": "تَأْتِيهِمْ", "translit": "ْmِhyِtْaʾَt", "root": "اتي"}, {"id": 14, "arabic": "حِيتَانُهُمْ", "translit": "ْmُhُnāَtyِḥ", "root": "حوت"}, {"id": 15, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 16, "arabic": "سَبْتِهِمْ", "translit": "ْmِhِtْbَs", "root": "سبت"}, {"id": 17, "arabic": "شُرَّعًا", "translit": "āًʿعَّrُhs", "root": "شرع"}, {"id": 18, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 19, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 20, "arabic": "يَسْبِتُونَ", "translit": "َnwُtِbْsَy", "root": "سبت"}, {"id": 21, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 22, "arabic": "تَأْتِيهِمْ", "translit": "ْmِhyِtْaʾَt", "root": "اتي"}, {"id": 23, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 24, "arabic": "نَبْلُوهُم", "translit": "mُhwُlْbَn", "root": "بلو"}, {"id": 25, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 26, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 27, "arabic": "يَفْسُقُونَ", "translit": "َnwُqُsْfَy", "root": "فسق"}], "hasIhya": false}, {"ayah": 164, "text": "وَإِذْ قَالَتْ أُمَّةٌ مِّنْهُمْ لِمَ تَعِظُونَ قَوْمًاۙ ٱللَّهُ مُهْلِكُهُمْ أَوْ مُعَذِّبُهُمْ عَذَابًا شَدِيدًاۖ قَالُوا۟ مَعْذِرَةً إِلَىٰ رَبِّكُمْ وَلَعَلَّهُمْ يَتَّقُونَ ", "translation": "And when a community among them said, \"Why do you advise [or warn] a people whom Allāh is [about] to destroy or to punish with a severe punishment?\" they [the advisors] said, \"To be absolved before your Lord and perhaps they may fear Him.\"", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قَالَتْ", "translit": "ْtَlāَq", "root": "قول"}, {"id": 3, "arabic": "أُمَّةٌ", "translit": "ٌẗَّmُaʾ", "root": "امم"}, {"id": 4, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 5, "arabic": "لِمَ", "translit": "َmِl", "root": ""}, {"id": 6, "arabic": "تَعِظُونَ", "translit": "َnwُẓِʿعَt", "root": "وعظ"}, {"id": 7, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "مُهْلِكُهُمْ", "translit": "ْmُhُkِlْhُm", "root": "هلك"}, {"id": 10, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 11, "arabic": "مُعَذِّبُهُمْ", "translit": "ْmُhُbِّhdَʿعُm", "root": "عذب"}, {"id": 12, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 13, "arabic": "شَدِيدًا", "translit": "āًdyِdَhs", "root": "شدد"}, {"id": 14, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 15, "arabic": "مَعْذِرَةً", "translit": "ًẗَrِhdْʿعَm", "root": "عذر"}, {"id": 16, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 17, "arabic": "رَبِّكُمْ", "translit": "ْmُkِّbَr", "root": "ربب"}, {"id": 18, "arabic": "وَلَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَlَw", "root": ""}, {"id": 19, "arabic": "يَتَّقُونَ", "translit": "َnwُqَّtَy", "root": "وقي"}], "hasIhya": false}, {"ayah": 165, "text": "فَلَمَّا نَسُوا۟ مَا ذُكِّرُوا۟ بِهِۦٓ أَنجَيْنَا ٱلَّذِينَ يَنْهَوْنَ عَنِ ٱلسُّوٓءِ وَأَخَذْنَا ٱلَّذِينَ ظَلَمُوا۟ بِعَذَابٍۭ بَـِٔيسٍۭ بِمَا كَانُوا۟ يَفْسُقُونَ ", "translation": "And when they [i.e., those advised] forgot that by which they had been reminded, We saved those who had forbidden evil and seized those who wronged, with a wretched punishment, because they were defiantly disobeying.", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "نَسُوا۟", "translit": "۟āwُsَn", "root": "نسي"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "ذُكِّرُوا۟", "translit": "۟āwُrِّkُhd", "root": "ذكر"}, {"id": 5, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 6, "arabic": "أَنجَيْنَا", "translit": "āَnْyَjgnَaʾ", "root": "نجو"}, {"id": 7, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "يَنْهَوْنَ", "translit": "َnْwَhْnَy", "root": "نهي"}, {"id": 9, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 10, "arabic": "ٱلسُّوٓءِ", "translit": "ِءٓwُّslٱ", "root": "سوا"}, {"id": 11, "arabic": "وَأَخَذْنَا", "translit": "āَnْhdَhkَaʾَw", "root": "اخذ"}, {"id": 12, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 13, "arabic": "ظَلَمُوا۟", "translit": "۟āwُmَlَẓ", "root": "ظلم"}, {"id": 14, "arabic": "بِعَذَابٍۭ", "translit": "ٍۭbāَhdَʿعِb", "root": "عذب"}, {"id": 15, "arabic": "بَـِٔيسٍۭ", "translit": "ٍۭsyِٔـَb", "root": "باس"}, {"id": 16, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 17, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 18, "arabic": "يَفْسُقُونَ", "translit": "َnwُqُsْfَy", "root": "فسق"}], "hasIhya": true}, {"ayah": 166, "text": "فَلَمَّا عَتَوْا۟ عَن مَّا نُهُوا۟ عَنْهُ قُلْنَا لَهُمْ كُونُوا۟ قِرَدَةً خَٰسِـِٔينَ ", "translation": "So when they were insolent about that which they had been forbidden, We said to them, \"Be apes, despised.\"", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "عَتَوْا۟", "translit": "۟āْwَtَʿع", "root": "عتو"}, {"id": 3, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 4, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 5, "arabic": "نُهُوا۟", "translit": "۟āwُhُn", "root": "نهي"}, {"id": 6, "arabic": "عَنْهُ", "translit": "ُhْnَʿع", "root": ""}, {"id": 7, "arabic": "قُلْنَا", "translit": "āَnْlُq", "root": "قول"}, {"id": 8, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 9, "arabic": "كُونُوا۟", "translit": "۟āwُnwُk", "root": "كون"}, {"id": 10, "arabic": "قِرَدَةً", "translit": "ًẗَdَrِq", "root": "قرد"}, {"id": 11, "arabic": "خَٰسِـِٔينَ", "translit": "َnyِٔـِsَٰhk", "root": "خسا"}], "hasIhya": false}, {"ayah": 167, "text": "وَإِذْ تَأَذَّنَ رَبُّكَ لَيَبْعَثَنَّ عَلَيْهِمْ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ مَن يَسُومُهُمْ سُوٓءَ ٱلْعَذَابِۗ إِنَّ رَبَّكَ لَسَرِيعُ ٱلْعِقَابِۖ وَإِنَّهُۥ لَغَفُورٌ رَّحِيمٌ ", "translation": "And [mention] when your Lord declared that He would surely [continue to] send upon them until the Day of Resurrection those who would afflict them with the worst torment. Indeed, your Lord is swift in penalty; but indeed, He is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "تَأَذَّنَ", "translit": "َnَّhdَaʾَt", "root": "اذن"}, {"id": 3, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 4, "arabic": "لَيَبْعَثَنَّ", "translit": "َّnَhtَʿعْbَyَl", "root": "بعث"}, {"id": 5, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 6, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 7, "arabic": "يَوْمِ", "translit": "ِmْwَy", "root": "يوم"}, {"id": 8, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 9, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 10, "arabic": "يَسُومُهُمْ", "translit": "ْmُhُmwُsَy", "root": "سوم"}, {"id": 11, "arabic": "سُوٓءَ", "translit": "َءٓwُs", "root": "سوا"}, {"id": 12, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 13, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 14, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 15, "arabic": "لَسَرِيعُ", "translit": "ُʿعyِrَsَl", "root": "سرع"}, {"id": 16, "arabic": "ٱلْعِقَابِ", "translit": "ِbāَqِʿعْlٱ", "root": "عقب"}, {"id": 17, "arabic": "وَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَw", "root": ""}, {"id": 18, "arabic": "لَغَفُورٌ", "translit": "ٌrwُfَغَl", "root": "غفر"}, {"id": 19, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 168, "text": "وَقَطَّعْنَٰهُمْ فِى ٱلْأَرْضِ أُمَمًاۖ مِّنْهُمُ ٱلصَّٰلِحُونَ وَمِنْهُمْ دُونَ ذَٰلِكَۖ وَبَلَوْنَٰهُم بِٱلْحَسَنَٰتِ وَٱلسَّيِّـَٔاتِ لَعَلَّهُمْ يَرْجِعُونَ ", "translation": "And We divided them throughout the earth into nations. Of them some were righteous, and of them some were otherwise. And We tested them with good [times] and bad that perhaps they would return [to obedience].", "words": [{"id": 1, "arabic": "وَقَطَّعْنَٰهُمْ", "translit": "ْmُhَٰnْʿعَّṭَqَw", "root": "قطع"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 4, "arabic": "أُمَمًا", "translit": "āًmَmُaʾ", "root": "امم"}, {"id": 5, "arabic": "مِّنْهُمُ", "translit": "ُmُhْnِّm", "root": ""}, {"id": 6, "arabic": "ٱلصَّٰلِحُونَ", "translit": "َnwُḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 7, "arabic": "وَمِنْهُمْ", "translit": "ْmُhْnِmَw", "root": ""}, {"id": 8, "arabic": "دُونَ", "translit": "َnwُd", "root": "دون"}, {"id": 9, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 10, "arabic": "وَبَلَوْنَٰهُم", "translit": "mُhَٰnْwَlَbَw", "root": "بلو"}, {"id": 11, "arabic": "بِٱلْحَسَنَٰتِ", "translit": "ِtَٰnَsَḥْlٱِb", "root": "حسن"}, {"id": 12, "arabic": "وَٱلسَّيِّـَٔاتِ", "translit": "ِtāَٔـِّyَّslٱَw", "root": "سوا"}, {"id": 13, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 14, "arabic": "يَرْجِعُونَ", "translit": "َnwُʿعِjgْrَy", "root": "رجع"}], "hasIhya": false}, {"ayah": 169, "text": "فَخَلَفَ مِنۢ بَعْدِهِمْ خَلْفٌ وَرِثُوا۟ ٱلْكِتَٰبَ يَأْخُذُونَ عَرَضَ هَٰذَا ٱلْأَدْنَىٰ وَيَقُولُونَ سَيُغْفَرُ لَنَا وَإِن يَأْتِهِمْ عَرَضٌ مِّثْلُهُۥ يَأْخُذُوهُۚ أَلَمْ يُؤْخَذْ عَلَيْهِم مِّيثَٰقُ ٱلْكِتَٰبِ أَن لَّا يَقُولُوا۟ عَلَى ٱللَّهِ إِلَّا ٱلْحَقَّ وَدَرَسُوا۟ مَا فِيهِۗ وَٱلدَّارُ ٱلْءَاخِرَةُ خَيْرٌ لِّلَّذِينَ يَتَّقُونَۗ أَفَلَا تَعْقِلُونَ ", "translation": "And there followed them successors who inherited the Scripture [while] taking the commodities[1] of this lower life and saying, \"It will be forgiven for us.\" And if an offer like it[2] comes to them, they will [again] take it. Was not the covenant of the Scripture [i.e., the Torah] taken from them that they would not say about Allāh except the truth, and they studied what was in it? And the home of the Hereafter is better for those who fear Allāh, so will you not use reason?", "words": [{"id": 1, "arabic": "فَخَلَفَ", "translit": "َfَlَhkَf", "root": "خلف"}, {"id": 2, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 3, "arabic": "بَعْدِهِمْ", "translit": "ْmِhِdْʿعَb", "root": "بعد"}, {"id": 4, "arabic": "خَلْفٌ", "translit": "ٌfْlَhk", "root": "خلف"}, {"id": 5, "arabic": "وَرِثُوا۟", "translit": "۟āwُhtِrَw", "root": "ورث"}, {"id": 6, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 7, "arabic": "يَأْخُذُونَ", "translit": "َnwُhdُhkْaʾَy", "root": "اخذ"}, {"id": 8, "arabic": "عَرَضَ", "translit": "َḍَrَʿع", "root": "عرض"}, {"id": 9, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 10, "arabic": "ٱلْأَدْنَىٰ", "translit": "ٰàَnْdَaʾْlٱ", "root": "دنو"}, {"id": 11, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 12, "arabic": "سَيُغْفَرُ", "translit": "ُrَfْغُyَs", "root": "غفر"}, {"id": 13, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 14, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 15, "arabic": "يَأْتِهِمْ", "translit": "ْmِhِtْaʾَy", "root": "اتي"}, {"id": 16, "arabic": "عَرَضٌ", "translit": "ٌḍَrَʿع", "root": "عرض"}, {"id": 17, "arabic": "مِّثْلُهُۥ", "translit": "ۥُhُlْhtِّm", "root": "مثل"}, {"id": 18, "arabic": "يَأْخُذُوهُ", "translit": "ُhwُhdُhkْaʾَy", "root": "اخذ"}, {"id": 19, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 20, "arabic": "يُؤْخَذْ", "translit": "ْhdَhkْwʾُy", "root": "اخذ"}, {"id": 21, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 22, "arabic": "مِّيثَٰقُ", "translit": "ُqَٰhtyِّm", "root": "وثق"}, {"id": 23, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 24, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 25, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 26, "arabic": "يَقُولُوا۟", "translit": "۟āwُlwُqَy", "root": "قول"}, {"id": 27, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 28, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 29, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 30, "arabic": "ٱلْحَقَّ", "translit": "َّqَḥْlٱ", "root": "حقق"}, {"id": 31, "arabic": "وَدَرَسُوا۟", "translit": "۟āwُsَrَdَw", "root": "درس"}, {"id": 32, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 33, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 34, "arabic": "وَٱلدَّارُ", "translit": "ُrāَّdlٱَw", "root": "دور"}, {"id": 35, "arabic": "ٱلْءَاخِرَةُ", "translit": "ُẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 36, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 37, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 38, "arabic": "يَتَّقُونَ", "translit": "َnwُqَّtَy", "root": "وقي"}, {"id": 39, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 40, "arabic": "تَعْقِلُونَ", "translit": "َnwُlِqْʿعَt", "root": "عقل"}], "hasIhya": true}, {"ayah": 170, "text": "وَٱلَّذِينَ يُمَسِّكُونَ بِٱلْكِتَٰبِ وَأَقَامُوا۟ ٱلصَّلَوٰةَ إِنَّا لَا نُضِيعُ أَجْرَ ٱلْمُصْلِحِينَ ", "translation": "But those who hold fast to the Book [i.e., the Qur’ān] and establish prayer - indeed, We will not allow to be lost the reward of the reformers.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "يُمَسِّكُونَ", "translit": "َnwُkِّsَmُy", "root": "مسك"}, {"id": 3, "arabic": "بِٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱِb", "root": "كتب"}, {"id": 4, "arabic": "وَأَقَامُوا۟", "translit": "۟āwُmāَqَaʾَw", "root": "قوم"}, {"id": 5, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 6, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "نُضِيعُ", "translit": "ُʿعyِḍُn", "root": "ضيع"}, {"id": 9, "arabic": "أَجْرَ", "translit": "َrْjgَaʾ", "root": "اجر"}, {"id": 10, "arabic": "ٱلْمُصْلِحِينَ", "translit": "َnyِḥِlْṣُmْlٱ", "root": "صلح"}], "hasIhya": false}, {"ayah": 171, "text": "وَإِذْ نَتَقْنَا ٱلْجَبَلَ فَوْقَهُمْ كَأَنَّهُۥ ظُلَّةٌ وَظَنُّوٓا۟ أَنَّهُۥ وَاقِعٌۢ بِهِمْ خُذُوا۟ مَآ ءَاتَيْنَٰكُم بِقُوَّةٍ وَٱذْكُرُوا۟ مَا فِيهِ لَعَلَّكُمْ تَتَّقُونَ ", "translation": "And [mention] when We raised the mountain above them as if it was a dark cloud and they were certain that it would fall upon them,[1] [and Allāh said], \"Take what We have given you with determination and remember what is in it that you might fear Allāh.\"", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "نَتَقْنَا", "translit": "āَnْqَtَn", "root": "نتق"}, {"id": 3, "arabic": "ٱلْجَبَلَ", "translit": "َlَbَjgْlٱ", "root": "جبل"}, {"id": 4, "arabic": "فَوْقَهُمْ", "translit": "ْmُhَqْwَf", "root": "فوق"}, {"id": 5, "arabic": "كَأَنَّهُۥ", "translit": "ۥُhَّnَaʾَk", "root": ""}, {"id": 6, "arabic": "ظُلَّةٌ", "translit": "ٌẗَّlُẓ", "root": "ظلل"}, {"id": 7, "arabic": "وَظَنُّوٓا۟", "translit": "۟āٓwُّnَẓَw", "root": "ظنن"}, {"id": 8, "arabic": "أَنَّهُۥ", "translit": "ۥُhَّnَaʾ", "root": ""}, {"id": 9, "arabic": "وَاقِعٌۢ", "translit": "ٌۢʿعِqāَw", "root": "وقع"}, {"id": 10, "arabic": "بِهِمْ", "translit": "ْmِhِb", "root": ""}, {"id": 11, "arabic": "خُذُوا۟", "translit": "۟āwُhdُhk", "root": "اخذ"}, {"id": 12, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 13, "arabic": "ءَاتَيْنَٰكُم", "translit": "mُkَٰnْyَtāَء", "root": "اتي"}, {"id": 14, "arabic": "بِقُوَّةٍ", "translit": "ٍẗَّwُqِb", "root": "قوي"}, {"id": 15, "arabic": "وَٱذْكُرُوا۟", "translit": "۟āwُrُkْhdٱَw", "root": "ذكر"}, {"id": 16, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 17, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 18, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 19, "arabic": "تَتَّقُونَ", "translit": "َnwُqَّtَt", "root": "وقي"}], "hasIhya": false}, {"ayah": 172, "text": "وَإِذْ أَخَذَ رَبُّكَ مِنۢ بَنِىٓ ءَادَمَ مِن ظُهُورِهِمْ ذُرِّيَّتَهُمْ وَأَشْهَدَهُمْ عَلَىٰٓ أَنفُسِهِمْ أَلَسْتُ بِرَبِّكُمْۖ قَالُوا۟ بَلَىٰۛ شَهِدْنَآۛ أَن تَقُولُوا۟ يَوْمَ ٱلْقِيَٰمَةِ إِنَّا كُنَّا عَنْ هَٰذَا غَٰفِلِينَ ", "translation": "And [mention] when your Lord took from the children of Adam - from their loins - their descendants and made them testify of themselves, [saying to them], \"Am I not your Lord?\" They said, \"Yes, we have testified.\" [This] - lest you should say on the Day of Resurrection, \"Indeed, we were of this unaware.\"", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "أَخَذَ", "translit": "َhdَhkَaʾ", "root": "اخذ"}, {"id": 3, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 4, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 5, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 6, "arabic": "ءَادَمَ", "translit": "َmَdāَء", "root": "ادم"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "ظُهُورِهِمْ", "translit": "ْmِhِrwُhُẓ", "root": "ظهر"}, {"id": 9, "arabic": "ذُرِّيَّتَهُمْ", "translit": "ْmُhَtَّyِّrُhd", "root": "ذرر"}, {"id": 10, "arabic": "وَأَشْهَدَهُمْ", "translit": "ْmُhَdَhْhsَaʾَw", "root": "شهد"}, {"id": 11, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 12, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 13, "arabic": "أَلَسْتُ", "translit": "ُtْsَlَaʾ", "root": "ليس"}, {"id": 14, "arabic": "بِرَبِّكُمْ", "translit": "ْmُkِّbَrِb", "root": "ربب"}, {"id": 15, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 16, "arabic": "بَلَىٰ", "translit": "ٰàَlَb", "root": ""}, {"id": 17, "arabic": "شَهِدْنَآ", "translit": "ٓāَnْdِhَhs", "root": "شهد"}, {"id": 18, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 19, "arabic": "تَقُولُوا۟", "translit": "۟āwُlwُqَt", "root": "قول"}, {"id": 20, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 21, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 22, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 23, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 24, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 25, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 26, "arabic": "غَٰفِلِينَ", "translit": "َnyِlِfَٰغ", "root": "غفل"}], "hasIhya": true}, {"ayah": 173, "text": "أَوْ تَقُولُوٓا۟ إِنَّمَآ أَشْرَكَ ءَابَآؤُنَا مِن قَبْلُ وَكُنَّا ذُرِّيَّةً مِّنۢ بَعْدِهِمْۖ أَفَتُهْلِكُنَا بِمَا فَعَلَ ٱلْمُبْطِلُونَ ", "translation": "Or [lest] you say, \"It was only that our fathers associated [others in worship] with Allāh before, and we were but descendants after them. Then would You destroy us for what the falsifiers have done?\"", "words": [{"id": 1, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 2, "arabic": "تَقُولُوٓا۟", "translit": "۟āٓwُlwُqَt", "root": "قول"}, {"id": 3, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 4, "arabic": "أَشْرَكَ", "translit": "َkَrْhsَaʾ", "root": "شرك"}, {"id": 5, "arabic": "ءَابَآؤُنَا", "translit": "āَnُwʾٓāَbāَء", "root": "ابو"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 8, "arabic": "وَكُنَّا", "translit": "āَّnُkَw", "root": "كون"}, {"id": 9, "arabic": "ذُرِّيَّةً", "translit": "ًẗَّyِّrُhd", "root": "ذرر"}, {"id": 10, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 11, "arabic": "بَعْدِهِمْ", "translit": "ْmِhِdْʿعَb", "root": "بعد"}, {"id": 12, "arabic": "أَفَتُهْلِكُنَا", "translit": "āَnُkِlْhُtَfَaʾ", "root": "هلك"}, {"id": 13, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 14, "arabic": "فَعَلَ", "translit": "َlَʿعَf", "root": "فعل"}, {"id": 15, "arabic": "ٱلْمُبْطِلُونَ", "translit": "َnwُlِṭْbُmْlٱ", "root": "بطل"}], "hasIhya": false}, {"ayah": 174, "text": "وَكَذَٰلِكَ نُفَصِّلُ ٱلْءَايَٰتِ وَلَعَلَّهُمْ يَرْجِعُونَ ", "translation": "And thus do We [explain in] detail the verses, and perhaps they will return.[1]", "words": [{"id": 1, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 2, "arabic": "نُفَصِّلُ", "translit": "ُlِّṣَfُn", "root": "فصل"}, {"id": 3, "arabic": "ٱلْءَايَٰتِ", "translit": "ِtَٰyāَءْlٱ", "root": "ايي"}, {"id": 4, "arabic": "وَلَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَlَw", "root": ""}, {"id": 5, "arabic": "يَرْجِعُونَ", "translit": "َnwُʿعِjgْrَy", "root": "رجع"}], "hasIhya": false}, {"ayah": 175, "text": "وَٱتْلُ عَلَيْهِمْ نَبَأَ ٱلَّذِىٓ ءَاتَيْنَٰهُ ءَايَٰتِنَا فَٱنسَلَخَ مِنْهَا فَأَتْبَعَهُ ٱلشَّيْطَٰنُ فَكَانَ مِنَ ٱلْغَاوِينَ ", "translation": "And recite to them, [O Muḥammad], the news of him[1] to whom We gave [knowledge of] Our signs, but he detached himself from them; so Satan pursued him, and he became of the deviators.[2]", "words": [{"id": 1, "arabic": "وَٱتْلُ", "translit": "ُlْtٱَw", "root": "تلو"}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "نَبَأَ", "translit": "َaʾَbَn", "root": "نبا"}, {"id": 4, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "ءَاتَيْنَٰهُ", "translit": "ُhَٰnْyَtāَء", "root": "اتي"}, {"id": 6, "arabic": "ءَايَٰتِنَا", "translit": "āَnِtَٰyāَء", "root": "ايي"}, {"id": 7, "arabic": "فَٱنسَلَخَ", "translit": "َhkَlَsnٱَf", "root": "سلخ"}, {"id": 8, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 9, "arabic": "فَأَتْبَعَهُ", "translit": "ُhَʿعَbْtَaʾَf", "root": "تبع"}, {"id": 10, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 11, "arabic": "فَكَانَ", "translit": "َnāَkَf", "root": "كون"}, {"id": 12, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 13, "arabic": "ٱلْغَاوِينَ", "translit": "َnyِwāَغْlٱ", "root": "غوي"}], "hasIhya": true}, {"ayah": 176, "text": "وَلَوْ شِئْنَا لَرَفَعْنَٰهُ بِهَا وَلَٰكِنَّهُۥٓ أَخْلَدَ إِلَى ٱلْأَرْضِ وَٱتَّبَعَ هَوَىٰهُۚ فَمَثَلُهُۥ كَمَثَلِ ٱلْكَلْبِ إِن تَحْمِلْ عَلَيْهِ يَلْهَثْ أَوْ تَتْرُكْهُ يَلْهَثۚ ذَّٰلِكَ مَثَلُ ٱلْقَوْمِ ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَاۚ فَٱقْصُصِ ٱلْقَصَصَ لَعَلَّهُمْ يَتَفَكَّرُونَ ", "translation": "And if We had willed, We could have elevated him thereby,[1] but he adhered [instead] to the earth[2] and followed his own desire. So his example is like that of the dog: if you chase him, he pants, or if you leave him, he [still] pants. That is the example of the people who denied Our signs.[3] So relate the stories that perhaps they will give thought.", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "شِئْنَا", "translit": "āَnْyʾِhs", "root": "شيا"}, {"id": 3, "arabic": "لَرَفَعْنَٰهُ", "translit": "ُhَٰnْʿعَfَrَl", "root": "رفع"}, {"id": 4, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 5, "arabic": "وَلَٰكِنَّهُۥٓ", "translit": "ٓۥُhَّnِkَٰlَw", "root": ""}, {"id": 6, "arabic": "أَخْلَدَ", "translit": "َdَlْhkَaʾ", "root": "خلد"}, {"id": 7, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "وَٱتَّبَعَ", "translit": "َʿعَbَّtٱَw", "root": "تبع"}, {"id": 10, "arabic": "هَوَىٰهُ", "translit": "ُhٰàَwَh", "root": "هوي"}, {"id": 11, "arabic": "فَمَثَلُهُۥ", "translit": "ۥُhُlَhtَmَf", "root": "مثل"}, {"id": 12, "arabic": "كَمَثَلِ", "translit": "ِlَhtَmَk", "root": "مثل"}, {"id": 13, "arabic": "ٱلْكَلْبِ", "translit": "ِbْlَkْlٱ", "root": "كلب"}, {"id": 14, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 15, "arabic": "تَحْمِلْ", "translit": "ْlِmْḥَt", "root": "حمل"}, {"id": 16, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 17, "arabic": "يَلْهَثْ", "translit": "ْhtَhْlَy", "root": "لهث"}, {"id": 18, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 19, "arabic": "تَتْرُكْهُ", "translit": "ُhْkُrْtَt", "root": "ترك"}, {"id": 20, "arabic": "يَلْهَث", "translit": "htَhْlَy", "root": "لهث"}, {"id": 21, "arabic": "ذَّٰلِكَ", "translit": "َkِlَّٰhd", "root": ""}, {"id": 22, "arabic": "مَثَلُ", "translit": "ُlَhtَm", "root": "مثل"}, {"id": 23, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 24, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 25, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 26, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 27, "arabic": "فَٱقْصُصِ", "translit": "ِṣُṣْqٱَf", "root": "قصص"}, {"id": 28, "arabic": "ٱلْقَصَصَ", "translit": "َṣَṣَqْlٱ", "root": "قصص"}, {"id": 29, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 30, "arabic": "يَتَفَكَّرُونَ", "translit": "َnwُrَّkَfَtَy", "root": "فكر"}], "hasIhya": true}, {"ayah": 177, "text": "سَآءَ مَثَلًا ٱلْقَوْمُ ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَا وَأَنفُسَهُمْ كَانُوا۟ يَظْلِمُونَ ", "translation": "How evil an example [is that of] the people who denied Our signs and used to wrong themselves.", "words": [{"id": 1, "arabic": "سَآءَ", "translit": "َءٓāَs", "root": "سوا"}, {"id": 2, "arabic": "مَثَلًا", "translit": "āًlَhtَm", "root": "مثل"}, {"id": 3, "arabic": "ٱلْقَوْمُ", "translit": "ُmْwَqْlٱ", "root": "قوم"}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 6, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 7, "arabic": "وَأَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾَw", "root": "نفس"}, {"id": 8, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 9, "arabic": "يَظْلِمُونَ", "translit": "َnwُmِlْẓَy", "root": "ظلم"}], "hasIhya": false}, {"ayah": 178, "text": "مَن يَهْدِ ٱللَّهُ فَهُوَ ٱلْمُهْتَدِىۖ وَمَن يُضْلِلْ فَأُو۟لَٰٓئِكَ هُمُ ٱلْخَٰسِرُونَ ", "translation": "Whoever Allāh guides - he is the [rightly] guided; and whoever He sends astray[1] - it is those who are the losers.", "words": [{"id": 1, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 2, "arabic": "يَهْدِ", "translit": "ِdْhَy", "root": "هدي"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "فَهُوَ", "translit": "َwُhَf", "root": ""}, {"id": 5, "arabic": "ٱلْمُهْتَدِى", "translit": "àِdَtْhُmْlٱ", "root": "هدي"}, {"id": 6, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 7, "arabic": "يُضْلِلْ", "translit": "ْlِlْḍُy", "root": "ضلل"}, {"id": 8, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 9, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 10, "arabic": "ٱلْخَٰسِرُونَ", "translit": "َnwُrِsَٰhkْlٱ", "root": "خسر"}], "hasIhya": false}, {"ayah": 179, "text": "وَلَقَدْ ذَرَأْنَا لِجَهَنَّمَ كَثِيرًا مِّنَ ٱلْجِنِّ وَٱلْإِنسِۖ لَهُمْ قُلُوبٌ لَّا يَفْقَهُونَ بِهَا وَلَهُمْ أَعْيُنٌ لَّا يُبْصِرُونَ بِهَا وَلَهُمْ ءَاذَانٌ لَّا يَسْمَعُونَ بِهَآۚ أُو۟لَٰٓئِكَ كَٱلْأَنْعَٰمِ بَلْ هُمْ أَضَلُّۚ أُو۟لَٰٓئِكَ هُمُ ٱلْغَٰفِلُونَ ", "translation": "And We have certainly created for Hell many of the jinn and mankind. They have hearts with which they do not understand, they have eyes with which they do not see, and they have ears with which they do not hear. Those are like livestock; rather, they are more astray.[1] It is they who are the heedless.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "ذَرَأْنَا", "translit": "āَnْaʾَrَhd", "root": "ذرا"}, {"id": 3, "arabic": "لِجَهَنَّمَ", "translit": "َmَّnَhَjgِl", "root": ""}, {"id": 4, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 5, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 6, "arabic": "ٱلْجِنِّ", "translit": "ِّnِjgْlٱ", "root": "جنن"}, {"id": 7, "arabic": "وَٱلْإِنسِ", "translit": "ِsnِiʾْlٱَw", "root": "انس"}, {"id": 8, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 9, "arabic": "قُلُوبٌ", "translit": "ٌbwُlُq", "root": "قلب"}, {"id": 10, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 11, "arabic": "يَفْقَهُونَ", "translit": "َnwُhَqْfَy", "root": "فقه"}, {"id": 12, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 13, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 14, "arabic": "أَعْيُنٌ", "translit": "ٌnُyْʿعَaʾ", "root": "عين"}, {"id": 15, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 16, "arabic": "يُبْصِرُونَ", "translit": "َnwُrِṣْbُy", "root": "بصر"}, {"id": 17, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 18, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 19, "arabic": "ءَاذَانٌ", "translit": "ٌnāَhdāَء", "root": "اذن"}, {"id": 20, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 21, "arabic": "يَسْمَعُونَ", "translit": "َnwُʿعَmْsَy", "root": "سمع"}, {"id": 22, "arabic": "بِهَآ", "translit": "ٓāَhِb", "root": ""}, {"id": 23, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 24, "arabic": "كَٱلْأَنْعَٰمِ", "translit": "ِmَٰʿعْnَaʾْlٱَk", "root": "نعم"}, {"id": 25, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 26, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 27, "arabic": "أَضَلُّ", "translit": "ُّlَḍَaʾ", "root": "ضلل"}, {"id": 28, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 29, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 30, "arabic": "ٱلْغَٰفِلُونَ", "translit": "َnwُlِfَٰغْlٱ", "root": "غفل"}], "hasIhya": true}, {"ayah": 180, "text": "وَلِلَّهِ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ فَٱدْعُوهُ بِهَاۖ وَذَرُوا۟ ٱلَّذِينَ يُلْحِدُونَ فِىٓ أَسْمَٰٓئِهِۦۚ سَيُجْزَوْنَ مَا كَانُوا۟ يَعْمَلُونَ ", "translation": "And to Allāh belong the best names, so invoke Him by them. And leave [the company of] those who practice deviation concerning His names.[1] They will be recompensed for what they have been doing.", "words": [{"id": 1, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 2, "arabic": "ٱلْأَسْمَآءُ", "translit": "ُءٓāَmْsَaʾْlٱ", "root": "سمو"}, {"id": 3, "arabic": "ٱلْحُسْنَىٰ", "translit": "ٰàَnْsُḥْlٱ", "root": "حسن"}, {"id": 4, "arabic": "فَٱدْعُوهُ", "translit": "ُhwُʿعْdٱَf", "root": "دعو"}, {"id": 5, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 6, "arabic": "وَذَرُوا۟", "translit": "۟āwُrَhdَw", "root": "وذر"}, {"id": 7, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "يُلْحِدُونَ", "translit": "َnwُdِḥْlُy", "root": "لحد"}, {"id": 9, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 10, "arabic": "أَسْمَٰٓئِهِۦ", "translit": "ۦِhِyʾَٰٓmْsَaʾ", "root": "سمو"}, {"id": 11, "arabic": "سَيُجْزَوْنَ", "translit": "َnْwَzْjgُyَs", "root": "جزي"}, {"id": 12, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 13, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 14, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 181, "text": "وَمِمَّنْ خَلَقْنَآ أُمَّةٌ يَهْدُونَ بِٱلْحَقِّ وَبِهِۦ يَعْدِلُونَ ", "translation": "And among those We created is a community[1] which guides by truth and thereby establishes justice.", "words": [{"id": 1, "arabic": "وَمِمَّنْ", "translit": "ْnَّmِmَw", "root": ""}, {"id": 2, "arabic": "خَلَقْنَآ", "translit": "ٓāَnْqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "أُمَّةٌ", "translit": "ٌẗَّmُaʾ", "root": "امم"}, {"id": 4, "arabic": "يَهْدُونَ", "translit": "َnwُdْhَy", "root": "هدي"}, {"id": 5, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 6, "arabic": "وَبِهِۦ", "translit": "ۦِhِbَw", "root": ""}, {"id": 7, "arabic": "يَعْدِلُونَ", "translit": "َnwُlِdْʿعَy", "root": "عدل"}], "hasIhya": false}, {"ayah": 182, "text": "وَٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَا سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ ", "translation": "But those who deny Our signs - We will progressively lead them [to destruction][1] from where they do not know.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 3, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 4, "arabic": "سَنَسْتَدْرِجُهُم", "translit": "mُhُjgِrْdَtْsَnَs", "root": "درج"}, {"id": 5, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 6, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": true}, {"ayah": 183, "text": "وَأُمْلِى لَهُمْۚ إِنَّ كَيْدِى مَتِينٌ ", "translation": "And I will give them time. Indeed, My plan is firm.", "words": [{"id": 1, "arabic": "وَأُمْلِى", "translit": "àِlْmُaʾَw", "root": "ملو"}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 4, "arabic": "كَيْدِى", "translit": "àِdْyَk", "root": "كيد"}, {"id": 5, "arabic": "مَتِينٌ", "translit": "ٌnyِtَm", "root": "متن"}], "hasIhya": false}, {"ayah": 184, "text": "أَوَلَمْ يَتَفَكَّرُوا۟ۗ مَا بِصَاحِبِهِم مِّن جِنَّةٍۚ إِنْ هُوَ إِلَّا نَذِيرٌ مُّبِينٌ ", "translation": "Then do they not give thought? There is in their companion [i.e., Muḥammad (ﷺ)] no madness. He is not but a clear warner.", "words": [{"id": 1, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 2, "arabic": "يَتَفَكَّرُوا۟", "translit": "۟āwُrَّkَfَtَy", "root": "فكر"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "بِصَاحِبِهِم", "translit": "mِhِbِḥāَṣِb", "root": "صحب"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "جِنَّةٍ", "translit": "ٍẗَّnِjg", "root": "جنن"}, {"id": 7, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 8, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "نَذِيرٌ", "translit": "ٌryِhdَn", "root": "نذر"}, {"id": 11, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 185, "text": "أَوَلَمْ يَنظُرُوا۟ فِى مَلَكُوتِ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا خَلَقَ ٱللَّهُ مِن شَىْءٍ وَأَنْ عَسَىٰٓ أَن يَكُونَ قَدِ ٱقْتَرَبَ أَجَلُهُمْۖ فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ ", "translation": "Do they not look into the realm of the heavens and the earth and everything that Allāh has created and [think] that perhaps their appointed time has come near? So in what statement [i.e., message] hereafter will they believe?", "words": [{"id": 1, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 2, "arabic": "يَنظُرُوا۟", "translit": "۟āwُrُẓnَy", "root": "نظر"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "مَلَكُوتِ", "translit": "ِtwُkَlَm", "root": "ملك"}, {"id": 5, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 7, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 8, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 12, "arabic": "وَأَنْ", "translit": "ْnَaʾَw", "root": ""}, {"id": 13, "arabic": "عَسَىٰٓ", "translit": "ٰٓàَsَʿع", "root": "عسي"}, {"id": 14, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 15, "arabic": "يَكُونَ", "translit": "َnwُkَy", "root": "كون"}, {"id": 16, "arabic": "قَدِ", "translit": "ِdَq", "root": ""}, {"id": 17, "arabic": "ٱقْتَرَبَ", "translit": "َbَrَtْqٱ", "root": "قرب"}, {"id": 18, "arabic": "أَجَلُهُمْ", "translit": "ْmُhُlَjgَaʾ", "root": "اجل"}, {"id": 19, "arabic": "فَبِأَىِّ", "translit": "ِّàَaʾِbَf", "root": "ايي"}, {"id": 20, "arabic": "حَدِيثٍۭ", "translit": "ٍۭhtyِdَḥ", "root": "حدث"}, {"id": 21, "arabic": "بَعْدَهُۥ", "translit": "ۥُhَdْʿعَb", "root": "بعد"}, {"id": 22, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": true}, {"ayah": 186, "text": "مَن يُضْلِلِ ٱللَّهُ فَلَا هَادِىَ لَهُۥۚ وَيَذَرُهُمْ فِى طُغْيَٰنِهِمْ يَعْمَهُونَ ", "translation": "Whoever Allāh sends astray - there is no guide for him. And He leaves them in their transgression, wandering blindly.", "words": [{"id": 1, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 2, "arabic": "يُضْلِلِ", "translit": "ِlِlْḍُy", "root": "ضلل"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 5, "arabic": "هَادِىَ", "translit": "َàِdāَh", "root": "هدي"}, {"id": 6, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 7, "arabic": "وَيَذَرُهُمْ", "translit": "ْmُhُrَhdَyَw", "root": "وذر"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "طُغْيَٰنِهِمْ", "translit": "ْmِhِnَٰyْغُṭ", "root": "طغي"}, {"id": 10, "arabic": "يَعْمَهُونَ", "translit": "َnwُhَmْʿعَy", "root": "عمه"}], "hasIhya": false}, {"ayah": 187, "text": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَاۖ قُلْ إِنَّمَا عِلْمُهَا عِندَ رَبِّىۖ لَا يُجَلِّيهَا لِوَقْتِهَآ إِلَّا هُوَۚ ثَقُلَتْ فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ لَا تَأْتِيكُمْ إِلَّا بَغْتَةًۗ يَسْـَٔلُونَكَ كَأَنَّكَ حَفِىٌّ عَنْهَاۖ قُلْ إِنَّمَا عِلْمُهَا عِندَ ٱللَّهِ وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَعْلَمُونَ ", "translation": "They ask you, [O Muḥammad], about the Hour: when is its arrival?[1] Say, \"Its knowledge is only with my Lord. None will reveal its time except Him. It lays heavily[2] upon the heavens and the earth. It will not come upon you except unexpectedly.\" They ask you as if you are familiar with it. Say, \"Its knowledge is only with Allāh, but most of the people do not know.\"", "words": [{"id": 1, "arabic": "يَسْـَٔلُونَكَ", "translit": "َkَnwُlَٔـْsَy", "root": "سال"}, {"id": 2, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 3, "arabic": "ٱلسَّاعَةِ", "translit": "ِẗَʿعāَّslٱ", "root": "سوع"}, {"id": 4, "arabic": "أَيَّانَ", "translit": "َnāَّyَaʾ", "root": ""}, {"id": 5, "arabic": "مُرْسَىٰهَا", "translit": "āَhٰàَsْrُm", "root": "رسو"}, {"id": 6, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 7, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 8, "arabic": "عِلْمُهَا", "translit": "āَhُmْlِʿع", "root": "علم"}, {"id": 9, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 10, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "يُجَلِّيهَا", "translit": "āَhyِّlَjgُy", "root": "جلو"}, {"id": 13, "arabic": "لِوَقْتِهَآ", "translit": "ٓāَhِtْqَwِl", "root": "وقت"}, {"id": 14, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 15, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 16, "arabic": "ثَقُلَتْ", "translit": "ْtَlُqَht", "root": "ثقل"}, {"id": 17, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 18, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 19, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 20, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 21, "arabic": "تَأْتِيكُمْ", "translit": "ْmُkyِtْaʾَt", "root": "اتي"}, {"id": 22, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 23, "arabic": "بَغْتَةً", "translit": "ًẗَtْغَb", "root": "بغت"}, {"id": 24, "arabic": "يَسْـَٔلُونَكَ", "translit": "َkَnwُlَٔـْsَy", "root": "سال"}, {"id": 25, "arabic": "كَأَنَّكَ", "translit": "َkَّnَaʾَk", "root": ""}, {"id": 26, "arabic": "حَفِىٌّ", "translit": "ٌّàِfَḥ", "root": "حفو"}, {"id": 27, "arabic": "عَنْهَا", "translit": "āَhْnَʿع", "root": ""}, {"id": 28, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 29, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 30, "arabic": "عِلْمُهَا", "translit": "āَhُmْlِʿع", "root": "علم"}, {"id": 31, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 32, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 33, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 34, "arabic": "أَكْثَرَ", "translit": "َrَhtْkَaʾ", "root": "كثر"}, {"id": 35, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 36, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 37, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": true}, {"ayah": 188, "text": "قُل لَّآ أَمْلِكُ لِنَفْسِى نَفْعًا وَلَا ضَرًّا إِلَّا مَا شَآءَ ٱللَّهُۚ وَلَوْ كُنتُ أَعْلَمُ ٱلْغَيْبَ لَٱسْتَكْثَرْتُ مِنَ ٱلْخَيْرِ وَمَا مَسَّنِىَ ٱلسُّوٓءُۚ إِنْ أَنَا۠ إِلَّا نَذِيرٌ وَبَشِيرٌ لِّقَوْمٍ يُؤْمِنُونَ ", "translation": "Say, \"I hold not for myself [the power of] benefit or harm, except what Allāh has willed. And if I knew the unseen, I could have acquired much wealth, and no harm would have touched me. I am not except a warner and a bringer of good tidings to a people who believe.\"", "words": [{"id": 1, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 2, "arabic": "لَّآ", "translit": "ٓāَّl", "root": ""}, {"id": 3, "arabic": "أَمْلِكُ", "translit": "ُkِlْmَaʾ", "root": "ملك"}, {"id": 4, "arabic": "لِنَفْسِى", "translit": "àِsْfَnِl", "root": "نفس"}, {"id": 5, "arabic": "نَفْعًا", "translit": "āًʿعْfَn", "root": "نفع"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "ضَرًّا", "translit": "āًّrَḍ", "root": "ضرر"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 11, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 13, "arabic": "كُنتُ", "translit": "ُtnُk", "root": "كون"}, {"id": 14, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 15, "arabic": "ٱلْغَيْبَ", "translit": "َbْyَغْlٱ", "root": "غيب"}, {"id": 16, "arabic": "لَٱسْتَكْثَرْتُ", "translit": "ُtْrَhtْkَtْsٱَl", "root": "كثر"}, {"id": 17, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 18, "arabic": "ٱلْخَيْرِ", "translit": "ِrْyَhkْlٱ", "root": "خير"}, {"id": 19, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 20, "arabic": "مَسَّنِىَ", "translit": "َàِnَّsَm", "root": "مسس"}, {"id": 21, "arabic": "ٱلسُّوٓءُ", "translit": "ُءٓwُّslٱ", "root": "سوا"}, {"id": 22, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 23, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 24, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 25, "arabic": "نَذِيرٌ", "translit": "ٌryِhdَn", "root": "نذر"}, {"id": 26, "arabic": "وَبَشِيرٌ", "translit": "ٌryِhsَbَw", "root": "بشر"}, {"id": 27, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 28, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": true}, {"ayah": 189, "text": "هُوَ ٱلَّذِى خَلَقَكُم مِّن نَّفْسٍ وَٰحِدَةٍ وَجَعَلَ مِنْهَا زَوْجَهَا لِيَسْكُنَ إِلَيْهَاۖ فَلَمَّا تَغَشَّىٰهَا حَمَلَتْ حَمْلًا خَفِيفًا فَمَرَّتْ بِهِۦۖ فَلَمَّآ أَثْقَلَت دَّعَوَا ٱللَّهَ رَبَّهُمَا لَئِنْ ءَاتَيْتَنَا صَٰلِحًا لَّنَكُونَنَّ مِنَ ٱلشَّٰكِرِينَ ", "translation": "It is He who created you from one soul and created from it its mate that he[1] might dwell in security with her. And when he [i.e., man] covers her,[2] she carries a light burden [i.e., a pregnancy] and continues therein. And when it becomes heavy, they both invoke Allāh, their Lord, \"If You should give us a good[3] [child], we will surely be among the grateful.\"", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "خَلَقَكُم", "translit": "mُkَqَlَhk", "root": "خلق"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "نَّفْسٍ", "translit": "ٍsْfَّn", "root": "نفس"}, {"id": 6, "arabic": "وَٰحِدَةٍ", "translit": "ٍẗَdِḥَٰw", "root": "وحد"}, {"id": 7, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 8, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 9, "arabic": "زَوْجَهَا", "translit": "āَhَjgْwَz", "root": "زوج"}, {"id": 10, "arabic": "لِيَسْكُنَ", "translit": "َnُkْsَyِl", "root": "سكن"}, {"id": 11, "arabic": "إِلَيْهَا", "translit": "āَhْyَlِiʾ", "root": ""}, {"id": 12, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 13, "arabic": "تَغَشَّىٰهَا", "translit": "āَhٰàَّhsَغَt", "root": "غشو"}, {"id": 14, "arabic": "حَمَلَتْ", "translit": "ْtَlَmَḥ", "root": "حمل"}, {"id": 15, "arabic": "حَمْلًا", "translit": "āًlْmَḥ", "root": "حمل"}, {"id": 16, "arabic": "خَفِيفًا", "translit": "āًfyِfَhk", "root": "خفف"}, {"id": 17, "arabic": "فَمَرَّتْ", "translit": "ْtَّrَmَf", "root": "مرر"}, {"id": 18, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 19, "arabic": "فَلَمَّآ", "translit": "ٓāَّmَlَf", "root": ""}, {"id": 20, "arabic": "أَثْقَلَت", "translit": "tَlَqْhtَaʾ", "root": "ثقل"}, {"id": 21, "arabic": "دَّعَوَا", "translit": "āَwَʿعَّd", "root": "دعو"}, {"id": 22, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "رَبَّهُمَا", "translit": "āَmُhَّbَr", "root": "ربب"}, {"id": 24, "arabic": "لَئِنْ", "translit": "ْnِyʾَl", "root": ""}, {"id": 25, "arabic": "ءَاتَيْتَنَا", "translit": "āَnَtْyَtāَء", "root": "اتي"}, {"id": 26, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 27, "arabic": "لَّنَكُونَنَّ", "translit": "َّnَnwُkَnَّl", "root": "كون"}, {"id": 28, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 29, "arabic": "ٱلشَّٰكِرِينَ", "translit": "َnyِrِkَّٰhslٱ", "root": "شكر"}], "hasIhya": false}, {"ayah": 190, "text": "فَلَمَّآ ءَاتَىٰهُمَا صَٰلِحًا جَعَلَا لَهُۥ شُرَكَآءَ فِيمَآ ءَاتَىٰهُمَاۚ فَتَعَٰلَى ٱللَّهُ عَمَّا يُشْرِكُونَ ", "translation": "But when He gives them a good [child], they[1] ascribe partners to Him concerning that which He has given them. Exalted is Allāh above what they associate with Him.", "words": [{"id": 1, "arabic": "فَلَمَّآ", "translit": "ٓāَّmَlَf", "root": ""}, {"id": 2, "arabic": "ءَاتَىٰهُمَا", "translit": "āَmُhٰàَtāَء", "root": "اتي"}, {"id": 3, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 4, "arabic": "جَعَلَا", "translit": "āَlَʿعَjg", "root": "جعل"}, {"id": 5, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 6, "arabic": "شُرَكَآءَ", "translit": "َءٓāَkَrُhs", "root": "شرك"}, {"id": 7, "arabic": "فِيمَآ", "translit": "ٓāَmyِf", "root": ""}, {"id": 8, "arabic": "ءَاتَىٰهُمَا", "translit": "āَmُhٰàَtāَء", "root": "اتي"}, {"id": 9, "arabic": "فَتَعَٰلَى", "translit": "àَlَٰʿعَtَf", "root": "علو"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 12, "arabic": "يُشْرِكُونَ", "translit": "َnwُkِrْhsُy", "root": "شرك"}], "hasIhya": false}, {"ayah": 191, "text": "أَيُشْرِكُونَ مَا لَا يَخْلُقُ شَيْـًٔا وَهُمْ يُخْلَقُونَ ", "translation": "Do they associate with Him those who create nothing and they are [themselves] created?", "words": [{"id": 1, "arabic": "أَيُشْرِكُونَ", "translit": "َnwُkِrْhsُyَaʾ", "root": "شرك"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يَخْلُقُ", "translit": "ُqُlْhkَy", "root": "خلق"}, {"id": 5, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 6, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 7, "arabic": "يُخْلَقُونَ", "translit": "َnwُqَlْhkُy", "root": "خلق"}], "hasIhya": false}, {"ayah": 192, "text": "وَلَا يَسْتَطِيعُونَ لَهُمْ نَصْرًا وَلَآ أَنفُسَهُمْ يَنصُرُونَ ", "translation": "And they [i.e., the false deities] are unable to [give] them help, nor can they help themselves.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "يَسْتَطِيعُونَ", "translit": "َnwُʿعyِṭَtْsَy", "root": "طوع"}, {"id": 3, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 4, "arabic": "نَصْرًا", "translit": "āًrْṣَn", "root": "نصر"}, {"id": 5, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 6, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 7, "arabic": "يَنصُرُونَ", "translit": "َnwُrُṣnَy", "root": "نصر"}], "hasIhya": false}, {"ayah": 193, "text": "وَإِن تَدْعُوهُمْ إِلَى ٱلْهُدَىٰ لَا يَتَّبِعُوكُمْۚ سَوَآءٌ عَلَيْكُمْ أَدَعَوْتُمُوهُمْ أَمْ أَنتُمْ صَٰمِتُونَ ", "translation": "And if you [believers] invite them to guidance, they will not follow you. It is all the same for you whether you invite them or you are silent.", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "تَدْعُوهُمْ", "translit": "ْmُhwُʿعْdَt", "root": "دعو"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلْهُدَىٰ", "translit": "ٰàَdُhْlٱ", "root": "هدي"}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "يَتَّبِعُوكُمْ", "translit": "ْmُkwُʿعِbَّtَy", "root": "تبع"}, {"id": 7, "arabic": "سَوَآءٌ", "translit": "ٌءٓāَwَs", "root": "سوي"}, {"id": 8, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 9, "arabic": "أَدَعَوْتُمُوهُمْ", "translit": "ْmُhwُmُtْwَʿعَdَaʾ", "root": "دعو"}, {"id": 10, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 11, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 12, "arabic": "صَٰمِتُونَ", "translit": "َnwُtِmَٰṣ", "root": "صمت"}], "hasIhya": false}, {"ayah": 194, "text": "إِنَّ ٱلَّذِينَ تَدْعُونَ مِن دُونِ ٱللَّهِ عِبَادٌ أَمْثَالُكُمْۖ فَٱدْعُوهُمْ فَلْيَسْتَجِيبُوا۟ لَكُمْ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "Indeed, those you [polytheists] call upon besides Allāh are servants [i.e., creations] like you. So call upon them and let them respond to you, if you should be truthful.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "تَدْعُونَ", "translit": "َnwُʿعْdَt", "root": "دعو"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "عِبَادٌ", "translit": "ٌdāَbِʿع", "root": "عبد"}, {"id": 8, "arabic": "أَمْثَالُكُمْ", "translit": "ْmُkُlāَhtْmَaʾ", "root": "مثل"}, {"id": 9, "arabic": "فَٱدْعُوهُمْ", "translit": "ْmُhwُʿعْdٱَf", "root": "دعو"}, {"id": 10, "arabic": "فَلْيَسْتَجِيبُوا۟", "translit": "۟āwُbyِjgَtْsَyْlَf", "root": "جوب"}, {"id": 11, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 12, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 13, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 14, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": true}, {"ayah": 195, "text": "أَلَهُمْ أَرْجُلٌ يَمْشُونَ بِهَآۖ أَمْ لَهُمْ أَيْدٍ يَبْطِشُونَ بِهَآۖ أَمْ لَهُمْ أَعْيُنٌ يُبْصِرُونَ بِهَآۖ أَمْ لَهُمْ ءَاذَانٌ يَسْمَعُونَ بِهَاۗ قُلِ ٱدْعُوا۟ شُرَكَآءَكُمْ ثُمَّ كِيدُونِ فَلَا تُنظِرُونِ ", "translation": "Do they have feet by which they walk? Or do they have hands by which they strike? Or do they have eyes by which they see? Or do they have ears by which they hear? Say, [O Muḥammad], \"Call your 'partners' and then conspire against me and give me no respite.", "words": [{"id": 1, "arabic": "أَلَهُمْ", "translit": "ْmُhَlَaʾ", "root": ""}, {"id": 2, "arabic": "أَرْجُلٌ", "translit": "ٌlُjgْrَaʾ", "root": "رجل"}, {"id": 3, "arabic": "يَمْشُونَ", "translit": "َnwُhsْmَy", "root": "مشي"}, {"id": 4, "arabic": "بِهَآ", "translit": "ٓāَhِb", "root": ""}, {"id": 5, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 6, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 7, "arabic": "أَيْدٍ", "translit": "ٍdْyَaʾ", "root": "يدي"}, {"id": 8, "arabic": "يَبْطِشُونَ", "translit": "َnwُhsِṭْbَy", "root": "بطش"}, {"id": 9, "arabic": "بِهَآ", "translit": "ٓāَhِb", "root": ""}, {"id": 10, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 11, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 12, "arabic": "أَعْيُنٌ", "translit": "ٌnُyْʿعَaʾ", "root": "عين"}, {"id": 13, "arabic": "يُبْصِرُونَ", "translit": "َnwُrِṣْbُy", "root": "بصر"}, {"id": 14, "arabic": "بِهَآ", "translit": "ٓāَhِb", "root": ""}, {"id": 15, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 16, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 17, "arabic": "ءَاذَانٌ", "translit": "ٌnāَhdāَء", "root": "اذن"}, {"id": 18, "arabic": "يَسْمَعُونَ", "translit": "َnwُʿعَmْsَy", "root": "سمع"}, {"id": 19, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 20, "arabic": "قُلِ", "translit": "ِlُq", "root": "قول"}, {"id": 21, "arabic": "ٱدْعُوا۟", "translit": "۟āwُʿعْdٱ", "root": "دعو"}, {"id": 22, "arabic": "شُرَكَآءَكُمْ", "translit": "ْmُkَءٓāَkَrُhs", "root": "شرك"}, {"id": 23, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 24, "arabic": "كِيدُونِ", "translit": "ِnwُdyِk", "root": "كيد"}, {"id": 25, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 26, "arabic": "تُنظِرُونِ", "translit": "ِnwُrِẓnُt", "root": "نظر"}], "hasIhya": false}, {"ayah": 196, "text": "إِنَّ وَلِۦِّىَ ٱللَّهُ ٱلَّذِى نَزَّلَ ٱلْكِتَٰبَۖ وَهُوَ يَتَوَلَّى ٱلصَّٰلِحِينَ ", "translation": "Indeed, my protector is Allāh, who has sent down the Book; and He is an ally to the righteous.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "وَلِۦِّىَ", "translit": "َàِّۦِlَw", "root": "ولي"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "نَزَّلَ", "translit": "َlَّzَn", "root": "نزل"}, {"id": 6, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 7, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 8, "arabic": "يَتَوَلَّى", "translit": "àَّlَwَtَy", "root": "ولي"}, {"id": 9, "arabic": "ٱلصَّٰلِحِينَ", "translit": "َnyِḥِlَّٰṣlٱ", "root": "صلح"}], "hasIhya": false}, {"ayah": 197, "text": "وَٱلَّذِينَ تَدْعُونَ مِن دُونِهِۦ لَا يَسْتَطِيعُونَ نَصْرَكُمْ وَلَآ أَنفُسَهُمْ يَنصُرُونَ ", "translation": "And those you call upon besides Him are unable to help you, nor can they help themselves.\"", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "تَدْعُونَ", "translit": "َnwُʿعْdَt", "root": "دعو"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "دُونِهِۦ", "translit": "ۦِhِnwُd", "root": "دون"}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "يَسْتَطِيعُونَ", "translit": "َnwُʿعyِṭَtْsَy", "root": "طوع"}, {"id": 7, "arabic": "نَصْرَكُمْ", "translit": "ْmُkَrْṣَn", "root": "نصر"}, {"id": 8, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 9, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 10, "arabic": "يَنصُرُونَ", "translit": "َnwُrُṣnَy", "root": "نصر"}], "hasIhya": false}, {"ayah": 198, "text": "وَإِن تَدْعُوهُمْ إِلَى ٱلْهُدَىٰ لَا يَسْمَعُوا۟ۖ وَتَرَىٰهُمْ يَنظُرُونَ إِلَيْكَ وَهُمْ لَا يُبْصِرُونَ ", "translation": "And if you invite them to guidance, they do not hear; and you see them looking at you while they do not see.", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "تَدْعُوهُمْ", "translit": "ْmُhwُʿعْdَt", "root": "دعو"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلْهُدَىٰ", "translit": "ٰàَdُhْlٱ", "root": "هدي"}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "يَسْمَعُوا۟", "translit": "۟āwُʿعَmْsَy", "root": "سمع"}, {"id": 7, "arabic": "وَتَرَىٰهُمْ", "translit": "ْmُhٰàَrَtَw", "root": "راي"}, {"id": 8, "arabic": "يَنظُرُونَ", "translit": "َnwُrُẓnَy", "root": "نظر"}, {"id": 9, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 10, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "يُبْصِرُونَ", "translit": "َnwُrِṣْbُy", "root": "بصر"}], "hasIhya": false}, {"ayah": 199, "text": "خُذِ ٱلْعَفْوَ وَأْمُرْ بِٱلْعُرْفِ وَأَعْرِضْ عَنِ ٱلْجَٰهِلِينَ ", "translation": "Take what is given freely,[1] enjoin what is good, and turn away from the ignorant.", "words": [{"id": 1, "arabic": "خُذِ", "translit": "ِhdُhk", "root": "اخذ"}, {"id": 2, "arabic": "ٱلْعَفْوَ", "translit": "َwْfَʿعْlٱ", "root": "عفو"}, {"id": 3, "arabic": "وَأْمُرْ", "translit": "ْrُmْaʾَw", "root": "امر"}, {"id": 4, "arabic": "بِٱلْعُرْفِ", "translit": "ِfْrُʿعْlٱِb", "root": "عرف"}, {"id": 5, "arabic": "وَأَعْرِضْ", "translit": "ْḍِrْʿعَaʾَw", "root": "عرض"}, {"id": 6, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 7, "arabic": "ٱلْجَٰهِلِينَ", "translit": "َnyِlِhَٰjgْlٱ", "root": "جهل"}], "hasIhya": true}, {"ayah": 200, "text": "وَإِمَّا يَنزَغَنَّكَ مِنَ ٱلشَّيْطَٰنِ نَزْغٌ فَٱسْتَعِذْ بِٱللَّهِۚ إِنَّهُۥ سَمِيعٌ عَلِيمٌ ", "translation": "And if an evil suggestion comes to you from Satan, then seek refuge in Allāh. Indeed, He is Hearing and Knowing.", "words": [{"id": 1, "arabic": "وَإِمَّا", "translit": "āَّmِiʾَw", "root": ""}, {"id": 2, "arabic": "يَنزَغَنَّكَ", "translit": "َkَّnَغَznَy", "root": "نزغ"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلشَّيْطَٰنِ", "translit": "ِnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 5, "arabic": "نَزْغٌ", "translit": "ٌغْzَn", "root": "نزغ"}, {"id": 6, "arabic": "فَٱسْتَعِذْ", "translit": "ْhdِʿعَtْsٱَf", "root": "عوذ"}, {"id": 7, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 8, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 9, "arabic": "سَمِيعٌ", "translit": "ٌʿعyِmَs", "root": "سمع"}, {"id": 10, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 201, "text": "إِنَّ ٱلَّذِينَ ٱتَّقَوْا۟ إِذَا مَسَّهُمْ طَٰٓئِفٌ مِّنَ ٱلشَّيْطَٰنِ تَذَكَّرُوا۟ فَإِذَا هُم مُّبْصِرُونَ ", "translation": "Indeed, those who fear Allāh - when an impulse touches them from Satan, they remember [Him] and at once they have insight.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ٱتَّقَوْا۟", "translit": "۟āْwَqَّtٱ", "root": "وقي"}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "مَسَّهُمْ", "translit": "ْmُhَّsَm", "root": "مسس"}, {"id": 6, "arabic": "طَٰٓئِفٌ", "translit": "ٌfِyʾَٰٓṭ", "root": "طوف"}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلشَّيْطَٰنِ", "translit": "ِnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 9, "arabic": "تَذَكَّرُوا۟", "translit": "۟āwُrَّkَhdَt", "root": "ذكر"}, {"id": 10, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 11, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 12, "arabic": "مُّبْصِرُونَ", "translit": "َnwُrِṣْbُّm", "root": "بصر"}], "hasIhya": true}, {"ayah": 202, "text": "وَإِخْوَٰنُهُمْ يَمُدُّونَهُمْ فِى ٱلْغَىِّ ثُمَّ لَا يُقْصِرُونَ ", "translation": "But their brothers[1] - they [i.e., the devils] increase them in error; then they do not stop short.", "words": [{"id": 1, "arabic": "وَإِخْوَٰنُهُمْ", "translit": "ْmُhُnَٰwْhkِiʾَw", "root": "اخو"}, {"id": 2, "arabic": "يَمُدُّونَهُمْ", "translit": "ْmُhَnwُّdُmَy", "root": "مدد"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْغَىِّ", "translit": "ِّàَغْlٱ", "root": "غوي"}, {"id": 5, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يُقْصِرُونَ", "translit": "َnwُrِṣْqُy", "root": "قصر"}], "hasIhya": false}, {"ayah": 203, "text": "وَإِذَا لَمْ تَأْتِهِم بِـَٔايَةٍ قَالُوا۟ لَوْلَا ٱجْتَبَيْتَهَاۚ قُلْ إِنَّمَآ أَتَّبِعُ مَا يُوحَىٰٓ إِلَىَّ مِن رَّبِّىۚ هَٰذَا بَصَآئِرُ مِن رَّبِّكُمْ وَهُدًى وَرَحْمَةٌ لِّقَوْمٍ يُؤْمِنُونَ ", "translation": "And when you, [O Muḥammad], do not bring them a sign [i.e., miracle], they say, \"Why have you not contrived it?\" Say, \"I only follow what is revealed to me from my Lord. This [Qur’ān] is enlightenment from your Lord and guidance and mercy for a people who believe.\"", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 3, "arabic": "تَأْتِهِم", "translit": "mِhِtْaʾَt", "root": "اتي"}, {"id": 4, "arabic": "بِـَٔايَةٍ", "translit": "ٍẗَyāَٔـِb", "root": "ايي"}, {"id": 5, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 6, "arabic": "لَوْلَا", "translit": "āَlْwَl", "root": ""}, {"id": 7, "arabic": "ٱجْتَبَيْتَهَا", "translit": "āَhَtْyَbَtْjgٱ", "root": "جبي"}, {"id": 8, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 9, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 10, "arabic": "أَتَّبِعُ", "translit": "ُʿعِbَّtَaʾ", "root": "تبع"}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "يُوحَىٰٓ", "translit": "ٰٓàَḥwُy", "root": "وحي"}, {"id": 13, "arabic": "إِلَىَّ", "translit": "َّàَlِiʾ", "root": ""}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "رَّبِّى", "translit": "àِّbَّr", "root": "ربب"}, {"id": 16, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 17, "arabic": "بَصَآئِرُ", "translit": "ُrِyʾٓāَṣَb", "root": "بصر"}, {"id": 18, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 19, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 20, "arabic": "وَهُدًى", "translit": "àًdُhَw", "root": "هدي"}, {"id": 21, "arabic": "وَرَحْمَةٌ", "translit": "ٌẗَmْḥَrَw", "root": "رحم"}, {"id": 22, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 23, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 204, "text": "وَإِذَا قُرِئَ ٱلْقُرْءَانُ فَٱسْتَمِعُوا۟ لَهُۥ وَأَنصِتُوا۟ لَعَلَّكُمْ تُرْحَمُونَ ", "translation": "So when the Qur’ān is recited, then listen to it and pay attention that you may receive mercy.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قُرِئَ", "translit": "َyʾِrُq", "root": "قرا"}, {"id": 3, "arabic": "ٱلْقُرْءَانُ", "translit": "ُnāَءْrُqْlٱ", "root": "قرا"}, {"id": 4, "arabic": "فَٱسْتَمِعُوا۟", "translit": "۟āwُʿعِmَtْsٱَf", "root": "سمع"}, {"id": 5, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 6, "arabic": "وَأَنصِتُوا۟", "translit": "۟āwُtِṣnَaʾَw", "root": "نصت"}, {"id": 7, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 8, "arabic": "تُرْحَمُونَ", "translit": "َnwُmَḥْrُt", "root": "رحم"}], "hasIhya": false}, {"ayah": 205, "text": "وَٱذْكُر رَّبَّكَ فِى نَفْسِكَ تَضَرُّعًا وَخِيفَةً وَدُونَ ٱلْجَهْرِ مِنَ ٱلْقَوْلِ بِٱلْغُدُوِّ وَٱلْءَاصَالِ وَلَا تَكُن مِّنَ ٱلْغَٰفِلِينَ ", "translation": "And remember your Lord within yourself in humility and in fear without being apparent in speech - in the mornings and the evenings. And do not be among the heedless.", "words": [{"id": 1, "arabic": "وَٱذْكُر", "translit": "rُkْhdٱَw", "root": "ذكر"}, {"id": 2, "arabic": "رَّبَّكَ", "translit": "َkَّbَّr", "root": "ربب"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "نَفْسِكَ", "translit": "َkِsْfَn", "root": "نفس"}, {"id": 5, "arabic": "تَضَرُّعًا", "translit": "āًʿعُّrَḍَt", "root": "ضرع"}, {"id": 6, "arabic": "وَخِيفَةً", "translit": "ًẗَfyِhkَw", "root": "خوف"}, {"id": 7, "arabic": "وَدُونَ", "translit": "َnwُdَw", "root": "دون"}, {"id": 8, "arabic": "ٱلْجَهْرِ", "translit": "ِrْhَjgْlٱ", "root": "جهر"}, {"id": 9, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 10, "arabic": "ٱلْقَوْلِ", "translit": "ِlْwَqْlٱ", "root": "قول"}, {"id": 11, "arabic": "بِٱلْغُدُوِّ", "translit": "ِّwُdُغْlٱِb", "root": "غدو"}, {"id": 12, "arabic": "وَٱلْءَاصَالِ", "translit": "ِlāَṣāَءْlٱَw", "root": "اصل"}, {"id": 13, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 14, "arabic": "تَكُن", "translit": "nُkَt", "root": "كون"}, {"id": 15, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 16, "arabic": "ٱلْغَٰفِلِينَ", "translit": "َnyِlِfَٰغْlٱ", "root": "غفل"}], "hasIhya": true}, {"ayah": 206, "text": "إِنَّ ٱلَّذِينَ عِندَ رَبِّكَ لَا يَسْتَكْبِرُونَ عَنْ عِبَادَتِهِۦ وَيُسَبِّحُونَهُۥ وَلَهُۥ يَسْجُدُونَ۩ ", "translation": "Indeed, those who are near your Lord [i.e., the angels] are not prevented by arrogance from His worship, and they exalt Him, and to Him they prostrate.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 4, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "يَسْتَكْبِرُونَ", "translit": "َnwُrِbْkَtْsَy", "root": "كبر"}, {"id": 7, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 8, "arabic": "عِبَادَتِهِۦ", "translit": "ۦِhِtَdāَbِʿع", "root": "عبد"}, {"id": 9, "arabic": "وَيُسَبِّحُونَهُۥ", "translit": "ۥُhَnwُḥِّbَsُyَw", "root": "سبح"}, {"id": 10, "arabic": "وَلَهُۥ", "translit": "ۥُhَlَw", "root": ""}, {"id": 11, "arabic": "يَسْجُدُونَ", "translit": "َnwُdُjgْsَy", "root": "سجد"}], "hasIhya": false}], "tafsir": {"6": [{"arabic": "وعند ذلك يصدق الله تعالى قوله: ﴿ فلنسألن الذين أرسل إليهم ولنسألن المرسلين فلنقصن عليهم بعلم وما كنا غائبين ﴾ {} وقوله: ﴿ فوربك لنسألهم أجمعين عما كانوا يعملون ﴾ {} فيبدأ سبحانه بالأنبياء ﴿ يوم يجمع الله الرسل فيقول ماذا أجبتم قالوا لا علم لنا إنك أنت علام الغيوب ﴾ {} فيا لشدة يوم تذهل فيه عقول الأنبياء وتنمحى علومهم من شدة الهيبة إذ يقال لهم ما أجبتم وقد أرسلتم إلى الخلائق وكانوا قد علموا فتدهش عقولهم فلا يدرون بماذا يجيبون فيقولون من شدة الهيبة لا علم لنا إنك أنت علام الغيوب وهم فى ذلك الوقت ص", "english": "And at that time, Allah the Exalted fulfills His saying: 'Then We will surely question those to whom messengers were sent, and We will surely question the messengers. Then We will surely relate [their deeds] to them with knowledge, and We were not [at all] absent.' (Quran 7:6-7) and His saying: 'So by your Lord, We will surely question them all about what they used to do.' (Quran 15:92-93) He begins, glorified is He, with the prophets: 'The Day when Allah will assemble the messengers and say, \"What was the response you received?\" They will say, \"We have no knowledge. Indeed, You are the Knower of the unseen.\"' (Quran 5:109) Oh, the severity of a day in which the intellects (Aql) of the prophets are bewildered and their knowledges (Ilm) are erased from the intensity of the awe (Hiba) when it is said to them, 'What did you answer?' even though they were sent to the creation and they had known. So their intellects are stunned, and they do not know with what to answer, and they say from the intensity of the awe, 'We have no knowledge. Indeed, You are the Knower of the unseen.' And they at that time are truthful, since the intellects have flown from them and the knowledges have been erased until Allah the Exalted strengthens them.", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Book of Repentance'", "badge": "Dhikr"}], "8": [{"arabic": "الأصل الرابع: الميزان وهو حق قال الله تعالى: ﴿ ونضع الموازين القسط ليوم القيامة ﴾ { سورة الأنبيآء: 47 } وقال تعالى: ﴿ فمن ثقلت موازينه فأولئك هم المفلحون. ومن خفت موازينه ﴾ { سورة المؤمنون:102، 103 } ووجهها أن الله تعالى يحدث في صحائف الأعمال وزنا بحسب درجات الأعمال عند الله تعالى فتصير مقادير أعمال العباد معلومة للعباد حتى يظهر لهم العدل في العقاب أو الفضل في العفو وتضعيف الثواب.", "english": "The Fourth Foundation: The Scale (Mizan) and it is truth. Allah the Exalted said: 'And We place the scales of justice for the Day of Resurrection' (Surah Al-Anbiya: 47). And He the Exalted said: 'So whoever's scales are heavy, then those are the successful ones. And whoever's scales are light' (Surah Al-Mu'minun: 102-103). And its explanation (wajhaha) is that Allah the Exalted creates in the records of deeds a weight (waznan) according to the degrees of deeds with Allah the Exalted, so the measures of the deeds of the servants become known to the servants until justice in punishment or favor in pardon and multiplication of reward becomes apparent to them.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Foundations of Belief'", "badge": "Afterlife"}], "10": [{"arabic": "أما من الكتاب فقوله تعالى  وجعلنا  النهار  معاشا  فذكره  في معرض الامتنان وقال تعالى وجعلنا لكم فيها معايش قليلا ما  تشكرون  فجعلها  ربك نعمة وطلب الشكر عليها", "english": "As for from the Book, then His saying, the Exalted: 'And We made the day for livelihood' - He mentioned it in the context of favor. And He said, the Exalted: 'And We made for you therein livelihoods; little do you give thanks' - so your Lord made it a blessing and demanded gratitude for it.", "book_file": "vol2_j2-k03.doc.txt", "book_title": "Etiquette of Earning", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Etiquette of Earning'", "badge": "Insight"}], "12": [{"arabic": "وقد كلف الملعون المخلوق من النار ان يطمئن عن حركته ساجدا لما خلق الله من الطين فأبى واستكبر واستعصى وعبر عن سبب استعصائه بأن قال: ﴿ خلقتني من نار وخلقته من طين ﴾ {} فاذن حيث لم يسجد الملعون لأبينا آدم صلوات الله عليه وسلامه فلا ينبغي ان يطمع في سجوده لأولاده ومهما كف عن القلب وسواسه وعدوانه وطيرانه وجولانه فقد اظهر انقياده واذعانه وانقياده بالاذعان سجود منه فهو روح السجود وانما وضع الجبهة على الارض قالبه وعلامته الدالة عليه بالاصطلاح", "english": "And the accursed one created from fire was commanded to settle from his movement prostrating to what Allah created from clay, but he refused and was arrogant and disobeyed, and he expressed the reason for his disobedience by saying: 'You created me from fire and created him from clay' (Quran 7:12). Therefore, since the accursed one did not prostrate to our father Adam (peace and blessings of Allah be upon him), one should not hope for his prostration to his children. And whenever he refrains from the Heart (Qalb) his whispering, aggression, flying, and roaming, he has shown his submission and compliance, and his submission through compliance is a prostration from him—it is the Spirit (Ruh) of prostration. Placing the forehead on the ground is merely its form and sign indicating it by convention.", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "فإذن تكبره على الخلق عظيم لأنه سيدعوه إلى التكبر على أمر الله، وإنما ضرب إبليس مثلاً لهذا، وما حكاه من أحواله إلا ليعتبر به، فإنه قال: أنا خير منه، وهذا الكبر بالنسب لأنه قال: أنا خير منه خلقتني من نار وخلقته من طين، فحمله ذلك على أن يمتنع من السجود الذي أمره الله تعالى به، وكان مبدؤه الكبر على آدم والحسد له فجره ذلك إلى التكبر على أمر الله تعالى، فكان ذلك سبب هلاكه أبد الآباد، فهذه آفة من آفات الكبر على العباد عظيمة، ولذلك شرح رسول الله ﷺ الكبر بهاتين الآفتين إذ سأله ثابت بن قيس بن شماس فقال: ي", "english": "Therefore, his arrogance toward the creation is great because it will lead him to arrogance toward the command of Allah. Indeed, Iblis (Satan) was made an example of this, and what is narrated of his states is only to take lesson from it. For he said: 'I am better than him,' and this arrogance is by lineage because he said: 'I am better than him; You created me from fire and created him from clay.' This carried him to refuse the prostration that Allah the Exalted commanded him to perform. Its beginning was arrogance toward Adam and envy of him, which dragged him to arrogance toward the command of Allah the Exalted, and that became the cause of his destruction forever. So this is a great affliction from the afflictions of arrogance upon the servants. Therefore, the Messenger of Allah ﷺ explained arrogance by these two afflictions when Thabit ibn Qays ibn Shammas asked him: 'O Messenger of Allah, I am a man to whom beauty has become beloved as you see; is this from arrogance?' He ﷺ said: 'No, but arrogance is from rejecting the truth (battar al-haqq) and despising people (ghamṣ al-nās).' And in another narration: 'from belittling the truth (safaha al-haqq).' And his saying 'and despising people' means looking down upon them and considering them insignificant, while they are servants of Allah like him or better than him. And this first affliction 'and belittling the truth' is rejecting it, and it is the second affliction. So whoever sees that he is better than his brother and despises his brother, looks down upon him, and views him with the eye of belittlement, or rejects the truth while knowing it, has become arrogant between himself and the creation. And whoever is too proud to submit to Allah the Exalted and humble himself to Allah through obedience and following His messengers has become arrogant between himself and Allah the Exalted and His messengers.", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}, {"arabic": "وإنما ضرب إبليس مثلاً لهذا، وما حكاه من أحواله إلا ليعتبر به، فإنه قال: أنا خير منه، وهذا الكبر بالنسب لأنه قال: أنا خير منه خلقتني من نار وخلقته من طين، فحمله ذلك على أن يمتنع من السجود الذي أمره الله تعالى به، وكان مبدؤه الكبر على آدم والحسد له فجره ذلك إلى التكبر على أمر الله تعالى، فكان ذلك سبب هلاكه أبد الآباد، فهذه آفة من آفات الكبر على العباد عظيمة، ولذلك شرح رسول الله ﷺ الكبر بهاتين الآفتين إذ سأله ثابت بن قيس بن شماس فقال: يا رسول الله إني امرؤ قد حبب إلي من الجمال ما ترى أفمن الكبر هو؟", "english": "And indeed, Iblis (Satan) was made an example of this, and what was narrated of his states is only to take lesson from it, for he said: 'I am better than him,' and this pride (Kibr) is by lineage because he said: 'I am better than him, You created me from fire and created him from clay,' so that carried him to refuse the prostration (Sujood) which Allah the Exalted commanded him with, and its beginning was pride (Kibr) upon Adam and envy (Hasad) for him, which dragged him to pride (Kibr) upon the command of Allah the Exalted, so that was the cause of his destruction forever, so this is a calamity (Aafah) from the calamities (Aafaat) of pride (Kibr) upon the servants (Ibaad) great, and therefore the Messenger of Allah ﷺ explained pride (Kibr) with these two calamities (Aafaat) when Thabit ibn Qays ibn Shammas asked him saying: 'O Messenger of Allah, I am a man who loves beauty as you see, is that from pride (Kibr)?' He ﷺ said: 'No, but pride (Kibr) is from rejecting the truth (Haqq) and despising people (Ghams al-Naas).' And in another narration: 'from belittling the truth (Safah al-Haqq).' And his saying 'and despising people (Ghams al-Naas)' meaning looking down upon them and considering them insignificant, and they are servants (Ibaad) of Allah like him or better than him. And this first calamity (Aafah) 'and belittling the truth (Safah al-Haqq)' is rejecting it, and it is the second calamity (Aafah), so whoever sees that he is better than his brother and despises his brother and looks down upon him and looks at him with the eye of belittlement, or rejects the truth (Haqq) while he knows it, has indeed become proud (Takabbar) between him and the creation (Khalq), and whoever is too proud (Anif) to submit (Yakhda') to Allah the Exalted and humble himself (Yatawada') to Allah through His obedience (Taa'ah) and following His messengers, has indeed become proud (Takabbar) between him and Allah the Exalted and His messengers.", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}, {"arabic": "وهذه أقيسة فاسدة تشبه قياس إبليس حيث قال \"أنا خير منه خلقتني من نار وخلقته من طين\" وإلى هؤلاء الإشارة بقوله تعالى \"أولئك الذين اشتروا الحياة الدنيا بالآخرة فلا يخفف عنهم العذاب ولا هم ينصرون\" وعلاج هذا الغرور إما بتصديق الإيمان وإما بالبرهان؛ أما التصديق بمجرد الإيمان فهو أن يصدق الله تعالى في قوله \"ما عندكم ينفد وما عند الله باق\" وفي قوله عز وجل \"وما عند الله خير\" وقوله \"والآخرة خير وأبقى\" وقوله \"وما الحياة الدنيا إلا متاع الغرور\" وقوله \"فلا تغرنكم الحياة الدنيا\" وقد أخبر رسول الله ﭬ بذلك طوائف", "english": "And these are corrupt analogies resembling the analogy of Iblis (Satan) when he said: \"I am better than him (Adam), You created me from fire and created him from clay.\" And to these people is the reference in His saying, the Exalted: \"Those are the ones who have purchased the worldly life for the Hereafter, so the punishment will not be lightened for them, nor will they be aided.\" And the treatment for this delusion (Ghurur) is either through affirmation of faith (Iman) or through proof (Burhan); as for affirmation through mere faith (Iman), it is to believe Allah, the Exalted, in His saying: \"What is with you will be exhausted, and what is with Allah is enduring,\" and in His saying, the Mighty and Majestic: \"And what is with Allah is better,\" and His saying: \"And the Hereafter is better and more enduring,\" and His saying: \"And the worldly life is not but the enjoyment of delusion (Ghurur),\" and His saying: \"So do not let the worldly life delude you.\" And the Messenger of Allah (peace be upon him) informed groups of disbelievers of this, so they followed him and believed him and had faith (Amanu) in him and did not demand proof from him[3], and among them were those who said: \"I adjure you by Allah, did Allah send you as a messenger?\" And he would say: \"Yes,\" so they would believe[4]. And this is the faith (Iman) of the common people, and it removes from delusion (Ghurur), and this is placed in the position of a child believing his father that attending the school is better than attending the playground, even though he does not know the aspect of its being better. And as for knowledge through clarification and proof (Burhan), it is to know the aspect of corruption of this analogy that Satan has organized in his heart (Qalb), for every deluded person has a cause for his delusion (Ghurur), and that cause is evidence, and every evidence is a type of analogy that occurs in the soul (Nafs) and produces tranquility (Sukun) towards it, even if its possessor is not aware of it nor capable of organizing it with the words of the scholars. So the analogy that Satan organized...", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Delusion'", "badge": "Ethics"}, {"arabic": "أما بعد فإن الغضب شعلة نار اقتبست من نار الله الموقدة التي تطلع على الأفئدة، وإنها لمستكنة في طي الفؤاد. استكنان الجمر تحت الرماد، ويستخرجها الكبر الدفين في قلب كل جبار عنيد، كاستخراج الحجر النار من الحديد، وقد انكشف للناظرين بنور اليقين، أن الإنسان ينزع منه عرق إلى الشيطان اللعين، فمن استفزته نار الغضب فقد قويت فيه قرابة الشيطان حيث قال \"خلقتني من نار وخلقته من طين\" فإن شأن الطين السكون والوقار، وشأن النار التلظي والاستعار، والحركة والاضطراب، ومن نتائج الغضب الحقد والحسد، وبهما هلك من هلك وفسد ", "english": "Afterwards, anger is a flame of fire borrowed from the fire of Allah the kindled which rises upon the hearts (Afa'idah), and indeed it is hidden in the fold of the heart (Fu'ad). The hiding of embers under ashes, and it is extracted by the concealed arrogance in the heart of every obstinate tyrant, like extracting fire from stone with iron, and it has been revealed to the observers with the light of certainty (Yaqin), that the human being has a vein extending to the accursed Satan (Shaytan), so whoever is provoked by the fire of anger has strengthened in him the kinship of Satan when he said \"I am better than him, You created me from fire and created him from clay.\" For the nature of clay is stillness and dignity, and the nature of fire is blazing and flaming, and movement and agitation, and from the results of anger are malice (Haqd) and envy (Hasad), and by them perished whoever perished and corrupted whoever corrupted, and their source is a morsel (Mudghah) if it becomes sound, the entire body becomes sound with it, and if malice and envy and anger are among what drives the servant (Abd) to places of destruction, how much he needs to know its harms and evils! To beware of that and avoid it, and remove it from the heart if it exists and expel it, and treat it if it becomes entrenched in his heart and cure it, for whoever does not know evil falls into it, and whoever knows it, knowledge alone does not suffice him, unless he knows the path by which he repels evil and removes it.", "book_file": "vol3_Vol3-book5a.doc.txt", "book_title": "Condemnation of Envy", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Envy'", "badge": "Ethics"}], "15": [{"arabic": "وقال سفيان بن عيينة لا يمنعن أحدكم من الدعاء ما يعلم من نفسه فإن الله عز وجل أجاب دعاء شر الخلق إبليس لعنه الله إذ قال: ﴿ رب فانظرني إلى يوم يبعثون قال إنك من المنظرين ﴾ {}.", "english": "And Sufyan ibn 'Uyaynah said: Let not what one knows about himself prevent anyone from supplication, for Allah the Exalted answered the supplication of the worst of creation, Iblis (may Allah curse him), when he said: 'My Lord, grant me respite until the Day they are resurrected.' He said: 'Indeed, you are of those granted respite.'", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance", "badge": "Du'a"}], "16": [{"arabic": "ولأجل اكتناف الشهوات للقلب من جوانبه قال الله تعالى إخبارا عن إبليس لأقعدن لهم صراطك المستقيم ثم لآتينهم من بين أيديهم ومن خلفهم وعن إيمانهم وعن شمائلهم وقال صلى الله عليه وسلم إن الشيطان قعد لابن آدم بطرق فقعد له بطريق الإسلام فقال أتسلم وتترك دينك ودين آبائك فعصاه وأسلم ثم قعد له بطريق الهجرة فقال أتهاجر أتدع أرضك وسمائك فعصاه وهاجر هو قعد له بطريق الجهاد فقال أتجاهد وهو تلف النفس والمال فتقاتل فتقتل فتنكح نساؤك ويقسم مالك فعصاه وجاهد[49]", "english": "And because the desires (Shahawat) surround the Heart (Qalb) from its sides, Allah the Exalted said, informing about Iblis: 'I will surely sit for them on Your straight path (Siraat al-Mustaqim), then I will come to them from before them and from behind them and from their right hands and from their left hands.' And the Prophet (peace be upon him) said: 'Indeed, Satan sat for the son of Adam with paths, so he sat for him with the path of Islam and said: Do you become Muslim and leave your religion and the religion of your fathers? So he disobeyed him and became Muslim. Then he sat for him with the path of emigration (Hijrah) and said: Do you emigrate? Do you leave your land and your sky? So he disobeyed him and emigrated. He sat for him with the path of striving (Jihad) and said: Do you strive, and it is destruction of the self (Nafs) and wealth, so you fight and are killed, then your women are married and your wealth is divided? So he disobeyed him and strove.'", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "وقال عز وجل إخبارا عن ابليس اللعين: ﴿ لأقعدن لهم صراطك المستقيم ﴾ {} قيل هو طريق الشكر ولعلو رتبة الشكر طعن اللعين في الخلق فقال: ولا تجد أكثرهم شاكرين وقال تعالى: ﴿ وقليل من عبادي الشكور ﴾ {} وقد قطع الله تعالى بالمزيد مع الشكر ولم يستثن فقال تعالى: ﴿ لئن شكرتم لأزيدنكم ﴾ {}", "english": "And the Mighty and Majestic said, reporting about the cursed Iblis: 'I will surely sit in ambush for them on Your straight path' (Quran 7:16). It is said that it is the path of gratitude (Shukr), and due to the high rank of gratitude (Shukr), the cursed one attacked the creation, saying: 'And you will not find most of them grateful' (Quran 7:17). And Allah the Exalted said: 'And few of My servants are grateful' (Quran 34:13). And Allah the Exalted has affirmed increase with gratitude (Shukr) without exception, saying: 'If you are grateful, I will surely increase you' (Quran 14:7).", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "وقيل في تفسير قوله عز وجل: ﴿ لأقعدن لهم صراطك المستقيم ﴾ {} أي طريق مكة يقعد الشيطان عليها ليمنع الناس منها", "english": "And it is said in the interpretation of His saying, the Exalted: 'I will surely sit for them on Your straight path' (Quran 7:16), meaning: the way to Mecca; the Satan sits on it to prevent people from it.", "book_file": "vol1_Vol1-book-7.doc.txt", "book_title": "Mysteries of Hajj", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Mysteries of Hajj'", "badge": "Afterlife"}], "17": [{"arabic": "وقال عز وجل إخبارا عن ابليس اللعين: ﴿ لأقعدن لهم صراطك المستقيم ﴾ {} قيل هو طريق الشكر ولعلو رتبة الشكر طعن اللعين في الخلق فقال: ولا تجد أكثرهم شاكرين وقال تعالى: ﴿ وقليل من عبادي الشكور ﴾ {}", "english": "And the Mighty and Majestic said, reporting from the cursed Iblis: 'I will surely sit for them on Your straight path' (Quran 7:16). It is said this is the path of gratitude (Shukr), and due to the high rank of gratitude (Shukr), the cursed one attacked the creation, saying: 'And you will not find most of them grateful (Shakirin)' (Quran 7:17). And Allah said: 'And few of My servants are grateful (Shakur)' (Quran 34:13).", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "فمن فهم حكمة الله تعالى في جميع أنواع الموجودات قدر على القيام بوظيفة الشكر واستقصاء ذلك يحتاج إلى مجلدات ثم لا تفى إلا بالقليل وإنما أوردنا هذا القدر ليعلم علة الصدق في قوله تعالى: ﴿ وقليل من عبادى الشكور ﴾ {} وفرح إبليس لعنه الله بقوله: ﴿ ولا تجد أكثرهم شاكرين ﴾ {} فلا يعرف معنى هذه الآية من لم يعرف معنى هذا كله وأمورا أخر وراء ذلك تنقضى الأعمار دون استقصاء مباديها فأما تفسير الآية ومعنى لفظها فيعرفه كل من يعرف اللغة وبهذا يتبين لك الفرق بين المعنى والتفسير.", "english": "So whoever understands the wisdom (Hikmah) of Allah the Exalted in all types of existents becomes capable of performing the duty of gratitude (Shukr), and exhaustively detailing that requires volumes, yet they would not suffice except with little. We have only presented this amount to know the reason for the truth in His saying the Exalted: 'And few of My servants are grateful' (Quran 34:13). And Iblis (Satan), may Allah curse him, rejoiced in His saying: 'And you will not find most of them grateful' (Quran 7:17). So one does not know the meaning of this verse who does not know the meaning of all this and other matters beyond that, whose principles lifetimes expire without exhaustive exploration. As for the interpretation (Tafsir) of the verse and the meaning of its wording, everyone who knows the language knows it, and with this the difference between meaning (Ma'na) and interpretation (Tafsir) becomes clear to you.", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Patience and Gratitude'", "badge": "Dhikr"}], "26": [{"arabic": "وقيل في قوله تعالى: ﴿ يا بني آدم قد أنزلنا عليكم لباسا يواري سوءاتكم﴾ يعني العلم ﴿وريشا﴾ يعني اليقين ﴿ولباس التقوى﴾ يعني الحياء.", "english": "And it is said regarding His statement, the Exalted: 'O children of Adam, We have sent down upon you clothing to cover your private parts' (Quran 7:26) meaning knowledge (Al-'Ilm), 'and adornment' meaning certainty (Al-Yaqeen), 'and the clothing of piety' meaning modesty (Al-Haya').", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}], "27": [{"arabic": "ولذلك حذر الله منه جميع الخلق فقال الله تعالى \"يا بني آدم لا يفتننكم الشيطان كما أخرج أبويكم من الجنة\" وقال عز وجل \"إنه يراكم هو وقبيله من حيث لا ترونهم\" والقرآن من أوله إلى آخره تحذير من الشيطان فكيف وقد أمر بالحذر من العدو كما أمر بالحذر من الكفار فقال تعالى \"وليأخذوا حذرهم وأسلحتهم\" وقال تعالى \"وأعدوا لهم ما استطعتم من قوة ومن رباط الخيل\" فإذا لزمك بأمر الله الحذر من العدو الكافر وأنت تراه فبأن يلزمك الحذر من عدو يراك ولا تراه أولى.", "english": "Therefore, Allah warned all creation from him, so Allah the Exalted said: \"O children of Adam, let not Satan tempt you as he removed your parents from the Garden (Jannah), stripping them of their clothing to show them their private parts. Indeed, he sees you, he and his tribe, from where you do not see them.\" And the Quran from its beginning to its end is a warning from Satan, so how [can one be heedless] when He has commanded caution from the enemy just as He commanded caution from the disbelievers? He the Exalted said: \"And let them take their precaution and their weapons,\" and He the Exalted said: \"And prepare against them whatever you are able of power and of steeds of war.\" So if it is incumbent upon you by Allah's command to be cautious from the disbelieving enemy whom you see, then it is more appropriate that it be incumbent upon you to be cautious from an enemy who sees you but you do not see him.", "book_file": "vol3_Vol3-book-8a.doc.txt", "book_title": "Condemnation of Status and Ostentation", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Condemnation of Status and Ostentation'", "badge": "Afterlife"}], "31": [{"arabic": "وعنه عبر بقوله ﭬ \"خير الأمور أوساطها\"[49] وإليه الإشارة بقوله تعالى \"وكلوا واشربوا ولا تسرفوا\" ومهما لم يحس الإنسان بجوع ولا شبع تيسرت له العبادة والفكر وخف في نفسه وقوي على العمل مع خفته، ولكن هذا بعد اعتدال الطبع.", "english": "And from this, he expressed with his saying ﭬ \"The best of matters are their middles\"[49] and to it is the indication by the saying of Allah the Exalted \"And eat and drink and do not be excessive (Tasrifu)\" and whenever the human does not feel hunger nor satiation, worship (Ibadah) and thought (Fikr) become easy for him and it becomes light in his soul (Nafs) and he becomes strong upon work with its lightness, but this is after the moderation of the natural disposition (Tab').", "book_file": "vol3_Vol3-book3a.doc.txt", "book_title": "Harms of the Tongue", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Harms of the Tongue'", "badge": "Insight"}, {"arabic": "وكذلك المطلوب في شهوة الطعام الاعتدال دون الشره والجمود قال الله تعالى \"وكلوا واشربوا ولا تسرفوا إنه لا يحب المسرفين\" وقال في الغضب \"أشداء على الكفار رحماء بينهم\" وقال ﭬ \"خير الأمور أوساطها\" وهذا له سر وتحقيق وهو أن السعادة منوطة بسلامة القلب عن عوارض هذا العالم. قال الله تعالى \"إلا من أتى الله بقلب سليم\" والبخل من عوارض الدنيا، والتبذير أيضاً من عوارض الدنيا، وشرط القلب أن يكون سليماً منهما أي لا يكون ملتفتاً إلى المال ولا يكون حريصاً على إنفاقه ولا على إمساكه، فإن الحريص على الإنفاق مصروف القل", "english": "Likewise, what is required in the appetite for food is moderation (I'tidal) without gluttony (Sharah) and rigidity (Jamud). Allah the Exalted said: \"And eat and drink and do not be excessive (Tusrifu). Indeed, He does not love the excessive ones (Musrifin).\" And He said regarding anger: \"Firm against the disbelievers, merciful among themselves.\" And the Prophet (peace be upon him) said: \"The best of matters are their middle ones.\" This has a secret and verification, which is that happiness is tied to the soundness of the Heart (Qalb) from the accidents of this world. Allah the Exalted said: \"Except he who comes to Allah with a sound heart (Qalb Salim).\" And miserliness (Bukhl) is from the accidents of the world, and wastefulness (Tabdhir) is also from the accidents of the world. The condition of the Heart (Qalb) is that it be sound from both of them, meaning it should not be attentive to wealth, nor should it be eager (Hariṣ) to spend it nor to withhold it. For the one eager (Hariṣ) to spend has his Heart (Qalb) diverted to spending, just as the one eager (Hariṣ) to withhold has his Heart (Qalb) diverted to withholding. So the perfection of the Heart (Qalb) is that it be purified (Yasfuw) from both descriptions altogether.", "book_file": "vol3_Vol3-book2a.doc.txt", "book_title": "Breaking the Two Desires", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Breaking the Two Desires'", "badge": "Ethics"}, {"arabic": "السادس الاعتدال في النفقة فلا ينبغي أن يقتر عليهن في الإنفاق ولا ينبغي أن يسرف بل يقتصد قال تعالى (وكلوا واشربوا ولا تسرفوا) وقال تعالى (ولا تجعل يدك مغلولة إلى عنقك ولا تبسطها كل البسط) وقد قال رسول الله صلى الله عليه وسلم (خيركم خيركم لأهله)[127] وقال صلى الله عليه وسلم (دينار أنفقته في سبيل الله ودينار أنفقته في رقبة ودينار تصدقت به على مسكين ودينار أنفقته على أهلك أعظمها أجرا الذي أنفقته على أهلك.)[128]", "english": "The sixth [principle] is moderation in expenditure. One should not be stingy with them in spending, nor should one be extravagant, but rather be moderate. Allah the Exalted said: 'And eat and drink, and do not be extravagant (la tusrifu).' And Allah the Exalted said: 'And do not make your hand tied to your neck, nor stretch it out completely.' And the Messenger of Allah, peace and blessings be upon him, said: 'The best of you is the best of you to his family.' And he, peace and blessings be upon him, said: 'A dinar you spend in the path of Allah, a dinar you spend to free a slave, a dinar you give in charity to a poor person, and a dinar you spend on your family—the greatest in reward is the one you spend on your family.'", "book_file": "vol2_j2-k02.doc.txt", "book_title": "Etiquette of Marriage", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Etiquette of Marriage'", "badge": "Afterlife"}], "32": [{"arabic": "فأما ما ذكرت لي أني آكل الرقاق وألبس الدقاق وأحتجب وأجلس على الوطىء فنحن نفعل ذلك ونستغفر الله تعالى فقد قال الله تعالى قل من حرم زينة الله التي أخرج لعباده والطيبات من الرزق وإني لأعلم أن ترك ذلك خير من الدخول فيه ولا تدعنا من كتابك فلسنا ندعك من كتابنا والسلام.", "english": "As for what you mentioned to me - that I eat thin bread (raqiq), wear fine clothes (daqaq), seclude myself, and sit on cushions - we do that and seek forgiveness from Allah the Exalted. For Allah the Exalted has said: 'Say: Who has forbidden the adornment (zina) of Allah which He has produced for His servants and the good things (tayyibat) from the provision (rizq)?' And I know that abandoning that is better than entering into it. And do not leave us from your letter, for we will not leave you from our letter. Peace.", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "بل أقول سماع الاوتار ممن يضربها على غير وزن متناسب مستلذ حرام أيضا وبهذا يتبين انه ليست العلة في تحريمها مجرد اللذة الطيبة بل القياس تحليل الطيبات كلها إلا ما في تحليله فساد قال الله تعالى قل من حرم زينة الله التي أخرج لعباده والطيبات من الرزق فهذه الأصوات لا تحرم من حيث إنها أصوات موزونة وإنما تحرم بعارض آخر كما سيأتي في العوارض المحرمة الدرجة الثالثة الموزون والمفهوم وهو الشعر وذلك لا يخرج إلا من حنجرة الإنسان فيقطع بإباحة ذلك لأنه ما زاد إلا كونه مفهوما والكلام المفهوم غير حرام والصوت الطيب ا", "english": "Rather, I say that listening to strings from one who plays them without proportional rhythm that is pleasurable is also forbidden, and by this it becomes clear that the reason for their prohibition is not merely the pleasant pleasure, but the analogy is the permissibility of all good things except what in its permissibility contains corruption. Allah the Exalted said: 'Say, who has forbidden the adornment of Allah which He has produced for His servants and the good things from the provision?' So these sounds are not forbidden because they are rhythmic sounds, but rather they are forbidden due to another incidental factor, as will come in the forbidden incidents of the third degree: the rhythmic and comprehensible, which is poetry, and that does not come out except from the throat of a human, so it is decisively permissible because it only increased by being comprehensible, and comprehensible speech is not forbidden, and pleasant rhythmic sound is not forbidden. So if the individual elements are not forbidden, then from where is the combination forbidden? Yes, one looks at what is understood from it; if it contains a prohibited matter, its prose and poetry are forbidden, and speaking it is forbidden whether with melodies or not. The truth in it is what Al-Shafi'i, may Allah have mercy on him, said when he said: 'Poetry is speech, so its good is good and its bad is bad.' Whenever reciting poetry without voice and melodies is permissible, reciting it with melodies is permissible, for when permissible individual things gather, that combination is permissible, and whenever a permissible thing joins with a permissible thing, it is not forbidden except if the combination contains a prohibition that the individual elements do not contain, and there is no prohibition here. And how can reciting poetry be denied when it was recited in the presence of the Messenger of Allah, peace and blessings be upon him? The hadith of reciting poetry in the presence of the Messenger of Allah, peace and blessings be upon him, is agreed upon from the narration of Abu Hurairah that 'Umar passed by Hassan while he was reciting poetry in the mosque, so he glanced at him and said: 'I used to recite, and in it is one better than you,' the hadith, and in Muslim from the narration of 'A'isha, reciting.", "book_file": "vol2_j2-k08.doc.txt", "book_title": "Audition and Ecstasy", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Audition and Ecstasy'", "badge": "Dhikr"}, {"arabic": "وما على الحائط ليس منسوبا إلى الذكور ولو حرم هذا لحرم تزيين الكعبة بل الأولى إباحته لموجب قوله قل من حرم زينة الله لا سيما في وقت الزينة إذا لم يتخذ عادة للتفاخر وإن تخيل أن الرجال ينتفعون بالنظر إليه ولا يحرم على الرجال الانتفاع بالنظر إلى الديباج مهما لبسه الجواري والنساء والحيطان في معنى النساء إذ لسن موصوفات بالذكورة", "english": "And what is on the wall is not attributed to males, and if this were prohibited, it would prohibit decorating the Kaaba. Rather, the first (opinion) is its permissibility due to the reason of His saying: 'Say, who has forbidden the adornment (Zīnah) of Allah which He has produced for His servants and the good things (Al-Ṭayyibāt) from the provision (Rizq)?' especially at the time of adornment if it is not taken as a habit for boasting. And if it is imagined that men benefit from looking at it, it is not prohibited for men to benefit from looking at silk whenever slave-girls and women wear it, and walls are in the meaning of women since they are not described with masculinity.", "book_file": "vol2_j2-k01.doc.txt", "book_title": "Manners of Eating", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Manners of Eating'", "badge": "General"}], "33": [{"arabic": "ولأجل غيرة الله تعالى حرم الفواحش ما ظهر منها وما بطن ولا أحد أحب إليه العذر من الله ولذلك بعث المنذرين والمبشرين ولا أحد أحب إليه المدح من الله ولأجل ذلك وعد الجنة.", "english": "And because of the jealousy (ghayrah) of Allah the Exalted, He prohibited the abominations (fawāḥish) - what is apparent of them and what is hidden - and no one is more beloved to Him than excuse, and for that reason He sent the warners and the bearers of good tidings, and no one is more beloved to Him than praise, and for that reason He promised Paradise.", "book_file": "vol2_j2-k02.doc.txt", "book_title": "Etiquette of Marriage", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Etiquette of Marriage'", "badge": "Afterlife"}], "37": [{"arabic": "ومنها الاستكبار عن الحق وكراهته، والحرص على المماراة فيه حتى إن أبغض شيء إلى المناظر أن يظهر على لسان خصمه الحق ومنهما ظهر تشمر لجحده وإنكاره بأقصى جهده وبذل غاية إمكانه في المخادعة والمكر والحيلة لدفعه حتى تصير المماراة فيه عادة طبيعية فلا يسمع كلاما إلا وينبعث من طبعه داعية الاعتراض عليه حتى يغلب ذلك على قلبه في أدلة القرآن وألفاظ الشرع فيضرب البعض منها بالبعض والمراء في مقابلة الباطل محذور إذ ندب رسول الله صلى الله عليه وسلم إلى ترك المراء بالحق على الباطل قال صلى الله عليه وسلم : (( من ترك ا", "english": "And among them is arrogance toward the truth (Al-Haqq) and hatred of it, and eagerness for disputation in it until indeed the most hated thing to the disputant is that the truth appears on the tongue of his opponent, and from these two emerges exertion for its denial and rejection with his utmost effort and expending the limit of his capability in deception, cunning, and trickery to repel it until disputation in it becomes a natural habit, so he does not hear speech except that there arises from his nature an urge to object to it until that overcomes his heart (Qalb) in the proofs of the Quran and the expressions of the Sharia, so he strikes some of them with others, and disputation in opposition to falsehood is cautioned against, for the Messenger of Allah, peace be upon him, encouraged abandoning disputation with truth against falsehood. He said, peace be upon him: 'Whoever abandons disputation while he is false, Allah builds for him a house in the outskirts of Paradise, and whoever abandons disputation while he is truthful, Allah builds for him a house in the highest Paradise.' And Allah the Exalted equated between one who fabricates a lie against Allah and one who denies the truth, for He said, the Exalted: 'And who is more unjust than one who fabricates a lie against Allah or denies the truth when it has come to him?' (Al-Ankabut: 68). And He said, the Exalted: 'So who is more unjust than one who lies against Allah and denies the truth when it has come to him?' (Az-Zumar: 32).", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}], "40": [{"arabic": "قالوا: الله ورسوله أعلم قال إنه نهر وعدنيه ربى عز  وجل  فى  الجنة\nعليه  خير  كثير  عليه  حوض  ترد  عليه  أمتى  يوم  القيامة  آنيته  عدد   نجوم\nالسماء[188]) وقال أنس: قال رسول الله ﭬ: بينما أنا أسير  فى  الجنة  إذا  بنهر\nحافتاه قباب اللؤلؤ المجوف قلت: ما هذا يا جبريل؟ قال: هذا الكوثر  الذى  أعطاك\nربك فضرب الملك بيده فإذا طينه مسك أذفر[189]) وقال كان رسول الله ﭬ يقول:  (ما\nبين لابتى حوضى مثل ما بين المدينة وصنعاء أو مثل ما بين  المدينة  وعمان[190])\nوروى ابن عمر (أنه لما نزل قوله تعالى: ﴿ إنا أعطين", "english": "[77] Hadith that Hudhayfah was specifically given by the Messenger of Allah (peace be upon him) knowledge of the hypocrites, narrated by Muslim from the hadith of Hudhayfah: 'Among my companions are twelve hypocrites, its completion: they will not enter Paradise until the camel passes through the eye of the needle' hadith.", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Remembrance of Death and Afterlife", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}], "42": [{"arabic": "وقال أبو طالب المكي العمل بالجوارح من الإيمان ولا يتم دونه وادعى الإجماع فيه واستدل بأدلة تشعر بنقيض غرضه كقوله تعالى الذين آمنوا وعملوا الصالحات إذ هذا يدل على أن العمل وراء الإيمان لا من نفس الإيمان وإلا فيكون العمل في حكم المعاد والعجب أنه ادعى الإجماع في هذا وهو مع ذلك ينقل قوله ﭬ: (لا يكفر أحد إلا بعد جحوده لما أقرّ به[51]) وينكر على المعتزلة قولهم بالتخليد في النار بسبب الكبائر والقائل بهذا قائل بنفس مذهب المعتزلة إذ يقال له من صدق بقلبه وشهد بلسانه ومات في الحال فهل هو في الجنة فلا بد أن ", "english": "And Abu Talib al-Makki said: 'Action with the limbs (al-Jawarih) is from faith (al-Iman) and it is not complete without it,' and he claimed consensus in this and argued with evidences that suggest the opposite of his purpose, such as His saying, the Exalted: 'And those who believe and do righteous deeds (al-Salihat)' - indeed this indicates that action is beyond faith, not from the essence of faith itself, otherwise action would be in the position of repetition. It is astonishing that he claimed consensus in this while also transmitting his saying, peace be upon him: 'No one becomes an unbeliever except after rejecting what they affirmed,' and he denies the Mu'tazilites' statement of eternal punishment in the Fire due to major sins. The one who says this is saying the same doctrine as the Mu'tazilites, for it is said to him: 'Whoever affirms with their heart (Qalb) and testifies with their tongue and dies immediately - is he in Paradise?' He must say yes, and in this is a ruling on the existence of faith without action. We add and say: If he remained alive until the time of one prayer entered upon him and he abandoned it, then died, or committed adultery then died - is he eternally punished in the Fire? If he says yes, then this is the intent of the Mu'tazilites; and if he says no, then this is a clear statement that action is not a pillar of the essence of faith, nor a condition for its existence, nor for deserving Paradise through it.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Foundations of Belief'", "badge": "Insight"}], "43": [{"arabic": "وهم على الدوام بين أصناف هذه النعم يترددون وهم من زوالها آمنون قال أبو هريرة: قال رسول الله ﭬ: (ينادى مناد: يا أهل الجنة إن لكم أن تصحوا فلا تسقموا أبدا وإن لكم أن تحيوا فلا تموتوا أبدا وإن لكم أن تشبوا فلا تهرموا أبدا وإن لكم أن تنعموا فلا تبأسوا أبدا فذلك قوله عز وجل: ﴿ ونودوا أن تلكم الجنة أورثتموها بما كنتم تعلمون ﴾ {}[216]) ومهما أردت أن تعرف صفة الجنة فاقرأ القرآن فليس وراء بيان الله تعالى بيان واقرأ من قوله تعالى: ﴿ لمن خاف مقام ربه جنتان ﴾ {} إلى آخر سورة الرحمن واقرأ سورة الواقعة وغيرها", "english": "And they are perpetually circulating among these varieties of blessings and they are secure from their disappearance. Abu Hurairah said: The Messenger of Allah (peace be upon him) said: 'A caller will call out: O people of Paradise, indeed for you is to be healthy so you will never be sick forever, and indeed for you is to live so you will never die forever, and indeed for you is to be youthful so you will never grow old forever, and indeed for you is to enjoy comfort so you will never be miserable forever. And that is His statement, the Exalted: \"And they will be called: That is Paradise which you have been made to inherit for what you used to do.\" And whenever you want to know the description of Paradise, then read the Quran, for there is no explanation beyond the explanation of Allah, the Exalted. And read from His statement, the Exalted: \"For those who feared the standing (maqām) of their Lord are two gardens\" to the end of Surah Ar-Rahman, and read Surah Al-Waqi'ah and other surahs.'", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Book of Repentance'", "badge": "Afterlife"}, {"arabic": "فإذا استوى على الراحلة واستوت تحته قال سبحان الله والحمد لله ولا إله إلا الله والله أكبر سبع مرات وقال الحمد لله الذي هدانا لهذا وما كنا لنهتدي لولا أن هدانا الله اللهم أنت الحامل على الظهر وأنت المستعان على الأمور.", "english": "When he mounts the riding animal and it becomes steady beneath him, he says: Glory be to Allah (Subhan Allah) and Praise be to Allah (Alhamdulillah) and There is no god but Allah (La ilaha illa Allah) and Allah is the Greatest (Allahu Akbar) seven times, and he says: Praise be to Allah (Alhamdulillah) who has guided us to this, and we would not have been guided had Allah not guided us. O Allah (Allahumma), You are the Carrier on the back and You are the One sought for help in matters.", "book_file": "vol1_Vol1-book-7.doc.txt", "book_title": "Mysteries of Hajj", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Mysteries of Hajj'", "badge": "Du'a"}, {"arabic": "فإذا استوت الدابة تحته فليقل الحمد لله الذي هدانا لهذا وما كنا لنهتدي لولا أن هدانا الله اللهم أنت الحامل على الظهر وأنت المستعان على الأمور", "english": "When the mount is steady beneath him, let him say: 'Praise be to Allah who guided us to this, and we would not have been guided had Allah not guided us. O Allah, You are the Carrier on the back, and You are the One sought for help in matters.'", "book_file": "vol2_j2-k07.doc.txt", "book_title": "Etiquette of Travel", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Etiquette of Travel'", "badge": "Du'a"}, {"arabic": "ثم اتكأ فقال: ﴿ الحمد لله الذي هدانا لهذا وما كنا لنهتدى لو لا أن هدانا الله ﴾ ثم ينادى مناد تحيون فلا تموتون أبدا وتقيمون فلا تظعنون أبدا وتصحون فلا تمرضون أبدا", "english": "Then he reclined and said: 'Praise (Al-Hamd) be to Allah who has guided us to this, and we would not have been guided had Allah not guided us.' Then a caller calls out: 'You live and never die, you settle and never depart, you are healthy and never become ill.'", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Book of Repentance'", "badge": "Du'a"}], "44": [{"arabic": "ولا ينكر بقاء ذكر الله عز وجل معه بعد الموت فيقول إنه أعدم فكيف يبقى معه ذكر الله عز وجل فإنه لم يعدم عدما يمنع الذكر بل عدما من الدنيا وعالم الملك والشهادة لا من عالم الملكوت وإلى ما ذكرناه الإشارة بقوله ﭬ: (القبر إما حفرة من حفر النار أو روضة من رياض الجنة[58]) وبقوله ﭬ: (أرواح الشهداء في حواصل طيور خضر[59]) وبقوله ﭬ لقتلى بدر من المشركين: (يا فلان ويا فلان وقد سماهم النبي ﭬ هل وجدتم ما وعد ربكم حقا فإني وجدت ما وعدني ربي حقا[60] فسمع عمر رضي الله عنه قوله ﭬ فقال: يا رسول الله كيف يسمعون وأنى ", "english": "And one should not deny the remaining of the Remembrance (Dhikr) of Allah, the Exalted, with him after death by saying that he has been annihilated, so how can the Remembrance (Dhikr) of Allah remain with him? For he has not been annihilated with an annihilation that prevents remembrance, but rather with an annihilation from the worldly life and the realm of dominion and witness, not from the realm of sovereignty. And to what we have mentioned is the allusion in his saying ﭬ: (The grave is either a pit from the pits of Hell or a garden from the gardens of Paradise[58]) and in his saying ﭬ: (The spirits of the martyrs are in the crops of green birds[59]) and in his saying ﭬ to the slain of Badr from the polytheists: (O so-and-so and O so-and-so—and the Prophet ﭬ named them—'Have you found what your Lord promised you to be true? For I have found what my Lord promised me to be true.'[60] Then Umar, may Allah be pleased with him, heard his saying ﭬ and said: 'O Messenger of Allah, how do they hear and how do they respond when they have become decomposed?' He said ﭬ: 'By the One in Whose Hand is my soul, you are not more hearing of my speech than them, but they are not able to respond.') And the hadith is in the Sahih; this is his saying ﭬ regarding the polytheists. As for the believers and the martyrs, he has said ﭬ: (Their spirits are in the crops of green birds suspended beneath the Throne[61]) And this state and what is alluded to by these expressions does not contradict the Remembrance (Dhikr) of Allah, the Exalted. And Allah, the Exalted, said: ﴿ And never think of those who have been killed in the cause of Allah as dead. Rather, they are alive with their Lord, receiving provision, rejoicing in what Allah has bestowed upon them of His bounty, and they receive good tidings about those [to be martyred] after them who have not yet joined them... ﴾ {} the verse. And due to the nobility of the Remembrance (Dhikr) of Allah, the Exalted, the rank of martyrdom is magnified, because the sought-after is the conclusion, and by the conclusion we mean the farewell to the worldly life and the arrival before Allah, with the Heart (Qalb) immersed in Allah, the Exalted, severed from attachments to other than Him. For if a servant is able to make his concern immersed in Allah, the Exalted, he cannot die in that state except in the ranks of combat, for he has cut off hope from his soul, his family, his wealth, and his children, indeed from the entire worldly life, for he desires it for his life, and he has made light in his heart of his life in the love of Allah, the Exalted, and seeking His pleasure, so there is no greater devotion to Allah...", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter", "badge": "Afterlife"}], "50": [{"arabic": "وكذلك المخاطبات التي تجري من منكر ونكير وفي الميزان والصراط والحساب ومناظرات أهل النار وأهل الجنة في قولهم: ﴿ أفيضوا علينا من الماء أو مما رزقكم الله ﴾ { سورة الأعراف:50 } زعموا أن ذلك كله بلسان الحال وغلا آخرون في حسم الباب منهم أحمد بن حنبل رضي الله عنه حتى منع تأويل قوله: ﴿ كن فيكون ﴾ { سورة النحل: 40 } وزعموا أن ذلك خطاب بحرف وصوت يوجد من الله تعالى في كل لحظة بعدد كون مكون", "english": "And likewise the dialogues that occur from Munkar and Nakir (the two questioning angels in the grave) and in the Scale (Mizan), the Bridge (Sirat), and the Reckoning (Hisab), and the debates between the people of the Fire (Ahl al-Nar) and the people of the Garden (Ahl al-Jannah) in their saying: 'Pour upon us from the water or from what Allah has provided you' (Surah al-A'raf: 50). They claimed that all of that is by the tongue of the state (bi-lisan al-hal), and others went to extremes in sealing the door, among them Ahmad ibn Hanbal (may Allah be pleased with him), to the point that he prohibited the interpretation (ta'wil) of His saying: 'Be, and it is' (Surah an-Nahl: 40), and they claimed that that is a discourse with letter and sound that occurs from Allah (Exalted is He) in every moment according to the number of a being being brought into existence.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Foundations of Belief'", "badge": "Afterlife"}], "52": [{"arabic": "وقال عز وجل: ﴿ولقد جئناهم بكتاب فصلناه على علم﴾ وقال تعالى: ﴿فلنقصن عليهم بعلم﴾ وقال عز وجل: ﴿بل هو آيات بينات في صدور الذين أوتوا العلم﴾ وقال تعالى: ﴿خلق الإنسان¤ علمه البيان﴾ وإنما ذكر ذلك في معرض الامتنان.", "english": "And the Mighty and Majestic said: 'And indeed We have brought them a Book which We have detailed with knowledge (ʿilm)' (Quran 7:52). And the Exalted said: 'So We will relate to them with knowledge (ʿilm)' (Quran 7:7). And the Mighty and Majestic said: 'Rather, it is clear signs in the breasts of those who have been given knowledge (ʿilm)' (Quran 29:49). And the Exalted said: 'He created the human being, He taught him the clear expression (bayān)' (Quran 55:3-4). And indeed He mentioned that in the context of bestowing favor.", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}], "54": [{"arabic": "والثاني: الأحكام، وحاصله يرجع إلى الاستدلال على الحوادث بالأسباب وهو يضاهي استدلال الطبيب بالنبض على ما سيحدث من المرض وهو معرفة لمجاري سنة الله تعالى وعادته في خلقه ولكن قد ذمه الشرع قال صلى الله عليه وسلم: (إذا ذكر القدر فأمسكوا وإذا ذكرت النجوم فأمسكوا وإذا ذكر أصحابي فأمسكوا)[81]. وقال صلى الله عليه وسلم: (أخاف على أمتي بعدي ثلاثا حيف الأئمة والإيمان بالنجوم والتكذيب بالقدر)[82]. وقال عمر بن الخطاب رضي الله عنه: تعلموا من النجوم ما تهتدون به في البر والبحر ثم أمسكوا. وإنما زجر عنه من ثلاثة أ", "english": "The second: The judgments, and its essence returns to deducing events through causes, which resembles a doctor deducing from the pulse what will occur of illness, and it is knowledge of the courses of the custom (Sunnah) of Allah the Exalted and His habit in His creation, but the Law has censured it. The Prophet (peace be upon him) said: 'When predestination (Qadar) is mentioned, refrain; when the stars are mentioned, refrain; and when my companions are mentioned, refrain.' And the Prophet (peace be upon him) said: 'I fear for my community after me three things: the injustice of rulers, belief in the stars, and denial of predestination (Qadar).' And Umar ibn al-Khattab (may Allah be pleased with him) said: 'Learn from the stars what guides you on land and sea, then refrain.' And it is prohibited for three aspects: The first: It harms most of creation, for when it is cast to them that these effects occur following the movement of the planets, it settles in their souls (Nufus) that the planets are the effectors and that they are the deities managing because they are noble celestial substances, and their impact becomes great in the hearts (Qulub), so the heart (Qalb) remains attentive to them, and good and evil are seen as feared or hoped from their direction, and the remembrance (Dhikr) of Allah the Exalted is erased from the heart (Qalb), for the weak one limits his view to the intermediaries, and the firmly established scholar is the one who perceives that the sun, the moon, and the stars are subjugated by His command, glory be to Him and exalted is He. And the example of the weak one's view to the occurrence of sunlight following sunrise is like an ant if intellect were created for it and it were on the surface of a paper, and it looks at the blackness of the line being renewed, so it believes it is the action of the pen, and it does not ascend in its view to witnessing the fingers, then from them to the hand, then from it to the moving will (Iradah) of the hand, then from it to the writer, the capable, the willing, then from him to the creator of the hand, capability, and will (Iradah). So most of the view of creation is limited to the proximate, lowly causes, cut off from ascending to the causer of causes. This is one of the reasons for prohibition regarding the stars.", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "ويستحب أن يقرأ الآيات المخصوصة مثل آية الكرسي وآخر البقرة وغيرهما وقوله تعالى: ﴿ وإلهكم إله واحد لا إله إلا هو ﴾ {} إلى قوله: ﴿ لقوم يعقلون ﴾ {} يقال إن من قرأها عند النوم حفظ الله عليه القرآن فلم ينسه ويقرأ من سورة الأعراف هذه الآية: ﴿ إن ربكم الله الذي خلق السموات والأرض في ستة أيام ﴾ {} إلى قوله: ﴿ قريب من المحسنين ﴾ {} وآخر بني إسرائيل ﴿ قل ادعوا الله ﴾ {} الآيتين فإنه يدخل في شعاره ملك يوكل بحفظه فيستغفر له ويقرأ المعوذتين وينفث بهن في يديه ويمسح بهما وجهه وسائر جسده كذلك روى من فعل رسول ال", "english": "And it is recommended to recite the specified verses such as the Throne Verse (Ayat al-Kursi) and the end of Surah al-Baqarah and others, and His saying, the Exalted: 'And your god is one God. There is no deity except Him' {} until His saying: 'for a people who use reason' {}. It is said that whoever recites it at sleep, Allah preserves the Quran for him so he does not forget it. And recite from Surah al-A'raf this verse: 'Indeed, your Lord is Allah who created the heavens and the earth in six days' {} until His saying: 'is near to the doers of good' {}. And the end of Bani Isra'il 'Say, Call upon Allah' {} the two verses, for then enters into his emblem an angel entrusted with his protection who seeks forgiveness for him. And recite the two seeking refuge (al-Mu'awwidhatayn) and blow with them into his hands and wipe with them his face and the rest of his body, as narrated from the action of the Messenger of Allah, peace be upon him[73]. And let him recite ten from the beginning of al-Kahf and ten from its end, and these verses are for awakening for the night prayer (Qiyam al-Layl). And Ali, may Allah honor his face, said: 'I do not think that a man with complete intellect sleeps before reciting the two verses from the end of Surah al-Baqarah.' And let him say twenty-five times: Glory be to Allah (Subhan Allah) and praise be to Allah (al-Hamd lillah) and there is no god but Allah (La ilaha illa Allah) and Allah is the Greatest (Allahu Akbar), so that the total of these four phrases becomes four hundred times.", "book_file": "vol1_Vol1-book-10.doc.txt", "book_title": "Book of Knowledge", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Book of Knowledge'", "badge": "Du'a"}], "55": [{"arabic": "الرابع: خفض الصوت بين المخافتة والجهر لما روى أن أبا موسى الأشعري قال قدمنا مع رسول الله فلما دنونا من المدينة كبر وكبر الناس ورفعوا أصواتهم فقال النبي ﭬ: (يا أيها الناس إن الذي تدعون ليس بأصم ولا غائب إن الذي تدعون بينكم وبين أعناق ركابكم) وقالت عائشة رضي الله عنه في قوله عز وجل: ﴿ ولا تجهر بصلاتك ولا تخافت بها ﴾ {} أي بدعائك وقد أثنى الله عز وجل على نبيه زكرياء عليه السلام حيث قال: ﴿ إذ نادى ربه نداء خفيا ﴾ {} وقال عز وجل: ﴿ ادعوا ربكم تضرعا وخفية ﴾ {}. الخامس: أن لا يتكلف السجع في الدعاء فإن ", "english": "Fourth: Lowering the voice between whispering and loudness, as narrated that Abu Musa al-Ash'ari said: We arrived with the Messenger of Allah, and when we approached Medina, he said 'Allahu Akbar' and the people said 'Allahu Akbar' and raised their voices. The Prophet said: (O people, the One you call upon is not deaf nor absent; the One you call upon is between you and the necks of your mounts). And Aisha, may Allah be pleased with her, said regarding His saying, the Exalted: (And do not be loud in your prayer nor whisper it) meaning in your supplication. And Allah, the Exalted, praised His prophet Zakariya, peace be upon him, when He said: (When he called upon his Lord with a secret call). And the Exalted said: (Call upon your Lord humbly and secretly). Fifth: That one should not contrive rhymed prose in supplication, for the state of the supplicant should be a state of humility (mutadarriʿ), and contrivance does not suit it. He said: (There will be a people who exceed bounds in supplication). And the Exalted said: (Call upon your Lord humbly and secretly; indeed, He does not love the transgressors). It is said its meaning is contrivance for rhymed prose, and it is preferable not to go beyond the transmitted supplications, for one may transgress in his supplication and ask for what his benefit does not require, for not everyone is good at supplication. Therefore, it is narrated from Mu'adh, may Allah be pleased with him, that the scholars are needed in Paradise, for it will be said to the people of Paradise: 'Wish,' and they will not know how to wish until they learn from the scholars. And he said: (Beware of rhymed prose in supplication; it is enough for one of you to say: O Allah, I ask You for Paradise and what brings near to it of speech and action, and I seek refuge in You from the Fire and what brings near to it of speech and action). And in the report: 'There will come a people who exceed bounds in supplication and purification.' And some of the predecessors passed by a storyteller supplicating with rhymed prose and said to him: 'May Allah elevate your exaggeration, I bear witness that I saw Habib al-'Ajami supplicating, and he did not exceed saying: O Allah, make us good, O Allah, do not disgrace us on the Day of Resurrection, O Allah, grant us success in good,' and the people were supplicating from every direction behind him, and he was known for the blessing of his supplication. And some of them said: 'Supplicate with the tongue of humility (dhull) and neediness (iftiqar), not with the tongue of eloquence and fluency.'", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure", "badge": "Ethics"}, {"arabic": "الرابع: خفض الصوت بين المخافتة والجهر لما روى أن أبا موسى الأشعري قال قدمنا مع رسول الله فلما دنونا من المدينة كبر وكبر الناس ورفعوا أصواتهم فقال النبي ﷺ: (يا أيها الناس إن الذي تدعون ليس بأصم ولا غائب إن الذي تدعون بينكم وبين أعناق ركابكم) وقالت عائشة رضي الله عنها في قوله عز وجل: ﴿ ولا تجهر بصلاتك ولا تخافت بها ﴾ {} أي بدعائك وقد أثنى الله عز وجل على نبيه زكرياء عليه السلام حيث قال: ﴿ إذ نادى ربه نداء خفيا ﴾ {} وقال عز وجل: ﴿ ادعوا ربكم تضرعا وخفية ﴾ {}. الخامس: أن لا يتكلف السجع في الدعاء فإن", "english": "Fourth: Lowering the voice between whispering and loudness, because it was narrated that Abu Musa al-Ash'ari said: 'We came with the Messenger of Allah, and when we approached Medina, he said takbir and the people said takbir and raised their voices.' The Prophet ﷺ said: 'O people, the One you are calling is not deaf nor absent; the One you are calling is between you and the necks of your mounts.' And Aisha, may Allah be pleased with her, said regarding His saying, the Mighty and Majestic: 'And do not be loud in your prayer nor whisper it' - meaning in your supplication. And Allah, the Mighty and Majestic, praised His prophet Zakariya, peace be upon him, when He said: 'When he called upon his Lord with a secret call.' And the Mighty and Majestic said: 'Call upon your Lord with humility and in secret.' Fifth: That one should not force rhymed prose in supplication, for the state of the supplicant should be a state of humility, and affectation does not suit it. The Prophet ﷺ said: 'There will be a people who transgress in supplication.' And the Mighty and Majestic said: 'Call upon your Lord with humility and in secret. Indeed, He does not love the transgressors.' It is said its meaning is affectation for rhymed prose. And it is preferable not to go beyond the transmitted supplications, for one may transgress in his supplication and ask for what his benefit does not require, and not everyone is good at supplication. Therefore, it is narrated from Mu'adh, may Allah be pleased with him, that the scholars are needed in Paradise, for it will be said to the people of Paradise: 'Wish,' and they will not know how to wish until they learn from the scholars. And the Prophet ﷺ said: 'Beware of rhymed prose in supplication; it is enough for one of you to say: O Allah, I ask You for Paradise and what brings near to it of speech and action, and I seek refuge in You from the Fire and what brings near to it of speech and action.' And in the report: 'There will come a people who transgress in supplication and purification.' And some of the predecessors passed by a storyteller supplicating with rhymed prose and said to him: 'May Allah elevate your exaggeration; I bear witness that I saw Habib al-'Ajami supplicating and he did not exceed saying: O Allah, make us good, O Allah, do not disgrace us on the Day of Resurrection, O Allah, grant us success in good.' And the people were supplicating from every direction behind him, and he was known for the blessing of his supplication. And some of them said: 'Supplicate with the tongue of lowliness and need, not with the tongue of eloquence and fluency.' And it is said that the scholars, the substitutes, do not exceed seven words or less in supplication, and the end of Surah al-Baqarah testifies to this, for Allah, the Exalted, did not inform in any place of the supplications of worship more than that.", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure", "badge": "Ethics"}, {"arabic": "السادس: التضرع والخشوع والرغبة والرهبة قال الله تعالى: ﴿ إنهم كانوا يسارعون في الخيرات ويدعوننا رغبا ورهبا ﴾ {} وقال عز وجل: ﴿ ادعوا ربكم تضرعا وخفية ﴾ {} وقال ﭬ: (إذا أحب الله عبدا ابتلاه حتى يسمع تضرعه[87]).", "english": "Sixth: Supplication (Tadarru') and Humility (Khushu') and Desire (Raghba) and Fear (Rahba). Allah the Exalted said: 'Indeed, they used to hasten to good deeds and supplicate Us with desire and fear' {} and He the Mighty and Majestic said: 'Supplicate your Lord with humility (Tadarru') and in secret (Khufya)' {} and the Prophet (peace be upon him) said: 'When Allah loves a servant, He tests him until He hears his supplication (Tadarru')[87].'", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance", "badge": "Du'a"}, {"arabic": "قال الله تعالى: ﴿ وإذا سألك عبادي عني فإني قريب أجيب دعوة الداع إذا دعان فليستجيبوا لي ﴾ {} وقال تعالى: ﴿ ادعوا ربكم تضرعا وخفية إنه لا يحب المعتدين ﴾ {} وقال تعالى: ﴿ وقال ربكم ادعوني أستجب لكم إن الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين ﴾ {} وقال عز وجل: ﴿ قل ادعوا الله أو ادعوا الرحمن أيا ما تدعوا فله الأسماء الحسنى ﴾ {} وروى النعمان بن بشير عن النبي ﭬ أنه قال: (إن الدعاء هو العبادة ثم قرأ: ﴿ ادعوني أستجب لكم ﴾ {}[65]) الآية. وقال ﭬ: (الدعاء مخ العبادة[66]) وروى أبو هريرة أنه ﭬ قال: (ليس ", "english": "Allah the Exalted said: 'And when My servants ask you concerning Me, indeed I am near. I respond to the invocation of the supplicant when he calls upon Me. So let them respond to Me' (Quran 2:186). And He said: 'Call upon your Lord humbly (tadarru'an) and in secret (khufyatan). Indeed, He does not like the transgressors' (Quran 7:55). And He said: 'And your Lord says, \"Call upon Me; I will respond to you. Indeed, those who disdain My worship will enter Hell in humiliation\"' (Quran 40:60). And the Mighty and Majestic said: 'Say, \"Call upon Allah or call upon the Most Merciful. Whichever [name] you call - to Him belong the best names\"' (Quran 17:110). And An-Nu'man ibn Bashir narrated from the Prophet (peace be upon him) that he said: ('Supplication (Du'a) is worship (al-'Ibadah).' Then he recited: 'Call upon Me; I will respond to you' (Quran 40:60) [65]). And he (peace be upon him) said: ('Supplication (Du'a) is the marrow of worship (mukhkh al-'Ibadah) [66]'). And Abu Hurairah narrated that he (peace be upon him) said: ('Nothing is more honorable to Allah the Mighty and Majestic than supplication (Du'a) [67]'). And he (peace be upon him) said: ('The servant (al-'Abd) does not miss from supplication (Du'a) one of three things: either a sin (dhamb) is forgiven for him, or a good (khayr) is hastened for him, or a good (khayr) is stored for him [68]'). And Abu Dharr (may Allah be pleased with him) said: 'Sufficient for supplication (Du'a) with righteousness (al-Birr) is what suffices food from salt.' And he (peace be upon him) said: ('Ask Allah the Exalted from His bounty, for indeed Allah the Exalted loves to be asked, and the best worship (al-'Ibadah) is awaiting relief (al-Faraj) [69]').", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication", "badge": "Hadith"}], "56": [{"arabic": "وحيث اقتصر ذكر شرطا جامعا فقال تعالى ﴿ إن رحمة الله قريب من المحسنين ﴾ {} فالإحسان يجمع الكل وهكذا من يتصفح القرآن من أوله إلى آخره ومن فهم ذلك فجدير بأن يكون حاله الخشية والحزن ولذلك قال الحسن: والله ما أصبح اليوم عبد يتلو القرآن يؤمن به إلا كثر حزنه وقل فرحه وكثر بكاؤه وقل ضحكه وكثر نصبه وشغله وقلت راحته وبطالته.", "english": "And where He limited the mention to a comprehensive condition, He said, the Most High: 'Indeed, the Mercy (Rahmah) of Allah is near to the Doers of Good (Muhsinin).' {} So the Doing of Good (Ihsan) encompasses all. And thus, whoever peruses the Quran from its beginning to its end and understands that, it is fitting that his state be one of fear (Khashyah) and sorrow. Therefore, Al-Hasan said: By Allah, no servant today recites the Quran and believes in it except that his sorrow increases and his joy decreases, his weeping increases and his laughter decreases, his toil and preoccupation increase and his rest and idleness decrease.", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}, {"arabic": "ولنرجع إلى الغرض المطلوب فالمقصود أن غرور الشيطان بأن الآخرة شك يدفع إما بيقين تقليدي، وأما ببصيرة ومشاهدة من جهة الباطن، والمؤمنين بألسنتهم وبعقائدهم إذا ضيعوا أوامر الله تعالى وهجروا الأعمال الصالحة ولابسوا الشهوات والمعاصي فهم مشاركون للكفار في هذا الغرور من النار ولو بعد حين، ولكنهم أيضاً من المغرورين فإنهم اعترفوا بأن الآخرة خير من الدنيا ولكنهم مالوا إلى الدنيا وآثروها، ومجرد الإيمان لا يكفي للفوز قال تعالى \"وإني لغفار لمن تاب وآمن وعمل صالحاً ثم اهتدى\" وقال تعالى \"إن رحمت الله قريب من الم", "english": "And let us return to the intended purpose, so the intended meaning is that the deception of Satan that the Hereafter is doubt is repelled either by traditional certainty, or by insight and witnessing from the aspect of the inner (Batin), and the believers with their tongues and with their beliefs if they neglect the commands of Allah the Exalted and abandon righteous works and engage in desires and disobediences, then they are partners with the disbelievers in this deception from the Fire even if after a while, but they are also among the deceived, for they acknowledged that the Hereafter is better than the world but they inclined to the world and preferred it, and mere faith is not sufficient for success. Allah the Exalted said: \"And indeed, I am Forgiving to whoever repents and believes and does righteous work then is guided\" and Allah the Exalted said: \"Indeed, the mercy of Allah is near to the doers of good (Muhsinin)\" then the Prophet (peace be upon him) said: \"Ihsan (doing good) is that you worship Allah as if you see Him\" and Allah the Exalted said: \"By time, indeed, mankind is in loss, except for those who have believed and done righteous works and advised each other to truth and advised each other to patience.\" So the promise of forgiveness in all the Book of Allah the Exalted is tied to faith and righteous work together, not to faith alone, so these are also deceived, I mean those who are content with the world, joyful in it, indulgent in its pleasures, loving it. Those who hate death fearing the loss of worldly pleasures, not those who hate it fearing what comes after it, so this is an example of deception by the world from both disbelievers and believers altogether.", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Delusion'", "badge": "Ethics"}, {"arabic": "وقد أمر الله تعالى بالعدل والإحسان جميعا والعدل سبب النجاة فقط وهو يجري من التجارة مجرى رأس المال والإحسان سبب الفوز ونيل السعادة وهو يجري من التجارة مجرى الربح ولا يعد من الغفلاء من قنع في معاملات الدنيا برأس ماله فكذا في معاملات الآخرة فلا ينبغي للمتدين أن يقتصر على العدل واجتناب الظلم ويدع أبواب الإحسان وقد قال الله وأحسن كما أحسن الله إليك وقال عز وجل إن الله يأمر بالعدل والإحسان وقال سبحانه إن رحمت الله قريب من المحسنين ونعني بالإحسان فعل ما ينتفع به المعامل وهو غير واجب عليه ولكنه تفضل منه", "english": "And Allah the Exalted has commanded justice and excellence in conduct (Ihsan) together. Justice is only the cause of salvation, and it flows in trade like capital. Excellence in conduct (Ihsan) is the cause of triumph and attainment of happiness, and it flows in trade like profit. One is not considered among the heedless who is content in worldly transactions with his capital, likewise in the transactions of the Hereafter. So it is not fitting for the religious person to limit himself to justice and avoiding oppression and abandon the doors of excellence in conduct (Ihsan). And Allah has said: 'And do good as Allah has done good to you' (28:77). And the Mighty and Majestic said: 'Indeed, Allah commands justice and excellence in conduct (Ihsan)' (16:90). And He the Glorified said: 'Indeed, the mercy of Allah is near to the doers of good (Al-Muhsinin)' (7:56). And we mean by excellence in conduct (Ihsan) doing what benefits the other party in transaction, and it is not obligatory upon him, but it is a favor from him. For the obligatory enters into the category of justice and avoiding oppression, and we have mentioned it.", "book_file": "vol2_j2-k03.doc.txt", "book_title": "Etiquette of Earning", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Etiquette of Earning'", "badge": "Ethics"}], "57": [{"arabic": "وقوله تعالى ﴿ فأنزلنا به الماء ﴾ {} يعني السحاب ﴿ فأخرجنا به من كل الثمرات ﴾ {} يعني الماء وأمثال هذا في القرآن لا ينحصر.", "english": "And His saying, the Exalted: 'And We sent down with it water' (Quran 7:57) means the cloud. 'And We brought forth with it every kind of fruit' (Quran 7:57) means the water. And examples like this in the Quran are countless.", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Etiquette of Quran Recitation'", "badge": "General"}], "63": [{"arabic": "السبب الرابع: التعجب، كما أخبر الله تعالى عن الأمم السالفة إذ قالوا \"ما أنتم إلا بشر مثلنا\" \"وقالوا أنؤمن لبشرين مثلنا\" \"ولئن أطعتم بشراً مثلكم إنكم إذاً لخاسرون\" فتعجبوا من أن يفوز برتبة الرسالة والوحي والقرب من الله تعالى بشر مثلهم فحسدوهم، وأحبوا زوال النبوة عنهم جزعاً أن يفضل عليهم من هو مثلهم في الخلقة، لا عن قصد تكبر وطلب رياسة وتقدم عداوة أو سبب آخر من سائر الأسباب، وقالوا متعجبين \"أبعث الله بشراً رسولاً\" وقالوا \"لولا أنزل علينا الملائكة\" وقال تعالى \"أو عجبتم أن جاءكم ذكر من ربكم على رجل ", "english": "The fourth cause: Astonishment (Ta'ajjub), as Allah the Exalted informed about the past nations when they said, \"You are only human beings like us,\" \"And they said, 'Shall we believe for two human beings like ourselves?',\" \"And if you obey a human being like yourselves, then indeed, you would be losers.\" So they were astonished that a human being like them would attain the rank of Messengership, Revelation, and closeness to Allah the Exalted, so they envied them, and desired the removal of Prophethood from them out of distress that one who is like them in creation would be favored over them, not from an intention of arrogance, seeking leadership, advancing enmity, or any other cause from the various causes. And they said in astonishment, \"Has Allah sent a human being as a messenger?\" And they said, \"Why were angels not sent down to us?\" And Allah the Exalted said, \"Or are you astonished that a Remembrance (Dhikr) from your Lord has come to you upon a man from among you?\" The verse.", "book_file": "vol3_Vol3-book5a.doc.txt", "book_title": "Condemnation of Envy", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Envy'", "badge": "Ethics"}], "69": [{"arabic": "السبب الرابع: التعجب، كما أخبر الله تعالى عن الأمم السالفة إذ قالوا \"ما أنتم إلا بشر مثلنا\" \"وقالوا أنؤمن لبشرين مثلنا\" \"ولئن أطعتم بشراً مثلكم إنكم إذاً لخاسرون\" فتعجبوا من أن يفوز برتبة الرسالة والوحي والقرب من الله تعالى بشر مثلهم فحسدوهم، وأحبوا زوال النبوة عنهم جزعاً أن يفضل عليهم من هو مثلهم في الخلقة، لا عن قصد تكبر وطلب رياسة وتقدم عداوة أو سبب آخر من سائر الأسباب، وقالوا متعجبين \"أبعث الله بشراً رسولاً\" وقالوا \"لولا أنزل علينا الملائكة\" وقال تعالى \"أو عجبتم أن جاءكم ذكر من ربكم على رجل ", "english": "The fourth cause: Amazement (Ta'ajjub), as Allah the Exalted informed about the past nations when they said, 'You are only human beings like us' and 'They said: Shall we believe in two human beings like ourselves?' and 'If you obey a human being like yourselves, then indeed you would be losers.' So they were amazed that a human being like them would attain the rank of Messengership, Revelation, and proximity (Qurb) to Allah the Exalted, so they envied them, and desired the removal of Prophethood from them out of distress that one who is like them in creation would be preferred over them, not from an intention of arrogance, seeking leadership, advancing enmity, or any other cause from the rest of the causes. And they said in amazement, 'Has Allah sent a human being as a messenger?' and they said, 'Why were not angels sent down to us?' And Allah the Exalted said, 'Or do you wonder that a Remembrance (Dhikr) from your Lord has come to you upon a man from among you to warn you? And remember when He made you successors after the people of Noah and increased you in creation extensively. So remember the favors of Allah that you might succeed.'", "book_file": "vol3_Vol3-book5a.doc.txt", "book_title": "Condemnation of Envy", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Envy'", "badge": "Ethics"}], "75": [{"arabic": "ومنها المكرر القاطع لوصل الكلام في الظاهر كقوله عز وجل ﴿ وما يتبع الذين يدعون من دون الله شركاء إن يتبعون إلا الظن ﴾ {} وقوله عز وجل ﴿ قال الملأ الذين استكبروا من قومه للذين استضعفوا لمن آمن منهم ﴾ {} معناه الذين استكبروا لمن آمن من الذين استضعفوا", "english": "And among them is the repeated [construction] that cuts off the apparent connection of speech, like His saying, the Mighty and Majestic: 'And those whom they invoke besides Allah do not follow [anything]; they follow not except assumption' (Quran 6:148), and His saying, the Mighty and Majestic: 'Said the chiefs who were arrogant among his people to those who were oppressed - to those who believed among them' (Quran 7:75), its meaning is: those who were arrogant [said] to those who believed from among those who were oppressed.", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Etiquette of Quran Recitation'", "badge": "Ethics"}], "79": [{"arabic": "وقد وصف الله تعالى الكاذبين ببعضهم للناصحين إذ قال ولكن لا تحبون الناصحين وهذا في عيب هو غافل عنه فأما ما علمت انه يعلمه من نفسه فإنما هو مقهور عليه من طبعه فلا ينبغي أن يكشف فيه ستره إن كان يخفيه وإن كان يظهره فلا بد من التلطف في النصح بالتعريض مرة وبالتصريح أخرى إلى حد لا يؤدي إلى الإيحاش فإن علمت أن النصح غير مؤثر فيه وأنه مضطر من طبعه إلى الإصرار عليه فالسكوت عنه أولى وهذا كله فيما يتعلق بمصالح أخيك في دينه أو دنياه أما ما يتعلق بتقصيره في حقك فالواجب فيه الاحتمال والعفو والصفح والتعامى عنه ", "english": "And Allah the Exalted has described the liars with some of them for the advisers (الناصحين) when He said: 'But you do not love the advisers (الناصحين).' And this is regarding a defect that one is heedless of. As for what you know that he knows about himself, then it is only something he is compelled to by his nature, so it is not appropriate to uncover its covering if he conceals it, and if he reveals it, then gentleness in advice (النصح) is necessary, with allusion at times and with explicit statement at others, to a limit that does not lead to alienation. If you know that the advice (النصح) is not effective in him and that he is compelled by his nature to persist in it, then silence about it is preferable. And all of this pertains to the interests of your brother in his religion or his worldly life. As for what pertains to his shortcoming in your right, then the obligation in it is forbearance, pardon, forgiveness, and turning a blind eye to it, and addressing that is not from advice (النصح) in anything. Yes, if it is such that its continuation leads to severance, then reproach in secret is better than severance, and allusion to it is better than explicit statement, and writing is better than face-to-face speech, and forbearance is better than all, for your intention from your brother should be the rectification of your soul (نفسك) by your observance of him and your fulfillment of his right and your forbearance of his shortcoming, not seeking help from him and seeking benefit from him.", "book_file": "vol2_j2-k05.doc.txt", "book_title": "Duties of Brotherhood", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "87": [{"arabic": "وقال رجل لعمرو بن عبيد: إن الأسواري ما يزال يذكرك في قصصه بشر، فقال له عمرو: يا هذا ما رعيت حق مجالسة الرجل حيث نقلت إلينا حديثه، ولا أديت حقي حين أعلمتني عن أخي ما أكره ولكن أعمله أن الموت يعمنا والقبر يضمنا والقيامة تجمعنا والله تعالى يحكم بيننا وهو خير الحاكمين.", "english": "And a man said to Amr ibn Ubayd: Al-Aswari continues to mention you in his stories with evil, so Amr said to him: O this one, you did not observe the right of sitting with the man when you conveyed to us his speech, nor did you fulfill my right when you informed me about my brother what I dislike. But I act upon the knowledge that death encompasses us, the grave gathers us, the Resurrection (Qiyamah) assembles us, and Allah the Exalted judges between us, and He is the best of judges.", "book_file": "vol3_Vol3-book4a.doc.txt", "book_title": "Condemnation of Anger and Hatred", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Condemnation of Anger and Hatred'", "badge": "Afterlife"}], "95": [{"arabic": "وحذرهم أن يأخذهم بغتة وهم لا يشعرون فقال \"ما ينظرون إلا صيحة واحدة تأخذهم وهم يخصمون فلا يستطيعون توصية ولا إلى أهلهم يرجعون\" والصلاة والسلام على محمد رسوله الذي يسير تحت لوائه النبيون، وعلى آله وأصحابه الأئمة المهديين، والسادة المرضيين، صلاة يوازي عددها عدد ما كان من خلق الله وما سيكون، ويحظى ببركتها الأولون والآخرون، وسلم تسليماً كثيرا. أما بعد فإن الغضب شعلة نار اقتبست من نار الله الموقدة التي تطلع على الأفئدة، وإنها لمستكنة في طي الفؤاد. استكنان الجمر تحت الرماد، ويستخرجها الكبر الدفين في قل", "english": "And He warned them that He might seize them suddenly while they are unaware, as He said: \"They await not but a single Cry that will seize them while they are disputing. Then they will not be able to make a bequest, nor will they return to their families.\" And prayers and peace be upon Muhammad, His messenger, under whose banner the prophets march, and upon his family and his companions, the guided leaders, and the pleased masters, prayers equal in number to what has been of Allah's creation and what will be, and may the earlier and later ones attain its blessing, and abundant peace. After that, indeed anger is a flame of fire kindled from the fire of Allah that is ignited, which rises upon the hearts (Af'idah), and it is hidden in the recess of the heart (Fu'ad). It is like the ember hidden under ashes, and it is extracted by the concealed arrogance in the heart of every obstinate tyrant, like extracting fire from stone with iron. And it has been revealed to the observers by the light of certainty (Yaqin), that man has a vein extending to the accursed Satan (Shaytan), so whoever is provoked by the fire of anger has strengthened in him the kinship of Satan, as he said: \"You created me from fire and created him from clay.\" For the nature of clay is stillness and dignity, and the nature of fire is blazing and flaming, and movement and agitation. And from the outcomes of anger are malice (Haqd) and envy (Hasad), and by them perished those who perished and corrupted those who corrupted, and their source is a morsel; if it is rectified, the entire body is rectified with it. And if malice (Haqd), envy (Hasad), and anger are among what drive the servant to places of destruction, then how much he needs to know the means of...", "book_file": "vol3_Vol3-book5a.doc.txt", "book_title": "Condemnation of Envy", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Envy'", "badge": "Ethics"}], "99": [{"arabic": "ومن اعتقد جزماً أنه فوق أحد من عباد الله فقد أحبط بجهله جمع عمله، فإن الجهل أفحش المعاصي وأعظم شيء يبعد العبد عن الله، وحكمه لنفسه بأنه خير من غيره جهل محض وأمن من مكر الله ولا يأمن مكر الله إلا القوم الخاسرون ولذلك روي أن رجلاً ذكر بخير للنبي ﭬ فأقبل ذات يوم فقالوا: يا رسول الله هذا الذي ذكرناه لك، فقال \"إني أرى في وجهه سفعة من الشيطان، فسلم ووقف على النبي ﭬ فقال له النبي ﭬ \"أسألك بالله حدثتك نفسك أن ليس في القوم أفضل منك\" قال: اللهم نعم\"[56] فرأى رسول الله ﭬ بنور النبوة ما استكن في قلبه سفعة ف", "english": "And whoever firmly believes that he is above any of the servants of Allah has nullified with his ignorance all his deeds, for ignorance is the most vile of sins and the greatest thing that distances the servant from Allah, and his judgment for himself that he is better than others is pure ignorance and security from the plotting of Allah, and none feels secure from the plotting of Allah except the people who are losers. And for that reason, it was narrated that a man was mentioned favorably to the Prophet (peace be upon him), then he came one day and they said: O Messenger of Allah, this is the one we mentioned to you, so he said: 'Indeed, I see in his face a trace from Satan.' So he greeted and stood before the Prophet (peace be upon him), and the Prophet (peace be upon him) said to him: 'I ask you by Allah, did your soul (Nafs) tell you that there is no one in the group better than you?' He said: 'O Allah, yes.' So the Messenger of Allah (peace be upon him) saw with the light of prophethood what had settled in his heart as a trace on his face. And this is an affliction from which none of the servants is free except whom Allah protects.", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Pride and Conceit'", "badge": "Insight"}, {"arabic": "وإنما كان خوف الأنبياء مع ما فاض عليهم من النعم لأنهم لم يأمنوا مكر الله تعالى ﴿ فلا يأمن مكر الله إلا القوم الخاسرون ﴾ حتى روى أن النبي وجبريل عليهما الصلاة والسلام بكيا خوفا من الله تعالى فأوحى الله إليهما لم تبكيان وقد أمنتكما فقالا ومن يأمن مكرك وكأنهما إذ علما أن الله هو علام الغيوب وأنه لا وقوف لهما على غاية الأمور لم يأمنا أن يكون قوله قد أمنتكما ابتلاء وامتحانا لهما ومكرا بهما حتى إن سكن خوفهما ظهر أنهما قد أمنا من المكر وما وفيا بقولهما", "english": "And the fear of the Prophets, despite the abundant blessings that flowed upon them, was because they did not feel secure from the plotting (makkara) of Allah the Exalted: 'So none feels secure from the plotting (makkara) of Allah except the people who are losers.' Until it was narrated that the Prophet and Gabriel, peace be upon them both, wept out of fear from Allah the Exalted, so Allah revealed to them: 'Why do you weep when I have given you security?' They said: 'And who feels secure from Your plotting (makkara)?' And it was as if they, since they knew that Allah is the Knower of the unseen and that they had no standing regarding the ultimate matters, did not feel secure that His saying 'I have given you security' might be a trial (ibtila') and a test (imtihana) for them and a plotting (makkara) against them, so that if their fear subsided, it would become apparent that they had felt secure from the plotting (makkara) and had not been true to their saying.", "book_file": "vol4_Vol4-book3.doc.txt", "book_title": "Fear and Hope", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Fear and Hope'", "badge": "Insight"}, {"arabic": "فمن آمن به تخلص من هذا الغرور فإن منشأ هذا الغرور والجهل بالله وبصفاته، فإن من عرفه لا يأمن مكره ولا يغتر بأمثال هذه الخيالات الفاسدة، وينظر إلى فرعون وهامان وقارون وإلى ملوك الأرض وما جرى لهم كيف أحسن الله إليهم ابتداء ثم دمرهم تدميرا! فقال تعالى \"هل تحس منهم من أحد\" الآية. وقد حذر الله تعالى من مكره واستدراجه فقال \"فلا يأمن مكر الله إلا القوم الخاسرون\" وقال تعالى \"ومكروا مكراً ومكرنا مكراً وهم لا يشعرون\" وقال عز وجل \"ومكروا ومكر الله والله خير الماكرين\" وقال تعالى \"إنهم يكيدون كيداً وأكيد كيدا", "english": "So whoever believes in Him is saved from this delusion (Ghurur), for the origin of this delusion (Ghurur) is ignorance of Allah and His attributes. For whoever knows Him does not feel secure from His scheme (Makr) nor is deceived by such false imaginings, and looks at Pharaoh, Haman, and Korah, and at the kings of the earth and what befell them—how Allah initially bestowed favors upon them, then utterly destroyed them! So Allah the Exalted said: \"Do you perceive any of them?\" [Quran 19:98]. And Allah the Exalted has warned against His scheme (Makr) and gradual entrapment (Istidraj), saying: \"So none feels secure from the scheme (Makr) of Allah except the losing people.\" [Quran 7:99] And He said: \"And they devised a scheme (Makr), and We devised a scheme (Makr), while they were unaware.\" [Quran 27:50] And He the Mighty and Majestic said: \"And they devised a scheme (Makr), and Allah devised a scheme (Makr), and Allah is the best of schemers (Makirin).\" [Quran 3:54] And He said: \"Indeed, they are planning a plan (Kaid), and I am planning a plan (Kaid). So give the disbelievers respite; give them respite a little.\" [Quran 86:15-17] Just as it is not permissible for a neglected servant to infer from the master's neglect of him and enabling him with blessings that the master loves him, rather he should beware that this might be a scheme (Makr) and plot (Kaid) from him, even though the master did not warn him of his own scheme (Makr), then how much more necessary is this regarding Allah the Exalted, with His warning of His gradual entrapment (Istidraj) being more appropriate. Therefore, whoever feels secure from the scheme (Makr) of Allah is deluded (Mughtarr), and the origin of this delusion (Ghurur) is that he infers from worldly blessings that he is honored by that Bestower, and it is possible that this is evidence of degradation, but that possibility does not accord with desire (Hawa). So Satan, through the medium of desire (Hawa), inclines the heart (Qalb) toward what accompanies it, which is believing that it indicates honor, and this is the definition of delusion (Ghurur).", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Delusion'", "badge": "Ethics"}], "100": [{"arabic": "وأما الآثار المذمومة فإنها مثل دخان مظلم يتصاعد إلى مرآة القلب ولا يزال يتراكم عليه مرة بعد أخرى إلى أن يسود ويظلم ويصير بالكلية محجوبا عن الله تعالى وهو الطبع وهو الرين قال الله تعالى كلا بل ران على قلوبهم ما كانوا يكسبون وقال عز وجل أن لو نشاء أصبناهم بذنبوهم ونطبع على قلوبهم فهم لا يسمعون فربط عدم السماع بالطبع بالذنوب كما ربط السماع بالتقوى فقال تعالى واتقوا الله واسمعوا واتقوا الله ويعلمكم الله ومهما تراكمت الذنوب طبع على القلوب وعند ذلك يعمى القلب عن إدراك الحق وصلاح الدين ويستهين بأمر الآ", "english": "As for the blameworthy effects, they are like dark smoke that rises to the mirror of the Heart (Qalb) and continues to accumulate upon it time after time until it blackens and darkens and becomes completely veiled from Allah the Exalted, and this is the Sealing (Al-Tab') and the Rust (Al-Rayn). Allah the Exalted said: 'No! Rather, what they have earned has rusted upon their hearts.' And He the Mighty and Majestic said: 'Or has it not been made clear to those who inherit the earth after its [former] people that if We willed, We could afflict them for their sins and seal over their hearts so they would not hear?' So He linked the lack of hearing to the sealing with sins, just as He linked hearing to God-consciousness (Taqwa), for He the Exalted said: 'And fear Allah and listen, and fear Allah, and Allah will teach you.' Whenever sins accumulate, the hearts are sealed, and at that point the Heart (Qalb) becomes blind to perceiving the Truth (Al-Haqq) and the rectitude of the religion, and it belittles the matter of the Hereafter (Al-Akhirah) and magnifies the matter of the Worldly Life (Al-Dunya), and its concern becomes restricted to it. So when its hearing is struck by the matter of the Hereafter and the dangers within it, it enters from one ear and exits from the other, and it does not settle in the Heart (Qalb) and does not move it to repentance (Al-Tawbah) and rectification. Those are the ones who have despaired of the Hereafter (Al-Akhirah) just as the disbelievers despair of the companions of the graves. And this is the meaning of the blackening of the Heart (Qalb) by sins, as articulated by the Quran and the Sunnah.", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}], "104": [{"arabic": "فإنه يوشك أن يأتيك رسول من رب العالمين يزيلك عن سريرك ويخرجك من سعة قصرك إلى ضيق قبرك", "english": "For indeed, it is imminent that a messenger from the Lord of the Worlds (Rabb al-'Alamin) will come to you, removing you from your throne and taking you out from the spaciousness of your palace to the narrowness of your grave.", "book_file": "vol2_j2-k09.doc.txt", "book_title": "Enjoining Good and Forbidding Evil", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Enjoining Good and Forbidding Evil'", "badge": "Afterlife"}], "124": [{"arabic": "وما مثال المكاشفين والمعتقدين إلا كسحرة فرعون مع أصحاب السامري؛ فإن سحرة فرعون لما كانوا مطلعين على منتهى تأثير السحر لطول مشاهدتهم وتجربتهم رأوا من موسى عليه السلام ما جاوز حدود السحر وانكشف لهم حقيقة الأمر فلم يكترثوا بقول فرعون \"لأقطعن أيديكم وأرجلكم من خلاف\" بل \"قالوا لن نؤثرك على ما جاءنا من البينات والذي فطرنا فاقض ما أنت قاض إنما تقضي هذه الحياة الدنيا\" فإن البيان والكشف يمنع التغيير", "english": "And the example of those who have spiritual unveiling (Mukāshifīn) and those who merely believe (Muʿtaqidīn) is none other than like the magicians of Pharaoh with the followers of the Sāmirī; for the magicians of Pharaoh, since they were aware of the ultimate effect of magic due to their prolonged witnessing and experience, saw from Moses, peace be upon him, what exceeded the limits of magic, and the truth of the matter was unveiled to them, so they did not heed the saying of Pharaoh: \"I will surely cut off your hands and your feet from opposite sides\" but rather \"they said: 'We will never prefer you over what has come to us of clear proofs and He who created us. So decree whatever you are to decree. You can only decree for this worldly life.'\" For clear demonstration and unveiling (Kashf) prevent change.", "book_file": "vol4_Vol4-book5.doc.txt", "book_title": "Monotheism and Reliance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monotheism and Reliance'", "badge": "Insight"}], "126": [{"arabic": "يا من لا تضره الذنوب ولا تنقصه المغفرة هب لي ما لا يضرك وأعطني ما لا ينقصك ربنا أفرغ علينا صبرا وتوفنا مسلمين أنت ولي في الدنيا والآخرة توفنى مسلما وألحقنى بالصالحين أنت ولينا فاغفر لنا وارحمنا وأنت خير الغافرين واكتب لنا في هذه الدنيا حسنة وفي الآخرة إنا هدنا إليك ربنا عليك توكلنا وإليك أنبنا وإليك المصير ربنا لا تجعلنا فتنة للقوم الظالمين ربنا لا تجعلنا فتنة للذين كفروا واغفر لنا ربنا إنك أنت العزيز الحكيم ربنا اغفر لنا ذنوبنا وإسرافنا في أمرنا وثبت أقدامنا وانصرنا على القوم الكافرين ربنا اغفر", "english": "O You whom sins do not harm and forgiveness does not diminish, grant me what does not harm You and give me what does not diminish You. Our Lord, pour upon us patience (Sabr) and cause us to die as Muslims (Muslimin). You are the Guardian (Wali) in this world and the Hereafter. Cause me to die as a Muslim (Muslim) and join me with the righteous. You are our Guardian (Wali), so forgive us and have mercy upon us, and You are the best of forgivers. And decree for us good in this world and in the Hereafter. Indeed, we have turned to You. Our Lord, upon You we rely and to You we turn, and to You is the destination. Our Lord, do not make us a trial for the wrongdoing people. Our Lord, do not make us a trial for those who disbelieve, and forgive us. Our Lord, indeed You are the Mighty, the Wise. Our Lord, forgive us our sins and our excess in our affair, and make firm our feet and grant us victory over the disbelieving people. Our Lord, forgive us and our brothers who preceded us in faith, and do not place in our hearts any rancor for those who have believed. Our Lord, indeed You are Kind, Merciful. Our Lord, grant us from Yourself mercy and prepare for us from our affair right guidance. Our Lord, grant us good in this world and good in the Hereafter, and protect us from the punishment of the Fire. Our Lord, indeed we have heard a caller calling to faith, up to His saying, the Mighty and Majestic: 'Indeed, You do not fail in the promise.' Our Lord, do not hold us accountable if we forget or err. Our Lord, to the end of the Surah.", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance", "badge": "Du'a"}], "137": [{"arabic": "وقد وصف الله تعالى الصابرين بأوصاف وذكر الصبر في القرآن في نيف وسبعين موضعا وأضاف أكثر الدرجات والخيرات إلى الصبر وجعلها ثمرة له فقال عز من قائل: ﴿ وجعلنا منهم أئمة يهدون بأمرنا لما صبروا ﴾ {} وقال تعالى: ﴿ وتمت كلمة ربك الحسنى على بني إسرائيل بما صبروا ﴾ {} وقال تعالى: ﴿ ولنجزين الذين صبروا أجرهم بأحسن ما كانوا يعملون ﴾ {} وقال تعالى: ﴿ أولئك يؤتون أجرهم مرتين بما صبروا ﴾ {} وقال تعالى: ﴿ إنما يوفى الصابرون أجرهم بغير حساب ﴾ {} فما من قربة إلا وأجرها بتقدير وحساب إلا الصبر ولأجل كون الصوم من ال", "english": "And Allah the Exalted has described the patient ones with attributes and mentioned patience in the Quran in over seventy places, and He attributed most degrees and goodnesses to patience and made them its fruit, as He the Mighty and Sublime said: 'And We made from them leaders guiding by Our command when they were patient' (Quran 32:24), and He the Exalted said: 'And the good word of your Lord was fulfilled upon the Children of Israel because of what they patiently endured' (Quran 7:137), and He the Exalted said: 'And We will surely give those who were patient their reward according to the best of what they used to do' (Quran 16:96), and He the Exalted said: 'Those will be given their reward twice for what they patiently endured' (Quran 28:54), and He the Exalted said: 'Indeed, the patient will be given their reward without account' (Quran 39:10). So there is no act of worship except that its reward is by measure and account except patience, and because fasting is from patience and it is half of patience, Allah the Exalted said: 'Fasting is for Me and I will reward it' (Hadith), so He attributed it to Himself from among all other acts of worship, and He promised the patient ones that He is with them, as He the Exalted said: 'And be patient, indeed Allah is with the patient' (Quran 8:46), and He made victory conditional upon patience, as He the Exalted said: 'Yes, if you are patient and conscious of Allah and they come upon you in this rage of theirs, your Lord will reinforce you with five thousand angels having marks' (Quran 3:125), and He gathered for the patient ones between matters He did not gather for others, as He the Exalted said: 'Those are the ones upon whom are prayers from their Lord and mercy, and those are the ones who are guided' (Quran 2:157). So guidance, mercy, and prayers are gathered for the patient ones, and enumerating all the verses in the station of patience would be lengthy.", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}], "143": [{"arabic": "وعند هذا كاد أن يزيغ ويطلق بالجراءة لسان السؤال، فثبت بالقول الثابت ونودي من وراء حجاب سرادقات الحضرة \" لا يسأل عما يفعل وهم يسألون \" فغشيته هيبة الحضرة، فخر صعقاً يضطرب في غشيته، فلما أفاق قال: سبحانك ما أعظم شأنك تبت إليك وتوكلت عليك وآمنت بأنك الملك الجبار الواحد القهار، فلا أخاف غيرك ولا أرجو سواك ولا أعوذ إلا بعفوك من عقابك وبرضاك من سخطك، وما لي إلا أن أسألك وأتضرع إليك وأبتهل بين يديك، فأقول: اشرح لي صدري لأعرفك واحلل عقدة من لساني لأثني عليك، فنودي من وراء الحجاب: إياك أن تطمع في الثناء ", "english": "And at this point, he almost deviated and unleashed his tongue with audacity in questioning, but he was steadied by the firm word and was called from behind the veil of the pavilions of the Presence (Hadhra): \"He is not questioned about what He does, but they will be questioned.\" Then the awe of the Presence (Hadhra) overwhelmed him, and he fell unconscious, convulsing in his swoon. When he regained consciousness, he said: Glory be to You, how great is Your affair! I have repented to You and relied upon You and believed that You are the King, the Compeller, the One, the Subduer, so I fear none but You, nor hope for any other than You, nor seek refuge except in Your pardon from Your punishment and in Your pleasure from Your wrath. And I have nothing except to ask You and supplicate to You and implore before You, so I say: Expand my chest for me to know You and untie a knot from my tongue to praise You. Then he was called from behind the veil: Beware lest you aspire to praise and exceed the master of the prophets, but return to him, so whatever he gave you, take it, and whatever he forbade you from, desist from it, and whatever he said to you, say it; for he did not increase in this Presence (Hadhra) beyond saying: \"Glory be to You, I cannot enumerate praise upon You, You are as You have praised Yourself.\" So he said: My God, if the tongue has no boldness to praise You, then does the Heart (Qalb) have aspiration in knowing You? Then he was called: Beware lest you overstep the necks of the truthful ones, so return to the greatest truthful one and follow him; for the companions of the master of the prophets are like stars, by whichever you follow, you are guided. Have you not heard him saying: The inability to attain perception is perception, so it suffices you as a share from our Presence (Hadhra) that you know you are deprived from our Presence (Hadhra), unable to observe our beauty and majesty. Then at that, the traveler returned and apologized for his questions and reproaches and said to the right hand, the pen, knowledge, will, power, and what is beyond them: Accept my excuse, for I was a stranger, newly arrived in the...", "book_file": "vol4_Vol4-book5.doc.txt", "book_title": "Monotheism and Reliance", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Monotheism and Reliance'", "badge": "Ethics"}], "146": [{"arabic": "وفي قوله تعالى سأصرف عن آياتى الذين يتكبرون في الأرض يغير الحق قال أمنع قلوبهم التفكر في أمرى", "english": "And in His saying, the Exalted: 'I will turn away from My signs those who are arrogant in the earth without right' (Quran 7:146), He said: 'I prevent their hearts from thinking (Tafakkur) in My affair.'", "book_file": "vol4_j4-k09.doc.txt", "book_title": "Contemplation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Contemplation'", "badge": "Insight"}], "154": [{"arabic": "وأما بطريق الإقتباس من الآيات والأخبار فما ورد في فضيلة الخوف خارج عن الحصر وناهيك دلالة على فضيلته جمع الله تعالى للخائفين الهدى والرحمة والعلم والرضوان وهي مجامع مقامات أهل الجنان وقال الله تعالى: ﴿ وهدى ورحمة للذين هم لربهم يرهبون ﴾ {} وقال تعالى: ﴿ إنما يخشى الله من عباده العلماء ﴾ {} وصفهم بالعلم لخشيتهم وقال عز وجلّ: ﴿ رضى الله عنهم ورضوا عنه ذلك لمن خشى ربه ﴾ {} وكل ما دل على فضيلة العلم دل على فضيلة الخوف لأن الخوف ثمرة العلم ولذلك جاء في خبر موسى عليه أفضل الصلاة والسلام وأما الخائفون ف", "english": "And as for through the method of citation from the verses and reports, what has come regarding the excellence of fear is beyond enumeration, and sufficient as an indication of its excellence is that Allah the Exalted has gathered for those who fear guidance and mercy and knowledge and pleasure, and these are the collective stations of the people of the Gardens. And Allah the Exalted said: 'And guidance and mercy for those who are in awe of their Lord (yarhaboon).' And He the Exalted said: 'Only those fear Allah from among His servants who are knowledgeable (al-'ulama).' He described them with knowledge due to their awe. And He the Majestic and Exalted said: 'Allah is pleased with them and they are pleased with Him; that is for whoever fears his Lord.' And everything that indicates the excellence of knowledge indicates the excellence of fear because fear is the fruit of knowledge. And therefore it came in the report of Moses, upon him the best of prayers and peace, and as for those who fear, then for them is the Highest Companion (al-Rafiq al-A'la) in which they are not shared. So see how He singled them out with the companionship of the Highest Companion, and that is because they are the knowledgeable ones (al-'ulama), and the knowledgeable ones have the rank of companionship with the prophets because they are the inheritors of the prophets, and the companionship of the Highest Companion is for the prophets and those who join them. And therefore (when the Messenger of Allah, peace be upon him, was given the choice during his terminal illness between remaining in the world and coming to Allah the Exalted, he would say: 'I ask You for the Highest Companion.') So then, if one looks at its producer, it is knowledge, and if one looks at its fruit, it is scrupulousness (al-wara') and piety (al-taqwa). And what has come regarding their excellences is not hidden, until indeed the outcome has become marked with piety, specifically designated by it, just as praise has become specifically designated for Allah the Exalted and prayer for the Messenger of Allah, peace be upon him, until it is said: 'Praise be to Allah, Lord of the worlds, and the outcome is for the pious, and prayers upon our master Muhammad, peace be upon him, and all his family.' And Allah the Exalted has specifically designated piety with addition to Himself, so He the Exalted said: 'Their flesh and their blood do not reach Allah, but your piety reaches Him.'", "book_file": "vol4_Vol4-book3.doc.txt", "book_title": "Fear and Hope", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Fear and Hope'", "badge": "Insight"}], "155": [{"arabic": "أنت ولي في الدنيا والآخرة توفنى مسلما وألحقنى بالصالحين أنت ولينا فاغفر لنا وارحمنا وأنت خير الغافرين", "english": "You are the Guardian (Wali) in this world and the Hereafter, cause me to die as a Muslim and join me with the righteous. You are our Guardian (Wali), so forgive us and have mercy upon us, and You are the best of those who forgive (Khayr al-Ghafirin).", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure", "badge": "Ethics"}], "157": [{"arabic": "مثال هذا المحتسب مثال من يخلص غيره من النار بإحراق نفسه وهو غاية في الجهل وهذه مذلة عظيمة وغائلة هائلة وغرور للشيطان يتدلى بحبله كل إنسان إلا من عرفه الله عيوب نفسه وفتح بصيرته بنور هدايته فإن في الاحتكام على الغير لذة للنفس عظيمة من وجهين أحدهما من جهة العلم والآخر من جهة دالة الاحتكام والسلطنة وذلك يرجع إلى الرياء وطلب الجاه وهو الشهوة الخفية الداعية إلى الشرك الخفي وله محك ومعيار ينبغي أن يمتحن المحتسب به نفسه وهو أن يكون امتناع ذلك الإنسان عن المنكر بنفسه أو باحتساب غيره أحب إليه من امتناعه ", "english": "The example of this one who enjoins good and forbids evil (Muḥtasib) is like one who saves another from the Fire by burning himself, and that is the utmost in ignorance. And this is a great humiliation and a tremendous calamity and a deception of Satan by whose rope every person descends except whom Allah has made aware of the faults of his own self (Nafs) and opened his insight with the light (Nūr) of His guidance. For in judging others there is a great pleasure for the self (Nafs) from two aspects: one from the aspect of knowledge, and the other from the aspect of the authority of judgment and dominion. And that returns to ostentation (Riyāʾ) and seeking status, and it is the hidden desire that calls to hidden polytheism (Shirk). And it has a criterion and measure by which the one who enjoins good and forbids evil (Muḥtasib) should test himself, which is that the abstention of that person from evil by himself or by the enjoining of another be more beloved to him than his abstention by his own enjoining. If the enjoining is burdensome upon him, heavy on his self (Nafs), and he wishes that another would suffice for it, then let him enjoin, for his motive is religion. But if the admonition of that sinner by his admonition and his deterrence by his deterrence is more beloved to him than his admonition by the admonition of another, then he is only following the desire (Hawā) of his self (Nafs) and seeking to display the status of his self (Nafs) through the means of his enjoining, so let him fear Allah the Exalted in that and let him first enjoin upon himself. And at this point, it is said to him what was said to Jesus, peace be upon him: 'O son of Mary, admonish yourself; if you are admonished, then admonish people; otherwise, be ashamed before Me.' And it was said to Dāwūd al-Ṭāʾī, may Allah have mercy on him: 'What do you think of a man who entered upon these rulers and commanded them to good and forbade them from evil?' He said: 'I fear for him the whip.' He said: 'He can bear it.' He said: 'I fear for him the sword.' He said: 'He can bear it.' He said: 'I fear for him the hidden disease, which is pride.' The fourth degree: insult and rebuke with harsh, coarse speech. And that is resorted to when unable to prevent with gentleness and when signs of persistence and mockery of admonition and counsel appear. And that is like the saying of Abraham, peace be upon him: 'Fie upon you and what you worship besides Allah; do you not understand?' And we do not mean by insult and obscenity what includes attribution to fornication and its preliminaries, nor lying, but rather to address him with what includes that which is not counted among obscenity, such as saying: 'O sinner, O foolish one, O ignorant one, do you not fear Allah?' and like saying: 'O black one, O stupid one,' and what runs in this course. For every sinner is foolish and ignorant, and were it not for his foolishness, he would not disobey Allah the Exalted. Rather, everyone who is not prudent is foolish, and the prudent one is he for whom the Messenger of Allah, peace and blessings be upon him, testified to prudence when he said: 'The prudent one (Kays) is he who holds his self (Nafs) accountable and works for what is after death, and the foolish one is he who follows the desire (Hawā) of his self (Nafs) and makes wishes upon Allah.' The ḥadīth: 'The prudent one is he who holds his self (Nafs) accountable and works for what is after death'—the ḥadīth was transmitted by al-Tirmidhī, who said it is ḥasan, and by Ibn Mājah from the ḥadīth of Shaddād ibn Aws. And for this rank there are two etiquettes: one is not to proceed to it except when necessary and unable to use gentleness, and the second is not to speak except with...", "book_file": "vol2_j2-k09.doc.txt", "book_title": "Enjoining Good and Forbidding Evil", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Enjoining Good and Forbidding Evil'", "badge": "Insight"}, {"arabic": "وقال ﭬ: (بعثت بالحنيفية السمحة السهلة[50]) وقال ﭬ وعلى كل عبد مصطفى: (أحب أن يعلم أهل الكتابين أن في ديننا سماحة[51]) ويدل على معناه استجابة الله تعالى للمؤمنين في قولهم ﴿ ولا تحمل علينا إصرا ﴾{} وقال تعالى: ﴿ ويضع عنهم إصرهم والأغلال التي كانت عليهم ﴾{}", "english": "And he (peace be upon him) said: 'I was sent with the easy and lenient monotheistic religion (al-Hanifiyyah al-Samhah al-Sahilah).' And he (peace be upon him) said, and upon every chosen servant: 'I love that the People of the Two Books know that in our religion there is leniency (samahah).' And what indicates its meaning is the response of Allah, the Exalted, to the believers in their saying: 'And do not place upon us a burden (isran).' And Allah, the Exalted, said: 'And He removes from them their burden (israhum) and the shackles (al-aghlal) that were upon them.'", "book_file": "vol4_Vol4-book3.doc.txt", "book_title": "Fear and Hope", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Fear and Hope'", "badge": "Afterlife"}, {"arabic": "وقيل لرسول الله صلى الله عليه وسلم أي الناس أفضل قال أتقاهم لله وأوصلهم لرحمه وآمرهم بالمعروف وأنهاهم عن المنكر حديث أي الناس أفضل فقال أتقاهم لله وأوصلهم للرحم رواه أحمد والطبراني من حديث درة بنت أبي لهب بإسناد حسن", "english": "And it was said to the Messenger of God (peace be upon him): 'Which people are best?' He said: 'The most God-fearing (Taqwa) of them towards God, the most connecting of them to kinship ties (Rahim), and the one who commands them with the recognized good (Ma'ruf) and forbids them from the disapproved evil (Munkar).' The hadith: 'Which people are best?' So he said: 'The most God-fearing (Taqwa) of them towards God and the most connecting of them to kinship ties (Rahim).' Narrated by Ahmad and Al-Tabarani from the narration of Durrah bint Abi Lahab with a good chain (Isnad).", "book_file": "vol2_j2-k05.doc.txt", "book_title": "Duties of Brotherhood", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Duties of Brotherhood'", "badge": "Hadith"}, {"arabic": "قال الله تعالى والمؤمنون والمؤمنات بعضهم أولياء بعض يأمرون بالمعروف الآية", "english": "Allah the Exalted said: 'And the believing men and believing women are allies of one another. They enjoin what is right...' (the verse).", "book_file": "vol2_j2-k09.doc.txt", "book_title": "Enjoining Good and Forbidding Evil", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Enjoining Good and Forbidding Evil'", "badge": "General"}], "158": [{"arabic": "وقال رسول الله ﭬ في فضيلة التقوى: (إذا جمع الله الأولين والآخرين لميقات يوم معلوم فإذا هم بصوت يسمع أقصاهم كما يسمع أدناهم فيقول: يا أيها الناس إني قد أنصت لكم مند خلقتكم إلى يومكم هذا فأنصتوا إلي اليوم إنما هي أعمالكم ترد عليكم. أيها الناس إني قد جعلت نسبا وجعلتم نسبا فوضعتم نسبي ورفعتم نسبكم. قلت ﴿ إن أكرمكم عند الله أتقاكم ﴾ {} وأبيتم إلا أن تقولوا فلان بن فلان وفلان أغنى من فلان فاليوم أضع نسبكم وأرفع نسبي أين المتقون فيرفع للقوم لواء فيتبع القوم لواءهم إلى منازلهم فيدخلون الجنة بغير حساب[61", "english": "And the Messenger of Allah (peace be upon him) said regarding the excellence of God-Consciousness (Taqwa): 'When Allah gathers the former and the latter for an appointed day, then they hear a voice that the farthest among them hears just as the nearest hears, and He says: O people, I have indeed listened to you since I created you until this day of yours, so listen to Me today; indeed, it is your deeds that are returned to you. O people, I have made a lineage and you have made lineages, so you have lowered My lineage and raised your lineages. I said: \"Indeed, the most noble among you with Allah is the most God-Conscious (Atqakum) among you\" (Quran 49:13), and you refused except to say: so-and-so son of so-and-so, and so-and-so is wealthier than so-and-so. So today I lower your lineages and raise My lineage. Where are the God-Conscious (Muttaqun)?' Then a banner is raised for the people, and the people follow their banner to their abodes, and they enter Paradise without reckoning.'", "book_file": "vol4_Vol4-book3.doc.txt", "book_title": "Fear and Hope", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Fear and Hope'", "badge": "Afterlife"}, {"arabic": "فقال داود: إني رسول الله إليكم جئتكم لأبلغكم رسالة ربكم، فأقبلوا نحوه وألقوا أسماعهم نحو قوله وألقوا أبصارهم إلى الأرض، فقال داود: إني رسول الله إليكم يقرئكم السلام ويقول لكم ألا تسألون حاجة؟ ألا تنادوني أسمع صوتكم وكلامكم فإنكم أحبائي وأصفيائي وأوليائي أفرح لفرحكم وأسارع إلى محبتكم وأنظر إليكم في كل ساعة نظر الوالدة الشفيقة الرفيقة؟", "english": "Then David said: 'I am the messenger of Allah to you, I have come to you to deliver the message of your Lord.' So they turned toward him and directed their hearing toward his words and cast their gazes to the ground. Then David said: 'I am the messenger of Allah to you, He sends you greetings of peace and says to you: Do you not ask for a need? Do you not call upon Me that I may hear your voice and your speech? For you are My beloved ones, My chosen ones, and My close friends (Awliya'). I rejoice in your joy and hasten to your love, and I look upon you every hour with the look of the compassionate, affectionate mother?'", "book_file": "vol4_Vol4-book6.doc.txt", "book_title": "Love, Longing, Intimacy and Contentment", "content_type": "fiqh", "topic": "Al-Ghazali on the outer and inner dimensions of worship, from 'Love, Longing, Intimacy and Contentment'", "badge": "Worship"}, {"arabic": "فأقبلوا نحوه وألقوا أسماعهم نحو قوله وألقوا أبصارهم إلى الأرض، فقال داود: إني رسول الله إليكم يقرئكم السلام ويقول لكم ألا تسألون حاجة؟ ألا تنادوني أسمع صوتكم وكلامكم فإنكم أحبائي وأصفيائي وأوليائي أفرح لفرحكم وأسارع إلى محبتكم وأنظر إليكم في كل ساعة نظر الوالدة الشفيقة الرفيقة؟", "english": "So they turned towards him and directed their hearing towards his speech and cast their gazes to the ground, and David said: 'I am the messenger of God to you, He sends you greetings and says to you: Do you not ask for a need? Do you not call upon Me that I may hear your voice and your speech, for you are My beloved ones, My chosen ones, and My friends (Awliya'), I rejoice in your joy and hasten to your love and look upon you every hour with the look of the compassionate, affectionate mother?'", "book_file": "vol4_Vol4-book6.doc.txt", "book_title": "Love, Longing, Intimacy and Contentment", "content_type": "fiqh", "topic": "Al-Ghazali on the outer and inner dimensions of worship, from 'Love, Longing, Intimacy and Contentment'", "badge": "Worship"}], "160": [{"arabic": "وقال تعالى في وصف الطيبات وأنزلنا عليكم المن والسلوى المن العسل والسلوى اللحم سمي سلوى لأنه يتسلى به عن جميع الإدام ولا يقوم غيره مقامه ولذلك قال صلى الله عليه وسلم سيد الإدام اللحم ثم قال بعد ذكر المن والسلوى كلوا من طيبات ما رزقناكم فاللحم والحلاوة من الطيبات", "english": "And Allah said in describing the good things: 'And We sent down upon you the Manna and the Quail (Salwa).' The Manna is honey, and the Quail (Salwa) is meat. It is called Salwa because one finds solace (yata-salla) in it from all other dishes, and nothing else takes its place. Therefore, the Prophet (peace be upon him) said: 'The master of dishes is meat.' Then He said after mentioning the Manna and the Quail (Salwa): 'Eat from the good things (Tayyibat) We have provided you.' So meat and sweetness are from the good things (Tayyibat).", "book_file": "vol2_j2-k01.doc.txt", "book_title": "Manners of Eating", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Manners of Eating'", "badge": "Insight"}], "165": [{"arabic": "وقال تعالى فلما نسوا ما ذكروا به أنجينا الذين ينهون عن السوء وأخذنا الذين ظلموا بعذاب بئيس بما كانوا يفسقون فبين أنهم استفادوا النجاة بالنهي عن السوء ويدل ذلك على الوجوب أيضا", "english": "And the Exalted said: 'So when they forgot what they had been reminded of, We saved those who forbid from the evil (Sū') and seized those who wronged (ẓalamū) with a painful punishment because they were defiantly disobedient (yafsuqūn).' So He made clear that they attained salvation through forbidding from the evil (Sū'), and this indicates the obligation (wujūb) as well.", "book_file": "vol2_j2-k09.doc.txt", "book_title": "Enjoining Good and Forbidding Evil", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Enjoining Good and Forbidding Evil'", "badge": "Insight"}], "169": [{"arabic": "وأما الآن فترى الخلق آمنين مسرورين مطمئنين غير خائفين مع إكبابهم على المعاصي وانهماكهم في الدنيا وإعراضهم عن الله تعالى، زاعمين أنهم واثقون بكرم الله تعالى وفضله، راجون لعفوه ومغفرته، كأنهم يزعمون أنهم عرفوا من فضله وكرمه ما لم يعرفه الأنبياء والصحابة والسلف الصالحون. فإن كان هذا الأمر يدرك بالمنى وينال بالهوينى فعلام إذن كان بكاء أولئك وخوفهم وحزنهم؟ وقد ذكرنا تحقيق هذه الأمور في كتاب الخوف والرجاء وقد قال رسول الله ﭬ فيما رواه معقل بن يسار \"يأتى على الناس زمان يخلق فيه القرآن في قلوب الرجال كم", "english": "But now you see the creation secure, joyful, tranquil, not fearful while they are bent upon sins, immersed in the world, and turning away from Allah the Exalted, claiming that they are confident in the generosity (Karam) of Allah the Exalted and His bounty, hoping for His pardon and forgiveness, as if they claim to have known from His bounty and generosity what the Prophets, Companions, and righteous predecessors did not know. If this matter were attained by wishful thinking and obtained easily, then why was the weeping, fear, and grief of those? We have mentioned the verification of these matters in the Book of Fear and Hope, and the Messenger of Allah (peace be upon him) said in what was narrated by Ma'qil ibn Yasar: 'A time will come upon people when the Quran will be created in the hearts of men just as garments are created on bodies; their whole affair will be hope (Tama') with no fear (Khauf) accompanying it. If one of them does good, he says: It will be accepted from me, and if he does evil, he says: I will be forgiven.' He informed that they place hope (Tama') in the position of fear (Khauf) due to their ignorance of the warnings of the Quran and what is in it. And similarly, He informed about the Christians when Allah the Exalted said: 'Then there succeeded after them a succession who inherited the Scripture, taking the enjoyment (Ard) of this lower world and saying: It will be forgiven for us.' And its meaning is that they 'inherited the Scripture,' meaning they are scholars, 'and take the enjoyment (Ard) of this lower world,' meaning their desires from the world, whether lawful (Halal) or unlawful (Haram). And Allah the Exalted said: 'And for he who fears the standing (Maqam) of his Lord are two gardens - that is for he who fears My standing (Maqam) and fears and worships.' And the Quran from its beginning to its end is warning and causing fear; no one reflects upon it except that his grief lengthens and his fear (Khauf) increases if he is a believer in what is in it.", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Delusion'", "badge": "Insight"}, {"arabic": "فقد كان الناس في الأعصار الأول يواظبون على العبادات ويؤتون ما آتوا وقلوبهم وجلة أنهم إلى ربهم راجعون، يخافون على أنفسهم وهم طول الليل والنهار في طاعة الله يبالغون في التقوى والحذر من الشبهات والشهوات ويبكون على أنفسهم في الخلوات. وأما الآن فترى الخلق آمنين مسرورين مطمئنين غير خائفين مع إكبابهم على المعاصي وانهماكهم في الدنيا وإعراضهم عن الله تعالى، زاعمين أنهم واثقون بكرم الله تعالى وفضله، راجون لعفوه ومغفرته، كأنهم يزعمون أنهم عرفوا من فضله وكرمه ما لم يعرفه الأنبياء والصحابة والسلف الصالحون. ف", "english": "Indeed, the people in the earlier eras used to consistently perform acts of worship and give what they gave while their hearts were fearful that they were returning to their Lord, fearing for their souls (Nafs), and they were throughout the night and day in obedience to Allah, exaggerating in God-consciousness (Taqwa) and caution from doubts and desires, and weeping over themselves in seclusions. As for now, you see the creation secure, joyful, tranquil, not fearful despite their plunging into sins, engrossment in the worldly life, and turning away from Allah the Exalted, claiming that they are confident in the generosity (Karam) of Allah the Exalted and His bounty, hoping for His pardon and forgiveness, as if they claim to have known from His bounty and generosity what the Prophets, Companions, and righteous predecessors did not know. If this matter were attained by wishful thinking and obtained easily, then why then was the weeping, fear, and grief of those? We have mentioned the verification of these matters in the Book of Fear and Hope, and the Messenger of Allah ﷺ said in what was narrated by Ma'qil ibn Yasar: \"There will come upon people a time when the Quran will be created in the hearts of men just as clothes are created on bodies; all their affair will be hope without fear with it. If one of them does good, he says: 'It will be accepted from me,' and if he does evil, he says: 'I will be forgiven.'\" So he informed that they place hope (Tam') in the position of fear due to their ignorance of the warnings of the Quran and what is in it. And similarly, He informed about the Christians when He the Exalted said: \"Then there succeeded after them a succession who inherited the Book, taking the enjoyment of this lower world and saying: 'It will be forgiven for us.'\" And its meaning is that they \"inherited the Book,\" meaning they are scholars, \"and take the enjoyment of this lower world,\" meaning their desires from the worldly life, whether it was unlawful (Haram) or lawful (Halal). And He the Exalted said: \"And for him who fears the standing before his Lord are two gardens - that is for whoever feared My standing and feared and worshiped.\" And the Quran from its beginning to its end is warning and causing fear; no one reflects in it except that his grief lengthens and his fear magnifies if he is a believer in what is in it. And you see people reciting it like this, emitting the letters from their points of articulation and disputing over their lowering, raising, and nominating as if they are reciting poetry from the poems of the Arabs, not caring to pay attention to its meanings and acting upon what is in it. And is there in the world delusion (Ghurur) greater than this? So these are examples of delusion regarding Allah and clarification of the difference between hope (Raja') and delusion, and near to it is the delusion of groups who have acts of obedience and sins except that their sins are more, and they expect forgiveness and think that the scale of their good deeds outweighs while what is in the scale of bad deeds is more, and this is the utmost ignorance. So you see one giving charity with counted dirhams from the lawful and unlawful, and what he consumes from the wealth of Muslims and doubts is multiples of it, and perhaps what he gives in charity is from the wealth of Muslims! And he relies upon it and thinks that consuming a thousand dirhams unlawfully is counterbalanced by giving charity with ten from the unlawful or lawful, and it is nothing but like one who placed ten dirhams in one scale of a balance and in the other scale the", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Delusion'", "badge": "Insight"}, {"arabic": "وإن قطع عن بذر الإيمان تعهده بماء الطاعات وترك القلب مشحونا برذائل الأخلاق وانهمك في طلب لذات الدنيا ثم انتظر المغفرة فانتظاره حمق وغرور قال صلى الله عليه وآله وسلم: (الأحمق من أتبع نفسه هواها وتمنى على الله الجنة[1]) وقال تعالى: ﴿ فخلف من بعدهم أضاعوا الصلاة واتبعوا الشهوات فسوف يلقون غيا ﴾ {} وقال تعالى: ﴿ فخلف من بعدهم خلف ورثوا الكتاب يأخذون عرض هذا الأدنى ويقولون سيغفر لنا ﴾{} وذم الله تعالى صاحب البستان إذا دخل جنته وقال: ﴿ ما أظن تبيده هذه أبدا وما أظن الساعة قائمة ولئن رددت إلى ربى لأجدن", "english": "And if he abandons nurturing the seed of faith (Iman) with the water of acts of obedience (Taa'at) and leaves the heart (Qalb) filled with vile character traits (Akhlāq) and immerses himself in seeking the pleasures of this world (Dunya), then he expects forgiveness (Maghfirah), so his expectation is foolishness and delusion. The Prophet (peace be upon him and his family) said: 'The foolish one is he who follows his soul's (Nafs) desires and hopes for Paradise from Allah.' And Allah the Exalted said: 'Then there succeeded after them a generation who neglected prayer and followed lusts, so they will meet perdition.' And Allah the Exalted said: 'Then there succeeded after them a generation who inherited the Book, taking the fleeting gains of this lower world and saying: \"It will be forgiven us.\"' And Allah the Exalted censured the owner of the garden when he entered his garden and said: 'I do not think this will ever perish, nor do I think the Hour will come. And if I am returned to my Lord, I will surely find a better place than this to return to.' So if the servant (Abd) strives in acts of obedience (Taa'at) and avoids sins (Ma'āsi), he is worthy of expecting from Allah's grace (Fadl) the completion of blessing (Ni'mah), and what is the completion of blessing except entry into Paradise. As for the sinner (Āsi), if he repents (Tāba) and makes up for all the shortcomings he has neglected, he is worthy of hoping for the acceptance of repentance (Tawbah). And as for before repentance, if he is averse to sin, the evil deed displeases him and the good deed pleases him, and he blames himself and reproaches it, and he desires repentance and yearns for it, he is worthy of hoping from Allah for success (Tawfīq) in repentance because his aversion to sin and his eagerness for repentance function as a cause (Sabab) that may lead to repentance. And hope (Rajā') is after the causes are firmly established, and therefore Allah the Exalted said: 'Indeed, those who have believed and those who have emigrated and fought in the cause of Allah - those hope for the mercy of Allah.' Its meaning is: those deserve to hope for Allah's mercy, and He did not intend to specify the existence of hope because others may also hope, but He specified them with deserving hope. So as for one who immerses himself in what Allah the Exalted dislikes and does not blame himself for it nor resolves on repentance and return, his hope for forgiveness is foolishness like the hope of one who sows seed in barren land and resolves on.", "book_file": "vol4_Vol4-book3.doc.txt", "book_title": "Fear and Hope", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Fear and Hope'", "badge": "Insight"}], "172": [{"arabic": "ولذلك قال تعالى وإذ أخذ ربك من بني آدم من ظهورهم ذريتهم وأشهدهم على أنفسهم ألست بربكم قالوا بلى فالمراد به إقرار نفوسهم لا إقرار الألسنة فإنهم انقسموا في إقرار الألسنة حيث وجدت الألسنة والأشخاص إلى مقر وإلى جاحد ولذلك قال تعالى: (ولئن سألتهم من خلقهم ليقولن الله( معناه إن اعتبرت أحوالهم شهدت بذلك نفوسهم وبواطنهم فطرة الله التي فطر الناس عليها أي كل آدمي فطر على الإيمان بالله عز وجل بل على معرفة الأشياء على ما هي عليه أعني أنها كالمضمنة فيها لقرب استعدادها للإدراك ثم لما كان الإيمان مركوزا في الن", "english": "Therefore, Allah the Exalted said: 'And [mention] when your Lord took from the children of Adam from their loins their descendants and made them testify concerning themselves, [saying to them], \"Am I not your Lord?\" They said, \"Yes, we have testified.\"' [Quran 7:172] The intended meaning is the affirmation of their souls (Nafs) not the affirmation of tongues, for they divided in the affirmation of tongues where tongues and persons are found into affirmers and deniers. Therefore, Allah the Exalted said: 'And if you asked them, \"Who created them?\" they would surely say, \"Allah.\"' [Quran 43:87] Its meaning is that if you consider their states, their souls (Nafs) and their inner selves (Bawatin) testify to that by the natural disposition (Fitrah) of Allah upon which He created people, meaning every human is created with natural disposition (Fitrah) upon faith in Allah the Exalted, indeed upon knowledge of things as they are, meaning they are as if embedded in it due to the proximity of their preparedness for perception. Then, since faith is firmly rooted in the souls (Nafs) by natural disposition (Fitrah), people divided into two groups: those who turned away and forgot, and they are the disbelievers (Kuffar), and those who pondered with their thoughts (Khatir) and remembered, so it was as if one carried a testimony then forgot it due to heedlessness (Ghaflah) then remembered it. Therefore, Allah the Exalted said: 'That they may remember' [Quran 7:174], 'And that those of understanding may remember' [Quran 38:29], 'And remember the favor of Allah upon you and His covenant with which He bound you' [Quran 5:7], 'And We have certainly made the Quran easy for remembrance, so is there any who will remember?' [Quran 54:17]; and naming this pattern remembrance (Tadhakkur) is not far-fetched, as if remembrance (Tadhakkur) is of two types: one is to remember an image that was present in existence in his heart (Qalb) but disappeared after the other existence. The other is to remember an image that was embedded in him by natural disposition (Fitrah), and these are truths apparent to the observer by the light of insight (Bassirah), heavy upon one who is dominated by hearsay, his saying 'is dominated' from circulation, meaning hearing and imitation become prevalent.", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}], "175": [{"arabic": "وقال في بلعم بن باعوراء \"واتل عليهم نبأ الذي آتيناه آياتنا فانسلخ منها\" حتى بلغ \"فمثله كمثل الكلب إن تحمل عليه يلهث أو تتركه يلهث\" قال ابن عباس رضي الله عنهما: أوتي بعلم كتاباً فأخلد إلى شهوات الأرض أي سكن حبه العالم هذا الخطر فأي عالم لم يتبع شهوته وأي عالم لم يأمر بالخير الذي لا يأتيه؟", "english": "And He said regarding Balaam son of Beor: \"And recite to them the news of him to whom We gave Our signs, but he detached himself from them\" until reaching \"so his likeness is like the likeness of a dog: if you drive him away, he pants, or if you leave him, he pants.\" Ibn Abbas, may Allah be pleased with them both, said: He was given knowledge of the Book, but he inclined to the desires of the earth, meaning his love settled in this danger. So which scholar does not follow his desire, and which scholar does not command good which he does not come to?", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}, {"arabic": "وقال تعالى في قصة بلعام بن باعوراء (واتل عليهم نبأ الذي آتيناه آياتنا فانسلخ منها فأتبعه الشيطان فكان من الغاوين( (الأعراف:175) حتى قال (فمثله كمثل الكلب إن تحمل عليه يلهث أو تتركه يلهث((الأعراف:176). فكذلك العالم الفاجر فإن بلعام أوتي كتاب الله تعالى فأخلد إلى الشهوات فشبه بالكلب أي سواء أوتي الحكمة أو لم يؤت فهو يلهث إلى الشهوات.", "english": "And He, the Exalted, said in the story of Balaam son of Beor: 'And recite to them the news of him to whom We gave Our signs, then he stripped himself of them, so Satan followed him, and he became of the misguided ones' (Al-A'raf:175) until He said: 'So his likeness is as the likeness of a dog; if you attack him, he pants, or if you leave him, he pants' (Al-A'raf:176). Thus is the wicked scholar, for Balaam was given the Book of Allah, the Exalted, then he clung to the desires, so he was likened to the dog, meaning whether he was given wisdom or not, he pants toward the desires.", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Book of Knowledge'", "badge": "General"}], "176": [{"arabic": "ومن عدل عن هذه الطريقة كان كمن قال الله تعالى فيه أفرأيت من اتخذ إلهه هواه وأضله الله على علم وقال تعالى واتبع هواه فمثله كمثل الكلب إن تحمل عليه يلهث أو تتركه يلهث وقال عز وجل فيمن نهى النفس عن الهوى وأما من خاف مقام ربه ونهى النفس عن الهوى فإن الجنة هي المأوى وسيأتي كيفية مجاهدة هذه الجنود وتسليط بعضها على بعض في كتاب رياضة النفس إن شاء الله تعالى", "english": "And whoever deviates from this method is like the one about whom Allah the Exalted said: 'Have you seen the one who takes his desire (hawa) as his god, and Allah has led him astray despite knowledge?' And He said: 'And he followed his desire (hawa), so his likeness is as the likeness of a dog: if you attack it, it pants, or if you leave it, it pants.' And He the Almighty said regarding the one who forbids the soul (nafs) from desire (hawa): 'And as for the one who feared the standing place of his Lord and forbade the soul (nafs) from desire (hawa), then indeed Paradise is the abode.' And the method of struggling (mujahada) against these armies and pitting some of them against others will come in the Book of Disciplining the Soul (riyadat al-nafs), if Allah the Exalted wills.", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "وقد مثل الله سبحانه وتعالى من يعلم ولا يعمل بالحمار والكلب فقال عز وجل 'مثل الذين حملوا التوراة ثم لم يحملوها كمثل الحمار يحمل أسفاراً' أراد به علماء اليهود. وقال في بلعم بن باعوراء 'واتل عليهم نبأ الذي آتيناه آياتنا فانسلخ منها' حتى بلغ 'فمثله كمثل الكلب إن تحمل عليه يلهث أو تتركه يلهث' قال ابن عباس رضي الله عنهما: أوتي بعلم كتاباً فأخلد إلى شهوات الأرض أي سكن حبه العالم هذا الخطر فأي عالم لم يتبع شهوته وأي عالم لم يأمر بالخير الذي لا يأتيه؟", "english": "And Allah, the Exalted and Majestic, has likened the one who knows but does not act to the donkey and the dog. He, the Mighty and Glorious, said: 'The likeness of those who were entrusted with the Torah and then did not carry it is like the likeness of a donkey carrying books' - He intended by this the scholars of the Jews. And He said regarding Balaam son of Beor: 'And recite to them the story of him to whom We gave Our signs, but he detached himself from them' until reaching 'So his likeness is like the likeness of a dog: if you drive it away, it pants, or if you leave it, it pants.' Ibn Abbas, may Allah be pleased with them both, said: He was given knowledge of the Book, but he clung to the desires of the earth, meaning his love settled in this danger. So which scholar has not followed his desire, and which scholar has not commanded the good which he does not come to?", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}, {"arabic": "وقال تعالى في قصة بلعام بن باعوراء (واتل عليهم نبأ الذي آتيناه آياتنا فانسلخ منها فأتبعه الشيطان فكان من الغاوين( (الأعراف:175) حتى قال (فمثله كمثل الكلب إن تحمل عليه يلهث أو تتركه يلهث((الأعراف:176). فكذلك العالم الفاجر فإن بلعام أوتي كتاب الله تعالى فأخلد إلى الشهوات فشبه بالكلب أي سواء أوتي الحكمة أو لم يؤت فهو يلهث إلى الشهوات.", "english": "And Allah the Exalted said in the story of Balaam son of Beor: 'And recite to them the news of him to whom We gave Our signs, but he detached himself from them, so Satan followed him, and he became of the misguided ones' (Al-A'raf:175) until He said: 'So his likeness is as the likeness of a dog; if you attack it, it pants, or if you leave it, it pants' (Al-A'raf:176). Thus is the wicked scholar, for Balaam was given the Book of Allah the Exalted, but he inclined to the desires (Shahawat), so he was likened to the dog, meaning whether he is given wisdom or not given it, he pants toward the desires (Shahawat).", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Book of Knowledge'", "badge": "General"}], "179": [{"arabic": "وليس يخفى أن شبه كل شيء منجذب إليه، وأن النفس التي نزوعها إلى صنعة الأساكفة أكثر من نزوعها إلى صنعة الكتابة، فهو بالأساكفة أشبه في جوهره منه بالكتاب، وكذلك من نزوع نفسه إلى نيل لذات البهائم أكثر من نزوعها إلى نيل لذات الملائكة، فهو بالبهائم أشبه منه بالملائكة لا محالة، وهؤلاء هم الذين يقال فيهم: \" أولئك كالأنعام بل هم أضل \" وإنما كانوا أضل لأن الأنعام ليس في قوتها طلب درجة الملائكة، فتركها الطلب للعجز، وأما الإنسان ففي قوته ذلك، والقادر على نيل الكمال أحرى بالذم وأجدر بالنسبة إلى الضلال مهما تقا", "english": "And it is not hidden that the likeness of every thing is drawn to it, and that the Soul (Nafs) whose inclination is toward the craft of shoemaking more than its inclination toward the craft of writing, then he is more similar in his essence to shoemakers than to writers. Likewise, he whose Soul (Nafs) inclines toward attaining the pleasures of beasts more than its inclination toward attaining the pleasures of angels, then he is more similar to beasts than to angels without doubt. And these are the ones about whom it is said: \"Those are like cattle, rather they are more astray.\" And they were more astray only because cattle do not have in their capacity the seeking of the degree of angels, so they abandon the seeking due to incapacity. As for the human, it is within his capacity for that, and the one capable of attaining perfection is more deserving of blame and more worthy in relation to straying whenever he refrains from seeking perfection.", "book_file": "vol4_Vol4-book5.doc.txt", "book_title": "Monotheism and Reliance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monotheism and Reliance'", "badge": "Insight"}, {"arabic": "وما يحصل به الإنذار والتخويف هو هذا الفقه دون تفريعات الطلاق والعتاق واللعان والسلم والإجارة فذلك لا يحصل به إنذار ولا تخويف بل التجرد له على الدوام يقسي القلب وينزع الخشية منه كما نشاهد الآن من المتجردين له وقال تعالى:( لهم قلوب لا يفقهون بها ((الأعراف: 179). وأراد به معاني الإيمان دون الفتاوى ولعمري إن الفقه والفهم في اللغة اسمان بمعنى واحد وإنما يتكلم في عادة الاستعمال به قديما وحديثا.", "english": "And what achieves the warning and fear is this understanding (Fiqh) without the subdivisions of divorce, emancipation, imprecation, salam (forward sale), and lease, for that does not achieve warning nor fear; rather, dedicating oneself to it constantly hardens the Heart (Qalb) and removes reverence from it, as we witness now from those dedicated to it. And He, the Exalted, said: 'They have hearts with which they do not understand (la yafqahuna biha)' (Al-A'raf: 179). And He intended by it the meanings of faith (Iman) without the legal opinions (Fatawa). And indeed, 'understanding' (Fiqh) and 'comprehension' (Fahm) in the language are two names with one meaning, and one only speaks of it in terms of customary usage, ancient and modern.", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "وخلق الله تعالى الإنس ثلاثة أصناف صنف كالبهائم كما قال تعالى لهم قلوب لا يفقهون بها ولهم أعين لا يبصرون بها ولهم آذان لا يسمعون بها أولئك كالأنعام بل هم أضل وصنف أجسامهم أجسام بني آدم وأرواحهم أرواح الشياطين وصنف في ظل الله تعالى يوم القيامة يوم لا ضل إلا ظله", "english": "And Allah the Exalted created humankind into three categories: a category like the beasts, as He the Exalted said: 'For them are hearts (Qulub) that they do not comprehend with, and for them are eyes that they do not see with, and for them are ears that they do not hear with; those are like the cattle, rather they are more astray.' And a category whose bodies are the bodies of the children of Adam and whose spirits (Arwah) are the spirits of the devils. And a category in the shade (Zill) of Allah the Exalted on the Day of Resurrection, the day when there is no shade except His shade.", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Disciplining the Soul'", "badge": "Afterlife"}], "182": [{"arabic": "فإن قلت: من أين عرف قائل هذا ما قاله إبليس ولم يشاهد إبليس ولا حدثه بذلك؟ فاعلم أن أرباب القلوب يكاشفون بأسرار الملكوت تارة على سبيل الإلهام بأن يخطر لهم على سبيل الورود عليهم من حيث لا يعلمون وتارة على سبيل الرؤيا الصادقة وتارة في اليقظة على سبيل كشف المعاني بمشاهدة الأمثلة كما يكون في المنام وهذا أعلى الدرجات وهي من درجات النبوة العالية كما أن الرؤيا الصادقة جزء من ستة وأربعين جزءا من النبوة. فإياك أن يكون حظك من هذا العلم إنكار ما جاوز حد قصورك ففيه هلك المتحذلقون من العلماء الزاعمون أنهم أحا", "english": "If you say: From where did the speaker know what Iblis said, when he neither witnessed Iblis nor was informed by him? Then know that the possessors of hearts (Arbab al-Qulub) are unveiled to the secrets of the dominion (Malakut) sometimes through inspiration (Ilham) by it occurring to them through arrival upon them from where they do not know, sometimes through truthful vision (Ru'ya al-Sadiqa), and sometimes in wakefulness through unveiling of meanings (Kashf al-Ma'ani) by witnessing examples as occurs in dreams. This is the highest of degrees, and it is from the high degrees of prophethood, just as the truthful vision is one part of forty-six parts of prophethood. Beware that your portion of this knowledge be denial of what exceeds the limit of your incapacity, for in it perished the pretentious among the scholars who claim they have encompassed the sciences of intellects. So ignorance is better than an intellect that calls to denial of such matters for the friends of Allah (Awliya' Allah) the Exalted. And whoever denies that for the friends, it necessitates for him denial of the prophets, and he would be completely outside the religion. Some of the knowers (Arifin) said: Indeed, the substitutes (Abdal) have been cut off in the extremities of the earth and concealed from the sight of the public because they cannot bear to look at the scholars of the time, for they are, according to them, ignorant of Allah the Exalted, while they are, according to themselves and according to the ignorant, scholars. Sahl al-Tustari, may Allah be pleased with him, said: Indeed, among the greatest sins is ignorance of ignorance, looking to the common people, and listening to the speech of the people of heedlessness (Ghafila). And every scholar who delves into the world, it is not fitting to heed his saying; rather, he should be suspected in everything he says, because every person delves into what he loves and repels what does not agree with his beloved. And for that reason, Allah the Mighty and Majestic said: 'And those who deny Our signs, We will lead them on from where they do not know' (Quran 7:182), and 'And do not obey one whose heart We have made heedless of Our remembrance (Dhikr) and who follows his desire (Hawa) and whose affair is ever [in] neglect'.", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "وهذا الغرور علاجه معرفة دلائل الكرامة والهوان إما بالبصيرة أو بالتقليد أما البصيرة فبأن يعرف وجه كون الالتفات إلى شهوات الدنيا مبعد عن الله ووجه كون التباعد عنها مقرباً إلى الله ويدرك ذلك بالإلهام في منازل العارفين والأولياء، وشرحه من جملة علوم المكاشفة ولا يليق بعلم المعاملة \"وأما معرفته بطريق التقليد والتصديق\" فهو أن يؤمن بكتاب الله تعالى ويصدق رسوله وقد قال تعالى \"أيحسبون أن ما نمدهم به من مال وبنين نسارع لهم في الخيرات بل لا يشعرون\" وقال تعالى \"سنستدرجهم من حيث لا يعلمون\" وقال تعالى \"فتحنا ع", "english": "And the cure for this delusion (Ghurur) is knowing the signs of honor (Karama) and humiliation (Hawan) either through insight (Basira) or through imitation (Taqleed). As for insight, it is by knowing how turning toward worldly desires distances one from Allah and how distancing from them brings one closer to Allah, and one perceives that through inspiration (Ilham) in the stations of the knowers (Arifin) and the friends (Awliya), and its explanation is among the sciences of unveiling (Mukashafa) and is not suitable for the science of transaction. \"And as for knowing it through the way of imitation and belief (Tasdeeq),\" it is to have faith in the Book of Allah the Exalted and believe His Messenger. And He the Exalted has said: \"Do they think that what We extend to them of wealth and children, We hasten for them in good things? Rather, they do not perceive.\" And He the Exalted said: \"And those who deny Our signs - We will progressively lead them [to destruction] from where they do not know.\" And He the Exalted said: \"We opened to them the gates of every thing until, when they rejoiced in that which they were given, We seized them suddenly, and at once they were in despair.\" And in the interpretation of His saying the Exalted \"We will progressively lead them [to destruction] from where they do not know,\" it is that whenever they commit a sin, We grant them a blessing to increase their delusion. And He the Exalted said: \"We only delay them that they may increase in sin.\" And He the Exalted said: \"And never think that Allah is unaware of what the wrongdoers do. He only delays them for a Day when eyes will stare [in horror].\" And other than that which has come in the Book of Allah the Exalted and the Sunnah of His Messenger. So whoever believes in it is freed from this delusion, for the origin of this delusion is ignorance of Allah and His attributes. For whoever knows Him does not feel secure from His plan (Makr) nor is deceived by such false imaginings, and looks at Pharaoh, Haman, and Korah, and at the kings of the earth and what happened to them - how Allah was good to them initially, then destroyed them utterly! So He the Exalted said: \"Do you perceive of them anyone?\" the verse. And Allah the Exalted has warned of His plan and gradual leading, saying: \"So no one feels secure from the plan of Allah except the losing people.\" And He the Exalted said: \"And they planned a plan, and We planned a plan, while they perceived not.\" And He the Mighty and Majestic said: \"And they planned, and Allah planned. And Allah is the best of planners.\" And He the Exalted said: \"Indeed, they are planning a plan, and I am planning a plan. So allow time for the disbelievers. Leave them awhile.\" So just as it is not permissible for the neglected servant to infer from the master's neglect of him and enabling", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Delusion'", "badge": "Ethics"}, {"arabic": "الحمد لله الذي لا يتكل على عفوه ورحمته إلا الراجون، ولا يحذر سوء غضبه وسطوته إلا الخائفون، الذي استدرج عباده من حيث لا يعلمون، وسلط عليهم الشهوات وأمرهم بترك ما يشتهون، وابتلاهم بالغضب وكلفهم كظم الغيظ فيما يغضبون، ثم حفهم بالمكاره واللذات وأملى لهم لينظر كيف يعملون، وامتحن بهم حبهم ليعلم صدقهم فيما يدعون، وعرفهم أنه لا يخفى عليه شيء مما يسرون وما يعلنون، وحذرهم أن يأخذهم بغتة وهم لا يشعرون فقال \"ما ينظرون إلا صيحة واحدة تأخذهم وهم يخصمون فلا يستطيعون توصية ولا إلى أهلهم يرجعون\" والصلاة والسلام ", "english": "Praise be to Allah, upon whose forgiveness and mercy none rely except the hopeful, and none fear the evil of His anger and His might except the fearful, who gradually leads His servants from where they do not know, and has subjected them to desires and commanded them to abandon what they desire, and has tested them with anger and obligated them to suppress rage in what angers them, then has surrounded them with hardships and pleasures and has given them respite to see how they act, and has tested them with their love to know their truthfulness in what they claim, and has made known to them that nothing is hidden from Him of what they conceal and what they reveal, and has warned them that He may seize them suddenly while they are unaware, so He said: \"They await not but a single blast which will seize them while they are disputing. Then they will not be able to make a bequest, nor will they return to their families.\" And prayers and peace be upon Muhammad, His messenger, under whose banner the prophets march, and upon his family and his companions, the guided leaders, and the pleased masters, prayers equal in number to what has been of Allah's creation and what will be, and may the first and the last attain its blessing, and abundant peace.", "book_file": "vol3_Vol3-book5a.doc.txt", "book_title": "Condemnation of Envy", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Envy'", "badge": "Ethics"}], "185": [{"arabic": "خاصية الإنسان التى حجبت البهائم عنها معرفة الله تعالى بالنظر فى ملكوت السموات والأرض وعجائب الافاق والأنفس إذ بها يدخل العبد فى زمرة الملائكة المقربين ويحشر فى زمرة النبيين والصديقين مقربا من حضرة رب العالمين وليست هذه المنزلة للبهائم ولا لإنسان رضى من الدنيا بشهوات البهائم فإنه شر من البهائم بكثير إذ لا قدرة للبهيمة على ذلك وأما هو فقد خلق الله له القدرة ثم عطلها وكفر نعمة الله فيها فأولئك كالأنعام بل هم أضل سبيلا وإذا عرفت طريق الفكر فى نفسك فتفكر فى الأرض التى هى مقرك ثم فى أنهارها وجبالها وم", "english": "The specific characteristic of the human being that is concealed from the beasts is the knowledge of Allah the Exalted through contemplation in the dominion (malakūt) of the heavens and the earth and the wonders of the horizons and the souls (anfus), for through it the servant (ʿabd) enters into the ranks of the close angels and is resurrected in the ranks of the prophets and the truthful ones, brought near to the presence (ḥaḍrah) of the Lord of the worlds. This station is not for the beasts, nor for a human who is content with the worldly desires of the beasts, for he is worse than the beasts by much, since the beast has no capability for that. As for him, Allah created for him the capability, then he neglected it and disbelieved in Allah's favor in it. Those are like cattle, rather they are more astray in path. And when you know the way of contemplation in your soul (nafs), then contemplate the earth which is your abode, then in its rivers, mountains, and minerals, then ascend from it to the dominion (malakūt) of the heavens. As for the earth, from His signs is that He created the earth as a bed and a cradle, and made in it wide roads, and made it submissive so that you may walk in its tracts, and made it stable so that it does not move, and set in it mountains as pegs for it to prevent it from shaking, then He expanded its expanses until the sons of Adam were unable to reach all its sides even if their lifespans were long and their travels abundant. So He the Exalted said: 'And the heaven We constructed with strength, and indeed, We are [its] expander. And the earth We have spread out, and excellent is the preparer.' And He the Exalted said: 'It is He who made the earth tame for you, so walk among its slopes.' And He the Exalted said: 'Who made for you the earth a bed.' And He has frequently mentioned the earth in His mighty book so that one may contemplate its wonders, its surface is an abode for the living and its interior.", "book_file": "vol4_j4-k09.doc.txt", "book_title": "Contemplation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Contemplation'", "badge": "Insight"}, {"arabic": "إن العين خلقت للنظر في ملكوت السموات والأرض عبرة ولتستعمل في طاعة الله تعالى وتنظر في كتاب الله وسنة رسوله صلى الله عليه وسلم وأنا قادر على أن أشغل العين بمطالعة القرآن والسنة فلم لا أفعله وأنا قادر على أن أنظر إلى فلان المطيع بعين التعظيم فأدخل السرور على قلبه وأنظر إلى فلان الفاسق بعين الازدراء فأزجره بذلك عن معصيته فلم لا أفعله", "english": "Indeed, the eye was created for looking at the dominion (malakoot) of the heavens and the earth as a lesson (ʿibrah) and to be used in the obedience (ṭāʿah) of Allah the Exalted and to look at the Book of Allah and the Sunnah of His Messenger, peace be upon him. And I am capable of occupying the eye with studying the Quran and the Sunnah, so why do I not do it? And I am capable of looking at so-and-so the obedient one with the eye of reverence (taʿẓīm) so that I bring joy to his heart (qalb), and looking at so-and-so the corrupt one with the eye of contempt so that I deter him by that from his disobedience (maʿṣiyah), so why do I not do it?", "book_file": "vol4_j4-k09.doc.txt", "book_title": "Contemplation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Contemplation'", "badge": "Insight"}, {"arabic": "وقال إسحاق بن خلف كان داود الطائى رحمه الله تعالى على سطح في ليلة قمراء فتفكر في ملكوت السموات والأرض وهو ينظر إلى السماء ويبكى حتى وقع في دار جار له قال فوثب صاحب الدار من فراشه عريانا وبيده سيف وظن أنه لص فلما نظر إلى داود رجع ووضع السيف وقال من ذا الذى طرحك من السطح قال ما شعرت بذلك", "english": "And Ishaq ibn Khalaf said: Dawud al-Ta'i, may Allah have mercy on him, was on a roof on a moonlit night, and he was contemplating (tafakkara) in the dominion (mulk) of the heavens and the earth while looking at the sky and weeping until he fell into the house of his neighbor. He said: The owner of the house jumped from his bed naked with a sword in his hand, thinking he was a thief. When he looked at Dawud, he returned and put down the sword and said: Who is it that threw you from the roof? He said: I did not realize that.", "book_file": "vol4_j4-k09.doc.txt", "book_title": "Contemplation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Contemplation'", "badge": "Insight"}], "187": [{"arabic": "وقوله عز وجل ﴿ ثقلت في السموات والأرض ﴾ {} معناه خفيت على أهل السموات والأرض والشيء إذا خفي ثقل فأبدل اللفظ به وأقيم في مقام على وأضمر الأهل وحذف", "english": "And His (Allah's) saying, the Exalted, 'It has become heavy in the heavens and the earth' (Quran 7:187) means it has become hidden from the inhabitants of the heavens and the earth. When a thing is hidden, it becomes heavy, so the expression is substituted for it and placed in the position of 'upon' (على), and the inhabitants (أهل) are implied and omitted.", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}, {"arabic": "وَقَوْلِهِ تَعَالَى ﴿ يَسْأَلُونَكَ كَأَنَّكَ حَفِيٌّ عَنْهَا ﴾ {} أَيْ يَسْأَلُونَكَ عَنْهَا كَأَنَّكَ حَفِيٌّ بِهَا", "english": "And His saying, the Exalted: 'They ask you as if you are well-informed about it' (Quran 7:187) meaning: They ask you about it as if you are well-informed about it.", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Etiquette of Quran Recitation'", "badge": "General"}], "188": [{"arabic": "لذي خلق لأجله؛ وهو العلم والحكمة والمعرفة وحب الله تعالى وعبادته والتلذذ بذكره وإيثاره ذلك على كل شهوة سواه والاستعانة بجميع الشهوات والأعضاء عليه قال الله تعالى \"وما خلقت الجن والإنس إلا ليعبدون\" ففي كل عضو فائدة وفائدة القلب الحكمة والمعرفة. وخاصية النفس التي للآدمي، ما يتميز بها عن البهائم، فإنه لم يتميز عنها بالقوة على الأكل والوقاع والإبصار أو غيرها: بل بمعرفة الأشياء على ما هي عليه. وأصل الأشياء وموجدها ومخترعها هو الله عز وجل الذي جعلها أشياء. فلو عرف كل شيء ولم يعرف الله عز وجل فكأنه لم ", "english": "For which He created; and it is knowledge and wisdom and knowledge and love of Allah the Exalted and worship of Him and delighting in His remembrance (Dhikr) and preferring that over every desire besides it and seeking help with all desires and limbs upon it. Allah the Exalted said: \"And I did not create the jinn and mankind except to worship Me.\" So in every limb there is a benefit and the benefit of the heart (Qalb) is wisdom and knowledge. And the characteristic of the soul (Nafs) that is for the human, what distinguishes him from the beasts, for he is not distinguished from them by the power over eating and intercourse and sight or others: but by knowing things as they are. And the origin of things and their bringer into existence and their inventor is Allah the Mighty and Majestic who made them things. So if he knew every thing and did not know Allah the Mighty and Majestic then it is as if he did not know anything. And the sign of knowledge is love, so whoever knows Allah the Exalted loves Him and the sign of love is that he does not prefer over Him the world, nor others from the beloved things as Allah the Exalted said: \"Say: If your fathers and your sons and your brothers and your wives\" to His saying: \"more beloved to you than Allah and His Messenger and striving in His cause then wait until Allah brings His command.\" So whoever has something more beloved to him than Allah then his heart (Qalb) is sick, just as every stomach that clay becomes more beloved to it than bread and water or its desire falls away from bread and water then it is sick. So these are the signs of sickness and by this it is known that the hearts (Qulub) are all sick except what Allah wills except that from the sicknesses is what its owner does not know, and sickness of the heart (Qalb) is from what its owner does not know, therefore he is heedless of it. And if he knows it, patience upon the bitterness of its medicine is difficult for him, for its medicine is opposing the desires and it is extracting the spirit (Ruh). So if he found from himself strength of patience upon it, he did not find a skilled physician to treat him, for the physicians are the scholars and the sickness has dominated them, so the sick physician rarely pays attention to his treatment, therefore the disease became chronic and the sickness became persistent and this knowledge became extinct, and the medicine of the hearts (Qulub) was denied completely and their sickness was denied, and the creation turned to love of the world, and upon works whose outward is acts of worship and whose inward is habits and showing off. So these are the signs of the roots of the sicknesses. And as for the signs of their return to health after treatment, it is that he looks at the ailment that he treats, for if he treats the disease of miserliness, it is the destroyer that distances from Allah the Mighty and Majestic and its treatment is by giving wealth and spending it, but he may give wealth to a limit that he becomes with it a squanderer, so squandering also becomes a disease, so it was as treating coldness with heat until heat overcomes, so it is also a disease, rather the required is moderation between heat and coldness. And likewise the required is moderation between squandering and stinginess until it is upon the middle and in an extreme of distance from the two extremes, so if you want to know the middle then look.", "book_file": "vol3_Vol3-book2a.doc.txt", "book_title": "Breaking the Two Desires", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Breaking the Two Desires'", "badge": "Insight"}, {"arabic": "ولا يتفكر واحد منهم إلا ما شاء الله في جنازة نفسه وفي حاله إذا حمل عليها ولا سبب لهذه الغفلة إلا قسوة القلوب بكثرة المعاصي والذنوب حتى نسينا الله تعالى واليوم الآخر والأهوال التي بين أيدينا فصرنا نلهو ونغفل ونشتغل بما لا يعنينا فنسأل الله تعالى اليقظة من هذه الغفلة فإن أحسن أحوال الحاضرين على الجنائز بكاؤهم على الميت ولو عقلوا لبكوا على أنفسهم لا على الميت نظر إبراهيم الزيات إلى إناس يترحمون على الميت فقال لو ترحمون على أنفسكم لكان خيرا لكم إنه نجا من أهوال ثلاثة: وجه ملك الموت وقد رأى، ومرارة ا", "english": "And not one of them reflects except what Allah wills (mā shāʾa Allāh) regarding his own funeral and his condition when carried upon it. And there is no cause for this heedlessness (ghaflah) except the hardening of the hearts (qulūb) through abundant sins and misdeeds, until we have forgotten Allah the Exalted and the Last Day and the terrors that lie before us, so we have become diverted, heedless, and preoccupied with what does not concern us. So we ask Allah the Exalted for awakening from this heedlessness. For the best state of those present at funerals is their weeping over the deceased; if they were to understand, they would weep over themselves, not over the deceased. Ibrahim al-Zayyat looked at people offering mercy upon the deceased and said: 'If you offered mercy upon yourselves, it would be better for you. He has escaped from three terrors: the face of the Angel of Death (Malak al-Mawt) which he has seen, the bitterness of death which he has tasted, and the fear of the ending (khātimah) from which he is secure.' And Abu 'Amr ibn al-'Ala' said: 'I sat with Jarir while he was dictating poetry to his scribe, then a funeral procession appeared, so he stopped and said: 'By Allah, these funerals have aged me,' and he began to recite: 'Funerals alarm us as they approach, and we amuse ourselves when they depart, like the alarm of a flock at a wolf's den, but when it disappears, they return to grazing.' Among the etiquettes of attending funerals are reflection (tafakkur), alertness (tanabbuh), preparation (isti'dād), and walking before them in a manner of humility (tawāḍu') as we have mentioned its etiquettes and practices in the field of jurisprudence. And among its etiquettes is having good thoughts (ḥusn al-ẓann) about the deceased even if he was a sinner, and having bad thoughts (sūʾ al-ẓann) about oneself even if one's outward appearance is righteous, for the ending is perilous and does not...", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Repentance'", "badge": "Insight"}, {"arabic": "وقال الشافعي رحمة الله عليه دهمني في هذه الأيام أمر أمضني وآلمني ولم يطلع عليه غير الله عز وجل فلما كان البارحة أتاني آت في منامي فقال لي يا محمد بن إدريس قل اللهم إني لا أملك لنفسي نفعا ولا ضرا ولا موتا ولا حياة ولا نشورا ولا أستطيع أن آخذ إلا ما أعطيتني ولا أتقي إلا ما وقيتني اللهم فوفقني لما تحب وترضى من القول والعمل في عافية فلما أصبحت أعدت ذلك فلما ترحل النهار أعطاني الله عز وجل طلبتي وسهل لي الخلاص مما كنت فيه فعليكم بهذه الدعوات لا تغفلوا عنها", "english": "And Al-Shafi'i, mercy of Allah upon him, said: 'An affair afflicted me in these days that distressed me and pained me, and none was aware of it except Allah, the Mighty and Majestic. When it was last night, a visitor came to me in my dream and said to me: \"O Muhammad ibn Idris, say: O Allah, indeed I do not possess for myself benefit (Naf') nor harm (Darr), nor death, nor life, nor resurrection, nor am I able to take except what You have given me, nor can I guard against except what You have protected me from. O Allah, then grant me success in what You love and are pleased with from speech and action in well-being.\" When I awoke, I repeated that. When the day departed, Allah, the Mighty and Majestic, gave me my request and facilitated for me deliverance from what I was in. So upon you are these supplications; do not neglect them.'", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Book of Repentance'", "badge": "Du'a"}], "194": [{"arabic": "فالأحرى بالعبد ان لم يحسن الصبر على البلاء والقضاء وأفضي به الضعف الى الشكوى ان تكون شكواه الى الله تعالى فهو المبلى والقادر على ازالة البلاء وذل العبد لمولاه عز والشكوى الى غيره ذل وإظهار الذل للعبد مع كونه عبدا مثله ذل قبيح قال الله تعالى: ﴿ إن الذين تعبدون من دون الله لا يملكون لكم رزقا فابتغوا عند الله الرزق واعبدوه واشكروا له ﴾ {} وقال تعالى: ﴿ إن الذين تدعون من دون الله عباد امثالكم ﴾ {} فالشكر باللسان من جملة الشكر.", "english": "It is more appropriate for the servant (Abd) that if he does not excel in patience (Sabr) upon affliction (Bala') and decree (Qada'), and weakness leads him to complaint, that his complaint be to Allah the Exalted, for He is the Afflicter and the Able to remove affliction, and the humility (Dhull) of the servant (Abd) to his Master (Mawla) is honorable, while complaint to other than Him is humiliation (Dhull), and displaying humility (Dhull) to a servant (Abd) while he is a servant (Abd) like him is ugly humiliation (Dhull). Allah the Exalted said: 'Indeed, those you worship besides Allah do not possess for you [the power of] provision. So seek from Allah provision and worship Him and be grateful to Him.' And He said: 'Indeed, those you call upon besides Allah are servants (Ibad) like you.' So gratitude (Shukr) by the tongue (Lisan) is from the totality of gratitude (Shukr).", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "أما سمعتني أقول إن الذين تدعون من دون الله عباد أمثالكم إن الذين تعبدون من دون الله لا يملكون لكم رزقا فابتغوا عند الله الرزق واعبدوه ويحك أما سمعتني أقول ألا لله الدين الخالص فإذا عرف العبد أنه بصدد هذه المطالبات والتوبيخات طالب نفسه قبل أن تطالب وأعد للسؤال جوابا وليكن الجواب صوابا", "english": "Have you not heard Me say: 'Indeed, those whom you call upon besides Allah are servants like yourselves. Indeed, those whom you worship besides Allah do not possess for you provision, so seek provision from Allah and worship Him.' Woe to you! Have you not heard Me say: 'Indeed, to Allah belongs the pure religion (Al-Din al-Khalis).' So when the servant (Al-Abd) knows that he is facing these demands and rebukes, he questions his soul (Nafs) before it is questioned and prepares an answer for the questioning, and let the answer be correct.", "book_file": "vol4_j4-k08.doc.txt", "book_title": "Monitoring and Accounting", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monitoring and Accounting'", "badge": "Insight"}, {"arabic": "وقال تعالى: \" إن الذين تدعون من دون الله عباد أمثالكم \". بين أن كل ما سوى الله تعالى عبد مسخر. حاجته مثل حاجتكم فكيف من يتوكل عليه.", "english": "And He (Exalted) said: \"Indeed, those whom you call upon besides Allah are servants (عباد) like you.\" He clarifies that everything other than Allah (Exalted) is a subjugated servant (عبد مسخر). His need is like your need, so how can one rely (يتوكل) upon him.", "book_file": "vol4_Vol4-book5.doc.txt", "book_title": "Monotheism and Reliance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monotheism and Reliance'", "badge": "Insight"}], "199": [{"arabic": "بل ينبغي أن يعالج هذا الجاهل بأن تتلى عليه حكايات أهل الحلم والعفو وما استحسن منهم من كظم الغيظ، فإن ذلك منقول عن الأنبياء والأولياء والحكماء والعلماء وأكابر الملوك الفضلاء، وضد ذلك منقول عن الأكراد والأتراك والجهلة والأغبياء الذين لا عقول لهم ولا فضل فيهم. بيان علاج الغضب بعد هيجانه ما ذكرناه هو حسم لمواد الغضب وقطع لأسبابه حتى لا يهيج، فإذا جرى سبب هيجه فعنده يجب التثبت حتى لا يضطر صاحبه إلى العمل به على الوجه المذموم، وإنما يعالج الغضب عند هيجانه بمعجون العلم والعمل. أما العلم فهو ستة أمور؛ ا", "english": "Rather, this ignorant person should be treated by recounting to him stories of the people of forbearance (Hilm) and pardon (Afw) and what has been praised among them of suppressing anger (Kazm al-Ghaiz), for that is transmitted from the Prophets, the saints (Awliya), the wise ones, the scholars, and the virtuous great kings, and the opposite of that is transmitted from the Kurds, the Turks, the ignorant ones, and the foolish ones who have no intellects and no virtue in them. Explanation of treating anger after its arousal: What we have mentioned is cutting off the materials of anger and severing its causes so that it does not become aroused. If a cause for its arousal occurs, then at that point caution must be exercised so that its possessor is not compelled to act upon it in the blameworthy manner. Indeed, anger is treated at the time of its arousal with the remedy of knowledge and action. As for knowledge, it is six matters; the first: that he reflects upon the reports that we will present regarding the virtue of suppressing anger (Kazm al-Ghaiz), pardon (Afw), forbearance (Hilm), and endurance (Ihtimal), so he becomes desirous of its reward, and the intensity of his eagerness for the reward of suppression prevents him from seeking revenge and retaliation, and his rage is extinguished. Malik bin Aws bin al-Hadthan said: Umar became angry with a man and ordered him to be struck, so I said, 'O Commander of the Faithful, \"Take the pardon (Afw) and command the recognized good (Urf) and turn away from the ignorant ones (Jahilin).\"' So Umar would say, \"Take the pardon (Afw) and command the recognized good (Urf) and turn away from the ignorant ones (Jahilin).\" He would contemplate the verse and was one who halted at the Book of Allah; whenever it was recited to him, he would reflect much upon it, so he reflected upon it and released the man.", "book_file": "vol3_Vol3-book5a.doc.txt", "book_title": "Condemnation of Envy", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Envy'", "badge": "Ethics"}, {"arabic": "اعلم أن معنى العفو أن يستحق حقاً فيسقطه ويبرئ عنه من قصاص أو غرامة، وهو غير الحلم وكظم الغيظ؛ فلذلك أفردناه. قال الله تعالى \"خذ العفو وأمر بالعرف وأعرض عن الجاهلين\" وقال الله تعالى \"وأن تعفوا أقرب للتقوى\" وقال رسول الله ﭬ \"ثلاث والذي نفسي بيده لو كنت حلافاً لحلفت عليهن: ما نقص مال من صدقة فتصدقوا، ولا عفا رجل عن مظلمة يبتغي بها وجه الله إلا زاده الله بها عزاً يوم القيامة، ولا فتح رجل على نفسه باب مسألة إلا فتح الله عليه باب فقر\"[64] وقال ﭬ \"التواضع لا يزيد العبد إلا رفعة فتواضعوا يرفعكم الله، وا", "english": "Know that the meaning of forgiveness (Al-'Afw) is that one is entitled to a right but waives it and absolves from punishment or penalty, and it is different from forbearance (Al-Hilm) and suppressing anger (Kazm Al-Ghaiz); therefore we have singled it out. Allah the Exalted said: \"Take forgiveness (Al-'Afw) and command with what is recognized as good (Al-'Urf) and turn away from the ignorant ones (Al-Jahilin).\" And Allah the Exalted said: \"And that you forgive is nearer to piety (Al-Taqwa).\" And the Messenger of Allah (peace be upon him) said: \"Three things - by the One in Whose Hand is my soul - if I were to swear an oath, I would swear upon them: No wealth decreases from charity (Sadaqah), so give charity; and no man forgives an injustice seeking by it the Face of Allah except that Allah increases him in honor (Izz) on the Day of Resurrection; and no man opens upon himself the door of begging except that Allah opens upon him the door of poverty.\" And he (peace be upon him) said: \"Humility (Al-Tawadu') does not increase the servant except in elevation, so be humble and Allah will elevate you; and forgiveness (Al-'Afw) does not increase the servant except in honor (Izz), so forgive and Allah will honor you; and charity (Al-Sadaqah) does not increase wealth except in abundance, so give charity and Allah will have mercy on you.\" And Aisha (may Allah be pleased with her) said: \"I never saw the Messenger of Allah (peace be upon him) seeking retaliation for an injustice done to him as long as it did not violate the prohibitions of Allah, but if something from the prohibitions of Allah was violated, he was the most severe among them in anger regarding that, and he was never given a choice between two matters except that he chose the easiest of them as long as it was not a sin.\" And Uqbah said: \"I met the Messenger of Allah (peace be upon him) one day and I hastened to him and took his hand, or he hastened to me and took my hand, and he said: 'O Uqbah, shall I not inform you of the best character traits of the people of this world and the Hereafter: You maintain ties with one who cuts you off, you give to one who deprives you, and you forgive one who wrongs you.'\" And he (peace be upon him) said: \"Moses (peace be upon him) said: 'O Lord, which of Your servants is most honorable to You?' He said: 'The one who, when he has power, forgives.'\" Likewise, Abu Al-Darda was asked about the most honorable of people, and he said: \"The one who forgives when he has power, so forgive.\"", "book_file": "vol3_Vol3-book5a.doc.txt", "book_title": "Condemnation of Envy", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Envy'", "badge": "Ethics"}, {"arabic": "ثم أن تفاخر عليه غيره فليحتمل قال الله تعالى لنبيه صلى الله عليه وسلم خذ العفو وأمر بالعرف وأعرض عن الجاهلين وعن ابن أبي أوفى كان رسول الله صلى الله عليه وسلم يتواضع لكل مسلم ولا يأنف ولا يتكبر أن يمشي مع الأرملة و المسكين فيقضى حاجته حديث ابن أبي أوفى كان لا يأنف ولا يستكبر أن يمشي مع الأرملة و السكين فيقضي حاجته أخرجه النسائي بإسناد صحيح والحاكم وقال على شرط الشيخين", "english": "Then, if someone else boasts over him, let him bear it. Allah the Exalted said to His Prophet (peace be upon him): 'Take the pardon (Al-'Afw) and command with the recognized good (Al-'Urf) and turn away from the ignorant ones (Al-Jahilin).' And from Ibn Abi Awfa: The Messenger of Allah (peace be upon him) would show humility (Tawadu') to every Muslim, and he would not disdain nor be too proud to walk with the widow and the poor person to fulfill their need. The hadith of Ibn Abi Awfa: He would not disdain nor be too proud to walk with the widow and the poor person to fulfill their need. Narrated by Al-Nasa'i with a sound chain and Al-Hakim said: according to the condition of the two Shaykhs.", "book_file": "vol2_j2-k05.doc.txt", "book_title": "Duties of Brotherhood", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Duties of Brotherhood'", "badge": "Hadith"}, {"arabic": "وإنما أدبه القرآن بمثل قوله تعالى خذ العفو وأمر بالعرف وأعرض عن الجاهلين وقوله إن الله يأمر بالعدل والإحسان وإيتاء ذي القربى وينهى عن الفحشاء والمنكر والبغي وقوله واصبر على ما أصابك إن ذلك من عزم الأمور وقوله ولمن صبر وغفر إن ذلك لمن عزم الأمور وقوله فاعف عنهم واصفح إن الله يحب المحسنين وقوله وليعفوا وليصفحوا ألا تحبون أن يغفر الله لكم وقوله ادفع بالتي هي أحسن فإذا الذي بينك وبينه عداوة كأنه ولي حميم وقوله والكاظمين الغيظ والعافين عن الناس والله يحب المحسنين وقوله اجتنبوا كثيرا من الظن إن بعض ال", "english": "And indeed, the Quran educated him with verses like His saying, the Exalted: 'Take the pardon (Al-'Afw) and command with the recognized good (Al-'Urf) and turn away from the ignorant ones (Al-Jahilin).' And His saying: 'Indeed, Allah commands with justice (Al-'Adl) and excellence (Al-Ihsan) and giving to the near of kin, and forbids from the indecency (Al-Fahsha') and the disapproved (Al-Munkar) and the transgression (Al-Baghy).' And His saying: 'And be patient (Asbir) over what befalls you; indeed, that is of the matters of determination (Azm Al-Umur).' And His saying: 'And for whoever is patient (Sabara) and forgives (Ghafara), indeed that is of the matters of determination (Azm Al-Umur).' And His saying: 'So pardon (Fa'fu) them and overlook (Wasfah); indeed, Allah loves the doers of excellence (Al-Muhsinin).' And His saying: 'And let them pardon (Wa Liya'fu) and let them overlook (Wa Liyasfahu); do you not love that Allah should forgive (Yaghfira) you?' And His saying: 'Repel with that which is better (Al-Lati Hiya Ahsan); then behold, the one between you and him is enmity, as if he were a close friend (Waliyy Hameem).' And His saying: 'And those who suppress the anger (Al-Ghaiz) and those who pardon (Al-'Afin) the people; and Allah loves the doers of excellence (Al-Muhsinin).' And His saying: 'Avoid much of the suspicion (Al-Zann); indeed, some suspicion is sin, and do not spy and do not backbite (Yaghtab) one another.'", "book_file": "vol2_j2-k10.doc.txt", "book_title": "Etiquette of Living and Prophetic Character", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Etiquette of Living and Prophetic Character'", "badge": "Ethics"}, {"arabic": "الثاني: أن يخوف نفسه بعقاب الله وهو أن يقول قدرة الله على أعظم من قدرتي على هذا الإنسان، فلو أمضيت غضبي عليه لم آمن أن يمضي الله غضبه علي يوم القيامة أحوج ما أكون إلى العفو. فقد قال تعالى في بعض الكتب القديمة: يا ابن آدم اذكرني حين تغضب أذكرك حين أغضب فلا أمحقك فيمن أمحق. وبعث رسول الله ﭬ وصيفاً إلى حاجة فأبطأ عليه فلما جاء قال \"لولا القصاص لأوجعتك\"[22] أي القصاص في القيامة. وقيل ما كان في بني إسرائيل ملك إلا ومعه حكيم إذا غضب أعطاه صحيفة فيها: ارحم المسكين واخش الموت واذكر الآخرة، فكان يقرؤها ح", "english": "The second: That he frightens his Soul (Nafs) with the punishment of Allah, which is that he says: The power of Allah is greater than my power over this human, so if I carry out my anger upon him, I do not feel secure that Allah will carry out His anger upon me on the Day of Resurrection when I am most in need of forgiveness. Indeed, Allah the Exalted said in some of the ancient books: O son of Adam, remember Me when you are angry, I will remember you when I am angry, so I will not annihilate you among those I annihilate. And the Messenger of Allah ﷺ sent a servant for a need, and he delayed upon him, so when he came, he said: \"Were it not for retribution, I would have hurt you\"[22] meaning retribution on the Day of Resurrection. And it was said: There was no king among the Children of Israel except that with him was a wise man; when he became angry, he would give him a scroll in which was written: Have mercy on the poor, fear death, and remember the Hereafter, and he would read it until his anger subsided. The third: That he warns his Soul (Nafs) of the consequence of enmity and revenge, and the enemy prepares to confront him and strives to destroy his purposes and gloat over his calamities, and he is not free from calamities, so he frightens his Soul (Nafs) with the consequences of anger in this world if he does not fear from the Hereafter. And this returns to unleashing desire.", "book_file": "vol3_Vol3-book5a.doc.txt", "book_title": "Condemnation of Envy", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Envy'", "badge": "Ethics"}], "200": [{"arabic": "وإنه مهما دفع الوساوس كلها ورد النفس إلى هذه الكلمة جاءته الوساوس من هذه الكلمة، وأنها: ما هي؟ وما معنى قولنا: الله؟ ولأي معنى كان إلهاً وكان معبوداً؟ ويعتريه عند ذلك خواطر تفتح عليه باب الفكر وربما يرد عليه من وساوس الشيطان ما هو كفر وبدعة. ومهما كان كارهاً لذلك ومتشمراً لإماطته عن القلب لم يضره ذلك. وهي منقسمة إلى ما يعلم قطعاً أن الله تعالى منزه عنه ولكن الشيطان يلقي ذلك في قلبه ويجريه على خاطره، فشرطه أن يبالي به ويفزع إلى ذكر الله تعالى ويبتهل إليه ليدفعه عنه كما قال الله تعالى \"وإما ينزغنك", "english": "And if he repels all the whisperings and returns the Soul (Nafs) to this word, whisperings come to him from this word, and they are: What is it? And what is the meaning of our saying: Allah? And for what meaning was He a deity (Ilah) and was worshipped? And there befalls him at that time thoughts that open upon him the door of reflection, and perhaps there comes to him from the whisperings of Satan what is disbelief and innovation. And however much he is averse to that and prepared to remove it from the Heart (Qalb), it does not harm him. And they are divided into what he knows decisively that Allah the Exalted is free from it, but Satan casts that in his heart and runs it on his thought, so his condition is that he should care about it and flee to the Remembrance (Dhikr) of Allah the Exalted and beseech Him to repel it from him, as Allah the Exalted said: \"And if an incitement from Satan incites you, then seek refuge in Allah. Indeed, He is Hearing, Knowing.\" And He said: \"Indeed, those who fear Allah, when an impulse from Satan touches them, they remember, and at once they see clearly.\" And into what he doubts about, then he should present that to his spiritual guide (Shaykh), rather everything he finds in his heart from the states of slackness or vigor or attention to an attachment or truthfulness in intention, then he should manifest that to his spiritual guide (Shaykh), and conceal it from others so that he does not inform anyone about it. Then his spiritual guide (Shaykh) looks at his condition and contemplates his intelligence and cleverness, so if he knows that if he leaves him and commands him with reflection, he awakens from himself to the reality of the Truth, then he should refer him to reflection and command him to adhere to it until there is cast in his heart from the light what unveils to him its reality. And if he knows that that is from what one like him cannot bear, he returns him to the decisive belief with what his heart can bear from admonition and that is evidence close to his understanding. And it is built that the spiritual guide (Shaykh) should be meticulous and gentle with him, for these are the perils of the path and places of its dangers.", "book_file": "vol3_Vol3-book2a.doc.txt", "book_title": "Breaking the Two Desires", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Breaking the Two Desires'", "badge": "Insight"}], "201": [{"arabic": "فحق على العبد أن يقف عند كل هم يخطر له ليعلم أنه من لمة الملك أو من لمة الشيطان وأن يمعن النظر فيه بعين البصيرة لا بهوى من الطبع ولا يطلع عليه إلا بنور التقوى والبصيرة وغزارة العلم كما قال تعالى إن الذين اتقوا إذا مسهم طائف من الشيطان تذكروا أي رجعوا إلى نور العلم فإذا هم مبصرون أي ينكشف لهم الإشكال فأما من لم يرض نفسه بالتقوى فيميل طبعه إلى الإذعان بتلبيسه بمتابعة الهوى فيكثر فيه غلطه ويتعجل فيه هلاكه وهو لا يشعر وفي مثلهم قال سبحانه وتعالى وبدا لهم من الله ما لم يكونوا يحتسبون قيل هي أعمال ظنو", "english": "It is incumbent upon the servant (Al-Abd) to pause at every thought that occurs to him to know whether it is from the inspiration of the angel (Lamat Al-Malak) or from the whisper of the devil (Lamat Al-Shaytan), and to examine it deeply with the eye of insight (Al-Basira) not with the desire (Hawa) of the natural disposition (Al-Tab'), nor can one perceive it except with the light of God-consciousness (Al-Taqwa) and insight (Al-Basira) and abundance of knowledge, as Allah the Exalted said: 'Indeed, those who are God-conscious (Al-Muttaqun) - when an impulse from Satan touches them, they remember (Tadhakkaru) [Allah] and at once they have insight (Mubsirun).' That is, they return to the light of knowledge, so then they have insight (Mubsirun), meaning the confusion is unveiled for them. As for one who does not satisfy himself with God-consciousness (Al-Taqwa), his natural disposition (Al-Tab') inclines to submitting to its deception by following desire (Al-Hawa), so his error increases in it and his destruction hastens while he is unaware. And concerning their like, He the Exalted said: 'And there will appear to them from Allah that which they had not taken into account.' It is said: they are deeds they thought were good deeds, but they are evil deeds.", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "ولذلك قال الله تعالى إن الذين اتقوا إذا مسهم طائف من الشيطان تذكروا فإذا هم مبصرون خصص بذلك المتقى فمثل الشيطان كمثل كلب جائع يقرب منك فإن لم يكن بين يديك خبز أو لحم فإنه ينزجر بأن تقول له اخسأ فمجرد الصوت يدفعه فإن كان بين يديك لحم وهو جائع فإنه يهجم على اللحم ولا يندفع بمجرد الكلام فالقلب الخالي عن قوت الشيطان ينزجر عنه بمجرد الذكر فأما الشهوة إذا غلبت على القلب دفعت حقيقة الذكر إلى حواشي القلب فلم يتمكن من سويدائه فيستقر الشيطان في سويداء القلب وأما قلوب المتقين الخالية من الهوى والصفات المذم", "english": "And therefore Allah the Exalted said: 'Indeed, those who are God-fearing (ittaqaw) when a passing thought (ta'if) from Satan touches them, they remember (tadhakkaru), then indeed they become seeing (mubsirun).' He specified that for the God-fearing (muttaqin). So the likeness of Satan is like a hungry dog that approaches you. If there is no bread or meat before you, then it is repelled by you saying to it: 'Go away!' Mere sound repels it. But if there is meat before you and it is hungry, then it attacks the meat and is not repelled by mere speech. So the Heart (Qalb) empty from the sustenance of Satan is repelled from it by mere Remembrance (Dhikr). As for the desire (shahwa) when it overcomes the Heart, it pushes the reality of the Remembrance to the peripheries of the Heart, so it does not reach its core (sawad), and Satan settles in the core of the Heart. But as for the hearts of the God-fearing (muttaqin), empty from caprice (hawa) and blameworthy traits, Satan approaches them not for desires but because of their emptiness due to heedlessness (ghafla) from the Remembrance. So when it returns to the Remembrance, Satan retreats. And evidence for that is His saying: 'So seek refuge in Allah from Satan the accursed,' and the rest of the reports and verses that have come regarding the Remembrance.", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "ولا يمحو وسوسة الشيطان من القلب إلا ذكر ما سوى ما يوسوس به لأنه إذا خطر في القلب ذكر شيء انعدم منه ما كان فيه من قبل ولكن كل شيء سوى الله تعالى وسوى ما يتعلق به فيجوز أيضا أن يكون مجالا للشيطان وذكر الله هو الذي يؤمن جانبه ويعلم أنه ليس للشيطان فيه مجال ولا يعالج الشيء إلا بضده وضد جميع وساوس الشيطان ذكر الله بالاستعاذة والتبري عن الحول والقوة وهو معنى قولك أعوذ بالله من الشيطان الرجيم ولا حول ولا قوة إلا بالله العلي العظيم وذلك لا يقدر عليه إلا المتقون الغالب عليهم ذكر الله تعالى وإنما الشيطان ", "english": "And nothing erases the whispering (waswasa) of the Satan (Shaytan) from the Heart (Qalb) except the remembrance (dhikr) of something other than what he whispers about, because when the remembrance of something occurs in the Heart, what was previously in it disappears. However, everything besides Allah the Exalted and besides what is connected to Him may also be a field for the Satan, and the remembrance of Allah is what secures his side and makes known that there is no field for the Satan in it. And nothing is treated except by its opposite, and the opposite of all the whisperings of the Satan is the remembrance of Allah through seeking refuge (isti'adha) and disavowing power and strength, which is the meaning of your saying: 'I seek refuge in Allah from the accursed Satan' and 'There is no power nor strength except with Allah, the Most High, the Most Great.' And that is not within the capability except of the God-fearing (muttaqun) upon whom the remembrance of Allah the Exalted predominates. Indeed, the Satan only circles around them at times of lapses (faltat) by way of stealth. Allah the Exalted said: 'Indeed, those who fear Allah (ittaqaw) - when an impulse (ta'if) from Satan touches them, they remember (tadhakkaru) and then they see clearly (mubsirun).' And Mujahid said regarding the meaning of the saying of Allah the Exalted: 'From the evil of the whisperer (waswas) who withdraws (khannas)' - he said: 'He spreads out over the Heart, so when Allah the Exalted is remembered, he withdraws (khanasa) and contracts, and when one is heedless (ghafil), he spreads out over his heart.' So the chasing away between the remembrance of Allah the Exalted and the whispering of the Satan is like the chasing away between light (nur) and darkness (zalam), and between night (layl) and day (nahar). And due to their opposition, Allah the Exalted said: 'Satan has gained mastery over them and made them forget the remembrance of Allah.'", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "ومهما كان كارهاً لذلك ومتشمراً لإماطته عن القلب لم يضره ذلك. وهي منقسمة إلى ما يعلم قطعاً أن الله تعالى منزه عنه ولكن الشيطان يلقي ذلك في قلبه ويجريه على خاطره، فشرطه أن يبالي به ويفزع إلى ذكر الله تعالى ويبتهل إليه ليدفعه عنه كما قال الله تعالى \"وإما ينزغنك من الشيطان نزغ فاستعذ بالله إنه سميع عليم\" وقال تعالى \"إن الذين اتقوا إذا مسهم طائف من الشيطان تذكروا فإذا هم مبصرون\" وإلى ما يشك فيه فينبغي أن يعرض ذلك على شيخه، بل كل ما يجد في قلبه من الأحوال من فترة أو نشاط أو التفات إلى علقة أو صدق في إ", "english": "And whenever he is averse to that and strives to remove it from the Heart (Qalb), it does not harm him. And it is divided into what he knows with certainty that Allah the Exalted is free from, but the Satan casts that into his Heart (Qalb) and runs it through his thought, so his condition is that he should care about it and flee to the Remembrance (Dhikr) of Allah the Exalted and beseech Him to repel it from him, as Allah the Exalted said: \"And if an evil whisper from the Satan tries to turn you away (O Muhammad), then seek refuge in Allah. Verily, He is the All-Hearer, the All-Knower\" and He said: \"Indeed, those who are God-fearing (Muttaqun) when a touch from the Satan touches them, they remember, then behold, they are seeing clearly.\" And as for what he doubts about, then he should present that to his spiritual guide (Shaykh), rather everything he finds in his Heart (Qalb) of states from slackness or activity or attention to an attachment or sincerity in intention, he should manifest that to his spiritual guide (Shaykh), and conceal it from others so that no one becomes aware of it. Then his spiritual guide (Shaykh) looks at his condition and contemplates his intelligence and cleverness, so if he knows that if he leaves him and commands him with reflection, he will awaken from himself to the reality of the Truth (Haqq), then he should refer him to reflection and command him to adhere to it until there is cast into his Heart (Qalb) from the Light (Nur) what unveils for him its reality. And if he knows that that is something his like cannot bear, he returns him to the decisive belief with what his Heart (Qalb) can bear of admonition and that is evidence close to his understanding. And it is built that the spiritual guide (Shaykh) should be refined and gentle with him, for these are the perils of the path and the places of its dangers.", "book_file": "vol3_Vol3-book2a.doc.txt", "book_title": "Breaking the Two Desires", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Breaking the Two Desires'", "badge": "Insight"}, {"arabic": "فمثل الإيمان فيه كمثل البقلة يمدها الماء الطيب ومثل النفاق فيه كمثل القرحة يمدها القيح والصديد فأي المادتين غلبت عليه حكم له بها وفي رواية ذهبت به قال الله تعالى إن الذين اتقوا إذا مسهم طائف من الشيطان تذكروا فإذا هم مبصرون فأخبر أن جلاء القلب وإبصاره يحصل بالذكر وأنه لا يتمكن منه إلا الذين اتقوا فالتقوى باب الذكر والذكر باب الكشف والكشف باب الفوز الأكبر وهو الفوز بلقاء الله تعالى.", "english": "So the likeness of faith in it is like a plant that pure water nourishes, and the likeness of hypocrisy in it is like an ulcer that pus and discharge nourish, so whichever of the two nourishments overcomes him, he is judged by it, and in a narration: it took him away. Allah the Exalted said: 'Indeed, those who are God-fearing (ittaqaw) when a passing thought (ta'if) from the Satan touches them, they remember (tadhakkaru), then behold, they are seeing clearly (mubsirun).' So He informed that the polishing (jala') of the heart (qalb) and its clear-sightedness (ibsar) occurs through the remembrance (dhikr), and that none can attain it except those who are God-fearing (ittaqaw). So God-fearingness (taqwa) is the gate of remembrance (dhikr), and remembrance (dhikr) is the gate of unveiling (kashf), and unveiling (kashf) is the gate of the greatest success (fawz al-akbar), which is success in meeting Allah the Exalted.", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}], "205": [{"arabic": "وقال عز وجل: ﴿ واذكر ربك في نفسك تضرّعاً وخيفةً  ودون  الجهر  من  القول  بالغدو والآصال ولا تكن من الغافلين ﴾ {} وقال تعالى: ﴿ ولذكر الله أكبر ﴾ {} قال  ابن عباس رضي الله عنهما: له وجهان أحدهما أن ذكر الله تعالى  لكم  أعظم  من  ذكركم إياه والآخر أن ذكر الله أعظم من كل عبادة سواه إلى غير ذلك  من  الآيات.", "english": "And He, the Exalted, said: 'And remember your Lord (Rabb) within your Soul (Nafs) with humility (Tadarru') and fear (Khifah) and without loudness in speech in the morning (Ghuduww) and the evening (Asal) and do not be among the heedless (Ghafilin).' And He, the Exalted, said: 'And the Remembrance (Dhikr) of Allah is greater.' Ibn Abbas, may Allah be pleased with them both, said: It has two aspects: one is that the Remembrance (Dhikr) of Allah, the Exalted, for you is greater than your remembrance of Him, and the other is that the Remembrance (Dhikr) of Allah is greater than every worship besides it, among other verses.", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith", "badge": "Insight"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 9389]], "2": [[1, 400, 1579], [2, 1579, 2954], [3, 2954, 4493], [4, 4493, 5672]