}, {"id": 30, "arabic": "يُومِنُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 157, "text": "اَ۬لذِينَ يَتَّبِعُونَ اَ۬لرَّسُولَ اَ۬لنَّبِےٓءَ اَ۬لُامِّيَّ اَ۬لذِے يَجِدُونَهُۥ مَكْتُوباً عِندَهُمْ فِے اِ۬لتَّوْر۪يٰةِ وَالِانجِيلِ يَامُرُهُم بِالْمَعْرُوفِ وَيَنْه۪يٰهُمْ عَنِ اِ۬لْمُنكَرِ وَيُحِلُّ لَهُمُ اُ۬لطَّيِّبَٰتِ وَيُحَرِّمُ عَلَيْهِمُ اُ۬لْخَبَٰٓئِثَ وَيَضَعُ عَنْهُمُۥٓ إِصْرَهُمْ وَالَاغْلَٰلَ اَ۬لتِے كَانَتْ عَلَيْهِمْۖ فَالذِينَ ءَامَنُواْ بِهِۦ وَعَزَّرُوهُ وَنَصَرُوهُ وَاتَّبَعُواْ اُ۬لنُّورَ اَ۬لذِےٓ أُنزِلَ مَعَهُۥٓ أُوْلَٰٓئِكَ هُمُ اُ۬لْمُفْلِحُونَۖ", "words": [{"id": 1, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَتَّبِعُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لرَّسُولَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لنَّبِےٓءَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لُامِّيَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 7, "arabic": "يَجِدُونَهُۥ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَكْتُوباً", "translit": "", "root": ""}, {"id": 9, "arabic": "عِندَهُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "فِے", "translit": "", "root": ""}, {"id": 11, "arabic": "اِ۬لتَّوْر۪يٰةِ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَالِانجِيلِ", "translit": "", "root": ""}, {"id": 13, "arabic": "يَامُرُهُم", "translit": "", "root": ""}, {"id": 14, "arabic": "بِالْمَعْرُوفِ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَيَنْه۪يٰهُمْ", "translit": "", "root": ""}, {"id": 16, "arabic": "عَنِ", "translit": "", "root": ""}, {"id": 17, "arabic": "اِ۬لْمُنكَرِ", "translit": "", "root": ""}, {"id": 18, "arabic": "وَيُحِلُّ", "translit": "", "root": ""}, {"id": 19, "arabic": "لَهُمُ", "translit": "", "root": ""}, {"id": 20, "arabic": "اُ۬لطَّيِّبَٰتِ", "translit": "", "root": ""}, {"id": 21, "arabic": "وَيُحَرِّمُ", "translit": "", "root": ""}, {"id": 22, "arabic": "عَلَيْهِ