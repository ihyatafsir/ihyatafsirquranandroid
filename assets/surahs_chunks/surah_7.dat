:8,"arabic":"ٱتَّبَعْتُمْ","translit":"ْmُtْʿعَbَّtٱ","root":"تبع"},{"id":9,"arabic":"شُعَيْبًا","translit":"āًbْyَʿعُhs","root":""},{"id":10,"arabic":"إِنَّكُمْ","translit":"ْmُkَّnِiʾ","root":""},{"id":11,"arabic":"إِذًا","translit":"āًhdِiʾ","root":""},{"id":12,"arabic":"لَّخَٰسِرُونَ","translit":"َnwُrِsَٰhkَّl","root":"خسر"}],"hasIhya":false},{"ayah":91,"text":"فَأَخَذَتْهُمُ ٱلرَّجْفَةُ فَأَصْبَحُوا۟ فِى دَارِهِمْ جَٰثِمِينَ ","translation":"So the earthquake seized them, and they became within their home [corpses] fallen prone.","words":[{"id":1,"arabic":"فَأَخَذَتْهُمُ","translit":"ُmُhْtَhdَhkَaʾَf","root":"اخذ"},{"id":2,"arabic":"ٱلرَّجْفَةُ","translit":"ُẗَfْjgَّrlٱ","root":"رجف"},{"id":3,"arabic":"فَأَصْبَحُوا۟","translit":"۟āwُḥَbْṣَaʾَf","root":"صبح"},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"دَارِهِمْ","translit":"ْmِhِrāَd","root":"دور"},{"id":6,"arabic":"جَٰثِمِينَ","translit":"َnyِmِhtَٰjg","root":"جثم"}],"hasIhya":false},{"ayah":92,"text":"ٱلَّذِينَ كَذَّبُوا۟ شُعَيْبًا كَأَن لَّمْ يَغْنَوْا۟ فِيهَاۚ ٱلَّذِينَ كَذَّبُوا۟ شُعَيْبًا كَانُوا۟ هُمُ ٱلْخَٰسِرِينَ ","translation":"Those who denied Shuʿayb - it was as though they had never resided there. Those who denied Shuʿayb - it was they who were the losers.","words":[{"id":1,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":2,"arabic":"كَذَّبُوا۟","translit":"۟āwُbَّhdَk","root":"كذب"},{"id":3,"arabic":"شُعَيْبًا","translit":"āًbْyَʿعُhs","root":""},{"id":4,"arabic":"كَأَن","translit":"nَaʾَk","root":""},{"id":5,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":6,"arabic":"يَغْنَوْا۟","translit":"۟āْwَnْغَy","root":"غني"},{"id":7,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":8,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":9,"arabic":"كَذَّبُوا۟","translit":"۟āwُbَّhdَk","root":"كذب"},{"id":10,"arabic":"شُعَيْبًا","translit":"āًbْyَʿعُhs","root":""},{"id":11,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":12,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":13,"arabic":"ٱلْخَٰسِرِينَ","translit":"َnyِrِsَٰhkْlٱ","root":"خسر"}],"hasIhya":false},{"ayah":93,"text":"فَتَوَلَّىٰ عَنْهُمْ وَقَالَ يَٰقَوْمِ لَقَدْ أَبْلَغْتُكُمْ رِسَٰلَٰتِ رَبِّى وَنَصَحْتُ لَكُمْۖ فَكَيْفَ ءَاسَىٰ عَلَىٰ قَوْمٍ كَٰفِرِينَ ","translation":"And he [i.e., Shuʿayb] turned away from them and said, \"O my people, I had certainly conveyed to you the messages of my Lord and advised you, so how could I grieve for a disbelieving people?\"","words":[{"id":1,"arabic":"فَتَوَلَّىٰ","translit":"ٰàَّlَwَtَf","root":"ولي"},{"id":2,"arabic":"عَنْهُمْ","translit":"ْmُhْnَʿع","root":""},{"id":3,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":4,"arabic":"يَٰقَوْمِ","translit":"ِmْwَqَٰy","root":"قوم"},{"id":5,"arabic":"لَقَدْ","translit":"ْdَqَl","root":""},{"id":6,"arabic":"أَبْلَغْتُكُمْ","translit":"ْmُkُtْغَlْbَaʾ","root":"بلغ"},{"id":7,"arabic":"رِسَٰلَٰتِ","translit":"ِtَٰlَٰsِr","root":"رسل"},{"id":8,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":9,"arabic":"وَنَصَحْتُ","translit":"ُtْḥَṣَnَw","root":"نصح"},{"id":10,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":11,"arabic":"فَكَيْفَ","translit":"َfْyَkَf","root":"كيف"},{"id":12,"arabic":"ءَاسَىٰ","translit":"ٰàَsāَء","root":"اسو"},{"id":13,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":14,"arabic":"قَوْمٍ","translit":"ٍmْwَq","root":"قوم"},{"id":15,"arabic":"كَٰفِرِينَ","translit":"َnyِrِfَٰk","root":"كفر"}],"hasIhya":false},{"ayah":94,"text":"وَمَآ أَرْسَلْنَا فِى قَرْيَةٍ مِّن نَّبِىٍّ إِلَّآ أَخَذْنَآ أَهْلَهَا بِٱلْبَأْسَآءِ وَٱلضَّرَّآءِ لَعَلَّهُمْ يَضَّرَّعُونَ ","translation":"And We sent to no city a prophet [who was denied] except that We seized its people with poverty and hardship that they might humble themselves [to Allāh].","words":[{"id":1,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":2,"arabic":"أَرْسَلْنَا","translit":"āَnْlَsْrَaʾ","root":"رسل"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"قَرْيَةٍ","translit":"ٍẗَyْrَq","root":"قري"},{"id":5,"arabic":"مِّن","translit":"nِّm","root":""},{"id":6,"arabic":"نَّبِىٍّ","translit":"ٍّàِbَّn","root":"نبا"},{"id":7,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":8,"arabic":"أَخَذْنَآ","translit":"ٓāَnْhdَhkَaʾ","root":"اخذ"},{"id":9,"arabic":"أَهْلَهَا","translit":"āَhَlْhَaʾ","root":"اهل"},{"id":10,"arabic":"بِٱلْبَأْسَآءِ","translit":"ِءٓāَsْaʾَbْlٱِb","root":"باس"},{"id":11,"arabic":"وَٱلضَّرَّآءِ","translit":"ِءٓāَّrَّḍlٱَw","root":"ضرر"},{"id":12,"arabic":"لَعَلَّهُمْ","translit":"ْmُhَّlَʿعَl","root":""},{"id":13,"arabic":"يَضَّرَّعُونَ","translit":"َnwُʿعَّrَّḍَy","root":"ضرع"}],"hasIhya":false},{"ayah":95,"text":"ثُمَّ بَدَّلْنَا مَكَانَ ٱلسَّيِّئَةِ ٱلْحَسَنَةَ حَتَّىٰ عَفَوا۟ وَّقَالُوا۟ قَدْ مَسَّ ءَابَآءَنَا ٱلضَّرَّآءُ وَٱلسَّرَّآءُ فَأَخَذْنَٰهُم بَغْتَةً وَهُمْ لَا يَشْعُرُونَ ","translation":"Then We exchanged in place of the bad [condition], good, until they increased [and prospered] and said, \"Our fathers [also] were touched with hardship and ease.\"[1] So We seized them suddenly while they did not perceive.[2]","words":[{"id":1,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":2,"arabic":"بَدَّلْنَا","translit":"āَnْlَّdَb","root":"بدل"},{"id":3,"arabic":"مَكَانَ","translit":"َnāَkَm","root":"كون"},{"id":4,"arabic":"ٱلسَّيِّئَةِ","translit":"ِẗَyʾِّyَّslٱ","root":"سوا"},{"id":5,"arabic":"ٱلْحَسَنَةَ","translit":"َẗَnَsَḥْlٱ","root":"حسن"},{"id":6,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":7,"arabic":"عَفَوا۟","translit":"۟āwَfَʿع","root":"عفو"},{"id":8,"arabic":"وَّقَالُوا۟","translit":"۟āwُlāَqَّw","root":"قول"},{"id":9,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":10,"arabic":"مَسَّ","translit":"َّsَm","root":"مسس"},{"id":11,"arabic":"ءَابَآءَنَا","translit":"āَnَءٓāَbāَء","root":"ابو"},{"id":12,"arabic":"ٱلضَّرَّآءُ","translit":"ُءٓāَّrَّḍlٱ","root":"ضرر"},{"id":13,"arabic":"وَٱلسَّرَّآءُ","translit":"ُءٓāَّrَّslٱَw","root":"سرر"},{"id":14,"arabic":"فَأَخَذْنَٰهُم","translit":"mُhَٰnْhdَhkَaʾَf","root":"اخذ"},{"id":15,"arabic":"بَغْتَةً","translit":"ًẗَtْغَb","root":"بغت"},{"id":16,"arabic":"وَهُمْ","translit":"ْmُhَw","root":""},{"id":17,"arabic":"لَا","translit":"āَl","root":""},{"id":18,"arabic":"يَشْعُرُونَ","translit":"َnwُrُʿعْhsَy","root":"شعر"}],"hasIhya":true},{"ayah":96,"text":"وَلَوْ أَنَّ أَهْلَ ٱلْقُرَىٰٓ ءَامَنُوا۟ وَٱتَّقَوْا۟ لَفَتَحْنَا عَلَيْهِم بَرَكَٰتٍ مِّنَ ٱلسَّمَآءِ وَٱلْأَرْضِ وَلَٰكِن كَذَّبُوا۟ فَأَخَذْنَٰهُم بِمَا كَانُوا۟ يَكْسِبُونَ ","translation":"And if only the people of the cities had believed and feared Allāh, We would have opened [i.e., bestowed] upon them blessings from the heaven and the earth; but they denied [the messengers], so We seized them for what they were earning.[1]","words":[{"id":1,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":2,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":3,"arabic":"أَهْلَ","translit":"َlْhَaʾ","root":"اهل"},{"id":4,"arabic":"ٱلْقُرَىٰٓ","translit":"ٰٓàَrُqْlٱ","root":"قري"},{"id":5,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":6,"arabic":"وَٱتَّقَوْا۟","translit":"۟āْwَqَّtٱَw","root":"وقي"},{"id":7,"arabic":"لَفَتَحْنَا","translit":"āَnْḥَtَfَl","root":"فتح"},{"id":8,"arabic":"عَلَيْهِم","translit":"mِhْyَlَʿع","root":""},{"id":9,"arabic":"بَرَكَٰتٍ","translit":"ٍtَٰkَrَb","root":"برك"},{"id":10,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":11,"arabic":"ٱلسَّمَآءِ","translit":"ِءٓāَmَّslٱ","root":"سمو"},{"id":12,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":13,"arabic":"وَلَٰكِن","translit":"nِkَٰlَw","root":""},{"id":14,"arabic":"كَذَّبُوا۟","translit":"۟āwُbَّhdَk","root":"كذب"},{"id":15,"arabic":"فَأَخَذْنَٰهُم","translit":"mُhَٰnْhdَhkَaʾَf","root":"اخذ"},{"id":16,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":17,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":18,"arabic":"يَكْسِبُونَ","translit":"َnwُbِsْkَy","root":"كسب"}],"hasIhya":false},{"ayah":97,"text":"أَفَأَمِنَ أَهْلُ ٱلْقُرَىٰٓ أَن يَأْتِيَهُم بَأْسُنَا بَيَٰتًا وَهُمْ نَآئِمُونَ ","translation":"Then, did the people of the cities feel secure from Our punishment coming to them at night while they were asleep?","words":[{"id":1,"arabic":"أَفَأَمِنَ","translit":"َnِmَaʾَfَaʾ","root":"امن"},{"id":2,"arabic":"أَهْلُ","translit":"ُlْhَaʾ","root":"اهل"},{"id":3,"arabic":"ٱلْقُرَىٰٓ","translit":"ٰٓàَrُqْlٱ","root":"قري"},{"id":4,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":5,"arabic":"يَأْتِيَهُم","translit":"mُhَyِtْaʾَy","root":"اتي"},{"id":6,"arabic":"بَأْسُنَا","translit":"āَnُsْaʾَb","root":"باس"},{"id":7,"arabic":"بَيَٰتًا","translit":"āًtَٰyَb","root":"بيت"},{"id":8,"arabic":"وَهُمْ","translit":"ْmُhَw","root":""},{"id":9,"arabic":"نَآئِمُونَ","translit":"َnwُmِyʾٓāَn","root":"نوم"}],"hasIhya":false},{"ayah":98,"text":"أَوَأَمِنَ أَهْلُ ٱلْقُرَىٰٓ أَن يَأْتِيَهُم بَأْسُنَا ضُحًى وَهُمْ يَلْعَبُونَ ","translation":"Or did the people of the cities feel secure from Our punishment coming to them in the morning while they were at play?[1]","words":[{"id":1,"arabic":"أَوَأَمِنَ","translit":"َnِmَaʾَwَaʾ","root":"امن"},{"id":2,"arabic":"أَهْلُ","translit":"ُlْhَaʾ","root":"اهل"},{"id":3,"arabic":"ٱلْقُرَىٰٓ","translit":"ٰٓàَrُqْlٱ","root":"قري"},{"id":4,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":5,"arabic":"يَأْتِيَهُم","translit":"mُhَyِtْaʾَy","root":"اتي"},{"id":6,"arabic":"بَأْسُنَا","translit":"āَnُsْaʾَb","root":"باس"},{"id":7,"arabic":"ضُحًى","translit":"àًḥُḍ","root":"ضحو"},{"id":8,"arabic":"وَهُمْ","translit":"ْmُhَw","root":""},{"id":9,"arabic":"يَلْعَبُونَ","translit":"َnwُbَʿعْlَy","root":"لعب"}],"hasIhya":false},{"ayah":99,"text":"أَفَأَمِنُوا۟ مَكْرَ ٱللَّهِۚ فَلَا يَأْمَنُ مَكْرَ ٱللَّهِ إِلَّا ٱلْقَوْمُ ٱلْخَٰسِرُونَ ","translation":"Then, did they feel secure from the plan of Allāh? But no one feels secure from the plan of Allāh except the losing people.","words":[{"id":1,"arabic":"أَفَأَمِنُوا۟","translit":"۟āwُnِmَaʾَfَaʾ","root":"امن"},{"id":2,"arabic":"مَكْرَ","translit":"َrْkَm","root":"مكر"},{"id":3,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":4,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":5,"arabic":"يَأْمَنُ","translit":"ُnَmْaʾَy","root":"امن"},{"id":6,"arabic":"مَكْرَ","translit":"َrْkَm","root":"مكر"},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":9,"arabic":"ٱلْقَوْمُ","translit":"ُmْwَqْlٱ","root":"قوم"},{"id":10,"arabic":"ٱلْخَٰسِرُونَ","translit":"َnwُrِsَٰhkْlٱ","root":"خسر"}],"hasIhya":true},{"ayah":100,"text":"أَوَلَمْ يَهْدِ لِلَّذِينَ يَرِثُونَ ٱلْأَرْضَ مِنۢ بَعْدِ أَهْلِهَآ أَن لَّوْ نَشَآءُ أَصَبْنَٰهُم بِذُنُوبِهِمْۚ وَنَطْبَعُ عَلَىٰ قُلُوبِهِمْ فَهُمْ لَا يَسْمَعُونَ ","translation":"Has it not become clear to those who inherited the earth after its [previous] people that if We willed, We could afflict them for their sins? But We seal over their hearts so they do not hear.[1]","words":[{"id":1,"arabic":"أَوَلَمْ","translit":"ْmَlَwَaʾ","root":""},{"id":2,"arabic":"يَهْدِ","translit":"ِdْhَy","root":"هدي"},{"id":3,"arabic":"لِلَّذِينَ","translit":"َnyِhdَّlِl","root":""},{"id":4,"arabic":"يَرِثُونَ","translit":"َnwُhtِrَy","root":"ورث"},{"id":5,"arabic":"ٱلْأَرْضَ","translit":"َḍْrَaʾْlٱ","root":"ارض"},{"id":6,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":7,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":8,"arabic":"أَهْلِهَآ","translit":"ٓāَhِlْhَaʾ","root":"اهل"},{"id":9,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":10,"arabic":"لَّوْ","translit":"ْwَّl","root":""},{"id":11,"arabic":"نَشَآءُ","translit":"ُءٓāَhsَn","root":"شيا"},{"id":12,"arabic":"أَصَبْنَٰهُم","translit":"mُhَٰnْbَṣَaʾ","root":"صوب"},{"id":13,"arabic":"بِذُنُوبِهِمْ","translit":"ْmِhِbwُnُhdِb","root":"ذنب"},{"id":14,"arabic":"وَنَطْبَعُ","translit":"ُʿعَbْṭَnَw","root":"طبع"},{"id":15,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":16,"arabic":"قُلُوبِهِمْ","translit":"ْmِhِbwُlُq","root":"قلب"},{"id":17,"arabic":"فَهُمْ","translit":"ْmُhَf","root":""},{"id":18,"arabic":"لَا","translit":"āَl","root":""},{"id":19,"arabic":"يَسْمَعُونَ","translit":"َnwُʿعَmْsَy","root":"سمع"}],"hasIhya":true},{"ayah":101,"text":"تِلْكَ ٱلْقُرَىٰ نَقُصُّ عَلَيْكَ مِنْ أَنۢبَآئِهَاۚ وَلَقَدْ جَآءَتْهُمْ رُسُلُهُم بِٱلْبَيِّنَٰتِ فَمَا كَانُوا۟ لِيُؤْمِنُوا۟ بِمَا كَذَّبُوا۟ مِن قَبْلُۚ كَذَٰلِكَ يَطْبَعُ ٱللَّهُ عَلَىٰ قُلُوبِ ٱلْكَٰفِرِينَ ","translation":"Those cities - We relate to you, [O Muḥammad], some of their news. And certainly did their messengers come to them with clear proofs, but they were not to believe in that which they had denied before.[1] Thus does Allāh seal over the hearts of the disbelievers.","words":[{"id":1,"arabic":"تِلْكَ","translit":"َkْlِt","root":""},{"id":2,"arabic":"ٱلْقُرَىٰ","translit":"ٰàَrُqْlٱ","root":"قري"},{"id":3,"arabic":"نَقُصُّ","translit":"ُّṣُqَn","root":"قصص"},{"id":4,"arabic":"عَلَيْكَ","translit":"َkْyَlَʿع","root":""},{"id":5,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":6,"arabic":"أَنۢبَآئِهَا","translit":"āَhِyʾٓāَbۢnَaʾ","root":"نبا"},{"id":7,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":8,"arabic":"جَآءَتْهُمْ","translit":"ْmُhْtَءٓāَjg","root":"جيا"},{"id":9,"arabic":"رُسُلُهُم","translit":"mُhُlُsُr","root":"رسل"},{"id":10,"arabic":"بِٱلْبَيِّنَٰتِ","translit":"ِtَٰnِّyَbْlٱِb","root":"بين"},{"id":11,"arabic":"فَمَا","translit":"āَmَf","root":""},{"id":12,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":13,"arabic":"لِيُؤْمِنُوا۟","translit":"۟āwُnِmْwʾُyِl","root":"امن"},{"id":14,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":15,"arabic":"كَذَّبُوا۟","translit":"۟āwُbَّhdَk","root":"كذب"},{"id":16,"arabic":"مِن","translit":"nِm","root":""},{"id":17,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":18,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":19,"arabic":"يَطْبَعُ","translit":"ُʿعَbْṭَy","root":"طبع"},{"id":20,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":21,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":22,"arabic":"قُلُوبِ","translit":"ِbwُlُq","root":"قلب"},{"id":23,"arabic":"ٱلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlٱ","root":"كفر"}],"hasIhya":false},{"ayah":102,"text":"وَمَا وَجَدْنَا لِأَكْثَرِهِم مِّنْ عَهْدٍۖ وَإِن وَجَدْنَآ أَكْثَرَهُمْ لَفَٰسِقِينَ ","translation":"And We did not find for most of them any covenant;[1] but indeed, We found most of them defiantly disobedient.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"وَجَدْنَا","translit":"āَnْdَjgَw","root":"وجد"},{"id":3,"arabic":"لِأَكْثَرِهِم","translit":"mِhِrَhtْkَaʾِl","root":"كثر"},{"id":4,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":5,"arabic":"عَهْدٍ","translit":"ٍdْhَʿع","root":"عهد"},{"id":6,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":7,"arabic":"وَجَدْنَآ","translit":"ٓāَnْdَjgَw","root":"وجد"},{"id":8,"arabic":"أَكْثَرَهُمْ","translit":"ْmُhَrَhtْkَaʾ","root":"كثر"},{"id":9,"arabic":"لَفَٰسِقِينَ","translit":"َnyِqِsَٰfَl","root":"فسق"}],"hasIhya":false},{"ayah":103,"text":"ثُمَّ بَعَثْنَا مِنۢ بَعْدِهِم مُّوسَىٰ بِـَٔايَٰتِنَآ إِلَىٰ فِرْعَوْنَ وَمَلَإِي۟هِۦ فَظَلَمُوا۟ بِهَاۖ فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُفْسِدِينَ ","translation":"Then We sent after them Moses with Our signs to Pharaoh and his establishment, but they were unjust toward them.[1] So see how was the end of the corrupters.","words":[{"id":1,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":2,"arabic":"بَعَثْنَا","translit":"āَnْhtَʿعَb","root":"بعث"},{"id":3,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":4,"arabic":"بَعْدِهِم","translit":"mِhِdْʿعَb","root":"بعد"},{"id":5,"arabic":"مُّوسَىٰ","translit":"ٰàَswُّm","root":""},{"id":6,"arabic":"بِـَٔايَٰتِنَآ","translit":"ٓāَnِtَٰyāَٔـِb","root":"ايي"},{"id":7,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":8,"arabic":"فِرْعَوْنَ","translit":"َnْwَʿعْrِf","root":""},{"id":9,"arabic":"وَمَلَإِي۟هِۦ","translit":"ۦِh۟yِiʾَlَmَw","root":"ملا"},{"id":10,"arabic":"فَظَلَمُوا۟","translit":"۟āwُmَlَẓَf","root":"ظلم"},{"id":11,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":12,"arabic":"فَٱنظُرْ","translit":"ْrُẓnٱَf","root":"نظر"},{"id":13,"arabic":"كَيْفَ","translit":"َfْyَk","root":"كيف"},{"id":14,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":15,"arabic":"عَٰقِبَةُ","translit":"ُẗَbِqَٰʿع","root":"عقب"},{"id":16,"arabic":"ٱلْمُفْسِدِينَ","translit":"َnyِdِsْfُmْlٱ","root":"فسد"}],"hasIhya":false},{"ayah":104,"text":"وَقَالَ مُوسَىٰ يَٰفِرْعَوْنُ إِنِّى رَسُولٌ مِّن رَّبِّ ٱلْعَٰلَمِينَ ","translation":"And Moses said, \"O Pharaoh, I am a messenger from the Lord of the worlds","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"مُوسَىٰ","translit":"ٰàَswُm","root":""},{"id":3,"arabic":"يَٰفِرْعَوْنُ","translit":"ُnْwَʿعْrِfَٰy","root":""},{"id":4,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":5,"arabic":"رَسُولٌ","translit":"ٌlwُsَr","root":"رسل"},{"id":6,"arabic":"مِّن","translit":"nِّm","root":""},{"id":7,"arabic":"رَّبِّ","translit":"ِّbَّr","root":"ربب"},{"id":8,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":true},{"ayah":105,"text":"حَقِيقٌ عَلَىٰٓ أَن لَّآ أَقُولَ عَلَى ٱللَّهِ إِلَّا ٱلْحَقَّۚ قَدْ جِئْتُكُم بِبَيِّنَةٍ مِّن رَّبِّكُمْ فَأَرْسِلْ مَعِىَ بَنِىٓ إِسْرَٰٓءِيلَ ","translation":"[Who is] obligated not to say about Allāh except the truth. I have come to you with clear evidence from your Lord, so send with me the Children of Israel.\"[1]","words":[{"id":1,"arabic":"حَقِيقٌ","translit":"ٌqyِqَḥ","root":"حقق"},{"id":2,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":3,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":4,"arabic":"لَّآ","translit":"ٓāَّl","root":""},{"id":5,"arabic":"أَقُولَ","translit":"َlwُqَaʾ","root":"قول"},{"id":6,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":9,"arabic":"ٱلْحَقَّ","translit":"َّqَḥْlٱ","root":"حقق"},{"id":10,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":11,"arabic":"جِئْتُكُم","translit":"mُkُtْyʾِjg","root":"جيا"},{"id":12,"arabic":"بِبَيِّنَةٍ","translit":"ٍẗَnِّyَbِb","root":"بين"},{"id":13,"arabic":"مِّن","translit":"nِّm","root":""},{"id":14,"arabic":"رَّبِّكُمْ","translit":"ْmُkِّbَّr","root":"ربب"},{"id":15,"arabic":"فَأَرْسِلْ","translit":"ْlِsْrَaʾَf","root":"رسل"},{"id":16,"arabic":"مَعِىَ","translit":"َàِʿعَm","root":""},{"id":17,"arabic":"بَنِىٓ","translit":"ٓàِnَb","root":"بني"},{"id":18,"arabic":"إِسْرَٰٓءِيلَ","translit":"َlyِءَٰٓrْsِiʾ","root":""}],"hasIhya":false},{"ayah":106,"text":"قَالَ إِن كُنتَ جِئْتَ بِـَٔايَةٍ فَأْتِ بِهَآ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ ","translation":"[Pharaoh] said, \"If you have come with a sign, then bring it forth, if you should be of the truthful.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":3,"arabic":"كُنتَ","translit":"َtnُk","root":"كون"},{"id":4,"arabic":"جِئْتَ","translit":"َtْyʾِjg","root":"جيا"},{"id":5,"arabic":"بِـَٔايَةٍ","translit":"ٍẗَyāَٔـِb","root":"ايي"},{"id":6,"arabic":"فَأْتِ","translit":"ِtْaʾَf","root":"اتي"},{"id":7,"arabic":"بِهَآ","translit":"ٓāَhِb","root":""},{"id":8,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":9,"arabic":"كُنتَ","translit":"َtnُk","root":"كون"},{"id":10,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":11,"arabic":"ٱلصَّٰدِقِينَ","translit":"َnyِqِdَّٰṣlٱ","root":"صدق"}],"hasIhya":false},{"ayah":107,"text":"فَأَلْقَىٰ عَصَاهُ فَإِذَا هِىَ ثُعْبَانٌ مُّبِينٌ ","translation":"So he [i.e., Moses] threw his staff, and suddenly it was a serpent, manifest.[1]","words":[{"id":1,"arabic":"فَأَلْقَىٰ","translit":"ٰàَqْlَaʾَf","root":"لقي"},{"id":2,"arabic":"عَصَاهُ","translit":"ُhāَṣَʿع","root":"عصو"},{"id":3,"arabic":"فَإِذَا","translit":"āَ