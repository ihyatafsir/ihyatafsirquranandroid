},{"id":2,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":3,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":4,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":5,"arabic":"لَا","translit":"āَl","root":""},{"id":6,"arabic":"نُكَلِّفُ","translit":"ُfِّlَkُn","root":"كلف"},{"id":7,"arabic":"نَفْسًا","translit":"āًsْfَn","root":"نفس"},{"id":8,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":9,"arabic":"وُسْعَهَآ","translit":"ٓāَhَʿعْsُw","root":"وسع"},{"id":10,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":11,"arabic":"أَصْحَٰبُ","translit":"ُbَٰḥْṣَaʾ","root":"صحب"},{"id":12,"arabic":"ٱلْجَنَّةِ","translit":"ِẗَّnَjgْlٱ","root":"جنن"},{"id":13,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":14,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":15,"arabic":"خَٰلِدُونَ","translit":"َnwُdِlَٰhk","root":"خلد"}],"hasIhya":true},{"ayah":43,"text":"وَنَزَعْنَا مَا فِى صُدُورِهِم مِّنْ غِلٍّ تَجْرِى مِن تَحْتِهِمُ ٱلْأَنْهَٰرُۖ وَقَالُوا۟ ٱلْحَمْدُ لِلَّهِ ٱلَّذِى هَدَىٰنَا لِهَٰذَا وَمَا كُنَّا لِنَهْتَدِىَ لَوْلَآ أَنْ هَدَىٰنَا ٱللَّهُۖ لَقَدْ جَآءَتْ رُسُلُ رَبِّنَا بِٱلْحَقِّۖ وَنُودُوٓا۟ أَن تِلْكُمُ ٱلْجَنَّةُ أُورِثْتُمُوهَا بِمَا كُنتُمْ تَعْمَلُونَ ","translation":"And We will have removed whatever is within their breasts of resentment,[1] [while] flowing beneath them are rivers. And they will say, \"Praise to Allāh, who has guided us to this; and we would never have been guided if Allāh had not guided us. Certainly the messengers of our Lord had come with the truth.\" And they will be called, \"This is Paradise, which you have been made to inherit for what you used to do.\"","words":[{"id":1,"arabic":"وَنَزَعْنَا","translit":"āَnْʿعَzَnَw","root":"نزع"},{"id":2,"arabic":"مَا","translit":"āَm","root":""},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"صُدُورِهِم","translit":"mِhِrwُdُṣ","root":"صدر"},{"id":5,"arabic":"مِّنْ","translit":"ْnِّm","roo