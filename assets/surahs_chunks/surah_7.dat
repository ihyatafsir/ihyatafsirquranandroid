ot": ""}, {"id": 2, "arabic": "ٱتَّخَذُوا۟", "translit": "۟āwُhdَhkَّtٱ", "root": "اخذ"}, {"id": 3, "arabic": "دِينَهُمْ", "translit": "ْmُhَnyِd", "root": "دين"}, {"id": 4, "arabic": "لَهْوًا", "translit": "āًwْhَl", "root": "لهو"}, {"id": 5, "arabic": "وَلَعِبًا", "translit": "āًbِʿعَlَw", "root": "لعب"}, {"id": 6, "arabic": "وَغَرَّتْهُمُ", "translit": "ُmُhْtَّrَغَw", "root": "غرر"}, {"id": 7, "arabic": "ٱلْحَيَوٰةُ", "translit": "ُẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 8, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 9, "arabic": "فَٱلْيَوْمَ", "translit": "َmْwَyْlٱَf", "root": "يوم"}, {"id": 10, "arabic": "نَنسَىٰهُمْ", "translit": "ْmُhٰàَsnَn", "root": "نسي"}, {"id": 11, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 12, "arabic": "نَسُوا۟", "translit": "۟āwُsَn", "root": "نسي"}, {"id": 13, "arabic": "لِقَآءَ", "translit": "َءٓāَqِl", "root": "لقي"}, {"id": 14, "arabic": "يَوْمِهِمْ", "translit": "ْmِhِmْwَy", "root": "يوم"}, {"id": 15, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 16, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 17, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 18, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 19, "arabic": "يَجْحَدُونَ", "translit": "َnwُdَḥْjgَy", "root": "جحد"}], "hasIhya": false}, {"ayah": 52, "text": "وَلَقَدْ جِئْنَٰهُم بِكِتَٰبٍ فَصَّلْنَٰهُ عَلَىٰ عِلْمٍ هُدًى وَرَحْمَةً لِّقَوْمٍ يُؤْمِنُونَ ", "translation": "And We had certainly brought them a Book which We detailed by knowledge - as guidance and mercy to a people who believe.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "جِئْنَٰهُم", "translit": "mُhَٰnْyʾِjg", "root": "جيا"}, {"id": 3, "arabic": "بِكِتَٰبٍ", "translit": "ٍbَٰtِkِb", "root": "كتب"}, {"id": 4, "arabic": "فَصَّلْنَٰهُ", "translit": "ُhَٰnْlَّṣَf", "root": "فصل"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "عِلْمٍ", "translit": "ٍmْlِʿع", "root": "علم"}, {"id": 7, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 8, "arabic": "وَرَحْمَةً", "translit": "ًẗَmْḥَrَw", "root": "رحم"}, {"id": 9, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 10, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": true}, {"ayah": 53, "text": "هَلْ يَنظُرُونَ إِلَّا تَأْوِيلَهُۥۚ يَوْمَ يَأْتِى تَأْوِيلُهُۥ يَقُولُ ٱلَّذِينَ نَسُوهُ مِن قَبْلُ قَدْ جَآءَتْ رُسُلُ رَبِّنَا بِٱلْحَقِّ فَهَل لَّنَا مِن شُفَعَآءَ فَيَشْفَعُوا۟ لَنَآ أَوْ نُرَدُّ فَنَعْمَلَ غَيْرَ ٱلَّذِى كُنَّا نَعْمَلُۚ قَدْ خَسِرُوٓا۟ أَنفُسَهُمْ وَضَلَّ عَنْهُم مَّا كَانُوا۟ يَفْتَرُونَ ", "translation": "Do they await except its result?[1] The Day its result comes, those who had ignored it before will say, \"The messengers of our Lord had come with the truth, so are there [now] any intercessors to intercede for us or could we be sent back to do other than what we used to do?\" They will have lost themselves, and lost from them is what they used to invent.", "words": [{"id": 1, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 2, "arabic": "يَنظُرُونَ", "translit": "َnwُrُẓnَy", "root": "نظر"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "تَأْوِيلَهُۥ", "translit": "ۥُhَlyِwْaʾَt", "root": "اول"}, {"id": 5, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 6, "arabic": "يَأْتِى", "translit": "àِtْaʾَy", "root": "اتي"}, {"id": 7, "arabic": "تَأْوِيلُهُۥ", "translit": "ۥُhُlyِwْaʾَt", "root": "اول"}, {"id": 8, "arabic": "يَقُولُ", "translit": "ُlwُqَy", "root": "قول"}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "نَسُوهُ", "translit": "ُhwُsَn", "root": "نسي"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 13, "arabic": "قَدْ",