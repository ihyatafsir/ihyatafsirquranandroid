ah": 7, "ayah": 105, "text": "حَقِيقٌۖ عَلَيَّ أَن لَّآ أَقُولَ عَلَي اَ۬للَّهِ إِلَّا اَ۬لْحَقَّۖ قَدْ جِئْتُكُم بِبَيِّنَةࣲ مِّن رَّبِّكُمْۖ فَأَرْسِلْ مَعِے بَنِےٓ إِسْرَآءِيلَۖ", "words": [{"id": 1, "arabic": "حَقِيقٌۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَن", "translit": "", "root": ""}, {"id": 4, "arabic": "لَّآ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَقُولَ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لْحَقَّۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "قَدْ", "translit": "", "root": ""}, {"id": 11, "arabic": "جِئْتُكُم", "translit": "", "root": ""}, {"id": 12, "arabic": "بِبَيِّنَةࣲ", "translit": "", "root": ""}, {"id": 13, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 14, "arabic": "رَّبِّكُمْۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "فَأَرْسِلْ", "translit": "", "root": ""}, {"id": 16, "arabic": "مَعِے", "translit": "", "root": ""}, {"id": 17, "arabic": "بَنِےٓ", "translit": "", "root": ""}, {"id": 18, "arabic": "إِسْرَآءِيلَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 106, "text": "قَالَ إِن كُنتَ جِئْتَ بِـَٔايَةࣲ فَاتِ بِهَآ إِن كُنتَ مِنَ اَ۬لصَّٰدِقِينَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِن", "translit": "", "root": ""}, {"id": 3, "arabic": "كُنتَ", "translit": "", "root": ""}, {"id": 4, "arabic": "جِئْتَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِـَٔايَةࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَاتِ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهَآ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِن", "translit": "", "root": ""}, {"id": 9, "arabic": "كُنتَ", "translit": "", "root": ""}, {"id": 10, "ar