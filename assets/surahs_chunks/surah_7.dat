 "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 26, "arabic": "هُمُۥٓ", "translit": "", "root": ""}, {"id": 27, "arabic": "أَضَلُّۖ", "translit": "", "root": ""}, {"id": 28, "arabic": "أُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 29, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 30, "arabic": "اُ۬لْغَٰفِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 180, "text": "وَلِلهِ اِ۬لَاسْمَآءُ اُ۬لْحُسْن۪يٰ فَادْعُوهُ بِهَاۖ وَذَرُواْ اُ۬لذِينَ يُلْحِدُونَ فِےٓ أَسْمَٰٓئِهِۦۖ سَيُجْزَوْنَ مَا كَانُواْ يَعْمَلُونَۖ", "words": [{"id": 1, "arabic": "وَلِلهِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لَاسْمَآءُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْحُسْن۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَادْعُوهُ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِهَاۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَذَرُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 8, "arabic": "يُلْحِدُونَ", "translit": "", "root": ""}, {"id": 9, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَسْمَٰٓئِهِۦۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "سَيُجْزَوْنَ", "translit": "", "root": ""}, {"id": 12, "arabic": "مَا", "translit": "", "root": ""}, {"id": 13, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 14, "arabic": "يَعْمَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 181, "text": "وَمِمَّنْ خَلَقْنَآ أُمَّةࣱ يَهْدُونَ بِالْحَقِّ وَبِهِۦ يَعْدِلُونَۖ", "words": [{"id": 1, "arabic": "وَمِمَّنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُمَّةࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَهْدُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِالْحَقِّ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَبِهِۦ", "translit": "", "root": ""}, {"id": 7, "arabic":