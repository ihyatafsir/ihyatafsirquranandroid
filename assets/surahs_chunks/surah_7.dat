""}], "narration": "warsh"}, {"surah": 7, "ayah": 2, "text": "كِتَٰبٌ اُنزِلَ إِلَيْكَ فَلَا يَكُن فِے صَدْرِكَ حَرَجࣱ مِّنْهُ لِتُنذِرَ بِهِۦ وَذِكْر۪يٰ لِلْمُومِنِينَۖ", "words": [{"id": 1, "arabic": "كِتَٰبٌ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُنزِلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيْكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يَكُن", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "صَدْرِكَ", "translit": "", "root": ""}, {"id": 8, "arabic": "حَرَجࣱ", "translit": "", "root": ""}, {"id": 9, "arabic": "مِّنْهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "لِتُنذِرَ", "translit": "", "root": ""}, {"id": 11, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَذِكْر۪يٰ", "translit": "", "root": ""}, {"id": 13, "arabic": "لِلْمُومِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 3, "text": "اَ۪تَّبِعُواْ مَآ أُنزِلَ إِلَيْكُم مِّن رَّبِّكُمْۖ وَلَا تَتَّبِعُواْ مِن دُونِهِۦٓ أَوْلِيَآءَۖ قَلِيلاࣰ مَّا تَذَّكَّرُونَۖ", "words": [{"id": 1, "arabic": "اَ۪تَّبِعُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُنزِلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَيْكُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 6, "arabic": "رَّبِّكُمْۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 8, "arabic": "تَتَّبِعُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "مِن", "translit": "", "root": ""}, {"id": 10, "arabic": "دُونِهِۦٓ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَوْلِيَآءَۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "قَلِيلاࣰ", "translit": "", "root": ""}, {"id": 13, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 14, "arabic": "تَذَّكَّرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 4, "text": "وَكَم مِّن قَرْيَةٍ اَهْلَكْنَٰهَا فَجَآءَهَا بَأْسُنَا بَيَٰتاً اَوْ هُمْ قَآئِلُونَۖ", "words": [{"id": 1, "arabic": "وَكَم", "translit": "", "root": ""}, {"id": 2, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 3, "arabic": "قَرْيَةٍ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَهْلَكْنَٰهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "فَجَآءَهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "بَأْسُنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "بَيَٰتاً", "translit": "", "root": ""}, {"id": 8, "arabic": "اَوْ", "translit": "", "root": ""}, {"id": 9, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "قَآئِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 5, "text": "۞فَمَا كَانَ دَعْو۪يٰهُمُۥٓ إِذْ جَآءَهُم بَأْسُنَآ إِلَّآ أَن قَالُوٓاْ إِنَّا كُنَّا ظَٰلِمِينَۖ", "words": [{"id": 1, "arabic": "۞فَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 3, "arabic": "دَعْو۪يٰهُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 5, "arabic": "جَآءَهُم", "translit": "", "root": ""}, {"id": 6, "arabic": "بَأْسُنَآ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَن", "translit": "", "root": ""}, {"id": 9, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 10, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 11, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 12, "arabic": "ظَٰلِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 6, "text": "فَلَنَسْـَٔلَنَّ اَ۬لذِينَ أُرْسِلَ إِلَيْهِمْ وَلَنَسْـَٔلَنَّ اَ۬لْمُرْسَلِينَۖ", "words": [{"id": 1, "arabic": "فَلَنَسْـَٔلَنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُرْسِلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَيْهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَلَنَسْـَٔلَنَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْمُرْسَلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 7, "text": "فَلَنَقُصَّنَّ عَلَيْهِم بِعِلْمࣲۖ وَمَا كُنَّا غَآئِبِينَۖ", "words": [{"id": 1, "arabic": "فَلَنَقُصَّنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِم", "translit": "", "root": ""}, {"id": 3, "arabic": "بِعِلْمࣲۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "غَآئِبِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 8, "text": "وَالْوَزْنُ يَوْمَئِذٍ اِ۬لْحَقُّۖ فَمَن ثَقُلَتْ مَوَٰزِينُهُۥ فَأُوْلَٰٓئِكَ هُمُ اُ۬لْمُفْلِحُونَۖ", "words": [{"id": 1, "arabic": "وَالْوَزْنُ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَوْمَئِذٍ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لْحَقُّۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَمَن", "translit": "", "root": ""}, {"id": 5, "arabic": "ثَقُلَتْ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَوَٰزِينُهُۥ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَأُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 8, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬لْمُفْلِحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 9, "text": "وَمَنْ خَفَّتْ مَوَٰزِينُهُۥ فَأُوْلَٰٓئِكَ اَ۬لذِينَ خَسِرُوٓاْ أَنفُسَهُم بِمَا كَانُواْ بِـَٔايَٰتِنَا يَظْلِمُونَۖ", "words": [{"id": 1, "arabic": "وَمَنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَفَّتْ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَوَٰزِينُهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَأُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 6, "arabic": "خَسِرُوٓاْ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَنفُسَهُم", "translit": "", "root": ""}, {"id": 8, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 9, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "بِـَٔايَٰتِنَا", "translit": "", "root": ""}, {"id": 11, "arabic": "يَظْلِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 10, "text": "وَلَقَدْ مَكَّنَّٰكُمْ فِے اِ۬لَارْضِ وَجَعَلْنَا لَكُمْ فِيهَا مَعَٰيِشَۖ قَلِيلاࣰ مَّا تَشْكُرُونَۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَكَّنَّٰكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَجَعَلْنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "مَعَٰيِشَۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "قَلِيلاࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 11, "arabic": "تَشْكُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 11, "text": "وَلَقَدْ خَلَقْنَٰكُمْ ثُمَّ صَوَّرْنَٰكُمْ ثُمَّ قُلْنَا لِلْمَلَٰٓئِكَةِ اِ۟سْجُدُواْ لِأٓدَمَ فَسَجَدُوٓاْۖ إِلَّآ إِبْلِيسَ لَمْ يَكُن مِّنَ اَ۬لسَّٰجِدِينَۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْنَٰكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "صَوَّرْنَٰكُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "قُلْنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "لِلْمَلَٰٓئِكَةِ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۟سْجُدُواْ", "translit": "", "root": ""}, 