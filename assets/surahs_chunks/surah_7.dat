ses and are arrogant toward them - those are the companions of the Fire; they will abide therein eternally.","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"كَذَّبُوا۟","translit":"۟āwُbَّhdَk","root":"كذب"},{"id":3,"arabic":"بِـَٔايَٰتِنَا","translit":"āَnِtَٰyāَٔـِb","root":"ايي"},{"id":4,"arabic":"وَٱسْتَكْبَرُوا۟","translit":"۟āwُrَbْkَtْsٱَw","root":"كبر"},{"id":5,"arabic":"عَنْهَآ","translit":"ٓāَhْnَʿع","root":""},{"id":6,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":7,"arabic":"أَصْحَٰبُ","translit":"ُbَٰḥْṣَaʾ","root":"صحب"},{"id":8,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"},{"id":9,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":10,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":11,"arabic":"خَٰلِدُونَ","translit":"َnwُdِlَٰhk","root":"خلد"}],"hasIhya":false},{"ayah":37,"text":"فَمَنْ أَظْلَمُ مِمَّنِ ٱفْتَرَىٰ عَلَى ٱللَّهِ كَذِبًا أَوْ كَذَّبَ بِـَٔايَٰتِهِۦٓۚ أُو۟لَٰٓئِكَ يَنَالُهُمْ نَصِيبُهُم مِّنَ ٱلْكِتَٰبِۖ حَتَّىٰٓ إِذَا جَآءَتْهُمْ رُسُلُنَا يَتَوَفَّوْنَهُمْ قَالُوٓا۟ أَيْنَ مَا كُنتُمْ تَدْعُونَ مِن دُونِ ٱللَّهِۖ قَالُوا۟ ضَلُّوا۟ عَنَّا وَشَهِدُوا۟ عَلَىٰٓ أَنفُسِهِمْ أَنَّهُمْ كَانُوا۟ كَٰفِرِينَ ","translation":"And who is more unjust than one who invents about Allāh a lie or denies His verses? Those will attain their portion of the decree[1] until, when Our messengers [i.e., angels] come to them to take them in death, they will say, \"Where are those you used to invoke besides Allāh?\" They will say, \"They have departed from us,\" and will bear witness against themselves that they were disbelievers.","words":[{"id":1,"arabic":"فَمَنْ","translit":"ْnَmَf","root":""},{"id":2,"arabic":"أَظْلَمُ","translit":"ُmَlْẓَaʾ","root":"ظلم"},{"id":3,"arabic":"مِمَّنِ","translit":"ِnَّmِm","root":""},{"id":4,"arabic":"ٱفْتَرَىٰ","translit":"ٰàَrَtْfٱ","root":"فري"},{"id":5,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"كَذِبًا","translit":"āًbِhdَk","root":"كذب"},{"id":8,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":9,"arabic":"كَذَّبَ","translit":"َbَّhdَk","root":"كذب"},{"id":10,"arabic":"بِـَٔايَٰتِهِۦٓ","translit":"ٓۦِhِtَٰyāَٔـِb","root":"ايي"},{"id":11,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":12,"arabic":"يَنَالُهُمْ","translit":"ْmُhُlāَnَy","root":"نيل"},{"id":13,"arabic":"نَصِيبُهُم","translit":"mُhُbyِṣَn","root":"نصب"},{"id":14,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":15,"arabic":"ٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱ","root":"كتب"},{"id":16,"arabic":"حَتَّىٰٓ","translit":"ٰٓàَّtَḥ","root":""},{"id":17,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":18,"arabic":"جَآءَتْهُمْ","translit":"ْmُhْtَءٓāَjg","root":"جيا"},{"id":19,"arabic":"رُسُلُنَا","translit":"āَnُlُsُr","root":"رسل"},{"id":20,"arabic":"يَتَوَفَّوْنَهُمْ","translit":"ْmُhَnْwَّfَwَtَy","root":"وفي"},{"id":21,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":22,"arabic":"أَيْنَ","translit":"َnْyَaʾ","root":""},{"id":23,"arabic":"مَا","translit":"āَm","root":""},{"id":24,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":25,"arabic":"تَدْعُونَ","translit":"َnwُʿعْdَt","root":"دعو"},{"id":26,"arabic":"مِن","translit":"nِm","root":""},{"id":27,"arabic":"دُونِ","translit":"ِnwُd","root":"دون"},{"id":28,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":29,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":30,"arabic":"ضَلُّوا۟","translit":"۟āwُّlَḍ","root":"ضلل"},{"id":31,"arabic":"عَنَّا","translit":"āَّnَʿع","root":""},{"id":32,"arabic":"وَشَهِدُوا۟","translit":"۟āwُdِhَhsَw","root":"شهد"},{"id":33,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":34,"arabic":"أَنفُسِهِمْ","translit":"ْmِhِsُfnَaʾ","root":"نفس"},{"id":35,"arabic":"أَنَّهُمْ","translit":"ْmُhَّnَaʾ","root":""},{"id":36,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":37,"arabic":"كَٰفِرِينَ","translit":"َnyِrِfَٰk","root":"كفر"}],"hasIhya":true},{"ayah":38,"text":"قَالَ ٱدْخُلُوا۟ فِىٓ أُمَمٍ قَدْ خَلَتْ مِن قَبْلِكُم مِّنَ ٱلْجِنِّ وَٱلْإِنسِ فِى ٱلنَّارِۖ كُلَّمَا دَخَلَتْ أُمَّةٌ لَّعَنَتْ أُخْتَهَاۖ حَتَّىٰٓ إِذَا ٱدَّارَكُوا۟ فِيهَا جَمِيعًا قَالَتْ أُخْرَىٰهُمْ لِأُولَىٰهُمْ رَبَّنَا هَٰٓؤُلَآءِ أَضَلُّونَا فَـَٔاتِهِمْ عَذَابًا ضِعْفًا مِّنَ ٱلنَّارِۖ قَالَ لِكُلٍّ ضِعْفٌ وَلَٰكِن لَّا تَعْلَمُونَ ","translation":"[Allāh] will say, \"Enter among nations which had passed on before you of jinn and mankind into the Fire.\" Every time a nation enters, it will curse its sister[1] until, when they have all overtaken one another therein, the last of them[2] will say about the first of them,[3] \"Our Lord, these had misled us, so give them a double punishment of the Fire.\" He will say, \"For each is double, but you do not know.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"ٱدْخُلُوا۟","translit":"۟āwُlُhkْdٱ","root":"دخل"},{"id":3,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":4,"arabic":"أُمَمٍ","translit":"ٍmَmُaʾ","root":"امم"},{"id":5,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":6,"arabic":"خَلَتْ","translit":"ْtَlَhk","root":"خلو"},{"id":7,"arabic":"مِن","translit":"nِm","root":""},{"id":8,"arabic":"قَبْلِكُم","translit":"mُkِlْbَq","root":"قبل"},{"id":9,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":10,"arabic":"ٱلْجِنِّ","translit":"ِّnِjgْlٱ","root":"جنن"},{"id":11,"arabic":"وَٱلْإِنسِ","translit":"ِsnِiʾْlٱَw","root":"انس"},{"id":12,"arabic":"فِى","translit":"àِf","root":""},{"id":13,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"},{"id":14,"arabic":"كُلَّمَا","translit":"āَmَّlُk","root":"كلل"},{"id":15,"arabic":"دَخَلَتْ","translit":"ْtَlَhkَd","root":"دخل"},{"id":16,"arabic":"أُمَّةٌ","translit":"ٌẗَّmُaʾ","root":"امم"},{"id":17,"arabic":"لَّعَنَتْ","translit":"ْtَnَʿعَّl","root":"لعن"},{"id":18,"arabic":"أُخْتَهَا","translit":"āَhَtْhkُaʾ","root":"اخو"},{"id":19,"arabic":"حَ