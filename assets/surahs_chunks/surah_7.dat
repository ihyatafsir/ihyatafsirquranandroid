bic": "لَا", "translit": "", "root": ""}, {"id": 12, "arabic": "يُبْصِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 199, "text": "خُذِ اِ۬لْعَفْوَۖ وَامُرْ بِالْعُرْفِۖ وَأَعْرِضْ عَنِ اِ۬لْجَٰهِلِينَۖ", "words": [{"id": 1, "arabic": "خُذِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لْعَفْوَۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَامُرْ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِالْعُرْفِۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَأَعْرِضْ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَنِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْجَٰهِلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 200, "text": "۞وَإِمَّا يَنزَغَنَّكَ مِنَ اَ۬لشَّيْطَٰنِ نَزْغࣱ فَاسْتَعِذْ بِاللَّهِۖ إِنَّهُۥ سَمِيعٌ عَلِيمٌۖ", "words": [{"id": 1, "arabic": "۞وَإِمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَنزَغَنَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لشَّيْطَٰنِ", "translit": "", "root": ""}, {"id": 5, "arabic": "نَزْغࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَاسْتَعِذْ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِاللَّهِۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 9, "arabic": "سَمِيعٌ", "translit": "", "root": ""}, {"id": 10, "arabic": "عَلِيمٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 201, "text": "اِنَّ اَ۬لذِينَ اَ۪تَّقَوِاْ اِذَا مَسَّهُمْ طَٰٓئِفࣱ مِّنَ اَ۬لشَّيْطَٰنِ تَذَكَّرُواْ فَإِذَا هُم مُّبْصِرُونَۖ", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۪تَّقَوِاْ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِذَا", "translit": "", "root": ""}, {"id": 5, "arabic": "مَسَّهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "طَٰٓ