nslit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":false},{"ayah":140,"text":"قَالَ أَغَيْرَ ٱللَّهِ أَبْغِيكُمْ إِلَٰهًا وَهُوَ فَضَّلَكُمْ عَلَى ٱلْعَٰلَمِينَ ","translation":"He said, \"Is it other than Allāh I should desire for you as a god[1] while He has preferred you over the worlds?\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"أَغَيْرَ","translit":"َrْyَغَaʾ","root":"غير"},{"id":3,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":4,"arabic":"أَبْغِيكُمْ","translit":"ْmُkyِغْbَaʾ","root":"بغي"},{"id":5,"arabic":"إِلَٰهًا","translit":"āًhَٰlِiʾ","root":"اله"},{"id":6,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":7,"arabic":"فَضَّلَكُمْ","translit":"ْmُkَlَّḍَf","root":"فضل"},{"id":8,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":9,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":141,"text":"وَإِذْ أَنجَيْنَٰكُم مِّنْ ءَالِ فِرْعَوْنَ يَسُومُونَكُمْ سُوٓءَ ٱلْعَذَابِۖ يُقَتِّلُونَ أَبْنَآءَكُمْ وَيَسْتَحْيُونَ نِسَآءَكُمْۚ وَفِى ذَٰلِكُم بَلَآءٌ مِّن رَّبِّكُمْ عَظِيمٌ ","translation":"And [recall, O Children of Israel], when We saved you from the people of Pharaoh, [who were] afflicting you with the worst torment - killing your sons and keeping your women alive. And in that was a great trial from your Lord.","words":[{"id":1,"arabic":"وَإِذْ","translit":"ْhdِiʾَw","root":""},{"id":2,"arabic":"أَنجَيْنَٰكُم","translit":"mُkَٰnْyَjgnَaʾ","root":"نجو"},{"id":3,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":4,"arabic":"ءَالِ","translit":"ِlāَء","root":"اول"},{"id":5,"arabic":"فِرْعَوْنَ","translit":"َnْwَʿعْrِf","root":""},{"id":6,"arabic":"يَسُومُونَكُمْ","translit":"ْmُkَnwُmwُsَy","root":"سوم"},{"id":7,"arabic":"سُوٓءَ","translit":"َءٓwُs","root":"سوا"},{"id":8,"arabic":"ٱلْعَذَابِ","translit":"ِbāَhdَʿعْlٱ","root":"عذب"},{"id":9,"arabic":"يُقَتِّلُونَ","translit":"َnwُlِّtَqُy","root":"قتل"},{"id":10,"arabic":"أَبْنَآءَكُمْ","translit":"ْmُkَء