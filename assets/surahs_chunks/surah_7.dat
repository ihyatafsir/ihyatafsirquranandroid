e unlettered prophet, whom they find written [i.e., described] in what they have of the Torah and the Gospel, who enjoins upon them what is right and prohibits them from what is wrong and makes lawful for them what is good and forbids them from what is evil and relieves them of their burden[1] and the shackles which were upon them.[2] So they who have believed in him, honored him, supported him and followed the light which was sent down with him - it is those who will be the successful.","words":[{"id":1,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":2,"arabic":"يَتَّبِعُونَ","translit":"َnwُʿعِbَّtَy","root":"تبع"},{"id":3,"arabic":"ٱلرَّسُولَ","translit":"َlwُsَّrlٱ","root":"رسل"},{"id":4,"arabic":"ٱلنَّبِىَّ","translit":"َّàِbَّnlٱ","root":"نبا"},{"id":5,"arabic":"ٱلْأُمِّىَّ","translit":"َّàِّmُaʾْlٱ","root":"امم"},{"id":6,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":7,"arabic":"يَجِدُونَهُۥ","translit":"ۥُhَnwُdِjgَy","root":"وجد"},{"id":8,"arabic":"مَكْتُوبًا","translit":"āًbwُtْkَm","root":"كتب"},{"id":9,"arabic":"عِندَهُمْ","translit":"ْmُhَdnِʿع","root":"عند"},{"id":10,"arabic":"فِى","translit":"àِf","root":""},{"id":11,"arabic":"ٱلتَّوْرَىٰةِ","translit":"ِẗٰàَrْwَّtlٱ","root":""},{"id":12,"arabic":"وَٱلْإِنجِيلِ","translit":"ِlyِjgnِiʾْlٱَw","root":""},{"id":13,"arabic":"يَأْمُرُهُم","translit":"mُhُrُmْaʾَy","root":"امر"},{"id":14,"arabic":"بِٱلْمَعْرُوفِ","translit":"ِfwُrْʿعَmْlٱِb","root":"عرف"},{"id":15,"arabic":"وَيَنْهَىٰهُمْ","translit":"ْmُhٰàَhْnَyَw","root":"نهي"},{"id":16,"arabic":"عَنِ","translit":"ِnَʿع","root":""},{"id":17,"arabic":"ٱلْمُنكَرِ","translit":"ِrَknُmْlٱ","root":"نكر"},{"id":18,"arabic":"وَيُحِلُّ","translit":"ُّlِḥُyَw","root":"حلل"},{"id":19,"arabic":"لَهُمُ","translit":"ُmُhَl","root":""},{"id":20,"arabic":"ٱلطَّيِّبَٰتِ","translit":"ِtَٰbِّyَّṭlٱ","root":"طيب"},{"id":21,"arabic":"وَيُحَرِّمُ","translit":"ُmِّrَḥُyَw","root":"حرم"},{"id":22,"arabic":"عَلَيْهِمُ","translit":"ُmِhْyَlَʿع","root":""},{"id":23,"arabic":"ٱلْخَبَٰٓئِثَ","translit":"َhtِyʾَٰٓbَhkْlٱ","root":"خبث"},{"id":24,"arabic":"وَيَضَعُ","translit":"ُʿعَḍَyَw","root":"وضع"},{"id":25,"arabic":"عَنْهُمْ","translit":"ْmُhْnَʿع","root":""},{"id":26,"arabic":"إِصْرَهُمْ","translit":"ْmُhَrْṣِiʾ","root":"اصر"},{"id":27,"arabic":"وَٱلْأَغْلَٰلَ","translit":"َlَٰlْغَaʾْlٱَw","root":"غلل"},{"id":28,"arabic":"ٱلَّتِى","translit":"àِtَّlٱ","root":""},{"id":29,"arabic":"كَانَتْ","translit":"ْtَnāَk","root":"كون"},{"id":30,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":31,"arabic":"فَٱلَّذِينَ","translit":"َnyِhdَّlٱَf","root":""},{"id":32,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":33,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":34,"arabic":"وَعَزَّرُوهُ","translit":"ُhwُrَّzَʿعَw","root":"عزر"},{"id":35,"arabic":"وَنَصَرُوهُ","translit":"ُhwُrَṣَnَw","root":"نصر"},{"id":36,"arabic":"وَٱتَّبَعُوا۟","translit":"۟āwُʿعَbَّtٱَw","root":"تبع"},{"id":37,"arabic":"ٱلنُّورَ","translit":"َrwُّnlٱ","root":"نور"},{"id":38,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":39,"arabic":"أُنزِلَ","translit":"َlِznُaʾ","root":"نزل"},{"id":40,"arabic":"مَعَهُۥٓ","translit":"ٓۥُhَʿعَm","root":""},{"id":41,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":42,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":43,"arabic":"ٱلْمُفْلِحُونَ","translit":"َnwُḥِlْfُmْlٱ","root":"فلح"}],"hasIhya":true},{"ayah":158,"text":"قُلْ يَٰٓأَيُّهَا ٱلنَّاسُ إِنِّى رَسُولُ ٱللَّهِ إِلَيْكُمْ جَمِيعًا ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ لَآ إِلَٰهَ إِلَّا هُوَ يُحْىِۦ وَيُمِيتُۖ فَـَٔامِنُوا۟ بِٱللَّهِ وَرَسُولِهِ ٱلنَّبِىِّ ٱلْأُمِّىِّ ٱلَّذِى يُؤْمِنُ بِٱللَّهِ وَكَلِمَٰتِهِۦ وَٱتَّبِعُوهُ لَعَلَّكُمْ تَهْتَدُونَ ","translation":"Say, [O Muḥammad], \"O mankind, indeed I am the Messenger of Allāh to you all, [from Him] to whom belongs the dominion of the heavens and the earth. There is no deity except Him; He gives life and causes death.\" So believe in Allāh and His Messenger, the unlettered prophet, who believes in Allāh and His words, and follow him that you may be guided.","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":3,"arabic":"ٱلنَّاسُ","translit":"ُsāَّnlٱ","root":"انس"},{"id":4,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":5,"arabic":"رَسُولُ","translit":"ُlwُsَr","root":"رسل"},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"إِلَيْكُمْ","translit":"ْmُkْyَlِiʾ","root":""},{"id":8,"arabic":"جَمِيعًا","translit":"āًʿعyِmَjg","root":"جمع"},{"id":9,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":10,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":11,"arabic":"مُلْكُ","translit":"ُkْlُm","root":"ملك"},{"id":12,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":13,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":14,"arabic":"لَآ","translit":"ٓāَl","root":""},{"id":15,"arabic":"إِلَٰهَ","translit":"َhَٰlِiʾ","root":"اله"},{"id":16,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":17,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":18,"arabic":"يُحْىِۦ","translit":"ۦِàْḥُy","root":"حيي"},{"id":19,"arabic":"وَيُمِيتُ","translit":"ُtyِmُyَw","root":"موت"},{"id":20,"arabic":"فَـَٔامِنُوا۟","translit":"۟āwُnِmāَٔـَf","root":"امن"},{"id":21,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":22,"arabic":"وَرَسُولِهِ","translit":"ِhِlwُsَrَw","root":"رسل"},{"id":23,"arabic":"ٱلنَّبِىِّ","translit":"ِّàِbَّnlٱ","root":"نبا"},{"id":24,"arabic":"ٱلْأُمِّىِّ","translit":"ِّàِّmُaʾْlٱ","root":"امم"},{"id":25,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":26,"arabic":"يُؤْمِنُ","translit":"ُnِmْwʾُy","root":"امن"},{"id":27,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":28,"arabic":"وَكَلِمَٰتِهِۦ","translit":"ۦِhِtَٰmِlَkَw","root":"كلم"},{"id":29,"arabic":"وَٱتَّبِعُوهُ","translit":"ُhwُʿعِbَّtٱَw","root":"تبع"},{"id":30,"arabic":"لَعَلَّكُمْ","translit":"ْmُkَّlَʿعَl","root":""},{"id":31,"arabic":"تَهْتَدُونَ","translit":"َnwُdَtْhَt","root":"هدي"}],"hasIhya":true},{"ayah":159,"text":"وَمِن قَوْمِ مُوسَىٰٓ أُمَّةٌ يَهْدُونَ بِٱلْحَقِّ وَبِهِۦ يَعْدِلُونَ ","translation":"And among the people of Moses is a community[1] which guides by truth and by it establishes justice.","words":[{"id":1,"arabic":"وَمِن","translit":"nِmَw","root":""},{"id":2,"arabic":"قَوْمِ","translit":"ِmْwَq","root":"قوم"},{"id":3,"arabic":"مُوسَىٰٓ","translit":"ٰٓàَswُm","root":""},{"id":4,"arabic":"أُمَّةٌ","translit":"ٌẗَّmُaʾ","root":"امم"},{"id":5,"arabic":"يَهْدُونَ","translit":"َnwُdْhَy","root":"هدي"},{"id":6,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":7,"arabic":"وَبِهِۦ","translit":"ۦِhِbَw","root":""},{"id":8,"arabic":"يَعْدِلُونَ","translit":"َnwُlِdْʿعَy","root":"عدل"}],"hasIhya":false},{"ayah":160,"text":"وَقَطَّعْنَٰهُمُ ٱثْنَتَىْ عَشْرَةَ أَسْبَاطًا أُمَمًاۚ وَأَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ إِذِ ٱسْتَسْقَىٰهُ قَوْمُهُۥٓ أَنِ ٱضْرِب بِّعَصَاكَ ٱلْحَجَرَۖ فَٱنۢبَجَسَتْ مِنْهُ ٱثْنَتَا عَشْرَةَ عَيْنًاۖ قَدْ عَلِمَ كُلُّ أُنَاسٍ مَّشْرَبَهُمْۚ وَظَلَّلْنَا عَلَيْهِمُ ٱلْغَمَٰمَ وَأَنزَلْنَا عَلَيْهِمُ ٱلْمَنَّ وَٱلسَّلْوَىٰۖ كُلُوا۟ مِن طَيِّبَٰتِ مَا رَزَقْنَٰكُمْۚ وَمَا ظَلَمُونَا وَلَٰكِن كَانُوٓا۟ أَنفُسَهُمْ يَظْلِمُونَ ","translation":"And We divided them into twelve descendant tribes[1] [as distinct] nations. And We inspired to Moses when his people implored him for water, \"Strike with your staff the stone,\" and there gushed forth from it twelve springs. Every people [i.e., tribe] knew its watering place. And We shaded them with clouds and sent down upon them manna and quails, [saying], \"Eat from the good things with which We have provided you.\" And they wronged Us not, but they were [only] wronging themselves.","words":[{"id":1,"arabic":"وَقَطَّعْنَٰهُمُ","translit":"ُmُhَٰnْʿعَّṭَqَw","root":"قطع"},{"id":2,"arabic":"ٱثْنَتَىْ","t