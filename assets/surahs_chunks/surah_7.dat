":"بطل"},{"id":4,"arabic":"مَا","translit":"āَm","root":""},{"id":5,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":6,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":false},{"ayah":119,"text":"فَغُلِبُوا۟ هُنَالِكَ وَٱنقَلَبُوا۟ صَٰغِرِينَ ","translation":"And they [i.e., Pharaoh and his people] were overcome right there and became debased.","words":[{"id":1,"arabic":"فَغُلِبُوا۟","translit":"۟āwُbِlُغَf","root":"غلب"},{"id":2,"arabic":"هُنَالِكَ","translit":"َkِlāَnُh","root":""},{"id":3,"arabic":"وَٱنقَلَبُوا۟","translit":"۟āwُbَlَqnٱَw","root":"قلب"},{"id":4,"arabic":"صَٰغِرِينَ","translit":"َnyِrِغَٰṣ","root":"صغر"}],"hasIhya":false},{"ayah":120,"text":"وَأُلْقِىَ ٱلسَّحَرَةُ سَٰجِدِينَ ","translation":"And the magicians fell down in prostration [to Allāh].","words":[{"id":1,"arabic":"وَأُلْقِىَ","translit":"َàِqْlُaʾَw","root":"لقي"},{"id":2,"arabic":"ٱلسَّحَرَةُ","translit":"ُẗَrَḥَّslٱ","root":"سحر"},{"id":3,"arabic":"سَٰجِدِينَ","translit":"َnyِdِjgَٰs","root":"سجد"}],"hasIhya":false},{"ayah":121,"text":"قَالُوٓا۟ ءَامَنَّا بِرَبِّ ٱلْعَٰلَمِينَ ","translation":"They said, \"We have believed in the Lord of the worlds,","words":[{"id":1,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":2,"arabic":"ءَامَنَّا","translit":"āَّnَmāَء","root":"امن"},{"id":3,"arabic":"بِرَبِّ","translit":"ِّbَrِb","root":"ربب"},{"id":4,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":122,"text":"رَبِّ مُوسَىٰ وَهَٰرُونَ ","translation":"The Lord of Moses and Aaron.\"","words":[{"id":1,"arabic":"رَبِّ","translit":"ِّbَr","root":"ربب"},{"id":2,"arabic":"مُوسَىٰ","translit":"ٰàَswُm","root":""},{"id":3,"arabic":"وَهَٰرُونَ","translit":"َnwُrَٰhَw","root":""}],"hasIhya":false},{"ayah":123,"text":"قَالَ فِرْعَوْنُ ءَامَنتُم بِهِۦ قَبْلَ أَنْ ءَاذَنَ لَكُمْۖ إِنَّ هَٰذَا لَمَكْرٌ مَّكَرْتُمُوهُ فِى ٱلْمَدِينَةِ لِتُخْرِجُوا۟ مِنْهَآ أَهْلَهَاۖ فَسَوْفَ تَعْلَمُونَ ","translation":"Said Pharaoh, \"You believed in him[1] before I gave you permission. Indeed, this is a conspiracy which you conspired in the city to expel therefrom its people. But you are going to know.","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"فِرْعَوْنُ","translit":"ُnْwَʿعْrِf","root":""},{"id":3,"arabic":"ءَامَنتُم","translit":"mُtnَmāَء","root":"امن"},{"id":4,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":5,"arabic":"قَبْلَ","translit":"َlْbَq","root":"قبل"},{"id":6,"arabic":"أَنْ","translit":"ْnَaʾ","root":""},{"id":7,"arabic":"ءَاذَنَ","translit":"َnَhdāَء","root":"اذن"},{"id":8,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":9,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":10,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":11,"arabic":"لَمَكْرٌ","translit":"ٌrْkَmَl","root":"مكر"},{"id":12,"arabic":"مَّكَرْتُمُوهُ","translit":"ُhwُmُtْrَkَّm","root":"مكر"},{"id":13,"arabic":"فِى","translit":"àِf","root":""},{"id":14,"arabic":"ٱلْمَدِينَةِ","translit":"ِẗَnyِdَmْlٱ","root":"مدن"},{"id":15,"arabic":"لِتُخْرِجُوا۟","translit":"۟āwُjgِrْhkُtِl","root":"خرج"},{"id":16,"arabic":"مِنْهَآ","translit":"ٓāَhْnِm","root":""},{"id":17,"arabic":"أَهْلَهَا","translit":"āَhَlْhَaʾ","root":"اهل"},{"id":18,"arabic":"فَسَوْفَ","translit":"َfْwَsَf","root":""},{"id":19,"arabic":"تَعْلَمُونَ","translit":"َnwُmَlْʿعَt","root":"علم"}],"hasIhya":false},{"ayah":124,"text":"لَأُقَطِّعَنَّ أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ خِلَٰفٍ ثُمَّ لَأُصَلِّبَنَّكُمْ أَجْمَعِينَ ","translation":"I will surely cut off your hands and your feet on opposite sides; then I will surely crucify you all.\"","words":[{"id":1,"arabic":"لَأُقَطِّعَنَّ","translit":"َّnَʿعِّṭَqُaʾَl","root":"قطع"},{"id":2,"arabic":"أَيْدِيَكُمْ","translit":"ْmُkَyِdْyَaʾ","root":"يدي"},{"id":3,"arabic":"وَأَرْجُلَكُم","translit":"mُkَlُjgْrَaʾَw","root":"رجل"},{"id":4,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":5,"arabic":"خِلَٰفٍ","translit":"ٍfَٰlِhk","root":"خلف"},{"id":6,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":7,"arabic":"لَأُصَلِّبَنَّكُمْ","translit":"ْmُkَّnَbِّlَṣُaʾَl","root":"صلب"},{"id":8,"arabic":"أَجْمَعِينَ","translit":"َnyِʿعَmْjgَaʾ","root":"جمع"}],"hasIhya":true},{"ayah":125,"text":"قَالُوٓا۟ إِنَّآ إِلَىٰ رَبِّنَا مُنقَلِبُونَ ","translation":"They said, \"Indeed, to our Lord we will return.","words":[{"id":1,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":2,"arabic":"إِنَّآ","translit":"ٓāَّnِiʾ","root":""},{"id":3,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":4,"arabic":"رَبِّنَا","translit":"āَnِّbَr","root":"ربب"},{"id":5,"arabic":"مُنقَلِبُونَ","translit":"َnwُbِlَqnُm","root":"قلب"}],"hasIhya":false},{"ayah":126,"text":"وَمَا تَنقِمُ مِنَّآ إِلَّآ أَنْ ءَامَنَّا بِـَٔايَٰتِ رَبِّنَا لَمَّا جَآءَتْنَاۚ رَبَّنَآ أَفْرِغْ عَلَيْنَا صَبْرًا وَتَوَفَّنَا مُسْلِمِينَ ","translation":"And you do not resent us except because we believed in the signs of our Lord when they came to us. Our Lord, pour upon us patience[1] and let us die as Muslims [in submission to You].\"","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"تَنقِمُ","translit":"ُmِqnَt","root":"نقم"},{"id":3,"arabic":"مِنَّآ","translit":"ٓāَّnِm","root":""},{"id":4,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":5,"arabic":"أَنْ","translit":"ْnَaʾ","root":""},{"id":6,"arabic":"ءَامَنَّا","translit":"āَّnَmāَء","root":"امن"},{"id":7,"arabic":"بِـَٔايَٰتِ","translit":"ِtَٰyāَٔـِb","root":"ايي"},{"id":8,"arabic":"رَبِّنَا","translit":"āَnِّbَr","root":"ربب"},{"id":9,"arabic":"لَمَّا","translit":"āَّmَl","root":""},{"id":10,"arabic":"جَآءَتْنَا","translit":"āَnْtَءٓāَjg","root":"جيا"},{"id":11,"arabic":"رَبَّنَآ","translit":"ٓāَnَّbَr","root":"ربب"},{"id":12,"arabic":"أَفْرِغْ","translit":"ْغِrْfَaʾ","root":"فرغ"},{"id":13,"arabic":"عَلَيْنَا","translit":"āَnْyَlَʿع","root":""},{"id":14,"arabic":"صَبْرًا","translit":"āًrْbَṣ","root":"صبر"},{"id":15,"arabic":"وَتَوَفَّنَا","translit":"āَnَّfَwَtَw","root":"وفي"},{"id":16,"arabic":"مُسْلِمِينَ","translit":"َnyِmِlْsُm","root":"سلم"}],"hasIhya":true},{"ayah":127,"text":"وَقَالَ ٱلْمَلَأُ مِن قَوْمِ فِرْعَوْنَ أَتَذَرُ مُوسَىٰ وَقَوْمَهُۥ لِيُفْسِدُوا۟ فِى ٱلْأَرْضِ وَيَذَرَكَ وَءَالِهَتَكَۚ قَالَ سَنُقَتِّلُ أَبْنَآءَهُمْ وَنَسْتَحْىِۦ نِسَآءَهُمْ وَإِنَّا فَوْقَهُمْ قَٰهِرُونَ ","translation":"And the eminent among the people of Pharaoh said, \"Will you leave Moses and his people to cause corruption in the land and abandon you and your gods?\" [Pharaoh] said, \"We will kill their sons and keep their women alive; and indeed, we are subjugators over them.\"","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"ٱلْمَلَأُ","translit":"ُaʾَlَmْlٱ","root":"ملا"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"قَوْمِ","translit":"ِmْwَq","root":"قوم"},{"id":5,"arabic":"فِرْعَوْنَ","translit":"َnْwَʿعْrِf","root":""},{"id":6,"arabic":"أَتَذَرُ","translit":"ُrَhdَtَaʾ","root":"وذر"},{"id":7,"arabic":"مُوسَىٰ","translit":"ٰàَswُm","root":""},{"id":8,"arabic":"وَقَوْمَهُۥ","translit":"ۥُhَmْwَqَw","root":"قوم"},{"id":9,"arabic":"لِيُفْسِدُوا۟","translit":"۟āwُdِsْfُyِl","root":"فسد"},{"id":10,"arabic":"فِى","translit":"àِf","root":""},{"id":11,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":12,"arabic":"وَيَذَرَكَ","translit":"َkَrَhdَyَw","root":"وذر"},{"id":13,"arabic":"وَءَالِهَتَكَ","translit":"َkَtَhِlāَءَw","root":"اله"},{"id":14,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":15,"arabic":"سَنُقَتِّلُ","translit":"ُlِّtَqُnَs","root":"قتل"},{"id":16,"arabic":"أَبْنَآءَهُمْ","translit":"ْmُhَءٓāَnْbَaʾ","root":"بني"},{"id":17,"arabic":"وَنَسْتَحْىِۦ","translit":"ۦِàْḥَtْsَnَw","root":"حيي"},{"id":18,"arabic":"نِسَآءَهُمْ","translit":"ْmُhَءٓāَsِn","root":"نسو"},{"id":19,"arabic":"وَإِنَّا","translit":"āَّnِiʾَw","root":""},{"id":20,"arabic":"فَوْقَهُمْ","translit":"ْmُhَqْwَf","root":"فوق"},{"id":21,"arabic":"قَٰهِرُونَ","translit":"َnwُrِhَٰq","root":"قهر"}],"hasIhya":false},{"ayah":128,"text":"قَالَ مُوسَىٰ لِقَوْمِهِ ٱسْتَعِينُوا۟ بِٱللَّهِ وَٱصْبِرُوٓا۟ۖ إِنَّ ٱلْأَرْضَ لِلَّهِ يُورِثُهَا مَن يَشَآءُ مِنْ عِبَادِهِۦۖ وَٱلْعَٰقِبَةُ لِلْمُتَّقِينَ ","translation":"Said Moses to his people, \"Seek help through Allāh and be patient. Indeed, the earth belongs to Allāh. He causes to inherit it whom He wills of His servants. And the [best] outcome is for the righteous.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"مُوسَىٰ","translit":"ٰàَswُm","root":""},{"id":3,"arabic":"لِقَوْمِهِ","translit":"ِhِmْwَqِl","root":"قوم"},{"id":4,"arabic":"ٱسْتَعِينُوا۟","translit":"۟āwُnyِʿعَtْsٱ","root":"عون"},{"id":5,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":6,"arabic":"وَٱصْبِرُوٓا۟","translit":"۟āٓwُrِbْṣٱَw","root":"صبر"},{"id":7,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":8,"arabic":"ٱلْأَرْضَ","translit":"َḍْrَaʾْlٱ","root":"ارض"},{"id":9,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":10,"arabic":"يُورِثُهَا","translit":"āَhُhtِrwُy","root":"ورث"},{"id":11,"arabic":"مَن","translit":"nَm","root":""},{"id":12,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":13,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":14,"arabic":"عِبَادِهِۦ","translit":"ۦِhِdāَbِʿع","root":"عبد"},{"id":15,"arabic":"وَٱلْعَٰقِبَةُ","translit":"ُẗَbِqَٰʿعْlٱَw","root":"عقب"},{"id":16,"arabic":"لِلْمُتَّقِينَ","translit":"َnyِqَّtُmْlِl","root":"وقي"}],"hasIhya":false},{"ayah":129,"text":"قَالُوٓا۟ أُوذِينَا مِن قَبْلِ أَن تَأْتِيَنَا وَمِنۢ بَعْدِ مَا جِئْتَنَاۚ قَالَ عَسَىٰ رَبُّكُمْ أَن يُهْلِكَ عَدُوَّكُمْ وَيَسْتَخْلِفَكُمْ فِى ٱلْأَرْضِ فَيَنظُرَ كَيْفَ تَعْمَلُونَ ","translation":"They said, \"We have been harmed before you came to us and after you have come to us.\" He said, \"Perhaps your Lord will destroy your enemy and grant you succession in the land and see how you will do.\"","words":[{"id":1,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":2,"arabic":"أُوذِينَا","translit":"āَnyِhdwُaʾ","root":"اذي"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"قَبْلِ","translit":"ِlْbَq","root":"قبل"},{"id":5,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":6,"arabic":"تَأْتِيَنَا","translit":"āَnَyِtْaʾَt","root":"اتي"},{"id":7,"arabic":"وَمِنۢ","translit":"ۢnِmَw","root":""},{"id":8,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":9,"arabic":"مَا","translit":"āَm","root":""},{"id":10,"arabic":"جِئْتَنَا","translit":"āَnَtْyʾِjg","root":"جيا"},{"id":11,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":12,"arabic":"عَسَىٰ","translit":"ٰàَsَʿع","root":"عسي"},{"id":13,"arabic":"رَبُّكُمْ","translit":"ْmُkُّbَr","root":"ربب"},{"id":14,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":15,"arabic":"يُهْلِكَ","translit":"َkِlْhُy","root":"هلك"},{"id":16,"arabic":"عَدُوَّكُمْ","translit":"ْmُkَّwُdَʿع","root":"عدو"},{"id":17,"arabic":"وَيَسْتَخْلِفَكُمْ","translit":"ْmُkَfِlْhkَtْsَyَw","root":"خلف"},{"id":18,"arabic":"فِى","translit":"àِf","root":""},{"id":19,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":20,"arabic":"فَيَنظُرَ","translit":"َrُẓnَyَf","root":"نظر"},{"id":21,"arabic":"كَيْفَ","translit":"َfْyَk","root":"كيف"},{"id":22,"arabic":"تَعْمَلُونَ","translit":"َnwُlَmْʿعَt","root":"عمل"}],"hasIhya":false},{"ayah":130,"text":"وَلَقَدْ أَخَذْنَآ ءَالَ فِرْعَوْنَ بِٱلسِّنِينَ وَنَقْصٍ مِّنَ ٱلثَّمَرَٰتِ لَعَلَّهُمْ يَذَّكَّرُونَ ","translation":"And We certainly seized[1] the people of Pharaoh with years of famine and a deficiency in fruits that perhaps they would be reminded.","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"أَخَذْنَآ","translit":"ٓāَnْhdَhkَaʾ","root":"اخذ"},{"id":3,"arabic":"ءَالَ","translit":"َlāَء","root":"اول"},{"id":4,"arabic":"فِرْعَوْنَ","translit":"َnْwَʿعْrِf","root":""},{"id":5,"arabic":"بِٱلسِّنِينَ","translit":"َnyِnِّslٱِb","root":"سنو"},{"id":6,"arabic":"وَنَقْصٍ","translit":"ٍṣْqَnَw","root":"نقص"},{"id":7,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":8,"arabic":"ٱلثَّمَرَٰتِ","translit":"ِtَٰrَmَّhtlٱ","root":"ثمر"},{"id":9,"arabic":"لَعَلَّهُمْ","translit":"ْmُhَّlَʿعَl","root":""},{"id":10,"arabic":"يَذَّكَّرُونَ","translit":"َnwُrَّkَّhdَy","root":"ذكر"}],"hasIhya":false},{"ayah":131,"text":"فَإِذَا جَآءَتْهُمُ ٱلْحَسَنَةُ قَالُوا۟ لَنَا هَٰذِهِۦۖ وَإِن تُصِبْهُمْ سَيِّئَةٌ يَطَّيَّرُوا۟ بِمُوسَىٰ وَمَن مَّعَهُۥٓۗ أَلَآ إِنَّمَا طَٰٓئِرُهُمْ عِندَ ٱللَّهِ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ ","translation":"But when good [i.e., provision] came to them, they said, \"This is ours [by right].\" And if a bad [condition] struck them, they saw an evil omen in Moses and those with him. Unquestionably, their fortune is with Allāh, but most of them do not know.","words":[{"id":1,"arabic":"فَإِذَا","translit":"āَhdِiʾَf","root":""},{"id":2,"arabic":"جَآءَتْهُمُ","translit":"ُmُhْtَءٓāَjg","root":"جيا"},{"id":3,"arabic":"ٱلْحَسَنَةُ","translit":"ُẗَnَsَḥْlٱ","root":"حسن"},{"id":4,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":5,"arabic":"لَنَا","translit":"āَnَl","root":""},{"id":6,"arabic":"هَٰذِهِۦ","translit":"ۦِhِhdَٰh","root":""},{"id":7,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":8,"arabic":"تُصِبْهُمْ","translit":"ْmُhْbِṣُt","root":"صوب"},{"id":9,"arabic":"سَيِّئَةٌ","translit":"ٌẗَyʾِّyَs","root":"سوا"},{"id":10,"arabic":"يَطَّيَّرُوا۟","translit":"۟āwُrَّyَّṭَy","root":"طير"},{"id":11,"arabic":"بِمُوسَىٰ","translit":"ٰàَswُmِb","root":""},{"id":12,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":13,"arabic":"مَّعَهُۥٓ","translit":"ٓۥُhَʿعَّm","root":""},{"id":14,"arabic":"أَلَآ","translit":"ٓāَlَaʾ","root":""},{"id":15,"arabic":"إِنَّمَا","translit":"āَmَّnِiʾ","root":""},{"id":16,"arabic":"طَٰٓئِرُهُمْ","translit":"ْmُhُrِyʾَٰٓṭ","root":"طير"},{"id":17,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":18,"arabic":"ٱللَّهِ","tra