رَّحِيمٌ","translit":"ٌmyِḥَّr","root":"رحم"}],"hasIhya":false},{"ayah":154,"text":"وَلَمَّا سَكَتَ عَن مُّوسَى ٱلْغَضَبُ أَخَذَ ٱلْأَلْوَاحَۖ وَفِى نُسْخَتِهَا هُدًى وَرَحْمَةٌ لِّلَّذِينَ هُمْ لِرَبِّهِمْ يَرْهَبُونَ ","translation":"And when the anger subsided in Moses, he took up the tablets; and in their inscription was guidance and mercy for those who are fearful of their Lord.","words":[{"id":1,"arabic":"وَلَمَّا","translit":"āَّmَlَw","root":""},{"id":2,"arabic":"سَكَتَ","translit":"َtَkَs","root":"سكت"},{"id":3,"arabic":"عَن","translit":"nَʿع","root":""},{"id":4,"arabic":"مُّوسَى","translit":"àَswُّm","root":""},{"id":5,"arabic":"ٱلْغَضَبُ","translit":"ُbَḍَغْlٱ","root":"غضب"},{"id":6,"arabic":"أَخَذَ","translit":"َhdَhkَaʾ","root":"اخذ"},{"id":7,"arabic":"ٱلْأَلْوَاحَ","translit":"َḥāَwْlَaʾْlٱ","root":"لوح"},{"id":8,"arabic":"وَفِى","translit":"àِfَw","root":""},{"id":9,"arabic":"نُسْخَتِهَا","translit":"āَhِtَhkْsُn","root":"نسخ"},{"id":10,"arabic":"هُدًى","translit":"àًdُh","root":"هدي"},{"id":11,"arabic":"وَرَحْمَةٌ","translit":"ٌẗَmْḥَrَw","root":"رحم"},{"id":12,"arabic":"لِّلَّذِينَ","translit":"َnyِhdَّlِّl","root":""},{"id":13,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":14,"arabic":"لِرَبِّهِمْ","translit":"ْmِhِّbَrِl","root":"ربب"},{"id":15,"arabic":"يَرْهَبُونَ","translit":"َnwُbَhْrَy","root":"رهب"}],"hasIhya":true},{"ayah":155,"text":"وَٱخْتَارَ مُوسَىٰ قَوْمَهُۥ سَبْعِينَ رَجُلًا لِّمِيقَٰتِنَاۖ فَلَمَّآ أَخَذَتْهُمُ ٱلرَّجْفَةُ قَالَ رَبِّ لَوْ شِئْتَ أَهْلَكْتَهُم مِّن قَبْلُ وَإِيَّٰىَۖ أَتُهْلِكُنَا بِمَا فَعَلَ ٱلسُّفَهَآءُ مِنَّآۖ إِنْ هِىَ إِلَّا فِتْنَتُكَ تُضِلُّ بِهَا مَن تَشَآءُ وَتَهْدِى مَن تَشَآءُۖ أَنتَ وَلِيُّنَا فَٱغْفِرْ لَنَا وَٱرْحَمْنَاۖ وَأَنتَ خَيْرُ ٱلْغَٰفِرِينَ ","translation":"And Moses chose from his people seventy men for Our appointment.[1] And when the earthquake seized them,[2] he said, \"My Lord, if You had willed, You could have destroyed them before and me [as well]. Would You destroy us for what the foolish among us have done? This is not but Your trial by which You send astray whom You will and guide whom You will. You are our Protector, so forgive us and have mercy upon us; and You are the best of forgivers.","words":[{"id":1,"arabic":"وَٱخْتَارَ","translit":"َrāَtْhkٱَw","root":"خير"},{"id":2,"arabic":"مُوسَىٰ","translit":"ٰàَswُm","root":""},{"id":3,"arabic":"قَوْمَهُۥ","translit":"ۥُhَmْwَq","root":"قوم"},{"id":4,"arabic":"سَبْعِينَ","translit":"َnyِʿعْbَs","root":"سبع"},{"id":5,"arabic":"رَجُلًا","translit":"āًlُjgَr","root":"رجل"},{"id":6,"arabic":"لِّمِيقَٰتِنَا","translit":"āَnِtَٰqyِmِّl","root":"وقت"},{"id":7,"arabic":"فَلَمَّآ","translit":"ٓāَّmَlَf","root":""},{"id":8,"arabic":"أَخَذَتْهُمُ","translit":"ُmُhْtَhdَhkَaʾ","root":"اخذ"},{"id":9,"arabic":"ٱلرَّجْفَةُ","translit":"ُẗَfْjgَّrlٱ","root":"رجف"},{"id":10,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":11,"arabic":"رَبِّ","translit":"ِّbَr","root":"ربب"},{"id":12,"arabic":"لَوْ","translit":"ْwَl","root":""},{"id":13,"arabic":"شِئْتَ","translit":"َtْyʾِhs","root":"شيا"},{"id":14,"arabic":"أَهْلَكْتَهُم","translit":"mُhَtْkَlْhَaʾ","root":"هلك"},{"id":15,"arabic":"مِّن","translit":"nِّm","root":""},{"id":16,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":17,"arabic":"وَإِيَّٰىَ","translit":"َàَّٰyِiʾَw","root":""},{"id":18,"arabic":"أَتُهْلِكُنَا","translit":"āَnُkِlْhُtَaʾ","root":"هلك"},{"id":19,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":20,"arabic":"فَعَلَ","translit":"َlَʿعَf","root":"فعل"},{"id":21,"arabic":"ٱلسُّفَهَآءُ","translit":"ُءٓāَhَfُّslٱ","root":"سفه"},{"id":22,"arabic":"مِنَّآ","translit":"ٓāَّnِm","root":""},{"id":23,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":24,"arabic":"هِىَ","translit":"َàِh","root":""},{"id":25,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":26,"arabic":"فِتْنَتُكَ","translit":"َkُtَnْtِf","root":"فتن"},{"id":27,"arabic":"تُضِلُّ","translit":"ُّlِḍُt","root":"ضلل"},{"id":28,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":29,"arabic":"مَن","translit":"nَm","root":""},{"id":30,"arabic":"تَشَآءُ","translit":"ُءٓāَhsَt","root":"شيا"},{"id":31,"arabic":"وَتَهْدِى","translit":"àِdْhَtَw","root":"هدي"},{"id":32,"arabic":"مَن","translit":"nَm","root":""},{"id":33,"arabic":"تَشَآءُ","translit":"ُءٓāَhsَt","root":"شيا"},{"id":34,"arabic":"أَنتَ","translit":"َtnَaʾ","root":""},{"id":35,"arabic":"وَلِيُّنَا","translit":"āَnُّyِlَw","root":"ولي"},{"id":36,"arabic":"فَٱغْفِرْ","translit":"ْrِfْغٱَf","root":"غفر"},{"id":37,"arabic":"لَنَا","translit":"āَnَl","root":""},{"id":38,"arabic":"وَٱرْحَمْنَا","translit":"āَnْmَḥْrٱَw","root":"رحم"},{"id":39,"arabic":"وَأَنتَ","translit":"َtnَaʾَw","root":""},{"id":40,"arabic":"خَيْرُ","translit":"ُrْyَhk","root":"خير"},{"id":41,"arabic":"ٱلْغَٰفِرِينَ","translit":"َnyِrِfَٰغْlٱ","root":"غفر"}],"hasIhya":true},{"ayah":156,"text":"وَٱكْتُبْ لَنَا فِى هَٰذِهِ ٱلدُّنْيَا حَسَنَةً وَفِى ٱلْءَاخِرَةِ إِنَّا هُدْنَآ إِلَيْكَۚ قَالَ عَذَابِىٓ أُصِيبُ بِهِۦ مَنْ أَشَآءُۖ وَرَحْمَتِى وَسِعَتْ كُلَّ شَىْءٍۚ فَسَأَكْتُبُهَا لِلَّذِينَ يَتَّقُونَ وَيُؤْتُونَ ٱلزَّكَوٰةَ وَٱلَّذِينَ هُم بِـَٔايَٰتِنَا يُؤْمِنُونَ ","translation":"And decree for us in this world [that which is] good and [also] in the Hereafter; indeed, we have turned back to You.\" [Allāh] said, \"My punishment - I afflict with it whom I will, but My mercy encompasses all things.\" So I will decree it [especially] for those who fear Me and give zakāh and those who believe in Our verses-","words":[{"id":1,"arabic":"وَٱكْتُبْ","translit":"ْbُtْkٱَw","root":"كتب"},{"id":2,"arabic":"لَنَا","translit":"āَnَl","root":""},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"هَٰذِهِ","translit":"ِhِhdَٰh","root":""},{"id":5,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":6,"arabic":"حَسَنَةً","translit":"ًẗَnَsَḥ","root":"حسن"},{"id":7,"arabic":"وَفِى","translit":"àِfَw","root":""},{"id":8,"arabic":"ٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱ","root":"اخر