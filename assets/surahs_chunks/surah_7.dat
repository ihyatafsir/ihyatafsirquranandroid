{"surah":7,"verses":[{"ayah":1,"text":"الٓمٓصٓ ","translation":"Alif, Lām, Meem, Ṣād.[1]","words":[{"id":1,"arabic":"الٓمٓصٓ","translit":"ٓṣٓmٓlā","root":""}],"hasIhya":false},{"ayah":2,"text":"كِتَٰبٌ أُنزِلَ إِلَيْكَ فَلَا يَكُن فِى صَدْرِكَ حَرَجٌ مِّنْهُ لِتُنذِرَ بِهِۦ وَذِكْرَىٰ لِلْمُؤْمِنِينَ ","translation":"[This is] a Book revealed to you, [O Muḥammad] - so let there not be in your breast distress therefrom - that you may warn thereby and as a reminder to the believers.","words":[{"id":1,"arabic":"كِتَٰبٌ","translit":"ٌbَٰtِk","root":"كتب"},{"id":2,"arabic":"أُنزِلَ","translit":"َlِznُaʾ","root":"نزل"},{"id":3,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":4,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":5,"arabic":"يَكُن","translit":"nُkَy","root":"كون"},{"id":6,"arabic":"فِى","translit":"àِf","root":""},{"id":7,"arabic":"صَدْرِكَ","translit":"َkِrْdَṣ","root":"صدر"},{"id":8,"arabic":"حَرَجٌ","translit":"ٌjgَrَḥ","root":"حرج"},{"id":9,"arabic":"مِّنْهُ","translit":"ُhْnِّm","root":""},{"id":10,"arabic":"لِتُنذِرَ","translit":"َrِhdnُtِl","root":"نذر"},{"id":11,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":12,"arabic":"وَذِكْرَىٰ","translit":"ٰàَrْkِhdَw","root":"ذكر"},{"id":13,"arabic":"لِلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlِl","root":"امن"}],"hasIhya":false},{"ayah":3,"text":"ٱتَّبِعُوا۟ مَآ أُنزِلَ إِلَيْكُم مِّن رَّبِّكُمْ وَلَا تَتَّبِعُوا۟ مِن دُونِهِۦٓ أَوْلِيَآءَۗ قَلِيلًا مَّا تَذَكَّرُونَ ","translation":"Follow, [O mankind], what has been revealed to you from your Lord and do not follow other than Him any allies. Little do you remember.","words":[{"id":1,"arabic":"ٱتَّبِعُوا۟","translit":"۟āwُʿعِbَّtٱ","root":"تبع"},{"id":2,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":3,"arabic":"أُنزِلَ","translit":"َlِznُaʾ","root":"نزل"},{"id":4,"arabic":"إِلَيْكُم","translit":"mُkْyَlِiʾ","root":""},{"id":5,"arabic":"مِّن","translit":"nِّm","root":""},{"id":6,"arabic":"رَّبِّكُمْ","translit":"ْmُkِّbَّr","root":"ربب"},{"id":7,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":8,"arabic":"تَتَّبِعُوا۟","translit":"۟āwُʿعِbَّtَt","root":"تبع"},{"id":9,"arabic":"مِن","translit":"nِm","root":""},{"id":10,"arabic":"دُونِهِۦٓ","translit":"ٓۦِhِnwُd","root":"دون"},{"id":11,"arabic":"أَوْلِيَآءَ","translit":"َءٓāَyِlْwَaʾ","root":"ولي"},{"id":12,"arabic":"قَلِيلًا","translit":"āًlyِlَq","root":"قلل"},{"id":13,"arabic":"مَّا","translit":"āَّm","root":""},{"id":14,"arabic":"تَذَكَّرُونَ","translit":"َnwُrَّkَhdَt","root":"ذكر"}],"hasIhya":false},{"ayah":4,"text":"وَكَم مِّن قَرْيَةٍ أَهْلَكْنَٰهَا فَجَآءَهَا بَأْسُنَا بَيَٰتًا أَوْ هُمْ قَآئِلُونَ ","translation":"And how many cities have We destroyed, and Our punishment came to them at night or while they were sleeping at noon.","words":[{"id":1,"arabic":"وَكَم","translit":"mَkَw","root":""},{"id":2,"arabic":"مِّن","translit":"nِّm","root":""},{"id":3,"arabic":"قَرْيَةٍ","translit":"ٍẗَyْrَq","root":"قري"},{"id":4,"arabic":"أَهْلَكْنَٰهَا","translit":"āَhَٰnْkَlْhَaʾ","root":"هلك"},{"id":5,"arabic":"فَجَآءَهَا","translit":"āَhَءٓāَjgَf","root":"جيا"},{"id":6,"arabic":"بَأْسُنَا","translit":"āَnُsْaʾَb","root":"باس"},{"id":7,"arabic":"بَيَٰتًا","translit":"āًtَٰyَb","root":"بيت"},{"id":8,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":9,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":10,"arabic":"قَآئِلُونَ","translit":"َnwُlِyʾٓāَq","root":"قيل"}],"hasIhya":false},{"ayah":5,"text":"فَمَا كَانَ دَعْوَىٰهُمْ إِذْ جَآءَهُم بَأْسُنَآ إِلَّآ أَن قَالُوٓا۟ إِنَّا كُنَّا ظَٰلِمِينَ ","translation":"And their declaration when Our punishment came to them was only that they said, \"Indeed, we were wrongdoers!\"","words":[{"id":1,"arabic":"فَمَا","translit":"āَmَf","root":""},{"id":2,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":3,"arabic":"دَعْوَىٰهُمْ","translit":"ْmُhٰàَwْʿعَd","root":"دعو"},{"id":4,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":5,"arabic":"جَآءَهُم","translit":"mُhَءٓāَjg","root":"جيا"},{"id":6,"arabic":"بَأْسُنَآ","translit":"ٓāَnُsْaʾَb","root":"باس"},{"id":7,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":8,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":9,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":10,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":11,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":12,"arabic":"ظَٰلِمِينَ","translit":"َnyِmِlَٰẓ","root":"ظلم"}],"hasIhya":false},{"ayah":6,"text":"فَلَنَسْـَٔلَنَّ ٱلَّذِينَ أُرْسِلَ إِلَيْهِمْ وَلَنَسْـَٔلَنَّ ٱلْمُرْسَلِينَ ","translation":"Then We will surely question those to whom [a message] was sent, and We will surely question the messengers.","words":[{"id":1,"arabic":"فَلَنَسْـَٔلَنَّ","translit":"َّnَlَٔـْsَnَlَf","root":"سال"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"أُرْسِلَ","translit":"َlِsْrُaʾ","root":"رسل"},{"id":4,"arabic":"إِلَيْهِمْ","translit":"ْmِhْyَlِiʾ","root":""},{"id":5,"arabic":"وَلَنَسْـَٔلَنَّ","translit":"َّnَlَٔـْsَnَlَw","root":"سال"},{"id":6,"arabic":"ٱلْمُرْسَلِينَ","translit":"َnyِlَsْrُmْlٱ","root":"رسل"}],"hasIhya":true},{"ayah":7,"text":"فَلَنَقُصَّنَّ عَلَيْهِم بِعِلْمٍۖ وَمَا كُنَّا غَآئِبِينَ ","translation":"Then We will surely relate [their deeds] to them with knowledge, and We were not [at all] absent.","words":[{"id":1,"arabic":"فَلَنَقُصَّنَّ","translit":"َّnَّṣُqَnَlَf","root":"قصص"},{"id":2,"arabic":"عَلَيْهِم","translit":"mِhْyَlَʿع","root":""},{"id":3,"arabic":"بِعِلْمٍ","translit":"ٍmْlِʿعِb","root":"علم"},{"id":4,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":5,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":6,"arabic":"غَآئِبِينَ","translit":"َnyِbِyʾٓāَغ","root":"غيب"}],"hasIhya":false},{"ayah":8,"text":"وَٱلْوَزْنُ يَوْمَئِذٍ ٱلْحَقُّۚ فَمَن ثَقُلَتْ مَوَٰزِينُهُۥ فَأُو۟لَٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ ","translation":"And the weighing [of deeds] that Day will be the truth. So those whose scales are heavy - it is they who will be the successful.","words":[{"id":1,"arabic":"وَٱلْوَزْنُ","translit":"ُnْzَwْlٱَw","root":"وزن"},{"id":2,"arabic":"يَوْمَئِذٍ","translit":"ٍhdِyʾَmْwَy","root":"يوم"},{"id":3,"arabic":"ٱلْحَقُّ","translit":"ُّqَḥْlٱ","root":"حقق"},{"id":4,"arabic":"فَمَن","translit":"nَmَf","root":""},{"id":5,"arabic":"ثَقُلَتْ","translit":"ْtَlُqَht","root":"ثقل"},{"id":6,"arabic":"مَوَٰزِينُهُۥ","translit":"ۥُhُnyِzَٰwَm","root":"وزن"},{"id":7,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":8,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":9,"arabic":"ٱلْمُفْلِحُونَ","translit":"َnwُḥِlْfُmْlٱ","root":"فلح"}],"hasIhya":true},{"ayah":9,"text":"وَمَنْ خَفَّتْ مَوَٰزِينُهُۥ فَأُو۟لَٰٓئِكَ ٱلَّذِينَ خَسِرُوٓا۟ أَنفُسَهُم بِمَا كَانُوا۟ بِـَٔايَٰتِنَا يَظْلِمُونَ ","translation":"And those whose scales are light - they are the ones who will lose themselves for what injustice they were doing toward Our verses.","words":[{"id":1,"arabic":"وَمَنْ","translit":"ْnَmَw","root":""},{"id":2,"arabic":"خَفَّتْ","translit":"ْtَّfَhk","root":"خفف"},{"id":3,"arabic":"مَوَٰزِينُهُۥ","translit":"ۥُhُnyِzَٰwَm","root":"وزن"},{"id":4,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":5,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":6,"arabic":"خَسِرُوٓا۟","translit":"۟āٓwُrِsَhk","root":"خسر"},{"id":7,"arabic":"أَنفُسَهُم","translit":"mُhَsُfnَaʾ","root":"نفس"},{"id":8,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":9,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":10,"arabic":"بِـَٔايَٰتِنَا","translit":"āَnِtَٰyāَٔـِb","root":"ايي"},{"id":11,"arabic":"يَظْلِمُونَ","translit":"َnwُmِlْẓَy","root":"ظلم"}],"hasIhya":false},{"ayah":10,"text":"وَلَقَدْ مَكَّنَّٰكُمْ فِى ٱلْأَرْضِ وَجَعَلْنَا لَكُمْ فِيهَا مَعَٰيِشَۗ قَلِيلًا مَّا تَشْكُرُونَ ","translation":"And We have certainly established you upon the earth and made for you therein ways of livelihood. Little are you grateful.","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"مَكَّنَّٰكُمْ","translit":"ْmُkَّٰnَّkَm","root":"مكن"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":5,"arabic":"وَجَعَلْنَا","translit":"āَnْlَʿعَjgَw","root":"جعل"},{"id":6,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":7,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":8,"arabic":"مَعَٰيِشَ","translit":"َhsِyَٰʿعَm","root":"عيش"},{"id":9,"arabic":"قَلِيلًا","translit":"āًlyِlَq","root":"قلل"},{"id":10,"arabic":"مَّا","translit":"āَّm","root":""},{"id":11,"arabic":"تَشْكُرُونَ","translit":"َnwُrُkْhsَt","root":"شكر"}],"hasIhya":true},{"ayah":11,"text":"وَلَقَدْ خَلَقْنَٰكُمْ ثُمَّ صَوَّرْنَٰكُمْ ثُمَّ قُلْنَا لِلْمَلَٰٓئِكَةِ ٱسْجُدُوا۟ لِءَادَمَ فَسَجَدُوٓا۟ إِلَّآ إِبْلِيسَ لَمْ يَكُن مِّنَ ٱلسَّٰجِدِينَ ","translation":"And We have certainly created you, [O mankind], and given you [human] form. Then We said to the angels, \"Prostrate to Adam\"; so they prostrated, except for Iblees.[1] He was not of those who prostrated.","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"خَلَقْنَٰكُمْ","translit":"ْmُkَٰnْqَlَhk","root":"خلق"},{"id":3,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":4,"arabic":"صَوَّرْنَٰكُمْ","translit":"ْmُkَٰnْrَّwَṣ","root":"صور"},{"id":5,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":6,"arabic":"قُلْنَا","translit":"āَnْlُq","root":"قول"},{"id":7,"arabic":"لِلْمَلَٰٓئِكَةِ","translit":"ِẗَkِyʾَٰٓlَmْlِl","root":"ملك"},{"id":8,"arabic":"ٱسْجُدُوا۟","translit":"۟āwُdُjgْsٱ","root":"سجد"},{"id":9,"arabic":"لِءَادَمَ","translit":"َmَdāَءِl","root":"ادم"},{"id":10,"arabic":"فَسَجَدُوٓا۟","translit":"۟āٓwُdَjgَsَf","root":"سجد"},{"id":11,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":12,"arabic":"إِبْلِيسَ","translit":"َsyِlْbِiʾ","root":""},{"id":13,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":14,"arabic":"يَكُن","translit":"nُkَy","root":"كون"},{"id":15,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":16,"arabic":"ٱلسَّٰجِدِينَ","translit":"َnyِdِjgَّٰslٱ","root":"سجد"}],"hasIhya":false},{"ayah":12,"text":"قَالَ مَا مَنَعَكَ أَلَّا تَسْجُدَ إِذْ أَمَرْتُكَۖ قَالَ أَنَا۠ خَيْرٌ مِّنْهُ خَلَقْتَنِى مِن نَّارٍ وَخَلَقْتَهُۥ مِن طِينٍ ","translation":"[Allāh] said, \"What prevented you from prostrating when I commanded you?\" [Satan] said, \"I am better than him. You created me from fire and created him from clay [i.e., earth].\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"مَا","translit":"āَm","root":""},{"id":3,"arabic":"مَنَعَكَ","translit":"َkَʿعَnَm","root":"منع"},{"id":4,"arabic":"أَلَّا","translit":"āَّlَaʾ","root":""},{"id":5,"arabic":"تَسْجُدَ","translit":"َdُjgْsَt","root":"سجد"},{"id":6,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":7,"arabic":"أَمَرْتُكَ","translit":"َkُtْrَmَaʾ","root":"امر"},{"id":8,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":9,"arabic":"أَنَا۠","translit":"۠āَnَaʾ","root":""},{"id":10,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":11,"arabic":"مِّنْهُ","translit":"ُhْnِّm","root":""},{"id":12,"arabic":"خَلَقْتَنِى","translit":"àِnَtْqَlَhk","root":"خلق"},{"id":13,"arabic":"مِن","translit":"nِm","root":""},{"id":14,"arabic":"نَّارٍ","translit":"ٍrāَّn","root":"نور"},{"id":15,"arabic":"وَخَلَقْتَهُۥ","translit":"ۥُhَtْqَlَhkَw","root":"خلق"},{"id":16,"arabic":"مِن","translit":"nِm","root":""},{"id":17,"arabic":"طِينٍ","translit":"ٍnyِṭ","root":"طين"}],"hasIhya":true},{"ayah":13,"text":"قَالَ فَٱهْبِطْ مِنْهَا فَمَا يَكُونُ لَكَ أَن تَتَكَبَّرَ فِيهَا فَٱخْرُجْ إِنَّكَ مِنَ ٱلصَّٰغِرِينَ ","translation":"[Allāh] said, \"Descend from it [i.e., Paradise], for it is not for you to be arrogant therein. So get out; indeed, you are of the debased.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"فَٱهْبِطْ","translit":"ْṭِbْhٱَf","root":"هبط"},{"id":3,"arabic":"مِنْهَا","translit":"āَhْnِ