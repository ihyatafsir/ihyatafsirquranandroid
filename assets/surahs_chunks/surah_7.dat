},{"id":9,"arabic":"وَتَرْحَمْنَا","translit":"āَnْmَḥْrَtَw","root":"رحم"},{"id":10,"arabic":"لَنَكُونَنَّ","translit":"َّnَnwُkَnَl","root":"كون"},{"id":11,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":12,"arabic":"ٱلْخَٰسِرِينَ","translit":"َnyِrِsَٰhkْlٱ","root":"خسر"}],"hasIhya":false},{"ayah":24,"text":"قَالَ ٱهْبِطُوا۟ بَعْضُكُمْ لِبَعْضٍ عَدُوٌّۖ وَلَكُمْ فِى ٱلْأَرْضِ مُسْتَقَرٌّ وَمَتَٰعٌ إِلَىٰ حِينٍ ","translation":"[Allāh] said, \"Descend, being to one another enemies. And for you on the earth is a place of settlement and enjoyment [i.e., provision] for a time.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"ٱهْبِطُوا۟","translit":"۟āwُṭِbْhٱ","root":"هبط"},{"id":3,"arabic":"بَعْضُكُمْ","translit":"ْmُkُḍْʿعَb","root":"بعض"},{"id":4,"arabic":"لِبَعْضٍ","translit":"ٍḍْʿعَbِl","root":"بعض"},{"id":5,"arabic":"عَدُوٌّ","translit":"ٌّwُdَʿع","root":"عدو"},{"id":6,"arabic":"وَلَكُمْ","translit":"ْmُkَlَw","root":""},{"id":7,"arabic":"فِى","translit":"àِf","root":""},{"id":8,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":9,"arabic":"مُسْتَقَرٌّ","translit":"ٌّrَqَtْsُm","root":"قرر"},{"id":10,"arabic":"وَمَتَٰعٌ","translit":"ٌʿعَٰtَmَw","root":"متع"},{"id":11,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":12,"arabic":"حِينٍ","translit":"ٍnyِḥ","root":"حين"}],"hasIhya":false},{"ayah":25,"text":"قَالَ فِيهَا تَحْيَوْنَ وَفِيهَا تَمُوتُونَ وَمِنْهَا تُخْرَجُونَ ","translation":"He said, \"Therein you will live, and therein you will die, and from it you will be brought forth.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":3,"arabic":"تَحْيَوْنَ","translit":"َnْwَyْḥَt","root":"حيي"},{"id":4,"arabic":"وَفِيهَا","translit":"āَhyِfَw","root":""},{"id":5,"arabic":"تَمُوتُونَ","translit":"َnwُtwُmَt","root":"موت"},{"id":6,"arabic":"وَمِنْهَا","translit":"āَhْnِmَw","root":""},{"id":7,"arabic":"تُخْرَجُونَ","translit":"َnwُjgَrْhkُt","root":"خرج"}],"hasIhya":false},{"ayah":26,"text":"يَٰبَنِىٓ ءَادَمَ قَدْ أَنزَلْنَا عَلَيْكُمْ لِبَاسًا يُوَٰرِى سَوْءَٰتِكُمْ وَرِيشًاۖ وَلِبَاسُ ٱلتَّقْوَىٰ ذَٰلِكَ خَيْرٌۚ ذَٰلِكَ مِنْ ءَايَٰتِ ٱللَّهِ لَعَلَّهُمْ يَذَّكَّرُونَ ","translation":"O children of Adam, We have bestowed upon you clothing to conceal your private parts and as adornment. But the clothing of righteousness - that is best. That is from the signs of Allāh that perhaps they will remember.","words":[{"id":1,"arabic":"يَٰبَنِىٓ","translit":"ٓàِnَbَٰy","root":"بني"},{"id":2,"arabic":"ءَادَمَ","translit":"َmَdāَء","root":"ادم"},{"id":3,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":4,"arabic":"أَنزَلْنَا","translit":"āَnْlَznَaʾ","root":"نزل"},{"id":5,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":6,"arabic":"لِبَاسًا","translit":"āًsāَbِl","root":"لبس"},{"id":7,"arabic":"يُوَٰرِى","translit":"àِrَٰwُy","root":"وري"},{"id":8,"arabic":"سَوْءَٰتِكُمْ","translit":"ْmُkِtَٰءْwَs","root":"سوا"},{"id":9,"arabic":"وَرِيشًا","translit":"āًhsyِrَw","root":"ريش"},{"id":10,"arabic":"وَلِبَاسُ","translit":"ُsāَbِlَw","root":"لبس"},{"id":11,"arabic":"ٱلتَّقْوَىٰ","translit":"ٰàَwْqَّtlٱ","root":"وقي"},{"id":12,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":13,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":14,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":15,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":16,"arabic":"ءَايَٰتِ","translit":"ِtَٰyāَء","root":"ايي"},{"id":17,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":18,"arabic":"لَعَلَّهُمْ","translit":"ْmُhَّlَʿعَl","root":""},{"id":19,"arabic":"يَذَّكَّرُونَ","translit":"َnwُrَّkَّhdَy","root":"ذكر"}],"hasIhya":true},{"ayah":27,"text":"يَٰبَنِىٓ ءَادَمَ لَا يَفْتِنَنَّكُمُ ٱلشَّيْطَٰنُ كَمَآ أَخْرَجَ أَبَوَيْكُم مِّنَ ٱلْجَنَّةِ يَنزِعُ عَنْهُمَا لِبَاسَهُمَا لِيُرِيَهُمَا سَوْءَٰتِهِمَآۗ إِنَّهُۥ يَرَىٰكُمْ هُوَ وَقَبِيلُهُۥ مِنْ حَيْثُ لَا تَرَوْنَهُمْۗ إِنَّا جَعَلْنَا ٱلشَّيَٰطِينَ أَوْلِيَآءَ لِلَّذِينَ لَا يُؤْمِنُونَ ","translation":"O children of Adam, let not Satan tempt you as he removed your parents from Paradise, stripping them of their clothing[1] to show them their private parts. Indeed, he sees you, he and his tribe, from where you do not see them. Indeed, We have made the devils allies to those who do not believe.","words":[{"id":1,"arabic":"يَٰبَنِىٓ","translit":"ٓàِnَbَٰy","root":"بني"},{"id":2,"arabic":"ءَادَمَ","translit":"َmَdāَء","root":"ادم"},{"id":3,"arabic":"لَا","translit":"āَl","root":""},{"id":4,"arabic":"يَفْتِنَنَّكُمُ","translit":"ُmُkَّnَnِtْfَy","root":"فتن"},{"id":5,"arabic":"ٱلشَّيْطَٰنُ","translit":"ُnَٰṭْyَّhslٱ","root":"شطن"},{"id":6,"arabic":"كَمَآ","translit":"ٓāَmَk","root":""},{"id":7,"arabic":"أَخْرَجَ","translit":"َjgَrْhkَaʾ","root":"خرج"},{"id":8,"arabic":"أَبَوَيْكُم","translit":"mُkْyَwَbَaʾ","root":"ابو"},{"id":9,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":10,"arabic":"ٱلْجَنَّةِ","translit":"ِẗَّnَjgْlٱ","root":"جنن"},{"id":11,"arabic":"يَنزِعُ","translit":"ُʿعِznَy","root":"نزع"},{"id":12,"arabic":"عَنْهُمَا","translit":"āَmُhْnَʿع","root":""},{"id":13,"arabic":"لِبَاسَهُمَا","translit":"āَmُhَsāَbِl","root":"لبس"},{"id":14,"arabic":"لِيُرِيَهُمَا","translit":"āَmُhَyِrُyِl","root":"راي"},{"id":15,"arabic":"سَوْءَٰتِهِمَآ","translit":"ٓāَmِhِtَٰءْwَs","root":"سوا"},{"id":16,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":17,"arabic":"يَرَىٰكُمْ","translit":"ْmُkٰàَrَy","root":"راي"},{"id":18,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":19,"arabic":"وَقَبِيلُهُۥ","translit":"ۥُhُlyِbَqَw","root":"قبل"},{"id":20,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":21,"arabic":"حَيْثُ","translit":"ُhtْyَḥ","root":"حيث"},{"id":22,"arabic":"لَا","translit":"āَl","root":""},{"id":23,"arabic":"تَرَوْنَهُمْ","translit":"ْmُhَnْwَrَt","root":"راي"},{"id":24,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":25,"arabic":"جَعَلْنَا","translit":"āَnْlَʿعَjg","root":"جعل"},{"id":26,"arabic":"ٱلشَّيَٰطِينَ","translit":"َnyِṭَٰyَّhslٱ","root":"شطن"},{"id":27,"arabic":"أَوْلِيَآءَ","translit":"َءٓāَyِlْwَaʾ","root":"ولي"},{"id":28,"arabic":"لِلَّذِينَ","translit":"َnyِhdَّlِl","root":""},{"id":29,"arabic":"لَا","translit":"āَl","root":""},{"id":30,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"}],"hasIhya":true},{"ayah":28,"text":"وَإِذَا فَعَلُوا۟ فَٰحِشَةً قَالُوا۟ وَجَدْنَا عَلَيْهَآ ءَابَآءَنَا وَٱللَّهُ أَمَرَنَا بِهَاۗ قُلْ إِنَّ ٱللَّهَ لَا يَأْمُرُ بِٱلْفَحْشَآءِۖ أَتَقُولُونَ عَلَى ٱللَّهِ مَا لَا تَعْلَمُونَ ","translation":"And when they commit an immorality, they say, \"We found our fathers doing it, and Allāh has ordered us to do it.\" Say, \"Indeed, Allāh does not order immorality. Do you say about Allāh that which you do not know?\"","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"فَعَلُوا۟","translit":"۟āwُlَʿعَf","root":"فعل"},{"id":3,"arabic":"فَٰحِشَةً","translit":"ًẗَhsِḥَٰf","root":"فحش"},{"id":4,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":5,"arabic":"وَجَدْنَا","translit":"āَnْdَjgَw","root":"وجد"},{"id":6,"arabic":"عَلَيْهَآ","translit":"ٓāَhْyَlَʿع","root":""},{"id":7,"arabic":"ءَابَآءَنَا","translit":"āَnَءٓāَbāَء","root":"ابو"},{"id":8,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":9,"arabic":"أَمَرَنَا","translit":"āَnَrَmَaʾ","root":"امر"},{"id":10,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":11,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":12,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":13,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":14,"arabic":"لَا","translit":"āَl","root":""},{"id":15,"arabic":"يَأْمُرُ","translit":"ُrُmْaʾَy","root":"امر"},{"id":16,"arabic":"بِٱلْفَحْشَآءِ","translit":"ِءٓāَhsْḥَfْlٱِb","root":"فحش"},{"id":17,"arabic":"أَتَقُولُونَ","translit":"َnwُlwُqَtَaʾ","root":"قول"},{"id":18,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":19,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":20,"arabic":"مَا","translit":"āَm","root":""},{"id":21,"arabic":"لَا","translit":"āَl","root":""},{"id":22,"arabic":"تَعْلَمُونَ","translit":"َnwُmَlْʿعَt","root":"علم"}],"hasIhya":true},{"ayah":29,"text":"قُلْ أَمَرَ رَبِّى بِٱلْقِسْطِۖ وَأَقِيمُوا۟ وُجُوهَكُمْ عِندَ كُلِّ مَسْجِدٍ وَٱدْعُوهُ مُخْلِصِينَ لَهُ ٱلدِّينَۚ كَمَا بَدَأَكُمْ تَعُودُونَ ","translation":"Say, [O Muḥammad], \"My Lord has ordered justice and that you direct yourselves [to the Qiblah] at every place [or time] of prostration, and invoke Him, sincere to Him in religion.\" Just as He originated you, you will return [to life] -","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"أَمَرَ","translit":"َrَmَaʾ","root":"امر"},{"id":3,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":4,"arabic":"بِٱلْقِسْطِ","translit":"ِṭْsِqْlٱِb","root":"قسط"},{"id":5,"arabic":"وَأَقِيمُوا۟","translit":"۟āwُmyِqَaʾَw","root":"قوم"},{"id":6,"arabic":"وُجُوهَكُمْ","translit":"ْmُkَhwُjgُw","root":"وجه"},{"id":7,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":8,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":9,"arabic":"مَسْجِدٍ","translit":"ٍdِjgْsَm","root":"سجد"},{"id":10,"arabic":"وَٱدْعُوهُ","translit":"ُhwُʿعْdٱَw","root":"دعو"},{"id":11,"arabic":"مُخْلِصِينَ","translit":"َnyِṣِlْhkُm","root":"خلص"},{"id":12,"arabic":"لَهُ","translit":"ُhَl","root":""},{"id":13,"arabic":"ٱلدِّينَ","translit":"َnyِّdlٱ","root":"دين"},{"id":14,"arabic":"كَمَا","translit":"āَmَk","root":""},{"id":15,"arabic":"بَدَأَكُمْ","translit":"ْmُkَaʾَdَb","root":"بدا"},{"id":16,"arabic":"تَعُودُونَ","translit":"َnwُdwُʿعَt","root":"عود"}],"hasIhya":false},{"ayah":30,"text":"فَرِيقًا هَدَىٰ وَفَرِيقًا حَقَّ عَلَيْهِمُ ٱلضَّلَٰلَةُۗ إِنَّهُمُ ٱتَّخَذُوا۟ ٱلشَّيَٰطِينَ أَوْلِيَآءَ مِن دُونِ ٱللَّهِ وَيَحْسَبُونَ أَنَّهُم مُّهْتَدُونَ ","translation":"A group [of you] He guided, and a group deserved [to be in] error. Indeed, they [i.e., the latter] had taken the devils as allies instead of Allāh while they thought that they were guided.","words":[{"id":1,"arabic":"فَرِيقًا","translit":"āًqyِrَf","root":"فرق"},{"id":2,"arabic":"هَدَىٰ","translit":"ٰàَdَh","root":"هدي"},{"id":3,"arabic":"وَفَرِيقًا","translit":"āًqyِrَfَw","root":"فرق"},{"id":4,"arabic":"حَقَّ","translit":"َّqَḥ","root":"حقق"},{"id":5,"arabic":"عَلَيْهِمُ","translit":"ُmِhْyَlَʿع","root":""},{"id":6,"arabic":"ٱلضَّلَٰلَةُ","translit":"ُẗَlَٰlَّḍlٱ","root":"ضلل"},{"id":7,"arabic":"إِنَّهُمُ","translit":"ُmُhَّnِiʾ","root":""},{"id":8,"arabic":"ٱتَّخَذُوا۟","translit":"۟āwُhdَhkَّtٱ","root":"اخذ"},{"id":9,"arabic":"ٱلشَّيَٰطِينَ","translit":"َnyِṭَٰyَّhslٱ","root":"شطن"},{"id":10,"arabic":"أَوْلِيَآءَ","translit":"َءٓāَyِlْwَaʾ","root":"ولي"},{"id":11,"arabic":"مِن","translit":"nِm","root":""},{"id":12,"arabic":"دُونِ","translit":"ِnwُd","root":"دون"},{"id":13,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":14,"arabic":"وَيَحْسَبُونَ","translit":"َnwُbَsْḥَyَw","root":"حسب"},{"id":15,"arabic":"أَنَّهُم","translit":"mُhَّnَaʾ","root":""},{"id":16,"arabic":"مُّهْتَدُونَ","translit":"َnwُdَtْhُّm","root":"هدي"}],"hasIhya":false},{"ayah":31,"text":"يَٰبَنِىٓ ءَادَمَ خُذُوا۟ زِينَتَكُمْ عِندَ كُلِّ مَسْجِدٍ وَكُلُوا۟ وَٱشْرَبُوا۟ وَلَا تُسْرِفُوٓا۟ۚ إِنَّهُۥ لَا يُحِبُّ ٱلْمُسْرِفِينَ ","translation":"O children of Adam, take your adornment [i.e., wear your clothing] at every masjid,[1] and eat and drink, but be not excessive. Indeed, He likes not those who commit excess.","words":[{"id":1,"arabic":"يَٰبَنِىٓ","translit":"ٓàِnَbَٰy","root":"بني"},{"id":2,"arabic":"ءَادَمَ","translit":"َmَdāَء","root":"ادم"},{"id":3,"arabic":"خُذُوا۟","translit":"۟āwُhdُhk","root":"اخذ"},{"id":4,"arabic":"زِينَتَكُمْ","translit":"ْmُkَtَnyِz","root":"زين"},{"id":5,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":6,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":7,"arabic":"مَسْجِدٍ","translit":"ٍdِjgْsَm","root":"سجد"},{"id":8,"arabic":"وَكُلُوا۟","translit":"۟āwُlُkَw","root":"اكل"},{"id":9,"arabic":"وَٱشْرَبُوا۟","translit":"۟āwُbَrْhsٱَw","root":"شرب"},{"id":10,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":11,"arabic":"تُسْرِفُوٓا۟","translit":"۟āٓwُfِrْsُt","root":"سرف"},{"id":12,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":13,"arabic":"لَا","translit":"āَl","root":""},{"id":14,"arabic":"يُحِبُّ","translit":"ُّbِḥُy","root":"حبب"},{"id":15,"arabic":"ٱلْمُسْرِفِينَ","translit":"َnyِfِrْsُmْlٱ","root":"سرف"}],"hasIhya":true},{"ayah":32,"text":"قُلْ مَنْ حَرَّمَ زِينَةَ ٱللَّهِ ٱلَّتِىٓ أَخْرَجَ لِعِبَادِهِۦ وَٱلطَّيِّبَٰتِ مِنَ ٱلرِّزْقِۚ قُلْ هِىَ لِلَّذِينَ ءَامَنُوا۟ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا خَالِصَةً يَوْمَ ٱلْقِيَٰمَةِۗ كَذَٰلِكَ نُفَصِّلُ ٱلْءَايَٰتِ لِقَوْمٍ يَعْلَمُونَ ","translation":"Say, \"Who has forbidden the adornment of [i.e., from] Allāh which He has produced for His servants and the good [lawful] things of provision?\" Say, \"They are for those who believed during the life of this world, exclusively [for them] on the Day of Resurrection.\" Thus do We detail the verses for a people who know.","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"مَنْ","translit":"ْnَm","root":""},{"id":3,"arabic":"حَرَّمَ","translit":"َmَّrَḥ","root":"حرم"},{"id":4,"arabic":"زِينَةَ","translit":"َẗَnyِz","root":"زين"},{"id":5,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":6,"arabic":"ٱلَّتِىٓ","translit":"ٓàِtَّlٱ","root":""},{"id":7,"arabic":"أَخْرَجَ","translit":"َjgَrْhkَaʾ","root":"خرج"},{"id":8,"arabic":"لِعِبَادِهِۦ","translit":"ۦِhِdāَbِʿعِl","root":"عبد"},{"id":9,"arabic":"وَٱلطَّيِّبَٰتِ","translit":"ِtَٰbِّyَّṭlٱَw","root":"طيب"},{"id":10,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":11,"arabic":"ٱلرِّزْقِ","translit":"ِqْzِّrlٱ","root":"رزق"},{"id":12,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":13,"arabic":"هِىَ","translit":"َàِh","root":""},{"id":14,"arabic":"لِلَّذِينَ","translit":"َnyِhdَّlِl","root":""},{"id":15,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":16,"arabic":"فِى","translit":"àِf","root":""},{"id":17,"arabic":"ٱلْحَيَوٰةِ","translit":"ِẗٰwَyَḥْlٱ","root":"حيي"},{"id":18,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":19,"arabic":"خَالِصَةً","translit":"ًẗَṣِlāَhk","root":"خلص"},{"id":20,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":21,"arabic":"ٱلْقِيَٰمَةِ","translit":"ِẗَmَٰyِqْlٱ","root":"قوم"},{"id":22,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":23,"arabic":"نُفَصِّلُ","translit":"ُlِّṣَfُn","root":"فصل"},{"id":24,"arabic":"ٱلْءَايَٰتِ","translit":"ِtَٰyāَءْlٱ","root":"ايي"},{"id":25,"arabic":"لِقَوْمٍ","translit":"ٍmْwَqِl","root":"قوم"},{"id":26,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":true},{"ayah":33,"text":"قُلْ إِنَّمَا حَرَّمَ رَبِّىَ ٱلْفَوَٰحِشَ مَا ظَهَرَ مِنْهَا وَمَا بَطَنَ وَٱلْإِثْمَ وَٱلْبَغْىَ بِغَيْرِ ٱلْحَقِّ وَأَن تُشْرِكُوا۟ بِٱللَّهِ مَا لَمْ يُنَزِّلْ بِهِۦ سُلْطَٰنًا وَأَن تَقُولُوا۟ عَلَى ٱللَّهِ مَا لَا تَعْلَمُونَ ","translation":"Say, \"My Lord has only forbidden immoralities - what is apparent of them and what is concealed - and sin,[1] and oppression without right, and that you associate with Allāh that for which He has not sent down authority, and that you say about Allāh that which you do not know.\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"إِنَّمَا","translit":"āَmَّnِiʾ","root":""},{"id":3,"arabic":"حَرَّمَ","translit":"َmَّrَḥ","root":"حرم"},{"id":4,"arabic":"رَبِّىَ","translit":"َàِّbَr","root":"ربب"},{"id":5,"arabic":"ٱلْفَوَٰحِشَ","translit":"َhsِḥَٰwَfْlٱ","root":"فحش"},{"id":6,"arabic":"مَا","translit":"āَm","root":""},{"id":7,"arabic":"ظَهَرَ","translit":"َrَhَẓ","root":"ظهر"},{"id":8,"arabic":"مِنْهَا","translit":"āَhْnِm","root":""},{"id":9,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":10,"arabic":"بَطَنَ","translit":"َnَṭَb","root":"بطن"},{"id":11,"arabic":"وَٱلْإِثْمَ","translit":"َmْhtِiʾْlٱَw","root":"اثم"},{"id":12,"arabic":"وَٱلْبَغْىَ","translit":"َàْغَbْlٱَw","root":"بغي"},{"id":13,"arabic":"بِغَيْرِ","translit":"ِrْyَغِb","root":"غير"},{"id":14,"arabic":"ٱلْحَقِّ","translit":"ِّqَḥْlٱ","root":"حقق"},{"id":15,"arabic":"وَأَن","translit":"nَaʾَw","root":""},{"id":16,"arabic":"تُشْرِكُوا۟","translit":"۟āwُkِrْhsُt","root":"شرك"},{"id":17,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":18,"arabic":"مَا","translit":"āَm","root":""},{"id":19,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":20,"arabic":"يُنَزِّلْ","translit":"ْlِّzَnُy","root":"نزل"},{"id":21,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":22,"arabic":"سُلْطَٰنًا","translit":"āًnَٰṭْlُs","root":"سلط"},{"id":23,"arabic":"وَأَن","translit":"nَaʾَw","root":""},{"id":24,"arabic":"تَقُولُوا۟","translit":"۟āwُlwُqَt","root":"قول"},{"id":25,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":26,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":27,"arabic":"مَا","translit":"āَm","root":""},{"id":28,"arabic":"لَا","translit":"āَl","root":""},{"id":29,"arabic":"تَعْلَمُونَ","translit":"َnwُmَlْʿعَt","root":"علم"}],"hasIhya":true},{"ayah":34,"text":"وَلِكُلِّ أُمَّةٍ أَجَلٌۖ فَإِذَا جَآءَ أَجَلُهُمْ لَا يَسْتَأْخِرُونَ سَاعَةًۖ وَلَا يَسْتَقْدِمُونَ ","translation":"And for every nation is a [specified] term. So when their time has come, they will not remain behind an hour, nor will they precede [it].","words":[{"id":1,"arabic":"وَلِكُلِّ","translit":"ِّlُkِlَw","root":"كلل"},{"id":2,"arabic":"أُمَّةٍ","translit":"ٍẗَّmُaʾ","root":"امم"},{"id":3,"arabic":"أَجَلٌ","translit":"ٌlَjgَaʾ","root":"اجل"},{"id":4,"arabic":"فَإِذَا","translit":"āَhdِiʾَf","root":""},{"id":5,"arabic":"جَآءَ","translit":"َءٓāَjg","root":"جيا"},{"id":6,"arabic":"أَجَلُهُمْ","translit":"ْmُhُlَjgَaʾ","root":"اجل"},{"id":7,"arabic":"لَا","translit":"āَl","root":""},{"id":8,"arabic":"يَسْتَأْخِرُونَ","translit":"َnwُrِhkْaʾَtْsَy","root":"اخ