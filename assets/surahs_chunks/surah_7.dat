text": "اَوَلَمْ يَنظُرُواْ فِے مَلَكُوتِ اِ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا خَلَقَ اَ۬للَّهُ مِن شَےْءࣲ وَأَنْ عَس۪يٰٓ أَنْ يَّكُونَ قَدِ اِ۪قْتَرَبَ أَجَلُهُمْۖ فَبِأَيِّ حَدِيثِۢ بَعْدَهُۥ يُومِنُونَۖ", "words": [{"id": 1, "arabic": "اَوَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَنظُرُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "مَلَكُوتِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَالَارْضِ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 8, "arabic": "خَلَقَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِن", "translit": "", "root": ""}, {"id": 11, "arabic": "شَےْءࣲ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَأَنْ", "translit": "", "root": ""}, {"id": 13, "arabic": "عَس۪يٰٓ", "translit": "", "root": ""}, {"id": 14, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 15, "arabic": "يَّكُونَ", "translit": "", "root": ""}, {"id": 16, "arabic": "قَدِ", "translit": "", "root": ""}, {"id": 17, "arabic": "اِ۪قْتَرَبَ", "translit": "", "root": ""}, {"id": 18, "arabic": "أَجَلُهُمْۖ", "translit": "", "root": ""}, {"id": 19, "arabic": "فَبِأَيِّ", "translit": "", "root": ""}, {"id": 20, "arabic": "حَدِيثِۢ", "translit": "", "root": ""}, {"id": 21, "arabic": "بَعْدَهُۥ", "translit": "", "root": ""}, {"id": 22, "arabic": "يُومِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 186, "text": "مَنْ يُّضْلِلِ اِ۬للَّهُ فَلَا هَادِيَ لَهُۥۖ وَنَذَرُهُمْ فِے طُغْيَٰنِهِمْ يَعْمَهُونَۖ", "words": [{"id": 1, "arabic": "مَنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يُّضْلِلِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬للَّهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 5, "arabic": "هَادِيَ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَهُۥۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَنَذَرُهُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "طُغْيَٰنِهِمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "يَعْمَهُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 187, "text": "يَسْـَٔلُونَكَ عَنِ اِ۬لسَّاعَةِ أَيَّانَ مُرْس۪يٰهَاۖ قُلِ اِنَّمَا عِلْمُهَا عِندَ رَبِّےۖ لَا يُجَلِّيهَا لِوَقْتِهَآ إِلَّا هُوَۖ ثَقُلَتْ فِے اِ۬لسَّمَٰوَٰتِ وَالَارْضِۖ لَا تَاتِيكُمُۥٓ إِلَّا بَغْتَةࣰۖ يَسْـَٔلُونَكَ كَأَنَّكَ حَفِيٌّ عَنْهَاۖ قُلِ اِنَّمَا عِلْمُهَا عِندَ اَ۬للَّهِۖ وَلَٰكِنَّ أَكْثَرَ اَ۬لنَّاسِ لَا يَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "يَسْـَٔلُونَكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَنِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لسَّاعَةِ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَيَّانَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُرْس۪يٰهَاۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "قُلِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِنَّمَا", "translit": "", "root": ""}, {"id": 8, "arabic": "عِلْمُهَا", "translit": "", "root": ""}, {"id": 9, "arabic": "عِندَ", "translit": "", "root": ""}, {"id": 10, "arabic": "رَبِّےۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "لَا", "translit": "", "root": ""}, {"id": 12, "arabic": "يُجَلِّيهَا", "translit": "", "root": ""}, {"id": 13, "arabic": "لِوَقْتِهَآ", "translit": "", "root": ""}, {"id": 14, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 15, "arabic": "هُوَۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "ثَقُلَتْ", "translit": "", "root": ""}, {"id": 17, "arabic": "فِے", "translit": "", "root": ""}, {"id": 18, "arabic": "اِ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 19, "arabic": "وَالَارْضِۖ", "translit": "", "root": ""}, {"id": 20, "arabic": "لَا", "translit": "", "root": ""}, {"id"