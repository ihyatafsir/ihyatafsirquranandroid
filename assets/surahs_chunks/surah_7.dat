rabic": "أَنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "يُّخْرِجَكُم", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَرْضِكُمْۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَمَاذَا", "translit": "", "root": ""}, {"id": 7, "arabic": "تَامُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 111, "text": "قَالُوٓاْ أَرْجِهِۦ وَأَخَاهُ وَأَرْسِلْ فِے اِ۬لْمَدَآئِنِ حَٰشِرِينَ", "words": [{"id": 1, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَرْجِهِۦ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَأَخَاهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَأَرْسِلْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لْمَدَآئِنِ", "translit": "", "root": ""}, {"id": 7, "arabic": "حَٰشِرِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 112, "text": "يَاتُوكَ بِكُلِّ سَٰحِرٍ عَلِيمࣲۖ", "words": [{"id": 1, "arabic": "يَاتُوكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِكُلِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "سَٰحِرٍ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلِيمࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 113, "text": "وَجَآءَ اَ۬لسَّحَرَةُ فِرْعَوْنَ قَالُوٓاْ إِنَّ لَنَا لَأَجْراً اِن كُنَّا نَحْنُ اُ۬لْغَٰلِبِينَۖ", "words": [{"id": 1, "arabic": "وَجَآءَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لسَّحَرَةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِرْعَوْنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "لَأَجْراً", "translit": "", "root": ""}, {"id": 8, "arabic": "اِن", "translit": "", "root": ""}, {"id": 9, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬لْغَٰلِبِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 114, "text": "قَالَ نَعَمْ وَإِنَّكُمْ لَمِنَ اَ۬لْمُقَرَّبِينَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَعَمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَإِنَّكُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَمِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْمُقَرَّبِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 115, "text": "قَالُواْ يَٰمُوس۪يٰٓ إِمَّآ أَن تُلْقِيَ وَإِمَّآ أَن نَّكُونَ نَحْنُ اُ۬لْمُلْقِينَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰمُوس۪يٰٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِمَّآ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "", "root": ""}, {"id": 5, "arabic": "تُلْقِيَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَإِمَّآ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَن", "translit": "", "root": ""}, {"id": 8, "arabic": "نَّكُونَ", "translit": "", "root": ""}, {"id": 9, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لْمُلْقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 116, "text": "قَالَ أَلْقُواْۖ فَلَمَّآ أَلْقَوْاْ سَحَرُوٓاْ أَعْيُنَ اَ۬لنَّاسِ وَاسْتَرْهَبُوهُمْۖ وَجَآءُو بِسِحْرٍ عَظِيمࣲۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَلْقُواْۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَلَمَّآ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَلْقَوْاْ", "translit": "", "root": ""}, {"id": 5, "arabic": "سَحَرُوٓاْ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَعْيُنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لنَّاسِ", "translit": "", "root": ""}, {"id": 8, "arabic":