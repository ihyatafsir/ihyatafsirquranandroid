": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 3, "arabic": "جَوَابَ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَوْمِهِۦٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَن", "translit": "", "root": ""}, {"id": 7, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَخْرِجُوهُم", "translit": "", "root": ""}, {"id": 9, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 10, "arabic": "قَرْيَتِكُمُۥٓۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِنَّهُمُۥٓ", "translit": "", "root": ""}, {"id": 12, "arabic": "أُنَاسࣱ", "translit": "", "root": ""}, {"id": 13, "arabic": "يَتَطَهَّرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 83, "text": "فَأَنجَيْنَٰهُ وَأَهْلَهُۥٓ إِلَّا اَ۪مْرَأَتَهُۥ كَانَتْ مِنَ اَ۬لْغَٰبِرِينَۖ", "words": [{"id": 1, "arabic": "فَأَنجَيْنَٰهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَأَهْلَهُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۪مْرَأَتَهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "كَانَتْ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْغَٰبِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 84, "text": "وَأَمْطَرْنَا عَلَيْهِم مَّطَراࣰۖ فَانظُرْ كَيْفَ كَانَ عَٰقِبَةُ اُ۬لْمُجْرِمِينَۖ", "words": [{"id": 1, "arabic": "وَأَمْطَرْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِم", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّطَراࣰۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَانظُرْ", "translit": "", "root": ""}, {"id": 5, "arabic": "كَيْفَ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَٰقِبَةُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لْمُجْرِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 7, "ayah": 85, "text": "وَإِلَيٰ مَدْيَنَ أَخَاهُمْ شُعَيْباࣰۖ قَالَ يَٰقَوْمِ اِ۟عْبُدُواْ اُ۬للَّهَ مَا لَكُم مِّنِ اِلَٰهٍ غَيْرُهُۥۖ قَدْ جَآءَتْكُم بَيِّنَةࣱ مِّن رَّبِّكُمْۖ فَأَوْفُواْ اُ۬لْكَيْلَ وَالْمِيزَانَۖ وَلَا تَبْخَسُواْ اُ۬لنَّاسَ أَشْيَآءَهُمْۖ وَلَا تُفْسِدُواْ فِے اِ۬لَارْضِ بَعْدَ إِصْلَٰحِهَاۖ ذَٰلِكُمْ خَيْرࣱ لَّكُمُۥٓ إِن كُنتُم مُّومِنِينَۖ", "words": [{"id": 1, "arabic": "وَإِلَيٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَدْيَنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَخَاهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "شُعَيْباࣰۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَٰقَوْمِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۟عْبُدُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬للَّهَ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَا", "translit": "", "root": ""}, {"id": 10, "arabic": "لَكُم", "translit": "", "root": ""}, {"id": 11, "arabic": "مِّنِ", "translit": "", "root": ""}, {"id": 12, "arabic": "اِلَٰهٍ", "translit": "", "root": ""}, {"id": 13, "arabic": "غَيْرُهُۥۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "قَدْ", "translit": "", "root": ""}, {"id": 15, "arabic": "جَآءَتْكُم", "translit": "", "root": ""}, {"id": 16, "arabic": "بَيِّنَةࣱ", "translit": "", "root": ""}, {"id": 17, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 18, "arabic": "رَّبِّكُمْۖ", "translit": "", "root": ""}, {"id": 19, "arabic": "فَأَوْفُواْ", "translit": "", "root": ""}, {"id": 20, "arabic": "اُ۬لْكَيْلَ", "translit": "", "root": ""}, {"id": 21, "arabic": "وَالْمِيزَانَۖ", "translit": "", "root": ""}, {"id": 22, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 23, "arabic": "تَبْخَسُواْ", "translit": "", "root": ""}, {"id": 24, "arabic": "اُ۬لنَّاسَ", "translit": "", "root": ""}, {"id": 25, "arabic": "أَشْيَآءَهُمْۖ