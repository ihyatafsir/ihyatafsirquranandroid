:"وَأَنَا۠","translit":"۠āَnَaʾَw","root":""},{"id":40,"arabic":"أَوَّلُ","translit":"ُlَّwَaʾ","root":"اول"},{"id":41,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"}],"hasIhya":true},{"ayah":144,"text":"قَالَ يَٰمُوسَىٰٓ إِنِّى ٱصْطَفَيْتُكَ عَلَى ٱلنَّاسِ بِرِسَٰلَٰتِى وَبِكَلَٰمِى فَخُذْ مَآ ءَاتَيْتُكَ وَكُن مِّنَ ٱلشَّٰكِرِينَ ","translation":"[Allāh] said, \"O Moses, I have chosen you over the people with My messages and My words [to you]. So take what I have given you and be among the grateful.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"يَٰمُوسَىٰٓ","translit":"ٰٓàَswُmَٰy","root":""},{"id":3,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":4,"arabic":"ٱصْطَفَيْتُكَ","translit":"َkُtْyَfَṭْṣٱ","root":"صفو"},{"id":5,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":6,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":7,"arabic":"بِرِسَٰلَٰتِى","translit":"àِtَٰlَٰsِrِb","root":"رسل"},{"id":8,"arabic":"وَبِكَلَٰمِى","translit":"àِmَٰlَkِbَw","root":"كلم"},{"id":9,"arabic":"فَخُذْ","translit":"ْhdُhkَf","root":"اخذ"},{"id":10,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":11,"arabic":"ءَاتَيْتُكَ","translit":"َkُtْyَtāَء","root":"اتي"},{"id":12,"arabic":"وَكُن","translit":"nُkَw","root":"كون"},{"id":13,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":14,"arabic":"ٱلشَّٰكِرِينَ","translit":"َnyِrِkَّٰhslٱ","root":"شكر"}],"hasIhya":false},{"ayah":145,"text":"وَكَتَبْنَا لَهُۥ فِى ٱلْأَلْوَاحِ مِن كُلِّ شَىْءٍ مَّوْعِظَةً وَتَفْصِيلًا لِّكُلِّ شَىْءٍ فَخُذْهَا بِقُوَّةٍ وَأْمُرْ قَوْمَكَ يَأْخُذُوا۟ بِأَحْسَنِهَاۚ سَأُو۟رِيكُمْ دَارَ ٱلْفَٰسِقِينَ ","translation":"And We wrote for him on the tablets [something] of all things - instruction and explanation for all things, [saying], \"Take them with determination and order your people to take the best of it. I will show you the home of the defiantly disobedient.\"[1]","words":[{"id":1,"arabic":"وَكَتَبْنَا","translit":"āَnْbَtَkَw","root":"كتب"},{"id":2,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلْأَلْوَاحِ","translit":"ِḥāَwْlَaʾْlٱ","root":"لوح"},{"id":5,"arabic":"مِن","translit":"nِm","root":""},{"id":6,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":7,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":8,"arabic":"مَّوْعِظَةً","translit":"ًẗَẓِʿعْwَّm","root":"وعظ"},{"id":9,"arabic":"وَتَفْصِيلًا","translit":"āًlyِṣْfَtَw","root":"فصل"},{"id":10,"arabic":"لِّكُلِّ","translit":"ِّlُkِّl","root":"كلل"},{"id":11,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":12,"arabic":"فَخُذْهَا","translit":"āَhْhdُhkَf","root":"اخذ"},{"id":13,"arabic":"بِقُوَّةٍ","translit":"ٍẗَّwُqِb","root":"قوي"},{"id":14,"arabic":"وَأْمُرْ","translit":"ْrُmْaʾَw","root":"امر"},{"id":15,"arabic":"قَوْمَكَ","translit":"َkَmْwَq","root":"قوم"},{"id":16,"arabic":"يَأْخُذُوا۟","translit":"۟āwُhdُhkْaʾَy","root":"اخذ"},{"id":17,"arabic":"بِأَحْسَنِهَا","translit":"āَhِnَsْḥَaʾِb","root":"حسن"},{"id":18,"arabic":"سَأُو۟رِيكُمْ","translit":"ْmُkyِr۟wُaʾَs","root":"راي"},{"id":19,"arabic":"دَارَ","translit":"َrāَd","root":"دور"},{"id":20,"arabic":"ٱلْفَٰسِقِينَ","translit":"َnyِqِsَٰfْlٱ","root":"فسق"}],"hasIhya":false},{"ayah":146,"text":"سَأَصْرِفُ عَنْ ءَايَٰتِىَ ٱلَّذِينَ يَتَكَبَّرُونَ فِى ٱلْأَرْضِ بِغَيْرِ ٱلْحَقِّ وَإِن يَرَوْا۟ كُلَّ ءَايَةٍ لَّا يُؤْمِنُوا۟ بِهَا وَإِن يَرَوْا۟ سَبِيلَ ٱلرُّشْدِ لَا يَتَّخِذُوهُ سَبِيلًا وَإِن يَرَوْا۟ سَبِيلَ ٱلْغَىِّ يَتَّخِذُوهُ سَبِيلًاۚ ذَٰلِكَ بِأَنَّهُمْ كَذَّبُوا۟ بِـَٔايَٰتِنَا وَكَانُوا۟ عَنْهَا غَٰفِلِينَ ","translation":"I will turn away from My signs those who are arrogant upon the earth without right; and if they should see every sign, they will not believe in it. And if they see the way of consciousness,[1] they will not adopt it as a way; but if they see the way of error, they will adopt it as a way. That is because they have denied Our signs and they were heedless of them.","words":[{"id":1,"arabic":"سَأَصْرِفُ","translit":"ُfِrْṣَaʾَs","root":"صرف"},{"id":2,"arabic":"عَنْ","translit":"ْnَʿع","root":""},{"id":3,"arabic":"ءَايَٰتِىَ","translit":"َàِtَٰyāَء","root":"ايي"},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"يَتَكَبَّرُونَ","translit":"َnwُrَّbَkَtَy","root":"كبر"},{"id":6,"arabic":"فِى","translit":"àِf","root":""},{"id":7,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":8,"arabic":"بِغَيْرِ","translit":"ِrْyَغِb","root":"غير"},{"id":9,"arabic":"ٱلْحَقِّ","translit":"ِّqَḥْlٱ","root":"حقق"},{"id":10,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":11,"arabic":"يَرَوْا۟","translit":"۟āْwَrَy","root":"راي"},{"id":12,"arabic":"كُلَّ","translit":"َّlُk","root":"كلل"},{"id":13,"arabic":"ءَايَةٍ","translit":"ٍẗَyāَء","root":"ايي"},{"id":14,"arabic":"لَّا","translit":"āَّl","root":""},{"id":15,"arabic":"يُؤْمِنُوا۟","translit":"۟āwُnِmْwʾُy","root":"امن"},{"id":16,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":17,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":18,"arabic":"يَرَوْا۟","translit":"۟āْwَrَy","root":"راي"},{"id":19,"arabic":"سَبِيلَ","translit":"َlyِbَs","root":"سبل"},{"id":20,"arabic":"ٱلرُّشْدِ","translit":"ِdْhsُّrlٱ","root":"رشد"},{"id":21,"arabic":"لَا","translit":"āَl","root":""},{"id":22,"arabic":"يَتَّخِذُوهُ","translit":"ُhwُhdِhkَّtَy","root":"اخذ"},{"id":23,"arabic":"سَبِيلًا","translit":"āًlyِbَs","root":"سبل"},{"id":24,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":25,"arabic":"يَرَوْا۟","translit":"۟āْwَrَy","root":"راي"},{"id":26,"arabic":"سَبِيلَ","translit":"َlyِbَs","root":"سبل"},{"id":27,"arabic":"ٱلْغَىِّ","translit":"ِّàَغْlٱ","root":"غوي"},{"id":28,"arabic":"يَتَّخِذُوهُ","translit":"ُhwُhdِhkَّtَy","root":"اخذ"},{"id":29,"arabic":"سَبِيلًا","translit":"āًlyِbَs","root":"سبل"},{"id":30,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":31,"arabic":"بِأَنَّهُمْ","translit":"ْmُhَّnَaʾِb","root":""},{"id":32,"arabic":"كَذَّبُوا۟","translit":"۟āwُbَّhdَk","root":"كذب"},{"id":33,"arabic":"بِـَٔايَٰتِنَا","translit":"āَnِtَٰyāَٔـِb","root":"ايي"},{"id":34,"arabic":"وَكَانُوا۟","translit":"۟āwُnāَkَw","root":"كون"},{"id":35,"arabic":"عَنْهَا","translit":"āَhْnَʿع","root":""},{"id":36,"arabic":"غَٰفِلِينَ","translit":"َnyِlِfَٰغ","root":"غفل"}],"hasIhya":true},{"ayah":147,"text":"وَٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَا وَلِقَآءِ ٱلْءَاخِرَةِ حَبِطَتْ أَعْمَٰلُهُمْۚ هَلْ يُجْزَوْنَ إِلَّا مَا كَانُوا۟ يَعْمَلُونَ ","translation":"Those who denied Our signs and the meeting of the Hereafter - their deeds have become worthless. Are they recompensed except for what they used to do?","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"كَذَّبُوا۟","translit":"۟āwُbَّhdَk","root":"كذب"},{"id":3,"arabic":"بِـَٔايَٰتِنَا","translit":"āَnِtَٰyāَٔـِb","root":"ايي"},{"id":4,"arabic":"وَلِقَآءِ","translit":"ِءٓāَqِlَw","root":"لقي"},{"id":5,"arabic":"ٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱ","root":"اخر"},{"id":6,"arabic":"حَبِطَتْ","translit":"ْtَṭِbَḥ","root":"حبط"},{"id":7,"arabic":"أَعْمَٰلُهُمْ","translit":"ْmُhُlَٰmْʿعَaʾ","root":"عمل"},{"id":8,"arabic":"هَلْ","translit":"ْlَh","root":""},{"id":9,"arabic":"يُجْزَوْنَ","translit":"َnْwَzْjgُy","root":"جزي"},{"id":10,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":11,"arabic":"مَا","translit":"āَm","root":""},{"id":12,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":13,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":false},{"ayah":148,"text":"وَٱتَّخَذَ قَوْمُ مُوسَىٰ مِنۢ بَعْدِهِۦ مِنْ حُلِيِّهِمْ عِجْلًا جَسَدًا لَّهُۥ خُوَارٌۚ أَلَمْ يَرَوْا۟ أَنَّهُۥ لَا يُكَلِّمُهُمْ وَلَا يَهْدِيهِمْ سَبِيلًاۘ ٱتَّخَذُوهُ وَكَانُوا۟ ظَٰلِمِينَ ","translation":"And the people of Moses made, after [his departure], from their ornaments a calf - an image having a lowing sound. Did they not see that it could neither speak to them nor guide them to a way? They took it [for worship], and they were wrongdoers.","words":[{"id":1,"arabic":"وَٱتَّخَذَ","translit":"َhdَhkَّtٱَw","root":"اخذ"},{"id":2,"arabic":"قَوْمُ","translit":"ُmْwَq","root":"قوم"},{"id":3,"arabic":"مُوسَىٰ","translit":"ٰàَswُm","root":""},{"id":4,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":5,"arabic":"بَعْدِهِۦ","translit":"ۦِhِdْʿعَb","root":"بعد"},{"id":6,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":7,"arabic":"حُلِيِّهِمْ","translit":"ْmِhِّyِlُḥ","root":"حلي"},{"id":8,"arabic":"عِجْلًا","translit":"āًlْjgِʿع","root":"عجل"},{"id":9,"arabic":"جَسَدًا","translit":"āًdَsَjg","root":"جسد"},{"id":10,"arabic":"لَّهُۥ","translit":"ۥُhَّl","root":""},{"id":11,"arabic":"خُوَارٌ","translit":"ٌrāَwُhk","root":"خور"},{"id":12,"arabic":"أَلَمْ","translit":"ْmَlَaʾ","root":""},{"id":13,"arabic":"يَرَوْا۟","translit":"۟āْwَrَy","root":"راي"},{"id":14,"arabic":"أَنَّهُۥ","translit":"ۥُhَّnَaʾ","root":""},{"id":15,"arabic":"لَا","translit":"āَl","root":""},{"id":16,"arabic":"يُكَلِّمُهُمْ","translit":"ْmُhُmِّlَkُy","root":"كلم"},{"id":17,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":18,"arabic":"يَهْدِيهِمْ","translit":"ْmِhyِdْhَy","root":"هدي"},{"id":19,"arabic":"سَبِيلًا","translit":"āًlyِbَs","root":"سبل"},{"id":20,"arabic":"ٱتَّخَذُوهُ","translit":"ُhwُhdَhkَّtٱ","root":"اخذ"},{"id":21,"arabic":"وَكَانُوا۟","translit":"۟āwُnāَkَw","root":"كون"},{"id":22,"arabic":"ظَٰلِمِينَ","translit":"َnyِmِlَٰẓ","root":"ظلم"}],"hasIhya":false},{"ayah":149,"text":"وَلَمَّا سُقِطَ فِىٓ أَيْدِيهِمْ وَرَأَوْا۟ أَنَّهُمْ قَدْ ضَلُّوا۟ قَالُوا۟ لَئِن لَّمْ يَرْحَمْنَا رَبُّنَا وَيَغْفِرْ لَنَا لَنَكُونَنَّ مِنَ ٱلْخَٰسِرِينَ ","translation":"And when regret overcame them[1] and they saw that they had gone astray, they said, \"If our Lord does not have mercy upon us and forgive us, we will surely be among the losers.\"","words":[{"id":1,"arabic":"وَلَمَّا","translit":"āَّmَlَw","root":""},{"id":2,"arabic":"سُقِطَ","translit":"َṭِqُs","root":"سقط"},{"id":3,"arabic":"