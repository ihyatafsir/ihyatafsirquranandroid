ion": "warsh"}, {"surah": 68, "ayah": 2, "text": "مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونࣲ‏", "words": [{"id": 1, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَنتَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِنِعْمَةِ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِمَجْنُونࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 3, "text": "وَإِنَّ لَكَ لَأَجْراً غَيْرَ مَمْنُونࣲ‏", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَأَجْراً", "translit": "", "root": ""}, {"id": 4, "arabic": "غَيْرَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَمْنُونࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 4, "text": "وَإِنَّكَ لَعَلَيٰ خُلُقٍ عَظِيمࣲۖ", "words": [{"id": 1, "arabic": "وَإِنَّكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَعَلَيٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "خُلُقٍ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَظِيمࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 5, "text": "فَسَتُبْصِرُ وَيُبْصِرُونَ", "words": [{"id": 1, "arabic": "فَسَتُبْصِرُ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَيُبْصِرُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 6, "text": "بِأَييِّكُمُ اُ۬لْمَفْتُونُۖ", "words": [{"id": 1, "arabic": "بِأَييِّكُمُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لْمَفْتُونُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 7, "text": "إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦۖ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ