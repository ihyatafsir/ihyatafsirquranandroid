{"surah": 68, "verses": [{"ayah": 1, "text": "نٓۚ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ ", "translation": "Nūn.[1] By the pen and what they inscribe,", "words": [{"id": 1, "arabic": "نٓ", "translit": "ٓn", "root": ""}, {"id": 2, "arabic": "وَٱلْقَلَمِ", "translit": "ِmَlَqْlٱَw", "root": "قلم"}, {"id": 3, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 4, "arabic": "يَسْطُرُونَ", "translit": "َnwُrُṭْsَy", "root": "سطر"}], "hasIhya": false}, {"ayah": 2, "text": "مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍ ", "translation": "You are not, [O Muḥammad], by the favor of your Lord, a madman.", "words": [{"id": 1, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 2, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 3, "arabic": "بِنِعْمَةِ", "translit": "ِẗَmْʿعِnِb", "root": "نعم"}, {"id": 4, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 5, "arabic": "بِمَجْنُونٍ", "translit": "ٍnwُnْjgَmِb", "root": "جنن"}], "hasIhya": false}, {"ayah": 3, "text": "وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍ ", "translation": "And indeed, for you is a reward uninterrupted.", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 2, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 3, "arabic": "لَأَجْرًا", "translit": "āًrْjgَaʾَl", "root": "اجر"}, {"id": 4, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 5, "arabic": "مَمْنُونٍ", "translit": "ٍnwُnْmَm", "root": "منن"}], "hasIhya": false}, {"ayah": 4, "text": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ ", "translation": "And indeed, you are of a great moral character.", "words": [{"id": 1, "arabic": "وَإِنَّكَ", "translit": "َkَّnِiʾَw", "root": ""}, {"id": 2, "arabic": "لَعَلَىٰ", "translit": "ٰàَlَʿعَl", "root": ""}, {"id": 3, "arabic": "خُلُقٍ", "translit": "ٍqُlُhk", "root": "خلق"}, {"id": 4, "arabic": "عَظِيمٍ", "translit": "ٍmyِẓَʿع", "root": "عظم"}], "hasIhya": true}, {"ayah": 5, "text": "فَسَتُبْصِرُ وَيُبْصِرُونَ ", "translation": "So you will see and they will see", "words": [{"id": 1, "arabic": "فَسَتُبْصِرُ", "translit": "ُrِṣْbُtَsَf", "root": "بصر"}, {"id": 2, "arabic": "وَيُبْصِرُونَ", "translit": "َnwُrِṣْbُyَw", "root": "بصر"}], "hasIhya": false}, {"ayah": 6, "text": "بِأَييِّكُمُ ٱلْمَفْتُونُ ", "translation": "Which of you is the afflicted [by a devil].", "words": [{"id": 1, "arabic": "بِأَييِّكُمُ", "translit": "ُmُkِّyyَaʾِb", "root": "ايي"}, {"id": 2, "arabic": "ٱلْمَفْتُونُ", "translit": "ُnwُtْfَmْlٱ", "root": "فتن"}], "hasIhya": false}, {"ayah": 7, "text": "إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ ", "translation": "Indeed, your Lord is most knowing of who has gone astray from His way, and He is most knowing of the [rightly] guided.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 3, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 4, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 5, "arabic": "بِمَن", "translit": "nَmِb", "root": ""}, {"id": 6, "arabic": "ضَلَّ", "translit": "َّlَḍ", "root": "ضلل"}, {"id": 7, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 8, "arabic": "سَبِيلِهِۦ", "translit": "ۦِhِlyِbَs", "root": "سبل"}, {"id": 9, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 10, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 11, "arabic": "بِٱلْمُهْتَدِينَ", "translit": "َnyِdَtْhُmْlٱِb", "root": "هدي"}], "hasIhya": false}, {"ayah": 8, "text": "فَلَا تُطِعِ ٱلْمُكَذِّبِينَ ", "translation": "Then do not obey the deniers.", "words": [{"id": 1, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 2, "arabic": "تُطِعِ", "translit": "ِʿعِṭُt", "root": "طوع"}, {"id": 3, "arabic": "ٱلْمُكَذِّبِينَ", "translit": "َnyِbِّhdَkُmْlٱ", "root": "كذب"}], "hasIhya": false}, {"ayah": 9, "text": "وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ ", "translation": "They wish that you would soften [in your position], so they would soften [toward you].", "words": [{"id": 1, "arabic": "وَدُّوا۟", "translit": "۟āwُّdَw", "root": "ودد"}, {"id": 2, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 3, "arabic": "تُدْهِنُ", "translit": "ُnِhْdُt", "root": "دهن"}, {"id": 4, "arabic": "فَيُدْهِنُونَ", "translit": "َnwُnِhْdُyَf", "root": "دهن"}], "hasIhya": false}, {"ayah": 10, "text": "وَلَا تُطِعْ كُلَّ حَلَّافٍ مَّهِينٍ ", "translation": "And do not obey every worthless habitual swearer", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تُطِعْ", "translit": "ْʿعِṭُt", "root": "طوع"}, {"id": 3, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 4, "arabic": "حَلَّافٍ", "translit": "ٍfāَّlَḥ", "root": "حلف"}, {"id": 5, "arabic": "مَّهِينٍ", "translit": "ٍnyِhَّm", "root": "مهن"}], "hasIhya": false}, {"ayah": 11, "text": "هَمَّازٍ مَّشَّآءٍۭ بِنَمِيمٍ ", "translation": "[And] scorner, going about with malicious gossip -", "words": [{"id": 1, "arabic": "هَمَّازٍ", "translit": "ٍzāَّmَh", "root": "همز"}, {"id": 2, "arabic": "مَّشَّآءٍۭ", "translit": "ٍۭءٓāَّhsَّm", "root": "مشي"}, {"id": 3, "arabic": "بِنَمِيمٍ", "translit": "ٍmyِmَnِb", "root": "نمم"}], "hasIhya": false}, {"ayah": 12, "text": "مَّنَّاعٍ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ ", "translation": "A preventer of good, transgressing and sinful,", "words": [{"id": 1, "arabic": "مَّنَّاعٍ", "translit": "ٍʿعāَّnَّm", "root": "منع"}, {"id": 2, "arabic": "لِّلْخَيْرِ", "translit": "ِrْyَhkْlِّl", "root": "خير"}, {"id": 3, "arabic": "مُعْتَدٍ", "translit": "ٍdَtْʿعُm", "root": "عدو"}, {"id": 4, "arabic": "أَثِيمٍ", "translit": "ٍmyِhtَaʾ", "root": "اثم"}], "hasIhya": false}, {"ayah": 13, "text": "عُتُلٍّۭ بَعْدَ ذَٰلِكَ زَنِيمٍ ", "translation": "Cruel, moreover, and an illegitimate pretender.[1]", "words": [{"id": 1, "arabic": "عُتُلٍّۭ", "translit": "ٍّۭlُtُʿع", "root": "عتل"}, {"id": 2, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 3, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 4, "arabic": "زَنِيمٍ", "translit": "ٍmyِnَz", "root": "زنم"}], "hasIhya": true}, {"ayah": 14, "text": "أَن كَانَ ذَا مَالٍ وَبَنِينَ ", "translation": "Because he is a possessor of wealth and children,", "words": [{"id": 1, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "ذَا", "translit": "āَhd", "root": ""}, {"id": 4, "arabic": "مَالٍ", "translit": "ٍlāَm", "root": "مول"}, {"id": 5, "arabic": "وَبَنِينَ", "translit": "َnyِnَbَw", "root": "بني"}], "hasIhya": false}, {"ayah": 15, "text": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ ", "translation": "When Our verses are recited to him, he says, \"Legends of the former peoples.\"", "words": [{"id": 1, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 2, "arabic": "تُتْلَىٰ", "translit": "ٰàَlْtُt", "root": "تلو"}, {"id": 3, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "ءَايَٰتُنَا", "translit": "āَnُtَٰyāَء", "root": "ايي"}, {"id": 5, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 6, "arabic": "أَسَٰطِيرُ", "translit": "ُryِṭَٰsَaʾ", "root": "سطر"}, {"id": 7, "arabic": "ٱلْأَوَّلِينَ", "translit": "َnyِlَّwَaʾْlٱ", "root": "اول"}], "hasIhya": false}, {"ayah": 16, "text": "سَنَسِمُهُۥ عَلَى ٱلْخُرْطُومِ ", "translation": "We will brand him upon the snout.[1]", "words": [{"id": 1, "arabic": "سَنَسِمُهُۥ", "translit": "ۥُhُmِsَnَs", "root": "وسم"}, {"id": 2, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلْخُرْطُومِ", "translit": "ِmwُṭْrُhkْlٱ", "root": "خرطم"}], "hasIhya": false}, {"ayah": 17, "text": "إِنَّا بَلَوْنَٰهُمْ كَمَا بَلَوْنَآ أَصْحَٰبَ ٱلْجَنَّةِ إِذْ أَقْسَمُوا۟ لَيَصْرِمُنَّهَا مُصْبِحِينَ ", "translation": "Indeed, We have tried them as We tried the companions of the garden, when they swore to cut its fruit in the [early] morning", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 2, "arabic": "بَلَوْنَٰهُمْ", "translit": "ْmُhَٰnْwَlَb", "root": "بلو"}, {"id": 3, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 4, "arabic": "بَلَوْنَآ", "translit": "ٓāَnْwَlَb", "root": "بلو"}, {"id": 5, "arabic": "أَصْحَٰبَ", "translit": "َbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 6, "arabic": "ٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱ", "root": "جنن"}, {"id": 7, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 8, "arabic": "أَقْسَمُوا۟", "translit": "۟āwُmَsْqَaʾ", "root": "قسم"}, {"id": 9, "arabic": "لَيَصْرِمُنَّهَا", "translit": "āَhَّnُmِrْṣَyَl", "root": "صرم"}, {"id": 10, "arabic": "مُصْبِحِينَ", "translit": "َnyِḥِbْṣُm", "root": "صبح"}], "hasIhya": false}, {"ayah": 18, "text": "وَلَا يَسْتَثْنُونَ ", "translation": "Without making exception.[1]", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "يَسْتَثْنُونَ", "translit": "َnwُnْhtَtْsَy", "root": "ثني"}], "hasIhya": false}, {"ayah": 19, "text": "فَطَافَ عَلَيْهَا طَآئِفٌ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ ", "translation": "So there came upon it [i.e., the garden] an affliction from your Lord while they were asleep.", "words": [{"id": 1, "arabic": "فَطَافَ", "translit": "َfāَṭَf", "root": "طوف"}, {"id": 2, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "طَآئِفٌ", "translit": "ٌfِyʾٓāَṭ", "root": "طوف"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 6, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 7, "arabic": "نَآئِمُونَ", "translit": "َnwُmِyʾٓāَn", "root": "نوم"}], "hasIhya": false}, {"ayah": 20, "text": "فَأَصْبَحَتْ كَٱلصَّرِيمِ ", "translation": "And it became as though reaped.", "words": [{"id": 1, "arabic": "فَأَصْبَحَتْ", "translit": "ْtَḥَbْṣَaʾَf", "root": "صبح"}, {"id": 2, "arabic": "كَٱلصَّرِيمِ", "translit": "ِmyِrَّṣlٱَk", "root": "صرم"}], "hasIhya": false}, {"ayah": 21, "text": "فَتَنَادَوْا۟ مُصْبِحِينَ ", "translation": "And they called one another at morning,", "words": [{"id": 1, "arabic": "فَتَنَادَوْا۟", "translit": "۟āْwَdāَnَtَf", "root": "ندي"}, {"id": 2, "arabic": "مُصْبِحِينَ", "translit": "َnyِḥِbْṣُm", "root": "صبح"}], "hasIhya": false}, {"ayah": 22, "text": "أَنِ ٱغْدُوا۟ عَلَىٰ حَرْثِكُمْ إِن كُنتُمْ صَٰرِمِينَ ", "translation": "[Saying], \"Go early to your crop if you would cut the fruit.\"", "words": [{"id": 1, "arabic": "أَنِ", "translit": "ِnَaʾ", "root": ""}, {"id": 2, "arabic": "ٱغْدُوا۟", "translit": "۟āwُdْغٱ", "root": "غدو"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "حَرْثِكُمْ", "translit": "ْmُkِhtْrَḥ", "root": "حرث"}, {"id": 5, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 6, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 7, "arabic": "صَٰرِمِينَ", "translit": "َnyِmِrَٰṣ", "root": "صرم"}], "hasIhya": false}, {"ayah": 23, "text": "فَٱنطَلَقُوا۟ وَهُمْ يَتَخَٰفَتُونَ ", "translation": "So they set out, while lowering their voices,", "words": [{"id": 1, "arabic": "فَٱنطَلَقُوا۟", "translit": "۟āwُqَlَṭnٱَf", "root": "طلق"}, {"id": 2, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 3, "arabic": "يَتَخَٰفَتُونَ", "translit": "َnwُtَfَٰhkَtَy", "root": "خفت"}], "hasIhya": false}, {"ayah": 24, "text": "أَن لَّا يَدْخُلَنَّهَا ٱلْيَوْمَ عَلَيْكُم مِّسْكِينٌ ", "translation": "[Saying], \"There will surely not enter it today upon you [any] poor person.\"", "words": [{"id": 1, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 2, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 3, "arabic": "يَدْخُلَنَّهَا", "translit": "āَhَّnَlُhkْdَy", "root": "دخل"}, {"id": 4, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 5, "arabic": "عَلَيْكُم", "translit": "mُkْyَlَʿع", "root": ""}, {"id": 6, "arabic": "مِّسْكِينٌ", "translit": "ٌnyِkْsِّm", "root": "سكن"}], "hasIhya": false}, {"ayah": 25, "text": "وَغَدَوْا۟ عَلَىٰ حَرْدٍ قَٰدِرِينَ ", "translation": "And they went early in determination, [assuming themselves] able.[1]", "words": [{"id": 1, "arabic": "وَغَدَوْا۟", "translit": "۟āْwَdَغَw", "root": "غدو"}, {"id": 2, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 3, "arabic": "حَرْدٍ", "translit": "ٍdْrَḥ", "root": "حرد"}, {"id": 4, "arabic": "قَٰدِرِينَ", "translit": "َnyِrِdَٰq", "root": "قدر"}], "hasIhya": false}, {"ayah": 26, "text": "فَلَمَّا رَأَوْهَا قَالُوٓا۟ إِنَّا لَضَآلُّونَ ", "translation": "But when they saw it, they said, \"Indeed, we are lost;", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "رَأَوْهَا", "translit": "āَhْwَaʾَr", "root": "راي"}, {"id": 3, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 4, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 5, "arabic": "لَضَآلُّونَ", "translit": "َnwُّlٓāَḍَl", "root": "ضلل"}], "hasIhya": false}, {"ayah": 27, "text": "بَلْ نَحْنُ مَحْرُومُونَ ", "translation": "Rather, we have been deprived.\"", "words": [{"id": 1, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 2, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 3, "arabic": "مَحْرُومُونَ", "translit": "َnwُmwُrْḥَm", "root": "حرم"}], "hasIhya": false}, {"ayah": 28, "text": "قَالَ أَوْسَطُهُمْ أَلَمْ أَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَ ", "translation": "The most moderate of them said, \"Did I not say to you, 'Why do you not exalt [Allāh]?'\"[1]", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "أَوْسَطُهُمْ", "translit": "ْmُhُṭَsْwَaʾ", "root": "وسط"}, {"id": 3, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 4, "arabic": "أَقُل", "translit": "lُqَaʾ", "root": "قول"}, {"id": 5, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 6, "arabic": "لَوْلَا", "translit": "āَlْwَl", "root": ""}, {"id": 7, "arabic": "تُسَبِّحُونَ", "translit": "َnwُḥِّbَsُt", "root": "سبح"}], "hasIhya": false}, {"ayah": 29, "text": "قَالُوا۟ سُبْحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَ ", "translation": "They said, \"Exalted is our Lord! Indeed, we were wrongdoers.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "سُبْحَٰنَ", "translit": "َnَٰḥْbُs", "root": "سبح"}, {"id": 3, "arabic": "رَبِّنَآ", "translit": "ٓāَnِّbَr", "root": "ربب"}, {"id": 4, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 5, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 6, "arabic": "ظَٰلِمِينَ", "translit": "َnyِmِlَٰẓ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 30, "text": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَلَٰوَمُونَ ", "translation": "Then they approached one another, blaming each other.", "words": [{"id": 1, "arabic": "فَأَقْبَلَ", "translit": "َlَbْqَaʾَf", "root": "قبل"}, {"id": 2, "arabic": "بَعْضُهُمْ", "translit": "ْmُhُḍْʿعَb", "root": "بعض"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 5, "arabic": "يَتَلَٰوَمُونَ", "translit": "َnwُmَwَٰlَtَy", "root": "لوم"}], "hasIhya": false}, {"ayah": 31, "text": "قَالُوا۟ يَٰوَيْلَنَآ إِنَّا كُنَّا طَٰغِينَ ", "translation": "They said, \"O woe to us; indeed we were transgressors.", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰوَيْلَنَآ", "translit": "ٓāَnَlْyَwَٰy", "root": ""}, {"id": 3, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 4, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 5, "arabic": "طَٰغِينَ", "translit": "َnyِغَٰṭ", "root": "طغي"}], "hasIhya": false}, {"ayah": 32, "text": "عَسَىٰ رَبُّنَآ أَن يُبْدِلَنَا خَيْرًا مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ ", "translation": "Perhaps our Lord will substitute for us [one] better than it. Indeed, we are toward our Lord desirous.\"[1]", "words": [{"id": 1, "arabic": "عَسَىٰ", "translit": "ٰàَsَʿع", "root": "عسي"}, {"id": 2, "arabic": "رَبُّنَآ", "translit": "ٓāَnُّbَr", "root": "ربب"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "يُبْدِلَنَا", "translit": "āَnَlِdْbُy", "root": "بدل"}, {"id": 5, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 6, "arabic": "مِّنْهَآ", "translit": "ٓāَhْnِّm", "root": ""}, {"id": 7, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 8, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 9, "arabic": "رَبِّنَا", "translit": "āَnِّbَr", "root": "ربب"}, {"id": 10, "arabic": "رَٰغِبُونَ", "translit": "َnwُbِغَٰr", "root": "رغب"}], "hasIhya": true}, {"ayah": 33, "text": "كَذَٰلِكَ ٱلْعَذَابُۖ وَلَعَذَابُ ٱلْءَاخِرَةِ أَكْبَرُۚ لَوْ كَانُوا۟ يَعْلَمُونَ ", "translation": "Such is the punishment [of this world]. And the punishment of the Hereafter is greater, if they only knew.", "words": [{"id": 1, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 2, "arabic": "ٱلْعَذَابُ", "translit": "ُbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 3, "arabic": "وَلَعَذَابُ", "translit": "ُbāَhdَʿعَlَw", "root": "عذب"}, {"id": 4, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 5, "arabic": "أَكْبَرُ", "translit": "ُrَbْkَaʾ", "root": "كبر"}, {"id": 6, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 7, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 8, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 34, "text": "إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّٰتِ ٱلنَّعِيمِ ", "translation": "Indeed, for the righteous with their Lord are the Gardens of Pleasure.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "لِلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlِl", "root": "وقي"}, {"id": 3, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 4, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 5, "arabic": "جَنَّٰتِ", "translit": "ِtَّٰnَjg", "root": "جنن"}, {"id": 6, "arabic": "ٱلنَّعِيمِ", "translit": "ِmyِʿعَّnlٱ", "root": "نعم"}], "hasIhya": false}, {"ayah": 35, "text": "أَفَنَجْعَلُ ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ ", "translation": "Then will We treat the Muslims like the criminals?", "words": [{"id": 1, "arabic": "أَفَنَجْعَلُ", "translit": "ُlَʿعْjgَnَfَaʾ", "root": "جعل"}, {"id": 2, "arabic": "ٱلْمُسْلِمِينَ", "translit": "َnyِmِlْsُmْlٱ", "root": "سلم"}, {"id": 3, "arabic": "كَٱلْمُجْرِمِينَ", "translit": "َnyِmِrْjgُmْlٱَk", "root": "جرم"}], "hasIhya": true}, {"ayah": 36, "text": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ ", "translation": "What is [the matter] with you? How do you judge?", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 3, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 4, "arabic": "تَحْكُمُونَ", "translit": "َnwُmُkْḥَt", "root": "حكم"}], "hasIhya": false}, {"ayah": 37, "text": "أَمْ لَكُمْ كِتَٰبٌ فِيهِ تَدْرُسُونَ ", "translation": "Or do you have a scripture in which you learn", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 3, "arabic": "كِتَٰبٌ", "translit": "ٌbَٰtِk", "root": "كتب"}, {"id": 4, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 5, "arabic": "تَدْرُسُونَ", "translit": "َnwُsُrْdَt", "root": "درس"}], "hasIhya": false}, {"ayah": 38, "text": "إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَ ", "translation": "That indeed for you is whatever you choose?", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 3, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 4, "arabic": "لَمَا", "translit": "āَmَl", "root": ""}, {"id": 5, "arabic": "تَخَيَّرُونَ", "translit": "َnwُrَّyَhkَt", "root": "خير"}], "hasIhya": false}, {"ayah": 39, "text": "أَمْ لَكُمْ أَيْمَٰنٌ عَلَيْنَا بَٰلِغَةٌ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِۙ إِنَّ لَكُمْ لَمَا تَحْكُمُونَ ", "translation": "Or do you have oaths [binding] upon Us, extending until the Day of Resurrection, that indeed for you is whatever you judge?", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 3, "arabic": "أَيْمَٰنٌ", "translit": "ٌnَٰmْyَaʾ", "root": "يمن"}, {"id": 4, "arabic": "عَلَيْنَا", "translit": "āَnْyَlَʿع", "root": ""}, {"id": 5, "arabic": "بَٰلِغَةٌ", "translit": "ٌẗَغِlَٰb", "root": "بلغ"}, {"id": 6, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 7, "arabic": "يَوْمِ", "translit": "ِmْwَy", "root": "يوم"}, {"id": 8, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 9, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 10, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 11, "arabic": "لَمَا", "translit": "āَmَl", "root": ""}, {"id": 12, "arabic": "تَحْكُمُونَ", "translit": "َnwُmُkْḥَt", "root": "حكم"}], "hasIhya": false}, {"ayah": 40, "text": "سَلْهُمْ أَيُّهُم بِذَٰلِكَ زَعِيمٌ ", "translation": "Ask them which of them, for that [claim], is responsible.", "words": [{"id": 1, "arabic": "سَلْهُمْ", "translit": "ْmُhْlَs", "root": "سال"}, {"id": 2, "arabic": "أَيُّهُم", "translit": "mُhُّyَaʾ", "root": "ايي"}, {"id": 3, "arabic": "بِذَٰلِكَ", "translit": "َkِlَٰhdِb", "root": ""}, {"id": 4, "arabic": "زَعِيمٌ", "translit": "ٌmyِʿعَz", "root": "زعم"}], "hasIhya": false}, {"ayah": 41, "text": "أَمْ لَهُمْ شُرَكَآءُ فَلْيَأْتُوا۟ بِشُرَكَآئِهِمْ إِن كَانُوا۟ صَٰدِقِينَ ", "translation": "Or do they have partners?[1] Then let them bring their partners, if they should be truthful.", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "شُرَكَآءُ", "translit": "ُءٓāَkَrُhs", "root": "شرك"}, {"id": 4, "arabic": "فَلْيَأْتُوا۟", "translit": "۟āwُtْaʾَyْlَf", "root": "اتي"}, {"id": 5, "arabic": "بِشُرَكَآئِهِمْ", "translit": "ْmِhِyʾٓāَkَrُhsِb", "root": "شرك"}, {"id": 6, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 7, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 8, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": false}, {"ayah": 42, "text": "يَوْمَ يُكْشَفُ عَن سَاقٍ وَيُدْعَوْنَ إِلَى ٱلسُّجُودِ فَلَا يَسْتَطِيعُونَ ", "translation": "The Day the shin will be uncovered[1] and they are invited to prostration but they [i.e., the disbelievers] will not be able,", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "يُكْشَفُ", "translit": "ُfَhsْkُy", "root": "كشف"}, {"id": 3, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 4, "arabic": "سَاقٍ", "translit": "ٍqāَs", "root": "سوق"}, {"id": 5, "arabic": "وَيُدْعَوْنَ", "translit": "َnْwَʿعْdُyَw", "root": "دعو"}, {"id": 6, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 7, "arabic": "ٱلسُّجُودِ", "translit": "ِdwُjgُّslٱ", "root": "سجد"}, {"id": 8, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 9, "arabic": "يَسْتَطِيعُونَ", "translit": "َnwُʿعyِṭَtْsَy", "root": "طوع"}], "hasIhya": false}, {"ayah": 43, "text": "خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۖ وَقَدْ كَانُوا۟ يُدْعَوْنَ إِلَى ٱلسُّجُودِ وَهُمْ سَٰلِمُونَ ", "translation": "Their eyes humbled, humiliation will cover them. And they used to be invited to prostration while they were sound.[1]", "words": [{"id": 1, "arabic": "خَٰشِعَةً", "translit": "ًẗَʿعِhsَٰhk", "root": "خشع"}, {"id": 2, "arabic": "أَبْصَٰرُهُمْ", "translit": "ْmُhُrَٰṣْbَaʾ", "root": "بصر"}, {"id": 3, "arabic": "تَرْهَقُهُمْ", "translit": "ْmُhُqَhْrَt", "root": "رهق"}, {"id": 4, "arabic": "ذِلَّةٌ", "translit": "ٌẗَّlِhd", "root": "ذلل"}, {"id": 5, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 6, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 7, "arabic": "يُدْعَوْنَ", "translit": "َnْwَʿعْdُy", "root": "دعو"}, {"id": 8, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 9, "arabic": "ٱلسُّجُودِ", "translit": "ِdwُjgُّslٱ", "root": "سجد"}, {"id": 10, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 11, "arabic": "سَٰلِمُونَ", "translit": "َnwُmِlَٰs", "root": "سلم"}], "hasIhya": false}, {"ayah": 44, "text": "فَذَرْنِى وَمَن يُكَذِّبُ بِهَٰذَا ٱلْحَدِيثِۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ ", "translation": "So leave Me, [O Muḥammad], with [the matter of] whoever denies this statement [i.e., the Qur’ān]. We will progressively lead them [to punishment] from where they do not know.[1]", "words": [{"id": 1, "arabic": "فَذَرْنِى", "translit": "àِnْrَhdَf", "root": "وذر"}, {"id": 2, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 3, "arabic": "يُكَذِّبُ", "translit": "ُbِّhdَkُy", "root": "كذب"}, {"id": 4, "arabic": "بِهَٰذَا", "translit": "āَhdَٰhِb", "root": ""}, {"id": 5, "arabic": "ٱلْحَدِيثِ", "translit": "ِhtyِdَḥْlٱ", "root": "حدث"}, {"id": 6, "arabic": "سَنَسْتَدْرِجُهُم", "translit": "mُhُjgِrْdَtْsَnَs", "root": "درج"}, {"id": 7, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 8, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": true}, {"ayah": 45, "text": "وَأُمْلِى لَهُمْۚ إِنَّ كَيْدِى مَتِينٌ ", "translation": "And I will give them time. Indeed, My plan is firm.", "words": [{"id": 1, "arabic": "وَأُمْلِى", "translit": "àِlْmُaʾَw", "root": "ملو"}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 4, "arabic": "كَيْدِى", "translit": "àِdْyَk", "root": "كيد"}, {"id": 5, "arabic": "مَتِينٌ", "translit": "ٌnyِtَm", "root": "متن"}], "hasIhya": false}, {"ayah": 46, "text": "أَمْ تَسْـَٔلُهُمْ أَجْرًا فَهُم مِّن مَّغْرَمٍ مُّثْقَلُونَ ", "translation": "Or do you ask of them a payment, so they are by debt burdened down?", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "تَسْـَٔلُهُمْ", "translit": "ْmُhُlَٔـْsَt", "root": "سال"}, {"id": 3, "arabic": "أَجْرًا", "translit": "āًrْjgَaʾ", "root": "اجر"}, {"id": 4, "arabic": "فَهُم", "translit": "mُhَf", "root": ""}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "مَّغْرَمٍ", "translit": "ٍmَrْغَّm", "root": "غرم"}, {"id": 7, "arabic": "مُّثْقَلُونَ", "translit": "َnwُlَqْhtُّm", "root": "ثقل"}], "hasIhya": false}, {"ayah": 47, "text": "أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ ", "translation": "Or have they [knowledge of] the unseen, so they write [it] down?", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "عِندَهُمُ", "translit": "ُmُhَdnِʿع", "root": "عند"}, {"id": 3, "arabic": "ٱلْغَيْبُ", "translit": "ُbْyَغْlٱ", "root": "غيب"}, {"id": 4, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 5, "arabic": "يَكْتُبُونَ", "translit": "َnwُbُtْkَy", "root": "كتب"}], "hasIhya": false}, {"ayah": 48, "text": "فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظُومٌ ", "translation": "Then be patient for the decision of your Lord, [O Muḥammad], and be not like the companion of the fish [i.e., Jonah] when he called out while he was distressed.", "words": [{"id": 1, "arabic": "فَٱصْبِرْ", "translit": "ْrِbْṣٱَf", "root": "صبر"}, {"id": 2, "arabic": "لِحُكْمِ", "translit": "ِmْkُḥِl", "root": "حكم"}, {"id": 3, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 5, "arabic": "تَكُن", "translit": "nُkَt", "root": "كون"}, {"id": 6, "arabic": "كَصَاحِبِ", "translit": "ِbِḥāَṣَk", "root": "صحب"}, {"id": 7, "arabic": "ٱلْحُوتِ", "translit": "ِtwُḥْlٱ", "root": "حوت"}, {"id": 8, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 9, "arabic": "نَادَىٰ", "translit": "ٰàَdāَn", "root": "ندي"}, {"id": 10, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 11, "arabic": "مَكْظُومٌ", "translit": "ٌmwُẓْkَm", "root": "كظم"}], "hasIhya": true}, {"ayah": 49, "text": "لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٌ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلْعَرَآءِ وَهُوَ مَذْمُومٌ ", "translation": "If not that a favor [i.e., mercy] from his Lord overtook him, he would have been thrown onto the naked shore while he was censured.[1]", "words": [{"id": 1, "arabic": "لَّوْلَآ", "translit": "ٓāَlْwَّl", "root": ""}, {"id": 2, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 3, "arabic": "تَدَٰرَكَهُۥ", "translit": "ۥُhَkَrَٰdَt", "root": "درك"}, {"id": 4, "arabic": "نِعْمَةٌ", "translit": "ٌẗَmْʿعِn", "root": "نعم"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "رَّبِّهِۦ", "translit": "ۦِhِّbَّr", "root": "ربب"}, {"id": 7, "arabic": "لَنُبِذَ", "translit": "َhdِbُnَl", "root": "نبذ"}, {"id": 8, "arabic": "بِٱلْعَرَآءِ", "translit": "ِءٓāَrَʿعْlٱِb", "root": "عري"}, {"id": 9, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 10, "arabic": "مَذْمُومٌ", "translit": "ٌmwُmْhdَm", "root": "ذمم"}], "hasIhya": true}, {"ayah": 50, "text": "فَٱجْتَبَٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّٰلِحِينَ ", "translation": "And his Lord chose him and made him of the righteous.", "words": [{"id": 1, "arabic": "فَٱجْتَبَٰهُ", "translit": "ُhَٰbَtْjgٱَf", "root": "جبي"}, {"id": 2, "arabic": "رَبُّهُۥ", "translit": "ۥُhُّbَr", "root": "ربب"}, {"id": 3, "arabic": "فَجَعَلَهُۥ", "translit": "ۥُhَlَʿعَjgَf", "root": "جعل"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱلصَّٰلِحِينَ", "translit": "َnyِḥِlَّٰṣlٱ", "root": "صلح"}], "hasIhya": false}, {"ayah": 51, "text": "وَإِن يَكَادُ ٱلَّذِينَ كَفَرُوا۟ لَيُزْلِقُونَكَ بِأَبْصَٰرِهِمْ لَمَّا سَمِعُوا۟ ٱلذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٌ ", "translation": "And indeed, those who disbelieve would almost make you slip with their eyes [i.e., looks] when they hear the message, and they say, \"Indeed, he is mad.\"", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "يَكَادُ", "translit": "ُdāَkَy", "root": "كود"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 5, "arabic": "لَيُزْلِقُونَكَ", "translit": "َkَnwُqِlْzُyَl", "root": "زلق"}, {"id": 6, "arabic": "بِأَبْصَٰرِهِمْ", "translit": "ْmِhِrَٰṣْbَaʾِb", "root": "بصر"}, {"id": 7, "arabic": "لَمَّا", "translit": "āَّmَl", "root": ""}, {"id": 8, "arabic": "سَمِعُوا۟", "translit": "۟āwُʿعِmَs", "root": "سمع"}, {"id": 9, "arabic": "ٱلذِّكْرَ", "translit": "َrْkِّhdlٱ", "root": "ذكر"}, {"id": 10, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 11, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 12, "arabic": "لَمَجْنُونٌ", "translit": "ٌnwُnْjgَmَl", "root": "جنن"}], "hasIhya": false}, {"ayah": 52, "text": "وَمَا هُوَ إِلَّا ذِكْرٌ لِّلْعَٰلَمِينَ ", "translation": "But it is not except a reminder to the worlds.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "ذِكْرٌ", "translit": "ٌrْkِhd", "root": "ذكر"}, {"id": 5, "arabic": "لِّلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlِّl", "root": "علم"}], "hasIhya": false}], "tafsir": {"4": [{"arabic": "وهو الذي مدح الله سبحانه به نبيه عليه السلام إذ قال {وإنك لعلى خلق عظيم} وقال النبي صلى الله عليه وسلم أكثر ما يدخل الناس الجنة تقوى الله وحسن الخلق (1) وقال أسامة بن شريك قلنا يا رسول الله ما خير ما أعطى الإنسان فقال خلق حسن (2) وقال صلى الله عليه وسلم بعثت لأتمم محاسن الأخلاق (3) وقال صلى الله عليه وسلم أثقل ما يوضع في الميزان خلق حسن (4) وقال صلى الله عليه وسلم ما حسن الله خلق امريء وخلقه فيطعمه النار (5) وقال صلى الله عليه وسلم يا أبا هريرة عليك بحسن الخلق قال أبو هريرة رضي الله عنه وما حسن الخلق يا رسو", "english": "Know that affability (al-ulfah) is the fruit of excellent character (ḥusn al-khuluq), and estrangement (al-tafarruq) is the fruit of evil character. For excellent character necessitates mutual love, harmony, and concord, whereas evil character yields mutual hatred, envy, and turning away (al-tadābur). And whenever the source is praiseworthy, the fruit is likewise praiseworthy. The excellence of good character is not hidden in the religion; indeed, it is that with which God—glorified be He—praised His Prophet, peace be upon him, when He said: {وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ} «And indeed, you are upon an immense character» (Al-Qalam: 4). The Prophet, peace be upon him, said: \"The thing which most causes people to enter Paradise is God-consciousness (taqwā) and excellent character.\" (1) Usāmah ibn Sharīk said: \"We said, O Messenger of God, what is the best thing given to a person?\" He said: \"Excellent character.\" (2) He, peace be upon him, also said: \"I was sent only to perfect the noble traits of character.\" (3) He, peace be upon him, said: \"Nothing is heavier in the Balance than excellent character.\" (4) He, peace be upon him, said: \"God does not beautify a person's outward form and his inward character, then feed him to the Fire.\" (5) He, peace be upon him, said: \"O Abū Hurayrah, adhere to excellent character.\" (Page V02P157) Abū Hurayrah, may God be pleased with him, said: \"What is excellent character, O Messenger of God?\" He said: \"That you join the one who cuts you off, forgive the one who wrongs you, and give to the one who deprives you.\" (1)", "book_title": "Breaking the Two Desires", "section_title_ar": "Section 402", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 402: On the Excellence of Affability (Al-Ulfah) and Brotherhood in God", "section_index": 402, "anchors": "- Root: ألف (Alifa)\n  * Lisan / Ayn: Core meaning of harmonizing, uniting, and reconciling; the removal of estrangement (al-waḥshah) and the establishment of concord.\n  * Al-Raghib (Mufradat): Theological nuance of ta'līf as the divine act of harmonizing hearts, a blessing bestowed by God alone, as in {لَوْ أَنفَقْتَ مَا فِي الْأَرْضِ جَمِيعًا مَّا أَلَّفْتَ بَيْنَ قُلُوبِهِمْ}.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) denotes physical joining; metaphorical (majāz) denotes the spiritual and moral concord of hearts, which is the fruit of excellent character (ḥusn al-khuluq).\n- Root: خلق (Khalaqa)\n  * Lisan / Ayn: Root meaning of measuring, proportioning, and smoothing; hence, the inherent disposition and moral character of a person.\n  * Al-Raghib (Mufradat): The origination of a thing upon a just measure; for character, it is the inward form (al-ṣūrah al-bāṭinah) of the soul, just as the physical form is its outward shape.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) is the physical creation and proportioning; metaphorical (majāz) is the moral and spiritual constitution, praised by God in {وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ}.\n- Root: بغض (Bughḍ)\n  * Lisan / Ayn: The opposite of love (ḥubb); intense aversion and hatred.\n  * Al-Raghib (Mufradat): In the Kalam context, al-bughḍ fī Allāh (hatred for God's sake) is a spiritual act of discernment and loyalty, not a mere emotional impulse; it is paired with al-ḥubb fī Allāh as the strongest bond of faith (awthaq ʿurā al-īmān).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) is personal animosity; metaphorical (majāz) is the righteous aversion to disobedience and the enemies of God, which is a form of devotion.\n- Sibawayh Rule: Rule of Prepositional Interposition (Bāb al-Faṣl bayna al-Jār wa al-Majrūr) — Governing the syntactic flow of conditional and relative clauses, ensuring the periodic structure of the author's argument remains coherent and unbroken.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Breaking the Two Desires'", "badge": "Afterlife"}], "13": [{"arabic": "قال الله تعالى {هماز مشاء بنميم} ثم قال {عتل بعد ذلك زنيم} قال عبد الله بن المبارك الزنيم ولد الزنا الذي لا يكتم الحديث وأشار به إلى أن كل من لم يكتم الحديث ومشى بالنميمة دل على أنه ولد زنا استنباطا من قوله عز وجل {عتل بعد ذلك زنيم} والزنيم هو الدعى وقال تعالى {ويل لكل همزة لمزة} قيل الهمزة النمام وقال تعالى {حمالة الحطب} قيل إنها كانت نمامة حمالة للحديث وقال تعالى {فخانتاهما فلم يغنيا عنهما من الله شيئا} قيل كانت امرأة لوط تخبر بالضيفان وامرأة نوح تخبر أنه مجنون وقد قال صلى الله ع", "english": "Allah Most High has said: {«هَمَّازٍ مَشَّاءٍ بِنَمِيمٍ»} [“A slanderer, a walker with talebearing”] (Al-Qalam: 11). Then He said: {«عُتُلٍّ بَعْدَ ذَلِكَ زَنِيمٍ»} [“Cruel, moreover, and an intruder (zanīm)”] (Al-Qalam: 13). ʿAbd Allāh ibn al-Mubārak said: “Al-zanīm is the child of fornication (walad al-zinā) who does not conceal speech.” He indicated by this that whoever does not conceal speech and walks with talebearing is evidence that he is a child of fornication — this being deduced (istinbāṭan) from the saying of Allah, Mighty and Majestic: {«عُتُلٍّ بَعْدَ ذَلِكَ زَنِيمٍ»}. And al-zanīm is the intruder (al-daʿīy) [one falsely attached to a lineage].", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 691", "section_title_en": "The Sixteenth Affliction: Namīmah (Malicious Talebearing)", "section_index": 691, "anchors": "- Root: نمم (n-m-m)\n  * Lisan / Ayn: Core meaning of \"to spread a report,\" \"to carry tales,\" \"to divulge what should remain concealed.\" Al-Ayn notes the root's connection to intensification and penetration of heat, implying the corrosive, penetrating effect of talebearing.\n  * Al-Raghib (Mufradat): Theological nuance: The talebearer (namūm) is one who transmits speech with the intent to corrupt and sever bonds of brotherhood, aligning with the Quranic condemnation of the \"mushā' bi-namīm\" (walker with slander).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"He is a talebearer (namūm) between people, walking with slanders (namā'im).\" Metaphorical (Majaz): \"The scent spread over musk (namat 'alā al-misk rā'iḥatuhā)\" — indicating that namīmah is the \"spreading\" of that which harms, just as fragrance spreads beneficially; the metaphor underscores the talebearer's deliberate dissemination of destructive words.\n- Root: زنم (z-n-m)\n  * Lisan / Ayn: Core meaning: an extra, superfluous appendage, like the wattle (zanamatān) hanging from a goat's ear or throat — something attached but not truly part of the whole.\n  * Al-Raghib (Mufradat): \"Al-Zanīm and al-muzannam: the one who is superfluous to a people, not being of them, likened to the two wattles of a sheep... i.e., one who claims affiliation to a people while being detached from them.\" Applied to the bastard (walad zinā) who is \"attached\" to a lineage not his own.\n  * Al-Zamakhshari (Asas): Literal: \"He has a goat with wattles (muzannamah).\" Metaphorical: \"In so-and-so is a zanamah of good and a zanamah of evil: a mark/sign. And so-and-so is zanīm and muzannam: an intruder (da'īy) attached to those not of him.\"\n- Root: قتت (q-t-t)\n  * Lisan / Ayn: Core meaning: to seek out and gather information stealthily, to eavesdrop and then carry reports — the \"qattāt\" is one who listens to others' private speech and transmits it to cause harm.\n  * Al-Raghib (Mufradat): The qattāt is synonymous with the namūm in the prophetic hadith; both denote the one who carries destructive speech between parties.\n  * Al-Zamakhshari (Asas): Literal: The qattāt is the one who \"tracks\" (yaquttu) news, i.e., investigates and then spreads it. Metaphorical: The term extends to any medium of harmful disclosure — speech, writing, gesture, or sign.\n- Sibawayh Rule: Restriction and Focused Predication (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — Governing the definitional statement \"innamā yuṭlaqu...\": the restriction confines the common application of namīmah to a specific case while the subsequent expansion (wa-laysat al-namīmah mukhtaṣṣah bihi) negates restriction, establishing the full technical definition through contrastive predication.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Anger and Hatred'", "badge": "Hadith"}], "32": [{"arabic": "وتقول عند الخسران {عسى ربنا أن يبدلنا خيرا منها إنا إلى ربنا راغبون} وتقول عند ابتداء الأمور ربنا آتنا من لدنك رحمة وهيىء لنا من أمرنا رشدا رب اشرح لي صدري ويسر لي أمري وتقول عند النظر إلى السماء ربنا ما خلقت هذا باطلا سبحانك فقنا عذاب النار تبارك الذي جعل في السماء بروجا وجعل فيها سراجا وقمرا منيرا وإذا سمعت صوت الرعد فقل سبحان من يسبح الرعد بحمده والملائكة من خيفته (7) فإن رأيت الصواعق فقل اللهم لا تقتلنا بغضبك ولا تهلكنا بعذابك وعافنا قبل ذلك (8) قاله كعب فإذا أمطرت السماء فقل اللهم سقيا هنيئا وصيبا نافعا (9)", "english": "When you rise in the morning and hear the call to prayer (adhān), it is recommended for you to respond to the caller of prayer (mu'adhdhin) — and we have already mentioned this, along with the supplications for entering and leaving the privy, and the supplications of ablution (wuḍū'), in the Book of Purification. When you set out toward the mosque, say: \"O Allah, place light (nūr) in my heart, and light in my tongue, and place light in my hearing, and place light in my sight, and place light behind me, and light before me, and place light above me. O Allah, grant me light.\" And also say: \"O Allah, I ask You by the right of those who ask of You, and by the right of this my walking unto You — for I have not gone out in insolence, nor in vanity, nor for show, nor for reputation. I have gone out seeking protection from Your wrath and seeking Your good pleasure. So I ask You to deliver me from the Fire and to forgive me my sins — verily, none forgives sins but You.\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 254", "section_title_en": "Section 254 — Supplications for the Hours of Day and Night: From Dawn to Sleep", "section_index": 254, "anchors": "- Root: ن و ر (n-w-r)\n  * Lisan / Ayn: النور: الضوء المنتشر الذي يُبصر به، وهو ضد الظلمة\n  * Al-Raghib (Mufradat): النور في القرآن يقع على ضروب: منها المعقول كالإيمان والحكمة، قال تعالى: {قد جاءكم من الله نور وكتاب مبين}، ومنها المحسوس كضوء الشمس والقمر\n  * Al-Zamakhshari (Asas): النور حقيقة في الضوء المحسوس، ومجاز في الهدى والإيمان والعلم — فدعاء النبي صلى الله عليه وسلم بطلب النور يشمل المعنيين جميعاً\n- Root: س ج د (s-j-d)\n  * Lisan / Ayn: السجود: وضع الجبهة على الأرض تعظيماً، وأصله التطامن والانخفاض\n  * Al-Raghib (Mufradat): السجود ضربان: سجود عبادة وهو وضع الجبهة على الأرض تقرباً، وسجود طاعة وهو الانقياد والخضوع — قال تعالى: {ولله يسجد من في السموات والأرض طوعاً وكرهاً}\n  * Al-Zamakhshari (Asas): سجد حقيقة في وضع الجبهة، ومجاز في الخضوع والانقياد — وقوله \"سجد لك سوادي وخيالي\" من المجاز المرسل\n- Root: ذ ك ر (dh-k-r)\n  * Lisan / Ayn: الذكر: نقيض النسيان، والذكر: الصوت الذي يُذكر به الشيء، والذكر: الشرف والصيت\n  * Al-Raghib (Mufradat): الذكر ضربان: ذكر بالقلب وهو التفكر في عظمة الله، وذكر باللسان وهو التلفظ بأسمائه — وأعلى مراتبه ما اجتمع فيه القلب واللسان\n  * Al-Zamakhshari (Asas): الذكر حقيقة في استحضار الشيء بالقلب أو اللسان، ومجاز في الصلاة والدعاء والثناء\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — جواز تقديم المعمول وتأخيره مع بقاء العامل عاملاً في المعنى، كقوله \"لك الحمد\" حيث تقدم الجار والمجرور على المبتدأ للاختصاص والاهتمام", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "35": [{"arabic": "أن تكون غدا من أمته وأتباعه وما أبعد ظنك وما أبرد طمعك {أفنجعل المسلمين كالمجرمين ما لكم كيف تحكمون} ولنرجع إلى ما كنا فيه وبصدده فقد امتد عنان الكلام إلى غير مقصده ولنذكر الآن من المنامات الكاشفة لأحوال الموتى ما يعظم الانتفاع به إذ ذهبت النبوة وبقيت المبشرات وليس ذلك إلا المنامات", "english": "If [the matter of death] were a lasting misery or an enduring felicity, that alone would suffice to consume the entirety of one's lifespan. And the wonder is at our heedlessness while these enormities lie before our very eyes; and more wondrous still is our rejoicing over our wealth, our families, our means, our offspring — nay, even over our limbs, our hearing, and our sight — despite our certain knowledge that we shall part from all of that. But where is the one who breathes the Spirit of Holiness (rūḥ al-quds) into his breast such that he utters what was said to the Master of the Prophets: \"Love whom you will, for you shall part from him; live as you will, for you shall die; and do what you will, for you shall be recompensed for it\" {«أحبب من أحببت فإنك مفارقه وعش ما شئت فإنك ميت واعمل ما شئت فإنك مجزي به»}? Without doubt, since that was unveiled to him with the eye of certainty (ʿayn al-yaqīn), he was in this world like a wayfarer passing through: he laid no brick upon brick, nor reed upon reed {«لم يضع لبنة على لبنة ولا قصبة على قصبة»}, he left behind no dinar nor dirham {«ولم يخلف دينارا ولا درهما»}, and he took no beloved nor intimate friend. Indeed, he said: \"Had I taken an intimate friend (khalīl), I would have taken Abū Bakr as a friend; but your companion is the intimate friend of the Merciful\" {«لو كنت متخذا خليلا لاتخذت أبا بكر خليلا ولكن صاحبكم خليل الرحمن»}. Thus he made clear that the intimacy of the Merciful (khullat al-Raḥmān) had permeated the innermost depth of his heart, and that his love had taken firm hold upon the very core of his heart, leaving therein no space for any friend or beloved. And he said to his community: {«إن كنتم تحبون الله فاتبعوني يحببكم الله»} — \"If you love God, then follow me, and God will love you.\" For his community is only those who follow him; and none follows him save one who turns away from this world and turns toward the Hereafter. For he called only to God and the Last Day, and he turned away only from this world and its fleeting appetites. So to the extent that you turn away from this world and turn toward the Hereafter, to that extent you have trodden his path which he trod; and to the extent that you tread his path, to that extent you have followed him; and to the extent that you follow him, to that extent you have become of his community; and to the extent that you turn toward this world, to that extent you have deviated from his path, turned away from following him, and joined those of whom God the Exalted said: {«فأما من طغى وآثر الحياة الدنيا فإن الجحيم هي المأوى»} — \"As for him who transgressed and preferred the life of this world, then indeed the Fire is the abode.\" So if you were to emerge from the hiding-place of delusion and deal justly with yourself — O man, and each of us is that man — you would know that from the moment you rise in the morning until the moment you retire at night, you strive only for fleeting appetites, and you move not nor rest save for something immediate in this world; then you aspire that tomorrow you shall be of his community and his followers. How far is your conjecture, and how cold is your hope! {«أفنجعل المسلمين كالمجرمين ما لكم كيف تحكمون»} — \"Shall We make the Muslims like the criminals? What is the matter with you, how do you judge?\" Let us now return to what we were upon and what was its purpose, for the reins of discourse have stretched far beyond its intended aim. Let us now mention, from among the dreams that unveil the states of the dead, that whose benefit is great — since prophethood has ceased while the glad tidings (mubashshirāt) remain, and that is none other than dreams.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1328", "section_title_en": "The Eighth Book: On What Has Been Revealed of the States of the Dead through Unveiling (Mukāshafah) in Dreams", "section_index": 1328, "anchors": "- Root: سبل (s-b-l)\n  * Lisan / Ayn: The path that is easy and trodden; the wayfarer (sābil) is one who traverses it.\n  * Al-Raghib (Mufradat): Al-Sabīl is the road of ease; when used absolutely, it designates the path of truth (ṭarīq al-ḥaqq).\n  * Al-Zamakhshari (Asas): Literal: a beaten road. Metaphorical: \"asbala al-maṭar\" — the rain poured forth as if letting down a veil (sitār).\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the exclusive linkage of following the Prophet to turning away from this world.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}], "44": [{"arabic": "الخيرات بل لا يشعرون وقال تعالى سنستدرجهم من حيث لا يعلمون وقال تعالى فتحنا عليهم أبواب كل شيء حتى إذا فرحوا بما أوتوا أخذناهم بغتة فإذا هم مبلسون وفي تفسير قوله تعالى سنستدرجهم من حيث لا يعلمون أنهم كلما أحدثوا ذنبا أحدثنا لهم نعمة ليزيد غرورهم وقال تعالى إنما نملي لهم ليزدادوا إثما وقال تعالى ولا تحسبن الله غافلا عما يعمل الظالمون إنما يؤخرهم ليوم تشخص فيه الأبصار إلى غير ذلك مما ورد في كتاب الله تعالى وسنة رسوله فمن آمن به تخلص من هذا الغرور فإن منشأ هذا الغرور الجهل بالله وبصفاته فإن من عرفه لا يأمن م", "english": "As for knowing it by way of authoritative transmission and affirmation (taṣdīq): it is that one believes in the Book of God — exalted is He — and affirms His Messenger. For God — exalted is He — has said: {«أيحسبون أن ما نمدهم به من مال وبنين * نسارع لهم في الخيرات بل لا يشعرون»} — \"Do they reckon that what We extend to them of wealth and sons — [that] We hasten for them good things? Nay, but they do not perceive\" (Q. 23:55-56). And He said — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — \"We shall draw them on by degrees from whence they do not know\" (Q. 7:182). And He said — exalted is He: {«فتحنا عليهم أبواب كل شيء حتى إذا فرحوا بما أوتوا أخذناهم بغتة فإذا هم مبلسون»} — \"We opened upon them the gates of everything, until when they rejoiced in what they were given, We seized them suddenly, and behold, they were in despair\" (Q. 6:44). And in the interpretation of His saying — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — it is said: \"Whenever they innovated a sin, We innovated for them a blessing, to increase their self-deception.\" And He said — exalted is He: {«إنما نملي لهم ليزدادوا إثما»} — \"We only grant them respite that they may increase in sin\" (Q. 3:178). And He said — exalted is He: {«ولا تحسبن الله غافلا عما يعمل الظالمون إنما يؤخرهم ليوم تشخص فيه الأبصار»} — \"And do not reckon God heedless of what the wrongdoers do; He only delays them to a Day when eyes will stare fixedly\" (Q. 14:42). And [there is] more of that kind which has come in the Book of God — exalted is He — and in the Sunnah of His Messenger. So whoever believes in it is delivered from this self-deception. For the origin of this self-deception is ignorance of God and of His attributes; for whoever knows Him does not feel secure from His stratagem (makr) and is not deceived by such corrupt fancies.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 888", "section_title_en": "Section 888 — On the Remedy for Self-Deception (Ghurūr): Recognizing the Signs of Divine Honor (Karāmah) and Humiliation (Hawān)", "section_index": 888, "anchors": "- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Core meaning of an outward trace or mark; heedlessness in wakefulness; the blaze on a horse's forehead.\n  * Al-Raghib (Mufradat): \"Ghurūr\" is delusion stemming from heedlessness — the soul's being overtaken while imagining security, as in {«ما غرك بربك الكريم»} (Q. 82:6). It is the state of one who is deceived by apparent favors while blind to their underlying test.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): heedlessness and exposure to predation, like a gazelle deceived by moonlight. Metaphorical (Majaz): being \"deceived by God\" (ightirār billāh) — trusting in His mercy while persisting in disobedience.\n- Root: لهم (l-h-m)\n  * Lisan / Ayn: Swallowing whole; the gullet.\n  * Al-Raghib (Mufradat): \"Ilhām\" — God's casting a meaning into the heart (al-raw'), distinct from demonic whispering; the channel of inner vision for the knowers (ʿārifūn).\n  * Al-Zamakhshari (Asas): Literal: to swallow. Metaphorical: the heart's receptive \"swallowing\" of divine inspiration.\n- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: Origination after non-existence; newness.\n  * Al-Raghib (Mufradat): \"Ḥudūth\" — a thing's coming to be after it was not; \"muḥdith\" — the originator, exclusively God for substances (jawāhir). \"Iḥdāth\" — bringing about a novel state or act.\n  * Al-Zamakhshari (Asas): Literal: temporal newness. Metaphorical: \"muḥaddath\" — one inspired with correct discernment, as if newly spoken-to.\n- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Softness, ease, well-being; a state of comfort.\n  * Al-Raghib (Mufradat): \"Niʿmah\" — the good state one inhabits; \"naʿīm\" — the act of living pleasantly. Blessings are both a test and a sign, per {«وإن تعدوا نعمة الله لا تحصوها»} (Q. 16:18).\n  * Al-Zamakhshari (Asas): Literal: bounty and comfort. Metaphorical: \"khafat naʿāmatuhum\" — their prosperity vanished; blessings may signal either favor or gradual ruin (istidrāj).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication with \"innamā\")\n  * In {«إنما نملي لهم ليزدادوا إثما»} (Q. 3:178) and {«إنما يؤخرهم ليوم تشخص فيه الأبصار»} (Q. 14:42), \"innamā\" restricts the purpose of divine respite exclusively to increase of sin and deferred reckoning — negating any reading of it as benevolent indulgence.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Condemnation of Delusion'", "badge": "Dhikr"}, {"arabic": "بأن يخطر لهم على سبيل الورود عليهم من حيث لا يعلمون وتارة على سبيل الرؤيا الصادقة وتارة في اليقظة على سبيل كشف المعاني بمشاهدة الأمثلة كما يكون في المنام وهذا أعلى الدرجات وهي من درجات النبوة العالية كما أن الرؤيا الصادقة جزء من ستة وأربعين جزءا من النبوة فإياك أن يكون حظك من هذا العلم إنكار ما جاوز حد قصورك ففيه هلك المتحذلقون من العلماء الزاعمون أنهم أحاطوا بعلوم العقول فالجهل خير من عقل يدعو إلى إنكار مثل هذه الأمور لأولياء الله تعالى ومن أنكر ذلك للأولياء لزمه إنكار الأنبياء وكان خارجا عن", "english": "For this reason ʿAlī, may God be pleased with him, said — when it was said to him, \"You have opposed so-and-so\" — \"The best of us is the most following of us of this religion.\" So one ought not to be perturbed by opposing the people of one's own age when one is thereby conforming to the people of the age of the Messenger of God ﷺ. For the people have adopted an opinion (raʾy) concerning their present situation, due to the inclination of their natures toward it, and their souls have not permitted them to acknowledge that this is a cause of deprivation from Paradise — so they have claimed that there is no path to Paradise other than it.", "book_title": "Book of Knowledge", "section_title_ar": "Section 64", "section_title_en": "** Section 64 — On the Sciences of the Inner Life: The Obligation to Follow the Salaf and the Condemnation of Innovation (Bidʿah)", "section_index": 64, "anchors": "**\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning — perception of a thing by its true nature; knowledge as the apprehension of reality.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment upon the thing.\n  * Al-Zamakhshari (Asas): Literal usage — \"ما علمت بخبرك: ما شعرت به\" (I did not know of your news: I had no awareness of it). The scholar (ʿālim) is one whose knowledge is manifest in action.\n- Root: بدع (badaʿa)\n  * Lisan / Ayn: Core meaning — to originate, to create something new without prior example.\n  * Al-Raghib (Mufradat): \"الإبداع: إنشاء صنعة بلا احتذاء واقتداء\" — origination of a thing without model or precedent. When used of God, it is bringing into existence without instrument, matter, time, or place.\n  * Al-Zamakhshari (Asas): Literal — \"أبدع الشيء وابتدعه: اخترعه\" (he originated it and innovated it: he invented it). Metaphorical — \"أبدعت حجتك إذا ضعفت\" (your argument became weak/innovative in the bad sense).\n- Root: حدث (ḥadatha)\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — coming-to-be of a thing after it was not. \"المحدث: ما أوجد بعد أن لم يكن\" — the originated thing.\n  * Al-Zamakhshari (Asas): Literal — \"هو حدث من الأحداث\" (he is a youth among youths). Metaphorical — \"صاروا أحاديث\" (they became [mere] tales). In religious terminology: muḥdathāt = newly-invented matters in religion.\n- Root: هدى (hadā)\n  * Al-Raghib (Mufradat): Guidance — directing to the path with gentleness; al-hudā is the guidance of the Prophet ﷺ in matters of religion.\n  * Al-Zamakhshari (Asas): \"حسن الهدى\" — excellent guidance, the prophetic way (sunnah) as opposed to innovation.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما هما اثنتان: الكلام والهدى\" restricts the two matters exclusively to speech and guidance, excluding all else.\n\n---\n\n#", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "48": [{"arabic": "وقيل له فاصبر لحكم ربك ولا تكن كصاحب الحوت إذ نادى وهو مكظوم وهذه الاختلافات بعضها لاختلاف الأحوال والمقامات وبعضها لما سبق في الأزل من التفاضل والتفاوت في القسمة بين العباد وقد قال تعالى ولقد فضلنا بعض النبين على بعض وقد قال منهم من كلم الله ورفع بعضهم درجات فكان عيسى عليه السلام من المفضلين ولإدلاله سلم على نفسه فقال والسلام علي يوم ولدت ويوم أموت ويوم أبعث حيا وهذا انبساط منه لما شاهد من اللطف في مقام الأنس وأما يحيى بن زكريا عليه السلام فإنه أقيم مقام الهيبة والحياء فلم ينطق حتى أثنى عليه خالقه فقال", "english": "As for Adam (peace be upon him), it was said concerning him: {«وعصى آدم ربه فغوى»} \"And Adam disobeyed his Lord, so he went astray\" (Q. 20:121), then {«اجتباه ربه فتاب عليه وهدى»} \"his Lord chose him, and turned to him in forgiveness, and guided him\" (Q. 20:122).", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1187", "section_title_en": "On the Varieties of Divine Proximity (Al-Inbisāṭ) and Awe (Al-Haybah) in the States of the Prophets and Saints", "section_index": 1187, "anchors": "- Root: بسط (B-S-T)\n  * Lisan / Ayn: Core meaning is \"to spread out, extend, expand\" — both physically (basting a garment) and metaphorically.\n  * Al-Raghib (Mufradat): Theological nuance: \"بسط الشيء: نشره وتوسيعه\" — used for expansion of mercy, favor, and the soul's comfort. In Kalam, it contrasts with *qabḍ* (contraction/withholding).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"بسط الثوب والفراش إذا نشره.\" Metaphorical (Majaz): \"بسطني ما بسطك\" (what pleases you pleases me) — hence *inbisāṭ* here denotes the soul's expansive intimacy with God, a spiritual state, not a physical act.\n- Root: أبلس (B-L-S)\n  * Lisan / Ayn: \"أبلس: انقطعت حجته ويئس\" — to be reduced to silence, to despair.\n  * Al-Raghib (Mufradat): \"الإبلاس: الحزن المعترض من شدة اليأس\" — the despair of Iblis is a theological state of being cut off from mercy.\n  * Al-Zamakhshari (Asas): Literal: despair/silence. Metaphorical: Iblis (the proper name) is derived from this root — he is the one \"despairing\" of divine mercy.\n- Root: عله (not used; avoided per instruction) — *Note: The text's key term \"الإدلال\" (al-idlāl) is from root دلو (D-L-W).*\n- Root: دلو (D-L-W)\n  * Lisan / Ayn: \"دلا الدلو: أخرجها من البئر\" — to draw water from a well; hence *iddalā'a* (إدلال) means to advance boldly, relying on a familiar bond.\n  * Al-Raghib (Mufradat): Not a primary Quranic term, but lexically implies confident approach based on prior intimacy.\n  * Al-Zamakhshari (Asas): Literal: lowering the bucket. Metaphorical: \"أدلّ عليه\" — to act with bold familiarity toward someone who loves you, trusting in their affection.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Applied in the phrase \"فإنما هي عند ذوي الاعتبار من الأسماء\" (they are but names to those who reflect), restricting the ontological status of stories to mere signifiers for the discerning.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "49": [{"arabic": "إلى يوم القيامة لولا أن تداركه نعمة من ربه لنبذ بالعراء وهو مذموم قال الحسن العراء هو القيامة ونهى نبينا صلى الله عليه وسلم أن يقتدى به وقيل له فاصبر لحكم ربك ولا تكن كصاحب الحوت إذ نادى وهو مكظوم وهذه الاختلافات بعضها لاختلاف الأحوال والمقامات وبعضها لما سبق في الأزل من التفاضل والتفاوت في القسمة بين العباد وقد قال تعالى ولقد فضلنا بعض النبين على بعض وقد قال منهم من كلم الله ورفع بعضهم درجات فكان عيسى عليه السلام من المفضلين ولإدلاله سلم على نفسه فقال والسلام علي يوم ولدت ويوم أموت ويوم أبعث حيا وهذا انبساط م", "english": "As for Adam (peace be upon him), it was said concerning him: {«وعصى آدم ربه فغوى»} \"And Adam disobeyed his Lord, so he went astray\" (Q. 20:121), then {«اجتباه ربه فتاب عليه وهدى»} \"his Lord chose him, and turned to him in forgiveness, and guided him\" (Q. 20:122).", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1187", "section_title_en": "On the Varieties of Divine Proximity (Al-Inbisāṭ) and Awe (Al-Haybah) in the States of the Prophets and Saints", "section_index": 1187, "anchors": "- Root: بسط (B-S-T)\n  * Lisan / Ayn: Core meaning is \"to spread out, extend, expand\" — both physically (basting a garment) and metaphorically.\n  * Al-Raghib (Mufradat): Theological nuance: \"بسط الشيء: نشره وتوسيعه\" — used for expansion of mercy, favor, and the soul's comfort. In Kalam, it contrasts with *qabḍ* (contraction/withholding).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"بسط الثوب والفراش إذا نشره.\" Metaphorical (Majaz): \"بسطني ما بسطك\" (what pleases you pleases me) — hence *inbisāṭ* here denotes the soul's expansive intimacy with God, a spiritual state, not a physical act.\n- Root: أبلس (B-L-S)\n  * Lisan / Ayn: \"أبلس: انقطعت حجته ويئس\" — to be reduced to silence, to despair.\n  * Al-Raghib (Mufradat): \"الإبلاس: الحزن المعترض من شدة اليأس\" — the despair of Iblis is a theological state of being cut off from mercy.\n  * Al-Zamakhshari (Asas): Literal: despair/silence. Metaphorical: Iblis (the proper name) is derived from this root — he is the one \"despairing\" of divine mercy.\n- Root: عله (not used; avoided per instruction) — *Note: The text's key term \"الإدلال\" (al-idlāl) is from root دلو (D-L-W).*\n- Root: دلو (D-L-W)\n  * Lisan / Ayn: \"دلا الدلو: أخرجها من البئر\" — to draw water from a well; hence *iddalā'a* (إدلال) means to advance boldly, relying on a familiar bond.\n  * Al-Raghib (Mufradat): Not a primary Quranic term, but lexically implies confident approach based on prior intimacy.\n  * Al-Zamakhshari (Asas): Literal: lowering the bucket. Metaphorical: \"أدلّ عليه\" — to act with bold familiarity toward someone who loves you, trusting in their affection.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Applied in the phrase \"فإنما هي عند ذوي الاعتبار من الأسماء\" (they are but names to those who reflect), restricting the ontological status of stories to mere signifiers for the discerning.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 1444], [2, 1444, 3854], [3, 3854, 5501], [4, 5501, 8474]], "2": [[1, 350, 1794], [2, 1794, 2690], [3, 2690, 4090], [4, 4090, 5140], [5, 5140, 7029]], "3": [[1, 350, 1633], [2, 1633, 2131], [3, 2131, 3638], [4, 3638, 4535], [5, 4535, 5905]], "4": [[1, 350, 1966], [2, 1966, 3437], [3, 3437, 4304], [4, 4304, 5618]], "5": [[1, 350, 2006], [2, 2006, 4260]], "6": [[1, 350, 2502], [2, 2502, 4260]], "7": [[1, 400, 1467], [2, 1467, 2563], [3, 2563, 3265], [4, 3265, 4551], [5, 4551, 5428], [6, 5428, 6320], [7, 6320, 6963], [8, 6963, 8571], [9, 8571, 9711], [10, 9711, 10997], [11, 10997, 13542]], "8": [[1, 350, 1293], [2, 1293, 2210], [3, 2210, 4495]], "9": [[1, 350, 1767], [2, 1767, 2325], [3, 2325, 3251], [4, 3251, 5069]], "10": [[1, 350, 1432], [2, 1432, 2355], [3, 2355, 3081], [4, 3081, 4519], [5, 4519, 6062]], "11": [[1, 400, 2677], [2, 2677, 6317], [3, 6317, 8422]], "12": [[1, 350, 2267], [2, 2267, 3848], [3, 3848, 4894], [4, 4894, 6088]], "13": [[1, 350, 1754], [2, 1754, 2891], [3, 2891, 4227], [4, 4227, 5827]], "14": [[1, 350, 1019], [2, 1019, 2114], [3, 2114, 2935], [4, 2935, 4030], [5, 4030, 5853]], "15": [[1, 400, 1233], [2, 1233, 2386], [3, 2386, 3368], [4, 3368, 5162], [5, 5162, 5973], [6, 5973, 7416], [7, 7416, 9258]], "16": [[1, 350, 1538], [2, 1538, 2400], [3, 2400, 4077]], "17": [[1, 400, 1748], [2, 1748, 3546], [3, 3546, 4471], [4, 4471, 6695], [5, 6695, 8046], [6, 8046, 9471], [7, 9471, 10062], [8, 10062, 12091], [9, 12091, 14852], [10, 14852, 16625]], "18": [[1, 250, 1184], [2, 1184, 3051]], "19": [[1, 400, 1681], [2, 1681, 3302], [3, 3302, 5331], [4, 5331, 6233], [5, 6233, 7410], [6, 7410, 8299], [7, 8299, 10904]], "20": [[1, 250, 1733], [2, 1733, 3548]], "21": [[1, 350, 2137], [2, 2137, 3554]], "22": [[1, 400, 966], [2, 966, 2380], [3, 2380, 3563], [4, 3563, 4900], [5, 4900, 5466], [6, 5466, 6495], [7, 6495, 8187]], "23": [[1, 350, 2576], [2, 2576, 3426], [3, 3426, 5618]], "24": [[1, 400, 909], [2, 909, 1685], [3, 1685, 3955], [4, 3955, 5182], [5, 5182, 6502], [6, 6502, 8135]], "25": [[1, 350, 2129], [2, 2129, 3351], [3, 3351, 4174], [4, 41