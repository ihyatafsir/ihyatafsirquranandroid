: "", "root": ""}, {"id": 8, "arabic": "يَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 34, "text": "إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّٰتِ اِ۬لنَّعِيمِۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِلْمُتَّقِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "عِندَ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبِّهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "جَنَّٰتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لنَّعِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 35, "text": "أَفَنَجْعَلُ اُ۬لْمُسْلِمِينَ كَالْمُجْرِمِينَۖ", "words": [{"id": 1, "arabic": "أَفَنَجْعَلُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لْمُسْلِمِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَالْمُجْرِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 36, "text": "مَا لَكُمْۖ كَيْفَ تَحْكُمُونَۖ", "words": [{"id": 1, "arabic": "مَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَكُمْۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَيْفَ", "translit": "", "root": ""}, {"id": 4, "arabic": "تَحْكُمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 37, "text": "أَمْ لَكُمْ كِتَٰبࣱ فِيهِ تَدْرُسُونَ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "كِتَٰبࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "تَدْرُسُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 38, "text": "إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "تَخَيَّرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 39, "text": "أَمْ لَكُمُۥٓ أَيْمَٰنٌ عَلَيْنَا بَٰلِغَةٌ اِلَيٰ يَوْمِ اِ۬لْقِيَٰمَةِ إِنَّ لَكُمْ لَمَا تَحْكُمُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَكُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَيْمَٰنٌ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَيْنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "بَٰلِغَةٌ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِلَيٰ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَوْمِ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لْقِيَٰمَةِ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "لَمَا", "translit": "", "root": ""}, {"id": 12, "arabic": "تَحْكُمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 40, "text": "سَلْهُمُۥٓ أَيُّهُم بِذَٰلِكَ زَعِيمٌۖ", "words": [{"id": 1, "arabic": "سَلْهُمُۥٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَيُّهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "بِذَٰلِكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "زَعِيمٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 41, "text": "اَمْ لَهُمْ شُرَكَآءُ فَلْيَاتُواْ بِشُرَكَآئِهِمُۥٓ إِن كَانُواْ صَٰدِقِينَۖ", "words": [{"id": 1, "arabic": "اَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "شُرَكَآءُ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَلْيَاتُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِشُرَكَآئِهِمُۥٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِن", "translit": "", "root": ""}, {"id": 7, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "صَٰدِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 42, "text": "يَوْمَ يُكْشَفُ عَن سَاقࣲ وَيُدْعَوْنَ إِلَي اَ۬لسُّجُودِ فَلَا يَسْتَطِيعُونَۖ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يُكْشَفُ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَن", "translit": "", "root": ""}, {"id": 4, "arabic": "سَاقࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَيُدْعَوْنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لسُّجُودِ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 9, "arabic": "يَسْتَطِيعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 43, "text": "خَٰشِعَةً اَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةࣱۖ وَقَدْ كَانُواْ يُدْعَوْنَ إِلَي اَ۬لسُّجُودِ وَهُمْ سَٰلِمُونَۖ", "words": [{"id": 1, "arabic": "خَٰشِعَةً", "translit": "", "root": ""}, {"id": 2, "arabic": "اَبْصَٰرُهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "تَرْهَقُهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "ذِلَّةࣱۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَقَدْ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "يُدْعَوْنَ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لسُّجُودِ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "سَٰلِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 44, "text": "فَذَرْنِے وَمَنْ يُّكَذِّبُ بِهَٰذَا اَ۬لْحَدِيثِۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ", "words": [{"id": 1, "arabic": "فَذَرْنِے", "translit": "", "root": ""}, {"id": 2, "arabic": "وَمَنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "يُّكَذِّبُ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِهَٰذَا", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْحَدِيثِۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "سَنَسْتَدْرِجُهُم", "translit": "", "root": ""}, {"id": 7, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 8, "arabic": "حَيْثُ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَا", "translit": "", "root": ""}, {"id": 10, "arabic": "يَعْلَمُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 45, "text": "وَأُمْلِے لَهُمُۥٓۖ إِنَّ كَيْدِے مَتِينٌۖ", "words": [{"id": 1, "arabic": "وَأُمْلِے", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُمُۥٓۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَيْدِے", "translit": "", "root": ""}, {"id": 5, "arabic": "مَتِينٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 46, "text": "اَمْ تَسْـَٔلُهُمُۥٓ أَجْراࣰ فَهُم مِّن مَّغْرَمࣲ مُّثْقَلُونَۖ", "words": [{"id": 1, "arabic": "اَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَسْـَٔلُهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَجْراࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَهُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 6, "arabic": "مَّغْرَمࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّثْقَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 47, "text": "أَمْ عِندَهُمُ اُ۬لْغَيْبُ فَهُمْ يَكْتُبُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عِندَهُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْغَيْبُ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَكْتُبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 48, "text": "۞فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَٰحِبِ اِ۬لْحُوتِ إِذْ نَاد۪يٰ وَهُوَ مَكْظُومࣱۖ", "words": [{"id": 1, "arabic": "۞فَاصْبِرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِحُكْمِ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 5, "arabic": "تَكُن", "translit": "", "root": ""}, {"id": 6, "arabic": "كَصَٰحِبِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْحُوتِ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 9, "arabic": "نَاد۪يٰ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 11, "arabic": "مَكْظُومࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 49, "text": "لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةࣱ مِّن رَّبِّهِۦ لَنُبِذَ بِالْعَرَآءِ وَهُوَ مَذْمُومࣱۖ", "words": [{"id": 1, "arabic": "لَّوْلَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَن", "translit": "", "root": ""}, {"id": 3, "arabic": "تَدَٰرَكَهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "نِعْمَةࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 6, "arabic": "رَّبِّهِۦ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَنُبِذَ", "translit": "", "root": ""}, {"id": 8, "arabic": "بِالْعَرَآءِ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 10, "arabic": "مَذْمُومࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 50, "text": "فَاجْتَبٰ۪هُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ اَ۬لصَّٰلِحِينَۖ", "words": [{"id": 1, "arabic": "فَاجْتَبٰ۪هُ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبُّهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَجَعَلَهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لصَّٰلِحِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 51, "text": "وَإِنْ يَّكَادُ اُ۬لذِينَ كَفَرُواْ لَيَزْلِقُونَكَ بِأَبْصٰ۪رِهِمْ لَمَّا سَمِعُواْ اُ۬لذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونࣱۖ", "words": [{"id": 1, "arabic": "وَإِنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَّكَادُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَيَزْلِقُونَكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِأَبْصٰ۪رِهِمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَمَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "سَمِعُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬لذِّكْرَ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَيَقُولُونَ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 12, "arabic": "لَمَجْنُونࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 52, "text": "وَمَا هُوَ إِلَّا ذِكْرࣱ لِّلْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "ذِكْرࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِّلْعَٰلَمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}]}