, "ayah": 27, "text": "بَلْ نَحْنُ مَحْرُومُونَۖ", "words": [{"id": 1, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَحْرُومُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 28, "text": "قَالَ أَوْسَطُهُمُۥٓ أَلَمَ اَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَوْسَطُهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَلَمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَقُل", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَوْلَا", "translit": "", "root": ""}, {"id": 7, "arabic": "تُسَبِّحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 29, "text": "قَالُواْ سُبْحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "سُبْحَٰنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّنَآ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "ظَٰلِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 30, "text": "فَأَقْبَلَ بَعْضُهُمْ عَلَيٰ بَعْضࣲ يَتَلَٰوَمُونَۖ", "words": [{"id": 1, "arabic": "فَأَقْبَلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَعْضُهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "بَعْضࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَتَلَٰوَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 31, "text": "قَالُواْ يَٰوَيْلَنَآ إِنَّا كُنَّا طَٰغِينَ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰوَيْلَنَآ", "translit": "", "root": ""}, {"id": 3, "ar