, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "تَخَيَّرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 39, "text": "أَمْ لَكُمُۥٓ أَيْمَٰنٌ عَلَيْنَا بَٰلِغَةٌ اِلَيٰ يَوْمِ اِ۬لْقِيَٰمَةِ إِنَّ لَكُمْ لَمَا تَحْكُمُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَكُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَيْمَٰنٌ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَيْنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "بَٰلِغَةٌ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِلَيٰ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَوْمِ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لْقِيَٰمَةِ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "لَمَا", "translit": "", "root": ""}, {"id": 12, "arabic": "تَحْكُمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 40, "text": "سَلْهُمُۥٓ أَيُّهُم بِذَٰلِكَ زَعِيمٌۖ", "words": [{"id": 1, "arabic": "سَلْهُمُۥٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَيُّهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "بِذَٰلِكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "زَعِيمٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 41, "text": "اَمْ لَهُمْ شُرَكَآءُ فَلْيَاتُواْ بِشُرَكَآئِهِمُۥٓ إِن كَانُواْ صَٰدِقِينَۖ", "words": [{"id": 1, "arabic": "اَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "شُرَكَآءُ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَلْيَاتُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِشُرَكَآئِهِمُ