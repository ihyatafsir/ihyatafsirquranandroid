 "narration": "warsh"}, {"surah": 68, "ayah": 30, "text": "فَأَقْبَلَ بَعْضُهُمْ عَلَيٰ بَعْضࣲ يَتَلَٰوَمُونَۖ", "words": [{"id": 1, "arabic": "فَأَقْبَلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَعْضُهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "بَعْضࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَتَلَٰوَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 31, "text": "قَالُواْ يَٰوَيْلَنَآ إِنَّا كُنَّا طَٰغِينَ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰوَيْلَنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "طَٰغِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 32, "text": "عَس۪يٰ رَبُّنَآ أَنْ يُّبَدِّلَنَا خَيْراࣰ مِّنْهَآ إِنَّآ إِلَيٰ رَبِّنَا رَٰغِبُونَۖ", "words": [{"id": 1, "arabic": "عَس۪يٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبُّنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 4, "arabic": "يُّبَدِّلَنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "خَيْراࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّنْهَآ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنَّآ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 9, "arabic": "رَبِّنَا", "translit": "", "root": ""}, {"id": 10, "arabic": "رَٰغِبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 33, "text": "كَذَٰلِكَ اَ۬لْعَذَابُۖ وَلَعَذَابُ اُ۬لَاخِرَةِ أَكْبَرُ لَوْ كَانُواْ يَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "كَذَٰلِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْعَذَابُۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَلَعَذَابُ", "translit": "", "root": ""}, {"id": 4, "