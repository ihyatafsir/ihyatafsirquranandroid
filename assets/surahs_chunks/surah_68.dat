 "warsh"}, {"surah": 68, "ayah": 48, "text": "۞فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَٰحِبِ اِ۬لْحُوتِ إِذْ نَاد۪يٰ وَهُوَ مَكْظُومࣱۖ", "words": [{"id": 1, "arabic": "۞فَاصْبِرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِحُكْمِ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 5, "arabic": "تَكُن", "translit": "", "root": ""}, {"id": 6, "arabic": "كَصَٰحِبِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْحُوتِ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 9, "arabic": "نَاد۪يٰ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 11, "arabic": "مَكْظُومࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 49, "text": "لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةࣱ مِّن رَّبِّهِۦ لَنُبِذَ بِالْعَرَآءِ وَهُوَ مَذْمُومࣱۖ", "words": [{"id": 1, "arabic": "لَّوْلَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَن", "translit": "", "root": ""}, {"id": 3, "arabic": "تَدَٰرَكَهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "نِعْمَةࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 6, "arabic": "رَّبِّهِۦ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَنُبِذَ", "translit": "", "root": ""}, {"id": 8, "arabic": "بِالْعَرَآءِ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 10, "arabic": "مَذْمُومࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 50, "text": "فَاجْتَبٰ۪هُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ اَ۬لصَّٰلِحِينَۖ", "words": [{"id": 1, "arabic": "فَاجْتَبٰ۪هُ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبُّهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَجَعَلَهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لصَّٰلِحِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 51, "text": "وَإِنْ يَّكَادُ اُ۬لذِينَ كَفَرُواْ لَيَزْلِقُونَكَ بِأَبْصٰ۪رِهِمْ لَمَّا سَمِعُواْ اُ۬لذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونࣱۖ", "words": [{"id": 1, "arabic": "وَإِنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَّكَادُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَيَزْلِقُونَكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِأَبْصٰ۪رِهِمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَمَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "سَمِعُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬لذِّكْرَ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَيَقُولُونَ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 12, "arabic": "لَمَجْنُونࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 52, "text": "وَمَا هُوَ إِلَّا ذِكْرࣱ لِّلْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "ذِكْرࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِّلْعَٰلَمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}]}