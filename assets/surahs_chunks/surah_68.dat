, "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لسُّجُودِ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 9, "arabic": "يَسْتَطِيعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 43, "text": "خَٰشِعَةً اَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةࣱۖ وَقَدْ كَانُواْ يُدْعَوْنَ إِلَي اَ۬لسُّجُودِ وَهُمْ سَٰلِمُونَۖ", "words": [{"id": 1, "arabic": "خَٰشِعَةً", "translit": "", "root": ""}, {"id": 2, "arabic": "اَبْصَٰرُهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "تَرْهَقُهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "ذِلَّةࣱۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَقَدْ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "يُدْعَوْنَ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لسُّجُودِ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "سَٰلِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 44, "text": "فَذَرْنِے وَمَنْ يُّكَذِّبُ بِهَٰذَا اَ۬لْحَدِيثِۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ", "words": [{"id": 1, "arabic": "فَذَرْنِے", "translit": "", "root": ""}, {"id": 2, "arabic": "وَمَنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "يُّكَذِّبُ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِهَٰذَا", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْحَدِيثِۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "سَنَسْتَدْرِجُهُم", "translit": "", "root": ""}, {"id": 7, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 8, "arabic": "حَيْثُ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَا", "translit": "", "root": ""}, {"id": 10, "arabic": "يَعْلَمُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 68, "ayah": 45, "text": "وَأُمْلِے لَهُمُۥٓۖ إِنَّ كَيْدِے مَتِينٌۖ", "words": [{"id"