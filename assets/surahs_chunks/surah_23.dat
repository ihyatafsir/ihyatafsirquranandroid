ٰلِحاًۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِنِّے", "translit": "", "root": ""}, {"id": 9, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 10, "arabic": "تَعْمَلُونَ", "translit": "", "root": ""}, {"id": 11, "arabic": "عَلِيمࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 52, "text": "وَأَنَّ هَٰذِهِۦٓ أُمَّتُكُمُۥٓ أُمَّةࣰ وَٰحِدَةࣰۖ وَأَنَا رَبُّكُمْ فَاتَّقُونِۖ", "words": [{"id": 1, "arabic": "وَأَنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَٰذِهِۦٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُمَّتُكُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أُمَّةࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَٰحِدَةࣰۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "رَبُّكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَاتَّقُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 53, "text": "فَتَقَطَّعُوٓاْ أَمْرَهُم بَيْنَهُمْ زُبُراࣰۖ كُلُّ حِزْبِۢ بِمَا لَدَيْهِمْ فَرِحُونَۖ", "words": [{"id": 1, "arabic": "فَتَقَطَّعُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَمْرَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "بَيْنَهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "زُبُراࣰۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "كُلُّ", "translit": "", "root": ""}, {"id": 6, "arabic": "حِزْبِۢ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 8, "arabic": "لَدَيْهِمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "فَرِحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 54, "text": "فَذَرْهُمْ فِے غَمْرَتِهِمْ حَتَّيٰ حِينٍۖ", "words": [{"id": 1, "arabic": "فَذَرْهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "غَمْرَتِهِمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "حَتَّيٰ", "translit": 