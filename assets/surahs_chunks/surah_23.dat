: 23, "ayah": 29, "text": "وَقُل رَّبِّ أَنزِلْنِے مُنزَلاࣰ مُّبَٰرَكاࣰ وَأَنتَ خَيْرُ اُ۬لْمُنزِلِينَۖ", "words": [{"id": 1, "arabic": "وَقُل", "translit": "", "root": ""}, {"id": 2, "arabic": "رَّبِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنزِلْنِے", "translit": "", "root": ""}, {"id": 4, "arabic": "مُنزَلاࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّبَٰرَكاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَنتَ", "translit": "", "root": ""}, {"id": 7, "arabic": "خَيْرُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لْمُنزِلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 30, "text": "إِنَّ فِے ذَٰلِكَ لَأٓيَٰتࣲۖ وَإِن كُنَّا لَمُبْتَلِينَۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَأٓيَٰتࣲۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَإِن", "translit": "", "root": ""}, {"id": 6, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "لَمُبْتَلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 31, "text": "ثُمَّ أَنشَأْنَا مِنۢ بَعْدِهِمْ قَرْناً اٰخَرِينَ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَنشَأْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 4, "arabic": "بَعْدِهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَرْناً", "translit": "", "root": ""}, {"id": 6, "arabic": "اٰخَرِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 32, "text": "فَأَرْسَلْنَا فِيهِمْ رَسُولاࣰ مِّنْهُمُۥٓ أَنُ اُ۟عْبُدُواْ اُ۬للَّهَ مَا لَكُم مِّنِ اِلَٰهٍ غَيْرُهُۥٓۖ أَفَلَا تَتَّقُونَۖ", "words": [{"id": 1, "arabic": "فَأَرْسَلْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "فِيهِمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَسُولاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنْهُمُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَنُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۟عْبُدُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬للَّهَ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَا", "translit": "", "root": ""}, {"id": 9, "arabic": "لَكُم", "translit": "", "root": ""}, {"id": 10, "arabic": "مِّنِ", "translit": "", "root": ""}, {"id": 11, "arabic": "اِلَٰهٍ", "translit": "", "root": ""}, {"id": 12, "arabic": "غَيْرُهُۥٓۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "أَفَلَا", "translit": "", "root": ""}, {"id": 14, "arabic": "تَتَّقُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 33, "text": "وَقَالَ اَ۬لْمَلَأُ مِن قَوْمِهِ اِ۬لذِينَ كَفَرُواْ وَكَذَّبُواْ بِلِقَآءِ اِ۬لَاخِرَةِ وَأَتْرَفْنَٰهُمْ فِے اِ۬لْحَيَوٰةِ اِ۬لدُّنْي۪ا مَا هَٰذَآ إِلَّا بَشَرࣱ مِّثْلُكُمْ يَاكُلُ مِمَّا تَاكُلُونَ مِنْهُ وَيَشْرَبُ مِمَّا تَشْرَبُونَ", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْمَلَأُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَوْمِهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لذِينَ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَكَذَّبُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "بِلِقَآءِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لَاخِرَةِ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَأَتْرَفْنَٰهُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "فِے", "translit": "", "root": ""}, {"id": 12, "arabic": "اِ۬لْحَيَوٰةِ", "translit": "", "root": ""}, {"id": 13, "arabic": "اِ۬لدُّنْي۪ا", "translit": "", "root": ""}, {"id": 14, "arabic": "مَا", "translit": "", "root": ""}, {"id": 15, "arabic": "هَٰذَآ", "translit": "", "root": ""}, {"id": 16, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 17, "arabic": "بَشَرࣱ", "translit": "", "root": ""}, {"id": 18, "arabic": "مِّثْلُكُمْ", "translit": "", "root": ""}, {"id": 19, "arabic": "يَاكُلُ", "translit": "", "root": ""}, {"id": 20, "arabic": "مِمَّا", "translit": "", "root": ""}, {"id": 21, "arabic": "تَاكُلُونَ", "translit": "", "root": ""}, {"id": 22, "arabic": "مِنْهُ", "translit": "", "root": ""}, {"id": 23, "arabic": "وَيَشْرَبُ", "translit": "", "root": ""}, {"id": 24, "arabic": "مِمَّا", "translit": "", "root": ""}, {"id": 25, "arabic": "تَشْرَبُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 34, "text": "وَلَئِنَ اَطَعْتُم بَشَراࣰ مِّثْلَكُمُۥٓ إِنَّكُمُۥٓ إِذاࣰ لَّخَٰسِرُونَ", "words": [{"id": 1, "arabic": "وَلَئِنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَطَعْتُم", "translit": "", "root": ""}, {"id": 3, "arabic": "بَشَراࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّثْلَكُمُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنَّكُمُۥٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِذاࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَّخَٰسِرُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 35, "text": "أَيَعِدُكُمُۥٓ أَنَّكُمُۥٓ إِذَا مِتُّمْ وَكُنتُمْ تُرَاباࣰ وَعِظَٰماً اَنَّكُم مُّخْرَجُونَ", "words": [{"id": 1, "arabic": "أَيَعِدُكُمُۥٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَنَّكُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مِتُّمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَكُنتُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "تُرَاباࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَعِظَٰماً", "translit": "", "root": ""}, {"id": 8, "arabic": "اَنَّكُم", "translit": "", "root": ""}, {"id": 9, "arabic": "مُّخْرَجُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 36, "text": "هَيْهَاتَ هَيْهَاتَ لِمَا تُو