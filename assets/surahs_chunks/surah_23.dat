ah": 43, "text": "مَا تَسْبِقُ مِنُ ا۟مَّةٍ اَجَلَهَا وَمَا يَسْتَٰخِرُونَۖ", "words": [{"id": 1, "arabic": "مَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَسْبِقُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنُ", "translit": "", "root": ""}, {"id": 4, "arabic": "ا۟مَّةٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَجَلَهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "يَسْتَٰخِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 44, "text": "ثُمَّ أَرْسَلْنَا رُسُلَنَا تَتْر۪اۖ كُلَّ مَا جَآءَ اُ۟مَّةࣰ رَّسُولُهَا كَذَّبُوهُۖ فَأَتْبَعْنَا بَعْضَهُم بَعْضاࣰ وَجَعَلْنَٰهُمُۥٓ أَحَادِيثَۖ فَبُعْداࣰ لِّقَوْمࣲ لَّا يُومِنُونَۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "رُسُلَنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "تَتْر۪اۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "كُلَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "", "root": ""}, {"id": 7, "arabic": "جَآءَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۟مَّةࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "رَّسُولُهَا", "translit": "", "root": ""}, {"id": 10, "arabic": "كَذَّبُوهُۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "فَأَتْبَعْنَا", "translit": "", "root": ""}, {"id": 12, "arabic": "بَعْضَهُم", "translit": "", "root": ""}, {"id": 13, "arabic": "بَعْضاࣰ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَجَعَلْنَٰهُمُۥٓ", "translit": "", "root": ""}, {"id": 15, "arabic": "أَحَادِيثَۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "فَبُعْداࣰ", "translit": "", "root": ""}, {"id": 17, "arabic": "لِّقَوْمࣲ", "translit": "", "root": ""}, {"id": 18, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 19, "arabic": "يُومِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 45, "text": "ثُمَّ أَرْسَلْنَا مُوس۪يٰ وَأَخَاهُ هَٰرُونَ بِـَٔايَٰتِنَا وَسُلْطَٰنࣲ مُّبِينٍ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مُوس۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَأَخَاهُ", "translit": "", "root": ""}, {"id": 5, "arabic": "هَٰرُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِـَٔايَٰتِنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "وَسُلْطَٰنࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُّبِينٍ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 46, "text": "اِلَيٰ فِرْعَوْنَ وَمَلَإِيْهِۦ فَاسْتَكْبَرُواْ وَكَانُواْ قَوْماً عَالِينَۖ", "words": [{"id": 1, "arabic": "اِلَيٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِرْعَوْنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَمَلَإِيْهِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَاسْتَكْبَرُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَكَانُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَوْماً", "translit": "", "root": ""}, {"id": 7, "arabic": "عَالِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 47, "text": "فَقَالُوٓاْ أَنُومِنُ لِبَشَرَيْنِ مِثْلِنَا وَقَوْمُهُمَا لَنَا عَٰبِدُونَۖ", "words": [{"id": 1, "arabic": "فَقَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَنُومِنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِبَشَرَيْنِ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِثْلِنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "وَقَوْمُهُمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "لَنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "عَٰبِدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 48, "text": "فَكَذَّبُوهُمَا فَكَانُواْ مِنَ اَ۬لْمُهْلَكِينَۖ", "words": [{"id": 1, "arabic": "فَكَذَّبُوهُمَا", "translit": "", "root": ""}, {"id": 2, "arabic