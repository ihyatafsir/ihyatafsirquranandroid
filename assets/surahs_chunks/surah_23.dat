3, "ayah": 18, "text": "وَأَنزَلْنَا مِنَ اَ۬لسَّمَآءِ مَآءَۢ بِقَدَرࣲ فَأَسْكَنَّٰهُ فِے اِ۬لَارْضِۖ وَإِنَّا عَلَيٰ ذَهَابِۢ بِهِۦ لَقَٰدِرُونَۖ", "words": [{"id": 1, "arabic": "وَأَنزَلْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَآءَۢ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِقَدَرࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَأَسْكَنَّٰهُ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لَارْضِۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَإِنَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 11, "arabic": "ذَهَابِۢ", "translit": "", "root": ""}, {"id": 12, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 13, "arabic": "لَقَٰدِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 19, "text": "فَأَنشَأْنَا لَكُم بِهِۦ جَنَّٰتࣲ مِّن نَّخِيلࣲ وَأَعْنَٰبࣲ لَّكُمْ فِيهَا فَوَٰكِهُ كَثِيرَةࣱ وَمِنْهَا تَاكُلُونَ", "words": [{"id": 1, "arabic": "فَأَنشَأْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَكُم", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "جَنَّٰتࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 6, "arabic": "نَّخِيلࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَأَعْنَٰبࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَّكُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 10, "arabic": "فَوَٰكِهُ", "translit": "", "root": ""}, {"id": 11, "arabic": "كَثِيرَةࣱ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَمِنْهَا", "translit": "", "root": ""}, {"id": 13, "arabic": "تَاكُلُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 20, "text": "وَشَجَرَةࣰ تَخْرُجُ مِن طُورِ سِينَآءَ تَنۢبُتُ بِالدُّهْنِ وَصِبْغࣲ لِّلَاكِلِينَۖ", "words": [{"id": 1, "arabic": "وَشَجَرَةࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَخْرُجُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "طُورِ", "translit": "", "root": ""}, {"id": 5, "arabic": "سِينَآءَ", "translit": "", "root": ""}, {"id": 6, "arabic": "تَنۢبُتُ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِالدُّهْنِ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَصِبْغࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "لِّلَاكِلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 21, "text": "وَإِنَّ لَكُمْ فِے اِ۬لَانْعَٰمِ لَعِبْرَةࣰۖ نَّسْقِيكُم مِّمَّا فِے بُطُونِهَاۖ وَلَكُمْ فِيهَا مَنَٰفِعُ كَثِيرَةࣱ وَمِنْهَا تَاكُلُونَ", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لَانْعَٰمِ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَعِبْرَةࣰۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "نَّسْقِيكُم", "translit": "", "root": ""}, {"id": 7, "arabic": "مِّمَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "بُطُونِهَاۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَلَكُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 12, "arabic": "مَنَٰفِعُ", "translit": "", "root": ""}, {"id": 13, "arabic": "كَثِيرَةࣱ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَمِنْهَا", "translit": "", "root": ""}, {"id": 15, "arabic": "تَاكُلُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 22, "text": "وَعَلَيْهَا وَعَلَي اَ۬لْفُلْكِ تُحْمَلُونَۖ", "words": [{"id": 1, "arabic": "وَعَلَيْهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "وَعَلَي", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْفُلْكِ", "translit": "", "root": ""}, {"id": 4, "arabic": "تُحْمَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 23, "text": "وَلَقَدَ اَرْسَلْنَا نُوحاً اِلَيٰ قَوْمِهِۦ فَقَالَ يَٰقَوْمِ اِ۟عْبُدُواْ اُ۬للَّهَ مَا لَكُم مِّنِ اِلَٰهٍ غَيْرُهُۥٓۖ أَفَلَا تَتَّقُونَۖ", "words": [{"id": 1, "arabic": "وَلَقَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَرْسَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "نُوحاً", "translit": "", "root": ""}, {"id": 4, "arabic": "اِلَيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَوْمِهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَقَالَ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَٰقَوْمِ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۟عْبُدُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬للَّهَ", "translit": "", "root": ""}, {"id": 10, "arabic": "مَا", "translit": "", "root": ""}, {"id": 11, "arabic": "لَكُم", "translit": "", "root": ""}, {"id": 12, "arabic": "مِّنِ", "translit": "", "root": ""}, {"id": 13, "arabic": "اِلَٰهٍ", "translit": "", "root": ""}, {"id": 14, "arabic": "غَيْرُهُۥٓۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "أَفَلَا", "translit": "", "root": ""}, {"id": 16, "arabic": "تَتَّقُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 24, "text": "۞فَقَالَ اَ۬لْمَلَؤُاْ اُ۬لذِينَ كَفَرُواْ مِن قَوْمِهِۦ مَا هَٰذَآ إِلَّا بَشَرࣱ مِّثْلُكُمْ يُرِيدُ أَنْ يَّتَفَضَّلَ عَلَيْكُمْ وَلَوْ شَآءَ اَ۬للَّهُ لَأَنزَلَ مَلَٰٓئِكَةࣰ مَّا سَمِعْنَا بِهَٰذَا فِےٓ ءَابَآئِنَا اَ۬لَاوَّلِينَ", "words": [{"id": 1, "arabic": "۞فَقَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْمَلَؤُاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "قَوْمِهِۦ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَا", "translit": "", "root": ""}, {"id": 8, "arabic": "هَٰذَآ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "بَشَرࣱ", "translit": "", "root": ""}, {"id": 11, "arabic": "مِّثْلُكُمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "يُرِيدُ", "translit": "", "root": ""}, {"id": 13, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 14, "arabic": "يَّتَفَضَّلَ", "translit": "", "root": ""}, {"id": 15, "arabic": "عَلَيْكُمْ", "translit": "", "root": ""}, {"id": 16, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 17, "arabic": "شَآءَ", "translit": "", "root": ""}, {"id": 18, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 19, "arabic": "لَأَنزَلَ", "translit": "", "root": ""}, {"id": 20, "arabic": "مَلَٰٓئِكَةࣰ", "translit": "", "root": ""}, {"id": 21, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 22, "arabic": "سَمِعْنَا", "translit": "", "root": ""}, {"id": 23, "arabic": "بِهَٰذَا", "translit": "", "root": ""}, {"id": 24, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 25, "arabic": "ءَابَآئِنَا", "translit": "", "root": ""}, {"id": 26, "arabic": "اَ۬لَاوَّلِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 25, "text": "إِنْ هُوَ إِلَّا رَجُلُۢ بِهِۦ جِنَّةࣱ فَتَرَبَّصُواْ بِهِۦ حَتَّيٰ حِينࣲۖ", "words": [{"id": 1, "arabic": "إِنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "رَجُلُۢ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "جِنَّةࣱ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَتَرَبَّصُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 9, "arabic": "حَتَّيٰ", "translit": "", "root": ""}, {"id": 10, "arabic": "حِينࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 26, "text": "قَالَ رَبِّ اِ۟نصُرْنِے بِمَا كَذَّبُونِۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۟نصُرْنِے", "translit": "", "root": ""}, {"id": 4, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "كَذَّبُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 27, "text": "فَأَوْحَيْنَآ إِلَيْهِ أَنِ اِ۪صْنَعِ اِ۬لْفُلْكَ بِأَعْيُنِنَا وَوَحْيِنَاۖ فَإِذَا جَآءَ امْرُنَا وَفَارَ اَ۬لتَّنُّورُ فَاسْلُكْ فِيهَا مِن كُلِّ زَوْجَيْنِ اِ۪ثْنَيْنِ وَأَهْلَكَ إِلَّا مَن سَبَقَ عَلَيْهِ اِ۬لْقَوْلُ مِنْهُمْۖ وَلَا تُخَٰطِبْنِے فِے اِ۬لذِينَ ظَلَمُوٓاْ إِنَّهُم مُّغْرَقُونَۖ", "words": [{"id": 1, "arabic": "فَأَوْحَيْنَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَيْهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۪صْنَعِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْفُلْكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِأَعْيُنِنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "وَوَحْيِنَاۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 9, "arabic": "جَآءَ", "translit": "", "root": ""}, {"id": 10, "arabic": "امْرُنَا", "translit": "", "root": ""}, {"id": 11, "arabic": "وَفَارَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬لتَّنُّورُ", "translit": "", "root": ""}, {"id": 13, "arabic": "فَاسْلُكْ", "translit": "", "root": ""}, {"id": 14, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 15, "arabic": "مِن", "translit": "", "root": ""}, {"id": 16, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 17, "arabic": "زَوْجَيْنِ", "translit": "", "root": ""}, {"id": 18, "arabic": "اِ۪ثْنَيْنِ", "translit": "", "root": ""}, {"id": 19, "arabic": "وَأَهْلَكَ", "tran