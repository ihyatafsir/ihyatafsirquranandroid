": 5, "arabic": "لَكَٰذِبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 91, "text": "مَا اَ۪تَّخَذَ اَ۬للَّهُ مِنْ وَّلَدࣲۖ وَمَا كَانَ مَعَهُۥ مِنِ اِلَٰهٍۖ اِذاࣰ لَّذَهَبَ كُلُّ إِلَٰهِۢ بِمَا خَلَقَ وَلَعَلَا بَعْضُهُمْ عَلَيٰ بَعْضࣲۖ سُبْحَٰنَ اَ۬للَّهِ عَمَّا يَصِفُونَۖ", "words": [{"id": 1, "arabic": "مَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۪تَّخَذَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَّلَدࣲۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَعَهُۥ", "translit": "", "root": ""}, {"id": 9, "arabic": "مِنِ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِلَٰهٍۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "اِذاࣰ", "translit": "", "root": ""}, {"id": 12, "arabic": "لَّذَهَبَ", "translit": "", "root": ""}, {"id": 13, "arabic": "كُلُّ", "translit": "", "root": ""}, {"id": 14, "arabic": "إِلَٰهِۢ", "translit": "", "root": ""}, {"id": 15, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 16, "arabic": "خَلَقَ", "translit": "", "root": ""}, {"id": 17, "arabic": "وَلَعَلَا", "translit": "", "root": ""}, {"id": 18, "arabic": "بَعْضُهُمْ", "translit": "", "root": ""}, {"id": 19, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 20, "arabic": "بَعْضࣲۖ", "translit": "", "root": ""}, {"id": 21, "arabic": "سُبْحَٰنَ", "translit": "", "root": ""}, {"id": 22, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 23, "arabic": "عَمَّا", "translit": "", "root": ""}, {"id": 24, "arabic": "يَصِفُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 92, "text": "عَٰلِمُ اُ۬لْغَيْبِ وَالشَّهَٰدَةِۖ فَتَعَٰل۪يٰ عَمَّا يُشْرِكُونَۖ", "words": [{"id": 1, "arabic": "عَٰلِمُ", "translit": "", "root": ""}, {"id": 2, "arabic": "