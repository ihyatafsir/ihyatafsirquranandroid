ic": "اَ۪دْفَعْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِالتِے", "translit": "", "root": ""}, {"id": 3, "arabic": "هِيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَحْسَنُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لسَّيِّئَةَۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَعْلَمُ", "translit": "", "root": ""}, {"id": 8, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 9, "arabic": "يَصِفُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 97, "text": "وَقُل رَّبِّ أَعُوذُ بِكَ مِنْ هَمَزَٰتِ اِ۬لشَّيَٰطِينِ", "words": [{"id": 1, "arabic": "وَقُل", "translit": "", "root": ""}, {"id": 2, "arabic": "رَّبِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَعُوذُ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 6, "arabic": "هَمَزَٰتِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لشَّيَٰطِينِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 98, "text": "وَأَعُوذُ بِكَ رَبِّ أَنْ يَّحْضُرُونِۖ", "words": [{"id": 1, "arabic": "وَأَعُوذُ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَّحْضُرُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 99, "text": "حَتَّيٰٓ إِذَا جَآءَ احَدَهُمُ اُ۬لْمَوْتُ قَالَ رَبِّ اِ۪رْجِعُونِ", "words": [{"id": 1, "arabic": "حَتَّيٰٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "جَآءَ", "translit": "", "root": ""}, {"id": 4, "arabic": "احَدَهُمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْمَوْتُ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 7, "arabic": "رَبِّ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۪رْجِعُونِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 100, "text": "لَعَلِّيَ أَعْمَلُ صَٰلِحاࣰ فِيمَا تَرَكْتُ كَلَّآۖ إِنَّهَا كَلِمَةٌ هُوَ قَآئِلُهَاۖ وَمِنْ وَّرَآئِهِم بَرْزَخٌ اِلَيٰ يَوْمِ يُبْعَثُونَۖ", "words": [{"id": 1, "arabic": "لَعَلِّيَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَعْمَلُ", "translit": "", "root": ""}, {"id": 3, "arabic": "صَٰلِحاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِيمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "تَرَكْتُ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَلَّآۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنَّهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "كَلِمَةٌ", "translit": "", "root": ""}, {"id": 9, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 10, "arabic": "قَآئِلُهَاۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَمِنْ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَّرَآئِهِم", "translit": "", "root": ""}, {"id": 13, "arabic": "بَرْزَخٌ", "translit": "", "root": ""}, {"id": 14, "arabic": "اِلَيٰ", "translit": "", "root": ""}, {"id": 15, "arabic": "يَوْمِ", "translit": "", "root": ""}, {"id": 16, "arabic": "يُبْعَثُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 101, "text": "فَإِذَا نُفِخَ فِے اِ۬لصُّورِ فَلَآ أَنسَابَ بَيْنَهُمْ يَوْمَئِذࣲ وَلَا يَتَسَآءَلُونَۖ", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "نُفِخَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لصُّورِ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَلَآ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَنسَابَ", "translit": "", "root": ""}, {"id": 7, "arabic": "بَيْنَهُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَوْمَئِذࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 10, "arabic": "يَتَسَآءَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 102, "text": "فَمَن ثَقُلَتْ مَوَٰزِينُهُۥ فَأُوْلَٰٓئِكَ هُمُ اُ۬لْمُفْلِحُونَۖ", "words": [{"id": 1, "arabic": "فَمَن", "translit": "", "root": ""}, {"id": 2, "arabic": "ثَقُلَتْ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَوَٰزِينُهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَأُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لْمُفْلِحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 103, "text": "وَمَنْ خَفَّتْ مَوَٰزِينُهُۥ فَأُوْلَٰٓئِكَ اَ۬لذِينَ خَسِرُوٓاْ أَنفُسَهُمْ فِے جَهَنَّمَ خَٰلِدُونَ", "words": [{"id": 1, "arabic": "وَمَنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَفَّتْ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَوَٰزِينُهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَأُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 6, "arabic": "خَسِرُوٓاْ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَنفُسَهُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "جَهَنَّمَ", "translit": "", "root": ""}, {"id": 10, "arabic": "خَٰلِدُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 104, "text": "تَلْفَحُ وُجُوهَهُمُ اُ۬لنَّارُ وَهُمْ فِيهَا كَٰلِحُونَۖ", "words": [{"id": 1, "arabic": "تَلْفَحُ", "translit": "", "root": ""}, {"id": 2, "arabic": "وُجُوهَهُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لنَّارُ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "كَٰلِحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 105, "text": "أَلَمْ تَكُنَ اٰيَٰتِے تُتْل۪يٰ عَلَيْكُمْ فَكُنتُم بِهَا تُكَذِّبُونَۖ", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَكُنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اٰيَٰتِے", "translit": "", "root": ""}, {"id": 4, "arabic": "تُتْل۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيْكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَكُنتُم", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "تُكَذِّبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 106, "text": "قَالُواْ رَبَّنَا غَلَبَتْ عَلَيْنَا شِقْوَتُنَا وَكُنَّا قَوْماࣰ ضَآلِّينَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "غَلَبَتْ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَيْنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "شِقْوَتُنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَكُنَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "قَوْماࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "ضَآلِّينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 107, "text": "رَبَّنَآ أَخْرِجْنَا مِنْهَا فَإِنْ عُدْنَا فَإِنَّا ظَٰلِمُونَۖ", "words": [{"id": 1, "arabic": "رَبَّنَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَخْرِجْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنْهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "فَإِنْ", "translit": "", "root": ""}, {"id": 5, "arabic": "عُدْنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "فَإِنَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "ظَٰلِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 108, "text": "قَالَ اَ۪خْسَـُٔواْ فِيهَا وَلَا تُكَلِّمُونِۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۪خْ