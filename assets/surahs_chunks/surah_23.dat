h"}, {"surah": 23, "ayah": 102, "text": "فَمَن ثَقُلَتْ مَوَٰزِينُهُۥ فَأُوْلَٰٓئِكَ هُمُ اُ۬لْمُفْلِحُونَۖ", "words": [{"id": 1, "arabic": "فَمَن", "translit": "", "root": ""}, {"id": 2, "arabic": "ثَقُلَتْ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَوَٰزِينُهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَأُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لْمُفْلِحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 103, "text": "وَمَنْ خَفَّتْ مَوَٰزِينُهُۥ فَأُوْلَٰٓئِكَ اَ۬لذِينَ خَسِرُوٓاْ أَنفُسَهُمْ فِے جَهَنَّمَ خَٰلِدُونَ", "words": [{"id": 1, "arabic": "وَمَنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَفَّتْ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَوَٰزِينُهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَأُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 6, "arabic": "خَسِرُوٓاْ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَنفُسَهُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "جَهَنَّمَ", "translit": "", "root": ""}, {"id": 10, "arabic": "خَٰلِدُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 104, "text": "تَلْفَحُ وُجُوهَهُمُ اُ۬لنَّارُ وَهُمْ فِيهَا كَٰلِحُونَۖ", "words": [{"id": 1, "arabic": "تَلْفَحُ", "translit": "", "root": ""}, {"id": 2, "arabic": "وُجُوهَهُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لنَّارُ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "كَٰلِحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 105, "text": "أَلَمْ تَكُنَ اٰيَٰتِے تُتْل۪يٰ عَلَيْكُمْ فَكُنتُم بِهَا تُكَذِّبُونَۖ", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "", "r