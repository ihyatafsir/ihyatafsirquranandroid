, "ayah": 111, "text": "إِنِّے جَزَيْتُهُمُ اُ۬لْيَوْمَ بِمَا صَبَرُوٓاْ أَنَّهُمْ هُمُ اُ۬لْفَآئِزُونَۖ", "words": [{"id": 1, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 2, "arabic": "جَزَيْتُهُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْيَوْمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "صَبَرُوٓاْ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَنَّهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لْفَآئِزُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 112, "text": "قَالَ كَمْ لَبِثْتُمْ فِے اِ۬لَارْضِ عَدَدَ سِنِينَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَبِثْتُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَدَدَ", "translit": "", "root": ""}, {"id": 7, "arabic": "سِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 113, "text": "قَالُواْ لَبِثْنَا يَوْماً اَوْ بَعْضَ يَوْمࣲۖ فَسْـَٔلِ اِ۬لْعَآدِّينَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَبِثْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "يَوْماً", "translit": "", "root": ""}, {"id": 4, "arabic": "اَوْ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَعْضَ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَوْمࣲۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَسْـَٔلِ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لْعَآدِّينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 114, "text": "قَالَ إِن لَّبِثْتُمُۥٓ إِلَّا قَلِيلاࣰ لَّوَ اَنَّكُمْ كُنتُمْ تَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِن", "translit": "", "root": ""}, {"id": 3, "arabic": "لَّبِثْتُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "قَلِيلاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَّوَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَنَّكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "تَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 115, "text": "۞أَفَحَسِبْتُمُۥٓ أَنَّمَا خَلَقْنَٰكُمْ عَبَثاࣰ وَأَنَّكُمُۥٓ إِلَيْنَا لَا تُرْجَعُونَۖ", "words": [{"id": 1, "arabic": "۞أَفَحَسِبْتُمُۥٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَنَّمَا", "translit": "", "root": ""}, {"id": 3, "arabic": "خَلَقْنَٰكُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَبَثاࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَأَنَّكُمُۥٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِلَيْنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "", "root": ""}, {"id": 8, "arabic": "تُرْجَعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 116, "text": "فَتَعَٰلَي اَ۬للَّهُ اُ۬لْمَلِكُ اُ۬لْحَقُّۖ لَآ إِلَٰهَ إِلَّا هُوَۖ رَبُّ اُ۬لْعَرْشِ اِ۬لْكَرِيمِۖ", "words": [{"id": 1, "arabic": "فَتَعَٰلَي", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْمَلِكُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْحَقُّۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَآ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِلَٰهَ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "هُوَۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "رَبُّ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لْعَرْشِ", "translit": "", "root": ""}, {"id": 11, "arabic": "اِ۬لْكَرِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 117, "text": "وَمَنْ يَّدْعُ مَعَ اَ۬للَّهِ إِلَٰهاً اٰخَرَ لَا بُرْهَٰنَ لَهُۥ بِهِۦ فَإِنَّمَا حِسَابُهُۥ عِندَ رَبِّهِۦٓۖ إِنَّهُۥ لَا يُفْلِحُ اُ۬لْكَٰفِرُونَۖ", "words": [{"id": 1, "arabic": "وَمَنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَّدْعُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَعَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَٰهاً", "translit": "", "root": ""}, {"id": 6, "arabic": "اٰخَرَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "", "root": ""}, {"id": 8, "arabic": "بُرْهَٰنَ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 10, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 11, "arabic": "فَإِنَّمَا", "translit": "", "root": ""}, {"id": 12, "arabic": "حِسَابُهُۥ", "translit": "", "root": ""}, {"id": 13, "arabic": "عِندَ", "translit": "", "root": ""}, {"id": 14, "arabic": "رَبِّهِۦٓۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 16, "arabic": "لَا", "translit": "", "root": ""}, {"id": 17, "arabic": "يُفْلِحُ", "translit": "", "root": ""}, {"id": 18, "arabic": "اُ۬لْكَٰفِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 118, "text": "وَقُل رَّبِّ اِ۪غْفِرْ وَارْحَمْ وَأَنتَ خَيْرُ اُ۬لرَّٰحِمِينَۖ", "words": [{"id": 1, "arabic": "وَقُل", "translit": "", "root": ""}, {"id": 2, "arabic": "رَّبِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۪غْفِرْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَارْحَمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَأَنتَ", "translit": "", "root": ""}, {"id": 6, "arabic": "خَيْرُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لرَّٰحِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}]}