": ""}, {"id": 11, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 12, "arabic": "مَنَٰفِعُ", "translit": "", "root": ""}, {"id": 13, "arabic": "كَثِيرَةࣱ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَمِنْهَا", "translit": "", "root": ""}, {"id": 15, "arabic": "تَاكُلُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 22, "text": "وَعَلَيْهَا وَعَلَي اَ۬لْفُلْكِ تُحْمَلُونَۖ", "words": [{"id": 1, "arabic": "وَعَلَيْهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "وَعَلَي", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْفُلْكِ", "translit": "", "root": ""}, {"id": 4, "arabic": "تُحْمَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 23, "text": "وَلَقَدَ اَرْسَلْنَا نُوحاً اِلَيٰ قَوْمِهِۦ فَقَالَ يَٰقَوْمِ اِ۟عْبُدُواْ اُ۬للَّهَ مَا لَكُم مِّنِ اِلَٰهٍ غَيْرُهُۥٓۖ أَفَلَا تَتَّقُونَۖ", "words": [{"id": 1, "arabic": "وَلَقَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَرْسَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "نُوحاً", "translit": "", "root": ""}, {"id": 4, "arabic": "اِلَيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَوْمِهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَقَالَ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَٰقَوْمِ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۟عْبُدُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬للَّهَ", "translit": "", "root": ""}, {"id": 10, "arabic": "مَا", "translit": "", "root": ""}, {"id": 11, "arabic": "لَكُم", "translit": "", "root": ""}, {"id": 12, "arabic": "مِّنِ", "translit": "", "root": ""}, {"id": 13, "arabic": "اِلَٰهٍ", "translit": "", "root": ""}, {"id": 14, "arabic": "غَيْرُهُۥٓۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "أَفَلَا", "translit": "", "root": ""}, {"id": 16, "arabic": "تَتَّقُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 24, "text": "۞فَقَالَ اَ۬لْمَلَؤُاْ اُ۬لذِينَ كَفَرُواْ مِن قَوْمِه