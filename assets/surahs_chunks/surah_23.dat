ayah": 104, "text": "تَلْفَحُ وُجُوهَهُمُ اُ۬لنَّارُ وَهُمْ فِيهَا كَٰلِحُونَۖ", "words": [{"id": 1, "arabic": "تَلْفَحُ", "translit": "", "root": ""}, {"id": 2, "arabic": "وُجُوهَهُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لنَّارُ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "كَٰلِحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 105, "text": "أَلَمْ تَكُنَ اٰيَٰتِے تُتْل۪يٰ عَلَيْكُمْ فَكُنتُم بِهَا تُكَذِّبُونَۖ", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَكُنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اٰيَٰتِے", "translit": "", "root": ""}, {"id": 4, "arabic": "تُتْل۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيْكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَكُنتُم", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "تُكَذِّبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 106, "text": "قَالُواْ رَبَّنَا غَلَبَتْ عَلَيْنَا شِقْوَتُنَا وَكُنَّا قَوْماࣰ ضَآلِّينَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "غَلَبَتْ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَيْنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "شِقْوَتُنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَكُنَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "قَوْماࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "ضَآلِّينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 107, "text": "رَبَّنَآ أَخْرِجْنَا مِنْهَا فَإِنْ عُدْنَا فَإِنَّا ظَٰلِمُونَۖ", "words": [{"id": 1, "arabic": "رَبَّنَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَخْرِجْنَا", "translit": "", "root"