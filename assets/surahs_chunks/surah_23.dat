َٰعِلُونَۖ", "words": [{"id": 1, "arabic": "وَالذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِلزَّكَوٰةِ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَٰعِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 5, "text": "وَالذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ", "words": [{"id": 1, "arabic": "وَالذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِفُرُوجِهِمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "حَٰفِظُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 6, "text": "إِلَّا عَلَيٰٓ أَزْوَٰجِهِمُۥٓ أَوْ مَا مَلَكَتَ اَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَۖ", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَزْوَٰجِهِمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَوْ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "", "root": ""}, {"id": 6, "arabic": "مَلَكَتَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَيْمَٰنُهُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَإِنَّهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "غَيْرُ", "translit": "", "root": ""}, {"id": 10, "arabic": "مَلُومِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 7, "text": "فَمَنِ اِ۪بْتَغ۪يٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ اُ۬لْعَادُونَۖ", "words": [{"id": 1, "arabic": "فَمَنِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۪بْتَغ۪يٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَرَآءَ", "translit": "", "root": ""}, {"id": 4, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَأُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْعَادُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 8, "text": "وَالذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَۖ", "words": [{"id": 1, "arabic": "وَالذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِأَمَٰنَٰتِهِمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَعَهْدِهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "رَٰعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 9, "text": "وَالذِينَ هُمْ عَلَيٰ صَلَوَٰتِهِمْ يُحَافِظُونَ", "words": [{"id": 1, "arabic": "وَالذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "صَلَوَٰتِهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يُحَافِظُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 10, "text": "أُوْلَٰٓئِكَ هُمُ اُ۬لْوَٰرِثُونَ", "words": [{"id": 1, "arabic": "أُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْوَٰرِثُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 11, "text": "اَ۬لذِينَ يَرِثُونَ اَ۬لْفِرْدَوْسَۖ هُمْ فِيهَا خَٰلِدُونَۖ", "words": [{"id": 1, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَرِثُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْفِرْدَوْسَۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "خَٰلِدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 23, "ayah": 12, "text": "وَلَقَدْ خَلَقْنَا اَ۬لِانسَٰنَ مِن سُلَٰلَةࣲ مِّن طِينࣲۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لِانسَٰنَ", "translit": "", "root": ""}, {"id": 4, "ar