 "text": "عَيْناࣰ يَشْرَبُ بِهَا اَ۬لْمُقَرَّبُونَۖ", "words": [{"id": 1, "arabic": "عَيْناࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَشْرَبُ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمُقَرَّبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 29, "text": "إِنَّ اَ۬لذِينَ أَجْرَمُواْ كَانُواْ مِنَ اَ۬لذِينَ ءَامَنُواْ يَضْحَكُونَ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَجْرَمُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 7, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَضْحَكُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 30, "text": "وَإِذَا مَرُّواْ بِهِمْ يَتَغَامَزُونَ", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَرُّواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهِمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَتَغَامَزُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 31, "text": "وَإِذَا اَ۪نقَلَبُوٓاْ إِلَيٰٓ أَهْلِهِمُ اُ۪نقَلَبُواْ فَٰكِهِينَ", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۪نقَلَبُوٓاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيٰٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَهْلِهِمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۪نقَلَبُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَٰكِهِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 32, "text": "وَإِذَا رَأَوْهُمْ قَالُوٓاْ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ", "words": [{"id": 1, "arabic": "وَإِذ