arabic": "يَسْتَوْفُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 3, "text": "وَإِذَا كَالُوهُمُۥٓ أَو وَّزَنُوهُمْ يُخْسِرُونَۖ", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "كَالُوهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَو", "translit": "", "root": ""}, {"id": 4, "arabic": "وَّزَنُوهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يُخْسِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 4, "text": "أَلَا يَظُنُّ أُوْلَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ", "words": [{"id": 1, "arabic": "أَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَظُنُّ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنَّهُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مَّبْعُوثُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 5, "text": "لِيَوْمٍ عَظِيمࣲ‏", "words": [{"id": 1, "arabic": "لِيَوْمٍ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَظِيمࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 6, "text": "يَوْمَ يَقُومُ اُ۬لنَّاسُ لِرَبِّ اِ۬لْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَقُومُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لنَّاسُ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِرَبِّ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْعَٰلَمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 7, "text": "كَلَّآ إِنَّ كِتَٰبَ اَ۬لْفُجّ۪ارِ لَفِے سِجِّينࣲۖ", "words": [{"id": 1, "arabic": "كَلَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "كِتَٰبَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْفُجّ۪ارِ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَفِے", "translit": "", "root": ""}, {"id": 6, "arabic": "سِجِّينࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 8, "text": "وَمَآ أَدْر۪يٰكَ مَا سِجِّينࣱ‏", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَدْر۪يٰكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "سِجِّينࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 9, "text": "كِتَٰبࣱ مَّرْقُومࣱۖ", "words": [{"id": 1, "arabic": "كِتَٰبࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَّرْقُومࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 10, "text": "وَيْلࣱ يَوْمَئِذࣲ لِّلْمُكَذِّبِينَ", "words": [{"id": 1, "arabic": "وَيْلࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَوْمَئِذࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِّلْمُكَذِّبِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 11, "text": "اَ۬لذِينَ يُكَذِّبُونَ بِيَوْمِ اِ۬لدِّينِۖ", "words": [{"id": 1, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يُكَذِّبُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِيَوْمِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لدِّينِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 12, "text": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ اَثِيمٍ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يُكَذِّبُ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهِۦٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "كُلُّ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُعْتَدٍ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَثِيمٍ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 13, "text": "اِذَا تُتْل۪يٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ اُ۬لَاوَّلِينَۖ", "words": [{"id": 1, "arabic": "اِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تُتْل۪يٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "ءَايَٰتُنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَسَٰطِيرُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لَاوَّلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 14, "text": "۞كَلَّا بَل رَّانَ عَلَيٰ قُلُوبِهِم مَّا كَانُواْ يَكْسِبُونَۖ", "words": [{"id": 1, "arabic": "۞كَلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "بَل", "translit": "", "root": ""}, {"id": 3, "arabic": "رَّانَ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "قُلُوبِهِم", "translit": "", "root": ""}, {"id": 6, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَكْسِبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 15, "text": "كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذࣲ لَّمَحْجُوبُونَۖ", "words": [{"id": 1, "arabic": "كَلَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَن", "translit": "", "root": ""}, {"id": 4, "arabic": "رَّبِّهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَوْمَئِذࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَّمَحْجُوبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 16, "text": "ثُمَّ إِنَّهُمْ لَصَالُواْ اُ۬لْجَحِيمِۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَصَالُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْجَحِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 17, "text": "ثُمَّ يُقَالُ هَٰذَا اَ۬لذِے كُنتُم بِهِۦ تُكَذِّبُ