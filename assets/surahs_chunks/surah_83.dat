{"surah": 83, "verses": [{"ayah": 1, "text": "وَيْلٌ لِّلْمُطَفِّفِينَ ", "translation": "Woe to those who give less [than due],[1]", "words": [{"id": 1, "arabic": "وَيْلٌ", "translit": "ٌlْyَw", "root": ""}, {"id": 2, "arabic": "لِّلْمُطَفِّفِينَ", "translit": "َnyِfِّfَṭُmْlِّl", "root": "طفف"}], "hasIhya": true}, {"ayah": 2, "text": "ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ ", "translation": "Who, when they take a measure from people, take in full.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "ٱكْتَالُوا۟", "translit": "۟āwُlāَtْkٱ", "root": "كيل"}, {"id": 4, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 6, "arabic": "يَسْتَوْفُونَ", "translit": "َnwُfْwَtْsَy", "root": "وفي"}], "hasIhya": false}, {"ayah": 3, "text": "وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ ", "translation": "But if they give by measure or by weight to them, they cause loss.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "كَالُوهُمْ", "translit": "ْmُhwُlāَk", "root": "كيل"}, {"id": 3, "arabic": "أَو", "translit": "wَaʾ", "root": ""}, {"id": 4, "arabic": "وَّزَنُوهُمْ", "translit": "ْmُhwُnَzَّw", "root": "وزن"}, {"id": 5, "arabic": "يُخْسِرُونَ", "translit": "َnwُrِsْhkُy", "root": "خسر"}], "hasIhya": false}, {"ayah": 4, "text": "أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ ", "translation": "Do they not think that they will be resurrected", "words": [{"id": 1, "arabic": "أَلَا", "translit": "āَlَaʾ", "root": ""}, {"id": 2, "arabic": "يَظُنُّ", "translit": "ُّnُẓَy", "root": "ظنن"}, {"id": 3, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 4, "arabic": "أَنَّهُم", "translit": "mُhَّnَaʾ", "root": ""}, {"id": 5, "arabic": "مَّبْعُوثُونَ", "translit": "َnwُhtwُʿعْbَّm", "root": "بعث"}], "hasIhya": false}, {"ayah": 5, "text": "لِيَوْمٍ عَظِيمٍ ", "translation": "For a tremendous Day -", "words": [{"id": 1, "arabic": "لِيَوْمٍ", "translit": "ٍmْwَyِl", "root": "يوم"}, {"id": 2, "arabic": "عَظِيمٍ", "translit": "ٍmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 6, "text": "يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ ", "translation": "The Day when mankind will stand before the Lord of the worlds?", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "يَقُومُ", "translit": "ُmwُqَy", "root": "قوم"}, {"id": 3, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 4, "arabic": "لِرَبِّ", "translit": "ِّbَrِl", "root": "ربب"}, {"id": 5, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": true}, {"ayah": 7, "text": "كَلَّآ إِنَّ كِتَٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍ ", "translation": "No! Indeed, the record of the wicked is in sijjeen.", "words": [{"id": 1, "arabic": "كَلَّآ", "translit": "ٓāَّlَk", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 3, "arabic": "كِتَٰبَ", "translit": "َbَٰtِk", "root": "كتب"}, {"id": 4, "arabic": "ٱلْفُجَّارِ", "translit": "ِrāَّjgُfْlٱ", "root": "فجر"}, {"id": 5, "arabic": "لَفِى", "translit": "àِfَl", "root": ""}, {"id": 6, "arabic": "سِجِّينٍ", "translit": "ٍnyِّjgِs", "root": "سجن"}], "hasIhya": false}, {"ayah": 8, "text": "وَمَآ أَدْرَىٰكَ مَا سِجِّينٌ ", "translation": "And what can make you know what is sijjeen?", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَدْرَىٰكَ", "translit": "َkٰàَrْdَaʾ", "root": "دري"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "سِجِّينٌ", "translit": "ٌnyِّjgِs", "root": "سجن"}], "hasIhya": false}, {"ayah": 9, "text": "كِتَٰبٌ مَّرْقُومٌ ", "translation": "It is [their destination[1] recorded in] a register inscribed.", "words": [{"id": 1, "arabic": "كِتَٰبٌ", "translit": "ٌbَٰtِk", "root": "كتب"}, {"id": 2, "arabic": "مَّرْقُومٌ", "translit": "ٌmwُqْrَّm", "root": "رقم"}], "hasIhya": false}, {"ayah": 10, "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ ", "translation": "Woe, that Day, to the deniers,", "words": [{"id": 1, "arabic": "وَيْلٌ", "translit": "ٌlْyَw", "root": ""}, {"id": 2, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 3, "arabic": "لِّلْمُكَذِّبِينَ", "translit": "َnyِbِّhdَkُmْlِّl", "root": "كذب"}], "hasIhya": false}, {"ayah": 11, "text": "ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ ", "translation": "Who deny the Day of Recompense.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يُكَذِّبُونَ", "translit": "َnwُbِّhdَkُy", "root": "كذب"}, {"id": 3, "arabic": "بِيَوْمِ", "translit": "ِmْwَyِb", "root": "يوم"}, {"id": 4, "arabic": "ٱلدِّينِ", "translit": "ِnyِّdlٱ", "root": "دين"}], "hasIhya": false}, {"ayah": 12, "text": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ ", "translation": "And none deny it except every sinful transgressor.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "يُكَذِّبُ", "translit": "ُbِّhdَkُy", "root": "كذب"}, {"id": 3, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 6, "arabic": "مُعْتَدٍ", "translit": "ٍdَtْʿعُm", "root": "عدو"}, {"id": 7, "arabic": "أَثِيمٍ", "translit": "ٍmyِhtَaʾ", "root": "اثم"}], "hasIhya": false}, {"ayah": 13, "text": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ ", "translation": "When Our verses are recited to him, he says, \"Legends of the former peoples.\"", "words": [{"id": 1, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 2, "arabic": "تُتْلَىٰ", "translit": "ٰàَlْtُt", "root": "تلو"}, {"id": 3, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "ءَايَٰتُنَا", "translit": "āَnُtَٰyāَء", "root": "ايي"}, {"id": 5, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 6, "arabic": "أَسَٰطِيرُ", "translit": "ُryِṭَٰsَaʾ", "root": "سطر"}, {"id": 7, "arabic": "ٱلْأَوَّلِينَ", "translit": "َnyِlَّwَaʾْlٱ", "root": "اول"}], "hasIhya": false}, {"ayah": 14, "text": "كَلَّاۖ بَلْۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ ", "translation": "No! Rather, the stain has covered their hearts of that which they were earning.[1]", "words": [{"id": 1, "arabic": "كَلَّا", "translit": "āَّlَk", "root": ""}, {"id": 2, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 3, "arabic": "رَانَ", "translit": "َnāَr", "root": "رين"}, {"id": 4, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 5, "arabic": "قُلُوبِهِم", "translit": "mِhِbwُlُq", "root": "قلب"}, {"id": 6, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 7, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 8, "arabic": "يَكْسِبُونَ", "translit": "َnwُbِsْkَy", "root": "كسب"}], "hasIhya": true}, {"ayah": 15, "text": "كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍ لَّمَحْجُوبُونَ ", "translation": "No! Indeed, from their Lord, that Day, they will be partitioned.[1]", "words": [{"id": 1, "arabic": "كَلَّآ", "translit": "ٓāَّlَk", "root": ""}, {"id": 2, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 3, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 4, "arabic": "رَّبِّهِمْ", "translit": "ْmِhِّbَّr", "root": "ربب"}, {"id": 5, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 6, "arabic": "لَّمَحْجُوبُونَ", "translit": "َnwُbwُjgْḥَmَّl", "root": "حجب"}], "hasIhya": true}, {"ayah": 16, "text": "ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ ", "translation": "Then indeed, they will [enter and] burn in Hellfire.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 3, "arabic": "لَصَالُوا۟", "translit": "۟āwُlāَṣَl", "root": "صلي"}, {"id": 4, "arabic": "ٱلْجَحِيمِ", "translit": "ِmyِḥَjgْlٱ", "root": "جحم"}], "hasIhya": false}, {"ayah": 17, "text": "ثُمَّ يُقَالُ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ ", "translation": "Then it will be said [to them], \"This is what you used to deny.\"", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "يُقَالُ", "translit": "ُlāَqُy", "root": "قول"}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 6, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 7, "arabic": "تُكَذِّبُونَ", "translit": "َnwُbِّhdَkُt", "root": "كذب"}], "hasIhya": false}, {"ayah": 18, "text": "كَلَّآ إِنَّ كِتَٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ ", "translation": "No! Indeed, the record of the righteous is in ʿilliyyūn.", "words": [{"id": 1, "arabic": "كَلَّآ", "translit": "ٓāَّlَk", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 3, "arabic": "كِتَٰبَ", "translit": "َbَٰtِk", "root": "كتب"}, {"id": 4, "arabic": "ٱلْأَبْرَارِ", "translit": "ِrāَrْbَaʾْlٱ", "root": "برر"}, {"id": 5, "arabic": "لَفِى", "translit": "àِfَl", "root": ""}, {"id": 6, "arabic": "عِلِّيِّينَ", "translit": "َnyِّyِّlِʿع", "root": "علو"}], "hasIhya": true}, {"ayah": 19, "text": "وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ ", "translation": "And what can make you know what is ʿilliyyūn?", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَدْرَىٰكَ", "translit": "َkٰàَrْdَaʾ", "root": "دري"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "عِلِّيُّونَ", "translit": "َnwُّyِّlِʿع", "root": "علو"}], "hasIhya": true}, {"ayah": 20, "text": "كِتَٰبٌ مَّرْقُومٌ ", "translation": "It is [their destination[1] recorded in] a register inscribed", "words": [{"id": 1, "arabic": "كِتَٰبٌ", "translit": "ٌbَٰtِk", "root": "كتب"}, {"id": 2, "arabic": "مَّرْقُومٌ", "translit": "ٌmwُqْrَّm", "root": "رقم"}], "hasIhya": false}, {"ayah": 21, "text": "يَشْهَدُهُ ٱلْمُقَرَّبُونَ ", "translation": "Which is witnessed by those brought near [to Allāh].", "words": [{"id": 1, "arabic": "يَشْهَدُهُ", "translit": "ُhُdَhْhsَy", "root": "شهد"}, {"id": 2, "arabic": "ٱلْمُقَرَّبُونَ", "translit": "َnwُbَّrَqُmْlٱ", "root": "قرب"}], "hasIhya": false}, {"ayah": 22, "text": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ ", "translation": "Indeed, the righteous will be in pleasure", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلْأَبْرَارَ", "translit": "َrāَrْbَaʾْlٱ", "root": "برر"}, {"id": 3, "arabic": "لَفِى", "translit": "àِfَl", "root": ""}, {"id": 4, "arabic": "نَعِيمٍ", "translit": "ٍmyِʿعَn", "root": "نعم"}], "hasIhya": true}, {"ayah": 23, "text": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ ", "translation": "On adorned couches, observing.", "words": [{"id": 1, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 2, "arabic": "ٱلْأَرَآئِكِ", "translit": "ِkِyʾٓāَrَaʾْlٱ", "root": "ارك"}, {"id": 3, "arabic": "يَنظُرُونَ", "translit": "َnwُrُẓnَy", "root": "نظر"}], "hasIhya": false}, {"ayah": 24, "text": "تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ ", "translation": "You will recognize in their faces the radiance of pleasure.", "words": [{"id": 1, "arabic": "تَعْرِفُ", "translit": "ُfِrْʿعَt", "root": "عرف"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "وُجُوهِهِمْ", "translit": "ْmِhِhwُjgُw", "root": "وجه"}, {"id": 4, "arabic": "نَضْرَةَ", "translit": "َẗَrْḍَn", "root": "نضر"}, {"id": 5, "arabic": "ٱلنَّعِيمِ", "translit": "ِmyِʿعَّnlٱ", "root": "نعم"}], "hasIhya": true}, {"ayah": 25, "text": "يُسْقَوْنَ مِن رَّحِيقٍ مَّخْتُومٍ ", "translation": "They will be given to drink [pure] wine[1] [which was] sealed.", "words": [{"id": 1, "arabic": "يُسْقَوْنَ", "translit": "َnْwَqْsُy", "root": "سقي"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "رَّحِيقٍ", "translit": "ٍqyِḥَّr", "root": "رحق"}, {"id": 4, "arabic": "مَّخْتُومٍ", "translit": "ٍmwُtْhkَّm", "root": "ختم"}], "hasIhya": true}, {"ayah": 26, "text": "خِتَٰمُهُۥ مِسْكٌۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَٰفِسُونَ ", "translation": "The last of it[1] is musk. So for this let the competitors compete.", "words": [{"id": 1, "arabic": "خِتَٰمُهُۥ", "translit": "ۥُhُmَٰtِhk", "root": "ختم"}, {"id": 2, "arabic": "مِسْكٌ", "translit": "ٌkْsِm", "root": "مسك"}, {"id": 3, "arabic": "وَفِى", "translit": "àِfَw", "root": ""}, {"id": 4, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 5, "arabic": "فَلْيَتَنَافَسِ", "translit": "ِsَfāَnَtَyْlَf", "root": "نفس"}, {"id": 6, "arabic": "ٱلْمُتَنَٰفِسُونَ", "translit": "َnwُsِfَٰnَtُmْlٱ", "root": "نفس"}], "hasIhya": true}, {"ayah": 27, "text": "وَمِزَاجُهُۥ مِن تَسْنِيمٍ ", "translation": "And its mixture is of Tasneem,[1]", "words": [{"id": 1, "arabic": "وَمِزَاجُهُۥ", "translit": "ۥُhُjgāَzِmَw", "root": "مزج"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "تَسْنِيمٍ", "translit": "ٍmyِnْsَt", "root": "سنم"}], "hasIhya": false}, {"ayah": 28, "text": "عَيْنًا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ ", "translation": "A spring from which those near [to Allāh] drink.", "words": [{"id": 1, "arabic": "عَيْنًا", "translit": "āًnْyَʿع", "root": "عين"}, {"id": 2, "arabic": "يَشْرَبُ", "translit": "ُbَrْhsَy", "root": "شرب"}, {"id": 3, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 4, "arabic": "ٱلْمُقَرَّبُونَ", "translit": "َnwُbَّrَqُmْlٱ", "root": "قرب"}], "hasIhya": false}, {"ayah": 29, "text": "إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ ", "translation": "Indeed, those who committed crimes used to laugh at those who believed.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "أَجْرَمُوا۟", "translit": "۟āwُmَrْjgَaʾ", "root": "جرم"}, {"id": 4, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 5, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 8, "arabic": "يَضْحَكُونَ", "translit": "َnwُkَḥْḍَy", "root": "ضحك"}], "hasIhya": true}, {"ayah": 30, "text": "وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ ", "translation": "And when they passed by them, they would exchange derisive glances.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "مَرُّوا۟", "translit": "۟āwُّrَm", "root": "مرر"}, {"id": 3, "arabic": "بِهِمْ", "translit": "ْmِhِb", "root": ""}, {"id": 4, "arabic": "يَتَغَامَزُونَ", "translit": "َnwُzَmāَغَtَy", "root": "غمز"}], "hasIhya": false}, {"ayah": 31, "text": "وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ ", "translation": "And when they returned to their people, they would return jesting.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "ٱنقَلَبُوٓا۟", "translit": "۟āٓwُbَlَqnٱ", "root": "قلب"}, {"id": 3, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 4, "arabic": "أَهْلِهِمُ", "translit": "ُmِhِlْhَaʾ", "root": "اهل"}, {"id": 5, "arabic": "ٱنقَلَبُوا۟", "translit": "۟āwُbَlَqnٱ", "root": "قلب"}, {"id": 6, "arabic": "فَكِهِينَ", "translit": "َnyِhِkَf", "root": "فكه"}], "hasIhya": false}, {"ayah": 32, "text": "وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ ", "translation": "And when they saw them, they would say, \"Indeed, those are truly lost.\"", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "رَأَوْهُمْ", "translit": "ْmُhْwَaʾَr", "root": "راي"}, {"id": 3, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 4, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 5, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 6, "arabic": "لَضَآلُّونَ", "translit": "َnwُّlٓāَḍَl", "root": "ضلل"}], "hasIhya": true}, {"ayah": 33, "text": "وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَٰفِظِينَ ", "translation": "But they had not been sent as guardians over them.", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أُرْسِلُوا۟", "translit": "۟āwُlِsْrُaʾ", "root": "رسل"}, {"id": 3, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "حَٰفِظِينَ", "translit": "َnyِẓِfَٰḥ", "root": "حفظ"}], "hasIhya": false}, {"ayah": 34, "text": "فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ ", "translation": "So Today[1] those who believed are laughing at the disbelievers,", "words": [{"id": 1, "arabic": "فَٱلْيَوْمَ", "translit": "َmْwَyْlٱَf", "root": "يوم"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱلْكُفَّارِ", "translit": "ِrāَّfُkْlٱ", "root": "كفر"}, {"id": 6, "arabic": "يَضْحَكُونَ", "translit": "َnwُkَḥْḍَy", "root": "ضحك"}], "hasIhya": true}, {"ayah": 35, "text": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ ", "translation": "On adorned couches, observing.", "words": [{"id": 1, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 2, "arabic": "ٱلْأَرَآئِكِ", "translit": "ِkِyʾٓāَrَaʾْlٱ", "root": "ارك"}, {"id": 3, "arabic": "يَنظُرُونَ", "translit": "َnwُrُẓnَy", "root": "نظر"}], "hasIhya": false}, {"ayah": 36, "text": "هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ ", "translation": "Have the disbelievers [not] been rewarded [this Day] for what they used to do?", "words": [{"id": 1, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 2, "arabic": "ثُوِّبَ", "translit": "َbِّwُht", "root": "ثوب"}, {"id": 3, "arabic": "ٱلْكُفَّارُ", "translit": "ُrāَّfُkْlٱ", "root": "كفر"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 6, "arabic": "يَفْعَلُونَ", "translit": "َnwُlَʿعْfَy", "root": "فعل"}], "hasIhya": false}], "tafsir": {"1": [{"arabic": "الكيل فينبغي أن يكيل كما يكتال قال الله تعالى ويل للمطففين الذين إذا اكتالوا على الناس يستوفون وإذا كالوهم أو وزنوهم يخسرون ولا يخلص من هذا إلا بأن يرجع إذا أعطى وينقص إذا أخذ إذ العدل الحقيقي قلما يتصور فليستظهر بظهور الزيادة والنقصان فإن من استقصى حقه بكماله يوشك أن يتعداه وكان بعضهم يقول لا أشتري الويل من الله بحبة فكان إذا أخذ نقص نصف حبة وإذا أعطى زاد حبة وكان يقول ويل لمن باع بحبة جنة عرضها السموات والأرض وما أخسر من باع طوبى بويل وإنما بالغوا في الاحتراز من هذا وشبهه لأنها مظالم لا يمكن التوبة منها إذ لا يعرف أصحاب الحبات حتى يجمعهم ويؤدى حقوقهم ولذلك لما اشت", "english": "One of the scholars said: \"Whoever sells his brother a commodity for a dirham, while it would not be suitable for him, had he purchased it for himself, except for five dānaqs (six-tenths of a dirham) — then he has abandoned the sincere counsel (al-nuṣḥ) commanded in transactions, and has not loved for his brother what he loves for himself.\"", "book_title": "Etiquette of Earning", "section_title_ar": "Section 325", "section_title_en": "Section 325", "section_index": 325, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Earning'", "badge": "Insight"}], "6": [{"arabic": "وسمع علي بن الفضيل قارئا يقرأ {يوم يقوم الناس لرب العالمين} فسقط مغشيا عليه فقال الفضيل شكر الله لك ما قد علمه منك وكذلك نقل عن جماعة منهم وكذلك الصوفية فقد كان الشبلي في مسجده ليلة من رمضان وهو يصلي خلف إمام له فقرأ الإمام {ولئن شئنا لنذهبن بالذي أوحينا إليك} فزعق الشبلي زعقة ظن الناس أنه قد طارت روحه وأحمر وجهه وارتعدت فرائصه وكان يقول بمثل هذا يخاطب الأحباب يردد ذلك مرارا وقال الجنيد دخلت على سرى السقطي فرأيت بين يديه رجلا قد غشي عليه فقال لي هذا رجل قد سمع آية من القرآن فغشي عليه فقلت اقرءوا عليه تل", "english": "**QUAD_ANCHORS:**\n- Root: وجد (Wajd)\n  * Lisan / Ayn: The root وجد encompasses multiple senses: finding/attaining (إدراك), intense love (الحب الشديد), grief (الحزن), and wealth/sufficiency (الغنى). Al-Khalil notes the range: \"الوجد: الحب. والوجد: الحزن. والوجد: الغنى. والوجد: إدراك الشيء\"\n  * Al-Raghib (Mufradat): \"الوجد: إدراك الشيء على خلاف ما يطلب\" — and in the technical terminology of the Sufis: \"ما يصادف القلب من واردات الأحوال\" (what the heart encounters of the influxes of spiritual states)\n  * Al-Zamakhshari (Asas): Literal sense is finding/attaining; metaphorical extension (majāz) in devotional context: \"وجد فلان في العبادة وجدا: إذا أتى بها على وجهها مع حضور القلب\"\n- Root: طبع (Tabʿ)\n  * Lisan / Ayn: \"الطبع: السجية التي جبل عليها الإنسان\" — the innate disposition upon which one is created; also \"الختم\" (sealing)\n  * Al-Raghib (Mufradat): \"الطبع: السجية التي جبل عليها الإنسان\" — the original constitution\n  * Al-Zamakhshari (Asas): Distinguishes \"مطبوع\" (innate/natural) from \"متكلف\" (deliberately acquired) — \"فلان مطبوع على الكرم، ومتكلف له\"\n- Root: كلف (Kulfah/Takalluf)\n  * Lisan / Ayn: \"التكلف: تجشم ما لا يلزمك\" — undertaking what is not incumbent upon you with effort and hardship\n  * Al-Raghib (Mufradat): \"التكلف: تجشم ما ليس من شأنه\" — burdening oneself with what is not one's natural concern\n  * Al-Zamakhshari (Asas): \"تكلفت الأمر: تجشمته على مشقة\" — deliberate self-imposition of effort\n- Root: سمع (Samāʿ)\n  * Lisan / Ayn: Auditory perception; also what is heard — recitation, song, remembrance\n  * Al-Raghib (Mufradat): \"السماع عند الصوفية: ما يهيج الوجد من الأصوات الموزونة\" — that which stirs ecstatic finding from measured sounds\n  * Al-Zamakhshari (Asas): \"السماع عند القوم: حضور مجلس يهيج الأحوال الشريفة\" — attending an assembly that stirs noble spiritual states\n- Root: عشق (ʿIshq)\n  * Lisan / Ayn: \"العشق: فرط الحب\" — excessive love; from \"العشقة\" — a plant that twines around another\n  * Al-Raghib (Mufradat): \"العشق: فرط الحب، وأصله من عشقة النبات وهي ما التف منه على غيره\"\n  * Al-Zamakhshari (Asas): \"العشق مجاز في حق الله تعالى\" — metaphorical when applied to God\n- Root: بكى (Bukāʾ)\n  * Lisan / Ayn: Weeping, shedding tears\n  * Al-Raghib (Mufradat): \"البكاء: إجراء الدمع من عين لحزن أو غيره\"\n  * Al-Zamakhshari (Asas): \"تباكى: تكلف البكاء\" — deliberate self-induced weeping\n- Root: صعق (Ṣaʿq)\n  * Lisan / Ayn: \"الصعق: الغشي. والصعق: الموت\" — swooning/loss of consciousness; death\n  * Al-Raghib (Mufradat): \"الصعق: غشية تعرض من صوت شديد أو هول\"\n  * Al-Zamakhshari (Asas): \"صعق من هول الأمر: إذا غشي عليه من شدة الخوف\"\n- Root: خشع (Khushūʿ)\n  * Lisan / Ayn: \"الخشوع: الخضوع والتذلل\" — humility and submissiveness\n  * Al-Raghib (Mufradat): \"الخشوع: التذلل والخضوع، وقيل: الخشوع في الصوت والبصر، والخضوع في البدن\"\n  * Al-Zamakhshari (Asas): \"خشعت الأصوات: سكنت. وخشع البصر: انكسر\"\n- Root: أنس (Uns)\n  * Lisan / Ayn: \"الأنس: نقيض الوحشة\" — the opposite of loneliness/estrangement\n  * Al-Raghib (Mufradat): \"الأنس: حضور القلب مع المحبوب\" — the heart's presence with the Beloved\n  * Al-Zamakhshari (Asas): \"الأنس بالله: سكون القلب إليه\"\n- Root: وجل (Wajal)\n  * Lisan / Ayn: \"الوجل: الخوف مع اضطراب القلب\" — fear accompanied by cardiac agitation\n  * Al-Raghib (Mufradat): \"الوجل: الخوف مع اضطراب القلب\"\n  * Al-Zamakhshari (Asas): \"الوجل: أشد من الخوف، فإنه مع اضطراب\"\n- Root: طمأن (Ṭumaʾnīnah)\n  * Lisan / Ayn: \"الطمأنينة: السكون\" — tranquility\n  * Al-Raghib (Mufradat): \"الطمأنينة: سكون القلب بعد اضطراب\"\n  * Al-Zamakhshari (Asas): \"اطمأن القلب: سكن بعد اضطراب\"\n- Root: قشعر (Iqshirʿār)\n  * Lisan / Ayn: \"القشعريرة: تقبض الجلد من الخوف\" — contraction of the skin from fear\n  * Al-Raghib (Mufradat): \"الاقشعرار: انقباض الجلد وتقبضه من الخوف\"\n  * Al-Zamakhshari (Asas): \"اقشعر الجلد من الخوف: إذا تقبض\"\n- Root: لين (Līn)\n  * Lisan / Ayn: \"اللين: ضد الخشونة\" — softness, opposite of hardness\n  * Al-Raghib (Mufradat): \"اللين: نقيض الخشونة\"\n  * Al-Zamakhshari (Asas): \"لان قلبه: إذا سكن وخشع\"\n- Root: غشي (Ghashy)\n  * Lisan / Ayn: \"الغشي: الإغماء\" — loss of consciousness\n  * Al-Raghib (Mufradat): \"الغشية: ما يغشى القلب من شدة الوجد\"\n  * Al-Zamakhshari (Asas): \"غشي عليه: إذا أغمي عليه من شدة وجد أو خوف\"\n- Root: زعق (Zaʿq)\n  * Lisan / Ayn: \"الزعق: الصياح الشديد\" — violent screaming\n  * Al-Raghib (Al-Mufradat): \"الزعق: الصياح الشديد\"\n  * Al-Zamakhshari (Asas): \"زعق: صاح بأعلى صوته\"\n- Root: أزيز (Azīz)\n  * Lisan / Ayn: \"الأزيز: صوت النار والمرجل\" — the sound of fire and boiling pot\n  * Al-Raghib (Al-Mufradat): \"الأزيز: صوت النار والمرجل ونحوهما\"\n  * Al-Zamakhshari (Asas): \"أزيز الصدر: صوت يسمع من شدة البكاء والوجد\"\n- Root: شهق (Shahīq)\n  * Lisan / Ayn: \"الشهيق: رد النفس إلى الداخل بصوت\" — drawing breath inward with sound\n  * Al-Raghib (Al-Mufradat): \"الشهيق: رد النفس إلى الداخل بصوت\"\n  * Al-Zamakhshari (Asas): \"شهق الرجل: إذا خرجت نفسه بصوت من شدة الوجد\"\n- Root: حزن (Ḥuzn)\n  * Lisan / Ayn: \"الحزن: ضد السرور\" — grief, opposite of joy\n  * Al-Raghib (Al-Mufradat): \"الحزن: ألم النفس\"\n  * Al-Zamakhshari (Asas): \"الحزن: ألم النفس، وهو مجاز من حزن الأرض\" (metaphorical extension from rough ground)\n- Root: شيب (Shayb)\n  * Lisan / Ayn: \"الشيب: بياض الشعر\" — whitening of hair\n  * Al-Raghib (Al-Mufradat): \"الشيب: بياض الشعر\"\n  * Al-Zamakhshari (Asas): \"شيبتني هود: أي: كبرتني وأحزنتني حتى شاب شعري\"\n- Root: ذرف (Dharf)\n  * Lisan / Ayn: \"الذرف: سيلان الدمع\" — flowing of tears\n  * Al-Raghib (Al-Mufradat): \"ذرفت العين: سال دمعها\"\n  * Al-Zamakhshari (Asas): \"ذرفت عينه: إذا سال دمعها من حزن\"\n- Root: فيض (Fayḍ)\n  * Lisan / Ayn: \"الفيض: سيلان الماء\" — overflowing of water\n  * Al-Raghib (Al-Mufradat): \"الفيض: جريان الماء بكثرة\"\n  * Al-Zamakhshari (Asas): \"فاضت العين بالدمع: سالت. وفاض القلب: امتلأ\"\n- Root: نقر (Naqr)\n  * Lisan / Ayn: \"النقر: الضرب على الشيء حتى يصوت\" — striking something until it sounds\n  * Al-Raghib (Al-Mufradat): \"الناقور: الصور\" — the Trumpet\n  * Al-Zamakhshari (Asas): \"الناقور: الصور الذي ينفخ فيه إسرافيل\"\n- Root: رعش (Riʿshah)\n  * Lisan / Ayn: \"الرعدة: الاضطراب\" — trembling\n  * Al-Raghib (Al-Mufradat): \"الارتعداد: الاضطراب\"\n  * Al-Zamakhshari (Asas): \"ارتعدت فرائصه: اضطربت من شدة الخوف\"\n- Root: فرص (Farīṣah)\n  * Lisan / Ayn: \"الفريصة: لحمة بين الجنب والكتف ترعد عند الفزع\" — the flesh between the side and shoulder blade that trembles at fright\n  * Al-Raghib (Al-Mufradat): \"الفريصة: لحمة بين الجنب والكتف ترعد عند الفزع\"\n  * Al-Zamakhshari (Asas): \"ارتعدت فرائصه: من شدة الخوف\"\n- Root: عما (ʿAmā)\n  * Lisan / Ayn: \"العمى: ذهاب البصر. والعمى: ذهاب البصيرة\" — blindness of sight; blindness of insight\n  * Al-Raghib (Al-Mufradat): \"العمى: آفة في البصر، وقد يستعار لآفة البصيرة\"\n  * Al-Zamakhshari (Asas): \"عمي القلب: ذهبت بصيرته\"\n- Root: أبصر (Abṣara)\n  * Lisan / Ayn: \"البصر: حاسة الرؤية. والبصيرة: العلم\" — sight; insight\n  *Al-Raghib (Al-Mufradat): \"الإبصار: إدراك البصر، وقد يستعار للبصيرة\"\n  * Al-Zamakhshari (Asas): \"أبصر الحق: علمه. ومنه: البصيرة\"\n- Root: كأس (Ka's)\n  * Lisan / Ayn: \"الكأس: القدح إذا كان فيه شراب\" — the cup when it contains drink\n  * Al-Raghib (Al-Mufradat): \"الكأس: الإناء المعروف، وقد يقال لما فيه\"\n  * Al-Zamakhshari (Asas): \"الكأس: القدح إذا كان فيه شراب\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 511", "section_title_en": "Section 511", "section_index": 511, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}, {"arabic": "فيه روح نسيم قال كعب وقتادة يوم يقوم الناس لرب العلمين قال يقومون مقدار ثلثمائة عام بل قال عبد الله بن عمرو تلا رسول الله صلى الله عليه وسلم هذه الآية ثم قال كيف بكم إنه جمعكم الله كما تجمع النبل فى الكنانة خمسين ألف سنة ولا ينظر إليكم (1) وقال الحسن ما ظنك بيوم قاموا فيه على أقدامهم مقدار خمسين ألف سنة لا يأكلون فيها أكلة ولا يشربون فيها شربة حتى إذا انقطعت أعناقهم عطشا واحترقت أجوافهم جوعا انصرف بهم إلى النار فسقوا من عين آنية قد آن حرها واشتد لفحها فلما بلغ المجهود منهم ما لا طاقة لهم ب", "english": "It is a Day on which all creatures stand, their eyes fixed in a stare, their hearts split asunder. They are not spoken to, and no one looks into their affairs. They stand for three hundred years, eating not therein a single eating, drinking not therein a single drink, and finding not therein the breath of any breeze. Ka'b and Qatadah said: \"The Day when mankind shall stand before the Lord of the Worlds\" {«يوم يقوم الناس لرب العالمين»} (Al-Mutaffifin: 6) — they stand for the measure of three hundred years. Nay — 'Abdullah ibn 'Amr said: The Messenger of Allah, peace be upon him, recited this verse, then said: \"How will it be with you when Allah gathers you as arrows are gathered in a quiver, for fifty thousand years, and He does not look upon you?\" (1) And Al-Hasan said: What is your opinion of a Day on which they stand upon their feet for the measure of fifty thousand years, eating not therein a single eating, drinking not therein a single drink — until, when their necks are severed by thirst and their innards are burnt by hunger, they are turned away to the Fire and given to drink from a boiling spring whose heat has reached its peak and whose scorching blast has grown fierce. Then when the utmost exhaustion reaches them, beyond what they have strength to bear, they speak one to another, seeking one who is honored before his Lord to intercede on their behalf. They cling to no prophet but that he repels them, saying: \"Leave me, leave me — my own self, my own self; my own affair has occupied me from the affair of another.\" And each one excuses himself by the severity of God's wrath, saying: \"Today our Lord has become wrathful with a wrath the like of which He has never been wrathful before, nor will He be wrathful with its like after.\" — until our Prophet, peace be upon him, intercedes for those to whom permission is granted therein; they possess not intercession save for him whom the Merciful has permitted and with whose word He is pleased {«لا يملكون الشفاعة إلا من أذن له الرحمن ورضي له قولا»} (Ta-Ha: 109).", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1338", "section_title_en": "The Description of the Length of the Day of Resurrection", "section_index": 1338, "anchors": "- Root: يوم (yawm)\n  * Lisan / Ayn: Core meaning is the period from sunrise to sunset; extended to any span of time, however long.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the term denotes any duration whatsoever, as in {«وذكرهم بأيام الله»} (Ibrahim: 5), where \"days\" are attributed to God as an honorific for His mighty acts.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to the solar day; metaphorical (Majaz) usage extends to \"days of the Arabs\" meaning their battles and epochal events. Here, the \"day\" of fifty thousand years is a real duration, not a metaphor.\n- Root: نفس (nafs)\n  * Lisan / Ayn: The self, soul, or spirit; also breath.\n  * Al-Raghib (Mufradat): \"نفسه: ذاته\" — God's \"Self\" is His very Essence. In the prophetic oath \"والذي نفسي بيده\" (By Him in Whose hand is my soul), the soul is the living self.\n  * Al-Zamakhshari (Asas): Literal: the soul/spirit; metaphorical: \"دفق نفسه\" (he poured out his soul = his blood). The Prophet's cry \"نفسي نفسي\" (myself, myself) is literal self-reference — each prophet is absorbed in his own deliverance.\n- Root: اكل (akl)\n  * Lisan / Ayn: Eating, consuming food.\n  * Al-Raghib (Mufradat): \"الأكل: تناول المطعم\" — partaking of nourishment; metaphorically extended to fire consuming fuel.\n  * Al-Zamakhshari (Asas): Literal: eating; metaphorical: \"أكل مالي وشربه\" (he ate my wealth and drank it = he fed it to people). The negation \"لا يأكلون فيه أكلة\" (they eat not therein a single eating) is literal — total deprivation of food.\n- Root: شرب (sharb)\n  * Lisan / Ayn: Drinking; also a share or portion.\n  * Al-Raghib (Mufradat): \"الشرب: تناول كل مائع\" — partaking of any liquid; \"الشرب: النصيب منه\" — the share of it.\n  * Al-Zamakhshari (Asas): Literal: drinking water, milk, medicine; metaphorical: \"أشرب الثوب حمرة\" (the garment was saturated with redness). \"ولا يشربون فيه شربة\" (nor drink therein a single drink) is literal — total deprivation of drink.\n- Sibawayh Rule: Interposition of the subject between the conditional and its apodosis; also the construction of \"حتى إذا\" (until when) marking a temporal sequence where the subordinate clause (انقطعت أعناقهم) is completed before the main clause (انصرف بهم) — a periodic structure requiring careful temporal parsing.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}], "14": [{"arabic": "الختم وتلا قوله تعالى كلا بل ران على قلوبهم الآية الإطلاق الثاني أن يراد به التصديق والعمل جميعا كما قال صلى الله عليه وسلم الإيمان بضع وسبعون بابا (1) وقال صلى الله عليه وسلم لا يزني الزاني حين يزني وهو مؤمن وإذا دخل العمل في مقتضى لفظ الإيمان لم تخف زيادته ونقصانه وهل يؤثر ذلك في زيادة الإيمان الذي هو مجرد التصديق هذا فيه نظر وقد أشرنا إلى أنه يؤثر فيه الإطلاق الثالث أن يراد به التصديق اليقيني على سبيل الكشف وانشراح الصدر والمشاهدة بنور البصيرة وهذا أبعد الأقسام عن قبول الزيادة ولكني أقول", "english": "I say: It is as though one had kindled a firebrand, yet there was no wine [to warm oneself by]. But let us return to the intended purpose. For this science [of unveiling, ʿilm al-mukāshafah] lies outside the science of practical religion (ʿilm al-muʿāmalah); yet between the two sciences there is also connection and linkage. For this reason, you see the sciences of unveiling climbing, at every hour, upon the sciences of practical religion — until they are unveiled from them by the imposition of obligation (taklīf). This, then, is the aspect of the increase of faith through obedience, in virtue of this first usage (al-iṭlāq al-awwal). And for this reason ʿAlī — may God honor his face — said: \"Faith indeed appears as a white gleam; when the servant performs righteous deeds, it grows and increases until the whole heart becomes white. And hypocrisy indeed appears as a black speck; when sacred prohibitions are violated, it grows and increases until the whole heart becomes black, and then it is sealed over it — and that is the sealing (al-khatm).\" And he recited the saying of God, Exalted: {«Nay, but that which they have earned has rusted upon their hearts»} (al-Muṭaffifīn, 83:14).", "book_title": "Foundations of Belief", "section_title_ar": "Section 101", "section_title_en": "On the Increase and Decrease of Faith — Three Senses of the Term, and the Heart's Varying Tranquility", "section_index": 101, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: Core meaning of turning over, revolving, and transforming a thing from one state to another — as the heart is perpetually turning between states.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart's turning is its being diverted from its course; the heart's whitening or blackening is its transformation through acts.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): turning a garment or object over. Metaphorical (Majaz): \"قلب المعلم الصبيان\" — the teacher's turning the boys back; here, the heart's \"sealing\" (khatm) and \"rusting\" (ran) are metaphorical turnings of the heart's very substance.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as the apprehension of a thing's reality; the root also yields \"sign\" and \"landmark\" — knowledge is that by which one is guided.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — two modes: apprehension of the essence, and judgment upon it; certainty admits degrees of clarity.\n  * Al-Zamakhshari (Asas): Literal: \"ما علمت بخبرك: ما شعرت به\" — to know is to perceive. Metaphorical: knowledge as a guiding landmark (ʿalam) upon the path.\n- Root: ايم (a-y-m)\n  * Lisan / Ayn: The state of being without a spouse; extended metaphorically to any state of lack or separation.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم\" — the unmarried; \"الحرب مأيمة\" — war separates spouses. Not directly used here, but the root's sense of \"lack\" versus \"completion\" parallels the discussion of faith's increase and decrease.\n  * Al-Zamakhshari (Asas): Literal: \"الحرب مأيمة ميتمة\" — war makes widows and orphans. Metaphorical resonance: faith, when complete, is like a marriage bond; when deficient, like the state of the ayyim.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a governing word and its governed term, provided the interposed element is such that speech may properly pause upon it. This governs the periodic structure of the author's conditional clauses and parenthetical qualifications.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'", "badge": "Insight"}, {"arabic": "عز وجل في كتابه {كلا بل ران على قلوبهم ما كانوا يكسبون} وروى أبو هريرة رضي الله عنه أنه صلى الله عليه وسلم قال إن الله سبحانه ليرفع الدرجة للعبد في الجنة فيقول يا رب أنى لي هذه فيقول عز وجل باستغفار ولدك لك (4) وروت عائشة رضي الله عنها أنه صلى الله عليه وسلم قال اللهم اجعلني من الذين إذا أحسنوا استبشروا وإذا أساؤوا استغفروا (5) وقال صلى الله عليه وسلم إذا أذنب العبد ذنبا فقال اللهم اغفر لي فيقول الله عز وجل أذنب عبدي ذنبا فعلم أن له ربا يأخذ بالذنب ويغفر الذنب عبدي اعمل ما شئت فقد غفرت لك (6) وقال", "english": "God Most High said: {«والذين إذا فعلوا فاحشة أو ظلموا أنفسهم ذكروا الله فاستغفروا لذنوبهم»} — \"And those who, when they commit an indecency or wrong themselves, remember God and seek forgiveness for their sins\" {آل عمران/135}.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 246", "section_title_en": "On Seeking Forgiveness (Al-Istighfar) — Section 246", "section_index": 246, "anchors": "- Root: ذنب (dhanb)\n  * Lisan / Ayn: Core meaning of \"tail\" or \"taking hold of a tail\"; extended to signify a sin as that which trails behind and follows a person.\n  * Al-Raghib (Mufradat): \"الذنب في الأصل: الأخذ بذنب الشيء\" — sin is that by which one is seized and held accountable; used metaphorically for a fault that clings to its perpetrator.\n  * Al-Zamakhshari (Asas): Literal: tail of an animal. Metaphorical: \"هو من الأذناب\" — one who follows; sin as that which trails the soul and must be severed through repentance.\n- Root: غفر (ghafara)\n  * Lisan / Ayn: Covering, veiling, protecting from defilement; a shield or helmet (المغفر).\n  * Al-Raghib (Mufradat): \"الغفران والمغفرة من الله هو أن يصون العبد من أن يمسه العذاب\" — divine forgiveness is God's protection of the servant from being touched by punishment.\n  * Al-Zamakhshari (Asas): Literal: to cover and protect. Metaphorical: God's \"covering\" of sins — not merely erasure, but active safeguarding of the sinner from consequence.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The frequent interposition of \"يا رب\" and vocative constructions between the subject and predicate in supplicatory sentences, as in \"اللهم اغفر لي,\" where the vocative particle governs the imperative verb's addressee, reflecting the grammatical permissibility of separation between governing and governed elements in invocational speech.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "15": [{"arabic": "قال الله تعلى كلا إنهم عن ربهم يومئذ لمحجوبون ثم إنهم لصالوا الجحيم فرتب العذاب بالنار على ألم الحجاب وألم الحجاب كاف من غير علاوة النار فكيف إذا أضيفت العلاوة إليه فنسأل الله تعالى أن يقرر في أسماعنا ما نفث في روع رسول الله صلى الله عليه وسلم حيث قيل له أحبب من أحببت فإنك مفارقه (1) وفي معنى ما ذكرناه من المثال قول الشاعر كدود كدود القز ينسج دائما .", "english": "As for the one who restricts himself to the measure of necessity and the essential — he cannot be attributed to the world (al-dunyā). Rather, that measure of the world is precisely the essence of religion (dīn), because it is a condition for religion, and the condition is part of the conditioned. Evidence for this is what has been related: that Abraham, the Friend (al-Khalīl), peace be upon him, was struck by a need, so he went to a friend of his to borrow something from him, but he did not lend him. He returned distressed, and God — exalted be He — revealed to him: \"Had you asked My Friend, He would have given you.\" He said: \"O Lord, I knew Your wrath against the world, so I feared to ask You for anything of it.\" Then God — exalted be He — revealed to him: \"Need is not of the world.\" Thus, the measure of need is of religion. Whatever is beyond that is a burden (wabāl) in the Hereafter, and in this world as well it is likewise — known to whoever examines the conditions of the rich and what they endure of tribulation in earning wealth, amassing it, guarding it, enduring humiliation in it, and the utmost of their happiness with it being that it is handed over to their heirs, who eat of it — and perhaps they are enemies of them, and perhaps they use it to aid them in disobedience, so that he becomes their helper in it. For this reason, the collector of the world and the follower of lusts is likened to the silk-worm (dūd al-qazz): it ceaselessly spins upon itself a thread, then it seeks to emerge but finds no escape, so it dies and perishes because of the work it wrought upon itself. Likewise, whoever follows the lusts of the world — he only fastens upon his heart chains that bind him to what he desires, until the chains accumulate upon him: wealth binds him, and status, and family, and children, and the gloating of enemies, and the ostentation of friends, and the rest of the shares of the world. If it occurs to him that he has erred in this, and he resolves to exit the world, he cannot do so; he sees his heart bound with chains and fetters that he cannot cut. And if he abandons one beloved of his beloveds by his own choice, he nearly kills himself and strives toward his own destruction — until the Angel of Death separates him from all of them at once.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 1099", "section_title_en": "The Middle Path Between Poison and Remedy: The Necessity of Restraint and the Peril of Attachment to the World", "section_index": 1099, "anchors": "- Root: ن-ف-ع (N-F-ʿ)\n  * Lisan / Ayn: Core meaning of benefit, utility, and that which yields advantage; opposed to ḍarar (harm).\n  * Al-Raghib (Mufradat): Theological nuance: benefit (nafʿ) is that which brings one nearer to God or secures one's ultimate felicity; harm is its opposite in the scale of the Hereafter.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): physical or material utility; metaphorical (majāz): spiritual benefit accruing to the heart and soul.\n- Root: ض-ر-ر (Ḍ-R-R)\n  * Lisan / Ayn: Harm, injury, distress; the opposite of nafʿ; also denotes constriction and hardship.\n  * Al-Raghib (Mufradat): In Kalam usage, ḍarar is that which obstructs the soul's journey toward God or corrupts its state.\n  * Al-Zamakhshari (Asas): Literal: bodily or worldly injury; metaphorical: that which damages one's religious state (dīn) or severs one from divine proximity.\n- Root: ح-ج-ب (Ḥ-J-B)\n  * Lisan / Ayn: Veiling, screening, concealing; the barrier that prevents vision or access.\n  * Al-Raghib (Mufradat): Theological: the veil (ḥijāb) separating the creature from the Creator; the state of being veiled (maḥjūb) from God is the essence of divine wrath and the precondition for the Fire's dominion.\n  * Al-Zamakhshari (Asas): Literal: a physical curtain; metaphorical: the spiritual obstruction of the heart from the vision of God, as in the Quranic verse cited.\n- Root: ق-ز-ز (Q-Z-Z) [as in دود القز — silk worm]\n  * Lisan / Ayn: The silk-worm (dūd al-qazz); its action of spinning silk thread around itself.\n  * Al-Raghib (Mufradat): Used as a parable (mathal) for the soul that weaves its own bonds of worldly attachment until it is trapped.\n  * Al-Zamakhshari (Asas): Metaphorical: the worm's self-imposed cocoon parallels the sinner's self-forged chains of desire; the imagery is purely figurative, not literal.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (باب الحصر والتقييد) — Governing the conditional and exceptive structures (e.g., \"فمن احتاط فإنما يحتاط لنفسه\") where the predicate is restricted to the subject's own benefit or harm, emphasizing moral self-accountability.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Poverty and Abstinence'", "badge": "Afterlife"}], "18": [{"arabic": "فقال إن كتاب الأبرار لفي عليين {ثم قال} يشهده المقربون فكان أمارة علو كتابهم أنه ارتفع إلى حيث يشهده المقربون وكما أن الأبرار يجدون المزيد في حالهم ومعرفتهم بقربهم من المقربين ومشاهدتهم لهم فكذلك يكون حالهم في الآخرة ما خلقكم ولا بعثكم إلا كنفس واحدة كما بدأنا أول خلق نعيده وكما قال تعالى جزاء وفاقا أي وافق الجزاء أعمالهم فقوبل الخالص بالصرف من الشراب وقوبل المشوب بالمشوب وشوب كل شراب على قدر ما سبق من الشوب في حبه وأعماله فمن يعمل مثقال ذرة خيرا يره ومن يعمل مثقال ذرة شرا ير", "english": "...twenty years.\nAnd al-Junayd said: \"The mark of the lover is the constancy of vigor and cheerfulness with a passion that wearies his body but does not weary his heart.\"\nAnd some of them said: \"Labor borne out of love — languor does not enter into it.\"\nAnd one of the scholars said: \"By God, no lover of God is ever fully quenched by His obedience, even if he were to attain to the most immense of means.\"\nAll of this and its like is found in observable experience, for the passionate lover does not find burdensome the pursuit of his beloved's desire, and he savors with his heart the service of the beloved even if it is arduous upon his body. And whenever his body falls short, the dearest of things to him is that his capacity should return to him and that incapacity should depart from him, so that he may occupy himself with it. Such, likewise, is the love of God the Exalted — for every love that becomes dominant inevitably subdues whatever is beneath it. So whoever's beloved is dearer to him than his sloth abandons sloth in serving him; and if the beloved is dearer to him than his wealth, he spends his wealth in his love.\nAnd it was said to one of the lovers — who had expended his very self and his wealth until nothing remained to him — \"What was the cause of your state in love?\" He said: \"One day I heard a lover who had secluded himself with his beloved, saying: 'By God, I love you with my whole heart, while you turn away from me with your whole face.' The beloved said to him: 'If you truly love me, what will you spend upon me?' He said: 'O my master, I put you in possession of all that I own, and then I spend upon you my very spirit until it is destroyed.'\" So I said: \"This is a creature loving a creature, and a slave loving a slave — how then with slaves loving the Worshipped One?\" All of this is by His cause.\nAnd among them is that he be compassionate toward all of God's servants, merciful to them, and severe against all of God's enemies — and against everyone who commits something of what God dislikes — as God the Exalted said: {«أشداء على الكفار رحماء بينهم»} \"Harsh against the disbelievers, merciful among themselves.\" No reproach of any reproacher seizes him, and no diverting force turns him from wrath for God's sake. With this God described His friends, saying: \"Those who are enamored with My love as a child is enamored with a thing, and who take refuge in My remembrance as the eagle takes refuge in its nest, and who rage for the sake of My sanctities as the leopard rages when provoked — for then he cares not whether the people are few or many.\"\nSo consider this example: the child, when enamored with a thing, does not part from it at all; if it is taken from him, he has no occupation but weeping and crying out until it is returned to him. If he sleeps, he takes it with him into his clothes; when he awakens, he returns and clings to it. Whenever he is parted from it, he weeps; whenever he finds it, he laughs. Whoever contends with him over it, he hates; whoever gives it to him, he loves. As for the leopard, he does not master himself at the moment of rage, until he reaches such a pitch of fury that he destroys himself. These, then, are the marks of love. Whoever's marks are perfected in him, his love is perfected and his affection is purified — so in the Hereafter his drink is clear and his draught is sweet.\nBut whoever's love is mingled with the love of other than God, he delights in the Hereafter in proportion to his love, for his drink is mingled with a measure of the drink of the Near Ones (al-muqarrabūn), as God the Exalted said concerning the righteous (al-abrār): {«إن الأبرار لفي نعيم»} \"Verily the righteous are in bliss,\" {ثم قال} then He said: {«يسقون من رحيق مختوم * ختامه مسك وفي ذلك فليتنافس المتنافسون * ومزاجه من تسنيم * عينا يشرب بها المقربون»} \"They are given to drink of sealed nectar, whose seal is musk — and in that let the competitors compete — and its mixture is of tasnīm, a spring from which the Near Ones drink.\" So when the drink of the righteous is sweetened by the admixture of the pure drink which belongs to the Near Ones...\nAnd \"drink\" is an expression for the totality of the bliss of the Gardens, just as the Book expressed by it all deeds, for He said: {«إن كتاب الأبرار لفي عليين»} \"Verily the book of the righteous is in 'Illiyyūn,\" {ثم قال} then He said: {«يشهده المقربون»} \"The Near Ones bear witness to it.\" So it was a sign of the loftiness of their book that it ascended to where the Near Ones bear witness to it. And just as the righteous find increase in their state and their knowledge by their proximity to the Near Ones and their beholding of them, so likewise is their state in the Hereafter — {«ما خلقكم ولا بعثكم إلا كنفس واحدة»} \"Your creation and your resurrection are but as a single soul,\" just as He said — as we began the first creation, We shall repeat it — and as the Exalted said: {«جزاء وفاقا»} \"A recompense fully matching\" — that is, the recompense matched their deeds. So the pure was met with the unmixed of the drink, and the mingled was met with the mingled.\nAnd the admixture of every drink is in proportion to what preceded of admixture in his love and his deeds. For {«من يعمل مثقال ذرة خيرا يره * ومن يعمل مثقال ذرة شرا يره»} \"Whoever does an atom's weight of good shall see it, and whoever does an atom's weight of evil shall see it.\" And {«إن الله لا يغير ما بقوم حتى يغيروا ما بأنفسهم * إن الله لا يظلم مثقال ذرة وإن تك حسنة يضاعفها وإن كان مثقال حبة من خردل أتينا بها وكفى بنا حاسبين»} \"Verily God does not change what is in a people until they change what is in themselves. Verily God does not wrong an atom's weight; and if it be a good deed, He multiplies it, and if it be a grain of mustard-seed, We bring it — and sufficient are We as reckoners.\"\nSo whoever's love in this world was his hope for the bliss of the Garden, the wide-eyed houris, and the palaces — he is granted the Garden to settle therein wherever he wishes, to sport with the immortal youths and take pleasure with the women. There his delight in the Hereafter reaches its end, because every man is given in love only what his soul desires and his eye delights in.\nBut whoever's aim was the Lord of the Abode and the Owner of the Kingdom, and nothing overcame him save His love with sincerity and truthfulness — he is lodged in the seat...", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1179", "section_title_en": "The Marks of True Love and the Degrees of the Hereafter", "section_index": 1179, "anchors": "- Root: نشط (n-sh-ṭ)\n  * Lisan / Ayn: Core meaning of vitality, energy, and alacrity in action.\n  * Al-Raghib (Mufradat): Activity of the soul (nafs) in pursuing what it loves, unflagging in its ardor.\n  * Al-Zamakhshari (Asas): Literal: bodily vigor; Metaphorical: the heart's persistent zeal that overrides physical exhaustion.\n- Root: شرب (sh-r-b)\n  * Lisan / Ayn: Drinking; the act of imbibing liquids.\n  * Al-Raghib (Mufradat): In Quranic usage, a metaphor (majaz) for the soul's reception of spiritual bliss and states.\n  * Al-Zamakhshari (Asas): Literal: physical quenching; Metaphorical: the tasting of paradisiacal delight, graded by purity (safā') versus admixture (shawb).\n- Root: صفو (ṣ-f-w)\n  * Lisan / Ayn: Purity, clarity, and freedom from turbidity or mixture.\n  * Al-Raghib (Mufradat): The unalloyed state of sincere love (mahabbah) and its corresponding reward.\n  * Al-Zamakhshari (Asas): Literal: clear liquid; Metaphorical: the soul's exclusive devotion to God, yielding unmixed bliss.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to delimit the final reward strictly by the object and purity of one's love, as in \"إنما يعطى كل إنسان في المحبة ما تشتهيه نفسه.\"", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "22": [{"arabic": "تعالى حيث قال {إن الأبرار لفي نعيم وإن الفجار لفي جحيم} قال فأين رحمة الله قال قريب من المحسنين ثم قال سليمان يا أبا حازم أي عباد الله أكرم قال أهل البر والتقوى قال فأي الأعمال أفضل قال أداء الفرائض مع اجتناب المحارم قال فأي الكلام أسمع قال قول الحق عند من تخاف وترجوا قال فأي المؤمنين أكيس قال رجل عمل بطاعة الله ودعا الناس إليها قال فأي المؤمنين أخسر قال رجل خطا في هوى أخيه وهو ظالم فباع آخرته بدنيا غيره قال سليمان ما تقول فيما نحن فيه قال أو تعفيني قال لا بد فإنها نصيحة تلقيها إ", "english": "...my need, so I said: \"I have only been placed in this station by the swords of the Muhājirūn and the Anṣār, while their sons are dying of hunger. So fear God, and deliver to them their rights.\" He lowered his head, then raised it and said: \"Present your need to us.\" I said: \"ʿUmar ibn al-Khaṭṭāb—may God be pleased with him—performed the Pilgrimage.\" He said to his treasurer: \"How much did he spend?\" He replied: \"A little over ten dirhams.\" And I see here wealth that the necks of camels cannot bear to carry. Then he left. Thus were their manner of entering upon the sultans when they were compelled [to do so], and they would risk their very souls to exact vengeance for God against their oppressors.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 392", "section_title_en": "Section 392 — The Conduct of the Religious Scholars with Rulers, and the States that Arise from Mixing with Them", "section_index": 392, "anchors": "- Root: قول (q-w-l)\n  * Lisan / Ayn: Speech, utterance, saying; the act of articulating words with meaning.\n  * Al-Raghib (Mufradat): Theological discourse; the content of what is said as binding or informative.\n  * Al-Zamakhshari (Asas): Literal: articulated speech. Metaphorical: a statement of truth or counsel delivered with authority.\n- Root: ملك (m-l-k)\n  * Lisan / Ayn: Possession, dominion, sovereignty; to have power over something.\n  * Al-Raghib (Mufradat): The king (malik) is one who disposes by command and prohibition over a people; kingship (mulk) is of two kinds: actual possession/authority and the capacity for it.\n  * Al-Zamakhshari (Asas): Literal: ownership and rule. Metaphorical: mastery over oneself, or the seizure of control over affairs.\n- Root: ولي (w-l-y)\n  * Lisan / Ayn: Nearness, closeness; guardianship, governance; to be in charge of a matter.\n  * Al-Raghib (Mufradat): The walī is the one who undertakes a matter; wilāyah is the office of governance or authority over others.\n  * Al-Zamakhshari (Asas): Literal: proximity and friendship. Metaphorical: the assumption of authority (tawallī) over a public office.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (باب الحصر والتقييد) — Constructions such as \"إنما\" and \"ما ... إلا\" restrict the predicate to a single referent, emphasizing exclusivity in the assertion.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "24": [{"arabic": "في أهل الجنة وفي وجوههم نضرة النعيم يسقون من رحيق مختوم جالسين على منابر الياقوت الأحمر في خيام من اللؤلؤ الرطب الأبيض فيها بسط من العبقري الأخضر متكئين على أرائك منصوبة على أطراف أنهار مطردة بالخمر والعسل محفوفة بالغلمان والولدان مزينة بالحور العين من الخيرات الحسان كأنهن الياقوت والمرجان لم يطمثهن إنس قبلهم ولا جان يمشين في درجات الجنان إذا اختالت إحداهن في مشيها حمل أعطافها سبعون ألفا من الولدان عليها من طرائف الحرير الأبيض ما تتحير فيه الأبصار مكللات بالتيجان المرصعة باللؤلؤ والمرجان شكلا", "english": "For God Most High has said: {«إن الأبرار لفي نعيم وإن الفجار لفي جحيم»} — \"Indeed the righteous are in bliss, and indeed the wicked are in Hellfire.\" So present yourself before these two verses, and you will have known your resting-place between the two abodes. And God knows best.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1351", "section_title_en": "Section 1351 — On the Description of Paradise and the Varieties of Its Bliss", "section_index": 1351, "anchors": "- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Core root denotes softness, ease, and pleasant living; al-Ayn notes it among names of the leopard and tiger, while Lisan records \"Nuʿm\" as a proper name.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — niʿmah is the excellent state/condition one inhabits; niʿīm is the experience of delight. The verse {«إن الأبرار لفي نعيم»} designates the abiding state of bliss as a settled condition, not a transient act.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"في النعمة والنعيم\" — dwelling in bounty and bliss. Metaphorical (Majaz): \"خفت نعامتهم: ذهبوا\" — ostriches departing; here the root's literal sense of softness is transfigured into the theological state of perpetual ease, free from all harshness.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: Core root: face, front, direction; al-Ayn cites \"وجه الصواب\" — the face/course of correctness.\n  * Al-Raghib (Mufradat): The face is the noblest part of the outward body, hence used for the essence (al-dhāt) of a thing; in {«ويبقى وجه ربك ذو الجلال والإكرام»} it signifies the Divine Essence. Here \"وجه الملك الكريم\" — the Face of the Generous King — denotes the Beatific Vision of God's Essence, not a corporeal organ.\n  * Al-Zamakhshari (Asas): Literal: physical face. Metaphorical: \"وجه القوم، وهؤلاء وجوه البلد\" — the foremost, noblest of a people; thus the \"face\" of the King is His most august presence.\n- Root: مرج (m-r-j)\n  * Lisan / Ayn: Core root: mixing, confusion, letting loose; al-Ayn: \"المرج: الشهد\" — also pure honey; Lisan: \"مرج أمرهم: اختلط\" — their affair became disordered.\n  * Al-Raghib (Mufradat): \"أصل المرج: الخلط\" — mixing; \"أمر مريج\" — a confused affair (Q. 50:5). In this text, the rivers of Paradise \"مطردة\" (flowing) are not \"ممرجة\" (mixed/confused) — rather they run pure and distinct, each in its channel.\n  * Al-Zamakhshari (Asas): Literal: \"مرج الدواب: أرسلها في المرج\" — releasing beasts into pasture. Metaphorical: \"مرج الله البحرين\" — God let the two seas flow freely; \"مرجت عهودهم\" — covenants became disordered. The contrast sharpens the purity of Paradise's rivers.\n- Root: امن (a-m-n)\n  * Lisan / Ayn: Core root: safety, freedom from fear; al-Ayn treats it under the hamzah chapter as the state of security.\n  * Al-Raghib (Mufradat): \"أصل الأمن: طمأنينة النفس وزوال الخوف\" — tranquility of the soul and removal of fear. In the Hereafter, \"آمنون\" is not mere absence of threat but the positive, settled peace of the soul in the Divine presence.\n  * Al-Zamakhshari (Asas): Literal: \"أمنته وآمننيه\" — to grant safety. Metaphorical: \"فرس أمين القوى\" — a horse whose strength is trustworthy; here the blessed are \"آمنون من ريب المنون\" — secure from the vicissitudes of fate, a security that is trustworthy and unbreachable.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule permits separation between a preposition and its object by an element upon which speech may properly pause, as in \"إن به لضرًا\" — here \"فهم فيما اشتهت أنفسهم خالدون\" (in what their souls desire, abiding eternally) interposes the clause of desire between the prepositional phrase and its predicate, heightening rhetorical emphasis on the soul's fulfillment.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}], "25": [{"arabic": "يسقون من رحيق مختوم ختامه مسك وفي ذلك فليتنافس المتنافسون ومزاجه من تسنيم عينا يشرب بها المقربون فإذا طاب شراب الأبرار لشوب الشراب الصرف الذي هو للمقربين والشراب عبارة عن جملة نعيم الجنان كما أن الكتاب عبر به عن جميع الأعمال فقال إن كتاب الأبرار لفي عليين {ثم قال} يشهده المقربون فكان أمارة علو كتابهم أنه ارتفع إلى حيث يشهده المقربون وكما أن الأبرار يجدون المزيد في حالهم ومعرفتهم بقربهم من المقربين ومشاهدتهم لهم فكذلك يكون حالهم في الآخرة ما خلقكم ولا بعثكم إلا كنفس واحدة كما بدأنا أول خلق نعيده وكما قال تعالى جزاء وفاقا أي وافق الجزاء", "english": "...twenty years.\nAnd al-Junayd said: \"The mark of the lover is the constancy of vigor and cheerfulness with a passion that wearies his body but does not weary his heart.\"\nAnd some of them said: \"Labor borne out of love — languor does not enter into it.\"\nAnd one of the scholars said: \"By God, no lover of God is ever fully quenched by His obedience, even if he were to attain to the most immense of means.\"\nAll of this and its like is found in observable experience, for the passionate lover does not find burdensome the pursuit of his beloved's desire, and he savors with his heart the service of the beloved even if it is arduous upon his body. And whenever his body falls short, the dearest of things to him is that his capacity should return to him and that incapacity should depart from him, so that he may occupy himself with it. Such, likewise, is the love of God the Exalted — for every love that becomes dominant inevitably subdues whatever is beneath it. So whoever's beloved is dearer to him than his sloth abandons sloth in serving him; and if the beloved is dearer to him than his wealth, he spends his wealth in his love.\nAnd it was said to one of the lovers — who had expended his very self and his wealth until nothing remained to him — \"What was the cause of your state in love?\" He said: \"One day I heard a lover who had secluded himself with his beloved, saying: 'By God, I love you with my whole heart, while you turn away from me with your whole face.' The beloved said to him: 'If you truly love me, what will you spend upon me?' He said: 'O my master, I put you in possession of all that I own, and then I spend upon you my very spirit until it is destroyed.'\" So I said: \"This is a creature loving a creature, and a slave loving a slave — how then with slaves loving the Worshipped One?\" All of this is by His cause.\nAnd among them is that he be compassionate toward all of God's servants, merciful to them, and severe against all of God's enemies — and against everyone who commits something of what God dislikes — as God the Exalted said: {«أشداء على الكفار رحماء بينهم»} \"Harsh against the disbelievers, merciful among themselves.\" No reproach of any reproacher seizes him, and no diverting force turns him from wrath for God's sake. With this God described His friends, saying: \"Those who are enamored with My love as a child is enamored with a thing, and who take refuge in My remembrance as the eagle takes refuge in its nest, and who rage for the sake of My sanctities as the leopard rages when provoked — for then he cares not whether the people are few or many.\"\nSo consider this example: the child, when enamored with a thing, does not part from it at all; if it is taken from him, he has no occupation but weeping and crying out until it is returned to him. If he sleeps, he takes it with him into his clothes; when he awakens, he returns and clings to it. Whenever he is parted from it, he weeps; whenever he finds it, he laughs. Whoever contends with him over it, he hates; whoever gives it to him, he loves. As for the leopard, he does not master himself at the moment of rage, until he reaches such a pitch of fury that he destroys himself. These, then, are the marks of love. Whoever's marks are perfected in him, his love is perfected and his affection is purified — so in the Hereafter his drink is clear and his draught is sweet.\nBut whoever's love is mingled with the love of other than God, he delights in the Hereafter in proportion to his love, for his drink is mingled with a measure of the drink of the Near Ones (al-muqarrabūn), as God the Exalted said concerning the righteous (al-abrār): {«إن الأبرار لفي نعيم»} \"Verily the righteous are in bliss,\" {ثم قال} then He said: {«يسقون من رحيق مختوم * ختامه مسك وفي ذلك فليتنافس المتنافسون * ومزاجه من تسنيم * عينا يشرب بها المقربون»} \"They are given to drink of sealed nectar, whose seal is musk — and in that let the competitors compete — and its mixture is of tasnīm, a spring from which the Near Ones drink.\" So when the drink of the righteous is sweetened by the admixture of the pure drink which belongs to the Near Ones...\nAnd \"drink\" is an expression for the totality of the bliss of the Gardens, just as the Book expressed by it all deeds, for He said: {«إن كتاب الأبرار لفي عليين»} \"Verily the book of the righteous is in 'Illiyyūn,\" {ثم قال} then He said: {«يشهده المقربون»} \"The Near Ones bear witness to it.\" So it was a sign of the loftiness of their book that it ascended to where the Near Ones bear witness to it. And just as the righteous find increase in their state and their knowledge by their proximity to the Near Ones and their beholding of them, so likewise is their state in the Hereafter — {«ما خلقكم ولا بعثكم إلا كنفس واحدة»} \"Your creation and your resurrection are but as a single soul,\" just as He said — as we began the first creation, We shall repeat it — and as the Exalted said: {«جزاء وفاقا»} \"A recompense fully matching\" — that is, the recompense matched their deeds. So the pure was met with the unmixed of the drink, and the mingled was met with the mingled.\nAnd the admixture of every drink is in proportion to what preceded of admixture in his love and his deeds. For {«من يعمل مثقال ذرة خيرا يره * ومن يعمل مثقال ذرة شرا يره»} \"Whoever does an atom's weight of good shall see it, and whoever does an atom's weight of evil shall see it.\" And {«إن الله لا يغير ما بقوم حتى يغيروا ما بأنفسهم * إن الله لا يظلم مثقال ذرة وإن تك حسنة يضاعفها وإن كان مثقال حبة من خردل أتينا بها وكفى بنا حاسبين»} \"Verily God does not change what is in a people until they change what is in themselves. Verily God does not wrong an atom's weight; and if it be a good deed, He multiplies it, and if it be a grain of mustard-seed, We bring it — and sufficient are We as reckoners.\"\nSo whoever's love in this world was his hope for the bliss of the Garden, the wide-eyed houris, and the palaces — he is granted the Garden to settle therein wherever he wishes, to sport with the immortal youths and take pleasure with the women. There his delight in the Hereafter reaches its end, because every man is given in love only what his soul desires and his eye delights in.\nBut whoever's aim was the Lord of the Abode and the Owner of the Kingdom, and nothing overcame him save His love with sincerity and truthfulness — he is lodged in the seat...", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1179", "section_title_en": "The Marks of True Love and the Degrees of the Hereafter", "section_index": 1179, "anchors": "- Root: نشط (n-sh-ṭ)\n  * Lisan / Ayn: Core meaning of vitality, energy, and alacrity in action.\n  * Al-Raghib (Mufradat): Activity of the soul (nafs) in pursuing what it loves, unflagging in its ardor.\n  * Al-Zamakhshari (Asas): Literal: bodily vigor; Metaphorical: the heart's persistent zeal that overrides physical exhaustion.\n- Root: شرب (sh-r-b)\n  * Lisan / Ayn: Drinking; the act of imbibing liquids.\n  * Al-Raghib (Mufradat): In Quranic usage, a metaphor (majaz) for the soul's reception of spiritual bliss and states.\n  * Al-Zamakhshari (Asas): Literal: physical quenching; Metaphorical: the tasting of paradisiacal delight, graded by purity (safā') versus admixture (shawb).\n- Root: صفو (ṣ-f-w)\n  * Lisan / Ayn: Purity, clarity, and freedom from turbidity or mixture.\n  * Al-Raghib (Mufradat): The unalloyed state of sincere love (mahabbah) and its corresponding reward.\n  * Al-Zamakhshari (Asas): Literal: clear liquid; Metaphorical: the soul's exclusive devotion to God, yielding unmixed bliss.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to delimit the final reward strictly by the object and purity of one's love, as in \"إنما يعطى كل إنسان في المحبة ما تشتهيه نفسه.\"", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "26": [{"arabic": "والمنافسة في اللغة مشتقة من النفاسة والذي يدل على إباحة المنافسة قوله تعالى {وفي ذلك فليتنافس المتنافسون} وقال تعالى {سابقوا إلى مغفرة من ربكم} وإنما المسابقة عند خوف الفوت وهو كالعبدين ينسابقان إلى خدمة مولاهما إذ يجزع كل واحد أن يسبقه صاحبه فيحظى عند مولاه بمنزلة لا يحظى هو بها فكيف وقد صرح رسول الله صلى الله عليه وسلم بذلك فقال لا حسد إلا في اثنتين رجل أتاه الله مالا فسلطه على هلكته في الحق ورجل آتاه الله تعالى علما فهو يعمل به ويعلمه الناس (1) حديث أبي كبشة مثل هذه الأمة مثل أربعة رجل أتاه الله مالا الحديث رواه ابن ماجه والت", "english": "The Prophet ﷺ said: «إن المؤمن يغبط والمنافق يحسد» — \"The believer aspires emulously, and the hypocrite envies.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 720", "section_title_en": "On the Reality of Envy (Ḥasad) and Its Degrees — Section 720", "section_index": 720, "anchors": "- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Core root meaning of \"bounty, benefaction, grace\" — that state of goodness and well-being bestowed.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — bounty is the excellent state/condition; it is the genus term applying to both little and much, as in {«وإن تعدوا نعمة الله لا تحصوها»} [Ibrahim: 34].\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"جلت نعمة الله ونعماؤه\" — bounty as actual bestowed good. Metaphorical (majāz): \"خفت نعامتهم\" — departure/removal, relevant to the envier's wish for the bounty's removal.\n- Root: حسد (ḥ-s-d)\n  * Lisan / Ayn: Envy — the desire for removal of another's good.\n  * Al-Raghib (Mufradat): \"الحسد: تمني زوال نعمة من مستحق لها\" — envy is wishing the removal of bounty from one who deserves it, sometimes accompanied by striving to effect its removal. Cited: «المؤمن يغبط والمنافق يحسد».\n  * Al-Zamakhshari (Asas): Literal: \"حسده على نعمة الله\" — envying someone for God's bounty. \"إن الحسد يأكل الجسد\" — envy consumes the body.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self; also value, preciousness.\n  * Al-Raghib (Mufradat): النفس: الروح — the soul/spirit; also الذات (essence/self).\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس ومنفس\" — a precious thing. Metaphorical: \"دفق نفسه أي دمه\" — poured out his self, i.e., his blood. From this root derives المنافسة (emulative competition) — the striving for precious things.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The definition of ḥasad is given as a restricted predication (ḥadd), delimiting its essential meaning: \"كراهة النعمة وحب زوالها عن المنعم عليه\" — the hatred of bounty and love of its removal from the one upon whom it is bestowed. This is a formal definition (ḥadd), not merely a lexical gloss.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}], "29": [{"arabic": "يكونوا ضحكة للجاهلين وإليه الإشارة بقوله تعالى إن الذين أجرموا كانوا من الذين آمنوا يضحكون وإذا مروا بهم يتغامزون وإذا انقلبوا إلى أهلهم انقلبوا فكهين وإذ رأوهم قالوا إن هؤلاء لضالون وما أرسلوا عليهم حافظين ثم بين أن ضحك العارفين عليهم غدا أعظم إذ قال تعالى {فاليوم الذين آمنوا من الكفار يضحكون على الأرائك ينظرون} وكذلك أمة نوح عليه السلام كانوا يضحكون عليه عند اشتغاله بعمل السفينة قال {إن تسخروا منا فإنا نسخر منكم كما تسخرون} فهذا أحد النظرين النظر الثاني نظر من لم يبلغ إلى مقام الفناء عن نفسه وهؤلاء قسمان قسم لم يثبتوا إلا وجود أنفسهم وأنكروا أن يكون لهم رب يعبد وهؤلاء هم العميان المنكوسون وع", "english": "From this station did Ḥabīb ibn Abī Ḥabīb look when he recited {«إِنَّا وَجَدْنَاهُ صَابِرًا نِعْمَ الْعَبْدُ إِنَّهُ أَوَّابٌ»} [We found him patient — an excellent servant, indeed he was oft-returning] and then exclaimed: \"How astonishing! He gave and He praised!\" — signaling that when He praises His own giving, He praises Himself; so He is the Praiser and He is the Praised. And from this station did the Shaykh Abū Saʿīd al-Muhayyanī look when {«يُحِبُّهُمْ وَيُحِبُّونَهُ»} [He loves them and they love Him] was recited before him, and he said: \"By my life, He loves them — leave Him to love them! By His right, He loves them — for He only loves Himself.\" He signaled thereby that He is the Loving and He is the Beloved.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 978", "section_title_en": "The Two Visions: The Eye of Pure Unity and the Eye of Those Veiled from Self-Annihilation", "section_index": 978, "anchors": "- Root: نظر (naẓar)\n  * Lisan / Ayn: Core meaning of \"sight, gazing, contemplation\" — both physical vision and intellectual perception.\n  * Al-Raghib (Mufradat): Theological nuance: naẓar as \"deliberative reflection\" (ta'ammul) leading to knowledge of the divine — the inward eye of the heart.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) = ocular sight; Metaphorical (majāz) = intellectual insight and spiritual vision.\n- Root: فنو (fanā')\n  * Lisan / Ayn: Root meaning of \"passing away, perishing, ceasing to be.\"\n  * Al-Raghib (Mufradat): Theological nuance: fanā' as the annihilation of the self's independent consideration — not physical extinction but the obliteration of the illusion of otherness beside God.\n  * Al-Zamakhshari (Asas): Literal = perishing of a thing; Metaphorical = the mystic's passing away from self-awareness into pure divine contemplation.\n- Root: قوم (qawm)\n  * Lisan / Ayn: Core meaning of \"standing, rising, being established.\"\n  * Al-Raghib (Mufradat): al-Qayyūm (القيوم) — the Self-Subsisting One by whom all else stands; theologically distinct from al-Qā'im (the standing one).\n  * Al-Zamakhshari (Asas): Literal = physical standing; Metaphorical = self-subsistence and sustaining others.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (باب الحصر والتقييد) — governing the exclusive predication in \"He is the Thankful and the Thanked\" (هو الشاكر وهو المشكور), where the definite predicate restricts the attribution solely to God.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "32": [{"arabic": "فكهين وإذ رأوهم قالوا إن هؤلاء لضالون وما أرسلوا عليهم حافظين ثم بين أن ضحك العارفين عليهم غدا أعظم إذ قال تعالى {فاليوم الذين آمنوا من الكفار يضحكون على الأرائك ينظرون} وكذلك أمة نوح عليه السلام كانوا يضحكون عليه عند اشتغاله بعمل السفينة قال {إن تسخروا منا فإنا نسخر منكم كما تسخرون} فهذا أحد النظرين النظر الثاني نظر من لم يبلغ إلى مقام الفناء عن نفسه وهؤلاء قسمان قسم لم يثبتوا إلا وجود أنفسهم وأنكروا أن يكون لهم رب يعبد وهؤلاء هم العميان المنكوسون وعماهم في كلتا العينين لأنهم نفوا ما هو الثابت تحقيقا وهو القي", "english": "From this station did Ḥabīb ibn Abī Ḥabīb look when he recited {«إِنَّا وَجَدْنَاهُ صَابِرًا نِعْمَ الْعَبْدُ إِنَّهُ أَوَّابٌ»} [We found him patient — an excellent servant, indeed he was oft-returning] and then exclaimed: \"How astonishing! He gave and He praised!\" — signaling that when He praises His own giving, He praises Himself; so He is the Praiser and He is the Praised. And from this station did the Shaykh Abū Saʿīd al-Muhayyanī look when {«يُحِبُّهُمْ وَيُحِبُّونَهُ»} [He loves them and they love Him] was recited before him, and he said: \"By my life, He loves them — leave Him to love them! By His right, He loves them — for He only loves Himself.\" He signaled thereby that He is the Loving and He is the Beloved.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 978", "section_title_en": "The Two Visions: The Eye of Pure Unity and the Eye of Those Veiled from Self-Annihilation", "section_index": 978, "anchors": "- Root: نظر (naẓar)\n  * Lisan / Ayn: Core meaning of \"sight, gazing, contemplation\" — both physical vision and intellectual perception.\n  * Al-Raghib (Mufradat): Theological nuance: naẓar as \"deliberative reflection\" (ta'ammul) leading to knowledge of the divine — the inward eye of the heart.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) = ocular sight; Metaphorical (majāz) = intellectual insight and spiritual vision.\n- Root: فنو (fanā')\n  * Lisan / Ayn: Root meaning of \"passing away, perishing, ceasing to be.\"\n  * Al-Raghib (Mufradat): Theological nuance: fanā' as the annihilation of the self's independent consideration — not physical extinction but the obliteration of the illusion of otherness beside God.\n  * Al-Zamakhshari (Asas): Literal = perishing of a thing; Metaphorical = the mystic's passing away from self-awareness into pure divine contemplation.\n- Root: قوم (qawm)\n  * Lisan / Ayn: Core meaning of \"standing, rising, being established.\"\n  * Al-Raghib (Mufradat): al-Qayyūm (القيوم) — the Self-Subsisting One by whom all else stands; theologically distinct from al-Qā'im (the standing one).\n  * Al-Zamakhshari (Asas): Literal = physical standing; Metaphorical = self-subsistence and sustaining others.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (باب الحصر والتقييد) — governing the exclusive predication in \"He is the Thankful and the Thanked\" (هو الشاكر وهو المشكور), where the definite predicate restricts the attribution solely to God.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "34": [{"arabic": "ضحك العارفين عليهم غدا أعظم إذ قال تعالى {فاليوم الذين آمنوا من الكفار يضحكون على الأرائك ينظرون} وكذلك أمة نوح عليه السلام كانوا يضحكون عليه عند اشتغاله بعمل السفينة قال {إن تسخروا منا فإنا نسخر منكم كما تسخرون} فهذا أحد النظرين النظر الثاني نظر من لم يبلغ إلى مقام الفناء عن نفسه وهؤلاء قسمان قسم لم يثبتوا إلا وجود أنفسهم وأنكروا أن يكون لهم رب يعبد وهؤلاء هم العميان المنكوسون وعماهم في كلتا العينين لأنهم نفوا ما هو الثابت تحقيقا وهو القيوم الذي هو قائم بنفسه وقائم على كل نفس بما كسبت وكل قائم فقائم به ولم يقتصروا على هذا حتى أثبتوا أنفسه", "english": "From this station did Ḥabīb ibn Abī Ḥabīb look when he recited {«إِنَّا وَجَدْنَاهُ صَابِرًا نِعْمَ الْعَبْدُ إِنَّهُ أَوَّابٌ»} [We found him patient — an excellent servant, indeed he was oft-returning] and then exclaimed: \"How astonishing! He gave and He praised!\" — signaling that when He praises His own giving, He praises Himself; so He is the Praiser and He is the Praised. And from this station did the Shaykh Abū Saʿīd al-Muhayyanī look when {«يُحِبُّهُمْ وَيُحِبُّونَهُ»} [He loves them and they love Him] was recited before him, and he said: \"By my life, He loves them — leave Him to love them! By His right, He loves them — for He only loves Himself.\" He signaled thereby that He is the Loving and He is the Beloved.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 978", "section_title_en": "The Two Visions: The Eye of Pure Unity and the Eye of Those Veiled from Self-Annihilation", "section_index": 978, "anchors": "- Root: نظر (naẓar)\n  * Lisan / Ayn: Core meaning of \"sight, gazing, contemplation\" — both physical vision and intellectual perception.\n  * Al-Raghib (Mufradat): Theological nuance: naẓar as \"deliberative reflection\" (ta'ammul) leading to knowledge of the divine — the inward eye of the heart.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) = ocular sight; Metaphorical (majāz) = intellectual insight and spiritual vision.\n- Root: فنو (fanā')\n  * Lisan / Ayn: Root meaning of \"passing away, perishing, ceasing to be.\"\n  * Al-Raghib (Mufradat): Theological nuance: fanā' as the annihilation of the self's independent consideration — not physical extinction but the obliteration of the illusion of otherness beside God.\n  * Al-Zamakhshari (Asas): Literal = perishing of a thing; Metaphorical = the mystic's passing away from self-awareness into pure divine contemplation.\n- Root: قوم (qawm)\n  * Lisan / Ayn: Core meaning of \"standing, rising, being established.\"\n  * Al-Raghib (Mufradat): al-Qayyūm (القيوم) — the Self-Subsisting One by whom all else stands; theologically distinct from al-Qā'im (the standing one).\n  * Al-Zamakhshari (Asas): Literal = physical standing; Metaphorical = self-subsistence and sustaining others.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (باب الحصر والتقييد) — governing the exclusive predication in \"He is the Thankful and the Thanked\" (هو الشاكر وهو المشكور), where the definite predicate restricts the attribution solely to God.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}]}, "wordTiming": {"minshawi": {"1": [[1, 670, 1713], [2, 1713, 4040]], "83:1": [[1, 670, 1713], [2, 1713, 4040]], "2": [[1, 520, 1567], [2, 1567, 2360], [3, 2360, 4128], [4, 4128, 4739], [5, 4739, 5905], [6, 5905, 7570]], "83:2": [[1, 520, 1567], [2, 1567, 2360], [3, 2360, 4128], [4, 4128, 4739], [5, 4739, 5905], [6, 5905, 7570]], "3": [[1, 920, 2028], [2, 2028, 3375], [3, 3375, 3914], [4, 3914, 5486], [5, 5486, 6840]], "83:3": [[1, 920, 2028], [2, 2028, 3375], [3, 3375, 3914], [4, 3914, 5486], [5, 5486, 6840]], "4": [[1, 820, 2008], [2, 2008, 3427], [3, 3427, 5949], [4, 5949, 7234], [5, 7234, 10060]], "83:4": [[1, 820, 2008], [2, 2008, 3427], [3, 3427, 5949], [4, 5949, 7234], [5, 7234, 10060]], "5": [[1, 430, 1736], [2, 1736, 3020]], "83:5": [[1, 430, 1736], [2, 1736, 3020]], "6": [[1, 500, 1526], [2, 1526, 2963], [3, 2963, 4472], [4, 4472, 5242], [5, 5242, 7090]], "83:6": [[1, 500, 1526], [2, 1526, 2963], [3, 2963, 4472], [4, 4472, 5242], [5, 5242, 7090]], "7": [[1, 410, 3060], [2, 3060, 3890], [3, 3890, 4818], [4, 4818, 6723], [5, 6723, 7602], [6, 7602, 9130]], "83:7": [[1, 410, 3060], [2, 3060, 3890], [3, 3890, 4818], [4, 4818, 6723], [5, 6723, 7602], [6, 7602, 9130]], "8": [[1, 410, 2664], [2, 2664, 4110], [3, 4110, 4835], [4, 4835, 6060]], "83:8": [[1, 410, 2664], [2, 2664, 4110], [3, 4110, 4835], [4, 4835, 6060]], "9": [[1, 520, 1575], [2, 1575, 3740]], "83:9": [[1, 520, 1575], [2, 1575, 3740]], "10": [[1, 270, 1527], [2, 1527, 3387], [3, 3387, 6170]], "83:10": [[1, 270, 1527], [2, 1527, 3387], [3, 3387, 6170]], "11": [[1, 570, 1912], [2, 1912, 3889],