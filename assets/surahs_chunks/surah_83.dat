ration": "warsh"}, {"surah": 83, "ayah": 16, "text": "ثُمَّ إِنَّهُمْ لَصَالُواْ اُ۬لْجَحِيمِۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَصَالُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْجَحِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 17, "text": "ثُمَّ يُقَالُ هَٰذَا اَ۬لذِے كُنتُم بِهِۦ تُكَذِّبُونَۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "يُقَالُ", "translit": "", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 5, "arabic": "كُنتُم", "translit": "", "root": ""}, {"id": 6, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 7, "arabic": "تُكَذِّبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 18, "text": "كَلَّآ إِنَّ كِتَٰبَ اَ۬لَابْر۪ارِ لَفِے عِلِّيِّينَۖ", "words": [{"id": 1, "arabic": "كَلَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "كِتَٰبَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لَابْر۪ارِ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَفِے", "translit": "", "root": ""}, {"id": 6, "arabic": "عِلِّيِّينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 19, "text": "وَمَآ أَدْر۪يٰكَ مَا عِلِّيُّونَ", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَدْر۪يٰكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "عِلِّيُّونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 20, "text": "كِتَٰبࣱ مَّرْقُومࣱ‏", "words": [{"id": 1, "arabic": "كِتَٰبࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَّرْقُومࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83