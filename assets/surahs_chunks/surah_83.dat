"", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 2, "text": "اَ۬لذِينَ إِذَا اَ۪كْتَالُواْ عَلَي اَ۬لنَّاسِ يَسْتَوْفُونَ", "words": [{"id": 1, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۪كْتَالُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لنَّاسِ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَسْتَوْفُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 3, "text": "وَإِذَا كَالُوهُمُۥٓ أَو وَّزَنُوهُمْ يُخْسِرُونَۖ", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "كَالُوهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَو", "translit": "", "root": ""}, {"id": 4, "arabic": "وَّزَنُوهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يُخْسِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 4, "text": "أَلَا يَظُنُّ أُوْلَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ", "words": [{"id": 1, "arabic": "أَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَظُنُّ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنَّهُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مَّبْعُوثُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 5, "text": "لِيَوْمٍ عَظِيمࣲ‏", "words": [{"id": 1, "arabic": "لِيَوْمٍ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَظِيمࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 83, "ayah": 6, "text": "يَوْمَ يَقُومُ اُ۬لنَّاسُ لِرَبِّ اِ۬لْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَقُومُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لنَّاسُ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِرَبِّ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْعَٰل