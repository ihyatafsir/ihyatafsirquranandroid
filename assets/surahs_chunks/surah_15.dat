{"surah":15,"verses":[{"ayah":1,"text":"الٓرۚ تِلْكَ ءَايَٰتُ ٱلْكِتَٰبِ وَقُرْءَانٍ مُّبِينٍ ","translation":"Alif, Lām, Rā.[1] These are the verses of the Book and a clear Qur’ān [i.e., recitation].","words":[{"id":1,"arabic":"الٓر","translit":"rٓlā","root":""},{"id":2,"arabic":"تِلْكَ","translit":"َkْlِt","root":""},{"id":3,"arabic":"ءَايَٰتُ","translit":"ُtَٰyāَء","root":"ايي"},{"id":4,"arabic":"ٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱ","root":"كتب"},{"id":5,"arabic":"وَقُرْءَانٍ","translit":"ٍnāَءْrُqَw","root":"قرا"},{"id":6,"arabic":"مُّبِينٍ","translit":"ٍnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":2,"text":"رُّبَمَا يَوَدُّ ٱلَّذِينَ كَفَرُوا۟ لَوْ كَانُوا۟ مُسْلِمِينَ ","translation":"Perhaps those who disbelieve will wish[1] that they had been Muslims.","words":[{"id":1,"arabic":"رُّبَمَا","translit":"āَmَbُّr","root":""},{"id":2,"arabic":"يَوَدُّ","translit":"ُّdَwَy","root":"ودد"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":5,"arabic":"لَوْ","translit":"ْwَl","root":""},{"id":6,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":7,"arabic":"مُسْلِمِينَ","translit":"َnyِmِlْsُm","root":"سلم"}],"hasIhya":true},{"ayah":3,"text":"ذَرْهُمْ يَأْكُلُوا۟ وَيَتَمَتَّعُوا۟ وَيُلْهِهِمُ ٱلْأَمَلُۖ فَسَوْفَ يَعْلَمُونَ ","translation":"Let them eat and enjoy themselves and be diverted by [false] hope, for they are going to know.","words":[{"id":1,"arabic":"ذَرْهُمْ","translit":"ْmُhْrَhd","root":"وذر"},{"id":2,"arabic":"يَأْكُلُوا۟","translit":"۟āwُlُkْaʾَy","root":"اكل"},{"id":3,"arabic":"وَيَتَمَتَّعُوا۟","translit":"۟āwُʿعَّtَmَtَyَw","root":"متع"},{"id":4,"arabic":"وَيُلْهِهِمُ","translit":"ُmِhِhْlُyَw","root":"لهو"},{"id":5,"arabic":"ٱلْأَمَلُ","translit":"ُlَmَaʾْlٱ","root":"امل"},{"id":6,"arabic":"فَسَوْفَ","translit":"َfْwَsَf","root":""},{"id":7,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":false},{"ayah":4,"text":"وَمَآ أَهْلَكْنَا مِن قَرْيَةٍ إِلَّا وَلَهَا كِتَابٌ مَّعْلُومٌ ","translation":"And We did not destroy any city but that for it was a known decree.","words":[{"id":1,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":2,"arabic":"أَهْلَكْنَا","translit":"āَnْkَlْhَaʾ","root":"هلك"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"قَرْيَةٍ","translit":"ٍẗَyْrَq","root":"قري"},{"id":5,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":6,"arabic":"وَلَهَا","translit":"āَhَlَw","root":""},{"id":7,"arabic":"كِتَابٌ","translit":"ٌbāَtِk","root":"كتب"},{"id":8,"arabic":"مَّعْلُومٌ","translit":"ٌmwُlْʿعَّm","root":"علم"}],"hasIhya":false},{"ayah":5,"text":"مَّا تَسْبِقُ مِنْ أُمَّةٍ أَجَلَهَا وَمَا يَسْتَـْٔخِرُونَ ","translation":"No nation will precede its term, nor will they remain thereafter.","words":[{"id":1,"arabic":"مَّا","translit":"āَّm","root":""},{"id":2,"arabic":"تَسْبِقُ","translit":"ُqِbْsَt","root":"سبق"},{"id":3,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":4,"arabic":"أُمَّةٍ","translit":"ٍẗَّmُaʾ","root":"امم"},{"id":5,"arabic":"أَجَلَهَا","translit":"āَhَlَjgَaʾ","root":"اجل"},{"id":6,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":7,"arabic":"يَسْتَـْٔخِرُونَ","translit":"َnwُrِhkْٔـَtْsَy","root":"اخر"}],"hasIhya":true},{"ayah":6,"text":"وَقَالُوا۟ يَٰٓأَيُّهَا ٱلَّذِى نُزِّلَ عَلَيْهِ ٱلذِّكْرُ إِنَّكَ لَمَجْنُونٌ ","translation":"And they say, \"O you upon whom the message has been sent down, indeed you are mad.[1]","words":[{"id":1,"arabic":"وَقَالُوا۟","translit":"۟āwُlāَqَw","root":"قول"},{"id":2,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":3,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":4,"arabic":"نُزِّلَ","translit":"َlِّzُn","root":"نزل"},{"id":5,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":6,"arabic":"ٱلذِّكْرُ","translit":"ُrْkِّhdlٱ","root":"ذكر"},{"id":7,"arabic":"إِنَّكَ","translit":"َkَّnِiʾ","root":""},{"id":8,"arabic":"لَمَجْنُونٌ","translit":"ٌnwُnْjgَmَl","root":"جنن"}],"hasIhya":false},{"ayah":7,"text":"لَّوْ مَا تَأْتِينَا بِٱلْمَلَٰٓئِكَةِ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ ","translation":"Why do you not bring us the angels, if you should be among the truthful?\"","words":[{"id":1,"arabic":"لَّوْ","translit":"ْwَّl","root":""},{"id":2,"arabic":"مَا","translit":"āَm","root":""},{"id":3,"arabic":"تَأْتِينَا","translit":"āَnyِtْaʾَt","root":"اتي"},{"id":4,"arabic":"بِٱلْمَلَٰٓئِكَةِ","translit":"ِẗَkِyʾَٰٓlَmْlٱِb","root":"ملك"},{"id":5,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":6,"arabic":"كُنتَ","translit":"َtnُk","root":"كون"},{"id":7,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":8,"arabic":"ٱلصَّٰدِقِينَ","translit":"َnyِqِdَّٰṣlٱ","root":"صدق"}],"hasIhya":false},{"ayah":8,"text":"مَا نُنَزِّلُ ٱلْمَلَٰٓئِكَةَ إِلَّا بِٱلْحَقِّ وَمَا كَانُوٓا۟ إِذًا مُّنظَرِينَ ","translation":"We do not send down the angels except with truth;[1] and they [i.e., the disbelievers] would not then be reprieved.","words":[{"id":1,"arabic":"مَا","translit":"āَm","root":""},{"id":2,"arabic":"نُنَزِّلُ","translit":"ُlِّzَnُn","root":"نزل"},{"id":3,"arabic":"ٱلْمَلَٰٓئِكَةَ","translit":"َẗَkِyʾَٰٓlَmْlٱ","root":"ملك"},{"id":4,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":5,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":6,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":7,"arabic":"كَانُوٓا۟","translit":"۟āٓwُnāَk","root":"كون"},{"id":8,"arabic":"إِذًا","translit":"āًhdِiʾ","root":""},{"id":9,"arabic":"مُّنظَرِينَ","translit":"َnyِrَẓnُّm","root":"نظر"}],"hasIhya":false},{"ayah":9,"text":"إِنَّا نَحْنُ نَزَّلْنَا ٱلذِّكْرَ وَإِنَّا لَهُۥ لَحَٰفِظُونَ ","translation":"Indeed, it is We who sent down the message [i.e., the Qur’ān], and indeed, We will be its guardian.","words":[{"id":1,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":2,"arabic":"نَحْنُ","translit":"ُnْḥَn","root":""},{"id":3,"arabic":"نَزَّلْنَا","translit":"āَnْlَّzَn","root":"نزل"},{"id":4,"arabic":"ٱلذِّكْرَ","translit":"َrْkِّhdlٱ","root":"ذكر"},{"id":5,"arabic":"وَإِنَّا","translit":"āَّnِiʾَw","root":""},{"id":6,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":7,"arabic":"لَحَٰفِظُونَ","translit":"َnwُẓِfَٰḥَl","root":"حفظ"}],"hasIhya":true},{"ayah":10,"text":"وَلَقَدْ أَرْسَلْنَا مِن قَبْلِكَ فِى شِيَعِ ٱلْأَوَّلِينَ ","translation":"And We had certainly sent [messengers] before you, [O Muḥammad], among the sects of the former peoples.","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"أَرْسَلْنَا","translit":"āَnْlَsْrَaʾ","root":"رسل"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"قَبْلِكَ","translit":"َkِlْbَq","root":"قبل"},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"شِيَعِ","translit":"ِʿعَyِhs","root":"شيع"},{"id":7,"arabic":"ٱلْأَوَّلِينَ","translit":"َnyِlَّwَaʾْlٱ","root":"اول"}],"hasIhya":false},{"ayah":11,"text":"وَمَا يَأْتِيهِم مِّن رَّسُولٍ إِلَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ ","translation":"And no messenger would come to them except that they ridiculed him.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"يَأْتِيهِم","translit":"mِhyِtْaʾَy","root":"اتي"},{"id":3,"arabic":"مِّن","translit":"nِّm","root":""},{"id":4,"arabic":"رَّسُولٍ","translit":"ٍlwُsَّr","root":"رسل"},{"id":5,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":6,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":7,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":8,"arabic":"يَسْتَهْزِءُونَ","translit":"َnwُءِzْhَtْsَy","root":"هزا"}],"hasIhya":false},{"ayah":12,"text":"كَذَٰلِكَ نَسْلُكُهُۥ فِى قُلُوبِ ٱلْمُجْرِمِينَ ","translation":"Thus do We insert it [i.e., denial] into the hearts of the criminals.","words":[{"id":1,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":2,"arabic":"نَسْلُكُهُۥ","translit":"ۥُhُkُlْsَn","root":"سلك"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"قُلُوبِ","translit":"ِbwُlُq","root":"قلب"},{"id":5,"arabic":"ٱلْمُجْرِمِينَ","translit":"َnyِmِrْjgُmْlٱ","root":"جرم"}],"hasIhya":false},{"ayah":13,"text":"لَا يُؤْمِنُونَ بِهِۦۖ وَقَدْ خَلَتْ سُنَّةُ ٱلْأَوَّلِينَ ","translation":"They will not believe in it, while there has already occurred the precedent of the former peoples.","words":[{"id":1,"arabic":"لَا","translit":"āَl","root":""},{"id":2,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"},{"id":3,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":4,"arabic":"وَقَدْ","translit":"ْdَqَw","root":""},{"id":5,"arabic":"خَلَتْ","translit":"ْtَlَhk","root":"خلو"},{"id":6,"arabic":"سُنَّةُ","translit":"ُẗَّnُs","root":"سنن"},{"id":7,"arabic":"ٱلْأَوَّلِينَ","translit":"َnyِlَّwَaʾْlٱ","root":"اول"}],"hasIhya":false},{"ayah":14,"text":"وَلَوْ فَتَحْنَا عَلَيْهِم بَابًا مِّنَ ٱلسَّمَآءِ فَظَلُّوا۟ فِيهِ يَعْرُجُونَ ","translation":"And [even] if We opened to them a gate from the heaven and they continued therein to ascend,","words":[{"id":1,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":2,"arabic":"فَتَحْنَا","translit":"āَnْḥَtَf","root":"فتح"},{"id":3,"arabic":"عَلَيْهِم","translit":"mِhْyَlَʿع","root":""},{"id":4,"arabic":"بَابًا","translit":"āًbāَb","root":"بوب"},{"id":5,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":6,"arabic":"ٱلسَّمَآءِ","translit":"ِءٓāَmَّslٱ","root":"سمو"},{"id":7,"arabic":"فَظَلُّوا۟","translit":"۟āwُّlَẓَf","root":"ظلل"},{"id":8,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":9,"arabic":"يَعْرُجُونَ","translit":"َnwُjgُrْʿعَy","root":"عرج"}],"hasIhya":false},{"ayah":15,"text":"لَقَالُوٓا۟ إِنَّمَا سُكِّرَتْ أَبْصَٰرُنَا بَلْ نَحْنُ قَوْمٌ مَّسْحُورُونَ ","translation":"They would say, \"Our eyes have only been dazzled. Rather, we are a people affected by magic.\"","words":[{"id":1,"arabic":"لَقَالُوٓا۟","translit":"۟āٓwُlāَqَl","root":"قول"},{"id":2,"arabic":"إِنَّمَا","translit":"āَmَّnِiʾ","root":""},{"id":3,"arabic":"سُكِّرَتْ","translit":"ْtَrِّkُs","root":"سكر"},{"id":4,"arabic":"أَبْصَٰرُنَا","translit":"āَnُrَٰṣْbَaʾ","root":"بصر"},{"id":5,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":6,"arabic":"نَحْنُ","translit":"ُnْḥَn","root":""},{"id":7,"arabic":"قَوْمٌ","translit":"ٌmْwَq","root":"قوم"},{"id":8,"arabic":"مَّسْحُورُونَ","translit":"َnwُrwُḥْsَّm","root":"سحر"}],"hasIhya":false},{"ayah":16,"text":"وَلَقَدْ جَعَلْنَا فِى ٱلسَّمَآءِ بُرُوجًا وَزَيَّنَّٰهَا لِلنَّٰظِرِينَ ","translation":"And We have placed within the heaven great stars and have beautified it for the observers.","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"جَعَلْنَا","translit":"āَnْlَʿعَjg","root":"جعل"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلسَّمَآءِ","translit":"ِءٓāَmَّslٱ","root":"سمو"},{"id":5,"arabic":"بُرُوجًا","translit":"āًjgwُrُb","root":"برج"},{"id":6,"arabic":"وَزَيَّنَّٰهَا","translit":"āَhَّٰnَّyَzَw","root":"زين"},{"id":7,"arabic":"لِلنَّٰظِرِينَ","translit":"َnyِrِẓَّٰnlِl","root":"نظر"}],"hasIhya":false},{"ayah":17,"text":"وَحَفِظْنَٰهَا مِن كُلِّ شَيْطَٰنٍ رَّجِيمٍ ","translation":"And We have protected it from every devil expelled [from the mercy of Allāh]","words":[{"id":1,"arabic":"وَحَفِظْنَٰهَا","translit":"āَhَٰnْẓِfَḥَw","root":"حفظ"},{"id":2,"arabic":"مِن","translit":"nِm","root":""},{"id":3,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":4,"arabic":"شَيْطَٰنٍ","translit":"ٍnَٰṭْyَhs","root":"شطن"},{"id":5,"arabic":"رَّجِيمٍ","translit":"ٍmyِjgَّr","root":"رجم"}],"hasIhya":false},{"ayah":18,"text":"إِلَّا مَنِ ٱسْتَرَقَ ٱلسَّمْعَ فَأَتْبَعَهُۥ شِهَابٌ مُّبِينٌ ","translation":"Except one who steals a hearing and is pursued by a clear burning flame.","words":[{"id":1,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":2,"arabic":"مَنِ","translit":"ِnَm","root":""},{"id":3,"arabic":"ٱسْتَرَقَ","translit":"َqَrَtْsٱ","root":"سرق"},{"id":4,"arabic":"ٱلسَّمْعَ","translit":"َʿعْmَّslٱ","root":"سمع"},{"id":5,"arabic":"فَأَتْبَعَهُۥ","translit":"ۥُhَʿعَbْtَaʾَf","root":"تبع"},{"id":6,"arabic":"شِهَابٌ","translit":"ٌbāَhِhs","root":"شهب"},{"id":7,"arabic":"مُّبِينٌ","translit":"ٌnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":19,"text":"وَٱلْأَرْضَ مَدَدْنَٰهَا وَأَلْقَيْنَا فِيهَا رَوَٰسِىَ وَأَنۢبَتْنَا فِيهَا مِن كُلِّ شَىْءٍ مَّوْزُونٍ ","translation":"And the earth - We have spread it and cast therein firmly set mountains and caused to grow therein [something] of every well-balanced thing.","words":[{"id":1,"arabic":"وَٱلْأَرْضَ","translit":"َḍْrَaʾْlٱَw","root":"ارض"},{"id":2,"arabic":"مَدَدْنَٰهَا","translit":"āَhَٰnْdَdَm","root":"مدد"},{"id":3,"arabic":"وَأَلْقَيْنَا","translit":"āَnْyَqْlَaʾَw","root":"لقي"},{"id":4,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":5,"arabic":"رَوَٰسِىَ","translit":"َàِsَٰwَr","root":"رسو"},{"id":6,"arabic":"وَأَنۢبَتْنَا","translit":"āَnْtَbۢnَaʾَw","root":"نبت"},{"id":7,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":8,"arabic":"مِن","translit":"nِm","root":""},{"id":9,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":10,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":11,"arabic":"مَّوْزُونٍ","translit":"ٍnwُzْwَّm","root":"وزن"}],"hasIhya":false},{"ayah":20,"text":"وَجَعَلْنَا لَكُمْ فِيهَا مَعَٰيِشَ وَمَن لَّسْتُمْ لَهُۥ بِرَٰزِقِينَ ","translation":"And We have made for you therein means of living and [for] those for whom you are not providers.[1]","words":[{"id":1,"arabic":"وَجَعَلْنَا","translit":"āَnْlَʿعَjgَw","root":"جعل"},{"id":2,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":3,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":4,"arabic":"مَعَٰيِشَ","translit":"َhsِyَٰʿعَm","root":"عيش"},{"id":5,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":6,"arabic":"لَّسْتُمْ","translit":"ْmُtْsَّl","root":"ليس"},{"id":7,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":8,"arabic":"بِرَٰزِقِينَ","translit":"َnyِqِzَٰrِb","root":"رزق"}],"hasIhya":false},{"ayah":21,"text":"وَإِن مِّن شَىْءٍ إِلَّا عِندَنَا خَزَآئِنُهُۥ وَمَا نُنَزِّلُهُۥٓ إِلَّا بِقَدَرٍ مَّعْلُومٍ ","translation":"And there is not a thing but that with Us are its depositories, and We do not send it down except according to a known [i.e., specified] measure.","words":[{"id":1,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":2,"arabic":"مِّن","translit":"nِّm","root":""},{"id":3,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":4,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":5,"arabic":"عِندَنَا","translit":"āَnَdnِʿع","root":"عند"},{"id":6,"arabic":"خَزَآئِنُهُۥ","translit":"ۥُhُnِyʾٓāَzَhk","root":"خزن"},{"id":7,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":8,"arabic":"نُنَزِّلُهُۥٓ","translit":"ٓۥُhُlِّzَnُn","root":"نزل"},{"id":9,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":10,"arabic":"بِقَدَرٍ","translit":"ٍrَdَqِb","root":"قدر"},{"id":11,"arabic":"مَّعْلُومٍ","translit":"ٍmwُlْʿعَّm","root":"علم"}],"hasIhya":false},{"ayah":22,"text":"وَأَرْسَلْنَا ٱلرِّيَٰحَ لَوَٰقِحَ فَأَنزَلْنَا مِنَ ٱلسَّمَآءِ مَآءً فَأَسْقَيْنَٰكُمُوهُ وَمَآ أَنتُمْ لَهُۥ بِخَٰزِنِينَ ","translation":"And We have sent the fertilizing winds[1] and sent down water from the sky and given you drink from it. And you are not its retainers.","words":[{"id":1,"arabic":"وَأَرْسَلْنَا","translit":"āَnْlَsْrَaʾَw","root":"رسل"},{"id":2,"arabic":"ٱلرِّيَٰحَ","translit":"َḥَٰyِّrlٱ","root":"روح"},{"id":3,"arabic":"لَوَٰقِحَ","translit":"َḥِqَٰwَl","root":"لقح"},{"id":4,"arabic":"فَأَنزَلْنَا","translit":"āَnْlَznَaʾَf","root":"نزل"},{"id":5,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":6,"arabic":"ٱلسَّمَآءِ","translit":"ِءٓāَmَّslٱ","root":"سمو"},{"id":7,"arabic":"مَآءً","translit":"ًءٓāَm","root":"موه"},{"id":8,"arabic":"فَأَسْقَيْنَٰكُمُوهُ","translit":"ُhwُmُkَٰnْyَqْsَaʾَf","root":"سقي"},{"id":9,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":10,"arabic":"أَنتُمْ","translit":"ْmُtnَaʾ","root":""},{"id":11,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":12,"arabic":"بِخَٰزِنِينَ","translit":"َnyِnِzَٰhkِb","root":"خزن"}],"hasIhya":false},{"ayah":23,"text":"وَإِنَّا لَنَحْنُ نُحْىِۦ وَنُمِيتُ وَنَحْنُ ٱلْوَٰرِثُونَ ","translation":"And indeed, it is We who give life and cause death, and We are the Inheritor.[1]","words":[{"id":1,"arabic":"وَإِنَّا","translit":"āَّnِiʾَw","root":""},{"id":2,"arabic":"لَنَحْنُ","translit":"ُnْḥَnَl","root":""},{"id":3,"arabic":"نُحْىِۦ","translit":"ۦِàْḥُn","root":"حيي"},{"id":4,"arabic":"وَنُمِيتُ","translit":"ُtyِmُnَw","root":"موت"},{"id":5,"arabic":"وَنَحْنُ","translit":"ُnْḥَnَw","root":""},{"id":6,"arabic":"ٱلْوَٰرِثُونَ","translit":"َnwُhtِrَٰwْlٱ","root":"ورث"}],"hasIhya":false},{"ayah":24,"text":"وَلَقَدْ عَلِمْنَا ٱلْمُسْتَقْدِمِينَ مِنكُمْ وَلَقَدْ عَلِمْنَا ٱلْمُسْتَـْٔخِرِينَ ","translation":"And We have already known the preceding [generations] among you, and We have already known the later [ones to come].","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"عَلِمْنَا","translit":"āَnْmِlَʿع","root":"علم"},{"id":3,"arabic":"ٱلْمُسْتَقْدِمِينَ","translit":"َnyِmِdْqَtْsُmْlٱ","root":"قدم"},{"id":4,"arabic":"مِنكُمْ","translit":"ْmُknِm","root":""},{"id":5,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":6,"arabic":"عَلِمْنَا","translit":"āَnْmِlَʿع","root":"علم"},{"id":7,"arabic":"ٱلْمُسْتَـْٔخِرِينَ","translit":"َnyِrِhkْٔـَtْsُmْlٱ","root":"اخر"}],"hasIhya":false},{"ayah":25,"text":"وَإِنَّ رَبَّكَ هُوَ يَحْشُرُهُمْۚ إِنَّهُۥ حَكِيمٌ عَلِيمٌ ","translation":"And indeed, your Lord will gather them; indeed, He is Wise and Knowing.","words":[{"id":1,"arabic":"وَإِنَّ","translit":"َّnِiʾَw","root":""},{"id":2,"arabic":"رَبَّكَ","translit":"َkَّbَr","root":"ربب"},{"id":3,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":4,"arabic":"يَحْشُرُهُمْ","translit":"ْmُhُrُhsْḥَy","root":"حشر"},{"id":5,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":6,"arabic":"حَكِيمٌ","translit":"ٌmyِkَḥ","root":"حكم"},{"id":7,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"}],"hasIhya":false},{"ayah":26,"text":"وَلَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ مِن صَلْصَٰلٍ مِّنْ حَمَإٍ مَّسْنُونٍ ","translation":"And We did certainly create man out of clay from an altered black mud.","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"خَلَقْنَا","translit":"āَnْqَlَhk","root":"خلق"},{"id":3,"arabic":"ٱلْإِنسَٰنَ","translit":"َnَٰsnِiʾْlٱ","root":"انس"},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"صَلْصَٰلٍ","translit":"ٍlَٰṣْlَṣ","root":"صلصل"},{"id":6,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":7,"arabic":"حَمَإٍ","translit":"ٍiʾَmَḥ","root":"حما"},{"id":8,"arabic":"مَّسْنُونٍ","translit":"ٍnwُnْsَّm","root":"سنن"}],"hasIhya":false},{"ayah":27,"text":"وَٱلْجَآنَّ خَلَقْنَٰهُ مِن قَبْلُ مِن نَّارِ ٱلسَّمُومِ ","translation":"And the jinn We created before from scorching fire.","words":[{"id":1,"arabic":"وَٱلْجَآنَّ","translit":"َّnٓāَjgْlٱَw","root":"جنن"},{"id":2,"arabic":"خَلَقْنَٰهُ","translit":"ُhَٰnْqَlَhk","root":"خلق"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":5,"arabic":"مِن","translit":"nِm","root":""},{"id":6,"arabic":"نَّارِ","translit":"ِrāَّn","root":"نور"},{"id":7,"arabic":"ٱلسَّمُومِ","translit":"ِmwُmَّslٱ","root":"سمم"}],"hasIhya":false},{"ayah":28,"text":"وَإِذْ قَالَ رَبُّكَ لِلْمَلَٰٓئِكَةِ إِنِّى خَٰلِقٌۢ بَشَرًا مِّن صَلْصَٰلٍ مِّنْ حَمَإٍ مَّسْنُونٍ ","translation":"And [mention, O Muḥammad], when your Lord said to the angels, \"I will create a human being out of clay from an altered black mud.","words":[{"id":1,"arabic":"وَإِذْ","translit":"ْhdِiʾَw","root":""},{"id":2,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":3,"arabic":"رَبُّكَ","translit":"َkُّbَr","root":"ربب"},{"id":4,"arabic":"لِلْمَلَٰٓئِكَةِ","translit":"ِẗَkِyʾَٰٓlَmْlِl","root":"ملك"},{"id":5,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":6,"arabic":"خَٰلِقٌۢ","translit":"ٌۢqِlَٰhk","root":"خلق"},{"id":7,"arabic":"بَشَرًا","translit":"āًrَhsَb","root":"بشر"},{"id":8,"arabic":"مِّن","translit":"nِّm","root":""},{"id":9,"arabic":"صَلْصَٰلٍ","translit":"ٍlَٰṣْlَṣ","root":"صلصل"},{"id":10,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":11,"arabic":"حَمَإٍ","translit":"ٍiʾَmَḥ","root":"حما"},{"id":12,"arabic":"مَّسْنُونٍ","translit":"ٍnwُnْsَّm","root":"سنن"}],"hasIhya":false},{"ayah":29,"text":"فَإِذَا سَوَّيْتُهُۥ وَنَفَخْتُ فِيهِ مِن رُّوحِى فَقَعُوا۟ لَهُۥ سَٰجِدِينَ ","translation":"And when I have proportioned him and breathed into him of My [created] soul,[1] then fall down to him in prostration.\"","words":[{"id":1,"arabic":"فَإِذَا","translit":"āَhdِiʾَf","root":""},{"id":2,"arabic":"سَوَّيْتُهُۥ","translit":"ۥُhُtْyَّwَs","root":"سوي"},{"id":3,"arabic":"وَنَفَخْتُ","translit":"ُtْhkَfَnَw","root":"نفخ"},{"id":4,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":5,"arabic":"مِن","translit":"nِm","root":""},{"id":6,"arabic":"رُّوحِى","translit":"àِḥwُّr","root":"روح"},{"id":7,"arabic":"فَقَعُوا۟","translit":"۟āwُʿعَqَf","root":"وقع"},{"id":8,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":9,"arabic":"سَٰجِدِينَ","translit":"َnyِdِjgَٰs","root":"سجد"}],"hasIhya":true},{"ayah":30,"text":"فَسَجَدَ ٱلْمَلَٰٓئِكَةُ كُلُّهُمْ أَجْمَعُونَ ","translation":"So the angels prostrated - all of them entirely,","words":[{"id":1,"arabic":"فَسَجَدَ","translit":"َdَjgَsَf","root":"سجد"},{"id":2,"arabic":"ٱلْمَلَٰٓئِكَةُ","translit":"ُẗَkِyʾَٰٓlَmْlٱ","root":"ملك"},{"id":3,"arabic":"كُلُّهُمْ","translit":"ْmُhُّlُk","root":"كلل"},{"id":4,"arabic":"أَجْمَعُونَ","translit":"َnwُʿعَmْjgَaʾ","root":"جمع"}],"hasIhya":false},{"ayah":31,"text":"إِلَّآ إِبْلِيسَ أَبَىٰٓ أَن يَكُونَ مَعَ ٱلسَّٰجِدِينَ ","translation":"Except Iblees;[1] he refused to be with those who prostrated.","words":[{"id":1,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":2,"arabic":"إِبْلِيسَ","translit":"َsyِlْbِiʾ","root":""},{"id":3,"arabic":"أَبَىٰٓ","translit":"ٰٓàَbَaʾ","root":"ابي"},{"id":4,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":5,"arabic":"يَكُونَ","translit":"َnwُkَy","root":"كون"},{"id":6,"arabic":"مَعَ","translit":"َʿعَm","root":""},{"id":7,"arabic":"ٱلسَّٰجِدِينَ","translit":"َnyِdِjgَّٰslٱ","root":"سجد"}],"hasIhya":false},{"ayah":32,"text":"قَالَ يَٰٓإِبْلِيسُ مَا لَكَ أَلَّا تَكُونَ مَعَ ٱلسَّٰجِدِينَ ","translation":"[Allāh] said, \"O Iblees, what is [the matter] with you that you are not with those who prostrate?\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"يَٰٓإِبْلِيسُ","translit":"ُsyِlْbِiʾَٰٓy","root":""},{"id":3,"arabic":"مَا","translit":"āَm","root":""},{"id":4,"arabic":"لَكَ","translit":"َkَl","root":""},{"id":5,"arabic":"أَلَّا","translit":"āَّlَaʾ","root":""},{"id":6,"arabic":"تَكُونَ","translit":"َnwُkَt","root":"كون"},{"id":7,"arabic":"مَعَ","translit":"َʿعَm","root":""},{"id":8,"arabic":"ٱلسَّٰجِدِينَ","translit":"َnyِdِjgَّٰslٱ","root":"سجد"}],"hasIhya":false},{"ayah":33,"text":"قَالَ لَمْ أَكُن لِّأَسْجُدَ لِبَشَرٍ خَلَقْتَهُۥ مِن صَلْصَٰلٍ مِّنْ حَمَإٍ مَّسْنُونٍ ","translation":"He said, \"Never would I prostrate to a human whom You created out of clay from an altered black mud.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":3,"arabic":"أَكُن","translit":"nُkَaʾ","root":"كون"},{"id":4,"arabic":"لِّأَسْجُدَ","translit":"َdُjgْsَaʾِّl","root":"سجد"},{"id":5,"arabic":"لِبَشَرٍ","translit":"ٍrَhsَbِl","root":"بشر"},{"id":6,"arabic":"خَلَقْتَهُۥ","translit":"ۥُhَtْqَlَhk","root":"خلق"},{"id":7,"arabic":"مِن","translit":"nِm","root":""},{"id":8,"arabic":"صَلْصَٰلٍ","translit":"ٍlَٰṣْlَṣ","root":"صلصل"},{"id":9,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":10,"arabic":"حَمَإٍ","translit":"ٍiʾَmَḥ","root":"حما"},{"id":11,"arabic":"مَّسْنُونٍ","translit":"ٍnwُnْsَّm","root":"سنن"}],"hasIhya":false},{"ayah":34,"text":"قَالَ فَٱخْرُجْ مِنْهَا فَإِنَّكَ رَجِيمٌ ","translation":"[Allāh] said, \"Then depart from it,[1] for indeed, you are expelled.","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"فَٱخْرُجْ","translit":"ْjgُrْhkٱَf","root":"خرج"},{"id":3,"arabic":"مِنْهَا","translit":"āَhْnِm","root":""},{"id":4,"arabic":"فَإِنَّكَ","translit":"َkَّnِiʾَf","root":""},{"id":5,"arabic":"رَجِيمٌ","translit":"ٌmyِjgَr","root":"رجم"}],"hasIhya":false},{"ayah":35,"text":"وَإِنَّ عَلَيْكَ ٱللَّعْنَةَ إِلَىٰ يَوْمِ ٱلدِّينِ ","translation":"And indeed, upon you is the curse until the Day of Recompense.\"","words":[{"id":1,"arabic":"وَإِنَّ","translit":"َّnِiʾَw","root":""},{"id":2,"arabic":"عَلَيْكَ","translit":"َkْyَlَʿع","root":""},{"id":3,"arabic":"ٱللَّعْنَةَ","translit":"َẗَnْʿعَّllٱ","root":"لعن"},{"id":4,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":5,"arabic":"يَوْمِ","translit":"ِmْwَy","root":"يوم"},{"id":6,"arabic":"ٱلدِّينِ","translit":"ِnyِّdlٱ","root":"دين"}],"hasIhya":false},{"ayah":36,"text":"قَالَ رَبِّ فَأَنظِرْنِىٓ إِلَىٰ يَوْمِ يُبْعَثُونَ ","translation":"He said, \"My Lord, then reprieve me until the Day they are resurrected.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"رَبِّ","translit":"ِّbَr","root":"ربب"},{"id":3,"arabic":"فَأَنظِرْنِىٓ","translit":"ٓàِnْrِẓnَaʾَf","root":"نظر"},{"id":4,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":5,"arabic":"يَوْمِ","translit":"ِmْwَy","root":"يوم"},{"id":6,"arabic":"يُبْعَثُونَ","translit":"َnwُhtَʿعْbُy","root":"بعث"}],"hasIhya":true},{"ayah":37,"text":"قَالَ فَإِنَّكَ مِنَ ٱلْمُنظَرِينَ ","translation":"[Allāh] said, \"So indeed, you are of those reprieved","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"فَإِنَّكَ","translit":"َkَّnِiʾَf","root":""},{"id":3,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":4,"arabic":"ٱلْمُنظَرِينَ","translit":"َnyِrَẓnُmْlٱ","root":"نظر"}],"hasIhya":false},{"ayah":38,"text":"إِلَىٰ يَوْمِ ٱلْوَقْتِ ٱلْمَعْلُومِ ","translation":"Until the Day of the time well-known.\"","words":[{"id":1,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":2,"arabic":"يَوْمِ","translit":"ِmْwَy","root":"يوم"},{"id":3,"arabic":"ٱلْوَقْتِ","translit":"ِtْqَwْlٱ","root":"وقت"},{"id":4,"arabic":"ٱلْمَعْلُومِ","translit":"ِmwُlْʿعَmْlٱ","root":"علم"}],"hasIhya":false},{"ayah":39,"text":"قَالَ رَبِّ بِمَآ أَغْوَيْتَنِى لَأُزَيِّنَنَّ لَهُمْ فِى ٱلْأَرْضِ وَلَأُغْوِيَنَّهُمْ أَجْمَعِينَ ","translation":"[Iblees] said, \"My Lord, because You have put me in error, I will surely make [disobedience] attractive to them [i.e., mankind] on earth, and I will mislead them all","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"رَبِّ","translit":"ِّbَr","root":"ربب"},{"id":3,"arabic":"بِمَآ","translit":"ٓāَmِb","root":""},{"id":4,"arabic":"أَغْوَيْتَنِى","translit":"àِnَtْyَwْغَaʾ","root":"غوي"},{"id":5,"arabic":"لَأُزَيِّنَنَّ","translit":"َّnَnِّyَzُaʾَl","root":"زين"},{"id":6,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":7,"arabic":"فِى","translit":"àِf","root":""},{"id":8,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":9,"arabic":"وَلَأُغْوِيَنَّهُمْ","translit":"ْmُhَّnَyِwْغُaʾَlَw","root":"غوي"},{"id":10,"arabic":"أَجْمَعِينَ","translit":"َnyِʿعَmْjgَaʾ","root":"جمع"}],"hasIhya":false},{"ayah":40,"text":"إِلَّا عِبَادَكَ مِنْهُمُ ٱلْمُخْلَصِينَ ","translation":"Except, among them, Your chosen servants.\"","words":[{"id":1,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":2,"arabic":"عِبَادَكَ","translit":"َkَdāَbِʿع","root":"عبد"},{"id":3,"arabic":"مِنْهُمُ","translit":"ُmُhْnِm","root":""},{"id":4,"arabic":"ٱلْمُخْلَصِينَ","translit":"َnyِṣَlْhkُmْlٱ","root":"خلص"}],"hasIhya":true},{"ayah":41,"text":"قَالَ هَٰذَا صِرَٰطٌ عَلَىَّ مُسْتَقِيمٌ ","translation":"[Allāh] said, \"This is a path [of return] to Me [that is] straight.","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":3,"arabic":"صِرَٰطٌ","translit":"ٌṭَٰrِṣ","root":"صرط"},{"id":4,"arabic":"عَلَىَّ","translit":"َّàَlَʿع","root":""},{"id":5,"arabic":"مُسْتَقِيمٌ","translit":"ٌmyِqَtْsُm","root":"قوم"}],"hasIhya":false},{"ayah":42,"text":"إِنَّ عِبَادِى لَيْسَ لَكَ عَلَيْهِمْ سُلْطَٰنٌ إِلَّا مَنِ ٱتَّبَعَكَ مِنَ ٱلْغَاوِينَ ","translation":"Indeed, My servants - no authority will you have over them, except those who follow you of the deviators.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"عِبَادِى","translit":"àِdāَbِʿع","root":"عبد"},{"id":3,"arabic":"لَيْسَ","translit":"َsْyَl","root":"ليس"},{"id":4,"arabic":"لَكَ","translit":"َkَl","root":""},{"id":5,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":6,"arabic":"سُلْطَٰنٌ","translit":"ٌnَٰṭْlُs","root":"سلط"},{"id":7,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":8,"arabic":"مَنِ","translit":"ِnَm","root":""},{"id":9,"arabic":"ٱتَّبَعَكَ","translit":"َkَʿعَbَّtٱ","root":"تبع"},{"id":10,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":11,"arabic":"ٱلْغَاوِينَ","translit":"َnyِwāَغْlٱ","root":"غوي"}],"hasIhya":true},{"ayah":43,"text":"وَإِنَّ جَهَنَّمَ لَمَوْعِدُهُمْ أَجْمَعِينَ ","translation":"And indeed, Hell is the promised place for them all.","words":[{"id":1,"arabic":"وَإِنَّ","translit":"َّnِiʾَw","root":""},{"id":2,"arabic":"جَهَنَّمَ","translit":"َmَّnَhَjg","root":""},{"id":3,"arabic":"لَمَوْعِدُهُمْ","translit":"ْmُhُdِʿعْwَmَl","root":"وعد"},{"id":4,"arabic":"أَجْمَعِينَ","translit":"َnyِʿعَmْjgَaʾ","root":"جمع"}],"hasIhya":true},{"ayah":44,"text":"لَهَا سَبْعَةُ أَبْوَٰبٍ لِّكُلِّ بَابٍ مِّنْهُمْ جُزْءٌ مَّقْسُومٌ ","translation":"It has seven gates; for every gate is of them [i.e., Satan's followers] a portion designated.\"","words":[{"id":1,"arabic":"لَهَا","translit":"āَhَl","root":""},{"id":2,"arabic":"سَبْعَةُ","translit":"ُẗَʿعْbَs","root":"سبع"},{"id":3,"arabic":"أَبْوَٰبٍ","translit":"ٍbَٰwْbَaʾ","root":"بوب"},{"id":4,"arabic":"لِّكُلِّ","translit":"ِّlُkِّl","root":"كلل"},{"id":5,"arabic":"بَابٍ","translit":"ٍbāَb","root":"بوب"},{"id":6,"arabic":"مِّنْهُمْ","translit":"ْmُhْnِّm","root":""},{"id":7,"arabic":"جُزْءٌ","translit":"ٌءْzُjg","root":"جزا"},{"id":8,"arabic":"مَّقْسُومٌ","translit":"ٌmwُsْqَّm","root":"قسم"}],"hasIhya":true},{"ayah":45,"text":"إِنَّ ٱلْمُتَّقِينَ فِى جَنَّٰتٍ وَعُيُونٍ ","translation":"Indeed, the righteous will be within gardens and springs,","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلْمُتَّقِينَ","translit":"َnyِqَّtُmْlٱ","root":"وقي"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"جَنَّٰتٍ","translit":"ٍtَّٰnَjg","root":"جنن"},{"id":5,"arabic":"وَعُيُونٍ","translit":"ٍnwُyُʿعَw","root":"عين"}],"hasIhya":false},{"ayah":46,"text":"ٱدْخُلُوهَا بِسَلَٰمٍ ءَامِنِينَ ","translation":"[Having been told], \"Enter it in peace, safe [and secure].\"","words":[{"id":1,"arabic":"ٱدْخُلُوهَا","translit":"āَhwُlُhkْdٱ","root":"دخل"},{"id":2,"arabic":"بِسَلَٰمٍ","translit":"ٍmَٰlَsِb","root":"سلم"},{"id":3,"arabic":"ءَامِنِينَ","translit":"َnyِnِmāَء","root":"امن"}],"hasIhya":false},{"ayah":47,"text":"وَنَزَعْنَا مَا فِى صُدُورِهِم مِّنْ غِلٍّ إِخْوَٰنًا عَلَىٰ سُرُرٍ مُّتَقَٰبِلِينَ ","translation":"And We will remove whatever is in their breasts of resentment,[1] [so they will be] brothers, on thrones facing each other.","words":[{"id":1,"arabic":"وَنَزَعْنَا","translit":"āَnْʿعَzَnَw","root":"نزع"},{"id":2,"arabic":"مَا","translit":"āَm","root":""},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"صُدُورِهِم","translit":"mِhِrwُdُṣ","root":"صدر"},{"id":5,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":6,"arabic":"غِلٍّ","translit":"ٍّlِغ","root":"غلل"},{"id":7,"arabic":"إِخْوَٰنًا","translit":"āًnَٰwْhkِiʾ","root":"اخو"},{"id":8,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":9,"arabic":"سُرُرٍ","translit":"ٍrُrُs","root":"سرر"},{"id":10,"arabic":"مُّتَقَٰبِلِينَ","translit":"َnyِlِbَٰqَtُّm","root":"قبل"}],"hasIhya":true},{"ayah":48,"text":"لَا يَمَسُّهُمْ فِيهَا نَصَبٌ وَمَا هُم مِّنْهَا بِمُخْرَجِينَ ","translation":"No fatigue will touch them therein, nor from it will they [ever] be removed.","words":[{"id":1,"arabic":"لَا","translit":"āَl","root":""},{"id":2,"arabic":"يَمَسُّهُمْ","translit":"ْmُhُّsَmَy","root":"مسس"},{"id":3,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":4,"arabic":"نَصَبٌ","translit":"ٌbَṣَn","root":"نصب"},{"id":5,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":6,"arabic":"هُم","translit":"mُh","root":""},{"id":7,"arabic":"مِّنْهَا","translit":"āَhْnِّm","root":""},{"id":8,"arabic":"بِمُخْرَجِينَ","translit":"َnyِjgَrْhkُmِb","root":"خرج"}],"hasIhya":false},{"ayah":49,"text":"نَبِّئْ عِبَادِىٓ أَنِّىٓ أَنَا ٱلْغَفُورُ ٱلرَّحِيمُ ","translation":"[O Muḥammad], inform My servants that it is I who am the Forgiving, the Merciful,","words":[{"id":1,"arabic":"نَبِّئْ","translit":"ْyʾِّbَn","root":"نبا"},{"id":2,"arabic":"عِبَادِىٓ","translit":"ٓàِdāَbِʿع","root":"عبد"},{"id":3,"arabic":"أَنِّىٓ","translit":"ٓàِّnَaʾ","root":""},{"id":4,"arabic":"أَنَا","translit":"āَnَaʾ","root":""},{"id":5,"arabic":"ٱلْغَفُورُ","translit":"ُrwُfَغْlٱ","root":"غفر"},{"id":6,"arabic":"ٱلرَّحِيمُ","translit":"ُmyِḥَّrlٱ","root":"رحم"}],"hasIhya":false},{"ayah":50,"text":"وَأَنَّ عَذَابِى هُوَ ٱلْعَذَابُ ٱلْأَلِيمُ ","translation":"And that it is My punishment which is the painful punishment.","words":[{"id":1,"arabic":"وَأَنَّ","translit":"َّnَaʾَw","root":""},{"id":2,"arabic":"عَذَابِى","translit":"àِbāَhdَʿع","root":"عذب"},{"id":3,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":4,"arabic":"ٱلْعَذَابُ","translit":"ُbāَhdَʿعْlٱ","root":"عذب"},{"id":5,"arabic":"ٱلْأَلِيمُ","translit":"ُmyِlَaʾْlٱ","root":"الم"}],"hasIhya":false},{"ayah":51,"text":"وَنَبِّئْهُمْ عَن ضَيْفِ إِبْرَٰهِيمَ ","translation":"And inform them about the guests of Abraham,","words":[{"id":1,"arabic":"وَنَبِّئْهُمْ","translit":"ْmُhْyʾِّbَnَw","root":"نبا"},{"id":2,"arabic":