e., show kindness] to the believers.","words":[{"id":1,"arabic":"لَا","translit":"āَl","root":""},{"id":2,"arabic":"تَمُدَّنَّ","translit":"َّnَّdُmَt","root":"مدد"},{"id":3,"arabic":"عَيْنَيْكَ","translit":"َkْyَnْyَʿع","root":"عين"},{"id":4,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":5,"arabic":"مَا","translit":"āَm","root":""},{"id":6,"arabic":"مَتَّعْنَا","translit":"āَnْʿعَّtَm","root":"متع"},{"id":7,"arabic":"بِهِۦٓ","translit":"ٓۦِhِb","root":""},{"id":8,"arabic":"أَزْوَٰجًا","translit":"āًjgَٰwْzَaʾ","root":"زوج"},{"id":9,"arabic":"مِّنْهُمْ","translit":"ْmُhْnِّm","root":""},{"id":10,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":11,"arabic":"تَحْزَنْ","translit":"ْnَzْḥَt","root":"حزن"},{"id":12,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":13,"arabic":"وَٱخْفِضْ","translit":"ْḍِfْhkٱَw","root":"خفض"},{"id":14,"arabic":"جَنَاحَكَ","translit":"َkَḥāَnَjg","root":"جنح"},{"id":15,"arabic":"لِلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlِl","root":"امن"}],"hasIhya":false},{"ayah":89,"text":"وَقُلْ إِنِّىٓ أَنَا ٱلنَّذِيرُ ٱلْمُبِينُ ","translation":"And say, \"Indeed, I am the clear warner\" -","words":[{"id":1,"arabic":"وَقُلْ","translit":"ْlُqَw","root":"قول"},{"id":2,"arabic":"إِنِّىٓ","translit":"ٓàِّnِiʾ","root":""},{"id":3,"arabic":"أَنَا","translit":"āَnَaʾ","root":""},{"id":4,"arabic":"ٱلنَّذِيرُ","translit":"ُryِhdَّnlٱ","root":"نذر"},{"id":5,"arabic":"ٱلْمُبِينُ","translit":"ُnyِbُmْlٱ","root":"بين"}],"hasIhya":false},{"ayah":90,"text":"كَمَآ أَنزَلْنَا عَلَى ٱلْمُقْتَسِمِينَ ","translation":"Just as We had revealed [scriptures] to the separators[1]","words":[{"id":1,"arabic":"كَمَآ","translit":"ٓāَmَk","root":""},{"id":2,"arabic":"أَنزَلْنَا","translit":"āَnْlَznَaʾ","root":"نزل"},{"id":3,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":4,"arabic":"ٱلْمُقْتَسِمِينَ","translit":"َnyِmِsَtْqُmْlٱ","root":"قسم"}],"hasIhya":false},{"ayah":91,"text":"ٱلَّذِينَ جَعَلُوا۟ ٱلْقُرْءَانَ عِضِينَ ","translation":"Who have made the Qur’ān into portions.[1]","words":[{"id":1,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":2,"arabic":"جَعَلُوا۟","translit":"۟āwُlَʿعَjg","root":"جعل"},{"id":3,"arabic":"ٱلْقُرْءَانَ","translit":"َnāَءْrُqْlٱ","root":"قرا"},{"id":4,"arabic":"عِضِينَ","translit":"َnyِḍِʿع","root":"عضو"}],"hasIhya":false},{"ayah":92,"text":"فَوَرَبِّكَ لَنَسْـَٔلَنَّهُمْ أَجْمَعِينَ ","translation":"So by your Lord, We will surely question them all","words":[{"id":1,"arabic":"فَوَرَبِّكَ","translit":"َkِّbَrَwَf","root":"ربب"},{"id":2,"arabic":"لَنَسْـَٔلَنَّهُمْ","translit":"ْmُhَّnَlَٔـْsَnَl","root":"سال"},{"id":3,"arabic":"أَجْمَعِينَ","translit":"َnyِʿعَmْjgَaʾ","root":"جمع"}],"hasIhya":true},{"ayah":93,"text":"عَمَّا كَانُوا۟ يَعْمَلُونَ ","translation":"About what they used to do.","words":[{"id":1,"arabic":"عَمَّا","translit":"āَّmَʿع","root":""},{"id":2,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":3,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":false},{"ayah":94,"text":"فَٱصْدَعْ بِمَا تُؤْمَرُ وَأَعْرِضْ عَنِ ٱلْمُشْرِكِينَ ","translation":"Then declare what you are commanded[1] and turn away from the polytheists.[2]","words":[{"id":1,"arabic":"فَٱصْدَعْ","translit":"ْʿعَdْṣٱَf","root":"صدع"},{"id":2,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":3,"arabic":"تُؤْمَرُ","translit":"ُrَmْwʾُt","root":"امر"},{"id":4,"arabic":"وَأَعْرِضْ","translit":"ْḍِrْʿعَaʾَw","root":"عرض"},{"id":5,"arabic":"عَنِ","translit":"ِnَʿع","root":""},{"id":6,"arabic":"ٱلْمُشْرِكِينَ","translit":"َnyِkِrْhsُmْlٱ","root":"شرك"}],"hasIhya":false},{"ayah":95,"text":"إِنَّا كَفَيْنَٰكَ ٱلْمُسْتَهْزِءِينَ ","translation":"Indeed, We are sufficient for you against the mockers","words":[{"id":1,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":2,"arabic":"كَفَيْنَٰكَ","translit":"َkَٰnْyَfَk","root":"كفي"},{"id":3,"arabic":"ٱلْمُسْتَهْزِءِينَ","translit":"َnyِءِzْhَtْsُmْlٱ","root":"هزا"}],"hasIhya":false},{"ayah":96,"text":"ٱلَّذِينَ يَجْعَلُونَ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَۚ فَسَوْفَ يَعْلَمُونَ ","translation":"Who make [equal] with Allāh another deity. But they are going to know.","words":[{"id":1,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":2,"arabic":"يَجْعَلُونَ","translit":"َnwُlَʿعْjgَy","root":"جعل"},{"id":3,"arabic":"مَعَ","translit":"َʿعَm","root":""},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"إِلَٰهًا","translit":"āًhَٰlِiʾ","root":"اله"},{"id":6,"arabic":"ءَاخَرَ","translit":"َrَhkāَء","root":"اخر"},{"id":7,"arabic":"فَسَوْفَ","translit":"َfْwَsَf","root":""},{"id":8,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":true},{"ayah":97,"text":"وَلَقَدْ نَعْلَمُ أَنَّكَ يَضِيقُ صَدْرُكَ بِمَا يَقُولُونَ ","translation":"And We already know that your breast is constrained by what they say.","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"نَعْلَمُ","translit":"ُmَlْʿعَn","root":"علم"},{"id":3,"arabic":"أَنَّكَ","translit":"َkَّnَaʾ","root":""},{"id":4,"arabic":"يَضِيقُ","translit":"ُqyِḍَy","root":"ضيق"},{"id":5,"arabic":"صَدْرُكَ","translit":"َkُrْdَṣ","root":"صدر"},{"id":6,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":7,"arabic":"يَقُولُونَ","translit":"َnwُlwُqَy","root":"قول"}],"hasIhya":true},{"ayah":98,"text":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَكُن مِّنَ ٱلسَّٰجِدِينَ ","translation":"So exalt [Allāh] with praise of your Lord and be of those who prostrate [to Him].","words":[{"id":1,"arabic":"فَسَبِّحْ","translit":"ْḥِّbَsَf","root":"سبح"},{"id":2,"arabic":"بِحَمْدِ","translit":"ِdْmَḥِb","root":"حمد"},{"id":3,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":4,"arabic":"وَكُن","translit":"nُkَw","root":"كون"},{"id":5,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":6,"arabic":"ٱلسَّٰجِدِينَ","translit":"َnyِdِjgَّٰslٱ","root":"سجد"}],"hasIhya":true},{"ayah":99,"text":"وَٱعْبُدْ رَبَّكَ حَتَّىٰ يَأْتِيَكَ ٱلْيَقِينُ ","translation":"And worship your Lord until there comes to you the certainty [i.e., death].","words":[{"id":1,"arabic":"وَٱعْبُدْ","translit":"ْdُbْʿعٱَw","root":"عبد"},{"id":2,"arabic":"رَبَّكَ","translit":"َkَّbَr","root":"ربب"},{"id":3,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":4,"arabic":"يَأْتِيَكَ","translit":"َkَyِtْaʾَy","root":"اتي"},{"id":5,"arabic":"ٱلْيَقِينُ","translit":"ُnyِqَyْlٱ","root":"يقن"}],"hasIhya":false}],"tafsir":{"2":[{"arabic":"الله عليه وسلم {ربما يود الذين كفروا لو كانوا مسلمين} (2) وقال رسول الله صلى الله عليه وسلم لله أرحم بعبده المؤمن من الوالدة الشفيقة بولدها (3) وقال جابر بن عبد الله من زادت حسناته على سيآته يوم القيامة فذلك الذي يدخل الجنة بغير حساب ومن استوت حسناته وسيآته فذلك الذي يحاسب حسابا يسيرا ثم يدخل الجنة وإنما شفاعة رسول الله صلى الله عليه وسلم لمن أوبق نفسه وأثقل ظهره ويروى إن الله عز وجل قال لموسى عليه السلام يا موسى استغاث بك قارون فلم تغثه وعزتي وجلالي لو استغاث بي لأغثته وعفوت عنه وقال سعد ب","english":"He mentioned me one day, or feared me in a station (1). And the Messenger of God, may God bless him and grant him peace, said: \"When the people of the Fire are gathered in the Fire — and with them, whomsoever God wills of the people of the Qiblah — the disbelievers will say to the Muslims: 'Were you not Muslims?' They will reply: 'Yes.' Then they will say: 'What did your Islam avail you, seeing that you are with us in the Fire?' They will answer: 'We had sins, and we were seized for them.' Then God, Mighty and Glorious, will hear what they have said, and He will command that whoever was in the Fire of the people of the Qiblah be brought out, and they will be brought out. When the disbelievers see that, they will say: 'Would that we had been Muslims, so that we might be brought out as they were brought out.' Then the Messenger of God, may God bless him and grant him peace, recited: {ربما يود الذين كفروا لو كانوا مسلمين} — \"Perhaps those who disbelieve will wish that they had been Muslims\" (Q. 15:2). (2)","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1360","section_title_en":"On the Vastness of Divine Mercy and the Intercession for the Sinful — Section 1360","section_index":1360,"anchors":"- Root: ذكر (dhakara)\n  * Lisan / Ayn: Remembrance, recollection; also mention, invocation.\n  * Al-Raghib (Mufradat): Al-dhikr is the opposite of forgetfulness (nisyān); it denotes the heart's presence with what is recalled, and the tongue's utterance thereof.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): to recall in the heart or utter on the tongue. Metaphorical (majāz): \"dhakartuhu bi-khayr\" — to speak well of someone, i.e., to raise their mention in honor.\n- Root: خرج (kharaja)\n  * Lisan / Ayn: To exit, depart, emerge from an interior to an exterior.\n  * Al-Raghib (Mufradat): Al-khurūj is the departure of a thing from its place or state; used of the soul leaving the body, and of the damned leaving the Fire.\n  * Al-Zamakhshari (Asas): Literal: spatial egress. Metaphorical: \"kharaja min al-amr\" — to emerge from an affair, i.e., to be free of its obligation; and \"akhrajahu Allāh min al-nār\" — divine extraction by mercy, not by merit.\n- Root: شفع (shafa'a)\n  * Lisan / Ayn: To make even, pair; intercession is making one's supplication a pair with another's need.\n  * Al-Raghib (Mufradat): Al-shafā'ah is the joining of one's intercession to another's request for aid; its reality is the elevation of the intercessor's rank and the remission of the offender's burden.\n  * Al-Zamakhshari (Asas): Literal: pairing. Metaphorical: intercession before a king — the intercessor \"pairs\" his own honor with the petitioner's deficiency.\n- Root: رحم (raḥima)\n  * Lisan / Ayn: Tenderness of heart, compassion; al-Raḥmān is intensive — mercy as an essential attribute.\n  * Al-Raghib (Mufradat): Al-raḥmah is tenderness that necessitates beneficence; when attributed to God, it is pure beneficence (tafaddul) without emotional change.\n  * Al-Zamakhshari (Asas): Literal: the mother's womb (raḥim) as the seat of compassion. Metaphorical: \"arḥam al-rāḥimīn\" — God's mercy as sheer gratuitous giving, exceeding any creaturely pity.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — \"Innamā shafā'atu Rasūlillāh…\" restricts intercession to a specific class, namely those who have burdened themselves with sins, not the innocent.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'","badge":"Afterlife"}],"5":[{"arabic":"الباعث في حقه ويبقى ما سبق من أمر الولد فإن ذلك عام إلا للممسوح وهو نادر ومن الطباع ما تغلب عليها الشهوة بحيث لا تحصنه المرأة الواحدة فيستحب لصاحبها الزيادة على الواحدة إلى الأربع فإن يسر الله له مودة ورحمة واطمأن قلبه بهن وإلا فيستحب له الاستبدال فقد نكح علي رضي الله عنه بعد وفاة فاطمة عليها السلام بسبع ليال ويقال إن الحسن بن علي كان منكاحا حتى نكح زيادة على مائتي امرأة وكان ربما عقد على أربع في وقت واحد وربما طلق أربعا في وقت واحد واستبدل بهن وقد قال صلى الله عليه وسلم للح","english":"وقال صلى الله عليه وسلم: \"لا يلقى الله أحد بذنب أعظم من جهالة أهله.\"","book_title":"Etiquette of Marriage","section_title_ar":"Section 296","section_title_en":"Section 296","section_index":296,"anchors":"*(Anchors established)*","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Marriage'","badge":"Hadith"}],"9":[{"arabic":"به فقد هدي ومن عمل به فقد فاز وقال تعالى {إنا نحن نزلنا الذكر وإنا له لحافظون} ومن أسباب حفظه في القلوب والمصاحف استدامة تلاوته والمواظبة على دراسته مع القيام بآدابه وشروطه والمحافظة على ما فيه من الأعمال الباطنة والآداب الظاهرة وذلك لا بد من بيانه وتفصيله وتنكشف مقاصده في أربعة أبواب الباب الأول في فضل القرآن وأهله الباب الثاني في آداب التلاوة في الظاهر الباب الثالث في الأعمال الباطنة عند التلاوة الباب الرابع في فهم القرآن وتفسيره بالرأي وغيره الباب الأول في فضل القرآن وأهله وذم المقصرين في تلاوته فضيلة القرآن","english":"Praise be to God, who has bestowed His favor upon His servants through His sent Messenger (peace be upon him) and His revealed Book — falsehood cannot approach it from before it or from behind it; it is a revelation (tanzīl) from the Wise, the Praiseworthy {«تَنْزِيلٌ مِنْ حَكِيمٍ حَمِيدٍ»}. Through it, the path of reflection (iʿtibār) has been widened for the people of understanding, by virtue of what it contains of narratives and reports; and through it, the way of the upright course and the straight path (al-ṣirāṭ al-mustaqīm) has been made clear, by virtue of what it details of rulings and distinguishes between the lawful (ḥalāl) and the unlawful (ḥarām). It is the illumination and the light; through it is deliverance from delusion; in it is healing for what is in the breasts. Whoever opposes it among the tyrants, God crushes him; and whoever seeks knowledge in other than it, God leads him astray. It is the firm rope of God (ḥabl Allāh al-matīn), His manifest light, the trustworthy handhold (al-ʿurwah al-wuthqā), and the most faithful refuge. It encompasses the little and the much, the small and the great. Its wonders do not come to an end, nor do its marvels reach a limit. No delimitation (taḥdīd) encompasses its benefits according to the people of knowledge, nor does the frequency of repetition wear it out according to the people of recitation. It is that which guided the first and the last. When the jinn heard it, they did not delay in turning to their people as warners, saying: {«فَقَالُوا إِنَّا سَمِعْنَا قُرْآنًا عَجَبًا * يَهْدِي إِلَى الرُّشْدِ فَآمَنَّا بِهِ وَلَنْ نُشْرِكَ بِرَبِّنَا أَحَدًا»} (\"Indeed, we have heard a wondrous Quran; it guides to right conduct, so we have believed in it, and we will never associate anyone with our Lord.\") So whoever believes in it has been granted success (tawfīq); whoever speaks by it has spoken truthfully; whoever clings to it has been guided; and whoever acts by it has attained felicity (fawz). And God, the Exalted, says: {«إِنَّا نَحْنُ نَزَّلْنَا الذِّكْرَ وَإِنَّا لَهُ لَحَافِظُونَ»} (\"Indeed, We — it is We who have sent down the Remembrance, and indeed, We are its Preservers.\") Among the means of its preservation (ḥifẓ) in hearts and in codices (maṣāḥif) is the constancy of its recitation (tilāwah) and perseverance in its study, along with the fulfillment of its etiquettes (ādāb) and conditions, and the safeguarding of what it contains of inward works (aʿmāl bāṭinah) and outward etiquettes (ādāb ẓāhirah). This cannot be done without its exposition and detailing; its aims unfold in four chapters (abwāb):","book_title":"Patience and Gratitude","section_title_ar":"Section 220","section_title_en":"The Book of the Etiquettes of Quran Recitation — Section 220: The Excellence of the Quran and Its People","section_index":220,"anchors":"- Root: نزل (n-z-l)\n  * Lisan / Ayn: \"نزل: انحطاط من علو إلى سفل\" — descent from a height to a lower place; the setting down of a thing in a place.\n  * Al-Raghib (Mufradat): \"النزول في الأصل هو انحطاط من علو... وإنزال الله تعالى نعمه ونقمه على الخلق، وإعطاؤهم إياها\" — the descent of the Quran is a divine act of sending down (tanzīl) from the highest station, carrying with it the very mercy and address of God.\n  * Al-Zamakhshari (Asas): Haqiqah (literal): \"نزل من علو إلى سفل\" — physical descent. Majaz (metaphorical): \"وأنزل الله الغيث، وأنزل الكتاب\" — the \"sending down\" of revelation is a metaphorical extension denoting divine bestowal and elevation of the recipient, not spatial movement.\n- Root: حفظ (ḥ-f-ẓ)\n  * Lisan / Ayn: \"الحفظ: الحِراسة والاستظهار\" — guarding, preserving, and keeping watch over a thing.\n  * Al-Raghib (Mufradat): \"الحفظ: ضبط الشيء عن أن يذهب أو يضيع\" — the securing of a thing against loss or corruption; divine preservation (ḥifẓ) is an act of sovereign care.\n  * Al-Zamakhshari (Asas): Haqiqah: guarding a physical object. Majaz: \"حفظ الله فلانًا\" — divine protection from spiritual harm and error.\n- Root: تلو (t-l-w)\n  * Lisan / Ayn: \"التلاوة: الاتباع، ثم سميت القراءة تلاوة لأنها تتبع الآيات حرفًا حرفًا\" — following in sequence; recitation is so named because the reader follows the verses letter by letter.\n  * Al-Raghib (Mufradat): \"التلاوة: الإتيان بالشيء متتابعًا\" — the bringing of a thing in succession; recitation of the Quran is the sequential utterance of its verses in devotion.\n  * Al-Zamakhshari (Asas): Haqiqah: following behind. Majaz: \"تلا الكتاب\" — reciting, as the tongue follows the written text.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of a preposition from its object by an intervening clause, as in «لا يأتيه الباطل من بين يديه ولا من خلفه», where the prepositional phrases are distributed across the sentence for rhetorical emphasis and comprehensiveness.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'","badge":"Insight"}],"29":[{"arabic":"أمره بإضافته إليه إذ قال تعالى إني خالق بشرا من طين فإذا سويته ونفخت فيه من روحي فقعوا له ساجدين فنبه على أن الجسد منسوب إلى الطين والروح إلى رب العالمين والمراد بالروح والنفس في هذا المقام واحد فالخلق عبارة عن هيئة في النفس راسخة عنها تصدر الأفعال بسهولة ويسر من غير حاجة إلى فكر وروية فإن كانت الهيئة بحيث تصدر عنها الأفعال الجميلة المحمودة عقلا وشرعا سميت تلك الهيئة خلقا حسنا وإن كان الصادر عنها الأفعال القبيحة سميت الهيئة التي هي المصدر خلقا سيئا وإنما قلنا إنها هيئة راسخة لأن من يصدر منه بذل المال على الندور لحاجة عارضة","english":"I say: Know that people have spoken concerning the reality of good character (ḥusn al-khulq) — what it is — yet they have not addressed its true nature; rather, they have addressed its fruits. Then they did not even exhaust all of its fruits, but each one mentioned only those fruits that occurred to him and were present in his mind. They did not direct their attention to mentioning its definition (ḥadd) and its reality (ḥaqīqah) that encompasses all its fruits in detail and with completeness. This is like the saying of al-Ḥasan: \"Good character is a cheerful face, the giving of bounty, and the withholding of harm.\" Al-Wāsiṭī said: \"It is that one neither disputes nor is disputed with, by virtue of his intense knowledge of God most high.\" Shāh al-Kirmānī said: \"It is the withholding of harm and the bearing of burdens.\" Some said: \"It is that one be near to people, yet a stranger among them.\" Al-Wāsiṭī said on another occasion: \"It is the pleasing of creation in prosperity and adversity.\" Abū ʿUthmān said: \"It is satisfaction with God most high.\" Sahl al-Tustarī was asked about good character, and he said: \"Its lowest degree is forbearance, the abandonment of retaliation, mercy toward the oppressor, seeking forgiveness for him, and compassion toward him.\" He said on another occasion: \"It is that one does not accuse the Truth concerning provision, but trusts in Him, and reposes in His faithfulness to what He has guaranteed, so that he obeys Him and does not disobey Him in all matters — both in what is between him and his Lord, and in what is between him and people.\" ʿAlī, may God be pleased with him, said: \"Good character consists in three qualities: avoiding forbidden things, seeking what is lawful, and enlarging one's provision upon one's dependents.\" Al-Ḥusayn ibn Manṣūr said: \"It is that the harshness of creation does not affect you after your contemplation of the Truth.\" Abū Saʿīd al-Kharrāz said: \"It is that you have no concern other than God most high.\" This and the like of it is abundant — and it is an addressing of the fruits of good character, not of its very self. Nor is it even encompassing of all the fruits.","book_title":"Fear and Hope","section_title_ar":"Section 615","section_title_en":"The Reality of Good Character (Ḥusn al-Khulq) — Its True Nature and the Four Pillars of the Soul","section_index":615,"anchors":"- Root: خلق (Kh-L-Q)\n  * Lisan / Ayn: \"التقدير المستقيم\" — precise measurement and fashioning; the outward form (khalq) and inward disposition (khuluq) as twin designations of the same root.\n  * Al-Raghib (Mufradat): \"إبداع الشيء من غير أصل ولا احتذاء\" — origination without precedent; here extended to the soul's innate constitution, which God alone originates and proportions.\n  * Al-Zamakhshari (Asas): Haqiqah: \"خلق الخراز الأديم\" — the tanner measures the hide before cutting. Majaz: \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation as measured origination. Thus khuluq is the soul's measured inward form, as khalq is the body's measured outward form.\n- Root: حسن (Ḥ-S-N)\n  * Lisan / Ayn: Beauty and comeliness in both visible and invisible orders.\n  * Al-Raghib (Mufradat): \"الحسن: عبارة عن كل مبهج مرغوب فيه\" — that which delights and is desired; three kinds: rational, appetitive, sensory. The good character is that which reason and revelation (ʿaqlan wa sharʿan) deem beautiful.\n  * Al-Zamakhshari (Asas): Haqiqah: \"أنظر إلى محاسن وجهه\" — visible beauties. Majaz: \"فلان لا يحسن شيئا\" — competence and virtue as moral beauty. The \"beautiful\" act is the metaphorical extension of visible comeliness to inward excellence.\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self, soul, spirit; that which is valued and precious.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul as spirit; in the verse {«ونفخت فيه من روحي»} the soul is that which is divinely breathed, distinguished from the clay body.\n  * Al-Zamakhshari (Asas): Haqiqah: \"شيء نفيس\" — precious thing. Majaz: \"دفق نفسه أي دمه\" — the self as the whole living person. Here, the soul (nafs) perceived by inner vision (baṣīrah) is of greater rank than the body perceived by sight (baṣar).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The author's repeated \"إنما قلنا\" and \"ليس الخلق عبارة عن...\" employ restrictive predication to delimit the definition of khuluq against rival candidates (act, power, knowledge), each negated in turn before the fourth meaning is affirmed.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'","badge":"Insight"},{"arabic":"وحذرتك سخطى ألم أخلقك بيدى ونفخت فيك من روحى وأسجدت لك ملائكتى فعصيت أمرى ونسيت عهدى وتعرضت لسخطى فو عزتى وجلالى لو ملأت الأرض رجالا كلهم مثلك يعبدونني ويسبحونني ثم عصونى لأنزلتهم منازل العاصين فبكى آدم عليه السلام عند ذلك ثلثمائة عام وكان عبيد الله البجلى كثير البكاء يقول في بكائه طول ليله إلهى أنا الذى كلما طال عمرى زادت ذنوبى أنا الذى كلما هممت بترك خطيئة عرضت لى شهوة أخرى واعبيداه خطيئة لم تبل وصاحبها في طلب أخرى واعبيداه إن كانت النار لك مقيلا ومأوى واعبيداه إن كانت المقامع برأسك تهيأ","english":"Following the example of your father Adam (upon him be peace). For Wahb ibn Munabbih related: When God caused Adam to descend from Paradise to the earth, he remained in a state where his tears would not dry. Then God—mighty and majestic is He—looked upon him on the seventh day, and he was sorrowful, dejected, and choked with grief, his head bowed low. So God—exalted is He—revealed to him: \"O Adam, what is this anguish I see in you?\" He said: \"O my Lord, my calamity has become immense, my sin has encompassed me, and I have been expelled from the dominion of my Lord. I have come to dwell in the abode of humiliation after honor, in the abode of misery after happiness, in the abode of toil after rest, in the abode of tribulation after well-being, in the abode of transience after permanence, and in the abode of death and annihilation after immortality and endurance. How should I not weep over my sin?\" So God—exalted is He—revealed to him: \"O Adam, did I not choose you for Myself, settle you in My abode, single you out with My honor, and warn you of My wrath? Did I not create you with My hand, breathe into you of My spirit, and cause My angels to prostrate before you? Yet you disobeyed My command, forgot My covenant, and exposed yourself to My wrath. By My might and My majesty, were I to fill the earth with men, all of them like you, worshipping Me and glorifying Me, and then they disobeyed Me, I would cast them down to the stations of the disobedient.\" At that, Adam (upon him be peace) wept for three hundred years.","book_title":"Monitoring and Accounting","section_title_ar":"Section 1255","section_title_en":"Section 1255 — The Supplication of the Distressed and the Path of the Devout in Private Confession","section_index":1255,"anchors":"- Root: ضرر (ḍ-r-r)\n  * Lisan / Ayn: Core meaning of hardship, harm, and dire necessity; al-muḍṭarr is one compelled by overwhelming distress.\n  * Al-Raghib (Mufradat): Theological nuance of existential neediness before God, where the creature’s incapacity meets divine sufficiency.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense of physical/compelling necessity; metaphorical (majāz) extension to spiritual desperation and supplication.\n- Root: كرم (k-r-m)\n  * Lisan / Ayn: Nobility and generosity as intrinsic qualities of character and divine action.\n  * Al-Raghib (Mufradat): When ascribed to God, denotes His manifest, overflowing beneficence; when to humans, praiseworthy acts and virtues.\n  * Al-Zamakhshari (Asas): Literal: abundant giving; metaphorical: the \"generosity\" of rain-laden clouds or a land rich in bounty.\n- Root: عفو (ʿ-f-w)\n  * Lisan / Ayn: Erasure, pardon, and remission of a fault; to leave something unpunished.\n  * Al-Raghib (Mufradat): Divine pardon as the effacement of sin and the restoration of the sinner to a state of grace.\n  * Al-Zamakhshari (Asas): Literal: blotting out; metaphorical: comprehensive mercy that \"covers\" (shāmil) all transgressions.\n- Sibawayh Rule: باب النداء والتضرع (The Chapter of Vocative Appeal and Supplication) — Governing the syntactic patterns of direct address (yā) with epithets of divine mercy, and the anaphoric repetition of \"anā\" (I am...) for emphatic self-abasement.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Monitoring and Accounting'","badge":"Afterlife"}],"36":[{"arabic":"أحدكم من الدعاء ما يعلم من نفسه فإن الله عز وجل أجاب دعاء شر الخلق إبليس لعنه الله إذ قال رب فانظرني إلى يوم يبعثون قال إنك من المنظرين الثامن أن يلح في الدعاء ويكرره ثلاثا قال ابن مسعود كان صلى الله عليه وسلم إذا دعا دعا ثلاثا وإذا سال سأل ثلاثا (1) وينبغي أن لا يستبطىء الإجابة لقوله صلى الله عليه وسلم يستجاب لأحدكم ما لم يعجل فيقول قد دعوت فلم يستجب لي فإذا دعوت فاسأل الله كثيرا فإنك تدعو كريما (2) وقال بعضهم إني أسأل الله عز وجل منذ عشرين سنة حاجة وما أجابني وأنا أرجو الإجابة سألت الله تعالى أن يوفقني لترك ما لا يعنيني وقال","english":"[Root: دعو]\n  • Lisan al-Arab: \"الدعاء: الرغبة إلى الله تعالى، والابتهال في المسألة. والدعوة: الكلمة التي يدعو بها. وأصل الدعاء: طلب الإقبال من الغير.\"\n  • Al-Raghib (Mufradat): \"الدعاء: ضربان: أحدهما دعاء العبادة، والآخر دعاء المسألة. فدعاء العبادة: هو توجه العبد إلى الله تعالى بالطاعة. ودعاء المسألة: طلب الحاجة من الله تعالى. قال تعالى: {وقال ربكم ادعوني أستجب لكم}.\"\n  • Al-Zamakhshari (Asas - Haqiqah/Literal): \"دعا فلان ربه: ابتهل إليه بالسؤال. ودعا الله: عبده. ومنه قوله تعالى: {إن الذين يستكبرون عن عبادتي} أي عن دعائي.\"\n  • Al-Zamakhshari (Asas - Majaz/Metaphorical): \"دعا عليه: سأل الله أن يصيبه بمكروه. ودعا له: سأل الله أن يحسن إليه. ومن المجاز: دعا الأمر إلى كذا، أي أدى إليه.\"","book_title":"On Invocations and Supplications","section_title_ar":"Section 242","section_title_en":"Section 242","section_index":242,"anchors":"*(Anchors established)*","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'","badge":"Insight"}],"40":[{"arabic":"وإليه الإشارة بقوله تعالى إلا عبادك منهم المخلصين وبقوله تعالى {إن عبادي ليس لك عليهم سلطان} والسماع سبب لصفاء القلب وهو شبكة للحق بواسطة الصفاء وعلى هذا يدل ما روى أن ذا النون المصري رحمه الله دخل بغداد فاجتمع إليه قوم من الصوفية ومعهم قوال فاستأذنوه في أن يقول لهم شيئا فأذن لهم في ذلك فأنشأ يقول صغير هواك عذبني .","english":"For this reason, he (peace and blessings be upon him) said: \"Beware the discernment of the believer, for he looks with the light of God.\" (2)","book_title":"Intention, Sincerity and Truthfulness","section_title_ar":"Section 509","section_title_en":"The Revival of the Religious Sciences — Section 509: On the Vision of Spiritual Realities Through Purity of Heart","section_index":509,"anchors":"- Root: صفا (ṣafā)\n  * Lisan / Ayn: Core meaning of clarity, purity, and transparency — free from turbidity or admixture.\n  * Al-Raghib (Mufradat): Denotes the heart's purification from base attributes, rendering it receptive to divine disclosures (mukāshafāt).\n  * Al-Zamakhshari (Asas): Literal: clarity of water or wine. Metaphorical: purity of the heart as the condition for spiritual perception.\n- Root: مثل (mathala)\n  * Lisan / Ayn: To stand before, to appear, to take shape or form.\n  * Al-Raghib (Mufradat): Used for representation and formation — the appearing of a thing in a form (ṣūrah) that may or may not correspond to its true reality.\n  * Al-Zamakhshari (Asas): Literal: standing erect before someone. Metaphorical: the self-representation of spiritual beings (arwāḥ) in sensible forms perceptible to the purified heart.\n- Root: نظر (naẓar)\n  * Lisan / Ayn: Vision, sight, and also reflection and consideration.\n  * Al-Raghib (Mufradat): Distinguishes between baṣar (physical sight) and baṣīrah (insight); the latter perceives spiritual realities (malakūt).\n  * Al-Zamakhshari (Asas): Literal: seeing with the eye. Metaphorical: \"looking with the light of God\" (al-naẓar bi-nūr Allāh) — perception through divine illumination.\n- Root: فرس (farasa)\n  * Lisan / Ayn: To prey upon, to seize — the ferāsah (discernment) is so named because it seizes upon the inner reality.\n  * Al-Raghib (Mufradat): The intuitive perception of inner states — a form of inspired knowledge (ʿilm ladunī).\n  * Al-Zamakhshari (Asas): Literal: the lion preying on its quarry. Metaphorical: the believer's discernment that pierces through outward appearances to inward truths.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to confine the activity of devils to hearts filled with blameworthy attributes, and to restrict the vision of the Kingdom of Heaven to purified hearts.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Intention, Sincerity and Truthfulness'","badge":"Insight"}],"42":[{"arabic":"عبادي ليس لك عليهم سلطان} والسماع سبب لصفاء القلب وهو شبكة للحق بواسطة الصفاء وعلى هذا يدل ما روى أن ذا النون المصري رحمه الله دخل بغداد فاجتمع إليه قوم من الصوفية ومعهم قوال فاستأذنوه في أن يقول لهم شيئا فأذن لهم في ذلك فأنشأ يقول صغير هواك عذبني .","english":"For this reason, he (peace and blessings be upon him) said: \"Beware the discernment of the believer, for he looks with the light of God.\" (2)","book_title":"Disciplining the Soul","section_title_ar":"Section 509","section_title_en":"The Revival of the Religious Sciences — Section 509: On the Vision of Spiritual Realities Through Purity of Heart","section_index":509,"anchors":"- Root: صفا (ṣafā)\n  * Lisan / Ayn: Core meaning of clarity, purity, and transparency — free from turbidity or admixture.\n  * Al-Raghib (Mufradat): Denotes the heart's purification from base attributes, rendering it receptive to divine disclosures (mukāshafāt).\n  * Al-Zamakhshari (Asas): Literal: clarity of water or wine. Metaphorical: purity of the heart as the condition for spiritual perception.\n- Root: مثل (mathala)\n  * Lisan / Ayn: To stand before, to appear, to take shape or form.\n  * Al-Raghib (Mufradat): Used for representation and formation — the appearing of a thing in a form (ṣūrah) that may or may not correspond to its true reality.\n  * Al-Zamakhshari (Asas): Literal: standing erect before someone. Metaphorical: the self-representation of spiritual beings (arwāḥ) in sensible forms perceptible to the purified heart.\n- Root: نظر (naẓar)\n  * Lisan / Ayn: Vision, sight, and also reflection and consideration.\n  * Al-Raghib (Mufradat): Distinguishes between baṣar (physical sight) and baṣīrah (insight); the latter perceives spiritual realities (malakūt).\n  * Al-Zamakhshari (Asas): Literal: seeing with the eye. Metaphorical: \"looking with the light of God\" (al-naẓar bi-nūr Allāh) — perception through divine illumination.\n- Root: فرس (farasa)\n  * Lisan / Ayn: To prey upon, to seize — the ferāsah (discernment) is so named because it seizes upon the inner reality.\n  * Al-Raghib (Mufradat): The intuitive perception of inner states — a form of inspired knowledge (ʿilm ladunī).\n  * Al-Zamakhshari (Asas): Literal: the lion preying on its quarry. Metaphorical: the believer's discernment that pierces through outward appearances to inward truths.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to confine the activity of devils to hearts filled with blameworthy attributes, and to restrict the vision of the Kingdom of Heaven to purified hearts.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'","badge":"Insight"}],"43":[{"arabic":"يترك الركون إلى الدنيا بقي في حزب الشيطان وإن جهنم لموعدهم أجمعين فإذا عرفت هذا تعجبت من قوم يقادون إلى الجنة بالسلاسل فما من أحد إلا وهو مقود الى الجنة بسلاسل الأسباب وهو تسليط العلم والخوف عليه وما من مخذول إلا وهو مقود إلى النار بالسلاسل وهو تسليط الغفلة والأمن والغرور عليه فالمتقون يساقون إلى الجنة قهرا والمجرمون يقادون إلى النار قهرا ولا قاهر إلا الله الواحد القهار","english":"...a beloved and an object of desire, or an abhorred and an object of aversion. And beyond the exposition of this subtle point lies the secret of Destiny (sirr al-qadar), the divulgence of which has been forbidden. And by this, the first difficulty is resolved—namely, how can gratitude be [required] when the grateful one has no share [in producing it]? And by this also the second is resolved: for by \"gratitude\" (shukr) we mean nothing other than the turning of God's blessing toward the direction of love for God. So when the blessing turns toward the direction of love—by God's act—then the intended purpose has been achieved. And your act is a gift from God, may He be exalted; and insofar as you are its locus (maḥall), He has praised you—and His praise is another blessing from Him to you. So it is He who gave, and it is He who praised; and one of His two acts became a cause (sabab) for the turning of His second act toward the direction of His love. To Him, therefore, belongs gratitude in every case; and you are described as \"grateful\" (shākir) only in the sense that you are the locus of that meaning which gratitude is an expression of—not in the sense that you are its efficient cause (mūjib). Just as you are described as \"knowing\" and \"learned\"—not in the sense that you create knowledge or bring it into existence, but in the sense that you are its locus, and it has come to be in you through the eternal power (al-qudrah al-azaliyyah). So your being described as \"grateful\" is an affirmation of thingness (shayʾiyyah) for you—and you are a thing, since He who made all things into things has made you a thing. Rather, you are a non-thing only when you suppose yourself to be a thing in your own essence. But with respect to the consideration of Him who made things into things, you are a thing, since He made you a thing. For if you cut off consideration of His making, you are a veritable non-thing. And to this the Prophet, may God's peace and blessings be upon him, alluded when he said: \"Act, for everyone is made facile for that for which he was created.\" {«حديث: اعملوا فكل ميسر لما خلق له»} — a hadith related from ʿAlī and ʿImrān ibn Ḥuṣayn, when it was said to him: \"O Messenger of God, of what use is action, if matters have already been finished beforehand?\" So it became clear that creatures are the channels (majārī) of God's power and the loci of His acts—even though they themselves are also among His acts. But some of His acts are loci for others. And His saying {«اعملوا»} (\"Act\"), even though it issued upon the tongue of the Messenger, may God's peace and blessings be upon him and his family, is itself one of His acts; and it is a cause for the creatures' knowledge that action is beneficial. And their knowledge is an act of God, may He be exalted; and knowledge is a cause for the arousal of a resolute inclination (dāʿiyyah jāzimah) toward movement and obedience. And the arousal of the inclination is also among God's acts; and it is a cause for the movement of the limbs—which also are among God's acts. But some of His acts are causes for others—that is, the first is a condition (sharṭ) for the second. Just as the creation of the body is a cause for the creation of the accident (ʿaraḍ), since the accident is not created before it; and the creation of life is a condition for the creation of knowledge; and the creation of knowledge is a condition for the creation of will (irādah). And all of it is from God's acts, some of them being causes for others—that is, conditions. And the meaning of its being a \"condition\" is that nothing is disposed to receive the act of life except a substance (jawhar); and nothing is disposed to receive knowledge except one possessed of life; and nothing is disposed to receive will except one possessed of knowledge. Thus, some of His acts are causes for others in this sense—not in the sense that some of His acts bring others into existence, but rather that they prepare and pave the way as conditions for the attainment of others. And this, when verified, ascends to the degree of divine unity (tawḥīd) which we have mentioned.","book_title":"Patience and Gratitude","section_title_ar":"Section 981","section_title_en":"The Unveiling of the Secret of Destiny and the True Meaning of Gratitude and Action","section_index":981,"anchors":"- Root: سبب (sababa)\n  * Lisan / Ayn: The rope by which one climbs a palm tree; extended to any means by which one reaches a thing.\n  * Al-Raghib (Mufradat): Every means (wasīlah) by which one arrives at something is called a sabab; God's \"causing\" (tasbīb) is the ordered chain of conditions and prerequisites.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): a physical cord or tie; Metaphorical (majāz): any causal connection, whether ontological or epistemic.\n- Root: شكر (shakara)\n  * Lisan / Ayn: To be full (of a well); to acknowledge and display a benefit.\n  * Al-Raghib (Mufradat): \"Shukr is the perception of the blessing and its manifestation.\" It is the heart's fullness with remembrance of the Benefactor, the tongue's praise, and the limbs' recompense.\n  * Al-Zamakhshari (Asas): Literal: verbal thanks; Metaphorical: a beast that thrives on little fodder—i.e., the creature becomes a \"locus\" (maḥall) for the divine act.\n- Root: خلق (khalaqa)\n  * Lisan / Ayn: To measure, estimate, and create in due proportion.\n  * Al-Raghib (Mufradat): \"Creation is origination (ibdāʿ) from no prior model,\" and also \"bringing forth one thing from another\" (ījād al-shayʾ min al-shayʾ).\n  * Al-Zamakhshari (Asas): Literal: the tailor's cutting and measuring; Metaphorical: God's bringing things into being upon a measure dictated by wisdom.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The restriction of attribution to a single agent (God) while preserving secondary causal descriptions for creatures as mere loci (maḥall) of divine acts.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Patience and Gratitude'","badge":"Ethics"}],"44":[{"arabic":"التجارة وبها تتم أعمال هذه التجارة وإن لجهنم سبعة أبواب لكل باب منهم جزء مقسوم وإنما تتعين تلك الأبواب لمن عصى الله تعالى بهذه الأعضاء فيوصيها بحفظها عن معاصيها أما العين فيحفظها عن النظر إلى وجه من ليس له بمحرم أو إلى عورة مسلم أو النظر إلى مسلم بعين الاحتقار بل عن كل فضول مستغنى عنه فإن الله تعالى يسأل عبده عن فضول النظر كما يسأله عن فضول الكلام ثم إذا صرفها عن هذا لم تقنع به حتى يشغلها بما فيه تجارتها وربحها وهو ما خلقت له من النظر إلى عجائب صنع الله بعين الاعتبار والنظر إلى أعمال الخير للاقتداء والنظر في كتاب الله وسنة ر","english":"And some have said: \"Grant that the wrongdoer has been pardoned—has he not still missed the reward of the righteous?\"—pointing thereby to the loss and regret. And God Most High says: {«يَوْمَ يَجْمَعُكُمْ لِيَوْمِ الْجَمْعِ ذَٰلِكَ يَوْمُ التَّغَابُنِ»} (\"The Day He will gather you for the Day of Gathering—that is the Day of Mutual Loss\") (Al-Taghābun 64:9). So this is his counsel to his soul concerning his hours.","book_title":"Monitoring and Accounting","section_title_ar":"Section 1232","section_title_en":"The Revival of the Religious Sciences — Section 1232: The Soul's Covenant with Itself and Reckoning Before Deeds","section_index":1232,"anchors":"- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that which breathes and animates; the essence of a thing.\n  * Al-Raghib (Mufradat): Al-nafs denotes the rūḥ (spirit) and, in theological contexts, the very dhāt (essence/self) of a being—as in {«وَيُحَذِّرُكُمُ اللَّهُ نَفْسَهُ»} (Āl ʿImrān 3:28), where \"His self\" means His essence, not a separate entity.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): the soul as the seat of desire and action. Metaphorical (majāz): \"دفق نفسه\" (he poured out his self = his blood); the soul as a recalcitrant entity requiring discipline.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A day, from sunrise to sunset; also any span of time, especially the Day of Reckoning.\n  * Al-Raghib (Mufradat): Yawm signifies the period of the sun's course, but metaphorically extends to any era—most critically \"the Day of Gathering\" (yawm al-jamʿ) and \"the Day of Mutual Loss\" (yawm al-taghābun), where God's attribution of the day to Himself signals its supreme gravity.\n  * Al-Zamakhshari (Asas): Literal: a 24-hour cycle. Metaphorical: \"أيام الله\" (the days of God) = His punitive acts against the disbelievers, as in {«وَذَكِّرْهُمْ بِأَيَّامِ اللَّهِ»} (Ibrāhīm 14:5).\n- Root: حسب (ḥ-s-b)\n  * Lisan / Ayn: To count, reckon, or compute; also to suffice.\n  * Al-Raghib (Mufradat): Ḥisāb is the employment of number; the Day of Judgment is the day of reckoning where deeds are weighed. The \"ḥusbān\" (computation) of the sun and moon (Al-Anʿām 6:96) marks time for human accountability.\n  * Al-Zamakhshari (Asas): Literal: counting wealth or deeds. Metaphorical: \"احتسبت ما عند فلان\" (I probed what so-and-so possesses) = testing and examining, as the soul must examine its own intentions and acts before God's scrutiny.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The text uses conditional and imperative constructions (e.g., \"فإياك ثم إياك\" and \"ليشترط على نفسه\") to impose binding covenants, where the predicate restricts the soul's scope of action, demanding a precise, self-imposed legal obligation.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'","badge":"Insight"}],"47":[{"arabic":"فيهم رب العالمين ونزعنا ما في صدورهم من غل إخوانا على سرر متقابلين فهذا حالهم وهم بعد في الدنيا فماذا يظن بهم عند انكشاف الغطاء ومشاهدة المحبوب في العقبى فإذن لا يتصور أن يكون في الجنة محاسدة ولا أن يكون بين أهل الدنيا في الجنة محاسدة لأن الجنة لا مضايقة فيها ولا مزاحمة ولا تنال إلا بمعرفة الله تعالى التي لا مزاحمة فيها في الدنيا أيضا فأهل الجنة بالضرورة برءاء من الحسد في الدنيا والآخرة جميعا بل الحسد من صفات المبعدين عن سعة عليين إلى مضيق سجين ولذلك وسم به الشيطان اللعين وذكر من صفاته أنه حسد آدم عليه السلام على م","english":"The cobbler — nay, rather the cloth-merchant — and then the jostling of the cloth-merchant against his immediate neighbor is greater than his jostling against one farther from him toward the end of the market. Unavoidably, therefore, his envy of his neighbor is greater. Likewise, the brave man envies the brave man and does not envy the scholar, because his aim is to be mentioned for bravery, to become famous for it, and to be uniquely distinguished by this trait — and the scholar does not compete with him for this purpose. Similarly, the scholar envies the scholar and does not envy the brave man. Then the envy of the preacher for the preacher is greater than his envy for the jurist or the physician, because the competition between them is over a single, more specific aim. So the root of all these envies is enmity, and the root of enmity is the competition between two parties over a single purpose. And a single purpose does not unite two distant parties but rather two proportionate ones; therefore envy abounds between them. Yes — whoever's craving for prestige intensifies, and who loves fame throughout all the regions of the world in that which he pursues, he will envy everyone in the world, however distant, who shares with him in the trait by which he boasts. And the origin of all of that is love of this world, for it is only this world that straitens the competitors. As for the Hereafter, there is no constriction in it. The likeness of the Hereafter is the blessing of knowledge. Unavoidably, therefore, whoever loves knowledge of Allah Most High, and knowledge of His attributes, His angels, His prophets, and the dominion (malakūt) of His heavens and His earth, does not envy another when he too comes to know that — because knowledge does not straiten the knowers. Rather, the single known object is learned by a thousand thousand knowers, and each rejoices in knowing it and takes delight in it, and the delight of one is not diminished by another. Rather, through the multiplicity of knowers there accrues an increase of intimacy and the fruit of mutual learning and teaching. For this reason, there is no envy among the scholars of religion, because their aim is knowledge of Allah Most High — and He is a vast sea in which there is no constriction. And their purpose is rank with Allah — and there is no constriction either in what is with Allah Most High, because the most sublime of what is with Allah — glory be to Him — of bliss is the delight of beholding Him, and in that there is no hindrance and no competition, nor does one beholder straiten another. Rather, intimacy increases through their multiplicity. Yes — when scholars seek by their knowledge wealth and prestige, they envy one another, because wealth consists of concrete entities and bodies: when it falls into one hand, the other hand is emptied of it. And the meaning of prestige is the possession of hearts; and whenever a person's heart is filled with veneration of one scholar, it turns away from veneration of another, or diminishes toward him unavoidably — and this becomes a cause for mutual envy. But when a heart is filled with joy in knowledge of Allah Most High, that does not prevent another's heart from being filled with it as well and rejoicing in it. And the difference between knowledge and wealth is that wealth does not settle in one hand unless it departs from the other hand, whereas knowledge resides in the scholar's heart and settles in another's heart through his teaching it without departing from his own heart. And wealth consists of bodies and concrete entities, and they have an end — so if a man possessed all that is on the earth, no wealth would remain after him for another to possess. But knowledge has no end, nor can its exhaustive comprehension be conceived. So whoever accustoms his soul to reflection upon the majesty of Allah and His greatness and the dominion (malakūt) of His earth and His heavens — that becomes more delightful to him than every bliss, and he is neither barred from it nor competed with in it. Thus there is no envy in his heart toward any of creation, because if another came to know just as he knows, that would not diminish his delight — rather, his delight would increase through his companionship. So the delight of these people in contemplating the wonders of the dominion (malakūt) perpetually is greater than the delight of one who gazes upon the trees of Paradise and its gardens with the outward eye. For the bliss of the knower (al-ʿārif) and his Paradise is his knowledge, which is an attribute of his own essence — secure from perishing — and he perpetually harvests its fruits. So he, by his spirit and his heart, feeds upon the fruit of his knowledge — a fruit neither cut off nor forbidden, but whose clusters are within reach. And even if he closes the outward eye, his spirit perpetually pastures in a lofty Paradise and blooming meadows. And if one supposes a multitude among the knowers, they would not be envious of one another, but rather would be as the Lord of the Worlds said of them: {«ونزعنا ما في صدورهم من غل إخوانا على سرر متقابلين»} — \"And We shall strip away whatever rancor is in their breasts, as brothers, upon couches, face to face.\" This is their state while still in this world — so what must be supposed of them when the veil is lifted and the Beloved is beheld in the Hereafter? Thus it is inconceivable that there be envy in Paradise, nor that there be envy among the people of this world in Paradise, because Paradise has no straitness in it and no competition, and it is attained only through knowledge of Allah Most High — in which there is no competition even in this world. So the people of Paradise are necessarily free of envy in this world and the Hereafter alike. Rather, envy is among the attributes of those banished from the spaciousness of ʿIlliyyīn to the narrows of Sijjīn. For this reason, the accursed Satan was branded with it, and it is mentioned among his attributes that he envied Adam — peace be upon him — for the special distinction of election (ijtibāʾ) conferred upon him; and when he was called to prostrate, he grew arrogant, refused, rebelled, and disobeyed. So you have come to know that there is no envy except from the converging of two parties upon a single sought aim.","book_title":"Condemnation of Envy","section_title_ar":"Section 724","section_title_en":"On Envy Arising from Competition for Worldly Aims, and the Absence of Envy Among Seekers of Knowledge","section_index":724,"anchors":"- Root: حسد (ḥ-s-d)\n  * Lisan / Ayn: Core meaning of wishing removal of another's blessing; the root carries the sense of ill-will toward another's good fortune.\n  * Al-Raghib (Mufradat): \"الحسد: تمني زوال نعمة من مستحق لها\" — envy is the desire for the removal of a blessing from one who rightfully possesses it, sometimes accompanied by striving to effect its removal.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes this spiteful wishing; metaphorically (majāz), it is said \"الحسد يأكل الجسد\" — envy consumes the body, likening its inner corrosion to physical devouring.\n- Root: ضيق (ḍ-y-q)\n  * Lisan / Ayn: Narrowness, constriction, the opposite of spaciousness (saʿah).\n  * Al-Raghib (Mufradat): \"الضيق: ضد السعة\" — used literally for spatial tightness, and extended to distress, poverty, and constriction of the breast.\n  * Al-Zamakhshari (Asas): Literal for physical narrowness; metaphorical (majāz) in \"ضاقت عليه الحيلة\" (stratagem became straitened for him) and \"وقع في مضيق من أمره\" (he fell into a strait in his affair) — indicating incapacity and restriction of means.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge, perception, cognition; the root denotes grasping a thing's reality.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, either by grasping its essence or by judging its attributes.\n  * Al-Zamakhshari (Asas): Literal for certain awareness; metaphorically, \"أعلام العلم الخافقه\" — the fluttering banners of knowledge — where knowledge is likened to a lofty standard guiding seekers.\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: Turning, overturning, transforming a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named for its constant turning and fluctuation.\n  * Al-Zamakhshari (Asas): Literal for physical overturning; metaphorical (majāz) in \"قلب المعلم الصبيان\" (the teacher turned the boys back) and \"رجل قلب حول\" (a man who turns matters over and devises stratagems) — indicating mental deliberation and management of affairs.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle \"إنما\" restricts the predicate to the subject alone, negating it for all else. In the phrase \"إنما الدنيا هي التي تضيق على المتزاحمين\" (it is only this world that straitens the competitors), the restriction emphasizes that constriction belongs exclusively to worldly aims, not to the Hereafter.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Envy'","badge":"Insight"}],"92":[{"arabic":"المرسلين فلنقصن عليهم بعلم وما كنا غائبين} وقوله {فوربك لنسألنهم أجمعين عما كانوا يعملون} فيبدأ سبحانه بالأنبياء {يوم يجمع الله الرسل فيقول}","english":"Then reflect, O wretched one, after these states upon what is directed against you of the questioning — face to face, without any interpreter — and you shall be asked concerning the little and the much, the speck on a date-stone (al-naqīr) and the husk (al-qitmīr). For while you are amidst the distress of the Resurrection, its sweat, and the severity of its terrors, lo! the angels descend from the horizons of the heaven with immense bodies and gigantic forms — harsh, severe — commanded to seize the forelocks of the criminals and drag them to the standing-place of presentation (mawqif al-ʿarḍ) before the Omnipotent (al-Jabbār). The Messenger of Allah, may Allah bless him and grant him peace, said: \"Verily, Allah, Mighty and Majestic, has an angel between whose two eyelids is a distance of a hundred years' journey.\" So what is your assumption concerning yourself when you behold the likes of these angels — dispatched unto you to seize you and bring you to the station of presentation — and you see them, despite the enormity of their forms, broken in humility before the severity of that Day, filled with dread at what has become manifest of the Omnipotent's wrath upon His servants? And at their descent, there remains no prophet, no veracious one (ṣiddīq), no righteous soul, save that they fall upon their chins in fear, lest they themselves be the seized ones. Such is the state of those brought near (al-muqarrabūn) — so what is your assumption concerning the disobedient criminals?","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1340","section_title_en":"The Description of the Day of Resurrection, Its Calamities, and Its Names — The Description of the Questioning","section_index":1340,"anchors":"- Root: س-أ-ل (sa-ʾa-la)\n  * Lisan / Ayn: Core root denotes seeking, demanding, or interrogating; al-suʾāl is the act of asking, and musāʾalah implies reciprocal or formal interrogation.\n  * Al-Raghib (Mufradat): In theological context, al-suʾāl on the Day of Resurrection is a divine inquest (musāʾalah) demanding account of deeds, not for God's knowledge (as He is 'alīm) but for establishing proof (ḥujjah) against the creature.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage is verbal inquiry; metaphorical (majāz) extends to the juridical reckoning (muḥāsabah) where the tongue is made to testify without intermediary.\n- Root: ن-ز-ل (na-za-la)\n  * Lisan / Ayn: Core root signifies descent from a height; nuzūl is the act of alighting.\n  * Al-Raghib (Mufradat): When predicated of angels, it denotes their dispatch from the celestial realm to execute divine command — a descent of authority, not spatial movement in the divine essence.\n  * Al-Zamakhshari (Asas): Literal: physical descent; metaphorical: the advent of divine decree or angelic execution of wrath.\n- Root: ع-ر-ض (ʿa-ra-ḍa)\n  * Lisan / Ayn: Core root means to present, expose, or show; al-ʿarḍ is the exhibition of something before a viewer.\n  * Al-Raghib (Mufradat): In eschatological usage, mawqif al-ʿarḍ is the standing-place of presentation before God for judgment — a public display of deeds.\n  * Al-Zamakhshari (Asas): Literal: to show; metaphorical: the juridical tribunal of the Hereafter where all acts are exhibited.\n- Sibawayh Rule: Rule of Interrogative Scope (Bāb al-istifhām) — The rhetorical question \"فما ظنك\" (so what is your assumption?) functions as a periodic pause, redirecting the addressee's cognition from narrated events to self-projection, governed by the conditional-temporal particle \"إذ\" (when) that binds the apodosis to the protasis.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'","badge":"Hadith"}],"96":[{"arabic":"الله ولقوله ولا تجعلوا مع الله إلها آخر فمن لم يره في كل شيء فقد رأى غيره وكل ما التفت إليه العبد سوى الله تعالى تضمن التفاته شيئا من الشرك الخفي بل التوحيد الخالص أن لا يرى في كل شيء إلا الله عز وجل العاشر التبري وأعني به أن يتبرأ من حوله وقوته والالتفات إلى نفسه بين الرضا والتزكية فإذا تلا بآيات الوعد والمدح للصالحين فلا يشهد نفسه عند ذلك بل يشهد الموقنين والصديقين فيها ويتشوف إلى أن يلحقه الله عز وجل بهم وإذا تلا آيات المقت وذم العصاة والمقصرين شهد على نفسه هناك وقدر أنه المخا","english":"For this reason, Yūsuf ibn Asbāṭ said: \"I intend to recite the Qur'an, but when I recall what is in it, I fear abhorrence (al-maqt), so I turn instead to glorification (al-tasbīḥ) and seeking forgiveness (al-istighfār).\"","book_title":"Condemnation of Pride and Conceit","section_title_ar":"Section 231","section_title_en":"** The Revival of the Religious Sciences — Section 231: On the Inward Conditions of Qur'anic Recitation (Continued)","section_index":231,"anchors":"**\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"الوجل: استشعار الخوف\" — the stirring of fear/apprehension within\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف. يقال: وجل يوجل وجلا، فهو وجل. قال تعالى: {إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم}\" — the theological state of the heart's trembling upon remembrance of God\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"رجل وجل، وقوم وجال، وقد وجل وجلا\" — the physical/emotional state of fear. Metaphorical (Majaz): The heart's trembling as the seat of spiritual perception\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — turning and transforming\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه، كقلب الثوب، وقلب الإنسان\" — the heart as that which is constantly turning/transforming between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — physical turning. Metaphorical: \"قلب المعلم الصبيان: صرفهم إلى بيوتهم\" — the heart's turning toward or away from spiritual realities\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, spirit — that which is breathed\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul as the animating principle; also the self as the locus of blameworthy attributes\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس ومنفس\" — preciousness. Metaphorical: \"دفق نفسه أي دمه\" — the self as that which must be transcended in spiritual realization\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise delimitation of spiritual states (أحوال) and their hierarchical gradation (درجات)\n\n---\n\n#","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'","badge":"Insight"}],"97":[{"arabic":"{واصبر على ما يقولون واهجرهم هجرا جميلا} وقال تعالى {ولقد نعلم أنك يضيق صدرك بما يقولون فسبح بحمد ربك} الآية وقال تعالى {ولتسمعن من الذين أوتوا الكتاب من قبلكم ومن الذين أشركوا أذى كثيرا وإن تصبروا وتتقوا فإن ذلك من عزم الأمور} أي تصبروا عن المكافأة ولذلك مدح الله تعالى العافين عن حقوقهم في القصاص وغيره فقال تعالى {وإن عاقبتم فعاقبوا بمثل ما عوقبتم به ولئن صبرتم لهو} خير الصابرين {وقال} صلى الله عليه وسلم صل من قطعك وأعط من حرمك واعف عمن ظلمك // ورأيت في الإنجيل قال عيسى بن مريم عليه السلام لقد قيل لكم من قبل إن السن بالسن والأنف بالأنف وأنا أقول","english":"And acts of disobedience are the requisite of the impulse of caprice (bāʿith al-hawā). And the most severe kind of patience is patience in abstaining from those acts of disobedience that have become familiar through habit — for habit is a fifth nature. When habit is joined to lustful desire, two battalions from the battalions of Satan array themselves in concert against the battalion of God (jund Allāh) — may He be exalted — and the impulse of religion (bāʿith al-dīn) has no strength to suppress them. Then, if that act be one whose commission has been rendered easy (tayassara), patience in abstaining from it is heavier upon the soul — such as patience in abstaining from the sins of the tongue: backbiting (ghībah), falsehood, contentious disputation (mirāʾ), self-praise whether by insinuation (taʿrīḍ) or by explicit statement (taṣrīḥ), the varieties of jesting that wound hearts, the kinds of words by which one intends belittlement and contempt, and the mention of the dead with aspersion cast upon them, upon their sciences, their conduct, and their stations. For such mention is in its outward aspect (fī ẓāhirihi) backbiting, and in its inward aspect (fī bāṭinihi) self-praise. In it the soul has two lusts: one is the negation of the other [person], and the other is the affirmation of oneself. And by these two together there is completed for it that lordship (rubūbiyyah) which is innate in its disposition — and which is the very opposite of what it has been commanded regarding servanthood (ʿubūdiyyah). And because of the conjunction of the two lusts, and the ease of moving the tongue, and the fact that this becomes habitual in everyday converse, patience in abstaining from it becomes difficult. And it is among the greatest of the destructive enormities (al-mūbiqāt) — so much so that its disapproval and ugliness have been effaced from hearts by dint of its frequent repetition and the universality of familiarity with it. Thus you see a man who would, for example, wear silk and deem it utterly remote [of permissibility], yet he unleashes his tongue the whole day long against the reputations (aʿrāḍ) of people and does not deem that objectionable — notwithstanding what has come down in the report that backbiting is more severe than adultery (zinā). And God — may He be exalted — said: {«ودع أذاهم وتوكل على الله»} \"And leave aside their harm and put thy trust in God\" (Q. 33:48). And He said — may He be exalted: {«واصبر على ما يقولون واهجرهم هجرا جميلا»} \"And be patient over what they say, and depart from them with a gracious departure\" (Q. 73:10). And He said — may He be exalted: {«ولقد نعلم أنك يضيق صدرك بما يقولون فسبح بحمد ربك»} \"And indeed We know that thy breast is straitened by what they say; so glorify with the praise of thy Lord\" (Q. 15:97–98) — to the end of the verse. And He said — may He be exalted: {«ولتسمعن من الذين أوتوا الكتاب من قبلكم ومن الذين أشركوا أذى كثيرا وإن تصبروا وتتقوا فإن ذلك من عزم الأمور»} \"And you shall surely hear from those who were given the Scripture before you and from those who associate [others with God] much harm. And if you are patient and God-fearing, indeed that is of the resolute affairs\" (Q. 3:186) — that is, that you be patient in refraining from requital (mukāfaʾah). And for this reason God — may He be exalted — praised those who pardon others their due rights in retaliation (qiṣāṣ) and otherwise, saying — may He be exalted: {«وإن عاقبتم فعاقبوا بمثل ما عوقبتم به ولئن صبرتم لهو خير الصابرين»} \"And if you punish, then punish with the like of that wherewith you were afflicted. And if you are patient, it is surely better for the patient\" (Q. 16:126). And he — upon him be peace — said: \"Maintain the bond with him who cuts you off, and give to him who withholds from you, and pardon him who wrongs you.\" And I have seen in the Gospel that ʿĪsā ibn Maryam — upon him be peace — said: \"It was said to you of old: an eye for an eye and a nose for a nose. But I say to you: do not resist evil. Rather, whoever strikes your right cheek, turn to him PageV04P071 the left cheek; and whoever takes your cloak, give him your garment; and whoever compels you to walk with him one mile, walk with him two miles.\" And all of that is a command to be patient under harm. So patience under the harm of people is among the highest stations of patience, because in it the impulse of religion and the impulse of lustful desire and anger are all arrayed together [against the soul].","book_title":"Patience and Gratitude","section_title_ar":"Section 965","section_title_en":"The Most Severe Forms of Patience: Abstaining from Habitual Sins and Enduring Harm","section_index":965,"anchors":"- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning of restraint and withholding; \"ṣabara al-dābbah\" = to hold back an animal without fodder; \"ṣabartu nafsī\" = I restrained my soul.\n  * Al-Raghib (Mufradat): \"الصبر: حبس النفس على ما يقتضيه العقل والشرع، أو عما يقتضيان حبسها عنه\" — Patience is the withholding of the soul upon what reason and Law require, or from what they require it to be withheld. When exercised against calamity it is called ṣabr alone (opposed to jazaʿ); in warfare, courage (shajāʿah); in vexing misfortune, forbearance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صبرت على ما أكره. وصبرت عما أحب\" — I bore patiently what I dislike, and I restrained myself from what I love. Metaphorical (majāz): \"هو أصبر على الضرب من الأرض\" — he is more enduring of beating than the earth.\n- Root: عادة (ʿ-w-d)\n  * Lisan / Ayn: Recurrence and return; habitual practice that becomes second nature through repetition.\n  * Al-Raghib (Mufradat): Habit (ʿādah) as reiterated action that imprints upon the soul, rendering the act facile and its abandonment burdensome.\n  * Al-Zamakhshari (Asas): Literal: return to a state or place. Metaphorical: the ingrained disposition that governs conduct.\n- Root: غيب (gh-y-b)\n  * Al-Raghib (Mufradat): \"الغيب: مصدر غابت الشمس وغيرها: إذا استترت عن العين\" — that which is concealed from the senses; applied to what is absent from human perception, though nothing is absent from God.\n  * Al-Zamakhshari (Asas): Literal: \"تكلم بذلك عن ظهر الغيب\" — he spoke of that behind the veil of the unseen. Metaphorical: \"أتونا في غابة\" — they came in a dense host (like tangled thickets).\n- Sibawayh Rule: Prepositional Interposition (باب الفصل بين الجار والمجرور) — governing the permissible separation between the preposition and its object for rhetorical emphasis, as in the periodic construction \"فإن ذلك في ظاهره غيبة وفي باطنه ثناء على النفس\" where the circumstantial qualifiers (ẓāhir/bāṭin) are interposed to contrast outward form with inward reality.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'","badge":"Insight"}],"98":[{"arabic":"التاجرين ولكن أوحي إلي أن سبح بحمد ربك وكن من الساجدين واعبد ربك حتى يأتيك اليقين (3) وقيل لسلمان الفارسي أوصنا فقال من استطاع منكم أن يموت حاجا أو غازيا أو عامرا لمسجد ربه فليفعل ولا يموتن تاجرا ولا خائنا فالجواب أن وجه الجمع بين هذه الأخبار تفصيل الأحوال فنقول لسنا نقول التجارة أفضل مطلقا من كل شيء ولكن التجارة إما أن تطلب بها الكفاية أو الثروة أو الزيادة على الكفاية فإن طلب منها الزيادة على الكفاية لاستكثار المال وادخاره لا ليصرف إلى الخيرات والصدقات فهي مذمومة لأنه إقبال على الدنيا التي حبها رأس كل خطيئة فإن كان مع ذلك","english":"Ibn Masʿūd, may God be pleased with him, said: \"Truly I dislike seeing a man idle, neither in the affair of his worldly life nor in the affair of his Hereafter.\"","book_title":"Etiquette of Earning","section_title_ar":"Section 313","section_title_en":"The Virtue of Earning and Trade — Section 313 of the Revival of the Religious Sciences","section_index":313,"anchors":"- Root: كسب (Kasaba)\n  * Lisan / Ayn: \"الكسب: طلب الرزق\" — earning is the seeking of provision; the root denotes acquisition through effort and endeavor.\n  * Al-Raghib (Mufradat): \"الكسب: ما يتحراه الإنسان مما فيه اجتلاب نفع\" — earning is what a man pursues in order to draw benefit; distinguished from iktisāb, which is specifically what one acquires for oneself alone.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"رجل كسوب للمال وكساب\" — a man habitually earning wealth. Metaphorical (Majaz): \"كسبت خيرا واكتسبت شرا\" — earning good (for oneself and others) vs. acquiring evil (for oneself alone), per the Quranic distinction {«لها ما كسبت وعليها ما اكتسبت»}.\n- Root: طلب (Talaba)\n  * Lisan / Ayn: Seeking, searching out; \"الطلب: الفحص عن وجود الشيء\" — the examination and pursuit of a thing's existence.\n  * Al-Raghib (Mufradat): \"الطلب: الفحص عن وجود الشيء، عينا كان أو معنى\" — seeking applies to both corporeal and meaningful objects; \"أطلبت فلانا: إذا أسعفته لما طلب\" — to satisfy another's request.\n  * Al-Zamakhshari (Asas): Literal: \"طلب الشيء طلبا ومطلبا وطلابا\" — to seek with intensity. Metaphorical: \"السراج يطلب أن ينطفيء\" — the lamp \"seeks\" to go out, i.e., is disposed toward it; thus the bird \"seeks\" provision by divine disposition.\n- Root: تجر (Tajara)\n  * Lisan / Ayn: Commerce, trade; \"سُوقاً ذاتَ رِبْحٍ\" — a market of profit.\n  * Al-Raghib (Mufradat): \"التجارة: التصرف في رأس المال طلبا للربح\" — the management of capital seeking profit; Quranically extended to faith: {«هل أدلكم على تجارة تنجيكم من عذاب أليم»}.\n  * Al-Zamakhshari (Asas): Literal: \"فلان يتجر في البز\" — trading in cloth. Metaphorical: \"عليكم بتجارة الآخرة\" — the commerce of the Hereafter; \"ناقة تاجرة: حسنة نافقة\" — a camel that is marketable and in demand, applied metaphorically to that which has currency and value.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication) — The particle innamā restricts the predicate to the subject alone, negating all else. Applied here to the Prophet's statement {«وكن من الساجدين»} — the command to worship is restricted to him as a unique station, not a universal negation of trade; likewise, the conditional structure (law/fa-in) governs the nuanced rulings on when earning is praiseworthy versus blameworthy.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Earning'","badge":"Insight"}]},"wordTiming":{"abdulbasit":{"1":[[1,400,2101],[2,2101,3082],[3,3082,4979],[4,4979,6582],[5,6582,8904],[6,8904,10851]],"2":[[1,350,1173],[2,1173,1903],[3,1903,2772],[4,2772,3710],[5,3710,4094],[6,4094,5124],[7,5124,6140]],"3":[[1,400,1066],[2,1066,2366],[3,2366,4207],[4,4207,5340],[5,5340,6090],[6,6090,6856],[7,6856,8056]],"4":[[1,400,1880],[2,1880,3369],[3,3369,3813],[4,3813,4813],[5,4813,5824],[6,5824,6935],[7,6935,7957],[8,7957,9545]],"5":[[1,350,1186],[2,1186,2074],[3,2074,2487],[4,2487,3406],[5,3406,4583],[6,4583,5430],[7,5430,7185]],"6":[[1,400,1933],[2,1933,3799],[3,3799,4648],[4,4648,5332],[5,5332,6172],[6,6172,7126],[7,7126,7975],[8,7975,9206]],"7":[[1,400,1145],[2,1145,1741],[3,1741,3414],[4,3414,5477],[5,5477,5981],[6,5981,6669],[7,6669,7127],[8,7127,9336]],"8":[[1,400,941],[2,941,1929],[3,1929,3593],[4,3593,4539],[5,4539,5683],[6,5683,6536],[7,6536,8429],[8,8429,9240],[9,9240,10956]],"9":[[1,400,1490],[2,1490,2133],[3,2133,3451],[4,3451,4535],[5,4535,5936],[6,5936,6330],[7,6330,7900]],"10":[[1,350,1396],[2,1396,2854],[3,2854,3277],[4,3277,4218],[5,4218,4746],[6,4746,5570],[7,5570,7394]],"11":[[1,400,1102],[2,1102,2318],[3,2318,2909],[4,2909,3825],[5,3825,4604],[6,4604,5752],[7,5752,6077],[8,6077,7586]],"12":[[1,350,1248],[2,1248,2191],[3,2191,2663],[4,2663,3550],[5,3550,5069]],"13":[[1,350,825],[2,825,2159],[3,2159,2506