5, "arabic": "وَعُيُونٍ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 46, "text": "اُ۟دْخُلُوهَا بِسَلَٰمٍ اٰمِنِينَۖ", "words": [{"id": 1, "arabic": "اُ۟دْخُلُوهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "بِسَلَٰمٍ", "translit": "", "root": ""}, {"id": 3, "arabic": "اٰمِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 47, "text": "وَنَزَعْنَا مَا فِے صُدُورِهِم مِّنْ غِلٍّۖ اِخْوَٰناً عَلَيٰ سُرُرࣲ مُّتَقَٰبِلِينَۖ", "words": [{"id": 1, "arabic": "وَنَزَعْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "صُدُورِهِم", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 6, "arabic": "غِلٍّۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِخْوَٰناً", "translit": "", "root": ""}, {"id": 8, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 9, "arabic": "سُرُرࣲ", "translit": "", "root": ""}, {"id": 10, "arabic": "مُّتَقَٰبِلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 48, "text": "لَا يَمَسُّهُمْ فِيهَا نَصَبࣱۖ وَمَا هُم مِّنْهَا بِمُخْرَجِينَۖ", "words": [{"id": 1, "arabic": "لَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَمَسُّهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "نَصَبࣱۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "هُم", "translit": "", "root": ""}, {"id": 7, "arabic": "مِّنْهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "بِمُخْرَجِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 49, "text": "۞نَبِّۓْ عِبَادِيَ أَنِّيَ أَنَا اَ۬لْغَفُورُ اُ۬لرَّحِيمُ", "words": [{"id": 1, "arabic": "۞نَبِّۓْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عِبَادِيَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنِّيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْغَفُورُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لرَّحِيمُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 50, "text": "وَأَنَّ عَذَابِے هُوَ اَ۬لْعَذَابُ اُ۬لَالِيمُۖ", "words": [{"id": 1, "arabic": "وَأَنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَذَابِے", "translit": "", "root": ""}, {"id": 3, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْعَذَابُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لَالِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 51, "text": "وَنَبِّئْهُمْ عَن ضَيْفِ إِبْرَٰهِيمَ", "words": [{"id": 1, "arabic": "وَنَبِّئْهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَن", "translit": "", "root": ""}, {"id": 3, "arabic": "ضَيْفِ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِبْرَٰهِيمَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 52, "text": "إِذْ دَخَلُواْ عَلَيْهِ فَقَالُواْ سَلَٰماࣰۖ قَالَ إِنَّا مِنكُمْ وَجِلُونَۖ", "words": [{"id": 1, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "دَخَلُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَقَالُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "سَلَٰماࣰۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "مِنكُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَجِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 53, "text": "قَالُواْ لَا تَوْجَلِ اِنَّا نُبَشِّرُكَ بِغُلَٰمٍ عَلِيمࣲۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "", "root": ""}, {"id": 3, "arabic": "تَوْجَ