ot":"غبر"}],"hasIhya":false},{"ayah":61,"text":"فَلَمَّا جَآءَ ءَالَ لُوطٍ ٱلْمُرْسَلُونَ ","translation":"And when the messengers came to the family of Lot,","words":[{"id":1,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":2,"arabic":"جَآءَ","translit":"َءٓāَjg","root":"جيا"},{"id":3,"arabic":"ءَالَ","translit":"َlāَء","root":"اول"},{"id":4,"arabic":"لُوطٍ","translit":"ٍṭwُl","root":""},{"id":5,"arabic":"ٱلْمُرْسَلُونَ","translit":"َnwُlَsْrُmْlٱ","root":"رسل"}],"hasIhya":false},{"ayah":62,"text":"قَالَ إِنَّكُمْ قَوْمٌ مُّنكَرُونَ ","translation":"He said, \"Indeed, you are people unknown.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"إِنَّكُمْ","translit":"ْmُkَّnِiʾ","root":""},{"id":3,"arabic":"قَوْمٌ","translit":"ٌmْwَq","root":"قوم"},{"id":4,"arabic":"مُّنكَرُونَ","translit":"َnwُrَknُّm","root":"نكر"}],"hasIhya":false},{"ayah":63,"text":"قَالُوا۟ بَلْ جِئْنَٰكَ بِمَا كَانُوا۟ فِيهِ يَمْتَرُونَ ","translation":"They said, \"But we have come to you with that about which they were disputing,","words":[{"id":1,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":2,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":3,"arabic":"جِئْنَٰكَ","translit":"َkَٰnْyʾِjg","root":"جيا"},{"id":4,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":5,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":6,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":7,"arabic":"يَمْتَرُونَ","translit":"َnwُrَtْmَy","root":"مري"}],"hasIhya":false},{"ayah":64,"text":"وَأَتَيْنَٰكَ بِٱلْحَقِّ وَإِنَّا لَصَٰدِقُونَ ","translation":"And we have come to you with truth, and indeed, we are truthful.","words":[{"id":1,"arabic":"وَأَتَيْنَٰكَ","translit":"َkَٰnْyَtَaʾَw","root":"اتي"},{"id":2,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":3,"arabic":"وَإِنَّا","translit":"āَّnِiʾَw","root":""},{"id":4,"arabic":"لَصَٰدِقُونَ","translit":"َnwُqِdَٰṣَl","root":"صدق"}],"hasIhya":false},{"ayah":65,"text":"فَأَ