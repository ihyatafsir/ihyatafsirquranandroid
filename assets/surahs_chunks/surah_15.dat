arration": "warsh"}, {"surah": 15, "ayah": 48, "text": "لَا يَمَسُّهُمْ فِيهَا نَصَبࣱۖ وَمَا هُم مِّنْهَا بِمُخْرَجِينَۖ", "words": [{"id": 1, "arabic": "لَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَمَسُّهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "نَصَبࣱۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "هُم", "translit": "", "root": ""}, {"id": 7, "arabic": "مِّنْهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "بِمُخْرَجِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 49, "text": "۞نَبِّۓْ عِبَادِيَ أَنِّيَ أَنَا اَ۬لْغَفُورُ اُ۬لرَّحِيمُ", "words": [{"id": 1, "arabic": "۞نَبِّۓْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عِبَادِيَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنِّيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْغَفُورُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لرَّحِيمُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 50, "text": "وَأَنَّ عَذَابِے هُوَ اَ۬لْعَذَابُ اُ۬لَالِيمُۖ", "words": [{"id": 1, "arabic": "وَأَنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَذَابِے", "translit": "", "root": ""}, {"id": 3, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْعَذَابُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لَالِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 51, "text": "وَنَبِّئْهُمْ عَن ضَيْفِ إِبْرَٰهِيمَ", "words": [{"id": 1, "arabic": "وَنَبِّئْهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَن", "translit": "", "root": ""}, {"id": 3, "arabic": "ضَيْفِ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِبْرَٰهِيمَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 52, "text": "إِذْ دَخَلُواْ عَلَيْهِ فَقَالُواْ سَلَٰماࣰۖ قَالَ إِنَّا مِنكُمْ وَجِلُونَۖ", "words": [{"id": 1, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "دَخَلُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَقَالُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "سَلَٰماࣰۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "مِنكُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَجِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 53, "text": "قَالُواْ لَا تَوْجَلِ اِنَّا نُبَشِّرُكَ بِغُلَٰمٍ عَلِيمࣲۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "", "root": ""}, {"id": 3, "arabic": "تَوْجَلِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِنَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "نُبَشِّرُكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِغُلَٰمٍ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلِيمࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 54, "text": "قَالَ أَبَشَّرْتُمُونِے عَلَيٰٓ أَن مَّسَّنِيَ اَ۬لْكِبَرُ فَبِمَ تُبَشِّرُونِۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَبَشَّرْتُمُونِے", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "", "root": ""}, {"id": 5, "arabic": "مَّسَّنِيَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْكِبَرُ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَبِمَ", "translit": "", "root": ""}, {"id": 8, "arabic": "تُبَشِّرُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 55, "text": "قَالُواْ بَشَّرْنَٰكَ بِالْحَقِّ فَلَا تَكُن مِّنَ اَ۬لْقَٰنِطِينَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَشَّرْنَٰكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِالْحَقِّ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 5, "arabic": "تَكُن", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْقَٰنِطِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 56, "text": "قَالَ وَمَنْ يَّقْنَطُ مِن رَّحْمَةِ رَبِّهِۦٓ إِلَّا اَ۬لضَّآلُّونَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَمَنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَّقْنَطُ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِن", "translit": "", "root": ""}, {"id": 5, "arabic": "رَّحْمَةِ", "translit": "", "root": ""}, {"id": 6, "arabic": "رَبِّهِۦٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لضَّآلُّونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 57, "text": "قَالَ فَمَا خَطْبُكُمُۥٓ أَيُّهَا اَ۬لْمُرْسَلُونَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 3, "arabic": "خَطْبُكُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَيُّهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْمُرْسَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 58, "text": "قَالُوٓاْ إِنَّآ أُرْسِلْنَآ إِلَيٰ قَوْمࣲ مُّجْرِمِينَ", "words": [{"id": 1, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُرْسِلْنَآ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَوْمࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُّجْرِمِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 59, "text": "إِلَّآ ءَالَ لُوطٍۖ اِنَّا لَمُنَجُّوهُمُۥٓ أَجْمَعِينَ", "words": [{"id": 1, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "ءَالَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لُوطٍۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِنَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "لَمُنَجُّوهُمُۥٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَجْمَعِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 60, "text": "إِلَّا اَ۪مْرَأَتَهُۥ قَدَّرْنَآ إِنَّهَا لَمِنَ اَ۬لْغَٰبِرِينَۖ", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۪مْرَأَتَهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَدَّرْنَآ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "لَمِنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْغَٰبِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 61, "text": "فَلَمَّا جَآءَ ا۟لَ لُوطٍ اِ۬لْمُرْسَلُونَ", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ا۟لَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لُوطٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْمُرْسَلُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 62, "text": "قَالَ إِنَّكُمْ قَوْمࣱ مُّنكَرُونَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَوْمࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "مُّنكَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 63, "text": "قَالُواْ بَلْ جِئْنَٰكَ بِمَا كَانُواْ فِيهِ يَمْتَرُونَ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 3, "arabic": "جِئْنَٰكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَمْتَرُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 64, "text": "وَأَتَيْنَٰكَ بِالْحَقِّ وَإِنَّا لَصَٰدِقُونَۖ", "words": [{"id": 1, "arabic": "وَأَتَيْنَٰكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِالْحَقِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَإِنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "لَصَٰدِقُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 65, "text": "فَاسْرِ بِأَهْلِكَ بِقِطْعࣲ مِّنَ اَ۬ليْلِ وَاتَّبِعَ اَدْبَٰرَهُمْ وَلَا يَلْتَفِتْ مِنكُمُۥٓ أَحَدࣱ وَامْضُواْ حَيْثُ تُومَرُونَۖ", "words": [{"id": 1, "arabic": "فَاسْرِ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِأَهْلِكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِقِطْعࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬ليْلِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَاتَّبِعَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَدْبَٰرَهُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 9, "arabic": "يَلْتَفِتْ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِنكُمُۥٓ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَحَدࣱ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَامْضُواْ", "translit": "", "root": ""}, {"id": 13, "arabic": "حَيْثُ", "translit": "", "root": ""}, {"id": 14, "arabic": "تُومَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 66, "text": "وَقَضَيْنَآ إِلَيْهِ ذَٰلِكَ اَ۬لَامْرَ أَنَّ دَابِرَ هَٰٓؤُلَآءِ مَقْطُوعࣱ مُّصْبِحِينَۖ", "words": [{"id": 1, "arabic": "وَقَضَيْنَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَيْهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لَامْرَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَنَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "دَابِرَ", "translit": "", "root": ""}, {"id": 7, "arabic": "هَٰٓؤُلَآءِ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَقْطُوعࣱ", "translit": "", "root": ""}, {"id": 9, "arabic": "مُّصْبِحِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 67, "text": "وَجَآءَ اهْلُ اُ۬لْمَدِينَةِ يَسْتَبْشِرُونَۖ", "words": [{"id": 1, "arabic": "وَجَآءَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اهْلُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْمَدِينَةِ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَسْتَبْشِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 68, "text": "قَالَ إِنَّ هَٰٓؤُلَآءِ ضَيْفِے فَلَا تَفْضَحُونِۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "هَٰٓؤُلَآءِ", "translit": "", "root": ""}, {"id": 4, "arabic": "ضَيْفِے", "translit": "", "root": ""}, {"id": 5, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 6, "arabic": "تَفْضَحُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 69, "text": "وَاتَّقُواْ اُ۬للَّهَ وَلَا تُخْزُونِۖ", "words": [{"id": 1, "arabic": "وَاتَّقُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬للَّهَ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 4, "arabic": "تُخْزُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 70, "text": "قَالُوٓاْ أَوَلَمْ نَنْهَكَ عَنِ اِ۬لْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَوَلَمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَنْهَكَ", "translit": "", "r