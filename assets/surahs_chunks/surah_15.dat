:"لَظَٰلِمِينَ","translit":"َnyِmِlَٰẓَl","root":"ظلم"}],"hasIhya":false},{"ayah":79,"text":"فَٱنتَقَمْنَا مِنْهُمْ وَإِنَّهُمَا لَبِإِمَامٍ مُّبِينٍ ","translation":"So We took retribution from them, and indeed, both [cities] are on a clear highway.","words":[{"id":1,"arabic":"فَٱنتَقَمْنَا","translit":"āَnْmَqَtnٱَf","root":"نقم"},{"id":2,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":3,"arabic":"وَإِنَّهُمَا","translit":"āَmُhَّnِiʾَw","root":""},{"id":4,"arabic":"لَبِإِمَامٍ","translit":"ٍmāَmِiʾِbَl","root":"امم"},{"id":5,"arabic":"مُّبِينٍ","translit":"ٍnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":80,"text":"وَلَقَدْ كَذَّبَ أَصْحَٰبُ ٱلْحِجْرِ ٱلْمُرْسَلِينَ ","translation":"And certainly did the companions of al-Ḥijr[1] [i.e., the Thamūd] deny the messengers.","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"كَذَّبَ","translit":"َbَّhdَk","root":"كذب"},{"id":3,"arabic":"أَصْحَٰبُ","translit":"ُbَٰḥْṣَaʾ","root":"صحب"},{"id":4,"arabic":"ٱلْحِجْرِ","translit":"ِrْjgِḥْlٱ","root":"حجر"},{"id":5,"arabic":"ٱلْمُرْسَلِينَ","translit":"َnyِlَsْrُmْlٱ","root":"رسل"}],"hasIhya":false},{"ayah":81,"text":"وَءَاتَيْنَٰهُمْ ءَايَٰتِنَا فَكَانُوا۟ عَنْهَا مُعْرِضِينَ ","translation":"And We gave them Our signs, but from them they were turning away.","words":[{"id":1,"arabic":"وَءَاتَيْنَٰهُمْ","translit":"ْmُhَٰnْyَtāَءَw","root":"اتي"},{"id":2,"arabic":"ءَايَٰتِنَا","translit":"āَnِtَٰyāَء","root":"ايي"},{"id":3,"arabic":"فَكَانُوا۟","translit":"۟āwُnāَkَf","root":"كون"},{"id":4,"arabic":"عَنْهَا","translit":"āَhْnَʿع","root":""},{"id":5,"arabic":"مُعْرِضِينَ","translit":"َnyِḍِrْʿعُm","root":"عرض"}],"hasIhya":false},{"ayah":82,"text":"وَكَانُوا۟ يَنْحِتُونَ مِنَ ٱلْجِبَالِ بُيُوتًا ءَامِنِينَ ","translation":"And they used to carve from the mountains, houses, feeling secure.","words":[{"id":1,"arabic":"وَكَانُوا۟","translit":"۟āwُnāَkَw","root":"كون"},{"id":2,"arabic":"يَنْحِتُونَ","translit":"َnwُtِḥْnَy","root":"نحت"},{"id":3,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":4,"arabic":"ٱلْجِبَالِ","translit":"ِlāَbِjgْlٱ","root":"جبل"},{"id":5,"arabic":"بُيُوتًا","translit":"āًtwُyُb","root":"بيت"},{"id":6,"arabic":"ءَامِنِينَ","translit":"َnyِnِmāَء","root":"امن"}],"hasIhya":false},{"ayah":83,"text":"فَأَخَذَتْهُمُ ٱلصَّيْحَةُ مُصْبِحِينَ ","translation":"But the shriek seized them at early morning,","words":[{"id":1,"arabic":"فَأَخَذَتْهُمُ","translit":"ُmُhْtَhdَhkَaʾَf","root":"اخذ"},{"id":2,"arabic":"ٱلصَّيْحَةُ","translit":"ُẗَḥْyَّṣlٱ","root":"صيح"},{"id":3,"arabic":"مُصْبِحِينَ","translit":"َnyِḥِbْṣُm","root":"صبح"}],"hasIhya":false},{"ayah":84,"text":"فَمَآ أَغْنَىٰ عَنْهُم مَّا كَانُوا۟ يَكْسِبُونَ ","translation":"So nothing availed them [from] what they used to earn.","words":[{"id":1,"arabic":"فَمَآ","translit":"ٓāَmَf","root":""},{"id":2,"arabic":"أَغْنَىٰ","translit":"ٰàَnْغَaʾ","root":"غني"},{"id":3,"arabic":"عَنْهُم","translit":"mُhْnَʿع","root":""},{"id":4,"arabic":"مَّا","translit":"āَّm","root":""},{"id":5,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":6,"arabic":"يَكْسِبُونَ","translit":"َnwُbِsْkَy","root":"كسب"}],"hasIhya":false},{"ayah":85,"text":"وَمَا خَلَقْنَا ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَآ إِلَّا بِٱلْحَقِّۗ وَإِنَّ ٱلسَّاعَةَ لَءَاتِيَةٌۖ فَٱصْفَحِ ٱلصَّفْحَ ٱلْجَمِيلَ ","translation":"And We have not created the heavens and earth and that between them except in truth. And indeed, the Hour is coming; so forgive with gracious forgiveness.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"خَلَقْنَا","translit":"āَnْqَlَhk","root":"خلق"},{"id":3,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":4,"arabic":"وَٱلْأَرْضَ","translit":"َḍْrَaʾْlٱَw","root":"ارض"},{"id":5,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":6,"arabic":"بَيْنَهُمَآ","translit":"ٓāَmُhَnْyَb","root":"بين"},{"id":7,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":8,"arabic":"بِٱل