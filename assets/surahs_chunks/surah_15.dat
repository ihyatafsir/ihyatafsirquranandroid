nslit": "", "root": ""}, {"id": 4, "arabic": "عَلَيَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُسْتَقِيمٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 42, "text": "اِنَّ عِبَادِے لَيْسَ لَكَ عَلَيْهِمْ سُلْطَٰنٌ اِلَّا مَنِ اِ۪تَّبَعَكَ مِنَ اَ۬لْغَاوِينَۖ", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "عِبَادِے", "translit": "", "root": ""}, {"id": 3, "arabic": "لَيْسَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيْهِمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "سُلْطَٰنٌ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "مَنِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۪تَّبَعَكَ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لْغَاوِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 43, "text": "وَإِنَّ جَهَنَّمَ لَمَوْعِدُهُمُۥٓ أَجْمَعِينَ", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "جَهَنَّمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَمَوْعِدُهُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَجْمَعِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 44, "text": "لَهَا سَبْعَةُ أَبْوَٰبࣲۖ لِّكُلِّ بَابࣲ مِّنْهُمْ جُزْءࣱ مَّقْسُومٌۖ", "words": [{"id": 1, "arabic": "لَهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "سَبْعَةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَبْوَٰبࣲۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِّكُلِّ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَابࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّنْهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "جُزْءࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَّقْسُومٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 45, "text": "اِنَّ اَ۬لْمُتَّقِينَ فِے جَنَّٰتࣲ وَعُيُونٍ", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْمُتَّقِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "جَنَّٰتࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَعُيُونٍ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 46, "text": "اُ۟دْخُلُوهَا بِسَلَٰمٍ اٰمِنِينَۖ", "words": [{"id": 1, "arabic": "اُ۟دْخُلُوهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "بِسَلَٰمٍ", "translit": "", "root": ""}, {"id": 3, "arabic": "اٰمِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 47, "text": "وَنَزَعْنَا مَا فِے صُدُورِهِم مِّنْ غِلٍّۖ اِخْوَٰناً عَلَيٰ سُرُرࣲ مُّتَقَٰبِلِينَۖ", "words": [{"id": 1, "arabic": "وَنَزَعْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "صُدُورِهِم", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 6, "arabic": "غِلٍّۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِخْوَٰناً", "translit": "", "root": ""}, {"id": 8, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 9, "arabic": "سُرُرࣲ", "translit": "", "root": ""}, {"id": 10, "arabic": "مُّتَقَٰبِلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 48, "text": "لَا يَمَسُّهُمْ فِيهَا نَصَبࣱۖ وَمَا هُم مِّنْهَا بِمُخْرَجِينَۖ", "words": [{"id": 1, "arabic": "لَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَمَسُّهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "نَصَبࣱۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "هُم", "translit": "", "root": ""}, {"id": 7, "arabic": "مِّنْهَا", "translit"