lit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لَامْرَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَنَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "دَابِرَ", "translit": "", "root": ""}, {"id": 7, "arabic": "هَٰٓؤُلَآءِ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَقْطُوعࣱ", "translit": "", "root": ""}, {"id": 9, "arabic": "مُّصْبِحِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 67, "text": "وَجَآءَ اهْلُ اُ۬لْمَدِينَةِ يَسْتَبْشِرُونَۖ", "words": [{"id": 1, "arabic": "وَجَآءَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اهْلُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْمَدِينَةِ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَسْتَبْشِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 68, "text": "قَالَ إِنَّ هَٰٓؤُلَآءِ ضَيْفِے فَلَا تَفْضَحُونِۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "هَٰٓؤُلَآءِ", "translit": "", "root": ""}, {"id": 4, "arabic": "ضَيْفِے", "translit": "", "root": ""}, {"id": 5, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 6, "arabic": "تَفْضَحُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 69, "text": "وَاتَّقُواْ اُ۬للَّهَ وَلَا تُخْزُونِۖ", "words": [{"id": 1, "arabic": "وَاتَّقُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬للَّهَ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 4, "arabic": "تُخْزُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 70, "text": "قَالُوٓاْ أَوَلَمْ نَنْهَكَ عَنِ اِ۬لْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَوَلَمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَنْهَكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَنِ", "translit": "", "root": ""}, {"id": 5, "arabi