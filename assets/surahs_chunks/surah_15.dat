": "اُ۬لْوَٰرِثُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 24, "text": "وَلَقَدْ عَلِمْنَا اَ۬لْمُسْتَقْدِمِينَ مِنكُمْ وَلَقَدْ عَلِمْنَا اَ۬لْمُسْتَٰخِرِينَۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلِمْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْمُسْتَقْدِمِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنكُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلِمْنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْمُسْتَٰخِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 25, "text": "وَإِنَّ رَبَّكَ هُوَ يَحْشُرُهُمُۥٓۖ إِنَّهُۥ حَكِيمٌ عَلِيمࣱۖ", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَحْشُرُهُمُۥٓۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "حَكِيمٌ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلِيمࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 26, "text": "وَلَقَدْ خَلَقْنَا اَ۬لِانسَٰنَ مِن صَلْصَٰلࣲ مِّنْ حَمَإࣲ مَّسْنُونࣲۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لِانسَٰنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِن", "translit": "", "root": ""}, {"id": 5, "arabic": "صَلْصَٰلࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 7, "arabic": "حَمَإࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَّسْنُونࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 27, "text": "وَالْجَآنَّ خَلَقْنَٰهُ مِن قَبْلُ مِن نّ۪ارِ اِ۬لسَّمُومِۖ", "words": [{"id": 1, "arabic": "وَالْجَآنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْنَٰهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَبْلُ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "نّ۪ارِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لسَّمُومِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 28, "text": "وَإِذْ قَالَ رَبُّكَ لِلْمَلَٰٓئِكَةِ إِنِّے خَٰلِقُۢ بَشَراࣰ مِّن صَلْصَٰلࣲ مِّنْ حَمَإࣲ مَّسْنُونࣲ‏", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبُّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِلْمَلَٰٓئِكَةِ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 6, "arabic": "خَٰلِقُۢ", "translit": "", "root": ""}, {"id": 7, "arabic": "بَشَراࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 9, "arabic": "صَلْصَٰلࣲ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 11, "arabic": "حَمَإࣲ", "translit": "", "root": ""}, {"id": 12, "arabic": "مَّسْنُونࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 29, "text": "فَإِذَا سَوَّيْتُهُۥ وَنَفَخْتُ فِيهِ مِن رُّوحِے فَقَعُواْ لَهُۥ سَٰجِدِينَۖ", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "سَوَّيْتُهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَنَفَخْتُ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "رُّوحِے", "translit": "", "root": ""}, {"id": 7, "arabic": "فَقَعُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 9, "arabic": "سَٰجِدِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 30, "text": "فَسَجَدَ اَ۬لْمَلَٰٓئِكَةُ كُلُّهُمُۥٓ أَجْمَعُونَ", "words": [{"id": 1, "arabic": "فَسَجَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْمَلَٰٓئِكَةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "كُلُّهُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَجْمَعُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 31, "text": "إِلَّآ إِبْلِيسَ أَب۪يٰٓ أَنْ يَّكُونَ مَعَ اَ۬لسَّٰجِدِينَۖ", "words": [{"id": 1, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِبْلِيسَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَب۪يٰٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَّكُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَعَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لسَّٰجِدِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 32, "text": "قَالَ يَٰٓإِبْلِيسُ مَا لَكَ أَلَّا تَكُونَ مَعَ اَ۬لسَّٰجِدِينَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰٓإِبْلِيسُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "لَكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَلَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "تَكُونَ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَعَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لسَّٰجِدِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 33, "text": "قَالَ لَمَ اَكُن لِّأَسْجُدَ لِبَشَرٍ خَلَقْتَهُۥ مِن صَلْصَٰلࣲ مِّنْ حَمَإࣲ مَّسْنُونࣲۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَكُن", "translit": "", "root": ""}, {"id": 4, "arabic": "لِّأَسْجُدَ", "translit": "", "root": ""}, {"