ot":"قطع"},{"id":9,"arabic":"مُّصْبِحِينَ","translit":"َnyِḥِbْṣُّm","root":"صبح"}],"hasIhya":false},{"ayah":67,"text":"وَجَآءَ أَهْلُ ٱلْمَدِينَةِ يَسْتَبْشِرُونَ ","translation":"And the people of the city came rejoicing.[1]","words":[{"id":1,"arabic":"وَجَآءَ","translit":"َءٓāَjgَw","root":"جيا"},{"id":2,"arabic":"أَهْلُ","translit":"ُlْhَaʾ","root":"اهل"},{"id":3,"arabic":"ٱلْمَدِينَةِ","translit":"ِẗَnyِdَmْlٱ","root":"مدن"},{"id":4,"arabic":"يَسْتَبْشِرُونَ","translit":"َnwُrِhsْbَtْsَy","root":"بشر"}],"hasIhya":false},{"ayah":68,"text":"قَالَ إِنَّ هَٰٓؤُلَآءِ ضَيْفِى فَلَا تَفْضَحُونِ ","translation":"[Lot] said, \"Indeed, these are my guests, so do not shame me.","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":3,"arabic":"هَٰٓؤُلَآءِ","translit":"ِءٓāَlُwʾَٰٓh","root":""},{"id":4,"arabic":"ضَيْفِى","translit":"àِfْyَḍ","root":"ضيف"},{"id":5,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":6,"arabic":"تَفْضَحُونِ","translit":"ِnwُḥَḍْfَt","root":"فضح"}],"hasIhya":false},{"ayah":69,"text":"وَٱتَّقُوا۟ ٱللَّهَ وَلَا تُخْزُونِ ","translation":"And fear Allāh and do not disgrace me.\"","words":[{"id":1,"arabic":"وَٱتَّقُوا۟","translit":"۟āwُqَّtٱَw","root":"وقي"},{"id":2,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":3,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":4,"arabic":"تُخْزُونِ","translit":"ِnwُzْhkُt","root":"خزي"}],"hasIhya":false},{"ayah":70,"text":"قَالُوٓا۟ أَوَلَمْ نَنْهَكَ عَنِ ٱلْعَٰلَمِينَ ","translation":"They said, \"Have we not forbidden you from [protecting] people?\"","words":[{"id":1,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":2,"arabic":"أَوَلَمْ","translit":"ْmَlَwَaʾ","root":""},{"id":3,"arabic":"نَنْهَكَ","translit":"َkَhْnَn","root":"نهي"},{"id":4,"arabic":"عَنِ","translit":"ِnَʿع","root":""},{"id":5,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":71,"text":"قَالَ