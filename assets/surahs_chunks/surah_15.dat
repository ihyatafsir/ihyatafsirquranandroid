َابࣱ مَّعْلُومࣱۖ", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَهْلَكْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَرْيَةٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَهَا", "translit": "", "root": ""}, {"id": 7, "arabic": "كِتَابࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَّعْلُومࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 5, "text": "مَّا تَسْبِقُ مِنُ ا۟مَّةٍ اَجَلَهَا وَمَا يَسْتَٰخِرُونَۖ", "words": [{"id": 1, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَسْبِقُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنُ", "translit": "", "root": ""}, {"id": 4, "arabic": "ا۟مَّةٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَجَلَهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "يَسْتَٰخِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 6, "text": "وَقَالُواْ يَٰٓأَيُّهَا اَ۬لذِے نُزِّلَ عَلَيْهِ اِ۬لذِّكْرُ إِنَّكَ لَمَجْنُونࣱ‏", "words": [{"id": 1, "arabic": "وَقَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰٓأَيُّهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 4, "arabic": "نُزِّلَ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لذِّكْرُ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنَّكَ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَمَجْنُونࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 7, "text": "لَّوْمَا تَاتِينَا بِالْمَلَٰٓئِكَةِ إِن كُنتَ مِنَ اَ۬لصَّٰدِقِينَۖ", "words": [{"id": 1, "arabic": "لَّوْمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَاتِينَا", "translit": "", "root": ""}, {"id": 3, "arabic": "بِالْمَلَٰٓئِكَةِ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِن", "translit": "", "root": ""}, {"id": 5, "arabic": "كُنتَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لصَّٰدِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 8, "text": "مَا تَنَزَّلُ اُ۬لْمَلَٰٓئِكَةُ إِلَّا بِالْحَقِّۖ وَمَا كَانُوٓاْ إِذاࣰ مُّنظَرِينَۖ", "words": [{"id": 1, "arabic": "مَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَنَزَّلُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْمَلَٰٓئِكَةُ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "بِالْحَقِّۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "كَانُوٓاْ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِذاࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "مُّنظَرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 9, "text": "إِنَّا نَحْنُ نَزَّلْنَا اَ۬لذِّكْرَۖ وَإِنَّا لَهُۥ لَحَٰفِظُونَۖ", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَزَّلْنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لذِّكْرَۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَإِنَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَحَٰفِظُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 10, "text": "وَلَقَدَ اَرْسَلْنَا مِن قَبْلِكَ فِے شِيَعِ اِ۬لَاوَّلِينَۖ", "words": [{"id": 1, "arabic": "وَلَقَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَرْسَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَبْلِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "شِيَعِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لَاوَّلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 11, "text": "وَمَا يَاتِيهِم مِّن رَّسُولٍ اِلَّا كَانُواْ بِهِۦ يَسْتَهْزِءُونَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَاتِيهِم", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 4, "arabic": "رَّسُولٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَسْتَهْزِءُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 12, "text": "كَذَٰلِكَ نَسْلُكُهُۥ فِے قُلُوبِ اِ۬لْمُجْرِمِينَ", "words": [{"id": 1, "arabic": "كَذَٰلِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَسْلُكُهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "قُلُوبِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْمُجْرِمِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 13, "text": "لَا يُومِنُونَ بِهِۦ وَقَدْ خَلَتْ سُنَّةُ اُ۬لَاوَّلِينَۖ", "words": [{"id": 1, "arabic": "لَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يُومِنُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَقَدْ", "translit": "", "root": ""}, {"id": 5, "arabic": "خَلَتْ", "translit": "", "root": ""}, {"id": 6, "arabic": "سُنَّةُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لَاوَّلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 14, "text": "وَلَوْ فَتَحْنَا عَلَيْهِم بَاباࣰ مِّنَ اَ۬لسَّمَآءِ فَظَلُّواْ فِيهِ يَعْرُجُونَ", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَتَحْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْهِم", "translit": "", "root": ""}, {"id": 4, "arabic": "بَاباࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَظَلُّواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 9, "arabic": "يَعْرُجُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 15, "text": "لَقَالُوٓاْ إِنَّمَا سُكِّرَتَ اَبْصَٰرُنَا بَلْ نَحْنُ قَوْمࣱ مَّسْحُورُونَۖ", "words": [{"id": 1, "arabic": "لَقَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّمَا", "translit": "", "root": ""}, {"id": 3, "arabic": "سُكِّرَتَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَبْصَٰرُنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 6, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَوْمࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَّسْحُورُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 16, "text": "وَلَقَدْ جَعَلْنَا فِے اِ۬لسَّمَآءِ بُرُوجاࣰ وَزَيَّنَّٰهَا لِلنَّٰظِرِينَ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "جَعَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 5, "arabic": "بُرُوجاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَزَيَّنَّٰهَا", "translit": "", "root": ""}, {"id": 7, "arabic": "لِلنَّٰظِرِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 17, "text": "وَحَفِظْنَٰهَا مِن كُلِّ شَيْطَٰنࣲ رَّجِيمٍ", "words": [{"id": 1, "arabic": "وَحَفِظْنَٰهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مِن", "translit": "", "root": ""}, {"id": 3, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 4, "arabic": "شَيْطَٰنࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "رَّجِيمٍ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 18, "text": "اِلَّا مَنِ اِ۪سْتَرَقَ اَ۬لسَّمْعَ فَأَتْبَعَهُۥ شِهَابࣱ مُّبِينࣱۖ", "words": [{"id": 1, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۪سْتَرَقَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لسَّمْعَ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَأَتْبَعَهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "شِهَابࣱ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّبِينࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 19, "text": "وَالَارْضَ مَدَدْنَٰهَا وَأَلْقَيْنَا فِيهَا رَوَٰسِيَ وَأَنۢبَتْنَا فِيهَا مِن كُلِّ شَےْءࣲ مَّوْزُونࣲ‏", "words": [{"id": 1, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَدَدْنَٰهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "وَأَلْقَيْنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "رَوَٰسِيَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَنۢبَتْنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "", "root": ""}, {"id": 9, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 10, "arabic": "شَےْءࣲ", "translit": "", "root": ""}, {"id": 11, "arabic": "مَّوْزُونࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 20, "text": "وَجَعَلْنَا لَكُمْ فِيهَا مَعَٰيِشَۖ وَمَن لَّسْتُمْ لَهُۥ بِرَٰزِقِينَۖ", "words": [{"id": 1, "arabic": "وَجَعَلْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مَعَٰيِشَۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَن", "translit": "", "root": ""}, {"id": 6, "ara