: 15, "ayah": 12, "text": "كَذَٰلِكَ نَسْلُكُهُۥ فِے قُلُوبِ اِ۬لْمُجْرِمِينَ", "words": [{"id": 1, "arabic": "كَذَٰلِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَسْلُكُهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "قُلُوبِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْمُجْرِمِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 13, "text": "لَا يُومِنُونَ بِهِۦ وَقَدْ خَلَتْ سُنَّةُ اُ۬لَاوَّلِينَۖ", "words": [{"id": 1, "arabic": "لَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يُومِنُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَقَدْ", "translit": "", "root": ""}, {"id": 5, "arabic": "خَلَتْ", "translit": "", "root": ""}, {"id": 6, "arabic": "سُنَّةُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لَاوَّلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 14, "text": "وَلَوْ فَتَحْنَا عَلَيْهِم بَاباࣰ مِّنَ اَ۬لسَّمَآءِ فَظَلُّواْ فِيهِ يَعْرُجُونَ", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَتَحْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْهِم", "translit": "", "root": ""}, {"id": 4, "arabic": "بَاباࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَظَلُّواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 9, "arabic": "يَعْرُجُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 15, "text": "لَقَالُوٓاْ إِنَّمَا سُكِّرَتَ اَبْصَٰرُنَا بَلْ نَحْنُ قَوْمࣱ مَّسْحُورُونَۖ", "words": [{"id": 1, "arabic": "لَقَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّمَا", "translit": "", "root": ""}, {"id": 3, "arabic": "سُكِّرَتَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَبْصَٰرُنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 6, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَوْمࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَّسْحُورُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 16, "text": "وَلَقَدْ جَعَلْنَا فِے اِ۬لسَّمَآءِ بُرُوجاࣰ وَزَيَّنَّٰهَا لِلنَّٰظِرِينَ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "جَعَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 5, "arabic": "بُرُوجاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَزَيَّنَّٰهَا", "translit": "", "root": ""}, {"id": 7, "arabic": "لِلنَّٰظِرِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 17, "text": "وَحَفِظْنَٰهَا مِن كُلِّ شَيْطَٰنࣲ رَّجِيمٍ", "words": [{"id": 1, "arabic": "وَحَفِظْنَٰهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مِن", "translit": "", "root": ""}, {"id": 3, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 4, "arabic": "شَيْطَٰنࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "رَّجِيمٍ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 18, "text": "اِلَّا مَنِ اِ۪سْتَرَقَ اَ۬لسَّمْعَ فَأَتْبَعَهُۥ شِهَابࣱ مُّبِينࣱۖ", "words": [{"id": 1, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۪سْتَرَقَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لسَّمْعَ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَأَتْبَعَهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "شِهَابࣱ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّبِينࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 19, "text": "وَالَارْضَ مَدَدْنَٰهَا وَأَلْقَيْنَا فِيهَا رَوَٰسِيَ وَ