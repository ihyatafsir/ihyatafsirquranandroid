: "warsh"}, {"surah": 15, "ayah": 80, "text": "وَلَقَدْ كَذَّبَ أَصْحَٰبُ اُ۬لْحِجْرِ اِ۬لْمُرْسَلِينَۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَذَّبَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَصْحَٰبُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْحِجْرِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْمُرْسَلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 81, "text": "وَءَاتَيْنَٰهُمُۥٓ ءَايَٰتِنَا فَكَانُواْ عَنْهَا مُعْرِضِينَۖ", "words": [{"id": 1, "arabic": "وَءَاتَيْنَٰهُمُۥٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "ءَايَٰتِنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فَكَانُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَنْهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "مُعْرِضِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 82, "text": "وَكَانُواْ يَنْحِتُونَ مِنَ اَ۬لْجِبَالِ بُيُوتاً اٰمِنِينَۖ", "words": [{"id": 1, "arabic": "وَكَانُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَنْحِتُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْجِبَالِ", "translit": "", "root": ""}, {"id": 5, "arabic": "بُيُوتاً", "translit": "", "root": ""}, {"id": 6, "arabic": "اٰمِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 83, "text": "فَأَخَذَتْهُمُ اُ۬لصَّيْحَةُ مُصْبِحِينَۖ", "words": [{"id": 1, "arabic": "فَأَخَذَتْهُمُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لصَّيْحَةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مُصْبِحِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 84, "text": "فَمَآ أَغْن۪يٰ عَنْهُم مَّا كَانُواْ يَكْسِبُونَۖ", "words": [{"id": 1, "arabic": "فَمَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَغْن۪يٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَنْهُم", "translit": "",