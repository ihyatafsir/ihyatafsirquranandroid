{"surah": 15, "verses": [{"ayah": 1, "text": "الٓرۚ تِلْكَ ءَايَٰتُ ٱلْكِتَٰبِ وَقُرْءَانٍ مُّبِينٍ ", "translation": "Alif, Lām, Rā.[1] These are the verses of the Book and a clear Qur’ān [i.e., recitation].", "words": [{"id": 1, "arabic": "الٓر", "translit": "rٓlā", "root": ""}, {"id": 2, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 3, "arabic": "ءَايَٰتُ", "translit": "ُtَٰyāَء", "root": "ايي"}, {"id": 4, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "وَقُرْءَانٍ", "translit": "ٍnāَءْrُqَw", "root": "قرا"}, {"id": 6, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 2, "text": "رُّبَمَا يَوَدُّ ٱلَّذِينَ كَفَرُوا۟ لَوْ كَانُوا۟ مُسْلِمِينَ ", "translation": "Perhaps those who disbelieve will wish[1] that they had been Muslims.", "words": [{"id": 1, "arabic": "رُّبَمَا", "translit": "āَmَbُّr", "root": ""}, {"id": 2, "arabic": "يَوَدُّ", "translit": "ُّdَwَy", "root": "ودد"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 5, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 6, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 7, "arabic": "مُسْلِمِينَ", "translit": "َnyِmِlْsُm", "root": "سلم"}], "hasIhya": true}, {"ayah": 3, "text": "ذَرْهُمْ يَأْكُلُوا۟ وَيَتَمَتَّعُوا۟ وَيُلْهِهِمُ ٱلْأَمَلُۖ فَسَوْفَ يَعْلَمُونَ ", "translation": "Let them eat and enjoy themselves and be diverted by [false] hope, for they are going to know.", "words": [{"id": 1, "arabic": "ذَرْهُمْ", "translit": "ْmُhْrَhd", "root": "وذر"}, {"id": 2, "arabic": "يَأْكُلُوا۟", "translit": "۟āwُlُkْaʾَy", "root": "اكل"}, {"id": 3, "arabic": "وَيَتَمَتَّعُوا۟", "translit": "۟āwُʿعَّtَmَtَyَw", "root": "متع"}, {"id": 4, "arabic": "وَيُلْهِهِمُ", "translit": "ُmِhِhْlُyَw", "root": "لهو"}, {"id": 5, "arabic": "ٱلْأَمَلُ", "translit": "ُlَmَaʾْlٱ", "root": "امل"}, {"id": 6, "arabic": "فَسَوْفَ", "translit": "َfْwَsَf", "root": ""}, {"id": 7, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 4, "text": "وَمَآ أَهْلَكْنَا مِن قَرْيَةٍ إِلَّا وَلَهَا كِتَابٌ مَّعْلُومٌ ", "translation": "And We did not destroy any city but that for it was a known decree.", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَهْلَكْنَا", "translit": "āَnْkَlْhَaʾ", "root": "هلك"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "قَرْيَةٍ", "translit": "ٍẗَyْrَq", "root": "قري"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "وَلَهَا", "translit": "āَhَlَw", "root": ""}, {"id": 7, "arabic": "كِتَابٌ", "translit": "ٌbāَtِk", "root": "كتب"}, {"id": 8, "arabic": "مَّعْلُومٌ", "translit": "ٌmwُlْʿعَّm", "root": "علم"}], "hasIhya": false}, {"ayah": 5, "text": "مَّا تَسْبِقُ مِنْ أُمَّةٍ أَجَلَهَا وَمَا يَسْتَـْٔخِرُونَ ", "translation": "No nation will precede its term, nor will they remain thereafter.", "words": [{"id": 1, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 2, "arabic": "تَسْبِقُ", "translit": "ُqِbْsَt", "root": "سبق"}, {"id": 3, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 4, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 5, "arabic": "أَجَلَهَا", "translit": "āَhَlَjgَaʾ", "root": "اجل"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "يَسْتَـْٔخِرُونَ", "translit": "َnwُrِhkْٔـَtْsَy", "root": "اخر"}], "hasIhya": true}, {"ayah": 6, "text": "وَقَالُوا۟ يَٰٓأَيُّهَا ٱلَّذِى نُزِّلَ عَلَيْهِ ٱلذِّكْرُ إِنَّكَ لَمَجْنُونٌ ", "translation": "And they say, \"O you upon whom the message has been sent down, indeed you are mad.[1]", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 3, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "نُزِّلَ", "translit": "َlِّzُn", "root": "نزل"}, {"id": 5, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلذِّكْرُ", "translit": "ُrْkِّhdlٱ", "root": "ذكر"}, {"id": 7, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 8, "arabic": "لَمَجْنُونٌ", "translit": "ٌnwُnْjgَmَl", "root": "جنن"}], "hasIhya": false}, {"ayah": 7, "text": "لَّوْ مَا تَأْتِينَا بِٱلْمَلَٰٓئِكَةِ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ ", "translation": "Why do you not bring us the angels, if you should be among the truthful?\"", "words": [{"id": 1, "arabic": "لَّوْ", "translit": "ْwَّl", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "تَأْتِينَا", "translit": "āَnyِtْaʾَt", "root": "اتي"}, {"id": 4, "arabic": "بِٱلْمَلَٰٓئِكَةِ", "translit": "ِẗَkِyʾَٰٓlَmْlٱِb", "root": "ملك"}, {"id": 5, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 6, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 7, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 8, "arabic": "ٱلصَّٰدِقِينَ", "translit": "َnyِqِdَّٰṣlٱ", "root": "صدق"}], "hasIhya": false}, {"ayah": 8, "text": "مَا نُنَزِّلُ ٱلْمَلَٰٓئِكَةَ إِلَّا بِٱلْحَقِّ وَمَا كَانُوٓا۟ إِذًا مُّنظَرِينَ ", "translation": "We do not send down the angels except with truth;[1] and they [i.e., the disbelievers] would not then be reprieved.", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "نُنَزِّلُ", "translit": "ُlِّzَnُn", "root": "نزل"}, {"id": 3, "arabic": "ٱلْمَلَٰٓئِكَةَ", "translit": "َẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "كَانُوٓا۟", "translit": "۟āٓwُnāَk", "root": "كون"}, {"id": 8, "arabic": "إِذًا", "translit": "āًhdِiʾ", "root": ""}, {"id": 9, "arabic": "مُّنظَرِينَ", "translit": "َnyِrَẓnُّm", "root": "نظر"}], "hasIhya": false}, {"ayah": 9, "text": "إِنَّا نَحْنُ نَزَّلْنَا ٱلذِّكْرَ وَإِنَّا لَهُۥ لَحَٰفِظُونَ ", "translation": "Indeed, it is We who sent down the message [i.e., the Qur’ān], and indeed, We will be its guardian.", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 2, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 3, "arabic": "نَزَّلْنَا", "translit": "āَnْlَّzَn", "root": "نزل"}, {"id": 4, "arabic": "ٱلذِّكْرَ", "translit": "َrْkِّhdlٱ", "root": "ذكر"}, {"id": 5, "arabic": "وَإِنَّا", "translit": "āَّnِiʾَw", "root": ""}, {"id": 6, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 7, "arabic": "لَحَٰفِظُونَ", "translit": "َnwُẓِfَٰḥَl", "root": "حفظ"}], "hasIhya": true}, {"ayah": 10, "text": "وَلَقَدْ أَرْسَلْنَا مِن قَبْلِكَ فِى شِيَعِ ٱلْأَوَّلِينَ ", "translation": "And We had certainly sent [messengers] before you, [O Muḥammad], among the sects of the former peoples.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "شِيَعِ", "translit": "ِʿعَyِhs", "root": "شيع"}, {"id": 7, "arabic": "ٱلْأَوَّلِينَ", "translit": "َnyِlَّwَaʾْlٱ", "root": "اول"}], "hasIhya": false}, {"ayah": 11, "text": "وَمَا يَأْتِيهِم مِّن رَّسُولٍ إِلَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ ", "translation": "And no messenger would come to them except that they ridiculed him.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "يَأْتِيهِم", "translit": "mِhyِtْaʾَy", "root": "اتي"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "رَّسُولٍ", "translit": "ٍlwُsَّr", "root": "رسل"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 7, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 8, "arabic": "يَسْتَهْزِءُونَ", "translit": "َnwُءِzْhَtْsَy", "root": "هزا"}], "hasIhya": false}, {"ayah": 12, "text": "كَذَٰلِكَ نَسْلُكُهُۥ فِى قُلُوبِ ٱلْمُجْرِمِينَ ", "translation": "Thus do We insert it [i.e., denial] into the hearts of the criminals.", "words": [{"id": 1, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 2, "arabic": "نَسْلُكُهُۥ", "translit": "ۥُhُkُlْsَn", "root": "سلك"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "قُلُوبِ", "translit": "ِbwُlُq", "root": "قلب"}, {"id": 5, "arabic": "ٱلْمُجْرِمِينَ", "translit": "َnyِmِrْjgُmْlٱ", "root": "جرم"}], "hasIhya": false}, {"ayah": 13, "text": "لَا يُؤْمِنُونَ بِهِۦۖ وَقَدْ خَلَتْ سُنَّةُ ٱلْأَوَّلِينَ ", "translation": "They will not believe in it, while there has already occurred the precedent of the former peoples.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 3, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 4, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 5, "arabic": "خَلَتْ", "translit": "ْtَlَhk", "root": "خلو"}, {"id": 6, "arabic": "سُنَّةُ", "translit": "ُẗَّnُs", "root": "سنن"}, {"id": 7, "arabic": "ٱلْأَوَّلِينَ", "translit": "َnyِlَّwَaʾْlٱ", "root": "اول"}], "hasIhya": false}, {"ayah": 14, "text": "وَلَوْ فَتَحْنَا عَلَيْهِم بَابًا مِّنَ ٱلسَّمَآءِ فَظَلُّوا۟ فِيهِ يَعْرُجُونَ ", "translation": "And [even] if We opened to them a gate from the heaven and they continued therein to ascend,", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "فَتَحْنَا", "translit": "āَnْḥَtَf", "root": "فتح"}, {"id": 3, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "بَابًا", "translit": "āًbāَb", "root": "بوب"}, {"id": 5, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 6, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 7, "arabic": "فَظَلُّوا۟", "translit": "۟āwُّlَẓَf", "root": "ظلل"}, {"id": 8, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 9, "arabic": "يَعْرُجُونَ", "translit": "َnwُjgُrْʿعَy", "root": "عرج"}], "hasIhya": false}, {"ayah": 15, "text": "لَقَالُوٓا۟ إِنَّمَا سُكِّرَتْ أَبْصَٰرُنَا بَلْ نَحْنُ قَوْمٌ مَّسْحُورُونَ ", "translation": "They would say, \"Our eyes have only been dazzled. Rather, we are a people affected by magic.\"", "words": [{"id": 1, "arabic": "لَقَالُوٓا۟", "translit": "۟āٓwُlāَqَl", "root": "قول"}, {"id": 2, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 3, "arabic": "سُكِّرَتْ", "translit": "ْtَrِّkُs", "root": "سكر"}, {"id": 4, "arabic": "أَبْصَٰرُنَا", "translit": "āَnُrَٰṣْbَaʾ", "root": "بصر"}, {"id": 5, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 6, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 7, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 8, "arabic": "مَّسْحُورُونَ", "translit": "َnwُrwُḥْsَّm", "root": "سحر"}], "hasIhya": false}, {"ayah": 16, "text": "وَلَقَدْ جَعَلْنَا فِى ٱلسَّمَآءِ بُرُوجًا وَزَيَّنَّٰهَا لِلنَّٰظِرِينَ ", "translation": "And We have placed within the heaven great stars and have beautified it for the observers.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "بُرُوجًا", "translit": "āًjgwُrُb", "root": "برج"}, {"id": 6, "arabic": "وَزَيَّنَّٰهَا", "translit": "āَhَّٰnَّyَzَw", "root": "زين"}, {"id": 7, "arabic": "لِلنَّٰظِرِينَ", "translit": "َnyِrِẓَّٰnlِl", "root": "نظر"}], "hasIhya": false}, {"ayah": 17, "text": "وَحَفِظْنَٰهَا مِن كُلِّ شَيْطَٰنٍ رَّجِيمٍ ", "translation": "And We have protected it from every devil expelled [from the mercy of Allāh]", "words": [{"id": 1, "arabic": "وَحَفِظْنَٰهَا", "translit": "āَhَٰnْẓِfَḥَw", "root": "حفظ"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 4, "arabic": "شَيْطَٰنٍ", "translit": "ٍnَٰṭْyَhs", "root": "شطن"}, {"id": 5, "arabic": "رَّجِيمٍ", "translit": "ٍmyِjgَّr", "root": "رجم"}], "hasIhya": false}, {"ayah": 18, "text": "إِلَّا مَنِ ٱسْتَرَقَ ٱلسَّمْعَ فَأَتْبَعَهُۥ شِهَابٌ مُّبِينٌ ", "translation": "Except one who steals a hearing and is pursued by a clear burning flame.", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "مَنِ", "translit": "ِnَm", "root": ""}, {"id": 3, "arabic": "ٱسْتَرَقَ", "translit": "َqَrَtْsٱ", "root": "سرق"}, {"id": 4, "arabic": "ٱلسَّمْعَ", "translit": "َʿعْmَّslٱ", "root": "سمع"}, {"id": 5, "arabic": "فَأَتْبَعَهُۥ", "translit": "ۥُhَʿعَbْtَaʾَf", "root": "تبع"}, {"id": 6, "arabic": "شِهَابٌ", "translit": "ٌbāَhِhs", "root": "شهب"}, {"id": 7, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 19, "text": "وَٱلْأَرْضَ مَدَدْنَٰهَا وَأَلْقَيْنَا فِيهَا رَوَٰسِىَ وَأَنۢبَتْنَا فِيهَا مِن كُلِّ شَىْءٍ مَّوْزُونٍ ", "translation": "And the earth - We have spread it and cast therein firmly set mountains and caused to grow therein [something] of every well-balanced thing.", "words": [{"id": 1, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 2, "arabic": "مَدَدْنَٰهَا", "translit": "āَhَٰnْdَdَm", "root": "مدد"}, {"id": 3, "arabic": "وَأَلْقَيْنَا", "translit": "āَnْyَqْlَaʾَw", "root": "لقي"}, {"id": 4, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 5, "arabic": "رَوَٰسِىَ", "tra