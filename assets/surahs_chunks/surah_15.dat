َدُّ اُ۬لذِينَ كَفَرُواْ لَوْ كَانُواْ مُسْلِمِينَۖ", "words": [{"id": 1, "arabic": "رُّبَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَوَدُّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَوْ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُسْلِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 3, "text": "ذَرْهُمْ يَاكُلُواْ وَيَتَمَتَّعُواْ وَيُلْهِهِمُ اُ۬لَامَلُۖ فَسَوْفَ يَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "ذَرْهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَاكُلُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَيَتَمَتَّعُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَيُلْهِهِمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لَامَلُۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَسَوْفَ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 4, "text": "وَمَآ أَهْلَكْنَا مِن قَرْيَةٍ اِلَّا وَلَهَا كِتَابࣱ مَّعْلُومࣱۖ", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَهْلَكْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَرْيَةٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَهَا", "translit": "", "root": ""}, {"id": 7, "arabic": "كِتَابࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَّعْلُومࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 5, "text": "مَّا تَسْبِقُ مِنُ ا۟مَّةٍ اَجَلَهَا وَمَا يَسْتَٰخِرُونَۖ", "words": [{"id": 1, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَسْبِقُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنُ", "translit": "", "root": ""}, {"id": 4, "arabic": "ا۟مَّةٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَجَلَهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "يَسْتَٰخِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 6, "text": "وَقَالُواْ يَٰٓأَيُّهَا اَ۬لذِے نُزِّلَ عَلَيْهِ اِ۬لذِّكْرُ إِنَّكَ لَمَجْنُونࣱ‏", "words": [{"id": 1, "arabic": "وَقَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰٓأَيُّهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 4, "arabic": "نُزِّلَ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لذِّكْرُ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنَّكَ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَمَجْنُونࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 7, "text": "لَّوْمَا تَاتِينَا بِالْمَلَٰٓئِكَةِ إِن كُنتَ مِنَ اَ۬لصَّٰدِقِينَۖ", "words": [{"id": 1, "arabic": "لَّوْمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَاتِينَا", "translit": "", "root": ""}, {"id": 3, "arabic": "بِالْمَلَٰٓئِكَةِ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِن", "translit": "", "root": ""}, {"id": 5, "arabic": "كُنتَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لصَّٰدِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 15, "ayah": 8, "text": "مَا تَنَزَّلُ اُ۬لْمَلَٰٓئِكَةُ إِلَّا بِالْحَقِّۖ وَمَا كَانُوٓاْ إِذاࣰ مُّنظَرِينَۖ", "words": [{"id": 1, "arabic": "مَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَنَزَّلُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْمَلَٰٓئِكَةُ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "بِالْحَقِّۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمَا", "