 "arabic": "اُ۬لْقُرْءَانِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَكِتَابࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُّبِينٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 2, "text": "هُديࣰ وَبُشْر۪يٰ لِلْمُومِنِينَ", "words": [{"id": 1, "arabic": "هُديࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَبُشْر۪يٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِلْمُومِنِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 3, "text": "اَ۬لذِينَ يُقِيمُونَ اَ۬لصَّلَوٰةَ وَيُوتُونَ اَ۬لزَّكَوٰةَ وَهُم بِالَاخِرَةِ هُمْ يُوقِنُونَۖ", "words": [{"id": 1, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يُقِيمُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لصَّلَوٰةَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَيُوتُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لزَّكَوٰةَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَهُم", "translit": "", "root": ""}, {"id": 7, "arabic": "بِالَاخِرَةِ", "translit": "", "root": ""}, {"id": 8, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "يُوقِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 4, "text": "إِنَّ اَ۬لذِينَ لَا يُومِنُونَ بِالَاخِرَةِ زَيَّنَّا لَهُمُۥٓ أَعْمَٰلَهُمْ فَهُمْ يَعْمَهُونَۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يُومِنُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِالَاخِرَةِ", "translit": "", "root": ""}, {"id": 6, "arabic": "زَيَّنَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "لَهُمُۥٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَعْمَٰلَهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "فَهُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "يَعْمَهُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 5, "text": "أُوْلَٰٓئِكَ اَ۬لذِينَ لَهُمْ سُوٓءُ اُ۬لْعَذَابِ وَهُمْ فِے اِ۬لَاخِرَةِ هُمُ اُ۬لَاخْسَرُونَۖ", "words": [{"id": 1, "arabic": "أُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "سُوٓءُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْعَذَابِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لَاخِرَةِ", "translit": "", "root": ""}, {"id": 9, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لَاخْسَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 6, "text": "۞وَإِنَّكَ لَتُلَقَّي اَ۬لْقُرْءَانَ مِن لَّدُنْ حَكِيمٍ عَلِيمٍۖ", "words": [{"id": 1, "arabic": "۞وَإِنَّكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَتُلَقَّي", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْقُرْءَانَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِن", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّدُنْ", "translit": "", "root": ""}, {"id": 6, "arabic": "حَكِيمٍ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلِيمٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 7, "text": "اِذْ قَالَ مُوس۪يٰ لِأَهْلِهِۦٓ إِنِّيَ ءَانَسْتُ نَاراࣰ سَـَٔاتِيكُم مِّنْهَا بِخَبَرٍ اَوَ اٰتِيكُم بِشِهَابِ قَبَسࣲ لَّعَلَّكُمْ تَصْطَلُونَۖ", "words": [{"id": 1, "arabic": "اِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مُوس۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِأَهْلِهِۦٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنِّيَ", "translit": "", "root": ""}, {"id": 6, "arabic": "ءَانَسْتُ", "translit": "", "root": ""}, {"id": 7, "arabic": "نَاراࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "سَـَٔاتِيكُم", "translit": "", "root": ""}, {"id": 9, "arabic": "مِّنْهَا", "translit": "", "root": ""}, {"id": 10, "arabic": "بِخَبَرٍ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَوَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اٰتِيكُم", "translit": "", "root": ""}, {"id": 13, "arabic": "بِشِهَابِ", "translit": "", "root": ""}, {"id": 14, "arabic": "قَبَسࣲ", "translit": "", "root": ""}, {"id": 15, "arabic": "لَّعَلَّكُمْ", "translit": "", "root": ""}, {"id": 16, "arabic": "تَصْطَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 8, "text": "فَلَمَّا جَآءَهَا نُودِيَ أَنۢ بُورِكَ مَن فِے اِ۬لنّ۪ارِ وَمَنْ حَوْلَهَاۖ وَسُبْحَٰنَ اَ۬للَّهِ رَبِّ اِ۬لْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَآءَهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "نُودِيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنۢ", "translit": "", "root": ""}, {"id": 5, "arabic": "بُورِكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَن", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لنّ۪ارِ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَمَنْ", "translit": "", "root": ""}, {"id": 10, "arabic": "حَوْلَهَاۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَسُبْحَٰنَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 13, "arabic": "رَبِّ", "translit": "", "root": ""}, {"id": 14, "arabic": "اِ۬لْعَٰلَمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 9, "text": "يَٰمُوس۪يٰٓ إِنَّهُۥٓ أَنَا اَ۬للَّهُ اُ۬لْعَزِيزُ اُ۬لْحَكِيمُ", "words": [{"id": 1, "arabic": "يَٰمُوس۪يٰٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّهُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْعَزِيزُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لْحَكِيمُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 10, "text": "وَأَلْقِ عَصَاكَۖ فَلَمَّا ر۪ء۪اهَا تَهْتَزُّ كَأَنَّهَا جَآنࣱّ وَلّ۪يٰ مُدْبِراࣰ وَلَمْ يُعَقِّبْۖ يَٰمُوس۪يٰ لَا تَخَفِۖ اِنِّے لَا يَخَافُ لَدَيَّ اَ۬لْمُرْسَلُونَۖ", "words": [{"id": 1, "arabic": "وَأَلْقِ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَصَاكَۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَلَمَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "ر۪ء۪اهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "تَهْتَزُّ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَأَنَّهَا", "translit": "", "root": ""}, {"id": 7, "arabic": "جَآنࣱّ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَلّ۪يٰ", "translit": "", "root": ""}, {"id": 9, "arabic": "مُدْبِراࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَلَمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "يُعَقِّبْۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "يَٰمُوس۪يٰ", "translit": "", "root": ""}, {"id": 13, "arabic": "لَا", "translit": "", "root": ""}, {"id": 14, "arabic": "تَخَفِۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "اِنِّے", "translit": "", "root": ""}, {"id": 16, "arabic": "لَا", "translit": "", "root": ""}, {"id": 17, "arabic": "يَخَافُ", "translit": "", "root": ""}, {"id": 18, "arabic": "لَدَيَّ", "translit": "", "root": ""}, {"id": 19, "arabic": "اَ۬لْمُرْسَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 11, "text": "إِلَّا مَن ظَلَمَ ثُمَّ بَدَّلَ حُسْناَۢ بَعْدَ سُوٓءࣲ فَإِنِّے غَفُورࣱ رَّحِيمࣱۖ", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "", "root": ""}, {"id": 3, "arabic": "ظَلَمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَدَّلَ", "translit": "", "root": ""}, {"id": 6, "arabic": "حُسْناَۢ