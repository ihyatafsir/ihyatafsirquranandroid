َٔاتِيكُم مِّنْهَا بِخَبَرٍ اَوَ اٰتِيكُم بِشِهَابِ قَبَسࣲ لَّعَلَّكُمْ تَصْطَلُونَۖ", "words": [{"id": 1, "arabic": "اِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مُوس۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِأَهْلِهِۦٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنِّيَ", "translit": "", "root": ""}, {"id": 6, "arabic": "ءَانَسْتُ", "translit": "", "root": ""}, {"id": 7, "arabic": "نَاراࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "سَـَٔاتِيكُم", "translit": "", "root": ""}, {"id": 9, "arabic": "مِّنْهَا", "translit": "", "root": ""}, {"id": 10, "arabic": "بِخَبَرٍ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَوَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اٰتِيكُم", "translit": "", "root": ""}, {"id": 13, "arabic": "بِشِهَابِ", "translit": "", "root": ""}, {"id": 14, "arabic": "قَبَسࣲ", "translit": "", "root": ""}, {"id": 15, "arabic": "لَّعَلَّكُمْ", "translit": "", "root": ""}, {"id": 16, "arabic": "تَصْطَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 8, "text": "فَلَمَّا جَآءَهَا نُودِيَ أَنۢ بُورِكَ مَن فِے اِ۬لنّ۪ارِ وَمَنْ حَوْلَهَاۖ وَسُبْحَٰنَ اَ۬للَّهِ رَبِّ اِ۬لْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَآءَهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "نُودِيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنۢ", "translit": "", "root": ""}, {"id": 5, "arabic": "بُورِكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَن", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لنّ۪ارِ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَمَنْ", "translit": "", "root": ""}, {"id": 10, "arabic": "حَوْلَهَاۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَسُبْحَٰنَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 13, "arabic": "رَبِّ", "translit": "", "root": ""}, {"id": 14, "arabic": "اِ۬لْعَٰلَمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 9, "text": "يَٰمُوس۪يٰٓ إِنَّهُۥٓ أَنَا اَ۬للَّهُ اُ۬لْعَزِيزُ اُ۬لْحَكِيمُ", "words": [{"id": 1, "arabic": "يَٰمُوس۪يٰٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّهُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْعَزِيزُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لْحَكِيمُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 10, "text": "وَأَلْقِ عَصَاكَۖ فَلَمَّا ر۪ء۪اهَا تَهْتَزُّ كَأَنَّهَا جَآنࣱّ وَلّ۪يٰ مُدْبِراࣰ وَلَمْ يُعَقِّبْۖ يَٰمُوس۪يٰ لَا تَخَفِۖ اِنِّے لَا يَخَافُ لَدَيَّ اَ۬لْمُرْسَلُونَۖ", "words": [{"id": 1, "arabic": "وَأَلْقِ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَصَاكَۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَلَمَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "ر۪ء۪اهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "تَهْتَزُّ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَأَنَّهَا", "translit": "", "root": ""}, {"id": 7, "arabic": "جَآنࣱّ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَلّ۪يٰ", "translit": "", "root": ""}, {"id": 9, "arabic": "مُدْبِراࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَلَمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "يُعَقِّبْۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "يَٰمُوس۪يٰ", "translit": "", "root": ""}, {"id": 13, "arabic": "لَا", "translit": "", "root": ""}, {"id": 14, "arabic": "تَخَفِۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "اِنِّے", "translit": "", "root": ""}, {"id": 16, "arabic": "لَا", "translit": "", "root": ""}, {"id": 17, "arabic": "يَخَافُ", "translit": "", "root": ""}, {"id": 18, "arabic": "لَدَيَّ", "translit": "", "root": ""}, {"id": 19, "ar