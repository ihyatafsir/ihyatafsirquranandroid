, "arabic": "وَأَنجَيْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَكَانُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَتَّقُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 54, "text": "وَلُوطاً اِذْ قَالَ لِقَوْمِهِۦٓ أَتَاتُونَ اَ۬لْفَٰحِشَةَ وَأَنتُمْ تُبْصِرُونَۖ", "words": [{"id": 1, "arabic": "وَلُوطاً", "translit": "", "root": ""}, {"id": 2, "arabic": "اِذْ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِقَوْمِهِۦٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَتَاتُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْفَٰحِشَةَ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَأَنتُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "تُبْصِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 55, "text": "أَئِنَّكُمْ لَتَاتُونَ اَ۬لرِّجَالَ شَهْوَةࣰ مِّن دُونِ اِ۬لنِّسَآءِۖ بَلَ اَنتُمْ قَوْمࣱ تَجْهَلُونَۖ", "words": [{"id": 1, "arabic": "أَئِنَّكُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَتَاتُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لرِّجَالَ", "translit": "", "root": ""}, {"id": 4, "arabic": "شَهْوَةࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 6, "arabic": "دُونِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لنِّسَآءِۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "بَلَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَنتُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "قَوْمࣱ", "translit": "", "root": ""}, {"id": 11, "arabic": "تَجْهَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 56, "text": "۞فَمَا كَانَ جَوَابَ قَوْمِهِۦٓ إِلَّآ أَن قَالُوٓاْ أَخْرِجُوٓاْ ءَالَ لُوطࣲ مِّن قَرْيَتِكُمُۥٓۖ إِنَّهُمُۥٓ أُ