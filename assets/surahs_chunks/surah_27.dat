lit": "", "root": ""}, {"id": 8, "arabic": "إِنْ", "translit": "", "root": ""}, {"id": 9, "arabic": "هَٰذَآ", "translit": "", "root": ""}, {"id": 10, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَسَٰطِيرُ", "translit": "", "root": ""}, {"id": 12, "arabic": "اُ۬لَاوَّلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 69, "text": "قُلْ سِيرُواْ فِے اِ۬لَارْضِ فَانظُرُواْ كَيْفَ كَانَ عَٰقِبَةُ اُ۬لْمُجْرِمِينَۖ", "words": [{"id": 1, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "سِيرُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَانظُرُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَيْفَ", "translit": "", "root": ""}, {"id": 7, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَٰقِبَةُ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬لْمُجْرِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 70, "text": "وَلَا تَحْزَنْ عَلَيْهِمْ وَلَا تَكُن فِے ضَيْقࣲ مِّمَّا يَمْكُرُونَۖ", "words": [{"id": 1, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَحْزَنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْهِمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 5, "arabic": "تَكُن", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "ضَيْقࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِّمَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "يَمْكُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 71, "text": "وَيَقُولُونَ مَت۪يٰ هَٰذَا اَ۬لْوَعْدُ إِن كُنتُمْ صَٰدِقِينَۖ", "words": [{"id": 1, "arabic": "وَيَقُولُونَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَت۪يٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "ه