 "arabic": "اُ۬للَّهَ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 11, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "فَرِيقَٰنِ", "translit": "", "root": ""}, {"id": 13, "arabic": "يَخْتَصِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 46, "text": "قَالَ يَٰقَوْمِ لِمَ تَسْتَعْجِلُونَ بِالسَّيِّئَةِ قَبْلَ اَ۬لْحَسَنَةِ لَوْلَا تَسْتَغْفِرُونَ اَ۬للَّهَ لَعَلَّكُمْ تُرْحَمُونَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰقَوْمِ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "تَسْتَعْجِلُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِالسَّيِّئَةِ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَبْلَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْحَسَنَةِ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَوْلَا", "translit": "", "root": ""}, {"id": 9, "arabic": "تَسْتَغْفِرُونَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 11, "arabic": "لَعَلَّكُمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "تُرْحَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 47, "text": "قَالُواْ اُ۪طَّيَّرْنَا بِكَ وَبِمَن مَّعَكَۖ قَالَ طَٰٓئِرُكُمْ عِندَ اَ۬للَّهِۖ بَلَ اَنتُمْ قَوْمࣱ تُفْتَنُونَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۪طَّيَّرْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "بِكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَبِمَن", "translit": "", "root": ""}, {"id": 5, "arabic": "مَّعَكَۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 7, "arabic": "طَٰٓئِرُكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "عِندَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬للَّهِۖ", "translit": "", "root"