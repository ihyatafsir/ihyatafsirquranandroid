": "", "root": ""}, {"id": 12, "arabic": "يَشْعُرُونَ", "translit": "", "root": ""}, {"id": 13, "arabic": "أَيَّانَ", "translit": "", "root": ""}, {"id": 14, "arabic": "يُبْعَثُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 66, "text": "۞بَلِ اِ۪دَّٰرَكَ عِلْمُهُمْ فِے اِ۬لَاخِرَةِۖ بَلْ هُمْ فِے شَكࣲّ مِّنْهَا بَلْ هُم مِّنْهَا عَمُونَۖ", "words": [{"id": 1, "arabic": "۞بَلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۪دَّٰرَكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "عِلْمُهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لَاخِرَةِۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 7, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "شَكࣲّ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِّنْهَا", "translit": "", "root": ""}, {"id": 11, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 12, "arabic": "هُم", "translit": "", "root": ""}, {"id": 13, "arabic": "مِّنْهَا", "translit": "", "root": ""}, {"id": 14, "arabic": "عَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 67, "text": "وَقَالَ اَ۬لذِينَ كَفَرُوٓاْ إِذَا كُنَّا تُرَٰباࣰ وَءَابَآؤُنَآ أَئِنَّا لَمُخْرَجُونَۖ", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَفَرُوٓاْ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 5, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "تُرَٰباࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَءَابَآؤُنَآ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَئِنَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "لَمُخْرَجُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 68, "text": "لَقَدْ وُعِدْنَا هَٰذَا نَحْنُ وَءَابَآؤُنَا مِن قَبْلُۖ إِنْ هَٰذَآ إِلَّآ أَسَٰطِيرُ اُ۬لَاوَّلِينَۖ", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "وُعِدْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَءَابَآؤُنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "مِن", "translit": "", "root": ""}, {"id": 7, "arabic": "قَبْلُۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنْ", "translit": "", "root": ""}, {"id": 9, "arabic": "هَٰذَآ", "translit": "", "root": ""}, {"id": 10, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَسَٰطِيرُ", "translit": "", "root": ""}, {"id": 12, "arabic": "اُ۬لَاوَّلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 69, "text": "قُلْ سِيرُواْ فِے اِ۬لَارْضِ فَانظُرُواْ كَيْفَ كَانَ عَٰقِبَةُ اُ۬لْمُجْرِمِينَۖ", "words": [{"id": 1, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "سِيرُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَانظُرُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَيْفَ", "translit": "", "root": ""}, {"id": 7, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَٰقِبَةُ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬لْمُجْرِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 70, "text": "وَلَا تَحْزَنْ عَلَيْهِمْ وَلَا تَكُن فِے ضَيْقࣲ مِّمَّا يَمْكُرُونَۖ", "words": [{"id": 1, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَحْزَنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْهِمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 5, "arabic": "تَكُن", "translit": "", 