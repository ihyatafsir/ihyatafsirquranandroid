{"surah": 27, "verses": [{"ayah": 1, "text": "طسٓۚ تِلْكَ ءَايَٰتُ ٱلْقُرْءَانِ وَكِتَابٍ مُّبِينٍ ", "translation": "Ṭā, Seen.[1] These are the verses of the Qur’ān [i.e., recitation] and a clear Book", "words": [{"id": 1, "arabic": "طسٓ", "translit": "ٓsṭ", "root": ""}, {"id": 2, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 3, "arabic": "ءَايَٰتُ", "translit": "ُtَٰyāَء", "root": "ايي"}, {"id": 4, "arabic": "ٱلْقُرْءَانِ", "translit": "ِnāَءْrُqْlٱ", "root": "قرا"}, {"id": 5, "arabic": "وَكِتَابٍ", "translit": "ٍbāَtِkَw", "root": "كتب"}, {"id": 6, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 2, "text": "هُدًى وَبُشْرَىٰ لِلْمُؤْمِنِينَ ", "translation": "As guidance and good tidings for the believers", "words": [{"id": 1, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 2, "arabic": "وَبُشْرَىٰ", "translit": "ٰàَrْhsُbَw", "root": "بشر"}, {"id": 3, "arabic": "لِلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlِl", "root": "امن"}], "hasIhya": false}, {"ayah": 3, "text": "ٱلَّذِينَ يُقِيمُونَ ٱلصَّلَوٰةَ وَيُؤْتُونَ ٱلزَّكَوٰةَ وَهُم بِٱلْءَاخِرَةِ هُمْ يُوقِنُونَ ", "translation": "Who establish prayer and give zakāh, and of the Hereafter they are certain [in faith].", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يُقِيمُونَ", "translit": "َnwُmyِqُy", "root": "قوم"}, {"id": 3, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 4, "arabic": "وَيُؤْتُونَ", "translit": "َnwُtْwʾُyَw", "root": "اتي"}, {"id": 5, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 6, "arabic": "وَهُم", "translit": "mُhَw", "root": ""}, {"id": 7, "arabic": "بِٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱِb", "root": "اخر"}, {"id": 8, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 9, "arabic": "يُوقِنُونَ", "translit": "َnwُnِqwُy", "root": "يقن"}], "hasIhya": false}, {"ayah": 4, "text": "إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْءَاخِرَةِ زَيَّنَّا لَهُمْ أَعْمَٰلَهُمْ فَهُمْ يَعْمَهُونَ ", "translation": "Indeed, for those who do not believe in the Hereafter, We have made pleasing to them their deeds, so they wander blindly.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 5, "arabic": "بِٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱِb", "root": "اخر"}, {"id": 6, "arabic": "زَيَّنَّا", "translit": "āَّnَّyَz", "root": "زين"}, {"id": 7, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 8, "arabic": "أَعْمَٰلَهُمْ", "translit": "ْmُhَlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 9, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 10, "arabic": "يَعْمَهُونَ", "translit": "َnwُhَmْʿعَy", "root": "عمه"}], "hasIhya": false}, {"ayah": 5, "text": "أُو۟لَٰٓئِكَ ٱلَّذِينَ لَهُمْ سُوٓءُ ٱلْعَذَابِ وَهُمْ فِى ٱلْءَاخِرَةِ هُمُ ٱلْأَخْسَرُونَ ", "translation": "Those are the ones for whom there will be the worst of punishment, and in the Hereafter they are the greatest losers.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 4, "arabic": "سُوٓءُ", "translit": "ُءٓwُs", "root": "سوا"}, {"id": 5, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 6, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 9, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 10, "arabic": "ٱلْأَخْسَرُونَ", "translit": "َnwُrَsْhkَaʾْlٱ", "root": "خسر"}], "hasIhya": false}, {"ayah": 6, "text": "وَإِنَّكَ لَتُلَقَّى ٱلْقُرْءَانَ مِن لَّدُنْ حَكِيمٍ عَلِيمٍ ", "translation": "And indeed, [O Muḥammad], you receive the Qur’ān from one Wise and Knowing.", "words": [{"id": 1, "arabic": "وَإِنَّكَ", "translit": "َkَّnِiʾَw", "root": ""}, {"id": 2, "arabic": "لَتُلَقَّى", "translit": "àَّqَlُtَl", "root": "لقي"}, {"id": 3, "arabic": "ٱلْقُرْءَانَ", "translit": "َnāَءْrُqْlٱ", "root": "قرا"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "لَّدُنْ", "translit": "ْnُdَّl", "root": "لدن"}, {"id": 6, "arabic": "حَكِيمٍ", "translit": "ٍmyِkَḥ", "root": "حكم"}, {"id": 7, "arabic": "عَلِيمٍ", "translit": "ٍmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 7, "text": "إِذْ قَالَ مُوسَىٰ لِأَهْلِهِۦٓ إِنِّىٓ ءَانَسْتُ نَارًا سَـَٔاتِيكُم مِّنْهَا بِخَبَرٍ أَوْ ءَاتِيكُم بِشِهَابٍ قَبَسٍ لَّعَلَّكُمْ تَصْطَلُونَ ", "translation": "[Mention] when Moses said to his family, \"Indeed, I have perceived a fire. I will bring you from there information or will bring you a burning torch that you may warm yourselves.\"", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 4, "arabic": "لِأَهْلِهِۦٓ", "translit": "ٓۦِhِlْhَaʾِl", "root": "اهل"}, {"id": 5, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 6, "arabic": "ءَانَسْتُ", "translit": "ُtْsَnāَء", "root": "انس"}, {"id": 7, "arabic": "نَارًا", "translit": "āًrāَn", "root": "نور"}, {"id": 8, "arabic": "سَـَٔاتِيكُم", "translit": "mُkyِtāَٔـَs", "root": "اتي"}, {"id": 9, "arabic": "مِّنْهَا", "translit": "āَhْnِّm", "root": ""}, {"id": 10, "arabic": "بِخَبَرٍ", "translit": "ٍrَbَhkِb", "root": "خبر"}, {"id": 11, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 12, "arabic": "ءَاتِيكُم", "translit": "mُkyِtāَء", "root": "اتي"}, {"id": 13, "arabic": "بِشِهَابٍ", "translit": "ٍbāَhِhsِb", "root": "شهب"}, {"id": 14, "arabic": "قَبَسٍ", "translit": "ٍsَbَq", "root": "قبس"}, {"id": 15, "arabic": "لَّعَلَّكُمْ", "translit": "ْmُkَّlَʿعَّl", "root": ""}, {"id": 16, "arabic": "تَصْطَلُونَ", "translit": "َnwُlَṭْṣَt", "root": "صلي"}], "hasIhya": false}, {"ayah": 8, "text": "فَلَمَّا جَآءَهَا نُودِىَ أَنۢ بُورِكَ مَن فِى ٱلنَّارِ وَمَنْ حَوْلَهَا وَسُبْحَٰنَ ٱللَّهِ رَبِّ ٱلْعَٰلَمِينَ ", "translation": "But when he came to it, he was called, \"Blessed is whoever is at the fire and whoever is around it. And exalted is Allāh, Lord of the worlds.", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "جَآءَهَا", "translit": "āَhَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "نُودِىَ", "translit": "َàِdwُn", "root": "ندي"}, {"id": 4, "arabic": "أَنۢ", "translit": "ۢnَaʾ", "root": ""}, {"id": 5, "arabic": "بُورِكَ", "translit": "َkِrwُb", "root": "برك"}, {"id": 6, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 9, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 10, "arabic": "حَوْلَهَا", "translit": "āَhَlْwَḥ", "root": "حول"}, {"id": 11, "arabic": "وَسُبْحَٰنَ", "translit": "َnَٰḥْbُsَw", "root": "سبح"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 14, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 9, "text": "يَٰمُوسَىٰٓ إِنَّهُۥٓ أَنَا ٱللَّهُ ٱلْعَزِيزُ ٱلْحَكِيمُ ", "translation": "O Moses, indeed it is I - Allāh, the Exalted in Might, the Wise.\"", "words": [{"id": 1, "arabic": "يَٰمُوسَىٰٓ", "translit": "ٰٓàَswُmَٰy", "root": ""}, {"id": 2, "arabic": "إِنَّهُۥٓ", "translit": "ٓۥُhَّnِiʾ", "root": ""}, {"id": 3, "arabic": "أَنَا", "translit": "āَnَaʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 6, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}, {"ayah": 10, "text": "وَأَلْقِ عَصَاكَۚ فَلَمَّا رَءَاهَا تَهْتَزُّ كَأَنَّهَا جَآنٌّ وَلَّىٰ مُدْبِرًا وَلَمْ يُعَقِّبْۚ يَٰمُوسَىٰ لَا تَخَفْ إِنِّى لَا يَخَافُ لَدَىَّ ٱلْمُرْسَلُونَ ", "translation": "And [he was told], \"Throw down your staff.\" But when he saw it writhing as if it were a snake, he turned in flight and did not return.[1] [Allāh said], \"O Moses, fear not. Indeed, in My presence the messengers do not fear.", "words": [{"id": 1, "arabic": "وَأَلْقِ", "translit": "ِqْlَaʾَw", "root": "لقي"}, {"id": 2, "arabic": "عَصَاكَ", "translit": "َkāَṣَʿع", "root": "عصو"}, {"id": 3, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 4, "arabic": "رَءَاهَا", "translit": "āَhāَءَr", "root": "راي"}, {"id": 5, "arabic": "تَهْتَزُّ", "translit": "ُّzَtْhَt", "root": "هزز"}, {"id": 6, "arabic": "كَأَنَّهَا", "translit": "āَhَّnَaʾَk", "root": ""}, {"id": 7, "arabic": "جَآنٌّ", "translit": "ٌّnٓāَjg", "root": "جنن"}, {"id": 8, "arabic": "وَلَّىٰ", "translit": "ٰàَّlَw", "root": "ولي"}, {"id": 9, "arabic": "مُدْبِرًا", "translit": "āًrِbْdُm", "root": "دبر"}, {"id": 10, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 11, "arabic": "يُعَقِّبْ", "translit": "ْbِّqَʿعُy", "root": "عقب"}, {"id": 12, "arabic": "يَٰمُوسَىٰ", "translit": "ٰàَswُmَٰy", "root": ""}, {"id": 13, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 14, "arabic": "تَخَفْ", "translit": "ْfَhkَt", "root": "خوف"}, {"id": 15, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 16, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 17, "arabic": "يَخَافُ", "translit": "ُfāَhkَy", "root": "خوف"}, {"id": 18, "arabic": "لَدَىَّ", "translit": "َّàَdَl", "root": ""}, {"id": 19, "arabic": "ٱلْمُرْسَلُونَ", "translit": "َnwُlَsْrُmْlٱ", "root": "رسل"}], "hasIhya": false}, {"ayah": 11, "text": "إِلَّا مَن ظَلَمَ ثُمَّ بَدَّلَ حُسْنًۢا بَعْدَ سُوٓءٍ فَإِنِّى غَفُورٌ رَّحِيمٌ ", "translation": "Otherwise, he who wrongs, then substitutes good after evil - indeed, I am Forgiving and Merciful.", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "ظَلَمَ", "translit": "َmَlَẓ", "root": "ظلم"}, {"id": 4, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 5, "arabic": "بَدَّلَ", "translit": "َlَّdَb", "root": "بدل"}, {"id": 6, "arabic": "حُسْنًۢا", "translit": "āًۢnْsُḥ", "root": "حسن"}, {"id": 7, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 8, "arabic": "سُوٓءٍ", "translit": "ٍءٓwُs", "root": "سوا"}, {"id": 9, "arabic": "فَإِنِّى", "translit": "àِّnِiʾَf", "root": ""}, {"id": 10, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 11, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 12, "text": "وَأَدْخِلْ يَدَكَ فِى جَيْبِكَ تَخْرُجْ بَيْضَآءَ مِنْ غَيْرِ سُوٓءٍۖ فِى تِسْعِ ءَايَٰتٍ إِلَىٰ فِرْعَوْنَ وَقَوْمِهِۦٓۚ إِنَّهُمْ كَانُوا۟ قَوْمًا فَٰسِقِينَ ", "translation": "And put your hand into the opening of your garment [at the breast]; it will come out white without disease. [These are] among the nine signs [you will take] to Pharaoh and his people. Indeed, they have been a people defiantly disobedient.\"", "words": [{"id": 1, "arabic": "وَأَدْخِلْ", "translit": "ْlِhkْdَaʾَw", "root": "دخل"}, {"id": 2, "arabic": "يَدَكَ", "translit": "َkَdَy", "root": "يدي"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "جَيْبِكَ", "translit": "َkِbْyَjg", "root": "جيب"}, {"id": 5, "arabic": "تَخْرُجْ", "translit": "ْjgُrْhkَt", "root": "خرج"}, {"id": 6, "arabic": "بَيْضَآءَ", "translit": "َءٓāَḍْyَb", "root": "بيض"}, {"id": 7, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 8, "arabic": "غَيْرِ", "translit": "ِrْyَغ", "root": "غير"}, {"id": 9, "arabic": "سُوٓءٍ", "translit": "ٍءٓwُs", "root": "سوا"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "تِسْعِ", "translit": "ِʿعْsِt", "root": "تسع"}, {"id": 12, "arabic": "ءَايَٰتٍ", "translit": "ٍtَٰyāَء", "root": "ايي"}, {"id": 13, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 14, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 15, "arabic": "وَقَوْمِهِۦٓ", "translit": "ٓۦِhِmْwَqَw", "root": "قوم"}, {"id": 16, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 17, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 18, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 19, "arabic": "فَٰسِقِينَ", "translit": "َnyِqِsَٰf", "root": "فسق"}], "hasIhya": false}, {"ayah": 13, "text": "فَلَمَّا جَآءَتْهُمْ ءَايَٰتُنَا مُبْصِرَةً قَالُوا۟ هَٰذَا سِحْرٌ مُّبِينٌ ", "translation": "But when there came to them Our visible signs, they said, \"This is obvious magic.\"", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "جَآءَتْهُمْ", "translit": "ْmُhْtَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "ءَايَٰتُنَا", "translit": "āَnُtَٰyāَء", "root": "ايي"}, {"id": 4, "arabic": "مُبْصِرَةً", "translit": "ًẗَrِṣْbُm", "root": "بصر"}, {"id": 5, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 6, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 7, "arabic": "سِحْرٌ", "translit": "ٌrْḥِs", "root": "سحر"}, {"id": 8, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 14, "text": "وَجَحَدُوا۟ بِهَا وَٱسْتَيْقَنَتْهَآ أَنفُسُهُمْ ظُلْمًا وَعُلُوًّاۚ فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُفْسِدِينَ ", "translation": "And they rejected them, while their [inner] selves were convinced thereof, out of injustice and haughtiness. So see how was the end of the corrupters.", "words": [{"id": 1, "arabic": "وَجَحَدُوا۟", "translit": "۟āwُdَḥَjgَw", "root": "جحد"}, {"id": 2, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 3, "arabic": "وَٱسْتَيْقَنَتْهَآ", "translit": "ٓāَhْtَnَqْyَtْsٱَw", "root": "يقن"}, {"id": 4, "arabic": "أَنفُسُهُمْ", "translit": "ْmُhُsُfnَaʾ", "root": "نفس"}, {"id": 5, "arabic": "ظُلْمًا", "translit": "āًmْlُẓ", "root": "ظلم"}, {"id": 6, "arabic": "وَعُلُوًّا", "translit": "āًّwُlُʿعَw", "root": "علو"}, {"id": 7, "arabic": "فَٱنظُرْ", "translit": "ْrُẓnٱَf", "root": "نظر"}, {"id": 8, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 9, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 10, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 11, "arabic": "ٱلْمُفْسِدِينَ", "translit": "َnyِdِsْfُmْlٱ", "root": "فسد"}], "hasIhya": true}, {"ayah": 15, "text": "وَلَقَدْ ءَاتَيْنَا دَاوُۥدَ وَسُلَيْمَٰنَ عِلْمًاۖ وَقَالَا ٱلْحَمْدُ لِلَّهِ ٱلَّذِى فَضَّلَنَا عَلَىٰ كَثِيرٍ مِّنْ عِبَادِهِ ٱلْمُؤْمِنِينَ ", "translation": "And We had certainly given to David and Solomon knowledge, and they said, \"Praise [is due] to Allāh, who has favored us over many of His believing servants.\"", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَا", "translit": "āَnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "دَاوُۥدَ", "translit": "َdۥُwāَd", "root": ""}, {"id": 4, "arabic": "وَسُلَيْمَٰنَ", "translit": "َnَٰmْyَlُsَw", "root": ""}, {"id": 5, "arabic": "عِلْمًا", "translit": "āًmْlِʿع", "root": "علم"}, {"id": 6, "arabic": "وَقَالَا", "translit": "āَlāَqَw", "root": "قول"}, {"id": 7, "arabic": "ٱلْحَمْدُ", "translit": "ُdْmَḥْlٱ", "root": "حمد"}, {"id": 8, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 9, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "فَضَّلَنَا", "translit": "āَnَlَّḍَf", "root": "فضل"}, {"id": 11, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 12, "arabic": "كَثِيرٍ", "translit": "ٍryِhtَk", "root": "كثر"}, {"id": 13, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 14, "arabic": "عِبَادِهِ", "translit": "ِhِdāَbِʿع", "root": "عبد"}, {"id": 15, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}], "hasIhya": false}, {"ayah": 16, "text": "وَوَرِثَ سُلَيْمَٰنُ دَاوُۥدَۖ وَقَالَ يَٰٓأَيُّهَا ٱلنَّاسُ عُلِّمْنَا مَنطِقَ ٱلطَّيْرِ وَأُوتِينَا مِن كُلِّ شَىْءٍۖ إِنَّ هَٰذَا لَهُوَ ٱلْفَضْلُ ٱلْمُبِينُ ", "translation": "And Solomon inherited David. He said, \"O people, we have been taught the language of birds, and we have been given from all things. Indeed, this is evident bounty.\"", "words": [{"id": 1, "arabic": "وَوَرِثَ", "translit": "َhtِrَwَw", "root": "ورث"}, {"id": 2, "arabic": "سُلَيْمَٰنُ", "translit": "ُnَٰmْyَlُs", "root": ""}, {"id": 3, "arabic": "دَاوُۥدَ", "translit": "َdۥُwāَd", "root": ""}, {"id": 4, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 5, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 6, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 7, "arabic": "عُلِّمْنَا", "translit": "āَnْmِّlُʿع", "root": "علم"}, {"id": 8, "arabic": "مَنطِقَ", "translit": "َqِṭnَm", "root": "نطق"}, {"id": 9, "arabic": "ٱلطَّيْرِ", "translit": "ِrْyَّṭlٱ", "root": "طير"}, {"id": 10, "arabic": "وَأُوتِينَا", "translit": "āَnyِtwُaʾَw", "root": "اتي"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 13, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 14, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 15, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 16, "arabic": "لَهُوَ", "translit": "َwُhَl", "root": ""}, {"id": 17, "arabic": "ٱلْفَضْلُ", "translit": "ُlْḍَfْlٱ", "root": "فضل"}, {"id": 18, "arabic": "ٱلْمُبِينُ", "translit": "ُnyِbُmْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 17, "text": "وَحُشِرَ لِسُلَيْمَٰنَ جُنُودُهُۥ مِنَ ٱلْجِنِّ وَٱلْإِنسِ وَٱلطَّيْرِ فَهُمْ يُوزَعُونَ ", "translation": "And gathered for Solomon were his soldiers of the jinn and men and birds, and they were [marching] in rows", "words": [{"id": 1, "arabic": "وَحُشِرَ", "translit": "َrِhsُḥَw", "root": "حشر"}, {"id": 2, "arabic": "لِسُلَيْمَٰنَ", "translit": "َnَٰmْyَlُsِl", "root": ""}, {"id": 3, "arabic": "جُنُودُهُۥ", "translit": "ۥُhُdwُnُjg", "root": "جند"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱلْجِنِّ", "translit": "ِّnِjgْlٱ", "root": "جنن"}, {"id": 6, "arabic": "وَٱلْإِنسِ", "translit": "ِsnِiʾْlٱَw", "root": "انس"}, {"id": 7, "arabic": "وَٱلطَّيْرِ", "translit": "ِrْyَّṭlٱَw", "root": "طير"}, {"id": 8, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 9, "arabic": "يُوزَعُونَ", "translit": "َnwُʿعَzwُy", "root": "وزع"}], "hasIhya": false}, {"ayah": 18, "text": "حَتَّىٰٓ إِذَآ أَتَوْا۟ عَلَىٰ وَادِ ٱلنَّمْلِ قَالَتْ نَمْلَةٌ يَٰٓأَيُّهَا ٱلنَّمْلُ ٱدْخُلُوا۟ مَسَٰكِنَكُمْ لَا يَحْطِمَنَّكُمْ سُلَيْمَٰنُ وَجُنُودُهُۥ وَهُمْ لَا يَشْعُرُونَ ", "translation": "Until, when they came upon the valley of the ants, an ant said, \"O ants, enter your dwellings that you not be crushed by Solomon and his soldiers while they perceive not.\"", "words": [{"id": 1, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 2, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 3, "arabic": "أَتَوْا۟", "translit": "۟āْwَtَaʾ", "root": "اتي"}, {"id": 4, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 5, "arabic": "وَادِ", "translit": "ِdāَw", "root": "ودي"}, {"id": 6, "arabic": "ٱلنَّمْلِ", "translit": "ِlْmَّnlٱ", "root": "نمل"}, {"id": 7, "arabic": "قَالَتْ", "translit": "ْtَlāَq", "root": "قول"}, {"id": 8, "arabic": "نَمْلَةٌ", "translit": "ٌẗَlْmَn", "root": "نمل"}, {"id": 9, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 10, "arabic": "ٱلنَّمْلُ", "translit": "ُlْmَّnlٱ", "root": "نمل"}, {"id": 11, "arabic": "ٱدْخُلُوا۟", "translit": "۟āwُlُhkْdٱ", "root": "دخل"}, {"id": 12, "arabic": "مَسَٰكِنَكُمْ", "translit": "ْmُkَnِkَٰsَm", "root": "سكن"}, {"id": 13, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 14, "arabic": "يَحْطِمَنَّكُمْ", "translit": "ْmُkَّnَmِṭْḥَy", "root": "حطم"}, {"id": 15, "arabic": "سُلَيْمَٰنُ", "translit": "ُnَٰmْyَlُs", "root": ""}, {"id": 16, "arabic": "وَجُنُودُهُۥ", "translit": "ۥُhُdwُnُjgَw", "root": "جند"}, {"id": 17, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 18, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 19, "arabic": "يَشْعُرُونَ", "translit": "َnwُrُʿعْhsَy", "root": "شعر"}], "hasIhya": false}, {"ayah": 19, "text": "فَتَبَسَّمَ ضَاحِكًا مِّن قَوْلِهَا وَقَالَ رَبِّ أَوْزِعْنِىٓ أَنْ أَشْكُرَ نِعْمَتَكَ ٱلَّتِىٓ أَنْعَمْتَ عَلَىَّ وَعَلَىٰ وَٰلِدَىَّ وَأَنْ أَعْمَلَ صَٰلِحًا تَرْضَىٰهُ وَأَدْخِلْنِى بِرَحْمَتِكَ فِى عِبَادِكَ ٱلصَّٰلِحِينَ ", "translation": "So [Solomon] smiled, amused at her speech, and said, \"My Lord, enable me[1] to be grateful for Your favor which You have bestowed upon me and upon my parents and to do righteousness of which You approve. And admit me by Your mercy into [the ranks of] Your righteous servants.\"[2]", "words": [{"id": 1, "arabic": "فَتَبَسَّمَ", "translit": "َmَّsَbَtَf", "root": "بسم"}, {"id": 2, "arabic": "ضَاحِكًا", "translit": "āًkِḥāَḍ", "root": "ضحك"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "قَوْلِهَا", "translit": "āَhِlْwَq", "root": "قول"}, {"id": 5, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 6, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 7, "arabic": "أَوْزِعْنِىٓ", "translit": "ٓàِnْʿعِzْwَaʾ", "root": "وزع"}, {"id": 8, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 9, "arabic": "أَشْكُرَ", "translit": "َrُkْhsَaʾ", "root": "شكر"}, {"id": 10, "arabic": "نِعْمَتَكَ", "translit": "َkَtَmْʿعِn", "root": "نعم"}, {"id": 11, "arabic": "ٱلَّتِىٓ", "translit": "ٓàِtَّlٱ", "root": ""}, {"id": 12, "arabic": "أَنْعَمْتَ", "translit": "َtْmَʿعْnَaʾ", "root": "نعم"}, {"id": 13, "arabic": "عَلَىَّ", "translit": "َّàَlَʿع", "root": ""}, {"id": 14, "arabic": "وَعَلَىٰ", "translit": "ٰàَlَʿعَw", "root": ""}, {"id": 15, "arabic": "وَٰلِدَىَّ", "translit": "َّàَdِlَٰw", "root": "ولد"}, {"id": 16, "arabic": "وَأَنْ", "translit": "ْnَaʾَw", "root": ""}, {"id": 17, "arabic": "أَعْمَلَ", "translit": "َlَmْʿعَaʾ", "root": "عمل"}, {"id": 18, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 19, "arabic": "تَرْضَىٰهُ", "translit": "ُhٰàَḍْrَt", "root": "رضو"}, {"id": 20, "arabic": "وَأَدْخِلْنِى", "translit": "àِnْlِhkْdَaʾَw", "root": "دخل"}, {"id": 21, "arabic": "بِرَحْمَتِكَ", "translit": "َkِtَmْḥَrِb", "root": "رحم"}, {"id": 22, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 23, "arabic": "عِبَادِكَ", "translit": "َkِdāَbِʿع", "root": "عبد"}, {"id": 24, "arabic": "ٱلصَّٰلِحِينَ", "translit": "َnyِḥِlَّٰṣlٱ", "root": "صلح"}], "hasIhya": false}, {"ayah": 20, "text": "وَتَفَقَّدَ ٱلطَّيْرَ فَقَالَ مَا لِىَ لَآ أَرَى ٱلْهُدْهُدَ أَمْ كَانَ مِنَ ٱلْغَآئِبِينَ ", "translation": "And he took attendance of the birds and said, \"Why do I not see the hoopoe - or is he among the absent?", "words": [{"id": 1, "arabic": "وَتَفَقَّدَ", "translit": "َdَّqَfَtَw", "root": "فقد"}, {"id": 2, "arabic": "ٱلطَّيْرَ", "translit": "َrْyَّṭlٱ", "root": "طير"}, {"id": 3, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "لِىَ", "translit": "َàِl", "root": ""}, {"id": 6, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 7, "arabic": "أَرَى", "translit": "àَrَaʾ", "root": "راي"}, {"id": 8, "arabic": "ٱلْهُدْهُدَ", "translit": "َdُhْdُhْlٱ", "root": "هدهد"}, {"id": 9, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 10, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 11, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 12, "arabic": "ٱلْغَآئِبِينَ", "translit": "َnyِbِyʾٓāَغْlٱ", "root": "غيب"}], "hasIhya": false}, {"ayah": 21, "text": "لَأُعَذِّبَنَّهُۥ عَذَابًا شَدِيدًا أَوْ لَأَا۟ذْبَحَنَّهُۥٓ أَوْ لَيَأْتِيَنِّى بِسُلْطَٰنٍ مُّبِينٍ ", "translation": "I will surely punish him with a severe punishment or slaughter him unless he brings me clear authorization.\"[1]", "words": [{"id": 1, "arabic": "لَأُعَذِّبَنَّهُۥ", "translit": "ۥُhَّnَbِّhdَʿعُaʾَl", "root": "عذب"}, {"id": 2, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 3, "arabic": "شَدِيدًا", "translit": "āًdyِdَhs", "root": "شدد"}, {"id": 4, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 5, "arabic": "لَأَا۟ذْبَحَنَّهُۥٓ", "translit": "ٓۥُhَّnَḥَbْhd۟āَaʾَl", "root": "ذبح"}, {"id": 6, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 7, "arabic": "لَيَأْتِيَنِّى", "translit": "àِّnَyِtْaʾَyَl", "root": "اتي"}, {"id": 8, "arabic": "بِسُلْطَٰنٍ", "translit": "ٍnَٰṭْlُsِb", "root": "سلط"}, {"id": 9, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 22, "text": "فَمَكَثَ غَيْرَ بَعِيدٍ فَقَالَ أَحَطتُ بِمَا لَمْ تُحِطْ بِهِۦ وَجِئْتُكَ مِن سَبَإٍۭ بِنَبَإٍ يَقِينٍ ", "translation": "But he [i.e., the hoopoe] stayed not long and said, \"I have encompassed [in knowledge] that which you have not encompassed, and I have come to you from Sheba with certain news.", "words": [{"id": 1, "arabic": "فَمَكَثَ", "translit": "َhtَkَmَf", "root": "مكث"}, {"id": 2, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 3, "arabic": "بَعِيدٍ", "translit": "ٍdyِʿعَb", "root": "بعد"}, {"id": 4, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 5, "arabic": "أَحَطتُ", "translit": "ُtṭَḥَaʾ", "root": "حوط"}, {"id": 6, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 7, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 8, "arabic": "تُحِطْ", "translit": "ْṭِḥُt", "root": "حوط"}, {"id": 9, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 10, "arabic": "وَجِئْتُكَ", "translit": "َkُtْyʾِjgَw", "root": "جيا"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "سَبَإٍۭ", "translit": "ٍۭiʾَbَs", "root": "سبا"}, {"id": 13, "arabic": "بِنَبَإٍ", "translit": "ٍiʾَbَnِb", "root": "نبا"}, {"id": 14, "arabic": "يَقِينٍ", "translit": "ٍnyِqَy", "root": "يقن"}], "hasIhya": false}, {"ayah": 23, "text": "إِنِّى وَجَدتُّ ٱمْرَأَةً تَمْلِكُهُمْ وَأُوتِيَتْ مِن كُلِّ شَىْءٍ وَلَهَا عَرْشٌ عَظِيمٌ ", "translation": "Indeed, I found [there] a woman ruling them, and she has been given of all things, and she has a great throne.", "words": [{"id": 1, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 2, "arabic": "وَجَدتُّ", "translit": "ُّtdَjgَw", "root": "وجد"}, {"id": 3, "arabic": "ٱمْرَأَةً", "translit": "ًẗَaʾَrْmٱ", "root": "مرا"}, {"id": 4, "arabic": "تَمْلِكُهُمْ", "translit": "ْmُhُkِlْmَt", "root": "ملك"}, {"id": 5, "arabic": "وَأُوتِيَتْ", "translit": "ْtَyِtwُaʾَw", "root": "اتي"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 8, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 9, "arabic": "وَلَهَا", "translit": "āَhَlَw", "root": ""}, {"id": 10, "arabic": "عَرْشٌ", "translit": "ٌhsْrَʿع", "root": "عرش"}, {"id": 11, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 24, "text": "وَجَدتُّهَا وَقَوْمَهَا يَسْجُدُونَ لِلشَّمْسِ مِن دُونِ ٱللَّهِ وَزَيَّنَ لَهُمُ ٱلشَّيْطَٰنُ أَعْمَٰلَهُمْ فَصَدَّهُمْ عَنِ ٱلسَّبِيلِ فَهُمْ لَا يَهْتَدُونَ ", "translation": "I found her and her people prostrating to the sun instead of Allāh, and Satan has made their deeds pleasing to them and averted them from [His] way, so they are not guided,", "words": [{"id": 1, "arabic": "وَجَدتُّهَا", "translit": "āَhُّtdَjgَw", "root": "وجد"}, {"id": 2, "arabic": "وَقَوْمَهَا", "translit": "āَhَmْwَqَw", "root": "قوم"}, {"id": 3, "arabic": "يَسْجُدُونَ", "translit": "َnwُdُjgْsَy", "root": "سجد"}, {"id": 4, "arabic": "لِلشَّمْسِ", "translit": "ِsْmَّhslِl", "root": "شمس"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "وَزَيَّنَ", "translit": "َnَّyَzَw", "root": "زين"}, {"id": 9, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 10, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 11, "arabic": "أَعْمَٰلَهُمْ", "translit": "ْmُhَlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 12, "arabic": "فَصَدَّهُمْ", "translit": "ْmُhَّdَṣَf", "root": "صدد"}, {"id": 13, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 14, "arabic": "ٱلسَّبِيلِ", "translit": "ِlyِbَّslٱ", "root": "سبل"}, {"id": 15, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 16, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 17, "arabic": "يَهْتَدُونَ", "translit": "َnwُdَtْhَy", "root": "هدي"}], "hasIhya": false}, {"ayah": 25, "text": "أَلَّا يَسْجُدُوا۟ لِلَّهِ ٱلَّذِى يُخْرِجُ ٱلْخَبْءَ فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَيَعْلَمُ مَا تُخْفُونَ وَمَا تُعْلِنُونَ ", "translation": "[And] so they do not prostrate to Allāh, who brings forth what is hidden within the heavens and the earth and knows what you conceal and what you declare -", "words": [{"id": 1, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 2, "arabic": "يَسْجُدُوا۟", "translit": "۟āwُdُjgْsَy", "root": "سجد"}, {"id": 3, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 4, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "يُخْرِجُ", "translit": "ُjgِrْhkُy", "root": "خرج"}, {"id": 6, "arabic": "ٱلْخَبْءَ", "translit": "َءْbَhkْlٱ", "root": "خبا"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 9, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 10, "arabic": "وَيَعْلَمُ", "translit": "ُmَlْʿعَyَw", "root": "علم"}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "تُخْفُونَ", "translit": "َnwُfْhkُt", "root": "خفي"}, {"id": 13, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 14, "arabic": "تُعْلِنُونَ", "translit": "َnwُnِlْʿعُt", "root": "علن"}], "hasIhya": true}, {"ayah": 26, "text": "ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَ رَبُّ ٱلْعَرْشِ ٱلْعَظِيمِ۩ ", "translation": "Allāh - there is no deity except Him, Lord of the Great Throne.\"", "words": [{"id": 1, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 2, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 3, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 6, "arabic": "رَبُّ", "translit": "ُّbَr", "root": "ربب"}, {"id": 7, "arabic": "ٱلْعَرْشِ", "translit": "ِhsْrَʿعْlٱ", "root": "عرش"}, {"id": 8, "arabic": "ٱلْعَظِيمِ", "translit": "ِmyِẓَʿعْlٱ", "root": "عظم"}], "hasIhya": false}, {"ayah": 27, "text": "قَالَ سَنَنظُرُ أَصَدَقْتَ أَمْ كُنتَ مِنَ ٱلْكَٰذِبِينَ ", "translation": "[Solomon] said, \"We will see whether you were truthful or were of the liars.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "سَنَنظُرُ", "translit": "ُrُẓnَnَs", "root": "نظر"}, {"id": 3, "arabic": "أَصَدَقْتَ", "translit": "َtْqَdَṣَaʾ", "root": "صدق"}, {"id": 4, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 5, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱلْكَٰذِبِينَ", "translit": "َnyِbِhdَٰkْlٱ", "root": "كذب"}], "hasIhya": false}, {"ayah": 28, "text": "ٱذْهَب بِّكِتَٰبِى هَٰذَا فَأَلْقِهْ إِلَيْهِمْ ثُمَّ تَوَلَّ عَنْهُمْ فَٱنظُرْ مَاذَا يَرْجِعُونَ ", "translation": "Take this letter of mine and deliver it to them. Then leave them and see what [answer] they will return.\"", "words": [{"id": 1, "arabic": "ٱذْهَب", "translit": "bَhْhdٱ", "root": "ذهب"}, {"id": 2, "arabic": "بِّكِتَٰبِى", "translit": "àِbَٰtِkِّb", "root": "كتب"}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "فَأَلْقِهْ", "translit": "ْhِqْlَaʾَf", "root": "لقي"}, {"id": 5, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "تَوَلَّ", "translit": "َّlَwَt", "root": "ولي"}, {"id": 8, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 9, "arabic": "فَٱنظُرْ", "translit": "ْrُẓnٱَf", "root": "نظر"}, {"id": 10, "arabic": "مَاذَا", "translit": "āَhdāَm", "root": ""}, {"id": 11, "arabic": "يَرْجِعُونَ", "translit": "َnwُʿعِjgْrَy", "root": "رجع"}], "hasIhya": false}, {"ayah": 29, "text": "قَالَتْ يَٰٓأَيُّهَا ٱلْمَلَؤُا۟ إِنِّىٓ أُلْقِىَ إِلَىَّ كِتَٰبٌ كَرِيمٌ ", "translation": "She said, \"O eminent ones, indeed, to me has been delivered a noble letter.", "words": [{"id": 1, "arabic": "قَالَتْ", "translit": "ْtَlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 3, "arabic": "ٱلْمَلَؤُا۟", "translit": "۟āُwʾَlَmْlٱ", "root": "ملا"}, {"id": 4, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 5, "arabic": "أُلْقِىَ", "translit": "َàِqْlُaʾ", "root": "لقي"}, {"id": 6, "arabic": "إِلَىَّ", "translit": "َّàَlِiʾ", "root": ""}, {"id": 7, "arabic": "كِتَٰبٌ", "translit": "ٌbَٰtِk", "root": "كتب"}, {"id": 8, "arabic": "كَرِيمٌ", "translit": "ٌmyِrَk", "root": "كرم"}], "hasIhya": false}, {"ayah": 30, "text": "إِنَّهُۥ مِن سُلَيْمَٰنَ وَإِنَّهُۥ بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ", "translation": "Indeed, it is from Solomon, and indeed, it is [i.e., reads]: 'In the name of Allāh, the Entirely Merciful, the Especially Merciful,", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "سُلَيْمَٰنَ", "translit": "َnَٰmْyَlُs", "root": ""}, {"id": 4, "arabic": "وَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَw", "root": ""}, {"id": 5, "arabic": "بِسْمِ", "translit": "ِmْsِb", "root": "سمو"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "ٱلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 8, "arabic": "ٱلرَّحِيمِ", "translit": "ِmyِḥَّrlٱ", "root": "رحم"}], "hasIhya": false}, {"ayah": 31, "text": "أَلَّا تَعْلُوا۟ عَلَىَّ وَأْتُونِى مُسْلِمِينَ ", "translation": "Be not haughty with me but come to me in submission [as Muslims].'\"", "words": [{"id": 1, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 2, "arabic": "تَعْلُوا۟", "translit": "۟āwُlْʿعَt", "root": "علو"}, {"id": 3, "arabic": "عَلَىَّ", "translit": "َّàَlَʿع", "root": ""}, {"id": 4, "arabic": "وَأْتُونِى", "translit": "àِnwُtْaʾَw", "root": "اتي"}, {"id": 5, "arabic": "مُسْلِمِينَ", "translit": "َnyِmِlْsُm", "root": "سلم"}], "hasIhya": false}, {"ayah": 32, "text": "قَالَتْ يَٰٓأَيُّهَا ٱلْمَلَؤُا۟ أَفْتُونِى فِىٓ أَمْرِى مَا كُنتُ قَاطِعَةً أَمْرًا حَتَّىٰ تَشْهَدُونِ ", "translation": "She said, \"O eminent ones, advise me in my affair. I would not decide a matter until you witness [for] me.\"[1]", "words": [{"id": 1, "arabic": "قَالَتْ", "translit": "ْtَlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 3, "arabic": "ٱلْمَلَؤُا۟", "translit": "۟āُwʾَlَmْlٱ", "root": "ملا"}, {"id": 4, "arabic": "أَفْتُونِى", "translit": "àِnwُtْfَaʾ", "root": "فتي"}, {"id": 5, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 6, "arabic": "أَمْرِى", "translit": "àِrْmَaʾ", "root": "امر"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "كُنتُ", "translit": "ُtnُk", "root": "كون"}, {"id": 9, "arabic": "قَاطِعَةً", "translit": "ًẗَʿعِṭāَq", "root": "قطع"}, {"id": 10, "arabic": "أَمْرًا", "translit": "āًrْmَaʾ", "root": "امر"}, {"id": 11, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 12, "arabic": "تَشْهَدُونِ", "translit": "ِnwُdَhْhsَt", "root": "شهد"}], "hasIhya": false}, {"ayah": 33, "text": "قَالُوا۟ نَحْنُ أُو۟لُوا۟ قُوَّةٍ وَأُو۟لُوا۟ بَأْسٍ شَدِيدٍ وَٱلْأَمْرُ إِلَيْكِ فَٱنظُرِى مَاذَا تَأْمُرِينَ ", "translation": "They said, \"We are men of strength and of great military might, but the command is yours, so see what you will command.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 3, "arabic": "أُو۟لُوا۟", "translit": "۟āwُl۟wُaʾ", "root": ""}, {"id": 4, "arabic": "قُوَّةٍ", "translit": "ٍẗَّwُq", "root": "قوي"}, {"id": 5, "arabic": "وَأُو۟لُوا۟", "translit": "۟āwُl۟wُaʾَw", "root": ""}, {"id": 6, "arabic": "بَأْسٍ", "translit": "ٍsْaʾَb", "root": "باس"}, {"id": 7, "arabic": "شَدِيدٍ", "translit": "ٍdyِdَhs", "root": "شدد"}, {"id": 8, "arabic": "وَٱلْأَمْرُ", "translit": "ُrْmَaʾْlٱَw", "root": "امر"}, {"id": 9, "arabic": "إِلَيْكِ", "translit": "ِkْyَlِiʾ", "root": ""}, {"id": 10, "arabic": "فَٱنظُرِى", "translit": "àِrُẓnٱَf", "root": "نظر"}, {"id": 11, "arabic": "مَاذَا", "translit": "āَhdāَm", "root": ""}, {"id": 12, "arabic": "تَأْمُرِينَ", "translit": "َnyِrُmْaʾَt", "root": "امر"}], "hasIhya": false}, {"ayah": 34, "text": "قَالَتْ إِنَّ ٱلْمُلُوكَ إِذَا دَخَلُوا۟ قَرْيَةً أَفْسَدُوهَا وَجَعَلُوٓا۟ أَعِزَّةَ أَهْلِهَآ أَذِلَّةًۖ وَكَذَٰلِكَ يَفْعَلُونَ ", "translation": "She said, \"Indeed kings - when they enter a city, they ruin it and render the honored of its people humbled. And thus do they do.", "words": [{"id": 1, "arabic": "قَالَتْ", "translit": "ْtَlāَq", "root": "قول"}, {"id": 2, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 3, "arabic": "ٱلْمُلُوكَ", "translit": "َkwُlُmْlٱ", "root": "ملك"}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "دَخَلُوا۟", "translit": "۟āwُlَhkَd", "root": "دخل"}, {"id": 6, "arabic": "قَرْيَةً", "translit": "ًẗَyْrَq", "root": "قري"}, {"id": 7, "arabic": "أَفْسَدُوهَا", "translit": "āَhwُdَsْfَaʾ", "root": "فسد"}, {"id": 8, "arabic": "وَجَعَلُوٓا۟", "translit": "۟āٓwُlَʿعَjgَw", "root": "جعل"}, {"id": 9, "arabic": "أَعِزَّةَ", "translit": "َẗَّzِʿعَaʾ", "root": "عزز"}, {"id": 10, "arabic": "أَهْلِهَآ", "translit": "ٓāَhِlْhَaʾ", "root": "اهل"}, {"id": 11, "arabic": "أَذِلَّةً", "translit": "ًẗَّlِhdَaʾ", "root": "ذلل"}, {"id": 12, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 13, "arabic": "يَفْعَلُونَ", "translit": "َnwُlَʿعْfَy", "root": "فعل"}], "hasIhya": false}, {"ayah": 35, "text": "وَإِنِّى مُرْسِلَةٌ إِلَيْهِم بِهَدِيَّةٍ فَنَاظِرَةٌۢ بِمَ يَرْجِعُ ٱلْمُرْسَلُونَ ", "translation": "But indeed, I will send to them a gift and see with what [reply] the messengers will return.\"", "words": [{"id": 1, "arabic": "وَإِنِّى", "translit": "àِّnِiʾَw", "root": ""}, {"id": 2, "arabic": "مُرْسِلَةٌ", "translit": "ٌẗَlِsْrُm", "root": "رسل"}, {"id": 3, "arabic": "إِلَيْهِم", "translit": "mِhْyَlِiʾ", "root": ""}, {"id": 4, "arabic": "بِهَدِيَّةٍ", "translit": "ٍẗَّyِdَhِb", "root": "هدي"}, {"id": 5, "arabic": "فَنَاظِرَةٌۢ", "translit": "ٌۢẗَrِẓāَnَf", "root": "نظر"}, {"id": 6, "arabic": "بِمَ", "translit": "َmِb", "root": ""}, {"id": 7, "arabic": "يَرْجِعُ", "translit": "ُʿعِjgْrَy", "root": "رجع"}, {"id": 8, "arabic": "ٱلْمُرْسَلُونَ", "translit": "َnwُlَsْrُmْlٱ", "root": "رسل"}], "hasIhya": false}, {"ayah": 36, "text": "فَلَمَّا جَآءَ سُلَيْمَٰنَ قَالَ أَتُمِدُّونَنِ بِمَالٍ فَمَآ ءَاتَىٰنِۦَ ٱللَّهُ خَيْرٌ مِّمَّآ ءَاتَىٰكُم بَلْ أَنتُم بِهَدِيَّتِكُمْ تَفْرَحُونَ ", "translation": "So when they came to Solomon, he said, \"Do you provide me with wealth? But what Allāh has given me is better than what He has given you. Rather, it is you who rejoice in your gift.", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "سُلَيْمَٰنَ", "translit": "َnَٰmْyَlُs", "root": ""}, {"id": 4, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 5, "arabic": "أَتُمِدُّونَنِ", "translit": "ِnَnwُّdِmُtَaʾ", "root": "مدد"}, {"id": 6, "arabic": "بِمَالٍ", "translit": "ٍlāَmِb", "root": "مول"}, {"id": 7, "arabic": "فَمَآ", "translit": "ٓāَmَf", "root": ""}, {"id": 8, "arabic": "ءَاتَىٰنِۦَ", "translit": "َۦِnٰàَtāَء", "root": "اتي"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 11, "arabic": "مِّمَّآ", "translit": "ٓāَّmِّm", "root": ""}, {"id": 12, "arabic": "ءَاتَىٰكُم", "translit": "mُkٰàَtāَء", "root": "اتي"}, {"id": 13, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 14, "arabic": "أَنتُم", "translit": "mُtnَaʾ", "root": ""}, {"id": 15, "arabic": "بِهَدِيَّتِكُمْ", "translit": "ْmُkِtَّyِdَhِb", "root": "هدي"}, {"id": 16, "arabic": "تَفْرَحُونَ", "translit": "َnwُḥَrْfَt", "root": "فرح"}], "hasIhya": false}, {"ayah": 37, "text": "ٱرْجِعْ إِلَيْهِمْ فَلَنَأْتِيَنَّهُم بِجُنُودٍ لَّا قِبَلَ لَهُم بِهَا وَلَنُخْرِجَنَّهُم مِّنْهَآ أَذِلَّةً وَهُمْ صَٰغِرُونَ ", "translation": "Return to them, for we will surely come to them with soldiers that they will be powerless to encounter, and we will surely expel them therefrom in humiliation, and they will be debased.\"", "words": [{"id": 1, "arabic": "ٱرْجِعْ", "translit": "ْʿعِjgْrٱ", "root": "رجع"}, {"id": 2, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 3, "arabic": "فَلَنَأْتِيَنَّهُم", "translit": "mُhَّnَyِtْaʾَnَlَf", "root": "اتي"}, {"id": 4, "arabic": "بِجُنُودٍ", "translit": "ٍdwُnُjgِb", "root": "جند"}, {"id": 5, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 6, "arabic": "قِبَلَ", "translit": "َlَbِq", "root": "قبل"}, {"id": 7, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 8, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 9, "arabic": "وَلَنُخْرِجَنَّهُم", "translit": "mُhَّnَjgِrْhkُnَlَw", "root": "خرج"}, {"id": 10, "arabic": "مِّنْهَآ", "translit": "ٓāَhْnِّm", "root": ""}, {"id": 11, "arabic": "أَذِلَّةً", "translit": "ًẗَّlِhdَaʾ", "root": "ذلل"}, {"id": 12, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 13, "arabic": "صَٰغِرُونَ", "translit": "َnwُrِغَٰṣ", "root": "صغر"}], "hasIhya": false}, {"ayah": 38, "text": "قَالَ يَٰٓأَيُّهَا ٱلْمَلَؤُا۟ أَيُّكُمْ يَأْتِينِى بِعَرْشِهَا قَبْلَ أَن يَأْتُونِى مُسْلِمِينَ ", "translation": "[Solomon] said, \"O assembly [of jinn], which of you will bring me her throne before they come to me in submission?\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 3, "arabic": "ٱلْمَلَؤُا۟", "translit": "۟āُwʾَlَmْlٱ", "root": "ملا"}, {"id": 4, "arabic": "أَيُّكُمْ", "translit": "ْmُkُّyَaʾ", "root": "ايي"}, {"id": 5, "arabic": "يَأْتِينِى", "translit": "àِnyِtْaʾَy", "root": "اتي"}, {"id": 6, "arabic": "بِعَرْشِهَا", "translit": "āَhِhsْrَʿعِb", "root": "عرش"}, {"id": 7, "arabic": "قَبْلَ", "translit": "َlْbَq", "root": "قبل"}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "يَأْتُونِى", "translit": "àِnwُtْaʾَy", "root": "اتي"}, {"id": 10, "arabic": "مُسْلِمِينَ", "translit": "َnyِmِlْsُm", "root": "سلم"}], "hasIhya": false}, {"ayah": 39, "text": "قَالَ عِفْرِيتٌ مِّنَ ٱلْجِنِّ أَنَا۠ ءَاتِيكَ بِهِۦ قَبْلَ أَن تَقُومَ مِن مَّقَامِكَۖ وَإِنِّى عَلَيْهِ لَقَوِىٌّ أَمِينٌ ", "translation": "A powerful one from among the jinn said, \"I will bring it to you before you rise from your place, and indeed, I am for this [task] strong and trustworthy.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "عِفْرِيتٌ", "translit": "ٌtyِrْfِʿع", "root": "عفر"}, {"id": 3, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 4, "arabic": "ٱلْجِنِّ", "translit": "ِّnِjgْlٱ", "root": "جنن"}, {"id": 5, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 6, "arabic": "ءَاتِيكَ", "translit": "َkyِtāَء", "root": "اتي"}, {"id": 7, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 8, "arabic": "قَبْلَ", "translit": "َlْbَq", "root": "قبل"}, {"id": 9, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 10, "arabic": "تَقُومَ", "translit": "َmwُqَt", "root": "قوم"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "مَّقَامِكَ", "translit": "َkِmāَqَّm", "root": "قوم"}, {"id": 13, "arabic": "وَإِنِّى", "translit": "àِّnِiʾَw", "root": ""}, {"id": 14, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 15, "arabic": "لَقَوِىٌّ", "translit": "ٌّàِwَqَl", "root": "قوي"}, {"id": 16, "arabic": "أَمِينٌ", "translit": "ٌnyِmَaʾ", "root": "امن"}], "hasIhya": false}, {"ayah": 40, "text": "قَالَ ٱلَّذِى عِندَهُۥ عِلْمٌ مِّنَ ٱلْكِتَٰبِ أَنَا۠ ءَاتِيكَ بِهِۦ قَبْلَ أَن يَرْتَدَّ إِلَيْكَ طَرْفُكَۚ فَلَمَّا رَءَاهُ مُسْتَقِرًّا عِندَهُۥ قَالَ هَٰذَا مِن فَضْلِ رَبِّى لِيَبْلُوَنِىٓ ءَأَشْكُرُ أَمْ أَكْفُرُۖ وَمَن شَكَرَ فَإِنَّمَا يَشْكُرُ لِنَفْسِهِۦۖ وَمَن كَفَرَ فَإِنَّ رَبِّى غَنِىٌّ كَرِيمٌ ", "translation": "Said one who had knowledge from the Scripture, \"I will bring it to you before your glance returns to you.\" And when [Solomon] saw it placed before him, he said, \"This is from the favor of my Lord to test me whether I will be grateful or ungrateful. And whoever is grateful - his gratitude is only for [the benefit of] himself. And whoever is ungrateful - then indeed, my Lord is Free of need and Generous.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "عِندَهُۥ", "translit": "ۥُhَdnِʿع", "root": "عند"}, {"id": 4, "arabic": "عِلْمٌ", "translit": "ٌmْlِʿع", "root": "علم"}, {"id": 5, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 6, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 7, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 8, "arabic": "ءَاتِيكَ", "translit": "َkyِtāَء", "root": "اتي"}, {"id": 9, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 10, "arabic": "قَبْلَ", "translit": "َlْbَq", "root": "قبل"}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "يَرْتَدَّ", "translit": "َّdَtْrَy", "root": "ردد"}, {"id": 13, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 14, "arabic": "طَرْفُكَ", "translit": "َkُfْrَṭ", "root": "طرف"}, {"id": 15, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 16, "arabic": "رَءَاهُ", "translit": "ُhāَءَr", "root": "راي"}, {"id": 17, "arabic": "مُسْتَقِرًّا", "translit": "āًّrِqَtْsُm", "root": "قرر"}, {"id": 18, "arabic": "عِندَهُۥ", "translit": "ۥُhَdnِʿع", "root": "عند"}, {"id": 19, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 20, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 21, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 22, "arabic": "فَضْلِ", "translit": "ِlْḍَf", "root": "فضل"}, {"id": 23, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 24, "arabic": "لِيَبْلُوَنِىٓ", "translit": "ٓàِnَwُlْbَyِl", "root": "بلو"}, {"id": 25, "arabic": "ءَأَشْكُرُ", "translit": "ُrُkْhsَaʾَء", "root": "شكر"}, {"id": 26, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 27, "arabic": "أَكْفُرُ", "translit": "ُrُfْkَaʾ", "root": "كفر"}, {"id": 28, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 29, "arabic": "شَكَرَ", "translit": "َrَkَhs", "root": "شكر"}, {"id": 30, "arabic": "فَإِنَّمَا", "translit": "āَmَّnِiʾَf", "root": ""}, {"id": 31, "arabic": "يَشْكُرُ", "translit": "ُrُkْhsَy", "root": "شكر"}, {"id": 32, "arabic": "لِنَفْسِهِۦ", "translit": "ۦِhِsْfَnِl", "root": "نفس"}, {"id": 33, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 34, "arabic": "كَفَرَ", "translit": "َrَfَk", "root": "كفر"}, {"id": 35, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 36, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 37, "arabic": "غَنِىٌّ", "translit": "ٌّàِnَغ", "root": "غني"}, {"id": 38, "arabic": "كَرِيمٌ", "translit": "ٌmyِrَk", "root": "كرم"}], "hasIhya": true}, {"ayah": 41, "text": "قَالَ نَكِّرُوا۟ لَهَا عَرْشَهَا نَنظُرْ أَتَهْتَدِىٓ أَمْ تَكُونُ مِنَ ٱلَّذِينَ لَا يَهْتَدُونَ ", "translation": "He said, \"Disguise for her her throne; we will see whether she will be guided [to truth] or will be of those who is not guided.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "نَكِّرُوا۟", "translit": "۟āwُrِّkَn", "root": "نكر"}, {"id": 3, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 4, "arabic": "عَرْشَهَا", "translit": "āَhَhsْrَʿع", "root": "عرش"}, {"id": 5, "arabic": "نَنظُرْ", "translit": "ْrُẓnَn", "root": "نظر"}, {"id": 6, "arabic": "أَتَهْتَدِىٓ", "translit": "ٓàِdَtْhَtَaʾ", "root": "هدي"}, {"id": 7, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 8, "arabic": "تَكُونُ", "translit": "ُnwُkَt", "root": "كون"}, {"id": 9, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 10, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "يَهْتَدُونَ", "translit": "َnwُdَtْhَy", "root": "هدي"}], "hasIhya": false}, {"ayah": 42, "text": "فَلَمَّا جَآءَتْ قِيلَ أَهَٰكَذَا عَرْشُكِۖ قَالَتْ كَأَنَّهُۥ هُوَۚ وَأُوتِينَا ٱلْعِلْمَ مِن قَبْلِهَا وَكُنَّا مُسْلِمِينَ ", "translation": "So when she arrived, it was said [to her], \"Is your throne like this?\" She said, \"[It is] as though it was it.\" [Solomon said], \"And we were given knowledge before her, and we have been Muslims [in submission to Allāh].", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "جَآءَتْ", "translit": "ْtَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 4, "arabic": "أَهَٰكَذَا", "translit": "āَhdَkَٰhَaʾ", "root": ""}, {"id": 5, "arabic": "عَرْشُكِ", "translit": "ِkُhsْrَʿع", "root": "عرش"}, {"id": 6, "arabic": "قَالَتْ", "translit": "ْtَlāَq", "root": "قول"}, {"id": 7, "arabic": "كَأَنَّهُۥ", "translit": "ۥُhَّnَaʾَk", "root": ""}, {"id": 8, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 9, "arabic": "وَأُوتِينَا", "translit": "āَnyِtwُaʾَw", "root": "اتي"}, {"id": 10, "arabic": "ٱلْعِلْمَ", "translit": "َmْlِʿعْlٱ", "root": "علم"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "قَبْلِهَا", "translit": "āَhِlْbَq", "root": "قبل"}, {"id": 13, "arabic": "وَكُنَّا", "translit": "āَّnُkَw", "root": "كون"}, {"id": 14, "arabic": "مُسْلِمِينَ", "translit": "َnyِmِlْsُm", "root": "سلم"}], "hasIhya": false}, {"ayah": 43, "text": "وَصَدَّهَا مَا كَانَت تَّعْبُدُ مِن دُونِ ٱللَّهِۖ إِنَّهَا كَانَتْ مِن قَوْمٍ كَٰفِرِينَ ", "translation": "And that which she was worshipping other than Allāh had averted her [from submission to Him]. Indeed, she was from a disbelieving people.\"", "words": [{"id": 1, "arabic": "وَصَدَّهَا", "translit": "āَhَّdَṣَw", "root": "صدد"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "كَانَت", "translit": "tَnāَk", "root": "كون"}, {"id": 4, "arabic": "تَّعْبُدُ", "translit": "ُdُbْʿعَّt", "root": "عبد"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "إِنَّهَا", "translit": "āَhَّnِiʾ", "root": ""}, {"id": 9, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "قَوْمٍ", "translit": "ٍmْwَq", "root": "قوم"}, {"id": 12, "arabic": "كَٰفِرِينَ", "translit": "َnyِrِfَٰk", "root": "كفر"}], "hasIhya": false}, {"ayah": 44, "text": "قِيلَ لَهَا ٱدْخُلِى ٱلصَّرْحَۖ فَلَمَّا رَأَتْهُ حَسِبَتْهُ لُجَّةً وَكَشَفَتْ عَن سَاقَيْهَاۚ قَالَ إِنَّهُۥ صَرْحٌ مُّمَرَّدٌ مِّن قَوَارِيرَۗ قَالَتْ رَبِّ إِنِّى ظَلَمْتُ نَفْسِى وَأَسْلَمْتُ مَعَ سُلَيْمَٰنَ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ ", "translation": "She was told, \"Enter the palace.\" But when she saw it, she thought it was a body of water[1] and uncovered her shins [to wade through]. He said, \"Indeed, it is a palace [whose floor is] made smooth with glass.\" She said, \"My Lord, indeed I have wronged myself, and I submit with Solomon to Allāh, Lord of the worlds.\"", "words": [{"id": 1, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 2, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 3, "arabic": "ٱدْخُلِى", "translit": "àِlُhkْdٱ", "root": "دخل"}, {"id": 4, "arabic": "ٱلصَّرْحَ", "translit": "َḥْrَّṣlٱ", "root": "صرح"}, {"id": 5, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 6, "arabic": "رَأَتْهُ", "translit": "ُhْtَaʾَr", "root": "راي"}, {"id": 7, "arabic": "حَسِبَتْهُ", "translit": "ُhْtَbِsَḥ", "root": "حسب"}, {"id": 8, "arabic": "لُجَّةً", "translit": "ًẗَّjgُl", "root": "لجج"}, {"id": 9, "arabic": "وَكَشَفَتْ", "translit": "ْtَfَhsَkَw", "root": "كشف"}, {"id": 10, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 11, "arabic": "سَاقَيْهَا", "translit": "āَhْyَqāَs", "root": "سوق"}, {"id": 12, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 13, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 14, "arabic": "صَرْحٌ", "translit": "ٌḥْrَṣ", "root": "صرح"}, {"id": 15, "arabic": "مُّمَرَّدٌ", "translit": "ٌdَّrَmُّm", "root": "مرد"}, {"id": 16, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 17, "arabic": "قَوَارِيرَ", "translit": "َryِrāَwَq", "root": "قرر"}, {"id": 18, "arabic": "قَالَتْ", "translit": "ْtَlāَq", "root": "قول"}, {"id": 19, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 20, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 21, "arabic": "ظَلَمْتُ", "translit": "ُtْmَlَẓ", "root": "ظلم"}, {"id": 22, "arabic": "نَفْسِى", "translit": "àِsْfَn", "root": "نفس"}, {"id": 23, "arabic": "وَأَسْلَمْتُ", "translit": "ُtْmَlْsَaʾَw", "root": "سلم"}, {"id": 24, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 25, "arabic": "سُلَيْمَٰنَ", "translit": "َnَٰmْyَlُs", "root": ""}, {"id": 26, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 27, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 28, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 45, "text": "وَلَقَدْ أَرْسَلْنَآ إِلَىٰ ثَمُودَ أَخَاهُمْ صَٰلِحًا أَنِ ٱعْبُدُوا۟ ٱللَّهَ فَإِذَا هُمْ فَرِيقَانِ يَخْتَصِمُونَ ", "translation": "And We had certainly sent to Thamūd their brother Ṣāliḥ, [saying], \"Worship Allāh,\" and at once they were two parties conflicting.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَآ", "translit": "ٓāَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 4, "arabic": "ثَمُودَ", "translit": "َdwُmَht", "root": ""}, {"id": 5, "arabic": "أَخَاهُمْ", "translit": "ْmُhāَhkَaʾ", "root": "اخو"}, {"id": 6, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 7, "arabic": "أَنِ", "translit": "ِnَaʾ", "root": ""}, {"id": 8, "arabic": "ٱعْبُدُوا۟", "translit": "۟āwُdُbْʿعٱ", "root": "عبد"}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 11, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 12, "arabic": "فَرِيقَانِ", "translit": "ِnāَqyِrَf", "root": "فرق"}, {"id": 13, "arabic": "يَخْتَصِمُونَ", "translit": "َnwُmِṣَtْhkَy", "root": "خصم"}], "hasIhya": false}, {"ayah": 46, "text": "قَالَ يَٰقَوْمِ لِمَ تَسْتَعْجِلُونَ بِٱلسَّيِّئَةِ قَبْلَ ٱلْحَسَنَةِۖ لَوْلَا تَسْتَغْفِرُونَ ٱللَّهَ لَعَلَّكُمْ تُرْحَمُونَ ", "translation": "He said, \"O my people, why are you impatient for evil before [i.e., instead of] good?[1] Why do you not seek forgiveness of Allāh that you may receive mercy?\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 3, "arabic": "لِمَ", "translit": "َmِl", "root": ""}, {"id": 4, "arabic": "تَسْتَعْجِلُونَ", "translit": "َnwُlِjgْʿعَtْsَt", "root": "عجل"}, {"id": 5, "arabic": "بِٱلسَّيِّئَةِ", "translit": "ِẗَyʾِّyَّslٱِb", "root": "سوا"}, {"id": 6, "arabic": "قَبْلَ", "translit": "َlْbَq", "root": "قبل"}, {"id": 7, "arabic": "ٱلْحَسَنَةِ", "translit": "ِẗَnَsَḥْlٱ", "root": "حسن"}, {"id": 8, "arabic": "لَوْلَا", "translit": "āَlْwَl", "root": ""}, {"id": 9, "arabic": "تَسْتَغْفِرُونَ", "translit": "َnwُrِfْغَtْsَt", "root": "غفر"}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 12, "arabic": "تُرْحَمُونَ", "translit": "َnwُmَḥْrُt", "root": "رحم"}], "hasIhya": false}, {"ayah": 47, "text": "قَالُوا۟ ٱطَّيَّرْنَا بِكَ وَبِمَن مَّعَكَۚ قَالَ طَٰٓئِرُكُمْ عِندَ ٱللَّهِۖ بَلْ أَنتُمْ قَوْمٌ تُفْتَنُونَ ", "translation": "They said, \"We consider you a bad omen, you and those with you.\" He said, \"Your omen [i.e., fate] is with Allāh. Rather, you are a people being tested.\"[1]", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱطَّيَّرْنَا", "translit": "āَnْrَّyَّṭٱ", "root": "طير"}, {"id": 3, "arabic": "بِكَ", "translit": "َkِb", "root": ""}, {"id": 4, "arabic": "وَبِمَن", "translit": "nَmِbَw", "root": ""}, {"id": 5, "arabic": "مَّعَكَ", "translit": "َkَʿعَّm", "root": ""}, {"id": 6, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 7, "arabic": "طَٰٓئِرُكُمْ", "translit": "ْmُkُrِyʾَٰٓṭ", "root": "طير"}, {"id": 8, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 11, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 12, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 13, "arabic": "تُفْتَنُونَ", "translit": "َnwُnَtْfُt", "root": "فتن"}], "hasIhya": false}, {"ayah": 48, "text": "وَكَانَ فِى ٱلْمَدِينَةِ تِسْعَةُ رَهْطٍ يُفْسِدُونَ فِى ٱلْأَرْضِ وَلَا يُصْلِحُونَ ", "translation": "And there were in the city nine family heads causing corruption in the land and not amending [its affairs].", "words": [{"id": 1, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ٱلْمَدِينَةِ", "translit": "ِẗَnyِdَmْlٱ", "root": "مدن"}, {"id": 4, "arabic": "تِسْعَةُ", "translit": "ُẗَʿعْsِt", "root": "تسع"}, {"id": 5, "arabic": "رَهْطٍ", "translit": "ٍṭْhَr", "root": "رهط"}, {"id": 6, "arabic": "يُفْسِدُونَ", "translit": "َnwُdِsْfُy", "root": "فسد"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "يُصْلِحُونَ", "translit": "َnwُḥِlْṣُy", "root": "صلح"}], "hasIhya": false}, {"ayah": 49, "text": "قَالُوا۟ تَقَاسَمُوا۟ بِٱللَّهِ لَنُبَيِّتَنَّهُۥ وَأَهْلَهُۥ ثُمَّ لَنَقُولَنَّ لِوَلِيِّهِۦ مَا شَهِدْنَا مَهْلِكَ أَهْلِهِۦ وَإِنَّا لَصَٰدِقُونَ ", "translation": "They said, \"Take a mutual oath by Allāh that we will kill him by night, he and his family. Then we will say to his executor,[1] 'We did not witness the destruction of his family, and indeed, we are truthful.'\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "تَقَاسَمُوا۟", "translit": "۟āwُmَsāَqَt", "root": "قسم"}, {"id": 3, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 4, "arabic": "لَنُبَيِّتَنَّهُۥ", "translit": "ۥُhَّnَtِّyَbُnَl", "root": "بيت"}, {"id": 5, "arabic": "وَأَهْلَهُۥ", "translit": "ۥُhَlْhَaʾَw", "root": "اهل"}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "لَنَقُولَنَّ", "translit": "َّnَlwُqَnَl", "root": "قول"}, {"id": 8, "arabic": "لِوَلِيِّهِۦ", "translit": "ۦِhِّyِlَwِl", "root": "ولي"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "شَهِدْنَا", "translit": "āَnْdِhَhs", "root": "شهد"}, {"id": 11, "arabic": "مَهْلِكَ", "translit": "َkِlْhَm", "root": "هلك"}, {"id": 12, "arabic": "أَهْلِهِۦ", "translit": "ۦِhِlْhَaʾ", "root": "اهل"}, {"id": 13, "arabic": "وَإِنَّا", "translit": "āَّnِiʾَw", "root": ""}, {"id": 14, "arabic": "لَصَٰدِقُونَ", "translit": "َnwُqِdَٰṣَl", "root": "صدق"}], "hasIhya": false}, {"ayah": 50, "text": "وَمَكَرُوا۟ مَكْرًا وَمَكَرْنَا مَكْرًا وَهُمْ لَا يَشْعُرُونَ ", "translation": "And they planned a plan, and We planned a plan, while they perceived not.", "words": [{"id": 1, "arabic": "وَمَكَرُوا۟", "translit": "۟āwُrَkَmَw", "root": "مكر"}, {"id": 2, "arabic": "مَكْرًا", "translit": "āًrْkَm", "root": "مكر"}, {"id": 3, "arabic": "وَمَكَرْنَا", "translit": "āَnْrَkَmَw", "root": "مكر"}, {"id": 4, "arabic": "مَكْرًا", "translit": "āًrْkَm", "root": "مكر"}, {"id": 5, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يَشْعُرُونَ", "translit": "َnwُrُʿعْhsَy", "root": "شعر"}], "hasIhya": true}, {"ayah": 51, "text": "فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ مَكْرِهِمْ أَنَّا دَمَّرْنَٰهُمْ وَقَوْمَهُمْ أَجْمَعِينَ ", "translation": "Then look how was the outcome of their plan - that We destroyed them and their people, all.", "words": [{"id": 1, "arabic": "فَٱنظُرْ", "translit": "ْrُẓnٱَf", "root": "نظر"}, {"id": 2, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 3, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 4, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 5, "arabic": "مَكْرِهِمْ", "translit": "ْmِhِrْkَm", "root": "مكر"}, {"id": 6, "arabic": "أَنَّا", "translit": "āَّnَaʾ", "root": ""}, {"id": 7, "arabic": "دَمَّرْنَٰهُمْ", "translit": "ْmُhَٰnْrَّmَd", "root": "دمر"}, {"id": 8, "arabic": "وَقَوْمَهُمْ", "translit": "ْmُhَmْwَqَw", "root": "قوم"}, {"id": 9, "arabic": "أَجْمَعِينَ", "translit": "َnyِʿعَmْjgَaʾ", "root": "جمع"}], "hasIhya": false}, {"ayah": 52, "text": "فَتِلْكَ بُيُوتُهُمْ خَاوِيَةًۢ بِمَا ظَلَمُوٓا۟ۗ إِنَّ فِى ذَٰلِكَ لَءَايَةً لِّقَوْمٍ يَعْلَمُونَ ", "translation": "So those are their houses, desolate because of the wrong they had done. Indeed in that is a sign for people who know.", "words": [{"id": 1, "arabic": "فَتِلْكَ", "translit": "َkْlِtَf", "root": ""}, {"id": 2, "arabic": "بُيُوتُهُمْ", "translit": "ْmُhُtwُyُb", "root": "بيت"}, {"id": 3, "arabic": "خَاوِيَةًۢ", "translit": "ًۢẗَyِwāَhk", "root": "خوي"}, {"id": 4, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 5, "arabic": "ظَلَمُوٓا۟", "translit": "۟āٓwُmَlَẓ", "root": "ظلم"}, {"id": 6, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 9, "arabic": "لَءَايَةً", "translit": "ًẗَyāَءَl", "root": "ايي"}, {"id": 10, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 11, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 53, "text": "وَأَنجَيْنَا ٱلَّذِينَ ءَامَنُوا۟ وَكَانُوا۟ يَتَّقُونَ ", "translation": "And We saved those who believed and used to fear Allāh.", "words": [{"id": 1, "arabic": "وَأَنجَيْنَا", "translit": "āَnْyَjgnَaʾَw", "root": "نجو"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 5, "arabic": "يَتَّقُونَ", "translit": "َnwُqَّtَy", "root": "وقي"}], "hasIhya": false}, {"ayah": 54, "text": "وَلُوطًا إِذْ قَالَ لِقَوْمِهِۦٓ أَتَأْتُونَ ٱلْفَٰحِشَةَ وَأَنتُمْ تُبْصِرُونَ ", "translation": "And [mention] Lot, when he said to his people, \"Do you commit immorality[1] while you are seeing?[2]", "words": [{"id": 1, "arabic": "وَلُوطًا", "translit": "āًṭwُlَw", "root": ""}, {"id": 2, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 3, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 4, "arabic": "لِقَوْمِهِۦٓ", "translit": "ٓۦِhِmْwَqِl", "root": "قوم"}, {"id": 5, "arabic": "أَتَأْتُونَ", "translit": "َnwُtْaʾَtَaʾ", "root": "اتي"}, {"id": 6, "arabic": "ٱلْفَٰحِشَةَ", "translit": "َẗَhsِḥَٰfْlٱ", "root": "فحش"}, {"id": 7, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 8, "arabic": "تُبْصِرُونَ", "translit": "َnwُrِṣْbُt", "root": "بصر"}], "hasIhya": false}, {"ayah": 55, "text": "أَئِنَّكُمْ لَتَأْتُونَ ٱلرِّجَالَ شَهْوَةً مِّن دُونِ ٱلنِّسَآءِۚ بَلْ أَنتُمْ قَوْمٌ تَجْهَلُونَ ", "translation": "Do you indeed approach men with desire instead of women? Rather, you are a people behaving ignorantly.\"", "words": [{"id": 1, "arabic": "أَئِنَّكُمْ", "translit": "ْmُkَّnِyʾَaʾ", "root": ""}, {"id": 2, "arabic": "لَتَأْتُونَ", "translit": "َnwُtْaʾَtَl", "root": "اتي"}, {"id": 3, "arabic": "ٱلرِّجَالَ", "translit": "َlāَjgِّrlٱ", "root": "رجل"}, {"id": 4, "arabic": "شَهْوَةً", "translit": "ًẗَwْhَhs", "root": "شهو"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 7, "arabic": "ٱلنِّسَآءِ", "translit": "ِءٓāَsِّnlٱ", "root": "نسو"}, {"id": 8, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 9, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 10, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 11, "arabic": "تَجْهَلُونَ", "translit": "َnwُlَhْjgَt", "root": "جهل"}], "hasIhya": false}, {"ayah": 56, "text": "فَمَا كَانَ جَوَابَ قَوْمِهِۦٓ إِلَّآ أَن قَالُوٓا۟ أَخْرِجُوٓا۟ ءَالَ لُوطٍ مِّن قَرْيَتِكُمْۖ إِنَّهُمْ أُنَاسٌ يَتَطَهَّرُونَ ", "translation": "But the answer of his people was not except that they said, \"Expel the family of Lot from your city. Indeed, they are people who keep themselves pure.\"", "words": [{"id": 1, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "جَوَابَ", "translit": "َbāَwَjg", "root": "جوب"}, {"id": 4, "arabic": "قَوْمِهِۦٓ", "translit": "ٓۦِhِmْwَq", "root": "قوم"}, {"id": 5, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 8, "arabic": "أَخْرِجُوٓا۟", "translit": "۟āٓwُjgِrْhkَaʾ", "root": "خرج"}, {"id": 9, "arabic": "ءَالَ", "translit": "َlāَء", "root": "اول"}, {"id": 10, "arabic": "لُوطٍ", "translit": "ٍṭwُl", "root": ""}, {"id": 11, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 12, "arabic": "قَرْيَتِكُمْ", "translit": "ْmُkِtَyْrَq", "root": "قري"}, {"id": 13, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 14, "arabic": "أُنَاسٌ", "translit": "ٌsāَnُaʾ", "root": "انس"}, {"id": 15, "arabic": "يَتَطَهَّرُونَ", "translit": "َnwُrَّhَṭَtَy", "root": "طهر"}], "hasIhya": false}, {"ayah": 57, "text": "فَأَنجَيْنَٰهُ وَأَهْلَهُۥٓ إِلَّا ٱمْرَأَتَهُۥ قَدَّرْنَٰهَا مِنَ ٱلْغَٰبِرِينَ ", "translation": "So We saved him and his family, except for his wife; We destined her to be of those who remained behind.", "words": [{"id": 1, "arabic": "فَأَنجَيْنَٰهُ", "translit": "ُhَٰnْyَjgnَaʾَf", "root": "نجو"}, {"id": 2, "arabic": "وَأَهْلَهُۥٓ", "translit": "ٓۥُhَlْhَaʾَw", "root": "اهل"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱمْرَأَتَهُۥ", "translit": "ۥُhَtَaʾَrْmٱ", "root": "مرا"}, {"id": 5, "arabic": "قَدَّرْنَٰهَا", "translit": "āَhَٰnْrَّdَq", "root": "قدر"}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱلْغَٰبِرِينَ", "translit": "َnyِrِbَٰغْlٱ", "root": "غبر"}], "hasIhya": false}, {"ayah": 58, "text": "وَأَمْطَرْنَا عَلَيْهِم مَّطَرًاۖ فَسَآءَ مَطَرُ ٱلْمُنذَرِينَ ", "translation": "And We rained upon them a rain [of stones], and evil was the rain of those who were warned.", "words": [{"id": 1, "arabic": "وَأَمْطَرْنَا", "translit": "āَnْrَṭْmَaʾَw", "root": "مطر"}, {"id": 2, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "مَّطَرًا", "translit": "āًrَṭَّm", "root": "مطر"}, {"id": 4, "arabic": "فَسَآءَ", "translit": "َءٓāَsَf", "root": "سوا"}, {"id": 5, "arabic": "مَطَرُ", "translit": "ُrَṭَm", "root": "مطر"}, {"id": 6, "arabic": "ٱلْمُنذَرِينَ", "translit": "َnyِrَhdnُmْlٱ", "root": "نذر"}], "hasIhya": false}, {"ayah": 59, "text": "قُلِ ٱلْحَمْدُ لِلَّهِ وَسَلَٰمٌ عَلَىٰ عِبَادِهِ ٱلَّذِينَ ٱصْطَفَىٰٓۗ ءَآللَّهُ خَيْرٌ أَمَّا يُشْرِكُونَ ", "translation": "Say, [O Muḥammad], \"Praise be to Allāh, and peace upon His servants whom He has chosen. Is Allāh better or what they associate with Him?\"", "words": [{"id": 1, "arabic": "قُلِ", "translit": "ِlُq", "root": "قول"}, {"id": 2, "arabic": "ٱلْحَمْدُ", "translit": "ُdْmَḥْlٱ", "root": "حمد"}, {"id": 3, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 4, "arabic": "وَسَلَٰمٌ", "translit": "ٌmَٰlَsَw", "root": "سلم"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "عِبَادِهِ", "translit": "ِhِdāَbِʿع", "root": "عبد"}, {"id": 7, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "ٱصْطَفَىٰٓ", "translit": "ٰٓàَfَṭْṣٱ", "root": "صفو"}, {"id": 9, "arabic": "ءَآللَّهُ", "translit": "ُhَّllٓāَء", "root": "اله"}, {"id": 10, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 11, "arabic": "أَمَّا", "translit": "āَّmَaʾ", "root": ""}, {"id": 12, "arabic": "يُشْرِكُونَ", "translit": "َnwُkِrْhsُy", "root": "شرك"}], "hasIhya": true}, {"ayah": 60, "text": "أَمَّنْ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَأَنزَلَ لَكُم مِّنَ ٱلسَّمَآءِ مَآءً فَأَنۢبَتْنَا بِهِۦ حَدَآئِقَ ذَاتَ بَهْجَةٍ مَّا كَانَ لَكُمْ أَن تُنۢبِتُوا۟ شَجَرَهَآۗ أَءِلَٰهٌ مَّعَ ٱللَّهِۚ بَلْ هُمْ قَوْمٌ يَعْدِلُونَ ", "translation": "[More precisely], is He [not best] who created the heavens and the earth and sent down for you rain from the sky, causing to grow thereby gardens of joyful beauty which you could not [otherwise] have grown the trees thereof? Is there a deity with Allāh?[1] [No], but they are a people who ascribe equals [to Him].", "words": [{"id": 1, "arabic": "أَمَّنْ", "translit": "ْnَّmَaʾ", "root": ""}, {"id": 2, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "وَأَنزَلَ", "translit": "َlَznَaʾَw", "root": "نزل"}, {"id": 6, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 9, "arabic": "مَآءً", "translit": "ًءٓāَm", "root": "موه"}, {"id": 10, "arabic": "فَأَنۢبَتْنَا", "translit": "āَnْtَbۢnَaʾَf", "root": "نبت"}, {"id": 11, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 12, "arabic": "حَدَآئِقَ", "translit": "َqِyʾٓāَdَḥ", "root": "حدق"}, {"id": 13, "arabic": "ذَاتَ", "translit": "َtāَhd", "root": ""}, {"id": 14, "arabic": "بَهْجَةٍ", "translit": "ٍẗَjgْhَb", "root": "بهج"}, {"id": 15, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 16, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 17, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 18, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 19, "arabic": "تُنۢبِتُوا۟", "translit": "۟āwُtِbۢnُt", "root": "نبت"}, {"id": 20, "arabic": "شَجَرَهَآ", "translit": "ٓāَhَrَjgَhs", "root": "شجر"}, {"id": 21, "arabic": "أَءِلَٰهٌ", "translit": "ٌhَٰlِءَaʾ", "root": "اله"}, {"id": 22, "arabic": "مَّعَ", "translit": "َʿعَّm", "root": ""}, {"id": 23, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 25, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 26, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 27, "arabic": "يَعْدِلُونَ", "translit": "َnwُlِdْʿعَy", "root": "عدل"}], "hasIhya": false}, {"ayah": 61, "text": "أَمَّن جَعَلَ ٱلْأَرْضَ قَرَارًا وَجَعَلَ خِلَٰلَهَآ أَنْهَٰرًا وَجَعَلَ لَهَا رَوَٰسِىَ وَجَعَلَ بَيْنَ ٱلْبَحْرَيْنِ حَاجِزًاۗ أَءِلَٰهٌ مَّعَ ٱللَّهِۚ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ ", "translation": "Is He [not best] who made the earth a stable ground and placed within it rivers and made for it firmly set mountains and placed between the two seas a barrier? Is there a deity with Allāh? [No], but most of them do not know.", "words": [{"id": 1, "arabic": "أَمَّن", "translit": "nَّmَaʾ", "root": ""}, {"id": 2, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 4, "arabic": "قَرَارًا", "translit": "āًrāَrَq", "root": "قرر"}, {"id": 5, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 6, "arabic": "خِلَٰلَهَآ", "translit": "ٓāَhَlَٰlِhk", "root": "خلل"}, {"id": 7, "arabic": "أَنْهَٰرًا", "translit": "āًrَٰhْnَaʾ", "root": "نهر"}, {"id": 8, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 9, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 10, "arabic": "رَوَٰسِىَ", "translit": "َàِsَٰwَr", "root": "رسو"}, {"id": 11, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 12, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 13, "arabic": "ٱلْبَحْرَيْنِ", "translit": "ِnْyَrْḥَbْlٱ", "root": "بحر"}, {"id": 14, "arabic": "حَاجِزًا", "translit": "āًzِjgāَḥ", "root": "حجز"}, {"id": 15, "arabic": "أَءِلَٰهٌ", "translit": "ٌhَٰlِءَaʾ", "root": "اله"}, {"id": 16, "arabic": "مَّعَ", "translit": "َʿعَّm", "root": ""}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 19, "arabic": "أَكْثَرُهُمْ", "translit": "ْmُhُrَhtْkَaʾ", "root": "كثر"}, {"id": 20, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 21, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 62, "text": "أَمَّن يُجِيبُ ٱلْمُضْطَرَّ إِذَا دَعَاهُ وَيَكْشِفُ ٱلسُّوٓءَ وَيَجْعَلُكُمْ خُلَفَآءَ ٱلْأَرْضِۗ أَءِلَٰهٌ مَّعَ ٱللَّهِۚ قَلِيلًا مَّا تَذَكَّرُونَ ", "translation": "Is He [not best] who responds to the desperate one when he calls upon Him and removes evil and makes you inheritors of the earth?[1] Is there a deity with Allāh? Little do you remember.", "words": [{"id": 1, "arabic": "أَمَّن", "translit": "nَّmَaʾ", "root": ""}, {"id": 2, "arabic": "يُجِيبُ", "translit": "ُbyِjgُy", "root": "جوب"}, {"id": 3, "arabic": "ٱلْمُضْطَرَّ", "translit": "َّrَṭْḍُmْlٱ", "root": "ضرر"}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "دَعَاهُ", "translit": "ُhāَʿعَd", "root": "دعو"}, {"id": 6, "arabic": "وَيَكْشِفُ", "translit": "ُfِhsْkَyَw", "root": "كشف"}, {"id": 7, "arabic": "ٱلسُّوٓءَ", "translit": "َءٓwُّslٱ", "root": "سوا"}, {"id": 8, "arabic": "وَيَجْعَلُكُمْ", "translit": "ْmُkُlَʿعْjgَyَw", "root": "جعل"}, {"id": 9, "arabic": "خُلَفَآءَ", "translit": "َءٓāَfَlُhk", "root": "خلف"}, {"id": 10, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 11, "arabic": "أَءِلَٰهٌ", "translit": "ٌhَٰlِءَaʾ", "root": "اله"}, {"id": 12, "arabic": "مَّعَ", "translit": "َʿعَّm", "root": ""}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 15, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 16, "arabic": "تَذَكَّرُونَ", "translit": "َnwُrَّkَhdَt", "root": "ذكر"}], "hasIhya": false}, {"ayah": 63, "text": "أَمَّن يَهْدِيكُمْ فِى ظُلُمَٰتِ ٱلْبَرِّ وَٱلْبَحْرِ وَمَن يُرْسِلُ ٱلرِّيَٰحَ بُشْرًۢا بَيْنَ يَدَىْ رَحْمَتِهِۦٓۗ أَءِلَٰهٌ مَّعَ ٱللَّهِۚ تَعَٰلَى ٱللَّهُ عَمَّا يُشْرِكُونَ ", "translation": "Is He [not best] who guides you through the darknesses of the land and sea and who sends the winds as good tidings before His mercy? Is there a deity with Allāh? High is Allāh above whatever they associate with Him.", "words": [{"id": 1, "arabic": "أَمَّن", "translit": "nَّmَaʾ", "root": ""}, {"id": 2, "arabic": "يَهْدِيكُمْ", "translit": "ْmُkyِdْhَy", "root": "هدي"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ظُلُمَٰتِ", "translit": "ِtَٰmُlُẓ", "root": "ظلم"}, {"id": 5, "arabic": "ٱلْبَرِّ", "translit": "ِّrَbْlٱ", "root": "برر"}, {"id": 6, "arabic": "وَٱلْبَحْرِ", "translit": "ِrْḥَbْlٱَw", "root": "بحر"}, {"id": 7, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 8, "arabic": "يُرْسِلُ", "translit": "ُlِsْrُy", "root": "رسل"}, {"id": 9, "arabic": "ٱلرِّيَٰحَ", "translit": "َḥَٰyِّrlٱ", "root": "روح"}, {"id": 10, "arabic": "بُشْرًۢا", "translit": "āًۢrْhsُb", "root": "بشر"}, {"id": 11, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 12, "arabic": "يَدَىْ", "translit": "ْàَdَy", "root": "يدي"}, {"id": 13, "arabic": "رَحْمَتِهِۦٓ", "translit": "ٓۦِhِtَmْḥَr", "root": "رحم"}, {"id": 14, "arabic": "أَءِلَٰهٌ", "translit": "ٌhَٰlِءَaʾ", "root": "اله"}, {"id": 15, "arabic": "مَّعَ", "translit": "َʿعَّm", "root": ""}, {"id": 16, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "تَعَٰلَى", "translit": "àَlَٰʿعَt", "root": "علو"}, {"id": 18, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 20, "arabic": "يُشْرِكُونَ", "translit": "َnwُkِrْhsُy", "root": "شرك"}], "hasIhya": false}, {"ayah": 64, "text": "أَمَّن يَبْدَؤُا۟ ٱلْخَلْقَ ثُمَّ يُعِيدُهُۥ وَمَن يَرْزُقُكُم مِّنَ ٱلسَّمَآءِ وَٱلْأَرْضِۗ أَءِلَٰهٌ مَّعَ ٱللَّهِۚ قُلْ هَاتُوا۟ بُرْهَٰنَكُمْ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "Is He [not best] who begins creation and then repeats it and who provides for you from the heaven and earth? Is there a deity with Allāh? Say, \"Produce your proof, if you should be truthful.\"", "words": [{"id": 1, "arabic": "أَمَّن", "translit": "nَّmَaʾ", "root": ""}, {"id": 2, "arabic": "يَبْدَؤُا۟", "translit": "۟āُwʾَdْbَy", "root": "بدا"}, {"id": 3, "arabic": "ٱلْخَلْقَ", "translit": "َqْlَhkْlٱ", "root": "خلق"}, {"id": 4, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 5, "arabic": "يُعِيدُهُۥ", "translit": "ۥُhُdyِʿعُy", "root": "عود"}, {"id": 6, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 7, "arabic": "يَرْزُقُكُم", "translit": "mُkُqُzْrَy", "root": "رزق"}, {"id": 8, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 9, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 10, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 11, "arabic": "أَءِلَٰهٌ", "translit": "ٌhَٰlِءَaʾ", "root": "اله"}, {"id": 12, "arabic": "مَّعَ", "translit": "َʿعَّm", "root": ""}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 15, "arabic": "هَاتُوا۟", "translit": "۟āwُtāَh", "root": "هات"}, {"id": 16, "arabic": "بُرْهَٰنَكُمْ", "translit": "ْmُkَnَٰhْrُb", "root": "برهن"}, {"id": 17, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 18, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 19, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": false}, {"ayah": 65, "text": "قُل لَّا يَعْلَمُ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ٱلْغَيْبَ إِلَّا ٱللَّهُۚ وَمَا يَشْعُرُونَ أَيَّانَ يُبْعَثُونَ ", "translation": "Say, \"None in the heavens and earth knows the unseen except Allāh, and they do not perceive when they will be resurrected.\"", "words": [{"id": 1, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 2, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 3, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 4, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 7, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 8, "arabic": "ٱلْغَيْبَ", "translit": "َbْyَغْlٱ", "root": "غيب"}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 12, "arabic": "يَشْعُرُونَ", "translit": "َnwُrُʿعْhsَy", "root": "شعر"}, {"id": 13, "arabic": "أَيَّانَ", "translit": "َnāَّyَaʾ", "root": ""}, {"id": 14, "arabic": "يُبْعَثُونَ", "translit": "َnwُhtَʿعْbُy", "root": "بعث"}], "hasIhya": false}, {"ayah": 66, "text": "بَلِ ٱدَّٰرَكَ عِلْمُهُمْ فِى ٱلْءَاخِرَةِۚ بَلْ هُمْ فِى شَكٍّ مِّنْهَاۖ بَلْ هُم مِّنْهَا عَمُونَ ", "translation": "Rather, their knowledge is arrested concerning the Hereafter. Rather, they are in doubt about it. Rather, they are, concerning it, blind.", "words": [{"id": 1, "arabic": "بَلِ", "translit": "ِlَb", "root": ""}, {"id": 2, "arabic": "ٱدَّٰرَكَ", "translit": "َkَrَّٰdٱ", "root": "درك"}, {"id": 3, "arabic": "عِلْمُهُمْ", "translit": "ْmُhُmْlِʿع", "root": "علم"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 6, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 7, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "شَكٍّ", "translit": "ٍّkَhs", "root": "شكك"}, {"id": 10, "arabic": "مِّنْهَا", "translit": "āَhْnِّm", "root": ""}, {"id": 11, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 12, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 13, "arabic": "مِّنْهَا", "translit": "āَhْnِّm", "root": ""}, {"id": 14, "arabic": "عَمُونَ", "translit": "َnwُmَʿع", "root": "عمي"}], "hasIhya": false}, {"ayah": 67, "text": "وَقَالَ ٱلَّذِينَ كَفَرُوٓا۟ أَءِذَا كُنَّا تُرَٰبًا وَءَابَآؤُنَآ أَئِنَّا لَمُخْرَجُونَ ", "translation": "And those who disbelieve say, \"When we have become dust as well as our forefathers, will we indeed be brought out [of the graves]?", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "أَءِذَا", "translit": "āَhdِءَaʾ", "root": ""}, {"id": 5, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 6, "arabic": "تُرَٰبًا", "translit": "āًbَٰrُt", "root": "ترب"}, {"id": 7, "arabic": "وَءَابَآؤُنَآ", "translit": "ٓāَnُwʾٓāَbāَءَw", "root": "ابو"}, {"id": 8, "arabic": "أَئِنَّا", "translit": "āَّnِyʾَaʾ", "root": ""}, {"id": 9, "arabic": "لَمُخْرَجُونَ", "translit": "َnwُjgَrْhkُmَl", "root": "خرج"}], "hasIhya": false}, {"ayah": 68, "text": "لَقَدْ وُعِدْنَا هَٰذَا نَحْنُ وَءَابَآؤُنَا مِن قَبْلُ إِنْ هَٰذَآ إِلَّآ أَسَٰطِيرُ ٱلْأَوَّلِينَ ", "translation": "We have been promised this, we and our forefathers, before. This is not but legends of the former peoples.\"", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 2, "arabic": "وُعِدْنَا", "translit": "āَnْdِʿعُw", "root": "وعد"}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 5, "arabic": "وَءَابَآؤُنَا", "translit": "āَnُwʾٓāَbāَءَw", "root": "ابو"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 8, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 9, "arabic": "هَٰذَآ", "translit": "ٓāَhdَٰh", "root": ""}, {"id": 10, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 11, "arabic": "أَسَٰطِيرُ", "translit": "ُryِṭَٰsَaʾ", "root": "سطر"}, {"id": 12, "arabic": "ٱلْأَوَّلِينَ", "translit": "َnyِlَّwَaʾْlٱ", "root": "اول"}], "hasIhya": false}, {"ayah": 69, "text": "قُلْ سِيرُوا۟ فِى ٱلْأَرْضِ فَٱنظُرُوا۟ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُجْرِمِينَ ", "translation": "Say, [O Muḥammad], \"Proceed [i.e., travel] through the land and observe how was the end of the criminals.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "سِيرُوا۟", "translit": "۟āwُryِs", "root": "سير"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 5, "arabic": "فَٱنظُرُوا۟", "translit": "۟āwُrُẓnٱَf", "root": "نظر"}, {"id": 6, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 7, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 8, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 9, "arabic": "ٱلْمُجْرِمِينَ", "translit": "َnyِmِrْjgُmْlٱ", "root": "جرم"}], "hasIhya": false}, {"ayah": 70, "text": "وَلَا تَحْزَنْ عَلَيْهِمْ وَلَا تَكُن فِى ضَيْقٍ مِّمَّا يَمْكُرُونَ ", "translation": "And grieve not over them or be in distress from what they conspire.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَحْزَنْ", "translit": "ْnَzْḥَt", "root": "حزن"}, {"id": 3, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 5, "arabic": "تَكُن", "translit": "nُkَt", "root": "كون"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ضَيْقٍ", "translit": "ٍqْyَḍ", "root": "ضيق"}, {"id": 8, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 9, "arabic": "يَمْكُرُونَ", "translit": "َnwُrُkْmَy", "root": "مكر"}], "hasIhya": false}, {"ayah": 71, "text": "وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلْوَعْدُ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "And they say, \"When is [the fulfillment of] this promise, if you should be truthful?\"", "words": [{"id": 1, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 2, "arabic": "مَتَىٰ", "translit": "ٰàَtَm", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "ٱلْوَعْدُ", "translit": "ُdْʿعَwْlٱ", "root": "وعد"}, {"id": 5, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 6, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 7, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": true}, {"ayah": 72, "text": "قُلْ عَسَىٰٓ أَن يَكُونَ رَدِفَ لَكُم بَعْضُ ٱلَّذِى تَسْتَعْجِلُونَ ", "translation": "Say, \"Perhaps it is close behind you [i.e., very near] - some of that for which you are impatient.", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "عَسَىٰٓ", "translit": "ٰٓàَsَʿع", "root": "عسي"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "يَكُونَ", "translit": "َnwُkَy", "root": "كون"}, {"id": 5, "arabic": "رَدِفَ", "translit": "َfِdَr", "root": "ردف"}, {"id": 6, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 7, "arabic": "بَعْضُ", "translit": "ُḍْʿعَb", "root": "بعض"}, {"id": 8, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "تَسْتَعْجِلُونَ", "translit": "َnwُlِjgْʿعَtْsَt", "root": "عجل"}], "hasIhya": false}, {"ayah": 73, "text": "وَإِنَّ رَبَّكَ لَذُو فَضْلٍ عَلَى ٱلنَّاسِ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَشْكُرُونَ ", "translation": "And indeed, your Lord is the possessor of bounty for the people, but most of them are not grateful.\"", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 3, "arabic": "لَذُو", "translit": "wُhdَl", "root": ""}, {"id": 4, "arabic": "فَضْلٍ", "translit": "ٍlْḍَf", "root": "فضل"}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 7, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 8, "arabic": "أَكْثَرَهُمْ", "translit": "ْmُhَrَhtْkَaʾ", "root": "كثر"}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "يَشْكُرُونَ", "translit": "َnwُrُkْhsَy", "root": "شكر"}], "hasIhya": false}, {"ayah": 74, "text": "وَإِنَّ رَبَّكَ لَيَعْلَمُ مَا تُكِنُّ صُدُورُهُمْ وَمَا يُعْلِنُونَ ", "translation": "And indeed, your Lord knows what their breasts conceal and what they declare.", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 3, "arabic": "لَيَعْلَمُ", "translit": "ُmَlْʿعَyَl", "root": "علم"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "تُكِنُّ", "translit": "ُّnِkُt", "root": "كنن"}, {"id": 6, "arabic": "صُدُورُهُمْ", "translit": "ْmُhُrwُdُṣ", "root": "صدر"}, {"id": 7, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 8, "arabic": "يُعْلِنُونَ", "translit": "َnwُnِlْʿعُy", "root": "علن"}], "hasIhya": false}, {"ayah": 75, "text": "وَمَا مِنْ غَآئِبَةٍ فِى ٱلسَّمَآءِ وَٱلْأَرْضِ إِلَّا فِى كِتَٰبٍ مُّبِينٍ ", "translation": "And there is nothing concealed[1] within the heaven and the earth except that it is in a clear Register.[2]", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 3, "arabic": "غَآئِبَةٍ", "translit": "ٍẗَbِyʾٓāَغ", "root": "غيب"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 7, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "كِتَٰبٍ", "translit": "ٍbَٰtِk", "root": "كتب"}, {"id": 10, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 76, "text": "إِنَّ هَٰذَا ٱلْقُرْءَانَ يَقُصُّ عَلَىٰ بَنِىٓ إِسْرَٰٓءِيلَ أَكْثَرَ ٱلَّذِى هُمْ فِيهِ يَخْتَلِفُونَ ", "translation": "Indeed, this Qur’ān relates to the Children of Israel most of that over which they disagree.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 3, "arabic": "ٱلْقُرْءَانَ", "translit": "َnāَءْrُqْlٱ", "root": "قرا"}, {"id": 4, "arabic": "يَقُصُّ", "translit": "ُّṣُqَy", "root": "قصص"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 7, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 8, "arabic": "أَكْثَرَ", "translit": "َrَhtْkَaʾ", "root": "كثر"}, {"id": 9, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 11, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 12, "arabic": "يَخْتَلِفُونَ", "translit": "َnwُfِlَtْhkَy", "root": "خلف"}], "hasIhya": false}, {"ayah": 77, "text": "وَإِنَّهُۥ لَهُدًى وَرَحْمَةٌ لِّلْمُؤْمِنِينَ ", "translation": "And indeed, it is guidance and mercy for the believers.", "words": [{"id": 1, "arabic": "وَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَw", "root": ""}, {"id": 2, "arabic": "لَهُدًى", "translit": "àًdُhَl", "root": "هدي"}, {"id": 3, "arabic": "وَرَحْمَةٌ", "translit": "ٌẗَmْḥَrَw", "root": "رحم"}, {"id": 4, "arabic": "لِّلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlِّl", "root": "امن"}], "hasIhya": false}, {"ayah": 78, "text": "إِنَّ رَبَّكَ يَقْضِى بَيْنَهُم بِحُكْمِهِۦۚ وَهُوَ ٱلْعَزِيزُ ٱلْعَلِيمُ ", "translation": "Indeed, your Lord will judge between them by His [wise] judgement. And He is the Exalted in Might, the Knowing.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 3, "arabic": "يَقْضِى", "translit": "àِḍْqَy", "root": "قضي"}, {"id": 4, "arabic": "بَيْنَهُم", "translit": "mُhَnْyَb", "root": "بين"}, {"id": 5, "arabic": "بِحُكْمِهِۦ", "translit": "ۦِhِmْkُḥِb", "root": "حكم"}, {"id": 6, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 7, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 8, "arabic": "ٱلْعَلِيمُ", "translit": "ُmyِlَʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 79, "text": "فَتَوَكَّلْ عَلَى ٱللَّهِۖ إِنَّكَ عَلَى ٱلْحَقِّ ٱلْمُبِينِ ", "translation": "So rely upon Allāh; indeed, you are upon the clear truth.", "words": [{"id": 1, "arabic": "فَتَوَكَّلْ", "translit": "ْlَّkَwَtَf", "root": "وكل"}, {"id": 2, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 7, "arabic": "ٱلْمُبِينِ", "translit": "ِnyِbُmْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 80, "text": "إِنَّكَ لَا تُسْمِعُ ٱلْمَوْتَىٰ وَلَا تُسْمِعُ ٱلصُّمَّ ٱلدُّعَآءَ إِذَا وَلَّوْا۟ مُدْبِرِينَ ", "translation": "Indeed, you will not make the dead hear, nor will you make the deaf hear the call when they have turned their backs retreating.", "words": [{"id": 1, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "تُسْمِعُ", "translit": "ُʿعِmْsُt", "root": "سمع"}, {"id": 4, "arabic": "ٱلْمَوْتَىٰ", "translit": "ٰàَtْwَmْlٱ", "root": "موت"}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "تُسْمِعُ", "translit": "ُʿعِmْsُt", "root": "سمع"}, {"id": 7, "arabic": "ٱلصُّمَّ", "translit": "َّmُّṣlٱ", "root": "صمم"}, {"id": 8, "arabic": "ٱلدُّعَآءَ", "translit": "َءٓāَʿعُّdlٱ", "root": "دعو"}, {"id": 9, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 10, "arabic": "وَلَّوْا۟", "translit": "۟āْwَّlَw", "root": "ولي"}, {"id": 11, "arabic": "مُدْبِرِينَ", "translit": "َnyِrِbْdُm", "root": "دبر"}], "hasIhya": false}, {"ayah": 81, "text": "وَمَآ أَنتَ بِهَٰدِى ٱلْعُمْىِ عَن ضَلَٰلَتِهِمْۖ إِن تُسْمِعُ إِلَّا مَن يُؤْمِنُ بِـَٔايَٰتِنَا فَهُم مُّسْلِمُونَ ", "translation": "And you cannot guide the blind away from their error. You will only make hear those who believe in Our verses so they are Muslims [i.e., submitting to Allāh].", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 3, "arabic": "بِهَٰدِى", "translit": "àِdَٰhِb", "root": "هدي"}, {"id": 4, "arabic": "ٱلْعُمْىِ", "translit": "ِàْmُʿعْlٱ", "root": "عمي"}, {"id": 5, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 6, "arabic": "ضَلَٰلَتِهِمْ", "translit": "ْmِhِtَlَٰlَḍ", "root": "ضلل"}, {"id": 7, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 8, "arabic": "تُسْمِعُ", "translit": "ُʿعِmْsُt", "root": "سمع"}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 11, "arabic": "يُؤْمِنُ", "translit": "ُnِmْwʾُy", "root": "امن"}, {"id": 12, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 13, "arabic": "فَهُم", "translit": "mُhَf", "root": ""}, {"id": 14, "arabic": "مُّسْلِمُونَ", "translit": "َnwُmِlْsُّm", "root": "سلم"}], "hasIhya": false}, {"ayah": 82, "text": "وَإِذَا وَقَعَ ٱلْقَوْلُ عَلَيْهِمْ أَخْرَجْنَا لَهُمْ دَآبَّةً مِّنَ ٱلْأَرْضِ تُكَلِّمُهُمْ أَنَّ ٱلنَّاسَ كَانُوا۟ بِـَٔايَٰتِنَا لَا يُوقِنُونَ ", "translation": "And when the word [i.e., decree] befalls them,[1] We will bring forth for them a creature from the earth speaking to them, [saying] that the people were, of Our verses, not certain [in faith].", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "وَقَعَ", "translit": "َʿعَqَw", "root": "وقع"}, {"id": 3, "arabic": "ٱلْقَوْلُ", "translit": "ُlْwَqْlٱ", "root": "قول"}, {"id": 4, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 5, "arabic": "أَخْرَجْنَا", "translit": "āَnْjgَrْhkَaʾ", "root": "خرج"}, {"id": 6, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 7, "arabic": "دَآبَّةً", "translit": "ًẗَّbٓāَd", "root": "دبب"}, {"id": 8, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 9, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 10, "arabic": "تُكَلِّمُهُمْ", "translit": "ْmُhُmِّlَkُt", "root": "كلم"}, {"id": 11, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 12, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 13, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 14, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 15, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 16, "arabic": "يُوقِنُونَ", "translit": "َnwُnِqwُy", "root": "يقن"}], "hasIhya": false}, {"ayah": 83, "text": "وَيَوْمَ نَحْشُرُ مِن كُلِّ أُمَّةٍ فَوْجًا مِّمَّن يُكَذِّبُ بِـَٔايَٰتِنَا فَهُمْ يُوزَعُونَ ", "translation": "And [warn of] the Day when We will gather from every nation a company of those who deny Our signs, and they will be [driven] in rows", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "نَحْشُرُ", "translit": "ُrُhsْḥَn", "root": "حشر"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 5, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 6, "arabic": "فَوْجًا", "translit": "āًjgْwَf", "root": "فوج"}, {"id": 7, "arabic": "مِّمَّن", "translit": "nَّmِّm", "root": ""}, {"id": 8, "arabic": "يُكَذِّبُ", "translit": "ُbِّhdَkُy", "root": "كذب"}, {"id": 9, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 10, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 11, "arabic": "يُوزَعُونَ", "translit": "َnwُʿعَzwُy", "root": "وزع"}], "hasIhya": false}, {"ayah": 84, "text": "حَتَّىٰٓ إِذَا جَآءُو قَالَ أَكَذَّبْتُم بِـَٔايَٰتِى وَلَمْ تُحِيطُوا۟ بِهَا عِلْمًا أَمَّاذَا كُنتُمْ تَعْمَلُونَ ", "translation": "Until, when they arrive [at the place of Judgement], He will say, \"Did you deny My signs while you encompassed them not in knowledge, or what [was it that] you were doing?\"", "words": [{"id": 1, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "جَآءُو", "translit": "wُءٓāَjg", "root": "جيا"}, {"id": 4, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 5, "arabic": "أَكَذَّبْتُم", "translit": "mُtْbَّhdَkَaʾ", "root": "كذب"}, {"id": 6, "arabic": "بِـَٔايَٰتِى", "translit": "àِtَٰyāَٔـِb", "root": "ايي"}, {"id": 7, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 8, "arabic": "تُحِيطُوا۟", "translit": "۟āwُṭyِḥُt", "root": "حوط"}, {"id": 9, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 10, "arabic": "عِلْمًا", "translit": "āًmْlِʿع", "root": "علم"}, {"id": 11, "arabic": "أَمَّاذَا", "translit": "āَhdāَّmَaʾ", "root": ""}, {"id": 12, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 13, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 85, "text": "وَوَقَعَ ٱلْقَوْلُ عَلَيْهِم بِمَا ظَلَمُوا۟ فَهُمْ لَا يَنطِقُونَ ", "translation": "And the decree will befall them[1] for the wrong they did, and they will not [be able to] speak.", "words": [{"id": 1, "arabic": "وَوَقَعَ", "translit": "َʿعَqَwَw", "root": "وقع"}, {"id": 2, "arabic": "ٱلْقَوْلُ", "translit": "ُlْwَqْlٱ", "root": "قول"}, {"id": 3, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 5, "arabic": "ظَلَمُوا۟", "translit": "۟āwُmَlَẓ", "root": "ظلم"}, {"id": 6, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يَنطِقُونَ", "translit": "َnwُqِṭnَy", "root": "نطق"}], "hasIhya": false}, {"ayah": 86, "text": "أَلَمْ يَرَوْا۟ أَنَّا جَعَلْنَا ٱلَّيْلَ لِيَسْكُنُوا۟ فِيهِ وَٱلنَّهَارَ مُبْصِرًاۚ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّقَوْمٍ يُؤْمِنُونَ ", "translation": "Do they not see that We made the night that they may rest therein and the day giving sight? Indeed in that are signs for a people who believe.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 3, "arabic": "أَنَّا", "translit": "āَّnَaʾ", "root": ""}, {"id": 4, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 5, "arabic": "ٱلَّيْلَ", "translit": "َlْyَّlٱ", "root": "ليل"}, {"id": 6, "arabic": "لِيَسْكُنُوا۟", "translit": "۟āwُnُkْsَyِl", "root": "سكن"}, {"id": 7, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 8, "arabic": "وَٱلنَّهَارَ", "translit": "َrāَhَّnlٱَw", "root": "نهر"}, {"id": 9, "arabic": "مُبْصِرًا", "translit": "āًrِṣْbُm", "root": "بصر"}, {"id": 10, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 13, "arabic": "لَءَايَٰتٍ", "translit": "ٍtَٰyāَءَl", "root": "ايي"}, {"id": 14, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 15, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 87, "text": "وَيَوْمَ يُنفَخُ فِى ٱلصُّورِ فَفَزِعَ مَن فِى ٱلسَّمَٰوَٰتِ وَمَن فِى ٱلْأَرْضِ إِلَّا مَن شَآءَ ٱللَّهُۚ وَكُلٌّ أَتَوْهُ دَٰخِرِينَ ", "translation": "And [warn of] the Day the Horn will be blown, and whoever is in the heavens and whoever is on the earth will be terrified except whom Allāh wills. And all will come to Him humbled.", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "يُنفَخُ", "translit": "ُhkَfnُy", "root": "نفخ"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلصُّورِ", "translit": "ِrwُّṣlٱ", "root": "صور"}, {"id": 5, "arabic": "فَفَزِعَ", "translit": "َʿعِzَfَf", "root": "فزع"}, {"id": 6, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 9, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 12, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 13, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 14, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 15, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "وَكُلٌّ", "translit": "ٌّlُkَw", "root": "كلل"}, {"id": 17, "arabic": "أَتَوْهُ", "translit": "ُhْwَtَaʾ", "root": "اتي"}, {"id": 18, "arabic": "دَٰخِرِينَ", "translit": "َnyِrِhkَٰd", "root": "دخر"}], "hasIhya": true}, {"ayah": 88, "text": "وَتَرَى ٱلْجِبَالَ تَحْسَبُهَا جَامِدَةً وَهِىَ تَمُرُّ مَرَّ ٱلسَّحَابِۚ صُنْعَ ٱللَّهِ ٱلَّذِىٓ أَتْقَنَ كُلَّ شَىْءٍۚ إِنَّهُۥ خَبِيرٌۢ بِمَا تَفْعَلُونَ ", "translation": "And you see the mountains, thinking them motionless,[1] while they will pass as the passing of clouds. [It is] the work of Allāh, who perfected all things. Indeed, He is Aware of that which you do.", "words": [{"id": 1, "arabic": "وَتَرَى", "translit": "àَrَtَw", "root": "راي"}, {"id": 2, "arabic": "ٱلْجِبَالَ", "translit": "َlāَbِjgْlٱ", "root": "جبل"}, {"id": 3, "arabic": "تَحْسَبُهَا", "translit": "āَhُbَsْḥَt", "root": "حسب"}, {"id": 4, "arabic": "جَامِدَةً", "translit": "ًẗَdِmāَjg", "root": "جمد"}, {"id": 5, "arabic": "وَهِىَ", "translit": "َàِhَw", "root": ""}, {"id": 6, "arabic": "تَمُرُّ", "translit": "ُّrُmَt", "root": "مرر"}, {"id": 7, "arabic": "مَرَّ", "translit": "َّrَm", "root": "مرر"}, {"id": 8, "arabic": "ٱلسَّحَابِ", "translit": "ِbāَḥَّslٱ", "root": "سحب"}, {"id": 9, "arabic": "صُنْعَ", "translit": "َʿعْnُṣ", "root": "صنع"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 12, "arabic": "أَتْقَنَ", "translit": "َnَqْtَaʾ", "root": "تقن"}, {"id": 13, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 14, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 15, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 16, "arabic": "خَبِيرٌۢ", "translit": "ٌۢryِbَhk", "root": "خبر"}, {"id": 17, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 18, "arabic": "تَفْعَلُونَ", "translit": "َnwُlَʿعْfَt", "root": "فعل"}], "hasIhya": true}, {"ayah": 89, "text": "مَن جَآءَ بِٱلْحَسَنَةِ فَلَهُۥ خَيْرٌ مِّنْهَا وَهُم مِّن فَزَعٍ يَوْمَئِذٍ ءَامِنُونَ ", "translation": "Whoever comes [at Judgement] with a good deed will have better than it, and they, from the terror of that Day, will be safe.", "words": [{"id": 1, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "بِٱلْحَسَنَةِ", "translit": "ِẗَnَsَḥْlٱِb", "root": "حسن"}, {"id": 4, "arabic": "فَلَهُۥ", "translit": "ۥُhَlَf", "root": ""}, {"id": 5, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 6, "arabic": "مِّنْهَا", "translit": "āَhْnِّm", "root": ""}, {"id": 7, "arabic": "وَهُم", "translit": "mُhَw", "root": ""}, {"id": 8, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 9, "arabic": "فَزَعٍ", "translit": "ٍʿعَzَf", "root": "فزع"}, {"id": 10, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 11, "arabic": "ءَامِنُونَ", "translit": "َnwُnِmāَء", "root": "امن"}], "hasIhya": true}, {"ayah": 90, "text": "وَمَن جَآءَ بِٱلسَّيِّئَةِ فَكُبَّتْ وُجُوهُهُمْ فِى ٱلنَّارِ هَلْ تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ ", "translation": "And whoever comes with an evil deed[1] - their faces will be overturned into the Fire, [and it will be said], \"Are you recompensed except for what you used to do?\"", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "بِٱلسَّيِّئَةِ", "translit": "ِẗَyʾِّyَّslٱِb", "root": "سوا"}, {"id": 4, "arabic": "فَكُبَّتْ", "translit": "ْtَّbُkَf", "root": "كبب"}, {"id": 5, "arabic": "وُجُوهُهُمْ", "translit": "ْmُhُhwُjgُw", "root": "وجه"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 8, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 9, "arabic": "تُجْزَوْنَ", "translit": "َnْwَzْjgُt", "root": "جزي"}, {"id": 10, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 13, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": true}, {"ayah": 91, "text": "إِنَّمَآ أُمِرْتُ أَنْ أَعْبُدَ رَبَّ هَٰذِهِ ٱلْبَلْدَةِ ٱلَّذِى حَرَّمَهَا وَلَهُۥ كُلُّ شَىْءٍۖ وَأُمِرْتُ أَنْ أَكُونَ مِنَ ٱلْمُسْلِمِينَ ", "translation": "[Say, O Muḥammad], \"I have only been commanded to worship the Lord of this city,[1] who made it sacred and to whom [belongs] all things. And I am commanded to be of the Muslims [i.e., those who submit to Allāh]", "words": [{"id": 1, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "أُمِرْتُ", "translit": "ُtْrِmُaʾ", "root": "امر"}, {"id": 3, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 4, "arabic": "أَعْبُدَ", "translit": "َdُbْʿعَaʾ", "root": "عبد"}, {"id": 5, "arabic": "رَبَّ", "translit": "َّbَr", "root": "ربب"}, {"id": 6, "arabic": "هَٰذِهِ", "translit": "ِhِhdَٰh", "root": ""}, {"id": 7, "arabic": "ٱلْبَلْدَةِ", "translit": "ِẗَdْlَbْlٱ", "root": "بلد"}, {"id": 8, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "حَرَّمَهَا", "translit": "āَhَmَّrَḥ", "root": "حرم"}, {"id": 10, "arabic": "وَلَهُۥ", "translit": "ۥُhَlَw", "root": ""}, {"id": 11, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 12, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 13, "arabic": "وَأُمِرْتُ", "translit": "ُtْrِmُaʾَw", "root": "امر"}, {"id": 14, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 15, "arabic": "أَكُونَ", "translit": "َnwُkَaʾ", "root": "كون"}, {"id": 16, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 17, "arabic": "ٱلْمُسْلِمِينَ", "translit": "َnyِmِlْsُmْlٱ", "root": "سلم"}], "hasIhya": false}, {"ayah": 92, "text": "وَأَنْ أَتْلُوَا۟ ٱلْقُرْءَانَۖ فَمَنِ ٱهْتَدَىٰ فَإِنَّمَا يَهْتَدِى لِنَفْسِهِۦۖ وَمَن ضَلَّ فَقُلْ إِنَّمَآ أَنَا۠ مِنَ ٱلْمُنذِرِينَ ", "translation": "And to recite the Qur’ān.\" And whoever is guided is only guided for [the benefit of] himself; and whoever strays - say, \"I am only [one] of the warners.\"", "words": [{"id": 1, "arabic": "وَأَنْ", "translit": "ْnَaʾَw", "root": ""}, {"id": 2, "arabic": "أَتْلُوَا۟", "translit": "۟āَwُlْtَaʾ", "root": "تلو"}, {"id": 3, "arabic": "ٱلْقُرْءَانَ", "translit": "َnāَءْrُqْlٱ", "root": "قرا"}, {"id": 4, "arabic": "فَمَنِ", "translit": "ِnَmَf", "root": ""}, {"id": 5, "arabic": "ٱهْتَدَىٰ", "translit": "ٰàَdَtْhٱ", "root": "هدي"}, {"id": 6, "arabic": "فَإِنَّمَا", "translit": "āَmَّnِiʾَf", "root": ""}, {"id": 7, "arabic": "يَهْتَدِى", "translit": "àِdَtْhَy", "root": "هدي"}, {"id": 8, "arabic": "لِنَفْسِهِۦ", "translit": "ۦِhِsْfَnِl", "root": "نفس"}, {"id": 9, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 10, "arabic": "ضَلَّ", "translit": "َّlَḍ", "root": "ضلل"}, {"id": 11, "arabic": "فَقُلْ", "translit": "ْlُqَf", "root": "قول"}, {"id": 12, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 13, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 14, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 15, "arabic": "ٱلْمُنذِرِينَ", "translit": "َnyِrِhdnُmْlٱ", "root": "نذر"}], "hasIhya": false}, {"ayah": 93, "text": "وَقُلِ ٱلْحَمْدُ لِلَّهِ سَيُرِيكُمْ ءَايَٰتِهِۦ فَتَعْرِفُونَهَاۚ وَمَا رَبُّكَ بِغَٰفِلٍ عَمَّا تَعْمَلُونَ ", "translation": "And say, \"[All] praise is [due] to Allāh. He will show you His signs, and you will recognize them. And your Lord is not unaware of what you do.\"", "words": [{"id": 1, "arabic": "وَقُلِ", "translit": "ِlُqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلْحَمْدُ", "translit": "ُdْmَḥْlٱ", "root": "حمد"}, {"id": 3, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 4, "arabic": "سَيُرِيكُمْ", "translit": "ْmُkyِrُyَs", "root": "راي"}, {"id": 5, "arabic": "ءَايَٰتِهِۦ", "translit": "ۦِhِtَٰyāَء", "root": "ايي"}, {"id": 6, "arabic": "فَتَعْرِفُونَهَا", "translit": "āَhَnwُfِrْʿعَtَf", "root": "عرف"}, {"id": 7, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 8, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 9, "arabic": "بِغَٰفِلٍ", "translit": "ٍlِfَٰغِb", "root": "غفل"}, {"id": 10, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 11, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}], "tafsir": {"14": [{"arabic": "ثم كان منهم من منعه الكبر عن الفكر والمعرفة فجهل كونه ﭬ محقاً، ومنهم من عرف ومنعه الكبر عن الاعتراف قال الله تعالى مخبراً عنهم \"فلما جاءهم ما عرفوا كفروا به\" وقال \"وجحدوا بها واستيقنتها أنفسهم ظلماً وعلوا\" وهذا الكبر قريب من التكبر على الله عز وجل وإن كان دونه، ولكنه تكبر على قبول أمر الله والتواضع لرسوله.", "english": "Then among them were those whom arrogance prevented from reflection and knowledge, so they were ignorant of his (peace be upon him) being truthful; and among them were those who knew but arrogance prevented them from acknowledgment. Allah the Exalted said, informing about them: \"And when came to them that which they recognized, they disbelieved in it\" and said: \"And they denied them while their souls (Anfus) were convinced of them, out of wrongdoing and arrogance.\" And this arrogance is close to arrogance against Allah the Mighty and Majestic, even if it is less than it, but it is arrogance against accepting the command of Allah and humbling oneself to His Messenger.", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}], "25": [{"arabic": "ومن لا يطلع على أسرار باطنه وخبائث صفاته لا يقدر على تطهير القلب منها وإنما السفر هو الذي يسفر عن أخلاق الرجال وبه يخرج الله الخبء في السماوات والأرض وإنما سمى السفر سفرا لأنه يسفر عن الأخلاق ولذلك قال عمر رضي الله عنه للذي زكى عنده بعض الشهود هل صحبته في السفر الذي يستدل به على مكارم أخلاقه فقال لا فقال ما أراك تعرفه وكان بشر يقول يا معشر القراء سيحوا تطيبوا فإن الماء إذا ساح طاب وإذا طال مقامه في موضع تغير وبالجملة فإن النفس في الوطن مع مواتاة الأسباب لا تظهر خبائث أخلاقها لاستئناسها بما يوافق", "english": "And whoever does not become aware of the secrets of his inner self (Batin) and the hidden evils (Khuba'ith) of his traits cannot purify the Heart (Qalb) from them. Indeed, travel is what reveals the character of men, and through it Allah brings forth the hidden (Al-Khab') in the heavens and the earth. Travel is only called travel (Safar) because it reveals (Yusfiru) character. Therefore, Umar (may Allah be pleased with him) said to the one who praised some witnesses before him: 'Have you accompanied him on the journey by which one discerns the noble traits of his character?' He said: 'No.' He said: 'I do not think you know him.' And Bishr used to say: 'O community of reciters, travel so that you may become pure, for when water flows (Saha), it becomes pure, and if it remains long in one place, it changes.' In summary, the Soul (Nafs) in the homeland, with the facilitation of means, does not manifest the hidden evils (Khuba'ith) of its character due to its familiarity with what agrees with its nature from accustomed habits. When it bears the hardship of travel and is diverted from its accustomed habits, and is tested by the difficulties of being a stranger, its hidden dangers are uncovered, and the recognition of its faults occurs, so one can then engage in treating them.", "book_file": "vol2_j2-k07.doc.txt", "book_title": "Etiquette of Travel", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Etiquette of Travel'", "badge": "Ethics"}], "40": [{"arabic": "وقال تعالى: ﴿قل كفى بالله شهيدا بيني وبينكم ومن عنده علم الكتاب﴾ وقال تعالى: ﴿قال الذي عنده علم من الكتاب أنا آتيك به﴾ تنبيها على أنه اقتدر بقوة العلم.", "english": "And He, the Exalted, said: 'Say: Sufficient is Allah as a witness between me and you, and whoever has knowledge of the Book (ʿilm al-Kitāb)' (Quran 13:43). And He, the Exalted, said: 'Said the one who had knowledge from the Book (ʿilm min al-Kitāb): I will bring it to you' (Quran 27:40) – alerting that he was empowered by the strength of knowledge (ʿilm).", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Book of Knowledge'", "badge": "Afterlife"}], "50": [{"arabic": "وقد حذر الله تعالى من مكره واستدراجه فقال \"فلا يأمن مكر الله إلا القوم الخاسرون\" وقال تعالى \"ومكروا مكراً ومكرنا مكراً وهم لا يشعرون\" وقال عز وجل \"ومكروا ومكر الله والله خير الماكرين\" وقال تعالى \"إنهم يكيدون كيداً وأكيد كيداً فمهل الكافرين أمهلهم رويداً\" فكما لا يجوز للعبد المهمل أن يستدل بإهمال السيد إياه وتمكينه من النعم على حب السيد، بل ينبغي أن يحذر أن يكون ذلك مكراً منه وكيداً مع أن السيد لم يحذره مكر نفسه، فبأن يجب ذلك في حق الله تعالى مع تحذيره استدراجه أولى، فإذن من أمن مكر الله فهو مغتر", "english": "And Allah the Exalted has warned of His plotting (makr) and gradual entrapment (istidrāj), saying: 'So none feels secure from the plotting (makr) of Allah except the losing people.' And He said: 'And they plotted a plot, and We plotted a plot, while they were not aware.' And the Mighty and Majestic said: 'And they plotted, and Allah plotted, and Allah is the best of plotters.' And He said: 'Indeed, they plan a plan, and I plan a plan. So give the disbelievers respite; give them respite a little.' So just as it is not permissible for the negligent servant to infer from the master's neglect of him and enabling him with blessings that the master loves him, rather he should be cautious that this might be plotting (makr) and scheming from him, even though the master did not warn him of his own plotting (makr), then how much more must this be in the case of Allah the Exalted with His warning of His gradual entrapment (istidrāj) is more deserving. Therefore, whoever feels secure from the plotting (makr) of Allah is deluded (maghṭūr), and the origin of this delusion (ghurūr) is that he inferred from worldly blessings that he is honorable with that Bestower, and it is possible that this is evidence of degradation, but that possibility does not agree with the lower self's desire (hawā), so Satan, by means of the lower self's desire (hawā), inclines the heart (qalb) toward what accompanies it, which is believing in its indication of honor, and this is the limit of delusion (ghurūr).", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Delusion'", "badge": "Insight"}], "59": [{"arabic": "وهذه أمور ممكنة في أنفسها فمن لم يحظ بشيء منها، فلا ينبغي أن يخلو عن التصديق والإيمان بإمكانها، فإن القدرة واسعة والفضل عميم وعجائب الملك والملكوت كثيرة، ومقدورات الله تعالى لا نهاية لها وفضله على عباده الذين اصطفى لا غاية له. ولذلك كان أبو يزيد يقول: إن أعطاك مناجاة موسى وروحانية عيسى وخلة إبراهيم فاطلب ما وراء ذلك، فإن عنده فوق ذلك أضعافاً مضاعفة، فإن سكت إلى ذلك حجبك به، وهذا بلاء مثلهم ومن هو في مثل حالهم لأنهم الأمثل فالأمثل.", "english": "And these matters are possible in themselves, so whoever does not attain any of them should not be devoid of belief and faith in their possibility, for the Power (Qudrah) is vast and the Favor (Fadl) is abundant, and the wonders of the Dominion (Malak) and the Kingdom (Malakut) are many, and the things decreed by Allah the Exalted have no end, and His Favor upon His servants whom He has chosen has no limit. And for that reason, Abu Yazid used to say: If He gives you the intimate conversation (Munajat) of Moses and the spirituality (Ruhaniyyah) of Jesus and the friendship (Khullah) of Abraham, then seek what is beyond that, for with Him is above that multiples upon multiples, for if you remain silent to that, He will veil you with it, and this is a trial for those like them and for whoever is in a state like theirs because they are the best of the best.", "book_file": "vol4_Vol4-book6.doc.txt", "book_title": "Love, Longing, Intimacy and Contentment", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}, {"arabic": "فإذا قرب من البيت قال الحمد لله وسلام على عباده الذين اصطفى اللهم صل على محمد عبدك ورسولك وعلى إبراهيم خليلك وعلى جميع أنبيائك ورسلك وليرفع يديه وليقل اللهم إني أسألك في مقامي هذا في أول مناسكي أن تتقبل توبتي وأن تتجاوز عن خطيئتي وتضع عني وزري الحمد لله الذي بلغني بيته الحرام الذي جعله مثابة للناس وأمنا وجعله مباركا وهدى للعالمين اللهم إني عبدك والبلد بلدك والحرم حرمك والبيت بيتك جئتك أطلب رحمتك وأسألك مسألة المضطر الخائف من عقوبتك الراجي لرحمتك الطالب مرضاتك.", "english": "When he approaches the House (Kaaba), he should say: 'All praise is for Allah and peace upon His servants whom He has chosen. O Allah, send blessings upon Muhammad, Your servant and messenger, and upon Abraham, Your intimate friend, and upon all Your prophets and messengers.' And he should raise his hands and say: 'O Allah, I ask You in this station of mine at the beginning of my rites that You accept my repentance, that You overlook my sin, and that You remove my burden from me. All praise is for Allah who has brought me to His Sacred House which He made a place of return for people and a sanctuary, and made it blessed and guidance for the worlds. O Allah, I am Your servant and the land is Your land and the sanctuary is Your sanctuary and the House is Your House. I have come to You seeking Your mercy and I ask You the request of the distressed one, fearful of Your punishment, hopeful for Your mercy, seeking Your pleasure.'", "book_file": "vol1_Vol1-book-7.doc.txt", "book_title": "Mysteries of Hajj", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Mysteries of Hajj'", "badge": "Du'a"}], "71": [{"arabic": "واختلاف تركيب أعضائه أعاجيب تزيد على الأعاجيب فى بعثه وإعادته فكيف ينكر ذلك من قدرة الله تعالى وحكمته من يشاهد ذلك فى صنعته وقدرته فإن كان فى إيمانك ضعف فقو الإيمان بالنظر فى النشأة الأولى فإن الثانية مثلها وأسهل منها وإن كنت قوى الإيمان بها فأشعر قلبك تلك المخاوف والأخطار وأكثر فيها التفكر والاعتبار لتسلب عن قلبك الراحة والقرار فتشتغل بالتشمر للعرض على الجبار وتفكر أولا فيما يقرع سمع سكان القبور من شدة نفخ الصور فإنها صيحة واحدة تنفرج بها القبور عن رءوس الموتي فيثورون دفعة واحدة فتوهم نفسك وقد ", "english": "And the differing composition of its limbs are wonders that increase over wonders in its resurrection and restoration, so how can one deny that from the power (Qudrah) of Allah the Exalted and His wisdom who witnesses that in His creation and power? If there is weakness in your faith (Iman), then strengthen the faith (Iman) by looking at the first creation, for the second is like it and easier than it. And if you are strong in faith (Iman) in it, then make your heart (Qalb) feel those fears and dangers and increase in it reflection (Tafakkur) and consideration (I'tibar) to strip from your heart (Qalb) comfort and settlement, so you busy yourself with preparing for the presentation before the Almighty (Al-Jabbar). And reflect first on what strikes the hearing of the inhabitants of the graves from the intensity of the blowing of the Trumpet (As-Sur), for it is a single cry by which the graves split open from the heads of the dead, and they rise up all at once. So imagine yourself having leaped up with your face changed, your body dusty from your scalp to your feet from the dust of your grave, stunned from the intensity of the blow, your eye fixed toward the call. And the creation has risen up in a single uprising from the graves in which their tribulation (Bala') has been prolonged, and alarm and terror have agitated them, added to what they had of sorrows (Humum) and griefs (Ghumum) and intense waiting for the outcome of the matter, as Allah the Exalted said: 'And the Trumpet (As-Sur) will be blown, and all who are in the heavens and all who are on the earth will fall dead except whom Allah wills. Then it will be blown again, and at once they will be standing, looking on.' And Allah the Exalted said: 'And when the Trumpet (An-Naqur) is blown, that Day will be a difficult day for the disbelievers; not easy.' And Allah the Exalted said: 'And they say, \"When is this promise, if you should be truthful?\" They do not await except one blast which will seize them while they are disputing. And they will not be able [to give] any instruction, nor to their people can they return. And the Trumpet (As-Sur) will be blown; and at once from the graves to their Lord they will hasten. They will say, \"O woe to us! Who has raised us up from our sleeping place?\" [The reply will be], \"This is what the Most Merciful had promised, and the messengers told the truth.\"' So if there were not before the dead except the terror of that blowing, it would be worthy of being feared, for it is a blowing and a cry by which those in the heavens and the earth are struck dead, meaning they die by it except whom Allah wills, and that is some of the angels. And therefore the Messenger of Allah (peace be upon him) said: 'How can I be at ease when the possessor of the Trumpet (As-Sur) has taken the horn in his mouth, lowered his forehead, and inclined his ear, waiting for when he will be commanded to blow?' Maqatil said: The Trumpet (As-Sur) is the horn, and that Israfil (upon him be peace) is placing his mouth on the horn like the form of a trumpet, and the circle of the head of the horn is like the width of the heavens and the earth, and he is fixing his gaze toward the Throne (Al-'Arsh), waiting for when he will be commanded to blow the first blowing. And when he blows, those in the heavens and the earth are struck dead, meaning every animal dies from the intensity of the alarm except whom Allah wills, and that is Jibril, Mika'il, Israfil, and the Angel of Death (Malak al-Mawt). Then the Angel of Death (Malak al-Mawt) is commanded to take the soul (Ruh) of Jibril, then the soul (Ruh) of Mika'il, then the soul (Ruh) of Israfil, then the Angel of Death (Malak al-Mawt) is commanded and he dies. Then the creation remains after the first blowing in the Barzakh for forty years, then Allah the Exalted revives Israfil and commands.", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Repentance'", "badge": "Insight"}], "87": [{"arabic": "قيام ليلة إلى الصبح، وقال أيضاً: الجوع عند الله في خزائنه لا يعطيه إلا من أحبه. وكان سهل بن عبد الله التستري يطوي نيفاً وعشرين يوماً لا يأكل، وكان يكفيه لطعامه في السنة درهم، وكان يعظم الجوع ويبالغ فيه حتى قال: لا يوافى القيامة عمل بر أفضل من ترك فضول الطعام اقتداء بالنبي ﭬ في أكله. وقال: لم ير الأكياس شيئاً أنفع من الجوع للدين والدنيا. وقال: لا أعلم شيئاً أضر على طلاب الآخرة من الأكل. وقال: وضعت الحكمة والعلم في الجوع ووضعت المعصية والجهل في الشبع. وقال ما عبد الله بشيء أفضل من مخالفة الهوى في ", "english": "Standing [in prayer] from night until dawn, and he also said: Hunger is with Allah in His treasuries, and He does not give it except to whom He loves. And Sahl ibn Abdullah al-Tustari would go over twenty-some days without eating, and a dirham sufficed him for his food in the year, and he would magnify hunger and exaggerate in it until he said: No righteous deed will meet the Resurrection better than abandoning excess food in emulation of the Prophet (peace be upon him) in his eating. And he said: The wise have not seen anything more beneficial than hunger for religion and the worldly life. And he said: I do not know anything more harmful to seekers of the Hereafter than eating. And he said: Wisdom and knowledge were placed in hunger, and disobedience and ignorance were placed in satiety. And he said: Allah has not been worshipped with anything better than opposing the desire (Hawa) in abandoning the lawful. And it has come in the hadith: \"One-third for food, so whoever increases upon that, then he eats from his good deeds.\" And he was asked about the increase, so he said: He does not find the increase until abandonment becomes more beloved to him than eating, and when he is hungry for a night, he asks Allah to make it two nights, so when that is, he finds the increase. And he said: The Substitutes (Abdal) became substitutes only by emptying the bellies, staying awake, silence, and seclusion. And he said: The head of every righteousness that descended from the sky to the earth is hunger, and the head of every wickedness between them is satiety. And he said: Whoever hungers his soul (Nafs), the whisperings are cut off from him. And he said: The turning of Allah, the Mighty and Majestic, to the servant is with hunger, sickness, and affliction except whom Allah wills. And he said: Know that this is a time in which no one attains salvation except by slaughtering his soul (Nafs) and killing it with hunger, staying awake, and exertion. And he said: No one has passed on the face of the earth who drank from this water until he was quenched and was safe from disobedience - even if he thanks Allah, the Exalted - so how about satiety from food? And a wise man was asked: With what restraint do I restrain my soul (Nafs)? He said: Restrain it with hunger and thirst, humble it by lowering remembrance (Dhikr) and abandoning honor, make it small by placing it under the feet of the sons of the Hereafter, break it by abandoning the appearance of the reciters from its outward, and escape from its defects by constant bad suspicion of it, and accompany it by opposing its desire (Hawa). And Abdul Wahid ibn Zaid would swear by Allah, the Exalted, that Allah, the Exalted, has not purified anyone except with hunger, nor have they walked on water except with it, nor was the earth folded for them except with hunger, nor has Allah, the Exalted, taken charge of them except with hunger. And Abu Talib al-Makki said: The belly is like the lute, which is the hollow wood with strings - indeed its sound is beautiful due to its lightness and thinness because it is hollow and not full, and likewise the interior if it is empty is sweeter for recitation, more enduring for standing [in prayer], and less for sleep. And Abu Bakr ibn Abdullah al-Muzani said: Three whom Allah, the Exalted, loves; a man of little sleep, little eating, little rest. And it is narrated that Jesus (peace be upon him) remained conversing intimately with his Lord for sixty mornings without eating, then bread occurred to his mind, so he was cut off from the intimate conversation, so...", "book_file": "vol3_Vol3-book3a.doc.txt", "book_title": "Harms of the Tongue", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Harms of the Tongue'", "badge": "Ethics"}, {"arabic": "فلو لم يكن بين يدي الموتي إلا هول تلك النفخة لكان ذلك جديرا بأن يتقى فإنها نفخة وصيحة يصعق بها من فى السموات والأرض يعنى يموتون بها إلا من شاء الله وهو بعض الملائكة ولذلك قال رسول الله ﭬ: (كيف أنعم وصاحب الصور قد التقم القرن وحنى الجبهة وأصغى بالأذن متى يؤمر فينفخ[144]) قال مقاتل: الصور هو القرن وذلك أن إسرافيل عليه السلام واضع فاه على القرن كهيئة البوق ودائرة رأس القرن كعرض السموات والأرض وهو شاخص بصره نحو العرش ينتظر متى يؤمر فينفخ النفخة الأولى فإذا نفخ صعق من فى السموات والأرض أى مات كل حيوا", "english": "If there were nothing before the dead except the terror of that blowing (of the Horn), it would be worthy of being feared, for it is a blowing and a shout by which those in the heavens and the earth are struck unconscious (صعق) - meaning they die by it - except whom Allah wills, and that is some of the angels. Therefore, the Messenger of Allah (peace be upon him) said: 'How can one enjoy comfort when the possessor of the Horn (الصور) has taken the horn into his mouth, bent his forehead, and listened with his ear, waiting for when he will be commanded to blow?' [144] Muqatil said: The Horn (الصور) is the trumpet, and that is because Israfil (upon him be peace) has placed his mouth on the horn like a trumpet, and the circumference of the horn's head is like the expanse of the heavens and the earth, and he is gazing with his sight toward the Throne, waiting for when he will be commanded to blow the first blowing. When he blows, those in the heavens and the earth are struck unconscious (صعق) - meaning every living creature dies from the intensity of the terror (الفزع) - except whom Allah wills, and that is Jibril, Mika'il, Israfil, and the Angel of Death. Then the Angel of Death is commanded to take the soul (روح) of Jibril, then the soul of Mika'il, then the soul of Israfil, then the Angel of Death is commanded and he dies. Then the creation remains after the first blowing in the Barzakh (البرزخ) for forty years. Then Allah the Exalted revives Israfil and commands him to blow the second blowing, and that is His saying: 'Then it will be blown into it another time, and behold, they are standing, looking.' [Quran 39:68] - on their feet, looking at the Resurrection. And the Messenger of Allah (peace be upon him) said: 'When I was sent, I was sent to the possessor of the Horn, and he inclined it to his mouth, and advanced one foot and delayed another, waiting for when he will be commanded to blow. So fear the blowing!' [145] So reflect upon the creatures and their humiliation (ذل), their brokenness (انكسار), and their submission (استكانة) at the time of being raised, out of fear of this striking unconscious (الصعقة) and in anticipation of what will be decreed for them of happiness (سعادة) or misery (شقاوة). And you are among them, broken like their brokenness, perplexed like their perplexity. Rather, if you were in the world among the luxurious and the rich who enjoy comfort, then the kings of the earth on that day are the most humiliated people of the gathering place, the smallest and most contemptible of them, being trodden under feet like a grain. And at that time, the wild beasts from the deserts and the mountains come with lowered heads, mixed with the creatures after their wildness, humiliated for the Day of Resurrection, without any sin by which they have been defiled, but their gathering is due to the intensity of the striking unconscious (الصعقة) and the terror of the blowing, and that preoccupies them from fleeing from the creatures and being wild toward them, and that.", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Book of Repentance'", "badge": "Afterlife"}, {"arabic": "رع سمع سكان القبور من شدة نفخ الصور فإنها صيحة واحدة تنفرج بها القبور عن رءوس الموتي فيثورون دفعة واحدة فتوهم نفسك وقد وثبت متغيرا وجهك مغبرا بدنك من فرقك إلى قدمك من تراب قبرك مبهوتا من شدة الصعقة شاخص العين نحو النداء وقد ثار الخلق ثورة واحدة من القبور التى طال فيها بلاؤهم وقد أزعجهم الفزع والرعب مضافا إلى ما كان عندهم من الهموم والغموم وشدة الانتظار لعاقبة الأمر كما قال تعالى: ﴿ ونفخ فى الصور فصعق من فى السموات ومن فى الأرض إلا من شاء الله ثم نفخ فيه أخرى فإذا هم قيام ينظرون ﴾ {} وقال تعالى: ", "english": "Listen, the inhabitants of the graves hear from the intensity of the blowing of the Trumpet (As-Sur), for it is a single cry by which the graves split open from the heads of the dead, and they rise up all at once. So imagine yourself having leaped up, your face altered, your body dusty from your head to your feet from the dust of your grave, stunned from the intensity of the blow, your eyes fixed toward the call. And the creation has risen up in a single uprising from the graves in which their tribulation has been prolonged, and the terror and dread have agitated them, added to what they had of sorrows, griefs, and intense waiting for the outcome of the matter, as Allah the Exalted said: 'And the Trumpet (As-Sur) will be blown, and all who are in the heavens and all who are on the earth will fall dead except whom Allah wills. Then it will be blown again, and at once they will be standing, looking on.' And Allah the Exalted said: 'And when the Trumpet (An-Naqur) is sounded, that Day will be a difficult day for the disbelievers; not easy.' And Allah the Exalted said: 'And they say, \"When is this promise, if you should be truthful?\" They do not await except one blast which will seize them while they are disputing. And they will not be able to make a testament, nor to their people will they return. And the Trumpet (As-Sur) will be blown; and at once from the graves to their Lord they will hasten. They will say, \"O woe to us! Who has raised us from our sleeping place? This is what the Most Merciful had promised, and the messengers told the truth.\"' So if there were nothing before the dead except the terror of that blowing, it would be worthy of being feared, for it is a blowing and a cry by which those in the heavens and the earth are struck dead, meaning they die by it, except whom Allah wills, and that is some of the angels. And for that reason, the Messenger of Allah (peace be upon him) said: 'How can I be at ease when the possessor of the Trumpet (As-Sur) has taken the horn in his mouth, bowed his forehead, and inclined his ear, waiting for when he is commanded to blow?' Maqatil said: The Trumpet (As-Sur) is the horn, and that is because Israfil (upon him be peace) places his mouth on the horn like the shape of a trumpet, and the circle of the head of the horn is like the expanse of the heavens and the earth, and he is fixing his gaze toward the Throne, waiting for when he is commanded to blow the first blowing. And when he blows, those in the heavens and the earth are struck dead, meaning every living creature dies from the intensity of the terror, except whom Allah wills, and that is Jibril, Mika'il, Israfil, and the Angel of Death (Malak al-Mawt). Then the Angel of Death is commanded to take the soul (Ruh) of Jibril, then the soul (Ruh) of Mika'il, then the soul (Ruh) of Israfil, then the Angel of Death is commanded and he dies. Then the creation remains after the first blowing in the Intermediate State (Al-Barzakh) for forty years. Then Allah the Exalted revives Israfil and commands him to blow the second blowing, and that is His saying the Exalted: 'Then it will be blown again, and at once they will be standing, looking on.' On their feet, looking at the Resurrection (Al-Ba'th). And the Messenger of Allah (peace be upon him) said: 'When I was sent, I was sent to the possessor of the Trumpet (As-Sur), and he inclined it to his mouth, advanced one foot and delayed another, waiting for when he is commanded to blow. So fear the blowing.' So reflect on the creation and their humiliation, their brokenness, and their submission at the resurrection, out of fear from this blow and waiting for what is decreed upon them of happiness or wretchedness, and", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Book of Repentance'", "badge": "Afterlife"}], "88": [{"arabic": "يوم ترى الجبال تحسبها جامدة وهى تمر مر السحاب، يوم تنشق فيه السماء فتكون وردة كالدهان، فيومئذ لا يسئل عن ذنبه إنس ولا جان، يوم يمنع فيه العاصى من الكلام ولا يسئل فيه عن الأجرام بل يؤخذ بالنواصى والأقدام، يوم تجد كل نفس ما عملت من خير محضرا وما عملت من سوء تود لو أن بينها وبينه أمدا بعيدا، يوم تعلم فيه كل نفس ما أحضرت وتشهد ما قدمت وأخرت يوم تخرس فيه الألسن وتنطق الجوارح يوم شيب ذكره سيد المرسلين إذ قال له الصديق رضى الله عنه: أراك قد شبت يا رسول الله قال: (شيبتنى هود وأخواتها[155]) وهى الواقعة و", "english": "The day you see the mountains, you think them firm while they pass like the passing of clouds, the day the sky splits therein and becomes like red leather, then on that day no human or jinn will be asked about his sin, the day the disobedient is prevented from speech and therein is not asked about the crimes but is taken by the forelocks and the feet, the day every soul finds what it did of good present and what it did of evil wishes that between it and it were a distant span, the day every soul therein knows what it has brought and witnesses what it has sent ahead and left behind, the day the tongues are silenced therein and the limbs speak, the day its mention turned gray the master of the messengers when the truthful one (may Allah be pleased with him) said to him: I see you have turned gray, O Messenger of Allah. He said: (Hud and its sisters turned me gray [155]) and they are Al-Waqi'ah, Al-Mursalat, 'Amma Yatasa'alun, and Idha Ash-Shamsu Kuwwirat. So O incapable reader, your share from your reading is that you mumble the Quran and move with it the tongue, and if you were reflecting on what you read, you would be worthy that your bitterness splits from what turned gray from it the hair of the master of the messengers, and if you are content with the movement of the tongue, you have deprived yourself of the fruit of the Quran. So the Resurrection (Al-Qiyamah) is one of what is mentioned therein, and Allah has described some of its calamities and multiplied its names for us to stand with the multiplicity of its names on the multiplicity of its meanings, so the intended with the multiplicity of the names is not the repetition of the names and titles, but the purpose is alerting the possessors of intellects (Ulul Albab), so under every name from the names of the Resurrection is a secret and in every attribute from its attributes is a meaning, so strive to know their meanings and", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Repentance'", "badge": "Insight"}, {"arabic": "فلا تظنن أن الذي يضطرب بنفسه على الأرض أتم وجدا من الساكن باضطرابه بل رب ساكن أتم وجدا من المضطرب فقد كان الجنيد يتحرك في السماع في بدايته ثم صار لا يتحرك فقيل له في ذلك فقال وترى الجبال تحسبها جامدة وهي تمر مر السحاب صنع الله الذي أتقن كل شيء إشارة إلى أن القلب مضطرب جائل في الملكوت والجوارح متأدبة في الظاهر ساكنة", "english": "So do not think that the one who trembles with his self (Nafs) upon the ground is more complete in spiritual ecstasy (Wajd) than the one who is still with his trembling; rather, perhaps a still one is more complete in spiritual ecstasy (Wajd) than the trembler. Indeed, Al-Junayd used to move during spiritual listening (Sama') in his beginning, then he became not moving. So it was said to him regarding that, and he said: 'And you see the mountains, you think them stationary, while they pass like the passing of the clouds. The making of Allah who perfected everything' (Quran 27:88) - an indication that the heart (Qalb) is disturbed, wandering in the dominion (Malakut), and the limbs are disciplined in the apparent, still.", "book_file": "vol2_j2-k08.doc.txt", "book_title": "Audition and Ecstasy", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Audition and Ecstasy'", "badge": "Insight"}], "89": [{"arabic": "ولقوله تعالى: ﴿ من جاء بالحسنة فله خير منها وهم من فزع يومئذ آمنون ﴾ {} فالإيمان رأس الحسنات ولقوله تعالى: ﴿ والله يحب المحسنين ﴾ {} وقال تعالى: ﴿ إنا لا نضيع أجر من أحسن عملا ﴾ {} ولا حجة لهم في ذلك فإنه حيث ذكر الإيمان في هذه الآيات أريد به الإيمان مع العمل إذ بينا أن الإيمان قد يطلق ويراد به الإسلام وهو الموافقة بالقلب والقول والعمل ودليل هذا التأويل أخبار كثيرة في معاقبة العاصين ومقادير العقاب", "english": "And due to His saying, the Exalted: 'Whoever comes with a good deed (al-hasanah) will have better than it, and they will be secure from terror on that day' (27:89). So faith (al-iman) is the head of the good deeds (al-hasanat). And due to His saying, the Exalted: 'And Allah loves the doers of good (al-muhsinin)' (3:134). And He said, the Exalted: 'Indeed, We do not waste the reward of one who does good (ahsana) in deed' (18:30). And they have no proof in that, for when faith (al-iman) is mentioned in these verses, it is intended to be faith (al-iman) with action (al-'amal), since we have clarified that faith (al-iman) may be uttered and intended to be Islam, which is conformity with the heart (al-qalb), the speech (al-qawl), and the action (al-'amal). And the evidence for this interpretation is many reports regarding the punishment of the disobedient and the measures of punishment.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Foundations of Belief'", "badge": "Insight"}], "90": [{"arabic": "وقوله تعالى: ﴿ ومن جاء بالسيئة فكبت وجوههم في النار ﴾ {} فهذه العمومات في معارضة عموماتهم ولا بد من تسليط التخصص والتأويل على الجانبين لأن الأخبار مصرحة بأن العصاة يعذبون[52] بل قوله تعالى: ﴿ وإن منكم إلا واردها ﴾ {} كالصريح في أن ذلك لا بد منه للكل إذ لا يخلو مؤمن عن ذنب يرتكبه", "english": "And His saying, the Exalted: 'And whoever comes with the evil deed, then their faces will be turned down in the Fire' (Quran 27:90). So these general statements are in opposition to their general statements, and it is necessary to apply specification (takhṣīṣ) and interpretation (taʾwīl) to both sides because the reports explicitly state that the disobedient ones (ʿuṣāh) are punished. Rather, His saying, the Exalted: 'And there is not one of you except that he will enter it' (Quran 19:71) is like the explicit in that this is inevitable for all, since no believer is free from a sin that he commits.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Foundations of Belief'", "badge": "Afterlife"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 1938], [2, 1938, 2967], [3, 2967, 4956], [4, 4956, 7322], [5, 7322, 9413], [6, 9413, 11452]], "2": [[1, 350, 1158], [2, 1158, 2846], [3, 2846, 4939]], "3": [[1, 400, 1614], [2, 1614, 3269], [3, 3269, 4940], [4, 4940, 6616], [5, 6616, 8174], [6, 8174, 8905], [7, 8905, 10538], [8, 10538, 10946], [9, 10946, 12602]], "4": [[1, 400, 1307], [2, 1307, 2710], [3, 2710, 3356], [4, 3356, 5169], [5, 5169, 7057], [6, 7057, 8963], [7, 8963, 9683], [8, 9683, 11397], [9, 11397, 12117], [10, 12117, 13882]], "5": [[1, 400, 2255], [2, 2255, 3634], [3, 3634, 4342], [4, 4342, 5757], [5, 5757, 7270], [6, 7270, 8100], [7, 8100, 8710], [8, 8710, 10321], [9, 10321, 10785], [10, 10785, 12784]], "6": [[1, 400, 1887], [2, 1887, 3482], [3, 3482, 5150], [4, 5150, 5633], [5, 5633, 6539], [6, 6539, 7651], [7, 7651, 8788]], "7": [[1, 400, 1217], [2, 1217, 2568], [3, 2568, 4700], [4, 4700, 6989], [5, 6989, 9672], [6, 9672, 11627], [7, 11627, 13475], [8, 13475, 16140], [9, 16140, 18255], [10, 18255, 19712], [11, 19712, 20672], [12, 20672, 23124], [13, 23124, 25150], [14, 25150, 26323], [15, 26323, 28704], [16, 28704, 31227]], "8": [[1, 400, 2144], [2, 2144, 4583], [3, 4583, 6025], [4, 6025, 6659], [5, 6659, 7956], [6, 7956, 8533], [7, 8533, 9254], [8, 9254, 11085], [9, 11085, 12094], [10, 12094, 13853], [11, 13853, 15759], [12, 15759, 16898], [13, 16898, 17691], [14, 17691, 19916]], "9": [[1, 400, 3100], [2, 3100, 4734], [3, 4734, 5770], [4, 5770, 6847], [5, 6847, 8484], [6, 8484, 10094]], "10": [[1, 400, 1847], [2, 1847, 3353], [3, 3353, 5140], [4, 5140, 6883], [5, 6883, 8256], [6, 8256, 10368], [7, 10368, 12616], [8, 12616, 14285], [9, 14285, 16013], [10, 16013, 17047], [11, 17047, 18834], [12, 18834, 21315], [13, 21315, 22083], [14, 22083, 22999], [15, 22999, 24520], [16, 24520, 25288], [17, 25288, 26824], [18, 26824, 28190], [19, 28190, 30522]], "11": [[1, 400, 1974], [2, 1974, 2666], [3, 2666, 3808], [4, 3808, 5036], [5, 5036, 6333], [6, 6333, 7994], [7, 7994, 9101], [8, 9101, 11108], [9, 11108, 13236]