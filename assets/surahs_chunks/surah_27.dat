it": "", "root": ""}, {"id": 7, "arabic": "وَلَٰكِنَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَكْثَرَهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَا", "translit": "", "root": ""}, {"id": 10, "arabic": "يَشْكُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 74, "text": "وَإِنَّ رَبَّكَ لَيَعْلَمُ مَا تُكِنُّ صُدُورُهُمْ وَمَا يُعْلِنُونَۖ", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَيَعْلَمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "تُكِنُّ", "translit": "", "root": ""}, {"id": 6, "arabic": "صُدُورُهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 8, "arabic": "يُعْلِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 75, "text": "وَمَا مِنْ غَآئِبَةࣲ فِے اِ۬لسَّمَآءِ وَالَارْضِ إِلَّا فِے كِتَٰبࣲ مُّبِينٍۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "غَآئِبَةࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَالَارْضِ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "كِتَٰبࣲ", "translit": "", "root": ""}, {"id": 10, "arabic": "مُّبِينٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 76, "text": "اِنَّ هَٰذَا اَ۬لْقُرْءَانَ يَقُصُّ عَلَيٰ بَنِےٓ إِسْرَآءِيلَ أَكْثَرَ اَ۬لذِے هُمْ فِيهِ يَخْتَلِفُونَۖ", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْقُرْءَانَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَقُصُّ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "بَنِےٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِسْرَآءِيلَ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَكْثَرَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 10, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 12, "arabic": "يَخْتَلِفُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 77, "text": "وَإِنَّهُۥ لَهُديࣰ وَرَحْمَةࣱ لِّلْمُومِنِينَۖ", "words": [{"id": 1, "arabic": "وَإِنَّهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُديࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَرَحْمَةࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِّلْمُومِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 78, "text": "إِنَّ رَبَّكَ يَقْضِے بَيْنَهُم بِحُكْمِهِۦۖ وَهُوَ اَ۬لْعَزِيزُ اُ۬لْعَلِيمُۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَقْضِے", "translit": "", "root": ""}, {"id": 4, "arabic": "بَيْنَهُم", "translit": "", "root": ""}, {"id": 5, "arabic": "بِحُكْمِهِۦۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْعَزِيزُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لْعَلِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 79, "text": "فَتَوَكَّلْ عَلَي اَ۬للَّهِۖ إِنَّكَ عَلَي اَ۬لْحَقِّ اِ۬لْمُبِينِۖ", "words": [{"id": 1, "arabic": "فَتَوَكَّلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّكَ", "translit": "", "root": ""}, {"id": 5, "arabic"