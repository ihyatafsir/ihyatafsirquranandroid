], [5, 7350, 9011], [6, 9011, 9873], [7, 9873, 12945], [8, 12945, 13635], [9, 13635, 15014], [10, 15014, 16644], [11, 16644, 18823], [12, 18823, 20516], [13, 20516, 22028], [14, 22028, 23940], [15, 23940, 26142], [16, 26142, 27302], [17, 27302, 28681], [18, 28681, 30493], [19, 30493, 32562], [20, 32562, 35242], [21, 35242, 37154], [22, 37154, 37938], [23, 37938, 39756], [24, 39756, 42747]], "20": [[1, 400, 2068], [2, 2068, 3603], [3, 3603, 4816], [4, 4816, 5473], [5, 5473, 6105], [6, 6105, 7409], [7, 7409, 8344], [8, 8344, 9696], [9, 9696, 10252], [10, 10252, 11162], [11, 11162, 11667], [12, 11667, 14535]], "21": [[1, 400, 3942], [2, 3942, 6322], [3, 6322, 8628], [4, 8628, 9616], [5, 9616, 13932], [6, 13932, 14920], [7, 14920, 18636], [8, 18636, 20898], [9, 20898, 23077]], "22": [[1, 400, 1673], [2, 1673, 2791], [3, 2791, 4250], [4, 4250, 5740], [5, 5740, 7269], [6, 7269, 8387], [7, 8387, 9008], [8, 9008, 10165], [9, 10165, 10755], [10, 10755, 12556], [11, 12556, 13177], [12, 13177, 14202], [13, 14202, 15506], [14, 15506, 17121]], "23": [[1, 400, 2046], [2, 2046, 3804], [3, 3804, 5178], [4, 5178, 7063], [5, 7063, 9524], [6, 9524, 10163], [7, 10163, 11042], [8, 11042, 12160], [9, 12160, 13758], [10, 13758, 14845], [11, 14845, 16442]], "24": [[1, 400, 3065], [2, 3065, 5630], [3, 5630, 7995], [4, 7995, 10061], [5, 10061, 10727], [6, 10727, 11893], [7, 11893, 13209], [8, 13209, 15250], [9, 15250, 16216], [10, 16216, 18875], [11, 18875, 21174], [12, 21174, 23156], [13, 23156, 23889], [14, 23889, 26129], [15, 26129, 27095], [16, 27095, 27961], [17, 27961, 30260]], "25": [[1, 400, 1502], [2, 1502, 3367], [3, 3367, 4251], [4, 4251, 5377], [5, 5377, 6491], [6, 6491, 7569], [7, 7569, 8175], [8, 8175, 10168], [9, 10168, 11694], [10, 11694, 13196], [11, 13196, 13826], [12, 13826, 15183], [13, 15183, 16176], [14, 16176, 17800]], "26": [[1, 400, 1503], [2, 1503, 2943], [3, 2943, 3976], [4, 3976, 5246], [5, 5246, 5916], [6, 5916, 6684], [7, 6684, 7996], [8, 7996, 9754]], "27": [[1