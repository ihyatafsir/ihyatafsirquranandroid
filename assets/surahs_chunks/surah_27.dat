": 1, "arabic": "وَكَانَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لْمَدِينَةِ", "translit": "", "root": ""}, {"id": 4, "arabic": "تِسْعَةُ", "translit": "", "root": ""}, {"id": 5, "arabic": "رَهْطࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "يُفْسِدُونَ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 10, "arabic": "يُصْلِحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 49, "text": "قَالُواْ تَقَاسَمُواْ بِاللَّهِ لَنُبَيِّتَنَّهُۥ وَأَهْلَهُۥ ثُمَّ لَنَقُولَنَّ لِوَلِيِّهِۦ مَا شَهِدْنَا مُهْلَكَ أَهْلِهِۦ وَإِنَّا لَصَٰدِقُونَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَقَاسَمُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِاللَّهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَنُبَيِّتَنَّهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَأَهْلَهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَنَقُولَنَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "لِوَلِيِّهِۦ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَا", "translit": "", "root": ""}, {"id": 10, "arabic": "شَهِدْنَا", "translit": "", "root": ""}, {"id": 11, "arabic": "مُهْلَكَ", "translit": "", "root": ""}, {"id": 12, "arabic": "أَهْلِهِۦ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَإِنَّا", "translit": "", "root": ""}, {"id": 14, "arabic": "لَصَٰدِقُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 50, "text": "وَمَكَرُواْ مَكْراࣰ وَمَكَرْنَا مَكْراࣰ وَهُمْ لَا يَشْعُرُونَۖ", "words": [{"id": 1, "arabic": "وَمَكَرُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَكْراࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَمَ