{"surah": 27, "verses": [{"ayah": 1, "text": "طسٓۚ تِلْكَ ءَايَٰتُ ٱلْقُرْءَانِ وَكِتَابٍ مُّبِينٍ ", "translation": "Ṭā, Seen.[1] These are the verses of the Qur’ān [i.e., recitation] and a clear Book", "words": [{"id": 1, "arabic": "طسٓ", "translit": "ٓsṭ", "root": ""}, {"id": 2, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 3, "arabic": "ءَايَٰتُ", "translit": "ُtَٰyāَء", "root": "ايي"}, {"id": 4, "arabic": "ٱلْقُرْءَانِ", "translit": "ِnāَءْrُqْlٱ", "root": "قرا"}, {"id": 5, "arabic": "وَكِتَابٍ", "translit": "ٍbāَtِkَw", "root": "كتب"}, {"id": 6, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 2, "text": "هُدًى وَبُشْرَىٰ لِلْمُؤْمِنِينَ ", "translation": "As guidance and good tidings for the believers", "words": [{"id": 1, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 2, "arabic": "وَبُشْرَىٰ", "translit": "ٰàَrْhsُbَw", "root": "بشر"}, {"id": 3, "arabic": "لِلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlِl", "root": "امن"}], "hasIhya": false}, {"ayah": 3, "text": "ٱلَّذِينَ يُقِيمُونَ ٱلصَّلَوٰةَ وَيُؤْتُونَ ٱلزَّكَوٰةَ وَهُم بِٱلْءَاخِرَةِ هُمْ يُوقِنُونَ ", "translation": "Who establish prayer and give zakāh, and of the Hereafter they are certain [in faith].", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يُقِيمُونَ", "translit": "َnwُmyِqُy", "root": "قوم"}, {"id": 3, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 4, "arabic": "وَيُؤْتُونَ", "translit": "َnwُtْwʾُyَw", "root": "اتي"}, {"id": 5, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 6, "arabic": "وَهُم", "translit": "mُhَw", "root": ""}, {"id": 7, "arabic": "بِٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱِb", "root": "اخر"}, {"id": 8, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 9, "arabic": "يُوقِنُونَ", "translit": "َnwُnِqwُy", "root": "يقن"}], "hasIhya": false}, {"ayah": 4, "text": "إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْءَاخِرَةِ زَيَّنَّا لَهُمْ أَعْمَٰلَهُمْ فَهُمْ يَعْمَهُونَ ", "translation": "Indeed, for those who do not believe in the Hereafter, We have made pleasing to them their deeds, so they wander blindly.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 5, "arabic": "بِٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱِb", "root": "اخر"}, {"id": 6, "arabic": "زَيَّنَّا", "translit": "āَّnَّyَz", "root": "زين"}, {"id": 7, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 8, "arabic": "أَعْمَٰلَهُمْ", "translit": "ْmُhَlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 9, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 10, "arabic": "يَعْمَهُونَ", "translit": "َnwُhَmْʿعَy", "root": "عمه"}], "hasIhya": false}, {"ayah": 5, "text": "أُو۟لَٰٓئِكَ ٱلَّذِينَ لَهُمْ سُوٓءُ ٱلْعَذَابِ وَهُمْ فِى ٱلْءَاخِرَةِ هُمُ ٱلْأَخْسَرُونَ ", "translation": "Those are the ones for whom there will be the worst of punishment, and in the Hereafter they are the greatest losers.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 4, "arabic": "سُوٓءُ", "translit": "ُءٓwُs", "root": "سوا"}, {"id": 5, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 6, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 9, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 10, "arabic": "ٱلْأَخْسَرُونَ", "translit": "َnwُrَsْhkَaʾْlٱ", "root": "خسر"}], "hasIhya": false}, {"ayah": 6, "text": "وَإِنَّكَ لَتُلَقَّى ٱلْقُرْءَانَ مِن لَّدُنْ حَكِيمٍ عَلِيمٍ ", "translation": "And indeed, [O Muḥammad], you receive the Qur’ān from one Wise and Knowing.", "words": [{"id": 1, "arabic": "وَإِنَّكَ", "translit": "َkَّnِiʾَw", "root": ""}, {"id": 2, "arabic": "لَتُلَقَّى", "translit": "àَّqَlُtَl", "root": "لقي"}, {"id": 3, "arabic": "ٱلْقُرْءَانَ", "translit": "َnāَءْrُqْlٱ", "root": "قرا"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "لَّدُنْ", "translit": "ْnُdَّl", "root": "لدن"}, {"id": 6, "arabic": "حَكِيمٍ", "translit": "ٍmyِkَḥ", "root": "حكم"}, {"id": 7, "arabic": "عَلِيمٍ", "translit": "ٍmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 7, "text": "إِذْ قَالَ مُوسَىٰ لِأَهْلِهِۦٓ إِنِّىٓ ءَانَسْتُ نَارًا سَـَٔاتِيكُم مِّنْهَا بِخَبَرٍ أَوْ ءَاتِيكُم بِشِهَابٍ قَبَسٍ لَّعَلَّكُمْ تَصْطَلُونَ ", "translation": "[Mention] when Moses said to his family, \"Indeed, I have perceived a fire. I will bring you from there information or will bring you a burning torch that you may warm yourselves.\"", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 4, "arabic": "لِأَهْلِهِۦٓ", "translit": "ٓۦِhِlْhَaʾِl", "root": "اهل"}, {"id": 5, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 6, "arabic": "ءَانَسْتُ", "translit": "ُtْsَnāَء", "root": "انس"}, {"id": 7, "arabic": "نَارًا", "translit": "āًrāَn", "root": "نور"}, {"id": 8, "arabic": "سَـَٔاتِيكُم", "translit": "mُkyِtāَٔـَs", "root": "اتي"}, {"id": 9, "arabic": "مِّنْهَا", "translit": "āَhْnِّm", "root": ""}, {"id": 10, "arabic": "بِخَبَرٍ", "translit": "ٍrَbَhkِb", "root": "خبر"}, {"id": 11, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 12, "arabic": "ءَاتِيكُم", "translit": "mُkyِtāَء", "root": "اتي"}, {"id": 13, "arabic": "بِشِهَابٍ", "translit": "ٍbāَhِhsِb", "root": "شهب"}, {"id": 14, "arabic": "قَبَسٍ", "translit": "ٍsَbَq", "root": "قبس"}, {"id": 15, "arabic": "لَّعَلَّكُمْ", "translit": "ْmُkَّlَʿعَّl", "root": ""}, {"id": 16, "arabic": "تَصْطَلُونَ", "translit": "َnwُlَṭْṣَt", "root": "صلي"}], "hasIhya": false}, {"ayah": 8, "text": "فَلَمَّا جَآءَهَا نُودِىَ أَنۢ بُورِكَ مَن فِى ٱلنَّارِ وَمَنْ حَوْلَهَا وَسُبْحَٰنَ ٱللَّهِ رَبِّ ٱلْعَٰلَمِينَ ", "translation": "But when he came to it, he was called, \"Blessed is whoever is at the fire and whoever is around it. And exalted is Allāh, Lord of the worlds.", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "جَآءَهَا", "translit": "āَhَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "نُودِىَ", "translit": "َàِdwُn", "root": "ندي"}, {"id": 4, "arabic": "أَنۢ", "translit": "ۢnَaʾ", "root": ""}, {"id": 5, "arabic": "بُورِكَ", "translit": "َkِrwُb", "root": "برك"}, {"id": 6, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 9, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 10, "arabic": "حَوْلَهَا", "translit": "āَhَlْwَḥ", "root": "حول"}, {"id": 11, "arabic": "وَسُبْحَٰنَ", "translit": "َnَٰḥْbُsَw", "root": "سبح"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 14, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 9, "text": "يَٰمُوسَىٰٓ إِنَّهُۥٓ أَنَا ٱللَّهُ ٱلْعَزِيزُ ٱلْحَكِيمُ ", "translation": "O Moses, indeed it is I - Allāh, the Exalted in Might, the Wise.\"", "words": [{"id": 1, "arabic": "يَٰمُوسَىٰٓ", "translit": "ٰٓàَswُmَٰy", "root": ""}, {"id": 2, "arabic": "إِنَّهُۥٓ", "translit": "ٓۥُhَّnِiʾ", "root": ""}, {"id": 3, "arabic": "أَنَا", "translit": "āَnَaʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 6, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}, {"ayah": 10, "text": "وَأَلْقِ عَصَاكَۚ فَلَمَّا رَءَاهَا تَهْتَزُّ كَأَنَّهَا جَآنٌّ وَلَّىٰ مُدْبِرًا وَلَمْ يُعَقِّبْۚ يَٰمُوسَىٰ لَا تَخَفْ إِنِّى لَا يَخَافُ لَدَىَّ ٱلْمُرْسَلُونَ ", "translation": "And [he was told], \"Throw down your staff.\" But when he saw it writhing as if it were a snake, he turned in flight and did not return.[1] [Allāh said], \"O Moses, fear not. Indeed, in My presence the messengers do not fear.", "words": [{"id": 1, "arabic": "وَأَلْقِ", "translit": "ِqْlَaʾَw", "root": "لقي"}, {"id": 2, "arabic": "عَصَاكَ", "translit": "َkāَṣَʿع", "root": "عصو"}, {"id": 3, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 4, "arabic": "رَءَاهَا", "translit": "āَhāَءَr", "root": "راي"}, {"id": 5, "arabic": "تَهْتَزُّ", "translit": "ُّzَtْhَt", "root": "هزز"}, {"id": 6, "arabic": "كَأَنَّهَا", "translit": "āَhَّnَaʾَk", "root": ""}, {"id": 7, "arabic": "جَآنٌّ", "translit": "ٌّnٓāَjg", "root": "جنن"}, {"id": 8, "arabic": "وَلَّىٰ", "translit": "ٰàَّlَw", "root": "ولي"}, {"id": 9, "arabic": "مُدْبِرًا", "translit": "āًrِbْdُm", "root": "دبر"}, {"id": 10, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 11, "arabic": "يُعَقِّبْ", "translit": "ْbِّqَʿعُy", "root": "عقب"}, {"id": 12, "arabic": "يَٰمُوسَىٰ", "translit": "ٰàَswُmَٰy", "root": ""}, {"id": 13, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 14, "arabic": "تَخَفْ", "translit": "ْfَhkَt", "root": "خوف"}, {"id": 15, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 16, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 17, "arabic": "يَخَافُ", "translit": "ُfāَhkَy", "root": "خوف"}, {"id": 18, "arabic": "لَدَىَّ", "translit": "َّàَdَl", "root": ""}, {"id": 19, "arabic": "ٱلْمُرْسَلُونَ", "translit": "َnwُlَsْrُmْlٱ", "root": "رسل"}], "hasIhya": false}, {"ayah": 11, "text": "إِلَّا مَن ظَلَمَ ثُمَّ بَدَّلَ حُسْنًۢا بَعْدَ سُوٓءٍ فَإِنِّى غَفُورٌ رَّحِيمٌ ", "translation": "Otherwise, he who wrongs, then substitutes good after evil - indeed, I am Forgiving and Merciful.", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "ظَلَمَ", "translit": "َmَlَẓ", "root": "ظلم"}, {"id": 4, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 5, "arabic": "بَدَّلَ", "translit": "َlَّdَb", "root": "بدل"}, {"id": 6, "arabic": "حُسْنًۢا", "translit": "āًۢnْsُḥ", "root": "حسن"}, {"id": 7, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 8, "arabic": "سُوٓءٍ", "translit": "ٍءٓwُs", "root": "سوا"}, {"id": 9, "arabic": "فَإِنِّى", "translit": "àِّnِiʾَf", "root": ""}, {"id": 10, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 11, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 12, "text": "وَأَدْخِلْ يَدَكَ فِى جَيْبِكَ تَخْرُجْ بَيْضَآءَ مِنْ غَيْرِ سُوٓءٍۖ فِى تِسْعِ ءَايَٰتٍ إِلَىٰ فِرْعَوْنَ وَقَوْمِهِۦٓۚ إِنَّهُمْ كَانُوا۟ قَوْمًا فَٰسِقِينَ ", "translation": "And put your hand into the opening of your garment [at the breast]; it will come out white without disease. [These are] among the nine signs [you will take] to Pharaoh and his people. Indeed, they have been a people defiantly disobedient.\"", "words": [{"id": 1, "arabic": "وَأَدْخِلْ", "translit": "ْlِhkْdَaʾَw", "root": "دخل"}, {"id": 2, "arabic": "يَدَكَ", "translit": "َkَdَy", "root": "يدي"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "جَيْبِكَ", "translit": "َkِbْyَjg", "root": "جيب"}, {"id": 5, "arabic": "تَخْرُجْ", "translit": "ْjgُrْhkَt", "root": "خرج"}, {"id": 6, "arabic": "بَيْضَآءَ", "translit": "َءٓāَḍْyَb", "root": "بيض"}, {"id": 7, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 8, "arabic": "غَيْرِ", "translit": "ِrْyَغ", "root": "غير"}, {"id": 9, "arabic": "سُوٓءٍ", "translit": "ٍءٓwُs", "root": "سوا"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "تِسْعِ", "translit": "ِʿعْsِt", "root": "تسع"}, {"id": 12, "arabic": "ءَايَٰتٍ", "translit": "ٍtَٰyāَء", "root": "ايي"}, {"id": 13, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 14, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 15, "arabic": "وَقَوْمِهِۦٓ", "translit": "ٓۦِhِmْwَqَw", "root": "قوم"}, {"id": 16, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 17, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 18, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 19, "arabic": "فَٰسِقِينَ", "translit": "َnyِqِsَٰf", "root": "فسق"}], "hasIhya": false}, {"ayah": 13, "text": "فَلَمَّا جَآءَتْهُمْ ءَايَٰتُنَا مُبْصِرَةً قَالُوا۟ هَٰذَا سِحْرٌ مُّبِينٌ ", "translation": "But when there came to them Our visible signs, they said, \"This is obvious magic.\"", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "جَآءَتْهُمْ", "translit": "ْmُhْtَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "ءَايَٰتُنَا", "translit": "āَnُtَٰyāَء", "root": "ايي"}, {"id": 4, "arabic": "مُبْصِرَةً", "translit": "ًẗَrِṣْbُm", "root": "بصر"}, {"id": 5, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 6, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 7, "arabic": "سِحْرٌ", "translit": "ٌrْḥِs", "root": "سحر"}, {"id": 8, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 14, "text": "وَجَحَدُوا۟ بِهَا وَٱسْتَيْقَنَتْهَآ أَنفُسُهُمْ ظُلْمًا وَعُلُوًّاۚ فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُفْسِدِينَ ", "translation": "And they rejected them, while their [inner] selves were convinced thereof, out of injustice and haughtiness. So see how was the end of the corrupters.", "words": [{"id": 1, "arabic": "وَجَحَدُوا۟", "translit": "۟āwُdَḥَjgَw", "root": "جحد"}, {"id": 2, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 3, "arabic": "وَٱسْتَيْقَنَتْهَآ", "translit": "ٓāَhْtَnَqْyَtْsٱَw", "root": "يقن"}, {"id": 4, "arabic": "أَنفُسُهُمْ", "translit": "ْmُhُsُfnَaʾ", "root": "نفس"}, {"id": 5, "arabic": "ظُلْمًا", "translit": "āًmْlُẓ", "root": "ظلم"}, {"id": 6, "arabic": "وَعُلُوًّا", "translit": "āًّwُlُʿعَw", "root": "علو"}, {"id": 7, "arabic": "فَٱنظُرْ", "translit": "ْrُẓnٱَf", "root": "نظر"}, {"id": 8, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 9, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 10, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 11, "arabic": "ٱلْمُفْسِدِينَ", "translit": "َnyِdِsْfُmْlٱ", "root": "فسد"}], "hasIhya": true}, {"ayah": 15, "text": "وَلَقَدْ ءَاتَيْنَا دَاوُۥدَ وَسُلَيْمَٰنَ عِلْمًاۖ وَقَالَا ٱلْحَمْدُ لِلَّهِ ٱلَّذِى فَضَّلَنَا عَلَىٰ كَثِيرٍ مِّنْ عِبَادِهِ ٱلْمُؤْمِنِينَ ", "translation": "And We had certainly given to David and Solomon knowledge, and they said, \"Praise [is due] to Allāh, who has favored us over many of His believing servants.\"", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَا", "translit": "āَnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "دَاوُۥدَ", "translit": "َdۥُwāَd", "root": ""}, {"id": 4, "arabic": "وَسُلَيْمَٰنَ", "translit": "َnَٰmْyَlُsَw", "root": ""}, {"id": 5, "arabic": "عِلْمًا", "translit": "āًmْlِʿع", "root": "علم"}, {"id": 6, "arabic": "وَقَالَا", "translit": "āَlāَqَw", "root": "قول"}, {"id": 7, "arabic": "ٱلْحَمْدُ", "translit": "ُdْmَḥْlٱ", "root": "حمد"}, {"id": 8, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 9, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "فَضَّلَنَا", "translit": "āَnَlَّḍَf", "root": "فضل"}, {"id": 11, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 12, "arabic": "كَثِيرٍ", "translit": "ٍryِhtَk", "root": "كثر"}, {"id": 13, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 14, "arabic": "عِبَادِهِ", "translit": "ِhِdāَbِʿع", "root": "عبد"}, {"id": 15, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}], "hasIhya": false}, {"ayah": 16, "text": "وَوَرِثَ سُلَيْمَٰنُ دَاوُۥدَۖ وَقَالَ يَٰٓأَيُّهَا ٱلنَّاسُ عُلِّمْنَا مَنطِقَ ٱلطَّيْرِ وَأُوتِينَا مِن كُلِّ شَىْءٍۖ إِنَّ هَٰذَا لَهُوَ ٱلْفَضْلُ ٱلْمُبِينُ ", "translation": "And Solomon inherited David. He said, \"O people, we have been taught the language of birds, and we have been given from all things. Indeed, this is evident bounty.\"", "words": [{"id": 1, "arabic": "وَوَرِثَ", "translit": "َhtِrَwَw", "root": "ورث"}, {"id": 2, "arabic": "سُلَيْمَٰنُ", "translit": "ُnَٰmْyَlُs", "root": ""}, {"id": 3, "arabic": "دَاوُۥدَ", "translit": "َdۥُwāَd", "root": ""}, {"id": 4, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 5, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 6, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 7, "arabic": "عُلِّمْنَا", "translit": "āَnْmِّlُʿع", "root": "علم"}, {"id": 8, "arabic": "مَنطِقَ", "translit": "َqِṭnَm", "root": "نطق"}, {"id": 9, "arabic": "ٱلطَّيْرِ", "translit": "ِrْyَّṭlٱ", "root": "طير"}, {"id": 10, "arabic": "وَأُوتِينَا", "translit": "āَnyِtwُaʾَw", "root": "اتي"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 13, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 14, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 15, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 16, "arabic": "لَهُوَ", "translit": "َwُhَl", "root": ""}, {"id": 17, "arabic": "ٱلْفَضْلُ", "translit": "ُlْḍَfْlٱ", "root": "فضل"}, {"id": 18, "arabic": "ٱلْمُبِينُ", "translit": "ُnyِbُmْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 17, "text": "وَحُشِرَ لِسُلَيْمَٰنَ جُنُودُهُۥ مِنَ ٱلْجِنِّ وَٱلْإِنسِ وَٱلطَّيْرِ فَهُمْ يُوزَعُونَ ", "translation": "And gathered for Solomon were his soldiers of the jinn and men and birds, and they were [marching] in rows", "words": [{"id": 1, "arabic": "وَحُشِرَ", "translit": "َrِhsُḥَw", "root": "حشر"}, {"id": 2, "arabic": "لِسُلَيْمَٰنَ", "translit": "َnَٰmْyَlُsِl", "root": ""}, {"id": 3, "arabic": "جُنُودُهُۥ", "translit": "ۥُhُdwُnُjg", "root": "جند"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱلْجِنِّ", "translit": "ِّnِjgْlٱ", "root": "جنن"}, {"id": 6, "arabic": "وَٱلْإِنسِ", "translit": "ِsnِiʾْlٱَw", "root": "انس"}, {"id": 7, "arabic": "وَٱلطَّيْرِ", "translit": "ِrْyَّṭlٱَw", "root": "طير"}, {"id": 8, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 9, "arabic": "يُوزَعُونَ", "translit": "َnwُʿعَzwُy", "root": "وزع"}], "hasIhya": false}, {"ayah": 18, "text": "حَتَّىٰٓ إِذَآ أَتَوْا۟ عَلَىٰ وَادِ ٱلنَّمْلِ قَالَتْ نَمْلَةٌ يَٰٓأَيُّهَا ٱلنَّمْلُ ٱدْخُلُوا۟ مَسَٰكِنَكُمْ لَا يَحْطِمَنَّكُمْ سُلَيْمَٰنُ وَجُنُودُهُۥ وَهُمْ لَا يَشْعُرُونَ ", "translation": "Until, when they came upon the valley of the ants, an ant said, \"O ants, enter your dwellings that you not be crushed by Solomon and his soldiers while they perceive not.\"", "words": [{"id": 1, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 2, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 3, "arabic": "أَتَوْا۟", "translit": "۟āْwَtَaʾ", "root": "اتي"}, {"id": 4, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 5, "arabic": "وَادِ", "translit": "ِdāَw", "root": "ودي"}, {"id": 6, "arabic": "ٱلنَّمْلِ", "translit": "ِlْmَّnlٱ", "root": "نمل"}, {"id": 7, "arabic": "قَالَتْ", "translit": "ْtَlāَq", "root": "قول"}, {"id": 8, "arabic": "نَمْلَةٌ", "translit": "ٌẗَlْmَn", "root": "نمل"}, {"id": 9, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 10, "arabic": "ٱلنَّمْلُ", "translit": "ُlْmَّnlٱ", "root": "نمل"}, {"id": 11, "arabic": "ٱدْخُلُوا۟", "translit": "۟āwُlُhkْdٱ", "root": "دخل"}, {"id": 12, "arabic": "مَسَٰكِنَكُمْ", "translit": "ْmُkَnِkَٰsَm", "root": "سكن"}, {"id": 13, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 14, "arabic": "يَحْطِمَنَّكُمْ", "translit": "ْmُkَّnَmِṭْḥَy", "root": "حطم"}, {"id": 15, "arabic": "سُلَيْمَٰنُ", "translit": "ُnَٰmْyَlُs", "root": ""}, {"id": 16, "arabic": "وَجُنُودُهُۥ", "translit": "ۥُhُdwُnُjgَw", "root": "جند"}, {"id": 17, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 18, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 19, "arabic": "يَشْعُرُونَ", "translit": "َnwُrُʿعْhsَy", "root": "شعر"}], "hasIhya": false}, {"ayah": 19, "text": "فَتَبَسَّمَ ضَاحِكًا مِّن قَوْلِهَا وَقَالَ رَبِّ أَوْزِعْنِىٓ أَنْ أَشْكُرَ نِعْمَتَكَ ٱلَّتِىٓ أَنْعَمْتَ عَلَىَّ وَعَلَىٰ وَٰلِدَىَّ وَأَنْ أَعْمَلَ صَٰلِحًا تَرْضَىٰهُ وَأَدْخِلْنِى بِرَحْمَتِكَ فِى عِبَادِكَ ٱلصَّٰلِحِينَ ", "translation": "So [Solomon] smiled, amused at her speech, and said, \"My Lord, enable me[1] to be grateful for Your favor which You have bestowed upon me and upon my parents and to do righteousness of which You approve. And admit me by Your mercy into [the ranks of] Your righteous servants.\"[2]", "words": [{"id": 1, "arabic": "فَتَبَسَّمَ", "translit": "َmَّsَbَtَf", "root": "بسم"}, {"id": 2, "arabic": "ضَاحِكًا", "translit": "āًkِḥāَḍ", "root": "ضحك"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "قَوْلِهَا", "translit": "āَhِlْwَq", "root": "قول"}, {"id": 5, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 6, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 7, "arabic": "أَوْزِعْنِىٓ", "translit": "ٓàِnْʿعِzْwَaʾ", "root": "وزع"}, {"id": 8, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 9, "arabic": "أَشْكُرَ", "translit": "َrُkْhsَaʾ", "root": "شكر"}, {"id": 10, "arabic": "نِعْمَتَكَ", "translit": "َkَtَmْʿعِn", "root": "نعم"}, {"id": 11, "arabic": "ٱلَّتِىٓ", "translit": "ٓàِtَّlٱ", "root": ""}, {"id": 12, "arabic": "أَنْعَمْتَ", "translit": "َtْmَʿعْnَaʾ", "root": "نعم"}, {"id": 13, "arabic": "عَلَىَّ", "translit": "َّàَlَʿع", "root": ""}, {"id": 14, "arabic": "وَعَلَىٰ", "translit": "ٰàَlَʿعَw", "root": ""}, {"id": 15, "arabic": "وَٰلِدَىَّ", "translit": "َّàَdِlَٰw", "root": "ولد"}, {"id": 16, "arabic": "وَأَنْ", "translit": "ْnَaʾَw", "root": ""}, {"id": 17, "arabic": "أَعْمَلَ", "translit": "َlَmْʿعَaʾ", "root": "عمل"}, {"id": 18, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 19, "arabic": "تَرْضَىٰهُ", "translit": "ُhٰàَḍْrَt", "root": "رضو"}, {"id": 20, "arabic": "وَأَدْخِلْنِى", "translit": "àِnْlِhkْdَaʾَw", "root": "دخل"}, {"id": 21, "arabic": "بِرَحْمَتِكَ", "translit": "َkِtَmْḥَrِb", "root": "رحم"}, {"id": 22, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 23, "arabic": "عِبَادِكَ", "translit": "َkِdāَbِʿع", "root": "عبد"}, {"id": 24, "arabic": "ٱلصَّٰلِحِينَ", "translit": "َnyِḥِlَّٰṣlٱ", "root": "صلح"}], "hasIhya": false}, {"ayah": 20, "text": "وَتَفَقَّدَ ٱلطَّيْرَ فَقَالَ مَا لِىَ لَآ أَرَى ٱلْهُدْهُدَ أَمْ كَانَ مِنَ ٱلْغَآئِبِينَ ", "translation": "And he took attendance of the birds and said, \"Why do I not see the hoopoe - or is he among the absent?", "words": [{"id": 1, "arabic": "وَتَفَقَّدَ", "translit": "َdَّqَfَtَw", "root": "فقد"}, {"id": 2, "arabic": "ٱلطَّيْرَ", "translit": "َrْyَّṭlٱ", "root": "طير"}, {"id": 3, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "لِىَ", "translit": "َàِl", "root": ""}, {"id": 6, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 7, "arabic": "أَرَى", "translit": "àَrَaʾ", "root": "راي"}, {"id": 8, "arabic": "ٱلْهُدْهُدَ", "translit": "َdُhْdُhْlٱ", "root": "هدهد"}, {"id": 9, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 10, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 11, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 12, "arabic": "ٱلْغَآئِبِينَ", "translit": "َnyِbِyʾٓāَغْlٱ", "root": "غيب"}], "hasIhya": false}, {"ayah": 21, "text": "لَأُعَذِّبَنَّهُۥ عَذَابًا شَدِيدًا أَوْ لَأَا۟ذْبَحَنَّهُۥٓ أَوْ لَيَأْتِيَنِّى بِسُلْطَٰنٍ مُّبِينٍ ", "translation": "I will surely punish him with a severe punishment or slaughter him unless he brings me clear authorization.\"[1]", "words": [{"id": 1, "arabic": "لَأُعَذِّبَنَّهُۥ", "translit": "ۥُhَّnَbِّhdَʿعُaʾَl", "root": "عذب"}, {"id": 2, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 3, "arabic": "شَدِيدًا", "translit": "āًdyِdَhs", "root": "شدد"}, {"id": 4, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 5, "arabic": "لَأَا۟ذْبَحَنَّهُۥٓ", "translit": "ٓۥُhَّnَḥَbْhd۟āَaʾَl", "root": "ذبح"}, {"id": 6, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 7, "arabic": "لَيَأْتِيَنِّى", "translit": "àِّnَyِtْaʾَyَl", "root": "اتي"}, {"id": 8, "arabic": "بِسُلْطَٰنٍ", "translit": "ٍnَٰṭْlُsِb", "root": "سلط"}, {"id": 9, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 22, "text": "فَمَكَثَ غَيْرَ بَعِيدٍ فَقَالَ أَحَطتُ بِمَا لَمْ تُحِطْ بِهِۦ وَجِئْتُكَ مِن سَبَإٍۭ بِنَبَإٍ يَقِينٍ ", "translation": "But he [i.e., the hoopoe] stayed not long and said, \"I have encompassed [in knowledge] that which you have not encompassed, and I have come to you from Sheba with certain news.", "words": [{"id": 1, "arabic": "فَمَكَثَ", "translit": "َhtَkَmَf", "root": "مكث"}, {"id": 2, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 3, "arabic": "بَعِيدٍ", "translit": "ٍdyِʿعَb", "root": "بعد"}, {"id": 4, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 5, "arabic": "أَحَطتُ", "translit": "ُtṭَḥَaʾ", "root": "حوط"}, {"id": 6, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 7, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 8, "arabic": "تُحِطْ", "translit": "ْṭِḥُt", "root": "حوط"}, {"id": 9, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 10, "arabic": "وَجِئْتُكَ", "translit": "َkُtْyʾِjgَw", "root": "جيا"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "سَبَإٍۭ", "translit": "ٍۭiʾَbَs", "root": "سبا"}, {"id": 13, "arabic": "بِنَبَإٍ", "translit": "ٍiʾَbَnِb", "root": "نبا"}, {"id": 14, "arabic": "يَقِينٍ", "translit": "ٍnyِqَy", "root": "يقن"}], "hasIhya": false}, {"ayah": 23, "text": "إِنِّى وَجَدتُّ ٱمْرَأَةً تَمْلِكُهُمْ وَأُوتِيَتْ مِن كُلِّ شَىْءٍ وَلَهَا عَرْشٌ عَظِيمٌ ", "translation": "Indeed, I found [there] a woman ruling them, and she has been given of all things, and she has a great throne.", "words": [{"id": 1, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 2, "arabic": "وَجَدتُّ", "translit": "ُّtdَjgَw", "root": "وجد"}, {"id": 3, "arabic": "ٱمْرَأَةً", "translit": "ًẗَaʾَrْmٱ", "root": "مرا"}, {"id": 4, "arabic": "تَمْلِكُهُمْ", "translit": "ْmُhُkِlْmَt", "root": "ملك"}, {"id": 5, "arabic": "وَأُوتِيَتْ", "translit": "ْtَyِtwُaʾَw", "root": "اتي"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 8, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 9, "arabic": "وَلَهَا", "translit": "āَhَlَw", "root": ""}, {"id": 10, "arabic": "عَرْشٌ", "translit": "ٌhsْrَʿع", "root": "عرش"}, {"id": 11, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 24, "text": "وَجَدتُّهَا وَقَوْمَهَا يَسْجُدُونَ لِلشَّمْسِ مِن دُونِ ٱللَّهِ وَزَيَّنَ لَهُمُ ٱلشَّيْطَٰنُ أَعْمَٰلَهُمْ فَصَدَّهُمْ عَنِ ٱلسَّبِيلِ فَهُمْ لَا يَهْتَدُونَ ", "translation": "I found her and her people prostrating to the sun instead of Allāh, and Satan has made their deeds pleasing to them and averted them from [His] way, so they are not guided,", "words": [{"id": 1, "arabic": "وَجَدتُّهَا", "translit": "āَhُّtdَjgَw", "root": "وجد"}, {"id": 2, "arabic": "وَقَوْمَهَا", "translit": "āَhَmْwَqَw", "root": "قوم"}, {"id": 3, "arabic": "يَسْجُدُونَ", "translit": "َnwُdُjgْsَy", "root": "سجد"}, {"id": 4, "arabic": "لِلشَّمْسِ", "translit": "ِsْmَّhslِl", "root": "شمس"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "وَزَيَّنَ", "translit": "َnَّyَzَw", "root": "زين"}, {"id": 9, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 10, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 11, "arabic": "أَعْمَٰلَهُمْ", "translit": "ْmُhَlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 12, "arabic": "فَصَدَّهُمْ", "translit": "ْmُhَّdَṣَf", "root": "صدد"}, {"id": 13, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 14, "arabic": "ٱلسَّبِيلِ", "translit": "ِlyِbَّslٱ", "root": "سبل"}, {"id": 15, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 16, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 17, "arabic": "يَهْتَدُونَ", "translit": "َnwُdَtْhَy", "root": "هدي"}], "hasIhya": false}, {"ayah": 25, "text": "أَلَّا يَسْجُدُوا۟ لِلَّهِ ٱلَّذِى يُخْرِجُ ٱلْخَبْءَ فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَيَعْلَمُ مَا تُخْفُونَ وَمَا تُعْلِنُونَ ", "translation": "[And] so they do not prostrate to Allāh, who brings forth what is hidden within the heavens and the earth and knows what you conceal and what you declare -", "words": [{"id": 1, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 2, "arabic": "يَسْجُدُوا۟", "translit": "۟āwُdُjgْsَy", "root": "سجد"}, {"id": 3, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 4, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "يُخْرِجُ", "translit": "ُjgِrْhkُy", "root": "خرج"}, {"id": 6, "arabic": "ٱلْخَبْءَ", "translit": "َءْbَhkْlٱ", "root": "خبا"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 9, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 10, "arabic": "وَيَعْلَمُ", "translit": "ُmَlْʿعَyَw", "root": "علم"}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "تُخْفُونَ", "translit": "َnwُfْhkُt", "root": "خفي"}, {"id": 13, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 14, "arabic": "تُعْلِنُونَ", "translit": "َnwُnِlْʿعُt", "root": "علن"}], "hasIhya": true}, {"ayah": 26, "text": "ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَ رَبُّ ٱلْعَرْشِ ٱلْعَظِيمِ۩ ", "translation": "Allāh - there is no deity except Him, Lord of the Great Throne.\"", "words": [{"id": 1, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 2, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 3, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 6, "arabic": "رَبُّ", "translit": "ُّbَr", "root": "ربب"}, {"id": 7, "arabic": "ٱلْعَرْشِ", "translit": "ِhsْrَʿعْlٱ", "root": "عرش"}, {"id": 8, "arabic": "ٱلْعَظِيمِ", "translit": "ِmyِẓَʿعْlٱ", "root": "عظم"}], "hasIhya": false}, {"ayah": 27, "text": "قَالَ سَنَنظُرُ أَصَدَقْتَ أَمْ كُنتَ مِنَ ٱلْكَٰذِبِينَ ", "translation": "[Solomon] said, \"We will see whether you were truthful or were of the liars.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "سَنَنظُرُ", "translit": "ُrُẓnَnَs", "root": "نظر"}, {"id": 3, "arabic": "أَصَدَقْتَ", "translit": "َtْqَdَṣَaʾ", "root": "صدق"}, {"id": 4, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 5, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱلْكَٰذِبِينَ", "translit": "َnyِbِhdَٰkْlٱ", "root": "كذب"}], "hasIhya": false}, {"ayah": 28, "text": "ٱذْهَب بِّكِتَٰبِى هَٰذَا فَأَلْقِهْ إِلَيْهِمْ ثُمَّ تَوَلَّ عَنْهُمْ فَٱنظُرْ مَاذَا يَرْجِعُونَ ", "translation": "Take this letter of mine and deliver it to them. Then leave them and see what [answer] they will return.\"", "words": [{"id": 1, "arabic": "ٱذْهَب", "translit": "bَhْhdٱ", "root": "ذهب"}, {"id": 2, "arabic": "بِّكِتَٰبِى", "translit": "àِbَٰtِkِّb", "root": "كتب"}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "فَأَلْقِهْ", "translit": "ْhِqْlَaʾَf", "root": "لقي"}, {"id": 5, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "تَوَلَّ", "translit": "َّlَwَt", "root": "ولي"}, {"id": 8, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 9, "arabic": "فَٱنظُرْ", "translit": "ْrُẓnٱَf", "root": "نظر"}, {"id": 10, "arabic": "مَاذَا", "translit": "āَhdāَm", "root": ""}, {"id": 11, "arabic": "يَرْجِعُونَ", "translit": "َnwُʿعِjgْrَy", "root": "رجع"}], "hasIhya": false}, {"ayah": 29, "text": "قَالَتْ يَٰٓأَيُّهَا ٱلْمَلَؤُا۟ إِنِّىٓ أُلْقِىَ إِلَىَّ كِتَٰبٌ كَرِيمٌ ", "translation": "She said, \"O eminent ones, indeed, to me has been delivered a noble letter.", "words": [{"id": 1, "arabic": "قَالَتْ", "translit": "ْtَlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 3, "arabic": "ٱلْمَلَؤُا۟", "translit": "۟āُwʾَlَmْlٱ", "root": "ملا"}, {"id": 4, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 5, "arabic": "أُلْقِىَ", "translit": "َàِqْlُaʾ", "root": "لقي"}, {"id": 6, "arabic": "إِلَىَّ", "translit": "َّàَlِiʾ", "root": ""}, {"id": 7, "arabic": "كِتَٰبٌ", "translit": "ٌbَٰtِk", "root": "كتب"}, {"id": 8, "arabic": "كَرِيمٌ", "translit": "ٌmyِrَk", "root": "كرم"}], "hasIhya": false}, {"ayah": 30, "text": "إِنَّهُۥ مِن سُلَيْمَٰنَ وَإِنَّهُۥ بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ", "translation": "Indeed, it is from Solomon, and indeed, it is [i.e., reads]: 'In the name of Allāh, the Entirely Merciful, the Especially Merciful,", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "سُلَيْمَٰنَ", "translit": "َnَٰmْyَlُs", "root": ""}, {"id": 4, "arabic": "وَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَw", "root": ""}, {"id": 5, "arabic": "بِسْمِ", "translit": "ِmْsِb", "root": "سمو"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "ٱلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 8, "arabic": "ٱلرَّحِيمِ", "translit": "ِmyِḥَّrlٱ", "root": "رحم"}], "hasIhya": false}, {"ayah": 31, "text": "أَلَّا تَعْلُوا۟ عَلَىَّ وَأْتُونِى مُسْلِمِينَ ", "translation": "Be not haughty with me but come to me in submission [as Muslims].'\"", "words": [{"id": 1, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 2, "arabic": "تَعْلُوا۟", "translit": "۟āwُlْʿعَt", "root": "علو"}, {"id": 3, "arabic": "عَلَىَّ", "translit": "َّàَlَʿع", "root": ""}, {"id": 4, "arabic": "وَأْتُونِى", "translit": "àِnwُtْaʾَw", "root": "اتي"}, {"id": 5, "arabic": "مُسْلِمِينَ", "translit": "َnyِmِlْsُm", "root": "سلم"}], "hasIhya": false}, {"ayah": 32, "text": "قَالَتْ يَٰٓأَيُّهَا ٱلْمَلَؤُا۟ أَفْتُونِى فِىٓ أَمْرِى مَا كُنتُ قَاطِعَةً أَمْرًا حَتَّىٰ تَشْهَدُونِ ", "translation": "She said, \"O eminent ones, advise me in my affair. I would not decide a matter until you witness [for] me.\"[1]", "words": [{"id": 1, "arabic": "قَالَتْ", "translit": "ْtَlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 3, "arabic": "ٱلْمَلَؤُا۟", "translit": "۟āُwʾَlَmْlٱ", "root": "ملا"}, {"id": 4, "arabic": "أَفْتُونِى", "translit": "àِnwُtْfَaʾ", "root": "فتي"}, {"id": 5, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 6, "arabic": "أَمْرِى", "translit": "àِrْmَaʾ", "root": "امر"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "كُنتُ", "translit": "ُtnُk", "root": "كون"}, {"id": 9, "arabic": "قَاطِعَةً", "translit": "ًẗَʿعِṭāَq", "root": "قطع"}, {"id": 10, "arabic": "أَمْرًا", "translit": "āًrْmَaʾ", "root": "امر"}, {"id": 11, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 12, "arabic": "تَشْهَدُونِ", "translit": "ِnwُdَhْhsَt", "root": "شهد"}], "hasIhya": false}, {"ayah": 33, "text": "قَالُوا۟ نَحْنُ أُو۟لُوا۟ قُوَّةٍ وَأُو۟لُوا۟ بَأْسٍ شَدِيدٍ وَٱلْأَمْرُ إِلَيْكِ فَٱنظُرِى مَاذَا تَأْمُرِينَ ", "translation": "They said, \"We are men of strength and of great military might, but the command is yours, so see what you will command.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 3, "arabic": "أُو۟لُوا۟", "translit": "۟āwُl۟wُaʾ", "root": ""}, {"id": 4, "arabic": "قُوَّةٍ", "translit": "ٍẗَّwُq", "root": "قوي"}, {"id": 5, "arabic": "وَأُو۟لُوا۟", "translit": "۟āwُl۟wُaʾَw", "root": ""}, {"id": 6, "arabic": "بَأْسٍ", "translit": "ٍsْaʾَb", "root": "باس"}, {"id": 7, "arabic": "شَدِيدٍ", "translit": "ٍdyِdَhs", "root": "شدد"}, {"id": 8, "arabic": "وَٱلْأَمْرُ", "translit": "ُrْmَaʾْlٱَw", "root": "امر"}, {"id": 9, "arabic": "إِلَيْكِ", "translit": "ِkْyَlِiʾ", "root": ""}, {"id": 10, "arabic": "فَٱنظُرِى", "translit": "àِrُẓnٱَf", "root": "نظر"}, {"id": 11, "arabic": "مَاذَا", "translit": "āَhdāَm", "root": ""}, {"id": 12, "arabic": "تَأْمُرِينَ", "translit": "َnyِrُmْaʾَt", "root": "امر"}], "hasIhya": false}, {"ayah": 34, "text": "قَالَتْ إِنَّ ٱلْمُلُوكَ إِذَا دَخَلُوا۟ قَرْيَةً أَفْسَدُوهَا وَجَعَلُوٓا۟ أَعِزَّةَ أَهْلِهَآ أَذِلَّةًۖ وَكَذَٰلِكَ يَفْعَلُونَ ", "translation": "She said, \"Indeed kings - when they enter a city, they ruin it and render the honored of its people humbled. And thus do they do.", "words": [{"id": 1, "arabic": "قَالَتْ", "translit": "ْtَlāَq", "root": "قول"}, {"id": 2, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 3, "arabic": "ٱلْمُلُوكَ", "translit": "َkwُlُmْlٱ", "root": "ملك"}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "دَخَلُوا۟", "translit": "۟āwُlَhkَd", "root": "دخل"}, {"id": 6, "arabic": "قَرْيَةً", "translit": "ًẗَyْrَq", "root": "قري"}, {"id": 7, "arabic": "أَفْسَدُوهَا", "translit": "āَhwُdَsْfَaʾ", "root": "فسد"}, {"id": 8, "arabic": "وَجَعَلُوٓا۟", "translit": "۟āٓwُlَʿعَjgَw", "root": "جعل"}, {"id": 9, "arabic": "أَعِزَّةَ", "translit": "َẗَّzِʿعَaʾ", "root": "عزز"}, {"id": 10, "arabic": "أَهْلِهَآ", "translit": "ٓāَhِlْhَaʾ", "root": "اهل"}, {"id": 11, "arabic": "أَذِلَّةً", "translit": "ًẗَّlِhdَaʾ", "root": "ذلل"}, {"id": 12, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 13, "arabic": "يَفْعَلُونَ", "translit": "َnwُlَʿعْfَy", "root": "فعل"}], "hasIhya": false}, {"ayah": 35, "text": "وَإِنِّى مُرْسِلَةٌ إِلَيْهِم بِهَدِيَّةٍ فَنَاظِرَةٌۢ بِمَ يَرْجِعُ ٱلْمُرْسَلُونَ ", "translation": "But indeed, I will send to them a gift and see with what [reply] the messengers will return.\"", "words": [{"id": 1, "arabic": "وَإِنِّى", "translit": "àِّnِiʾَw", "root": ""}, {"id": 2, "arabic": "مُرْسِلَةٌ", "translit": "ٌẗَlِsْrُm", "root": "رسل"}, {"id": 3, "arabic": "إِلَيْهِم", "translit": "mِhْyَlِiʾ", "root": ""}, {"id": 4, "arabic": "بِهَدِيَّةٍ", "translit": "ٍẗَّyِdَhِb", "root": "هدي"}, {"id": 5, "arabic": "فَنَاظِرَةٌۢ", "translit": "ٌۢẗَrِẓāَnَf", "root": "نظر"}, {"id": 6, "arabic": "بِمَ", "translit": "َmِb", "root": ""}, {"id": 7, "arabic": "يَرْجِعُ", "translit": "ُʿعِjgْrَy", "root": "رجع"}, {"id": 8, "arabic": "ٱلْمُرْسَلُونَ", "translit": "َnwُlَsْrُmْlٱ", "root": "رسل"}], "hasIhya": false}, {"ayah": 36, "text": "فَلَمَّا جَآءَ سُلَيْمَٰنَ قَالَ أَتُمِدُّونَنِ بِمَالٍ فَمَآ ءَاتَىٰنِۦَ ٱللَّهُ خَيْرٌ مِّمَّآ ءَاتَىٰكُم بَلْ أَنتُم بِهَدِيَّتِكُمْ تَفْرَحُونَ ", "translation": "So when they came to Solomon, he said, \"Do you provide me with wealth? But what Allāh has given me is better than what He has given you. Rather, it is you who rejoice in your gift.", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "سُلَيْمَٰنَ", "translit": "َnَٰmْyَlُs", "root": ""}, {"id": 4, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 5, "arabic": "أَتُمِدُّونَنِ", "translit": "ِnَnwُّdِmُtَaʾ", "root": "مدد"}, {"id": 6, "arabic": "بِمَالٍ", "translit": "ٍlāَmِb", "root": "مول"}, {"id": 7, "arabic": "فَمَآ", "translit": "ٓāَmَf", "root": ""}, {"id": 8, "arabic": "ءَاتَىٰنِۦَ", "translit": "َۦِnٰàَtāَء", "root": "اتي"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 11, "arabic": "مِّمَّآ", "translit": "ٓāَّmِّm", "root": ""}, {"id": 12, "arabic": "ءَاتَىٰكُم", "translit": "mُkٰàَtāَء", "root": "اتي"}, {"id": 13, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 14, "arabic": "أَنتُم", "translit": "mُtnَaʾ", "root": ""}, {"id": 15, "arabic": "بِهَدِيَّتِكُمْ", "translit": "ْmُkِtَّyِdَhِb", "root": "هدي"}, {"id": 16, "arabic": "تَفْرَحُونَ", "translit": "َnwُḥَrْfَt", "root": "فرح"}], "hasIhya": false}, {"ayah": 37, "text": "ٱرْجِعْ إِلَيْهِمْ فَلَنَأْتِيَنَّهُم بِجُنُودٍ لَّا قِبَلَ لَهُم بِهَا وَلَنُخْرِجَنَّهُم مِّنْهَآ أَذِلَّةً وَهُمْ صَٰغِرُونَ ", "translation": "Return to them, for we will surely come to them with soldiers that they will be powerless to encounter, and we will surely expel them therefrom in humiliation, and they will be debased.\"", "words": [{"id": 1, "arabic": "ٱرْجِعْ", "translit": "ْʿعِjgْrٱ", "root": "رجع"}, {"id": 2, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 3, "arabic": "فَلَنَأْتِيَنَّهُم", "translit": "mُhَّnَyِtْaʾَnَlَf", "root": "اتي"}, {"id": 4, "arabic": "بِجُنُودٍ", "translit": "ٍdwُnُjgِb", "root": "جند"}, {"id": 5, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 6, "arabic": "قِبَلَ", "translit": "َlَbِq", "root": "قبل"}, {"id": 7, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 8, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 9, "arabic": "وَلَنُخْرِجَنَّهُم", "translit": "mُhَّnَjgِrْhkُnَlَw", "root": "خرج"}, {"id": 10, "arabic": "مِّنْهَآ", "translit": "ٓāَhْnِّm", "root": ""}, {"id": 11, "arabic": "أَذِلَّةً", "translit": "ًẗَّlِhdَaʾ", "root": "ذلل"}, {"id": 12, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 13, "arabic": "صَٰغِرُونَ", "translit": "َnwُrِغَٰṣ", "root": "صغر"}], "hasIhya": false}, {"ayah": 38, "text": "قَالَ يَٰٓأَيُّهَا ٱلْمَلَؤُا۟ أَيُّكُمْ يَأْتِينِى بِعَرْشِهَا قَبْلَ أَن يَأْتُونِى مُسْلِمِينَ ", "translation": "[Solomon] said, \"O assembly [of jinn], which of you will bring me her throne before they come to me in submission?\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 3, "arabic": "ٱلْمَلَؤُا۟", "translit": "۟āُwʾَlَmْlٱ", "root": "ملا"}, {"id": 4, "arabic": "أَيُّكُمْ", "translit": "ْmُkُّyَaʾ", "root": "ايي"}, {"id": 5, "arabic": "يَأْتِينِى", "translit": "àِnyِtْaʾَy", "root": "اتي"}, {"id": 6, "arabic": "بِعَرْشِهَا", "translit": "āَhِhsْrَʿعِb", "root": "عرش"}, {"id": 7, "arabic": "قَبْلَ", "translit": "َlْbَq", "root": "قبل"}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "يَأْتُونِى", "translit": "àِnwُtْaʾَy", "root": "اتي"}, {"id": 10, "arabic": "مُسْلِمِينَ", "translit": "َnyِmِlْsُm", "root": "سلم"}], "hasIhya": false}, {"ayah": 39, "text": "قَالَ عِفْرِيتٌ مِّنَ ٱلْجِنِّ أَنَا۠ ءَاتِيكَ بِهِۦ قَبْلَ أَن تَقُومَ مِن مَّقَامِكَۖ وَإِنِّى عَلَيْهِ لَقَوِىٌّ أَمِينٌ ", "translation": "A powerful one from among the jinn said, \"I will bring it to you before you rise from your place, and indeed, I am for this [task] strong and trustworthy.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "عِفْرِيتٌ", "translit": "ٌtyِrْfِʿع", "root": "عفر"}, {"id": 3, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 4, "arabic": "ٱلْجِنِّ", "translit": "ِّnِjgْlٱ", "root": "جنن"}, {"id": 5, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 6, "arabic": "ءَاتِيكَ", "translit": "َkyِtāَء", "root": "اتي"}, {"id": 7, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 8, "arabic": "قَبْلَ", "translit": "َlْbَq", "root": "قبل"}, {"id": 9, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 10, "arabic": "تَقُومَ", "translit": "َmwُqَt", "root": "قوم"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "مَّقَامِكَ", "translit": "َkِmāَqَّm", "root": "قوم"}, {"id": 13, "arabic": "وَإِنِّى", "translit": "àِّnِiʾَw", "root": ""}, {"id": 14, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 15, "arabic": "لَقَوِىٌّ", "translit": "ٌّàِwَqَl", "root": "قوي"}, {"id": 16, "arabic": "أَمِينٌ", "translit": "ٌnyِmَaʾ", "root": "امن"}], "hasIhya": false}, {"ayah": 40, "text": "قَالَ ٱلَّذِى عِندَهُۥ عِلْمٌ مِّنَ ٱلْكِتَٰبِ أَنَا۠ ءَاتِيكَ بِهِۦ قَبْلَ أَن يَرْتَدَّ إِلَيْكَ طَرْفُكَۚ فَلَمَّا رَءَاهُ مُسْتَقِرًّا عِندَهُۥ قَالَ هَٰذَا مِن فَضْلِ رَبِّى لِيَبْلُوَنِىٓ ءَأَشْكُرُ أَمْ أَكْفُرُۖ وَمَن شَكَرَ فَإِنَّمَا يَشْكُرُ لِنَفْسِهِۦۖ وَمَن كَفَرَ فَإِنَّ رَبِّى غَنِىٌّ كَرِيمٌ ", "translation": "Said one who had knowledge from the Scripture, \"I will bring it to you before your glance returns to you.\" And when [Solomon] saw it placed before him, he said, \"This is from the favor of my Lord to test me whether I will be grateful or ungrateful. And whoever is grateful - his gratitude is only for [the benefit of] himself. And whoever is ungrateful - then indeed, my Lord is Free of need and Generous.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "عِندَهُۥ", "translit": "ۥُhَdnِʿع", "root": "عند"}, {"id": 4, "arabic": "عِلْمٌ", "translit": "ٌmْlِʿع", "root": "علم"}, {"id": 5, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 6, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 7, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 8, "arabic": "ءَاتِيكَ", "translit": "َkyِtāَء", "root": "اتي"}, {"id": 9, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 10, "arabic": "قَبْلَ", "translit": "َlْbَq", "root": "قبل"}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "يَرْتَدَّ", "translit": "َّdَtْrَy", "root": "ردد"}, {"id": 13, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 14, "arabic": "طَرْفُكَ", "translit": "َkُfْrَṭ", "root": "طرف"}, {"id": 15, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 16, "arabic": "رَءَاهُ", "translit": "ُhāَءَr", "root": "راي"}, {"id": 17, "arabic": "مُسْتَقِرًّا", "translit": "āًّrِqَtْsُm", "root": "قرر"}, {"id": 18, "arabic": "عِندَهُۥ", "translit": "ۥُhَdnِʿع", "root": "عند"}, {"id": 19, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 20, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 21, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 22, "arabic": "فَضْلِ", "translit": "ِlْḍَf", "root": "فضل"}, {"id": 23, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 24, "arabic": "لِيَبْلُوَنِىٓ", "translit": "ٓàِnَwُlْbَyِl", "root": "بلو"}, {"id": 25, "arabic": "ءَأَشْكُرُ", "translit": "ُrُkْhsَaʾَء", "root": "شكر"}, {"id": 26, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 27, "arabic": "أَكْفُرُ", "translit": "ُrُfْkَaʾ", "root": "كفر"}, {"id": 28, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 29, "arabic": "شَكَرَ", "translit": "َrَkَhs", "root": "شكر"}, {"id": 30, "arabic": "فَإِنَّمَا", "translit": "āَmَّnِiʾَf", "root": ""}, {"id": 31, "arabic": "يَشْكُرُ", "translit": "ُrُkْhsَy", "root": "شكر"}, {"id": 32, "arabic": "لِنَفْسِهِۦ", "translit": "ۦِhِsْfَnِl", "root": "نفس"}, {"id": 33, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 34, "arabic": "كَفَرَ", "translit": "َrَfَk", "root": "كفر"}, {"id": 35, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 36, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 37, "arabic": "غَنِىٌّ", "translit": "ٌّàِnَغ", "root": "غني"}, {"id": 38, "arabic": "كَرِيمٌ", "translit": "ٌmyِrَk", "root": "كرم"}], "hasIhya": true}, {"ayah": 41, "text": "قَالَ نَكِّرُوا۟ لَهَا عَرْشَهَا نَنظُرْ أَتَهْتَدِىٓ أَمْ تَكُونُ مِنَ ٱلَّذِينَ لَا يَهْتَدُونَ ", "translation": "He said, \"Disguise for her her throne; we will see whether she will be guided [to truth] or will be of those who is not guided.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "نَكِّرُوا۟", "translit": "۟āwُrِّkَn", "root": "نكر"}, {"id": 3, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 4, "arabic": "عَرْشَهَا", "translit": "āَhَhsْrَʿع", "root": "عرش"}, {"id": 5, "arabic": "نَنظُرْ", "translit": "ْrُẓnَn", "root": "نظر"}, {"id": 6, "arabic": "أَتَهْتَدِىٓ", "translit": "ٓàِdَtْhَtَaʾ", "root": "هدي"}, {"id": 7, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 8, "arabic": "تَكُونُ", "translit": "ُnwُkَt", "root": "كون"}, {"id": 9, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 10, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "يَهْتَدُونَ", "translit": "َnwُdَtْhَy", "root": "هدي"}], "hasIhya": false}, {"ayah": 42, "text": "فَلَمَّا جَآءَتْ قِيلَ أَهَٰكَذَا عَرْشُكِۖ قَالَتْ كَأَنَّهُۥ هُوَۚ وَأُوتِينَا ٱلْعِلْمَ مِن قَبْلِهَا وَكُنَّا مُسْلِمِينَ ", "translation": "So when she arrived, it was said [to her], \"Is your throne like this?\" She said, \"[It is] as though it was it.\" [Solomon said], \"And we were given knowledge before her, and we have been Muslims [in submission to Allāh].", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "جَآءَتْ", "translit": "ْtَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 4, "arabic": "أَهَٰكَذَا", "translit": "āَhdَkَٰhَaʾ", "root": ""}, {"id": 5, "arabic": "عَرْشُكِ", "translit": "ِkُhsْrَʿع", "root": "عرش"}, {"id": 6, "arabic": "قَالَتْ", "translit": "ْtَlāَq", "root": "قول"}, {"id": 7, "arabic": "كَأَنَّهُۥ", "translit": "ۥُhَّnَaʾَk", "root": ""}, {"id": 8, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 9, "arabic": "وَأُوتِينَا", "translit": "āَnyِtwُaʾَw", "root": "اتي"}, {"id": 10, "arabic": "ٱلْعِلْمَ", "translit": "َmْlِʿعْlٱ", "root": "علم"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "قَبْلِهَا", "translit": "āَhِlْbَq", "root": "قبل"}, {"id": 13, "arabic": "وَكُنَّا", "translit": "āَّnُkَw", "root": "كون"}, {"id": 14, "arabic": "مُسْلِمِينَ", "translit": "َnyِmِlْsُm", "root": "سلم"}], "hasIhya": false}, {"ayah": 43, "text": "وَصَدَّهَا مَا كَانَت تَّعْبُدُ مِن دُونِ ٱللَّهِۖ إِنَّهَا كَانَتْ مِن قَوْمٍ كَٰفِرِينَ ", "translation": "And that which she was worshipping other than Allāh had averted her [from submission to Him]. Indeed, she was from a disbelieving people.\"", "words": [{"id": 1, "arabic": "وَصَدَّهَا", "translit": "āَhَّdَṣَw", "root": "صدد"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "كَانَت", "translit": "tَnāَk", "root": "كون"}, {"id": 4, "arabic": "تَّعْبُدُ", "translit": "ُdُbْʿعَّt", "root": "عبد"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "إِنَّهَا", "translit": "āَhَّnِiʾ", "root": ""}, {"id": 9, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "قَوْمٍ", "translit": "ٍmْwَq", "root": "قوم"}, {"id": 12, "arabic": "كَٰفِرِينَ", "translit": "َnyِrِfَٰk", "root": "كفر"}], "hasIhya": false}, {"ayah": 44, "text": "قِيلَ لَهَا ٱدْخُلِى ٱلصَّرْحَۖ فَلَمَّا رَأَتْهُ حَسِبَتْهُ لُجَّةً وَكَشَفَتْ عَن سَاقَيْهَاۚ قَالَ إِنَّهُۥ صَرْحٌ مُّمَرَّدٌ مِّن قَوَارِيرَۗ قَالَتْ رَبِّ إِنِّى ظَلَمْتُ نَفْسِى وَأَسْلَمْتُ مَعَ سُلَيْمَٰنَ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ ", "translation": "She was told, \"Enter the palace.\" But when she saw it, she thought it was a body of water[1] and uncovered her shins [to wade through]. He said, \"Indeed, it is a palace [whose floor is] made smooth with glass.\" She said, \"My Lord, indeed I have wronged myself, and I submit with Solomon to Allāh, Lord of the worlds.\"", "words": [{"id": 1, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 2, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 3, "arabic": "ٱدْخُلِى", "translit": "àِlُhkْdٱ", "root": "دخل"}, {"id": 4, "arabic": "ٱلصَّرْحَ", "translit": "َḥْrَّṣlٱ", "root": "صرح"}, {"id": 5, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 6, "arabic": "رَأَتْهُ", "translit": "ُhْtَaʾَr", "root": "راي"}, {"id": 7, "arabic": "حَسِبَتْهُ", "translit": "ُhْtَbِsَḥ", "root": "حسب"}, {"id": 8, "arabic": "لُجَّةً", "translit": "ًẗَّjgُl", "root": "لجج"}, {"id": 9, "arabic": "وَكَشَفَتْ", "translit": "ْtَfَhsَkَw", "root": "كشف"}, {"id": 10, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 11, "arabic": "سَاقَيْهَا", "translit": "āَhْyَqāَs", "root": "سوق"}, {"id": 12, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 13, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 14, "arabic": "صَرْحٌ", "translit": "ٌḥْrَṣ", "root": "صرح"}, {"id": 15, "arabic": "مُّمَرَّدٌ", "translit": "ٌdَّrَmُّm", "root": "مرد"}, {"id": 16, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 17, "arabic": "قَوَارِيرَ", "translit": "َryِrāَwَq", "root": "قرر"}, {"id": 18, "arabic": "قَالَتْ", "translit": "ْtَlāَq", "root": "قول"}, {"id": 19, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 20, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 21, "arabic": "ظَلَمْتُ", "translit": "ُtْmَlَẓ", "root": "ظلم"}, {"id": 22, "arabic": "نَفْسِى", "translit": "àِsْfَn", "root": "نفس"}, {"id": 23, "arabic": "وَأَسْلَمْتُ", "translit": "ُtْmَlْsَaʾَw", "root": "سلم"}, {"id": 24, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 25, "arabic": "سُلَيْمَٰنَ", "translit": "َnَٰmْyَlُs", "root": ""}, {"id": 26, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 27, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 28, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 45, "text": "وَلَقَدْ أَرْسَلْنَآ إِلَىٰ ثَمُودَ أَخَاهُمْ صَٰلِحًا أَنِ ٱعْبُدُوا۟ ٱللَّهَ فَإِذَا هُمْ فَرِيقَانِ يَخْتَصِمُونَ ", "translation": "And We had certainly sent to Thamūd their brother Ṣāliḥ, [saying], \"Worship Allāh,\" and at once they were two parties conflicting.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَآ", "translit": "ٓāَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 4, "arabic": "ثَمُودَ", "translit": "َdwُmَht", "root": ""}, {"id": 5, "arabic": "أَخَاهُمْ", "translit": "ْmُhāَhkَaʾ", "root": "اخو"}, {"id": 6, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 7, "arabic": "أَنِ", "translit": "ِnَaʾ", "root": ""}, {"id": 8, "arabic": "ٱعْبُدُوا۟", "translit": "۟āwُdُbْʿعٱ", "root": "عبد"}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 11, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 12, "arabic": "فَرِيقَانِ", "translit": "ِnāَqyِrَf", "root": "فرق"}, {"id": 13, "arabic": "يَخْتَصِمُونَ", "translit": "َnwُmِṣَtْhkَy", "root": "خصم"}], "hasIhya": false}, {"ayah": 46, "text": "قَالَ يَٰقَوْمِ لِمَ تَسْتَعْجِلُونَ بِٱلسَّيِّئَةِ قَبْلَ ٱلْحَسَنَةِۖ لَوْلَا تَسْتَغْفِرُونَ ٱللَّهَ لَعَلَّكُمْ تُرْحَمُونَ ", "translation": "He said, \"O my people, why are you impatient for evil before [i.e., instead of] good?[1] Why do you not seek forgiveness of Allāh that you may receive mercy?\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 3, "arabic": "لِمَ", "translit": "َmِl", "root": ""}, {"id": 4, "arabic": "تَسْتَعْجِلُونَ", "translit": "َnwُlِjgْʿعَtْsَt", "root": "عجل"}, {"id": 5, "arabic": "بِٱلسَّيِّئَةِ", "translit": "ِẗَyʾِّyَّslٱِb", "root": "سوا"}, {"id": 6, "arabic": "قَبْلَ", "translit": "َlْbَq", "root": "قبل"}, {"id": 7, "arabic": "ٱلْحَسَنَةِ", "translit": "ِẗَnَsَḥْlٱ", "root": "حسن"}, {"id": 8, "arabic": "لَوْلَا", "translit": "āَlْwَl", "root": ""}, {"id": 9, "arabic": "تَسْتَغْفِرُونَ", "translit": "َnwُrِfْغَtْsَt", "root": "غفر"}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 12, "arabic": "تُرْحَمُونَ", "translit": "َnwُmَḥْrُt", "root": "رحم"}], "hasIhya": false}, {"ayah": 47, "text": "قَالُوا۟ ٱطَّيَّرْنَا بِكَ وَبِمَن مَّعَكَۚ قَالَ طَٰٓئِرُكُمْ عِندَ ٱللَّهِۖ بَلْ أَنتُمْ قَوْمٌ تُفْتَنُونَ ", "translation": "They said, \"We consider you a bad omen, you and those with you.\" He said, \"Your omen [i.e., fate] is with Allāh. Rather, you are a people being tested.\"[1]", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱطَّيَّرْنَا", "translit": "āَnْrَّyَّṭٱ", "root": "طير"}, {"id": 3, "arabic": "بِكَ", "translit": "َkِb", "root": ""}, {"id": 4, "arabic": "وَبِمَن", "translit": "nَmِbَw", "root": ""}, {"id": 5, "arabic": "مَّعَكَ", "translit": "َkَʿعَّm", "root": ""}, {"id": 6, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 7, "arabic": "طَٰٓئِرُكُمْ", "translit": "ْmُkُrِyʾَٰٓṭ", "root": "طير"}, {"id": 8, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 11, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 12, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 13, "arabic": "تُفْتَنُونَ", "translit": "َnwُnَtْfُt", "root": "فتن"}], "hasIhya": false}, {"ayah": 48, "text": "وَكَانَ فِى ٱلْمَدِينَةِ تِسْعَةُ رَهْطٍ يُفْسِدُونَ فِى ٱلْأَرْضِ وَلَا يُصْلِحُونَ ", "translation": "And there were in the city nine family heads causing corruption in the land and not amending [its affairs].", "words": [{"id": 1, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ٱلْمَدِينَةِ", "translit": "ِẗَnyِdَmْlٱ", "root": "مدن"}, {"id": 4, "arabic": "تِسْعَةُ", "translit": "ُẗَʿعْsِt", "root": "تسع"}, {"id": 5, "arabic": "رَهْطٍ", "translit": "ٍṭْhَr", "root": "رهط"}, {"id": 6, "arabic": "يُفْسِدُونَ", "translit": "َnwُdِsْfُy", "root": "فسد"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "يُصْلِحُونَ", "translit": "َnwُḥِlْṣُy", "root": "صلح"}], "hasIhya": false}, {"ayah": 49, "text": "قَالُوا۟ تَقَاسَمُوا۟ بِٱللَّهِ لَنُبَيِّتَنَّهُۥ وَأَهْلَهُۥ ثُمَّ لَنَقُولَنَّ لِوَلِيِّهِۦ مَا شَهِدْنَا مَهْلِكَ أَهْلِهِۦ وَإِنَّا لَصَٰدِقُونَ ", "translation": "They said, \"Take a mutual oath by Allāh that we will kill him by night, he and his family. Then we will say to his executor,[1] 'We did not witness the destruction of his family, and indeed, we are truthful.'\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "تَقَاسَمُوا۟", "translit": "۟āwُmَsāَqَt", "root": "قسم"}, {"id": 3, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 4, "arabic": "لَنُبَيِّتَنَّهُۥ", "translit": "ۥُhَّnَtِّyَbُnَl", "root": "بيت"}, {"id": 5, "arabic": "وَأَهْلَهُۥ", "translit": "ۥُhَlْhَaʾَw", "root": "اهل"}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "لَنَقُولَنَّ", "translit": "َّnَlwُqَnَl", "root": "قول"}, {"id": 8, "arabic": "لِوَلِيِّهِۦ", "translit": "ۦِhِّyِlَwِl", "root": "ولي"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "شَهِدْنَا", "translit": "āَnْdِhَhs", "root": "شهد"}, {"id": 11, "arabic": "مَهْلِكَ", "translit": "َkِlْhَm", "root": "هلك"}, {"id": 12, "arabic": "أَهْلِهِۦ", "translit": "ۦِhِlْhَaʾ", "root": "اهل"}, {"id": 13, "arabic": "وَإِنَّا", "translit": "āَّnِiʾَw", "root": ""}, {"id": 14, "arabic": "لَصَٰدِقُونَ", "translit": "َnwُqِdَٰṣَl", "root": "صدق"}], "hasIhya": false}, {"ayah": 50, "text": "وَمَكَرُوا۟ مَكْرًا وَمَكَرْنَا مَكْرًا وَهُمْ لَا يَشْعُرُونَ ", "translation": "And they planned a plan, and We planned a plan, while they perceived not.", "words": [{"id": 1, "arabic": "وَمَكَرُوا۟", "translit": "۟āwُrَkَmَw", "root": "مكر"}, {"id": 2, "arabic": "مَكْرًا", "translit": "āًrْkَm", "root": "مكر"}, {"id": 3, "arabic": "وَمَكَرْنَا", "translit": "āَnْrَkَmَw", "root": "مكر"}, {"id": 4, "arabic": "مَكْرًا", "translit": "āًrْkَm", "root": "مكر"}, {"id": 5, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يَشْعُرُونَ", "translit": "َnwُrُʿعْhsَy", "root": "شعر"}], "hasIhya": true}, {"ayah": 51, "text": "فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ مَكْرِهِمْ أَنَّا دَمَّرْنَٰهُمْ وَقَوْمَهُمْ أَجْمَعِينَ ", "translation": "Then look how was the outcome of their plan - that We destroyed them and their people, all.", "words": [{"id": 1, "arabic": "فَٱنظُرْ", "translit": "ْrُẓnٱَf", "root": "نظر"}, {"id": 2, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 3, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 4, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 5, "arabic": "مَكْرِهِمْ", "translit": "ْmِhِrْkَm", "root": "مكر"}, {"id": 6, "arabic": "أَنَّا", "translit": "āَّnَaʾ", "root": ""}, {"id": 7, "arabic": "دَمَّرْنَٰهُمْ", "translit": "ْmُhَٰnْrَّmَd", "root": "دمر"}, {"id": 8, "arabic": "وَقَوْمَهُمْ", "translit": "ْmُhَmْwَqَw", "root": "قوم"}, {"id": 9, "arabic": "أَجْمَعِينَ", "translit": "َnyِʿعَmْjgَaʾ", "root": "جمع"}], "hasIhya": false}, {"ayah": 52, "text": "فَتِلْكَ بُيُوتُهُمْ خَاوِيَةًۢ بِمَا ظَلَمُوٓا۟ۗ إِنَّ فِى ذَٰلِكَ لَءَايَةً لِّقَوْمٍ يَعْلَمُونَ ", "translation": "So those are their houses, desolate because of the wrong they had done. Indeed in that is a sign for people who know.", "words": [{"id": 1, "arabic": "فَتِلْكَ", "translit": "َkْlِtَf", "root": ""}, {"id": 2, "arabic": "بُيُوتُهُمْ", "translit": "ْmُhُtwُyُb", "root": "بيت"}, {"id": 3, "arabic": "خَاوِيَةًۢ", "translit": "ًۢẗَyِwāَhk", "root": "خوي"}, {"id": 4, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 5, "arabic": "ظَلَمُوٓا۟", "translit": "۟āٓwُmَlَẓ", "root": "ظلم"}, {"id": 6, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 9, "arabic": "لَءَايَةً", "translit": "ًẗَyāَءَl", "root": "ايي"}, {"id": 10, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 11, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 53, "text": "وَأَنجَيْنَا ٱلَّذِينَ ءَامَنُوا۟ وَكَانُوا۟ يَتَّقُونَ ", "translation": "And We saved those who believed and used to fear Allāh.", "words": [{"id": 1, "arabic": "وَأَنجَيْنَا", "translit": "āَnْyَjgnَaʾَw", "root": "نجو"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 5, "arabic": "يَتَّقُونَ", "translit": "َnwُqَّtَy", "root": "وقي"}], "hasIhya": false}, {"ayah": 54, "text": "وَلُوطًا إِذْ قَالَ لِقَوْمِهِۦٓ أَتَأْتُونَ ٱلْفَٰحِشَةَ وَأَنتُمْ تُبْصِرُونَ ", "translation": "And [mention] Lot, when he said to his people, \"Do you commit immorality[1] while you are seeing?[2]", "words": [{"id": 1, "arabic": "وَلُوطًا", "translit": "āًṭwُlَw", "root": ""}, {"id": 2, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 3, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 4, "arabic": "لِقَوْمِهِۦٓ", "translit": "ٓۦِhِmْwَqِl", "root": "قوم"}, {"id": 5, "arabic": "أَتَأْتُونَ", "translit": "َnwُtْaʾَtَaʾ", "root": "اتي"}, {"id": 6, "arabic": "ٱلْفَٰحِشَةَ", "translit": "َẗَhsِḥَٰfْlٱ", "root": "فحش"}, {"id": 7, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 8, "arabic": "تُبْصِرُونَ", "translit": "َnwُrِṣْbُt", "root": "بصر"}], "hasIhya": false}, {"ayah": 55, "text": "أَئِنَّكُمْ لَتَأْتُونَ ٱلرِّجَالَ شَهْوَةً مِّن دُونِ ٱلنِّسَآءِۚ بَلْ أَنتُمْ قَوْمٌ تَجْهَلُونَ ", "translation": "Do you indeed approach men with desire instead of women? Rather, you are a people behaving ignorantly.\"", "words": [{"id": 1, "arabic": "أَئِنَّكُمْ", "translit": "ْmُkَّnِyʾَaʾ", "root": ""}, {"id": 2, "arabic": "لَتَأْتُونَ", "translit": "َnwُtْaʾَtَl", "root": "اتي"}, {"id": 3, "arabic": "ٱلرِّجَالَ", "translit": "َlāَjgِّrlٱ", "root": "رجل"}, {"id": 4, "arabic": "شَهْوَةً", "translit": "ًẗَwْhَhs", "root": "شهو"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 7, "arabic": "ٱلنِّسَآءِ", "translit": "ِءٓāَsِّnlٱ", "root": "نسو"}, {"id": 8, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 9, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 10, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 11, "arabic": "تَجْهَلُونَ", "translit": "َnwُlَhْjgَt", "root": "جهل"}], "hasIhya": false}, {"ayah": 56, "text": "فَمَا كَانَ جَوَابَ قَوْمِهِۦٓ إِلَّآ أَن قَالُوٓا۟ أَخْرِجُوٓا۟ ءَالَ لُوطٍ مِّن قَرْيَتِكُمْۖ إِنَّهُمْ أُنَاسٌ يَتَطَهَّرُونَ ", "translation": "But the answer of his people was not except that they said, \"Expel the family of Lot from your city. Indeed, they are people who keep themselves pure.\"", "words": [{"id": 1, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "جَوَابَ", "translit": "َbāَwَjg", "root": "جوب"}, {"id": 4, "arabic": "قَوْمِهِۦٓ", "translit": "ٓۦِhِmْwَq", "root": "قوم"}, {"id": 5, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 8, "arabic": "أَخْرِجُوٓا۟", "translit": "۟āٓwُjgِrْhkَaʾ", "root": "خرج"}, {"id": 9, "arabic": "ءَالَ", "translit": "َlāَء", "root": "اول"}, {"id": 10, "arabic": "لُوطٍ", "translit": "ٍṭwُl", "root": ""}, {"id": 11, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 12, "arabic": "قَرْيَتِكُمْ", "translit": "ْmُkِtَyْrَq", "root": "قري"}, {"id": 13, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 14, "arabic": "أُنَاسٌ", "translit": "ٌsāَnُaʾ", "root": "انس"}, {"id": 15, "arabic": "يَتَطَهَّرُونَ", "translit": "َnwُrَّhَṭَtَy", "root": "طهر"}], "hasIhya": false}, {"ayah": 57, "text": "فَأَنجَيْنَٰهُ وَأَهْلَهُۥٓ إِلَّا ٱمْرَأَتَهُۥ قَدَّرْنَٰهَا مِنَ ٱلْغَٰبِرِينَ ", "translation": "So We saved him and his family, except for his wife; We destined her to be of those who remained behind.", "words": [{"id": 1, "arabic": "فَأَنجَيْنَٰهُ", "translit": "ُhَٰnْyَjgnَaʾَf", "root": "نجو"}, {"id": 2, "arabic": "وَأَهْلَهُۥٓ", "translit": "ٓۥُhَlْhَaʾَw", "root": "اهل"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱمْرَأَتَهُۥ", "translit": "ۥُhَtَaʾَrْmٱ", "root": "مرا"}, {"id": 5, "arabic": "قَدَّرْنَٰهَا", "translit": "āَhَٰnْrَّdَq", "root": "قدر"}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱلْغَٰبِرِينَ", "translit": "َnyِrِbَٰغْlٱ", "root": "غبر"}], "hasIhya": false}, {"ayah": 58, "text": "وَأَمْطَرْنَا عَلَيْهِم مَّطَرًاۖ فَسَآءَ مَطَرُ ٱلْمُنذَرِينَ ", "translation": "And We rained upon them a rain [of stones], and evil was the rain of those who were warned.", "words": [{"id": 1, "arabic": "وَأَمْطَرْنَا", "translit": "āَnْrَṭْmَaʾَw", "root": "مطر"}, {"id": 2, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "مَّطَرًا", "translit": "āًrَṭَّm", "root": "مطر"}, {"id": 4, "arabic": "فَسَآءَ", "translit": "َءٓāَsَf", "root": "سوا"}, {"id": 5, "arabic": "مَطَرُ", "translit": "ُrَṭَm", "root": "مطر"}, {"id": 6, "arabic": "ٱلْمُنذَرِينَ", "translit": "َnyِrَhdnُmْlٱ", "root": "نذر"}], "hasIhya": false}, {"ayah": 59, "text": "قُلِ ٱلْحَمْدُ لِلَّهِ وَسَلَٰمٌ عَلَىٰ عِبَادِهِ ٱلَّذِينَ ٱصْطَفَىٰٓۗ ءَآللَّهُ خَيْرٌ أَمَّا يُشْرِكُونَ ", "translation": "Say, [O Muḥammad], \"Praise be to Allāh, and peace upon His servants whom He has chosen. Is Allāh better or what they associate with Him?\"", "words": [{"id": 1, "arabic": "قُلِ", "translit": "ِlُq", "root": "قول"}, {"id": 2, "arabic": "ٱلْحَمْدُ", "translit": "ُdْmَḥْlٱ", "root": "حمد"}, {"id": 3, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 4, "arabic": "وَسَلَٰمٌ", "translit": "ٌmَٰlَsَw", "root": "سلم"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "عِبَادِهِ", "translit": "ِhِdāَbِʿع", "root": "عبد"}, {"id": 7, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "ٱصْطَفَىٰٓ", "translit": "ٰٓàَfَṭْṣٱ", "root": "صفو"}, {"id": 9, "arabic": "ءَآللَّهُ", "translit": "ُhَّllٓāَء", "root": "اله"}, {"id": 10, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 11, "arabic": "أَمَّا", "translit": "āَّmَaʾ", "root": ""}, {"id": 12, "arabic": "يُشْرِكُونَ", "translit": "َnwُkِrْhsُy", "root": "شرك"}], "hasIhya": true}, {"ayah": 60, "text": "أَمَّنْ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَأَنزَلَ لَكُم مِّنَ ٱلسَّمَآءِ مَآءً فَأَنۢبَتْنَا بِهِۦ حَدَآئِقَ ذَاتَ بَهْجَةٍ مَّا كَانَ لَكُمْ أَن تُنۢبِتُوا۟ شَجَرَهَآۗ أَءِلَٰهٌ مَّعَ ٱللَّهِۚ بَلْ هُمْ قَوْمٌ يَعْدِلُونَ ", "translation": "[More precisely], is He [not best] who created the heavens and the earth and sent down for you rain from the sky, causing to grow thereby gardens of joyful beauty which you could not [otherwise] have grown the trees thereof? Is there a deity with Allāh?[1] [No], but they are a people who ascribe equals [to Him].", "words": [{"id": 1, "arabic": "أَمَّنْ", "translit": "ْnَّmَaʾ", "root": ""}, {"id": 2, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "وَأَنزَلَ", "translit": "َlَznَaʾَw", "root": "نزل"}, {"id": 6, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 9, "arabic": "مَآءً", "translit": "ًءٓāَm", "root": "موه"}, {"id": 10, "arabic": "فَأَنۢبَتْنَا", "translit": "āَnْtَbۢnَaʾَf", "root": "نبت"}, {"id": 11, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 12, "arabic": "حَدَآئِقَ", "translit": "َqِyʾٓāَdَḥ", "root": "حدق"}, {"id": 13, "arabic": "ذَاتَ", "translit": "َtāَhd", "root": ""}, {"id": 14, "arabic": "بَهْجَةٍ", "translit": "ٍẗَjgْhَb", "root": "بهج"}, {"id": 15, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 16, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 17, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 18, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 19, "arabic": "تُنۢبِتُوا۟", "translit": "۟āwُtِbۢnُt", "root": "نبت"}, {"id": 20, "arabic": "شَجَرَهَآ", "translit": "ٓāَhَrَjgَhs", "root": "شجر"}, {"id": 21, "arabic": "أَءِلَٰهٌ", "translit": "ٌhَٰlِءَaʾ", "root": "اله"}, {"id": 22, "arabic": "مَّعَ", "translit": "َʿعَّm", "root": ""}, {"id": 23, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 25, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 26, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 27, "arabic": "يَعْدِلُونَ", "translit": "َnwُlِdْʿعَy", "root": "عدل"}], "hasIhya": false}, {"ayah": 61, "text": "أَمَّن جَعَلَ ٱلْأَرْضَ قَرَارًا وَجَعَلَ خِلَٰلَهَآ أَنْهَٰرًا وَجَعَلَ لَهَا رَوَٰسِىَ وَجَعَلَ بَيْنَ ٱلْبَحْرَيْنِ حَاجِزًاۗ أَءِلَٰهٌ مَّعَ ٱللَّهِۚ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ ", "translation": "Is He [not best] who made the earth a stable ground and placed within it rivers and made for it firmly set mountains and placed between the two seas a barrier? Is there a deity with Allāh? [No], but most of them do not know.", "words": [{"id": 1, "arabic": "أَمَّن", "translit": "nَّmَaʾ", "root": ""}, {"id": 2, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 4, "arabic": "قَرَارًا", "translit": "āًrāَrَq", "root": "قرر"}, {"id": 5, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 6, "arabic": "خِلَٰلَهَآ", "translit": "ٓāَhَlَٰlِhk", "root": "خلل"}, {"id": 7, "arabic": "أَنْهَٰرًا", "translit": "āًrَٰhْnَaʾ", "root": "نهر"}, {"id": 8, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 9, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 10, "arabic": "رَوَٰسِىَ", "translit": "َàِsَٰwَr", "root": "رسو"}, {"id": 11, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 12, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 13, "arabic": "ٱلْبَحْرَيْنِ", "translit": "ِnْyَrْḥَbْlٱ", "root": "بحر"}, {"id": 14, "arabic": "حَاجِزًا", "translit": "āًzِjgāَḥ", "root": "حجز"}, {"id": 15, "arabic": "أَءِلَٰهٌ", "translit": "ٌhَٰlِءَaʾ", "root": "اله"}, {"id": 16, "arabic": "مَّعَ", "translit": "َʿعَّm", "root": ""}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 19, "arabic": "أَكْثَرُهُمْ", "translit": "ْmُhُrَhtْkَaʾ", "root": "كثر"}, {"id": 20, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 21, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 62, "text": "أَمَّن يُجِيبُ ٱلْمُضْطَرَّ إِذَا دَعَاهُ وَيَكْشِفُ ٱلسُّوٓءَ وَيَجْعَلُكُمْ خُلَفَآءَ ٱلْأَرْضِۗ أَءِلَٰهٌ مَّعَ ٱللَّهِۚ قَلِيلًا مَّا تَذَكَّرُونَ ", "translation": "Is He [not best] who responds to the desperate one when he calls upon Him and removes evil and makes you inheritors of the earth?[1] Is there a deity with Allāh? Little do you remember.", "words": [{"id": 1, "arabic": "أَمَّن", "translit": "nَّmَaʾ", "root": ""}, {"id": 2, "arabic": "يُجِيبُ", "translit": "ُbyِjgُy", "root": "جوب"}, {"id": 3, "arabic": "ٱلْمُضْطَرَّ", "translit": "َّrَṭْḍُmْlٱ", "root": "ضرر"}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "دَعَاهُ", "translit": "ُhāَʿعَd", "root": "دعو"}, {"id": 6, "arabic": "وَيَكْشِفُ", "translit": "ُfِhsْkَyَw", "root": "كشف"}, {"id": 7, "arabic": "ٱلسُّوٓءَ", "translit": "َءٓwُّslٱ", "root": "سوا"}, {"id": 8, "arabic": "وَيَجْعَلُكُمْ", "translit": "ْmُkُlَʿعْjgَyَw", "root": "جعل"}, {"id": 9, "arabic": "خُلَفَآءَ", "translit": "َءٓāَfَlُhk", "root": "خلف"}, {"id": 10, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 11, "arabic": "أَءِلَٰهٌ", "translit": "ٌhَٰlِءَaʾ", "root": "اله"}, {"id": 12, "arabic": "مَّعَ", "translit": "َʿعَّm", "root": ""}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 15, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 16, "arabic": "تَذَكَّرُونَ", "translit": "َnwُrَّkَhdَt", "root": "ذكر"}], "hasIhya": false}, {"ayah": 63, "text": "أَمَّن يَهْدِيكُمْ فِى ظُلُمَٰتِ ٱلْبَرِّ وَٱلْبَحْرِ وَمَن يُرْسِلُ ٱلرِّيَٰحَ بُشْرًۢا بَيْنَ يَدَىْ رَحْمَتِهِۦٓۗ أَءِلَٰهٌ مَّعَ ٱللَّهِۚ تَعَٰلَى ٱللَّهُ عَمَّا يُشْرِكُونَ ", "translation": "Is He [not best] who guides you through the darknesses of the land and sea and who sends the winds as good tidings before His mercy? Is there a deity with Allāh? High is Allāh above whatever they associate with Him.", "words": [{"id": 1, "arabic": "أَمَّن", "translit": "nَّmَaʾ", "root": ""}, {"id": 2, "arabic": "يَهْدِيكُمْ", "translit": "ْmُkyِdْhَy", "root": "هدي"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ظُلُمَٰتِ", "translit": "ِtَٰmُlُẓ", "root": "ظلم"}, {"id": 5, "arabic": "ٱلْبَرِّ", "translit": "ِّrَbْlٱ", "root": "برر"}, {"id": 6, "arabic": "وَٱلْبَحْرِ", "translit": "ِrْḥَbْlٱَw", "root": "بحر"}, {"id": 7, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 8, "arabic": "يُرْسِلُ", "translit": "ُlِsْrُy", "root": "رسل"}, {"id": 9, "arabic": "ٱلرِّيَٰحَ", "translit": "َḥَٰyِّrlٱ", "root": "روح"}, {"id": 10, "arabic": "بُشْرًۢا", "translit": "āًۢrْhsُb", "root": "بشر"}, {"id": 11, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 12, "arabic": "يَدَىْ", "translit": "ْàَdَy", "root": "يدي"}, {"id": 13, "arabic": "رَحْمَتِهِۦٓ", "translit": "ٓۦِhِtَmْḥَr", "root": "رحم"}, {"id": 14, "arabic": "أَءِلَٰهٌ", "translit": "ٌhَٰlِءَaʾ", "root": "اله"}, {"id": 15, "arabic": "مَّعَ", "translit": "َʿعَّm", "root": ""}, {"id": 16, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "تَعَٰلَى", "translit": "àَlَٰʿعَt", "root": "علو"}, {"id": 18, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 20, "arabic": "يُشْرِكُونَ", "translit": "َnwُkِrْhsُy", "root": "شرك"}], "hasIhya": false}, {"ayah": 64, "text": "أَمَّن يَبْدَؤُا۟ ٱلْخَلْقَ ثُمَّ يُعِيدُهُۥ وَمَن يَرْزُقُكُم مِّنَ ٱلسَّمَآءِ وَٱلْأَرْضِۗ أَءِلَٰهٌ مَّعَ ٱللَّهِۚ قُلْ هَاتُوا۟ بُرْهَٰنَكُمْ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "Is He [not best] who begins creation and then repeats it and who provides for you from the heaven and earth? Is there a deity with Allāh? Say, \"Produce your proof, if you should be truthful.\"", "words": [{"id": 1, "arabic": "أَمَّن", "translit": "nَّmَaʾ", "root": ""}, {"id": 2, "arabic": "يَبْدَؤُا۟", "translit": "۟āُwʾَdْbَy", "root": "بدا"}, {"id": 3, "arabic": "ٱلْخَلْقَ", "translit": "َqْlَhkْlٱ", "root": "خلق"}, {"id": 4, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 5, "arabic": "يُعِيدُهُۥ", "translit": "ۥُhُdyِʿعُy", "root": "عود"}, {"id": 6, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 7, "arabic": "يَرْزُقُكُم", "translit": "mُkُqُzْrَy", "root": "رزق"}, {"id": 8, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 9, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 10, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 11, "arabic": "أَءِلَٰهٌ", "translit": "ٌhَٰlِءَaʾ", "root": "اله"}, {"id": 12, "arabic": "مَّعَ", "translit": "َʿعَّm", "root": ""}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 15, "arabic": "هَاتُوا۟", "translit": "۟āwُtāَh", "root": "هات"}, {"id": 16, "arabic": "بُرْهَٰنَكُمْ", "translit": "ْmُkَnَٰhْrُb", "root": "برهن"}, {"id": 17, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 18, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 19, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": false}, {"ayah": 65, "text": "قُل لَّا يَعْلَمُ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ٱلْغَيْبَ إِلَّا ٱللَّهُۚ وَمَا يَشْعُرُونَ أَيَّانَ يُبْعَثُونَ ", "translation": "Say, \"None in the heavens and earth knows the unseen except Allāh, and they do not perceive when they will be resurrected.\"", "words": [{"id": 1, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 2, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 3, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 4, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 7, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 8, "arabic": "ٱلْغَيْبَ", "translit": "َbْyَغْlٱ", "root": "غيب"}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 12, "arabic": "يَشْعُرُونَ", "translit": "َnwُrُʿعْhsَy", "root": "شعر"}, {"id": 13, "arabic": "أَيَّانَ", "translit": "َnāَّyَaʾ", "root": ""}, {"id": 14, "arabic": "يُبْعَثُونَ", "translit": "َnwُhtَʿعْbُy", "root": "بعث"}], "hasIhya": false}, {"ayah": 66, "text": "بَلِ ٱدَّٰرَكَ عِلْمُهُمْ فِى ٱلْءَاخِرَةِۚ بَلْ هُمْ فِى شَكٍّ مِّنْهَاۖ بَلْ هُم مِّنْهَا عَمُونَ ", "translation": "Rather, their knowledge is arrested concerning the Hereafter. Rather, they are in doubt about it. Rather, they are, concerning it, blind.", "words": [{"id": 1, "arabic": "بَلِ", "translit": "ِlَb", "root": ""}, {"id": 2, "arabic": "ٱدَّٰرَكَ", "translit": "َkَrَّٰdٱ", "root": "درك"}, {"id": 3, "arabic": "عِلْمُهُمْ", "translit": "ْmُhُmْlِʿع", "root": "علم"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 6, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 7, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "شَكٍّ", "translit": "ٍّkَhs", "root": "شكك"}, {"id": 10, "arabic": "مِّنْهَا", "translit": "āَhْnِّm", "root": ""}, {"id": 11, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 12, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 13, "arabic": "مِّنْهَا", "translit": "āَhْnِّm", "root": ""}, {"id": 14, "arabic": "عَمُونَ", "translit": "َnwُmَʿع", "root": "عمي"}], "hasIhya": false}, {"ayah": 67, "text": "وَقَالَ ٱلَّذِينَ كَفَرُوٓا۟ أَءِذَا كُنَّا تُرَٰبًا وَءَابَآؤُنَآ أَئِنَّا لَمُخْرَجُونَ ", "translation": "And those who disbelieve say, \"When we have become dust as well as our forefathers, will we indeed be brought out [of the graves]?", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "أَءِذَا", "translit": "āَhdِءَaʾ", "root": ""}, {"id": 5, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 6, "arabic": "تُرَٰبًا", "translit": "āًbَٰrُt", "root": "ترب"}, {"id": 7, "arabic": "وَءَابَآؤُنَآ", "translit": "ٓāَnُwʾٓāَbāَءَw", "root": "ابو"}, {"id": 8, "arabic": "أَئِنَّا", "translit": "āَّnِyʾَaʾ", "root": ""}, {"id": 9, "arabic": "لَمُخْرَجُونَ", "translit": "َnwُjgَrْhkُmَl", "root": "خرج"}], "hasIhya": false}, {"ayah": 68, "text": "لَقَدْ وُعِدْنَا هَٰذَا نَحْنُ وَءَابَآؤُنَا مِن قَبْلُ إِنْ هَٰذَآ إِلَّآ أَسَٰطِيرُ ٱلْأَوَّلِينَ ", "translation": "We have been promised this, we and our forefathers, before. This is not but legends of the former peoples.\"", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 2, "arabic": "وُعِدْنَا", "translit": "āَnْdِʿعُw", "root": "وعد"}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 5, "arabic": "وَءَابَآؤُنَا", "translit": "āَnُwʾٓāَbāَءَw", "root": "ابو"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 8, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 9, "arabic": "هَٰذَآ", "translit": "ٓāَhdَٰh", "root": ""}, {"id": 10, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 11, "arabic": "أَسَٰطِيرُ", "translit": "ُryِṭَٰsَaʾ", "root": "سطر"}, {"id": 12, "arabic": "ٱلْأَوَّلِينَ", "translit": "َnyِlَّwَaʾْlٱ", "root": "اول"}], "hasIhya": false}, {"ayah": 69, "text": "قُلْ سِيرُوا۟ فِى ٱلْأَرْضِ فَٱنظُرُوا۟ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُجْرِمِينَ ", "translation": "Say, [O Muḥammad], \"Proceed [i.e., travel] through the land and observe how was the end of the criminals.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "سِيرُوا۟", "translit": "۟āwُryِs", "root": "سير"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 5, "arabic": "فَٱنظُرُوا۟", "translit": "۟āwُrُẓnٱَf", "root": "نظر"}, {"id": 6, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 7, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 8, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 9, "arabic": "ٱلْمُجْرِمِينَ", "translit": "َnyِmِrْjgُmْlٱ", "root": "جرم"}], "hasIhya": false}, {"ayah": 70, "text": "وَلَا تَحْزَنْ عَلَيْهِمْ وَلَا تَكُن فِى ضَيْقٍ مِّمَّا يَمْكُرُونَ ", "translation": "And grieve not over them or be in distress from what they conspire.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَحْزَنْ", "translit": "ْnَzْḥَt", "root": "حزن"}, {"id": 3, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 5, "arabic": "تَكُن", "translit": "nُkَt", "root": "كون"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ضَيْقٍ", "translit": "ٍqْyَḍ", "root": "ضيق"}, {"id": 8, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 9, "arabic": "يَمْكُرُونَ", "translit": "َnwُrُkْmَy", "root": "مكر"}], "hasIhya": false}, {"ayah": 71, "text": "وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلْوَعْدُ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "And they say, \"When is [the fulfillment of] this promise, if you should be truthful?\"", "words": [{"id": 1, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 2, "arabic": "مَتَىٰ", "translit": "ٰàَtَm", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "ٱلْوَعْدُ", "translit": "ُdْʿعَwْlٱ", "root": "وعد"}, {"id": 5, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 6, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 7, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": true}, {"ayah": 72, "text": "قُلْ عَسَىٰٓ أَن يَكُونَ رَدِفَ لَكُم بَعْضُ ٱلَّذِى تَسْتَعْجِلُونَ ", "translation": "Say, \"Perhaps it is close behind you [i.e., very near] - some of that for which you are impatient.", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "عَسَىٰٓ", "translit": "ٰٓàَsَʿع", "root": "عسي"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "يَكُونَ", "translit": "َnwُkَy", "root": "كون"}, {"id": 5, "arabic": "رَدِفَ", "translit": "َfِdَr", "root": "ردف"}, {"id": 6, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 7, "arabic": "بَعْضُ", "translit": "ُḍْʿعَb", "root": "بعض"}, {"id": 8, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "تَسْتَعْجِلُونَ", "translit": "َnwُlِjgْʿعَtْsَt", "root": "عجل"}], "hasIhya": false}, {"ayah": 73, "text": "وَإِنَّ رَبَّكَ لَذُو فَضْلٍ عَلَى ٱلنَّاسِ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَشْكُرُونَ ", "translation": "And indeed, your Lord is the possessor of bounty for the people, but most of them are not grateful.\"", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 3, "arabic": "لَذُو", "translit": "wُhdَl", "root": ""}, {"id": 4, "arabic": "فَضْلٍ", "translit": "ٍlْḍَf", "root": "فضل"}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 7, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 8, "arabic": "أَكْثَرَهُمْ", "translit": "ْmُhَrَhtْkَaʾ", "root": "كثر"}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "يَشْكُرُونَ", "translit": "َnwُrُkْhsَy", "root": "شكر"}], "hasIhya": false}, {"ayah": 74, "text": "وَإِنَّ رَبَّكَ لَيَعْلَمُ مَا تُكِنُّ صُدُورُهُمْ وَمَا يُعْلِنُونَ ", "translation": "And indeed, your Lord knows what their breasts conceal and what they declare.", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 3, "arabic": "لَيَعْلَمُ", "translit": "ُmَlْʿعَyَl", "root": "علم"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "تُكِنُّ", "translit": "ُّnِkُt", "root": "كنن"}, {"id": 6, "arabic": "صُدُورُهُمْ", "translit": "ْmُhُrwُdُṣ", "root": "صدر"}, {"id": 7, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 8, "arabic": "يُعْلِنُونَ", "translit": "َnwُnِlْʿعُy", "root": "علن"}], "hasIhya": false}, {"ayah": 75, "text": "وَمَا مِنْ غَآئِبَةٍ فِى ٱلسَّمَآءِ وَٱلْأَرْضِ إِلَّا فِى كِتَٰبٍ مُّبِينٍ ", "translation": "And there is nothing concealed[1] within the heaven and the earth except that it is in a clear Register.[2]", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 3, "arabic": "غَآئِبَةٍ", "translit": "ٍẗَbِyʾٓāَغ", "root": "غيب"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 7, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "كِتَٰبٍ", "translit": "ٍbَٰtِk", "root": "كتب"}, {"id": 10, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 76, "text": "إِنَّ هَٰذَا ٱلْقُرْءَانَ يَقُصُّ عَلَىٰ بَنِىٓ إِسْرَٰٓءِيلَ أَكْثَرَ ٱلَّذِى هُمْ فِيهِ يَخْتَلِفُونَ ", "translation": "Indeed, this Qur’ān relates to the Children of Israel most of that over which they disagree.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 3, "arabic": "ٱلْقُرْءَانَ", "translit": "َnāَءْrُqْlٱ", "root": "قرا"}, {"id": 4, "arabic": "يَقُصُّ", "translit": "ُّṣُqَy", "root": "قصص"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 7, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 8, "arabic": "أَكْثَرَ", "translit": "َrَhtْkَaʾ", "root": "كثر"}, {"id": 9, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 11, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 12, "arabic": "يَخْتَلِفُونَ", "translit": "َnwُfِlَtْhkَy", "root": "خلف"}], "hasIhya": false}, {"ayah": 77, "text": "وَإِنَّهُۥ لَهُدًى وَرَحْمَةٌ لِّلْمُؤْمِنِينَ ", "translation": "And indeed, it is guidance and mercy for the believers.", "words": [{"id": 1, "arabic": "وَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَw", "root": ""}, {"id": 2, "arabic": "لَهُدًى", "translit": "àًdُhَl", "root": "هدي"}, {"id": 3, "arabic": "وَرَحْمَةٌ", "translit": "ٌẗَmْḥَrَw", "root": "رحم"}, {"id": 4, "arabic": "لِّلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlِّl", "root": "امن"}], "hasIhya": false}, {"ayah": 78, "text": "إِنَّ رَبَّكَ يَقْضِى بَيْنَهُم بِحُكْمِهِۦۚ وَهُوَ ٱلْعَزِيزُ ٱلْعَلِيمُ ", "translation": "Indeed, your Lord will judge between them by His [wise] judgement. And He is the Exalted in Might, the Knowing.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 3, "arabic": "يَقْضِى", "translit": "àِḍْqَy", "root": "قضي"}, {"id": 4, "arabic": "بَيْنَهُم", "translit": "mُhَnْyَb", "root": "بين"}, {"id": 5, "arabic": "بِحُكْمِهِۦ", "translit": "ۦِhِmْkُḥِb", "root": "حكم"}, {"id": 6, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 7, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 8, "arabic": "ٱلْعَلِيمُ", "translit": "ُmyِlَʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 79, "text": "فَتَوَكَّلْ عَلَى ٱللَّهِۖ إِنَّكَ عَلَى ٱلْحَقِّ ٱلْمُبِينِ ", "translation": "So rely upon Allāh; indeed, you are upon the clear truth.", "words": [{"id": 1, "arabic": "فَتَوَكَّلْ", "translit": "ْlَّkَwَtَf", "root": "وكل"}, {"id": 2, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 7, "arabic": "ٱلْمُبِينِ", "translit": "ِnyِbُmْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 80, "text": "إِنَّكَ لَا تُسْمِعُ ٱلْمَوْتَىٰ وَلَا تُسْمِعُ ٱلصُّمَّ ٱلدُّعَآءَ إِذَا وَلَّوْا۟ مُدْبِرِينَ ", "translation": "Indeed, you will not make the dead hear, nor will you make the deaf hear the call when they have turned their backs retreating.", "words": [{"id": 1, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "تُسْمِعُ", "translit": "ُʿعِmْsُt", "root": "سمع"}, {"id": 4, "arabic": "ٱلْمَوْتَىٰ", "translit": "ٰàَtْwَmْlٱ", "root": "موت"}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "تُسْمِعُ", "translit": "ُʿعِmْsُt", "root": "سمع"}, {"id": 7, "arabic": "ٱلصُّمَّ", "translit": "َّmُّṣlٱ", "root": "صمم"}, {"id": 8, "arabic": "ٱلدُّعَآءَ", "translit": "َءٓāَʿعُّdlٱ", "root": "دعو"}, {"id": 9, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 10, "arabic": "وَلَّوْا۟", "translit": "۟āْwَّlَw", "root": "ولي"}, {"id": 11, "arabic": "مُدْبِرِينَ", "translit": "َnyِrِbْdُm", "root": "دبر"}], "hasIhya": false}, {"ayah": 81, "text": "وَمَآ أَنتَ بِهَٰدِى ٱلْعُمْىِ عَن ضَلَٰلَتِهِمْۖ إِن تُسْمِعُ إِلَّا مَن يُؤْمِنُ بِـَٔايَٰتِنَا فَهُم مُّسْلِمُونَ ", "translation": "And you cannot guide the blind away from their error. You will only make hear those who believe in Our verses so they are Muslims [i.e., submitting to Allāh].", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 3, "arabic": "بِهَٰدِى", "translit": "àِdَٰhِb", "root": "هدي"}, {"id": 4, "arabic": "ٱلْعُمْىِ", "translit": "ِàْmُʿعْlٱ", "root": "عمي"}, {"id": 5, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 6, "arabic": "ضَلَٰلَتِهِمْ", "translit": "ْmِhِtَlَٰlَḍ", "root": "ضلل"}, {"id": 7, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 8, "arabic": "تُسْمِعُ", "translit": "ُʿعِmْsُt", "root": "سمع"}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 11, "arabic": "يُؤْمِنُ", "translit": "ُnِmْwʾُy", "root": "امن"}, {"id": 12, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 13, "arabic": "فَهُم", "translit": "mُhَf", "root": ""}, {"id": 14, "arabic": "مُّسْلِمُونَ", "translit": "َnwُmِlْsُّm", "root": "سلم"}], "hasIhya": false}, {"ayah": 82, "text": "وَإِذَا وَقَعَ ٱلْقَوْلُ عَلَيْهِمْ أَخْرَجْنَا لَهُمْ دَآبَّةً مِّنَ ٱلْأَرْضِ تُكَلِّمُهُمْ أَنَّ ٱلنَّاسَ كَانُوا۟ بِـَٔايَٰتِنَا لَا يُوقِنُونَ ", "translation": "And when the word [i.e., decree] befalls them,[1] We will bring forth for them a creature from the earth speaking to them, [saying] that the people were, of Our verses, not certain [in faith].", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "وَقَعَ", "translit": "َʿعَqَw", "root": "وقع"}, {"id": 3, "arabic": "ٱلْقَوْلُ", "translit": "ُlْwَqْlٱ", "root": "قول"}, {"id": 4, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 5, "arabic": "أَخْرَجْنَا", "translit": "āَnْjgَrْhkَaʾ", "root": "خرج"}, {"id": 6, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 7, "arabic": "دَآبَّةً", "translit": "ًẗَّbٓāَd", "root": "دبب"}, {"id": 8, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 9, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 10, "arabic": "تُكَلِّمُهُمْ", "translit": "ْmُhُmِّlَkُt", "root": "كلم"}, {"id": 11, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 12, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 13, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 14, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 15, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 16, "arabic": "يُوقِنُونَ", "translit": "َnwُnِqwُy", "root": "يقن"}], "hasIhya": false}, {"ayah": 83, "text": "وَيَوْمَ نَحْشُرُ مِن كُلِّ أُمَّةٍ فَوْجًا مِّمَّن يُكَذِّبُ بِـَٔايَٰتِنَا فَهُمْ يُوزَعُونَ ", "translation": "And [warn of] the Day when We will gather from every nation a company of those who deny Our signs, and they will be [driven] in rows", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "نَحْشُرُ", "translit": "ُrُhsْḥَn", "root": "حشر"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 5, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 6, "arabic": "فَوْجًا", "translit": "āًjgْwَf", "root": "فوج"}, {"id": 7, "arabic": "مِّمَّن", "translit": "nَّmِّm", "root": ""}, {"id": 8, "arabic": "يُكَذِّبُ", "translit": "ُbِّhdَkُy", "root": "كذب"}, {"id": 9, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 10, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 11, "arabic": "يُوزَعُونَ", "translit": "َnwُʿعَzwُy", "root": "وزع"}], "hasIhya": false}, {"ayah": 84, "text": "حَتَّىٰٓ إِذَا جَآءُو قَالَ أَكَذَّبْتُم بِـَٔايَٰتِى وَلَمْ تُحِيطُوا۟ بِهَا عِلْمًا أَمَّاذَا كُنتُمْ تَعْمَلُونَ ", "translation": "Until, when they arrive [at the place of Judgement], He will say, \"Did you deny My signs while you encompassed them not in knowledge, or what [was it that] you were doing?\"", "words": [{"id": 1, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "جَآءُو", "translit": "wُءٓāَjg", "root": "جيا"}, {"id": 4, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 5, "arabic": "أَكَذَّبْتُم", "translit": "mُtْbَّhdَkَaʾ", "root": "كذب"}, {"id": 6, "arabic": "بِـَٔايَٰتِى", "translit": "àِtَٰyāَٔـِb", "root": "ايي"}, {"id": 7, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 8, "arabic": "تُحِيطُوا۟", "translit": "۟āwُṭyِḥُt", "root": "حوط"}, {"id": 9, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 10, "arabic": "عِلْمًا", "translit": "āًmْlِʿع", "root": "علم"}, {"id": 11, "arabic": "أَمَّاذَا", "translit": "āَhdāَّmَaʾ", "root": ""}, {"id": 12, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 13, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 85, "text": "وَوَقَعَ ٱلْقَوْلُ عَلَيْهِم بِمَا ظَلَمُوا۟ فَهُمْ لَا يَنطِقُونَ ", "translation": "And the decree will befall them[1] for the wrong they did, and they will not [be able to] speak.", "words": [{"id": 1, "arabic": "وَوَقَعَ", "translit": "َʿعَqَwَw", "root": "وقع"}, {"id": 2, "arabic": "ٱلْقَوْلُ", "translit": "ُlْwَqْlٱ", "root": "قول"}, {"id": 3, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 5, "arabic": "ظَلَمُوا۟", "translit": "۟āwُmَlَẓ", "root": "ظلم"}, {"id": 6, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يَنطِقُونَ", "translit": "َnwُqِṭnَy", "root": "نطق"}], "hasIhya": false}, {"ayah": 86, "text": "أَلَمْ يَرَوْا۟ أَنَّا جَعَلْنَا ٱلَّيْلَ لِيَسْكُنُوا۟ فِيهِ وَٱلنَّهَارَ مُبْصِرًاۚ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّقَوْمٍ يُؤْمِنُونَ ", "translation": "Do they not see that We made the night that they may rest therein and the day giving sight? Indeed in that are signs for a people who believe.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 3, "arabic": "أَنَّا", "translit": "āَّnَaʾ", "root": ""}, {"id": 4, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 5, "arabic": "ٱلَّيْلَ", "translit": "َlْyَّlٱ", "root": "ليل"}, {"id": 6, "arabic": "لِيَسْكُنُوا۟", "translit": "۟āwُnُkْsَyِl", "root": "سكن"}, {"id": 7, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 8, "arabic": "وَٱلنَّهَارَ", "translit": "َrāَhَّnlٱَw", "root": "نهر"}, {"id": 9, "arabic": "مُبْصِرًا", "translit": "āًrِṣْbُm", "root": "بصر"}, {"id": 10, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 13, "arabic": "لَءَايَٰتٍ", "translit": "ٍtَٰyāَءَl", "root": "ايي"}, {"id": 14, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 15, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 87, "text": "وَيَوْمَ يُنفَخُ فِى ٱلصُّورِ فَفَزِعَ مَن فِى ٱلسَّمَٰوَٰتِ وَمَن فِى ٱلْأَرْضِ إِلَّا مَن شَآءَ ٱللَّهُۚ وَكُلٌّ أَتَوْهُ دَٰخِرِينَ ", "translation": "And [warn of] the Day the Horn will be blown, and whoever is in the heavens and whoever is on the earth will be terrified except whom Allāh wills. And all will come to Him humbled.", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "يُنفَخُ", "translit": "ُhkَfnُy", "root": "نفخ"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلصُّورِ", "translit": "ِrwُّṣlٱ", "root": "صور"}, {"id": 5, "arabic": "فَفَزِعَ", "translit": "َʿعِzَfَf", "root": "فزع"}, {"id": 6, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 9, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 12, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 13, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 14, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 15, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "وَكُلٌّ", "translit": "ٌّlُkَw", "root": "كلل"}, {"id": 17, "arabic": "أَتَوْهُ", "translit": "ُhْwَtَaʾ", "root": "اتي"}, {"id": 18, "arabic": "دَٰخِرِينَ", "translit": "َnyِrِhkَٰd", "root": "دخر"}], "hasIhya": true}, {"ayah": 88, "text": "وَتَرَى ٱلْجِبَالَ تَحْسَبُهَا جَامِدَةً وَهِىَ تَمُرُّ مَرَّ ٱلسَّحَابِۚ صُنْعَ ٱللَّهِ ٱلَّذِىٓ أَتْقَنَ كُلَّ شَىْءٍۚ إِنَّهُۥ خَبِيرٌۢ بِمَا تَفْعَلُونَ ", "translation": "And you see the mountains, thinking them motionless,[1] while they will pass as the passing of clouds. [It is] the work of Allāh, who perfected all things. Indeed, He is Aware of that which you do.", "words": [{"id": 1, "arabic": "وَتَرَى", "translit": "àَrَtَw", "root": "راي"}, {"id": 2, "arabic": "ٱلْجِبَالَ", "translit": "َlāَbِjgْlٱ", "root": "جبل"}, {"id": 3, "arabic": "تَحْسَبُهَا", "translit": "āَhُbَsْḥَt", "root": "حسب"}, {"id": 4, "arabic": "جَامِدَةً", "translit": "ًẗَdِmāَjg", "root": "جمد"}, {"id": 5, "arabic": "وَهِىَ", "translit": "َàِhَw", "root": ""}, {"id": 6, "arabic": "تَمُرُّ", "translit": "ُّrُmَt", "root": "مرر"}, {"id": 7, "arabic": "مَرَّ", "translit": "َّrَm", "root": "مرر"}, {"id": 8, "arabic": "ٱلسَّحَابِ", "translit": "ِbāَḥَّslٱ", "root": "سحب"}, {"id": 9, "arabic": "صُنْعَ", "translit": "َʿعْnُṣ", "root": "صنع"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 12, "arabic": "أَتْقَنَ", "translit": "َnَqْtَaʾ", "root": "تقن"}, {"id": 13, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 14, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 15, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 16, "arabic": "خَبِيرٌۢ", "translit": "ٌۢryِbَhk", "root": "خبر"}, {"id": 17, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 18, "arabic": "تَفْعَلُونَ", "translit": "َnwُlَʿعْfَt", "root": "فعل"}], "hasIhya": true}, {"ayah": 89, "text": "مَن جَآءَ بِٱلْحَسَنَةِ فَلَهُۥ خَيْرٌ مِّنْهَا وَهُم مِّن فَزَعٍ يَوْمَئِذٍ ءَامِنُونَ ", "translation": "Whoever comes [at Judgement] with a good deed will have better than it, and they, from the terror of that Day, will be safe.", "words": [{"id": 1, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "بِٱلْحَسَنَةِ", "translit": "ِẗَnَsَḥْlٱِb", "root": "حسن"}, {"id": 4, "arabic": "فَلَهُۥ", "translit": "ۥُhَlَf", "root": ""}, {"id": 5, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 6, "arabic": "مِّنْهَا", "translit": "āَhْnِّm", "root": ""}, {"id": 7, "arabic": "وَهُم", "translit": "mُhَw", "root": ""}, {"id": 8, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 9, "arabic": "فَزَعٍ", "translit": "ٍʿعَzَf", "root": "فزع"}, {"id": 10, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 11, "arabic": "ءَامِنُونَ", "translit": "َnwُnِmāَء", "root": "امن"}], "hasIhya": true}, {"ayah": 90, "text": "وَمَن جَآءَ بِٱلسَّيِّئَةِ فَكُبَّتْ وُجُوهُهُمْ فِى ٱلنَّارِ هَلْ تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ ", "translation": "And whoever comes with an evil deed[1] - their faces will be overturned into the Fire, [and it will be said], \"Are you recompensed except for what you used to do?\"", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "بِٱلسَّيِّئَةِ", "translit": "ِẗَyʾِّyَّslٱِb", "root": "سوا"}, {"id": 4, "arabic": "فَكُبَّتْ", "translit": "ْtَّbُkَf", "root": "كبب"}, {"id": 5, "arabic": "وُجُوهُهُمْ", "translit": "ْmُhُhwُjgُw", "root": "وجه"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 8, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 9, "arabic": "تُجْزَوْنَ", "translit": "َnْwَzْjgُt", "root": "جزي"}, {"id": 10, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 13, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": true}, {"ayah": 91, "text": "إِنَّمَآ أُمِرْتُ أَنْ أَعْبُدَ رَبَّ هَٰذِهِ ٱلْبَلْدَةِ ٱلَّذِى حَرَّمَهَا وَلَهُۥ كُلُّ شَىْءٍۖ وَأُمِرْتُ أَنْ أَكُونَ مِنَ ٱلْمُسْلِمِينَ ", "translation": "[Say, O Muḥammad], \"I have only been commanded to worship the Lord of this city,[1] who made it sacred and to whom [belongs] all things. And I am commanded to be of the Muslims [i.e., those who submit to Allāh]", "words": [{"id": 1, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "أُمِرْتُ", "translit": "ُtْrِmُaʾ", "root": "امر"}, {"id": 3, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 4, "arabic": "أَعْبُدَ", "translit": "َdُbْʿعَaʾ", "root": "عبد"}, {"id": 5, "arabic": "رَبَّ", "translit": "َّbَr", "root": "ربب"}, {"id": 6, "arabic": "هَٰذِهِ", "translit": "ِhِhdَٰh", "root": ""}, {"id": 7, "arabic": "ٱلْبَلْدَةِ", "translit": "ِẗَdْlَbْlٱ", "root": "بلد"}, {"id": 8, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "حَرَّمَهَا", "translit": "āَhَmَّrَḥ", "root": "حرم"}, {"id": 10, "arabic": "وَلَهُۥ", "translit": "ۥُhَlَw", "root": ""}, {"id": 11, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 12, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 13, "arabic": "وَأُمِرْتُ", "translit": "ُtْrِmُaʾَw", "root": "امر"}, {"id": 14, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 15, "arabic": "أَكُونَ", "translit": "َnwُkَaʾ", "root": "كون"}, {"id": 16, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 17, "arabic": "ٱلْمُسْلِمِينَ", "translit": "َnyِmِlْsُmْlٱ", "root": "سلم"}], "hasIhya": false}, {"ayah": 92, "text": "وَأَنْ أَتْلُوَا۟ ٱلْقُرْءَانَۖ فَمَنِ ٱهْتَدَىٰ فَإِنَّمَا يَهْتَدِى لِنَفْسِهِۦۖ وَمَن ضَلَّ فَقُلْ إِنَّمَآ أَنَا۠ مِنَ ٱلْمُنذِرِينَ ", "translation": "And to recite the Qur’ān.\" And whoever is guided is only guided for [the benefit of] himself; and whoever strays - say, \"I am only [one] of the warners.\"", "words": [{"id": 1, "arabic": "وَأَنْ", "translit": "ْnَaʾَw", "root": ""}, {"id": 2, "arabic": "أَتْلُوَا۟", "translit": "۟āَwُlْtَaʾ", "root": "تلو"}, {"id": 3, "arabic": "ٱلْقُرْءَانَ", "translit": "َnāَءْrُqْlٱ", "root": "قرا"}, {"id": 4, "arabic": "فَمَنِ", "translit": "ِnَmَf", "root": ""}, {"id": 5, "arabic": "ٱهْتَدَىٰ", "translit": "ٰàَdَtْhٱ", "root": "هدي"}, {"id": 6, "arabic": "فَإِنَّمَا", "translit": "āَmَّnِiʾَf", "root": ""}, {"id": 7, "arabic": "يَهْتَدِى", "translit": "àِdَtْhَy", "root": "هدي"}, {"id": 8, "arabic": "لِنَفْسِهِۦ", "translit": "ۦِhِsْfَnِl", "root": "نفس"}, {"id": 9, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 10, "arabic": "ضَلَّ", "translit": "َّlَḍ", "root": "ضلل"}, {"id": 11, "arabic": "فَقُلْ", "translit": "ْlُqَf", "root": "قول"}, {"id": 12, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 13, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 14, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 15, "arabic": "ٱلْمُنذِرِينَ", "translit": "َnyِrِhdnُmْlٱ", "root": "نذر"}], "hasIhya": false}, {"ayah": 93, "text": "وَقُلِ ٱلْحَمْدُ لِلَّهِ سَيُرِيكُمْ ءَايَٰتِهِۦ فَتَعْرِفُونَهَاۚ وَمَا رَبُّكَ بِغَٰفِلٍ عَمَّا تَعْمَلُونَ ", "translation": "And say, \"[All] praise is [due] to Allāh. He will show you His signs, and you will recognize them. And your Lord is not unaware of what you do.\"", "words": [{"id": 1, "arabic": "وَقُلِ", "translit": "ِlُqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلْحَمْدُ", "translit": "ُdْmَḥْlٱ", "root": "حمد"}, {"id": 3, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 4, "arabic": "سَيُرِيكُمْ", "translit": "ْmُkyِrُyَs", "root": "راي"}, {"id": 5, "arabic": "ءَايَٰتِهِۦ", "translit": "ۦِhِtَٰyāَء", "root": "ايي"}, {"id": 6, "arabic": "فَتَعْرِفُونَهَا", "translit": "āَhَnwُfِrْʿعَtَf", "root": "عرف"}, {"id": 7, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 8, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 9, "arabic": "بِغَٰفِلٍ", "translit": "ٍlِfَٰغِb", "root": "غفل"}, {"id": 10, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 11, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}], "tafsir": {"14": [{"arabic": "{وجحدوا بها واستيقنتها أنفسهم ظلما وعلوا} وهذا الكبر قريب من التكبر على الله عز وجل وإن كان دونه ولكنه تكبر على قبول أمر الله والتواضع لرسوله", "english": "Know that the one against whom pride is directed is either God—mighty and majestic—or His messengers, or the rest of His creation. Man has been created unjust and ignorant {«وخلق الإنسان ظلوما جهولا»}, so at times he grows proud against the creation, and at times he grows proud against the Creator. Thus, pride, considered with respect to the one against whom it is directed, falls into three divisions.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 855", "section_title_en": "Exposition of the One Against Whom Pride Is Directed, Its Degrees, Its Divisions, and the Fruits of Pride Within It", "section_index": 855, "anchors": "- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core root denotes magnitude, whether physical size, age, or rank; \"الكبرة\" specifically marks the state of advanced age or an ingrained, chronic condition.\n  * Al-Raghib (Mufradat): \"الكبير والصغير من الأسماء المتضايفة\" — bigness and smallness are relative terms. In the theological context, pride (الكبر) is the soul's self-magnification against another, a relational vice that distorts the creature's standing before the Creator.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage concerns physical or quantitative magnitude. Metaphorical (Majaz) usage transfers this to moral and spiritual stature, as in \"كبر علي ذلك\" (it weighed heavily upon him) — here, the soul's swelling against divine command is a metaphorical arrogation of greatness.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — Governing the syntactic tension between the agent of pride (المتكبر) and its object (المتكبر عليه), where the preposition \"على\" carries the full weight of opposition and elevation, structuring the periodic sentences that follow.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}], "16": [{"arabic": "عليه وسلم فقال يا أيها الناس إن لكل شيء مطية ومطية المرء العقل وأحسنكم دلالة ومعرفة بالحجة أفضلكم عقلا (6) وعن أبي هريرة رضي الله عنه قال لما رجع رسول الله صلى الله عليه وسلم من غزوة أحد سمع الناس يقولون فلان أشجع من فلان وفلان أبلى ما لم يبل فلان ونحو هذا فقال رسول الله صلى الله عليه وسلم أما هذا فلا علم لكم به قالوا وكيف ذلك يا رسول الله فقال صلى الله عليه وسلم إنهم قاتلوا على قدر ما قسم الله لهم من العقل وكانت نصرتهم ونيتهم على قدر عقولهم فأصيب منهم من أصيب على منازل شتى", "english": "It is narrated from Anas (may Allah be pleased with him) who said: A group of people praised a man before the Prophet (peace be upon him) until they exaggerated. The Prophet (peace be upon him) said: **\"How is the man's intellect?\"** They said: \"We inform you of his diligence in worship and his various kinds of goodness, yet you ask us about his intellect?\" The Prophet (peace be upon him) said: **\"Indeed, the foolish man attains through his ignorance more corruption than the wickedness of the wicked man attains through his wickedness. And indeed, the servants will be raised on the Day of Resurrection in the degrees of nearness (al-zulfā) to their Lord only according to the measure of their intellects.\"**", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 66", "section_title_en": "Section 66", "section_index": 66, "anchors": "*(Anchors established)*", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}], "23": [{"arabic": "سيدنا ومولانا يا كافي من كل شيء ولا يكفى منه شيء أطعمت من جوع وآمنت من خوف فلك الحمد آويت من يتم وهديت من ضلالة وأغنيت من عيلة فلك الحمد حمدا كثيرا دائما طيبا نافعا مباركا فيه كما أنت أهله ومستحقه اللهم أطعمتنا طيبا فاستعملنا صالحا واجعله عونا لنا عن طاعتك ونعوذ بك أن نستعين به على معصيتك وأما غسل اليدين بالأشنان فكيفيته أن يجعل الأشنان في كفه اليسرى ويغسل الأصابع الثلاث من اليد اليمنى أولا ويضرب أصابعه على الأشنان اليابس فيمسح به شفتيه ثم ينعم غسل الفم بإصبعه ويدلك ظاهر أسنان", "english": "It is that one should refrain from eating before complete satiety, and lick his fingers, then wipe them with a napkin, then wash them, and pick up the crumbs of food that have fallen. The Prophet (peace and blessings be upon him) said: \"Whoever eats what falls from the table will live in abundance and his offspring will be protected.\" (5)", "book_title": "Manners of Eating", "section_title_ar": "Section 285", "section_title_en": "The Third Division: What is Recommended After Eating", "section_index": 285, "anchors": "- Root: اكل (akl)\n  * Lisan / Ayn: Core meaning is the act of eating/consuming food; also used for the action of fire upon wood, and metaphorically for devouring.\n  * Al-Raghib (Mufradat): Distinguishes الأكل (eating) as the intake of nourishment; the theological nuance extends to the spiritual consequence of what is consumed — lawful (halal) versus unlawful (haram) food affecting the soul's disposition.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) refers to physical ingestion; Metaphorical (Majaz) extends to \"devouring\" wealth or property unjustly. Here, the literal sense governs the etiquettes of eating, while the metaphorical sense underlies the warning against consuming what is unlawful.\n- Root: لهم (lahm)\n  * Lisan / Ayn: Root relates to swallowing/ingesting; also the flesh (lahm) of the body.\n  * Al-Raghib (Mufradat): The root for إلهام (inspiration) is distinct, but the physical flesh (لحم) is the corporeal substance nourished by food. The Prophetic warning \"every flesh that grows from the unlawful\" connects the physical body to its spiritual source.\n  * Al-Zamakhshari (Asas): Literal: flesh as bodily substance. Metaphorical: the moral state of the body as a direct consequence of its nourishment.\n- Root: حمد (hamd)\n  * Lisan / Ayn: Praise, commendation; the act of extolling virtues.\n  * Al-Raghib (Mufradat): Praise (حمد) is the acknowledgment of beneficence with reverence; it is the verbal expression of gratitude for divine provision, distinct from mere thanks (شكر) which can be by action.\n  * Al-Zamakhshari (Asas): Literal: to praise God for His favors. Metaphorical: \"I praised his conduct\" — extending to approving of an act. Here, the literal sense of praising God after eating is the prescribed liturgical response.\n- Root: برك (barak)\n  * Lisan / Ayn: The chest of a camel; to kneel down; blessing (بركة) as a derived concept of divine goodness descending.\n  * Al-Raghib (Mufradat): Blessing (بركة) is the increase of good from God; it is invoked upon food, upon a person, or upon an action.\n  * Al-Zamakhshari (Asas): Literal: \"God blessed him\" — to confer goodness. Metaphorical: \"War laid its chest upon them\" — to press down heavily. In the supplications, the literal sense of invoking divine blessing upon food and the provider is intended.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the placement of prepositional phrases and the flow of supplications, ensuring the syntactic structure of the du'a remains coherent and grammatically sound.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Manners of Eating'", "badge": "Du'a"}], "25": [{"arabic": "وإنما السفر هو الذي يسفر عن أخلاق الرجال وبه يخرج الله الخبء في السماوات والأرض وإنما سمى السفر سفرا لأنه يسفر عن الأخلاق ولذلك قال عمر رضي الله عنه للذي زكى عنده بعض الشهود هل صحبته في السفر الذي يستدل به على مكارم أخلاقه فقال لا فقال ما أراك تعرفه وكان بشر يقول يا معشر القراء سيحوا تطيبوا فإن الماء إذا ساح طاب وإذا طال مقامه في موضع تغير وبالجملة فإن النفس في الوطن مع مواتاة الأسباب لا تظهر خبائث أخلاقها لاستئناسها بما يوافق طبعها من المألوفات المعهودة فإذا حملت وعثاء السفر وصرفت عن مألوفاتها المعتادة وامتحنت بمشاق الغر", "english": "The Prophet, peace be upon him, said: \"Whoever goes forth from his house in pursuit of knowledge is in the path of God until he returns.\" {«من خرج من بيته في طلب العلم فهو في سبيل الله حتى يرجع»}", "book_title": "Etiquette of Travel", "section_title_ar": "Section 465", "section_title_en": "Section 465", "section_index": 465, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Travel'", "badge": "Insight"}], "32": [{"arabic": "يقول في الاستغفار اللهم اغفر لي خطيئتي وجهلي وإسرافي في أمري وما أنت أعلم به مني اللهم اغفر لي هزلي وجدي وخطئي وعمدي وكل ذلك عندي اللهم اغفر لي ما قدمت وما أخرت وما أسررت وما أعلنت وما أنت أعلم به مني أنت المقدم وأنت المؤخر وأنت على كل شيء قدير (1) وقال علي رضي الله عنه كنت رجلا إذا سمعت من رسول الله صلى الله عليه وسلم حديثا نفعني الله عز وجل بما شاء أن ينفعني منه وإذا حدثني أحد من أصحابه استحلفته فإذا حلف صدقته قال وحدثني أبو بكر وصدق أبو بكر رضي الله عنه قال سمعت رسول الله صلى الله عليه وسلم يقول ما من عبد", "english": "God Most High said: {«والذين إذا فعلوا فاحشة أو ظلموا أنفسهم ذكروا الله فاستغفروا لذنوبهم»} — \"And those who, when they commit an indecency or wrong themselves, remember God and seek forgiveness for their sins\" {آل عمران/135}.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 246", "section_title_en": "On Seeking Forgiveness (Al-Istighfar) — Section 246", "section_index": 246, "anchors": "- Root: ذنب (dhanb)\n  * Lisan / Ayn: Core meaning of \"tail\" or \"taking hold of a tail\"; extended to signify a sin as that which trails behind and follows a person.\n  * Al-Raghib (Mufradat): \"الذنب في الأصل: الأخذ بذنب الشيء\" — sin is that by which one is seized and held accountable; used metaphorically for a fault that clings to its perpetrator.\n  * Al-Zamakhshari (Asas): Literal: tail of an animal. Metaphorical: \"هو من الأذناب\" — one who follows; sin as that which trails the soul and must be severed through repentance.\n- Root: غفر (ghafara)\n  * Lisan / Ayn: Covering, veiling, protecting from defilement; a shield or helmet (المغفر).\n  * Al-Raghib (Mufradat): \"الغفران والمغفرة من الله هو أن يصون العبد من أن يمسه العذاب\" — divine forgiveness is God's protection of the servant from being touched by punishment.\n  * Al-Zamakhshari (Asas): Literal: to cover and protect. Metaphorical: God's \"covering\" of sins — not merely erasure, but active safeguarding of the sinner from consequence.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The frequent interposition of \"يا رب\" and vocative constructions between the subject and predicate in supplicatory sentences, as in \"اللهم اغفر لي,\" where the vocative particle governs the imperative verb's addressee, reflecting the grammatical permissibility of separation between governing and governed elements in invocational speech.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "40": [{"arabic": "وبينكم ومن عنده علم الكتاب} وقال تعالى {قال الذي عنده علم من الكتاب أنا آتيك به} تنبيها على أنه اقتدر بقوة العلم وقال عز وجل {وقال الذين أوتوا العلم ويلكم ثواب الله خير لمن آمن وعمل صالحا} بين أن عظم قدر الآخرة يعلم بالعلم وقال تعالى {وتلك الأمثال نضربها للناس وما يعقلها إلا العالمون} وقال تعالى {ولو ردوه إلى الرسول وإلى أولي الأمر منهم لعلمه الذين يستنبطونه منهم} رد حكمه في الوقائع إلى استنباطهم وألحق رتبتهم برتبة الأنبياء في كشف حكم الله وقيل في قوله تعالى يا بني آدم قد أنزلنا عليكم لباسا يواري سوءاتكم يعني العلم وريشا يع", "english": "How He, Glorified and Exalted, began with Himself, then seconded with the angels, and thirded with the people of knowledge — and sufficient for you is this as honor, excellence, splendor, and nobility. And God, Exalted, said: {«يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات»} — \"God will raise those who have believed among you and those who have been given knowledge, in degrees.\" Ibn ʿAbbās, may God be pleased with them both, said: For the scholars there are degrees above the believers, seven hundred degrees, and between each two degrees is a distance of five hundred years' journey.", "book_title": "Book of Knowledge", "section_title_ar": "Section 4", "section_title_en": "The Book of Knowledge — Section 4: The Excellence of Knowledge and the Scholars", "section_index": 4, "anchors": "- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Core root meaning of knowing, perceiving a thing in its true reality; the act of apprehension and judgment.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment of existence or non-existence.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes genuine knowing; metaphorical (majāz) usage extends to signs, landmarks, and traces that guide to knowledge.\n- Root: درج (d-r-j)\n  * Lisan / Ayn: Degrees, steps, ascending stations; the root denotes gradation and progressive elevation.\n  * Al-Raghib (Mufradat): \"الدرجة نحو المنزلة، لكن يقال للمنزلة: درجة إذا اعتبرت بالصعود\" — a degree is a station considered by ascent, not horizontal extension.\n  * Al-Zamakhshari (Asas): Literal: physical steps of ascent. Metaphorical: \"لفلان درجة رفيعة\" — lofty rank; \"امش في مدارج الحق\" — walk in the paths of truth.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day denotes the time of the sun's rising to its setting, and may denote any period of time whatsoever.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"ذكر في أيام العرب كذا\" — historical battles and events; \"وذكرهم بأيام الله\" — His mighty deeds against the disbelievers.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication) — The particle \"innamā\" restricts and confines the predicate to the subject alone, as in {«إنما يخشى الله من عباده العلماء»}, where fear of God is restricted exclusively to the scholars.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "50": [{"arabic": "واستدراجه فقال فلا يأمن مكر الله إلا القوم الخاسرون وقال تعالى ومكروا مكرا ومكرنا مكرا وهم لا يشعرون وقال عز وجل ومكروا ومكر الله والله خير الماكرين وقال تعالى إنهم يكيدون كيدا وأكيد كيدا فمهل الكافرين أمهلهم رويدا فكما لا يجوز للعبد المهمل أن يستدل بإهمال السيد إياه وتمكينه من النعم على حب السيد بل ينبغي أن يحذر أن يكون ذلك مكرا منه وكيدا مع أن السيد لم يحذره مكر نفسه فبأن يجب ذلك في حق الله تعالى مع تحذيره استدراجه أولى فإذن من أمن مكر الله فهو مغتر ومنشأ هذا الغرور أنه استدل بنعم الدنيا على أنه كريم عند ذلك المنعم واحتمل أن يكون ذلك دليل الهوان و", "english": "As for knowing it by way of authoritative transmission and affirmation (taṣdīq): it is that one believes in the Book of God — exalted is He — and affirms His Messenger. For God — exalted is He — has said: {«أيحسبون أن ما نمدهم به من مال وبنين * نسارع لهم في الخيرات بل لا يشعرون»} — \"Do they reckon that what We extend to them of wealth and sons — [that] We hasten for them good things? Nay, but they do not perceive\" (Q. 23:55-56). And He said — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — \"We shall draw them on by degrees from whence they do not know\" (Q. 7:182). And He said — exalted is He: {«فتحنا عليهم أبواب كل شيء حتى إذا فرحوا بما أوتوا أخذناهم بغتة فإذا هم مبلسون»} — \"We opened upon them the gates of everything, until when they rejoiced in what they were given, We seized them suddenly, and behold, they were in despair\" (Q. 6:44). And in the interpretation of His saying — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — it is said: \"Whenever they innovated a sin, We innovated for them a blessing, to increase their self-deception.\" And He said — exalted is He: {«إنما نملي لهم ليزدادوا إثما»} — \"We only grant them respite that they may increase in sin\" (Q. 3:178). And He said — exalted is He: {«ولا تحسبن الله غافلا عما يعمل الظالمون إنما يؤخرهم ليوم تشخص فيه الأبصار»} — \"And do not reckon God heedless of what the wrongdoers do; He only delays them to a Day when eyes will stare fixedly\" (Q. 14:42). And [there is] more of that kind which has come in the Book of God — exalted is He — and in the Sunnah of His Messenger. So whoever believes in it is delivered from this self-deception. For the origin of this self-deception is ignorance of God and of His attributes; for whoever knows Him does not feel secure from His stratagem (makr) and is not deceived by such corrupt fancies.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 888", "section_title_en": "Section 888 — On the Remedy for Self-Deception (Ghurūr): Recognizing the Signs of Divine Honor (Karāmah) and Humiliation (Hawān)", "section_index": 888, "anchors": "- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Core meaning of an outward trace or mark; heedlessness in wakefulness; the blaze on a horse's forehead.\n  * Al-Raghib (Mufradat): \"Ghurūr\" is delusion stemming from heedlessness — the soul's being overtaken while imagining security, as in {«ما غرك بربك الكريم»} (Q. 82:6). It is the state of one who is deceived by apparent favors while blind to their underlying test.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): heedlessness and exposure to predation, like a gazelle deceived by moonlight. Metaphorical (Majaz): being \"deceived by God\" (ightirār billāh) — trusting in His mercy while persisting in disobedience.\n- Root: لهم (l-h-m)\n  * Lisan / Ayn: Swallowing whole; the gullet.\n  * Al-Raghib (Mufradat): \"Ilhām\" — God's casting a meaning into the heart (al-raw'), distinct from demonic whispering; the channel of inner vision for the knowers (ʿārifūn).\n  * Al-Zamakhshari (Asas): Literal: to swallow. Metaphorical: the heart's receptive \"swallowing\" of divine inspiration.\n- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: Origination after non-existence; newness.\n  * Al-Raghib (Mufradat): \"Ḥudūth\" — a thing's coming to be after it was not; \"muḥdith\" — the originator, exclusively God for substances (jawāhir). \"Iḥdāth\" — bringing about a novel state or act.\n  * Al-Zamakhshari (Asas): Literal: temporal newness. Metaphorical: \"muḥaddath\" — one inspired with correct discernment, as if newly spoken-to.\n- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Softness, ease, well-being; a state of comfort.\n  * Al-Raghib (Mufradat): \"Niʿmah\" — the good state one inhabits; \"naʿīm\" — the act of living pleasantly. Blessings are both a test and a sign, per {«وإن تعدوا نعمة الله لا تحصوها»} (Q. 16:18).\n  * Al-Zamakhshari (Asas): Literal: bounty and comfort. Metaphorical: \"khafat naʿāmatuhum\" — their prosperity vanished; blessings may signal either favor or gradual ruin (istidrāj).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication with \"innamā\")\n  * In {«إنما نملي لهم ليزدادوا إثما»} (Q. 3:178) and {«إنما يؤخرهم ليوم تشخص فيه الأبصار»} (Q. 14:42), \"innamā\" restricts the purpose of divine respite exclusively to increase of sin and deferred reckoning — negating any reading of it as benevolent indulgence.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Delusion'", "badge": "Ethics"}], "59": [{"arabic": "فإذا قرب من البيت قال الحمد لله وسلام على عباده الذين اصطفى اللهم صل على محمد عبدك ورسولك وعلى إبراهيم خليلك وعلى جميع أنبيائك ورسلك وليرفع يديه وليقل اللهم إني أسألك في مقامي هذا في أول مناسكي أن تتقبل توبتي وأن تتجاوز عن خطيئتي وتضع عني وزري الحمد لله الذي بلغني بيته الحرام الذي جعله مثابة للناس وأمنا وجعله مباركا وهدى للعالمين اللهم إني عبدك والبلد بلدك والحرم حرمك والبيت بيتك جئتك أطلب رحمتك وأسألك مسألة المضطر الخائف من عقوبتك الراجي لرحمتك الطالب مرضاتك السادس أن تقصد الحجر الأسود بعد ذل", "english": "The second [etiquette]: that he say, upon entering the first boundary of the Sacred Precinct (al-ḥaram), while still outside Mecca: \"O Allah, this is Your Sanctuary (ḥaramuka) and Your Place of Security (amnuka); so make my flesh, my blood, my hair, and my skin forbidden to the Fire, and grant me security from Your punishment on the Day You resurrect Your servants, and make me among Your friends (awliyāʾ) and the people of Your obedience.\"", "book_title": "Mysteries of Hajj", "section_title_ar": "Section 201", "section_title_en": "Section 201 — On the Etiquettes of Entering Mecca and the Sacred Mosque", "section_index": 201, "anchors": "- Root: حرم (ḥ-r-m)\n  * Lisan / Ayn: \"Al-ḥaram\" denotes that which is rendered inviolable and protected; the Sacred Precinct (al-ḥaram) is the sanctuary whose sanctity Allah has established, making its game, trees, and bloodshed forbidden.\n  * Al-Raghib (Mufradat): \"Al-ḥarām: that which is prohibited—whether by divine decree, by legal command, or by coercive prevention.\" The ḥaram of Mecca is that which Allah has rendered sacrosanct, and His sanctuary (amn) is its correlate—security from fear and punishment.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"He protects the sanctuary (ḥimā) and guards the inviolable precinct (ḥarīm).\" Metaphorical (majāz): \"A man of inviolable sanctity (muḥarram)\"—one whose honor is protected; \"the terrors of the night (maḥārim al-layl)\"—its perils which make travel unlawful in safety.\n- Root: ثني (th-n-y)\n  * Lisan / Ayn: \"Ath-thaniyyah\" (pl. thanāyā): a mountain pass or defile in the road, so named because the path folds and doubles back upon itself through the heights.\n  * Al-Raghib (Mufradat): \"Ath-thanā' and ithnān: a root for its derivatives, used by virtue of number or repetition.\" The two passes of Mecca—Thaniyyat Kadā' (upper) and Thaniyyat Kudā (lower)—are so named for their winding, doubled course.\n  * Al-Zamakhshari (Asas): Literal: \"Every thing folded one part upon another in layers—each layer is a thanī.\" Metaphorical: \"I turned him back (thanaytuhu) upon his face\"—I returned him whence he came. The pilgrim's entry and exit through these passes enacts a turning toward and away from the Sacred House.\n- Root: بيت (b-y-t)\n  * Lisan / Ayn: \"Al-bayt\": the place of abode by night (al-baytūtah); the Kaaba is \"al-Bayt al-Ḥarām\"—the Inviolable House—because it is the primordial dwelling of worship.\n  * Al-Raghib (Mufradat): \"The origin of bayt: man's shelter by night... then applied to any dwelling.\" Allah says: {وَإِذْ جَعَلْنَا الْبَيْتَ مَثَابَةً لِلنَّاسِ وَأَمْنًا} [Al-Baqarah: 125]—a place of return and security.\n  * Al-Zamakhshari (Asas): Literal: the physical structure of the Kaaba. Metaphorical: \"Bayt Allāh\" as the locus of divine mercy and the qiblah of invocation—its corner (al-rukn) and its wall (al-multazam) are stations of answered supplication.\n- Root: لهم (l-h-m) [as in ilhām, though not in this text, the root's semantic field of \"swallowing/engulfing\" informs the pilgrim's total absorption in the rites]\n  * Lisan / Ayn: \"Ilhām\": to cast something into the heart (al-raw'); from lahima—to swallow entirely, leaving nothing.\n  * Al-Raghib (Mufradat): \"Al-ilhām: the casting of a thing into the inner self (al-raw'), and it is specific to what comes from Allah.\" The pilgrim's supplications at the threshold of the House are an act of receptive swallowing of divine grace.\n  * Al-Zamakhshari (Asas): Literal: \"He swallowed the thing—he gulped it down.\" Metaphorical: \"A horse that swallows the ground (yaltahim al-arḍ)\"—one that devours distance. The pilgrim's entry into the ḥaram is a devouring of the path of return to Allah.\n- Sibawayh Rule: Al-ʿAṭf ʿalā al-Maʿnā (Coordination by Meaning) — When the Prophet ﷺ is reported to have entered from one pass and exited from another, the coordination of the two verbs (dakhala/kharaja) with their respective prepositions (min) governs the syntactic parallelism, each clause standing complete in its own semantic field, as in Sibawayh's treatment of coordinated sentences where the second member need not repeat the first's verb but carries its full force by ellipsis (ḥadhf).", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Hajj'", "badge": "Du'a"}], "65": [{"arabic": "وهو أحد والآصال التي ذكرها الله تعالى إذ قال ولله يسجد من في السموات والأرض طوعا وكرها وظلالهم بالغدو والآصال وإذا سجد لله عز وجل الجمادات فكيف يجوز أن يغفل العبد العاقل عن أنواع العبادات الورد السادس إذا دخل وقت العصر دخل وقت الورد السادس وهو الذي أقسم الله تعالى به فقال تعالى {والعصر} هذا أحد معنيي الآية وهو المراد بالآصال في أحد التفسيرين وهو العشي المذكور في قوله {وعشيا} وفي قوله {بالعشي والإشراق} وليس في هذا الورد صلاة إلا أربع ركعات بين الأذان والإقامة كما سبق في الظهر ثم يصلي الفرض ويشتغل بالأقسام الأربعة المذكورة", "english": "I say: And just as knowledge and remembrance are the nourishment of the heart, which can never be cut off from it, so too the measure of moderation is this; and deficiency from it may lead to the disturbance of the body — except for one who accustoms himself to wakefulness gradually, for he may train himself upon it without disturbance. And this litany (wird) is among the longest of the litanies and the most delightful for the worshippers, and it is one of the \"evenings and mornings\" (al-āṣāl) which God Most High mentioned when He said: {«ولله يسجد من في السموات والأرض طوعا وكرها وظلالهم بالغدو والآصال»} \"And to God prostrates whoever is in the heavens and the earth, willingly or unwillingly, and their shadows, in the mornings and the evenings\" (Q. 13:15). And when inanimate objects prostrate to God, Mighty and Majestic, how then can the intelligent servant be heedless of the varieties of worship?", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 261", "section_title_en": "The Seventh Daily Litany (Al-Wird al-Sābiʿ): The Time of Sunset — The Completion of the Day's Litanies and Self-Accounting", "section_index": 261, "anchors": "- Root: ورد (warada)\n  * Lisan / Ayn: The root denotes arriving at water, seeking it, and drinking from it; also the portion or share of water allotted for drinking at a specific time.\n  * Al-Raghib (Mufradat): \"الورود أصله: قصد الماء\" — the core meaning is the intentional approach to water; the litany (wird) is the appointed portion of devotional recitation, likened to the daily share of water that a person must take to sustain life.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): the act of arriving at water. Metaphorical (Majaz): \"ورد علي كتاب سرني مورده\" — a book arrived upon me whose arrival pleased me; likewise, the wird is the arrival of the appointed time for worship, and the soul's approach to the fountain of divine remembrance.\n- Root: عصر (ʿaṣr)\n  * Lisan / Ayn: The root denotes pressing, squeezing, and extracting; also the time of afternoon, so called because it is the pressing of the day's end.\n  * Al-Raghib (Mufradat): The ʿaṣr is the latter part of the day; God swore by it in {«والعصر»} (Q. 103:1), indicating its great merit.\n  * Al-Zamakhshari (Asas): Literal: the afternoon time. Metaphorical: the pressing of one's life — as the day is pressed at its end, so the life of man is pressed at its term.\n- Root: غرب (gharaba)\n  * Lisan / Ayn: The root denotes disappearance, absence, and setting; the sun's setting (ghurūb) is its concealment from the eye.\n  * Al-Raghib (Mufradat): The setting of the sun marks the boundary between the day's works and the night's; it is the terminus of the visible world's diurnal cycle.\n  * Al-Zamakhshari (Asas): Literal: the sun's descent below the horizon. Metaphorical: the setting of the sun of life — the death of man, after which there is no rising.\n- Root: حاسب (ḥāsaba)\n  * Lisan / Ayn: The root denotes reckoning, counting, and taking account; muḥāsabah is the mutual reckoning between two parties.\n  * Al-Raghib (Mufradat): Self-accounting (muḥāsabat al-nafs) is the soul's reckoning with itself over its deeds before the Day of Reckoning, for \"one who reckons himself before he is reckoned\" is among the wise.\n  * Al-Zamakhshari (Asas): Literal: the arithmetic counting of sums. Metaphorical: the soul's audit of its own works, weighing the day's deeds against the standard of the Sacred Law.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of the prepositional phrase from its governing verb, as in the construction \"فسبحان الله حين تمسون\" where the adverbial clause is interposed to emphasize the temporal specification of the act of glorification.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Remembrance of Death and Afterlife'", "badge": "Dhikr"}], "71": [{"arabic": "على الكافرين غير يسير} وقال تعالى {ويقولون متى هذا الوعد إن كنتم صادقين ما ينظرون إلا صيحة واحدة تأخذهم وهم يخصمون فلا يستطيعون توصية ولا إلى أهلهم يرجعون ونفخ في الصور فإذا هم من الأجداث إلى ربهم ينسلون قالوا يا ويلنا من بعثنا من مرقدنا هذا ما وعد الرحمن وصدق المرسلون} فلو لم يكن بين يدي الموتى إلا هول تلك النفخة لكان ذلك جديرا بأن يتقى فإنها نفخة وصيحة يصعق بها من في السموات والأرض يعنى يموتون بها إلا من شاء الله وهو بعض الملائكة ولذلك قال رسول الله صلى الله عليه وسلم كيف أنعم وصاحب الصور قد التقم القرن وحنى الجبهة", "english": "The Prophet (peace and blessings be upon him) said: Allah the Exalted said: \"The son of Adam has reviled Me, and he had no right to revile Me; and he has denied Me, and he had no right to deny Me. As for his reviling of Me, it is his saying that I have a son. And as for his denial of Me, it is his saying: 'He will never bring me back as He created me at first.'\" {«شتمني ابن آدم وما ينبغي له أن يشتمني وكذبني وما ينبغي له أن يكذبني...»}", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1335", "section_title_en": "On the Terrors of the Trumpet-Blast and the Awakening for the Resurrection", "section_index": 1335, "anchors": "- Root: نفخ (N-F-Kh)\n  * Lisan / Ayn: To blow into a thing, to inflate; the breath of wind entering a vessel or body.\n  * Al-Raghib (Mufradat): The divine act of breathing spirit into creation {«ونفخت فيه من روحي»}; here, the eschatological blast that annihilates and then revives all beings.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage of blowing into the Trumpet (الصور); metaphorical extension to the \"blast of spring\" reviving the earth—here applied to the two cosmic blasts of death and resurrection.\n- Root: صور (S-W-R)\n  * Lisan / Ayn: Form, image, shape; also a horn or trumpet (the instrument of the blast).\n  * Al-Raghib (Mufradat): The perceptible form of bodies and the intelligible form of souls; here, the Trumpet (الصور) as the instrument of divine command that re-forms and re-shapes creation.\n  * Al-Zamakhshari (Asas): Literal: the horn (القرن) held by Israfil; metaphorical: the \"inclination\" (صورة) of hearts toward terror and anticipation.\n- Root: موت (M-W-T)\n  * Lisan / Ayn: Death as the cessation of life; the state of the corpse.\n  * Al-Raghib (Mufradat): Death as the separation of the soul from the body; the \"first death\" of the blast and the \"second death\" of the wicked.\n  * Al-Zamakhshari (Asas): Literal: physical death; metaphorical: the \"death\" of the heart through heedlessness, and the reviving of dead lands by rain—here, the reviving of bodies by the second blast.\n- Root: قبر (Q-B-R)\n  * Lisan / Ayn: The grave as the abode of the dead; burial.\n  * Al-Raghib (Mufradat): The grave as the intermediate state (barzakh) before resurrection; {«حتى زرتم المقابر»} as a metaphor for death.\n  * Al-Zamakhshari (Asas): Literal: the grave and its inhabitants; metaphorical: the \"raising of the nose\" (قبراه) of the proud—contrasted here with the humility of the dead rising from their graves.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to emphasize that true faith is not mere verbal assent but heartfelt conviction, as in \"إنما فتور البواطن... لقلة الفهم\" (The languor of the inner selves is only due to the lack of understanding).", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}], "87": [{"arabic": "والبلاء إلا من شاء الله وقال اعلموا أن هذا زمان لا ينال أحد فيه النجاة إلا بذبح نفسه وقتلها بالجوع والسهر والجهد وقال ما مر على وجه الأرض أحد شرب من هذا الماء حتى روي فسلم من المعصية وإن شكر الله تعالى فكيف الشبع من الطعام وسئل حكيم بأي قيد أقيد نفسي قال قيدها بالجوع والعطش وذللها بإخمال الذكر وترك العز وصغرها بوضعها تحت أرجل أبناء الآخرة واكسرها بترك زي القراء عن ظاهرها وانج من آفاتها بدوام سوء الظن بها واصحبها بخلاف هواها وكان عبد الواحد بن زيد يقسم بالله تع", "english": "The Messenger of God, peace be upon him, said: \"Strive against your souls with hunger and thirst, for the reward in that is like the reward of the warrior striving in the path of God. And there is no deed more beloved to God than hunger and thirst.\" (1) And Ibn 'Abbas said: The Prophet, peace be upon him, said: \"He who fills his belly shall not enter the kingdom of heaven.\" (2) And it was said: O Messenger of God, which person is most excellent? He said: \"He whose food is little, and whose laughter is little, and who is content with what covers his nakedness.\" (3) And the Prophet, peace be upon him, said: \"The master of deeds is hunger, and the abasement of the soul, and the wearing of wool.\" (4) And Abu Sa'id al-Khudri said: The Messenger of God, peace be upon him, said: \"Wear, eat, and drink in half of the belly, for that is a part of prophethood.\" (5) And al-Hasan said: The Prophet, peace be upon him, said: \"Reflection is half of worship, and little food is the whole of worship.\" (6) And al-Hasan also said: The Messenger of God, peace be upon him, said: \"The most excellent of you in station before God on the Day of Resurrection is the one among you who is longest in hunger and reflection upon God, Glorified be He. And the most hateful of you to God, Mighty and Majestic, on the Day of Resurrection is every sleepy, gluttonous, drink-loving person.\" (1)", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 639", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 639: On the Excellence of Hunger and Thirst, and the Blameworthiness of Satiety", "section_index": 639, "anchors": "- Root: جوع (J-W-')\n  * Lisan / Ayn: Core root meaning: hunger, emptiness of the stomach, famine (makhmasah); the state of one who abstains from food.\n  * Al-Raghib (Mufradat): Hunger is the pain afflicting the living being from the emptiness of the stomach; it is a spiritual discipline that severs the soul's attachment to corporeal appetites, aligning with the laṭīfah's (subtle divine reality) purification from bodily preoccupations.\n  * Al-Zamakhshari (Asas): Literal (haqiqah): physical hunger from lack of food. Metaphorical (majaz): \"hunger of the heart\" — the soul's yearning for God, as in \"I hunger for my family\"; here, the Prophet's voluntary hunger is a majaz for spiritual elevation, not mere deprivation.\n- Root: عله (gh-dh-')\n  * Lisan / Ayn: Root meaning: to feed, nourishment, provision (ghidhā'); the intake that sustains the body.\n  * Al-Raghib (Mufradat): Sustenance is that which maintains the corporeal substance (jawhar) for obedience; excess nourishment (shib') dulls the heart's perception, while measured intake preserves the subtle reality (laṭīfah) for divine knowledge.\n  * Al-Zamakhshari (Asas): Literal: food as physical sustenance. Metaphorical: \"feeding the heart\" with remembrance (dhikr) versus \"killing the heart\" with excess — the Prophet's simile of the heart as a crop (zar') drowned by excessive water.\n- Root: رسل (R-S-L)\n  * Lisan / Ayn: Root meaning: to send forth gently, to dispatch; a messenger (rasūl) sent with a mission.\n  * Al-Raghib (Mufradat): The root implies gentle dispatch and measured movement; here, the \"messengers\" of the prophets (ulu al-'azm) who endured hunger as a sent discipline, and the believer's self-sending (irsāl) toward God through voluntary abstinence.\n  * Al-Zamakhshari (Asas): Literal: sending a message. Metaphorical: \"sending the soul\" (irsāl al-nafs) on the path of hunger as a means of approach to God — the Prophet's statement that hunger is a \"part of prophethood\" (juz' min al-nubuwwah).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Governing the Prophet's statements like \"Sayyid al-a'māl al-jū'\" (The master of deeds is hunger), where the predicate is restricted to a single virtue, emphasizing its exclusive supremacy over other acts.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "88": [{"arabic": "ذلك فقال {وترى الجبال تحسبها جامدة وهي تمر مر السحاب صنع الله الذي أتقن كل شيء} إشارة إلى أن القلب مضطرب جائل في الملكوت والجوارح متأدبة في الظاهر ساكنة وقال أبو الحسن محمد بن أحمد وكان بالبصرة صحبت سهل بن عبد الله ستين سنة فما رأيته تغير عند شيء كان يسمعه من الذكر أو القرآن فلما كان في آخر عمره قرأ رجل بين يديه {فاليوم لا يؤخذ منكم فدية} الآية فرأيته قد ارتعد وكاد يسقط فلما عاد إلى حاله سألته عن ذلك فقال نعم يا حبيبي قد ضعفنا وكذلك سمع مرة قوله تعالى {الملك يومئذ الحق للرحمن} فاضطرب فسأله ابن سالم وك", "english": "And it is related that Moses — peace be upon him — was preaching among the Children of Israel, and one of them tore his garment or his shirt. So God — exalted be He — revealed to Moses — peace be upon him: \"Say to him: Tear for Me your heart, and do not tear your garment.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 517", "section_title_en": "The Revival of the Religious Sciences — Section 517: On the Steadfastness of the Strong in the Face of Ecstatic Samaʿ, and the Degrees of Manifestation and Restraint", "section_index": 517, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn over, to overturn, to transform from one state to another; the heart as that which is perpetually fluctuating and being overturned between states.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart's turning and overturning is its being diverted from one disposition to another. The heart (qalb) is so named for its constant fluctuation (taqallub) between states.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"قلب الشيء قلبا: حوله عن وجهه\" — to turn a thing from its face. Metaphorical (Majaz): \"قلب المعلم الصبيان: صرفهم إلى بيوتهم\" — to turn pupils back to their homes; and \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and manages them. Here, the heart's being \"split\" (inshaqqa) and its \"turning\" (taqallub) in the unseen realm (malakūt) are majaz for the soul's profound transformation.\n- Root: ظهر (ẓ-h-r)\n  * Lisan / Ayn: The back; the outward, visible surface as opposed to the hidden interior.\n  * Al-Raghib (Mufradat): \"الظهر الجارحة\" — the back as a bodily limb; used metaphorically for the outward aspect of the earth: \"ظهر الأرض وبطنها\" — its surface and its interior.\n  * Al-Zamakhshari (Asas): Literal: \"رجل مظهر: قوي الظهر\" — a man strong of back. Metaphorical: \"قلبت الأمر ظهرا لبطن\" — to turn the matter over, back and belly, i.e., to examine it thoroughly. In this section, the \"outward\" (zāhir) is the domain of the bodily members (jawāriḥ) which must be restrained, while the \"inward\" (bāṭin) is the domain of the heart's ecstasy (wajd).\n- Root: حول (ḥ-w-l)\n  * Lisan / Ayn: To change, to turn, to shift from one state to another; power and capacity to effect change.\n  * Al-Raghib (Mufradat): \"أصل الحول تغير الشيء وانفصاله عن غيره\" — the root meaning is the changing of a thing and its separation from another. \"حال بيني وبينك كذا\" — something intervened between me and you.\n  * Al-Zamakhshari (Asas): Literal: \"حال عليه الحول\" — a year passed over it. Metaphorical: \"لقحت الحرب عن حيال\" — war conceived after a period of barrenness. Here, \"ḥāl\" (state/condition) and \"taḥawwul\" (transformation) denote the changing spiritual conditions that assail the heart, and the power (ḥawl) to restrain the outward members.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; breath; that which is precious and valued.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the self is the spirit; \"نفسه: ذاته\" — His Self is His Essence. The soul is that which is breathed out and drawn in, and by extension, the living self.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس ومنفس\" — a precious thing. Metaphorical: \"دفق نفسه أي دمه\" — he poured out his self, i.e., his blood. In this text, \"nafsahu\" (his self/soul) departs at death when the heart is split by suppressed ecstasy.\n- Sibawayh Rule: باب الفصل بين المبتدأ والخبر (Interposition between Subject and Predicate) — The periodic structure of al-Ghazali's conditional sentences (fa-in qulta... fa-'lam) follows the classical pattern of protasis and apodosis, where the apodosis is introduced by the particle fa- to mark the resumption of the main clause after a lengthy conditional protasis, preserving syntactic cohesion across extended theological arguments.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "89": [{"arabic": "ونفي ولقوله تعالى {من جاء بالحسنة فله خير منها وهم من فزع يومئذ آمنون} فالإيمان رأس الحسنات ولقوله تعالى {والله يحب المحسنين} وقال تعالى {إنا لا نضيع أجر من أحسن عملا} ولا حجة لهم في ذلك فإنه حيث ذكر الإيمان في هذه الآيات أريد به الإيمان مع العمل إذ بينا أن الإيمان قد يطلق ويراد به الإسلام وهو الموافقة بالقلب والقول والعمل ودليل هذا التأويل أخبار كثيرة في معاقبة العاصين ومقادير العقاب وقوله صلى الله عليه وسلم يخرج من النار من كان في قلبه مثقال ذرة من إيمان فكيف يخرج إذا لم يدخل ومن القرآن قوله تعالى {إن الله لا يغفر أن ي", "english": "He was asked, \"Which deed is most excellent?\" The Prophet (peace and blessings be upon him) said: \"Islam.\" It was then asked, \"Which aspect of Islam is most excellent?\" He (peace and blessings be upon him) said: \"Faith (Īmān).\" This is evidence for both the distinction (ikhtilāf) between the two terms and their overlap (tadākhul). This usage is the most consistent with the conventions of the language, because faith is a deed among deeds, and it is the most excellent of them. Islam is submission (taslīm), whether by the heart, by the tongue, or by the limbs. The most excellent of these is that which is by the heart, which is the assent (taṣdīq) that is called faith. Using the two terms in a way that indicates distinction, overlap, or even complete synonymy (tarāduf) is all within the bounds of metaphorical usage (tajawwuz) in the language.", "book_title": "Foundations of Belief", "section_title_ar": "Section 99", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 99: On the Distinction, Overlap, and Synonymy of Faith (Īmān) and Submission (Islām), and Their Worldly and Otherworldly Judgments", "section_index": 99, "anchors": "- Root: ايم (A-Y-M)\n  * Lisan / Ayn: Core meaning of remaining unmarried, or a state of being without a spouse; extended metaphorically to describe one who is solitary or without support.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها... والحرب مأيمة، أي: يفرق بين الزوج والزوجة.\" The root carries the sense of separation or a state of lacking union, which informs the theological discussion of what constitutes the essential bond of faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the state of being unmarried; metaphorical (Majaz) usage extends to anything that separates or leaves one bereft. This distinction between literal and metaphorical application is central to the chapter's method.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه... والانقلاب: الانصراف.\" The heart (qalb) is so named for its constant fluctuation and turning. In theological terms, it is the seat of taṣdīq (assent), the immaterial faculty of cognition and conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is physical turning; metaphorical (Majaz) usage is \"قلب الأمور\" — to deliberate, scrutinize, and manage affairs. This supports the distinction between the heart's internal act of assent and the external acts of the limbs.\n- Root: عمل (ʿ-A-M-L)\n  * Lisan / Ayn: Any deed or action performed with purpose and intent.\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد، فهو أخص من الفعل.\" Work is more specific than mere action, as it implies deliberate, intentional agency. It is used for both righteous and sinful deeds, and is the external manifestation of internal conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to physical labor or deeds. The chapter explores whether \"work\" is an integral part of the reality of faith or a separate, consequent requirement.\n- Root: صدق (S-D-Q)\n  * Lisan / Ayn: To be truthful, to speak the truth, to verify.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول.\" Truth and falsehood are primarily properties of speech and reports. Taṣdīq (assent) is the heart's affirmation of the truth of a report, which is the core reality of Īmān.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is truthful speech; metaphorical (Majaz) usage is \"صادق الحملة\" — one who is true and firm in battle or resolve. This shows that taṣdīq is not merely verbal but a firm, internal resolution.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication). This rule governs how restriction (ḥaṣr) is achieved in Arabic, often through particles like \"innamā\" or through contextual specification (takhṣīṣ). The chapter's core argument hinges on how terms like Īmān and Islām are semantically restricted, expanded, or made synonymous through contextual usage (majāz), requiring precise parsing of the predicate and its scope.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'", "badge": "Insight"}], "90": [{"arabic": "عذاب مقيم} وقال تعالى {ومن جاء بالسيئة فكبت وجوههم في النار} فهذه العمومات في معارضة عموماتهم ولا بد من تسليط التخصص والتأويل على الجانبين لأن الأخبار مصرحة بأن العصاة يعذبون (1) بل قوله تعالى وإن منكم إلا واردها كالصريح في أن ذلك لا بد منه للكل إذ لا يخلو مؤمن عن ذنب يرتكبه وقوله تعالى لا يصلاها إلا الأشقى الذي كذب وتولى أراد به من جماعة مخصوصين أو أراد بالأشقى شخصا معينا أيضا وقوله تعالى كلما ألقى فيها فوج سألهم خزنتها أي فوج من الكفار وتخصيص العمومات قريب ومن هذه الآية وقع للأشعري وطائفة من المتكلم", "english": "He was asked, \"Which deed is most excellent?\" The Prophet (peace and blessings be upon him) said: \"Islam.\" It was then asked, \"Which aspect of Islam is most excellent?\" He (peace and blessings be upon him) said: \"Faith (Īmān).\" This is evidence for both the distinction (ikhtilāf) between the two terms and their overlap (tadākhul). This usage is the most consistent with the conventions of the language, because faith is a deed among deeds, and it is the most excellent of them. Islam is submission (taslīm), whether by the heart, by the tongue, or by the limbs. The most excellent of these is that which is by the heart, which is the assent (taṣdīq) that is called faith. Using the two terms in a way that indicates distinction, overlap, or even complete synonymy (tarāduf) is all within the bounds of metaphorical usage (tajawwuz) in the language.", "book_title": "Foundations of Belief", "section_title_ar": "Section 99", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 99: On the Distinction, Overlap, and Synonymy of Faith (Īmān) and Submission (Islām), and Their Worldly and Otherworldly Judgments", "section_index": 99, "anchors": "- Root: ايم (A-Y-M)\n  * Lisan / Ayn: Core meaning of remaining unmarried, or a state of being without a spouse; extended metaphorically to describe one who is solitary or without support.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها... والحرب مأيمة، أي: يفرق بين الزوج والزوجة.\" The root carries the sense of separation or a state of lacking union, which informs the theological discussion of what constitutes the essential bond of faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the state of being unmarried; metaphorical (Majaz) usage extends to anything that separates or leaves one bereft. This distinction between literal and metaphorical application is central to the chapter's method.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه... والانقلاب: الانصراف.\" The heart (qalb) is so named for its constant fluctuation and turning. In theological terms, it is the seat of taṣdīq (assent), the immaterial faculty of cognition and conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is physical turning; metaphorical (Majaz) usage is \"قلب الأمور\" — to deliberate, scrutinize, and manage affairs. This supports the distinction between the heart's internal act of assent and the external acts of the limbs.\n- Root: عمل (ʿ-A-M-L)\n  * Lisan / Ayn: Any deed or action performed with purpose and intent.\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد، فهو أخص من الفعل.\" Work is more specific than mere action, as it implies deliberate, intentional agency. It is used for both righteous and sinful deeds, and is the external manifestation of internal conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to physical labor or deeds. The chapter explores whether \"work\" is an integral part of the reality of faith or a separate, consequent requirement.\n- Root: صدق (S-D-Q)\n  * Lisan / Ayn: To be truthful, to speak the truth, to verify.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول.\" Truth and falsehood are primarily properties of speech and reports. Taṣdīq (assent) is the heart's affirmation of the truth of a report, which is the core reality of Īmān.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is truthful speech; metaphorical (Majaz) usage is \"صادق الحملة\" — one who is true and firm in battle or resolve. This shows that taṣdīq is not merely verbal but a firm, internal resolution.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication). This rule governs how restriction (ḥaṣr) is achieved in Arabic, often through particles like \"innamā\" or through contextual specification (takhṣīṣ). The chapter's core argument hinges on how terms like Īmān and Islām are semantically restricted, expanded, or made synonymous through contextual usage (majāz), requiring precise parsing of the predicate and its scope.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Foundations of Belief'", "badge": "Afterlife"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 1938], [2, 1938, 2967], [3, 2967, 4956], [4, 4956, 7322], [5, 7322, 9413], [6, 9413, 11452]], "2": [[1, 350, 1158], [2, 1158, 2846], [3, 2846, 4939]], "3": [[1, 400, 1614], [2, 1614, 3269], [3, 3269, 4940], [4, 4940, 6616], [5, 6616, 8174], [6, 8174, 8905], [7, 8905, 10538], [8, 10538, 10946], [9, 10946, 12602]], "4": [[1, 400, 1307], [2, 1307, 2710], [3, 2710, 3356], [4, 3356, 5169], [5, 5169, 7057], [6, 7057, 8963], [7, 8963, 9683], [8, 9683, 11397], [9, 11397, 12117], [10, 12117, 13882]], "5": [[1, 400, 2255], [2, 2255, 3634], [3, 3634, 4342], [4, 4342, 5757], [5, 5757, 7270], [6, 7270, 8100], [7, 8100, 8710], [8, 8710, 10321], [9, 10321, 10785], [10, 10785, 12784]], "6": [[1, 400, 1887], [2, 1887, 3482], [3, 3482, 5150], [4, 5150, 5633], [5, 5633, 6539], [6, 6539, 7651], [7, 7651, 8788]], "7": [[1, 400, 1217], [2, 1217, 2568], [3, 2568, 4700], [4, 4700, 6989], [5, 6989, 9672], [6, 9672, 11627], [7, 11627, 13475], [8, 13475, 16140], [9, 16140, 18255], [10, 18255, 19712], [11, 19712, 20672], [12, 20672, 23124], [13, 23124, 25150], [14, 25150, 26323], [15, 26323, 28704], [16, 28704, 31227]], "8": [[1, 400, 2144], [2, 2144, 4583], [3, 4583, 6025], [4, 6025, 6659], [5, 6659, 7956], [6, 7956, 8533], [7, 8533, 9254], [8, 9254, 11085], [9, 11085, 12094], [10, 12094, 13853], [11, 13853, 15759], [12, 15759, 16898], [13, 16898, 17691], [14, 17691, 19916]], "9": [[1, 400, 3100], [2, 3100, 4734], [3, 4734, 5770], [4, 5770, 6847], [5, 6847, 8484], [6, 8484, 10094]], "10": [[1, 400, 1847], [2, 1847, 3353], [3, 3353, 5140], [4, 5140, 6883], [5, 6883, 8256], [6, 8256, 10368], [7, 10368, 12616], [8, 12616, 14285], [9, 14285, 16013], [10, 16013, 17047], [11, 17047, 18834], [12, 18834, 21315], [13, 21315, 22083], [14, 22083, 22999], [15, 22999, 24520], [16, 24520, 25288], [17, 25288, 26824], [18, 26824, 28190], [19, 28190, 30522]], "11": [[1, 400, 1974], [2, 1974, 2666], [3, 2666, 3808], [4, 3808, 5036], [5, 5036, 6333], [6, 6333