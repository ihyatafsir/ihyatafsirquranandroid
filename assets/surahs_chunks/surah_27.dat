: "فَتَبَسَّمَ ضَاحِكاࣰ مِّن قَوْلِهَا وَقَالَ رَبِّ أَوْزِعْنِيَ أَنَ اَشْكُرَ نِعْمَتَكَ اَ۬لتِےٓ أَنْعَمْتَ عَلَيَّ وَعَلَيٰ وَٰلِدَيَّ وَأَنَ اَعْمَلَ صَٰلِحاࣰ تَرْض۪يٰهُ وَأَدْخِلْنِے بِرَحْمَتِكَ فِے عِبَادِكَ اَ۬لصَّٰلِحِينَۖ", "words": [{"id": 1, "arabic": "فَتَبَسَّمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "ضَاحِكاࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَوْلِهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "وَقَالَ", "translit": "", "root": ""}, {"id": 6, "arabic": "رَبِّ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَوْزِعْنِيَ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَنَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَشْكُرَ", "translit": "", "root": ""}, {"id": 10, "arabic": "نِعْمَتَكَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لتِےٓ", "translit": "", "root": ""}, {"id": 12, "arabic": "أَنْعَمْتَ", "translit": "", "root": ""}, {"id": 13, "arabic": "عَلَيَّ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَعَلَيٰ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَٰلِدَيَّ", "translit": "", "root": ""}, {"id": 16, "arabic": "وَأَنَ", "translit": "", "root": ""}, {"id": 17, "arabic": "اَعْمَلَ", "translit": "", "root": ""}, {"id": 18, "arabic": "صَٰلِحاࣰ", "translit": "", "root": ""}, {"id": 19, "arabic": "تَرْض۪يٰهُ", "translit": "", "root": ""}, {"id": 20, "arabic": "وَأَدْخِلْنِے", "translit": "", "root": ""}, {"id": 21, "arabic": "بِرَحْمَتِكَ", "translit": "", "root": ""}, {"id": 22, "arabic": "فِے", "translit": "", "root": ""}, {"id": 23, "arabic": "عِبَادِكَ", "translit": "", "root": ""}, {"id": 24, "arabic": "اَ۬لصَّٰلِحِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 20, "text": "وَتَفَقَّدَ اَ۬لطَّيْرَ فَقَالَ مَا لِے لَآ أَرَي اَ۬لْهُدْهُدَ أَمْ كَانَ مِنَ اَ۬لْغَآئِبِينَۖ", "words": [{"id": 1, "arabic": "وَتَفَقَّدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لطَّيْرَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَقَالَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "لِے", "translit": "", "root": ""}, {"id": 6, "arabic": "لَآ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَرَي", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لْهُدْهُدَ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 11, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬لْغَآئِبِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 21, "text": "لَأُعَذِّبَنَّهُۥ عَذَاباࣰ شَدِيداً اَوْ لَأَاْذْبَحَنَّهُۥٓ أَوْ لَيَاتِيَنِّے بِسُلْطَٰنࣲ مُّبِينࣲۖ", "words": [{"id": 1, "arabic": "لَأُعَذِّبَنَّهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَذَاباࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "شَدِيداً", "translit": "", "root": ""}, {"id": 4, "arabic": "اَوْ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَأَاْذْبَحَنَّهُۥٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَوْ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَيَاتِيَنِّے", "translit": "", "root": ""}, {"id": 8, "arabic": "بِسُلْطَٰنࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "مُّبِينࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 22, "text": "فَمَكُثَ غَيْرَ بَعِيدࣲۖ فَقَالَ أَحَطْتُّ بِمَا لَمْ تُحِطْ بِهِۦ وَجِئْتُكَ مِن سَبَإِۢ بِنَبَإࣲ يَقِينٍۖ", "words": [{"id": 1, "arabic": "فَمَكُثَ", "translit": "", "root": ""}, {"id": 2, "arabic": "غَيْرَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بَعِيدࣲۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَقَالَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَحَطْتُّ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "لَمْ", "translit": "", "root": ""},