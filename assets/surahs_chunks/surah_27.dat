 "وَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "", "root": ""}, {"id": 7, "arabic": "يَشْعُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 51, "text": "فَانظُرْ كَيْفَ كَانَ عَٰقِبَةُ مَكْرِهِمُۥٓۖ إِنَّا دَمَّرْنَٰهُمْ وَقَوْمَهُمُۥٓ أَجْمَعِينَۖ", "words": [{"id": 1, "arabic": "فَانظُرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَيْفَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَٰقِبَةُ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَكْرِهِمُۥٓۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "دَمَّرْنَٰهُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَقَوْمَهُمُۥٓ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَجْمَعِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 52, "text": "فَتِلْكَ بُيُوتُهُمْ خَاوِيَةَۢ بِمَا ظَلَمُوٓاْۖ إِنَّ فِے ذَٰلِكَ لَأٓيَةࣰ لِّقَوْمࣲ يَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "فَتِلْكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بُيُوتُهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "خَاوِيَةَۢ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "ظَلَمُوٓاْۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَأٓيَةࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "لِّقَوْمࣲ", "translit": "", "root": ""}, {"id": 11, "arabic": "يَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 53, "text": "وَأَنجَيْنَا اَ۬لذِينَ ءَامَنُواْ وَكَانُواْ يَتَّقُونَۖ", "words": [{"id": 1, "arabic": "وَأَنجَيْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَكَانُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَتَّقُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 54, "text": "وَلُوطاً اِذْ قَالَ لِقَوْمِهِۦٓ أَتَاتُونَ اَ۬لْفَٰحِشَةَ وَأَنتُمْ تُبْصِرُونَۖ", "words": [{"id": 1, "arabic": "وَلُوطاً", "translit": "", "root": ""}, {"id": 2, "arabic": "اِذْ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِقَوْمِهِۦٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَتَاتُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْفَٰحِشَةَ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَأَنتُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "تُبْصِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 55, "text": "أَئِنَّكُمْ لَتَاتُونَ اَ۬لرِّجَالَ شَهْوَةࣰ مِّن دُونِ اِ۬لنِّسَآءِۖ بَلَ اَنتُمْ قَوْمࣱ تَجْهَلُونَۖ", "words": [{"id": 1, "arabic": "أَئِنَّكُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَتَاتُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لرِّجَالَ", "translit": "", "root": ""}, {"id": 4, "arabic": "شَهْوَةࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 6, "arabic": "دُونِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لنِّسَآءِۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "بَلَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَنتُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "قَوْمࣱ", "translit": "", "root": ""}, {"id": 11, "arabic": "تَجْهَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 56, "text": "۞فَمَا كَانَ جَوَابَ قَوْمِهِۦٓ إِلَّآ أَن قَالُوٓاْ أَخْرِجُوٓاْ ءَالَ لُوطࣲ مِّن قَرْيَتِكُمُۥٓۖ إِنَّهُمُۥٓ أُنَاسࣱ يَتَطَهَّرُونَۖ", "words": [{"id": 1, "arabic": "۞فَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 3, "arabic": "جَوَابَ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَوْمِهِۦٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَن", "translit": "", "root": ""}, {"id": 7, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَخْرِجُوٓاْ", "translit": "", "root": ""}, {"id": 9, "arabic": "ءَالَ", "translit": "", "root": ""}, {"id": 10, "arabic": "لُوطࣲ", "translit": "", "root": ""}, {"id": 11, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 12, "arabic": "قَرْيَتِكُمُۥٓۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "إِنَّهُمُۥٓ", "translit": "", "root": ""}, {"id": 14, "arabic": "أُنَاسࣱ", "translit": "", "root": ""}, {"id": 15, "arabic": "يَتَطَهَّرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 57, "text": "فَأَنجَيْنَٰهُ وَأَهْلَهُۥٓ إِلَّا اَ۪مْرَأَتَهُۥ قَدَّرْنَٰهَا مِنَ اَ۬لْغَٰبِرِينَۖ", "words": [{"id": 1, "arabic": "فَأَنجَيْنَٰهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَأَهْلَهُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۪مْرَأَتَهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَدَّرْنَٰهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْغَٰبِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 27, "ayah": 58, "text": "وَأَمْطَرْنَا عَلَيْهِم مَّطَراࣰۖ فَسَآءَ مَطَرُ اُ۬لْمُنذَرِينَۖ", "words": [{"id": 1, "arabic": "وَأَمْطَرْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِم", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّطَراࣰۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَسَآءَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَطَرُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لْمُنذَرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"},