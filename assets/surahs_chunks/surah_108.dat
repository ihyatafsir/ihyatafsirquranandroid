{"surah": 108, "verses": [{"ayah": 1, "text": "إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ ", "translation": "Indeed, We have granted you, [O Muḥammad], al-Kawthar.", "words": [{"id": 1, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 2, "arabic": "أَعْطَيْنَٰكَ", "translit": "َkَٰnْyَṭْʿعَaʾ", "root": "عطو"}, {"id": 3, "arabic": "ٱلْكَوْثَرَ", "translit": "َrَhtْwَkْlٱ", "root": "كثر"}], "hasIhya": false}, {"ayah": 2, "text": "فَصَلِّ لِرَبِّكَ وَٱنْحَرْ ", "translation": "So pray to your Lord and offer sacrifice [to Him alone].", "words": [{"id": 1, "arabic": "فَصَلِّ", "translit": "ِّlَṣَf", "root": "صلو"}, {"id": 2, "arabic": "لِرَبِّكَ", "translit": "َkِّbَrِl", "root": "ربب"}, {"id": 3, "arabic": "وَٱنْحَرْ", "translit": "ْrَḥْnٱَw", "root": "نحر"}], "hasIhya": false}, {"ayah": 3, "text": "إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ ", "translation": "Indeed, your enemy is the one cut off.[1]", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "شَانِئَكَ", "translit": "َkَyʾِnāَhs", "root": "شنا"}, {"id": 3, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 4, "arabic": "ٱلْأَبْتَرُ", "translit": "ُrَtْbَaʾْlٱ", "root": "بتر"}], "hasIhya": false}], "tafsir": {}, "wordTiming": {"abdulbasit": {"1": [[1, 350, 2187], [2, 2187, 4022], [3, 4022, 5409]], "2": [[1, 250, 1179], [2, 1179, 2268], [3, 2268, 3391]], "3": [[1, 350, 1089], [2, 1089, 2323], [3, 2323, 2809], [4, 2809, 3972]]}, "minshawi": {"1": [[1, 110, 2993], [2, 2993, 5024], [3, 5024, 6540]], "2": [[1, 270, 1270], [2, 1270, 2458], [3, 2458, 3920]], "3": [[1, 110, 883], [2, 883, 2520], [3, 2520, 3270], [4, 3270, 4600]]}, "abdulbasit_warsh": {"108:1": [[1, 600, 2021], [2, 2021, 4162], [3, 4162, 6930]], "1": [[1, 600, 2021], [2, 2021, 4162], [3, 4162, 6930]], "108:2": [[1, 350, 1037], [2, 1037, 1877], [3, 1877, 3665]], "2": [[1, 350, 1037], [2, 1037, 1877], [3, 1877, 3665]], "108:3": [[1, 440, 1019], [2, 1019, 2153], [3, 2153, 2557], [4, 2557, 4892]], "3": [[1, 4