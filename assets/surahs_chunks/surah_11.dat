t": "وَلَوْ شَآءَ رَبُّكَ لَجَعَلَ اَ۬لنَّاسَ أُمَّةࣰ وَٰحِدَةࣰۖ وَلَا يَزَالُونَ مُخْتَلِفِينَ", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 2, "arabic": "شَآءَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبُّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَجَعَلَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لنَّاسَ", "translit": "", "root": ""}, {"id": 6, "arabic": "أُمَّةࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَٰحِدَةࣰۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 9, "arabic": "يَزَالُونَ", "translit": "", "root": ""}, {"id": 10, "arabic": "مُخْتَلِفِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 119, "text": "إِلَّا مَن رَّحِمَ رَبُّكَۖ وَلِذَٰلِكَ خَلَقَهُمْۖ وَتَمَّتْ كَلِمَةُ رَبِّكَ لَأَمْلَأَنَّ جَهَنَّمَ مِنَ اَ۬لْجِنَّةِ وَالنَّاسِ أَجْمَعِينَۖ", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "", "root": ""}, {"id": 3, "arabic": "رَّحِمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبُّكَۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَلِذَٰلِكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "خَلَقَهُمْۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَتَمَّتْ", "translit": "", "root": ""}, {"id": 8, "arabic": "كَلِمَةُ", "translit": "", "root": ""}, {"id": 9, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَأَمْلَأَنَّ", "translit": "", "root": ""}, {"id": 11, "arabic": "جَهَنَّمَ", "translit": "", "root": ""}, {"id": 12, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 13, "arabic": "اَ۬لْجِنَّةِ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَالنَّاسِ", "translit": "", "root": ""}, {"id": 15, "arabic": "أَجْمَعِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 120, "text": "وَكُلّاࣰ نَّقُصُّ عَلَيْكَ مِنَ اَنۢبَآءِ اِ۬لرُّسُلِ مَا نُثَبِّتُ بِهِۦ فُؤَادَكَۖ وَجَآءَكَ فِے هَٰذِهِ اِ۬لْحَقُّ وَمَوْعِظَةࣱ وَذِكْر۪يٰ لِلْمُومِنِينَۖ", "words": [{"id": 1, "arabic": "وَكُلّاࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَّقُصُّ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَنۢبَآءِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لرُّسُلِ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَا", "translit": "", "root": ""}, {"id": 8, "arabic": "نُثَبِّتُ", "translit": "", "root": ""}, {"id": 9, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 10, "arabic": "فُؤَادَكَۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَجَآءَكَ", "translit": "", "root": ""}, {"id": 12, "arabic": "فِے", "translit": "", "root": ""}, {"id": 13, "arabic": "هَٰذِهِ", "translit": "", "root": ""}, {"id": 14, "arabic": "اِ۬لْحَقُّ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَمَوْعِظَةࣱ", "translit": "", "root": ""}, {"id": 16, "arabic": "وَذِكْر۪يٰ", "translit": "", "root": ""}, {"id": 17, "arabic": "لِلْمُومِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 121, "text": "وَقُل لِّلذِينَ لَا يُومِنُونَ اَ۪عْمَلُواْ عَلَيٰ مَكَانَتِكُمُۥٓ إِنَّا عَٰمِلُونَ", "words": [{"id": 1, "arabic": "وَقُل", "translit": "", "root": ""}, {"id": 2, "arabic": "لِّلذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يُومِنُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۪عْمَلُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَكَانَتِكُمُۥٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "عَٰمِلُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 122, "text": "وَانتَظِرُوٓاْ إِنَّا مُنتَظِرُونَۖ", "words": [{"id": 1, "arabic": "وَانتَظِرُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "مُنتَظِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 123, "text": "وَلِلهِ غَيْبُ اُ۬لسَّمَٰوَٰتِ وَالَارْضِۖ وَإِلَيْهِ يُرْجَعُ اُ۬لَامْرُ كُلُّهُۥۖ فَاعْبُدْهُ وَتَوَكَّلْ عَلَيْهِۖ وَمَا رَبُّكَ بِغَٰفِلٍ عَمَّا تَعْمَلُونَۖ", "words": [{"id": 1, "arabic": "وَلِلهِ", "translit": "", "root": ""}, {"id": 2, "arabic": "غَيْبُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالَارْضِۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَإِلَيْهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "يُرْجَعُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لَامْرُ", "translit": "", "root": ""}, {"id": 8, "arabic": "كُلُّهُۥۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "فَاعْبُدْهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَتَوَكَّلْ", "translit": "", "root": ""}, {"id": 11, "arabic": "عَلَيْهِۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 13, "arabic": "رَبُّكَ", "translit": "", "root": ""}, {"id": 14, "arabic": "بِغَٰفِلٍ", "translit": "", "root": ""}, {"id": 15, "arabic": "عَمَّا", "translit": "", "root": ""}, {"id": 16, "arabic": "تَعْمَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}]}