}, {"surah": 11, "ayah": 79, "text": "قَالُواْ لَقَدْ عَلِمْتَ مَا لَنَا فِے بَنَاتِكَ مِنْ حَقࣲّ وَإِنَّكَ لَتَعْلَمُ مَا نُرِيدُۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَقَدْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلِمْتَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "لَنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "بَنَاتِكَ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 9, "arabic": "حَقࣲّ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَإِنَّكَ", "translit": "", "root": ""}, {"id": 11, "arabic": "لَتَعْلَمُ", "translit": "", "root": ""}, {"id": 12, "arabic": "مَا", "translit": "", "root": ""}, {"id": 13, "arabic": "نُرِيدُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 80, "text": "قَالَ لَوَ اَنَّ لِے بِكُمْ قُوَّةً اَوَ اٰوِےٓ إِلَيٰ رُكْنࣲ شَدِيدࣲۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَوَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَنَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِے", "translit": "", "root": ""}, {"id": 5, "arabic": "بِكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "قُوَّةً", "translit": "", "root": ""}, {"id": 7, "arabic": "اَوَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اٰوِےٓ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 10, "arabic": "رُكْنࣲ", "translit": "", "root": ""}, {"id": 11, "arabic": "شَدِيدࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 81, "text": "قَالُواْ يَٰلُوطُ إِنَّا رُسُلُ رَبِّكَ لَنْ يَّصِلُوٓاْ إِلَيْكَۖ فَاسْرِ بِأَهْلِكَ بِقِطْعࣲ مِّنَ اَ۬ليْلِ وَلَا يَلْتَفِتْ مِنكُمُۥٓ أَحَدٌ اِلَّا اَ۪مْرَأَتَكَۖ إِنَّهُۥ مُصِيبُهَا مَآ أَصَابَهُمُۥٓۖ إِنَّ مَوْعِدَهُمُ