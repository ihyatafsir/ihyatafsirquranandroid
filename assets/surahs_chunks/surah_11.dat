": ""}, {"id": 6, "arabic": "اِ۬لَاخِرَةِ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لنَّارُۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَحَبِطَ", "translit": "", "root": ""}, {"id": 10, "arabic": "مَا", "translit": "", "root": ""}, {"id": 11, "arabic": "صَنَعُواْ", "translit": "", "root": ""}, {"id": 12, "arabic": "فِيهَاۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَبَٰطِلࣱ", "translit": "", "root": ""}, {"id": 14, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 15, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 16, "arabic": "يَعْمَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 17, "text": "أَفَمَن كَانَ عَلَيٰ بَيِّنَةࣲ مِّن رَّبِّهِۦ وَيَتْلُوهُ شَاهِدࣱ مِّنْهُۖ وَمِن قَبْلِهِۦ كِتَٰبُ مُوس۪يٰٓ إِمَاماࣰ وَرَحْمَةًۖ ا۟وْلَٰٓئِكَ يُومِنُونَ بِهِۦۖ وَمَنْ يَّكْفُرْ بِهِۦ مِنَ اَ۬لَاحْزَابِ فَالنَّارُ مَوْعِدُهُۥۖ فَلَا تَكُ فِے مِرْيَةࣲ مِّنْهُۖ إِنَّهُ اُ۬لْحَقُّ مِن رَّبِّكَۖ وَلَٰكِنَّ أَكْثَرَ اَ۬لنَّاسِ لَا يُومِنُونَۖ", "words": [{"id": 1, "arabic": "أَفَمَن", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "بَيِّنَةࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 6, "arabic": "رَّبِّهِۦ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَيَتْلُوهُ", "translit": "", "root": ""}, {"id": 8, "arabic": "شَاهِدࣱ", "translit": "", "root": ""}, {"id": 9, "arabic": "مِّنْهُۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَمِن", "translit": "", "root": ""}, {"id": 11, "arabic": "قَبْلِهِۦ", "translit": "", "root": ""}, {"id": 12, "arabic": "كِتَٰبُ", "translit": "", "root": ""}, {"id": 13, "arabic": "مُوس۪يٰٓ", "translit": "", "root": ""}, {"id": 14, "arabic": "إِمَاماࣰ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَرَحْمَةًۖ", "translit