32601], [27, 32601, 33111], [28, 33111, 34663], [29, 34663, 35717], [30, 35717, 36458], [31, 36458, 37836]], "8": [[1, 400, 1414], [2, 1414, 2834], [3, 2834, 3700], [4, 3700, 5009], [5, 5009, 6297], [6, 6297, 7237], [7, 7237, 8916], [8, 8916, 10901], [9, 10901, 11450], [10, 11450, 12937], [11, 12937, 13740], [12, 13740, 14585], [13, 14585, 16085], [14, 16085, 16845], [15, 16845, 18408], [16, 18408, 19274], [17, 19274, 20415], [18, 20415, 21028], [19, 21028, 21883], [20, 21883, 23298], [21, 23298, 23699], [22, 23699, 25558]], "9": [[1, 400, 1645], [2, 1645, 3305], [3, 3305, 4928], [4, 4928, 6238], [5, 6238, 7249], [6, 7249, 8170], [7, 8170, 10063], [8, 10063, 10815], [9, 10815, 11995], [10, 11995, 13395], [11, 13395, 14561]], "10": [[1, 400, 1616], [2, 1616, 3213], [3, 3213, 5281], [4, 5281, 6092], [5, 6092, 8122], [6, 8122, 9345], [7, 9345, 11537], [8, 11537, 12297], [9, 12297, 14514], [10, 14514, 16427], [11, 16427, 17580], [12, 17580, 18619], [13, 18619, 19785]], "11": [[1, 400, 1331], [2, 1331, 2487], [3, 2487, 3796], [4, 3796, 5391], [5, 5391, 7170], [6, 7170, 8724], [7, 8724, 9317], [8, 9317, 10616], [9, 10616, 11628], [10, 11628, 12549]], "12": [[1, 400, 2123], [2, 2123, 3455], [3, 3455, 4469], [4, 4469, 5222], [5, 5222, 7539], [6, 7539, 8900], [7, 8900, 11640], [8, 11640, 12190], [9, 12190, 13508], [10, 13508, 14145], [11, 14145, 16549], [12, 16549, 18768], [13, 18768, 19985], [14, 19985, 21317], [15, 21317, 22186], [16, 22186, 22968], [17, 22968, 24694], [18, 24694, 25592], [19, 25592, 26461], [20, 26461, 29013], [21, 29013, 29940], [22, 29940, 31272], [23, 31272, 32851], [24, 32851, 34183], [25, 34183, 34980], [26, 34980, 35994], [27, 35994, 37444]], "13": [[1, 400, 889], [2, 889, 2602], [3, 2602, 4070], [4, 4070, 4559], [5, 4559, 5960], [6, 5960, 6939], [7, 6939, 7740], [8, 7740, 8952], [9, 8952, 10598], [10, 10598, 12233], [11, 12233, 12678], [12, 12678, 14213], [13, 14213, 14980], [14, 14980, 15758], [15, 15758, 16637], [16, 16637, 17126], [17, 17126, 18