: 10, "arabic": "ٱلْأَمْرُ", "translit": "ُrْmَaʾْlٱ", "root": "امر"}, {"id": 11, "arabic": "وَٱسْتَوَتْ", "translit": "ْtَwَtْsٱَw", "root": "سوي"}, {"id": 12, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 13, "arabic": "ٱلْجُودِىِّ", "translit": "ِّàِdwُjgْlٱ", "root": "جود"}, {"id": 14, "arabic": "وَقِيلَ", "translit": "َlyِqَw", "root": "قول"}, {"id": 15, "arabic": "بُعْدًا", "translit": "āًdْʿعُb", "root": "بعد"}, {"id": 16, "arabic": "لِّلْقَوْمِ", "translit": "ِmْwَqْlِّl", "root": "قوم"}, {"id": 17, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 45, "text": "وَنَادَىٰ نُوحٌ رَّبَّهُۥ فَقَالَ رَبِّ إِنَّ ٱبْنِى مِنْ أَهْلِى وَإِنَّ وَعْدَكَ ٱلْحَقُّ وَأَنتَ أَحْكَمُ ٱلْحَٰكِمِينَ ", "translation": "And Noah called to his Lord and said, \"My Lord, indeed my son is of my family; and indeed, Your promise is true; and You are the most just of judges!\"", "words": [{"id": 1, "arabic": "وَنَادَىٰ", "translit": "ٰàَdāَnَw", "root": "ندي"}, {"id": 2, "arabic": "نُوحٌ", "translit": "ٌḥwُn", "root": ""}, {"id": 3, "arabic": "رَّبَّهُۥ", "translit": "ۥُhَّbَّr", "root": "ربب"}, {"id": 4, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 5, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 6, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 7, "arabic": "ٱبْنِى", "translit": "àِnْbٱ", "root": "بني"}, {"id": 8, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 9, "arabic": "أَهْلِى", "translit": "àِlْhَaʾ", "root": "اهل"}, {"id": 10, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 11, "arabic": "وَعْدَكَ", "translit": "َkَdْʿعَw", "root": "وعد"}, {"id": 12, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 13, "arabic": "وَأَنتَ", "translit": "َtnَaʾَw", "root": ""}, {"id": 14, "arabic": "أَحْكَمُ", "translit": "ُmَkْḥَaʾ", "root": "حكم"}, {"id": 15, "arabic": "ٱلْحَٰكِمِينَ", "translit": "َnyِmِkَٰḥْlٱ", "root": "حكم"}], "hasIhya": true}, {"ayah": 46, "text": "قَالَ يَٰنُوحُ إِنَّهُۥ لَيْسَ مِنْ أَهْلِكَۖ إِنَّهُۥ عَمَلٌ غَيْرُ صَٰلِحٍۖ فَلَا تَسْـَٔلْنِ مَا لَيْسَ لَكَ بِهِۦ عِلْمٌۖ إِنِّىٓ أَعِظُكَ أَن تَكُونَ مِنَ ٱلْجَٰهِلِينَ ", "translation": "He said, \"O Noah, indeed he is not of your family; indeed, he is [one whose] work was other than righteous, so ask Me not for that about which you have no knowledge. Indeed, I advise you, lest you be among the ignorant.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰنُوحُ", "translit": "ُḥwُnَٰy", "root": ""}, {"id": 3, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 4, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 5, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 6, "arabic": "أَهْلِكَ", "translit": "َkِlْhَaʾ", "root": "اهل"}, {"id": 7, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 8, "arabic": "عَمَلٌ", "translit": "ٌlَmَʿع", "root": "عمل"}, {"id": 9, "arabic": "غَيْرُ", "translit": "ُrْyَغ", "root": "غير"}, {"id": 10, "arabic": "صَٰلِحٍ", "translit": "ٍḥِlَٰṣ", "root": "صلح"}, {"id": 11, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 12, "arabic": "تَسْـَٔلْنِ", "translit": "ِnْlَٔـْsَt", "root": "سال"}, {"id": 13, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 14, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 15, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 16, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 17, "arabic": "عِلْمٌ", "translit": "ٌmْlِʿع", "root": "علم"}, {"id": 18, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 19, "arabic": "أَعِظُكَ", "translit": "َkُẓِʿعَaʾ", "root": "وعظ"}, {"id": 20, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 21, "arabic": "تَكُونَ", "translit": "َnwُkَt", "root": "كون"}, {"id": 22, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 23, "arabic": "ٱلْجَٰهِلِينَ", "translit": "َnyِlِhَٰjgْlٱ", "root": "جهل"}], "hasIhya": true}, {"ayah": 47, "text": "قَالَ رَبِّ إِنِّىٓ أَعُوذُ بِكَ أَنْ أَسْـَٔلَكَ مَا لَيْسَ لِى بِهِۦ عِلْمٌۖ وَإِلَّا تَغْفِرْ لِى وَتَرْحَمْنِىٓ أَكُن مِّنَ ٱلْخَٰسِرِينَ ", "translation": "[Noah] said, \"My Lord, I seek refuge in You from asking that of which I have no knowledge. And unless You forgive me and have mercy upon me, I will be among the losers.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 3, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 4, "arabic": "أَعُوذُ", "translit": "ُhdwُʿعَaʾ", "root": "عوذ"}, {"id": 5, "arabic": "بِكَ", "translit": "َkِb", "root": ""}, {"id": 6, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 7, "arabic": "أَسْـَٔلَكَ", "translit": "َkَlَٔـْsَaʾ", "root": "سال"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 10, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 11, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 12, "arabic": "عِلْمٌ", "translit": "ٌmْlِʿع", "root": "علم"}, {"id": 13, "arabic": "وَإِلَّا", "translit": "āَّlِiʾَw", "root": ""}, {"id": 14, "arabic": "تَغْفِرْ", "translit": "ْrِfْغَt", "root": "غفر"}, {"id": 15, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 16, "arabic": "وَتَرْحَمْنِىٓ", "translit": "ٓàِnْmَḥْrَtَw", "root": "رحم"}, {"id": 17, "arabic": "أَكُن", "translit": "nُkَaʾ", "root": "كون"}, {"id": 18, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 19, "arabic": "ٱلْخَٰسِرِينَ", "translit": "َnyِrِsَٰhkْlٱ", "root": "خسر"}], "hasIhya": false}, {"ayah": 48, "text": "قِيلَ يَٰنُوحُ ٱهْبِطْ بِسَلَٰمٍ مِّنَّا وَبَرَكَٰتٍ عَلَيْكَ وَعَلَىٰٓ أُمَمٍ مِّمَّن مَّعَكَۚ وَأُمَمٌ سَنُمَتِّعُهُمْ ثُمَّ يَمَسُّهُم مِّنَّا عَذَابٌ أَلِيمٌ ", "translation": "It was said, \"O Noah, disembark in security from Us and blessings upon you and upon nations [descending] from those with you. But other nations [of them] We will grant enjoyment; then there will touch them from Us a painful punishment.\"", "words": [{"id": 1, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 2, "arabic": "يَٰنُوحُ", "translit": "ُḥwُnَٰy", "root": ""}, {"id": 3, "arabic": "ٱهْبِطْ", "translit": "ْṭِbْhٱ", "root": "هبط"}, {"id": 4, "arabic": "بِسَلَٰمٍ", "translit": "ٍmَٰlَsِb", "root": "سلم"}, {"id": 5, "arabic": "مِّنَّا", "translit": "āَّnِّm", "root": ""}, {"id": 6, "arabic": "وَبَرَكَٰتٍ", "translit": "ٍtَٰkَrَbَw", "root": "برك"}, {"id": 7, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 8, "arabic": "وَعَلَىٰٓ", "translit": "ٰٓàَlَʿعَw", "root": ""}, {"id": 9, "arabic": "أُمَمٍ", "translit": "ٍmَmُaʾ", "root": "امم"}, {"id": 10, "arabic": "مِّمَّن", "translit": "nَّmِّm", "root": ""}, {"id": 11, "arabic": "مَّعَكَ", "translit": "َkَʿعَّm", "root": ""}, {"id": 12, "arabic": "وَأُمَمٌ", "translit": "ٌmَmُaʾَw", "root": "امم"}, {"id": 13, "arabic": "سَنُمَتِّعُهُمْ", "translit": "ْmُhُʿعِّtَmُnَs", "root": "متع"}, {"id": 14, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 15, "arabic": "يَمَسُّهُم", "translit": "mُhُّsَmَy", "root": "مسس"}, {"id": 16, "arabic": "مِّنَّا", "translit": "āَّnِّm", "root": ""}, {"id": 17, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 18, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 49, "text": "تِلْكَ مِنْ أَنۢبَآءِ ٱلْغَيْبِ نُوحِيهَآ إِلَيْكَۖ مَا كُنتَ تَعْلَمُهَآ أَنتَ وَلَا قَوْمُكَ مِن قَبْلِ هَٰذَاۖ فَٱصْبِرْۖ إِنَّ ٱلْعَٰقِبَةَ لِلْمُتَّقِينَ ", "translation": "That is from the news of the unseen which We reveal to you, [O Muḥammad]. You knew it not, neither you nor your people, before this. So be patient; indeed, the [best] outcome is for the righteous.", "words": [{"id": 1, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 2, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 3, "arabic": "أَنۢبَآءِ", "translit": "ِءٓāَbۢnَaʾ", "root": "نبا"}, {"id": 4, "arabic": "ٱلْغَيْبِ", "translit": "ِbْyَغْlٱ", "root": "غيب"}, {"id": 5, "arabic": "نُوحِيهَآ", "translit": "ٓāَhyِḥwُn", "root": "وحي"}, {"id": 6, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 9, "arabic": "تَعْلَمُهَآ", "translit": "ٓāَhُmَlْʿعَt", "root": "علم"}, {"id": 10, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "قَوْمُكَ", "translit": "َkُmْwَq", "root": "قوم"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "قَبْلِ", "translit": "ِlْbَq", "root": "قبل"}, {"id": 15, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 16, "arabic": "فَٱصْبِرْ", "translit": "ْrِbْṣٱَf", "root": "صبر"}, {"id": 17, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 18, "arabic": "ٱلْعَٰقِبَةَ", "translit": "َẗَbِqَٰʿعْlٱ", "root": "عقب"}, {"id": 19, "arabic": "لِلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlِl", "root": "وقي"}], "hasIhya": false}, {"ayah": 50, "text": "وَإِلَىٰ عَادٍ أَخَاهُمْ هُودًاۚ قَالَ يَٰقَوْمِ ٱعْبُدُوا۟ ٱللَّهَ مَا لَكُم مِّنْ إِلَٰهٍ غَيْرُهُۥٓۖ إِنْ أَنتُمْ إِلَّا مُفْتَرُونَ ", "translation": "And to ʿAad [We sent] their brother Hūd. He said, \"O my people, worship Allāh; you have no deity other than Him. You are not but inventors [of falsehood].", "words": [{"id": 1, "arabic": "وَإِلَىٰ", "translit": "ٰàَlِiʾَw", "root": ""}, {"id": 2, "arabic": "عَادٍ", "translit": "ٍdāَʿع", "root": "عود"}, {"id": 3, "arabic": "أَخَاهُمْ", "translit": "ْmُhāَhkَaʾ", "root": "اخو"}, {"id": 4, "arabic": "هُودًا", "translit": "āًdwُh", "root": "هود"}, {"id": 5, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 6, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 7, "arabic": "ٱعْبُدُوا۟", "translit": "۟āwُdُbْʿعٱ", "root": "عبد"}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 11, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 12, "arabic": "إِلَٰهٍ", "translit": "ٍhَٰlِiʾ", "root": "اله"}, {"id": 13, "arabic": "غَيْرُهُۥٓ", "translit": "ٓۥُhُrْyَغ", "root": "غير"}, {"id": 14, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 15, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 16, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 17, "arabic": "مُفْتَرُونَ", "translit": "َnwُrَtْfُm", "root": "فري"}], "hasIhya": false}, {"ayah": 51, "text": "يَٰقَوْمِ لَآ أَسْـَٔلُكُمْ عَلَيْهِ أَجْرًاۖ إِنْ أَجْرِىَ إِلَّا عَلَى ٱلَّذِى فَطَرَنِىٓۚ أَفَلَا تَعْقِلُونَ ", "translation": "O my people, I do not ask you for it [i.e., my advice] any reward. My reward is only from the one who created me. Then will you not reason?", "words": [{"id": 1, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 2, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 3, "arabic": "أَسْـَٔلُكُمْ", "translit": "ْmُkُlَٔـْsَaʾ", "root": "سال"}, {"id": 4, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 5, "arabic": "أَجْرًا", "translit": "āًrْjgَaʾ", "root": "اجر"}, {"id": 6, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 7, "arabic": "أَجْرِىَ", "translit": "َàِrْjgَaʾ", "root": "اجر"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 10, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "فَطَرَنِىٓ", "translit": "ٓàِnَrَṭَf", "root": "فطر"}, {"id": 12, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 13, "arabic": "تَعْقِلُونَ", "translit": "َnwُlِqْʿعَt", "root": "عقل"}], "hasIhya": false}, {"ayah": 52, "text": "وَيَٰقَوْمِ ٱسْتَغْفِرُوا۟ رَبَّكُمْ ثُمَّ تُوبُوٓا۟ إِلَيْهِ يُرْسِلِ ٱلسَّمَآءَ عَلَيْكُم مِّدْرَارًا وَيَزِدْكُمْ قُوَّةً إِلَىٰ قُوَّتِكُمْ وَلَا تَتَوَلَّوْا۟ مُجْرِمِينَ ", "translation": "And O my people, ask forgiveness of your Lord and then repent to Him. He will send [rain from] the sky upon you in showers and increase you in strength [added] to your strength. And do not turn away, [being] criminals.\"", "words": [{"id": 1, "arabic": "وَيَٰقَوْمِ", "translit": "ِmْwَqَٰyَw", "root": "قوم"}, {"id": 2, "arabic": "ٱسْتَغْفِرُوا۟", "translit": "۟āwُrِfْغَtْsٱ", "root": "غفر"}, {"id": 3, "arabic": "رَبَّكُمْ", "translit": "ْmُkَّbَr", "root": "ربب"}, {"id": 4, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 5, "arabic": "تُوبُوٓا۟", "translit": "۟āٓwُbwُt", "root": "توب"}, {"id": 6, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 7, "arabic": "يُرْسِلِ", "translit": "ِlِsْrُy", "root": "رسل"}, {"id": 8, "arabic": "ٱلسَّمَآءَ", "translit": "َءٓāَmَّslٱ", "root": "سمو"}, {"id": 9, "arabic": "عَلَيْكُم", "translit": "mُkْyَlَʿع", "root": ""}, {"id": 10, "arabic": "مِّدْرَارًا", "translit": "āًrāَrْdِّm", "root": "درر"}, {"id": 11, "arabic": "وَيَزِدْكُمْ", "translit": "ْmُkْdِzَyَw", "root": "زيد"}, {"id": 12, "arabic": "قُوَّةً", "translit": "ًẗَّwُq", "root": "قوي"}, {"id": 13, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 14, "arabic": "قُوَّتِكُمْ", "translit": "ْmُkِtَّwُq", "root": "قوي"}, {"id": 15, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 16, "arabic": "تَتَوَلَّوْا۟", "translit": "۟āْwَّlَwَtَt", "root": "ولي"}, {"id": 17, "arabic": "مُجْرِمِينَ", "translit": "َnyِmِrْjgُm", "root": "جرم"}], "hasIhya": false}, {"ayah": 53, "text": "قَالُوا۟ يَٰهُودُ مَا جِئْتَنَا بِبَيِّنَةٍ وَمَا نَحْنُ بِتَارِكِىٓ ءَالِهَتِنَا عَن قَوْلِكَ وَمَا نَحْنُ لَكَ بِمُؤْمِنِينَ ", "translation": "They said, \"O Hūd, you have not brought us clear evidence, and we are not ones to leave our gods on your say-so. Nor are we believers in you.", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰهُودُ", "translit": "ُdwُhَٰy", "root": "هود"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "جِئْتَنَا", "translit": "āَnَtْyʾِjg", "root": "جيا"}, {"id": 5, "arabic": "بِبَيِّنَةٍ", "translit": "ٍẗَnِّyَbِb", "root": "بين"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 8, "arabic": "بِتَارِكِىٓ", "translit": "ٓàِkِrāَtِb", "root": "ترك"}, {"id": 9, "arabic": "ءَالِهَتِنَا", "translit": "āَnِtَhِlāَء", "root": "اله"}, {"id": 10, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 11, "arabic": "قَوْلِكَ", "translit": "َkِlْwَq", "root": "قول"}, {"id": 12, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 13, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 14, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 15, "arabic": "بِمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmِb", "root": "امن"}], "hasIhya": false}, {"ayah": 54, "text": "إِن نَّقُولُ إِلَّا ٱعْتَرَىٰكَ بَعْضُ ءَالِهَتِنَا بِسُوٓءٍۗ قَالَ إِنِّىٓ أُشْهِدُ ٱللَّهَ وَٱشْهَدُوٓا۟ أَنِّى بَرِىٓءٌ مِّمَّا تُشْرِكُونَ ", "translation": "We only say that some of our gods have possessed you with evil [i.e., insanity].\" He said, \"Indeed, I call Allāh to witness, and witness [yourselves] that I am free from whatever you associate with Allāh", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "نَّقُولُ", "translit": "ُlwُqَّn", "root": "قول"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱعْتَرَىٰكَ", "translit": "َkٰàَrَtْʿعٱ", "root": "عرو"}, {"id": 5, "arabic": "بَعْضُ", "translit": "ُḍْʿعَb", "root": "بعض"}, {"id": 6, "arabic": "ءَالِهَتِنَا", "translit": "āَnِtَhِlāَء", "root": "اله"}, {"id": 7, "arabic": "بِسُوٓءٍ", "translit": "ٍءٓwُsِb", "root": "سوا"}, {"id": 8, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 9, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 10, "arabic": "أُشْهِدُ", "translit": "ُdِhْhsُaʾ", "root": "شهد"}, {"id": 11, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "وَٱشْهَدُوٓا۟", "translit": "۟āٓwُdَhْhsٱَw", "root": "شهد"}, {"id": 13, "arabic": "أَنِّى", "translit": "àِّnَaʾ", "root": ""}, {"id": 14, "arabic": "بَرِىٓءٌ", "translit": "ٌءٓàِrَb", "root": "برا"}, {"id": 15, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 16, "arabic": "تُشْرِكُونَ", "translit": "َnwُkِrْhsُt", "root": "شرك"}], "hasIhya": false}, {"ayah": 55, "text": "مِن دُونِهِۦۖ فَكِيدُونِى جَمِيعًا ثُمَّ لَا تُنظِرُونِ ", "translation": "Other than Him. So plot against me all together; then do not give me respite.", "words": [{"id": 1, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 2, "arabic": "دُونِهِۦ", "translit": "ۦِhِnwُd", "root": "دون"}, {"id": 3, "arabic": "فَكِيدُونِى", "translit": "àِnwُdyِkَf", "root": "كيد"}, {"id": 4, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 5, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "تُنظِرُونِ", "translit": "ِnwُrِẓnُt", "root": "نظر"}], "hasIhya": false}, {"ayah": 56, "text": "إِنِّى تَوَكَّلْتُ عَلَى ٱللَّهِ رَبِّى وَرَبِّكُمۚ مَّا مِن دَآبَّةٍ إِلَّا هُوَ ءَاخِذٌۢ بِنَاصِيَتِهَآۚ إِنَّ رَبِّى عَلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ ", "translation": "Indeed, I have relied upon Allāh, my Lord and your Lord. There is no creature but that He holds it by its forelock [i.e., controls it]. Indeed, my Lord is on a path [that is] straight.", "words": [{"id": 1, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 2, "arabic": "تَوَكَّلْتُ", "translit": "ُtْlَّkَwَt", "root": "وكل"}, {"id": 3, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 6, "arabic": "وَرَبِّكُم", "translit": "mُkِّbَrَw", "root": "ربب"}, {"id": 7, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "دَآبَّةٍ", "translit": "ٍẗَّbٓāَd", "root": "دبب"}, {"id": 10, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 11, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 12, "arabic": "ءَاخِذٌۢ", "translit": "ٌۢhdِhkāَء", "root": "اخذ"}, {"id": 13, "arabic": "بِنَاصِيَتِهَآ", "translit": "ٓāَhِtَyِṣāَnِb", "root": "نصي"}, {"id": 14, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 15, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 16, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 17, "arabic": "صِرَٰطٍ", "translit": "ٍṭَٰrِṣ", "root": "صرط"}, {"id": 18, "arabic": "مُّسْتَقِيمٍ", "translit": "ٍmyِqَtْsُّm", "root": "قوم"}], "hasIhya": true}, {"ayah": 57, "text": "فَإِن تَوَلَّوْا۟ فَقَدْ أَبْلَغْتُكُم مَّآ أُرْسِلْتُ بِهِۦٓ إِلَيْكُمْۚ وَيَسْتَخْلِفُ رَبِّى قَوْمًا غَيْرَكُمْ وَلَا تَضُرُّونَهُۥ شَيْـًٔاۚ إِنَّ رَبِّى عَلَىٰ كُلِّ شَىْءٍ حَفِيظٌ ", "translation": "But if you turn away, then I have already conveyed that with which I was sent to you. My Lord will give succession to a people other than you, and you will not harm Him at all. Indeed my Lord is, over all things, Guardian.\"[1]", "words": [{"id": 1, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 2, "arabic": "تَوَلَّوْا۟", "translit": "۟āْwَّlَwَt", "root": "ولي"}, {"id": 3, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 4, "arabic": "أَبْلَغْتُكُم", "translit": "mُkُtْغَlْbَaʾ", "root": "بلغ"}, {"id": 5, "arabic": "مَّآ", "translit": "ٓāَّm", "root": ""}, {"id": 6, "arabic": "أُرْسِلْتُ", "translit": "ُtْlِsْrُaʾ", "root": "رسل"}, {"id": 7, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 8, "arabic": "إِلَيْكُمْ", "translit": "ْmُkْyَlِiʾ", "root": ""}, {"id": 9, "arabic": "وَيَسْتَخْلِفُ", "translit": "ُfِlْhkَtْsَyَw", "root": "خلف"}, {"id": 10, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 11, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 12, "arabic": "غَيْرَكُمْ", "translit": "ْmُkَrْyَغ", "root": "غير"}, {"id": 13, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 14, "arabic": "تَضُرُّونَهُۥ", "translit": "ۥُhَnwُّrُḍَt", "root": "ضرر"}, {"id": 15, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 16, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 17, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 18, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 19, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 20, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 21, "arabic": "حَفِيظٌ", "translit": "ٌẓyِfَḥ", "root": "حفظ"}], "hasIhya": false}, {"ayah": 58, "text": "وَلَمَّا جَآءَ أَمْرُنَا نَجَّيْنَا هُودًا وَٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ بِرَحْمَةٍ مِّنَّا وَنَجَّيْنَٰهُم مِّنْ عَذَابٍ غَلِيظٍ ", "translation": "And when Our command came, We saved Hūd and those who believed with him, by mercy from Us; and We saved them from a harsh punishment.", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "أَمْرُنَا", "translit": "āَnُrْmَaʾ", "root": "امر"}, {"id": 4, "arabic": "نَجَّيْنَا", "translit": "āَnْyَّjgَn", "root": "نجو"}, {"id": 5, "arabic": "هُودًا", "translit": "āًdwُh", "root": "هود"}, {"id": 6, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 7, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 8, "arabic": "مَعَهُۥ", "translit": "ۥُhَʿعَm", "root": ""}, {"id": 9, "arabic": "بِرَحْمَةٍ", "translit": "ٍẗَmْḥَrِb", "root": "رحم"}, {"id": 10, "arabic": "مِّنَّا", "translit": "āَّnِّm", "root": ""}, {"id": 11, "arabic": "وَنَجَّيْنَٰهُم", "translit": "mُhَٰnْyَّjgَnَw", "root": "نجو"}, {"id": 12, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 13, "arabic": "عَذَابٍ", "translit": "ٍbāَhdَʿع", "root": "عذب"}, {"id": 14, "arabic": "غَلِيظٍ", "translit": "ٍẓyِlَغ", "root": "غلظ"}], "hasIhya": false}, {"ayah": 59, "text": "وَتِلْكَ عَادٌۖ جَحَدُوا۟ بِـَٔايَٰتِ رَبِّهِمْ وَعَصَوْا۟ رُسُلَهُۥ وَٱتَّبَعُوٓا۟ أَمْرَ كُلِّ جَبَّارٍ عَنِيدٍ ", "translation": "And that was ʿAad, who rejected the signs of their Lord and disobeyed His messengers and followed the order of every obstinate tyrant.", "words": [{"id": 1, "arabic": "وَتِلْكَ", "translit": "َkْlِtَw", "root": ""}, {"id": 2, "arabic": "عَادٌ", "translit": "ٌdāَʿع", "root": "عود"}, {"id": 3, "arabic": "جَحَدُوا۟", "translit": "۟āwُdَḥَjg", "root": "جحد"}, {"id": 4, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 5, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 6, "arabic": "وَعَصَوْا۟", "translit": "۟āْwَṣَʿعَw", "root": "عصي"}, {"id": 7, "arabic": "رُسُلَهُۥ", "translit": "ۥُhَlُsُr", "root": "رسل"}, {"id": 8, "arabic": "وَٱتَّبَعُوٓا۟", "translit": "۟āٓwُʿعَbَّtٱَw", "root": "تبع"}, {"id": 9, "arabic": "أَمْرَ", "translit": "َrْmَaʾ", "root": "امر"}, {"id": 10, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 11, "arabic": "جَبَّارٍ", "translit": "ٍrāَّbَjg", "root": "جبر"}, {"id": 12, "arabic": "عَنِيدٍ", "translit": "ٍdyِnَʿع", "root": "عند"}], "hasIhya": false}, {"ayah": 60, "text": "وَأُتْبِعُوا۟ فِى هَٰذِهِ ٱلدُّنْيَا لَعْنَةً وَيَوْمَ ٱلْقِيَٰمَةِۗ أَلَآ إِنَّ عَادًا كَفَرُوا۟ رَبَّهُمْۗ أَلَا بُعْدًا لِّعَادٍ قَوْمِ هُودٍ ", "translation": "And they were [therefore] followed in this world with a curse and [as well] on the Day of Resurrection. Unquestionably, ʿAad denied their Lord; then away with ʿAad, the people of Hūd.", "words": [{"id": 1, "arabic": "وَأُتْبِعُوا۟", "translit": "۟āwُʿعِbْtُaʾَw", "root": "تبع"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "هَٰذِهِ", "translit": "ِhِhdَٰh", "root": ""}, {"id": 4, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 5, "arabic": "لَعْنَةً", "translit": "ًẗَnْʿعَl", "root": "لعن"}, {"id": 6, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 7, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 8, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 9, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 10, "arabic": "عَادًا", "translit": "āًdāَʿع", "root": "عود"}, {"id": 11, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 12, "arabic": "رَبَّهُمْ", "translit": "ْmُhَّbَr", "root": "ربب"}, {"id": 13, "arabic": "أَلَا", "translit": "āَlَaʾ", "root": ""}, {"id": 14, "arabic": "بُعْدًا", "translit": "āًdْʿعُb", "root": "بعد"}, {"id": 15, "arabic": "لِّعَادٍ", "translit": "ٍdāَʿعِّl", "root": "عود"}, {"id": 16, "arabic": "قَوْمِ", "translit": "ِmْwَq", "root": "قوم"}, {"id": 17, "arabic": "هُودٍ", "translit": "ٍdwُh", "root": "هود"}], "hasIhya": true}, {"ayah": 61, "text": "وَإِلَىٰ ثَمُودَ أَخَاهُمْ صَٰلِحًاۚ قَالَ يَٰقَوْمِ ٱعْبُدُوا۟ ٱللَّهَ مَا لَكُم مِّنْ إِلَٰهٍ غَيْرُهُۥۖ هُوَ أَنشَأَكُم مِّنَ ٱلْأَرْضِ وَٱسْتَعْمَرَكُمْ فِيهَا فَٱسْتَغْفِرُوهُ ثُمَّ تُوبُوٓا۟ إِلَيْهِۚ إِنَّ رَبِّى قَرِيبٌ مُّجِيبٌ ", "translation": "And to Thamūd [We sent] their brother Ṣāliḥ. He said, \"O my people, worship Allāh; you have no deity other than Him. He has produced you from the earth and settled you in it, so ask forgiveness of Him and then repent to Him. Indeed, my Lord is near and responsive.\"", "words": [{"id": 1, "arabic": "وَإِلَىٰ", "translit": "ٰàَlِiʾَw", "root": ""}, {"id": 2, "arabic": "ثَمُودَ", "translit": "َdwُmَht", "root": ""}, {"id": 3, "arabic": "أَخَاهُمْ", "translit": "ْmُhāَhkَaʾ", "root": "اخو"}, {"id": 4, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 5, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 6, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 7, "arabic": "ٱعْبُدُوا۟", "translit": "۟āwُdُbْʿعٱ", "root": "عبد"}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 11, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 12, "arabic": "إِلَٰهٍ", "translit": "ٍhَٰlِiʾ", "root": "اله"}, {"id": 13, "arabic": "غَيْرُهُۥ", "translit": "ۥُhُrْyَغ", "root": "غير"}, {"id": 14, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 15, "arabic": "أَنشَأَكُم", "translit": "mُkَaʾَhsnَaʾ", "root": "نشا"}, {"id": 16, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 17, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 18, "arabic": "وَٱسْتَعْمَرَكُمْ", "translit": "ْmُkَrَmْʿعَtْsٱَw", "root": "عمر"}, {"id": 19, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 20, "arabic": "فَٱسْتَغْفِرُوهُ", "translit": "ُhwُrِfْغَtْsٱَf", "root": "غفر"}, {"id": 21, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 22, "arabic": "تُوبُوٓا۟", "translit": "۟āٓwُbwُt", "root": "توب"}, {"id": 23, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 24, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 25, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 26, "arabic": "قَرِيبٌ", "translit": "ٌbyِrَq", "root": "قرب"}, {"id": 27, "arabic": "مُّجِيبٌ", "translit": "ٌbyِjgُّm", "root": "جوب"}], "hasIhya": false}, {"ayah": 62, "text": "قَالُوا۟ يَٰصَٰلِحُ قَدْ كُنتَ فِينَا مَرْجُوًّا قَبْلَ هَٰذَآۖ أَتَنْهَىٰنَآ أَن نَّعْبُدَ مَا يَعْبُدُ ءَابَآؤُنَا وَإِنَّنَا لَفِى شَكٍّ مِّمَّا تَدْعُونَآ إِلَيْهِ مُرِيبٍ ", "translation": "They said, \"O Ṣāliḥ, you were among us a man of promise before this. Do you forbid us to worship what our fathers worshipped? And indeed we are, about that to which you invite us, in disquieting doubt.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰصَٰلِحُ", "translit": "ُḥِlَٰṣَٰy", "root": "صلح"}, {"id": 3, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 4, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 5, "arabic": "فِينَا", "translit": "āَnyِf", "root": ""}, {"id": 6, "arabic": "مَرْجُوًّا", "translit": "āًّwُjgْrَm", "root": "رجو"}, {"id": 7, "arabic": "قَبْلَ", "translit": "َlْbَq", "root": "قبل"}, {"id": 8, "arabic": "هَٰذَآ", "translit": "ٓāَhdَٰh", "root": ""}, {"id": 9, "arabic": "أَتَنْهَىٰنَآ", "translit": "ٓāَnٰàَhْnَtَaʾ", "root": "نهي"}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 11, "arabic": "نَّعْبُدَ", "translit": "َdُbْʿعَّn", "root": "عبد"}, {"id": 12, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 13, "arabic": "يَعْبُدُ", "translit": "ُdُbْʿعَy", "root": "عبد"}, {"id": 14, "arabic": "ءَابَآؤُنَا", "translit": "āَnُwʾٓāَbāَء", "root": "ابو"}, {"id": 15, "arabic": "وَإِنَّنَا", "translit": "āَnَّnِiʾَw", "root": ""}, {"id": 16, "arabic": "لَفِى", "translit": "àِfَl", "root": ""}, {"id": 17, "arabic": "شَكٍّ", "translit": "ٍّkَhs", "root": "شكك"}, {"id": 18, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 19, "arabic": "تَدْعُونَآ", "translit": "ٓāَnwُʿعْdَt", "root": "دعو"}, {"id": 20, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 21, "arabic": "مُرِيبٍ", "translit": "ٍbyِrُm", "root": "ريب"}], "hasIhya": false}, {"ayah": 63, "text": "قَالَ يَٰقَوْمِ أَرَءَيْتُمْ إِن كُنتُ عَلَىٰ بَيِّنَةٍ مِّن رَّبِّى وَءَاتَىٰنِى مِنْهُ رَحْمَةً فَمَن يَنصُرُنِى مِنَ ٱللَّهِ إِنْ عَصَيْتُهُۥۖ فَمَا تَزِيدُونَنِى غَيْرَ تَخْسِيرٍ ", "translation": "He said, \"O my people, have you considered: if I should be upon clear evidence from my Lord and He has given me mercy from Himself, who would protect me from Allāh if I disobeyed Him? So you would not increase me except in loss.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 3, "arabic": "أَرَءَيْتُمْ", "translit": "ْmُtْyَءَrَaʾ", "root": "راي"}, {"id": 4, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 5, "arabic": "كُنتُ", "translit": "ُtnُk", "root": "كون"}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "بَيِّنَةٍ", "translit": "ٍẗَnِّyَb", "root": "بين"}, {"id": 8, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 9, "arabic": "رَّبِّى", "translit": "àِّbَّr", "root": "ربب"}, {"id": 10, "arabic": "وَءَاتَىٰنِى", "translit": "àِnٰàَtāَءَw", "root": "اتي"}, {"id": 11, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 12, "arabic": "رَحْمَةً", "translit": "ًẗَmْḥَr", "root": "رحم"}, {"id": 13, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 14, "arabic": "يَنصُرُنِى", "translit": "àِnُrُṣnَy", "root": "نصر"}, {"id": 15, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 16, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 18, "arabic": "عَصَيْتُهُۥ", "translit": "ۥُhُtْyَṣَʿع", "root": "عصي"}, {"id": 19, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 20, "arabic": "تَزِيدُونَنِى", "translit": "àِnَnwُdyِzَt", "root": "زيد"}, {"id": 21, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 22, "arabic": "تَخْسِيرٍ", "translit": "ٍryِsْhkَt", "root": "خسر"}], "hasIhya": false}, {"ayah": 64, "text": "وَيَٰقَوْمِ هَٰذِهِۦ نَاقَةُ ٱللَّهِ لَكُمْ ءَايَةً فَذَرُوهَا تَأْكُلْ فِىٓ أَرْضِ ٱللَّهِ وَلَا تَمَسُّوهَا بِسُوٓءٍ فَيَأْخُذَكُمْ عَذَابٌ قَرِيبٌ ", "translation": "And O my people, this is the she-camel of Allāh - [she is] to you a sign. So let her feed upon Allāh's earth and do not touch her with harm, or you will be taken by an impending punishment.\"", "words": [{"id": 1, "arabic": "وَيَٰقَوْمِ", "translit": "ِmْwَqَٰyَw", "root": "قوم"}, {"id": 2, "arabic": "هَٰذِهِۦ", "translit": "ۦِhِhdَٰh", "root": ""}, {"id": 3, "arabic": "نَاقَةُ", "translit": "ُẗَqāَn", "root": "نوق"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 6, "arabic": "ءَايَةً", "translit": "ًẗَyāَء", "root": "ايي"}, {"id": 7, "arabic": "فَذَرُوهَا", "translit": "āَhwُrَhdَf", "root": "وذر"}, {"id": 8, "arabic": "تَأْكُلْ", "translit": "ْlُkْaʾَt", "root": "اكل"}, {"id": 9, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 10, "arabic": "أَرْضِ", "translit": "ِḍْrَaʾ", "root": "ارض"}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "تَمَسُّوهَا", "translit": "āَhwُّsَmَt", "root": "مسس"}, {"id": 14, "arabic": "بِسُوٓءٍ", "translit": "ٍءٓwُsِb", "root": "سوا"}, {"id": 15, "arabic": "فَيَأْخُذَكُمْ", "translit": "ْmُkَhdُhkْaʾَyَf", "root": "اخذ"}, {"id": 16, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 17, "arabic": "قَرِيبٌ", "translit": "ٌbyِrَq", "root": "قرب"}], "hasIhya": false}, {"ayah": 65, "text": "فَعَقَرُوهَا فَقَالَ تَمَتَّعُوا۟ فِى دَارِكُمْ ثَلَٰثَةَ أَيَّامٍۖ ذَٰلِكَ وَعْدٌ غَيْرُ مَكْذُوبٍ ", "translation": "But they hamstrung her, so he said, \"Enjoy yourselves in your homes for three days. That is a promise not to be denied [i.e., unfailing].\"", "words": [{"id": 1, "arabic": "فَعَقَرُوهَا", "translit": "āَhwُrَqَʿعَf", "root": "عقر"}, {"id": 2, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 3, "arabic": "تَمَتَّعُوا۟", "translit": "۟āwُʿعَّtَmَt", "root": "متع"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "دَارِكُمْ", "translit": "ْmُkِrāَd", "root": "دور"}, {"id": 6, "arabic": "ثَلَٰثَةَ", "translit": "َẗَhtَٰlَht", "root": "ثلث"}, {"id": 7, "arabic": "أَيَّامٍ", "translit": "ٍmāَّyَaʾ", "root": "يوم"}, {"id": 8, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 9, "arabic": "وَعْدٌ", "translit": "ٌdْʿعَw", "root": "وعد"}, {"id": 10, "arabic": "غَيْرُ", "translit": "ُrْyَغ", "root": "غير"}, {"id": 11, "arabic": "مَكْذُوبٍ", "translit": "ٍbwُhdْkَm", "root": "كذب"}], "hasIhya": false}, {"ayah": 66, "text": "فَلَمَّا جَآءَ أَمْرُنَا نَجَّيْنَا صَٰلِحًا وَٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ بِرَحْمَةٍ مِّنَّا وَمِنْ خِزْىِ يَوْمِئِذٍۗ إِنَّ رَبَّكَ هُوَ ٱلْقَوِىُّ ٱلْعَزِيزُ ", "translation": "So when Our command came, We saved Ṣāliḥ and those who believed with him, by mercy from Us, and [saved them] from the disgrace of that day.[1] Indeed, it is your Lord who is the Powerful, the Exalted in Might.", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "أَمْرُنَا", "translit": "āَnُrْmَaʾ", "root": "امر"}, {"id": 4, "arabic": "نَجَّيْنَا", "translit": "āَnْyَّjgَn", "root": "نجو"}, {"id": 5, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 6, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 7, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 8, "arabic": "مَعَهُۥ", "translit": "ۥُhَʿعَm", "root": ""}, {"id": 9, "arabic": "بِرَحْمَةٍ", "translit": "ٍẗَmْḥَrِb", "root": "رحم"}, {"id": 10, "arabic": "مِّنَّا", "translit": "āَّnِّm", "root": ""}, {"id": 11, "arabic": "وَمِنْ", "translit": "ْnِmَw", "root": ""}, {"id": 12, "arabic": "خِزْىِ", "translit": "ِàْzِhk", "root": "خزي"}, {"id": 13, "arabic": "يَوْمِئِذٍ", "translit": "ٍhdِyʾِmْwَy", "root": "يوم"}, {"id": 14, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 15, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 16, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 17, "arabic": "ٱلْقَوِىُّ", "translit": "ُّàِwَqْlٱ", "root": "قوي"}, {"id": 18, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}], "hasIhya": false}, {"ayah": 67, "text": "وَأَخَذَ ٱلَّذِينَ ظَلَمُوا۟ ٱلصَّيْحَةُ فَأَصْبَحُوا۟ فِى دِيَٰرِهِمْ جَٰثِمِينَ ", "translation": "And the shriek[1] seized those who had wronged, and they became within their homes [corpses] fallen prone", "words": [{"id": 1, "arabic": "وَأَخَذَ", "translit": "َhdَhkَaʾَw", "root": "اخذ"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ظَلَمُوا۟", "translit": "۟āwُmَlَẓ", "root": "ظلم"}, {"id": 4, "arabic": "ٱلصَّيْحَةُ", "translit": "ُẗَḥْyَّṣlٱ", "root": "صيح"}, {"id": 5, "arabic": "فَأَصْبَحُوا۟", "translit": "۟āwُḥَbْṣَaʾَf", "root": "صبح"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "دِيَٰرِهِمْ", "translit": "ْmِhِrَٰyِd", "root": "دور"}, {"id": 8, "arabic": "جَٰثِمِينَ", "translit": "َnyِmِhtَٰjg", "root": "جثم"}], "hasIhya": false}, {"ayah": 68, "text": "كَأَن لَّمْ يَغْنَوْا۟ فِيهَآۗ أَلَآ إِنَّ ثَمُودَا۟ كَفَرُوا۟ رَبَّهُمْۗ أَلَا بُعْدًا لِّثَمُودَ ", "translation": "As if they had never prospered therein. Unquestionably, Thamūd denied their Lord; then, away with Thamūd.", "words": [{"id": 1, "arabic": "كَأَن", "translit": "nَaʾَk", "root": ""}, {"id": 2, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 3, "arabic": "يَغْنَوْا۟", "translit": "۟āْwَnْغَy", "root": "غني"}, {"id": 4, "arabic": "فِيهَآ", "translit": "ٓāَhyِf", "root": ""}, {"id": 5, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 6, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 7, "arabic": "ثَمُودَا۟", "translit": "۟āَdwُmَht", "root": ""}, {"id": 8, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 9, "arabic": "رَبَّهُمْ", "translit": "ْmُhَّbَr", "root": "ربب"}, {"id": 10, "arabic": "أَلَا", "translit": "āَlَaʾ", "root": ""}, {"id": 11, "arabic": "بُعْدًا", "translit": "āًdْʿعُb", "root": "بعد"}, {"id": 12, "arabic": "لِّثَمُودَ", "translit": "َdwُmَhtِّl", "root": ""}], "hasIhya": false}, {"ayah": 69, "text": "وَلَقَدْ جَآءَتْ رُسُلُنَآ إِبْرَٰهِيمَ بِٱلْبُشْرَىٰ قَالُوا۟ سَلَٰمًاۖ قَالَ سَلَٰمٌۖ فَمَا لَبِثَ أَن جَآءَ بِعِجْلٍ حَنِيذٍ ", "translation": "And certainly did Our messengers [i.e., angels] come to Abraham with good tidings; they said, \"Peace.\" He said, \"Peace,\" and did not delay in bringing [them] a roasted calf.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "جَآءَتْ", "translit": "ْtَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "رُسُلُنَآ", "translit": "ٓāَnُlُsُr", "root": "رسل"}, {"id": 4, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 5, "arabic": "بِٱلْبُشْرَىٰ", "translit": "ٰàَrْhsُbْlٱِb", "root": "بشر"}, {"id": 6, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 7, "arabic": "سَلَٰمًا", "translit": "āًmَٰlَs", "root": "سلم"}, {"id": 8, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 9, "arabic": "سَلَٰمٌ", "translit": "ٌmَٰlَs", "root": "سلم"}, {"id": 10, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 11, "arabic": "لَبِثَ", "translit": "َhtِbَl", "root": "لبث"}, {"id": 12, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 13, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 14, "arabic": "بِعِجْلٍ", "translit": "ٍlْjgِʿعِb", "root": "عجل"}, {"id": 15, "arabic": "حَنِيذٍ", "translit": "ٍhdyِnَḥ", "root": "حنذ"}], "hasIhya": true}, {"ayah": 70, "text": "فَلَمَّا رَءَآ أَيْدِيَهُمْ لَا تَصِلُ إِلَيْهِ نَكِرَهُمْ وَأَوْجَسَ مِنْهُمْ خِيفَةًۚ قَالُوا۟ لَا تَخَفْ إِنَّآ أُرْسِلْنَآ إِلَىٰ قَوْمِ لُوطٍ ", "translation": "But when he saw their hands not reaching for it, he distrusted them and felt from them apprehension.[1] They said, \"Fear not. We have been sent to the people of Lot.\"", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "رَءَآ", "translit": "ٓāَءَr", "root": "راي"}, {"id": 3, "arabic": "أَيْدِيَهُمْ", "translit": "ْmُhَyِdْyَaʾ", "root": "يدي"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَصِلُ", "translit": "ُlِṣَt", "root": "وصل"}, {"id": 6, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 7, "arabic": "نَكِرَهُمْ", "translit": "ْmُhَrِkَn", "root": "نكر"}, {"id": 8, "arabic": "وَأَوْجَسَ", "translit": "َsَjgْwَaʾَw", "root": "وجس"}, {"id": 9, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 10, "arabic": "خِيفَةً", "translit": "ًẗَfyِhk", "root": "خوف"}, {"id": 11, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "تَخَفْ", "translit": "ْfَhkَt", "root": "خوف"}, {"id": 14, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 15, "arabic": "أُرْسِلْنَآ", "translit": "ٓāَnْlِsْrُaʾ", "root": "رسل"}, {"id": 16, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 17, "arabic": "قَوْمِ", "translit": "ِmْwَq", "root": "قوم"}, {"id": 18, "arabic": "لُوطٍ", "translit": "ٍṭwُl", "root": ""}], "hasIhya": false}, {"ayah": 71, "text": "وَٱمْرَأَتُهُۥ قَآئِمَةٌ فَضَحِكَتْ فَبَشَّرْنَٰهَا بِإِسْحَٰقَ وَمِن وَرَآءِ إِسْحَٰقَ يَعْقُوبَ ", "translation": "And his wife was standing, and she smiled.[1] Then We gave her good tidings of Isaac and after Isaac, Jacob.", "words": [{"id": 1, "arabic": "وَٱمْرَأَتُهُۥ", "translit": "ۥُhُtَaʾَrْmٱَw", "root": "مرا"}, {"id": 2, "arabic": "قَآئِمَةٌ", "translit": "ٌẗَmِyʾٓāَq", "root": "قوم"}, {"id": 3, "arabic": "فَضَحِكَتْ", "translit": "ْtَkِḥَḍَf", "root": "ضحك"}, {"id": 4, "arabic": "فَبَشَّرْنَٰهَا", "translit": "āَhَٰnْrَّhsَbَf", "root": "بشر"}, {"id": 5, "arabic": "بِإِسْحَٰقَ", "translit": "َqَٰḥْsِiʾِb", "root": ""}, {"id": 6, "arabic": "وَمِن", "translit": "nِmَw", "root": ""}, {"id": 7, "arabic": "وَرَآءِ", "translit": "ِءٓāَrَw", "root": "وري"}, {"id": 8, "arabic": "إِسْحَٰقَ", "translit": "َqَٰḥْsِiʾ", "root": ""}, {"id": 9, "arabic": "يَعْقُوبَ", "translit": "َbwُqْʿعَy", "root": ""}], "hasIhya": false}, {"ayah": 72, "text": "قَالَتْ يَٰوَيْلَتَىٰٓ ءَأَلِدُ وَأَنَا۠ عَجُوزٌ وَهَٰذَا بَعْلِى شَيْخًاۖ إِنَّ هَٰذَا لَشَىْءٌ عَجِيبٌ ", "translation": "She said, \"Woe to me![1] Shall I give birth while I am an old woman and this, my husband, is an old man? Indeed, this is an amazing thing!\"", "words": [{"id": 1, "arabic": "قَالَتْ", "translit": "ْtَlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰوَيْلَتَىٰٓ", "translit": "ٰٓàَtَlْyَwَٰy", "root": ""}, {"id": 3, "arabic": "ءَأَلِدُ", "translit": "ُdِlَaʾَء", "root": "ولد"}, {"id": 4, "arabic": "وَأَنَا۠", "translit": "۠āَnَaʾَw", "root": ""}, {"id": 5, "arabic": "عَجُوزٌ", "translit": "ٌzwُjgَʿع", "root": "عجز"}, {"id": 6, "arabic": "وَهَٰذَا", "translit": "āَhdَٰhَw", "root": ""}, {"id": 7, "arabic": "بَعْلِى", "translit": "àِlْʿعَb", "root": "بعل"}, {"id": 8, "arabic": "شَيْخًا", "translit": "āًhkْyَhs", "root": "شيخ"}, {"id": 9, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 10, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 11, "arabic": "لَشَىْءٌ", "translit": "ٌءْàَhsَl", "root": "شيا"}, {"id": 12, "arabic": "عَجِيبٌ", "translit": "ٌbyِjgَʿع", "root": "عجب"}], "hasIhya": false}, {"ayah": 73, "text": "قَالُوٓا۟ أَتَعْجَبِينَ مِنْ أَمْرِ ٱللَّهِۖ رَحْمَتُ ٱللَّهِ وَبَرَكَٰتُهُۥ عَلَيْكُمْ أَهْلَ ٱلْبَيْتِۚ إِنَّهُۥ حَمِيدٌ مَّجِيدٌ ", "translation": "They said, \"Are you amazed at the decree of Allāh? May the mercy of Allāh and His blessings be upon you, people of the house. Indeed, He is Praiseworthy and Honorable.\"", "words": [{"id": 1, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 2, "arabic": "أَتَعْجَبِينَ", "translit": "َnyِbَjgْʿعَtَaʾ", "root": "عجب"}, {"id": 3, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 4, "arabic": "أَمْرِ", "translit": "ِrْmَaʾ", "root": "امر"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "رَحْمَتُ", "translit": "ُtَmْḥَr", "root": "رحم"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "وَبَرَكَٰتُهُۥ", "translit": "ۥُhُtَٰkَrَbَw", "root": "برك"}, {"id": 9, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 10, "arabic": "أَهْلَ", "translit": "َlْhَaʾ", "root": "اهل"}, {"id": 11, "arabic": "ٱلْبَيْتِ", "translit": "ِtْyَbْlٱ", "root": "بيت"}, {"id": 12, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 13, "arabic": "حَمِيدٌ", "translit": "ٌdyِmَḥ", "root": "حمد"}, {"id": 14, "arabic": "مَّجِيدٌ", "translit": "ٌdyِjgَّm", "root": "مجد"}], "hasIhya": false}, {"ayah": 74, "text": "فَلَمَّا ذَهَبَ عَنْ إِبْرَٰهِيمَ ٱلرَّوْعُ وَجَآءَتْهُ ٱلْبُشْرَىٰ يُجَٰدِلُنَا فِى قَوْمِ لُوطٍ ", "translation": "And when the fright had left Abraham and the good tidings had reached him, he began to argue [i.e., plead] with Us[1] concerning the people of Lot.", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "ذَهَبَ", "translit": "َbَhَhd", "root": "ذهب"}, {"id": 3, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 4, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 5, "arabic": "ٱلرَّوْعُ", "translit": "ُʿعْwَّrlٱ", "root": "روع"}, {"id": 6, "arabic": "وَجَآءَتْهُ", "translit": "ُhْtَءٓāَjgَw", "root": "جيا"}, {"id": 7, "arabic": "ٱلْبُشْرَىٰ", "translit": "ٰàَrْhsُbْlٱ", "root": "بشر"}, {"id": 8, "arabic": "يُجَٰدِلُنَا", "translit": "āَnُlِdَٰjgُy", "root": "جدل"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "قَوْمِ", "translit": "ِmْwَq", "root": "قوم"}, {"id": 11, "arabic": "لُوطٍ", "translit": "ٍṭwُl", "root": ""}], "hasIhya": false}, {"ayah": 75, "text": "إِنَّ إِبْرَٰهِيمَ لَحَلِيمٌ أَوَّٰهٌ مُّنِيبٌ ", "translation": "Indeed, Abraham was forbearing, grieving[1] and [frequently] returning [to Allāh].", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 3, "arabic": "لَحَلِيمٌ", "translit": "ٌmyِlَḥَl", "root": "حلم"}, {"id": 4, "arabic": "أَوَّٰهٌ", "translit": "ٌhَّٰwَaʾ", "root": "اوه"}, {"id": 5, "arabic": "مُّنِيبٌ", "translit": "ٌbyِnُّm", "root": "نوب"}], "hasIhya": false}, {"ayah": 76, "text": "يَٰٓإِبْرَٰهِيمُ أَعْرِضْ عَنْ هَٰذَآۖ إِنَّهُۥ قَدْ جَآءَ أَمْرُ رَبِّكَۖ وَإِنَّهُمْ ءَاتِيهِمْ عَذَابٌ غَيْرُ مَرْدُودٍ ", "translation": "[The angels said], \"O Abraham, give up this [plea]. Indeed, the command of your Lord has come, and indeed, there will reach them a punishment that cannot be repelled.\"", "words": [{"id": 1, "arabic": "يَٰٓإِبْرَٰهِيمُ", "translit": "ُmyِhَٰrْbِiʾَٰٓy", "root": ""}, {"id": 2, "arabic": "أَعْرِضْ", "translit": "ْḍِrْʿعَaʾ", "root": "عرض"}, {"id": 3, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 4, "arabic": "هَٰذَآ", "translit": "ٓāَhdَٰh", "root": ""}, {"id": 5, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 6, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 7, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 8, "arabic": "أَمْرُ", "translit": "ُrْmَaʾ", "root": "امر"}, {"id": 9, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 10, "arabic": "وَإِنَّهُمْ", "translit": "ْmُhَّnِiʾَw", "root": ""}, {"id": 11, "arabic": "ءَاتِيهِمْ", "translit": "ْmِhyِtāَء", "root": "اتي"}, {"id": 12, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 13, "arabic": "غَيْرُ", "translit": "ُrْyَغ", "root": "غير"}, {"id": 14, "arabic": "مَرْدُودٍ", "translit": "ٍdwُdْrَm", "root": "ردد"}], "hasIhya": false}, {"ayah": 77, "text": "وَلَمَّا جَآءَتْ رُسُلُنَا لُوطًا سِىٓءَ بِهِمْ وَضَاقَ بِهِمْ ذَرْعًا وَقَالَ هَٰذَا يَوْمٌ عَصِيبٌ ", "translation": "And when Our messengers, [the angels], came to Lot, he was anguished for them and felt for them great discomfort[1] and said, \"This is a trying day.\"", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 2, "arabic": "جَآءَتْ", "translit": "ْtَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "رُسُلُنَا", "translit": "āَnُlُsُr", "root": "رسل"}, {"id": 4, "arabic": "لُوطًا", "translit": "āًṭwُl", "root": ""}, {"id": 5, "arabic": "سِىٓءَ", "translit": "َءٓàِs", "root": "سوا"}, {"id": 6, "arabic": "بِهِمْ", "translit": "ْmِhِb", "root": ""}, {"id": 7, "arabic": "وَضَاقَ", "translit": "َqāَḍَw", "root": "ضيق"}, {"id": 8, "arabic": "بِهِمْ", "translit": "ْmِhِb", "root": ""}, {"id": 9, "arabic": "ذَرْعًا", "translit": "āًʿعْrَhd", "root": "ذرع"}, {"id": 10, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 11, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 12, "arabic": "يَوْمٌ", "translit": "ٌmْwَy", "root": "يوم"}, {"id": 13, "arabic": "عَصِيبٌ", "translit": "ٌbyِṣَʿع", "root": "عصب"}], "hasIhya": false}, {"ayah": 78, "text": "وَجَآءَهُۥ قَوْمُهُۥ يُهْرَعُونَ إِلَيْهِ وَمِن قَبْلُ كَانُوا۟ يَعْمَلُونَ ٱلسَّيِّـَٔاتِۚ قَالَ يَٰقَوْمِ هَٰٓؤُلَآءِ بَنَاتِى هُنَّ أَطْهَرُ لَكُمْۖ فَٱتَّقُوا۟ ٱللَّهَ وَلَا تُخْزُونِ فِى ضَيْفِىٓۖ أَلَيْسَ مِنكُمْ رَجُلٌ رَّشِيدٌ ", "translation": "And his people came hastening to him, and before [this] they had been doing evil deeds.[1] He said, \"O my people, these are my daughters;[2] they are purer for you. So fear Allāh and do not disgrace me concerning my guests. Is there not among you a man of reason?\"", "words": [{"id": 1, "arabic": "وَجَآءَهُۥ", "translit": "ۥُhَءٓāَjgَw", "root": "جيا"}, {"id": 2, "arabic": "قَوْمُهُۥ", "translit": "ۥُhُmْwَq", "root": "قوم"}, {"id": 3, "arabic": "يُهْرَعُونَ", "translit": "َnwُʿعَrْhُy", "root": "هرع"}, {"id": 4, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 5, "arabic": "وَمِن", "translit": "nِmَw", "root": ""}, {"id": 6, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 7, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 8, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}, {"id": 9, "arabic": "ٱلسَّيِّـَٔاتِ", "translit": "ِtāَٔـِّyَّslٱ", "root": "سوا"}, {"id": 10, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 11, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 12, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 13, "arabic": "بَنَاتِى", "translit": "àِtāَnَb", "root": "بني"}, {"id": 14, "arabic": "هُنَّ", "translit": "َّnُh", "root": ""}, {"id": 15, "arabic": "أَطْهَرُ", "translit": "ُrَhْṭَaʾ", "root": "طهر"}, {"id": 16, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 17, "arabic": "فَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَf", "root": "وقي"}, {"id": 18, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 20, "arabic": "تُخْزُونِ", "translit": "ِnwُzْhkُt", "root": "خزي"}, {"id": 21, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 22, "arabic": "ضَيْفِىٓ", "translit": "ٓàِfْyَḍ", "root": "ضيف"}, {"id": 23, "arabic": "أَلَيْسَ", "translit": "َsْyَlَaʾ", "root": "ليس"}, {"id": 24, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 25, "arabic": "رَجُلٌ", "translit": "ٌlُjgَr", "root": "رجل"}, {"id": 26, "arabic": "رَّشِيدٌ", "translit": "ٌdyِhsَّr", "root": "رشد"}], "hasIhya": false}, {"ayah": 79, "text": "قَالُوا۟ لَقَدْ عَلِمْتَ مَا لَنَا فِى بَنَاتِكَ مِنْ حَقٍّ وَإِنَّكَ لَتَعْلَمُ مَا نُرِيدُ ", "translation": "They said, \"You have already known that we have not concerning your daughters [i.e., women] any claim [i.e., desire], and indeed, you know what we want.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 3, "arabic": "عَلِمْتَ", "translit": "َtْmِlَʿع", "root": "علم"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "بَنَاتِكَ", "translit": "َkِtāَnَb", "root": "بني"}, {"id": 8, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 9, "arabic": "حَقٍّ", "translit": "ٍّqَḥ", "root": "حقق"}, {"id": 10, "arabic": "وَإِنَّكَ", "translit": "َkَّnِiʾَw", "root": ""}, {"id": 11, "arabic": "لَتَعْلَمُ", "translit": "ُmَlْʿعَtَl", "root": "علم"}, {"id": 12, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 13, "arabic": "نُرِيدُ", "translit": "ُdyِrُn", "root": "رود"}], "hasIhya": false}, {"ayah": 80, "text": "قَالَ لَوْ أَنَّ لِى بِكُمْ قُوَّةً أَوْ ءَاوِىٓ إِلَىٰ رُكْنٍ شَدِيدٍ ", "translation": "He said, \"If only I had against you some power or could take refuge in a strong support.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 3, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 4, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 5, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": ""}, {"id": 6, "arabic": "قُوَّةً", "translit": "ًẗَّwُq", "root": "قوي"}, {"id": 7, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 8, "arabic": "ءَاوِىٓ", "translit": "ٓàِwāَء", "root": "اوي"}, {"id": 9, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 10, "arabic": "رُكْنٍ", "translit": "ٍnْkُr", "root": "ركن"}, {"id": 11, "arabic": "شَدِيدٍ", "translit": "ٍdyِdَhs", "root": "شدد"}], "hasIhya": false}, {"ayah": 81, "text": "قَالُوا۟ يَٰلُوطُ إِنَّا رُسُلُ رَبِّكَ لَن يَصِلُوٓا۟ إِلَيْكَۖ فَأَسْرِ بِأَهْلِكَ بِقِطْعٍ مِّنَ ٱلَّيْلِ وَلَا يَلْتَفِتْ مِنكُمْ أَحَدٌ إِلَّا ٱمْرَأَتَكَۖ إِنَّهُۥ مُصِيبُهَا مَآ أَصَابَهُمْۚ إِنَّ مَوْعِدَهُمُ ٱلصُّبْحُۚ أَلَيْسَ ٱلصُّبْحُ بِقَرِيبٍ ", "translation": "They [the angels] said, \"O Lot, indeed we are messengers of your Lord; [therefore], they will never reach you. So set out with your family during a portion of the night[1] and let not any among you look back - except your wife; indeed, she will be struck by that which strikes them. Indeed, their appointment is [for] the morning. Is not the morning near?\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰلُوطُ", "translit": "ُṭwُlَٰy", "root": ""}, {"id": 3, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 4, "arabic": "رُسُلُ", "translit": "ُlُsُr", "root": "رسل"}, {"id": 5, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 6, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 7, "arabic": "يَصِلُوٓا۟", "translit": "۟āٓwُlِṣَy", "root": "وصل"}, {"id": 8, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 9, "arabic": "فَأَسْرِ", "translit": "ِrْsَaʾَf", "root": "سري"}, {"id": 10, "arabic": "بِأَهْلِكَ", "translit": "َkِlْhَaʾِb", "root": "اهل"}, {"id": 11, "arabic": "بِقِطْعٍ", "translit": "ٍʿعْṭِqِb", "root": "قطع"}, {"id": 12, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 13, "arabic": "ٱلَّيْلِ", "translit": "ِlْyَّlٱ", "root": "ليل"}, {"id": 14, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 15, "arabic": "يَلْتَفِتْ", "translit": "ْtِfَtْlَy", "root": "لفت"}, {"id": 16, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 17, "arabic": "أَحَدٌ", "translit": "ٌdَḥَaʾ", "root": "احد"}, {"id": 18, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 19, "arabic": "ٱمْرَأَتَكَ", "translit": "َkَtَaʾَrْmٱ", "root": "مرا"}, {"id": 20, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 21, "arabic": "مُصِيبُهَا", "translit": "āَhُbyِṣُm", "root": "صوب"}, {"id": 22, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 23, "arabic": "أَصَابَهُمْ", "translit": "ْmُhَbāَṣَaʾ", "root": "صوب"}, {"id": 24, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 25, "arabic": "مَوْعِدَهُمُ", "translit": "ُmُhَdِʿعْwَm", "root": "وعد"}, {"id": 26, "arabic": "ٱلصُّبْحُ", "translit": "ُḥْbُّṣlٱ", "root": "صبح"}, {"id": 27, "arabic": "أَلَيْسَ", "translit": "َsْyَlَaʾ", "root": "ليس"}, {"id": 28, "arabic": "ٱلصُّبْحُ", "translit": "ُḥْbُّṣlٱ", "root": "صبح"}, {"id": 29, "arabic": "بِقَرِيبٍ", "translit": "ٍbyِrَqِb", "root": "قرب"}], "hasIhya": false}, {"ayah": 82, "text": "فَلَمَّا جَآءَ أَمْرُنَا جَعَلْنَا عَٰلِيَهَا سَافِلَهَا وَأَمْطَرْنَا عَلَيْهَا حِجَارَةً مِّن سِجِّيلٍ مَّنضُودٍ ", "translation": "So when Our command came, We made the highest part [of the city] its lowest and rained upon them stones of layered hard clay, [which were]", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "أَمْرُنَا", "translit": "āَnُrْmَaʾ", "root": "امر"}, {"id": 4, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 5, "arabic": "عَٰلِيَهَا", "translit": "āَhَyِlَٰʿع", "root": "علو"}, {"id": 6, "arabic": "سَافِلَهَا", "translit": "āَhَlِfāَs", "root": "سفل"}, {"id": 7, "arabic": "وَأَمْطَرْنَا", "translit": "āَnْrَṭْmَaʾَw", "root": "مطر"}, {"id": 8, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "حِجَارَةً", "translit": "ًẗَrāَjgِḥ", "root": "حجر"}, {"id": 10, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 11, "arabic": "سِجِّيلٍ", "translit": "ٍlyِّjgِs", "root": "سجل"}, {"id": 12, "arabic": "مَّنضُودٍ", "translit": "ٍdwُḍnَّm", "root": "نضد"}], "hasIhya": false}, {"ayah": 83, "text": "مُّسَوَّمَةً عِندَ رَبِّكَۖ وَمَا هِىَ مِنَ ٱلظَّٰلِمِينَ بِبَعِيدٍ ", "translation": "Marked from your Lord. And it [i.e., Allāh's punishment] is not from the wrongdoers [very] far.", "words": [{"id": 1, "arabic": "مُّسَوَّمَةً", "translit": "ًẗَmَّwَsُّm", "root": "سوم"}, {"id": 2, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 3, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 5, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}, {"id": 8, "arabic": "بِبَعِيدٍ", "translit": "ٍdyِʿعَbِb", "root": "بعد"}], "hasIhya": false}, {"ayah": 84, "text": "وَإِلَىٰ مَدْيَنَ أَخَاهُمْ شُعَيْبًاۚ قَالَ يَٰقَوْمِ ٱعْبُدُوا۟ ٱللَّهَ مَا لَكُم مِّنْ إِلَٰهٍ غَيْرُهُۥۖ وَلَا تَنقُصُوا۟ ٱلْمِكْيَالَ وَٱلْمِيزَانَۚ إِنِّىٓ أَرَىٰكُم بِخَيْرٍ وَإِنِّىٓ أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ مُّحِيطٍ ", "translation": "And to Madyan [We sent] their brother Shuʿayb. He said, \"O my people, worship Allāh; you have no deity other than Him. And do not decrease from the measure and the scale. Indeed, I see you in prosperity, but indeed, I fear for you the punishment of an all-encompassing Day.", "words": [{"id": 1, "arabic": "وَإِلَىٰ", "translit": "ٰàَlِiʾَw", "root": ""}, {"id": 2, "arabic": "مَدْيَنَ", "translit": "َnَyْdَm", "root": "مدن"}, {"id": 3, "arabic": "أَخَاهُمْ", "translit": "ْmُhāَhkَaʾ", "root": "اخو"}, {"id": 4, "arabic": "شُعَيْبًا", "translit": "āًbْyَʿعُhs", "root": ""}, {"id": 5, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 6, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 7, "arabic": "ٱعْبُدُوا۟", "translit": "۟āwُdُbْʿعٱ", "root": "عبد"}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 11, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 12, "arabic": "إِلَٰهٍ", "translit": "ٍhَٰlِiʾ", "root": "اله"}, {"id": 13, "arabic": "غَيْرُهُۥ", "translit": "ۥُhُrْyَغ", "root": "غير"}, {"id": 14, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 15, "arabic": "تَنقُصُوا۟", "translit": "۟āwُṣُqnَt", "root": "نقص"}, {"id": 16, "arabic": "ٱلْمِكْيَالَ", "translit": "َlāَyْkِmْlٱ", "root": "كيل"}, {"id": 17, "arabic": "وَٱلْمِيزَانَ", "translit": "َnāَzyِmْlٱَw", "root": "وزن"}, {"id": 18, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 19, "arabic": "أَرَىٰكُم", "translit": "mُkٰàَrَaʾ", "root": "راي"}, {"id": 20, "arabic": "بِخَيْرٍ", "translit": "ٍrْyَhkِb", "root": "خير"}, {"id": 21, "arabic": "وَإِنِّىٓ", "translit": "ٓàِّnِiʾَw", "root": ""}, {"id": 22, "arabic": "أَخَافُ", "translit": "ُfāَhkَaʾ", "root": "خوف"}, {"id": 23, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 24, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 25, "arabic": "يَوْمٍ", "translit": "ٍmْwَy", "root": "يوم"}, {"id": 26, "arabic": "مُّحِيطٍ", "translit": "ٍṭyِḥُّm", "root": "حوط"}], "hasIhya": false}, {"ayah": 85, "text": "وَيَٰقَوْمِ أَوْفُوا۟ ٱلْمِكْيَالَ وَٱلْمِيزَانَ بِٱلْقِسْطِۖ وَلَا تَبْخَسُوا۟ ٱلنَّاسَ أَشْيَآءَهُمْ وَلَا تَعْثَوْا۟ فِى ٱلْأَرْضِ مُفْسِدِينَ ", "translation": "And O my people, give full measure and weight in justice and do not deprive the people of their due and do not commit abuse on the earth, spreading corruption.", "words": [{"id": 1, "arabic": "وَيَٰقَوْمِ", "translit": "ِmْwَqَٰyَw", "root": "قوم"}, {"id": 2, "arabic": "أَوْفُوا۟", "translit": "۟āwُfْwَaʾ", "root": "وفي"}, {"id": 3, "arabic": "ٱلْمِكْيَالَ", "translit": "َlāَyْkِmْlٱ", "root": "كيل"}, {"id": 4, "arabic": "وَٱلْمِيزَانَ", "translit": "َnāَzyِmْlٱَw", "root": "وزن"}, {"id": 5, "arabic": "بِٱلْقِسْطِ", "translit": "ِṭْsِqْlٱِb", "root": "قسط"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "تَبْخَسُوا۟", "translit": "۟āwُsَhkْbَt", "root": "بخس"}, {"id": 8, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 9, "arabic": "أَشْيَآءَهُمْ", "translit": "ْmُhَءٓāَyْhsَaʾ", "root": "شيا"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "تَعْثَوْا۟", "translit": "۟āْwَhtْʿعَt", "root": "عثو"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 14, "arabic": "مُفْسِدِينَ", "translit": "َnyِdِsْfُm", "root": "فسد"}], "hasIhya": false}, {"ayah": 86, "text": "بَقِيَّتُ ٱللَّهِ خَيْرٌ لَّكُمْ إِن كُنتُم مُّؤْمِنِينَۚ وَمَآ أَنَا۠ عَلَيْكُم بِحَفِيظٍ ", "translation": "What remains [lawful] from Allāh is best for you, if you would be believers. But I am not a guardian over you.\"", "words": [{"id": 1, "arabic": "بَقِيَّتُ", "translit": "ُtَّyِqَb", "root": "بقي"}, {"id": 2, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 4, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 5, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 6, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 7, "arabic": "مُّؤْمِنِينَ", "translit": "َnyِnِmْwʾُّm", "root": "امن"}, {"id": 8, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 9, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 10, "arabic": "عَلَيْكُم", "translit": "mُkْyَlَʿع", "root": ""}, {"id": 11, "arabic": "بِحَفِيظٍ", "translit": "ٍẓyِfَḥِb", "root": "حفظ"}], "hasIhya": false}, {"ayah": 87, "text": "قَالُوا۟ يَٰشُعَيْبُ أَصَلَوٰتُكَ تَأْمُرُكَ أَن نَّتْرُكَ مَا يَعْبُدُ ءَابَآؤُنَآ أَوْ أَن نَّفْعَلَ فِىٓ أَمْوَٰلِنَا مَا نَشَٰٓؤُا۟ۖ إِنَّكَ لَأَنتَ ٱلْحَلِيمُ ٱلرَّشِيدُ ", "translation": "They said, \"O Shuʿayb, does your prayer [i.e., religion] command you that we should leave what our fathers worship or not do with our wealth what we please? Indeed, you are the forbearing, the discerning!\"[1]", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰشُعَيْبُ", "translit": "ُbْyَʿعُhsَٰy", "root": ""}, {"id": 3, "arabic": "أَصَلَوٰتُكَ", "translit": "َkُtٰwَlَṣَaʾ", "root": "صلو"}, {"id": 4, "arabic": "تَأْمُرُكَ", "translit": "َkُrُmْaʾَt", "root": "امر"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "نَّتْرُكَ", "translit": "َkُrْtَّn", "root": "ترك"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "يَعْبُدُ", "translit": "ُdُbْʿعَy", "root": "عبد"}, {"id": 9, "arabic": "ءَابَآؤُنَآ", "translit": "ٓāَnُwʾٓāَbāَء", "root": "ابو"}, {"id": 10, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "نَّفْعَلَ", "translit": "َlَʿعْfَّn", "root": "فعل"}, {"id": 13, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 14, "arabic": "أَمْوَٰلِنَا", "translit": "āَnِlَٰwْmَaʾ", "root": "مول"}, {"id": 15, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 16, "arabic": "نَشَٰٓؤُا۟", "translit": "۟āُwʾَٰٓhsَn", "root": "شيا"}, {"id": 17, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 18, "arabic": "لَأَنتَ", "translit": "َtnَaʾَl", "root": ""}, {"id": 19, "arabic": "ٱلْحَلِيمُ", "translit": "ُmyِlَḥْlٱ", "root": "حلم"}, {"id": 20, "arabic": "ٱلرَّشِيدُ", "translit": "ُdyِhsَّrlٱ", "root": "رشد"}], "hasIhya": false}, {"ayah": 88, "text": "قَالَ يَٰقَوْمِ أَرَءَيْتُمْ إِن كُنتُ عَلَىٰ بَيِّنَةٍ مِّن رَّبِّى وَرَزَقَنِى مِنْهُ رِزْقًا حَسَنًاۚ وَمَآ أُرِيدُ أَنْ أُخَالِفَكُمْ إِلَىٰ مَآ أَنْهَىٰكُمْ عَنْهُۚ إِنْ أُرِيدُ إِلَّا ٱلْإِصْلَٰحَ مَا ٱسْتَطَعْتُۚ وَمَا تَوْفِيقِىٓ إِلَّا بِٱللَّهِۚ عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُنِيبُ ", "translation": "He said, \"O my people, have you considered: if I am upon clear evidence from my Lord and He has provided me with a good provision from Him...?[1] And I do not intend to differ from you in that which I have forbidden you; I only intend reform as much as I am able. And my success is not but through Allāh. Upon Him I have relied, and to Him I return.[2]", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 3, "arabic": "أَرَءَيْتُمْ", "translit": "ْmُtْyَءَrَaʾ", "root": "راي"}, {"id": 4, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 5, "arabic": "كُنتُ", "translit": "ُtnُk", "root": "كون"}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "بَيِّنَةٍ", "translit": "ٍẗَnِّyَb", "root": "بين"}, {"id": 8, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 9, "arabic": "رَّبِّى", "translit": "àِّbَّr", "root": "ربب"}, {"id": 10, "arabic": "وَرَزَقَنِى", "translit": "àِnَqَzَrَw", "root": "رزق"}, {"id": 11, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 12, "arabic": "رِزْقًا", "translit": "āًqْzِr", "root": "رزق"}, {"id": 13, "arabic": "حَسَنًا", "translit": "āًnَsَḥ", "root": "حسن"}, {"id": 14, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 15, "arabic": "أُرِيدُ", "translit": "ُdyِrُaʾ", "root": "رود"}, {"id": 16, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 17, "arabic": "أُخَالِفَكُمْ", "translit": "ْmُkَfِlāَhkُaʾ", "root": "خلف"}, {"id": 18, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 19, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 20, "arabic": "أَنْهَىٰكُمْ", "translit": "ْmُkٰàَhْnَaʾ", "root": "نهي"}, {"id": 21, "arabic": "عَنْهُ", "translit": "ُhْnَʿع", "root": ""}, {"id": 22, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 23, "arabic": "أُرِيدُ", "translit": "ُdyِrُaʾ", "root": "رود"}, {"id": 24, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 25, "arabic": "ٱلْإِصْلَٰحَ", "translit": "َḥَٰlْṣِiʾْlٱ", "root": "صلح"}, {"id": 26, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 27, "arabic": "ٱسْتَطَعْتُ", "translit": "ُtْʿعَṭَtْsٱ", "root": "طوع"}, {"id": 28, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 29, "arabic": "تَوْفِيقِىٓ", "translit": "ٓàِqyِfْwَt", "root": "وفق"}, {"id": 30, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 31, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 32, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 33, "arabic": "تَوَكَّلْتُ", "translit": "ُtْlَّkَwَt", "root": "وكل"}, {"id": 34, "arabic": "وَإِلَيْهِ", "translit": "ِhْyَlِiʾَw", "root": ""}, {"id": 35, "arabic": "أُنِيبُ", "translit": "ُbyِnُaʾ", "root": "نوب"}], "hasIhya": true}, {"ayah": 89, "text": "وَيَٰقَوْمِ لَا يَجْرِمَنَّكُمْ شِقَاقِىٓ أَن يُصِيبَكُم مِّثْلُ مَآ أَصَابَ قَوْمَ نُوحٍ أَوْ قَوْمَ هُودٍ أَوْ قَوْمَ صَٰلِحٍۚ وَمَا قَوْمُ لُوطٍ مِّنكُم بِبَعِيدٍ ", "translation": "And O my people, let not [your] dissension from me cause you to be struck by that similar to what struck the people of Noah or the people of Hūd or the people of Ṣāliḥ. And the people of Lot are not from you far away.", "words": [{"id": 1, "arabic": "وَيَٰقَوْمِ", "translit": "ِmْwَqَٰyَw", "root": "قوم"}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "يَجْرِمَنَّكُمْ", "translit": "ْmُkَّnَmِrْjgَy", "root": "جرم"}, {"id": 4, "arabic": "شِقَاقِىٓ", "translit": "ٓàِqāَqِhs", "root": "شقق"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "يُصِيبَكُم", "translit": "mُkَbyِṣُy", "root": "صوب"}, {"id": 7, "arabic": "مِّثْلُ", "translit": "ُlْhtِّm", "root": "مثل"}, {"id": 8, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 9, "arabic": "أَصَابَ", "translit": "َbāَṣَaʾ", "root": "صوب"}, {"id": 10, "arabic": "قَوْمَ", "translit": "َmْwَq", "root": "قوم"}, {"id": 11, "arabic": "نُوحٍ", "translit": "ٍḥwُn", "root": ""}, {"id": 12, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 13, "arabic": "قَوْمَ", "translit": "َmْwَq", "root": "قوم"}, {"id": 14, "arabic": "هُودٍ", "translit": "ٍdwُh", "root": "هود"}, {"id": 15, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 16, "arabic": "قَوْمَ", "translit": "َmْwَq", "root": "قوم"}, {"id": 17, "arabic": "صَٰلِحٍ", "translit": "ٍḥِlَٰṣ", "root": "صلح"}, {"id": 18, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 19, "arabic": "قَوْمُ", "translit": "ُmْwَq", "root": "قوم"}, {"id": 20, "arabic": "لُوطٍ", "translit": "ٍṭwُl", "root": ""}, {"id": 21, "arabic": "مِّنكُم", "translit": "mُknِّm", "root": ""}, {"id": 22, "arabic": "بِبَعِيدٍ", "translit": "ٍdyِʿعَbِb", "root": "بعد"}], "hasIhya": false}, {"ayah": 90, "text": "وَٱسْتَغْفِرُوا۟ رَبَّكُمْ ثُمَّ تُوبُوٓا۟ إِلَيْهِۚ إِنَّ رَبِّى رَحِيمٌ وَدُودٌ ", "translation": "And ask forgiveness of your Lord and then repent to Him. Indeed, my Lord is Merciful and Affectionate.\"", "words": [{"id": 1, "arabic": "وَٱسْتَغْفِرُوا۟", "translit": "۟āwُrِfْغَtْsٱَw", "root": "غفر"}, {"id": 2, "arabic": "رَبَّكُمْ", "translit": "ْmُkَّbَr", "root": "ربب"}, {"id": 3, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 4, "arabic": "تُوبُوٓا۟", "translit": "۟āٓwُbwُt", "root": "توب"}, {"id": 5, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 6, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 7, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 8, "arabic": "رَحِيمٌ", "translit": "ٌmyِḥَr", "root": "رحم"}, {"id": 9, "arabic": "وَدُودٌ", "translit": "ٌdwُdَw", "root": "ودد"}], "hasIhya": false}, {"ayah": 91, "text": "قَالُوا۟ يَٰشُعَيْبُ مَا نَفْقَهُ كَثِيرًا مِّمَّا تَقُولُ وَإِنَّا لَنَرَىٰكَ فِينَا ضَعِيفًاۖ وَلَوْلَا رَهْطُكَ لَرَجَمْنَٰكَۖ وَمَآ أَنتَ عَلَيْنَا بِعَزِيزٍ ", "translation": "They said, \"O Shuʿayb, we do not understand much of what you say, and indeed, we consider you among us as weak. And if not for your family, we would have stoned you [to death]; and you are not to us one respected.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰشُعَيْبُ", "translit": "ُbْyَʿعُhsَٰy", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "نَفْقَهُ", "translit": "ُhَqْfَn", "root": "فقه"}, {"id": 5, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 6, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 7, "arabic": "تَقُولُ", "translit": "ُlwُqَt", "root": "قول"}, {"id": 8, "arabic": "وَإِنَّا", "translit": "āَّnِiʾَw", "root": ""}, {"id": 9, "arabic": "لَنَرَىٰكَ", "translit": "َkٰàَrَnَl", "root": "راي"}, {"id": 10, "arabic": "فِينَا", "translit": "āَnyِf", "root": ""}, {"id": 11, "arabic": "ضَعِيفًا", "translit": "āًfyِʿعَḍ", "root": "ضعف"}, {"id": 12, "arabic": "وَلَوْلَا", "translit": "āَlْwَlَw", "root": ""}, {"id": 13, "arabic": "رَهْطُكَ", "translit": "َkُṭْhَr", "root": "رهط"}, {"id": 14, "arabic": "لَرَجَمْنَٰكَ", "translit": "َkَٰnْmَjgَrَl", "root": "رجم"}, {"id": 15, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 16, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 17, "arabic": "عَلَيْنَا", "translit": "āَnْyَlَʿع", "root": ""}, {"id": 18, "arabic": "بِعَزِيزٍ", "translit": "ٍzyِzَʿعِb", "root": "عزز"}], "hasIhya": false}, {"ayah": 92, "text": "قَالَ يَٰقَوْمِ أَرَهْطِىٓ أَعَزُّ عَلَيْكُم مِّنَ ٱللَّهِ وَٱتَّخَذْتُمُوهُ وَرَآءَكُمْ ظِهْرِيًّاۖ إِنَّ رَبِّى بِمَا تَعْمَلُونَ مُحِيطٌ ", "translation": "He said, \"O my people, is my family more respected for power by you than Allāh? But you put Him behind your backs [in neglect]. Indeed, my Lord is encompassing of what you do.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 3, "arabic": "أَرَهْطِىٓ", "translit": "ٓàِṭْhَrَaʾ", "root": "رهط"}, {"id": 4, "arabic": "أَعَزُّ", "translit": "ُّzَʿعَaʾ", "root": "عزز"}, {"id": 5, "arabic": "عَلَيْكُم", "translit": "mُkْyَlَʿع", "root": ""}, {"id": 6, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "وَٱتَّخَذْتُمُوهُ", "translit": "ُhwُmُtْhdَhkَّtٱَw", "root": "اخذ"}, {"id": 9, "arabic": "وَرَآءَكُمْ", "translit": "ْmُkَءٓāَrَw", "root": "وري"}, {"id": 10, "arabic": "ظِهْرِيًّا", "translit": "āًّyِrْhِẓ", "root": "ظهر"}, {"id": 11, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 12, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 13, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 14, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 15, "arabic": "مُحِيطٌ", "translit": "ٌṭyِḥُm", "root": "حوط"}], "hasIhya": false}, {"ayah": 93, "text": "وَيَٰقَوْمِ ٱعْمَلُوا۟ عَلَىٰ مَكَانَتِكُمْ إِنِّى عَٰمِلٌۖ سَوْفَ تَعْلَمُونَ مَن يَأْتِيهِ عَذَابٌ يُخْزِيهِ وَمَنْ هُوَ كَٰذِبٌۖ وَٱرْتَقِبُوٓا۟ إِنِّى مَعَكُمْ رَقِيبٌ ", "translation": "And O my people, work according to your position; indeed, I am working. You are going to know to whom will come a punishment that will disgrace him and who is a liar. So watch; indeed, I am with you a watcher, [awaiting the outcome].\"", "words": [{"id": 1, "arabic": "وَيَٰقَوْمِ", "translit": "ِmْwَqَٰyَw", "root": "قوم"}, {"id": 2, "arabic": "ٱعْمَلُوا۟", "translit": "۟āwُlَmْʿعٱ", "root": "عمل"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "مَكَانَتِكُمْ", "translit": "ْmُkِtَnāَkَm", "root": "كون"}, {"id": 5, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 6, "arabic": "عَٰمِلٌ", "translit": "ٌlِmَٰʿع", "root": "عمل"}, {"id": 7, "arabic": "سَوْفَ", "translit": "َfْwَs", "root": ""}, {"id": 8, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}, {"id": 9, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 10, "arabic": "يَأْتِيهِ", "translit": "ِhyِtْaʾَy", "root": "اتي"}, {"id": 11, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 12, "arabic": "يُخْزِيهِ", "translit": "ِhyِzْhkُy", "root": "خزي"}, {"id": 13, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 14, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 15, "arabic": "كَٰذِبٌ", "translit": "ٌbِhdَٰk", "root": "كذب"}, {"id": 16, "arabic": "وَٱرْتَقِبُوٓا۟", "translit": "۟āٓwُbِqَtْrٱَw", "root": "رقب"}, {"id": 17, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 18, "arabic": "مَعَكُمْ", "translit": "ْmُkَʿعَm", "root": ""}, {"id": 19, "arabic": "رَقِيبٌ", "translit": "ٌbyِqَr", "root": "رقب"}], "hasIhya": false}, {"ayah": 94, "text": "وَلَمَّا جَآءَ أَمْرُنَا نَجَّيْنَا شُعَيْبًا وَٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ بِرَحْمَةٍ مِّنَّا وَأَخَذَتِ ٱلَّذِينَ ظَلَمُوا۟ ٱلصَّيْحَةُ فَأَصْبَحُوا۟ فِى دِيَٰرِهِمْ جَٰثِمِينَ ", "translation": "And when Our command came, We saved Shuʿayb and those who believed with him, by mercy from Us. And the shriek seized those who had wronged, and they became within their homes [corpses] fallen prone", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "أَمْرُنَا", "translit": "āَnُrْmَaʾ", "root": "امر"}, {"id": 4, "arabic": "نَجَّيْنَا", "translit": "āَnْyَّjgَn", "root": "نجو"}, {"id": 5, "arabic": "شُعَيْبًا", "translit": "āًbْyَʿعُhs", "root": ""}, {"id": 6, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 7, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 8, "arabic": "مَعَهُۥ", "translit": "ۥُhَʿعَm", "root": ""}, {"id": 9, "arabic": "بِرَحْمَةٍ", "translit": "ٍẗَmْḥَrِb", "root": "رحم"}, {"id": 10, "arabic": "مِّنَّا", "translit": "āَّnِّm", "root": ""}, {"id": 11, "arabic": "وَأَخَذَتِ", "translit": "ِtَhdَhkَaʾَw", "root": "اخذ"}, {"id": 12, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 13, "arabic": "ظَلَمُوا۟", "translit": "۟āwُmَlَẓ", "root": "ظلم"}, {"id": 14, "arabic": "ٱلصَّيْحَةُ", "translit": "ُẗَḥْyَّṣlٱ", "root": "صيح"}, {"id": 15, "arabic": "فَأَصْبَحُوا۟", "translit": "۟āwُḥَbْṣَaʾَf", "root": "صبح"}, {"id": 16, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 17, "arabic": "دِيَٰرِهِمْ", "translit": "ْmِhِrَٰyِd", "root": "دور"}, {"id": 18, "arabic": "جَٰثِمِينَ", "translit": "َnyِmِhtَٰjg", "root": "جثم"}], "hasIhya": false}, {"ayah": 95, "text": "كَأَن لَّمْ يَغْنَوْا۟ فِيهَآۗ أَلَا بُعْدًا لِّمَدْيَنَ كَمَا بَعِدَتْ ثَمُودُ ", "translation": "As if they had never prospered therein. Then, away with Madyan as Thamūd was taken away.", "words": [{"id": 1, "arabic": "كَأَن", "translit": "nَaʾَk", "root": ""}, {"id": 2, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 3, "arabic": "يَغْنَوْا۟", "translit": "۟āْwَnْغَy", "root": "غني"}, {"id": 4, "arabic": "فِيهَآ", "translit": "ٓāَhyِf", "root": ""}, {"id": 5, "arabic": "أَلَا", "translit": "āَlَaʾ", "root": ""}, {"id": 6, "arabic": "بُعْدًا", "translit": "āًdْʿعُb", "root": "بعد"}, {"id": 7, "arabic": "لِّمَدْيَنَ", "translit": "َnَyْdَmِّl", "root": "مدن"}, {"id": 8, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 9, "arabic": "بَعِدَتْ", "translit": "ْtَdِʿعَb", "root": "بعد"}, {"id": 10, "arabic": "ثَمُودُ", "translit": "ُdwُmَht", "root": ""}], "hasIhya": true}, {"ayah": 96, "text": "وَلَقَدْ أَرْسَلْنَا مُوسَىٰ بِـَٔايَٰتِنَا وَسُلْطَٰنٍ مُّبِينٍ ", "translation": "And We did certainly send Moses with Our signs and a clear authority[1]", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 4, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 5, "arabic": "وَسُلْطَٰنٍ", "translit": "ٍnَٰṭْlُsَw", "root": "سلط"}, {"id": 6, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 97, "text": "إِلَىٰ فِرْعَوْنَ وَمَلَإِي۟هِۦ فَٱتَّبَعُوٓا۟ أَمْرَ فِرْعَوْنَۖ وَمَآ أَمْرُ فِرْعَوْنَ بِرَشِيدٍ ", "translation": "To Pharaoh and his establishment, but they followed the command of Pharaoh, and the command of Pharaoh was not [at all] discerning.", "words": [{"id": 1, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 2, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 3, "arabic": "وَمَلَإِي۟هِۦ", "translit": "ۦِh۟yِiʾَlَmَw", "root": "ملا"}, {"id": 4, "arabic": "فَٱتَّبَعُوٓا۟", "translit": "۟āٓwُʿعَbَّtٱَf", "root": "تبع"}, {"id": 5, "arabic": "أَمْرَ", "translit": "َrْmَaʾ", "root": "امر"}, {"id": 6, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 7, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 8, "arabic": "أَمْرُ", "translit": "ُrْmَaʾ", "root": "امر"}, {"id": 9, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 10, "arabic": "بِرَشِيدٍ", "translit": "ٍdyِhsَrِb", "root": "رشد"}], "hasIhya": false}, {"ayah": 98, "text": "يَقْدُمُ قَوْمَهُۥ يَوْمَ ٱلْقِيَٰمَةِ فَأَوْرَدَهُمُ ٱلنَّارَۖ وَبِئْسَ ٱلْوِرْدُ ٱلْمَوْرُودُ ", "translation": "He will precede his people on the Day of Resurrection and lead them into the Fire; and wretched is the place to which they are led.", "words": [{"id": 1, "arabic": "يَقْدُمُ", "translit": "ُmُdْqَy", "root": "قدم"}, {"id": 2, "arabic": "قَوْمَهُۥ", "translit": "ۥُhَmْwَq", "root": "قوم"}, {"id": 3, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 4, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 5, "arabic": "فَأَوْرَدَهُمُ", "translit": "ُmُhَdَrْwَaʾَf", "root": "ورد"}, {"id": 6, "arabic": "ٱلنَّارَ", "translit": "َrāَّnlٱ", "root": "نور"}, {"id": 7, "arabic": "وَبِئْسَ", "translit": "َsْyʾِbَw", "root": "باس"}, {"id": 8, "arabic": "ٱلْوِرْدُ", "translit": "ُdْrِwْlٱ", "root": "ورد"}, {"id": 9, "arabic": "ٱلْمَوْرُودُ", "translit": "ُdwُrْwَmْlٱ", "root": "ورد"}], "hasIhya": false}, {"ayah": 99, "text": "وَأُتْبِعُوا۟ فِى هَٰذِهِۦ لَعْنَةً وَيَوْمَ ٱلْقِيَٰمَةِۚ بِئْسَ ٱلرِّفْدُ ٱلْمَرْفُودُ ", "translation": "And they were followed in this [world] with a curse and on the Day of Resurrection. And wretched is the gift[1] which is given.", "words": [{"id": 1, "arabic": "وَأُتْبِعُوا۟", "translit": "۟āwُʿعِbْtُaʾَw", "root": "تبع"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "هَٰذِهِۦ", "translit": "ۦِhِhdَٰh", "root": ""}, {"id": 4, "arabic": "لَعْنَةً", "translit": "ًẗَnْʿعَl", "root": "لعن"}, {"id": 5, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 6, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 7, "arabic": "بِئْسَ", "translit": "َsْyʾِb", "root": "باس"}, {"id": 8, "arabic": "ٱلرِّفْدُ", "translit": "ُdْfِّrlٱ", "root": "رفد"}, {"id": 9, "arabic": "ٱلْمَرْفُودُ", "translit": "ُdwُfْrَmْlٱ", "root": "رفد"}], "hasIhya": false}, {"ayah": 100, "text": "ذَٰلِكَ مِنْ أَنۢبَآءِ ٱلْقُرَىٰ نَقُصُّهُۥ عَلَيْكَۖ مِنْهَا قَآئِمٌ وَحَصِيدٌ ", "translation": "That is from the news of the cities, which We relate to you; of them, some are [still] standing and some are [as] a harvest [mowed down].[1]", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 3, "arabic": "أَنۢبَآءِ", "translit": "ِءٓāَbۢnَaʾ", "root": "نبا"}, {"id": 4, "arabic": "ٱلْقُرَىٰ", "translit": "ٰàَrُqْlٱ", "root": "قري"}, {"id": 5, "arabic": "نَقُصُّهُۥ", "translit": "ۥُhُّṣُqَn", "root": "قصص"}, {"id": 6, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 7, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 8, "arabic": "قَآئِمٌ", "translit": "ٌmِyʾٓāَq", "root": "قوم"}, {"id": 9, "arabic": "وَحَصِيدٌ", "translit": "ٌdyِṣَḥَw", "root": "حصد"}], "hasIhya": false}, {"ayah": 101, "text": "وَمَا ظَلَمْنَٰهُمْ وَلَٰكِن ظَلَمُوٓا۟ أَنفُسَهُمْۖ فَمَآ أَغْنَتْ عَنْهُمْ ءَالِهَتُهُمُ ٱلَّتِى يَدْعُونَ مِن دُونِ ٱللَّهِ مِن شَىْءٍ لَّمَّا جَآءَ أَمْرُ رَبِّكَۖ وَمَا زَادُوهُمْ غَيْرَ تَتْبِيبٍ ", "translation": "And We did not wrong them, but they wronged themselves. And they were not availed at all by their gods which they invoked other than Allāh when there came the command of your Lord. And they did not increase them in other than ruin.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "ظَلَمْنَٰهُمْ", "translit": "ْmُhَٰnْmَlَẓ", "root": "ظلم"}, {"id": 3, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 4, "arabic": "ظَلَمُوٓا۟", "translit": "۟āٓwُmَlَẓ", "root": "ظلم"}, {"id": 5, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 6, "arabic": "فَمَآ", "translit": "ٓāَmَf", "root": ""}, {"id": 7, "arabic": "أَغْنَتْ", "translit": "ْtَnْغَaʾ", "root": "غني"}, {"id": 8, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 9, "arabic": "ءَالِهَتُهُمُ", "translit": "ُmُhُtَhِlāَء", "root": "اله"}, {"id": 10, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 11, "arabic": "يَدْعُونَ", "translit": "َnwُʿعْdَy", "root": "دعو"}, {"id": 12, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 13, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 14, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 16, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 17, "arabic": "لَّمَّا", "translit": "āَّmَّl", "root": ""}, {"id": 18, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 19, "arabic": "أَمْرُ", "translit": "ُrْmَaʾ", "root": "امر"}, {"id": 20, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 21, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 22, "arabic": "زَادُوهُمْ", "translit": "ْmُhwُdāَz", "root": "زيد"}, {"id": 23, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 24, "arabic": "تَتْبِيبٍ", "translit": "ٍbyِbْtَt", "root": "تبب"}], "hasIhya": false}, {"ayah": 102, "text": "وَكَذَٰلِكَ أَخْذُ رَبِّكَ إِذَآ أَخَذَ ٱلْقُرَىٰ وَهِىَ ظَٰلِمَةٌۚ إِنَّ أَخْذَهُۥٓ أَلِيمٌ شَدِيدٌ ", "translation": "And thus is the seizure of your Lord when He seizes the cities while they are committing wrong. Indeed, His seizure is painful and severe.", "words": [{"id": 1, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 2, "arabic": "أَخْذُ", "translit": "ُhdْhkَaʾ", "root": "اخذ"}, {"id": 3, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 5, "arabic": "أَخَذَ", "translit": "َhdَhkَaʾ", "root": "اخذ"}, {"id": 6, "arabic": "ٱلْقُرَىٰ", "translit": "ٰàَrُqْlٱ", "root": "قري"}, {"id": 7, "arabic": "وَهِىَ", "translit": "َàِhَw", "root": ""}, {"id": 8, "arabic": "ظَٰلِمَةٌ", "translit": "ٌẗَmِlَٰẓ", "root": "ظلم"}, {"id": 9, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 10, "arabic": "أَخْذَهُۥٓ", "translit": "ٓۥُhَhdْhkَaʾ", "root": "اخذ"}, {"id": 11, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}, {"id": 12, "arabic": "شَدِيدٌ", "translit": "ٌdyِdَhs", "root": "شدد"}], "hasIhya": true}, {"ayah": 103, "text": "إِنَّ فِى ذَٰلِكَ لَءَايَةً لِّمَنْ خَافَ عَذَابَ ٱلْءَاخِرَةِۚ ذَٰلِكَ يَوْمٌ مَّجْمُوعٌ لَّهُ ٱلنَّاسُ وَذَٰلِكَ يَوْمٌ مَّشْهُودٌ ", "translation": "Indeed in that is a sign for those who fear the punishment of the Hereafter. That is a Day for which the people will be collected, and that is a Day [which will be] witnessed.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 4, "arabic": "لَءَايَةً", "translit": "ًẗَyāَءَl", "root": "ايي"}, {"id": 5, "arabic": "لِّمَنْ", "translit": "ْnَmِّl", "root": ""}, {"id": 6, "arabic": "خَافَ", "translit": "َfāَhk", "root": "خوف"}, {"id": 7, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 8, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 9, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 10, "arabic": "يَوْمٌ", "translit": "ٌmْwَy", "root": "يوم"}, {"id": 11, "arabic": "مَّجْمُوعٌ", "translit": "ٌʿعwُmْjgَّm", "root": "جمع"}, {"id": 12, "arabic": "لَّهُ", "translit": "ُhَّl", "root": ""}, {"id": 13, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 14, "arabic": "وَذَٰلِكَ", "translit": "َkِlَٰhdَw", "root": ""}, {"id": 15, "arabic": "يَوْمٌ", "translit": "ٌmْwَy", "root": "يوم"}, {"id": 16, "arabic": "مَّشْهُودٌ", "translit": "ٌdwُhْhsَّm", "root": "شهد"}], "hasIhya": false}, {"ayah": 104, "text": "وَمَا نُؤَخِّرُهُۥٓ إِلَّا لِأَجَلٍ مَّعْدُودٍ ", "translation": "And We do not delay it except for a limited term.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "نُؤَخِّرُهُۥٓ", "translit": "ٓۥُhُrِّhkَwʾُn", "root": "اخر"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "لِأَجَلٍ", "translit": "ٍlَjgَaʾِl", "root": "اجل"}, {"id": 5, "arabic": "مَّعْدُودٍ", "translit": "ٍdwُdْʿعَّm", "root": "عدد"}], "hasIhya": false}, {"ayah": 105, "text": "يَوْمَ يَأْتِ لَا تَكَلَّمُ نَفْسٌ إِلَّا بِإِذْنِهِۦۚ فَمِنْهُمْ شَقِىٌّ وَسَعِيدٌ ", "translation": "The Day it comes no soul will speak except by His permission. And among them will be the wretched and the prosperous.", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "يَأْتِ", "translit": "ِtْaʾَy", "root": "اتي"}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "تَكَلَّمُ", "translit": "ُmَّlَkَt", "root": "كلم"}, {"id": 5, "arabic": "نَفْسٌ", "translit": "ٌsْfَn", "root": "نفس"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "بِإِذْنِهِۦ", "translit": "ۦِhِnْhdِiʾِb", "root": "اذن"}, {"id": 8, "arabic": "فَمِنْهُمْ", "translit": "ْmُhْnِmَf", "root": ""}, {"id": 9, "arabic": "شَقِىٌّ", "translit": "ٌّàِqَhs", "root": "شقو"}, {"id": 10, "arabic": "وَسَعِيدٌ", "translit": "ٌdyِʿعَsَw", "root": "سعد"}], "hasIhya": false}, {"ayah": 106, "text": "فَأَمَّا ٱلَّذِينَ شَقُوا۟ فَفِى ٱلنَّارِ لَهُمْ فِيهَا زَفِيرٌ وَشَهِيقٌ ", "translation": "As for those who were [destined to be] wretched, they will be in the Fire. For them therein is [violent] exhaling and inhaling.[1]", "words": [{"id": 1, "arabic": "فَأَمَّا", "translit": "āَّmَaʾَf", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "شَقُوا۟", "translit": "۟āwُqَhs", "root": "شقو"}, {"id": 4, "arabic": "فَفِى", "translit": "àِfَf", "root": ""}, {"id": 5, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 6, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 7, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 8, "arabic": "زَفِيرٌ", "translit": "ٌryِfَz", "root": "زفر"}, {"id": 9, "arabic": "وَشَهِيقٌ", "translit": "ٌqyِhَhsَw", "root": "شهق"}], "hasIhya": false}, {"ayah": 107, "text": "خَٰلِدِينَ فِيهَا مَا دَامَتِ ٱلسَّمَٰوَٰتُ وَٱلْأَرْضُ إِلَّا مَا شَآءَ رَبُّكَۚ إِنَّ رَبَّكَ فَعَّالٌ لِّمَا يُرِيدُ ", "translation": "[They will be] abiding therein as long as the heavens and the earth endure, except what your Lord should will. Indeed, your Lord is an effecter of what He intends.", "words": [{"id": 1, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "دَامَتِ", "translit": "ِtَmāَd", "root": "دوم"}, {"id": 5, "arabic": "ٱلسَّمَٰوَٰتُ", "translit": "ُtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَٱلْأَرْضُ", "translit": "ُḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 7, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 10, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 11, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 12, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 13, "arabic": "فَعَّالٌ", "translit": "ٌlāَّʿعَf", "root": "فعل"}, {"id": 14, "arabic": "لِّمَا", "translit": "āَmِّl", "root": ""}, {"id": 15, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}], "hasIhya": true}, {"ayah": 108, "text": "وَأَمَّا ٱلَّذِينَ سُعِدُوا۟ فَفِى ٱلْجَنَّةِ خَٰلِدِينَ فِيهَا مَا دَامَتِ ٱلسَّمَٰوَٰتُ وَٱلْأَرْضُ إِلَّا مَا شَآءَ رَبُّكَۖ عَطَآءً غَيْرَ مَجْذُوذٍ ", "translation": "And as for those who were [destined to be] prosperous, they will be in Paradise, abiding therein as long as the heavens and the earth endure, except what your Lord should will - a bestowal uninterrupted.", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "āَّmَaʾَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "سُعِدُوا۟", "translit": "۟āwُdِʿعُs", "root": "سعد"}, {"id": 4, "arabic": "فَفِى", "translit": "àِfَf", "root": ""}, {"id": 5, "arabic": "ٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱ", "root": "جنن"}, {"id": 6, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 7, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "دَامَتِ", "translit": "ِtَmāَd", "root": "دوم"}, {"id": 10, "arabic": "ٱلسَّمَٰوَٰتُ", "translit": "ُtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 11, "arabic": "وَٱلْأَرْضُ", "translit": "ُḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 12, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 13, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 14, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 15, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 16, "arabic": "عَطَآءً", "translit": "ًءٓāَṭَʿع", "root": "عطو"}, {"id": 17, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 18, "arabic": "مَجْذُوذٍ", "translit": "ٍhdwُhdْjgَm", "root": "جذذ"}], "hasIhya": false}, {"ayah": 109, "text": "فَلَا تَكُ فِى مِرْيَةٍ مِّمَّا يَعْبُدُ هَٰٓؤُلَآءِۚ مَا يَعْبُدُونَ إِلَّا كَمَا يَعْبُدُ ءَابَآؤُهُم مِّن قَبْلُۚ وَإِنَّا لَمُوَفُّوهُمْ نَصِيبَهُمْ غَيْرَ مَنقُوصٍ ", "translation": "So do not be in doubt, [O Muḥammad], as to what these [polytheists] are worshipping. They worship not except as their fathers worshipped before. And indeed, We will give them their share undiminished.", "words": [{"id": 1, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 2, "arabic": "تَكُ", "translit": "ُkَt", "root": "كون"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "مِرْيَةٍ", "translit": "ٍẗَyْrِm", "root": "مري"}, {"id": 5, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 6, "arabic": "يَعْبُدُ", "translit": "ُdُbْʿعَy", "root": "عبد"}, {"id": 7, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "يَعْبُدُونَ", "translit": "َnwُdُbْʿعَy", "root": "عبد"}, {"id": 10, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 11, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 12, "arabic": "يَعْبُدُ", "translit": "ُdُbْʿعَy", "root": "عبد"}, {"id": 13, "arabic": "ءَابَآؤُهُم", "translit": "mُhُwʾٓāَbāَء", "root": "ابو"}, {"id": 14, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 15, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 16, "arabic": "وَإِنَّا", "translit": "āَّnِiʾَw", "root": ""}, {"id": 17, "arabic": "لَمُوَفُّوهُمْ", "translit": "ْmُhwُّfَwُmَl", "root": "وفي"}, {"id": 18, "arabic": "نَصِيبَهُمْ", "translit": "ْmُhَbyِṣَn", "root": "نصب"}, {"id": 19, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 20, "arabic": "مَنقُوصٍ", "translit": "ٍṣwُqnَm", "root": "نقص"}], "hasIhya": false}, {"ayah": 110, "text": "وَلَقَدْ ءَاتَيْنَا مُوسَى ٱلْكِتَٰبَ فَٱخْتُلِفَ فِيهِۚ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِن رَّبِّكَ لَقُضِىَ بَيْنَهُمْۚ وَإِنَّهُمْ لَفِى شَكٍّ مِّنْهُ مُرِيبٍ ", "translation": "And We had certainly given Moses the Scripture, but it came under disagreement. And if not for a word[1] that preceded from your Lord, it would have been judged between them. And indeed they are, concerning it [i.e., the Qur’ān], in disquieting doubt.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَا", "translit": "āَnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "مُوسَى", "translit": "àَswُm", "root": ""}, {"id": 4, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "فَٱخْتُلِفَ", "translit": "َfِlُtْhkٱَf", "root": "خلف"}, {"id": 6, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 7, "arabic": "وَلَوْلَا", "translit": "āَlْwَlَw", "root": ""}, {"id": 8, "arabic": "كَلِمَةٌ", "translit": "ٌẗَmِlَk", "root": "كلم"}, {"id": 9, "arabic": "سَبَقَتْ", "translit": "ْtَqَbَs", "root": "سبق"}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 12, "arabic": "لَقُضِىَ", "translit": "َàِḍُqَl", "root": "قضي"}, {"id": 13, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 14, "arabic": "وَإِنَّهُمْ", "translit": "ْmُhَّnِiʾَw", "root": ""}, {"id": 15, "arabic": "لَفِى", "translit": "àِfَl", "root": ""}, {"id": 16, "arabic": "شَكٍّ", "translit": "ٍّkَhs", "root": "شكك"}, {"id": 17, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 18, "arabic": "مُرِيبٍ", "translit": "ٍbyِrُm", "root": "ريب"}], "hasIhya": false}, {"ayah": 111, "text": "وَإِنَّ كُلًّا لَّمَّا لَيُوَفِّيَنَّهُمْ رَبُّكَ أَعْمَٰلَهُمْۚ إِنَّهُۥ بِمَا يَعْمَلُونَ خَبِيرٌ ", "translation": "And indeed, each [of the believers and disbelievers] - your Lord will fully compensate them for their deeds. Indeed, He is Aware of what they do.", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 2, "arabic": "كُلًّا", "translit": "āًّlُk", "root": "كلل"}, {"id": 3, "arabic": "لَّمَّا", "translit": "āَّmَّl", "root": ""}, {"id": 4, "arabic": "لَيُوَفِّيَنَّهُمْ", "translit": "ْmُhَّnَyِّfَwُyَl", "root": "وفي"}, {"id": 5, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 6, "arabic": "أَعْمَٰلَهُمْ", "translit": "ْmُhَlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 7, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 8, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 9, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}, {"id": 10, "arabic": "خَبِيرٌ", "translit": "ٌryِbَhk", "root": "خبر"}], "hasIhya": false}, {"ayah": 112, "text": "فَٱسْتَقِمْ كَمَآ أُمِرْتَ وَمَن تَابَ مَعَكَ وَلَا تَطْغَوْا۟ۚ إِنَّهُۥ بِمَا تَعْمَلُونَ بَصِيرٌ ", "translation": "So remain on a right course as you have been commanded, [you] and those who have turned back with you [to Allāh], and do not transgress. Indeed, He is Seeing of what you do.", "words": [{"id": 1, "arabic": "فَٱسْتَقِمْ", "translit": "ْmِqَtْsٱَf", "root": "قوم"}, {"id": 2, "arabic": "كَمَآ", "translit": "ٓāَmَk", "root": ""}, {"id": 3, "arabic": "أُمِرْتَ", "translit": "َtْrِmُaʾ", "root": "امر"}, {"id": 4, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 5, "arabic": "تَابَ", "translit": "َbāَt", "root": "توب"}, {"id": 6, "arabic": "مَعَكَ", "translit": "َkَʿعَm", "root": ""}, {"id": 7, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 8, "arabic": "تَطْغَوْا۟", "translit": "۟āْwَغْṭَt", "root": "طغي"}, {"id": 9, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 10, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 11, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 12, "arabic": "بَصِيرٌ", "translit": "ٌryِṣَb", "root": "بصر"}], "hasIhya": false}, {"ayah": 113, "text": "وَلَا تَرْكَنُوٓا۟ إِلَى ٱلَّذِينَ ظَلَمُوا۟ فَتَمَسَّكُمُ ٱلنَّارُ وَمَا لَكُم مِّن دُونِ ٱللَّهِ مِنْ أَوْلِيَآءَ ثُمَّ لَا تُنصَرُونَ ", "translation": "And do not incline toward those who do wrong, lest you be touched by the Fire, and you would not have other than Allāh any protectors; then you would not be helped.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَرْكَنُوٓا۟", "translit": "۟āٓwُnَkْrَt", "root": "ركن"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "ظَلَمُوا۟", "translit": "۟āwُmَlَẓ", "root": "ظلم"}, {"id": 6, "arabic": "فَتَمَسَّكُمُ", "translit": "ُmُkَّsَmَtَf", "root": "مسس"}, {"id": 7, "arabic": "ٱلنَّارُ", "translit": "ُrāَّnlٱ", "root": "نور"}, {"id": 8, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 9, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 10, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 11, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 14, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 15, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 16, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 17, "arabic": "تُنصَرُونَ", "translit": "َnwُrَṣnُt", "root": "نصر"}], "hasIhya": true}, {"ayah": 114, "text": "وَأَقِمِ ٱلصَّلَوٰةَ طَرَفَىِ ٱلنَّهَارِ وَزُلَفًا مِّنَ ٱلَّيْلِۚ إِنَّ ٱلْحَسَنَٰتِ يُذْهِبْنَ ٱلسَّيِّـَٔاتِۚ ذَٰلِكَ ذِكْرَىٰ لِلذَّٰكِرِينَ ", "translation": "And establish prayer at the two ends of the day and at the approach of the night. Indeed, good deeds do away with misdeeds. That is a reminder for those who remember.", "words": [{"id": 1, "arabic": "وَأَقِمِ", "translit": "ِmِqَaʾَw", "root": "قوم"}, {"id": 2, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 3, "arabic": "طَرَفَىِ", "translit": "ِàَfَrَṭ", "root": "طرف"}, {"id": 4, "arabic": "ٱلنَّهَارِ", "translit": "ِrāَhَّnlٱ", "root": "نهر"}, {"id": 5, "arabic": "وَزُلَفًا", "translit": "āًfَlُzَw", "root": "زلف"}, {"id": 6, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 7, "arabic": "ٱلَّيْلِ", "translit": "ِlْyَّlٱ", "root": "ليل"}, {"id": 8, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 9, "arabic": "ٱلْحَسَنَٰتِ", "translit": "ِtَٰnَsَḥْlٱ", "root": "حسن"}, {"id": 10, "arabic": "يُذْهِبْنَ", "translit": "َnْbِhْhdُy", "root": "ذهب"}, {"id": 11, "arabic": "ٱلسَّيِّـَٔاتِ", "translit": "ِtāَٔـِّyَّslٱ", "root": "سوا"}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 13, "arabic": "ذِكْرَىٰ", "translit": "ٰàَrْkِhd", "root": "ذكر"}, {"id": 14, "arabic": "لِلذَّٰكِرِينَ", "translit": "َnyِrِkَّٰhdlِl", "root": "ذكر"}], "hasIhya": true}, {"ayah": 115, "text": "وَٱصْبِرْ فَإِنَّ ٱللَّهَ لَا يُضِيعُ أَجْرَ ٱلْمُحْسِنِينَ ", "translation": "And be patient, for indeed, Allāh does not allow to be lost the reward of those who do good.", "words": [{"id": 1, "arabic": "وَٱصْبِرْ", "translit": "ْrِbْṣٱَw", "root": "صبر"}, {"id": 2, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 3, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "يُضِيعُ", "translit": "ُʿعyِḍُy", "root": "ضيع"}, {"id": 6, "arabic": "أَجْرَ", "translit": "َrْjgَaʾ", "root": "اجر"}, {"id": 7, "arabic": "ٱلْمُحْسِنِينَ", "translit": "َnyِnِsْḥُmْlٱ", "root": "حسن"}], "hasIhya": true}, {"ayah": 116, "text": "فَلَوْلَا كَانَ مِنَ ٱلْقُرُونِ مِن قَبْلِكُمْ أُو۟لُوا۟ بَقِيَّةٍ يَنْهَوْنَ عَنِ ٱلْفَسَادِ فِى ٱلْأَرْضِ إِلَّا قَلِيلًا مِّمَّنْ أَنجَيْنَا مِنْهُمْۗ وَٱتَّبَعَ ٱلَّذِينَ ظَلَمُوا۟ مَآ أُتْرِفُوا۟ فِيهِ وَكَانُوا۟ مُجْرِمِينَ ", "translation": "So why were there not[1] among the generations before you those of enduring discrimination forbidding corruption on earth - except a few of those We saved from among them? But those who wronged pursued what luxury they were given therein, and they were criminals.", "words": [{"id": 1, "arabic": "فَلَوْلَا", "translit": "āَlْwَlَf", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلْقُرُونِ", "translit": "ِnwُrُqْlٱ", "root": "قرن"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "قَبْلِكُمْ", "translit": "ْmُkِlْbَq", "root": "قبل"}, {"id": 7, "arabic": "أُو۟لُوا۟", "translit": "۟āwُl۟wُaʾ", "root": ""}, {"id": 8, "arabic": "بَقِيَّةٍ", "translit": "ٍẗَّyِqَb", "root": "بقي"}, {"id": 9, "arabic": "يَنْهَوْنَ", "translit": "َnْwَhْnَy", "root": "نهي"}, {"id": 10, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 11, "arabic": "ٱلْفَسَادِ", "translit": "ِdāَsَfْlٱ", "root": "فسد"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 14, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 15, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 16, "arabic": "مِّمَّنْ", "translit": "ْnَّmِّm", "root": ""}, {"id": 17, "arabic": "أَنجَيْنَا", "translit": "āَnْyَjgnَaʾ", "root": "نجو"}, {"id": 18, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 19, "arabic": "وَٱتَّبَعَ", "translit": "َʿعَbَّtٱَw", "root": "تبع"}, {"id": 20, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 21, "arabic": "ظَلَمُوا۟", "translit": "۟āwُmَlَẓ", "root": "ظلم"}, {"id": 22, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 23, "arabic": "أُتْرِفُوا۟", "translit": "۟āwُfِrْtُaʾ", "root": "ترف"}, {"id": 24, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 25, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 26, "arabic": "مُجْرِمِينَ", "translit": "َnyِmِrْjgُm", "root": "جرم"}], "hasIhya": true}, {"ayah": 117, "text": "وَمَا كَانَ رَبُّكَ لِيُهْلِكَ ٱلْقُرَىٰ بِظُلْمٍ وَأَهْلُهَا مُصْلِحُونَ ", "translation": "And your Lord would not have destroyed the cities unjustly while their people were reformers.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 4, "arabic": "لِيُهْلِكَ", "translit": "َkِlْhُyِl", "root": "هلك"}, {"id": 5, "arabic": "ٱلْقُرَىٰ", "translit": "ٰàَrُqْlٱ", "root": "قري"}, {"id": 6, "arabic": "بِظُلْمٍ", "translit": "ٍmْlُẓِb", "root": "ظلم"}, {"id": 7, "arabic": "وَأَهْلُهَا", "translit": "āَhُlْhَaʾَw", "root": "اهل"}, {"id": 8, "arabic": "مُصْلِحُونَ", "translit": "َnwُḥِlْṣُm", "root": "صلح"}], "hasIhya": false}, {"ayah": 118, "text": "وَلَوْ شَآءَ رَبُّكَ لَجَعَلَ ٱلنَّاسَ أُمَّةً وَٰحِدَةًۖ وَلَا يَزَالُونَ مُخْتَلِفِينَ ", "translation": "And if your Lord had willed, He could have made mankind one community; but they will not cease to differ,", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 3, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 4, "arabic": "لَجَعَلَ", "translit": "َlَʿعَjgَl", "root": "جعل"}, {"id": 5, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 6, "arabic": "أُمَّةً", "translit": "ًẗَّmُaʾ", "root": "امم"}, {"id": 7, "arabic": "وَٰحِدَةً", "translit": "ًẗَdِḥَٰw", "root": "وحد"}, {"id": 8, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 9, "arabic": "يَزَالُونَ", "translit": "َnwُlāَzَy", "root": "زيل"}, {"id": 10, "arabic": "مُخْتَلِفِينَ", "translit": "َnyِfِlَtْhkُm", "root": "خلف"}], "hasIhya": false}, {"ayah": 119, "text": "إِلَّا مَن رَّحِمَ رَبُّكَۚ وَلِذَٰلِكَ خَلَقَهُمْۗ وَتَمَّتْ كَلِمَةُ رَبِّكَ لَأَمْلَأَنَّ جَهَنَّمَ مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ أَجْمَعِينَ ", "translation": "Except whom your Lord has given mercy, and for that He created them. But the word of your Lord is to be fulfilled that, \"I will surely fill Hell with jinn and men all together.\"", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "رَّحِمَ", "translit": "َmِḥَّr", "root": "رحم"}, {"id": 4, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 5, "arabic": "وَلِذَٰلِكَ", "translit": "َkِlَٰhdِlَw", "root": ""}, {"id": 6, "arabic": "خَلَقَهُمْ", "translit": "ْmُhَqَlَhk", "root": "خلق"}, {"id": 7, "arabic": "وَتَمَّتْ", "translit": "ْtَّmَtَw", "root": "تمم"}, {"id": 8, "arabic": "كَلِمَةُ", "translit": "ُẗَmِlَk", "root": "كلم"}, {"id": 9, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 10, "arabic": "لَأَمْلَأَنَّ", "translit": "َّnَaʾَlْmَaʾَl", "root": "ملا"}, {"id": 11, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 12, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 13, "arabic": "ٱلْجِنَّةِ", "translit": "ِẗَّnِjgْlٱ", "root": "جنن"}, {"id": 14, "arabic": "وَٱلنَّاسِ", "translit": "ِsāَّnlٱَw", "root": "انس"}, {"id": 15, "arabic": "أَجْمَعِينَ", "translit": "َnyِʿعَmْjgَaʾ", "root": "جمع"}], "hasIhya": true}, {"ayah": 120, "text": "وَكُلًّا نَّقُصُّ عَلَيْكَ مِنْ أَنۢبَآءِ ٱلرُّسُلِ مَا نُثَبِّتُ بِهِۦ فُؤَادَكَۚ وَجَآءَكَ فِى هَٰذِهِ ٱلْحَقُّ وَمَوْعِظَةٌ وَذِكْرَىٰ لِلْمُؤْمِنِينَ ", "translation": "And each [story] We relate to you from the news of the messengers is that by which We make firm your heart. And there has come to you, in this, the truth and an instruction and a reminder for the believers.", "words": [{"id": 1, "arabic": "وَكُلًّا", "translit": "āًّlُkَw", "root": "كلل"}, {"id": 2, "arabic": "نَّقُصُّ", "translit": "ُّṣُqَّn", "root": "قصص"}, {"id": 3, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 4, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 5, "arabic": "أَنۢبَآءِ", "translit": "ِءٓāَbۢnَaʾ", "root": "نبا"}, {"id": 6, "arabic": "ٱلرُّسُلِ", "translit": "ِlُsُّrlٱ", "root": "رسل"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "نُثَبِّتُ", "translit": "ُtِّbَhtُn", "root": "ثبت"}, {"id": 9, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 10, "arabic": "فُؤَادَكَ", "translit": "َkَdāَwʾُf", "root": "فاد"}, {"id": 11, "arabic": "وَجَآءَكَ", "translit": "َkَءٓāَjgَw", "root": "جيا"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "هَٰذِهِ", "translit": "ِhِhdَٰh", "root": ""}, {"id": 14, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 15, "arabic": "وَمَوْعِظَةٌ", "translit": "ٌẗَẓِʿعْwَmَw", "root": "وعظ"}, {"id": 16, "arabic": "وَذِكْرَىٰ", "translit": "ٰàَrْkِhdَw", "root": "ذكر"}, {"id": 17, "arabic": "لِلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlِl", "root": "امن"}], "hasIhya": true}, {"ayah": 121, "text": "وَقُل لِّلَّذِينَ لَا يُؤْمِنُونَ ٱعْمَلُوا۟ عَلَىٰ مَكَانَتِكُمْ إِنَّا عَٰمِلُونَ ", "translation": "And say to those who do not believe, \"Work according to your position; indeed, we are working.", "words": [{"id": 1, "arabic": "وَقُل", "translit": "lُqَw", "root": "قول"}, {"id": 2, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 5, "arabic": "ٱعْمَلُوا۟", "translit": "۟āwُlَmْʿعٱ", "root": "عمل"}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "مَكَانَتِكُمْ", "translit": "ْmُkِtَnāَkَm", "root": "كون"}, {"id": 8, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 9, "arabic": "عَٰمِلُونَ", "translit": "َnwُlِmَٰʿع", "root": "عمل"}], "hasIhya": false}, {"ayah": 122, "text": "وَٱنتَظِرُوٓا۟ إِنَّا مُنتَظِرُونَ ", "translation": "And wait; indeed, we are waiting.\"", "words": [{"id": 1, "arabic": "وَٱنتَظِرُوٓا۟", "translit": "۟āٓwُrِẓَtnٱَw", "root": "نظر"}, {"id": 2, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 3, "arabic": "مُنتَظِرُونَ", "translit": "َnwُrِẓَtnُm", "root": "نظر"}], "hasIhya": false}, {"ayah": 123, "text": "وَلِلَّهِ غَيْبُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَإِلَيْهِ يُرْجَعُ ٱلْأَمْرُ كُلُّهُۥ فَٱعْبُدْهُ وَتَوَكَّلْ عَلَيْهِۚ وَمَا رَبُّكَ بِغَٰفِلٍ عَمَّا تَعْمَلُونَ ", "translation": "And to Allāh belong the unseen [aspects] of the heavens and the earth and to Him will be returned the matter, all of it, so worship Him and rely upon Him. And your Lord is not unaware of that which you do.", "words": [{"id": 1, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 2, "arabic": "غَيْبُ", "translit": "ُbْyَغ", "root": "غيب"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "وَإِلَيْهِ", "translit": "ِhْyَlِiʾَw", "root": ""}, {"id": 6, "arabic": "يُرْجَعُ", "translit": "ُʿعَjgْrُy", "root": "رجع"}, {"id": 7, "arabic": "ٱلْأَمْرُ", "translit": "ُrْmَaʾْlٱ", "root": "امر"}, {"id": 8, "arabic": "كُلُّهُۥ", "translit": "ۥُhُّlُk", "root": "كلل"}, {"id": 9, "arabic": "فَٱعْبُدْهُ", "translit": "ُhْdُbْʿعٱَf", "root": "عبد"}, {"id": 10, "arabic": "وَتَوَكَّلْ", "translit": "ْlَّkَwَtَw", "root": "وكل"}, {"id": 11, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 12, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 13, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 14, "arabic": "بِغَٰفِلٍ", "translit": "ٍlِfَٰغِb", "root": "غفل"}, {"id": 15, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 16, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": true}], "tafsir": {"4": [{"arabic": "وهو مع ذلك قريب من كل موجود وهو أقرب إلى العبد من حبل الوريد وهو على كل شيء شهيد إذ لا يماثل قربه قرب الأجسام كما لا تماثل ذاته ذات الأجسام وأنه لا يحل في شيء ولا يحل فيه شيء تعالى عن أن يحويه مكان كما تقدس عن أن يحده زمان بل كان قبل أن خلق الزمان والمكان وهو الآن على ما عليه كان وأنه بائن عن خلقه بصفاته ليس في ذاته سواه ولا في سواه ذاته وأنه مقدس عن التغير والانتقال لا تحله الحوادث ولا تعتريه العوارض بل لا يزال في نعوت جلاله منزها عن الزوال وفي صفات كماله مستغنيا عن زيادة الاستكمال وأنه في ذاته معلوم الوجود بالعقول مرئ", "english": "- **Root: خلق (khalaqa)**\n  - *Lisan / Ayn:* Core meaning of measuring, proportioning, and fashioning; al-Khalil notes the root's application to the act of creation as bringing forth upon a measured determination.\n  - *Al-Raghib (Mufradat):* \"الخلق أصله: التقدير المستقيم\" — Creation fundamentally signifies right/straight measurement; used for bringing into being from nothing (ibdāʿ) as in {خلق السماوات والأرض}, and for bringing forth from something as in {خلقكم من نفس واحدة}.\n  - *Al-Zamakhshari (Asas):* Literal (ḥaqīqah): the craftsman's measuring before cutting. Metaphorical (majāz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure necessitated by wisdom.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 72", "section_title_en": "Section 72", "section_index": 72, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'", "badge": "Insight"}, {"arabic": "الأصل الأول العلم بأن صانع العالم قادر وأنه تعالى في قوله وهو على كل شيء قدير صادق لأن العالم محكم في صنعته مرتب في خلقته ومن رأى ثوبا من ديباج حسن النسج والتأليف متناسب التطريز والتطريف ثم توهم صدور نسجه عن ميت لا استطاعة له أو عن إنسان لا قدرة له كان منخلعا عن غريزة العقل ومنخرطا في سلك أهل الغباوة والجهل الأصل الثاني العلم بأنه تعالى عالم بجميع الموجودات ومحيط بكل المخلوقات لا يعزب عن علمه مثقال ذرة في الأرض ولا في السماء صادق في قوله وهو بكل شيء عليم ومرشد إلى صدقه بقوله تعالى ألا يعلم من خلق وهو اللطيف الخبير أرشدك", "english": "**The Eighth Principle: Knowledge that He, Exalted is He, is established upon His Throne (mustawin ʿalā ʿarshihi) in the sense that God, Exalted is He, intended by istiwāʾ — which is the sense that does not contradict the attribute of Majesty, nor does any mark of origination (ḥudūth) or passing away (fanāʾ) attach to it. And it is the sense intended by His saying — istiwāʾ toward the heaven — where He said in the Qur'an: {«ثُمَّ اسْتَوَىٰ إِلَى السَّمَاءِ وَهِيَ دُخَانٌ»} (\"Then He directed Himself to the heaven, and it was smoke\") [Fussilat 41:11]. And that is only by way of subjugation (qahr) and dominion (istīlāʾ), as the poet said:", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 90", "section_title_en": "The Revival of the Religious Sciences — Section 90: The Ten Principles Concerning Knowledge of the Divine Attributes", "section_index": 90, "anchors": "- Root: ع ل م (ʿ-l-m)\n  * Lisan / Ayn: Core root denoting the faculty of perception and comprehension; the mark or trace by which something is known.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment upon it.\n  * Al-Zamakhshari (Asas): Distinguishes literal knowledge (ḥaqīqah) from awareness (shiʿr); here, it denotes certain, verified cognition of theological verities.\n- Root: س و ي (s-w-y)\n  * Lisan / Ayn: Root indicating straightness, equality, and levelness; from it derives istiwāʾ (establishing oneself upon, ascending to).\n  * Al-Raghib (Mufradat): Istiwāʾ upon the Throne (al-ʿArsh) is a divine act of sovereign dominion, not corporeal settlement.\n  * Al-Zamakhshari (Asas): Literal sense of physical sitting is impossible for God; metaphorical sense (majāz) of qahr (overpowering) and istīlāʾ (dominion) is necessitated by reason and consensus.\n- Root: ر أ ي (r-ʾ-y)\n  * Lisan / Ayn: Visual perception; also opinion and discernment.\n  * Al-Raghib (Mufradat): Ruʾyah (vision) of God in the Hereafter is a mode of disclosure (kashf) and knowledge (ʿilm), more complete than intellectual cognition, not conditioned by spatial direction.\n  * Al-Zamakhshari (Asas): Literal vision requires corporeality and direction; its application to God demands theological specification (takhṣīṣ) without nullifying the veracity of the scriptural promise.\n- Root: ق د ر (q-d-r)\n  * Lisan / Ayn: Power, measure, decree; the capacity to bring about an act.\n  * Al-Raghib (Mufradat): Divine power (qudrah) is the negation of incapacity (ʿajz); absolute power belongs to God alone, while creatures possess limited capacity.\n  * Al-Zamakhshari (Asas): Literal power over an object; metaphorically, God's power encompasses all things without exertion or instrument.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — governing the permissible separation between the preposition and its object for rhetorical emphasis, applied here to the parsing of \"إلى السماء\" in the verse on istiwāʾ, where the prepositional phrase is delayed to highlight the divine act of sovereign direction toward the heavens.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'", "badge": "Hadith"}], "6": [{"arabic": "فيها نفسه ويدخل فيما لا يحل له ثم نظرت إلى قوله تعالى وما من دابة في الأرض إلا على الله رزقها فعلمت أني واحد من هذه الدواب التي على الله رزقها فاشتغلت بما لله تعالى علي وتركت ما لي عنده الثامنة نظرت إلى هذا الخلق فرأيتهم كلهم متوكلين على مخلوق هذا على ضيعته وهذا على تجارته وهذا على صناعته وهذا على صحة بدنه وكل مخلوق متوكل على مخلوق مثله فرجعت إلى قوله تعالى ومن يتوكل على الله فهو حسبه فتوكلت على الله عز وجل فهو حسبي قال شقيق يا حاتم وفقك الله تعالى فإني نظرت في علوم التوراة والإنجيل والزبور والفرقان العظيم فوجدت جميع أنواع ا", "english": "Know that the scholar who does not act upon his knowledge is condemned by the Book, the Sunnah, and the sayings of the sages. God, exalted be He, said: {«يا أيها الذين آمنوا لم تقولون ما لا تفعلون * كبر مقتا عند الله أن تقولوا ما لا تفعلون»} (\"O you who believe, why do you say what you do not do? Most hateful it is to God that you say what you do not do\"). And He said: {«أتأمرون الناس بالبر وتنسون أنفسكم»} (\"Do you command people to righteousness while you forget yourselves?\"). And He said: {«ومن الناس من يعجبك قوله في الحياة الدنيا ويشهد الله على ما في قلبه وهو ألد الخصام»} (\"And among people is he whose speech pleases you in the worldly life, and he calls God to witness what is in his heart, yet he is the fiercest of opponents\").", "book_title": "Book of Knowledge", "section_title_ar": "Section 54", "section_title_en": "Section 54", "section_index": 54, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "الأرض إلا على الله رزقها فعلمت أني واحد من هذه الدواب التي على الله رزقها فاشتغلت بما لله تعالى علي وتركت ما لي عنده الثامنة نظرت إلى هذا الخلق فرأيتهم كلهم متوكلين على مخلوق هذا على ضيعته وهذا على تجارته وهذا على صناعته وهذا على صحة بدنه وكل مخلوق متوكل على مخلوق مثله فرجعت إلى قوله تعالى ومن يتوكل على الله فهو حسبه فتوكلت على الله عز وجل فهو حسبي قال شقيق يا حاتم وفقك الله تعالى فإني نظرت في علوم التوراة والإنجيل والزبور والفرقان العظيم فوجدت جميع أنواع ال", "english": "Know that the scholar who does not act upon his knowledge is condemned by the Book, the Sunnah, and the sayings of the sages. God, exalted be He, said: {«يا أيها الذين آمنوا لم تقولون ما لا تفعلون * كبر مقتا عند الله أن تقولوا ما لا تفعلون»} (\"O you who believe, why do you say what you do not do? Most hateful it is to God that you say what you do not do\"). And He said: {«أتأمرون الناس بالبر وتنسون أنفسكم»} (\"Do you command people to righteousness while you forget yourselves?\"). And He said: {«ومن الناس من يعجبك قوله في الحياة الدنيا ويشهد الله على ما في قلبه وهو ألد الخصام»} (\"And among people is he whose speech pleases you in the worldly life, and he calls God to witness what is in his heart, yet he is the fiercest of opponents\").", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 54", "section_title_en": "Section 54", "section_index": 54, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monotheism and Reliance'", "badge": "Insight"}], "7": [{"arabic": "وخطب علي كرم الله وجهه يوما خطبة فقال فيها اعلموا أنكم ميتون ومبعوثون من بعد الموت وموقوفون على أعمالكم ومجزيون بها فلا تغرنكم الحياة الدنيا فإنها بالبلاء محفوفة وبالفناء معروفة وبالغدر موصوفة وكل ما فيها إلى زوال وهي بين أهلها دول وسجال لا تدوم أحوالها ولا يسلم من شرها نزالها بينا أهلها منها في رخاء وسرور إذا هم منها في بلاء وغرور أحوال مختلفة وتارات منصرفة العيش فيها مذموم والرخاء فيها لا يدوم وإنما أهلها فيها أغراض مستهدفة ترميهم بسهامها وتقصيهم بحمامها وكل حتفه فيها مقدور وحظه فيها موفور واعلموا عباد الله أنكم", "english": "And indeed there has come the narration from him, from his Lord, Mighty and Glorious, that He said to Moses, peace be upon him: \"When you see the rich man approaching, say: 'A sin whose punishment has been hastened.' And when you see the poor man approaching, say: 'Welcome to the badge of the righteous.'\" And if you wish, you may follow the possessor of the Spirit and the Word, Jesus son of Mary, peace be upon him — for he used to say: \"My condiment is hunger, my badge is fear, my garment is wool, my warmth in winter is the rising places of the sun, my lamp is the moon, my mount is my two feet, and my food and my fruit is what the earth brings forth. I pass the night and I possess nothing, and I rise in the morning and I possess nothing — and there is no one upon the earth richer than I.\"", "book_title": "Condemnation of the World", "section_title_ar": "Section 737", "section_title_en": "The Revival of the Religious Sciences — Section 737: On the Censure of This World and the Description of Its Perils", "section_index": 737, "anchors": "- Root: دنو (danuww)\n  * Lisan / Ayn: \"دنا فهو دانٍ\" — proximity, nearness; the world (al-dunyā) is so named because it is nearer and lower, deferred from the Hereafter.\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات، أو بالحكم\" — proximity by essence or by decree; used of place, time, and station. The \"nearer\" (al-adnā) is contrasted with the greater and the better.\n  * Al-Zamakhshari (Asas): Literal: physical nearness. Metaphorical: the lower, contemptible station — \"أهل الدناءة هم أهل الشناءة\" (the people of baseness are the people of abhorrence).\n- Root: يوم (yawm)\n  * Lisan / Ayn: \"اليوم\" — a day; also any period of time.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day is the time from sunrise to sunset, or any duration whatsoever. \"وذكرهم بأيام الله\" — the days of God are His mighty deeds and calamities upon the disbelievers.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"أيام العرب\" — their battles and vicissitudes; \"أيام الله\" — His punitive visitations.\n- Root: وقد (waqada)\n  * Lisan / Ayn: \"وقدت النار تقد وقودا ووقدا\" — the fire blazed; al-wuqūd is the fuel.\n  * Al-Raghib (Mufradat): \"وقودها الناس والحجارة\" — the fuel of the Fire is men and stones; the one who kindles it for himself (istawqada) is he who seeks its light.\n  * Al-Zamakhshari (Asas): Literal: kindling a fire. Metaphorical: \"قلب وقاد\" — a blazing, keen heart; \"وقد الحصى\" — the pebbles became scorching hot (i.e., the intensity of the sun's heat).\n- Root: ألك (alaka)\n  * Lisan / Ayn: \"المألكة: الرسالة، لأنها تؤلك في الفم\" — the message (risālah) is called ma'lakah because it is chewed/worked in the mouth.\n  * Al-Raghib (Mufradat): \"الملائكة تقع على الواحد والجمع\" — angels (malā'ikah) are so named as bearers of messages; \"الله يصطفي من الملائكة رسلا\" {«الله يصطفي من الملائكة رسلا»} — God chooses messengers from the angels.\n  * Al-Zamakhshari (Asas): Literal: chewing (as a horse chews its bit). Metaphorical: delivering a message — the angel is the one who delivers the divine communication.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما\" restricts the predicate to the subject alone, negating it of all else. Applied in the sermon: \"إنما يتزين لي أوليائي بالذل والخوف\" — My friends adorn themselves for Me ONLY with humility, fear, and submission — restricting their adornment to these alone, excluding all worldly ornament.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of the World'", "badge": "Ethics"}], "11": [{"arabic": "على العمل فقال تعالى إلا الذين صبروا وعملوا الصالحات الحالة الثانية حالة العمل كي لا يغفل عن الله في أثناء عمله ولا يتكاسل عن تحقيق آدابه وسننه ويدوم على شرط الأدب إلى آخر العمل الأخير فيلازم الصبر عن دواعي الفتور إلى الفراغ وهذا أيضا من شدائد الصبر ولعله المراد بقوله تعالى نعم أجر العاملين الذين صبروا أي صبروا إلى تمام العمل الحالة الثالثة بعد الفراغ من العمل إذ يحتاج إلى الصبر عن إفشائه والتظاهر به للسمعة والرياء والصبر عن النظر إليه بعين العجب وعن كل ما يبطل عمله ويحبط أثره كما قال تعالى ولا ت", "english": "The first kind is obedience. The servant stands in need of patience in performing it, for patience in obedience is severe. This is because the soul (al-nafs) is by its very nature (bi-ṭabʿihā) averse to servitude (al-ʿubūdiyyah) and covets lordship (al-rubūbiyyah). For this reason, one of the knowers of God (al-ʿārifīn) said: \"There is no soul but that it conceals within itself what Pharaoh displayed when he said, 'I am your lord most high' {أنا ربكم الأعلى} — but Pharaoh found for it a scope and an acceptance, so he manifested it when he vilified his people and they obeyed him. And there is no one but that he claims this [very thing] with respect to his slave, his servant, his followers, and every one who is under his subjugation and obedience — even if he refrains from manifesting it. For his fury and rage at their shortcomings in serving him, and his enslaving them [in that rage], issues only from an inner concealment of pride (al-kibr) and a contesting of lordship (munāzaʿat al-rubūbiyyah) within the mantle of majesty (ridāʾ al-kibriyāʾ).\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 964", "section_title_en": "On Patience in Obedience and Abstinence from Disobedience — The Two Categories of Volitional Acts", "section_index": 964, "anchors": "- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning of restraint and retention under constraint; al-Farahidi notes its application to holding back.\n  * Al-Raghib (Mufradat): \"الصبر: الإمساك في ضيق\" — restraint within hardship; the soul's confinement to what reason and Law require, or its abstention from what they require it to abstain from. It is a generic term whose specific names vary by context: in tribulation it is patience (ṣabr) against despair (jazaʿ); in battle it is courage (shajāʿah) against cowardice.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صبرت على ما أكره\" (I bore patiently what I dislike) and \"صبرت عما أحب\" (I held back from what I love). Metaphorical (majāz): \"صبرت يمينه\" (I bound him by a stringent oath) — extended to any firm constraining.\n- Root: ع م ل (ʿ-m-l)\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد\" — every purposeful act of a living being; more specific than mere \"act\" (fiʿl), and applies to both righteous and wicked deeds.\n- Root: ن ف س (n-f-s)\n  * Al-Raghib (Mufradat): The soul (nafs) as the seat of volition and desire; its innate inclination (ṭabʿ) is central to Ghazali's argument here.\n  * Al-Zamakhshari (Asas): Literal: \"نفس\" as the self; metaphorical: \"دفق نفسه\" (he poured out his blood/life).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication with innamā) — governing the Prophet's dictum «إنما الأعمال بالنيات» where the predicate is restricted exclusively to intention.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "15": [{"arabic": "وغبن خسرانا عظيما وقال عز وجل من كان يريد الحياة الدنيا وزينتها الآية وقال تعالى إن الإنسان ليطغى أن رآه استغنى فلا حول ولا قوة إلا بالله العلي العظيم وقال تعالى ألهاكم التكاثر وقال رسول الله صلى الله عليه وسلم حب المال والشرف ينبتان النفاق في القلب كما ينبت الماء البقل (1) وقال صلى الله عليه وسلم ما ذئبان ضاريان أرسلا في زريبة غنم بأكثر إفسادا فيها من حب الشرف والمال والجاه في دين الرجل المسلم (2) وقال صلى الله عليه وسلم هلك المكثرون إلا من قال به في عباد الله هكذا وهكذا وقليل ما هم (3) وقيل يا رسول الله أي أمت", "english": "Allah Most High said: {«يا أيها الذين آمنوا لا تلهكم أموالكم ولا أولادكم عن ذكر الله ومن يفعل ذلك فأولئك هم الخاسرون»} — \"O you who believe, let not your wealth and your children divert you from the remembrance of Allah. And whoever does that — then it is they who are the losers.\" And He said Most High: {«إنما أموالكم وأولادكم فتنة والله عنده أجر عظيم»} — \"Your wealth and your children are only a trial, and Allah — with Him is a mighty reward.\" So whoever chooses his wealth and his child over what is with Allah has indeed lost and been defrauded a tremendous loss. And He said, Mighty and Majestic: {«من كان يريد الحياة الدنيا وزينتها»} — \"Whoever desires the life of this world and its adornment...\" — to the end of the verse. And He said Most High: {«إن الإنسان ليطغى أن رآه استغنى»} — \"Indeed, man does transgress when he sees himself self-sufficient.\" There is no might and no power except through Allah, the Exalted, the Magnificent. And He said Most High: {«ألهاكم التكاثر»} — \"Vying in increase diverts you.\"", "book_title": "Condemnation of Miserliness and Love of Wealth", "section_title_ar": "Section 753", "section_title_en": "The Revival of the Religious Sciences — Book on Poverty and Abstinence: The Blame of Wealth and Its Perils", "section_index": 753, "anchors": "- Root: لهو (l-h-w)\n  * Lisan / Ayn: To divert, distract, or occupy oneself away from a matter of greater import; amusement that turns one from serious concern.\n  * Al-Raghib (Mufradat): Theologically, *lahw* denotes that which diverts the heart from Allah — the root cause of spiritual ruin, as wealth and children are here designated as distracting agents.\n  * Al-Zamakhshari (Asas): Literal: play/amusement. Metaphorical: any engrossing worldly pursuit that veils one from the Hereafter.\n- Root: كثر (k-th-r)\n  * Lisan / Ayn: Abundance, multitude, increase in number or quantity.\n  * Al-Raghib (Mufradat): *Takāthur* (vying in increase) is censured as the competitive accumulation of worldly goods for pride, not need.\n  * Al-Zamakhshari (Asas): Literal: seeking more. Metaphorical: the obsessive race toward worldly accumulation that hardens the heart.\n- Root: غبن (gh-b-n)\n  * Lisan / Ayn: To cheat, defraud, or suffer loss in a transaction; to be outwitted.\n  * Al-Raghib (Mufradat): In the Hereafter, *ghubn* is the ultimate loss — exchanging eternal bliss for fleeting worldly gain.\n  * Al-Zamakhshari (Asas): Literal: commercial deception. Metaphorical: the soul's self-deception in preferring the ephemeral over the everlasting.\n- Root: فتن (f-t-n)\n  * Lisan / Ayn: Trial, tribulation, test; that which sifts the sincere from the insincere.\n  * Al-Raghib (Mufradat): *Fitnah* is a divine test through which the heart's attachment to worldly goods is exposed.\n  * Al-Zamakhshari (Asas): Literal: burning in fire (as gold is refined). Metaphorical: wealth as a crucible for faith.\n- Sibawayh Rule: Restriction and Focused Predication (*Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā*) — The particle *innamā* in {«إنما أموالكم وأولادكم فتنة»} restricts the predicate, affirming that wealth and children are solely a trial, not an end in themselves.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Condemnation of Miserliness and Love of Wealth'", "badge": "Du'a"}, {"arabic": "فقال عز وجل ومن كان يريد الحياة الدنيا وزينتها نوف إليهم أعمالهم فيها وهم فيها لا يبخسون أولئك الذين ليس لهم في الآخرة إلا النار وحبط ما صنعوا فيها وباطل ما كانوا يعملون وهذا أيضا متناول بعمومه لحب الجاه فإنه أعظم لذة من لذات الحياة الدنيا وأكثر زينة من زينتها وقال رسول الله صلى الله عليه وسلم حب المال والجاه ينبتان النفاق في القلب كما ينبت الماء البقل (1) حديث ما ذئبان ضاريان أرسلا في زريبة غنم الحديث تقدم أيضا هناك وقال صلى الله عليه وسلم لعلي كرم الله وجهه إنما هلاك الناس باتباع الهوى وحب الثناء // حديث إنما هلاك الناس باتباع الهوى وحب الثناء لم أره بهذا اللفظ وقد تقدم في العلم من حديث أنس ثلاث مهلكات شح مط", "english": "And Allah Most High said: {«تلك الدار الآخرة نجعلها للذين لا يريدون علوا في الأرض ولا فسادا»} — \"That abode of the Hereafter — We appoint it for those who do not desire exaltation upon the earth, nor corruption.\" He joined together the desire for corruption and the desire for exaltation [in a single condemnation], and [declared] that the Hereafter belongs solely to the one who is free of both desires together.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 794", "section_title_en": "Section 794 — Exposition of the Blameworthiness of Prestige (Jāh) and Its True Meaning", "section_index": 794, "anchors": "- Root: جاه (J-W-H)\n  * Lisan / Ayn: Core root denotes \"face, countenance, standing, rank, dignity\" — the elevated position by which one is received with honor.\n  * Al-Raghib (Mufradat): Theological nuance: jāh is the \"station\" (manzilah) in hearts, distinct from mere wealth (māl); it is a spiritual sovereignty over others' inward dispositions.\n  * Al-Zamakhshari (Asas): Literal: \"place/standing before the king.\" Metaphorical: \"possession of hearts\" — the ruler's sway over subjects' wills, not their bodies.\n- Root: ملك (M-L-K)\n  * Lisan / Ayn: Possession, dominion, sovereign control over what one owns.\n  * Al-Raghib (Mufradat): Two modes: (1) tamalluk — actual possession and disposal; (2) quwwah — capacity to possess, whether or not exercised.\n  * Al-Zamakhshari (Asas): Literal: ownership of chattel. Metaphorical: \"malaka nafsahu\" (self-mastery), \"malaka al-mar'ah\" (marriage) — dominion over that which yields to one's authority.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: The heart; that which fluctuates, turns, and overturns between states.\n  * Al-Raghib (Mufradat): The heart is the seat of perception and volition; its \"turning\" (taqlīb) between conditions is its essential nature.\n  * Al-Zamakhshari (Asas): Literal: physical turning over. Metaphorical: \"qallaba al-umūr\" — to scrutinize and manage affairs; the heart as the organ of belief and inclination.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما هلاك الناس...\" restricts destruction solely to the two cited causes, excluding all others.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Status and Ostentation'", "badge": "Ethics"}], "18": [{"arabic": "الله تعالى بين من افترى على الله كذبا وبين من كذب بالحق فقال تعالى ومن أظلم ممن افترى على الله كذبا أو كذب بالحق لما جاءه وقال تعالى فمن أظلم ممن كذب على الله وكذب بالصدق إذ جاءه ومنها الرياء وملاحظة الخلق والجهد في استمالة قلوبهم وصرف وجوههم والرياء هو الداء العضال الذي يدعو إلى أكبر الكبائر كما سيأتي في كتاب الرياء والمناظر لا يقصد إلا الظهور عند الخلق وانطلاق ألسنتهم بالثناء عليه فهذه عشر خصال من أمهات الفواحش الباطنة سوى ما يتفق لغير المتماسكين منهم من الخصام المؤدي إلى الضرب", "english": "**QUAD_ANCHORS:**\n- Root: نظر (naẓara)\n  * Lisan / Ayn: Core meaning: to look, to examine, to consider; al-munāẓarah is mutual examination/argumentation between two parties.\n  * Al-Raghib (Mufradat): Theological nuance: naẓar as intellectual contemplation (taʾammul bi-l-baṣīrah); munāẓarah as dialectical exchange.\n  * Al-Zamakhshari (Asas): Literal: sitting face-to-face in debate; Metaphorical: disputation for victory.\n- Root: غلب (ghalaba)\n  * Lisan / Ayn: Core meaning: to overcome, to conquer, to prevail.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghalabah as seeking to dominate another in argument.\n  * Al-Zamakhshari (Asas): Literal: victory in combat; Metaphorical: intellectual supremacy.\n- Root: حسد (ḥasada)\n  * Lisan / Ayn: Core meaning: to envy, to wish removal of blessings from another.\n  * Al-Raghib (Mufradat): Theological nuance: envy as wishing deprivation of blessings from the deserving — among the basest traits.\n  * Al-Zamakhshari (Asas): Literal: envy of another's blessing; Metaphorical: consuming fire of the soul.\n- Root: كبر (kabura)\n  * Lisan / Ayn: Core meaning: to be great, to be haughty.\n  * Al-Raghib (Mufradat): Theological nuance: al-kibr as self-elevation above others; condemned by God.\n  * Al-Zamakhshari (Asas): Literal: greatness; Metaphorical: arrogance and pride.\n- Root: غيب (ghāba)\n  * Lisan / Ayn: Core meaning: to be absent, to be hidden.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghībah as mentioning another with what he dislikes in his absence — likened to eating carrion.\n  * Al-Zamakhshari (Asas): Literal: backbiting; Metaphorical: consuming the flesh of one's brother.\n- Root: راءى (rāʾā)\n  * Lisan / Ayn: Core meaning: to show off, to display.\n  * Al-Raghib (Mufradat): Theological nuance: al-riyāʾ as performing acts for the sake of being seen — hidden shirk.\n  * Al-Zamakhshari (Asas): Literal: showing good deeds; Metaphorical: seeking reputation.\n- Root: نفس (nafs)\n  * Lisan / Ayn: Core meaning: self, soul, spirit.\n  * Al-Raghib (Mufradat): Theological nuance: tazkiyat al-nafs as self-praise and self-purification — forbidden by God.\n  * Al-Zamakhshari (Asas): Literal: self; Metaphorical: self-commendation.\n- Root: حقd (ḥaqida)\n  * Lisan / Ayn: Core meaning: to bear malice, to harbor resentment.\n  * Al-Raghib (Mufradat): Theological nuance: al-ḥiqd as nursing enmity in the heart — negated from the believer.\n  * Al-Zamakhshari (Asas): Literal: bearing grudge; Metaphorical: hidden rancor.\n- Root: نفاق (nifāq)\n  * Lisan / Ayn: Core meaning: hypocrisy, showing contrary to what one conceals.\n  * Al-Raghib (Mufradat): Theological nuance: hypocrisy in deeds — outward display contrary to inward state.\n  * Al-Zamakhshari (Asas): Literal: hypocrisy in faith; Metaphorical: hypocrisy in character.\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning: to know, to perceive.\n  * Al-Raghib (Mufradat): Theological nuance: knowledge as apprehension of reality — its pursuit for other than God is destructive.\n  * Al-Zamakhshari (Asas): Literal: knowledge; Metaphorical: the dangerous burden of the scholar.\n- Root: جدل (jadala)\n  * Lisan / Ayn: Core meaning: to argue, to dispute.\n  * Al-Raghib (Mufradat): Theological nuance: al-jidāl as contention; al-mirāʾ as disputation with falsehood — condemned.\n  * Al-Zamakhshari (Asas): Literal: argumentation; Metaphorical: obstinate disputation.\n- Root: شرك (sharaka)\n  * Lisan / Ayn: Core meaning: to associate, to share.\n  * Al-Raghib (Mufradat): Theological nuance: al-riyāʾ as hidden shirk — associating others with God in intention.\n  * Al-Zamakhshari (Asas): Literal: polytheism; Metaphorical: hidden association in deeds.\n- Root: موت (māta)\n  * Lisan / Ayn: Core meaning: to die.\n  * Al-Raghib (Mufradat): Theological nuance: death as separation of soul from body; spiritual death as ruin of the soul.\n  * Al-Zamakhshari (Asas): Literal: physical death; Metaphorical: spiritual destruction.\n- Root: حيى (ḥayiya)\n  * Lisan / Ayn: Core meaning: to live.\n  * Al-Raghib (Mufradat): Theological nuance: life as the power of perception; eternal life as the reward of the righteous.\n  * Al-Zamakhshari (Asas): Literal: physical life; Metaphorical: spiritual vitality.\n- Root: هلك (halaka)\n  * Lisan / Ayn: Core meaning: to perish, to be destroyed.\n  * Al-Raghib (Mufradat): Theological nuance: al-halāk as ruin; eternal destruction as everlasting punishment.\n  * Al-Zamakhshari (Asas): Literal: destruction; Metaphorical: eternal ruin.\n- Root: رياء (riyāʾ)\n  * Lisan / Ayn: Core meaning: showing off, ostentation.\n  * Al-Raghib (Mufradat): Theological nuance: riyāʾ as the incurable disease calling to the greatest sins.\n  * Al-Zamakhshari (Asas): Literal: ostentation; Metaphorical: spiritual disease.\n- Root: جاه (jāh)\n  * Lisan / Ayn: Core meaning: rank, status, prestige.\n  * Al-Raghib (Mufradat): Theological nuance: love of status (ḥubb al-jāh) among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: position; Metaphorical: seeking prestige.\n- Root: مباهاة (mubāhāh)\n  * Lisan / Ayn: Core meaning: mutual boasting, vying in splendor.\n  * Al-Raghib (Mufradat): Theological nuance: mubāhāh as each seeking to display superiority over the other.\n  * Al-Zamakhshari (Asas): Literal: mutual boasting; Metaphorical: rivalry in honor.\n- Root: مماراة (mumārāh)\n  * Lisan / Ayn: Core meaning: disputation, wrangling.\n  * Al-Raghib (Mufradat): Theological nuance: al-mirāʾ as contentious argument — condemned by the Prophet.\n  * Al-Zamakhshari (Asas): Literal: disputation; Metaphorical: obstinate wrangling.\n- Root: فخر (fakhara)\n  * Lisan / Ayn: Core meaning: to boast, to pride oneself.\n  * Al-Raghib (Mufradat): Theological nuance: al-fakhr as self-glorification — among the blameworthy traits.\n  * Al-Zamakhshari (Asas): Literal: boasting; Metaphorical: vainglory.\n- Root: عجب (ʿajiba)\n  * Lisan / Ayn: Core meaning: to wonder, to be amazed.\n  * Al-Raghib (Mufradat): Theological nuance: al-ʿujb as self-admiration — among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: wonder; Metaphorical: self-conceit.\n- Root: بغض (baghiḍa)\n  * Lisan / Ayn: Core meaning: to hate, to detest.\n  * Al-Raghib (Mufradat): Theological nuance: al-baghdāʾ as mutual hatred — contrary to brotherhood.\n  * Al-Zamakhshari (Asas): Literal: hatred; Metaphorical: mutual enmity.\n- Root: غضب (ghaḍiba)\n  * Lisan / Ayn: Core meaning: to be angry.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghaḍab as anger — among the blameworthy traits.\n  * Al-Zamakhshari (Asas): Literal: anger; Metaphorical: rage.\n- Root: طمع (ṭamiʿa)\n  * Lisan / Ayn: Core meaning: to covet, to desire.\n  * Al-Raghib (Mufradat): Theological nuance: al-ṭamaʿ as covetousness — among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: desire; Metaphorical: greed.\n- Root: أشر (ashira)\n  * Lisan / Ayn: Core meaning: to be exultant, to be insolent.\n  * Al-Raghib (Mufradat): Theological nuance: al-ashar as excessive joy and insolence — blameworthy.\n  * Al-Zamakhshari (Asas): Literal: exultation; Metaphorical: insolence.\n- Root: بطر (baṭira)\n  * Lisan / Ayn: Core meaning: to be arrogant, to be ungrateful.\n  * Al-Raghib (Mufradat): Theological nuance: al-baṭar as arrogance in prosperity — among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: arrogance; Metaphorical: ingratitude for blessings.\n- Root: خيلاء (khuyalāʾ)\n  * Lisan / Ayn: Core meaning: pride, haughtiness.\n  * Al-Raghib (Mufradat): Theological nuance: al-khuyalāʾ as pride and conceit — blameworthy.\n  * Al-Zamakhshari (Asas): Literal: pride; Metaphorical: haughty bearing.\n- Root: خشية (khashyah)\n  * Lisan / Ayn: Core meaning: fear, awe.\n  * Al-Raghib (Mufradat): Theological nuance: al-khashyah as reverential fear — among the traits of the believers.\n  * Al-Zamakhshari (Asas): Literal: fear; Metaphorical: reverential awe.\n- Root: رحمة (raḥmah)\n  * Lisan / Ayn: Core meaning: mercy, compassion.\n  * Al-Raghib (Mufradat): Theological nuance: al-raḥmah as tenderness of heart — among the traits of the believers.\n  * Al-Zamakhshari (Asas): Literal: mercy; Metaphorical: compassion.\n- Root: غفلة (ghaflah)\n  * Lisan / Ayn: Core meaning: heedlessness, inattention.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghaflah as heedlessness — contrary to vigilance.\n  * Al-Zamakhshari (Asas): Literal: inattention; Metaphorical: spiritual heedlessness.\n- Root: خشوع (khushūʿ)\n  * Lisan / Ayn: Core meaning: humility, submissiveness.\n  * Al-Raghib (Mufradat): Theological nuance: al-khushūʿ as humility — among the traits of the believers.\n  * Al-Zamakhshari (Asas): Literal: humility; Metaphorical: devotional submission.\n- Root: تذكير (tadhkīr)\n  * Lisan / Ayn: Core meaning: reminding, admonishing.\n  * Al-Raghib (Mufradat): Theological nuance: al-tadhkīr as reminding of God — a righteous act.\n  * Al-Zamakhshari (Asas): Literal: reminding; Metaphorical: preaching.\n- Root: وعظ (waʿaẓa)\n  * Lisan / Ayn: Core meaning: to admonish, to exhort.\n  * Al-Raghib (Mufradat): Theological nuance: al-waʿẓ as exhortation to obedience and warning against disobedience.\n  * Al-Zamakhshari (Asas): Literal: admonition; Metaphorical: sermonizing.\n- Root: فتوى (fatwā)\n  * Lisan / Ayn: Core meaning: legal ruling, formal opinion.\n  * Al-Raghib (Mufradat): Theological nuance: al-fatwā as clarification of legal rulings.\n  * Al-Zamakhshari (Asas): Literal: legal opinion; Metaphorical: religious authority.\n- Root: قضاء (qaḍāʾ)\n  * Lisan / Ayn: Core meaning: judgment, decree.\n  * Al-Raghib (Mufradat): Theological nuance: al-qaḍāʾ as judgment between people.\n  * Al-Zamakhshari (Asas): Literal: judgment; Metaphorical: judicial authority.\n- Root: وقف (waqafa)\n  * Lisan / Ayn: Core meaning: to stop, to stand.\n  * Al-Raghib (Mufradat): Theological nuance: al-waqf as endowment of property for charitable purposes.\n  * Al-Zamakhshari (Asas): Literal: standing; Metaphorical: religious endowment.\n- Root: ثواب (thawāb)\n  * Lisan / Ayn: Core meaning: reward, recompense.\n  * Al-Raghib (Mufradat): Theological nuance: al-thawāb as divine recompense for righteous deeds.\n  * Al-Zamakhshari (Asas): Literal: reward; Metaphorical: divine recompense.\n- Root: عذاب (ʿadhāb)\n  * Lisan / Ayn: Core meaning: punishment, torment.\n  * Al-Raghib (Mufradat): Theological nuance: al-ʿadhāb as divine punishment for the disobedient.\n  * Al-Zamakhshari (Asas): Literal: punishment; Metaphorical: divine chastisement.\n- Root: ملك (malaka)\n  * Lisan / Ayn: Core meaning: to possess, to rule.\n  * Al-Raghib (Mufradat): Theological nuance: al-mulk as sovereignty; al-mulk al-muʾabbad as eternal sovereignty in Paradise.\n  * Al-Zamakhshari (Asas): Literal: dominion; Metaphorical: eternal kingdom.\n- Root: نعيم (naʿīm)\n  * Lisan / Ayn: Core meaning: bliss, delight.\n  * Al-Raghib (Mufradat): Theological nuance: al-naʿīm as bliss; al-naʿīm al-sarmad as everlasting bliss.\n  * Al-Zamakhshari (Asas): Literal: delight; Metaphorical: eternal bliss.\n- Root: رخصة (rukhaṣah)\n  * Lisan / Ayn: Core meaning: concession, dispensation.\n  * Al-Raghib (Mufradat): Theological nuance: al-rukhaṣah as legal concession.\n  * Al-Zamakhshari (Asas): Literal: concession; Metaphorical: legal dispensation.\n- Root: رياسة (riyāsah)\n  * Lisan / Ayn: Core meaning: leadership, headship.\n  * Al-Raghib (Mufradat): Theological nuance: love of leadership among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: leadership; Metaphorical: seeking authority.\n- Root: اندراس (indirās)\n  * Lisan / Ayn: Core meaning: effacement, obliteration.\n  * Al-Raghib (Mufradat): Theological nuance: indirās al-ʿulūm as the obliteration of the sciences.\n  * Al-Zamakhshari (Asas): Literal: effacement; Metaphorical: extinction of knowledge.\n- Root: صبيان (ṣibyān)\n  * Lisan / Ayn: Core meaning: boys, children.\n  * Al-Raghib (Mufradat): Theological nuance: children's motivation for learning through play.\n  * Al-Zamakhshari (Asas): Literal: boys; Metaphorical: pupils.\n- Root: مكتب (maktab)\n  * Lisan / Ayn- Root: مكتب (maktab)\n  * Lisan / Ayn: Core meaning: place of instruction, school for boys.\n  * Al-Raghib (Mufradat): Theological nuance: the elementary school where children are taught.\n  * Al-Zamakhshari (Asas): Literal: school; Metaphorical: place of elementary learning.\n- Root: خلاق (khilāq)\n  * Lisan / Ayn: Core meaning: portion, share, lot.\n  * Al-Raghib (Mufradat): Theological nuance: \"no portion\" (lā khilāq) in the Hereafter — utter deprivation of divine reward.\n  * Al-Zamakhshari (Asas): Literal: share; Metaphorical: spiritual allotment in the afterlife.\n- Root: فاجر (fājir)\n  * Lisan / Ayn: Core meaning: wicked, immoral, profligate.\n  * Al-Raghib (Mufradat): Theological nuance: the dissolute one who commits sins openly.\n  * Al-Zamakhshari (Asas): Literal: sinner; Metaphorical: one through whom God nonetheless supports religion.\n- Root: شمع (shamʿ)\n  * Lisan / Ayn: Core meaning: candle, wax taper.\n  * Al-Raghib (Mufradat): Theological nuance: the candle as parable — consuming itself while giving light to others.\n  * Al-Zamakhshari (Asas): Literal: candle; Metaphorical: one who destroys himself but benefits others.\n- Root: نار (nār)\n  * Lisan / Ayn: Core meaning: fire.\n  * Al-Raghib (Mufradat): Theological nuance: fire as parable — consuming itself and all around it.\n  * Al-Zamakhshari (Asas): Literal: fire; Metaphorical: one who destroys himself and others.\n- Root: سعد (saʿida)\n  * Lisan / Ayn: Core meaning: to be fortunate, to prosper.\n  * Al-Raghib (Mufradat): Theological nuance: saʿādah as felicity — success in the Hereafter.\n  * Al-Zamakhshari (Asas): Literal: good fortune; Metaphorical: eternal felicity.\n- Root: شقي (shaqiya)\n  * Lisan / Ayn: Core meaning: to be wretched, to be miserable.\n  * Al-Raghib (Mufradat): Theological nuance: shaqāwah as wretchedness — ruin in the Hereafter.\n  * Al-Zamakhshari (Asas): Literal: misery; Metaphorical: eternal ruin.\n- Root: أخلص (akhlaṣa)\n  * Lisan / Ayn: Core meaning: to purify, to be sincere.\n  * Al-Raghib (Mufradat): Theological nuance: ikhlāṣ as purifying intention for God alone — the condition of acceptance.\n  * Al-Zamakhshari (Asas): Literal: sincerity; Metaphorical: pure devotion.\n- Root: ريب (rāba)\n  * Lisan / Ayn: Core meaning: to doubt, to suspect.\n  * Al-Raghib (Mufradat): Theological nuance: al-rayb as doubt and uncertainty — to be dispelled by evidence.\n  * Al-Zamakhshari (Asas): Literal: doubt; Metaphorical: skepticism.", "book_title": "Book of Knowledge", "section_title_ar": "Section 39", "section_title_en": "Section 39", "section_index": 39, "anchors": "*(Anchors established)*", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Book of Knowledge'", "badge": "Ethics"}, {"arabic": "وأما الكافرون والمنافقون فتقول الأشهاد هؤلاء الذين كذبوا على ربهم ألا لعنة الله على الظالمين (2) وقال صلى الله عليه وسلم كل أمتي معافى إلا المجاهرين (3) وإن من المجاهرة أن يعمل الرجل السوء سرا ثم يخبر به وقال صلى الله عليه وسلم من استمع خبر قوم وهم له كارهون صب في أذنه الآنك يوم القيامة (4) ومنها أن يتقي مواضع التهم صيانة لقلوب الناس عن سوء الظن ولألسنتهم عن العيبة فإنهم إذا عصوا الله بذكره وكان هو السبب فيه كان شريكا قال الله تعالى ولا تسبوا الذي يدعون من دون الله فيسبوا الله عدوا بغير علم وقال صلى الله عليه وسلم كيف ترون من يسب أبويه فقالوا وهل من أحد يسب أبويه فق", "english": "**First**: That you greet him with peace (*salām*) when you meet him, and respond to his invitation when he invites you, and say \"may Allah have mercy on you\" (*tashmīt*) when he sneezes, and visit him when he is ill, and attend his funeral procession when he dies, and fulfill his oath when he swears by you, and give him sincere counsel when he seeks your advice, and protect him in his absence when he is away from you, and love for him what you love for yourself, and dislike for him what you dislike for yourself. (1)", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 433", "section_title_en": "The Rights of Brotherhood — Section 433: The Duties of a Muslim Toward His Fellow Muslims", "section_index": 433, "anchors": "- Root: سلم (s-l-m)\n  * Lisan / Ayn: Core meaning of safety, security, freedom from harm; the root from which *islām* (submission/surrender) and *salām* (peace) derive\n  * Al-Raghib (Mufradat): *Salām* as the theological state of being secure from harm — both giving and receiving safety; *islām* as the total surrender of the heart to Allah\n  * Al-Zamakhshari (Asas): Literal (*ḥaqīqah*): physical safety from tongue and hand; Metaphorical (*majāz*): the comprehensive spiritual safety that defines true Muslim brotherhood\n- Root: عون (ʿ-w-n)\n  * Lisan / Ayn: Assistance, aid, helping another in need\n  * Al-Raghib (Mufradat): Mutual assistance as a divine ordinance among believers\n  * Al-Zamakhshari (Asas): Literal: physical aid; Metaphorical: intercession (*shafāʿah*) and advocacy on behalf of others\n- Root: ستر (s-t-r)\n  * Lisan / Ayn: Covering, concealing, veiling; protection from exposure\n  * Al-Raghib (Mufradat): *Sitr* as the divine attribute of concealment — Allah's covering of sins in this world and the next\n  * Al-Zamakhshari (Asas): Literal: covering a physical defect; Metaphorical: concealing another's faults and sins — a cardinal virtue of brotherhood\n- Root: عذر (ʿ-dh-r)\n  * Lisan / Ayn: Excuse, pardon, acceptance of apology\n  * Al-Raghib (Mufradat): *ʿAfw* (pardon) as the higher station of forgiveness that elevates the forgiver\n  * Al-Zamakhshari (Asas): Literal: releasing from obligation; Metaphorical: the noble trait of overlooking others' offenses\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated use of restrictive constructions (e.g., \"المسلم من سلم المسلمون\") establishes definitional boundaries through predicate restriction, indicating that the *ḥaqīqah* of faith is manifested through specific observable actions.\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}, {"arabic": "وقال بعض العلماء إن العبد ليتلو القرآن فيلعن نفسه وهو لا يعلم يقول {ألا لعنة الله على الظالمين} وهو ظالم نفسه ألا لعنة الله على الكاذبين وهو منهم وقال الحسن إنكم اتخذتم قراءة القرآن مراحل وجعلتم الليل جملا فأنتم تركبونه فتقطعون به مراحله وإن من كان قبلكم رأوه رسائل من ربهم فكانوا يتدبرونها بالليل وينفذونها بالنهار وقال ابن مسعود أنزل القرآن عليهم ليعملوا به فاتخذوا دراسته عملا إن أحدكم ليقرأ القرآن من فاتحته إلى خاتمته ما يسقط منه حرفا وقد أسقط العمل به وفي حديث ابن عمر وحديث جندب رضي الله عنهما لقد عشنا دهرا طويلا وأحدنا يؤتى الإي", "english": "Anas ibn Mālik said: \"How many a reciter of the Qur'an there is, while the Qur'an curses him!\" And Maysarah al-Gharīb said: \"It is the Qur'an in the belly of the wicked one.\" And Abū Sulaymān al-Dārānī said: \"The Zabāniyah (the stern keepers of Hell) are swifter to seize the carriers of the Qur'an who disobey God — Mighty and Majestic is He — than they are to seize the worshippers of idols, when they disobey God — Glorified is He — after having received the Qur'an.\"", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 222", "section_title_en": "Section 222 — On the Condemnation of the Recitation of the Negligent", "section_index": 222, "anchors": "- Root: تلا (t-l-w)\n  * Lisan / Ayn: Core meaning of following in sequence, tracing footsteps; recitation as sequential articulation of words.\n  * Al-Raghib (Mufradat): Tilāwah implies following with obedience — the reciter who does not follow the recited command is not truly a tālī.\n  * Al-Zamakhshari (Asas): Literal: to follow behind. Metaphorical: the Qur'an \"follows\" or \"pursues\" its reciter — either blessing him or cursing him on the Day of Judgment.\n- Root: لعل (l-ʿ-n)\n  * Lisan / Ayn: To curse, to drive away from mercy, to banish.\n  * Al-Raghib (Mufradat): Laʿnah is expulsion from divine mercy; the Qur'an itself \"cursing\" its reciter is a metaphorical (majāz) attribution of the act to the Book, the actual agent being God.\n  * Al-Zamakhshari (Asas): Literal: imprecation. Metaphorical: the Qur'an's letters and verses standing as witnesses against the negligent reciter.\n- Root: حمل (ḥ-m-l)\n  * Lisan / Ayn: To carry, to bear; ḥāmil al-Qurʾān is one who bears the Qur'an by memorization.\n  * Al-Raghib (Mufradat): Carrying implies bearing its obligations, not merely its letters — the true carrier is he who carries its commands into action.\n  * Al-Zamakhshari (Asas): Literal: physical carrying. Metaphorical: bearing its legal responsibilities (takālīf).\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rhetorical structure of \"the Qur'an curses him\" employs an implied agentive construction where the grammatical subject is the Book itself, requiring the reader to parse the metaphorical agency without literal attribution.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Anger and Hatred'", "badge": "Hadith"}], "26": [{"arabic": "إن كان يريد أن يكون تعلمه طاعة فإن العباد أمروا أن لا يعبدوا إلا الله ولا يريدوا بطاعتهم غيره وكذلك من يخدم أبويه لا ينبغي أن يخدمهما لطلب المنزلة عندهما إلا من حيث إن رضا الله عنه في رضا الوالدين ولا يجوز له أن يرائي بطاعته لينال بها منزلة عند الوالدين فإن ذلك معصية في الحال وسيكشف الله عن ريائه وتسقط منزلته من قلوب الوالدين أيضا وأما الزاهد المعتزل عن الناس فينبغي له أن يلزم قلبه ذكر الله والقناعة بعلمه ولا يخطر بقلبه معرفة الناس زهده واستعظامهم محله فإن ذلك يغرس الرياء في صدره حتى تتيسر عليه العبادات في خلوته به", "english": "Ibrahim ibn Adham — may God have mercy on him — said: \"I learned [true] knowledge (al-ma'rifah) from a monk called Sam'an. I entered upon him in his hermitage and said, 'O Sam'an, how long have you been in your hermitage?' He said, 'Seventy years.' I said, 'And what is your food?' He said — [marveling] — 'O Hanifi, what has brought you to this?' I said, 'I wished to learn.' He said, 'Each night, one chickpea.' I said, 'And what is it that stirs in your heart such that this single chickpea suffices you?' He said, 'Do you see that monastery facing you?' I said, 'Yes.' He said, 'They come to me once every year, on a single day. They decorate my hermitage, circumambulate around it, and magnify me. So whenever my soul grows sluggish toward worship, I recall that [moment] — the glory of that hour — and so I endure the toil of a whole year for the glory of a single hour. So do you, O Hanifi, endure the toil of a single hour for the glory of eternity.' And [this] settled knowledge (al-ma'rifah) into my heart. He said, 'Is that enough for you, or shall I add more?' I said, 'Yes [add more].' He said, 'Descend from the hermitage.' So I descended, and he lowered to me a small leather vessel (rakwah) containing twenty chickpeas. He said, 'Enter the monastery, for they have seen what I lowered to you.' When I entered the monastery, the Christians gathered around me and said, 'O Hanifi, what did the elder lower to you?' I said, 'Some of his provisions.' They said, 'And what will you do with it, when we have more right to it?' Then they said, 'Sell it.' I said, 'For twenty dinars.' So they gave me twenty dinars. I returned to the elder, and he said, 'O Hanifi, what did you do?' I said, 'I sold it to them.' He said, 'For how much?' I said, 'For twenty dinars.' He said, 'You erred. Had you asked them for twenty thousand dinars, they would have given you [that]. This is the glory of one whom you do not worship — so consider how must be the glory of One whom you do worship! O Hanifi, turn to your Lord, and abandon this coming and going.'\"", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 845", "section_title_en": "On the Hidden Dangers of Seeking Status Through Worship — The Story of Ibrahim ibn Adham and the Monk", "section_index": 845, "anchors": "- Root: زهد (z-h-d)\n  * Lisan / Ayn: Abstinence, renunciation, turning away from something with deliberate disregard.\n  * Al-Raghib (Mufradat): The virtue of the heart's detachment from worldly allurements; a state of the inner self, not merely outward acts.\n  * Al-Zamakhshari (Asas): Literal: abandoning a thing as contemptible. Metaphorical: the ascetic's heart being present with God while absent from creation's regard.\n- Root: راءى (r-'-y)\n  * Lisan / Ayn: To show off, to display an act for the sake of being seen by others.\n  * Al-Raghib (Mufradat): Riya' is the seeking of station (manzilah) in the hearts of creatures through acts of obedience, which nullifies sincerity to God.\n  * Al-Zamakhshari (Asas): Literal: visual perception. Metaphorical: making one's worship a spectacle for onlookers, a hidden shirk.\n- Root: خطر (kh-t-r)\n  * Lisan / Ayn: To cross the mind, to occur to one; a passing thought.\n  * Al-Raghib (Mufradat): Khatir denotes the fleeting suggestions that enter the heart, whether praiseworthy or blameworthy.\n  * Al-Zamakhshari (Asas): Literal: to pace back and forth. Metaphorical: thoughts traversing the mind's terrain.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The conditional and restrictive particles (إنما، لو، إلا) govern the precise scope of the author's rulings, distinguishing permissible intention from corrupting motive.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Status and Ostentation'", "badge": "Insight"}], "29": [{"arabic": "إلا من الله تعالى كما قال عز وجل {ويا قوم لا أسألكم عليه مالا إن أجري إلا على الله} فإن المال وما في الدنيا خادم البدن والبدن مركب النفس ومطيتها والمخدوم هو العلم إذ به شرف النفس فمن طلب بالعلم المال كان كمن مسح أسفل مداسه بوجهه لينظفه فجعل المخدوم خادما والخادم مخدوما وذلك هو الانتكاس على أم الرأس ومثله هو الذي يقوم في العرض الأكبر مع المجرمين ناكسي رءوسهم عند ربهم وعلى الجملة فالفضل والمنة للمعلم فانظر كيف انتهى أمر الدين إلى قوم يزعمون أن مقصودهم التقرب إلى الله تعالى بما هم فيه من علم الفقه والكلام والتدريس فيهما وفي غير", "english": "And those who turn aside to seek leadership (al-riyāsah) through the sciences have departed from the requirement of His saying, Exalted: {«The believers are but brothers»} (al-Ḥujurāt 49:10), and have entered into the implication of His saying, Exalted: {«Intimate friends on that Day will be enemies to one another, except the God-fearing»} (al-Zukhruf 43:67).", "book_title": "Book of Knowledge", "section_title_ar": "Section 46", "section_title_en": "The Duties of the Teacher — Section 46: On the Teacher's Sincerity, His Conduct Toward Students, and the Signs of Those Who Seek the World Through Knowledge", "section_index": 46, "anchors": "- Root: قصد (qaṣada)\n  * Lisan / Ayn: Core meaning of \"intending, aiming toward, taking the straight path to a goal\"; al-Ayn notes its use in aiming at a target.\n  * Al-Raghib (Mufradat): \"Al-Qaṣd: the straightness of the path... al-iqtiṣād (moderation) is praiseworthy absolutely, as in generosity between extravagance and miserliness.\"\n  * Al-Zamakhshari (Asas): Literal: \"I intended him and intended for him\" (physical direction). Metaphorical: \"He was moderate in his livelihood... he who does not exceed the limit in a matter and is content with the middle way.\"\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Knowledge as the perception of a thing's reality; al-Ayn traces its verbal forms across perception and knowing.\n  * Al-Raghib (Mufradat): \"Al-ʿIlm: the apprehension of a thing by its true reality... two kinds: apprehension of the essence of a thing, and judgment upon a thing.\"\n  * Al-Zamakhshari (Asas): Literal: \"He was a sign (ʿalam) of knowledge.\" Metaphorical: \"The landmarks (maʿālim) of the road\" — the traces by which one is guided.\n- Root: أخل (akhala)\n  * Lisan / Ayn: \"Al-Akhillāʾ: intimate friends (pl. of khalīl).\" Al-Ayn: \"Al-Maʾlaka: the message, because it is chewed (yuʾlak) in the mouth.\"\n  * Al-Raghib (Mufradat): \"Al-Khullāh: sincere friendship... {«Intimate friends on that Day will be enemies to one another, except the God-fearing»} (al-Zukhruf 43:67).\"\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"Innamā\" restricts the predicate to the subject alone, excluding all else; used here to delimit the brotherhood of believers and the enmity of the wicked on the Day of Judgment.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "32": [{"arabic": "عز وجل وتلك حجتنا آتيناها إبراهيم على قومه وقال تعالى قالوا يا نوح قد جادلتنا فأكثرت جدالنا وقال تعالى في قصة فرعون وما رب العالمين إلى قوله أولوا جئتك بشيء مبين وعلى الجملة فالقرآن من أوله إلى آخره محاجة مع الكفار فعمدة أدلة المتكلمين في التوحيد قوله تعالى {لو كان فيهما آلهة إلا الله لفسدتا} وفي النبوة {وإن كنتم في ريب مما نزلنا على عبدنا فأتوا بسورة من مثله} وفي البعث {قل يحييها الذي أنشأها أول مرة} إلى غير ذلك من الآيات والأدلة ولم تزل الرسل صلوات الله عليهم يحاجون المنكرين ويجادلونهم قال تعالى {وجادلهم بالتي هي أحسن} فالصحابة رضي ال", "english": "The mention of the proof (ḥujjah), the demand for it, and the search after it — how could these be prohibited, when God — may He be exalted — has said: {«قُلْ هَاتُوا بُرْهَانَكُمْ»} (Say: Bring forth your proof — Qur'an 2:111), and He — mighty and majestic — has said: {«لِيَهْلِكَ مَنْ هَلَكَ عَنْ بَيِّنَةٍ وَيَحْيَا مَنْ حَيَّ عَنْ بَيِّنَةٍ»} (So that he who perishes may perish upon clear evidence, and he who lives may live upon clear evidence — Qur'an 8:42), and He — may He be exalted — has said: {«هَلْ عِنْدَكُمْ مِنْ سُلْطَانٍ بِهَذَا»} (Have you any authority for this? — Qur'an 10:68), meaning a proof and demonstration, and He — may He be exalted — has said: {«قُلْ فَلِلَّهِ الْحُجَّةُ الْبَالِغَةُ»} (Say: To God belongs the conclusive proof — Qur'an 6:149), and He — may He be exalted — has said: {«أَلَمْ تَرَ إِلَى الَّذِي حَاجَّ إِبْرَاهِيمَ فِي رَبِّهِ»} (Have you not considered him who disputed with Abraham concerning his Lord? — Qur'an 2:258) up to His words: {«فَبُهِتَ الَّذِي كَفَرَ»} (So the one who disbelieved was confounded — Qur'an 2:258).", "book_title": "Foundations of Belief", "section_title_ar": "Section 77", "section_title_en": "The Revival of the Religious Sciences — Section 77: On the Permissibility of Theological Discourse (Kalām) and Its Early Practice", "section_index": 77, "anchors": "- Root: ح-د-ث (ḥ-d-th)\n  * Lisan / Ayn: \"Al-ḥudūth: the coming-to-be of a thing after it was not; al-ḥadath: the novel event; al-ḥīdāth: origination.\"\n  * Al-Raghib (Mufradat): \"Al-ḥudūth: a thing's becoming after it was not, whether accident or substance; iḥdāth: bringing it into existence. The origination of substances belongs to God alone.\"\n  * Al-Zamakhshari (Asas): \"Literal: 'He is a recent event among events.' Metaphorical: 'They became topics of conversation (aḥādīth).'\"\n- Root: ح-ا-ج (ḥ-ā-j)\n  * Lisan / Ayn: \"Al-ḥājah: need of a thing, with desire for it; its plural: ḥājāt and ḥawā'ij.\"\n  * Al-Raghib (Mufradat): \"Al-ḥājah ilā al-shay': poverty toward it with love of it. God said: {«إِلَّا حَاجَةً فِي نَفْسِ يَعْقُوبَ»} (except a need in Jacob's soul — Qur'an 12:68).\"\n  * Al-Zamakhshari (Asas): \"Literal: need and want. The 'ḥājah' is that which one seeks to obtain.\"\n- Root: ك-و-ن (k-w-n)\n  * Lisan / Ayn: \"Kāna: to be, to exist; takwīn: bringing into being from non-existence.\"\n  * Al-Raghib (Mufradat): \"Al-kawn: existence after non-existence; the muḥdath (originated thing) is that brought forth after it was not.\"\n  * Al-Zamakhshari (Asas): \"Literal: being and becoming. Metaphorical: the continuous states of affairs.\"\n- Sibawayh Rule: Al-Faṣl bayna al-Jār wa-al-Majrūr (Prepositional Interposition) — The permissibility of separating a preposition from its object when the intervening clause is complete in meaning, as in the verse's structure of argumentation where the proof (ḥujjah) stands independently before its conclusion.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Foundations of Belief'", "badge": "Hadith"}], "38": [{"arabic": "عند اشتغاله بعمل السفينة قال {إن تسخروا منا فإنا نسخر منكم كما تسخرون} فهذا أحد النظرين النظر الثاني نظر من لم يبلغ إلى مقام الفناء عن نفسه وهؤلاء قسمان قسم لم يثبتوا إلا وجود أنفسهم وأنكروا أن يكون لهم رب يعبد وهؤلاء هم العميان المنكوسون وعماهم في كلتا العينين لأنهم نفوا ما هو الثابت تحقيقا وهو القيوم الذي هو قائم بنفسه وقائم على كل نفس بما كسبت وكل قائم فقائم به ولم يقتصروا على هذا حتى أثبتوا أنفسهم ولو عرفوا لعلموا أنهم من حيث هم هم لا ثبات لهم ولا وجود لهم وإنما وجودهم من حيث أوجدوا لا من حيث وجدوا وفرق بين الموج", "english": "From this station did Ḥabīb ibn Abī Ḥabīb look when he recited {«إِنَّا وَجَدْنَاهُ صَابِرًا نِعْمَ الْعَبْدُ إِنَّهُ أَوَّابٌ»} [We found him patient — an excellent servant, indeed he was oft-returning] and then exclaimed: \"How astonishing! He gave and He praised!\" — signaling that when He praises His own giving, He praises Himself; so He is the Praiser and He is the Praised. And from this station did the Shaykh Abū Saʿīd al-Muhayyanī look when {«يُحِبُّهُمْ وَيُحِبُّونَهُ»} [He loves them and they love Him] was recited before him, and he said: \"By my life, He loves them — leave Him to love them! By His right, He loves them — for He only loves Himself.\" He signaled thereby that He is the Loving and He is the Beloved.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 978", "section_title_en": "The Two Visions: The Eye of Pure Unity and the Eye of Those Veiled from Self-Annihilation", "section_index": 978, "anchors": "- Root: نظر (naẓar)\n  * Lisan / Ayn: Core meaning of \"sight, gazing, contemplation\" — both physical vision and intellectual perception.\n  * Al-Raghib (Mufradat): Theological nuance: naẓar as \"deliberative reflection\" (ta'ammul) leading to knowledge of the divine — the inward eye of the heart.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) = ocular sight; Metaphorical (majāz) = intellectual insight and spiritual vision.\n- Root: فنو (fanā')\n  * Lisan / Ayn: Root meaning of \"passing away, perishing, ceasing to be.\"\n  * Al-Raghib (Mufradat): Theological nuance: fanā' as the annihilation of the self's independent consideration — not physical extinction but the obliteration of the illusion of otherness beside God.\n  * Al-Zamakhshari (Asas): Literal = perishing of a thing; Metaphorical = the mystic's passing away from self-awareness into pure divine contemplation.\n- Root: قوم (qawm)\n  * Lisan / Ayn: Core meaning of \"standing, rising, being established.\"\n  * Al-Raghib (Mufradat): al-Qayyūm (القيوم) — the Self-Subsisting One by whom all else stands; theologically distinct from al-Qā'im (the standing one).\n  * Al-Zamakhshari (Asas): Literal = physical standing; Metaphorical = self-subsistence and sustaining others.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (باب الحصر والتقييد) — governing the exclusive predication in \"He is the Thankful and the Thanked\" (هو الشاكر وهو المشكور), where the definite predicate restricts the attribution solely to God.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "40": [{"arabic": "وفاحشا فقد روي أن نوحا عليه السلام لما ركب السفينة حمل فيها من كل زوجين اثنين كما أمره الله تعالى فرأى في السفينة شيخا لم يعرفه فقال له نوح ما أدخلك فقال دخلت لأصيب قلوب أصحابك فتكون قلوبهم معي وأبدانهم معك فقال له نوح أخرج منها يا عدو الله فإنك لعين فقال له إبليس خمس أهلك بهن الناس وسأحدثك منهم بثلاث ولا أحدثك باثنتين فأوحى الله تعالى إلى نوح أنه لا حاجة لك بالثلاث فليحدثك بالاثنين فقال له نوح", "english": "Among his great gates are anger (ghaḍab) and lustful desire (shahwah). For anger is the ghoul of the intellect — when the soldier of the intellect weakens, the soldier of Satan attacks. Whenever a man becomes angry, Satan plays with him as a boy plays with a ball. It has been narrated that Moses, peace be upon him, was met by Iblis, who said to him: \"O Moses, you are the one whom God chose for His message and to whom He spoke directly (taklīman). I am a creature among God's creatures. I sinned, and I wish to repent. So intercede for me to my Lord that He might accept my repentance.\" Moses said: \"Yes.\" When Moses ascended the mountain and spoke with his Lord, Mighty and Majestic, and wished to descend, his Lord said to him: \"Deliver the trust.\" Moses said: \"O Lord, Your servant Iblis wishes that You accept his repentance.\" So God, exalted be He, revealed to Moses: \"O Moses, I have already granted your request — that he prostrate before the grave of Adam so that his repentance might be accepted.\" Moses then met Iblis and said to him: \"I have secured your request — you have been commanded to prostrate before the grave of Adam so that your repentance might be accepted.\" But he became angry and arrogant, saying: \"I did not prostrate to him while he was alive — shall I prostrate to him dead?\" Then he said to him: \"O Moses, you have a right upon me because you interceded for me to your Lord. So remember me at three occasions, and I shall not destroy you in them: Remember me when you become angry, for my spirit is in your heart and my eye is in your eye, and I flow through you like the flow of blood. Remember me when you become angry — for when a man becomes angry, I blow into his nostrils, and he does not know what he does. And remember me when you encounter the battle-line (zaḥf), for I come to the son of Adam when he encounters the battle-line and remind him of his wife, his children, and his family, until he turns and flees. And beware of sitting with a woman who is not a close relative (dhāt maḥram), for I am her messenger to you and your messenger to her — I shall not cease until I tempt you with her and tempt her with you.\"", "book_title": "Disciplining the Soul", "section_title_ar": "Section 600", "section_title_en": "The Detailed Exposition of the Entrances of Satan into the Heart", "section_index": 600, "anchors": "- Root: شيط (Shayṭ)\n  * Lisan / Ayn: Core meaning relates to burning, scorching, or being consumed by fire — that which is burnt and spoiled.\n  * Al-Raghib (Mufradat): الشيطان refers to the rebellious one among jinn and mankind; the term denotes one who has deviated from truth through pride and disobedience.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"شاط اللحم\" — meat that is burnt and spoiled. Metaphorical (Majaz): \"شاط دمه\" — his blood was spilled in vain; \"أشاط السلطان دمه\" — the ruler declared his blood lawful to shed. Thus the Shayṭān is so named because he is consumed by fire, or because he causes others to be consumed/destroyed.\n\n- Root: غضب (Ghaḍab)\n  * Lisan / Ayn: The boiling and agitation of the blood of the heart, seeking vengeance.\n  * Al-Raghib (Mufradat): \"الغضب: ثوران دم القلب إرادة الانتقام\" — anger is the surging of the blood of the heart desiring vengeance. When attributed to God, it means only retribution and punishment, not an emotional state.\n  * Al-Zamakhshari (Asas): Literal: anger as a human emotional state. Metaphorical: \"غضبت له قوائم عوج\" — even inanimate things are described metaphorically. The Prophet said: \"اتقوا الغضب فإنه جمرة توقد في قلب ابن آدم\" — anger is a burning ember kindled in the heart of the son of Adam.\n\n- Root: قلب (Qalb)\n  * Lisan / Ayn: The heart; also the turning and revolving of a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the turning of a thing and its conversion from one aspect to another. The heart is so named because of its constant turning and fluctuation of states.\n  * Al-Zamakhshari (Asas): Literal: to turn something over, to flip it. Metaphorical: \"قلب المعلم الصبيان\" — the teacher dismissed the boys (turned them back to their homes); \"رجل قلب حول\" — a man who turns matters over and devises stratagems. The heart is the seat of understanding and discernment, and its protection is the fortress against Satan.\n\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the meaning remains clear, analogous to how the heart's defenses may be interposed between Satan and his objectives.\n\n---\n\n##", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Disciplining the Soul'", "badge": "Hadith"}], "45": [{"arabic": "السفينة فلم يرد فكان من المغرقين فقال رب إن ابني من أهلي فقال تعالى يا نوح إنه ليس من أهلك إنه عمل غير صالح وأن إبراهيم عليه السلام استغفر لأبيه فلم ينفعه وأن نبينا صلى الله عليه وسلم وعلى كل عبد مصطفى استأذن ربه في أن يزور قبر أمه ويستغفر لها فأذن له في الزيارة ولم يؤذن له في الاستغفار فجلس يبكي على قبر أمه لرقته لها بسبب القرابة حتى أبكى من حوله // حديث أنه صلى الله عليه وسلم استأذن أن يزور قبر أمه ويستغفر لها فأذن له في الزيارة ولم يؤذن له الاستغفار الحديث أخرجه مسلم من حديث أبي هريرة فهذا أيضا اغترار بالله", "english": "As for knowing it by way of authoritative transmission and affirmation (taṣdīq): it is that one believes in the Book of God — exalted is He — and affirms His Messenger. For God — exalted is He — has said: {«أيحسبون أن ما نمدهم به من مال وبنين * نسارع لهم في الخيرات بل لا يشعرون»} — \"Do they reckon that what We extend to them of wealth and sons — [that] We hasten for them good things? Nay, but they do not perceive\" (Q. 23:55-56). And He said — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — \"We shall draw them on by degrees from whence they do not know\" (Q. 7:182). And He said — exalted is He: {«فتحنا عليهم أبواب كل شيء حتى إذا فرحوا بما أوتوا أخذناهم بغتة فإذا هم مبلسون»} — \"We opened upon them the gates of everything, until when they rejoiced in what they were given, We seized them suddenly, and behold, they were in despair\" (Q. 6:44). And in the interpretation of His saying — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — it is said: \"Whenever they innovated a sin, We innovated for them a blessing, to increase their self-deception.\" And He said — exalted is He: {«إنما نملي لهم ليزدادوا إثما»} — \"We only grant them respite that they may increase in sin\" (Q. 3:178). And He said — exalted is He: {«ولا تحسبن الله غافلا عما يعمل الظالمون إنما يؤخرهم ليوم تشخص فيه الأبصار»} — \"And do not reckon God heedless of what the wrongdoers do; He only delays them to a Day when eyes will stare fixedly\" (Q. 14:42). And [there is] more of that kind which has come in the Book of God — exalted is He — and in the Sunnah of His Messenger. So whoever believes in it is delivered from this self-deception. For the origin of this self-deception is ignorance of God and of His attributes; for whoever knows Him does not feel secure from His stratagem (makr) and is not deceived by such corrupt fancies.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 888", "section_title_en": "Section 888 — On the Remedy for Self-Deception (Ghurūr): Recognizing the Signs of Divine Honor (Karāmah) and Humiliation (Hawān)", "section_index": 888, "anchors": "- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Core meaning of an outward trace or mark; heedlessness in wakefulness; the blaze on a horse's forehead.\n  * Al-Raghib (Mufradat): \"Ghurūr\" is delusion stemming from heedlessness — the soul's being overtaken while imagining security, as in {«ما غرك بربك الكريم»} (Q. 82:6). It is the state of one who is deceived by apparent favors while blind to their underlying test.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): heedlessness and exposure to predation, like a gazelle deceived by moonlight. Metaphorical (Majaz): being \"deceived by God\" (ightirār billāh) — trusting in His mercy while persisting in disobedience.\n- Root: لهم (l-h-m)\n  * Lisan / Ayn: Swallowing whole; the gullet.\n  * Al-Raghib (Mufradat): \"Ilhām\" — God's casting a meaning into the heart (al-raw'), distinct from demonic whispering; the channel of inner vision for the knowers (ʿārifūn).\n  * Al-Zamakhshari (Asas): Literal: to swallow. Metaphorical: the heart's receptive \"swallowing\" of divine inspiration.\n- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: Origination after non-existence; newness.\n  * Al-Raghib (Mufradat): \"Ḥudūth\" — a thing's coming to be after it was not; \"muḥdith\" — the originator, exclusively God for substances (jawāhir). \"Iḥdāth\" — bringing about a novel state or act.\n  * Al-Zamakhshari (Asas): Literal: temporal newness. Metaphorical: \"muḥaddath\" — one inspired with correct discernment, as if newly spoken-to.\n- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Softness, ease, well-being; a state of comfort.\n  * Al-Raghib (Mufradat): \"Niʿmah\" — the good state one inhabits; \"naʿīm\" — the act of living pleasantly. Blessings are both a test and a sign, per {«وإن تعدوا نعمة الله لا تحصوها»} (Q. 16:18).\n  * Al-Zamakhshari (Asas): Literal: bounty and comfort. Metaphorical: \"khafat naʿāmatuhum\" — their prosperity vanished; blessings may signal either favor or gradual ruin (istidrāj).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication with \"innamā\")\n  * In {«إنما نملي لهم ليزدادوا إثما»} (Q. 3:178) and {«إنما يؤخرهم ليوم تشخص فيه الأبصار»} (Q. 14:42), \"innamā\" restricts the purpose of divine respite exclusively to increase of sin and deferred reckoning — negating any reading of it as benevolent indulgence.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Delusion'", "badge": "Hadith"}], "46": [{"arabic": "السفينة فلم يرد فكان من المغرقين فقال رب إن ابني من أهلي فقال تعالى يا نوح إنه ليس من أهلك إنه عمل غير صالح وأن إبراهيم عليه السلام استغفر لأبيه فلم ينفعه وأن نبينا صلى الله عليه وسلم وعلى كل عبد مصطفى استأذن ربه في أن يزور قبر أمه ويستغفر لها فأذن له في الزيارة ولم يؤذن له في الاستغفار فجلس يبكي على قبر أمه لرقته لها بسبب القرابة حتى أبكى من حوله // حديث أنه صلى الله عليه وسلم استأذن أن يزور قبر أمه ويستغفر لها فأذن له في الزيارة ولم يؤذن له الاستغفار الحديث أخرجه مسلم من حديث أبي هريرة فهذا أيضا اغترار بالله تعالى وهذا لأن الله", "english": "As for knowing it by way of authoritative transmission and affirmation (taṣdīq): it is that one believes in the Book of God — exalted is He — and affirms His Messenger. For God — exalted is He — has said: {«أيحسبون أن ما نمدهم به من مال وبنين * نسارع لهم في الخيرات بل لا يشعرون»} — \"Do they reckon that what We extend to them of wealth and sons — [that] We hasten for them good things? Nay, but they do not perceive\" (Q. 23:55-56). And He said — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — \"We shall draw them on by degrees from whence they do not know\" (Q. 7:182). And He said — exalted is He: {«فتحنا عليهم أبواب كل شيء حتى إذا فرحوا بما أوتوا أخذناهم بغتة فإذا هم مبلسون»} — \"We opened upon them the gates of everything, until when they rejoiced in what they were given, We seized them suddenly, and behold, they were in despair\" (Q. 6:44). And in the interpretation of His saying — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — it is said: \"Whenever they innovated a sin, We innovated for them a blessing, to increase their self-deception.\" And He said — exalted is He: {«إنما نملي لهم ليزدادوا إثما»} — \"We only grant them respite that they may increase in sin\" (Q. 3:178). And He said — exalted is He: {«ولا تحسبن الله غافلا عما يعمل الظالمون إنما يؤخرهم ليوم تشخص فيه الأبصار»} — \"And do not reckon God heedless of what the wrongdoers do; He only delays them to a Day when eyes will stare fixedly\" (Q. 14:42). And [there is] more of that kind which has come in the Book of God — exalted is He — and in the Sunnah of His Messenger. So whoever believes in it is delivered from this self-deception. For the origin of this self-deception is ignorance of God and of His attributes; for whoever knows Him does not feel secure from His stratagem (makr) and is not deceived by such corrupt fancies.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 888", "section_title_en": "Section 888 — On the Remedy for Self-Deception (Ghurūr): Recognizing the Signs of Divine Honor (Karāmah) and Humiliation (Hawān)", "section_index": 888, "anchors": "- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Core meaning of an outward trace or mark; heedlessness in wakefulness; the blaze on a horse's forehead.\n  * Al-Raghib (Mufradat): \"Ghurūr\" is delusion stemming from heedlessness — the soul's being overtaken while imagining security, as in {«ما غرك بربك الكريم»} (Q. 82:6). It is the state of one who is deceived by apparent favors while blind to their underlying test.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): heedlessness and exposure to predation, like a gazelle deceived by moonlight. Metaphorical (Majaz): being \"deceived by God\" (ightirār billāh) — trusting in His mercy while persisting in disobedience.\n- Root: لهم (l-h-m)\n  * Lisan / Ayn: Swallowing whole; the gullet.\n  * Al-Raghib (Mufradat): \"Ilhām\" — God's casting a meaning into the heart (al-raw'), distinct from demonic whispering; the channel of inner vision for the knowers (ʿārifūn).\n  * Al-Zamakhshari (Asas): Literal: to swallow. Metaphorical: the heart's receptive \"swallowing\" of divine inspiration.\n- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: Origination after non-existence; newness.\n  * Al-Raghib (Mufradat): \"Ḥudūth\" — a thing's coming to be after it was not; \"muḥdith\" — the originator, exclusively God for substances (jawāhir). \"Iḥdāth\" — bringing about a novel state or act.\n  * Al-Zamakhshari (Asas): Literal: temporal newness. Metaphorical: \"muḥaddath\" — one inspired with correct discernment, as if newly spoken-to.\n- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Softness, ease, well-being; a state of comfort.\n  * Al-Raghib (Mufradat): \"Niʿmah\" — the good state one inhabits; \"naʿīm\" — the act of living pleasantly. Blessings are both a test and a sign, per {«وإن تعدوا نعمة الله لا تحصوها»} (Q. 16:18).\n  * Al-Zamakhshari (Asas): Literal: bounty and comfort. Metaphorical: \"khafat naʿāmatuhum\" — their prosperity vanished; blessings may signal either favor or gradual ruin (istidrāj).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication with \"innamā\")\n  * In {«إنما نملي لهم ليزدادوا إثما»} (Q. 3:178) and {«إنما يؤخرهم ليوم تشخص فيه الأبصار»} (Q. 14:42), \"innamā\" restricts the purpose of divine respite exclusively to increase of sin and deferred reckoning — negating any reading of it as benevolent indulgence.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Delusion'", "badge": "Hadith"}], "56": [{"arabic": "ومن شر كل دابة أنت آخذ بناصيتها إن ربي على صراط مستقيم (1) دعاء الخليل إبراهيم عليه الصلاة والسلام كان يقول إذا أصبح اللهم إن هذا خلق جديد فافتحه علي بطاعتك واختمه لي بمغفرتك ورضوانك وارزقني فيه حسنة تقبلها مني وزكها وضعفها لي وما عملت فيه من سيئة فاغفرها لي إنك غفور رحيم ودود كريم قال ومن دعا بهذا الدعاء إذا أصبح فقد أدى شكر يومه دعاء عيسى عليه الصلاة والسلام كان يقول اللهم إني أصبحت لا أستطيع دفع ما أكره ولا أملك نفع ما أرجو وأصبح الأمر بيد غيري وأصبحت مرتهنا بعملي فلا فقير أفقر من", "english": "And it is related that the Messenger of Allah (peace be upon him) said to him: \"O Buraydah, shall I not teach you words which, if anyone desires good through them, he is taught them, and then he never forgets them ever?\" He said: \"I said, 'Yes, O Messenger of Allah.'\" He said: \"Say: 'O Allah, I am weak, so strengthen my weakness in Your pleasure, and take me by my forelock toward goodness, and make Islam the limit of my contentment. O Allah, I am weak, so strengthen me; and I am abased, so honor me; and I am poor, so enrich me, O Most Merciful of the merciful.'\" (2)", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 248", "section_title_en": "The Revival of the Religious Sciences — Section 248: Supplications of the Companions and Prophets (Peace Be Upon Them)", "section_index": 248, "anchors": "- Root: دعو (d-'-w)\n  * Lisan / Ayn: Core meaning of calling, invoking, summoning; du'a as the act of calling upon God with humble petition.\n  * Al-Raghib (Mufradat): Theological nuance of du'a as the essence of worship ('ibadah), the creature's acknowledgment of need (iftaqar) before the Creator.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) — to call out; Metaphorical (majaz) — the soul's inward turning to God, transcending mere vocal utterance.\n- Root: وقي (w-q-y)\n  * Lisan / Ayn: To protect, guard, preserve from harm; the root of taqwa (God-consciousness) and ittiqa (self-preservation from divine displeasure).\n  * Al-Raghib (Mufradat): The theological state of being shielded by God's grace through the performance of obligations and abstention from prohibitions.\n  * Al-Zamakhshari (Asas): Literal — physical protection; Metaphorical — spiritual safeguarding of the heart from worldly attachment.\n- Root: حول (h-w-l)\n  * Lisan / Ayn: Power, might, capacity to change or transform; the ability to effect motion or cessation.\n  * Al-Raghib (Mufradat): In the formula \"لا حول ولا قوة إلا بالله\" (lā ḥawla wa lā quwwata illā billāh), it denotes the creature's absolute incapacity and total reliance on divine power (quwwah) for all acts of obedience and avoidance of sin.\n  * Al-Zamakhshari (Asas): Literal — physical strength; Metaphorical — the spiritual power granted by God to overcome one's lower self (nafs).\n- Root: فقر (f-q-r)\n  * Lisan / Ayn: Poverty, neediness, lack of possessions; the state of one who requires what he does not possess.\n  * Al-Raghib (Mufradat): The ontological poverty of all creatures before God — \"يا أيها الناس أنتم الفقراء إلى الله\" {O mankind, you are the poor in need of Allah} [Fatir: 15]. This is the existential need that defines creaturehood.\n  * Al-Zamakhshari (Asas): Literal — material poverty; Metaphorical — the soul's recognition of its utter dependence on God for guidance, sustenance, and salvation.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening phrase constitutes a complete and meaningful utterance, as seen in the extended invocations where multiple clauses are joined by conjunctions (wa) before the governing verb's object is completed.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "69": [{"arabic": "أتاك حديث ضيف إبراهيم المكرمين} أنهم أكرموا بتعجيل الطعام إليهم دل عليه قوله تعالى {فما لبث أن جاء بعجل حنيذ} وقوله {فراغ إلى أهله فجاء بعجل سمين} والروغان الذهاب بسرعة وقيل في خفية وقيل جاء بفخذ من لحم وإنما سمي عجلا لأنه عجله ولم يلبث قال حاتم الأصم العجلة من الشيطان إلا في خمسة فإنها من سنة رسول الله صلى الله عليه وسلم إطعام الضيف وتجهيز الميت وتزويج البكر وقضاء الدين والتوبة من الذنب (2) ويستحب التعجيل في الوليمة قيل الوليمة في أول يوم سنة وفي الثاني معروف وفي الثالث رياء الثاني ترتيب الأطعمة بتقديم الفاكهة أولا إن كانت فذلك أوفق في ا", "english": "The Prophet (peace and blessings be upon him) said: \"Do not burden your guest so that you make him hate you, for whoever hates his guest has hated Allah, and whoever hates Allah, Allah hates him.\"", "book_title": "Manners of Eating", "section_title_ar": "Section 290", "section_title_en": "The Etiquettes of Hospitality: Invitation, Response, Attendance, and the Serving of Food — Section 290 of The Revival of the Religious Sciences", "section_index": 290, "anchors": "- Root: ضيف (ḍ-y-f)\n  * Lisan / Ayn: Core meaning is \"to incline, to lean toward.\" The guest (al-ḍayf) is one who inclines toward you, alighting as a visitor; the root carries the sense of leaning or bending.\n  * Al-Raghib (Mufradat): The guest is \"one who inclines to you, alighting with you\"; hospitality (al-ḍiyāfah) became customary in the sense of receiving such a one. The word is originally a verbal noun, hence one and many are equal in most usage.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ḍāfa ilayhi: he inclined toward him\"; \"ḍāfat al-shams: the sun inclined toward setting.\" Metaphorical (majāz): \"aḍāfa ilayhi amran: he attributed a matter to him, leaning it upon him\"; \"al-muḍāf: the one constrained, hemmed in, in distress.\"\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the Prophet's statement \"innamā hādhihi al-akhlāq bi-yad Allāh\" (these morals are only in the hand of Allah), where innamā restricts the attribution of moral character exclusively to divine bestowal.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Manners of Eating'", "badge": "Hadith"}], "80": [{"arabic": "مسكين وقيل لإبراهيم بن أدهم رحمه الله لم لا تشرب من ماء زمزم فقال لو كان لي دلو شربت منه وقال سفيان الثوري رضي الله عنه من أنفق من الحرام في طاعة الله كان كمن طهر الثوب النجس بالبول والثوب النجس لا يطهره إلا الماء والذنب لا يكفره إلا الحلال وقال يحيى بن معاذ الطاعة خزانة من خزائن الله إلا أن مفتاحها الدعاء وأسنانه لقم الحلال وقال ابن عباس رضي الله عنهما لا يقبل الله صلاة امرىء في جوفه حرام وقال سهل التستري لا يبلغ العبد حقيقة الإيمان حتى يكون فيه أربع خصال أداء الفرائض بالسنة وأكل الحلال بالورع واجتناب ال", "english": "God Most High has said: {«كلوا من الطيبات واعملوا صالحا»} — \"Eat of the good things and do righteous deeds.\" (Q. 23:51) He commanded eating from the good things before [commanding] righteous deeds. And it is said that what is meant by \"the good things\" is the lawful (al-ḥalāl).", "book_title": "Harms of the Tongue", "section_title_ar": "Section 336", "section_title_en": "The Revival of the Religious Sciences — Book of the Etiquette of Eating: Section 336 — The Virtue of Lawful Sustenance and the Blameworthiness of the Forbidden", "section_index": 336, "anchors": "- Root: اكل (akl)\n  * Lisan / Ayn: Core root meaning of eating, consuming, and tasting food; the act of taking nourishment into the body.\n  * Al-Raghib (Mufradat): \"الأكل: تناول المطعم\" — eating is the taking of food; used metaphorically for fire consuming wood, and extended to mean lawful provision (ḥalāl) as the sustenance of the soul's soundness.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for physical ingestion; metaphorical (majāz) for consuming wealth unlawfully, as in \"أكل مال اليتيم\" (devouring the orphan's wealth).\n- Root: طعم (tuʿm)\n  * Lisan / Ayn: Food, sustenance, and the act of tasting; also used for bait and that which is eaten.\n  * Al-Raghib (Mufradat): Sustenance as that which nourishes the body; in the Kalam context, the lawful (ḥalāl) is that which purifies the heart, while the forbidden (ḥarām) corrupts it.\n  * Al-Zamakhshari (Asas): Literal for food; metaphorical for the moral state of the soul — \"طعمه حرام\" (his food is forbidden) signifies the corruption of one's entire being.\n- Root: ورق (waraʿ)\n  * Lisan / Ayn: Abstinence, scrupulousness, and piety; refraining from doubtful matters.\n  * Al-Raghib (Mufradat): The theological virtue of cautious avoidance of all that is suspect, as the foundation of true worship and the key to answered supplication.\n  * Al-Zamakhshari (Asas): Literal for refraining; metaphorical for the heart's purity achieved through guarding the limbs from the unlawful.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure of conditional and consequential clauses, where the protasis (e.g., \"من أكل حراما\") governs the apodosis (\"لم يقبل منه صرف ولا عدل\"), demonstrating the causal nexus between action and divine recompense.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Harms of the Tongue'", "badge": "Insight"}], "88": [{"arabic": "والله المعين لا رب غيره وما توفيقي إلا بالله وحسبنا الله ونعم الوكيل", "english": "As for what occurs in the year, after the days of Ramadan: the Day of 'Arafah, the Day of 'Āshūrā', the first ten days of Dhū al-Ḥijjah, and the first ten days of al-Muḥarram. All of the Sacred Months are occasions for fasting, and they are virtuous times. The Messenger of God, peace be upon him, used to fast much in Sha'bān, until it was thought that he was in Ramadan. (1) And in the report: \"The best of fasting after the month of Ramadan is the month of God, al-Muḥarram\" (2) — because it is the beginning of the year, and that its foundation be laid upon good is more beloved and more hopeful for the continuance of its blessing.", "book_title": "Mysteries of Fasting", "section_title_ar": "Section 190", "section_title_en": "The Book of the Secrets of Fasting — Section 190: On the Virtuous Days and the Ranks of Voluntary Fasting", "section_index": 190, "anchors": "- Root: صوم (ṣ-w-m)\n  * Lisan / Ayn: Core meaning is \"abstention\" (imsāk) from any act—food, speech, or movement—as al-Raghib notes; a horse that refrains from fodder is called ṣā'im.\n  * Al-Raghib (Mufradat): \"الصوم في الأصل: الإمساك عن الفعل\" — fasting in its root is abstention from action, whether food, speech, or walking; hence the horse that refrains from movement or fodder is called ṣā'im.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): the month of fasting, \"فمن شهد منكم الشهر فليصمه\" — \"so whoever witnesses the month, let him fast it.\" Metaphorical (majāz): \"صام الفرس على آريه إذا لم يعتلف\" — the horse \"fasts\" at its stall when it does not eat.\n- Root: شهر (sh-h-r)\n  * Lisan / Ayn: The month (al-shahr) is a well-known measure of time, marked by the appearance of the crescent or by a twelfth part of the solar circuit.\n  * Al-Raghib (Mufradat): \"الشهر: مدة مشهورة بإهلال الهلال\" — the month is a duration made known by the crescent's sighting; God says: {«شهر رمضان الذي أنزل فيه القرآن»} — \"The month of Ramadan in which the Qur'an was sent down.\"\n  * Al-Zamakhshari (Asas): Literal: \"طلع الشهر: الهلال\" — the month rises with the crescent. Metaphorical: \"اشتهرت فلانا: استخففت به وفضحته\" — to make one a \"month-famous\" is to expose and disgrace him.\n- Root: رمض (r-m-ḍ)\n  * Lisan / Ayn: From the intense heat of the sun-baked ground (al-ramḍā'); one whose feet are burned by it is ramiḍ.\n  * Al-Raghib (Mufradat): \"شهر رمضان هو من الرمض، أي: شدة وقع الشمس\" — Ramadan derives from ramaḍ, the severity of the sun's heat; \"أرمضته فرمض\" — the heat burned him.\n  * Al-Zamakhshari (Asas): Literal: \"مشى على الرمضاء وهي الحجارة التي اشتد عليها وقع الشمس فحميت\" — walking on the ramḍā', stones heated by the sun's force. Metaphorical: \"تداخلني من هذا الأمر رمض\" — anxiety from an affair enters one, as if burning.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Specification) — The phrase \"إنما يكره لشيئين\" (it is only disliked for two reasons) employs restriction (ḥaṣr) to delimit the scope of the ruling, a construction governed by the principles of focused predication in Al-Kitāb.", "content_type": "general", "topic": "Classical commentary from Al-Ghazali's Ihya Ulum al-Din, from 'Mysteries of Fasting'", "badge": "Commentary"}, {"arabic": "الله أن تقولوا ما لا تفعلون وقال تعالى في قصة شعيب وما أريد أن أخالفكم إلى ما أنهاكم عنه وقال تعالى واتقوا الله ويعلمكم الله وقال تعالى واتقوا الله واعلموا واتقوا الله واسمعوا وقال تعالى لعيسى عليه السلام يا ابن مريم عظ نفسك فإن اتعظت فعظ الناس وإلا فاستحي مني وقال رسول الله صلى الله عليه وسلم مررت ليلة أسري بي بأقوام تقرض شفاههم بمقاريض من نار فقلت من أنتم فقالوا كنا نأمر بالخير ولا نأتيه وننهى عن الشر ونأتيه (2) وقال صلى الله عليه وسلم هلاك أمتي عالم فاجر وعابد جاهل وشر الشرار شرار العلماء وخير الخيار خيار العلماء (3) وقال الأوزاعي رحم", "english": "[Root: ملح]\n  • Lisan al-Arab: \"الملح: ما يصلح الطعام، وجمعه ملوح وأملاح. والمليح: الحسن. والملاحة: الحسن. وملح الرجل يملح ملاحة: حسن. وتملح: تزين.\"\n  • Al-Raghib (Al-Mufradat): \"الملح: ما يحفظ الطعام ويمنع فساده، ويستعار لما يحفظ الإيمان والعلم من الفساد.\"\n  • Al-Zamakhshari (Asas): \"ملح الماء: إذا كان فيه ملوحة. وملح الطعام: جعل فيه الملح. وهذا على الحقيقة، ويستعار الملح لما يصلح به الأمر.\"\n  • Kitab al-Ayn: \"الملح: معروف، والمليح: الحسن من كل شيء.\"", "book_title": "Book of Knowledge", "section_title_ar": "Section 52", "section_title_en": "Section 52", "section_index": 52, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "مصطفى من أهل الأرض والسماء وما توفيقي إلا بالله عليه توكلت وإليه أنيب كتاب كسر الشهوتين وهو الكتاب الثالث من ربع المهلكات بسم الله الرحمن الرحيم الحمد لله المنفرد بالجلال في كبريائه وتعاليه المستحق للتحميد والتقديس والتسبيح والتنزيه القائم بالعدل فيما يبرمه ويقضيه المتطول بالفضل فيما ينعم به ويسديه المتكفل بحفظ عبده في جميع موارده ومجاريه المنعم عليه بما يزيد على مهمات مقاصده بل بما يفي بأمانيه فهو الذي يرشده ويهديه وهو الذي يميته ويحييه وإذا مرض فهو يشفيه وإذا ضعف فهو يقويه وهو الذي يوفقه للطاعة ويرتضيه وهو", "english": "And praise belongs to God alone, and blessings upon our master Muḥammad, upon his Family, his Companions, and upon every chosen servant from among the people of the earth and the heavens. And my success is only through God; upon Him I rely and unto Him I turn in repentance.", "book_title": "Breaking the Two Desires", "section_title_ar": "Section 638", "section_title_en": "Section 638", "section_index": 638, "anchors": "*(Anchors established)*", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Breaking the Two Desires'", "badge": "Dhikr"}], "107": [{"arabic": "الله وأدامها ما دامت السموات والأرض وفي التثويب صدقت وبررت ونصحت وعند الفراغ يقول اللهم رب هذه الدعوة التامة والصلاة القائمة آت محمدا الوسيلة والفضيلة والدرجة الرفيعة وابعثه المقام المحمود الذي وعدته إنك لا تخلف الميعاد وقال سعيد بن المسيب من صلى بأرض فلاة صلى عن يمينه ملك وعن شماله ملك فإن أذن وأقام صلى وراءه أمثال الجبال من الملائكة فضيلة المكتوبة قال الله تعالى إن الصلاة كانت على المؤمنين كتابا موقوتا وقال صلى الله عليه وسلم خمس صلوات كتبهن الله على العباد فمن جاء", "english": "Praise be to God, who has inundated His servants with His subtle graces (laṭāʾif) and filled their hearts with the lights of religion and its ordinances — which descend from the Throne of Majesty to the heaven of this world as one of the outpourings of His mercy. He has distinguished Himself from [earthly] kings through His unique possession of Majesty and Grandeur by encouraging His creatures to ask and to supplicate, saying: {«هَلْ مِن دَاعٍ فَأَسْتَجِيبَ لَهُ وَهَلْ مِن مُّسْتَغْفِرٍ فَأَغْفِرَ لَهُ»} (Is there any supplicant that I may respond to him? Is there any seeker of forgiveness that I may forgive him?). And He has set Himself apart from [earthly] sovereigns by opening the door and lifting the veil, permitting His servants to engage in intimate communion (munājāh) through the prayers, however their states may fluctuate — in congregations and in solitude. Nor did He content Himself with mere permission, but He graciously encouraged and invited [them]. Other kings, even the weakest among them, do not permit private audience except after the presentation of gifts and bribes. Glory be to Him — how great is His majesty, how mighty His dominion, how complete His gentleness, how all-encompassing His beneficence!", "book_title": "Mysteries of Prayer", "section_title_ar": "Section 120", "section_title_en": "The Book of the Secrets of Prayer and Its Essential Matters — Section 120: On the Virtues of the Call to Prayer (Adhān) and the Prescribed Prayers", "section_index": 120, "anchors": "- Root: صلو (Ṣ-L-W)\n  * Lisan / Ayn: The root denotes the act of supplication, blessing, and the prescribed ritual prayer; its core sense involves \"connection\" and \"turning toward.\"\n  * Al-Raghib (Mufradat): \"الصلاة\" in its theological sense is the act of drawing near to God through prescribed devotional acts comprising bowing, prostration, and remembrance — a covenant (ʿahd) between the servant and his Lord.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): the ritual prayer with its known conditions and pillars. Metaphorical (majāz): supplication (duʿāʾ) and blessing (raḥmah), as in \"the angels send blessings (yuṣallūn) upon the Prophet.\"\n- Root: أذن (A-Dh-N)\n  * Lisan / Ayn: To listen, to give ear; the mu'adhdhin is one who makes the call heard publicly.\n  * Al-Raghib (Mufradat): The adhān is the public proclamation summoning the community to the prescribed prayer — a declaration of the time of worship.\n  * Al-Zamakhshari (Asas): Literal: the act of making known. Metaphorical: the call to prayer as a summons to the Divine presence.\n- Root: ملك (M-L-K)\n  * Lisan / Ayn: Possession, dominion, sovereignty.\n  * Al-Raghib (Mufradat): \"الملك: هو المتصرف بالأمر والنهي في الجمهور\" — The king is one who disposes by command and prohibition over the multitude. God's sovereignty (mulk) is absolute and unshared.\n  * Al-Zamakhshari (Asas): Literal: ownership and dominion. Metaphorical: \"ملك عليه أمره\" — mastery over one's own affair, self-possession.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — The periodic sentence structure in the opening doxology employs suspended clauses (ḥāl) that qualify the subject while maintaining syntactic cohesion through the governing verb's semantic reach.\n\n---", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Prayer'", "badge": "Insight"}], "108": [{"arabic": "الله وأدامها ما دامت السموات والأرض وفي التثويب صدقت وبررت ونصحت وعند الفراغ يقول اللهم رب هذه الدعوة التامة والصلاة القائمة آت محمدا الوسيلة والفضيلة والدرجة الرفيعة وابعثه المقام المحمود الذي وعدته إنك لا تخلف الميعاد وقال سعيد بن المسيب من صلى بأرض فلاة صلى عن يمينه ملك وعن شماله ملك فإن أذن وأقام صلى وراءه أمثال الجبال من الملائكة فضيلة المكتوبة قال الله تعالى إن الصلاة كانت على المؤمنين كتابا موقوتا وقال صلى الله عليه وسلم خمس صلوات كتبهن الله على العباد فمن جاء", "english": "Praise be to God, who has inundated His servants with His subtle graces (laṭāʾif) and filled their hearts with the lights of religion and its ordinances — which descend from the Throne of Majesty to the heaven of this world as one of the outpourings of His mercy. He has distinguished Himself from [earthly] kings through His unique possession of Majesty and Grandeur by encouraging His creatures to ask and to supplicate, saying: {«هَلْ مِن دَاعٍ فَأَسْتَجِيبَ لَهُ وَهَلْ مِن مُّسْتَغْفِرٍ فَأَغْفِرَ لَهُ»} (Is there any supplicant that I may respond to him? Is there any seeker of forgiveness that I may forgive him?). And He has set Himself apart from [earthly] sovereigns by opening the door and lifting the veil, permitting His servants to engage in intimate communion (munājāh) through the prayers, however their states may fluctuate — in congregations and in solitude. Nor did He content Himself with mere permission, but He graciously encouraged and invited [them]. Other kings, even the weakest among them, do not permit private audience except after the presentation of gifts and bribes. Glory be to Him — how great is His majesty, how mighty His dominion, how complete His gentleness, how all-encompassing His beneficence!", "book_title": "Mysteries of Prayer", "section_title_ar": "Section 120", "section_title_en": "The Book of the Secrets of Prayer and Its Essential Matters — Section 120: On the Virtues of the Call to Prayer (Adhān) and the Prescribed Prayers", "section_index": 120, "anchors": "- Root: صلو (Ṣ-L-W)\n  * Lisan / Ayn: The root denotes the act of supplication, blessing, and the prescribed ritual prayer; its core sense involves \"connection\" and \"turning toward.\"\n  * Al-Raghib (Mufradat): \"الصلاة\" in its theological sense is the act of drawing near to God through prescribed devotional acts comprising bowing, prostration, and remembrance — a covenant (ʿahd) between the servant and his Lord.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): the ritual prayer with its known conditions and pillars. Metaphorical (majāz): supplication (duʿāʾ) and blessing (raḥmah), as in \"the angels send blessings (yuṣallūn) upon the Prophet.\"\n- Root: أذن (A-Dh-N)\n  * Lisan / Ayn: To listen, to give ear; the mu'adhdhin is one who makes the call heard publicly.\n  * Al-Raghib (Mufradat): The adhān is the public proclamation summoning the community to the prescribed prayer — a declaration of the time of worship.\n  * Al-Zamakhshari (Asas): Literal: the act of making known. Metaphorical: the call to prayer as a summons to the Divine presence.\n- Root: ملك (M-L-K)\n  * Lisan / Ayn: Possession, dominion, sovereignty.\n  * Al-Raghib (Mufradat): \"الملك: هو المتصرف بالأمر والنهي في الجمهور\" — The king is one who disposes by command and prohibition over the multitude. God's sovereignty (mulk) is absolute and unshared.\n  * Al-Zamakhshari (Asas): Literal: ownership and dominion. Metaphorical: \"ملك عليه أمره\" — mastery over one's own affair, self-possession.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — The periodic sentence structure in the opening doxology employs suspended clauses (ḥāl) that qualify the subject while maintaining syntactic cohesion through the governing verb's semantic reach.\n\n---", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Prayer'", "badge": "Insight"}], "113": [{"arabic": "شهده قال تعالى {ولا تركنوا إلى الذين ظلموا} قيل لا ترضوا بأعمالهم فإن كنت في القوة بحيث لا تزداد حبالهم بذلك فلا بأس بالأخذ وقد حكي عن بعض عباد البصرة أنه كان يأخذ أموالا ويفرقها فقيل له ألا تخاف أن تحبهم فقال لو أخذ رجل بيدي وأدخلني الجنة ثم عصى ربه ما أحبه قلبي لأن ما الذي سخره للأخذ بيدي هو الذي أبغضه لأجله شكرا له على تصخيره إياه وبهذا تبين أخذ المال الآن منهم وإن كان ذلك المال بعينه من وجه حلال محذور ومذموم لأنه لا ينفك عن هذه الغوائل", "english": "Wahb ibn Munabbih related that a man was brought before a king in the sight of the people, to be compelled to eat the flesh of swine — and he did not eat. Then roasted sheep's flesh was presented to him, and he was compelled by the sword — and he did not eat. So it was said to him concerning that, and he replied: \"The people have come to believe that I was demanded to eat swine's flesh. So if I come out safe, having eaten, they will not know what I ate — and they will be led astray.\"", "book_title": "The Lawful and Prohibited", "section_title_ar": "Section 393", "section_title_en": "** Section 393: On Accepting Wealth from Rulers for Distribution — The Three Perils", "section_index": 393, "anchors": "**\n- Root: أ-ل-ك (ʾ-l-k)\n  * Lisan / Ayn: The root denotes \"to carry a message\" (al-ulūkah/al-alūkah = the message). Al-Farahidi: \"al-maʾlakah: the message, because it is carried in the mouth.\"\n  * Al-Raghib (Mufradat): \"al-malāʾikah\" (angels) derives from this root — one who carries the message between the Divine and creation. The term \"malak\" (angel) is a contraction of \"maʾlak.\"\n  * Al-Zamakhshari (Asas): Literal usage: \"alkani ilā fulān\" (carry my message to so-and-so). The metaphorical extension applies to any commission of trust.\n- Root: و-ق-د (w-q-d)\n  * Lisan / Ayn: \"To kindle, to burn, to blaze.\" Al-Ayn: \"waqadat al-nār\" (the fire blazed).\n  * Al-Raghib (Mufradat): \"al-wuqūd\" is both the fuel and the act of burning. In the Quranic verse {«وَقُودُهَا النَّاسُ وَالْحِجَارَةُ»} (\"whose fuel is men and stones\"), the term denotes that which feeds the fire.\n  * Al-Zamakhshari (Asas - Majaz): Metaphorical: \"qalbun waqqād\" (a blazing heart — i.e., sharp, penetrating intellect). The \"blazing\" of the heart in love or zeal is a metaphorical extension of the physical burning of fire.\n- Root: ك-و-ن (k-w-n)\n  * Lisan / Ayn: \"To be, to exist, to come into being.\" The root denotes existence and becoming.\n  * Al-Raghib (Mufradat): \"kāna\" in its full sense denotes coming into being after non-existence; in its defective (nāqiṣah) usage, it links predicate to subject without implying temporal origination.\n  * Al-Zamakhshari (Asas): The literal sense is \"to be\"; the metaphorical extension applies to any state or condition that \"comes to be\" for a person.\n- Sibawayh Rule: Bāb al-Ḥaṣr wa-al-Taqyīd bi-innamā (Restriction and Focused Predication with innamā) — When the construction \"innamā\" is used, it restricts the predicate to the subject alone, excluding all else. This is critical for understanding the author's restrictive statements about when taking is permissible.\n\n---\n\n**", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'The Lawful and Prohibited'", "badge": "Insight"}], "114": [{"arabic": "وأطراف النهار لعلك ترضى} وقال عز وجل {وأقم الصلاة طرفي النهار وزلفا من الليل أن الحسنات يذهبن السيئات} ثم انظر كيف وصف الفائزين من عباده وبماذا وصفهم فقال تعالى {أم من هو قانت}", "english": "This is what has been unveiled to those who gaze with the light of inner vision. But if you are not among its people, then look to the address of God Most High to His Messenger and derive it by the light of faith. For God Most High said to the nearest of His servants to Him and the highest of them in rank before Him: {«Indeed, for you in the day is prolonged occupation and [in the night] long travail. And remember the name of your Lord and devote yourself to Him with [complete] devotion»} (73:7-8). And He said Most High: {«And remember the name of your Lord [in prayer] morning and evening. And from [part of] the night, prostrate to Him and exalt Him a long [part of the] night»} (76:25-26). And He said Most High: {«And exalt [Allah] with praise of your Lord before the rising of the sun and before its setting, and during periods of the night [exalt Him] and after the [performance of] prostrations»} (50:39-40). And He said, Glorified be He: {«And exalt [Allah] with praise of your Lord when you arise. And during part of the night exalt Him and after the stars»} (52:48-49). And He said Most High: {«Indeed, the rising by night is more potent for directing the soul and more suitable for the recitation [of the Qur'an]»} (73:6). And He said Most High: {«And from [part of] the night, exalt Him and after the setting of the stars»} (52:49). And He said Most High: {«And during parts of the night, exalt Him and at the ends of the day, that you may be satisfied»} (20:130). And He said, Mighty and Majestic: {«And establish prayer at the two ends of the day and at the approach of the night. Indeed, good deeds do away with misdeeds»} (11:114).", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 257", "section_title_en": "The Virtue of the Liturgies of Remembrance (Awrād) and the Elucidation That Perseverance Upon Them Is the Path to God Most High", "section_index": 257, "anchors": "- Root: ورد (w-r-d)\n  * Lisan / Ayn: The root denotes arriving at water, approaching a watering-place; the awrād (pl. of wird) are the appointed portions of devotional recitation assigned to fixed times, as one approaches the fountain of divine mercy.\n  * Al-Raghib (Mufradat): The wird is the allocated share of worship apportioned to a specific hour; its theological nuance is the systematic distribution of remembrance (dhikr) and reflection (fikr) across the昼夜 cycle to combat the soul's innate restlessness.\n  * Al-Zamakhshari (Asas): Literal: the portion of water one drinks. Metaphorical: the fixed liturgical portion one \"drinks\" from the fountain of gnosis—the shift from physical quenching to spiritual saturation.\n- Root: لطف (l-ṭ-f)\n  * Lisan / Ayn: Gentleness, subtlety, graciousness; to treat with kindness and refinement.\n  * Al-Raghib (Mufradat): The divine subtlety (al-luṭf) by which God gently draws His servant; here, the soul's need for gentle management (talṭīf) through variety in worship, lest it weary.\n  * Al-Zamakhshari (Asas): Literal: physical gentleness of touch. Metaphorical: the strategic, compassionate variation of devotional acts to sustain the soul's momentum—a haqīqah of spiritual governance.\n- Root: سأم (s-'-m)\n  * Lisan / Ayn: Weariness, boredom, satiety that breeds aversion; the soul's constitutional fatigue with a single monotonous mode.\n  * Al-Raghib (Mufradat): The psychological impediment to perseverance; overcome only by the divine mercy of variety, as the Prophet said: «إن الله لا يمل حتى تملوا» — God does not weary, but He has ordained that you may.\n  * Al-Zamakhshari (Asas): Literal: the nausea of over-satiation. Metaphorical: the spiritual listlessness that overtakes the heart when devotion becomes mechanical—requiring the \"turn\" (tanqul) between genres of worship.\n- Sibawayh Rule: باب التنويع والتقسيم (The Chapter of Division and Distribution) — The periodic structure here distributes predicates across multiple conditional clauses (fa-in... fa-in...), each governing a distinct outcome, requiring the translator to preserve the balanced, correlative syntax of proportional reward.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}, {"arabic": "الليل أن الحسنات يذهبن السيئات} ثم انظر كيف وصف الفائزين من عباده وبماذا وصفهم فقال تعالى {أم من هو قانت}", "english": "This is what has been unveiled to those who gaze with the light of inner vision. But if you are not among its people, then look to the address of God Most High to His Messenger and derive it by the light of faith. For God Most High said to the nearest of His servants to Him and the highest of them in rank before Him: {«Indeed, for you in the day is prolonged occupation and [in the night] long travail. And remember the name of your Lord and devote yourself to Him with [complete] devotion»} (73:7-8). And He said Most High: {«And remember the name of your Lord [in prayer] morning and evening. And from [part of] the night, prostrate to Him and exalt Him a long [part of the] night»} (76:25-26). And He said Most High: {«And exalt [Allah] with praise of your Lord before the rising of the sun and before its setting, and during periods of the night [exalt Him] and after the [performance of] prostrations»} (50:39-40). And He said, Glorified be He: {«And exalt [Allah] with praise of your Lord when you arise. And during part of the night exalt Him and after the stars»} (52:48-49). And He said Most High: {«Indeed, the rising by night is more potent for directing the soul and more suitable for the recitation [of the Qur'an]»} (73:6). And He said Most High: {«And from [part of] the night, exalt Him and after the setting of the stars»} (52:49). And He said Most High: {«And during parts of the night, exalt Him and at the ends of the day, that you may be satisfied»} (20:130). And He said, Mighty and Majestic: {«And establish prayer at the two ends of the day and at the approach of the night. Indeed, good deeds do away with misdeeds»} (11:114).", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 257", "section_title_en": "The Virtue of the Liturgies of Remembrance (Awrād) and the Elucidation That Perseverance Upon Them Is the Path to God Most High", "section_index": 257, "anchors": "- Root: ورد (w-r-d)\n  * Lisan / Ayn: The root denotes arriving at water, approaching a watering-place; the awrād (pl. of wird) are the appointed portions of devotional recitation assigned to fixed times, as one approaches the fountain of divine mercy.\n  * Al-Raghib (Mufradat): The wird is the allocated share of worship apportioned to a specific hour; its theological nuance is the systematic distribution of remembrance (dhikr) and reflection (fikr) across the昼夜 cycle to combat the soul's innate restlessness.\n  * Al-Zamakhshari (Asas): Literal: the portion of water one drinks. Metaphorical: the fixed liturgical portion one \"drinks\" from the fountain of gnosis—the shift from physical quenching to spiritual saturation.\n- Root: لطف (l-ṭ-f)\n  * Lisan / Ayn: Gentleness, subtlety, graciousness; to treat with kindness and refinement.\n  * Al-Raghib (Mufradat): The divine subtlety (al-luṭf) by which God gently draws His servant; here, the soul's need for gentle management (talṭīf) through variety in worship, lest it weary.\n  * Al-Zamakhshari (Asas): Literal: physical gentleness of touch. Metaphorical: the strategic, compassionate variation of devotional acts to sustain the soul's momentum—a haqīqah of spiritual governance.\n- Root: سأم (s-'-m)\n  * Lisan / Ayn: Weariness, boredom, satiety that breeds aversion; the soul's constitutional fatigue with a single monotonous mode.\n  * Al-Raghib (Mufradat): The psychological impediment to perseverance; overcome only by the divine mercy of variety, as the Prophet said: «إن الله لا يمل حتى تملوا» — God does not weary, but He has ordained that you may.\n  * Al-Zamakhshari (Asas): Literal: the nausea of over-satiation. Metaphorical: the spiritual listlessness that overtakes the heart when devotion becomes mechanical—requiring the \"turn\" (tanqul) between genres of worship.\n- Sibawayh Rule: باب التنويع والتقسيم (The Chapter of Division and Distribution) — The periodic structure here distributes predicates across multiple conditional clauses (fa-in... fa-in...), each governing a distinct outcome, requiring the translator to preserve the balanced, correlative syntax of proportional reward.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Condemnation of Pride and Conceit'", "badge": "Du'a"}], "115": [{"arabic": "فتح الباب والله لا يضيع أجر المحسنين وإن تك حسنة يضاعفها ويؤت من لدنه أجرا عظيما المقام الثاني في دفع العارض منه في أثناء العبادة وذلك لا بد من تعلمه أيضا فإن من جاهد نفسه وقلع مغارس الرياء من قلبه بالقناعة وقطع الطمع وإسقاط نفسه من أعين المخلوقين واستحقار مدح المخلوقين وذمهم فالشيطان لا يتركه في أثناء العبادات بل يعارضه بخطرات الرياء ولا تنقطع عنه نزعاته وهوى النفس وميلها لا ينمحي بالكلية فلا بد وأن يتشمر لدفع ما يعرض من خاطر الرياء وخواطر الرياء ثلاثة قد تخطر دفعة واحدة كالخاطر ال", "english": "So when the harm and injury of these causes is firmly settled in his heart, his desire [for them] slackens, and his heart turns toward God. For the intelligent person does not covet that whose harm is abundant and whose benefit is scant. It suffices him that if people knew what is in his inner self—the intent of ostentation (riyā') and the display of sincerity—they would abhor him. And God will surely expose his secret until He makes him odious to the people and makes them know that he is a show-off, abhorrent to God. Had he been sincere to God, God would have unveiled his sincerity to them, made him beloved to them, subjected them to him, and loosened their tongues in praise and commendation of him—even though there is no perfection in their praise, nor deficiency in their blame. As the poet of Banī Tamīm said: \"My praise is an adornment, and my blame is a disgrace.\" The Messenger of God (peace and blessings be upon him) said to him: \"You have lied—that belongs to God, there is no deity but Him.\" // [Hadith: A poet of Banī Tamīm said, \"My praise is an adornment, and my blame is a disgrace.\" He (the Prophet) said: \"You have lied—that belongs to God.\" Ahmad narrated it from the hadith of al-Aqra' ibn Ḥābis—who was the speaker of that verse, excluding the phrase \"You have lied\"—and its narrators are trustworthy, except that I do not know of Abū Salamah ibn 'Abd al-Raḥmān having heard [directly] from al-Aqra'. Al-Tirmidhī narrated it from the hadith of al-Barā' and deemed it sound (ḥasan), with the wording: \"A man said, 'Indeed, my praise...'\"]", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 827", "section_title_en": "The Revival of the Religious Sciences — Section 827: The Second Station: Repelling the Accidental Promptings of Ostentation During Worship", "section_index": 827, "anchors": "- Root: كذب (kadhaba)\n  * Lisan / Ayn: Core meaning: falsehood, lying, saying what is contrary to reality; also used for \"to declare someone a liar.\"\n  * Al-Raghib (Mufradat): In theological context, kadhb is the antithesis of sidq (truthfulness); it is a moral and epistemic vice, often linked to hypocrisy (nifāq) and false claims.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): to report what did not occur. Metaphorical (majāz): attributing to God what is unworthy of Him, as in the Prophet's rebuke of the poet's self-praise.\n- Sibawayh Rule: Rule of Predicate Emphasis (Bāb al-Tawkīd) — The Prophet's reply \"كَذَبْتَ\" (You have lied) functions as an emphatic categorical refutation, structured as a nominal sentence with implied subject, establishing a permanent verdict rather than a transient rebuke.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Status and Ostentation'", "badge": "Insight"}], "116": [{"arabic": "يصنعون فبين أنهم أثموا بترك النهي وقال تعالى فلولا كان من القرون من قبلكم أولوا بقية ينهون عن الفساد في الأرض الآية فبين أنه أهلك جميعهم إلا قليلا منهم كانوا ينهون عن الفساد وقال تعالى يا أيها الذين آمنوا كونوا قوامين بالقسط شهداء لله ولو على أنفسكم أو الوالدين والأقربين وذلك هو الأمر بالمعروف للوالدين والأقربين وقال تعالى لا خير في كثير من نجواهم إلا من أمر بصدقة أو معروف أو إصلاح بين الناس ومن يفعل ذلك ابتغاء مرضاة الله فسوف نؤتيه أجرا عظيما وقال تعالى وإن طائفتان من المؤمنين اقتتلوا فأصلحوا بينهما الآية والإصلاح نهي عن البغي وإعادة إلى الطاعة فإن لم يفعل فقد", "english": "Know that the verses indicating the obligation of commanding right and forbidding wrong are numerous. Among them is His saying, may He be exalted: {«Let there arise from among you a nation inviting to good, commanding right and forbidding wrong — and those are the successful»} (Āl ʿImrān 3:104). In this verse is the declaration of obligation, for His saying, may He be exalted, \"Let there be\" (wal-takun) is a command, and the apparent meaning of a command is obligation. In it also is the declaration that success (falāḥ) is contingent upon it, for He restricted it and said: {«And those are the successful»}. In it also is the declaration that it is a collective obligation (farḍ kifāyah), not an individual obligation (farḍ ʿayn), and that when a group undertakes it, the obligation falls from the rest — for He did not say, \"Let all of you be commanders of right,\" but rather said: {«Let there arise from among you a nation»}. Thus, whenever one person or a group undertakes it, the burden falls from the others, and success is particularized to those who undertake it and directly perform it. But if all of creation were to hold back from it, the burden would encompass all those capable of it without exception.", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 521", "section_title_en": "Section 521", "section_index": 521, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Enjoining Good and Forbidding Evil'", "badge": "Insight"}], "119": [{"arabic": "مني لأملأن جهنم من الجنة والناس أجمعين وقال تعالى وتمت كلمة ربك لأملأن جهنم الآية فكيف لا يخاف ما حق من القول في الأزل ولا يطمع في تداركه ولو كان الأمر آنفا لكانت الأطماع تمتد إلى حيلة فيه ولكن ليس إلا التسليم فيه واستقراء خفي السابقة من جلي الأسباب الظاهرة على القلب والجوارح فمن يسرت له أسباب الشر وحيل بينه وبين أسباب الخير وأحكمت علاقته من الدنيا فكأنه كشف له على التحقيق سر السابقة التي سبقت له بالشقاوة إذ كل ميسر لما خلق له وإن كانت الخيرات كلها ميسرة والقلب بالكلية عن الدنيا منقطعا وبظاهره وباطنه على الله مقبلا كان", "english": "Just as Abraham (peace be upon him), when he was placed in the catapult, said: \"God is sufficient for me\" {حسبي الله} — and this was among the greatest supplications — he was tested and was confronted by Gabriel in mid-air, who said to him: \"Do you have any need?\" He replied: \"As for you, no.\" And that was the fulfillment of the very reality of his words: \"God is sufficient for me.\" So God Most High informed us about him, saying: \"And Abraham who fulfilled\" {وإبراهيم الذي وفى} — that is, fulfilled the requirement of his saying \"God is sufficient for me.\" And in like manner, He informed us about Moses (peace be upon him), where he said: \"Indeed, we fear that he may assault us or that he may transgress\" {إننا نخاف أن يفرط علينا أو أن يطغى}. He said: \"Fear not; indeed, I am with you both; I hear and I see\" {لا تخافا إنني معكما أسمع وأرى}. Yet despite this, when the sorcerers cast their sorcery, Moses conceived within himself a fear — because he did not feel secure from the deception (makar) of God, and the matter became obscure to him — until security was renewed for him, and it was said to him: \"Fear not; indeed, you are the most exalted\" {لا تخف إنك أنت الأعلى}. And when the strength of the Muslims weakened on the Day of Badr, he (peace be upon him) said: \"O God, if You destroy this band, there will remain no one on the face of the earth who worships You\" — a hadith reported on the Day of Badr: \"O God, if You destroy this band, there will remain no one on the face of the earth who worships You,\" transmitted by al-Bukhari from the hadith of Ibn Abbas with the wording: \"O God, if You will, You will not be worshipped after this day\" — to the end of the hadith. So Abu Bakr (may God be pleased with him) said: \"Leave off your importuning of your Lord, for He will surely fulfill what He has promised you.\" Thus, the station of al-Siddiq (may God be pleased with him) was the station of trust in God's promise, while the station of the Messenger of God (peace be upon him) was the station of fear of God's deception (makar) — and this latter is more complete, for it issues only from the perfection of knowledge of God's secrets, the hidden aspects of His acts, and the meanings of His attributes, some of whose manifestations are expressed as \"deception\" (makar). And no human being can stand upon the ultimate reality (kunnah) of God's attributes. Whoever knows the true nature of knowledge — that his knowledge falls short of encompassing the ultimate reality of things — his fear inevitably magnifies. For this reason, the Messiah (peace be upon him), when it was said to him: \"Did you say to the people: 'Take me and my mother as two gods besides God?'\" replied: \"Glory be to You! It was not mine to say what I had no right to say. If I had said it, You would have known it. You know what is in my self, and I do not know what is in Your Self\" {سبحانك ما يكون لي أن أقول ما ليس لي بحق إن كنت قلته فقد علمته تعلم ما في نفسي ولا أعلم ما في نفسك}. And he said: \"If You punish them, indeed they are Your servants; and if You forgive them...\" {إن تعذبهم فإنهم عبادك وإن تغفر لهم} — to the end of the verse. So he delegated the matter entirely to the divine will (mashī'ah) and removed himself completely from the equation, knowing that he had no say in the affair whatsoever, and that all matters are linked to the divine will in a linkage that exceeds the bounds of rational categories and habitual patterns — such that no judgment can be passed upon them by analogy, nor by conjecture, nor by reckoning (ḥisbān), let alone by verification and certainty. And this is precisely what has rent the hearts of the knowers (ʿārifīn) asunder — for the supreme calamity (al-ṭāmmah al-kubrā) is the linkage of your affair to the will of One who does not care about you: if He destroys you, He has destroyed countless others like you, and He has never ceased in this world to torment them with various kinds of pains and diseases, and to sicken their hearts thereby with disbelief and hypocrisy, and then to perpetuate the punishment upon them for all eternity. Then He informs us about this, saying: \"And had We willed, We would have given every soul its guidance, but the word from Me has taken effect: I will surely fill Hell with jinn and people all together\" {ولو شئنا لآتينا كل نفس هداها ولكن حق القول مني لأملأن جهنم من الجنة والناس أجمعين}. And He Most High said: \"And the word of your Lord has been fulfilled: I will surely fill Hell...\" {وتمت كلمة ربك لأملأن جهنم}. So how should one not fear what has been decreed as a word from eternity (al-azal), and not hope for its reversal? Had the matter been recent, then hopes might extend toward some stratagem regarding it — but there is nothing except submission to it, and the discernment of the hidden precedent (al-sābiqah) from the manifest outward causes upon the heart and the bodily members. For whoever is facilitated toward the causes of evil, and is barred from the causes of good, and whose attachment to this world is firmly secured — it is as if the secret of the prior decree that destined him to wretchedness has been unveiled to him with certainty, since \"everyone is facilitated toward that for which he was created\" {كل ميسر لما خلق له}. And even if all good things were facilitated, and the heart were entirely severed from this world, with its outward and inward aspects turned wholly toward God, this would necessitate a lightening of fear — were continuity in that state to be trusted. But the peril of the final end (khātimah) and the difficulty of steadfastness only fan the flames of fear into greater blaze and prevent them from being extinguished. For how can one feel secure from the change of state, when the believer's heart lies between two fingers of the fingers of the Merciful? And indeed, the heart is more prone to turning than a boiling pot. And the Turner of Hearts (Glory be to Him) has said: \"Indeed, the punishment of their Lord is not to be felt secure from\" {إن عذاب ربهم غير مأمون}. So the most ignorant of people is the one who feels secure from it, while He proclaims the warning against security. And were God to show kindness to His knowing servants by reviving their hearts with the spirit of hope (rajā'), their hearts would still burn from the fire of fear. Thus, the causes of hope are a mercy for God's elect, and the causes of heedlessness are a mercy upon the common folk of creation in one respect — for were the veil to be lifted, souls would perish and hearts would be torn asunder from the fear of the Turner of Hearts. One of the knowers said: \"If fifty were to intervene between me and the One I have known through tawḥīd...\"", "book_title": "Fear and Hope", "section_title_ar": "Section 1051", "section_title_en": "The Reality of Fear and the Station of Abraham, Moses, and the Messenger (Peace Be Upon Them) — On the Inescapable Terror of the Divine Decree", "section_index": 1051, "anchors": "- Root: حسب (ḥ-s-b)\n  * Lisan / Ayn: Core meaning of counting, reckoning, and sufficiency; \"ḥasbī Allāh\" signifies God as the sufficient reckoner.\n  * Al-Raghib (Mufradat): Theological nuance of ḥisāb as divine accounting; \"ḥasbī Allāh\" is a declaration of total reliance on God's sufficiency, transcending mere numerical count.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — reckoning by number; Metaphorical (majāz) — trusting in God's sufficiency as an act of spiritual accounting, where the servant counts God as enough against all else.\n- Root: خوف (kh-w-f)\n  * Lisan / Ayn: Core meaning of fear, dread, and apprehension of harm.\n  * Al-Raghib (Mufradat): Khawf is the expectation of a disliked outcome based on a probable or known sign; it opposes amn (security) and applies to both worldly and otherworldly matters.\n  * Al-Zamakhshari (Asas): Literal — fear of loss or harm; Metaphorical — a \"fearful path\" (ṭarīq khā'if) where danger inheres in the object, and \"takhawwuf\" as gradual diminishment, implying fear's erosive effect on the soul.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: Core meaning of self, soul, breath; the essence of a thing.\n  * Al-Raghib (Mufradat): Nafs as the self or essence (dhāt), as in \"ta'lamu mā fī nafsī\" (You know what is in my self), denoting the innermost reality distinct from the body.\n  * Al-Zamakhshari (Asas): Literal — the soul as animate essence; Metaphorical — \"nafs sā'ilah\" (flowing blood) as the life-principle, and the soul's hidden movements as the locus of divine knowledge.\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: Core meaning of turning, overturning, and transformation.\n  * Al-Raghib (Mufradat): Qalb is the turning of a thing from one state to another; the heart is so named for its constant fluctuation (taqallub) between states.\n  * Al-Zamakhshari (Asas): Literal — physical overturning; Metaphorical — the heart's perpetual oscillation, as in the prophetic hadith of the heart between two fingers of the Merciful, and the \"turning\" of affairs by divine decree.\n- Sibawayh Rule: Rule of Interposition and Apposition (al-ʿaṭf wa al-faṣl) — The periodic structure of \"fa-kayfa lā yakhāfu...\" (How then should one not fear...) employs a rhetorical question governed by an implied causal clause, where the apodosis is suspended across multiple subordinate clauses, requiring the translator to preserve the cumulative force of the argument without breaking the syntactic chain.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Fear and Hope'", "badge": "Ethics"}], "120": [{"arabic": "في حق النبي صلى الله عليه وسلم وأمته ولذلك قال تعالى {ما نثبت به فؤادك} فليقدر العبد أن الله ثبت فؤاده بما يقصه عليه من أحوال الأنبياء وصبرهم على الإيذاء وثباتهم في الدين لانتظار نصر الله تعالى وكيف لا يقدر هذا والقرآن ما أنزل على رسول الله صلى الله عليه وسلم لرسول الله خاصة بل هو شفاء وهدى ورحمة ونور للعالمين ولذلك أمر الله تعالى الكافة بشكر نعمة الكتاب فقال تعالى {واذكروا نعمة الله عليكم وما أنزل عليكم من الكتاب والحكمة يعظكم به} وقال عز وجل لقد أنزلنا إليكم كتابا فيه", "english": "I say: These meanings are buried treasures that are not unveiled except to the divinely aided ones. To this 'Ali — may God be pleased with him — alluded by his saying: \"The Messenger of God — may God's peace and blessings be upon him — did not confide to me anything that he concealed from the people, except that God — mighty and majestic — grants to a servant understanding (fahm) of His Book. So let one be eager in seeking that understanding.\" (1) And Ibn Mas'ud — may God be pleased with him — said: \"Whoever desires the knowledge of the first and the last, let him stir up the Qur'an.\" And the greatest of the sciences of the Qur'an lie beneath the names of God — mighty and majestic — and His attributes, for most of creation have grasped from them only matters befitting their understandings and have not stumbled upon their depths.", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 228", "section_title_en": "The Revival of the Religious Sciences — Section 228: On the Inner Meanings of the Qur'an and the Removal of Obstacles to Understanding", "section_index": 228, "anchors": "- Root: فهم (f-h-m)\n  * Lisan / Ayn: Comprehension, discernment, the faculty by which one grasps meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — a disposition by which one verifies the realities of what is perceived; distinct from mere hearing or transmission\n  * Al-Zamakhshari (Asas): Literal: swift apprehension; Metaphorical: the divine gift of insight into hidden meanings, as in the verse {ففهمناها سليمان}\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: Turning, overturning, transformation from one state to another\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart as that which is perpetually turned and overturned between states\n  * Al-Zamakhshari (Asas): Literal: physical turning; Metaphorical: the heart as the seat of understanding that is veiled or illuminated, rusted or polished\n- Root: سمع (s-m-')\n  * Lisan / Ayn: Hearing, the auditory faculty\n  * Al-Raghib (Mufradat): \"السمع: قوة في الأذن به يدرك الأصوات\" — extends metaphorically to comprehension and obedience; \"أو ألقى السمع وهو شهيد\" — one who casts his hearing while present\n  * Al-Zamakhshari (Asas): Literal: auditory perception; Metaphorical: attentive obedience and receptive understanding\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — governing the precise delimitation of predicates such as \"إنما يتذكر أولوا الألباب\" where restriction confines the action to its proper subject", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}], "123": [{"arabic": "قدم وذكر بلا ذكر إذ كان هو المبتدئ بالنعم والمتولى وإليه يرجع الأمر كله فهذا ظاهر علم الوجد وأقوال الصوفية من هذا الجنس في الوجد كثيرة وأما الحكماء فقال بعضهم في القلب فضيلة شريفة لم تقدر قوة النطق على إخراجها باللفظ فأخرجتها النفس بالألحان فلما ظهرت سرت وطربت إليها فاستمعوا من النفس وناجوها ودعوا مناجاة الظواهر وقال بعضهم نتائج السماع استنهاض العاجز من الرأي واستجلاب العازب من الأفكار وحدة الكال من الأفهام والآراء حتى يثوب ما عزب وينهض ما عجز ويصفو ما كدر ويمرح في كل رأي ونية فيصيب ولا يخطىء ويأتي ولا يبطىء وقال آ", "english": "As for the Sufis: Dhū al-Nūn al-Miṣrī, may Allah have mercy on him, said concerning audition: \"It is a divine arrival (wārid ḥaqq) that comes, agitating the hearts toward the Truth. Whoever listens to it with truth becomes realized (taḥaqqaqa); whoever listens to it with his ego becomes a heretic (tazandaqa).\" It is as though he expressed ecstasy as the agitation of hearts toward the Truth — and that is what one finds upon the arrival of the arrival of audition, since audition is named \"a divine arrival.\"", "book_title": "Audition and Ecstasy", "section_title_ar": "Section 507", "section_title_en": "The Science of Spiritual Wayfaring — On the Reality of Ecstasy (Wajd) in Audition (Samāʿ)", "section_index": 507, "anchors": "- Root: و ج د (w-j-d)\n  * Lisan / Ayn: To find, to attain, to experience; existence (wujūd) and ecstasy (wajd) derive from the same root — that which is \"found\" in the heart upon encounter with divine realities.\n  * Al-Raghib (Mufradat): Wajd denotes the soul's discovery of what was previously absent — a finding that transforms the finder. In theological usage, it signifies the heart's direct apprehension of spiritual realities through unveiling (mukāshafah), not through discursive reasoning.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): to find a lost thing. Metaphorical (majāz): the heart's finding of divine presence — an ecstatic state that overwhelms the seeker upon the arrival (wurūd) of spiritual influx.\n- Root: و ر د (w-r-d)\n  * Lisan / Ayn: To arrive at water — the quenching source. The \"arrival\" (wurūd) of that which refreshes the soul.\n  * Al-Raghib (Mufradat): \"Al-wurūd is originally: the intending of water, then used for other things.\" The arrival of audition (samāʿ) upon the heart is likened to the arrival of a traveler at a watering-place — it quenches, revives, and stirs.\n  * Al-Zamakhshari (Asas): Literal: arriving at water. Metaphorical: the arrival of divine intimations upon the heart — \"warda ʿalayhi amrun lam yuṭiqhu\" (an affair arrived upon him that he could not bear) — the overwhelming nature of ecstatic arrival.\n- Root: س م ع (s-m-ʿ)\n  * Lisan / Ayn: Hearing, audition; the ear's reception of sound.\n  * Al-Raghib (Mufradat): Hearing that penetrates beyond the ear to the heart — the difference between mere audibility and attentive listening (istiṣghāʾ).\n  * Al-Zamakhshari (Asas): Literal: auditory perception. Metaphorical: the soul's inner hearing of subtle divine addresses — \"hearing with an attentive ear and a witnessing heart.\"\n- Root: ق ل ب (q-l-b)\n  * Lisan / Ayn: The heart; that which turns about, fluctuates, and transforms.\n  * Al-Raghib (Mufradat): \"Qalb al-shayʾ: to turn it about and divert it from one face to another.\" The heart's being \"turned\" (inqilāb) toward the Truth — its agitation and upheaval upon the arrival of audition.\n  * Al-Zamakhshari (Asas): Literal: to turn a thing over. Metaphorical: \"qallaba al-amra ẓahrahu wa-baṭnahu\" (he turned the matter over, back and front) — the heart's being overturned, stirred, and convulsed by ecstatic arrival.\n- Root: ظ ه ر (ẓ-h-r)\n  * Lisan / Ayn: To appear, to be manifest; the back/surface (ẓahr) as opposed to the hidden (bāṭin).\n  * Al-Raghib (Mufradat): The outward (ẓāhir) and the inward (bāṭin) — the visible and the hidden dimensions of reality.\n  * Al-Zamakhshari (Asas): Literal: the back of a thing. Metaphorical: \"qalabtu al-amra ẓahrahu wa-baṭnahu\" — to examine a matter thoroughly, turning it over in all its aspects. In the Sufi lexicon: the outward form of audition (fitnah — trial) versus its inward meaning (ʿibrah — lesson).\n- Sibawayh Rule: Bāb al-faṣl bayna al-jār wa-al-majrūr (Prepositional Interposition) — The permissibility of interposing elements between the preposition and its object when the intervening clause is complete in itself, as in the construction \"fa-man aṣghā ilayhi bi-ḥaqqin taḥaqqaqa\" — the prepositional phrase \"ilayhi\" governs the hearing, while the qualifying clause \"bi-ḥaqqin\" specifies the mode of attentive listening.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Audition and Ecstasy'", "badge": "Insight"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 2031], [2, 2031, 3160], [3, 3160, 4822], [4, 4822, 6923], [5, 6923, 8036], [6, 8036, 9690], [7, 9690, 10317], [8, 