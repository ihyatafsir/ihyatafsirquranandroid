: "وَلَا تَرْكَنُوٓاْ إِلَي اَ۬لذِينَ ظَلَمُواْ فَتَمَسَّكُمُ اُ۬لنَّارُۖ وَمَا لَكُم مِّن دُونِ اِ۬للَّهِ مِنَ اَوْلِيَآءَۖ ثُمَّ لَا تُنصَرُونَۖ", "words": [{"id": 1, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَرْكَنُوٓاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "ظَلَمُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَتَمَسَّكُمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لنَّارُۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 9, "arabic": "لَكُم", "translit": "", "root": ""}, {"id": 10, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 11, "arabic": "دُونِ", "translit": "", "root": ""}, {"id": 12, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 13, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 14, "arabic": "اَوْلِيَآءَۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 16, "arabic": "لَا", "translit": "", "root": ""}, {"id": 17, "arabic": "تُنصَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 114, "text": "وَأَقِمِ اِ۬لصَّلَوٰةَ طَرَفَيِ اِ۬لنَّه۪ارِ وَزُلَفاࣰ مِّنَ اَ۬ليْلِۖ إِنَّ اَ۬لْحَسَنَٰتِ يُذْهِبْنَ اَ۬لسَّيِّـَٔاتِۖ ذَٰلِكَ ذِكْر۪يٰ لِلذَّٰكِرِينَۖ", "words": [{"id": 1, "arabic": "وَأَقِمِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لصَّلَوٰةَ", "translit": "", "root": ""}, {"id": 3, "arabic": "طَرَفَيِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لنَّه۪ارِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَزُلَفاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬ليْلِۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لْحَسَنَٰتِ", "translit": "", "root": ""}, {"id": 10, "arabic": "يُذْهِبْنَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لسَّيِّـَٔاتِۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 13, "arabic": "ذِكْر۪يٰ", "translit": "", "root": ""}, {"id": 14, "arabic": "لِلذَّٰكِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 115, "text": "وَاصْبِرْۖ فَإِنَّ اَ۬للَّهَ لَا يُضِيعُ أَجْرَ اَ۬لْمُحْسِنِينَۖ", "words": [{"id": 1, "arabic": "وَاصْبِرْۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَإِنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يُضِيعُ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَجْرَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْمُحْسِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 116, "text": "فَلَوْلَا كَانَ مِنَ اَ۬لْقُرُونِ مِن قَبْلِكُمُۥٓ أُوْلُواْ بَقِيَّةࣲ يَنْهَوْنَ عَنِ اِ۬لْفَسَادِ فِے اِ۬لَارْضِ إِلَّا قَلِيلاࣰ مِّمَّنَ اَنجَيْنَا مِنْهُمْۖ وَاتَّبَعَ اَ۬لذِينَ ظَلَمُواْ مَآ أُتْرِفُواْ فِيهِ وَكَانُواْ مُجْرِمِينَۖ", "words": [{"id": 1, "arabic": "فَلَوْلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْقُرُونِ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "قَبْلِكُمُۥٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "أُوْلُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "بَقِيَّةࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "يَنْهَوْنَ", "translit": "", "root": ""}, {"id": 10, "arabic": "عَنِ", "translit": "", "root": ""}, {"id": 11, "arabic": "اِ۬لْفَسَادِ", "translit": "", "root": ""}, {"id": 12, "arabic": "فِے", "translit": "", "root": ""}, {"id": 13, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 14, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 15, "arabic": "قَلِيلاࣰ", "translit": "", "root": ""}, {"id": 16, "arabic": "مِّمَّنَ", "translit": "", "root": ""}, {"id": 17, "arabic": "اَنجَيْنَا", "translit": "", "root": ""}, {"id": 18, "arabic": "مِنْهُمْۖ", "translit": "", "root": ""}, {"id": 19, "arabic": "وَاتَّبَعَ", "translit": "", "root": ""}, {"id": 20, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 21, "arabic": "ظَلَمُواْ", "translit": "", "root": ""}, {"id": 22, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 23, "arabic": "أُتْرِفُواْ", "translit": "", "root": ""}, {"id": 24, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 25, "arabic": "وَكَانُواْ", "translit": "", "root": ""}, {"id": 26, "arabic": "مُجْرِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 117, "text": "۞وَمَا كَانَ رَبُّكَ لِيُهْلِكَ اَ۬لْقُر۪يٰ بِظُلْمࣲ وَأَهْلُهَا مُصْلِحُونَۖ", "words": [{"id": 1, "arabic": "۞وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبُّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِيُهْلِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْقُر۪يٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِظُلْمࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَأَهْلُهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "مُصْلِحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 118, "text": "وَلَوْ شَآءَ رَبُّكَ لَجَعَلَ اَ۬لنَّاسَ أُمَّةࣰ وَٰحِدَةࣰۖ وَلَا يَزَالُونَ مُخْتَلِفِينَ", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 2, "arabic": "شَآءَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبُّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَجَعَلَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لنَّاسَ", "translit": "", "root": ""}, {"id": 6, "arabic": "أُمَّةࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَٰحِدَةࣰۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 9, "arabic": "يَزَالُونَ", "translit": "", "root": ""}, {"id": 10, "arabic": "مُخْتَلِفِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 119, "text": "إِلَّا مَن رَّحِمَ رَبُّكَۖ وَلِذَٰلِكَ خَلَقَهُمْۖ وَتَمَّتْ كَلِمَةُ رَبِّكَ لَأَمْلَأَنَّ جَهَنَّمَ مِنَ اَ۬لْجِنَّةِ وَالنَّاسِ أَجْمَعِينَۖ", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "", "root": ""}, {"id": 3, "arabic": "رَّحِمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبُّكَۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَلِذَٰلِكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "خَلَقَهُمْۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَتَمَّتْ", "translit": "", "root": ""}, {"id": 8, "arabic": "كَلِمَةُ", "translit": "", "root": ""}, {"id": 9, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَأَمْلَأَنَّ", "translit": "", "root": ""}, {"id": 11, "arabic": "جَهَنَّمَ", "translit": "", "root": ""}, {"id": 12, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 13, "arabic": "اَ۬لْجِنَّةِ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَالنَّاسِ", "translit": "", "root": ""}, {"id": 15, "arabic": "أَجْمَعِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 120, "text": "وَكُلّاࣰ نَّقُصُّ عَلَيْكَ مِنَ اَنۢبَآءِ اِ۬لرُّسُلِ مَا نُثَبِّتُ بِهِۦ فُؤَادَكَۖ وَجَآءَكَ فِے هَٰذِهِ اِ۬لْحَقُّ وَمَوْعِظَةࣱ وَذِكْر۪يٰ لِلْمُومِنِينَۖ", "words": [{"id": 1, "arabic": "وَكُلّاࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَّقُصُّ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَنۢبَآءِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لرُّسُلِ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَا", "translit": "", "root": ""}, {"id": 8, "arabic": "نُثَبِّتُ", "translit": "", "root": ""}, {"id": 9, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 10, "arabic": "فُؤَادَكَۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَجَآءَكَ", "translit": "", "root": ""}, {"id": 12, "arabic": "فِے", "translit": "", "root": ""}, {"id": 13, "arabic": "هَٰذِهِ", "translit": "", "root": ""}, {"id": 14, "arabic": "اِ۬لْحَقُّ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَمَوْعِظَةࣱ", "translit": "", "root": ""}, {"id": 16, "arabic": "وَذِكْر۪يٰ", "translit": "", "root": ""}, {"id": 17, "arabic": "لِلْمُومِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 121, "text": "وَقُل لِّلذِينَ لَا يُومِنُونَ اَ۪عْمَلُواْ عَلَيٰ مَكَانَتِكُمُۥٓ إِنَّا عَٰمِلُونَ", "words": [{"id": 1, "arabic": "وَقُل", "translit": "", "root": ""}, {"id": 2, "arabic": "لِّلذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يُومِنُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۪عْمَلُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَكَانَتِكُمُۥٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "عَٰمِلُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 122, "text": "وَانتَظِرُوٓاْ إِنَّا مُنتَظِرُونَۖ", "words": [{"id": 1, "arabic": "وَانتَظِرُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "مُنتَظِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 123, "text": "وَلِلهِ غَيْبُ اُ۬لسَّمَٰوَٰتِ وَالَارْضِۖ وَإِلَيْهِ يُرْجَعُ اُ۬لَامْرُ كُلُّهُۥۖ فَاعْبُدْهُ وَتَوَكَّلْ عَلَيْهِۖ وَمَا رَبُّكَ بِغَٰفِلٍ عَمَّا تَعْمَلُونَۖ", "words": [{"id": 1, "arabic": "وَلِلهِ", "translit": "", "root": ""}, {"id": 2, "