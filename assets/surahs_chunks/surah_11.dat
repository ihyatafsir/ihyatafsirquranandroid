{"surah": 11, "verses": [{"ayah": 1, "text": "الٓرۚ كِتَٰبٌ أُحْكِمَتْ ءَايَٰتُهُۥ ثُمَّ فُصِّلَتْ مِن لَّدُنْ حَكِيمٍ خَبِيرٍ ", "translation": "Alif, Lām, Rā.[1] [This is] a Book whose verses are perfected and then presented in detail from [one who is] Wise and Aware[2]", "words": [{"id": 1, "arabic": "الٓر", "translit": "rٓlā", "root": ""}, {"id": 2, "arabic": "كِتَٰبٌ", "translit": "ٌbَٰtِk", "root": "كتب"}, {"id": 3, "arabic": "أُحْكِمَتْ", "translit": "ْtَmِkْḥُaʾ", "root": "حكم"}, {"id": 4, "arabic": "ءَايَٰتُهُۥ", "translit": "ۥُhُtَٰyāَء", "root": "ايي"}, {"id": 5, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 6, "arabic": "فُصِّلَتْ", "translit": "ْtَlِّṣُf", "root": "فصل"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "لَّدُنْ", "translit": "ْnُdَّl", "root": "لدن"}, {"id": 9, "arabic": "حَكِيمٍ", "translit": "ٍmyِkَḥ", "root": "حكم"}, {"id": 10, "arabic": "خَبِيرٍ", "translit": "ٍryِbَhk", "root": "خبر"}], "hasIhya": false}, {"ayah": 2, "text": "أَلَّا تَعْبُدُوٓا۟ إِلَّا ٱللَّهَۚ إِنَّنِى لَكُم مِّنْهُ نَذِيرٌ وَبَشِيرٌ ", "translation": "[Through a messenger, saying], \"Do not worship except Allāh. Indeed, I am to you from Him a warner and a bringer of good tidings,\"", "words": [{"id": 1, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 2, "arabic": "تَعْبُدُوٓا۟", "translit": "۟āٓwُdُbْʿعَt", "root": "عبد"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "إِنَّنِى", "translit": "àِnَّnِiʾ", "root": ""}, {"id": 6, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 7, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 8, "arabic": "نَذِيرٌ", "translit": "ٌryِhdَn", "root": "نذر"}, {"id": 9, "arabic": "وَبَشِيرٌ", "translit": "ٌryِhsَbَw", "root": "بشر"}], "hasIhya": false}, {"ayah": 3, "text": "وَأَنِ ٱسْتَغْفِرُوا۟ رَبَّكُمْ ثُمَّ تُوبُوٓا۟ إِلَيْهِ يُمَتِّعْكُم مَّتَٰعًا حَسَنًا إِلَىٰٓ أَجَلٍ مُّسَمًّى وَيُؤْتِ كُلَّ ذِى فَضْلٍ فَضْلَهُۥۖ وَإِن تَوَلَّوْا۟ فَإِنِّىٓ أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ كَبِيرٍ ", "translation": "And [saying], \"Seek forgiveness of your Lord and repent to Him, [and] He will let you enjoy a good provision for a specified term and give every doer of favor his favor [i.e., reward]. But if you turn away, then indeed, I fear for you the punishment of a great Day.", "words": [{"id": 1, "arabic": "وَأَنِ", "translit": "ِnَaʾَw", "root": ""}, {"id": 2, "arabic": "ٱسْتَغْفِرُوا۟", "translit": "۟āwُrِfْغَtْsٱ", "root": "غفر"}, {"id": 3, "arabic": "رَبَّكُمْ", "translit": "ْmُkَّbَr", "root": "ربب"}, {"id": 4, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 5, "arabic": "تُوبُوٓا۟", "translit": "۟āٓwُbwُt", "root": "توب"}, {"id": 6, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 7, "arabic": "يُمَتِّعْكُم", "translit": "mُkْʿعِّtَmُy", "root": "متع"}, {"id": 8, "arabic": "مَّتَٰعًا", "translit": "āًʿعَٰtَّm", "root": "متع"}, {"id": 9, "arabic": "حَسَنًا", "translit": "āًnَsَḥ", "root": "حسن"}, {"id": 10, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 11, "arabic": "أَجَلٍ", "translit": "ٍlَjgَaʾ", "root": "اجل"}, {"id": 12, "arabic": "مُّسَمًّى", "translit": "àًّmَsُّm", "root": "سمو"}, {"id": 13, "arabic": "وَيُؤْتِ", "translit": "ِtْwʾُyَw", "root": "اتي"}, {"id": 14, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 15, "arabic": "ذِى", "translit": "àِhd", "root": ""}, {"id": 16, "arabic": "فَضْلٍ", "translit": "ٍlْḍَf", "root": "فضل"}, {"id": 17, "arabic": "فَضْلَهُۥ", "translit": "ۥُhَlْḍَf", "root": "فضل"}, {"id": 18, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 19, "arabic": "تَوَلَّوْا۟", "translit": "۟āْwَّlَwَt", "root": "ولي"}, {"id": 20, "arabic": "فَإِنِّىٓ", "translit": "ٓàِّnِiʾَf", "root": ""}, {"id": 21, "arabic": "أَخَافُ", "translit": "ُfāَhkَaʾ", "root": "خوف"}, {"id": 22, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 23, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 24, "arabic": "يَوْمٍ", "translit": "ٍmْwَy", "root": "يوم"}, {"id": 25, "arabic": "كَبِيرٍ", "translit": "ٍryِbَk", "root": "كبر"}], "hasIhya": false}, {"ayah": 4, "text": "إِلَى ٱللَّهِ مَرْجِعُكُمْۖ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "To Allāh is your return, and He is over all things competent.\"", "words": [{"id": 1, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "مَرْجِعُكُمْ", "translit": "ْmُkُʿعِjgْrَm", "root": "رجع"}, {"id": 4, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 7, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 8, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": true}, {"ayah": 5, "text": "أَلَآ إِنَّهُمْ يَثْنُونَ صُدُورَهُمْ لِيَسْتَخْفُوا۟ مِنْهُۚ أَلَا حِينَ يَسْتَغْشُونَ ثِيَابَهُمْ يَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَۚ إِنَّهُۥ عَلِيمٌۢ بِذَاتِ ٱلصُّدُورِ ", "translation": "Unquestionably, they [i.e., the disbelievers] turn away their breasts to hide themselves from him. Unquestionably, [even] when they cover themselves in their clothing, He [i.e., Allāh] knows what they conceal and what they declare. Indeed, He is Knowing of that within the breasts.", "words": [{"id": 1, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 2, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 3, "arabic": "يَثْنُونَ", "translit": "َnwُnْhtَy", "root": "ثني"}, {"id": 4, "arabic": "صُدُورَهُمْ", "translit": "ْmُhَrwُdُṣ", "root": "صدر"}, {"id": 5, "arabic": "لِيَسْتَخْفُوا۟", "translit": "۟āwُfْhkَtْsَyِl", "root": "خفي"}, {"id": 6, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 7, "arabic": "أَلَا", "translit": "āَlَaʾ", "root": ""}, {"id": 8, "arabic": "حِينَ", "translit": "َnyِḥ", "root": "حين"}, {"id": 9, "arabic": "يَسْتَغْشُونَ", "translit": "َnwُhsْغَtْsَy", "root": "غشو"}, {"id": 10, "arabic": "ثِيَابَهُمْ", "translit": "ْmُhَbāَyِht", "root": "ثوب"}, {"id": 11, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 12, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 13, "arabic": "يُسِرُّونَ", "translit": "َnwُّrِsُy", "root": "سرر"}, {"id": 14, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 15, "arabic": "يُعْلِنُونَ", "translit": "َnwُnِlْʿعُy", "root": "علن"}, {"id": 16, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 17, "arabic": "عَلِيمٌۢ", "translit": "ٌۢmyِlَʿع", "root": "علم"}, {"id": 18, "arabic": "بِذَاتِ", "translit": "ِtāَhdِb", "root": ""}, {"id": 19, "arabic": "ٱلصُّدُورِ", "translit": "ِrwُdُّṣlٱ", "root": "صدر"}], "hasIhya": false}, {"ayah": 6, "text": "وَمَا مِن دَآبَّةٍ فِى ٱلْأَرْضِ إِلَّا عَلَى ٱللَّهِ رِزْقُهَا وَيَعْلَمُ مُسْتَقَرَّهَا وَمُسْتَوْدَعَهَاۚ كُلٌّ فِى كِتَٰبٍ مُّبِينٍ ", "translation": "And there is no creature on earth but that upon Allāh is its provision, and He knows its place of dwelling and place of storage.[1] All is in a clear register.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "دَآبَّةٍ", "translit": "ٍẗَّbٓāَd", "root": "دبب"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "رِزْقُهَا", "translit": "āَhُqْzِr", "root": "رزق"}, {"id": 10, "arabic": "وَيَعْلَمُ", "translit": "ُmَlْʿعَyَw", "root": "علم"}, {"id": 11, "arabic": "مُسْتَقَرَّهَا", "translit": "āَhَّrَqَtْsُm", "root": "قرر"}, {"id": 12, "arabic": "وَمُسْتَوْدَعَهَا", "translit": "āَhَʿعَdْwَtْsُmَw", "root": "ودع"}, {"id": 13, "arabic": "كُلٌّ", "translit": "ٌّlُk", "root": "كلل"}, {"id": 14, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "كِتَٰبٍ", "translit": "ٍbَٰtِk", "root": "كتب"}, {"id": 16, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": true}, {"ayah": 7, "text": "وَهُوَ ٱلَّذِى خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ فِى سِتَّةِ أَيَّامٍ وَكَانَ عَرْشُهُۥ عَلَى ٱلْمَآءِ لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًاۗ وَلَئِن قُلْتَ إِنَّكُم مَّبْعُوثُونَ مِنۢ بَعْدِ ٱلْمَوْتِ لَيَقُولَنَّ ٱلَّذِينَ كَفَرُوٓا۟ إِنْ هَٰذَآ إِلَّا سِحْرٌ مُّبِينٌ ", "translation": "And it is He who created the heavens and the earth in six days - and His Throne had been upon water - that He might test you as to which of you is best in deed. But if you say, \"Indeed, you are resurrected after death,\" those who disbelieve will surely say, \"This is not but obvious magic.\"", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "سِتَّةِ", "translit": "ِẗَّtِs", "root": "ستت"}, {"id": 8, "arabic": "أَيَّامٍ", "translit": "ٍmāَّyَaʾ", "root": "يوم"}, {"id": 9, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 10, "arabic": "عَرْشُهُۥ", "translit": "ۥُhُhsْrَʿع", "root": "عرش"}, {"id": 11, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 12, "arabic": "ٱلْمَآءِ", "translit": "ِءٓāَmْlٱ", "root": "موه"}, {"id": 13, "arabic": "لِيَبْلُوَكُمْ", "translit": "ْmُkَwُlْbَyِl", "root": "بلو"}, {"id": 14, "arabic": "أَيُّكُمْ", "translit": "ْmُkُّyَaʾ", "root": "ايي"}, {"id": 15, "arabic": "أَحْسَنُ", "translit": "ُnَsْḥَaʾ", "root": "حسن"}, {"id": 16, "arabic": "عَمَلًا", "translit": "āًlَmَʿع", "root": "عمل"}, {"id": 17, "arabic": "وَلَئِن", "translit": "nِyʾَlَw", "root": ""}, {"id": 18, "arabic": "قُلْتَ", "translit": "َtْlُq", "root": "قول"}, {"id": 19, "arabic": "إِنَّكُم", "translit": "mُkَّnِiʾ", "root": ""}, {"id": 20, "arabic": "مَّبْعُوثُونَ", "translit": "َnwُhtwُʿعْbَّm", "root": "بعث"}, {"id": 21, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 22, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 23, "arabic": "ٱلْمَوْتِ", "translit": "ِtْwَmْlٱ", "root": "موت"}, {"id": 24, "arabic": "لَيَقُولَنَّ", "translit": "َّnَlwُqَyَl", "root": "قول"}, {"id": 25, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 26, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 27, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 28, "arabic": "هَٰذَآ", "translit": "ٓāَhdَٰh", "root": ""}, {"id": 29, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 30, "arabic": "سِحْرٌ", "translit": "ٌrْḥِs", "root": "سحر"}, {"id": 31, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": true}, {"ayah": 8, "text": "وَلَئِنْ أَخَّرْنَا عَنْهُمُ ٱلْعَذَابَ إِلَىٰٓ أُمَّةٍ مَّعْدُودَةٍ لَّيَقُولُنَّ مَا يَحْبِسُهُۥٓۗ أَلَا يَوْمَ يَأْتِيهِمْ لَيْسَ مَصْرُوفًا عَنْهُمْ وَحَاقَ بِهِم مَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ ", "translation": "And if We hold back from them the punishment for a limited time, they will surely say,[1] \"What detains it?\" Unquestionably, on the Day it comes to them, it will not be averted from them, and they will be enveloped by what they used to ridicule.", "words": [{"id": 1, "arabic": "وَلَئِنْ", "translit": "ْnِyʾَlَw", "root": ""}, {"id": 2, "arabic": "أَخَّرْنَا", "translit": "āَnْrَّhkَaʾ", "root": "اخر"}, {"id": 3, "arabic": "عَنْهُمُ", "translit": "ُmُhْnَʿع", "root": ""}, {"id": 4, "arabic": "ٱلْعَذَابَ", "translit": "َbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 5, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 6, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 7, "arabic": "مَّعْدُودَةٍ", "translit": "ٍẗَdwُdْʿعَّm", "root": "عدد"}, {"id": 8, "arabic": "لَّيَقُولُنَّ", "translit": "َّnُlwُqَyَّl", "root": "قول"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "يَحْبِسُهُۥٓ", "translit": "ٓۥُhُsِbْḥَy", "root": "حبس"}, {"id": 11, "arabic": "أَلَا", "translit": "āَlَaʾ", "root": ""}, {"id": 12, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 13, "arabic": "يَأْتِيهِمْ", "translit": "ْmِhyِtْaʾَy", "root": "اتي"}, {"id": 14, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 15, "arabic": "مَصْرُوفًا", "translit": "āًfwُrْṣَm", "root": "صرف"}, {"id": 16, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 17, "arabic": "وَحَاقَ", "translit": "َqāَḥَw", "root": "حيق"}, {"id": 18, "arabic": "بِهِم", "translit": "mِhِb", "root": ""}, {"id": 19, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 20, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 21, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 22, "arabic": "يَسْتَهْزِءُونَ", "translit": "َnwُءِzْhَtْsَy", "root": "هزا"}], "hasIhya": false}, {"ayah": 9, "text": "وَلَئِنْ أَذَقْنَا ٱلْإِنسَٰنَ مِنَّا رَحْمَةً ثُمَّ نَزَعْنَٰهَا مِنْهُ إِنَّهُۥ لَيَـُٔوسٌ كَفُورٌ ", "translation": "And if We give man a taste of mercy from Us and then We withdraw it from him, indeed, he is despairing and ungrateful.", "words": [{"id": 1, "arabic": "وَلَئِنْ", "translit": "ْnِyʾَlَw", "root": ""}, {"id": 2, "arabic": "أَذَقْنَا", "translit": "āَnْqَhdَaʾ", "root": "ذوق"}, {"id": 3, "arabic": "ٱلْإِنسَٰنَ", "translit": "َnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 4, "arabic": "مِنَّا", "translit": "āَّnِm", "root": ""}, {"id": 5, "arabic": "رَحْمَةً", "translit": "ًẗَmْḥَr", "root": "رحم"}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "نَزَعْنَٰهَا", "translit": "āَhَٰnْʿعَzَn", "root": "نزع"}, {"id": 8, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 9, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 10, "arabic": "لَيَـُٔوسٌ", "translit": "ٌswُٔـَyَl", "root": "ياس"}, {"id": 11, "arabic": "كَفُورٌ", "translit": "ٌrwُfَk", "root": "كفر"}], "hasIhya": false}, {"ayah": 10, "text": "وَلَئِنْ أَذَقْنَٰهُ نَعْمَآءَ بَعْدَ ضَرَّآءَ مَسَّتْهُ لَيَقُولَنَّ ذَهَبَ ٱلسَّيِّـَٔاتُ عَنِّىٓۚ إِنَّهُۥ لَفَرِحٌ فَخُورٌ ", "translation": "But if We give him a taste of favor after hardship has touched him, he will surely say, \"Bad times have left me.\" Indeed, he is exultant and boastful -", "words": [{"id": 1, "arabic": "وَلَئِنْ", "translit": "ْnِyʾَlَw", "root": ""}, {"id": 2, "arabic": "أَذَقْنَٰهُ", "translit": "ُhَٰnْqَhdَaʾ", "root": "ذوق"}, {"id": 3, "arabic": "نَعْمَآءَ", "translit": "َءٓāَmْʿعَn", "root": "نعم"}, {"id": 4, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 5, "arabic": "ضَرَّآءَ", "translit": "َءٓāَّrَḍ", "root": "ضرر"}, {"id": 6, "arabic": "مَسَّتْهُ", "translit": "ُhْtَّsَm", "root": "مسس"}, {"id": 7, "arabic": "لَيَقُولَنَّ", "translit": "َّnَlwُqَyَl", "root": "قول"}, {"id": 8, "arabic": "ذَهَبَ", "translit": "َbَhَhd", "root": "ذهب"}, {"id": 9, "arabic": "ٱلسَّيِّـَٔاتُ", "translit": "ُtāَٔـِّyَّslٱ", "root": "سوا"}, {"id": 10, "arabic": "عَنِّىٓ", "translit": "ٓàِّnَʿع", "root": ""}, {"id": 11, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 12, "arabic": "لَفَرِحٌ", "translit": "ٌḥِrَfَl", "root": "فرح"}, {"id": 13, "arabic": "فَخُورٌ", "translit": "ٌrwُhkَf", "root": "فخر"}], "hasIhya": false}, {"ayah": 11, "text": "إِلَّا ٱلَّذِينَ صَبَرُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ أُو۟لَٰٓئِكَ لَهُم مَّغْفِرَةٌ وَأَجْرٌ كَبِيرٌ ", "translation": "Except for those who are patient and do righteous deeds; those will have forgiveness and great reward.", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "صَبَرُوا۟", "translit": "۟āwُrَbَṣ", "root": "صبر"}, {"id": 4, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 5, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 6, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 7, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 8, "arabic": "مَّغْفِرَةٌ", "translit": "ٌẗَrِfْغَّm", "root": "غفر"}, {"id": 9, "arabic": "وَأَجْرٌ", "translit": "ٌrْjgَaʾَw", "root": "اجر"}, {"id": 10, "arabic": "كَبِيرٌ", "translit": "ٌryِbَk", "root": "كبر"}], "hasIhya": true}, {"ayah": 12, "text": "فَلَعَلَّكَ تَارِكٌۢ بَعْضَ مَا يُوحَىٰٓ إِلَيْكَ وَضَآئِقٌۢ بِهِۦ صَدْرُكَ أَن يَقُولُوا۟ لَوْلَآ أُنزِلَ عَلَيْهِ كَنزٌ أَوْ جَآءَ مَعَهُۥ مَلَكٌۚ إِنَّمَآ أَنتَ نَذِيرٌۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ وَكِيلٌ ", "translation": "Then would you possibly leave [out] some of what is revealed to you,[1] or is your breast constrained by it because they say, \"Why has there not been sent down to him a treasure or come with him an angel?\" But you are only a warner. And Allāh is Disposer of all things.", "words": [{"id": 1, "arabic": "فَلَعَلَّكَ", "translit": "َkَّlَʿعَlَf", "root": ""}, {"id": 2, "arabic": "تَارِكٌۢ", "translit": "ٌۢkِrāَt", "root": "ترك"}, {"id": 3, "arabic": "بَعْضَ", "translit": "َḍْʿعَb", "root": "بعض"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "يُوحَىٰٓ", "translit": "ٰٓàَḥwُy", "root": "وحي"}, {"id": 6, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 7, "arabic": "وَضَآئِقٌۢ", "translit": "ٌۢqِyʾٓāَḍَw", "root": "ضيق"}, {"id": 8, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 9, "arabic": "صَدْرُكَ", "translit": "َkُrْdَṣ", "root": "صدر"}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 11, "arabic": "يَقُولُوا۟", "translit": "۟āwُlwُqَy", "root": "قول"}, {"id": 12, "arabic": "لَوْلَآ", "translit": "ٓāَlْwَl", "root": ""}, {"id": 13, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 14, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 15, "arabic": "كَنزٌ", "translit": "ٌznَk", "root": "كنز"}, {"id": 16, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 17, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 18, "arabic": "مَعَهُۥ", "translit": "ۥُhَʿعَm", "root": ""}, {"id": 19, "arabic": "مَلَكٌ", "translit": "ٌkَlَm", "root": "ملك"}, {"id": 20, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 21, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 22, "arabic": "نَذِيرٌ", "translit": "ٌryِhdَn", "root": "نذر"}, {"id": 23, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 24, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 25, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 26, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 27, "arabic": "وَكِيلٌ", "translit": "ٌlyِkَw", "root": "وكل"}], "hasIhya": false}, {"ayah": 13, "text": "أَمْ يَقُولُونَ ٱفْتَرَىٰهُۖ قُلْ فَأْتُوا۟ بِعَشْرِ سُوَرٍ مِّثْلِهِۦ مُفْتَرَيَٰتٍ وَٱدْعُوا۟ مَنِ ٱسْتَطَعْتُم مِّن دُونِ ٱللَّهِ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "Or do they say, \"He invented it\"? Say, \"Then bring ten sūrahs like it that have been invented and call upon [for assistance] whomever you can besides Allāh, if you should be truthful.\"", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 3, "arabic": "ٱفْتَرَىٰهُ", "translit": "ُhٰàَrَtْfٱ", "root": "فري"}, {"id": 4, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 5, "arabic": "فَأْتُوا۟", "translit": "۟āwُtْaʾَf", "root": "اتي"}, {"id": 6, "arabic": "بِعَشْرِ", "translit": "ِrْhsَʿعِb", "root": "عشر"}, {"id": 7, "arabic": "سُوَرٍ", "translit": "ٍrَwُs", "root": "سور"}, {"id": 8, "arabic": "مِّثْلِهِۦ", "translit": "ۦِhِlْhtِّm", "root": "مثل"}, {"id": 9, "arabic": "مُفْتَرَيَٰتٍ", "translit": "ٍtَٰyَrَtْfُm", "root": "فري"}, {"id": 10, "arabic": "وَٱدْعُوا۟", "translit": "۟āwُʿعْdٱَw", "root": "دعو"}, {"id": 11, "arabic": "مَنِ", "translit": "ِnَm", "root": ""}, {"id": 12, "arabic": "ٱسْتَطَعْتُم", "translit": "mُtْʿعَṭَtْsٱ", "root": "طوع"}, {"id": 13, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 14, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 17, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 18, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": false}, {"ayah": 14, "text": "فَإِلَّمْ يَسْتَجِيبُوا۟ لَكُمْ فَٱعْلَمُوٓا۟ أَنَّمَآ أُنزِلَ بِعِلْمِ ٱللَّهِ وَأَن لَّآ إِلَٰهَ إِلَّا هُوَۖ فَهَلْ أَنتُم مُّسْلِمُونَ ", "translation": "And if they do not respond to you - then know that it [i.e., the Qur’ān] was revealed with the knowledge of Allāh[1] and that there is no deity except Him. Then,[2] would you [not] be Muslims?", "words": [{"id": 1, "arabic": "فَإِلَّمْ", "translit": "ْmَّlِiʾَf", "root": ""}, {"id": 2, "arabic": "يَسْتَجِيبُوا۟", "translit": "۟āwُbyِjgَtْsَy", "root": "جوب"}, {"id": 3, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 4, "arabic": "فَٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱَf", "root": "علم"}, {"id": 5, "arabic": "أَنَّمَآ", "translit": "ٓāَmَّnَaʾ", "root": ""}, {"id": 6, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 7, "arabic": "بِعِلْمِ", "translit": "ِmْlِʿعِb", "root": "علم"}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "وَأَن", "translit": "nَaʾَw", "root": ""}, {"id": 10, "arabic": "لَّآ", "translit": "ٓāَّl", "root": ""}, {"id": 11, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 12, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 13, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 14, "arabic": "فَهَلْ", "translit": "ْlَhَf", "root": ""}, {"id": 15, "arabic": "أَنتُم", "translit": "mُtnَaʾ", "root": ""}, {"id": 16, "arabic": "مُّسْلِمُونَ", "translit": "َnwُmِlْsُّm", "root": "سلم"}], "hasIhya": false}, {"ayah": 15, "text": "مَن كَانَ يُرِيدُ ٱلْحَيَوٰةَ ٱلدُّنْيَا وَزِينَتَهَا نُوَفِّ إِلَيْهِمْ أَعْمَٰلَهُمْ فِيهَا وَهُمْ فِيهَا لَا يُبْخَسُونَ ", "translation": "Whoever desires the life of this world and its adornments - We fully repay them for their deeds therein,[1] and they therein will not be deprived.", "words": [{"id": 1, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 4, "arabic": "ٱلْحَيَوٰةَ", "translit": "َẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 5, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 6, "arabic": "وَزِينَتَهَا", "translit": "āَhَtَnyِzَw", "root": "زين"}, {"id": 7, "arabic": "نُوَفِّ", "translit": "ِّfَwُn", "root": "وفي"}, {"id": 8, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 9, "arabic": "أَعْمَٰلَهُمْ", "translit": "ْmُhَlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 10, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 11, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 12, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 13, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 14, "arabic": "يُبْخَسُونَ", "translit": "َnwُsَhkْbُy", "root": "بخس"}], "hasIhya": true}, {"ayah": 16, "text": "أُو۟لَٰٓئِكَ ٱلَّذِينَ لَيْسَ لَهُمْ فِى ٱلْءَاخِرَةِ إِلَّا ٱلنَّارُۖ وَحَبِطَ مَا صَنَعُوا۟ فِيهَا وَبَٰطِلٌ مَّا كَانُوا۟ يَعْمَلُونَ ", "translation": "Those are the ones for whom there is not in the Hereafter but the Fire. And lost is what they did therein,[1] and worthless is what they used to do.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 4, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 7, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 8, "arabic": "ٱلنَّارُ", "translit": "ُrāَّnlٱ", "root": "نور"}, {"id": 9, "arabic": "وَحَبِطَ", "translit": "َṭِbَḥَw", "root": "حبط"}, {"id": 10, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 11, "arabic": "صَنَعُوا۟", "translit": "۟āwُʿعَnَṣ", "root": "صنع"}, {"id": 12, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 13, "arabic": "وَبَٰطِلٌ", "translit": "ٌlِṭَٰbَw", "root": "بطل"}, {"id": 14, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 15, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 16, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 17, "text": "أَفَمَن كَانَ عَلَىٰ بَيِّنَةٍ مِّن رَّبِّهِۦ وَيَتْلُوهُ شَاهِدٌ مِّنْهُ وَمِن قَبْلِهِۦ كِتَٰبُ مُوسَىٰٓ إِمَامًا وَرَحْمَةًۚ أُو۟لَٰٓئِكَ يُؤْمِنُونَ بِهِۦۚ وَمَن يَكْفُرْ بِهِۦ مِنَ ٱلْأَحْزَابِ فَٱلنَّارُ مَوْعِدُهُۥۚ فَلَا تَكُ فِى مِرْيَةٍ مِّنْهُۚ إِنَّهُ ٱلْحَقُّ مِن رَّبِّكَ وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يُؤْمِنُونَ ", "translation": "So is one who [stands] upon a clear evidence from his Lord [like the aforementioned]? And a witness[1] from Him follows it,[2] and before it was the Scripture of Moses to lead and as mercy. Those [believers in the former revelations] believe in it [i.e., the Qur’ān]. But whoever disbelieves in it from the [various] factions - the Fire is his promised destination. So be not in doubt about it. Indeed, it is the truth from your Lord, but most of the people do not believe.", "words": [{"id": 1, "arabic": "أَفَمَن", "translit": "nَmَfَaʾ", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "بَيِّنَةٍ", "translit": "ٍẗَnِّyَb", "root": "بين"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "رَّبِّهِۦ", "translit": "ۦِhِّbَّr", "root": "ربب"}, {"id": 7, "arabic": "وَيَتْلُوهُ", "translit": "ُhwُlْtَyَw", "root": "تلو"}, {"id": 8, "arabic": "شَاهِدٌ", "translit": "ٌdِhāَhs", "root": "شهد"}, {"id": 9, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 10, "arabic": "وَمِن", "translit": "nِmَw", "root": ""}, {"id": 11, "arabic": "قَبْلِهِۦ", "translit": "ۦِhِlْbَq", "root": "قبل"}, {"id": 12, "arabic": "كِتَٰبُ", "translit": "ُbَٰtِk", "root": "كتب"}, {"id": 13, "arabic": "مُوسَىٰٓ", "translit": "ٰٓàَswُm", "root": ""}, {"id": 14, "arabic": "إِمَامًا", "translit": "āًmāَmِiʾ", "root": "امم"}, {"id": 15, "arabic": "وَرَحْمَةً", "translit": "ًẗَmْḥَrَw", "root": "رحم"}, {"id": 16, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 17, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 18, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 19, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 20, "arabic": "يَكْفُرْ", "translit": "ْrُfْkَy", "root": "كفر"}, {"id": 21, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 22, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 23, "arabic": "ٱلْأَحْزَابِ", "translit": "ِbāَzْḥَaʾْlٱ", "root": "حزب"}, {"id": 24, "arabic": "فَٱلنَّارُ", "translit": "ُrāَّnlٱَf", "root": "نور"}, {"id": 25, "arabic": "مَوْعِدُهُۥ", "translit": "ۥُhُdِʿعْwَm", "root": "وعد"}, {"id": 26, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 27, "arabic": "تَكُ", "translit": "ُkَt", "root": "كون"}, {"id": 28, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 29, "arabic": "مِرْيَةٍ", "translit": "ٍẗَyْrِm", "root": "مري"}, {"id": 30, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 31, "arabic": "إِنَّهُ", "translit": "ُhَّnِiʾ", "root": ""}, {"id": 32, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 33, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 34, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 35, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 36, "arabic": "أَكْثَرَ", "translit": "َrَhtْkَaʾ", "root": "كثر"}, {"id": 37, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 38, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 39, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 18, "text": "وَمَنْ أَظْلَمُ مِمَّنِ ٱفْتَرَىٰ عَلَى ٱللَّهِ كَذِبًاۚ أُو۟لَٰٓئِكَ يُعْرَضُونَ عَلَىٰ رَبِّهِمْ وَيَقُولُ ٱلْأَشْهَٰدُ هَٰٓؤُلَآءِ ٱلَّذِينَ كَذَبُوا۟ عَلَىٰ رَبِّهِمْۚ أَلَا لَعْنَةُ ٱللَّهِ عَلَى ٱلظَّٰلِمِينَ ", "translation": "And who is more unjust than he who invents a lie about Allāh? Those will be presented before their Lord, and the witnesses will say, \"These are the ones who lied against their Lord.\" Unquestionably, the curse of Allāh is upon the wrongdoers", "words": [{"id": 1, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 2, "arabic": "أَظْلَمُ", "translit": "ُmَlْẓَaʾ", "root": "ظلم"}, {"id": 3, "arabic": "مِمَّنِ", "translit": "ِnَّmِm", "root": ""}, {"id": 4, "arabic": "ٱفْتَرَىٰ", "translit": "ٰàَrَtْfٱ", "root": "فري"}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "كَذِبًا", "translit": "āًbِhdَk", "root": "كذب"}, {"id": 8, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 9, "arabic": "يُعْرَضُونَ", "translit": "َnwُḍَrْʿعُy", "root": "عرض"}, {"id": 10, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 11, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 12, "arabic": "وَيَقُولُ", "translit": "ُlwُqَyَw", "root": "قول"}, {"id": 13, "arabic": "ٱلْأَشْهَٰدُ", "translit": "ُdَٰhْhsَaʾْlٱ", "root": "شهد"}, {"id": 14, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 15, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 16, "arabic": "كَذَبُوا۟", "translit": "۟āwُbَhdَk", "root": "كذب"}, {"id": 17, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 18, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 19, "arabic": "أَلَا", "translit": "āَlَaʾ", "root": ""}, {"id": 20, "arabic": "لَعْنَةُ", "translit": "ُẗَnْʿعَl", "root": "لعن"}, {"id": 21, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 23, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": true}, {"ayah": 19, "text": "ٱلَّذِينَ يَصُدُّونَ عَن سَبِيلِ ٱللَّهِ وَيَبْغُونَهَا عِوَجًا وَهُم بِٱلْءَاخِرَةِ هُمْ كَٰفِرُونَ ", "translation": "Who averted [people] from the way of Allāh and sought to make it [seem] deviant while they, concerning the Hereafter, were disbelievers.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يَصُدُّونَ", "translit": "َnwُّdُṣَy", "root": "صدد"}, {"id": 3, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 4, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَيَبْغُونَهَا", "translit": "āَhَnwُغْbَyَw", "root": "بغي"}, {"id": 7, "arabic": "عِوَجًا", "translit": "āًjgَwِʿع", "root": "عوج"}, {"id": 8, "arabic": "وَهُم", "translit": "mُhَw", "root": ""}, {"id": 9, "arabic": "بِٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱِb", "root": "اخر"}, {"id": 10, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 11, "arabic": "كَٰفِرُونَ", "translit": "َnwُrِfَٰk", "root": "كفر"}], "hasIhya": false}, {"ayah": 20, "text": "أُو۟لَٰٓئِكَ لَمْ يَكُونُوا۟ مُعْجِزِينَ فِى ٱلْأَرْضِ وَمَا كَانَ لَهُم مِّن دُونِ ٱللَّهِ مِنْ أَوْلِيَآءَۘ يُضَٰعَفُ لَهُمُ ٱلْعَذَابُۚ مَا كَانُوا۟ يَسْتَطِيعُونَ ٱلسَّمْعَ وَمَا كَانُوا۟ يُبْصِرُونَ ", "translation": "Those were not causing failure [to Allāh] on earth, nor did they have besides Allāh any protectors. For them the punishment will be multiplied. They were not able to hear, nor did they see.[1]", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 3, "arabic": "يَكُونُوا۟", "translit": "۟āwُnwُkَy", "root": "كون"}, {"id": 4, "arabic": "مُعْجِزِينَ", "translit": "َnyِzِjgْʿعُm", "root": "عجز"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 7, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 8, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 9, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 10, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 11, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 14, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 15, "arabic": "يُضَٰعَفُ", "translit": "ُfَʿعَٰḍُy", "root": "ضعف"}, {"id": 16, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 17, "arabic": "ٱلْعَذَابُ", "translit": "ُbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 18, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 19, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 20, "arabic": "يَسْتَطِيعُونَ", "translit": "َnwُʿعyِṭَtْsَy", "root": "طوع"}, {"id": 21, "arabic": "ٱلسَّمْعَ", "translit": "َʿعْmَّslٱ", "root": "سمع"}, {"id": 22, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 23, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 24, "arabic": "يُبْصِرُونَ", "translit": "َnwُrِṣْbُy", "root": "بصر"}], "hasIhya": false}, {"ayah": 21, "text": "أُو۟لَٰٓئِكَ ٱلَّذِينَ خَسِرُوٓا۟ أَنفُسَهُمْ وَضَلَّ عَنْهُم مَّا كَانُوا۟ يَفْتَرُونَ ", "translation": "Those are the ones who will have lost themselves, and lost from them is what they used to invent.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "خَسِرُوٓا۟", "translit": "۟āٓwُrِsَhk", "root": "خسر"}, {"id": 4, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 5, "arabic": "وَضَلَّ", "translit": "َّlَḍَw", "root": "ضلل"}, {"id": 6, "arabic": "عَنْهُم", "translit": "mُhْnَʿع", "root": ""}, {"id": 7, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 8, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 9, "arabic": "يَفْتَرُونَ", "translit": "َnwُrَtْfَy", "root": "فري"}], "hasIhya": false}, {"ayah": 22, "text": "لَا جَرَمَ أَنَّهُمْ فِى ٱلْءَاخِرَةِ هُمُ ٱلْأَخْسَرُونَ ", "translation": "Assuredly, it is they in the Hereafter who will be the greatest losers.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "جَرَمَ", "translit": "َmَrَjg", "root": "جرم"}, {"id": 3, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 6, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 7, "arabic": "ٱلْأَخْسَرُونَ", "translit": "َnwُrَsْhkَaʾْlٱ", "root": "خسر"}], "hasIhya": false}, {"ayah": 23, "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَأَخْبَتُوٓا۟ إِلَىٰ رَبِّهِمْ أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْجَنَّةِۖ هُمْ فِيهَا خَٰلِدُونَ ", "translation": "Indeed, they who have believed and done righteous deeds and humbled themselves to their Lord - those are the companions of Paradise; they will abide eternally therein.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 5, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 6, "arabic": "وَأَخْبَتُوٓا۟", "translit": "۟āٓwُtَbْhkَaʾَw", "root": "خبت"}, {"id": 7, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 8, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 9, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 10, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 11, "arabic": "ٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱ", "root": "جنن"}, {"id": 12, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 13, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 14, "arabic": "خَٰلِدُونَ", "translit": "َnwُdِlَٰhk", "root": "خلد"}], "hasIhya": false}, {"ayah": 24, "text": "مَثَلُ ٱلْفَرِيقَيْنِ كَٱلْأَعْمَىٰ وَٱلْأَصَمِّ وَٱلْبَصِيرِ وَٱلسَّمِيعِۚ هَلْ يَسْتَوِيَانِ مَثَلًاۚ أَفَلَا تَذَكَّرُونَ ", "translation": "The example of the two parties is like the blind and deaf, and the seeing and hearing. Are they equal in comparison? Then, will you not remember?", "words": [{"id": 1, "arabic": "مَثَلُ", "translit": "ُlَhtَm", "root": "مثل"}, {"id": 2, "arabic": "ٱلْفَرِيقَيْنِ", "translit": "ِnْyَqyِrَfْlٱ", "root": "فرق"}, {"id": 3, "arabic": "كَٱلْأَعْمَىٰ", "translit": "ٰàَmْʿعَaʾْlٱَk", "root": "عمي"}, {"id": 4, "arabic": "وَٱلْأَصَمِّ", "translit": "ِّmَṣَaʾْlٱَw", "root": "صمم"}, {"id": 5, "arabic": "وَٱلْبَصِيرِ", "translit": "ِryِṣَbْlٱَw", "root": "بصر"}, {"id": 6, "arabic": "وَٱلسَّمِيعِ", "translit": "ِʿعyِmَّslٱَw", "root": "سمع"}, {"id": 7, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 8, "arabic": "يَسْتَوِيَانِ", "translit": "ِnāَyِwَtْsَy", "root": "سوي"}, {"id": 9, "arabic": "مَثَلًا", "translit": "āًlَhtَm", "root": "مثل"}, {"id": 10, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 11, "arabic": "تَذَكَّرُونَ", "translit": "َnwُrَّkَhdَt", "root": "ذكر"}], "hasIhya": false}, {"ayah": 25, "text": "وَلَقَدْ أَرْسَلْنَا نُوحًا إِلَىٰ قَوْمِهِۦٓ إِنِّى لَكُمْ نَذِيرٌ مُّبِينٌ ", "translation": "And We had certainly sent Noah to his people, [saying], \"Indeed, I am to you a clear warner", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "نُوحًا", "translit": "āًḥwُn", "root": ""}, {"id": 4, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 5, "arabic": "قَوْمِهِۦٓ", "translit": "ٓۦِhِmْwَq", "root": "قوم"}, {"id": 6, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 7, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 8, "arabic": "نَذِيرٌ", "translit": "ٌryِhdَn", "root": "نذر"}, {"id": 9, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 26, "text": "أَن لَّا تَعْبُدُوٓا۟ إِلَّا ٱللَّهَۖ إِنِّىٓ أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ أَلِيمٍ ", "translation": "That you not worship except Allāh. Indeed, I fear for you the punishment of a painful day.\"", "words": [{"id": 1, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 2, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 3, "arabic": "تَعْبُدُوٓا۟", "translit": "۟āٓwُdُbْʿعَt", "root": "عبد"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 7, "arabic": "أَخَافُ", "translit": "ُfāَhkَaʾ", "root": "خوف"}, {"id": 8, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 9, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 10, "arabic": "يَوْمٍ", "translit": "ٍmْwَy", "root": "يوم"}, {"id": 11, "arabic": "أَلِيمٍ", "translit": "ٍmyِlَaʾ", "root": "الم"}], "hasIhya": true}, {"ayah": 27, "text": "فَقَالَ ٱلْمَلَأُ ٱلَّذِينَ كَفَرُوا۟ مِن قَوْمِهِۦ مَا نَرَىٰكَ إِلَّا بَشَرًا مِّثْلَنَا وَمَا نَرَىٰكَ ٱتَّبَعَكَ إِلَّا ٱلَّذِينَ هُمْ أَرَاذِلُنَا بَادِىَ ٱلرَّأْىِ وَمَا نَرَىٰ لَكُمْ عَلَيْنَا مِن فَضْلٍۭ بَلْ نَظُنُّكُمْ كَٰذِبِينَ ", "translation": "So the eminent among those who disbelieved from his people said, \"We do not see you but as a man like ourselves, and we do not see you followed except by those who are the lowest of us [and] at first suggestion.[1] And we do not see in you over us any merit; rather, we think you are liars.\"", "words": [{"id": 1, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 2, "arabic": "ٱلْمَلَأُ", "translit": "ُaʾَlَmْlٱ", "root": "ملا"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "قَوْمِهِۦ", "translit": "ۦِhِmْwَq", "root": "قوم"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "نَرَىٰكَ", "translit": "َkٰàَrَn", "root": "راي"}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "بَشَرًا", "translit": "āًrَhsَb", "root": "بشر"}, {"id": 11, "arabic": "مِّثْلَنَا", "translit": "āَnَlْhtِّm", "root": "مثل"}, {"id": 12, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 13, "arabic": "نَرَىٰكَ", "translit": "َkٰàَrَn", "root": "راي"}, {"id": 14, "arabic": "ٱتَّبَعَكَ", "translit": "َkَʿعَbَّtٱ", "root": "تبع"}, {"id": 15, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 16, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 17, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 18, "arabic": "أَرَاذِلُنَا", "translit": "āَnُlِhdāَrَaʾ", "root": "رذل"}, {"id": 19, "arabic": "بَادِىَ", "translit": "َàِdāَb", "root": "بدو"}, {"id": 20, "arabic": "ٱلرَّأْىِ", "translit": "ِàْaʾَّrlٱ", "root": "راي"}, {"id": 21, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 22, "arabic": "نَرَىٰ", "translit": "ٰàَrَn", "root": "راي"}, {"id": 23, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 24, "arabic": "عَلَيْنَا", "translit": "āَnْyَlَʿع", "root": ""}, {"id": 25, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 26, "arabic": "فَضْلٍۭ", "translit": "ٍۭlْḍَf", "root": "فضل"}, {"id": 27, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 28, "arabic": "نَظُنُّكُمْ", "translit": "ْmُkُّnُẓَn", "root": "ظنن"}, {"id": 29, "arabic": "كَٰذِبِينَ", "translit": "َnyِbِhdَٰk", "root": "كذب"}], "hasIhya": false}, {"ayah": 28, "text": "قَالَ يَٰقَوْمِ أَرَءَيْتُمْ إِن كُنتُ عَلَىٰ بَيِّنَةٍ مِّن رَّبِّى وَءَاتَىٰنِى رَحْمَةً مِّنْ عِندِهِۦ فَعُمِّيَتْ عَلَيْكُمْ أَنُلْزِمُكُمُوهَا وَأَنتُمْ لَهَا كَٰرِهُونَ ", "translation": "He said, \"O my people, have you considered: if I should be upon clear evidence from my Lord while He has given me mercy from Himself but it has been made unapparent to you, should we force it upon you while you are averse to it?", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 3, "arabic": "أَرَءَيْتُمْ", "translit": "ْmُtْyَءَrَaʾ", "root": "راي"}, {"id": 4, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 5, "arabic": "كُنتُ", "translit": "ُtnُk", "root": "كون"}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "بَيِّنَةٍ", "translit": "ٍẗَnِّyَb", "root": "بين"}, {"id": 8, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 9, "arabic": "رَّبِّى", "translit": "àِّbَّr", "root": "ربب"}, {"id": 10, "arabic": "وَءَاتَىٰنِى", "translit": "àِnٰàَtāَءَw", "root": "اتي"}, {"id": 11, "arabic": "رَحْمَةً", "translit": "ًẗَmْḥَr", "root": "رحم"}, {"id": 12, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 13, "arabic": "عِندِهِۦ", "translit": "ۦِhِdnِʿع", "root": "عند"}, {"id": 14, "arabic": "فَعُمِّيَتْ", "translit": "ْtَyِّmُʿعَf", "root": "عمي"}, {"id": 15, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 16, "arabic": "أَنُلْزِمُكُمُوهَا", "translit": "āَhwُmُkُmِzْlُnَaʾ", "root": "لزم"}, {"id": 17, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 18, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 19, "arabic": "كَٰرِهُونَ", "translit": "َnwُhِrَٰk", "root": "كره"}], "hasIhya": false}, {"ayah": 29, "text": "وَيَٰقَوْمِ لَآ أَسْـَٔلُكُمْ عَلَيْهِ مَالًاۖ إِنْ أَجْرِىَ إِلَّا عَلَى ٱللَّهِۚ وَمَآ أَنَا۠ بِطَارِدِ ٱلَّذِينَ ءَامَنُوٓا۟ۚ إِنَّهُم مُّلَٰقُوا۟ رَبِّهِمْ وَلَٰكِنِّىٓ أَرَىٰكُمْ قَوْمًا تَجْهَلُونَ ", "translation": "And O my people, I ask not of you for it any wealth. My reward is not but from Allāh. And I am not one to drive away those who have believed. Indeed, they will meet their Lord, but I see that you are a people behaving ignorantly.", "words": [{"id": 1, "arabic": "وَيَٰقَوْمِ", "translit": "ِmْwَqَٰyَw", "root": "قوم"}, {"id": 2, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 3, "arabic": "أَسْـَٔلُكُمْ", "translit": "ْmُkُlَٔـْsَaʾ", "root": "سال"}, {"id": 4, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 5, "arabic": "مَالًا", "translit": "āًlāَm", "root": "مول"}, {"id": 6, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 7, "arabic": "أَجْرِىَ", "translit": "َàِrْjgَaʾ", "root": "اجر"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 12, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 13, "arabic": "بِطَارِدِ", "translit": "ِdِrāَṭِb", "root": "طرد"}, {"id": 14, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 15, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 16, "arabic": "إِنَّهُم", "translit": "mُhَّnِiʾ", "root": ""}, {"id": 17, "arabic": "مُّلَٰقُوا۟", "translit": "۟āwُqَٰlُّm", "root": "لقي"}, {"id": 18, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 19, "arabic": "وَلَٰكِنِّىٓ", "translit": "ٓàِّnِkَٰlَw", "root": ""}, {"id": 20, "arabic": "أَرَىٰكُمْ", "translit": "ْmُkٰàَrَaʾ", "root": "راي"}, {"id": 21, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 22, "arabic": "تَجْهَلُونَ", "translit": "َnwُlَhْjgَt", "root": "جهل"}], "hasIhya": true}, {"ayah": 30, "text": "وَيَٰقَوْمِ مَن يَنصُرُنِى مِنَ ٱللَّهِ إِن طَرَدتُّهُمْۚ أَفَلَا تَذَكَّرُونَ ", "translation": "And O my people, who would protect me from Allāh if I drove them away? Then will you not be reminded?", "words": [{"id": 1, "arabic": "وَيَٰقَوْمِ", "translit": "ِmْwَqَٰyَw", "root": "قوم"}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "يَنصُرُنِى", "translit": "àِnُrُṣnَy", "root": "نصر"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 7, "arabic": "طَرَدتُّهُمْ", "translit": "ْmُhُّtdَrَṭ", "root": "طرد"}, {"id": 8, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 9, "arabic": "تَذَكَّرُونَ", "translit": "َnwُrَّkَhdَt", "root": "ذكر"}], "hasIhya": false}, {"ayah": 31, "text": "وَلَآ أَقُولُ لَكُمْ عِندِى خَزَآئِنُ ٱللَّهِ وَلَآ أَعْلَمُ ٱلْغَيْبَ وَلَآ أَقُولُ إِنِّى مَلَكٌ وَلَآ أَقُولُ لِلَّذِينَ تَزْدَرِىٓ أَعْيُنُكُمْ لَن يُؤْتِيَهُمُ ٱللَّهُ خَيْرًاۖ ٱللَّهُ أَعْلَمُ بِمَا فِىٓ أَنفُسِهِمْۖ إِنِّىٓ إِذًا لَّمِنَ ٱلظَّٰلِمِينَ ", "translation": "And I do not tell you that I have the depositories [containing the provision] of Allāh or that I know the unseen, nor do I tell you that I am an angel, nor do I say of those upon whom your eyes look down that Allāh will never grant them any good. Allāh is most knowing of what is within their souls. Indeed, I would then be among the wrongdoers [i.e., the unjust].\"", "words": [{"id": 1, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 2, "arabic": "أَقُولُ", "translit": "ُlwُqَaʾ", "root": "قول"}, {"id": 3, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 4, "arabic": "عِندِى", "translit": "àِdnِʿع", "root": "عند"}, {"id": 5, "arabic": "خَزَآئِنُ", "translit": "ُnِyʾٓāَzَhk", "root": "خزن"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 8, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 9, "arabic": "ٱلْغَيْبَ", "translit": "َbْyَغْlٱ", "root": "غيب"}, {"id": 10, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 11, "arabic": "أَقُولُ", "translit": "ُlwُqَaʾ", "root": "قول"}, {"id": 12, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 13, "arabic": "مَلَكٌ", "translit": "ٌkَlَm", "root": "ملك"}, {"id": 14, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 15, "arabic": "أَقُولُ", "translit": "ُlwُqَaʾ", "root": "قول"}, {"id": 16, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 17, "arabic": "تَزْدَرِىٓ", "translit": "ٓàِrَdْzَt", "root": "زري"}, {"id": 18, "arabic": "أَعْيُنُكُمْ", "translit": "ْmُkُnُyْʿعَaʾ", "root": "عين"}, {"id": 19, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 20, "arabic": "يُؤْتِيَهُمُ", "translit": "ُmُhَyِtْwʾُy", "root": "اتي"}, {"id": 21, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 23, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 25, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 26, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 27, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 28, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 29, "arabic": "إِذًا", "translit": "āًhdِiʾ", "root": ""}, {"id": 30, "arabic": "لَّمِنَ", "translit": "َnِmَّl", "root": ""}, {"id": 31, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 32, "text": "قَالُوا۟ يَٰنُوحُ قَدْ جَٰدَلْتَنَا فَأَكْثَرْتَ جِدَٰلَنَا فَأْتِنَا بِمَا تَعِدُنَآ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ ", "translation": "They said, \"O Noah, you have disputed [i.e., opposed] us and been frequent in dispute of us. So bring us what you threaten us, if you should be of the truthful.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰنُوحُ", "translit": "ُḥwُnَٰy", "root": ""}, {"id": 3, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 4, "arabic": "جَٰدَلْتَنَا", "translit": "āَnَtْlَdَٰjg", "root": "جدل"}, {"id": 5, "arabic": "فَأَكْثَرْتَ", "translit": "َtْrَhtْkَaʾَf", "root": "كثر"}, {"id": 6, "arabic": "جِدَٰلَنَا", "translit": "āَnَlَٰdِjg", "root": "جدل"}, {"id": 7, "arabic": "فَأْتِنَا", "translit": "āَnِtْaʾَf", "root": "اتي"}, {"id": 8, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 9, "arabic": "تَعِدُنَآ", "translit": "ٓāَnُdِʿعَt", "root": "وعد"}, {"id": 10, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 11, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 12, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 13, "arabic": "ٱلصَّٰدِقِينَ", "translit": "َnyِqِdَّٰṣlٱ", "root": "صدق"}], "hasIhya": true}, {"ayah": 33, "text": "قَالَ إِنَّمَا يَأْتِيكُم بِهِ ٱللَّهُ إِن شَآءَ وَمَآ أَنتُم بِمُعْجِزِينَ ", "translation": "He said, \"Allāh will only bring it to you if He wills, and you will not cause [Him] failure.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 3, "arabic": "يَأْتِيكُم", "translit": "mُkyِtْaʾَy", "root": "اتي"}, {"id": 4, "arabic": "بِهِ", "translit": "ِhِb", "root": ""}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 7, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 8, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 9, "arabic": "أَنتُم", "translit": "mُtnَaʾ", "root": ""}, {"id": 10, "arabic": "بِمُعْجِزِينَ", "translit": "َnyِzِjgْʿعُmِb", "root": "عجز"}], "hasIhya": false}, {"ayah": 34, "text": "وَلَا يَنفَعُكُمْ نُصْحِىٓ إِنْ أَرَدتُّ أَنْ أَنصَحَ لَكُمْ إِن كَانَ ٱللَّهُ يُرِيدُ أَن يُغْوِيَكُمْۚ هُوَ رَبُّكُمْ وَإِلَيْهِ تُرْجَعُونَ ", "translation": "And my advice will not benefit you - although I wished to advise you - if Allāh should intend to put you in error. He is your Lord, and to Him you will be returned.\"", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "يَنفَعُكُمْ", "translit": "ْmُkُʿعَfnَy", "root": "نفع"}, {"id": 3, "arabic": "نُصْحِىٓ", "translit": "ٓàِḥْṣُn", "root": "نصح"}, {"id": 4, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 5, "arabic": "أَرَدتُّ", "translit": "ُّtdَrَaʾ", "root": "رود"}, {"id": 6, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 7, "arabic": "أَنصَحَ", "translit": "َḥَṣnَaʾ", "root": "نصح"}, {"id": 8, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 9, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 10, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 11, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 13, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 14, "arabic": "يُغْوِيَكُمْ", "translit": "ْmُkَyِwْغُy", "root": "غوي"}, {"id": 15, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 16, "arabic": "رَبُّكُمْ", "translit": "ْmُkُّbَr", "root": "ربب"}, {"id": 17, "arabic": "وَإِلَيْهِ", "translit": "ِhْyَlِiʾَw", "root": ""}, {"id": 18, "arabic": "تُرْجَعُونَ", "translit": "َnwُʿعَjgْrُt", "root": "رجع"}], "hasIhya": false}, {"ayah": 35, "text": "أَمْ يَقُولُونَ ٱفْتَرَىٰهُۖ قُلْ إِنِ ٱفْتَرَيْتُهُۥ فَعَلَىَّ إِجْرَامِى وَأَنَا۠ بَرِىٓءٌ مِّمَّا تُجْرِمُونَ ", "translation": "Or do they say [about Prophet Muḥammad (ﷺ)], \"He invented it\"? Say, \"If I have invented it, then upon me is [the consequence of] my crime; but I am innocent of what [crimes] you commit.\"", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 3, "arabic": "ٱفْتَرَىٰهُ", "translit": "ُhٰàَrَtْfٱ", "root": "فري"}, {"id": 4, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 5, "arabic": "إِنِ", "translit": "ِnِiʾ", "root": ""}, {"id": 6, "arabic": "ٱفْتَرَيْتُهُۥ", "translit": "ۥُhُtْyَrَtْfٱ", "root": "فري"}, {"id": 7, "arabic": "فَعَلَىَّ", "translit": "َّàَlَʿعَf", "root": ""}, {"id": 8, "arabic": "إِجْرَامِى", "translit": "àِmāَrْjgِiʾ", "root": "جرم"}, {"id": 9, "arabic": "وَأَنَا۠", "translit": "۠āَnَaʾَw", "root": ""}, {"id": 10, "arabic": "بَرِىٓءٌ", "translit": "ٌءٓàِrَb", "root": "برا"}, {"id": 11, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 12, "arabic": "تُجْرِمُونَ", "translit": "َnwُmِrْjgُt", "root": "جرم"}], "hasIhya": false}, {"ayah": 36, "text": "وَأُوحِىَ إِلَىٰ نُوحٍ أَنَّهُۥ لَن يُؤْمِنَ مِن قَوْمِكَ إِلَّا مَن قَدْ ءَامَنَ فَلَا تَبْتَئِسْ بِمَا كَانُوا۟ يَفْعَلُونَ ", "translation": "And it was revealed to Noah that, \"No one will believe from your people except those who have already believed, so do not be distressed by what they have been doing.", "words": [{"id": 1, "arabic": "وَأُوحِىَ", "translit": "َàِḥwُaʾَw", "root": "وحي"}, {"id": 2, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 3, "arabic": "نُوحٍ", "translit": "ٍḥwُn", "root": ""}, {"id": 4, "arabic": "أَنَّهُۥ", "translit": "ۥُhَّnَaʾ", "root": ""}, {"id": 5, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 6, "arabic": "يُؤْمِنَ", "translit": "َnِmْwʾُy", "root": "امن"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "قَوْمِكَ", "translit": "َkِmْwَq", "root": "قوم"}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 11, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 12, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 13, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 14, "arabic": "تَبْتَئِسْ", "translit": "ْsِyʾَtْbَt", "root": "باس"}, {"id": 15, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 16, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 17, "arabic": "يَفْعَلُونَ", "translit": "َnwُlَʿعْfَy", "root": "فعل"}], "hasIhya": false}, {"ayah": 37, "text": "وَٱصْنَعِ ٱلْفُلْكَ بِأَعْيُنِنَا وَوَحْيِنَا وَلَا تُخَٰطِبْنِى فِى ٱلَّذِينَ ظَلَمُوٓا۟ۚ إِنَّهُم مُّغْرَقُونَ ", "translation": "And construct the ship under Our observation and Our inspiration and do not address Me concerning those who have wronged; indeed, they are [to be] drowned.\"", "words": [{"id": 1, "arabic": "وَٱصْنَعِ", "translit": "ِʿعَnْṣٱَw", "root": "صنع"}, {"id": 2, "arabic": "ٱلْفُلْكَ", "translit": "َkْlُfْlٱ", "root": "فلك"}, {"id": 3, "arabic": "بِأَعْيُنِنَا", "translit": "āَnِnُyْʿعَaʾِb", "root": "عين"}, {"id": 4, "arabic": "وَوَحْيِنَا", "translit": "āَnِyْḥَwَw", "root": "وحي"}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "تُخَٰطِبْنِى", "translit": "àِnْbِṭَٰhkُt", "root": "خطب"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "ظَلَمُوٓا۟", "translit": "۟āٓwُmَlَẓ", "root": "ظلم"}, {"id": 10, "arabic": "إِنَّهُم", "translit": "mُhَّnِiʾ", "root": ""}, {"id": 11, "arabic": "مُّغْرَقُونَ", "translit": "َnwُqَrْغُّm", "root": "غرق"}], "hasIhya": false}, {"ayah": 38, "text": "وَيَصْنَعُ ٱلْفُلْكَ وَكُلَّمَا مَرَّ عَلَيْهِ مَلَأٌ مِّن قَوْمِهِۦ سَخِرُوا۟ مِنْهُۚ قَالَ إِن تَسْخَرُوا۟ مِنَّا فَإِنَّا نَسْخَرُ مِنكُمْ كَمَا تَسْخَرُونَ ", "translation": "And he constructed the ship, and whenever an assembly of the eminent of his people passed by him, they ridiculed him. He said, \"If you ridicule us, then we will ridicule you just as you ridicule.", "words": [{"id": 1, "arabic": "وَيَصْنَعُ", "translit": "ُʿعَnْṣَyَw", "root": "صنع"}, {"id": 2, "arabic": "ٱلْفُلْكَ", "translit": "َkْlُfْlٱ", "root": "فلك"}, {"id": 3, "arabic": "وَكُلَّمَا", "translit": "āَmَّlُkَw", "root": "كلل"}, {"id": 4, "arabic": "مَرَّ", "translit": "َّrَm", "root": "مرر"}, {"id": 5, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 6, "arabic": "مَلَأٌ", "translit": "ٌaʾَlَm", "root": "ملا"}, {"id": 7, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 8, "arabic": "قَوْمِهِۦ", "translit": "ۦِhِmْwَq", "root": "قوم"}, {"id": 9, "arabic": "سَخِرُوا۟", "translit": "۟āwُrِhkَs", "root": "سخر"}, {"id": 10, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 11, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 12, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 13, "arabic": "تَسْخَرُوا۟", "translit": "۟āwُrَhkْsَt", "root": "سخر"}, {"id": 14, "arabic": "مِنَّا", "translit": "āَّnِm", "root": ""}, {"id": 15, "arabic": "فَإِنَّا", "translit": "āَّnِiʾَf", "root": ""}, {"id": 16, "arabic": "نَسْخَرُ", "translit": "ُrَhkْsَn", "root": "سخر"}, {"id": 17, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 18, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 19, "arabic": "تَسْخَرُونَ", "translit": "َnwُrَhkْsَt", "root": "سخر"}], "hasIhya": true}, {"ayah": 39, "text": "فَسَوْفَ تَعْلَمُونَ مَن يَأْتِيهِ عَذَابٌ يُخْزِيهِ وَيَحِلُّ عَلَيْهِ عَذَابٌ مُّقِيمٌ ", "translation": "And you are going to know who will get a punishment that will disgrace him [on earth] and upon whom will descend an enduring punishment [in the Hereafter].\"", "words": [{"id": 1, "arabic": "فَسَوْفَ", "translit": "َfْwَsَf", "root": ""}, {"id": 2, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "يَأْتِيهِ", "translit": "ِhyِtْaʾَy", "root": "اتي"}, {"id": 5, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 6, "arabic": "يُخْزِيهِ", "translit": "ِhyِzْhkُy", "root": "خزي"}, {"id": 7, "arabic": "وَيَحِلُّ", "translit": "ُّlِḥَyَw", "root": "حلل"}, {"id": 8, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 10, "arabic": "مُّقِيمٌ", "translit": "ٌmyِqُّm", "root": "قوم"}], "hasIhya": false}, {"ayah": 40, "text": "حَتَّىٰٓ إِذَا جَآءَ أَمْرُنَا وَفَارَ ٱلتَّنُّورُ قُلْنَا ٱحْمِلْ فِيهَا مِن كُلٍّ زَوْجَيْنِ ٱثْنَيْنِ وَأَهْلَكَ إِلَّا مَن سَبَقَ عَلَيْهِ ٱلْقَوْلُ وَمَنْ ءَامَنَۚ وَمَآ ءَامَنَ مَعَهُۥٓ إِلَّا قَلِيلٌ ", "translation": "[So it was], until when Our command came and the oven overflowed,[1] We said, \"Load upon it [i.e., the ship] of each [creature] two mates and your family, except those about whom the word [i.e., decree] has preceded, and [include] whoever has believed.\" But none had believed with him, except a few.", "words": [{"id": 1, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 4, "arabic": "أَمْرُنَا", "translit": "āَnُrْmَaʾ", "root": "امر"}, {"id": 5, "arabic": "وَفَارَ", "translit": "َrāَfَw", "root": "فور"}, {"id": 6, "arabic": "ٱلتَّنُّورُ", "translit": "ُrwُّnَّtlٱ", "root": ""}, {"id": 7, "arabic": "قُلْنَا", "translit": "āَnْlُq", "root": "قول"}, {"id": 8, "arabic": "ٱحْمِلْ", "translit": "ْlِmْḥٱ", "root": "حمل"}, {"id": 9, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "كُلٍّ", "translit": "ٍّlُk", "root": "كلل"}, {"id": 12, "arabic": "زَوْجَيْنِ", "translit": "ِnْyَjgْwَz", "root": "زوج"}, {"id": 13, "arabic": "ٱثْنَيْنِ", "translit": "ِnْyَnْhtٱ", "root": "ثني"}, {"id": 14, "arabic": "وَأَهْلَكَ", "translit": "َkَlْhَaʾَw", "root": "اهل"}, {"id": 15, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 16, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 17, "arabic": "سَبَقَ", "translit": "َqَbَs", "root": "سبق"}, {"id": 18, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 19, "arabic": "ٱلْقَوْلُ", "translit": "ُlْwَqْlٱ", "root": "قول"}, {"id": 20, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 21, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 22, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 23, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 24, "arabic": "مَعَهُۥٓ", "translit": "ٓۥُhَʿعَm", "root": ""}, {"id": 25, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 26, "arabic": "قَلِيلٌ", "translit": "ٌlyِlَq", "root": "قلل"}], "hasIhya": true}, {"ayah": 41, "text": "وَقَالَ ٱرْكَبُوا۟ فِيهَا بِسْمِ ٱللَّهِ مَجْر۪ىٰهَا وَمُرْسَىٰهَآۚ إِنَّ رَبِّى لَغَفُورٌ رَّحِيمٌ ", "translation": "And [Noah] said, \"Embark therein; in the name of Allāh [are] its course and its anchorage. Indeed, my Lord is Forgiving and Merciful.\"", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱرْكَبُوا۟", "translit": "۟āwُbَkْrٱ", "root": "ركب"}, {"id": 3, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 4, "arabic": "بِسْمِ", "translit": "ِmْsِb", "root": "سمو"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "مَجْر۪ىٰهَا", "translit": "āَhٰà۪rْjgَm", "root": "جري"}, {"id": 7, "arabic": "وَمُرْسَىٰهَآ", "translit": "ٓāَhٰàَsْrُmَw", "root": "رسو"}, {"id": 8, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 9, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 10, "arabic": "لَغَفُورٌ", "translit": "ٌrwُfَغَl", "root": "غفر"}, {"id": 11, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 42, "text": "وَهِىَ تَجْرِى بِهِمْ فِى مَوْجٍ كَٱلْجِبَالِ وَنَادَىٰ نُوحٌ ٱبْنَهُۥ وَكَانَ فِى مَعْزِلٍ يَٰبُنَىَّ ٱرْكَب مَّعَنَا وَلَا تَكُن مَّعَ ٱلْكَٰفِرِينَ ", "translation": "And it sailed with them through waves like mountains, and Noah called to his son who was apart [from them], \"O my son, come aboard with us and be not with the disbelievers.\"", "words": [{"id": 1, "arabic": "وَهِىَ", "translit": "َàِhَw", "root": ""}, {"id": 2, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 3, "arabic": "بِهِمْ", "translit": "ْmِhِb", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "مَوْجٍ", "translit": "ٍjgْwَm", "root": "موج"}, {"id": 6, "arabic": "كَٱلْجِبَالِ", "translit": "ِlāَbِjgْlٱَk", "root": "جبل"}, {"id": 7, "arabic": "وَنَادَىٰ", "translit": "ٰàَdāَnَw", "root": "ندي"}, {"id": 8, "arabic": "نُوحٌ", "translit": "ٌḥwُn", "root": ""}, {"id": 9, "arabic": "ٱبْنَهُۥ", "translit": "ۥُhَnْbٱ", "root": "بني"}, {"id": 10, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "مَعْزِلٍ", "translit": "ٍlِzْʿعَm", "root": "عزل"}, {"id": 13, "arabic": "يَٰبُنَىَّ", "translit": "َّàَnُbَٰy", "root": "بني"}, {"id": 14, "arabic": "ٱرْكَب", "translit": "bَkْrٱ", "root": "ركب"}, {"id": 15, "arabic": "مَّعَنَا", "translit": "āَnَʿعَّm", "root": ""}, {"id": 16, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 17, "arabic": "تَكُن", "translit": "nُkَt", "root": "كون"}, {"id": 18, "arabic": "مَّعَ", "translit": "َʿعَّm", "root": ""}, {"id": 19, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": false}, {"ayah": 43, "text": "قَالَ سَـَٔاوِىٓ إِلَىٰ جَبَلٍ يَعْصِمُنِى مِنَ ٱلْمَآءِۚ قَالَ لَا عَاصِمَ ٱلْيَوْمَ مِنْ أَمْرِ ٱللَّهِ إِلَّا مَن رَّحِمَۚ وَحَالَ بَيْنَهُمَا ٱلْمَوْجُ فَكَانَ مِنَ ٱلْمُغْرَقِينَ ", "translation": "[But] he said, \"I will take refuge on a mountain to protect me from the water.\" [Noah] said, \"There is no protector today from the decree of Allāh, except for whom He gives mercy.\" And the waves came between them, and he was among the drowned.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "سَـَٔاوِىٓ", "translit": "ٓàِwāَٔـَs", "root": "اوي"}, {"id": 3, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 4, "arabic": "جَبَلٍ", "translit": "ٍlَbَjg", "root": "جبل"}, {"id": 5, "arabic": "يَعْصِمُنِى", "translit": "àِnُmِṣْʿعَy", "root": "عصم"}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱلْمَآءِ", "translit": "ِءٓāَmْlٱ", "root": "موه"}, {"id": 8, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "عَاصِمَ", "translit": "َmِṣāَʿع", "root": "عصم"}, {"id": 11, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 12, "arabic":