": 3, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَمْرِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "رَحْمَتُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬للَّهِ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَبَرَكَٰتُهُۥ", "translit": "", "root": ""}, {"id": 9, "arabic": "عَلَيْكُمُۥٓ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَهْلَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لْبَيْتِۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 13, "arabic": "حَمِيدࣱ", "translit": "", "root": ""}, {"id": 14, "arabic": "مَّجِيدࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 74, "text": "فَلَمَّا ذَهَبَ عَنِ اِبْرَٰهِيمَ اَ۬لرَّوْعُ وَجَآءَتْهُ اُ۬لْبُشْر۪يٰ يُجَٰدِلُنَا فِے قَوْمِ لُوطٍۖ", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "ذَهَبَ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَنِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِبْرَٰهِيمَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لرَّوْعُ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَجَآءَتْهُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْبُشْر۪يٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "يُجَٰدِلُنَا", "translit": "", "root": ""}, {"id": 9, "arabic": "فِے", "translit": "", "root": ""}, {"id": 10, "arabic": "قَوْمِ", "translit": "", "root": ""}, {"id": 11, "arabic": "لُوطٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 11, "ayah": 75, "text": "اِنَّ إِبْرَٰهِيمَ لَحَلِيمٌ اَوَّٰهࣱ مُّنِيبࣱۖ", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِبْرَٰهِيمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَحَلِيمٌ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَوَّٰهࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّنِيبࣱۖ", "tr