": [{"surah": 88, "ayah": 1, "text": "هَلَ اَت۪يٰكَ حَدِيثُ اُ۬لْغَٰشِيَةِۖ", "words": [{"id": 1, "arabic": "هَلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَت۪يٰكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "حَدِيثُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْغَٰشِيَةِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 88, "ayah": 2, "text": "وُجُوهࣱ يَوْمَئِذٍ خَٰشِعَةٌ", "words": [{"id": 1, "arabic": "وُجُوهࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَوْمَئِذٍ", "translit": "", "root": ""}, {"id": 3, "arabic": "خَٰشِعَةٌ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 88, "ayah": 3, "text": "عَامِلَةࣱ نَّاصِبَةࣱ‏", "words": [{"id": 1, "arabic": "عَامِلَةࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَّاصِبَةࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 88, "ayah": 4, "text": "تَصْلَيٰ نَاراً حَامِيَةࣰ‏", "words": [{"id": 1, "arabic": "تَصْلَيٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَاراً", "translit": "", "root": ""}, {"id": 3, "arabic": "حَامِيَةࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 88, "ayah": 5, "text": "تُسْق۪يٰ مِنْ عَيْنٍ اٰنِيَةࣲۖ", "words": [{"id": 1, "arabic": "تُسْق۪يٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَيْنٍ", "translit": "", "root": ""}, {"id": 4, "arabic": "اٰنِيَةࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 88, "ayah": 6, "text": "لَّيْسَ لَهُمْ طَعَامٌ اِلَّا مِن ضَرِيعࣲ‏", "words": [{"id": 1, "arabic": "لَّيْسَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "طَعَامٌ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "ضَرِيعࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 88, "ayah": 7, "text": "لَّا يُسْمِنُ وَ