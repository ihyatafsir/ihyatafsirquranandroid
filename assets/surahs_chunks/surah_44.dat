مَا لَٰعِبِينَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "بَيْنَهُمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "لَٰعِبِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 39, "text": "مَا خَلَقْنَٰهُمَآ إِلَّا بِالْحَقِّۖ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "مَا", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْنَٰهُمَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "بِالْحَقِّۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَلَٰكِنَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَكْثَرَهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "", "root": ""}, {"id": 8, "arabic": "يَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 40, "text": "إِنَّ يَوْمَ اَ۬لْفَصْلِ مِيقَٰتُهُمُۥٓ أَجْمَعِينَ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْفَصْلِ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِيقَٰتُهُمُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَجْمَعِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 41, "text": "يَوْمَ لَا يُغْنِے مَوْليً عَن مَّوْليࣰ شَئْاࣰ وَلَا هُمْ يُنصَرُونَ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "", "root": ""}, {"id": 3, "arabic": "يُغْنِے", "translit": "", "root": ""}, {"id": 4, "arabic": "مَوْليً", "translit": "", "root": ""}, {"id": 5, "arabic": "عَن", "translit": "", "root": ""}, {"id": 6, "ar