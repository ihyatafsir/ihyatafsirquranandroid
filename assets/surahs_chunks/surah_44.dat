, \"Our Lord, remove from us the torment; indeed, we are believers.\"","words":[{"id":1,"arabic":"رَّبَّنَا","translit":"āَnَّbَّr","root":"ربب"},{"id":2,"arabic":"ٱكْشِفْ","translit":"ْfِhsْkٱ","root":"كشف"},{"id":3,"arabic":"عَنَّا","translit":"āَّnَʿع","root":""},{"id":4,"arabic":"ٱلْعَذَابَ","translit":"َbāَhdَʿعْlٱ","root":"عذب"},{"id":5,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":6,"arabic":"مُؤْمِنُونَ","translit":"َnwُnِmْwʾُm","root":"امن"}],"hasIhya":false},{"ayah":13,"text":"أَنَّىٰ لَهُمُ ٱلذِّكْرَىٰ وَقَدْ جَآءَهُمْ رَسُولٌ مُّبِينٌ ","translation":"How will there be for them a reminder [at that time]? And there had come to them a clear Messenger.","words":[{"id":1,"arabic":"أَنَّىٰ","translit":"ٰàَّnَaʾ","root":""},{"id":2,"arabic":"لَهُمُ","translit":"ُmُhَl","root":""},{"id":3,"arabic":"ٱلذِّكْرَىٰ","translit":"ٰàَrْkِّhdlٱ","root":"ذكر"},{"id":4,"arabic":"وَقَدْ","translit":"ْdَqَw","root":""},{"id":5,"arabic":"جَآءَهُمْ","translit":"ْmُhَءٓāَjg","root":"جيا"},{"id":6,"arabic":"رَسُولٌ","translit":"ٌlwُsَr","root":"رسل"},{"id":7,"arabic":"مُّبِينٌ","translit":"ٌnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":14,"text":"ثُمَّ تَوَلَّوْا۟ عَنْهُ وَقَالُوا۟ مُعَلَّمٌ مَّجْنُونٌ ","translation":"Then they turned away from him and said, \"[He was] taught [and is] a madman.\"","words":[{"id":1,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":2,"arabic":"تَوَلَّوْا۟","translit":"۟āْwَّlَwَt","root":"ولي"},{"id":3,"arabic":"عَنْهُ","translit":"ُhْnَʿع","root":""},{"id":4,"arabic":"وَقَالُوا۟","translit":"۟āwُlāَqَw","root":"قول"},{"id":5,"arabic":"مُعَلَّمٌ","translit":"ٌmَّlَʿعُm","root":"علم"},{"id":6,"arabic":"مَّجْنُونٌ","translit":"ٌnwُnْjgَّm","root":"جنن"}],"hasIhya":false},{"ayah":15,"text":"إِنَّا كَاشِفُوا۟ ٱلْعَذَابِ قَلِيلًاۚ إِنَّكُمْ عَآئِدُونَ ","translation":"Indeed, We will remove the torment for a little. Indeed, you [disbelievers] will return [to disbelief].","words":[{"id":1,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":2,"arabic":"كَاشِفُوا۟","translit":"۟āwُfِhsāَk","root":"كشف"},{"id":3,"arabic":"ٱلْعَذَابِ","translit":"ِbāَhdَʿعْlٱ","root":"عذب"},{"id":4,"arabic":"قَلِيلًا","translit":"āًlyِlَq","root":"قلل"},{"id":5,"arabic":"إِنَّكُمْ","translit":"ْmُkَّnِiʾ","root":""},{"id":6,"arabic":"عَآئِدُونَ","translit":"َnwُdِyʾٓāَʿع","root":"عود"}],"hasIhya":false},{"ayah":16,"text":"يَوْمَ نَبْطِشُ ٱلْبَطْشَةَ ٱلْكُبْرَىٰٓ إِنَّا مُنتَقِمُونَ ","translation":"The Day We will strike with the greatest assault, indeed, We will take retribution.","words":[{"id":1,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":2,"arabic":"نَبْطِشُ","translit":"ُhsِṭْbَn","root":"بطش"},{"id":3,"arabic":"ٱلْبَطْشَةَ","translit":"َẗَhsْṭَbْlٱ","root":"بطش"},{"id":4,"arabic":"ٱلْكُبْرَىٰٓ","translit":"ٰٓàَrْbُkْlٱ","root":"كبر"},{"id":5,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":6,"arabic":"مُنتَقِمُونَ","translit":"َnwُmِqَtnُm","root":"نقم"}],"hasIhya":false},{"ayah":17,"text":"وَلَقَدْ فَتَنَّا قَبْلَهُمْ قَوْمَ فِرْعَوْنَ وَجَآءَهُمْ رَسُولٌ كَرِيمٌ ","translation":"And We had already tried before them the people of Pharaoh, and there came to them a noble messenger [i.e., Moses],","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"فَتَنَّا","translit":"āَّnَtَf","root":"فتن"},{"id":3,"arabic":"قَبْلَهُمْ","translit":"ْmُhَlْbَq","root":"قبل"},{"id":4,"arabic":"قَوْمَ","translit":"َmْwَq","root":"قوم"},{"id":5,"arabic":"فِرْعَوْنَ","translit":"َnْwَʿعْrِf","root":""},{"id":6,"arabic":"وَجَآءَهُمْ","translit":"ْmُhَءٓāَjgَw","root":"جيا"},{"id":7,"arabic":"رَسُولٌ","translit":"ٌlwُsَr","root":"رسل"},{"id":8,"arabic":"كَرِيمٌ","translit":"ٌmyِrَk","root":"كرم"}],"hasIhya":false},{"ayah":18,"text":"أَنْ أَدُّوٓا۟ إِلَىَّ عِبَادَ ٱللَّهِۖ إِنِّى لَكُمْ رَسُولٌ أَمِينٌ ","translation":"[Saying], \"Render to me the servants of Allāh.[1] Indeed, I am to you a trustworthy messenger,\"","words":[{"id":1,"arabic":"أَنْ","translit":"ْnَaʾ","root":""},{"id":2,"arabic":"أَدُّوٓا۟","translit":"۟āٓwُّdَaʾ","root":"ادي"},{"id":3,"arabic":"إِلَىَّ","translit":"َّàَlِiʾ","root":""},{"id":4,"arabic":"عِبَادَ","translit":"َdāَbِʿع","root":"عبد"},{"id":5,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":6,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":7,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":8,"arabic":"رَسُولٌ","translit":"ٌlwُsَr","root":"رسل"},{"id":9,"arabic":"أَمِينٌ","translit":"ٌnyِmَaʾ","root":"امن"}],"hasIhya":false},{"ayah":19,"text":"وَأَن لَّا تَعْلُوا۟ عَلَى ٱللَّهِۖ إِنِّىٓ ءَاتِيكُم بِسُلْطَٰنٍ مُّبِينٍ ","translation":"And [saying], \"Be not haughty with Allāh. Indeed, I have come to you with clear evidence.","words":[{"id":1,"arabic":"وَأَن","translit":"nَaʾَw","root":""},{"id":2,"arabic":"لَّا","translit":"āَّl","root":""},{"id":3,"arabic":"تَعْلُوا۟","translit":"۟āwُlْʿعَt","root":"علو"},{"id":4,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":5,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":6,"arabic":"إِنِّىٓ","translit":"ٓàِّnِiʾ","root":""},{"id":7,"arabic":"ءَاتِيكُم","translit":"mُkyِtāَء","root":"اتي"},{"id":8,"arabic":"بِسُلْطَٰنٍ","translit":"ٍnَٰṭْlُsِb","root":"سلط"},{"id":9,"arabic":"مُّبِينٍ","translit":"ٍnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":20,"text":"وَإِنِّى عُذْتُ بِرَبِّى وَرَبِّكُمْ أَن تَرْجُمُونِ ","translation":"And indeed, I have sought refuge in my Lord and your Lord, lest you stone me.[1]","words":[{"id":1,"arabic":"وَإِنِّى","translit":"àِّnِiʾَw","root":""},{"id":2,"arabic":"عُذْتُ","translit":"ُtْhdُʿع","root":"عوذ"},{"id":3,"arabic":"بِرَبِّى","translit":"àِّbَrِb","root":"ربب"},{"id":4,"arabic":"وَرَبِّكُمْ","translit":"ْmُkِّbَrَw","root":"ربب"},{"id":5,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":6,"arabic":"تَرْجُمُونِ","translit":"ِnwُmُjgْrَt","root":"رجم"}],"hasIhya":false},{"ayah":21,"text":"وَإِن لَّمْ تُؤْمِنُوا۟ لِى فَٱعْتَزِلُونِ ","translation":"But if you do not believe me, then leave me alone.\"","words":[{"id":1,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":2,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":3,"arabic":"تُؤْمِنُوا۟","translit":"۟āwُnِmْwʾُt","root":"امن"},{"id":4,"arabic":"لِى","translit":"àِl","root":""},{"id":5,"arabic":"فَٱعْتَزِلُونِ","translit":"ِnwُlِzَtْʿعٱَf","root":"عزل"}],"hasIhya":true},{"ayah":22,"text":"فَدَعَا رَبَّهُۥٓ أَنَّ هَٰٓؤُلَآءِ قَوْمٌ مُّجْرِمُونَ ","translation":"And [finally] he called to his Lord that these were a criminal people.","words":[{"id":1,"arabic":"فَدَعَا","translit":"āَʿعَdَf","root":"دعو"},{"id":2,"arabic":"رَبَّهُۥٓ","translit":"ٓۥُhَّbَr","root":"ربب"},{"id":3,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":4,"arabic":"هَٰٓؤُلَآءِ","translit":"ِءٓāَlُwʾَٰٓh","root":""},{"id":5,"arabic":"قَوْمٌ","translit":"ٌmْwَq","root":"قوم"},{"id":6,"arabic":"مُّجْرِمُونَ","translit":"َnwُmِrْjgُّm","root":"جرم"}],"hasIhya":false},{"ayah":23,"text":"فَأَسْرِ بِعِبَادِى لَيْلًا إِنَّكُم مُّتَّبَعُونَ ","translation":"[Allāh said], \"Then set out with My servants by night. Indeed, you are to be pursued.","words":[{"id":1,"arabic":"فَأَسْرِ","translit":"ِrْsَaʾَf","root":"سري"},{"id":2,"arabic":"بِعِبَادِى","translit":"àِdāَbِʿعِb","root":"عبد"},{"id":3,"arabic":"لَيْلًا","translit":"āًlْyَl","root":"ليل"},{"id":4,"arabic":"إِنَّكُم","translit":"mُkَّnِiʾ","root":""},{"id":5,"arabic":"مُّتَّبَعُونَ","translit":"َnwُʿعَbَّtُّm","root":"تبع"}],"hasIhya":false},{"ayah":24,"text":"وَٱتْرُكِ ٱلْبَحْرَ رَهْوًاۖ إِنَّهُمْ جُندٌ مُّغْرَقُونَ ","translation":"And leave the sea in stillness.[1] Indeed, they are an army to be drowned.\"","words":[{"id":1,"arabic":"وَٱتْرُكِ","translit":"ِkُrْtٱَw","root":"ترك"},{"id":2,"arabic":"ٱلْبَحْرَ","translit":"َrْḥَbْlٱ","root":"بحر"},{"id":3,"arabic":"رَهْوًا","translit":"āًwْhَr","root":"رهو"},{"id":4,"arabic":"إِنَّهُمْ","translit":"ْmُhَّnِiʾ","root":""},{"id":5,"arabic":"جُندٌ","translit":"ٌdnُjg","root":"جند"},{"id":6,"arabic":"مُّغْرَقُونَ","translit":"َnwُqَrْغُّm","root":"غرق"}],"hasIhya":false},{"ayah":25,"text":"كَمْ تَرَكُوا۟ مِن جَنَّٰتٍ وَعُيُونٍ ","translation":"How much they left behind of gardens and springs","words":[{"id":1,"arabic":"كَمْ","translit":"ْmَk","root":""},{"id":2,"arabic":"تَرَكُوا۟","translit":"۟āwُkَrَt","root":"ترك"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"جَنَّٰتٍ","translit":"ٍtَّٰnَjg","root":"جنن"},{"id":5,"arabic":"وَعُيُونٍ","translit":"ٍnwُyُʿعَw","root":"عين"}],"hasIhya":false},{"ayah":26,"text":"وَزُرُوعٍ وَمَقَامٍ كَرِيمٍ ","translation":"And crops and noble sites","words":[{"id":1,"arabic":"وَزُرُوعٍ","translit":"ٍʿعwُrُzَw","root":"زرع"},{"id":2,"arabic":"وَمَقَامٍ","translit":"ٍmāَqَmَw","root":"قوم"},{"id":3,"arabic":"كَرِيمٍ","translit":"ٍmyِrَk","root":"كرم"}],"hasIhya":false},{"ayah":27,"text":"وَنَعْمَةٍ كَانُوا۟ فِيهَا فَٰكِهِينَ ","translation":"And comfort wherein they were amused.","words":[{"id":1,"arabic":"وَنَعْمَةٍ","translit":"ٍẗَmْʿعَnَw","root":"نعم"},{"id":2,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":3,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":4,"arabic":"فَٰكِهِينَ","translit":"َnyِhِkَٰf","root":"فكه"}],"hasIhya":false},{"ayah":28,"text":"كَذَٰلِكَۖ وَأَوْرَثْنَٰهَا قَوْمًا ءَاخَرِينَ ","translation":"Thus. And We caused to inherit it another people.","words":[{"id":1,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":2,"arabic":"وَأَوْرَثْنَٰهَا","translit":"āَhَٰnْhtَrْwَaʾَw","root":"ورث"},{"id":3,"arabic":"قَوْمًا","translit":"āًmْwَq","root":"قوم"},{"id":4,"arabic":"ءَاخَرِينَ","translit":"َnyِrَhkāَء","root":"اخر"}],"hasIhya":false},{"ayah":29,"text":"فَمَا بَكَتْ عَلَيْهِمُ ٱلسَّمَآءُ وَٱلْأَرْضُ وَمَا كَانُوا۟ مُنظَرِينَ ","translation":"And the heaven and earth wept not for them, nor were they reprieved.","words":[{"id":1,"arabic":"فَمَا","translit":"āَmَf","root":""},{"id":2,"arabic":"بَكَتْ","translit":"ْtَkَb","root":"بكي"},{"id":3,"arabic":"عَلَيْهِمُ","transl