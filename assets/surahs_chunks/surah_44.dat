 [[1, 350, 1754], [2, 1754, 3464], [3, 3464, 4740], [4, 4740, 6271]], "28": [[1, 350, 1449], [2, 1449, 3850], [3, 3850, 5073], [4, 5073, 6689]], "29": [[1, 400, 1243], [2, 1243, 1946], [3, 1946, 3258], [4, 3258, 5410], [5, 5410, 6886], [6, 6886, 7846], [7, 7846, 9415], [8, 9415, 11008]], "30": [[1, 400, 1762], [2, 1762, 3646], [3, 3646, 5269], [4, 5269, 7525], [5, 7525, 8075], [6, 8075, 9780], [7, 9780, 11348]], "31": [[1, 400, 987], [2, 987, 2660], [3, 2660, 3995], [4, 3995, 5051], [5, 5051, 7076], [6, 7076, 8088], [7, 8088, 10407]], "32": [[1, 350, 1412], [2, 1412, 2972], [3, 2972, 4012], [4, 4012, 4735], [5, 4735, 5571], [6, 5571, 7316]], "33": [[1, 400, 2980], [2, 2980, 3879], [3, 3879, 5729], [4, 5729, 6407], [5, 6407, 7293], [6, 7293, 8987], [7, 8987, 10538]], "34": [[1, 350, 1469], [2, 1469, 4413], [3, 4413, 7081]], "35": [[1, 400, 907], [2, 907, 1460], [3, 1460, 2509], [4, 2509, 4145], [5, 4145, 5850], [6, 5850, 6795], [7, 6795, 7509], [8, 7509, 9284]], "36": [[1, 400, 2173], [2, 2173, 6259], [3, 6259, 6878], [4, 6878, 8004], [5, 8004, 9911]], "37": [[1, 400, 1316], [2, 1316, 2380], [3, 2380, 3030], [4, 3030, 4123], [5, 4123, 5290], [6, 5290, 7403], [7, 7403, 7994], [8, 7994, 9575], [9, 9575, 11821], [10, 11821, 13461], [11, 13461, 15441], [12, 15441, 17434]], "38": [[1, 400, 1250], [2, 1250, 2535], [3, 2535, 4240], [4, 4240, 5546], [5, 5546, 6396], [6, 6396, 7847], [7, 7847, 9154]], "39": [[1, 400, 1058], [2, 1058, 3908], [3, 3908, 5060], [4, 5060, 6452], [5, 6452, 8110], [6, 8110, 9679], [7, 9679, 10337], [8, 10337, 12158]], "40": [[1, 350, 1277], [2, 1277, 2292], [3, 2292, 3460], [4, 3460, 5318], [5, 5318, 7133]], "41": [[1, 400, 1434], [2, 1434, 2106], [3, 2106, 3425], [4, 3425, 4718], [5, 4718, 5287], [6, 5287, 6955], [7, 6955, 8144], [8, 8144, 9204], [9, 9204, 9695], [10, 9695, 11583]], "42": [[1, 400, 1605], [2, 1605, 2135], [3, 2135, 3154], [4, 3154, 4200], [5, 4200, 5405], [6, 5405, 6040], [7, 6040, 7629], [8, 7629, 9389]], "43": [[1, 350, 1443], [2