}, {"id": 3, "arabic": "وَعُيُونࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 53, "text": "يَلْبَسُونَ مِن سُندُسࣲ وَإِسْتَبْرَقࣲ مُّتَقَٰبِلِينَۖ", "words": [{"id": 1, "arabic": "يَلْبَسُونَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِن", "translit": "", "root": ""}, {"id": 3, "arabic": "سُندُسࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَإِسْتَبْرَقࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّتَقَٰبِلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 54, "text": "كَذَٰلِكَۖ وَزَوَّجْنَٰهُم بِحُورٍ عِينࣲۖ", "words": [{"id": 1, "arabic": "كَذَٰلِكَۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَزَوَّجْنَٰهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "بِحُورٍ", "translit": "", "root": ""}, {"id": 4, "arabic": "عِينࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 55, "text": "يَدْعُونَ فِيهَا بِكُلِّ فَٰكِهَةٍ اٰمِنِينَۖ", "words": [{"id": 1, "arabic": "يَدْعُونَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "بِكُلِّ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَٰكِهَةٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "اٰمِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 56, "text": "لَا يَذُوقُونَ فِيهَا اَ۬لْمَوْتَۖ إِلَّا اَ۬لْمَوْتَةَ اَ۬لُاول۪يٰۖ وَوَق۪يٰهُمْ عَذَابَ اَ۬لْجَحِيمِ", "words": [{"id": 1, "arabic": "لَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَذُوقُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمَوْتَۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْمَوْتَةَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لُاول۪يٰۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَوَق۪يٰهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "عَذَابَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لْجَحِيمِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 57, "text": "فَضْلاࣰ مِّن رَّبِّكَۖ ذَٰلِكَ هُوَ اَ۬لْفَوْزُ اُ۬لْعَظِيمُۖ", "words": [{"id": 1, "arabic": "فَضْلاࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 3, "arabic": "رَّبِّكَۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْفَوْزُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْعَظِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 58, "text": "فَإِنَّمَا يَسَّرْنَٰهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَۖ", "words": [{"id": 1, "arabic": "فَإِنَّمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَسَّرْنَٰهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِلِسَانِكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَعَلَّهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَتَذَكَّرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 59, "text": "فَارْتَقِبِۖ اِنَّهُم مُّرْتَقِبُونَۖ", "words": [{"id": 1, "arabic": "فَارْتَقِبِۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِنَّهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مُّرْتَقِبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}]}