, 4731], [5, 4731, 5479], [6, 5479, 6660]], "44:14": [[1, 500, 993], [2, 993, 2406], [3, 2406, 2877], [4, 2877, 4731], [5, 4731, 5479], [6, 5479, 6660]], "15": [[1, 360, 1362], [2, 1362, 3170], [3, 3170, 4386], [4, 4386, 5750], [5, 5750, 6637], [6, 6637, 9110]], "44:15": [[1, 360, 1362], [2, 1362, 3170], [3, 3170, 4386], [4, 4386, 5750], [5, 5750, 6637], [6, 6637, 9110]], "16": [[1, 220, 1118], [2, 1118, 1971], [3, 1971, 3044], [4, 3044, 5172], [5, 5172, 6267], [6, 6267, 7810]], "44:16": [[1, 220, 1118], [2, 1118, 1971], [3, 1971, 3044], [4, 3044, 5172], [5, 5172, 6267], [6, 6267, 7810]], "17": [[1, 540, 1574], [2, 1574, 2783], [3, 2783, 3729], [4, 3729, 4395], [5, 4395, 5420], [6, 5420, 7909], [7, 7909, 8873], [8, 8873, 9820]], "44:17": [[1, 540, 1574], [2, 1574, 2783], [3, 2783, 3729], [4, 3729, 4395], [5, 4395, 5420], [6, 5420, 7909], [7, 7909, 8873], [8, 8873, 9820]], "18": [[1, 250, 651], [2, 651, 2993], [3, 2993, 3904], [4, 3904, 4989], [5, 4989, 5718], [6, 5718, 6629], [7, 6629, 7176], [8, 7176, 8179], [9, 8179, 9200]], "44:18": [[1, 250, 651], [2, 651, 2993], [3, 2993, 3904], [4, 3904, 4989], [5, 4989, 5718], [6, 5718, 6629], [7, 6629, 7176], [8, 7176, 8179], [9, 8179, 9200]], "19": [[1, 430, 1272], [2, 1272, 2086], [3, 2086, 3614], [4, 3614, 4319], [5, 4319, 5051], [6, 5051, 6991], [7, 6991, 8620], [8, 8620, 9782], [9, 9782, 10990]], "44:19": [[1, 430, 1272], [2, 1272, 2086], [3, 2086, 3614], [4, 3614, 4319], [5, 4319, 5051], [6, 5051, 6991], [7, 6991, 8620], [8, 8620, 9782], [9, 9782, 10990]], "20": [[1, 490, 1972], [2, 1972, 2643], [3, 2643, 3715], [4, 3715, 5147], [5, 5147, 5588], [6, 5588, 7070]], "44:20": [[1, 490, 1972], [2, 1972, 2643], [3, 2643, 3715], [4, 3715, 5147], [5, 5147, 5588], [6, 5588, 7070]], "21": [[1, 210, 805], [2, 805, 1161], [3, 1161, 2378], [4, 2378, 2715], [5, 2715, 3880]], "44:21": [[1, 210, 805], [2, 805, 1161], [3, 1161, 2378], [4, 2378, 2715], [5, 2715, 3880]], "22": [[1, 460, 1755], [2, 1755, 3235], [3, 3235, 3975], [4, 3975, 