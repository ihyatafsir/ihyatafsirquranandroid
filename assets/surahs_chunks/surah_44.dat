, "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لنَّاسَۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "عَذَابٌ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَلِيمࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 12, "text": "رَّبَّنَا اَ۪كْشِفْ عَنَّا اَ۬لْعَذَابَ إِنَّا مُومِنُونَۖ", "words": [{"id": 1, "arabic": "رَّبَّنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۪كْشِفْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْعَذَابَ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "مُومِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 13, "text": "أَنّ۪يٰ لَهُمُ اُ۬لذِّكْر۪يٰ وَقَدْ جَآءَهُمْ رَسُولࣱ مُّبِينࣱ‏", "words": [{"id": 1, "arabic": "أَنّ۪يٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لذِّكْر۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَقَدْ", "translit": "", "root": ""}, {"id": 5, "arabic": "جَآءَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "رَسُولࣱ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّبِينࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 14, "text": "ثُمَّ تَوَلَّوْاْ عَنْهُ وَقَالُواْ مُعَلَّمࣱ مَّجْنُونٌۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَوَلَّوْاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَنْهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَقَالُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُعَلَّمࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَّجْنُونٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 15, "text": "اِنَّا كَاشِفُواْ اُ۬لْعَذَابِ قَلِيلاًۖ اِنَّكُمْ عَآئِدُونَۖ", "words": [{"id": 1, "arabic": 