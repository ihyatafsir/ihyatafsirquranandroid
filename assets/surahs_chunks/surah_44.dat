{"surah":44,"verses":[{"ayah":1,"text":"حمٓ ","translation":"Ḥā, Meem.[1]","words":[{"id":1,"arabic":"حمٓ","translit":"ٓmḥ","root":""}],"hasIhya":false},{"ayah":2,"text":"وَٱلْكِتَٰبِ ٱلْمُبِينِ ","translation":"By the clear Book,","words":[{"id":1,"arabic":"وَٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱَw","root":"كتب"},{"id":2,"arabic":"ٱلْمُبِينِ","translit":"ِnyِbُmْlٱ","root":"بين"}],"hasIhya":false},{"ayah":3,"text":"إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةٍ مُّبَٰرَكَةٍۚ إِنَّا كُنَّا مُنذِرِينَ ","translation":"Indeed, We sent it down during a blessed night.[1] Indeed, We were to warn [mankind].","words":[{"id":1,"arabic":"إِنَّآ","translit":"ٓāَّnِiʾ","root":""},{"id":2,"arabic":"أَنزَلْنَٰهُ","translit":"ُhَٰnْlَznَaʾ","root":"نزل"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"لَيْلَةٍ","translit":"ٍẗَlْyَl","root":"ليل"},{"id":5,"arabic":"مُّبَٰرَكَةٍ","translit":"ٍẗَkَrَٰbُّm","root":"برك"},{"id":6,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":7,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":8,"arabic":"مُنذِرِينَ","translit":"َnyِrِhdnُm","root":"نذر"}],"hasIhya":true},{"ayah":4,"text":"فِيهَا يُفْرَقُ كُلُّ أَمْرٍ حَكِيمٍ ","translation":"Therein [i.e., on that night] is made distinct[1] every precise matter -","words":[{"id":1,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":2,"arabic":"يُفْرَقُ","translit":"ُqَrْfُy","root":"فرق"},{"id":3,"arabic":"كُلُّ","translit":"ُّlُk","root":"كلل"},{"id":4,"arabic":"أَمْرٍ","translit":"ٍrْmَaʾ","root":"امر"},{"id":5,"arabic":"حَكِيمٍ","translit":"ٍmyِkَḥ","root":"حكم"}],"hasIhya":false},{"ayah":5,"text":"أَمْرًا مِّنْ عِندِنَآۚ إِنَّا كُنَّا مُرْسِلِينَ ","translation":"[Every] matter [proceeding] from Us. Indeed, We were to send [a messenger]","words":[{"id":1,"arabic":"أَمْرًا","translit":"āًrْmَaʾ","root":"امر"},{"id":2,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":3,"arabic":"عِندِنَآ","translit":"ٓāَnِdnِʿع","root":"عند"},{"id":4,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":5,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":6,"arabic":"مُرْسِلِينَ","translit":"َnyِlِsْrُm","root":"رسل"}],"hasIhya":false},{"ayah":6,"text":"رَحْمَةً مِّن رَّبِّكَۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ ","translation":"As mercy from your Lord. Indeed, He is the Hearing, the Knowing,","words":[{"id":1,"arabic":"رَحْمَةً","translit":"ًẗَmْḥَr","root":"رحم"},{"id":2,"arabic":"مِّن","translit":"nِّm","root":""},{"id":3,"arabic":"رَّبِّكَ","translit":"َkِّbَّr","root":"ربب"},{"id":4,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":5,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":6,"arabic":"ٱلسَّمِيعُ","translit":"ُʿعyِmَّslٱ","root":"سمع"},{"id":7,"arabic":"ٱلْعَلِيمُ","translit":"ُmyِlَʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":7,"text":"رَبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَآۖ إِن كُنتُم مُّوقِنِينَ ","translation":"Lord of the heavens and the earth and that between them, if you would be certain.","words":[{"id":1,"arabic":"رَبِّ","translit":"ِّbَr","root":"ربب"},{"id":2,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":3,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":4,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":5,"arabic":"بَيْنَهُمَآ","translit":"ٓāَmُhَnْyَb","root":"بين"},{"id":6,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":7,"arabic":"كُنتُم","translit":"mُtnُk","root":"كون"},{"id":8,"arabic":"مُّوقِنِينَ","translit":"َnyِnِqwُّm","root":"يقن"}],"hasIhya":false},{"ayah":8,"text":"لَآ إِلَٰهَ إِلَّا هُوَ يُحْىِۦ وَيُمِيتُۖ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ ","translation":"There is no deity except Him; He gives life and causes death. [He is] your Lord and the Lord of your first forefathers.","words":[{"id":1,"arabic":"لَآ","translit":"ٓāَl","root":""},{"id":2,"arabic":"إِلَٰهَ","translit":"َhَٰlِiʾ","root":"اله"},{"id":3,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":4,"arabic":"هُوَ","translit":"َwُh","root":""},