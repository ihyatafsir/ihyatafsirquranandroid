it": "", "root": ""}, {"id": 7, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "رَسُولٌ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَمِينࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 19, "text": "وَأَن لَّا تَعْلُواْ عَلَي اَ۬للَّهِ إِنِّيَ ءَاتِيكُم بِسُلْطَٰنࣲ مُّبِينࣲ‏", "words": [{"id": 1, "arabic": "وَأَن", "translit": "", "root": ""}, {"id": 2, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "تَعْلُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِنِّيَ", "translit": "", "root": ""}, {"id": 7, "arabic": "ءَاتِيكُم", "translit": "", "root": ""}, {"id": 8, "arabic": "بِسُلْطَٰنࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "مُّبِينࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 20, "text": "وَإِنِّے عُذْتُ بِرَبِّے وَرَبِّكُمُۥٓ أَن تَرْجُمُونِۦ", "words": [{"id": 1, "arabic": "وَإِنِّے", "translit": "", "root": ""}, {"id": 2, "arabic": "عُذْتُ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِرَبِّے", "translit": "", "root": ""}, {"id": 4, "arabic": "وَرَبِّكُمُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَن", "translit": "", "root": ""}, {"id": 6, "arabic": "تَرْجُمُونِۦ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 21, "text": "وَإِن لَّمْ تُومِنُواْ لِيَ فَاعْتَزِلُونِۦۖ", "words": [{"id": 1, "arabic": "وَإِن", "translit": "", "root": ""}, {"id": 2, "arabic": "لَّمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "تُومِنُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِيَ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَاعْتَزِلُونِۦۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 22, "text": "فَدَعَا رَبَّهُۥٓ أَنَّ هَٰٓؤُلَآءِ قَوْمࣱ مُّجْرِمُونَۖ", "words": [{"id": 1, "arabic": "فَدَعَا", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّهُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "هَٰٓؤُلَآءِ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَوْمࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُّجْرِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 23, "text": "فَاسْرِ بِعِبَادِے لَيْلاً اِنَّكُم مُّتَّبَعُونَ", "words": [{"id": 1, "arabic": "فَاسْرِ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِعِبَادِے", "translit": "", "root": ""}, {"id": 3, "arabic": "لَيْلاً", "translit": "", "root": ""}, {"id": 4, "arabic": "اِنَّكُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّتَّبَعُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 24, "text": "وَاتْرُكِ اِ۬لْبَحْرَ رَهْواًۖ اِنَّهُمْ جُندࣱ مُّغْرَقُونَۖ", "words": [{"id": 1, "arabic": "وَاتْرُكِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لْبَحْرَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَهْواًۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِنَّهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "جُندࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُّغْرَقُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 25, "text": "۞كَمْ تَرَكُواْ مِن جَنَّٰتࣲ وَعُيُونࣲ‏", "words": [{"id": 1, "arabic": "۞كَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَرَكُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "جَنَّٰتࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَعُيُونࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 26, "text": "وَزُرُوعࣲ وَمَقَامࣲ كَرِيمࣲ‏", "words": [{"id": 1, "arabic": "وَزُرُوعࣲ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَمَقَامࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَرِيمࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 27, "text": "وَنَعْمَةࣲ كَانُواْ فِيهَا فَٰكِهِينَۖ", "words": [{"id": 1, "arabic": "وَنَعْمَةࣲ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "فَٰكِهِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 28, "text": "كَذَٰلِكَۖ وَأَوْرَثْنَٰهَا قَوْماً اٰخَرِينَۖ", "words": [{"id": 1, "arabic": "كَذَٰلِكَۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَأَوْرَثْنَٰهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "قَوْماً", "translit": "", "root": ""}, {"id": 4, "arabic": "اٰخَرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 29, "text": "فَمَا بَكَتْ عَلَيْهِمُ اُ۬لسَّمَآءُ وَالَارْضُ وَمَا كَانُواْ مُنظَرِينَۖ", "words": [{"id": 1, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "بَكَتْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْهِمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لسَّمَآءُ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَالَارْضُ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُنظَرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 30, "text": "وَلَقَدْ نَجَّيْنَا بَنِےٓ إِسْرَآءِيلَ مِنَ اَ۬لْعَذَابِ اِ۬لْمُهِينِ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَجَّيْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "بَنِےٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِسْرَآءِيلَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْعَذَابِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْمُهِينِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 31, "text": "مِن فِرْعَوْنَۖ إِنَّهُۥ كَانَ عَالِياࣰ مِّنَ اَ۬لْمُسْرِفِينَۖ", "words": [{"id": 1, "arabic": "مِن", "translit": "", "root": ""}, {"id": 2, "arabic": "فِرْعَوْنَۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَالِياࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْمُسْرِفِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 32, "text": "وَلَقَدِ اِ۪خْتَرْنَٰهُمْ عَلَيٰ عِلْمٍ عَلَي اَ۬لْعَٰلَمِينَ", "words": [{"id": 1, "arabic": "وَلَقَدِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۪خْتَرْنَٰهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "عِلْمٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْعَٰلَمِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 33, "text": "وَءَاتَيْنَٰهُم مِّنَ اَ۬لَايَٰتِ مَا فِيهِ بَلَٰٓؤࣱ اْ مُّبِينٌۖ", "words": [{"id": 1, "arabic": "وَءَاتَيْنَٰهُم", "translit": "", "root": ""}, {"id": 2, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لَايَٰتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "بَلَٰٓؤࣱ", "translit": "", "root": ""}, {"id": 7, "arabic": "اْ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُّبِينٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 34, "text": "اِنَّ هَٰٓؤُلَآءِ لَيَقُولُونَ", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَٰٓؤُلَآءِ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَيَقُولُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 35, "text": "إِنْ هِيَ إِلَّا مَوْتَتُنَا اَ۬لُاول۪يٰ وَمَ