surah": 44, "ayah": 5, "text": "اَمْراࣰ مِّنْ عِندِنَآۖ إِنَّا كُنَّا مُرْسِلِينَ", "words": [{"id": 1, "arabic": "اَمْراࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عِندِنَآۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "مُرْسِلِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 6, "text": "رَحْمَةࣰ مِّن رَّبِّكَۖ إِنَّهُۥ هُوَ اَ۬لسَّمِيعُ اُ۬لْعَلِيمُۖ", "words": [{"id": 1, "arabic": "رَحْمَةࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 3, "arabic": "رَّبِّكَۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لسَّمِيعُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْعَلِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 7, "text": "رَبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَآ إِن كُنتُم مُّوقِنِينَۖ", "words": [{"id": 1, "arabic": "رَبُّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَالَارْضِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "بَيْنَهُمَآ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِن", "translit": "", "root": ""}, {"id": 7, "arabic": "كُنتُم", "translit": "", "root": ""}, {"id": 8, "arabic": "مُّوقِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 8, "text": "لَآ إِلَٰهَ إِلَّا هُوَۖ يُحْيِۦ وَيُمِيتُۖ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ اُ۬لَاوَّلِينَۖ", "words": [{"id": 1, "arabic": "لَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَٰهَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "هُوَۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "يُحْيِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَيُمِيتُۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "رَبُّكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَرَبُّ", "translit": "", "root": ""}, {"id": 9, "arabic": "ءَابَآئِكُمُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لَاوَّلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 9, "text": "بَلْ هُمْ فِے شَكࣲّ يَلْعَبُونَۖ", "words": [{"id": 1, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "شَكࣲّ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَلْعَبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 10, "text": "فَارْتَقِبْ يَوْمَ تَاتِے اِ۬لسَّمَآءُ بِدُخَانࣲ مُّبِينࣲ‏", "words": [{"id": 1, "arabic": "فَارْتَقِبْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "تَاتِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لسَّمَآءُ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِدُخَانࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُّبِينࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 11, "text": "يَغْشَي اَ۬لنَّاسَۖ هَٰذَا عَذَابٌ اَلِيمࣱۖ", "words": [{"id": 1, "arabic": "يَغْشَي", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لنَّاسَۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "عَذَابٌ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَلِيمࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 12, "text": "رَّبَّنَا اَ۪كْشِفْ عَنَّا اَ۬لْعَذَابَ إِنَّا مُومِنُونَۖ", "words": [{"id": 1, "arabic": "رَّبَّنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۪كْشِفْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْعَذَابَ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "مُومِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 13, "text": "أَنّ۪يٰ لَهُمُ اُ۬لذِّكْر۪يٰ وَقَدْ جَآءَهُمْ رَسُولࣱ مُّبِينࣱ‏", "words": [{"id": 1, "arabic": "أَنّ۪يٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لذِّكْر۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَقَدْ", "translit": "", "root": ""}, {"id": 5, "arabic": "جَآءَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "رَسُولࣱ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّبِينࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 14, "text": "ثُمَّ تَوَلَّوْاْ عَنْهُ وَقَالُواْ مُعَلَّمࣱ مَّجْنُونٌۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَوَلَّوْاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَنْهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَقَالُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُعَلَّمࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَّجْنُونٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 15, "text": "اِنَّا كَاشِفُواْ اُ۬لْعَذَابِ قَلِيلاًۖ اِنَّكُمْ عَآئِدُونَۖ", "words": [{"id": 1, "arabic": "اِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "كَاشِفُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْعَذَابِ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَلِيلاًۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِنَّكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَآئِدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 16, "text": "يَوْمَ نَبْطِشُ اُ۬لْبَطْشَةَ اَ۬لْكُبْر۪يٰٓۖ إِنَّا مُنتَقِمُونَۖ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَبْطِشُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْبَطْشَةَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْكُبْر۪يٰٓۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "مُنتَقِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 17, "text": "وَلَقَدْ فَتَنَّا قَبْلَهُمْ قَوْمَ فِرْعَوْنَ وَجَآءَهُمْ رَسُولࣱ كَرِيمٌ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَتَنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "قَبْلَهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَوْمَ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِرْعَوْنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَجَآءَهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "رَسُولࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "كَرِيمٌ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 18, "text": "اَنَ اَدُّوٓاْ إِلَيَّ عِبَادَ اَ۬للَّهِ إِنِّے لَكُمْ رَسُولٌ اَمِينࣱ‏", "words": [{"id": 1, "arabic": "اَنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَدُّوٓاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "عِبَادَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 7, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "رَسُولٌ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَمِينࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 19, "text": "وَأَن لَّا تَعْلُواْ عَلَي اَ۬للَّهِ إِنِّيَ ءَاتِيكُم بِسُلْطَٰنࣲ مُّبِينࣲ‏", "words": [{"id": 1, "arabic": "وَأَن", "translit": "", "root": ""}, {"id": 2, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "تَعْلُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِنِّيَ", "translit": "", "root": ""}, {"id": 7, "arabic": "ءَاتِيكُم", "translit": "", "root": ""}, {"id": 8, "arabic": "بِسُلْطَٰنࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "مُّبِينࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 20, "text": "وَإِنِّے عُذْتُ بِرَبِّے وَرَبِّكُمُۥٓ أَن تَرْجُمُونِۦ", "words": [{"id": 1, "arabic": "وَإِنِّے", "translit": "", "root": ""}, {"id": 2, "arabic": "عُذْتُ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِرَبِّے", "translit": "", "root": ""}, {"id": 4, "arabic": "وَرَبِّكُمُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَن", "translit": "", "root": ""}, {"id": 6, "arabic": "تَرْجُمُونِۦ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 21, "text": "وَإِن لَّمْ تُومِنُواْ لِيَ فَاعْتَزِلُونِۦۖ", "words": [{"id": 1, "arabic": "وَإِن", "translit": "", "root": ""}, {"id": 2, "arabic": "لَّمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "تُومِنُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِيَ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَاعْتَزِلُونِۦۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 22, "text": "فَدَعَا رَبَّهُۥٓ أَنَّ هَٰٓؤُلَآءِ قَوْمࣱ مُّجْرِمُونَۖ", "words": [{"id": 1, "arabic": "فَدَعَا", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّهُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "هَٰٓؤُلَآءِ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَوْمࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُّجْرِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 23, "text": "فَاسْرِ بِعِبَادِے لَيْلاً اِنَّكُم مُّتَّبَعُونَ", "words": [{"id": 1, "arabic": "فَاسْرِ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِعِبَادِے", "translit": "", "root": ""}, {"id": 3, "arabic": "لَيْلاً", "translit": "", "root": ""}, {"id": 4, "arabic": "اِنَّكُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّتَّبَعُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 24, "text": "وَاتْرُكِ اِ۬لْبَحْرَ رَهْواًۖ اِنَّهُمْ جُندࣱ مُّغْرَقُونَۖ", "words": [{"id": 1, "arabic": "وَاتْرُكِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لْبَحْرَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَهْواًۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِنَّهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "جُندࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُّغْرَقُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 25, "text": "۞كَمْ تَرَكُواْ مِن جَنَّٰتࣲ وَعُيُونࣲ‏", "words": [{"id": 1, "arabic": "۞كَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَرَكُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "جَنَّٰتࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَعُيُونࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 26, "text": "وَزُرُوعࣲ وَمَقَامࣲ كَرِيمࣲ‏", "words": [{"id": 1, "arabic": "وَزُرُوعࣲ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَمَقَامࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَرِيمࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 27, "text": "وَنَعْمَةࣲ كَانُواْ فِيهَا فَٰكِهِينَۖ", "words": [{"id": 1, "arabic": "وَنَعْمَةࣲ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "فَٰكِهِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 28, "text": "كَذَٰلِكَۖ وَأَوْرَثْنَٰهَا قَوْماً اٰخَرِينَۖ", "words": [{"id": 1, "arabic": "كَذَٰلِكَۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَأَوْرَثْنَٰهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "قَوْماً", "translit": "", "root": ""}, {"id": 4, "arabic": "اٰخَرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 29, "text": "فَمَا بَكَتْ عَلَيْهِمُ اُ۬لسَّمَآءُ وَالَارْضُ وَمَا كَانُواْ مُنظَرِينَۖ", "words": [{"id": 1, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "بَكَتْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْهِمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لسَّمَآءُ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَالَارْضُ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُنظَرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 30, "text": "وَلَقَدْ نَجَّيْنَا بَنِےٓ إِسْرَآءِيلَ مِنَ اَ۬لْعَذَابِ اِ۬لْمُهِينِ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَجَّيْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "بَنِےٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِسْرَآءِيلَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْعَذَابِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْمُهِينِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 31, "text": "مِن فِرْعَوْنَۖ إِنَّهُۥ كَانَ عَالِياࣰ مِّنَ اَ۬لْمُسْرِفِينَۖ", "words": [{"id": 1, "arabic": "مِن", "translit": "", "root": ""}, {"id": 2, "arabic": "فِرْعَوْنَۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَالِياࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْمُسْرِفِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 32, "text": "وَلَقَدِ اِ۪خْتَرْنَٰهُمْ عَلَيٰ عِلْمٍ عَلَي اَ۬لْعَٰلَمِينَ", "words": [{"id": 1, "arabic": "وَلَقَدِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۪خْتَرْنَٰهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "عِلْمٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْعَٰلَمِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 33, "text": "وَءَاتَيْنَٰهُم مِّنَ اَ۬لَايَٰتِ مَا فِيهِ بَلَٰٓؤࣱ اْ مُّبِينٌۖ", "words": [{"id": 1, "arabic": "وَءَاتَيْنَٰهُم", "translit": "", "root": ""}, {"id": 2, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لَايَٰتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "بَلَٰٓؤࣱ", "translit": "", "root": ""}, {"id": 7, "arabic": "اْ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُّبِينٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 34, "text": "اِنَّ هَٰٓؤُلَآءِ لَيَقُولُونَ", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَٰٓؤُلَآءِ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَيَقُولُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 35, "text": "إِنْ هِيَ إِلَّا مَوْتَتُنَا اَ۬لُاول۪يٰ وَمَا نَحْنُ بِمُنشَرِينَ", "words": [{"id": 1, "arabic": "إِنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "هِيَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "مَوْتَتُنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لُاول۪يٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 8, "arabic": "بِمُنشَرِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 36, "text": "فَاتُواْ بِـَٔابَآئِنَآ إِن كُنتُمْ صَٰدِقِينَۖ", "words": [{"id": 1, "arabic": "فَاتُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِـَٔابَآئِنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِن", "translit": "", "root": ""}, {"id": 4, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "صَٰدِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 37, "text": "أَهُمْ خَيْرٌ اَمْ قَوْمُ تُبَّعࣲۖ وَالذِينَ مِن قَبْلِهِمُۥٓ أَهْلَكْنَٰهُمُۥٓۖ إِنَّهُمْ كَانُواْ مُجْرِمِينَۖ", "words": [{"id": 1, "arabic": "أَهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَيْرٌ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَوْمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "تُبَّعࣲۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَالذِينَ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِن", "translit": "", "root": ""}, {"id": 8, "arabic": "قَبْلِهِمُۥٓ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَهْلَكْنَٰهُمُۥٓۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 12, "arabic": "مُجْرِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 38, "text": "وَمَا خَلَقْنَا اَ۬لسَّمَٰوَٰتِ وَالَارْضَ وَمَا بَيْنَهُمَا لَٰعِبِينَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "بَيْنَهُمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "لَٰعِبِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 39, "text": "مَا خَلَقْنَٰهُمَآ إِلَّا بِالْحَقِّۖ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "مَا", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْنَٰهُمَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "بِالْحَقِّۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَلَٰكِنَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَكْثَرَهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "", "root": ""}, {"id": 8, "arabic": "يَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 40, "text": "إِنَّ يَوْمَ اَ۬لْفَصْلِ مِيقَٰتُهُمُۥٓ أَجْمَعِينَ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْفَصْلِ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِيقَٰتُهُمُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَجْمَعِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 41, "text": "يَوْمَ لَا يُغْنِے مَوْليً عَن مَّوْليࣰ شَئْاࣰ وَلَا هُمْ يُنصَرُونَ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "", "root": ""}, {"id": 3, "arabic": "يُغْنِے", "translit": "", "root": ""}, {"id": 4, "arabic": "مَوْليً", "translit": "", "root": ""}, {"id": 5, "arabic": "عَن", "translit": "", "root": ""}, {"id": 6, "arabic": "مَّوْليࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "شَئْاࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 9, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "يُنصَرُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 42, "text": "إِلَّا مَن رَّحِمَ اَ۬للَّهُۖ إِنَّهُۥ هُوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "", "root": ""}, {"id": 3, "arabic": "رَّحِمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهُۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْعَزِيزُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لرَّحِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 43, "text": "إِنَّ شَجَرَتَ اَ۬لزَّقُّومِ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "شَجَرَتَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لزَّقُّومِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 44, "text": "طَعَامُ اُ۬لَاثِيمِ", "words": [{"id": 1, "arabic": "طَعَامُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لَاثِيمِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 45, "text": "كَالْمُهْلِ تَغْلِے فِے اِ۬لْبُطُونِ", "words": [{"id": 1, "arabic": "كَالْمُهْلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَغْلِے", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْبُطُونِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 46, "text": "كَغَلْيِ اِ۬لْحَمِيمِۖ", "words": [{"id": 1, "arabic": "كَغَلْيِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لْحَمِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 47, "text": "خُذُوهُ فَاعْتُلُوهُ إِلَيٰ سَوَآءِ اِ۬لْجَحِيمِ", "words": [{"id": 1, "arabic": "خُذُوهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَاعْتُلُوهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "سَوَآءِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْجَحِيمِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 44, "ayah": 48, "text": "ثُمَّ صُبُّواْ فَوْق