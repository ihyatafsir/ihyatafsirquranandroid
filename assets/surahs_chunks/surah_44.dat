lit":"ٰàَlَʿع","root":""},{"id":4,"arabic":"عِلْمٍ","translit":"ٍmْlِʿع","root":"علم"},{"id":5,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":6,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":33,"text":"وَءَاتَيْنَٰهُم مِّنَ ٱلْءَايَٰتِ مَا فِيهِ بَلَٰٓؤٌا۟ مُّبِينٌ ","translation":"And We gave them of signs that in which there was a clear trial.","words":[{"id":1,"arabic":"وَءَاتَيْنَٰهُم","translit":"mُhَٰnْyَtāَءَw","root":"اتي"},{"id":2,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":3,"arabic":"ٱلْءَايَٰتِ","translit":"ِtَٰyāَءْlٱ","root":"ايي"},{"id":4,"arabic":"مَا","translit":"āَm","root":""},{"id":5,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":6,"arabic":"بَلَٰٓؤٌا۟","translit":"۟āٌwʾَٰٓlَb","root":"بلو"},{"id":7,"arabic":"مُّبِينٌ","translit":"ٌnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":34,"text":"إِنَّ هَٰٓؤُلَآءِ لَيَقُولُونَ ","translation":"Indeed, these [disbelievers] are saying,","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"هَٰٓؤُلَآءِ","translit":"ِءٓāَlُwʾَٰٓh","root":""},{"id":3,"arabic":"لَيَقُولُونَ","translit":"َnwُlwُqَyَl","root":"قول"}],"hasIhya":false},{"ayah":35,"text":"إِنْ هِىَ إِلَّا مَوْتَتُنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُنشَرِينَ ","translation":"\"There is not but our first death, and we will not be resurrected.","words":[{"id":1,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":2,"arabic":"هِىَ","translit":"َàِh","root":""},{"id":3,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":4,"arabic":"مَوْتَتُنَا","translit":"āَnُtَtْwَm","root":"موت"},{"id":5,"arabic":"ٱلْأُولَىٰ","translit":"ٰàَlwُaʾْlٱ","root":"اول"},{"id":6,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":7,"arabic":"نَحْنُ","translit":"ُnْḥَn","root":""},{"id":8,"arabic":"بِمُنشَرِينَ","translit":"َnyِrَhsnُmِb","root":"نشر"}],"hasIhya":false},{"ayah":36,"text":"فَأْتُوا۟ بِـَٔابَآئِنَآ إِن كُنتُمْ صَٰدِقِينَ ","translation":"Then bring [back] our forefathers, if you should be truthful.\"","words":[{"id":1,"arabic":"فَأْتُوا۟","translit":"۟āwُtْaʾَf","root":"اتي"},{"id":2,"arabic":"بِـَٔابَآئِنَآ","translit":"ٓāَnِyʾٓāَbāَٔـِb","root":"ابو"},{"id":3,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":4,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":5,"arabic":"صَٰدِقِينَ","translit":"َnyِqِdَٰṣ","root":"صدق"}],"hasIhya":false},{"ayah":37,"text":"أَهُمْ خَيْرٌ أَمْ قَوْمُ تُبَّعٍ وَٱلَّذِينَ مِن قَبْلِهِمْۚ أَهْلَكْنَٰهُمْۖ إِنَّهُمْ كَانُوا۟ مُجْرِمِينَ ","translation":"Are they better or the people of Tubbaʿ[1] and those before them? We destroyed them, [for] indeed, they were criminals.","words":[{"id":1,"arabic":"أَهُمْ","translit":"ْmُhَaʾ","root":""},{"id":2,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":3,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":4,"arabic":"قَوْمُ","translit":"ُmْwَq","root":"قوم"},{"id":5,"arabic":"تُبَّعٍ","translit":"ٍʿعَّbُt","root":""},{"id":6,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":7,"arabic":"مِن","translit":"nِm","root":""},{"id":8,"arabic":"قَبْلِهِمْ","translit":"ْmِhِlْbَq","root":"قبل"},{"id":9,"arabic":"أَهْلَكْنَٰهُمْ","translit":"ْmُhَٰnْkَlْhَaʾ","root":"هلك"},{"id":10,"arabic":"إِنَّهُمْ","translit":"ْmُhَّnِiʾ","root":""},{"id":11,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":12,"arabic":"مُجْرِمِينَ","translit":"َnyِmِrْjgُm","root":"جرم"}],"hasIhya":false},{"ayah":38,"text":"وَمَا خَلَقْنَا ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا لَٰعِبِينَ ","translation":"And We did not create the heavens and earth and that between them in play.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"خَلَقْنَا","translit":"āَnْqَlَhk","root":"خلق"},{"id":3,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":4,"arabic":"وَٱلْأَرْضَ","translit":"َḍْrَaʾْlٱَw","root":"ارض"},{"id":5,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":6,"arabic":"بَيْنَهُمَا","translit":"āَmُhَnْyَb","root":"بين"},{"id":7,"arabic":"لَٰعِبِينَ","translit":"َnyِbِʿعَٰl","root":"لعب"}],"hasIhya":true},{"ayah":39,"text":"مَا خَلَقْنَٰهُمَآ إِلَّا بِٱلْحَقِّ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ ","translation":"We did not create them except in truth, but most of them do not know.","words":[{"id":1,"arabic":"مَا","translit":"āَm","root":""},{"id":2,"arabic":"خَلَقْنَٰهُمَآ","translit":"ٓāَmُhَٰnْqَlَhk","root":"خلق"},{"id":3,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":4,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":5,"arabic":"وَلَٰكِنَّ","translit":"َّnِkَٰlَw","root":""},{"id":6,"arabic":"أَكْثَرَهُمْ","translit":"ْmُhَrَhtْkَaʾ","root":"كثر"},{"id":7,"arabic":"لَا","translit":"āَl","root":""},{"id":8,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":false},{"ayah":40,"text":"إِنَّ يَوْمَ ٱلْفَصْلِ مِيقَٰتُهُمْ أَجْمَعِينَ ","translation":"Indeed, the Day of Judgement is the appointed time for them all -","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":3,"arabic":"ٱلْفَصْلِ","translit":"ِlْṣَfْlٱ","root":"فصل"},{"id":4,"arabic":"مِيقَٰتُهُمْ","translit":"ْmُhُtَٰqyِm","root":"وقت"},{"id":5,"arabic":"أَجْمَعِينَ","translit":"َnyِʿعَmْjgَaʾ","root":"جمع"}],"hasIhya":false},{"ayah":41,"text":"يَوْمَ لَا يُغْنِى مَوْلًى عَن مَّوْلًى شَيْـًٔا وَلَا هُمْ يُنصَرُونَ ","translation":"The Day when no relation[1] will avail a relation at all, nor will they be helped -","words":[{"id":1,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":2,"arabic":"لَا","translit":"āَl","root":""},{"id":3,"arabic":"يُغْنِى","translit":"àِnْغُy","root":"غني"},{"id":4,"arabic":"مَوْلًى","translit":"àًlْwَm","root":"ولي"},{"id":5,"arabic":"عَن","translit":"nَʿع","root":""},{"id":6,"arabic":"مَّوْلًى","translit":"àًlْwَّm","root":"ولي"},{"id":7,"arabic":"شَيْـًٔا","translit":"āًٔـْyَhs","root":"شيا"},{"id":8,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":9,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":10,"arabic":"يُنصَرُونَ","translit":"َnwُrَṣnُy","root":"نصر"}],"hasIhya":true},{"ayah":42,"text":"إِلَّا مَن رَّحِمَ ٱللَّهُۚ إِنَّهُۥ هُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ ","translation":"Except those [believers] on whom Allāh has mercy. Indeed, He is the Exalted in Might, the Merciful.","words":[{"id":1,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":2,"arabic":"مَن","translit":"nَm","root":""},{"id":3,"arabic":"رَّحِمَ","translit":"َmِḥَّr","root":"رحم"},{"id":4,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":5,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":6,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":7,"arabic":"ٱلْعَزِيزُ","translit":"ُzyِzَʿعْlٱ","root":"عزز"},{"id":8,"arabic":"ٱلرَّحِيمُ","translit":"ُmyِḥَّrlٱ","root":"رحم"}],"hasIhya":true},{"ayah":43,"text":"إِنَّ شَجَرَتَ ٱلزَّقُّومِ ","translation":"Indeed, the tree of zaqqūm","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"شَجَرَتَ","translit":"َtَrَjgَhs","root":"شجر"},{"id":3,"arabic":"ٱلزَّقُّومِ","translit":"ِmwُّqَّzlٱ","root":"زقم"}],"hasIhya":false},{"ayah":44,"text":"طَعَامُ ٱلْأَثِيمِ ","translation":"Is food for the sinful.","words":[{"id":1,"arabic":"طَعَامُ","translit":"ُmāَʿعَṭ","root":"طعم"},{"id":2,"arabic":"ٱلْأَثِيمِ","translit":"ِmyِhtَaʾْlٱ","root":"اثم"}],"hasIhya":false},{"ayah":45,"text":"كَٱلْمُهْلِ يَغْلِى فِى ٱلْبُطُونِ ","translation":"Like murky oil, it boils within bellies","words":[{"id":1,"arabic":"كَٱلْمُهْلِ","translit":"ِlْhُmْlٱَk","root":"مهل"},{"id":2,"arabic":"يَغْلِى","translit":"àِlْغَy","root":"غلي"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلْبُطُونِ","translit":"ِnwُṭُbْlٱ","root":"بطن"}],"hasIhya":false},{"ayah":46,"text":"كَغَلْىِ ٱلْحَمِيمِ ","translation":"Like the boiling of scalding water.","words":[{"id":1,"arabic":"كَغَلْىِ","translit":"ِàْlَغَk","root":"غلي"},{"id":2,"arabic":"ٱلْحَمِيمِ","translit":"ِmyِmَḥْlٱ","root":"حمم"}],"hasIhya":false},{"ayah":47,"text":"خُذُوهُ فَٱعْتِلُوهُ إِلَىٰ سَوَآءِ ٱلْجَحِيمِ ","translation":"[It will be commanded], \"Seize him and drag him into the midst of the Hellfire,","words":[{"id":1,"arabic":"خُذُوهُ","translit":"ُhwُhdُhk","root":"اخذ"},{"id":2,"arabic":"فَٱعْتِلُوهُ","translit":"ُhwُlِtْʿعٱَf","root":"عتل"},{"id":3,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":4,"arabic":"سَوَآءِ","translit":"ِءٓāَwَs","root":"سوي"},{"id":5,"arabic":"ٱلْجَحِيمِ","translit":"ِmyِḥَjgْlٱ","root":"جحم"}],"hasIhya":false},{"ayah":48,"text":"ثُمَّ صُبُّوا۟ فَوْقَ رَأْسِهِۦ مِنْ عَذَابِ ٱلْحَمِيمِ ","translation":"Then pour over his head from the torment of scalding water.\"","words":[{"id":1,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":2,"arabic":"صُبُّوا۟","translit":"۟āwُّbُṣ","root":"صبب"},{"id":3,"arabic":"فَوْقَ","translit":"َqْwَf","root":"فوق"},{"id":4,"arabic":"رَأْسِهِۦ","translit":"ۦِhِsْaʾَr","root":"راس"},{"id":5,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":6,"arabic":"عَذَابِ","translit":"ِbāَhdَʿع","root":"عذب"},{"id":7,"arabic":"ٱلْحَمِيمِ","translit":"ِmyِmَḥْlٱ","root":"حمم"}],"hasIhya":false},{"ayah":49,"text":"ذُقْ إِنَّكَ أَنتَ ٱلْعَزِيزُ ٱلْكَرِيمُ ","translation":"[It will be said], \"Taste! Indeed, you are the honored, the noble![1]","words":[{"id":1,"arabic":"ذُقْ","translit":"ْqُhd","root":"ذوق"},{"id":2,"arabic":"إِنَّكَ","translit":"َkَّnِiʾ","root":""},{"id":3,"arabic":"أَنتَ","translit":"َtnَaʾ","root":""},{"id":4,"arabic":"ٱلْعَزِيزُ","translit":"ُzyِzَʿعْlٱ","root":"عزز"},{"id":5,"arabic":"ٱلْكَرِيمُ","translit":"ُmyِrَkْlٱ","root":"كرم"}],"hasIhya":true},{"ayah":50,"text":"إِنَّ هَٰذَا مَا كُنتُم بِهِۦ تَمْتَرُونَ ","translation":"Indeed, this is what you used to dispute.\"","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":3,"arabic":"مَا","translit":"āَm","root":""},{"id":4,"arabic":"كُنتُم","translit":"mُtnُk","root":"كون"},{"id":5,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":6,"arabic":"تَمْتَرُونَ","translit":"َnwُrَtْmَt","root":"مري"}],"hasIhya":false},{"ayah":51,"text":"إِنَّ ٱلْمُتَّقِينَ فِى مَقَامٍ أَمِينٍ ","translation":"Indeed, the righteous will be in a secure place:","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلْمُتَّقِينَ","translit":"َnyِqَّtُmْlٱ","root":"وقي"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"مَقَامٍ","translit":"ٍmāَqَm","root":"قوم"},{"id":5,"arabic":"أَمِينٍ","translit":"ٍnyِmَaʾ","root":"امن"}],"hasIhya":true},{"ayah":52,"text":"فِى جَنَّٰتٍ وَعُيُونٍ ","translation":"Within gardens and springs,","words":[{"id":1,"arabic":"فِى","translit":"àِf","root":""},{"id":2,"arabic":"جَنَّٰتٍ","translit":"ٍtَّٰnَjg","root":"جنن"},{"id":3,"arabic":"وَعُيُونٍ","translit":"ٍnwُyُʿعَw","root":"عين"}],"hasIhya":false},{"ayah":53,"text":"يَلْبَسُونَ مِن سُندُسٍ وَإِسْتَبْرَقٍ مُّتَقَٰبِلِينَ ","translation":"Wearing [garments of] fine silk and brocade, facing each other.","words":[{"id":1,"arabic":"يَلْبَسُونَ","translit":"َnwُsَbْlَy","root":"لبس"},{"id":2,"arabic":"مِن","translit":"nِm","root":""},{"id":3,"arabic":"سُندُسٍ","translit":"ٍsُdnُs","root":""},{"id":4,"arabic":"وَإِسْتَبْرَقٍ","translit":"ٍqَrْbَtْsِiʾَw","root":""},{"id":5,"arabic":"مُّتَقَٰبِلِينَ","translit":"َnyِlِbَٰqَtُّm","root":"قبل"}],"hasIhya":false},{"ayah":54,"text":"كَذَٰلِكَ وَزَوَّجْنَٰهُم بِحُورٍ عِينٍ ","translation":"Thus. And We will marry them to fair women with large, [beautiful] eyes.","words":[{"id":1,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":2,"arabic":"وَزَوَّجْنَٰهُم","translit":"mُhَٰnْjgَّwَzَw","root":"زوج"},{"id":3,"arabic":"بِحُورٍ","translit":"ٍrwُḥِb","root":"حور"},{"id":4,"arabic":"عِينٍ","translit":"ٍnyِʿع","root":"عين"}],"hasIhya":false},{"ayah":55,"text":"يَدْعُونَ فِيهَا بِكُلِّ فَٰكِهَةٍ ءَامِنِينَ ","translation":"They will call therein for every [kind of] fruit - safe and secure.","words":[{"id":1,"arabic":"يَدْعُونَ","translit":"َnwُʿعْdَy","root":"دعو"},{"id":2,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":3,"arabic":"بِكُلِّ","translit":"ِّlُkِb","root":"كلل"},{"id":4,"arabic":"فَٰكِهَةٍ","translit":"ٍẗَhِkَٰf","root":"فكه"},{"id":5,"arabic":"ءَامِنِينَ","translit":"َnyِnِmāَء","root":"امن"}],"hasIhya":false},{"ayah":56,"text":"لَا يَذُوقُونَ فِيهَا ٱلْمَوْتَ إِلَّا ٱلْمَوْتَةَ ٱلْأُولَىٰۖ وَوَقَىٰهُمْ عَذَابَ ٱلْجَحِيمِ ","translation":"They will not taste death therein except the first death, and He will have protected them from the punishment of Hellfire","words":[{"id":1,"arabic":"لَا","translit":"āَl","root":""},{"id":2,"arabic":"يَذُوقُونَ","translit":"َnwُqwُhdَy","root":"ذوق"},{"id":3,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":4,"arabic":"ٱلْمَوْتَ","translit":"َtْwَmْlٱ","root":"موت"},{"id":5,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":6,"arabic":"ٱلْمَوْتَةَ","translit":"َẗَtْwَmْlٱ","root":"موت"},{"id":7,"arabic":"ٱلْأُولَىٰ","translit":"ٰàَlwُaʾْlٱ","root":"اول"},{"id":8,"arabic":"وَوَقَىٰهُمْ","translit":"ْmُhٰàَqَwَw","root":"وقي"},{"id":9,"arabic":"عَذَابَ","translit":"َbāَhdَʿع","root":"عذب"},{"id":10,"arabic":"ٱلْجَحِيمِ","translit":"ِmyِḥَjgْlٱ","root":"جحم"}],"hasIhya":false},{"ayah":57,"text":"فَضْلًا مِّن رَّبِّكَۚ ذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ ","translation":"As bounty from your Lord. That is what is the great attainment.","words":[{"id":1,"arabic":"فَضْلًا","translit":"āًlْḍَf","root":"فضل"},{"id":2,"arabic":"مِّن","translit":"nِّm","root":""},{"id":3,"arabic":"رَّبِّكَ","translit":"َkِّbَّr","root":"ربب"},{"id":4,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":5,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":6,"arabic":"ٱلْفَوْزُ","translit":"ُzْwَfْlٱ","root":"فوز"},{"id":7,"arabic":"ٱلْعَظِيمُ","translit":"ُmyِẓَʿعْlٱ","root":"عظم"}],"hasIhya":false},{"ayah":58,"text":"فَإِنَّمَا يَسَّرْنَٰهُ بِلِسَانِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ ","translation":"And indeed, We have eased it [i.e., the Qur’ān] in your tongue that they might be reminded.","words":[{"id":1,"arabic":"فَإِنَّمَا","translit":"āَmَّnِiʾَf","root":""},{"id":2,"arabic":"يَسَّرْنَٰهُ","translit":"ُhَٰnْrَّsَy","root":"يسر"},{"id":3,"arabic":"بِلِسَانِكَ","translit":"َkِnāَsِlِb","root":"لسن"},{"id":4,"arabic":"لَعَلَّهُمْ","translit":"ْmُhَّlَʿعَl","root":""},{"id":5,"arabic":"يَتَذَكَّرُونَ","translit":"َnwُrَّkَhdَtَy","root":"ذكر"}],"hasIhya":false},{"ayah":59,"text":"فَٱرْتَقِبْ إِنَّهُم مُّرْتَقِبُونَ ","translation":"So watch, [O Muḥammad]; indeed, they are watching [for your end].","words":[{"id":1,"arabic":"فَٱرْتَقِبْ","translit":"ْbِqَtْrٱَf","root":"رقب"},{"id":2,"arabic":"إِنَّهُم","translit":"mُhَّnِiʾ","root":""},{"id":3,"arabic":"مُّرْتَقِبُونَ","translit":"َnwُbِqَtْrُّm","root":"رقب"}],"hasIhya":false}],"tafsir":{"3":[{"arabic":"نهار وبان بقوله عز وجل إنا أنزلناه في ليلة مباركة ولم يظهر به أي ليلة فظهر بقوله تعالى إنا أنزلناه في ليلة القدر وربما يظن في الظاهر الاختلاف بين هذه الآيات فهذا وأمثاله مما لا يغني فيه إلا النقل والسماع فالقرآن من أوله إلى آخره غير خال عن هذا الجنس لأنه أنزل بلغة العرب فكان مشتملا على أصناف كلامهم من إيجاز وتطويل وإضمار وحذف وإبدال وتقديم وتأخير ليكون ذلك مفحما لهم ومعجزا في حقهم فكل من اكتفى بفهم ظاهر العربية وبادر إلى تفسير القرآن ولم يستظهر بالسماع والنقل في هذه الأمور فهو داخل فيمن فسر","english":"I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"","book_title":"Etiquette of Quran Recitation","section_title_ar":"Section 233","section_title_en":"The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation","section_index":233,"anchors":"- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Quran Recitation'","badge":"Hadith"}],"21":[{"arabic":"واحتجوا أيضا بقول موسى عليه السلام {وإن لم تؤمنوا لى فاعتزلون} وأنه فزع إلى العزلة عند اليأس منهم وقال تعالى في أصحاب الكهف وإذا اعتزلتموهم وما يعبدون إلا الله فأووا إلى الكهف ينشر لكم ربكم من رحمته أمرهم بالعزلة وقد اعتزل نبينا صلى الله عليه وسلم قريشا لما آذوه وجفوه ودخل الشعب وامر أصحابه باعتزالهم والهجرة الى أرض الحبشة (3) ثم تلاحقوا به الى المدينة بعد أن أعلى الله كلمته وهذا أيضا اعتزال عن الكفار بعد اليأس منهم فإنه صلى الله عليه وسلم لم يعتزل المسلمين ولا من توقع إسلامه من الكفار وأهل الكهف لم يعت","english":"They argued by the saying of Allah Almighty, narrating of Abraham, peace be upon him: {«وَأَعْتَزِلُكُمْ وَمَا تَدْعُونَ مِنْ دُونِ اللَّهِ وَأَدْعُو رَبِّي»} [And I will withdraw from you and what you call upon besides Allah, and I will call upon my Lord] — to the end of the verse. Then Allah Almighty said: {«فَلَمَّا اعْتَزَلَهُمْ وَمَا يَعْبُدُونَ مِنْ دُونِ اللَّهِ وَهَبْنَا لَهُ إِسْحَاقَ وَيَعْقُوبَ وَكُلًّا جَعَلْنَا نَبِيًّا»} [So when he withdrew from them and what they worshipped besides Allah, We granted him Isaac and Jacob, and each We made a prophet] — indicating that this was by the blessing of seclusion.","book_title":"Etiquette of Seclusion","section_title_ar":"Section 446","section_title_en":"Section 446 — On the Evidences for and Against Seclusion (Al-ʿUzlah) and the Refutation of Both Extremes","section_index":446,"anchors":"- Root: عزل (ʿ-z-l)\n  * Lisan / Ayn: Core root meaning of separation, withdrawal, setting apart; al-iʿtizāl is to remove oneself from company or affairs.\n  * Al-Raghib (Mufradat): \"الاعتزال: تجنب الشيء\" — seclusion is the shunning of a thing, whether by body or by heart, whether as an act of piety, innocence, or otherwise. It is used in the Qur'an for withdrawing from idolaters {«وَإِذَا اعْتَزَلْتُمُوهُمْ وَمَا يَعْبُدُونَ إِلَّا اللَّهَ»} and from women during menses {«فَاعْتَزِلُوا النِّسَاءَ»}.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): physical separation from a place or people. Metaphorical (majāz): withdrawal of the heart from worldly concerns or from the company of the corrupt.\n- Root: خلط (kh-l-ṭ)\n  * Lisan / Ayn: Mixing, blending, intermingling; a companion or partner is called khalīṭ because of shared association.\n  * Al-Raghib (Mufradat): \"الخلط: هو الجمع بين أجزاء الشيئين فصاعدا\" — mixing is the joining of parts of two or more things; extended metaphorically to social mixing (mukhālaṭah) with people.\n  * Al-Zamakhshari (Asas): Literal: mixing substances. Metaphorical: social intercourse, companionship, partnership — \"خالطت فلانا، وهو خليطي\" (I mixed with so-and-so, and he is my companion).\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Specification) — The particle innamā restricts predication to a single referent, as in the Prophet's ﷺ saying \"إنما العلم بالتعلم\" (Knowledge is only attained by learning), which confines the means of acquiring knowledge to learning alone.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Seclusion'","badge":"Hadith"}],"29":[{"arabic":"عمله من السماء ثم قرأ {فما بكت عليهم السماء والأرض وما كانوا منظرين} وقال ابن عباس تبكي عليه الأرض أربعين صباحا وقال عطاء الخراساني ما من عبد يسجد لله سجدة في بقعة من بقاع الأرض إلا شهدت له يوم القيامة وبكت عليه يوم يموت وقال أنس بن مالك ما من بقعة يذكر الله تعالى عليها بصلاة أو ذكر إلا افتخرت على ما حولها من البقاع واستبشرت بذكر الله عز وجل إلى منتهاها من سبع أرضين وما من عبد يقوم يصلي إلا تزخرفت له الأرض ويقال ما من منزل ينزل فيه قوم إلا أصبح ذلك المنزل يصلي عليهم أو يلعنهم","english":"And it is related from Ḥātim al-Aṣamm, may God be pleased with him, that he was asked about his prayer, and he said: \"When the time of prayer arrives, I perfect my ablution, and I come to the place where I intend to pray, and I sit therein until my bodily members are composed. Then I rise to my prayer, and I make the Kaʿbah between my eyebrows, and the Ṣirāṭ beneath my feet, and Paradise on my right, and the Fire on my left, and the Angel of Death behind me—thinking it to be my final prayer. Then I stand between hope and fear, and I pronounce the takbīr with sincerity, and I recite the Qurʾān with measured chanting (tartīl), and I bow with humility, and I prostrate with reverence (takhashshuʿ), and I sit upon my left hip, spreading the back of its foot, and I erect the right foot upon its toe, and I follow it with sincerity (ikhlāṣ). Then I do not know whether it has been accepted from me or not.\"","book_title":"Mysteries of Prayer","section_title_ar":"Section 125","section_title_en":"The Virtue of the Mosque and the Place of Prayer","section_index":125,"anchors":"- Root: عمر (ʿamara)\n  * Lisan / Ayn: Core meaning of inhabiting, cultivating, and maintaining a place; the opposite of desolation (kharāb)\n  * Al-Raghib (Mufradat): Theological nuance of ʿimārah as spiritual cultivation—frequenting and enlivening through worship, not merely physical construction\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) = physical building/maintenance; Metaphorical (majāz) = spiritual habitation through prayer and remembrance\n\n- Root: سجد (sajada)\n  * Lisan / Ayn: Physical prostration; placing the forehead on the ground in submission\n  * Al-Raghib (Mufradat): \"السجود أصله: التطامن والتذلل\" — Prostration's root meaning is humility and self-abasement; it is of two types: voluntary (for humans, deserving reward) and compelled/subjugated (for all creation)\n  * Al-Zamakhshari (Asas): Literal = the physical act of prostration; Metaphorical = the earth bearing witness, weeping, or rejoicing over the worshipper (anthropomorphic attribution of human actions to inanimate creation as majāz)\n\n- Root: الف (alifa)\n  * Lisan / Ayn: To become familiar, accustomed, or attached to something; to frequent habitually\n  * Al-Raghib (Mufradat): The theological sense of intimacy and familiarity with sacred spaces as a mark of genuine faith\n  * Al-Zamakhshari (Asas): Literal = habitual attendance; Metaphorical = God's reciprocal familiarity and love toward the one who frequents His houses\n\n- Root: خلد (khalada)\n  * Lisan / Ayn: To remain, abide, or endure perpetually\n  * Al-Raghib (Mufradat): Eternal duration without termination—used of Paradise and its inhabitants\n  * Al-Zamakhshari (Asas): Literal = perpetual remaining; used here in the context of eternal reward\n\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle \"innamā\" restricts the predicate exclusively to the subject, as in {إنما يعمر مساجد الله من آمن بالله واليوم الآخر}, confining true mosque-habitation to believers alone.\n\n---\n\n##","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Mysteries of Prayer'","badge":"Afterlife"}],"38":[{"arabic":"فلنعدل إلى الأقرب إلى الأفهام وهي المدركات بحس البصر وذلك هو السموات السبع والأرض وما بينهما فالسموات مشاهدة بكواكبها وشمسها وقمرها وحركتها ودورانها في طلوعها وغروبها والأرض مشاهدة بما فيها من جبالها ومعادنها وأنهارها وبحارها وحيوانها ونباتها وما بين السماء والأرض وهو الجو مدرك بغيومها وأمطارها وثلوجها ورعدها وبرقها وصواعقها وشهبها وعواصف رياحها فهذه هي الأجناس المشاهدة من السموات والأرض وما بينهما وكل جنس منها ينقسم إلى أنواع وكل نوع ينقسم إلى أقسام ويتشعب كل قسم إلى أصناف ولا نهاية لانشعاب ذلك وانقسامه في اختلاف صفاته وهيآته ومعانيه الظاهرة والباطنة وجميع ذلك مجال الفكر فلا تتحرك ذرة في السموات والأرض من جماد ولا نبات ولا حيوان ولا فلك ولا كوكب إلا والله تعالى هو محركها وفي حركتها حكمة أو حكمتان أو عشر أو ألف حكمة كل ذلك شاهد لله تعالى بالوحدانية ودال على جلاله وكبريائه وهي الآيات الدالة عليه وقد ورد القرآن بالحث على التفكر في هذه الايات كما قال الله تعالى إن في خلق السموات والأرض واختلاف الليل والنهار لآيات لأولي الألباب وكما قال تعالى ومن آياته من أول القرآن إلى آخره فلنذكر كيفية الفكر في بعض الآيات فمن آياته الإنسان المخلوق من النطفة وأقرب شيء إليك نفسك وفيك من العجائب الدالة على عظمة الله تعالى ما تنقضي الأعمار في الوقوف على عشر عشيره وأنت غافل عنه فيامن هو غافل عن نفسه وجاهل بها كيف تطمع في معرفة غيرك وقد أمرك الله تعالى بالتدبر في نفسك في كتابه العزيز فقال وفي أنفسكم أفلا تبصرون وذكر أنك مخلوق من نطفة قذرة فقال قتل الإنسان ما أكفره من أي شئ خلقه من نطفة خلقه فقدره ثم السبيل يسره ثم أماته فأقبره ثم إذا شاء أنشره وقال تعالى ومن آياته أن خلقكم من تراب ثم إذا أنتم بشر تنتشرون وقال تعالى","english":"We say: Created existents are divided into that whose origin is unknown to us, such that we cannot contemplate it—and how many are the existents we do not know! As God Most High said: {«وَيَخْلُقُ مَا لَا تَعْلَمُونَ»} (And He creates what you do not know — Q. 16:8), and {«سُبْحَانَ الَّذِي خَلَقَ الْأَزْوَاجَ كُلَّهَا مِمَّا تُنبِتُ الْأَرْضُ وَمِنْ أَنفُسِهِمْ وَمِمَّا لَا يَعْلَمُونَ»} (Glory be to Him who created all pairs, of what the earth grows, and of themselves, and of what they do not know — Q. 36:36), and He said: {«وَنُنشِئُكُمْ فِيمَا لَا تَعْلَمُونَ»} (And We raise you up in what you do not know — Q. 56:61). And [it is divided] into that whose origin and general nature are known, but whose detailed particulars are not known—so we are able to contemplate its details.","book_title":"Contemplation","section_title_ar":"Section 1268","section_title_en":"Exposition of the Method of Contemplation upon the Creation of God Most High","section_index":1268,"anchors":"- Root: فكر (f-k-r)\n  * Lisan / Ayn: Core meaning is reflection, deliberation, and the movement of the mind over a matter to arrive at its reality.\n  * Al-Raghib (Mufradat): In theological usage, *tafakkur* is the soul's journey through created things (al-makhlūqāt) to derive knowledge of the Creator—it is the bridge from the sensory to the intelligible.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense is mental consideration; metaphorical (majāz) extension applies it to the heart's \"seeing\" of divine wisdom latent in creation.\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Root meaning is measuring, proportioning, and fashioning a thing with precise estimation.\n  * Al-Raghib (Mufradat): *Khalq* denotes origination from nothing (ibdāʿ) or creation of one thing from another, always upon a measure necessitated by wisdom.\n  * Al-Zamakhshari (Asas): Literal: the artisan's sizing of material before cutting; Metaphorical: God's bringing things into existence upon a measure that wisdom dictates—He is Rabb al-khalīqah.\n- Root: بصر (b-ṣ-r)\n  * Lisan / Ayn: Core meaning is sight, both ocular and perceptive.\n  * Al-Raghib (Mufradat): *Baṣar* applies to the eye's organ and its power, and to the heart's perceptive faculty (*baṣīrah*), as in {«فَكَشَفْنَا عَنكَ غِطَاءَكَ فَبَصَرُكَ الْيَوْمَ حَدِيدٌ»} (Q. 50:22).\n  * Al-Zamakhshari (Asas): Literal: physical sight; Metaphorical: *ibṣār* as intellectual discernment—\"هذه آية مبصرة\" (this is an illuminating sign).\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: Core meaning is the self, the soul, the vital principle.\n  * Al-Raghib (Mufradat): *Nafs* denotes the rational soul (al-rūḥ) and also the very essence (al-dhāt); in {«وَفِي أَنفُسِكُمْ أَفَلَا تُبْصِرُونَ»} (Q. 51:21) it refers to the human self as a microcosmic sign.\n  * Al-Zamakhshari (Asas): Literal: the self as animate entity; Metaphorical: the inner dimension of man as a locus of divine signs.\n- Sibawayh Rule: Rule of Specification and Restriction (Bāb al-Takhṣīṣ) — When a general term (like \"everything in existence\") is followed by a restrictive clause (\"save God\"), the syntax governs the scope of predication, ensuring the exception is precise and the universal claim is bounded.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'","badge":"Insight"},{"arabic":"ربي وأصدق الحديث حديثه وأصدق الكلام كلامه ثم قرأ وما خلقنا السموات والأرض وما بينهما لاعبين ما خلقناهما إلا بالحق ولكن أكثرهم لا يعلمون حتى انتهى إلى قوله إنه هو العزيز الرحيم فشهق شهقة ظننت أنه قد غشي عليه ثم قال يا ابن حيان مات أبوك حيان وتوشك أن تموت فإما إلى جنة وإما إلى نار ومات أبوك آدم وماتت أمك حواء ومات نوح ومات إبراهيم خليل الرحمن ومات موسى نجى الرحمن ومات داود خليفة الرحمن ومات محمد صلى الله عليه وسلم وهو رسول رب العالمين ومات أبو بكر خليفة المسلمين ومات عمر بن الخطاب أخي وصفي ثم قال يا عمراه يا عمراه قال فقلت رحمك الله إن","english":"And the gatherings of passion are five matters, which are what Allah, the Exalted, has gathered in His saying: {إنما الحياة الدنيا لعب ولهو وزينة وتفاخر بينكم وتكاثر في الأموال والأولاد} — \"The life of this world is but play and diversion and adornment and boasting among yourselves and increase in wealth and children\" (57:20). And the corporeal entities (al-aʿyān) from which these five are obtained are seven, gathered by His saying, the Exalted: {زين للناس حب الشهوات من النساء والبنين والقناطير المقنطرة من الذهب والفضة والخيل المسومة والأنعام والحرث ذلك متاع الحياة الدنيا} — \"Adorned for mankind is the love of desires — of women and sons and heaped-up treasures of gold and silver and branded horses and cattle and tillage. That is the enjoyment of the life of this world\" (3:14).","book_title":"Contemplation","section_title_ar":"Section 744","section_title_en":"The Discipline of the Soul and the Restraint of the Passions — The Life of Uways al-Qarani and the True Boundary of the Worldly Life","section_index":744,"anchors":"- Root: ن-ه-ي (N-H-Y)\n  * Lisan / Ayn: \"نهاه عنه نهياً: كفّه وردّه عنه. والنهي: خلاف الأمر.\"\n  * Al-Raghib (Mufradat): \"النهي: الزجر عن الشيء، ويستعمل في الكفّ عن الفعل. قال تعالى: {ونهى النفس عن الهوى} — أي: كفّها وزجرها عن متابعة الشهوات.\"\n  * Al-Zamakhshari (Asas): \"نهاه عن كذا: كفّه. ومنه: انتهى عن الأمر إذا كفّ نفسه. والتناهي: التوقف عند الحد.\"\n- Root: ه-و-ي (H-W-Y)\n  * Lisan / Ayn: \"الهوى: ميل النفس إلى الشهوة. وهويته: أحببته. والهوى: ما تهواه النفس وتنزع إليه من غير هدى.\"\n  * Al-Raghib (Mufradat): \"الهوى: ميل النفس إلى ما تشتهيه، ويذمّ إذا لم يكن بعقل وشرع. قال تعالى: {أفرأيت من اتخذ إلهه هواه}.\"\n  * Al-Zamakhshari (Asas): \"هويته: أحببته. وهوًى: سقط. والهوى: اسم لما تهواه النفس من غير رشد. وقد غلب في الشرع على الميل المذموم.\"\n- Root: د-ن-و (D-N-W)\n  * Lisan / Ayn: \"دنا يدنو دنواً: قرب. والدنيا: نقيض الآخرة، سميت بذلك لدنوّها وتقدّمها.\"\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات أو بالحكم. والدنيا: الحياة العاجلة، سميت دنيا لدنوّها من الإنسان أو لتأخر الآخرة عنها.\"\n  * Al-Zamakhshari (Asas): \"الدنيا: الحاضرة العاجلة. وتقول: هو من أهل الدنيا إذا كان مقبلاً على شهواتها.\"\n- Root: ن-ف-س (N-F-S)\n  * Lisan / Ayn: \"النفس: الروح، والذات. ونفس الشيء: عينه. والنفس: الدم. والنفيس: الثمين.\"\n  * Al-Raghib (Mufradat): \"النفس: الروح، وتستعمل للذات. قال تعالى: {ويحذركم الله نفسه} أي: ذاته. وقد تكون النفس بمعنى الهوى والشهوة.\"\n  * Al-Zamakhshari (Asas): \"نفس الشيء: عينه وذاته. وأنفس الشيء: صار نفيساً. ومن المجاز: نفس عن كذا أي: فرّج عنه.\"\n- Sibawayh Rule: باب الفصل بين المبتدأ والخبر (Interposition between Subject and Predicate) — The periodic structure allows for extended parenthetical insertions between the subject and its predicate, as in the long narrative sequences here, where the subject (أويس) is introduced and its predicate follows after extensive descriptive clauses.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Contemplation'","badge":"Afterlife"}],"42":[{"arabic":"فقال يا رسول الله أهكذا يكون قال نعم والذي نفسي بيده إلا من رحم الله قال فوالذي بعثك بالحق لا أعمل على شيء أبدا (1) وقال صلى الله عليه وسلم إني لا أخاف عليكم أن تشركوا بعدي إنما أخاف عليكم أن تنافسوا (2) وإنما خاف التنافس في المآل ولذلك قال عمر رضي الله عنه في حديث طويل يذكر فيه مال بيت المال إني لم أجد نفسي فيه إلا كالوالى مال اليتيم إن استغنيت استعففت وإن افتقرت أكلت بالمعروف وروي أن ابنا لطاوس افتعل كتابا عن لسانه إلى عمر بن عبد العزيز فأعطاه ثلثمائة دينار فباع طاوس ضيعة له وبعث من ثمنها إلى عمر بثلثمائة دينا","english":"Ibn Abī Thābit said: \"I indeed saw the gift of al-Mukhtār to Ibn ʿUmar and Ibn ʿAbbās, and they both accepted it.\" It was said: \"What was it?\" He said: \"Wealth and clothing.\"","book_title":"The Lawful and Prohibited","section_title_ar":"Section 385","section_title_en":"On the Permissibility of Accepting Gifts from Tyrannical Rulers — The Evidences of the Permissive School and the Refutation","section_index":385,"anchors":"- Root: قبل (qabila)\n  * Lisan / Ayn: To accept, receive, take what is offered; acceptance with the hand or with assent.\n  * Al-Raghib (Mufradat): Acceptance (qubūl) in the theological sense implies receiving what is due or permissible without transgression; its opposite is rejection (radd).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): taking hold of something offered. Metaphorical (majāz): assenting to a claim or gift.\n- Root: ظلم (ẓalama)\n  * Lisan / Ayn: To place something in other than its proper place; darkness; wrongdoing.\n  * Al-Raghib (Mufradat): Ẓulm is the act of transgression against another's right; its root meaning connects to darkness (ẓulmah), as injustice obscures truth.\n  * Al-Zamakhshari (Asas): Literal: deprivation of right. Metaphorical: the tyrant (ẓālim) is one who acts in darkness of judgment; \"the ẓālim is in the meaning of the usurer\" — a legal analogy (qiyās).\n- Root: وزر (wizr)\n  * Lisan / Ayn: Burden, heavy load; sin as a burden carried on the back.\n  * Al-Raghib (Mufradat): The sin (wizr) is that which weighs down the soul; the one who bears it carries its consequence.\n  * Al-Zamakhshari (Asas): Literal: a heavy load. Metaphorical: the burden of transgression borne by the wrongdoer alone.\n- Root: ورع (wariʿa)\n  * Lisan / Ayn: To abstain, refrain from what is doubtful or forbidden; scrupulous piety.\n  * Al-Raghib (Mufradat): Waraʿ is the abstention of the soul from what is not clearly permissible, a station above mere lawfulness.\n  * Al-Zamakhshari (Asas): Literal: keeping away from filth. Metaphorical: the scrupulous one (wariʿ) keeps his religion pure from doubtful gains.\n- Sibawayh Rule: Bāb al-ḥaṣr wa al-taqyīd bi-innamā (Restriction and Focused Predication) — The particle innamā restricts the predicate to the subject alone, as in \"their abstention does not indicate prohibition but rather scrupulousness,\" delimiting the cause.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'The Lawful and Prohibited'","badge":"Insight"}],"49":[{"arabic":"العذاب الشديد وينكسونه في قعر الجحيم ويقولون له {ذق إنك أنت العزيز الكريم} فأسكنوا دارا ضيقة الأرجاء مظلمة المسالك مبهمة المهالك يخلد فيها الأسير ويوقد فيها السعير شرابهم فيها الحميم ومستقرهم الجحيم الزبانية تقمعهم والهاوية تجمعهم أمانيهم فيها الهلاك وما لهم منها فكاك قد شدت أقدامهم إلى النواصي واسودت وجوههم من ظلمة المعاصي ينادون من أكنافها ويصيحون في نواحيها وأطرافها يا مالك قد حق علينا الوعيد يا مالك قد أثقلنا الحديد يا مالك قد نضجت منا الجلود يا مالك أخرجنا منها فإنا لا نعود فتقول الزبانية هيهات لات حين أمان","english":"O you who are heedless of your own soul, deluded by what occupies you of the distractions of this world that is on the verge of passing away and perishing — abandon reflection upon that from which you are departing, and turn your thought to your place of arrival (mawrid), for you have been informed that the Fire is a place of arrival for all, since it was said: {«وإن منكم إلا واردها كان على ربك حتما مقضيا ثم ننجي الذين اتقوا ونذر الظالمين فيها جثيا»} [And there is none of you but shall arrive at it — an inevitability decreed upon your Lord. Then We shall save those who were God-fearing, and leave the wrongdoers in it, kneeling]. You are thus in certainty regarding the arrival (wurūd), and in doubt regarding deliverance. So instill within your heart the terror of that place of arrival — perhaps you will thereby prepare yourself for deliverance from it.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1348","section_title_en":"Discourse on the Attributes of Hellfire, Its Terrors, and Its Fetters","section_index":1348,"anchors":"- Root: ورد (w-r-d)\n  * Lisan / Ayn: Core meaning is \"to arrive at water\" — the primordial act of approaching a watering-place; from this derives the sense of arriving at any destination, whether desired or dreaded.\n  * Al-Raghib (Mufradat): \"الورود أصله: قصد الماء\" — its origin is the intent to reach water; then applied generally, and used of the Fire \"على سبيل الفظاعة\" (by way of horrification), as in {وإن منكم إلا واردها} — the universal \"arrival\" at Hell is a divinely decreed certainty.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): ورد الماء — arriving at water to drink. Metaphorical (Majaz): وردت البلد — arriving at a land; ورد عليه أمر لم يطقه — an overwhelming matter descended upon him. Here, \"al-wurūd\" is majaz extended to the eschatological \"arrival\" at the Fire, a passage all must undergo.\n- Root: جلد (j-l-d)\n  * Lisan / Ayn: The skin or hide covering the body; جلد الكتاب — to cover a book with leather; جلدته بالسياط — to flog.\n  * Al-Raghib (Mufradat): \"الجلد: قشر البدن\" — the skin is the body's integument; in the Quranic verse {كلما نضجت جلودهم بدلناهم جلودا غيرها} [النساء/56], the renewal of skins is the renewal of the seat of pain, ensuring perpetual sensation.\n  * Al-Zamakhshari (Asas): Literal: flaying, covering, stripping. Metaphorical: جلدته على هذا الأمر — compelled him. In this text, the literal sense governs: skins roasted, then replaced, so that torment never ceases.\n- Root: ظلم (z-l-m)\n  * Lisan / Ayn: Darkness, absence of light; also wrongdoing. The lexicographers note the moral-ontological link: injustice is a kind of darkness.\n  * Al-Raghib (Mufradat): \"الظلمة: عدم النور\" — darkness is the privation of light; used metaphorically for ignorance, polytheism, and transgression, as light is used for their opposites.\n  * Al-Zamakhshari (Asas): Literal: \"الظلم ظلمات يوم القيامة\" — wrongdoing is darknesses on the Day of Resurrection. Metaphorical: أرض مظلومة — land never before dug. Here, \"zulumāt\" (ظلمات) is used literally of Hell's physical darknesses, yet these are also the reified shadows of the inmates' own wrongs.\n- Root: نار (n-w-r / n-w-r)\n  * Lisan / Ayn: Fire; the root also yields نار — to kindle, to blaze up. The lexicons record the proverb: ورَيْتُ بك زنادي — \"I struck fire from your flint,\" i.e., I perceived from you good counsel.\n  * Al-Raghib (Al-Mufradat): Fire is the elemental reality of Hell, but its Quranic usage spans both physical flame and the \"Fire of God kindled\" which mounts over hearts [الهمزة/6-7] — the inward fire of heedlessness made outward.\n  * Al-Zamakhshari (Asas): Literal: flame, burning. Metaphorical: نار الحرب — the fire of war. In this passage, the literal fire of Jahannam is described with maximal sensory concreteness, yet it remains the outward manifestation of the soul's own kindled crimes.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the permissibility of interposing elements between a preposition and its object when the intervening phrase is semantically complete. Applied here in the periodic constructions where long descriptive clauses intervene between the initial vocative (يا أيها الغافل) and its eventual predicate, sustaining rhetorical tension across the entire passage.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"}],"51":[{"arabic":"كأمثال اللؤلؤ المكنون جزاء بما كانوا يعملون في مقام أمين في جنات وعيون في جنات ونهر في مقعد صدق عند مليك مقتدر ينظرون فيها إلى وجه الملك الكريم وقد أشرقت في وجوههم نضرة النعيم لا يرهقهم فتر ولا ذلة بل عباد مكرمون وبأنواع التحف من ربهم يتعاهدون فهم فيما اشتهيت أنفسهم خالدون لا يخافون فيها ولا يحزنون وهم من ريب المنون آمنون فهم فيها يتنعمون ويأكلون من أطعمتها ويشربون من أنهارها لبنا وخمرا وعسلا في أنهار أراضيها من فضة وحصباؤها مرجان وعلى أرض ترابها مسك أذفر ونباتها زعفران ويمطرون من سحاب فيها من ماء النسرين على كثب","english":"For God Most High has said: {«إن الأبرار لفي نعيم وإن الفجار لفي جحيم»} — \"Indeed the righteous are in bliss, and indeed the wicked are in Hellfire.\" So present yourself before these two verses, and you will have known your resting-place between the two abodes. And God knows best.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1351","section_title_en":"Section 1351 — On the Description of Paradise and the Varieties of Its Bliss","section_index":1351,"anchors":"- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Core root denotes softness, ease, and pleasant living; al-Ayn notes it among names of the leopard and tiger, while Lisan records \"Nuʿm\" as a proper name.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — niʿmah is the excellent state/condition one inhabits; niʿīm is the experience of delight. The verse {«إن الأبرار لفي نعيم»} designates the abiding state of bliss as a settled condition, not a transient act.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"في النعمة والنعيم\" — dwelling in bounty and bliss. Metaphorical (Majaz): \"خفت نعامتهم: ذهبوا\" — ostriches departing; here the root's literal sense of softness is transfigured into the theological state of perpetual ease, free from all harshness.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: Core root: face, front, direction; al-Ayn cites \"وجه الصواب\" — the face/course of correctness.\n  * Al-Raghib (Mufradat): The face is the noblest part of the outward body, hence used for the essence (al-dhāt) of a thing; in {«ويبقى وجه ربك ذو الجلال والإكرام»} it signifies the Divine Essence. Here \"وجه الملك الكريم\" — the Face of the Generous King — denotes the Beatific Vision of God's Essence, not a corporeal organ.\n  * Al-Zamakhshari (Asas): Literal: physical face. Metaphorical: \"وجه القوم، وهؤلاء وجوه البلد\" — the foremost, noblest of a people; thus the \"face\" of the King is His most august presence.\n- Root: مرج (m-r-j)\n  * Lisan / Ayn: Core root: mixing, confusion, letting loose; al-Ayn: \"المرج: الشهد\" — also pure honey; Lisan: \"مرج أمرهم: اختلط\" — their affair became disordered.\n  * Al-Raghib (Mufradat): \"أصل المرج: الخلط\" — mixing; \"أمر مريج\" — a confused affair (Q. 50:5). In this text, the rivers of Paradise \"مطردة\" (flowing) are not \"ممرجة\" (mixed/confused) — rather they run pure and distinct, each in its channel.\n  * Al-Zamakhshari (Asas): Literal: \"مرج الدواب: أرسلها في المرج\" — releasing beasts into pasture. Metaphorical: \"مرج الله البحرين\" — God let the two seas flow freely; \"مرجت عهودهم\" — covenants became disordered. The contrast sharpens the purity of Paradise's rivers.\n- Root: امن (a-m-n)\n  * Lisan / Ayn: Core root: safety, freedom from fear; al-Ayn treats it under the hamzah chapter as the state of security.\n  * Al-Raghib (Mufradat): \"أصل الأمن: طمأنينة النفس وزوال الخوف\" — tranquility of the soul and removal of fear. In the Hereafter, \"آمنون\" is not mere absence of threat but the positive, settled peace of the soul in the Divine presence.\n  * Al-Zamakhshari (Asas): Literal: \"أمنته وآمننيه\" — to grant safety. Metaphorical: \"فرس أمين القوى\" — a horse whose strength is trustworthy; here the blessed are \"آمنون من ريب المنون\" — secure from the vicissitudes of fate, a security that is trustworthy and unbreachable.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule permits separation between a preposition and its object by an element upon which speech may properly pause, as in \"إن به لضرًا\" — here \"فهم فيما اشتهت أنفسهم خالدون\" (in what their souls desire, abiding eternally) interposes the clause of desire between the prepositional phrase and its predicate, heightening rhetorical emphasis on the soul's fulfillment.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"}]},"wordTiming":{"abdulbasit":{"1":[[1,350,3502]],"2":[[1,250,1774],[2,1774,3156]],"3":[[1,400,2882],[2,2882,5011],[3,5011,5805],[4,5805,7171],[5,7171,9348],[6,9348,11016],[7,11016,12621],[8,12621,14718]],"4":[[1,350,1483],[2,1483,2548],[3,2548,3171],[4,3171,3896],[5,3896,4939]],"5":[[1,400,1721],[2,1721,2671],[3,2671,4972],[4,4972,6417],[5,6417,7807],[6,7807,9624]],"6":[[1,400,1380],[2,1380,2247],[3,2247,3377],[4,3377,4520],[5,4520,5123],[6,5123,6863],[7,6863,8370]],"7":[[1,400,1123],[2,1123,3287],[3,3287,4944],[4,4944,6023],[5,6023,8538],[6,8538,9117],[7,9117,10169],[8,10169,12445]],"8":[[1,400,1677],[2,1677,2593],[3,2593,3719],[4,3719,4313],[5,4313,5328],[6,5328,6937],[7,6937,8113],[8,8113,9165],[9,9165,11853],[10,11853,13986]],"9":[[1,350,968],[2,968,1555],[3,1555,2327],[4,2327,3238],[5,3238,5461]],"10":[[1,400,1656],[2,1656,2530],[3,2530,3557],[4,3557,5564],[5,5564,6809],[6,6809,8109]],"11":[[1,350,1657],[2,1657,3248],[3,3248,4269],[4,4269,5478],[5,5478,6637]],"12":[[1,400,1720],[2,1720,2477],[3,2477,3613],[4,3613,4954],[5,4954,6090],[6,6090,7560]],"13":[[1,400,1894],[2,1894,2610],[3,2610,4493],[4,4493,5469],[5,5469,7410],[6,7410,8546],[7,8546,10016]],"14":[[1,400,1216],[2,1216,2906],[3,2906,3619],[4,3619,5550],[5,5550,6688],[6,6688,8344]],"15":[[1,400,1793],[2,1793,3889],[3,3889,5534],[4,5534,7205],[5,7205,8704],[6,8704,11400]],"16":[[1,400,1423],[2,1423,2638],[3,2638,4153],[4,4153,6314],[5,6314,7656],[6,7656,9624]],"17":[[1,400,1746],[2,1746,3391],[3,3391,4845],[4,4845,5851],[5,5851,7401],[6,7401,9946],[7,9946,11197],[8,11197,12419]],"18":[[1,400,1047],[2,1047,3532],[3,3532,4951],[4,4951,6362],[5,6362,7523],[6,7523,9037],[7,9037,9919],[8,9919,11272],[9,11272,12654]],"19":[[1,400,1436],[2,1436,2374],[3,2374,4138],[4,4138,5174],[5,5174,6280],[6,6280,8394],[7,8394,10326],[8,10326,12057],[9,12057,13725]],"20":[[1,400,2337],[2,2337,3298],[3,3298,4827],[4,4827,6647],[5,6647,7288],[6,7288,9180]],"21":[[1,350,1111],[2,1111,1676],[3,1676,3198],[4,3198,3712],[5,3712,5357]],"22":[[1,400,1875],[2,1875,3439],[3,3439,4560],[4,4560,7509],[5,7509,8646],[6,8646,11165]],"23":[[1,400,1497],[2,1497,3359],[3,3359,4660],[4,4660,6101],[5,6101,8370]],"24":[[1,400,1759],[2,1759,3005],[3,3005,4421],[4,4421,5993],[5,5993,6843],[6,6843,9180]],"25":[[1,350,917],[2,917,2647],[3,2647,3214],[4,3214,4893],[5,4893,6794]],"26":[[1,350,2281],