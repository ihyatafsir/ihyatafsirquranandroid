", "root": ""}], "narration": "warsh"}, {"surah": 93, "ayah": 6, "text": "أَلَمْ يَجِدْكَ يَتِيماࣰ فَـَٔاو۪يٰ", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَجِدْكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَتِيماࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَـَٔاو۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 93, "ayah": 7, "text": "وَوَجَدَكَ ضَآلّاࣰ فَهَد۪يٰ", "words": [{"id": 1, "arabic": "وَوَجَدَكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "ضَآلّاࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَهَد۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 93, "ayah": 8, "text": "وَوَجَدَكَ عَآئِلاࣰ فَأَغْن۪يٰۖ", "words": [{"id": 1, "arabic": "وَوَجَدَكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَآئِلاࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَأَغْن۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 93, "ayah": 9, "text": "فَأَمَّا اَ۬لْيَتِيمَ فَلَا تَقْهَرْۖ", "words": [{"id": 1, "arabic": "فَأَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْيَتِيمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 4, "arabic": "تَقْهَرْۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 93, "ayah": 10, "text": "وَأَمَّا اَ۬لسَّآئِلَ فَلَا تَنْهَرْۖ", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لسَّآئِلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 4, "arabic": "تَنْهَرْۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 93, "ayah": 11, "text": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثَۖ", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "بِنِعْمَةِ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَحَدِّثَۖ", "tran