ah":13,"text":"لَّوْلَا جَآءُو عَلَيْهِ بِأَرْبَعَةِ شُهَدَآءَۚ فَإِذْ لَمْ يَأْتُوا۟ بِٱلشُّهَدَآءِ فَأُو۟لَٰٓئِكَ عِندَ ٱللَّهِ هُمُ ٱلْكَٰذِبُونَ ","translation":"Why did they [who slandered] not produce for it four witnesses? And when they do not produce the witnesses, then it is they, in the sight of Allāh, who are the liars.","words":[{"id":1,"arabic":"لَّوْلَا","translit":"āَlْwَّl","root":""},{"id":2,"arabic":"جَآءُو","translit":"wُءٓāَjg","root":"جيا"},{"id":3,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":4,"arabic":"بِأَرْبَعَةِ","translit":"ِẗَʿعَbْrَaʾِb","root":"ربع"},{"id":5,"arabic":"شُهَدَآءَ","translit":"َءٓāَdَhُhs","root":"شهد"},{"id":6,"arabic":"فَإِذْ","translit":"ْhdِiʾَf","root":""},{"id":7,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":8,"arabic":"يَأْتُوا۟","translit":"۟āwُtْaʾَy","root":"اتي"},{"id":9,"arabic":"بِٱلشُّهَدَآءِ","translit":"ِءٓāَdَhُّhslٱِb","root":"شهد"},{"id":10,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":11,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":12,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":13,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":14,"arabic":"ٱلْكَٰذِبُونَ","translit":"َnwُbِhdَٰkْlٱ","root":"كذب"}],"hasIhya":false},{"ayah":14,"text":"وَلَوْلَا فَضْلُ ٱللَّهِ عَلَيْكُمْ وَرَحْمَتُهُۥ فِى ٱلدُّنْيَا وَٱلْءَاخِرَةِ لَمَسَّكُمْ فِى مَآ أَفَضْتُمْ فِيهِ عَذَابٌ عَظِيمٌ ","translation":"And if it had not been for the favor of Allāh upon you and His mercy in this world and the Hereafter, you would have been touched for that [lie] in which you were involved by a great punishment","words":[{"id":1,"arabic":"وَلَوْلَا","translit":"āَlْwَlَw","root":""},{"id":2,"arabic":"فَضْلُ","translit":"ُlْḍَf","root":"فضل"},{"id":3,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":4,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":5,"arabic":"وَرَحْمَتُهُۥ","translit":"ۥُhُtَmْḥَrَw","root":"رحم"},{"id":6,"arabic":"فِى","translit":"àِf","root":""},{"id":7,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":8,"arabic":"وَٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱَw","root":"اخر"},{"id":9,"arabic":"لَمَسَّكُمْ","translit":"ْmُkَّsَmَl","root":"مسس"},{"id":10,"arabic":"فِى","translit":"àِf","root":""},{"id":11,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":12,"arabic":"أَفَضْتُمْ","translit":"ْmُtْḍَfَaʾ","root":"فيض"},{"id":13,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":14,"arabic":"عَذَابٌ","translit":"ٌbāَhdَʿع","root":"عذب"},{"id":15,"arabic":"عَظِيمٌ","translit":"ٌmyِẓَʿع","root":"عظم"}],"hasIhya":false},{"ayah":15,"text":"إِذْ تَلَقَّوْنَهُۥ بِأَلْسِنَتِكُمْ وَتَقُولُونَ بِأَفْوَاهِكُم مَّا لَيْسَ لَكُم بِهِۦ عِلْمٌ وَتَحْسَبُونَهُۥ هَيِّنًا وَهُوَ عِندَ ٱللَّهِ عَظِيمٌ ","translation":"When you received it with your tongues[1] and said with your mouths that of which you had no knowledge and thought it was insignificant while it was, in the sight of Allāh, tremendous.","words":[{"id":1,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":2,"arabic":"تَلَقَّوْنَهُۥ","translit":"ۥُhَnْwَّqَlَt","root":"لقي"},{"id":3,"arabic":"بِأَلْسِنَتِكُمْ","translit":"ْmُkِtَnِsْlَaʾِb","root":"لسن"},{"id":4,"arabic":"وَتَقُولُونَ","translit":"َnwُlwُqَtَw","root":"قول"},{"id":5,"arabic":"بِأَفْوَاهِكُم","translit":"mُkِhāَwْfَaʾِb","root":"فوه"},{"id":6,"arabic":"مَّا","translit":"āَّm","root":""},{"id":7,"arabic":"لَيْسَ","translit":"َsْyَl","root":"ليس"},{"id":8,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":9,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":10,"arabic":"عِلْمٌ","translit":"ٌmْlِʿع","root":"علم"},{"id":11,"arabic":"وَتَحْسَبُونَهُۥ","translit":"ۥُhَnwُbَsْḥَtَw","root":"حسب"},{"id":12,"arabic":"هَيِّنًا","translit":"āًnِّyَh","root":"هون"},{"id":13,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":14,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":15,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":16,"arabic":"عَظِيمٌ","translit":"ٌmyِẓَʿع","root":"عظم"}],"hasIhya":true},{"ayah":16,"text":"وَلَوْلَآ إِذْ سَمِعْتُمُوهُ قُلْتُم مَّا يَكُونُ لَنَآ أَن نَّتَكَلَّمَ بِهَٰذَا سُبْحَٰنَكَ هَٰذَا بُهْتَٰنٌ عَظِيمٌ ","translation":"And why, when you heard it, did you not say, \"It is not for us to speak of this. Exalted are You, [O Allāh]; this is a great slander\"?","words":[{"id":1,"arabic":"وَلَوْلَآ","translit":"ٓāَlْwَlَw","root":""},{"id":2,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":3,"arabic":"سَمِعْتُمُوهُ","translit":"ُhwُmُtْʿعِmَs","root":"سمع"},{"id":4,"arabic":"قُلْتُم","translit":"mُtْlُq","root":"قول"},{"id":5,"arabic":"مَّا","translit":"āَّm","root":""},{"id":6,"arabic":"يَكُونُ","translit":"ُnwُkَy","root":"كون"},{"id":7,"arabic":"لَنَآ","translit":"ٓāَnَl","root":""},{"id":8,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":9,"arabic":"نَّتَكَلَّمَ","translit":"َmَّlَkَtَّn","root":"كلم"},{"id":10,"arabic":"بِهَٰذَا","translit":"āَhdَٰhِb","root":""},{"id":11,"arabic":"سُبْحَٰنَكَ","translit":"َkَnَٰḥْbُs","root":"سبح"},{"id":12,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":13,"arabic":"بُهْتَٰنٌ","translit":"ٌnَٰtْhُb","root":"بهت"},{"id":14,"arabic":"عَظِيمٌ","translit":"ٌmyِẓَʿع","root":"عظم"}],"hasIhya":false},{"ayah":17,"text":"يَعِظُكُمُ ٱللَّهُ أَن تَعُودُوا۟ لِمِثْلِهِۦٓ أَبَدًا إِن كُنتُم مُّؤْمِنِينَ ","translation":"Allāh warns you against returning to the likes of this [conduct], ever, if you should be believers.","words":[{"id":1,"arabic":"يَعِظُكُمُ","translit":"ُmُkُẓِʿعَy","root":"وعظ"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":4,"arabic":"تَعُودُوا۟","translit":"۟āwُdwُʿعَt","root":"عود"},{"id":5,"arabic":"لِمِثْلِهِۦٓ","translit":"ٓۦِhِlْhtِmِl","root":"مثل"},{"id":6,"arabic":"أَبَدًا","translit":"āًdَbَaʾ","root":"ابد"},{"id":7,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":8,"arabic":"كُنتُم","translit":"mُtnُk","root":"كون"},{"id":9,"arabic":"مُّؤْمِنِينَ","translit":"َnyِnِmْwʾُّm","root":"امن"}],"hasIhya":false},{"ayah":18,"text":"وَيُبَيِّنُ ٱللَّهُ لَكُمُ ٱلْءَايَٰتِۚ وَٱللَّهُ عَلِيمٌ حَكِيمٌ ","translation":"And Allāh makes clear to you the verses [i.e., His rulings], and Allāh is Knowing and Wise.","words":[{"id":1,"arabic":"وَيُبَيِّنُ","translit":"ُnِّyَbُyَw","root":"بين"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"لَكُمُ","translit":"ُmُkَl","root":""},{"id":4,"arabic":"ٱلْءَايَٰتِ","translit":"ِtَٰyāَءْlٱ","root":"ايي"},{"id":5,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":6,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"},{"id":7,"arabic":"حَكِيمٌ","translit":"ٌmyِkَḥ","root":"حكم"}],"hasIhya":false},{"ayah":19,"text":"إِنَّ ٱلَّذِينَ يُحِبُّونَ أَن تَشِيعَ ٱلْفَٰحِشَةُ فِى ٱلَّذِينَ ءَامَنُوا۟ لَهُمْ عَذَابٌ أَلِيمٌ فِى ٱلدُّنْيَا وَٱلْءَاخِرَةِۚ وَٱللَّهُ يَعْلَمُ وَأَنتُمْ لَا تَعْلَمُونَ ","translation":"Indeed, those who like that immorality[1] should be spread [or publicized] among those who have believed will have a painful punishment in this world and the Hereafter. And Allāh knows[2] and you do not know.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"يُحِبُّونَ","translit":"َnwُّbِḥُy","root":"حبب"},{"id":4,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":5,"arabic":"تَشِيعَ","translit":"َʿعyِhsَt","root":"شيع"},{"id":6,"arabic":"ٱلْفَٰحِشَةُ","translit":"ُẗَhsِḥَٰfْlٱ","root":"فحش"},{"id":7,"arabic":"فِى","translit":"àِf","root":""},{"id":8,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":9,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":10,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":11,"arabic":"عَذَابٌ","translit":"ٌbāَhdَʿع","root":"عذب"},{"id":12,"arabic":"أَلِيمٌ","translit":"ٌmyِlَaʾ","root":"الم"},{"id":13,"arabic":"فِى","translit":"àِf","root":""},{"id":14,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":15,"arabic":"وَٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱَw","root":"اخر"},{"id":16,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":17,"arabic":"يَعْلَمُ","translit":"ُmَlْʿعَy","root":"علم"},{"id":18,"arabic":"وَأَنتُمْ","translit":"ْmُtnَaʾَw","root":""},{"id":19,"arabic":"لَا","translit":"āَl","root":""},{"id":20,"arabic":"تَعْلَمُونَ","translit":"َnwُmَlْʿعَt","root":"علم"}],"hasIhya":false},{"ayah":20,"text":"وَلَوْلَا فَضْلُ ٱللَّهِ عَلَيْكُمْ وَرَحْمَتُهُۥ وَأَنَّ ٱللَّهَ رَءُوفٌ رَّحِيمٌ ","translation":"And if it had not been for the favor of Allāh upon you and His mercy...[1] and because Allāh is Kind and Merciful.","words":[{"id":1,"arabic":"وَلَوْلَا","translit":"āَlْwَlَw","root":""},{"id":2,"arabic":"فَضْلُ","translit":"ُlْḍَf","root":"فضل"},{"id":3,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":4,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":5,"arabic":"وَرَحْمَتُهُۥ","translit":"ۥُhُtَmْḥَrَw","root":"رحم"},{"id":6,"arabic":"وَأَنَّ","translit":"َّnَaʾَw","root":""},{"id":7,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":8,"arabic":"رَءُوفٌ","translit":"ٌfwُءَr","root":"راف"},{"id":9,"arabic":"رَّحِيمٌ","translit":"ٌmyِḥَّr","root":"رحم"}],"hasIhya":false},{"ayah":21,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَتَّبِعُوا۟ خُطُوَٰتِ ٱلشَّيْطَٰنِۚ وَمَن يَتَّبِعْ خُطُوَٰتِ ٱلشَّيْطَٰنِ فَإِنَّهُۥ يَأْمُرُ بِٱلْفَحْشَآءِ وَٱلْمُنكَرِۚ وَلَوْلَا فَضْلُ ٱللَّهِ عَلَيْكُمْ وَرَحْمَتُهُۥ مَا زَكَىٰ مِنكُم مِّنْ أَحَدٍ أَبَدًا وَلَٰكِنَّ ٱللَّهَ يُزَكِّى مَن يَشَآءُۗ وَٱللَّهُ سَمِيعٌ عَلِيمٌ ","translation":"O you who have believed, do not follow the footsteps of Satan. And whoever follows the footsteps of Satan - indeed, he enjoins immorality and wrongdoing. And if not for the favor of Allāh upon you and His mercy, not one of you would have been pure, ever, but Allāh purifies whom He wills, and Allāh is Hearing and Knowing.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"تَتَّبِعُوا۟","translit":"۟āwُʿعِbَّtَt","root":"تبع"},{"id":6,"arabic":"خُطُوَٰتِ","translit":"ِtَٰwُṭُhk","root":"خطو"},{"id":7,"arabic":"ٱلشَّيْطَٰنِ","translit":"ِnَٰṭْyَّhslٱ","root":"شطن"},{"id":8,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":9,"arabic":"يَتَّبِعْ","translit":"ْʿعِbَّtَy","root":"تبع"},{"id":10,"arabic":"خُطُوَٰتِ","translit":"ِtَٰwُṭُhk","root":"خطو"},{"id":11,"arabic":"ٱلشَّيْطَٰنِ","translit":"ِnَٰṭْyَّhslٱ","root":"شطن"},{"id":12,"arabic":"فَإِنَّهُۥ","translit":"ۥُhَّnِiʾَf","root":""},{"id":13,"arabic":"يَأْمُرُ","translit":"ُrُmْaʾَy","root":"امر"},{"id":14,"arabic":"بِٱلْفَحْشَآءِ","translit":"ِءٓāَhsْḥَfْlٱِb","root":"فحش"},{"id":15,"arabic":"وَٱلْمُنكَرِ","translit":"ِrَknُmْlٱَw","root":"نكر"},{"id":16,"arabic":"وَلَوْلَا","translit":"āَlْwَlَw","root":""},{"id":17,"arabic":"فَضْلُ","translit":"ُlْḍَf","root":"فضل"},{"id":18,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":19,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":20,"arabic":"وَرَحْمَتُهُۥ","translit":"ۥُhُtَmْḥَrَw","root":"رحم"},{"id":21,"arabic":"مَا","translit":"āَm","root":""},{"id":22,"arabic":"زَكَىٰ","translit":"ٰàَkَz","root":"زكو"},{"id":23,"arabic":"مِنكُم","translit":"mُknِm","root":""},{"id":24,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":25,"arabic":"أَحَدٍ","translit":"ٍdَḥَaʾ","root":"احد"},{"id":26,"arabic":"أَبَدًا","translit":"āًdَbَaʾ","root":"ابد"},{"id":27,"arabic":"وَلَٰكِنَّ","translit":"َّnِkَٰlَw","root":""},{"id":28,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":29,"arabic":"يُزَكِّى","translit":"àِّkَzُy","root":"زكو"},{"id":30,"arabic":"مَن","translit":"nَm","root":""},{"id":31,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":32,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":33,"arabic":"سَمِيعٌ","translit":"ٌʿعyِmَs","root":"سمع"},{"id":34,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"}],"hasIhya":true},{"ayah":22,"text":"وَلَا يَأْتَلِ أُو۟لُوا۟ ٱلْفَضْلِ مِنكُمْ وَٱلسَّعَةِ أَن يُؤْتُوٓا۟ أُو۟لِى ٱلْقُرْبَىٰ وَٱلْمَسَٰكِينَ وَٱلْمُهَٰجِرِينَ فِى سَبِيلِ ٱللَّهِۖ وَلْيَعْفُوا۟ وَلْيَصْفَحُوٓا۟ۗ أَلَا تُحِبُّونَ أَن يَغْفِرَ ٱللَّهُ لَكُمْۗ وَٱللَّهُ غَفُورٌ رَّحِيمٌ ","translation":"And let not those of virtue among you and wealth swear not to give [aid] to their relatives and the needy and the emigrants for the cause of Allāh, and let them pardon and overlook. Would you not like that Allāh should forgive you? And Allāh is Forgiving and Merciful.","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"يَأْتَلِ","translit":"ِlَtْaʾَy","root":"الو"},{"id":3,"arabic":"أُو۟لُوا۟","translit":"۟āwُl۟wُaʾ","root":""},{"id":4,"arabic":"ٱلْفَضْلِ","translit":"ِlْḍَfْlٱ","root":"فضل"},{"id":5,"arabic":"مِنكُمْ","translit":"ْmُknِm","root":""},{"id":6,"arabic":"وَٱلسَّعَةِ","translit":"ِẗَʿعَّslٱَw","root":"وسع"},{"id":7,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":8,"arabic":"يُؤْتُوٓا۟","translit":"۟āٓwُtْwʾُy","root":"اتي"},{"id":9,"arabic":"أُو۟لِى","translit":"àِl۟wُaʾ","root":""},{"id":10,"arabic":"ٱلْقُرْبَىٰ","translit":"ٰàَbْrُqْlٱ","root":"قرب"},{"id":11,"arabic":"وَٱلْمَسَٰكِينَ","translit":"َnyِkَٰsَmْlٱَw","root":"سكن"},{"id":12,"arabic":"وَٱلْمُهَٰجِرِينَ","translit":"َnyِrِjgَٰhُmْlٱَw","root":"هجر"},{"id":13,"arabic":"فِى","translit":"àِf","root":""},{"id":14,"arabic":"سَبِيلِ","translit":"ِlyِbَs","root":"سبل"},{"id":15,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":16,"arabic":"وَلْيَعْفُوا۟","translit":"۟āwُfْʿعَyْlَw","root":"عفو"},{"id":17,"arabic":"وَلْيَصْفَحُوٓا۟","translit":"۟āٓwُḥَfْṣَyْlَw","root":"صفح"},{"id":18,"arabic":"أَلَا","translit":"āَlَaʾ","root":""},{"id":19,"arabic":"تُحِبُّونَ","translit":"َnwُّbِḥُt","root":"حبب"},{"id":20,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":21,"arabic":"يَغْفِرَ","translit":"َrِfْغَy","root":"غفر"},{"id":22,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":23,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":24,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":25,"arabic":"غَفُورٌ","translit":"ٌrwُfَغ","root":"غفر"},{"id":26,"arabic":"رَّحِيمٌ","translit":"ٌmyِḥَّr","root":"رحم"}],"hasIhya":true},{"ayah":23,"text":"إِنَّ ٱلَّذِينَ يَرْمُونَ ٱلْمُحْصَنَٰتِ ٱلْغَٰفِلَٰتِ ٱلْمُؤْمِنَٰتِ لُعِنُوا۟ فِى ٱلدُّنْيَا وَٱلْءَاخِرَةِ وَلَهُمْ عَذَابٌ عَظِيمٌ ","translation":"Indeed, those who [falsely] accuse chaste, unaware and believing women are cursed in this world and the Hereafter; and they will have a great punishment","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"يَرْمُونَ","translit":"َnwُmْrَy","root":"رمي"},{"id":4,"arabic":"ٱلْمُحْصَنَٰتِ","translit":"ِtَٰnَṣْḥُmْlٱ","root":"حصن"},{"id":5,"arabic":"ٱلْغَٰفِلَٰتِ","translit":"ِtَٰlِfَٰغْlٱ","root":"غفل"},{"id":6,"arabic":"ٱلْمُؤْمِنَٰتِ","translit":"ِtَٰnِmْwʾُmْlٱ","root":"امن"},{"id":7,"arabic":"لُعِنُوا۟","translit":"۟āwُnِʿعُl","root":"لعن"},{"id":8,"arabic":"فِى","translit":"àِf","root":""},{"id":9,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":10,"arabic":"وَٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱَw","root":"اخر"},{"id":11,"arabic":"وَلَهُمْ","translit":"ْmُhَlَw","root":""},{"id":12,"arabic":"عَذَابٌ","translit":"ٌbāَhdَʿع","root":"عذب"},{"id":13,"arabic":"عَظِيمٌ","translit":"ٌmyِẓَʿع","root":"عظم"}],"hasIhya":false},{"ayah":24,"text":"يَوْمَ تَشْهَدُ عَلَيْهِمْ أَلْسِنَتُهُمْ وَأَيْدِيهِمْ وَأَرْجُلُهُم بِمَا كَانُوا۟ يَعْمَلُونَ ","translation":"On a Day when their tongues, their hands and their feet will bear witness against them as to what they used to do.","words":[{"id":1,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":2,"arabic":"تَشْهَدُ","translit":"ُdَhْhsَt","root":"شهد"},{"id":3,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":4,"arabic":"أَلْسِنَتُهُمْ","translit":"ْmُhُtَnِsْlَaʾ","root":"لسن"},{"id":5,"arabic":"وَأَيْدِيهِمْ","translit":"ْmِhyِdْyَaʾَw","root":"يدي"},{"id":6,"arabic":"وَأَرْجُلُهُم","translit":"mُhُlُjgْrَaʾَw","root":"رجل"},{"id":7,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":8,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":9,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":false},{"ayah":25,"text":"يَوْمَئِذٍ يُوَفِّيهِمُ ٱللَّهُ دِينَهُمُ ٱلْحَقَّ وَيَعْلَمُونَ أَنَّ ٱللَّهَ هُوَ ٱلْحَقُّ ٱلْمُبِينُ ","translation":"That Day, Allāh will pay them in full their true [i.e., deserved] recompense, and they will know that it is Allāh who is the manifest Truth [i.e., perfect in justice].","words":[{"id":1,"arabic":"يَوْمَئِذٍ","translit":"ٍhdِyʾَmْwَy","root":"يوم"},{"id":2,"arabic":"يُوَفِّيهِمُ","translit":"ُmِhyِّfَwُy","root":"وفي"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"دِينَهُمُ","translit":"ُmُhَnyِd","root":"دين"},{"id":5,"arabic":"ٱلْحَقَّ","translit":"َّqَḥْlٱ","root":"حقق"},{"id":6,"arabic":"وَيَعْلَمُونَ","translit":"َnwُmَlْʿعَyَw","root":"علم"},{"id":7,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":8,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":9,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":10,"arabic":"ٱلْحَقُّ","translit":"ُّqَḥْlٱ","root":"حقق"},{"id":11,"arabic":"ٱلْمُبِينُ","translit":"ُnyِbُmْlٱ","root":"بين"}],"hasIhya":false},{"ayah":26,"text":"ٱلْخَبِيثَٰتُ لِلْخَبِيثِينَ وَٱلْخَبِيثُونَ لِلْخَبِيثَٰتِۖ وَٱلطَّيِّبَٰتُ لِلطَّيِّبِينَ وَٱلطَّيِّبُونَ لِلطَّيِّبَٰتِۚ أُو۟لَٰٓئِكَ مُبَرَّءُونَ مِمَّا يَقُولُونَۖ لَهُم مَّغْفِرَةٌ وَرِزْقٌ كَرِيمٌ ","translation":"Evil words are for evil men, and evil men are [subjected] to evil words. And good words are for good men, and good men are [an object] of good words.[1] Those [good people] are declared innocent of what they [i.e., slanderers] say. For them is forgiveness and noble provision.","words":[{"id":1,"arabic":"ٱلْخَبِيثَٰتُ","translit":"ُtَٰhtyِbَhkْlٱ","root":"خبث"},{"id":2,"arabic":"لِلْخَبِيثِينَ","translit":"َnyِhtyِbَhkْlِl","root":"خبث"},{"id":3,"arabic":"وَٱلْخَبِيثُونَ","translit":"َnwُhtyِbَhkْlٱَw","root":"خبث"},{"id":4,"arabic":"لِلْخَبِيثَٰتِ","translit":"ِtَٰhtyِbَhkْlِl","root":"خبث"},{"id":5,"arabic":"وَٱلطَّيِّبَٰتُ","translit":"ُtَٰbِّyَّṭlٱَw","root":"طيب"},{"id":6,"arabic":"لِلطَّيِّبِينَ","translit":"َnyِbِّyَّṭlِl","root":"طيب"},{"id":7,"arabic":"وَٱلطَّيِّبُونَ","translit":"َnwُbِّyَّṭlٱَw","root":"طيب"},{"id":8,"arabic":"لِلطَّيِّبَٰتِ","translit":"ِtَٰbِّyَّṭlِl","root":"طيب"},{"id":9,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":10,"arabic":"مُبَرَّءُونَ","translit":"َnwُءَّrَbُm","root":"برا"},{"id":11,"arabic":"مِمَّا","translit":"āَّmِm","root":""},{"id":12,"arabic":"يَقُولُونَ","translit":"َnwُlwُqَy","root":"قول"},{"id":13,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":14,"arabic":"مَّغْفِرَةٌ","translit":"ٌẗَrِfْغَّm","root":"غفر"},{"id":15,"arabic":"وَرِزْقٌ","translit":"ٌqْzِrَw","root":"رزق"},{"id":16,"arabic":"كَرِيمٌ","translit":"ٌmyِrَk","root":"كرم"}],"hasIhya":false},{"ayah":27,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَدْخُلُوا۟ بُيُوتًا غَيْرَ بُيُوتِكُمْ حَتَّىٰ تَسْتَأْنِسُوا۟ وَتُسَلِّمُوا۟ عَلَىٰٓ أَهْلِهَاۚ ذَٰلِكُمْ خَيْرٌ لَّكُمْ لَعَلَّكُمْ تَذَكَّرُونَ ","translation":"O you who have believed, do not enter houses other than your own houses until you ascertain welcome and greet[1] their inhabitants. That is best for you; perhaps you will be reminded [i.e., advised].","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"تَدْخُلُوا۟","translit":"۟āwُlُhkْdَt","root":"دخل"},{"id":6,"arabic":"بُيُوتًا","translit":"āًtwُyُb","root":"بيت"},{"id":7,"arabic":"غَيْرَ","translit":"َrْyَغ","root":"غير"},{"id":8,"arabic":"بُيُوتِكُمْ","translit":"ْmُkِtwُyُb","root":"بيت"},{"id":9,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":10,"arabic":"تَسْتَأْنِسُوا۟","translit":"۟āwُsِnْaʾَtْsَt","root":"انس"},{"id":11,"arabic":"وَتُسَلِّمُوا۟","translit":"۟āwُmِّlَsُtَw","root":"سلم"},{"id":12,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":13,"arabic":"أَهْلِهَا","translit":"āَhِlْhَaʾ","root":"اهل"},{"id":14,"arabic":"ذَٰلِكُمْ","translit":"ْmُkِlَٰhd","root":""},{"id":15,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":16,"arabic":"لَّكُمْ","translit":"ْmُkَّl","root":""},{"id":17,"arabic":"لَعَلَّكُمْ","translit":"ْmُkَّlَʿعَl","root":""},{"id":18,"arabic":"تَذَكَّرُونَ","translit":"َnwُrَّkَhdَt","root":"ذكر"}],"hasIhya":true},{"ayah":28,"text":"فَإِن لَّمْ تَجِدُوا۟ فِيهَآ أَحَدًا فَلَا تَدْخُلُوهَا حَتَّىٰ يُؤْذَنَ لَكُمْۖ وَإِن قِيلَ لَكُمُ ٱرْجِعُوا۟ فَٱرْجِعُوا۟ۖ هُوَ أَزْكَىٰ لَكُمْۚ وَٱللَّهُ بِمَا تَعْمَلُونَ عَلِيمٌ ","translation":"And if you do not find anyone therein, do not enter them until permission has been given you. And if it is said to you, \"Go back,\"[1] then go back; it is purer for you. And Allāh is Knowing of what you do.","words":[{"id":1,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":2,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":3,"arabic":"تَجِدُوا۟","translit":"۟āwُdِjgَt","root":"وجد"},{"id":4,"arabic":"فِيهَآ","translit":"ٓāَhyِf","root":""},{"id":5,"arabic":"أَحَدًا","translit":"āًdَḥَaʾ","root":"احد"},{"id":6,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":7,"arabic":"تَدْخُلُوهَا","translit":"āَhwُlُhkْdَt","root":"دخل"},{"id":8,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":9,"arabic":"يُؤْذَنَ","translit":"َnَhdْwʾُy","root":"اذن"},{"id":10,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":11,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":12,"arabic":"قِيلَ","translit":"َlyِq","root":"قول"},{"id":13,"arabic":"لَكُمُ","translit":"ُmُkَl","root":""},{"id":14,"arabic":"ٱرْجِعُوا۟","translit":"۟āwُʿعِjgْrٱ","root":"رجع"},{"id":15,"arabic":"فَٱرْجِعُوا۟","translit":"۟āwُʿعِjgْrٱَf","root":"رجع"},{"id":16,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":17,"arabic":"أَزْكَىٰ","translit":"ٰàَkْzَaʾ","root":"زكو"},{"id":18,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":19,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":20,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":21,"arabic":"تَعْمَلُونَ","translit":"َnwُlَmْʿعَt","root":"عمل"},{"id":22,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"}],"hasIhya":false},{"ayah":29,"text":"لَّيْسَ عَلَيْكُمْ جُنَاحٌ أَن تَدْخُلُوا۟ بُيُوتًا غَيْرَ مَسْكُونَةٍ فِيهَا مَتَٰعٌ لَّكُمْۚ وَٱللَّهُ يَعْلَمُ مَا تُبْدُونَ وَمَا تَكْتُمُونَ ","translation":"There is no blame upon you for entering houses not inhabited in which there is convenience[1] for you. And Allāh knows what you reveal and what you conceal.","words":[{"id":1,"arabic":"لَّيْسَ","translit":"َsْyَّl","root":"ليس"},{"id":2,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":3,"arabic":"جُنَاحٌ","translit":"ٌḥāَnُjg","root":"جنح"},{"id":4,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":5,"arabic":"تَدْخُلُوا۟","translit":"۟āwُlُhkْdَt","root":"دخل"},{"id":6,"arabic":"بُيُوتًا","translit":"āًtwُyُb","root":"بيت"},{"id":7,"arabic":"غَيْرَ","translit":"َrْyَغ","root":"غير"},{"id":8,"arabic":"مَسْكُونَةٍ","translit":"ٍẗَnwُkْsَm","root":"سكن"},{"id":9,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":10,"arabic":"مَتَٰعٌ","translit":"ٌʿعَٰtَm","root":"متع"},{"id":11,"arabic":"لَّكُمْ","translit":"ْmُkَّl","root":""},{"id":12,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":13,"arabic":"يَعْلَمُ","translit":"ُmَlْʿعَy","root":"علم"},{"id":14,"arabic":"مَا","translit":"āَm","root":""},{"id":15,"arabic":"تُبْدُونَ","translit":"َnwُdْbُt","root":"بدو"},{"id":16,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":17,"arabic":"تَكْتُمُونَ","translit":"َnwُmُtْkَt","root":"كتم"}],"hasIhya":false},{"ayah":30,"text":"قُل لِّلْمُؤْمِنِينَ يَغُضُّوا۟ مِنْ أَبْصَٰرِهِمْ وَيَحْفَظُوا۟ فُرُوجَهُمْۚ ذَٰلِكَ أَزْكَىٰ لَهُمْۗ إِنَّ ٱللَّهَ خَبِيرٌۢ بِمَا يَصْنَعُونَ ","translation":"Tell the believing men to reduce [some] of their vision[1] and guard their private parts.[2] That is purer for them. Indeed, Allāh is [fully] Aware of what they do.","words":[{"id":1,"arabic":"قُل","translit":"lُq","root":"قول"},{"id":2,"arabic":"لِّلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlِّl","root":"امن"},{"id":3,"arabic":"يَغُضُّوا۟","translit":"۟āwُّḍُغَy","root":"غضض"},{"id":4,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":5,"arabic":"أَبْصَٰرِهِمْ","translit":"ْmِhِrَٰṣْbَaʾ","root":"بصر"},{"id":6,"arabic":"وَيَحْفَظُوا۟","translit":"۟āwُẓَfْḥَyَw","root":"حفظ"},{"id":7,"arabic":"فُرُوجَهُمْ","translit":"ْmُhَjgwُrُf","root":"فرج"},{"id":8,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":9,"arabic":"أَزْكَىٰ","translit":"ٰàَkْzَaʾ","root":"زكو"},{"id":10,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":11,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":12,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":13,"arabic":"خَبِيرٌۢ","translit":"ٌۢryِbَhk","root":"خبر"},{"id":14,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":15,"arabic":"يَصْنَعُونَ","translit":"َnwُʿعَnْṣَy","root":"صنع"}],"hasIhya":true},{"ayah":31,"text":"وَقُل لِّلْمُؤْمِنَٰتِ يَغْضُضْنَ مِنْ أَبْصَٰرِهِنَّ وَيَحْفَظْنَ فُرُوجَهُنَّ وَلَا يُبْدِينَ زِينَتَهُنَّ إِلَّا مَا ظَهَرَ مِنْهَاۖ وَلْيَضْرِبْنَ بِخُمُرِهِنَّ عَلَىٰ جُيُوبِهِنَّۖ وَلَا يُبْدِينَ زِينَتَهُنَّ إِلَّا لِبُعُولَتِهِنَّ أَوْ ءَابَآئِهِنَّ أَوْ ءَابَآءِ بُعُولَتِهِنَّ أَوْ أَبْنَآئِهِنَّ أَوْ أَبْنَآءِ بُعُولَتِهِنَّ أَوْ إِخْوَٰنِهِنَّ أَوْ بَنِىٓ إِخْوَٰنِهِنَّ أَوْ بَنِىٓ أَخَوَٰتِهِنَّ أَوْ نِسَآئِهِنَّ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُنَّ أَوِ ٱلتَّٰبِعِينَ غَيْرِ أُو۟لِى ٱلْإِرْبَةِ مِنَ ٱلرِّجَالِ أَوِ ٱلطِّفْلِ ٱلَّذِينَ لَمْ يَظْهَرُوا۟ عَلَىٰ عَوْرَٰتِ ٱلنِّسَآءِۖ وَلَا يَضْرِبْنَ بِأَرْجُلِهِنَّ لِيُعْلَمَ مَا يُخْفِينَ مِن زِينَتِهِنَّۚ وَتُوبُوٓا۟ إِلَى ٱللَّهِ جَمِيعًا أَيُّهَ ٱلْمُؤْمِنُونَ لَعَلَّكُمْ تُفْلِحُونَ ","translation":"And tell the believing women to reduce [some] of their vision[1] and guard their private parts and not expose their adornment[2] except that which [necessarily] appears thereof[3] and to wrap [a portion of] their headcovers over their chests and not expose their adornment [i.e., beauty] except to their husbands, their fathers, their husbands' fathers, their sons, their husbands' sons, their brothers, their brothers' sons, their sisters' sons, their women, that which their right hands possess [i.e., slaves], or those male attendants having no physical desire,[4] or children who are not yet aware of the private aspects of women. And let them not stamp their feet to make known what they conceal of their adornment. And turn to Allāh in repentance, all of you, O believers, that you might succeed.","words":[{"id":1,"arabic":"وَقُل","translit":"lُqَw","root":"قول"},{"id":2,"arabic":"لِّلْمُؤْمِنَٰتِ","translit":"ِtَٰnِmْwʾُmْlِّl","root":"امن"},{"id":3,"arabic":"يَغْضُضْنَ","translit":"َnْḍُḍْغَy","root":"غضض"},{"id":4,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":5,"arabic":"أَبْصَٰرِهِنَّ","translit":"َّnِhِrَٰṣْbَaʾ","root":"بصر"},{"id":6,"arabic":"وَيَحْفَظْنَ","translit":"َnْẓَfْḥَyَw","root":"حفظ"},{"id":7,"arabic":"فُرُوجَهُنَّ","translit":"َّnُhَjgwُrُf","root":"فرج"},{"id":8,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":9,"arabic":"يُبْدِينَ","translit":"َnyِdْbُy","root":"بدو"},{"id":10,"arabic":"زِينَتَهُنَّ","translit":"َّnُhَtَnyِz","root":"زين"},{"id":11,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":12,"arabic":"مَا","translit":"āَm","root":""},{"id":13,"arabic":"ظَهَ