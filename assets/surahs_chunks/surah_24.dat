: "اخو"}, {"id": 39, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 40, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 41, "arabic": "أَخَوَٰتِهِنَّ", "translit": "َّnِhِtَٰwَhkَaʾ", "root": "اخو"}, {"id": 42, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 43, "arabic": "نِسَآئِهِنَّ", "translit": "َّnِhِyʾٓāَsِn", "root": "نسو"}, {"id": 44, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 45, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 46, "arabic": "مَلَكَتْ", "translit": "ْtَkَlَm", "root": "ملك"}, {"id": 47, "arabic": "أَيْمَٰنُهُنَّ", "translit": "َّnُhُnَٰmْyَaʾ", "root": "يمن"}, {"id": 48, "arabic": "أَوِ", "translit": "ِwَaʾ", "root": ""}, {"id": 49, "arabic": "ٱلتَّٰبِعِينَ", "translit": "َnyِʿعِbَّٰtlٱ", "root": "تبع"}, {"id": 50, "arabic": "غَيْرِ", "translit": "ِrْyَغ", "root": "غير"}, {"id": 51, "arabic": "أُو۟لِى", "translit": "àِl۟wُaʾ", "root": ""}, {"id": 52, "arabic": "ٱلْإِرْبَةِ", "translit": "ِẗَbْrِiʾْlٱ", "root": "ارب"}, {"id": 53, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 54, "arabic": "ٱلرِّجَالِ", "translit": "ِlāَjgِّrlٱ", "root": "رجل"}, {"id": 55, "arabic": "أَوِ", "translit": "ِwَaʾ", "root": ""}, {"id": 56, "arabic": "ٱلطِّفْلِ", "translit": "ِlْfِّṭlٱ", "root": "طفل"}, {"id": 57, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 58, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 59, "arabic": "يَظْهَرُوا۟", "translit": "۟āwُrَhْẓَy", "root": "ظهر"}, {"id": 60, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 61, "arabic": "عَوْرَٰتِ", "translit": "ِtَٰrْwَʿع", "root": "عور"}, {"id": 62, "arabic": "ٱلنِّسَآءِ", "translit": "ِءٓāَsِّnlٱ", "root": "نسو"}, {"id": 63, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 64, "arabic": "يَضْرِبْنَ", "translit": "َnْbِrْḍَy", "root": "ضرب"}, {"id": 65, "arabic": "بِأَرْجُلِهِنَّ", "translit": "َّnِhِlُjgْrَaʾِb", "root": "رجل"}, {"id": 66, "arabic": "لِيُعْلَمَ", "translit": "َmَlْʿعُyِl", "root": "علم"}, {"id": 67, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 68, "arabic": "يُخْفِينَ", "translit": "َnyِfْhkُy", "root": "خفي"}, {"id": 69, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 70, "arabic": "زِينَتِهِنَّ", "translit": "َّnِhِtَnyِz", "root": "زين"}, {"id": 71, "arabic": "وَتُوبُوٓا۟", "translit": "۟āٓwُbwُtَw", "root": "توب"}, {"id": 72, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 73, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 74, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 75, "arabic": "أَيُّهَ", "translit": "َhُّyَaʾ", "root": "ايي"}, {"id": 76, "arabic": "ٱلْمُؤْمِنُونَ", "translit": "َnwُnِmْwʾُmْlٱ", "root": "امن"}, {"id": 77, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 78, "arabic": "تُفْلِحُونَ", "translit": "َnwُḥِlْfُt", "root": "فلح"}], "hasIhya": true}, {"ayah": 32, "text": "وَأَنكِحُوا۟ ٱلْأَيَٰمَىٰ مِنكُمْ وَٱلصَّٰلِحِينَ مِنْ عِبَادِكُمْ وَإِمَآئِكُمْۚ إِن يَكُونُوا۟ فُقَرَآءَ يُغْنِهِمُ ٱللَّهُ مِن فَضْلِهِۦۗ وَٱللَّهُ وَٰسِعٌ عَلِيمٌ ", "translation": "And marry the unmarried among you and the righteous among your male slaves and female slaves. If they should be poor, Allāh will enrich them from His bounty, and Allāh is all-Encompassing and Knowing.", "words": [{"id": 1, "arabic": "وَأَنكِحُوا۟", "translit": "۟āwُḥِknَaʾَw", "root": "نكح"}, {"id": 2, "arabic": "ٱلْأَيَٰمَىٰ", "translit": "ٰàَmَٰyَaʾْlٱ", "root": "ايم"}, {"id": 3, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 4, "arabic": "وَٱلصَّٰلِحِينَ", "translit": "َnyِḥِlَّٰṣlٱَw", "root": "صلح"}, {"id": 5, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 6, "arabic": "عِبَادِكُمْ", "translit": "ْmُkِdāَbِʿع", "root": "عبد"}, {"id": 7, "arabic": "وَإِمَآئِكُمْ", "translit": "ْmُkِyʾٓāَmِiʾَw", "root": "امو"}, {"id": 8, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 9, "arabic": "يَكُونُوا۟", "translit": "۟āwُnwُkَy", "root": "كون"}, {"id": 10, "arabic": "فُقَرَآءَ", "translit": "َءٓāَrَqُf", "root": "فقر"}, {"id": 11, "arabic": "يُغْنِهِمُ", "translit": "ُmِhِnْغُy", "root": "غني"}, {"id": 12, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "فَضْلِهِۦ", "translit": "ۦِhِlْḍَf", "root": "فضل"}, {"id": 15, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 16, "arabic": "وَٰسِعٌ", "translit": "ٌʿعِsَٰw", "root": "وسع"}, {"id": 17, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 33, "text": "وَلْيَسْتَعْفِفِ ٱلَّذِينَ لَا يَجِدُونَ نِكَاحًا حَتَّىٰ يُغْنِيَهُمُ ٱللَّهُ مِن فَضْلِهِۦۗ وَٱلَّذِينَ يَبْتَغُونَ ٱلْكِتَٰبَ مِمَّا مَلَكَتْ أَيْمَٰنُكُمْ فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًاۖ وَءَاتُوهُم مِّن مَّالِ ٱللَّهِ ٱلَّذِىٓ ءَاتَىٰكُمْۚ وَلَا تُكْرِهُوا۟ فَتَيَٰتِكُمْ عَلَى ٱلْبِغَآءِ إِنْ أَرَدْنَ تَحَصُّنًا لِّتَبْتَغُوا۟ عَرَضَ ٱلْحَيَوٰةِ ٱلدُّنْيَاۚ وَمَن يُكْرِههُّنَّ فَإِنَّ ٱللَّهَ مِنۢ بَعْدِ إِكْرَٰهِهِنَّ غَفُورٌ رَّحِيمٌ ", "translation": "But let them who find not [the means for] marriage abstain [from sexual relations] until Allāh enriches them from His bounty. And those who seek a contract [for eventual emancipation] from among whom your right hands possess[1] - then make a contract with them if you know there is within them goodness and give them from the wealth of Allāh which He has given you. And do not compel your slave girls to prostitution, if they desire chastity, to seek [thereby] the temporary interests of worldly life. And if someone should compel them, then indeed, Allāh is [to them], after their compulsion, Forgiving and Merciful.", "words": [{"id": 1, "arabic": "وَلْيَسْتَعْفِفِ", "translit": "ِfِfْʿعَtْsَyْlَw", "root": "عفف"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يَجِدُونَ", "translit": "َnwُdِjgَy", "root": "وجد"}, {"id": 5, "arabic": "نِكَاحًا", "translit": "āًḥāَkِn", "root": "نكح"}, {"id": 6, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 7, "arabic": "يُغْنِيَهُمُ", "translit": "ُmُhَyِnْغُy", "root": "غني"}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "فَضْلِهِۦ", "translit": "ۦِhِlْḍَf", "root": "فضل"}, {"id": 11, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 12, "arabic": "يَبْتَغُونَ", "translit": "َnwُغَtْbَy", "root": "بغي"}, {"id": 13, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 14, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 15, "arabic": "مَلَكَتْ", "translit": "ْtَkَlَm", "root": "ملك"}, {"id": 16, "arabic": "أَيْمَٰنُكُمْ", "translit": "ْmُkُnَٰmْyَaʾ", "root": "يمن"}, {"id": 17, "arabic": "فَكَاتِبُوهُمْ", "translit": "ْmُhwُbِtāَkَf", "root": "كتب"}, {"id": 18, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 19, "arabic": "عَلِمْتُمْ", "translit": "ْmُtْmِlَʿع", "root": "علم"}, {"id": 20, "arabic": "فِيهِمْ", "translit": "ْmِhyِf", "root": ""}, {"id": 21, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 22, "arabic": "وَءَاتُوهُم", "translit": "mُhwُtāَءَw", "root": "اتي"}, {"id": 23, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 24, "arabic": "مَّالِ", "translit": "ِlāَّm", "root": "مول"}, {"id": 25, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 27, "arabic": "ءَاتَىٰكُمْ", "translit": "ْmُkٰàَtāَء", "root": "اتي"}, {"id": 28, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 29, "arabic": "تُكْرِهُوا۟", "translit": "۟āwُhِrْkُt", "root": "كره"}, {"id": 30, "arabic": "فَتَيَٰتِكُمْ", "translit": "ْmُkِtَٰyَtَf", "root": "فتي"}, {"id": 31, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 32, "arabic": "ٱلْبِغَآءِ", "translit": "ِءٓāَغِbْlٱ", "root": "بغي"}, {"id": 33, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 34, "arabic": "أَرَدْنَ", "translit": "َnْdَrَaʾ", "root": "رود"}, {"id": 35, "arabic": "تَحَصُّنًا", "translit": "āًnُّṣَḥَt", "root": "حصن"}, {"id": 36, "arabic": "لِّتَبْتَغُوا۟", "translit": "۟āwُغَtْbَtِّl", "root": "بغي"}, {"id": 37, "arabic": "عَرَضَ", "translit": "َḍَrَʿع", "root": "عرض"}, {"id": 38, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 39, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 40, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 41, "arabic": "يُكْرِههُّنَّ", "translit": "َّnُّhhِrْkُy", "root": "كره"}, {"id": 42, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 43, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 44, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 45, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 46, "arabic": "إِكْرَٰهِهِنَّ", "translit": "َّnِhِhَٰrْkِiʾ", "root": "كره"}, {"id": 47, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 48, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 34, "text": "وَلَقَدْ أَنزَلْنَآ إِلَيْكُمْ ءَايَٰتٍ مُّبَيِّنَٰتٍ وَمَثَلًا مِّنَ ٱلَّذِينَ خَلَوْا۟ مِن قَبْلِكُمْ وَمَوْعِظَةً لِّلْمُتَّقِينَ ", "translation": "And We have certainly sent down to you distinct verses[1] and examples from those who passed on before you and an admonition for those who fear Allāh.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "أَنزَلْنَآ", "translit": "ٓāَnْlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "إِلَيْكُمْ", "translit": "ْmُkْyَlِiʾ", "root": ""}, {"id": 4, "arabic": "ءَايَٰتٍ", "translit": "ٍtَٰyāَء", "root": "ايي"}, {"id": 5, "arabic": "مُّبَيِّنَٰتٍ", "translit": "ٍtَٰnِّyَbُّm", "root": "بين"}, {"id": 6, "arabic": "وَمَثَلًا", "translit": "āًlَhtَmَw", "root": "مثل"}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "خَلَوْا۟", "translit": "۟āْwَlَhk", "root": "خلو"}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "قَبْلِكُمْ", "translit": "ْmُkِlْbَq", "root": "قبل"}, {"id": 12, "arabic": "وَمَوْعِظَةً", "translit": "ًẗَẓِʿعْwَmَw", "root": "وعظ"}, {"id": 13, "arabic": "لِّلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlِّl", "root": "وقي"}], "hasIhya": false}, {"ayah": 35, "text": "ٱللَّهُ نُورُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ مَثَلُ نُورِهِۦ كَمِشْكَوٰةٍ فِيهَا مِصْبَاحٌۖ ٱلْمِصْبَاحُ فِى زُجَاجَةٍۖ ٱلزُّجَاجَةُ كَأَنَّهَا كَوْكَبٌ دُرِّىٌّ يُوقَدُ مِن شَجَرَةٍ مُّبَٰرَكَةٍ زَيْتُونَةٍ لَّا شَرْقِيَّةٍ وَلَا غَرْبِيَّةٍ يَكَادُ زَيْتُهَا يُضِىٓءُ وَلَوْ لَمْ تَمْسَسْهُ نَارٌۚ نُّورٌ عَلَىٰ نُورٍۗ يَهْدِى ٱللَّهُ لِنُورِهِۦ مَن يَشَآءُۚ وَيَضْرِبُ ٱللَّهُ ٱلْأَمْثَٰلَ لِلنَّاسِۗ وَٱللَّهُ بِكُلِّ شَىْءٍ عَلِيمٌ ", "translation": "Allāh is the Light[1] of the heavens and the earth. The example of His light[2] is like a niche within which is a lamp;[3] the lamp is within glass, the glass as if it were a pearly [white] star lit from [the oil of] a blessed olive tree, neither of the east nor of the west, whose oil would almost glow even if untouched by fire. Light upon light. Allāh guides to His light whom He wills. And Allāh presents examples for the people, and Allāh is Knowing of all things.", "words": [{"id": 1, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 2, "arabic": "نُورُ", "translit": "ُrwُn", "root": "نور"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "مَثَلُ", "translit": "ُlَhtَm", "root": "مثل"}, {"id": 6, "arabic": "نُورِهِۦ", "translit":