ranslit":"ًẗَdْlَjg","root":"جلد"},{"id":12,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":13,"arabic":"تَقْبَلُوا۟","translit":"۟āwُlَbْqَt","root":"قبل"},{"id":14,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":15,"arabic":"شَهَٰدَةً","translit":"ًẗَdَٰhَhs","root":"شهد"},{"id":16,"arabic":"أَبَدًا","translit":"āًdَbَaʾ","root":"ابد"},{"id":17,"arabic":"وَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَw","root":""},{"id":18,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":19,"arabic":"ٱلْفَٰسِقُونَ","translit":"َnwُqِsَٰfْlٱ","root":"فسق"}],"hasIhya":false},{"ayah":5,"text":"إِلَّا ٱلَّذِينَ تَابُوا۟ مِنۢ بَعْدِ ذَٰلِكَ وَأَصْلَحُوا۟ فَإِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ","translation":"Except for those who repent thereafter and reform, for indeed, Allāh is Forgiving and Merciful.","words":[{"id":1,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"تَابُوا۟","translit":"۟āwُbāَt","root":"توب"},{"id":4,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":5,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":6,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":7,"arabic":"وَأَصْلَحُوا۟","translit":"۟āwُḥَlْṣَaʾَw","root":"صلح"},{"id":8,"arabic":"فَإِنَّ","translit":"َّnِiʾَf","root":""},{"id":9,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":10,"arabic":"غَفُورٌ","translit":"ٌrwُfَغ","root":"غفر"},{"id":11,"arabic":"رَّحِيمٌ","translit":"ٌmyِḥَّr","root":"رحم"}],"hasIhya":false},{"ayah":6,"text":"وَٱلَّذِينَ يَرْمُونَ أَزْوَٰجَهُمْ وَلَمْ يَكُن لَّهُمْ شُهَدَآءُ إِلَّآ أَنفُسُهُمْ فَشَهَٰدَةُ أَحَدِهِمْ أَرْبَعُ شَهَٰدَٰتٍۭ بِٱللَّهِۙ إِنَّهُۥ لَمِنَ ٱلصَّٰدِقِينَ ","translation":"And those who accuse their wives [of adultery] and have no witnesses except themselves - then the witness of one of them[1] [shall be] four testimonies [swearing] by Allāh that indeed, he is of the truthful.","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"يَرْمُونَ","translit":"َnwُmْrَy","root":"رمي"},{"id":3,"arabic":"أَزْوَٰجَهُمْ","translit":"ْmُhَjgَٰwْzَaʾ","root":"زوج"},{"id":4,"arabic":"وَلَمْ","translit":"ْmَlَw","root":""},{"id":5,"arabic":"يَكُن","translit":"nُkَy","root":"كون"},{"id":6,"arabic":"لَّهُمْ","translit":"ْmُhَّl","root":""},{"id":7,"arabic":"شُهَدَآءُ","translit":"ُءٓāَdَhُhs","root":"شهد"},{"id":8,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":9,"arabic":"أَنفُسُهُمْ","translit":"ْmُhُsُfnَaʾ","root":"نفس"},{"id":10,"arabic":"فَشَهَٰدَةُ","translit":"ُẗَdَٰhَhsَf","root":"شهد"},{"id":11,"arabic":"أَحَدِهِمْ","translit":"ْmِhِdَḥَaʾ","root":"احد"},{"id":12,"arabic":"أَرْبَعُ","translit":"ُʿعَbْrَaʾ","root":"ربع"},{"id":13,"arabic":"شَهَٰدَٰتٍۭ","translit":"ٍۭtَٰdَٰhَhs","root":"شهد"},{"id":14,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":15,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":16,"arabic":"لَمِنَ","translit":"َnِmَl","root":""},{"id":17,"arabic":"ٱلصَّٰدِقِينَ","translit":"َnyِqِdَّٰṣlٱ","root":"صدق"}],"hasIhya":false},{"ayah":7,"text":"وَٱلْخَٰمِسَةُ أَنَّ لَعْنَتَ ٱللَّهِ عَلَيْهِ إِن كَانَ مِنَ ٱلْكَٰذِبِينَ ","translation":"And the fifth [oath will be] that the curse of Allāh be upon him if he should be of the liars.","words":[{"id":1,"arabic":"وَٱلْخَٰمِسَةُ","translit":"ُẗَsِmَٰhkْlٱَw","root":"خمس"},{"id":2,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":3,"arabic":"لَعْنَتَ","translit":"َtَnْʿعَl","root":"لعن"},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":6,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":7,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":8,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":9,"arabic":"ٱلْكَٰذِبِينَ","translit":"َnyِbِhdَٰkْlٱ","root":"كذب"}],"hasIhya":false},{"ayah":8,"text":"وَيَدْرَؤُا۟ عَنْهَا ٱلْعَذَابَ أَن تَشْهَدَ أَرْبَعَ شَهَٰدَٰتٍۭ بِٱللَّهِۙ إِنَّهُۥ لَمِنَ ٱلْكَٰذِبِينَ ","translation":"But it will prevent punishment from her if she gives four testimonies [swearing] by Allāh that indeed, he is of the liars.","words":[{"id":1,"arabic":"وَيَدْرَؤُا۟","translit":"۟āُwʾَrْdَyَw","root":"درا"},{"id":2,"arabic":"عَنْهَا","translit":"āَhْnَʿع","root":""},{"id":3,"arabic":"ٱلْعَذَابَ","translit":"َbāَhdَʿعْlٱ","root":"عذب"},{"id":4,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":5,"arabic":"تَشْهَدَ","translit":"َdَhْhsَt","root":"شهد"},{"id":6,"arabic":"أَرْبَعَ","translit":"َʿعَbْrَaʾ","root":"ربع"},{"id":7,"arabic":"شَهَٰدَٰتٍۭ","translit":"ٍۭtَٰdَٰhَhs","root":"شهد"},{"id":8,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":9,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":10,"arabic":"لَمِنَ","translit":"َnِmَl","root":""},{"id":11,"arabic":"ٱلْكَٰذِبِينَ","translit":"َnyِbِhdَٰkْlٱ","root":"كذب"}],"hasIhya":false},{"ayah":9,"text":"وَٱلْخَٰمِسَةَ أَنَّ غَضَبَ ٱللَّهِ عَلَيْهَآ إِن كَانَ مِنَ ٱلصَّٰدِقِينَ ","translation":"And the fifth [oath will be] that the wrath of Allāh be upon her if he was of the truthful.","words":[{"id":1,"arabic":"وَٱلْخَٰمِسَةَ","translit":"َẗَsِmَٰhkْlٱَw","root":"خمس"},{"id":2,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":3,"arabic":"غَضَبَ","translit":"َbَḍَغ","root":"غضب"},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"عَلَيْهَآ","translit":"ٓāَhْyَlَʿع","root":""},{"id":6,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":7,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":8,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":9,"arabic":"ٱلصَّٰدِقِينَ","translit":"َnyِqِdَّٰṣlٱ","root":"صدق"}],"hasIhya":false},{"ayah":10,"text":"وَلَوْلَا فَضْلُ ٱللَّهِ عَلَيْكُمْ وَرَحْمَتُهُۥ وَأَنَّ ٱللَّهَ تَوَّابٌ حَكِيمٌ ","translation":"And if not for the favor of Allāh upon you and His mercy...[1] and because Allāh is Accepting of Repentance and Wise.","words":[{"id":1,"arabic":"وَلَوْلَا","translit":"āَlْwَlَw","root":""},{"id":2,"arabic":"فَضْلُ","translit":"ُlْḍَf","root":"فضل"},{"id":3,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":4,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":5,"arabic":"وَرَحْمَتُهُۥ","translit":"ۥُhُtَmْḥَrَw","root":"رحم"},{"id":6,"arabic":"وَأَنَّ","translit":"َّnَaʾَw","root":""},{"id":7,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":8,"arabic":"تَوَّابٌ","translit":"ٌbāَّwَt","root":"توب"},{"id":9,"arabic":"حَكِيمٌ","translit":"ٌmyِkَḥ","root":"حكم"}],"hasIhya":false},{"ayah":11,"text":"إِنَّ ٱلَّذِينَ جَآءُو بِٱلْإِفْكِ عُصْبَةٌ مِّنكُمْۚ لَا تَحْسَبُوهُ شَرًّا لَّكُمۖ بَلْ هُوَ خَيْرٌ لَّكُمْۚ لِكُلِّ ٱمْرِئٍ مِّنْهُم مَّا ٱكْتَسَبَ مِنَ ٱلْإِثْمِۚ وَٱلَّذِى تَوَلَّىٰ كِبْرَهُۥ مِنْهُمْ لَهُۥ عَذَابٌ عَظِيمٌ ","translation":"Indeed, those who came with falsehood[1] are a group among you. Do not think it bad for you; rather, it is good for you. For every person among them is what [punishment] he has earned from the sin, and he who took upon himself the greater portion thereof[2] - for him is a great punishment [i.e., Hellfire].","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"جَآءُو","translit":"wُءٓāَjg","root":"جيا"},{"id":4,"arabic":"بِٱلْإِفْكِ","translit":"ِkْfِiʾْlٱِb","root":"افك"},{"id":5,"arabic":"عُصْبَةٌ","translit":"ٌẗَbْṣُʿع","root":"عصب"},{"id":6,"arabic":"مِّنكُمْ","translit":"ْmُknِّm","root":""},{"id":7,"arabic":"لَا","translit":"āَl","root":""},{"id":8,"arabic":"تَحْسَبُوهُ","translit":"ُhwُbَsْḥَt","root":"حسب"},{"id":9,"arabic":"شَرًّا","translit":"āًّrَhs","root":"شرر"},{"id":10,"arabic":"لَّكُم","translit":"mُkَّl","root":""},{"id":11,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":12,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":13,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":14,"arabic":"لَّكُمْ","translit":"ْmُkَّl","root":""},{"id":15,"arabic":"لِكُلِّ","translit":"ِّlُkِl","