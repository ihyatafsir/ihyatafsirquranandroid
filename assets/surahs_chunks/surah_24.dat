ۥٓ أَوْ بُيُوتِ إِخْوَٰنِكُمُۥٓ أَوْ بُيُوتِ أَخَوَٰتِكُمُۥٓ أَوْ بُيُوتِ أَعْمَٰمِكُمُۥٓ أَوْ بُيُوتِ عَمَّٰتِكُمُۥٓ أَوْ بُيُوتِ أَخْوَٰلِكُمُۥٓ أَوْ بُيُوتِ خَٰلَٰتِكُمُۥٓ أَوْ مَا مَلَكْتُم مَّفَاتِحَهُۥٓ أَوْ صَدِيقِكُمْۖ لَيْسَ عَلَيْكُمْ جُنَاحٌ اَن تَاكُلُواْ جَمِيعاً اَوَ اَشْتَاتاࣰۖ فَإِذَا دَخَلْتُم بُيُوتاࣰ فَسَلِّمُواْ عَلَيٰٓ أَنفُسِكُمْ تَحِيَّةࣰ مِّنْ عِندِ اِ۬للَّهِ مُبَٰرَكَةࣰ طَيِّبَةࣰۖ كَذَٰلِكَ يُبَيِّنُ اُ۬للَّهُ لَكُمُ اُ۬لَايَٰتِ لَعَلَّكُمْ تَعْقِلُونَۖ", "words": [{"id": 1, "arabic": "لَّيْسَ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لَاعْم۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "حَرَجࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لَاعْرَجِ", "translit": "", "root": ""}, {"id": 8, "arabic": "حَرَجࣱ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 10, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لْمَرِيضِ", "translit": "", "root": ""}, {"id": 12, "arabic": "حَرَجࣱ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 14, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 15, "arabic": "أَنفُسِكُمُۥٓ", "translit": "", "root": ""}, {"id": 16, "arabic": "أَن", "translit": "", "root": ""}, {"id": 17, "arabic": "تَاكُلُواْ", "translit": "", "root": ""}, {"id": 18, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 19, "arabic": "بُيُوتِكُمُۥٓ", "translit": "", "root": ""}, {"id": 20, "arabic": "أَوْ", "translit": "", "root": ""}, {"id": 21, "arabic": "بُيُوتِ", "translit": "", "root": ""}, {"id": 22, "arabic": "ءَابَآئِكُمُۥٓ", "translit": "", "root": ""}, {"id": 23, "arabic": "أَوْ", "translit": "", "root": ""}, {"id": 24, "arabic": "بُيُوتِ", "translit": "", "root": ""}, {"id": 25, "arabic": 