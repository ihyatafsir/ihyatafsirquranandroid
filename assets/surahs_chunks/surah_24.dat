2987,14019],[11,14019,14569],[12,14569,15229],[13,15229,16219],[14,16219,17251],[15,17251,18283],[16,18283,19273],[17,19273,20745],[18,20745,21859],[19,21859,23069],[20,23069,23619],[21,23619,24884],[22,24884,26576],[23,26576,28405],[24,28405,29547],[25,29547,30620],[26,30620,31143],[27,31143,32491],[28,32491,33865]],"12":[[1,400,2524],[2,2524,3105],[3,3105,5050],[4,5050,5997],[5,5997,8043],[6,8043,10240],[7,10240,12059],[8,12059,13372],[9,13372,15494],[10,15494,17186],[11,17186,17994],[12,17994,19498]],"13":[[1,400,1862],[2,1862,3727],[3,3727,4877],[4,4877,6427],[5,6427,8442],[6,8442,9267],[7,9267,9767],[8,9767,11467],[9,11467,14282],[10,14282,16432],[11,16432,17232],[12,17232,18219],[13,18219,18694],[14,18694,20569]],"14":[[1,400,1948],[2,1948,2722],[3,2722,3649],[4,3649,4986],[5,4986,6511],[6,6511,7097],[7,7097,8774],[8,8774,10674],[9,10674,12064],[10,12064,12650],[11,12650,13860],[12,13860,15150],[13,15150,15948],[14,15948,17097],[15,17097,18270]],"15":[[1,400,1033],[2,1033,3098],[3,3098,5383],[4,5383,7778],[5,7778,10311],[6,10311,11426],[7,11426,12417],[8,12417,13243],[9,13243,13766],[10,13766,14647],[11,14647,17153],[12,17153,18839],[13,18839,19913],[14,19913,20794],[15,20794,21882],[16,21882,23260]],"16":[[1,400,2745],[2,2745,3334],[3,3334,5305],[4,5305,6380],[5,6380,7417],[6,7417,8697],[7,8697,10274],[8,10274,10837],[9,10837,12680],[10,12680,13996],[11,13996,15560],[12,15560,16620],[13,16620,17772],[14,17772,19054]],"17":[[1,400,2155],[2,2155,3310],[3,3310,3954],[4,3954,6236],[5,6236,8120],[6,8120,9524],[7,9524,10168],[8,10168,11338],[9,11338,13751]],"18":[[1,400,2233],[2,2233,3182],[3,3182,3903],[4,3903,5609],[5,5609,6919],[6,6919,8049],[7,8049,9154]],"19":[[1,400,1297],[2,1297,2685],[3,2685,4368],[4,4368,4908],[5,4908,6112],[6,6112,7586],[7,7586,8200],[8,8200,9588],[9,9588,11430],[10,11430,12142],[11,12142,13346],[12,13346,14500],[13,14500,15114],[14,15114,16870],[15,16870,18860],[16,18860,20199],[17,20199,21353],[18,21353,22753],[19,22753,23392],[20,23392