},{"id":71,"arabic":"يُبَيِّنُ","translit":"ُnِّyَbُy","root":"بين"},{"id":72,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":73,"arabic":"لَكُمُ","translit":"ُmُkَl","root":""},{"id":74,"arabic":"ٱلْءَايَٰتِ","translit":"ِtَٰyāَءْlٱ","root":"ايي"},{"id":75,"arabic":"لَعَلَّكُمْ","translit":"ْmُkَّlَʿعَl","root":""},{"id":76,"arabic":"تَعْقِلُونَ","translit":"َnwُlِqْʿعَt","root":"عقل"}],"hasIhya":true},{"ayah":62,"text":"إِنَّمَا ٱلْمُؤْمِنُونَ ٱلَّذِينَ ءَامَنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ وَإِذَا كَانُوا۟ مَعَهُۥ عَلَىٰٓ أَمْرٍ جَامِعٍ لَّمْ يَذْهَبُوا۟ حَتَّىٰ يَسْتَـْٔذِنُوهُۚ إِنَّ ٱلَّذِينَ يَسْتَـْٔذِنُونَكَ أُو۟لَٰٓئِكَ ٱلَّذِينَ يُؤْمِنُونَ بِٱللَّهِ وَرَسُولِهِۦۚ فَإِذَا ٱسْتَـْٔذَنُوكَ لِبَعْضِ شَأْنِهِمْ فَأْذَن لِّمَن شِئْتَ مِنْهُمْ وَٱسْتَغْفِرْ لَهُمُ ٱللَّهَۚ إِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ","translation":"The believers are only those who believe in Allāh and His Messenger and, when they are [meeting] with him for a matter of common interest, do not depart until they have asked his permission. Indeed, those who ask your permission, [O Muḥammad] - those are the ones who believe in Allāh and His Messenger. So when they ask your permission due to something of their affairs, then give permission to whom you will among them and ask forgiveness for them of Allāh. Indeed, Allāh is Forgiving and Merciful.","words":[{"id":1,"arabic":"إِنَّمَا","translit":"āَmَّnِiʾ","root":""},{"id":2,"arabic":"ٱلْمُؤْمِنُونَ","translit":"َnwُnِmْwʾُmْlٱ","root":"امن"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":5,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":6,"arabic":"وَرَسُولِهِۦ","translit":"ۦِhِlwُsَrَw","root":"رسل"},{"id":7,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":8,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":9,"arabic":"مَعَهُۥ","translit":"ۥُhَʿعَm","root":""},{"id":10,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع",