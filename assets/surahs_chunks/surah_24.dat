text": "۞أَلَمْ تَرَ أَنَّ اَ۬للَّهَ يُزْجِے سَحَاباࣰ ثُمَّ يُوَ۬لِّفُ بَيْنَهُۥ ثُمَّ يَجْعَلُهُۥ رُكَاماࣰ فَتَرَي اَ۬لْوَدْقَ يَخْرُجُ مِنْ خِلَٰلِهِۖۦ وَيُنَزِّلُ مِنَ اَ۬لسَّمَآءِ مِن جِبَالࣲ فِيهَا مِنۢ بَرَدࣲ فَيُصِيبُ بِهِۦ مَنْ يَّشَآءُ وَيَصْرِفُهُۥ عَن مَّنْ يَّشَآءُۖ يَكَادُ سَنَا بَرْقِهِۦ يَذْهَبُ بِالَابْصٰ۪رِۖ", "words": [{"id": 1, "arabic": "۞أَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 5, "arabic": "يُزْجِے", "translit": "", "root": ""}, {"id": 6, "arabic": "سَحَاباࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "يُوَ۬لِّفُ", "translit": "", "root": ""}, {"id": 9, "arabic": "بَيْنَهُۥ", "translit": "", "root": ""}, {"id": 10, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 11, "arabic": "يَجْعَلُهُۥ", "translit": "", "root": ""}, {"id": 12, "arabic": "رُكَاماࣰ", "translit": "", "root": ""}, {"id": 13, "arabic": "فَتَرَي", "translit": "", "root": ""}, {"id": 14, "arabic": "اَ۬لْوَدْقَ", "translit": "", "root": ""}, {"id": 15, "arabic": "يَخْرُجُ", "translit": "", "root": ""}, {"id": 16, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 17, "arabic": "خِلَٰلِهِۖۦ", "translit": "", "root": ""}, {"id": 18, "arabic": "وَيُنَزِّلُ", "translit": "", "root": ""}, {"id": 19, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 20, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 21, "arabic": "مِن", "translit": "", "root": ""}, {"id": 22, "arabic": "جِبَالࣲ", "translit": "", "root": ""}, {"id": 23, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 24, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 25, "arabic": "بَرَدࣲ", "translit": "", "root": ""}, {"id": 26, "arabic": "فَيُصِيبُ", "translit": "", "root": ""}, {"id": 27, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 2