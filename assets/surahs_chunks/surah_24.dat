},{"id":10,"arabic":"صِرَٰطٍ","translit":"ٍṭَٰrِṣ","root":"صرط"},{"id":11,"arabic":"مُّسْتَقِيمٍ","translit":"ٍmyِqَtْsُّm","root":"قوم"}],"hasIhya":false},{"ayah":47,"text":"وَيَقُولُونَ ءَامَنَّا بِٱللَّهِ وَبِٱلرَّسُولِ وَأَطَعْنَا ثُمَّ يَتَوَلَّىٰ فَرِيقٌ مِّنْهُم مِّنۢ بَعْدِ ذَٰلِكَۚ وَمَآ أُو۟لَٰٓئِكَ بِٱلْمُؤْمِنِينَ ","translation":"But they [i.e., the hypocrites] say, \"We have believed in Allāh and in the Messenger, and we obey\"; then a party of them turns away after that. And those are not believers.","words":[{"id":1,"arabic":"وَيَقُولُونَ","translit":"َnwُlwُqَyَw","root":"قول"},{"id":2,"arabic":"ءَامَنَّا","translit":"āَّnَmāَء","root":"امن"},{"id":3,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":4,"arabic":"وَبِٱلرَّسُولِ","translit":"ِlwُsَّrlٱِbَw","root":"رسل"},{"id":5,"arabic":"وَأَطَعْنَا","translit":"āَnْʿعَṭَaʾَw","root":"طوع"},{"id":6,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":7,"arabic":"يَتَوَلَّىٰ","translit":"ٰàَّlَwَtَy","root":"ولي"},{"id":8,"arabic":"فَرِيقٌ","translit":"ٌqyِrَf","root":"فرق"},{"id":9,"arabic":"مِّنْهُم","translit":"mُhْnِّm","root":""},{"id":10,"arabic":"مِّنۢ","translit":"ۢnِّm","root":""},{"id":11,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":12,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":13,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":14,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":15,"arabic":"بِٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱِb","root":"امن"}],"hasIhya":false},{"ayah":48,"text":"وَإِذَا دُعُوٓا۟ إِلَى ٱللَّهِ وَرَسُولِهِۦ لِيَحْكُمَ بَيْنَهُمْ إِذَا فَرِيقٌ مِّنْهُم مُّعْرِضُونَ ","translation":"And when they are called to [the words of] Allāh and His Messenger to judge between them, at once a party of them turns aside [in refusal].","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"دُعُوٓا۟","translit":"۟āٓwُʿعُd","root":"دعو"},{"id":3,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"وَرَسُولِهِۦ","translit":"ۦِhِlwُsَrَw","root":"رسل"},{"id":6,"arabic":"لِيَحْكُمَ","translit":"َmُkْḥَyِl","root":"حكم"},{"id":7,"arabic":"بَيْنَهُمْ","translit":"ْmُhَnْyَb","root":"بين"},{"id":8,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":9,"arabic":"فَرِيقٌ","translit":"ٌqyِrَf","root":"فرق"},{"id":10,"arabic":"مِّنْهُم","translit":"mُhْnِّm","root":""},{"id":11,"arabic":"مُّعْرِضُونَ","translit":"َnwُḍِrْʿعُّm","root":"عرض"}],"hasIhya":true},{"ayah":49,"text":"وَإِن يَكُن لَّهُمُ ٱلْحَقُّ يَأْتُوٓا۟ إِلَيْهِ مُذْعِنِينَ ","translation":"But if the right is theirs, they come to him in prompt obedience.","words":[{"id":1,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":2,"arabic":"يَكُن","translit":"nُkَy","root":"كون"},{"id":3,"arabic":"لَّهُمُ","translit":"ُmُhَّl","root":""},{"id":4,"arabic":"ٱلْحَقُّ","translit":"ُّqَḥْlٱ","root":"حقق"},{"id":5,"arabic":"يَأْتُوٓا۟","translit":"۟āٓwُtْaʾَy","root":"اتي"},{"id":6,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":7,"arabic":"مُذْعِنِينَ","translit":"َnyِnِʿعْhdُm","root":"ذعن"}],"hasIhya":false},{"ayah":50,"text":"أَفِى قُلُوبِهِم مَّرَضٌ أَمِ ٱرْتَابُوٓا۟ أَمْ يَخَافُونَ أَن يَحِيفَ ٱللَّهُ عَلَيْهِمْ وَرَسُولُهُۥۚ بَلْ أُو۟لَٰٓئِكَ هُمُ ٱلظَّٰلِمُونَ ","translation":"Is there disease in their hearts? Or have they doubted? Or do they fear that Allāh will be unjust to them, or His Messenger? Rather, it is they who are the wrongdoers [i.e., the unjust].","words":[{"id":1,"arabic":"أَفِى","translit":"àِfَaʾ","root":""},{"id":2,"arabic":"قُلُوبِهِم","translit":"mِhِbwُlُq","root":"قلب"},{"id":3,"arabic":"مَّرَضٌ","translit":"ٌḍَrَّm","root":"مرض"},{"id":4,"arabic":"أَمِ","translit":"ِmَaʾ","root":""},{"id":5,"arabic":"ٱرْتَابُوٓا۟","translit":"۟āٓwُbāَtْrٱ","root":"ريب"},{"id":6,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":7,"arabic":"يَخَافُونَ","translit":"َnwُfāَhkَy","root":"خوف"},{"id":8,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":9,"arabic":"يَحِيفَ","translit":"َfyِḥَy","root":"حيف"},{"id":10,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":11,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":12,"arabic":"وَرَسُولُهُۥ","translit":"ۥُhُlwُsَrَw","root":"رسل"},{"id":13,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":14,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":15,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":16,"arabic":"ٱلظَّٰلِمُونَ","translit":"َnwُmِlَّٰẓlٱ","root":"ظلم"}],"hasIhya":false},{"ayah":51,"text":"إِنَّمَا كَانَ قَوْلَ ٱلْمُؤْمِنِينَ إِذَا دُعُوٓا۟ إِلَى ٱللَّهِ وَرَسُولِهِۦ لِيَحْكُمَ بَيْنَهُمْ أَن يَقُولُوا۟ سَمِعْنَا وَأَطَعْنَاۚ وَأُو۟لَٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ ","translation":"The only statement of the [true] believers when they are called to Allāh and His Messenger to judge between them is that they say, \"We hear and we obey.\" And those are the successful.","words":[{"id":1,"arabic":"إِنَّمَا","translit":"āَmَّnِiʾ","root":""},{"id":2,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":3,"arabic":"قَوْلَ","translit":"َlْwَq","root":"قول"},{"id":4,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"},{"id":5,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":6,"arabic":"دُعُوٓا۟","translit":"۟āٓwُʿعُd","root":"دعو"},{"id":7,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":8,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":9,"arabic":"وَرَسُولِهِۦ","translit":"ۦِhِlwُsَrَw","root":"رسل"},{"id":10,"arabic":"لِيَحْكُمَ","translit":"َmُkْḥَyِl","root":"حكم"},{"id":11,"arabic":"بَيْنَهُمْ","translit":"ْmُhَnْyَb","root":"بين"},{"id":12,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":13,"arabic":"يَقُولُوا۟","translit":"۟āwُlwُqَy","root":"قول"},{"id":14,"arabic":"سَمِعْنَا","translit":"āَnْʿعِmَs","root":"سمع"},{"id":15,"arabic":"وَأَطَعْنَا","translit":"āَnْʿعَṭَaʾَw","root":"طوع"},{"id":16,"arabic":"وَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَw","root":""},{"id":17,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":18,"arabic":"ٱلْمُفْلِحُونَ","translit":"َnwُḥِlْfُmْlٱ","root":"فلح"}],"hasIhya":false},{"ayah":52,"text":"وَمَن يُطِعِ ٱللَّهَ وَرَسُولَهُۥ وَيَخْشَ ٱللَّهَ وَيَتَّقْهِ فَأُو۟لَٰٓئِكَ هُمُ ٱلْفَآئِزُونَ ","translation":"And whoever obeys Allāh and His Messenger and fears Allāh and is conscious of Him - it is those who are the attainers.","words":[{"id":1,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":2,"arabic":"يُطِعِ","translit":"ِʿعِṭُy","root":"طوع"},{"id":3,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":4,"arabic":"وَرَسُولَهُۥ","translit":"ۥُhَlwُsَrَw","root":"رسل"},{"id":5,"arabic":"وَيَخْشَ","translit":"َhsْhkَyَw","root":"خشي"},{"id":6,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":7,"arabic":"وَيَتَّقْهِ","translit":"ِhْqَّtَyَw","root":"وقي"},{"id":8,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":9,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":10,"arabic":"ٱلْفَآئِزُونَ","translit":"َnwُzِyʾٓāَfْlٱ","root":"فوز"}],"hasIhya":true},{"ayah":53,"text":"وَأَقْسَمُوا۟ بِٱللَّهِ جَهْدَ أَيْمَٰنِهِمْ لَئِنْ أَمَرْتَهُمْ لَيَخْرُجُنَّۖ قُل لَّا تُقْسِمُوا۟ۖ طَاعَةٌ مَّعْرُوفَةٌۚ إِنَّ ٱللَّهَ خَبِيرٌۢ بِمَا تَعْمَلُونَ ","translation":"And they swear by Allāh their strongest oaths that if you ordered them, they would go forth [in Allāh's cause]. Say, \"Do not swear. [Such] obedience is known.[1] Indeed, Allāh is [fully] Aware of that which you do.\"","words":[{"id":1,"arabic":"وَأَقْسَمُوا۟","translit":"۟āwُmَsْqَaʾَw","root":"قسم"},{"id":2,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":3,"arabic":"جَهْدَ","translit":"َdْhَjg","root":"جهد"},{"id":4,"arabic":"أَيْمَٰنِهِمْ","translit":"ْmِhِnَٰmْyَaʾ","root":"يمن"},{"id":5,"arabic":"لَئِنْ","translit":"ْnِyʾَl","root":""},{"id":6,"arabic":"أَمَرْتَهُمْ","translit":"ْmُhَtْrَmَaʾ","root":"امر"},{"id":7,"arabic":"لَيَخْرُجُنَّ","translit":"َّnُjgُrْhkَyَl","root":"خرج"},{"id":8,"arabic":"قُل","translit":"lُq","root":"قول"},{"id":9,"arabic":"لَّا","translit":"āَّl","root":""},{"id":10,"arabic":"تُقْسِمُوا۟","translit":"۟āwُmِsْqُt","root":"قسم"},{"id":11,"arabic":"طَاعَةٌ","translit":"ٌẗَʿعāَṭ","root":"طوع"},{"id":12,"arabic":"مَّعْرُوفَةٌ","translit":"ٌẗَfwُrْʿعَّm","root":"عرف"},{"id":13,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":14,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":15,"arabic":"خَبِيرٌۢ","translit":"ٌۢryِbَhk","root":"خبر"},{"id":16,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":17,"arabic":"تَعْمَلُونَ","translit":"َnwُlَmْʿعَt","root":"عمل"}],"hasIhya":false},{"ayah":54,"text":"قُلْ أَطِيعُوا۟ ٱللَّهَ وَأَطِيعُوا۟ ٱلرَّسُولَۖ فَإِن تَوَلَّوْا۟ فَإِنَّمَا عَلَيْهِ مَا حُمِّلَ وَعَلَيْكُم مَّا حُمِّلْتُمْۖ وَإِن تُطِيعُوهُ تَهْتَدُوا۟ۚ وَمَا عَلَى ٱلرَّسُولِ إِلَّا ٱلْبَلَٰغُ ٱلْمُبِينُ ","translation":"Say, \"Obey Allāh and obey the Messenger; but if you turn away - then upon him is only that [duty] with which he has been charged, and upon you is that with which you have been charged. And if you obey him, you will be [rightly] guided. And there is not upon the Messenger except the [responsibility for] clear notification.\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"أَطِيعُوا۟","translit":"۟āwُʿعyِṭَaʾ","root":"طوع"},{"id":3,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":4,"arabic":"وَأَطِيعُوا۟","translit":"۟āwُʿعyِṭَaʾَw","root":"طوع"},{"id":5,"arabic":"ٱلرَّسُولَ","translit":"َlwُsَّrlٱ","root":"رسل"},{"id":6,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":7,"arabic":"تَوَلَّوْا۟","translit":"۟āْwَّlَwَt","root":"ولي"},{"id":8,"arabic":"فَإِنَّمَا","translit":"āَmَّnِiʾَf","root":""},{"id":9,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":10,"arabic":"مَا","translit":"āَm","root":""},{"id":11,"arabic":"حُمِّلَ","translit":"َlِّmُḥ","root":"حمل"},{"id":12,"arabic":"وَعَلَيْكُم","translit":"mُkْyَlَʿعَw","root":""},{"id":13,"arabic":"مَّا","translit":"āَّm","root":""},{"id":14,"arabic":"حُمِّلْتُمْ","translit":"ْmُtْlِّmُḥ","root":"حمل"},{"id":15,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":16,"arabic":"تُطِيعُوهُ","translit":"ُhwُʿعyِṭُt","root":"طوع"},{"id":17,"arabic":"تَهْتَدُوا۟","translit":"۟āwُdَtْhَt","root":"هدي"},{"id":18,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":19,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":20,"arabic":"ٱلرَّسُولِ","translit":"ِlwُsَّrlٱ","root":"رسل"},{"id":21,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":22,"arabic":"ٱلْبَلَٰغُ","translit":"ُغَٰlَbْlٱ","root":"بلغ"},{"id":23,"arabic":"ٱلْمُبِينُ","translit":"ُnyِbُmْlٱ","root":"بين"}],"hasIhya":false},{"ayah":55,"text":"وَعَدَ ٱللَّهُ ٱلَّذِينَ ءَامَنُوا۟ مِنكُمْ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَيَسْتَخْلِفَنَّهُمْ فِى ٱلْأَرْضِ كَمَا ٱسْتَخْلَفَ ٱلَّذِينَ مِن قَبْلِهِمْ وَلَيُمَكِّنَنَّ لَهُمْ دِينَهُمُ ٱلَّذِى ٱرْتَضَىٰ لَهُمْ وَلَيُبَدِّلَنَّهُم مِّنۢ بَعْدِ خَوْفِهِمْ أَمْنًاۚ يَعْبُدُونَنِى لَا يُشْرِكُونَ بِى شَيْـًٔاۚ وَمَن كَفَرَ بَعْدَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْفَٰسِقُونَ ","translation":"Allāh has promised those who have believed among you and done righteous deeds that He will surely grant them succession [to authority] upon the earth just as He granted it to those before them and that He will surely establish for them [therein] their religion which He has preferred for them and that He will surely substitute for them, after their fear, security, [for] they worship Me, not associating anything with Me. But whoever disbelieves[1] after that - then those are the defiantly disobedient.","words":[{"id":1,"arabic":"وَعَدَ","translit":"َdَʿعَw","root":"وعد"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":5,"arabic":"مِنكُمْ","translit":"ْmُknِm","root":""},{"id":6,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":7,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":8,"arabic":"لَيَسْتَخْلِفَنَّهُمْ","translit":"ْmُhَّnَfِlْhkَtْsَyَl","root":"خلف"},{"id":9,"arabic":"فِى","translit":"àِf","root":""},{"id":10,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":11,"arabic":"كَمَا","translit":"āَmَk","root":""},{"id":12,"arabic":"ٱسْتَخْلَفَ","translit":"َfَlْhkَtْsٱ","root":"خلف"},{"id":13,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":14,"arabic":"مِن","translit":"nِm","root":""},{"id":15,"arabic":"قَبْلِهِمْ","translit":"ْmِhِlْbَq","root":"قبل"},{"id":16,"arabic":"وَلَيُمَكِّنَنَّ","translit":"َّnَnِّkَmُyَlَw","root":"مكن"},{"id":17,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":18,"arabic":"دِينَهُمُ","translit":"ُmُhَnyِd","root":"دين"},{"id":19,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":20,"arabic":"ٱرْتَضَىٰ","translit":"ٰàَḍَtْrٱ","root":"رضو"},{"id":21,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":22,"arabic":"وَلَيُبَدِّلَنَّهُم","translit":"mُhَّnَlِّdَbُyَlَw","root":"بدل"},{"id":23,"arabic":"مِّنۢ","translit":"ۢnِّm","root":""},{"id":24,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":25,"arabic":"خَوْفِهِمْ","translit":"ْmِhِfْwَhk","root":"خوف"},{"id":26,"arabic":"أَمْنًا","translit":"āًnْmَaʾ","root":"امن"},{"id":27,"arabic":"يَعْبُدُونَنِى","translit":"àِnَnwُdُbْʿعَy","root":"عبد"},{"id":28,"arabic":"لَا","translit":"āَl","root":""},{"id":29,"arabic":"يُشْرِكُونَ","translit":"َnwُkِrْhsُy","root":"شرك"},{"id":30,"arabic":"بِى","translit":"àِb","root":""},{"id":31,"arabic":"شَيْـًٔا","translit":"āًٔـْyَhs","root":"شيا"},{"id":32,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":33,"arabic":"كَفَرَ","translit":"َrَfَk","root":"كفر"},{"id":34,"arabic":"بَعْدَ","translit":"َdْʿعَb","root":"بعد"},{"id":35,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":36,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":37,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":38,"arabic":"ٱلْفَٰسِقُونَ","translit":"َnwُqِsَٰfْlٱ","root":"فسق"}],"hasIhya":false},{"ayah":56,"text":"وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ وَأَطِيعُوا۟ ٱلرَّسُولَ لَعَلَّكُمْ تُرْحَمُونَ ","translation":"And establish prayer and give zakāh and obey the Messenger - that you may receive mercy.","words":[{"id":1,"arabic":"وَأَقِيمُوا۟","translit":"۟āwُmyِqَaʾَw","root":"قوم"},{"id":2,"arabic":"ٱلصَّلَوٰةَ","translit":"َẗٰwَlَّṣlٱ","root":"صلو"},{"id":3,"arabic":"وَءَاتُوا۟","translit":"۟āwُtāَءَw","root":"اتي"},{"id":4,"arabic":"ٱلزَّكَوٰةَ","translit":"َẗٰwَkَّzlٱ","root":"زكو"},{"id":5,"arabic":"وَأَطِيعُوا۟","translit":"۟āwُʿعyِṭَaʾَw","root":"طوع"},{"id":6,"arabic":"ٱلرَّسُولَ","translit":"َlwُsَّrlٱ","root":"رسل"},{"id":7,"arabic":"لَعَلَّكُمْ","translit":"ْmُkَّlَʿعَl","root":""},{"id":8,"arabic":"تُرْحَمُونَ","translit":"َnwُmَḥْrُt","root":"رحم"}],"hasIhya":true},{"ayah":57,"text":"لَا تَحْسَبَنَّ ٱلَّذِينَ كَفَرُوا۟ مُعْجِزِينَ فِى ٱلْأَرْضِۚ وَمَأْوَىٰهُمُ ٱلنَّارُۖ وَلَبِئْسَ ٱلْمَصِيرُ ","translation":"Never think that the disbelievers are causing failure [to Allāh] upon the earth. Their refuge will be the Fire - and how wretched the destination.","words":[{"id":1,"arabic":"لَا","translit":"āَl","root":""},{"id":2,"arabic":"تَحْسَبَنَّ","translit":"َّnَbَsْḥَt","root":"حسب"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":5,"arabic":"مُعْجِزِينَ","translit":"َnyِzِjgْʿعُm","root":"عجز"},{"id":6,"arabic":"فِى","translit":"àِf","root":""},{"id":7,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":8,"arabic":"وَمَأْوَىٰهُمُ","translit":"ُmُhٰàَwْaʾَmَw","root":"اوي"},{"id":9,"arabic":"ٱلنَّارُ","translit":"ُrāَّnlٱ","root":"نور"},{"id":10,"arabic":"وَلَبِئْسَ","translit":"َsْyʾِbَlَw","root":"باس"},{"id":11,"arabic":"ٱلْمَصِيرُ","translit":"ُryِṣَmْlٱ","root":"صير"}],"hasIhya":false},{"ayah":58,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لِيَسْتَـْٔذِنكُمُ ٱلَّذِينَ مَلَكَتْ أَيْمَٰنُكُمْ وَٱلَّذِينَ لَمْ يَبْلُغُوا۟ ٱلْحُلُمَ مِنكُمْ ثَلَٰثَ مَرَّٰتٍۚ مِّن قَبْلِ صَلَوٰةِ ٱلْفَجْرِ وَحِينَ تَضَعُونَ ثِيَابَكُم مِّنَ ٱلظَّهِيرَةِ وَمِنۢ بَعْدِ صَلَوٰةِ ٱلْعِشَآءِۚ ثَلَٰثُ عَوْرَٰتٍ لَّكُمْۚ لَيْسَ عَلَيْكُمْ وَلَا عَلَيْهِمْ جُنَاحٌۢ بَعْدَهُنَّۚ طَوَّٰفُونَ عَلَيْكُم بَعْضُكُمْ عَلَىٰ بَعْضٍۚ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمُ ٱلْءَايَٰتِۗ وَٱللَّهُ عَلِيمٌ حَكِيمٌ ","translation":"O you who have believed, let those whom your right hands possess and those who have not [yet] reached puberty among you ask permission of you [before entering] at three times: before the dawn prayer and when you put aside your clothing [for rest] at noon and after the night prayer. [These are] three times of privacy[1] for you. There is no blame upon you nor upon them beyond these [periods], for they continually circulate among you - some of you, among others. Thus does Allāh make clear to you the verses [i.e., His ordinances]; and Allāh is Knowing and Wise.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"لِيَسْتَـْٔذِنكُمُ","translit":"ُmُknِhdْٔـَtْsَyِl","root":"اذن"},{"id":5,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":6,"arabic":"مَلَكَتْ","translit":"ْtَkَlَm","root":"ملك"},{"id":7,"arabic":"أَيْمَٰنُكُمْ","translit":"ْmُkُnَٰmْyَaʾ","root":"يمن"},{"id":8,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":9,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":10,"arabic":"يَبْلُغُوا۟","translit":"۟āwُغُlْbَy","root":"بلغ"},{"id":11,"arabic":"ٱلْحُلُمَ","translit":"َmُlُḥْlٱ","root":"حلم"},{"id":12,"arabic":"مِنكُمْ","translit":"ْmُknِm","root":""},{"id":13,"arabic":"ثَلَٰثَ","translit":"َhtَٰlَht","root":"ثلث"},{"id":14,"arabic":"مَرَّٰتٍ","translit":"ٍtَّٰrَm","root":"مرر"},{"id":15,"arabic":"مِّن","translit":"nِّm","root":""},{"id":16,"arabic":"قَبْلِ","translit":"ِlْbَq","root":"قبل"},{"id":17,"arabic":"صَلَوٰةِ","translit":"ِẗٰwَlَṣ","root":"صلو"},{"id":18,"arabic":"ٱلْفَجْرِ","translit":"ِrْjgَfْlٱ","root":"فجر"},{"id":19,"arabic":"وَحِينَ","translit":"َnyِḥَw","root":"حين"},{"id":20,"arabic":"تَضَعُونَ","translit":"َnwُʿعَḍَt","root":"وضع"},{"id":21,"arabic":"ثِيَابَكُم","translit":"mُkَbāَyِht","root":"ثوب"},{"id":22,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":23,"arabic":"ٱلظَّهِيرَةِ","translit":"ِẗَryِhَّẓlٱ","root":"ظهر"},{"id":24,"arabic":"وَمِنۢ","translit":"ۢnِmَw","root":""},{"id":25,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":26,"arabic":"صَلَوٰةِ","translit":"ِẗٰwَlَṣ","root":"صلو"},{"id":27,"arabic":"ٱلْعِشَآءِ","translit":"ِءٓāَhsِʿعْlٱ","root":"عشو"},{"id":28,"arabic":"ثَلَٰثُ","translit":"ُhtَٰlَht","root":"ثلث"},{"id":29,"arabic":"عَوْرَٰتٍ","translit":"ٍtَٰrْwَʿع","root":"عور"},{"id":30,"arabic":"لَّكُمْ","translit":"ْmُkَّl","root":""},{"id":31,"arabic":"لَيْسَ","translit":"َsْyَl","root":"ليس"},{"id":32,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":33,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":34,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":35,"arabic":"جُنَاحٌۢ","translit":"ٌۢḥāَnُjg","root":"جنح"},{"id":36,"arabic":"بَعْدَهُنَّ","translit":"َّnُhَdْʿعَb","root":"بعد"},{"id":37,"arabic":"طَوَّٰفُونَ","translit":"َnwُfَّٰwَṭ","root":"طوف"},{"id":38,"arabic":"عَلَيْكُم","translit":"mُkْyَlَʿع","root":""},{"id":39,"arabic":"بَعْضُكُمْ","translit":"ْmُkُḍْʿعَb","root":"بعض"},{"id":40,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":41,"arabic":"بَعْضٍ","translit":"ٍḍْʿعَb","root":"بعض"},{"id":42,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":43,"arabic":"يُبَيِّنُ","translit":"ُnِّyَbُy","root":"بين"},{"id":44,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":45,"arabic":"لَكُمُ","translit":"ُmُkَl","root":""},{"id":46,"arabic":"ٱلْءَايَٰتِ","translit":"ِtَٰyāَءْlٱ","root":"ايي"},{"id":47,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":48,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"},{"id":49,"arabic":"حَكِيمٌ","translit":"ٌmyِkَḥ","root":"حكم"}],"hasIhya":true},{"ayah":59,"text":"وَإِذَا بَلَغَ ٱلْأَطْفَٰلُ مِنكُمُ ٱلْحُلُمَ فَلْيَسْتَـْٔذِنُوا۟ كَمَا ٱسْتَـْٔذَنَ ٱلَّذِينَ مِن قَبْلِهِمْۚ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمْ ءَايَٰتِهِۦۗ وَٱللَّهُ عَلِيمٌ حَكِيمٌ ","translation":"And when the children among you reach puberty, let them ask permission [at all times] as those before them have done. Thus does Allāh make clear to you His verses; and Allāh is Knowing and Wise.","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"بَلَغَ","translit":"َغَlَb","root":"بلغ"},{"id":3,"arabic":"ٱلْأَطْفَٰلُ","translit":"ُlَٰfْṭَaʾْlٱ","root":"طفل"},{"id":4,"arabic":"مِنكُمُ","translit":"ُmُknِm","root":""},{"id":5,"arabic":"ٱلْحُلُمَ","translit":"َmُlُḥْlٱ","root":"حلم"},{"id":6,"arabic":"فَلْيَسْتَـْٔذِنُوا۟","translit":"۟āwُnِhdْٔـَtْsَyْlَf","root":"اذن"},{"id":7,"arabic":"كَمَا","translit":"āَmَk","root":""},{"id":8,"arabic":"ٱسْتَـْٔذَنَ","translit":"َnَhdْٔـَtْsٱ","root":"اذن"},{"id":9,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":10,"arabic":"مِن","translit":"nِm","root":""},{"id":11,"arabic":"قَبْلِهِمْ","translit":"ْmِhِlْbَq","root":"قبل"},{"id":12,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":13,"arabic":"يُبَيِّنُ","translit":"ُnِّyَbُy","root":"بين"},{"id":14,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":15,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":16,"arabic":"ءَايَٰتِهِۦ","translit":"ۦِhِtَٰyāَء","root":"ايي"},{"id":17,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":18,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"},{"id":19,"arabic":"حَكِيمٌ","translit":"ٌmyِkَḥ","root":"حكم"}],"hasIhya":false},{"ayah":60,"text":"وَٱلْقَوَٰعِدُ مِنَ ٱلنِّسَآءِ ٱلَّٰتِى لَا يَرْجُونَ نِكَاحًا فَلَيْسَ عَلَيْهِنَّ جُنَاحٌ أَن يَضَعْنَ ثِيَابَهُنَّ غَيْرَ مُتَبَرِّجَٰتٍۭ بِزِينَةٍۖ وَأَن يَسْتَعْفِفْنَ خَيْرٌ لَّهُنَّۗ وَٱللَّهُ سَمِيعٌ عَلِيمٌ ","translation":"And women of post-menstrual age who have no desire for marriage - there is no blame upon them for putting aside their outer garments [but] not displaying adornment. But to modestly refrain [from that] is better for them. And Allāh is Hearing and Knowing.","words":[{"id":1,"arabic":"وَٱلْقَوَٰعِدُ","translit":"ُdِʿعَٰwَqْlٱَw","root":"قعد"},{"id":2,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":3,"arabic":"ٱلنِّسَآءِ","translit":"ِءٓāَsِّnlٱ","root":"نسو"},{"id":4,"arabic":"ٱلَّٰتِى","translit":"àِtَّٰlٱ","root":""},{"id":5,"arabic":"لَا","translit":"āَl","root":""},{"id":6,"arabic":"يَرْجُونَ","translit":"َnwُjgْrَy","root":"رجو"},{"id":7,"arabic":"نِكَاحًا","translit":"āًḥāَkِn","root":"نكح"},{"id":8,"arabic":"فَلَيْسَ","translit":"َsْyَlَf","root":"ليس"},{"id":9,"arabic":"عَلَيْهِنَّ","translit":"َّnِhْyَlَʿع","root":""},{"id":10,"arabic":"جُنَاحٌ","translit":"ٌḥāَnُjg","root":"جنح"},{"id":11,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":12,"arabic":"يَضَعْنَ","translit":"َnْʿعَḍَy","root":"وضع"},{"id":13,"arabic":"ثِيَابَهُنَّ","translit":"َّnُhَbāَyِht","root":"ثوب"},{"id":14,"arabic":"غَيْرَ","translit":"َrْyَغ","root":"غير"},{"id":15,"arabic":"مُتَبَرِّجَٰتٍۭ","translit":"ٍۭtَٰjgِّrَbَtُm","root":"برج"},{"id":16,"arabic":"بِزِينَةٍ","translit":"ٍẗَnyِzِb","root":"زين"},{"id":17,"arabic":"وَأَن","translit":"nَaʾَw","root":""},{"id":18,"arabic":"يَسْتَعْفِفْنَ","translit":"َnْfِfْʿعَtْsَy","root":"عفف"},{"id":19,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":20,"arabic":"لَّهُنَّ","translit":"َّnُhَّl","root":""},{"id":21,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":22,"arabic":"سَمِيعٌ","translit":"ٌʿعyِmَs","root":"سمع"},{"id":23,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"}],"hasIhya":false},{"ayah":61,"text":"لَّيْسَ عَلَى ٱلْأَعْمَىٰ حَرَجٌ وَلَا عَلَى ٱلْأَعْرَجِ حَرَجٌ وَلَا عَلَى ٱلْمَرِيضِ حَرَجٌ وَلَا عَلَىٰٓ أَنفُسِكُمْ أَن تَأْكُلُوا۟ مِنۢ بُيُوتِكُمْ أَوْ بُيُوتِ ءَابَآئِكُمْ أَوْ بُيُوتِ أُمَّهَٰتِكُمْ أَوْ بُيُوتِ إِخْوَٰنِكُمْ أَوْ بُيُوتِ أَخَوَٰتِكُمْ أَوْ بُيُوتِ أَعْمَٰمِكُمْ أَوْ بُيُوتِ عَمَّٰتِكُمْ أَوْ بُيُوتِ أَخْوَٰلِكُمْ أَوْ بُيُوتِ خَٰلَٰتِكُمْ أَوْ مَا مَلَكْتُم مَّفَاتِحَهُۥٓ أَوْ صَدِيقِكُمْۚ لَيْسَ عَلَيْكُمْ جُنَاحٌ أَن تَأْكُلُوا۟ جَمِيعًا أَوْ أَشْتَاتًاۚ فَإِذَا دَخَلْتُم بُيُوتًا فَسَلِّمُوا۟ عَلَىٰٓ أَنفُسِكُمْ تَحِيَّةً مِّنْ عِندِ ٱللَّهِ مُبَٰرَكَةً طَيِّبَةًۚ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمُ ٱلْءَايَٰتِ لَعَلَّكُمْ تَعْقِلُونَ ","translation":"There is not upon the blind [any] constraint nor upon the lame constraint nor upon the ill constraint nor upon yourselves when you eat from your [own] houses or the houses of your fathers or the houses of your mothers or the houses of your brothers or the houses of your sisters or the houses of your father's brothers or the houses of your father's sisters or the houses of your mother's brothers or the houses of your mother's sisters or [from houses] whose keys you possess or [from the house] of your friend. There is no blame upon you whether you eat together or separately. But when you enter houses, give greetings of peace[1] upon each other - a greeting from Allāh, blessed and good. Thus does Allāh make clear to you the verses [of ordinance] that you may understand.","words":[{"id":1,"arabic":"لَّيْسَ","translit":"َsْyَّl","root":"ليس"},{"id":2,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":3,"arabic":"ٱلْأَعْمَىٰ","translit":"ٰàَmْʿعَaʾْlٱ","root":"عمي"},{"id":4,"arabic":"حَرَجٌ","translit":"ٌjgَrَḥ","root":"حرج"},{"id":5,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":6,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":7,"arabic":"ٱلْأَعْرَجِ","translit":"ِjgَrْʿعَaʾْlٱ","root":"عرج"},{"id":8,"arabic":"حَرَجٌ","trans