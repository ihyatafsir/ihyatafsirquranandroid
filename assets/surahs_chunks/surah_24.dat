c": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 35, "arabic": "نُورٍ", "translit": "ٍrwُn", "root": "نور"}, {"id": 36, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 37, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 38, "arabic": "لِنُورِهِۦ", "translit": "ۦِhِrwُnِl", "root": "نور"}, {"id": 39, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 40, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 41, "arabic": "وَيَضْرِبُ", "translit": "ُbِrْḍَyَw", "root": "ضرب"}, {"id": 42, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 43, "arabic": "ٱلْأَمْثَٰلَ", "translit": "َlَٰhtْmَaʾْlٱ", "root": "مثل"}, {"id": 44, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 45, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 46, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 47, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 48, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 36, "text": "فِى بُيُوتٍ أَذِنَ ٱللَّهُ أَن تُرْفَعَ وَيُذْكَرَ فِيهَا ٱسْمُهُۥ يُسَبِّحُ لَهُۥ فِيهَا بِٱلْغُدُوِّ وَٱلْءَاصَالِ ", "translation": "[Such niches are] in houses [i.e., mosques] which Allāh has ordered to be raised and that His name be mentioned [i.e., praised] therein; exalting Him within them in the morning and the evenings[1]", "words": [{"id": 1, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 2, "arabic": "بُيُوتٍ", "translit": "ٍtwُyُb", "root": "بيت"}, {"id": 3, "arabic": "أَذِنَ", "translit": "َnِhdَaʾ", "root": "اذن"}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "تُرْفَعَ", "translit": "َʿعَfْrُt", "root": "رفع"}, {"id": 7, "arabic": "وَيُذْكَرَ", "translit": "َrَkْhdُyَw", "root": "ذكر"}, {"id": 8, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 9, "arabic": "ٱسْمُهُۥ", "translit": "ۥُhُmْsٱ", "root": "سمو"}, {"id": 10, "arabic": "يُسَبِّحُ", "translit": "ُḥِّbَsُy", "root": "سبح"}, {"id": 11, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 12, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 13, "arabic": "بِٱلْغُدُوِّ", "translit": "ِّwُdُغْlٱِb", "root": "غدو"}, {"id": 14, "arabic": "وَٱلْءَاصَالِ", "translit": "ِlāَṣāَءْlٱَw", "root": "اصل"}], "hasIhya": true}, {"ayah": 37, "text": "رِجَالٌ لَّا تُلْهِيهِمْ تِجَٰرَةٌ وَلَا بَيْعٌ عَن ذِكْرِ ٱللَّهِ وَإِقَامِ ٱلصَّلَوٰةِ وَإِيتَآءِ ٱلزَّكَوٰةِۙ يَخَافُونَ يَوْمًا تَتَقَلَّبُ فِيهِ ٱلْقُلُوبُ وَٱلْأَبْصَٰرُ ", "translation": "[Are] men whom neither commerce nor sale distracts from the remembrance of Allāh and performance of prayer and giving of zakāh. They fear a Day in which the hearts and eyes will [fearfully] turn about -", "words": [{"id": 1, "arabic": "رِجَالٌ", "translit": "ٌlāَjgِr", "root": "رجل"}, {"id": 2, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 3, "arabic": "تُلْهِيهِمْ", "translit": "ْmِhyِhْlُt", "root": "لهو"}, {"id": 4, "arabic": "تِجَٰرَةٌ", "translit": "ٌẗَrَٰjgِt", "root": "تجر"}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "بَيْعٌ", "translit": "ٌʿعْyَb", "root": "بيع"}, {"id": 7, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 8, "arabic": "ذِكْرِ", "translit": "ِrْkِhd", "root": "ذكر"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "وَإِقَامِ", "translit": "ِmāَqِiʾَw", "root": "قوم"}, {"id": 11, "arabic": "ٱلصَّلَوٰةِ", "translit": "ِẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 12, "arabic": "وَإِيتَآءِ", "translit": "ِءٓāَtyِiʾَw", "root": "اتي"}, {"id": 13, "arabic": "ٱلزَّكَوٰةِ", "translit": "ِẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 14, "arabic": "يَخَافُونَ", "translit": "َnwُfāَhkَy", "root": "خوف"}, {"id": 15, "arabic": "يَوْمًا", "translit": "āًmْwَy", "root": "يوم"}, {"id": 16, "arabic": "تَتَقَلَّبُ", "translit": "ُbَّlَqَtَt", "root": "قلب"}, {"id": 17, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 18, "arabic": "ٱلْقُلُوبُ", "translit": "ُbwُlُqْlٱ", "root": "قلب"}, {"id": 19, "arabic": "وَٱلْأَبْصَٰرُ", "translit": "ُrَٰṣْbَaʾْlٱَw", "root": "بصر"}], "hasIhya": true}, {"ayah": 38, "text": "لِيَجْزِيَهُمُ ٱللَّهُ أَحْسَنَ مَا عَمِلُوا۟ وَيَزِيدَهُم مِّن فَضْلِهِۦۗ وَٱللَّهُ يَرْزُقُ مَن يَشَآءُ بِغَيْرِ حِسَابٍ ", "translation": "That Allāh may reward them [according to] the best of what they did and increase them from His bounty. And Allāh gives provision to whom He wills without account [i.e., limit].", "words": [{"id": 1, "arabic": "لِيَجْزِيَهُمُ", "translit": "ُmُhَyِzْjgَyِl", "root": "جزي"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "أَحْسَنَ", "translit": "َnَsْḥَaʾ", "root": "حسن"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "عَمِلُوا۟", "translit": "۟āwُlِmَʿع", "root": "عمل"}, {"id": 6, "arabic": "وَيَزِيدَهُم", "translit": "mُhَdyِzَyَw", "root": "زيد"}, {"id": 7, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 8, "arabic": "فَضْلِهِۦ", "translit": "ۦِhِlْḍَf", "root": "فضل"}, {"id": 9, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 10, "arabic": "يَرْزُقُ", "translit": "ُqُzْrَy", "root": "رزق"}, {"id": 11, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 12, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 13, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 14, "arabic": "حِسَابٍ", "translit": "ٍbāَsِḥ", "root": "حسب"}], "hasIhya": true}, {"ayah": 39, "text": "وَٱلَّذِينَ كَفَرُوٓا۟ أَعْمَٰلُهُمْ كَسَرَابٍۭ بِقِيعَةٍ يَحْسَبُهُ ٱلظَّمْـَٔانُ مَآءً حَتَّىٰٓ إِذَا جَآءَهُۥ لَمْ يَجِدْهُ شَيْـًٔا وَوَجَدَ ٱللَّهَ عِندَهُۥ فَوَفَّىٰهُ حِسَابَهُۥۗ وَٱللَّهُ سَرِيعُ ٱلْحِسَابِ ", "translation": "But those who disbelieved - their deeds are like a mirage in a lowland which a thirsty one thinks is water until, when he comes to it, he finds it is nothing but finds Allāh before him, and He will pay him in full his due; and Allāh is swift in account.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 3, "arabic": "أَعْمَٰلُهُمْ", "translit": "ْmُhُlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 4, "arabic": "كَسَرَابٍۭ", "translit": "ٍۭbāَrَsَk", "root": "سرب"}, {"id": 5, "arabic": "بِقِيعَةٍ", "translit": "ٍẗَʿعyِqِb", "root": "قوع"}, {"id": 6, "arabic": "يَحْسَبُهُ", "translit": "ُhُbَsْḥَy", "root": "حسب"}, {"id": 7, "arabic": "ٱلظَّمْـَٔانُ", "translit": "ُnāَٔـْmَّẓlٱ", "root": "ظما"}, {"id": 8, "arabic": "مَآءً", "translit": "ًءٓāَm", "root": "موه"}, {"id": 9, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 10, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 11, "arabic": "جَآءَهُۥ", "translit": "ۥُhَءٓāَjg", "root": "جيا"}, {"id": 12, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 13, "arabic": "يَجِدْهُ", "translit": "ُhْdِjgَy", "root": "وجد"}, {"id": 14, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 15, "arabic": "وَوَجَدَ", "translit": "َdَjgَwَw", "root": "وجد"}, {"id": 16, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "عِندَهُۥ", "translit": "ۥُhَdnِʿع", "root": "عند"}, {"id": 18, "arabic": "فَوَفَّىٰهُ", "translit": "ُhٰàَّfَwَf", "root": "وفي"}, {"id": 19, "arabic": "حِسَابَهُۥ", "translit": "ۥُhَbāَsِḥ", "root": "حسب"}, {"id": 20, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 21, "arabic": "سَرِيعُ", "translit": "ُʿعyِrَs", "root": "سرع"}, {"id": 22, "arabic": "ٱلْحِسَابِ", "translit": "ِbāَsِḥْlٱ", "root": "حسب"}], "hasIhya": false}, {"ayah": 40, "text": "أَوْ كَظُلُمَٰتٍ فِى بَحْرٍ لُّجِّىٍّ يَغْشَىٰهُ مَوْجٌ مِّن فَوْقِهِۦ مَوْجٌ مِّن فَوْقِهِۦ سَحَابٌۚ ظُلُمَٰتٌۢ بَعْضُهَا فَوْقَ بَعْضٍ إِذَآ أَخْرَجَ يَدَهُۥ لَمْ يَكَدْ يَرَىٰهَاۗ وَمَن لَّمْ يَجْعَلِ ٱللَّهُ لَهُۥ نُورًا فَمَا لَهُۥ مِن نُّورٍ ", "translation": "Or [they are] like darknesses within an unfathomable sea which is covered by waves, upon which are waves, over which are clouds - darknesses, some of them upon others. When one puts out his hand [therein], he can hardly see it. And he to whom Allāh has not granted light - for him there is no light.", "words": [{"id": 1, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 2, "arabic": "كَظُلُمَٰتٍ", "translit": "ٍtَٰmُlُẓَk", "root": "ظلم"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "بَحْرٍ", "translit": "ٍrْḥَb", "root": "بحر"}, {"id": 5, "arabic": "لُّجِّىٍّ", "translit": "ٍّàِّjgُّl", "root": "لجج"}, {"id": 6, "arabic": "يَغْشَىٰهُ", "translit": "ُhٰàَhsْغَy", "root": "غشو"}, {"id": 7, "arabic": "مَوْجٌ", "translit": "ٌjgْwَm", "root": "موج"}, {"id": 8, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 9, "arabic": "فَوْقِهِۦ", "translit": "ۦِhِqْwَf", "root": "فوق"}, {"id": 10, "arabic": "مَوْجٌ", "translit": "ٌjgْwَm", "root": "موج"}, {"id": 11, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 12, "arabic": "فَوْقِهِۦ", "translit": "ۦِhِqْwَf", "root": "فوق"}, {"id": 13, "arabic": "سَحَابٌ", "translit": "ٌbāَḥَs", "root": "سحب"}, {"id": 14, "arabic": "ظُلُمَٰتٌۢ", "translit": "ٌۢtَٰmُlُẓ", "root": "ظلم"}, {"id": 15, "arabic": "بَعْضُهَا", "translit": "āَhُḍْʿعَb", "root": "بعض"}, {"id": 16, "arabic": "فَوْقَ", "translit": "َqْwَf", "root": "فوق"}, {"id": 17, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 18, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 19, "arabic": "أَخْرَجَ", "translit": "َjgَrْhkَaʾ", "root": "خرج"}, {"id": 20, "arabic": "يَدَهُۥ", "translit": "ۥُhَdَy", "root": "يدي"}, {"id": 21, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 22, "arabic": "يَكَدْ", "translit": "ْdَkَy", "root": "كود"}, {"id": 23, "arabic": "يَرَىٰهَا", "translit": "āَhٰàَrَy", "root": "راي"}, {"id": 24, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 25, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 26, "arabic": "يَجْعَلِ", "translit": "ِlَʿعْjgَy", "root": "جعل"}, {"id": 27, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 28, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 29, "arabic": "نُورًا", "translit": "āًrwُn", "root": "نور"}, {"id": 30, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 31, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 32, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 33, "arabic": "نُّورٍ", "translit": "ٍrwُّn", "root": "نور"}], "hasIhya": true}, {"ayah": 41, "text": "أَلَمْ تَرَ أَنَّ ٱللَّهَ يُسَبِّحُ لَهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَٱلطَّيْرُ صَٰٓفَّٰتٍۖ كُلٌّ قَدْ عَلِمَ صَلَاتَهُۥ وَتَسْبِيحَهُۥۗ وَٱللَّهُ عَلِيمٌۢ بِمَا يَفْعَلُونَ ", "translation": "Do you not see that Allāh is exalted by whomever is within the heavens and the earth and [by] the birds with wings spread [in flight]? Each [of them] has known his [means of] prayer and exalting [Him], and Allāh is Knowing of what they do.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "يُسَبِّحُ", "translit": "ُḥِّbَsُy", "root": "سبح"}, {"id": 6, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 7, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 10, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 11, "arabic": "وَٱلطَّيْرُ", "translit": "ُrْyَّṭlٱَw", "root": "طير"}, {"id": 12, "arabic": "صَٰٓفَّٰتٍ", "translit": "ٍtَّٰfَٰٓṣ", "root": "صفف"}, {"id": 13, "arabic": "كُلٌّ", "translit": "ٌّlُk", "root": "كلل"}, {"id": 14, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 15, "arabic": "عَلِمَ", "translit": "َmِlَʿع", "root": "علم"}, {"id": 16, "arabic": "صَلَاتَهُۥ", "translit": "ۥُhَtāَlَṣ", "root": "صلو"}, {"id": 17, "arabic": "وَتَسْبِيحَهُۥ", "translit": "ۥُhَḥyِbْsَtَw", "root": "سبح"}, {"id": 18, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 19, "arabic": "عَلِيمٌۢ", "translit": "ٌۢmyِlَʿع", "root": "علم"}, {"id": 20, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 21, "arabic": "يَفْعَلُونَ", "translit": "َnwُlَʿعْfَy", "root": "فعل"}], "hasIhya": true}, {"ayah": 42, "text": "وَلِلَّهِ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ وَإِلَى ٱللَّهِ ٱلْمَصِيرُ ", "translation": "And to Allāh belongs the dominion of the heavens and the earth, and to Allāh is the destination.", "words": [{"id": 1, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 2, "arabic": "مُلْكُ", "translit": "ُkْlُm", "root": "ملك"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "وَإِلَى", "translit": "àَlِiʾَw", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "ٱلْمَصِيرُ", "translit": "ُryِṣَmْlٱ", "root": "صير"}], "hasIhya": false}, {"ayah": 43, "text": "أَلَمْ تَرَ أَنَّ ٱللَّهَ يُزْجِى سَحَابًا ثُمَّ يُؤَلِّفُ بَيْنَهُۥ ثُمَّ يَجْعَلُهُۥ رُكَامًا فَتَرَى ٱلْوَدْقَ يَخْرُجُ مِنْ خِلَٰلِهِۦ وَيُنَزِّلُ مِنَ ٱلسَّمَآءِ مِن جِبَالٍ فِيهَا مِنۢ بَرَدٍ فَيُصِيبُ بِهِۦ مَن يَشَآءُ وَيَصْرِفُهُۥ عَن مَّن يَشَآءُۖ يَكَادُ سَنَا بَرْقِهِۦ يَذْهَبُ بِٱلْأَبْصَٰرِ ", "translation": "Do you not see that Allāh drives clouds? Then He brings them together; then He makes them into a mass, and you see the rain emerge from within it. And He sends down from the sky, mountains [of clouds] within which is hail, and He strikes with it whom He wills and averts it from whom He wills. The flash of its lightning almost takes away the eyesight.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "يُزْجِى", "translit": "àِjgْzُy", "root": "زجو"}, {"id": 6, "arabic": "سَحَابًا", "translit": "āًbāَḥَs", "root": "سحب"}, {"id": 7, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 8, "arabic": "يُؤَلِّفُ", "translit": "ُfِّlَwʾُy", "root": "الف"}, {"id": 9, "arabic": "بَيْنَهُۥ", "translit": "ۥُhَnْyَb", "root": "بين"}, {"id": 10, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 11, "arabic": "يَجْعَلُهُۥ", "translit": "ۥُhُlَʿعْjgَy", "root": "جعل"}, {"id": 12, "arabic": "رُكَامًا", "translit": "āًmāَkُr", "root": "ركم"}, {"id": 13, "arabic": "فَتَرَى", "translit": "àَrَtَf", "root": "راي"}, {"id": 14, "arabic": "ٱلْوَدْقَ", "translit": "َqْdَwْlٱ", "root": "ودق"}, {"id": 15, "arabic": "يَخْرُجُ", "translit": "ُjgُrْhkَy", "root": "خرج"}, {"id": 16, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 17, "arabic": "خِلَٰلِهِۦ", "translit": "ۦِhِlَٰlِhk", "root": "خلل"}, {"id": 18, "arabic": "وَيُنَزِّلُ", "translit": "ُlِّzَnُyَw", "root": "نزل"}, {"id": 19, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 20, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 21, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 22, "arabic": "جِبَالٍ", "translit": "ٍlāَbِjg", "root": "جبل"}, {"id": 23, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 24, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 25, "arabic": "بَرَدٍ", "translit": "ٍdَrَb", "root": "برد"}, {"id": 26, "arabic": "فَيُصِيبُ", "translit": "ُbyِṣُyَf", "root": "صوب"}, {"id": 27, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 28, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 29, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 30, "arabic": "وَيَصْرِفُهُۥ", "translit": "ۥُhُfِrْṣَyَw", "root": "صرف"}, {"id": 31, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 32, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 33, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 34, "arabic": "يَكَادُ", "translit": "ُdāَkَy", "root": "كود"}, {"id": 35, "arabic": "سَنَا", "translit": "āَnَs", "root": "سنو"}, {"id": 36, "arabic": "بَرْقِهِۦ", "translit": "ۦِhِqْrَb", "root": "برق"}, {"id": 37, "arabic": "يَذْهَبُ", "translit": "ُbَhْhdَy", "root": "ذهب"}, {"id": 38, "arabic": "بِٱلْأَبْصَٰرِ", "translit": "ِrَٰṣْbَaʾْlٱِb", "root": "بصر"}], "hasIhya": false}, {"ayah": 44, "text": "يُقَلِّبُ ٱللَّهُ ٱلَّيْلَ وَٱلنَّهَارَۚ إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّأُو۟لِى ٱلْأَبْصَٰرِ ", "translation": "Allāh alternates the night and the day. Indeed in that is a lesson for those who have vision.", "words": [{"id": 1, "arabic": "يُقَلِّبُ", "translit": "ُbِّlَqُy", "root": "قلب"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱلَّيْلَ", "translit": "َlْyَّlٱ", "root": "ليل"}, {"id": 4, "arabic": "وَٱلنَّهَارَ", "translit": "َrāَhَّnlٱَw", "root": "نهر"}, {"id": 5, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 8, "arabic": "لَعِبْرَةً", "translit": "ًẗَrْbِʿعَl", "root": "عبر"}, {"id": 9, "arabic": "لِّأُو۟لِى", "translit": "àِl۟wُaʾِّl", "root": ""}, {"id": 10, "arabic": "ٱلْأَبْصَٰرِ", "translit": "ِrَٰṣْbَaʾْlٱ", "root": "بصر"}], "hasIhya": true}, {"ayah": 45, "text": "وَٱللَّهُ خَلَقَ كُلَّ دَآبَّةٍ مِّن مَّآءٍۖ فَمِنْهُم مَّن يَمْشِى عَلَىٰ بَطْنِهِۦ وَمِنْهُم مَّن يَمْشِى عَلَىٰ رِجْلَيْنِ وَمِنْهُم مَّن يَمْشِى عَلَىٰٓ أَرْبَعٍۚ يَخْلُقُ ٱللَّهُ مَا يَشَآءُۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "Allāh has created every [living] creature from water. And of them are those that move on their bellies, and of them are those that walk on two legs, and of them are those that walk on four. Allāh creates what He wills. Indeed, Allāh is over all things competent.", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 4, "arabic": "دَآبَّةٍ", "translit": "ٍẗَّbٓāَd", "root": "دبب"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "مَّآءٍ", "translit": "ٍءٓāَّm", "root": "موه"}, {"id": 7, "arabic": "فَمِنْهُم", "translit": "mُhْnِmَf", "root": ""}, {"id": 8, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 9, "arabic": "يَمْشِى", "translit": "àِhsْmَy", "root": "مشي"}, {"id": 10, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 11, "arabic": "بَطْنِهِۦ", "translit": "ۦِhِnْṭَb", "root": "بطن"}, {"id": 12, "arabic": "وَمِنْهُم", "translit": "mُhْnِmَw", "root": ""}, {"id": 13, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 14, "arabic": "يَمْشِى", "translit": "àِhsْmَy", "root": "مشي"}, {"id": 15, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 16, "arabic": "رِجْلَيْنِ", "translit": "ِnْyَlْjgِr", "root": "رجل"}, {"id": 17, "arabic": "وَمِنْهُم", "translit": "mُhْnِmَw", "root": ""}, {"id": 18, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 19, "arabic": "يَمْشِى", "translit": "àِhsْmَy", "root": "مشي"}, {"id": 20, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 21, "arabic": "أَرْبَعٍ", "translit": "ٍʿعَbْrَaʾ", "root": "ربع"}, {"id": 22, "arabic": "يَخْلُقُ", "translit": "ُqُlْhkَy", "root": "خلق"}, {"id": 23, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 25, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 26, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 27, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 28, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 29, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 30, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 31, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 46, "text": "لَّقَدْ أَنزَلْنَآ ءَايَٰتٍ مُّبَيِّنَٰتٍۚ وَٱللَّهُ يَهْدِى مَن يَشَآءُ إِلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ ", "translation": "We have certainly sent down distinct verses. And Allāh guides whom He wills to a straight path.", "words": [{"id": 1, "arabic": "لَّقَدْ", "translit": "ْdَqَّl", "root": ""}, {"id": 2, "arabic": "أَنزَلْنَآ", "translit": "ٓāَnْlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "ءَايَٰتٍ", "translit": "ٍtَٰyāَء", "root": "ايي"}, {"id": 4, "arabic": "مُّبَيِّنَٰتٍ", "translit": "ٍtَٰnِّyَbُّm", "root": "بين"}, {"id": 5, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 6, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 7, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 8, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 9, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 10, "arabic": "صِرَٰطٍ", "translit": "ٍṭَٰrِṣ", "root": "صرط"}, {"id": 11, "arabic": "مُّسْتَقِيمٍ", "translit": "ٍmyِqَtْsُّm", "root": "قوم"}], "hasIhya": false}, {"ayah": 47, "text": "وَيَقُولُونَ ءَامَنَّا بِٱللَّهِ وَبِٱلرَّسُولِ وَأَطَعْنَا ثُمَّ يَتَوَلَّىٰ فَرِيقٌ مِّنْهُم مِّنۢ بَعْدِ ذَٰلِكَۚ وَمَآ أُو۟لَٰٓئِكَ بِٱلْمُؤْمِنِينَ ", "translation": "But they [i.e., the hypocrites] say, \"We have believed in Allāh and in the Messenger, and we obey\"; then a party of them turns away after that. And those are not believers.", "words": [{"id": 1, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 2, "arabic": "ءَامَنَّا", "translit": "āَّnَmāَء", "root": "امن"}, {"id": 3, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 4, "arabic": "وَبِٱلرَّسُولِ", "translit": "ِlwُsَّrlٱِbَw", "root": "رسل"}, {"id": 5, "arabic": "وَأَطَعْنَا", "translit": "āَnْʿعَṭَaʾَw", "root": "طوع"}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "يَتَوَلَّىٰ", "translit": "ٰàَّlَwَtَy", "root": "ولي"}, {"id": 8, "arabic": "فَرِيقٌ", "translit": "ٌqyِrَf", "root": "فرق"}, {"id": 9, "arabic": "مِّنْهُم", "translit": "mُhْnِّm", "root": ""}, {"id": 10, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 11, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 13, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 14, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 15, "arabic": "بِٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱِb", "root": "امن"}], "hasIhya": false}, {"ayah": 48, "text": "وَإِذَا دُعُوٓا۟ إِلَى ٱللَّهِ وَرَسُولِهِۦ لِيَحْكُمَ بَيْنَهُمْ إِذَا فَرِيقٌ مِّنْهُم مُّعْرِضُونَ ", "translation": "And when they are called to [the words of] Allāh and His Messenger to judge between them, at once a party of them turns aside [in refusal].", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "دُعُوٓا۟", "translit": "۟āٓwُʿعُd", "root": "دعو"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَرَسُولِهِۦ", "translit": "ۦِhِlwُsَrَw", "root": "رسل"}, {"id": 6, "arabic": "لِيَحْكُمَ", "translit": "َmُkْḥَyِl", "root": "حكم"}, {"id": 7, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 8, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 9, "arabic": "فَرِيقٌ", "translit": "ٌqyِrَf", "root": "فرق"}, {"id": 10, "arabic": "مِّنْهُم", "translit": "mُhْnِّm", "root": ""}, {"id": 11, "arabic": "مُّعْرِضُونَ", "translit": "َnwُḍِrْʿعُّm", "root": "عرض"}], "hasIhya": true}, {"ayah": 49, "text": "وَإِن يَكُن لَّهُمُ ٱلْحَقُّ يَأْتُوٓا۟ إِلَيْهِ مُذْعِنِينَ ", "translation": "But if the right is theirs, they come to him in prompt obedience.", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "يَكُن", "translit": "nُkَy", "root": "كون"}, {"id": 3, "arabic": "لَّهُمُ", "translit": "ُmُhَّl", "root": ""}, {"id": 4, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 5, "arabic": "يَأْتُوٓا۟", "translit": "۟āٓwُtْaʾَy", "root": "اتي"}, {"id": 6, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 7, "arabic": "مُذْعِنِينَ", "translit": "َnyِnِʿعْhdُm", "root": "ذعن"}], "hasIhya": false}, {"ayah": 50, "text": "أَفِى قُلُوبِهِم مَّرَضٌ أَمِ ٱرْتَابُوٓا۟ أَمْ يَخَافُونَ أَن يَحِيفَ ٱللَّهُ عَلَيْهِمْ وَرَسُولُهُۥۚ بَلْ أُو۟لَٰٓئِكَ هُمُ ٱلظَّٰلِمُونَ ", "translation": "Is there disease in their hearts? Or have they doubted? Or do they fear that Allāh will be unjust to them, or His Messenger? Rather, it is they who are the wrongdoers [i.e., the unjust].", "words": [{"id": 1, "arabic": "أَفِى", "translit": "àِfَaʾ", "root": ""}, {"id": 2, "arabic": "قُلُوبِهِم", "translit": "mِhِbwُlُq", "root": "قلب"}, {"id": 3, "arabic": "مَّرَضٌ", "translit": "ٌḍَrَّm", "root": "مرض"}, {"id": 4, "arabic": "أَمِ", "translit": "ِmَaʾ", "root": ""}, {"id": 5, "arabic": "ٱرْتَابُوٓا۟", "translit": "۟āٓwُbāَtْrٱ", "root": "ريب"}, {"id": 6, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 7, "arabic": "يَخَافُونَ", "translit": "َnwُfāَhkَy", "root": "خوف"}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "يَحِيفَ", "translit": "َfyِḥَy", "root": "حيف"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 12, "arabic": "وَرَسُولُهُۥ", "translit": "ۥُhُlwُsَrَw", "root": "رسل"}, {"id": 13, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 14, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 15, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 16, "arabic": "ٱلظَّٰلِمُونَ", "translit": "َnwُmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 51, "text": "إِنَّمَا كَانَ قَوْلَ ٱلْمُؤْمِنِينَ إِذَا دُعُوٓا۟ إِلَى ٱللَّهِ وَرَسُولِهِۦ لِيَحْكُمَ بَيْنَهُمْ أَن يَقُولُوا۟ سَمِعْنَا وَأَطَعْنَاۚ وَأُو۟لَٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ ", "translation": "The only statement of the [true] believers when they are called to Allāh and His Messenger to judge between them is that they say, \"We hear and we obey.\" And those are the successful.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "قَوْلَ", "translit": "َlْwَq", "root": "قول"}, {"id": 4, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 5, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 6, "arabic": "دُعُوٓا۟", "translit": "۟āٓwُʿعُd", "root": "دعو"}, {"id": 7, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "وَرَسُولِهِۦ", "translit": "ۦِhِlwُsَrَw", "root": "رسل"}, {"id": 10, "arabic": "لِيَحْكُمَ", "translit": "َmُkْḥَyِl", "root": "حكم"}, {"id": 11, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 12, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 13, "arabic": "يَقُولُوا۟", "translit": "۟āwُlwُqَy", "root": "قول"}, {"id": 14, "arabic": "سَمِعْنَا", "translit": "āَnْʿعِmَs", "root": "سمع"}, {"id": 15, "arabic": "وَأَطَعْنَا", "translit": "āَnْʿعَṭَaʾَw", "root": "طوع"}, {"id": 16, "arabic": "وَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَw", "root": ""}, {"id": 17, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 18, "arabic": "ٱلْمُفْلِحُونَ", "translit": "َnwُḥِlْfُmْlٱ", "root": "فلح"}], "hasIhya": false}, {"ayah": 52, "text": "وَمَن يُطِعِ ٱللَّهَ وَرَسُولَهُۥ وَيَخْشَ ٱللَّهَ وَيَتَّقْهِ فَأُو۟لَٰٓئِكَ هُمُ ٱلْفَآئِزُونَ ", "translation": "And whoever obeys Allāh and His Messenger and fears Allāh and is conscious of Him - it is those who are the attainers.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يُطِعِ", "translit": "ِʿعِṭُy", "root": "طوع"}, {"id": 3, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "وَرَسُولَهُۥ", "translit": "ۥُhَlwُsَrَw", "root": "رسل"}, {"id": 5, "arabic": "وَيَخْشَ", "translit": "َhsْhkَyَw", "root": "خشي"}, {"id": 6, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "وَيَتَّقْهِ", "translit": "ِhْqَّtَyَw", "root": "وقي"}, {"id": 8, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 9, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 10, "arabic": "ٱلْفَآئِزُونَ", "translit": "َnwُzِyʾٓāَfْlٱ", "root": "فوز"}], "hasIhya": true}, {"ayah": 53, "text": "وَأَقْسَمُوا۟ بِٱللَّهِ جَهْدَ أَيْمَٰنِهِمْ لَئِنْ أَمَرْتَهُمْ لَيَخْرُجُنَّۖ قُل لَّا تُقْسِمُوا۟ۖ طَاعَةٌ مَّعْرُوفَةٌۚ إِنَّ ٱللَّهَ خَبِيرٌۢ بِمَا تَعْمَلُونَ ", "translation": "And they swear by Allāh their strongest oaths that if you ordered them, they would go forth [in Allāh's cause]. Say, \"Do not swear. [Such] obedience is known.[1] Indeed, Allāh is [fully] Aware of that which you do.\"", "words": [{"id": 1, "arabic": "وَأَقْسَمُوا۟", "translit": "۟āwُmَsْqَaʾَw", "root": "قسم"}, {"id": 2, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 3, "arabic": "جَهْدَ", "translit": "َdْhَjg", "root": "جهد"}, {"id": 4, "arabic": "أَيْمَٰنِهِمْ", "translit": "ْmِhِnَٰmْyَaʾ", "root": "يمن"}, {"id": 5, "arabic": "لَئِنْ", "translit": "ْnِyʾَl", "root": ""}, {"id": 6, "arabic": "أَمَرْتَهُمْ", "translit": "ْmُhَtْrَmَaʾ", "root": "امر"}, {"id": 7, "arabic": "لَيَخْرُجُنَّ", "translit": "َّnُjgُrْhkَyَl", "root": "خرج"}, {"id": 8, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 9, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 10, "arabic": "تُقْسِمُوا۟", "translit": "۟āwُmِsْqُt", "root": "قسم"}, {"id": 11, "arabic": "طَاعَةٌ", "translit": "ٌẗَʿعāَṭ", "root": "طوع"}, {"id": 12, "arabic": "مَّعْرُوفَةٌ", "translit": "ٌẗَfwُrْʿعَّm", "root": "عرف"}, {"id": 13, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 14, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "خَبِيرٌۢ", "translit": "ٌۢryِbَhk", "root": "خبر"}, {"id": 16, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 17, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 54, "text": "قُلْ أَطِيعُوا۟ ٱللَّهَ وَأَطِيعُوا۟ ٱلرَّسُولَۖ فَإِن تَوَلَّوْا۟ فَإِنَّمَا عَلَيْهِ مَا حُمِّلَ وَعَلَيْكُم مَّا حُمِّلْتُمْۖ وَإِن تُطِيعُوهُ تَهْتَدُوا۟ۚ وَمَا عَلَى ٱلرَّسُولِ إِلَّا ٱلْبَلَٰغُ ٱلْمُبِينُ ", "translation": "Say, \"Obey Allāh and obey the Messenger; but if you turn away - then upon him is only that [duty] with which he has been charged, and upon you is that with which you have been charged. And if you obey him, you will be [rightly] guided. And there is not upon the Messenger except the [responsibility for] clear notification.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَطِيعُوا۟", "translit": "۟āwُʿعyِṭَaʾ", "root": "طوع"}, {"id": 3, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "وَأَطِيعُوا۟", "translit": "۟āwُʿعyِṭَaʾَw", "root": "طوع"}, {"id": 5, "arabic": "ٱلرَّسُولَ", "translit": "َlwُsَّrlٱ", "root": "رسل"}, {"id": 6, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 7, "arabic": "تَوَلَّوْا۟", "translit": "۟āْwَّlَwَt", "root": "ولي"}, {"id": 8, "arabic": "فَإِنَّمَا", "translit": "āَmَّnِiʾَf", "root": ""}, {"id": 9, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 10, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 11, "arabic": "حُمِّلَ", "translit": "َlِّmُḥ", "root": "حمل"}, {"id": 12, "arabic": "وَعَلَيْكُم", "translit": "mُkْyَlَʿعَw", "root": ""}, {"id": 13, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 14, "arabic": "حُمِّلْتُمْ", "translit": "ْmُtْlِّmُḥ", "root": "حمل"}, {"id": 15, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 16, "arabic": "تُطِيعُوهُ", "translit": "ُhwُʿعyِṭُt", "root": "طوع"}, {"id": 17, "arabic": "تَهْتَدُوا۟", "translit": "۟āwُdَtْhَt", "root": "هدي"}, {"id": 18, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 19, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 20, "arabic": "ٱلرَّسُولِ", "translit": "ِlwُsَّrlٱ", "root": "رسل"}, {"id": 21, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 22, "arabic": "ٱلْبَلَٰغُ", "translit": "ُغَٰlَbْlٱ", "root": "بلغ"}, {"id": 23, "arabic": "ٱلْمُبِينُ", "translit": "ُnyِbُmْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 55, "text": "وَعَدَ ٱللَّهُ ٱلَّذِينَ ءَامَنُوا۟ مِنكُمْ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَيَسْتَخْلِفَنَّهُمْ فِى ٱلْأَرْضِ كَمَا ٱسْتَخْلَفَ ٱلَّذِينَ مِن قَبْلِهِمْ وَلَيُمَكِّنَنَّ لَهُمْ دِينَهُمُ ٱلَّذِى ٱرْتَضَىٰ لَهُمْ وَلَيُبَدِّلَنَّهُم مِّنۢ بَعْدِ خَوْفِهِمْ أَمْنًاۚ يَعْبُدُونَنِى لَا يُشْرِكُونَ بِى شَيْـًٔاۚ وَمَن كَفَرَ بَعْدَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْفَٰسِقُونَ ", "translation": "Allāh has promised those who have believed among you and done righteous deeds that He will surely grant them succession [to authority] upon the earth just as He granted it to those before them and that He will surely establish for them [therein] their religion which He has preferred for them and that He will surely substitute for them, after their fear, security, [for] they worship Me, not associating anything with Me. But whoever disbelieves[1] after that - then those are the defiantly disobedient.", "words": [{"id": 1, "arabic": "وَعَدَ", "translit": "َdَʿعَw", "root": "وعد"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 5, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 6, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 7, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 8, "arabic": "لَيَسْتَخْلِفَنَّهُمْ", "translit": "ْmُhَّnَfِlْhkَtْsَyَl", "root": "خلف"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 11, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 12, "arabic": "ٱسْتَخْلَفَ", "translit": "َfَlْhkَtْsٱ", "root": "خلف"}, {"id": 13, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "قَبْلِهِمْ", "translit": "ْmِhِlْbَq", "root": "قبل"}, {"id": 16, "arabic": "وَلَيُمَكِّنَنَّ", "translit": "َّnَnِّkَmُyَlَw", "root": "مكن"}, {"id": 17, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 18, "arabic": "دِينَهُمُ", "translit": "ُmُhَnyِd", "root": "دين"}, {"id": 19, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 20, "arabic": "ٱرْتَضَىٰ", "translit": "ٰàَḍَtْrٱ", "root": "رضو"}, {"id": 21, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 22, "arabic": "وَلَيُبَدِّلَنَّهُم", "translit": "mُhَّnَlِّdَbُyَlَw", "root": "بدل"}, {"id": 23, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 24, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 25, "arabic": "خَوْفِهِمْ", "translit": "ْmِhِfْwَhk", "root": "خوف"}, {"id": 26, "arabic": "أَمْنًا", "translit": "āًnْmَaʾ", "root": "امن"}, {"id": 27, "arabic": "يَعْبُدُونَنِى", "translit": "àِnَnwُdُbْʿعَy", "root": "عبد"}, {"id": 28, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 29, "arabic": "يُشْرِكُونَ", "translit": "َnwُkِrْhsُy", "root": "شرك"}, {"id": 30, "arabic": "بِى", "translit": "àِb", "root": ""}, {"id": 31, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 32, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 33, "arabic": "كَفَرَ", "translit": "َrَfَk", "root": "كفر"}, {"id": 34, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 35, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 36, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 37, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 38, "arabic": "ٱلْفَٰسِقُونَ", "translit": "َnwُqِsَٰfْlٱ", "root": "فسق"}], "hasIhya": false}, {"ayah": 56, "text": "وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ وَأَطِيعُوا۟ ٱلرَّسُولَ لَعَلَّكُمْ تُرْحَمُونَ ", "translation": "And establish prayer and give zakāh and obey the Messenger - that you may receive mercy.", "words": [{"id": 1, "arabic": "وَأَقِيمُوا۟", "translit": "۟āwُmyِqَaʾَw", "root": "قوم"}, {"id": 2, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 3, "arabic": "وَءَاتُوا۟", "translit": "۟āwُtāَءَw", "root": "اتي"}, {"id": 4, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 5, "arabic": "وَأَطِيعُوا۟", "translit": "۟āwُʿعyِṭَaʾَw", "root": "طوع"}, {"id": 6, "arabic": "ٱلرَّسُولَ", "translit": "َlwُsَّrlٱ", "root": "رسل"}, {"id": 7, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 8, "arabic": "تُرْحَمُونَ", "translit": "َnwُmَḥْrُt", "root": "رحم"}], "hasIhya": true}, {"ayah": 57, "text": "لَا تَحْسَبَنَّ ٱلَّذِينَ كَفَرُوا۟ مُعْجِزِينَ فِى ٱلْأَرْضِۚ وَمَأْوَىٰهُمُ ٱلنَّارُۖ وَلَبِئْسَ ٱلْمَصِيرُ ", "translation": "Never think that the disbelievers are causing failure [to Allāh] upon the earth. Their refuge will be the Fire - and how wretched the destination.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "تَحْسَبَنَّ", "translit": "َّnَbَsْḥَt", "root": "حسب"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 5, "arabic": "مُعْجِزِينَ", "translit": "َnyِzِjgْʿعُm", "root": "عجز"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "وَمَأْوَىٰهُمُ", "translit": "ُmُhٰàَwْaʾَmَw", "root": "اوي"}, {"id": 9, "arabic": "ٱلنَّارُ", "translit": "ُrāَّnlٱ", "root": "نور"}, {"id": 10, "arabic": "وَلَبِئْسَ", "translit": "َsْyʾِbَlَw", "root": "باس"}, {"id": 11, "arabic": "ٱلْمَصِيرُ", "translit": "ُryِṣَmْlٱ", "root": "صير"}], "hasIhya": false}, {"ayah": 58, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لِيَسْتَـْٔذِنكُمُ ٱلَّذِينَ مَلَكَتْ أَيْمَٰنُكُمْ وَٱلَّذِينَ لَمْ يَبْلُغُوا۟ ٱلْحُلُمَ مِنكُمْ ثَلَٰثَ مَرَّٰتٍۚ مِّن قَبْلِ صَلَوٰةِ ٱلْفَجْرِ وَحِينَ تَضَعُونَ ثِيَابَكُم مِّنَ ٱلظَّهِيرَةِ وَمِنۢ بَعْدِ صَلَوٰةِ ٱلْعِشَآءِۚ ثَلَٰثُ عَوْرَٰتٍ لَّكُمْۚ لَيْسَ عَلَيْكُمْ وَلَا عَلَيْهِمْ جُنَاحٌۢ بَعْدَهُنَّۚ طَوَّٰفُونَ عَلَيْكُم بَعْضُكُمْ عَلَىٰ بَعْضٍۚ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمُ ٱلْءَايَٰتِۗ وَٱللَّهُ عَلِيمٌ حَكِيمٌ ", "translation": "O you who have believed, let those whom your right hands possess and those who have not [yet] reached puberty among you ask permission of you [before entering] at three times: before the dawn prayer and when you put aside your clothing [for rest] at noon and after the night prayer. [These are] three times of privacy[1] for you. There is no blame upon you nor upon them beyond these [periods], for they continually circulate among you - some of you, among others. Thus does Allāh make clear to you the verses [i.e., His ordinances]; and Allāh is Knowing and Wise.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لِيَسْتَـْٔذِنكُمُ", "translit": "ُmُknِhdْٔـَtْsَyِl", "root": "اذن"}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "مَلَكَتْ", "translit": "ْtَkَlَm", "root": "ملك"}, {"id": 7, "arabic": "أَيْمَٰنُكُمْ", "translit": "ْmُkُnَٰmْyَaʾ", "root": "يمن"}, {"id": 8, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 9, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 10, "arabic": "يَبْلُغُوا۟", "translit": "۟āwُغُlْbَy", "root": "بلغ"}, {"id": 11, "arabic": "ٱلْحُلُمَ", "translit": "َmُlُḥْlٱ", "root": "حلم"}, {"id": 12, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 13, "arabic": "ثَلَٰثَ", "translit": "َhtَٰlَht", "root": "ثلث"}, {"id": 14, "arabic": "مَرَّٰتٍ", "translit": "ٍtَّٰrَm", "root": "مرر"}, {"id": 15, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 16, "arabic": "قَبْلِ", "translit": "ِlْbَq", "root": "قبل"}, {"id": 17, "arabic": "صَلَوٰةِ", "translit": "ِẗٰwَlَṣ", "root": "صلو"}, {"id": 18, "arabic": "ٱلْفَجْرِ", "translit": "ِrْjgَfْlٱ", "root": "فجر"}, {"id": 19, "arabic": "وَحِينَ", "translit": "َnyِḥَw", "root": "حين"}, {"id": 20, "arabic": "تَضَعُونَ", "translit": "َnwُʿعَḍَt", "root": "وضع"}, {"id": 21, "arabic": "ثِيَابَكُم", "translit": "mُkَbāَyِht", "root": "ثوب"}, {"id": 22, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 23, "arabic": "ٱلظَّهِيرَةِ", "translit": "ِẗَryِhَّẓlٱ", "root": "ظهر"}, {"id": 24, "arabic": "وَمِنۢ", "translit": "ۢnِmَw", "root": ""}, {"id": 25, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 26, "arabic": "صَلَوٰةِ", "translit": "ِẗٰwَlَṣ", "root": "صلو"}, {"id": 27, "arabic": "ٱلْعِشَآءِ", "translit": "ِءٓāَhsِʿعْlٱ", "root": "عشو"}, {"id": 28, "arabic": "ثَلَٰثُ", "translit": "ُhtَٰlَht", "root": "ثلث"}, {"id": 29, "arabic": "عَوْرَٰتٍ", "translit": "ٍtَٰrْwَʿع", "root": "عور"}, {"id": 30, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 31, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 32, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 33, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 34, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 35, "arabic": "جُنَاحٌۢ", "translit": "ٌۢḥāَnُjg", "root": "جنح"}, {"id": 36, "arabic": "بَعْدَهُنَّ", "translit": "َّnُhَdْʿعَb", "root": "بعد"}, {"id": 37, "arabic": "طَوَّٰفُونَ", "translit": "َnwُfَّٰwَṭ", "root": "طوف"}, {"id": 38, "arabic": "عَلَيْكُم", "translit": "mُkْyَlَʿع", "root": ""}, {"id": 39, "arabic": "بَعْضُكُمْ", "translit": "ْmُkُḍْʿعَb", "root": "بعض"}, {"id": 40, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 41, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 42, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 43, "arabic": "يُبَيِّنُ", "translit": "ُnِّyَbُy", "root": "بين"}, {"id": 44, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 45, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 46, "arabic": "ٱلْءَايَٰتِ", "translit": "ِtَٰyāَءْlٱ", "root": "ايي"}, {"id": 47, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 48, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}, {"id": 49, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": true}, {"ayah": 59, "text": "وَإِذَا بَلَغَ ٱلْأَطْفَٰلُ مِنكُمُ ٱلْحُلُمَ فَلْيَسْتَـْٔذِنُوا۟ كَمَا ٱسْتَـْٔذَنَ ٱلَّذِينَ مِن قَبْلِهِمْۚ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمْ ءَايَٰتِهِۦۗ وَٱللَّهُ عَلِيمٌ حَكِيمٌ ", "translation": "And when the children among you reach puberty, let them ask permission [at all times] as those before them have done. Thus does Allāh make clear to you His verses; and Allāh is Knowing and Wise.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "بَلَغَ", "translit": "َغَlَb", "root": "بلغ"}, {"id": 3, "arabic": "ٱلْأَطْفَٰلُ", "translit": "ُlَٰfْṭَaʾْlٱ", "root": "طفل"}, {"id": 4, "arabic": "مِنكُمُ", "translit": "ُmُknِm", "root": ""}, {"id": 5, "arabic": "ٱلْحُلُمَ", "translit": "َmُlُḥْlٱ", "root": "حلم"}, {"id": 6, "arabic": "فَلْيَسْتَـْٔذِنُوا۟", "translit": "۟āwُnِhdْٔـَtْsَyْlَf", "root": "اذن"}, {"id": 7, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 8, "arabic": "ٱسْتَـْٔذَنَ", "translit": "َnَhdْٔـَtْsٱ", "root": "اذن"}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "قَبْلِهِمْ", "translit": "ْmِhِlْbَq", "root": "قبل"}, {"id": 12, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 13, "arabic": "يُبَيِّنُ", "translit": "ُnِّyَbُy", "root": "بين"}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 16, "arabic": "ءَايَٰتِهِۦ", "translit": "ۦِhِtَٰyāَء", "root": "ايي"}, {"id": 17, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 18, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}, {"id": 19, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": false}, {"ayah": 60, "text": "وَٱلْقَوَٰعِدُ مِنَ ٱلنِّسَآءِ ٱلَّٰتِى لَا يَرْجُونَ نِكَاحًا فَلَيْسَ عَلَيْهِنَّ جُنَاحٌ أَن يَضَعْنَ ثِيَابَهُنَّ غَيْرَ مُتَبَرِّجَٰتٍۭ بِزِينَةٍۖ وَأَن يَسْتَعْفِفْنَ خَيْرٌ لَّهُنَّۗ وَٱللَّهُ سَمِيعٌ عَلِيمٌ ", "translation": "And women of post-menstrual age who have no desire for marriage - there is no blame upon them for putting aside their outer garments [but] not displaying adornment. But to modestly refrain [from that] is better for them. And Allāh is Hearing and Knowing.", "words": [{"id": 1, "arabic": "وَٱلْقَوَٰعِدُ", "translit": "ُdِʿعَٰwَqْlٱَw", "root": "قعد"}, {"id": 2, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 3, "arabic": "ٱلنِّسَآءِ", "translit": "ِءٓāَsِّnlٱ", "root": "نسو"}, {"id": 4, "arabic": "ٱلَّٰتِى", "translit": "àِtَّٰlٱ", "root": ""}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "يَرْجُونَ", "translit": "َnwُjgْrَy", "root": "رجو"}, {"id": 7, "arabic": "نِكَاحًا", "translit": "āًḥāَkِn", "root": "نكح"}, {"id": 8, "arabic": "فَلَيْسَ", "translit": "َsْyَlَf", "root": "ليس"}, {"id": 9, "arabic": "عَلَيْهِنَّ", "translit": "َّnِhْyَlَʿع", "root": ""}, {"id": 10, "arabic": "جُنَاحٌ", "translit": "ٌḥāَnُjg", "root": "جنح"}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "يَضَعْنَ", "translit": "َnْʿعَḍَy", "root": "وضع"}, {"id": 13, "arabic": "ثِيَابَهُنَّ", "translit": "َّnُhَbāَyِht", "root": "ثوب"}, {"id": 14, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 15, "arabic": "مُتَبَرِّجَٰتٍۭ", "translit": "ٍۭtَٰjgِّrَbَtُm", "root": "برج"}, {"id": 16, "arabic": "بِزِينَةٍ", "translit": "ٍẗَnyِzِb", "root": "زين"}, {"id": 17, "arabic": "وَأَن", "translit": "nَaʾَw", "root": ""}, {"id": 18, "arabic": "يَسْتَعْفِفْنَ", "translit": "َnْfِfْʿعَtْsَy", "root": "عفف"}, {"id": 19, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 20, "arabic": "لَّهُنَّ", "translit": "َّnُhَّl", "root": ""}, {"id": 21, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 22, "arabic": "سَمِيعٌ", "translit": "ٌʿعyِmَs", "root": "سمع"}, {"id": 23, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 61, "text": "لَّيْسَ عَلَى ٱلْأَعْمَىٰ حَرَجٌ وَلَا عَلَى ٱلْأَعْرَجِ حَرَجٌ وَلَا عَلَى ٱلْمَرِيضِ حَرَجٌ وَلَا عَلَىٰٓ أَنفُسِكُمْ أَن تَأْكُلُوا۟ مِنۢ بُيُوتِكُمْ أَوْ بُيُوتِ ءَابَآئِكُمْ أَوْ بُيُوتِ أُمَّهَٰتِكُمْ أَوْ بُيُوتِ إِخْوَٰنِكُمْ أَوْ بُيُوتِ أَخَوَٰتِكُمْ أَوْ بُيُوتِ أَعْمَٰمِكُمْ أَوْ بُيُوتِ عَمَّٰتِكُمْ أَوْ بُيُوتِ أَخْوَٰلِكُمْ أَوْ بُيُوتِ خَٰلَٰتِكُمْ أَوْ مَا مَلَكْتُم مَّفَاتِحَهُۥٓ أَوْ صَدِيقِكُمْۚ لَيْسَ عَلَيْكُمْ جُنَاحٌ أَن تَأْكُلُوا۟ جَمِيعًا أَوْ أَشْتَاتًاۚ فَإِذَا دَخَلْتُم بُيُوتًا فَسَلِّمُوا۟ عَلَىٰٓ أَنفُسِكُمْ تَحِيَّةً مِّنْ عِندِ ٱللَّهِ مُبَٰرَكَةً طَيِّبَةًۚ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمُ ٱلْءَايَٰتِ لَعَلَّكُمْ تَعْقِلُونَ ", "translation": "There is not upon the blind [any] constraint nor upon the lame constraint nor upon the ill constraint nor upon yourselves when you eat from your [own] houses or the houses of your fathers or the houses of your mothers or the houses of your brothers or the houses of your sisters or the houses of your father's brothers or the houses of your father's sisters or the houses of your mother's brothers or the houses of your mother's sisters or [from houses] whose keys you possess or [from the house] of your friend. There is no blame upon you whether you eat together or separately. But when you enter houses, give greetings of peace[1] upon each other - a greeting from Allāh, blessed and good. Thus does Allāh make clear to you the verses [of ordinance] that you may understand.", "words": [{"id": 1, "arabic": "لَّيْسَ", "translit": "َsْyَّl", "root": "ليس"}, {"id": 2, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلْأَعْمَىٰ", "translit": "ٰàَmْʿعَaʾْlٱ", "root": "عمي"}, {"id": 4, "arabic": "حَرَجٌ", "translit": "ٌjgَrَḥ", "root": "حرج"}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 7, "arabic": "ٱلْأَعْرَجِ", "translit": "ِjgَrْʿعَaʾْlٱ", "root": "عرج"}, {"id": 8, "arabic": "حَرَجٌ", "translit": "ٌjgَrَḥ", "root": "حرج"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 11, "arabic": "ٱلْمَرِيضِ", "translit": "ِḍyِrَmْlٱ", "root": "مرض"}, {"id": 12, "arabic": "حَرَجٌ", "translit": "ٌjgَrَḥ", "root": "حرج"}, {"id": 13, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 14, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 15, "arabic": "أَنفُسِكُمْ", "translit": "ْmُkِsُfnَaʾ", "root": "نفس"}, {"id": 16, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 17, "arabic": "تَأْكُلُوا۟", "translit": "۟āwُlُkْaʾَt", "root": "اكل"}, {"id": 18, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 19, "arabic": "بُيُوتِكُمْ", "translit": "ْmُkِtwُyُb", "root": "بيت"}, {"id": 20, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 21, "arabic": "بُيُوتِ", "translit": "ِtwُyُb", "root": "بيت"}, {"id": 22, "arabic": "ءَابَآئِكُمْ", "translit": "ْmُkِyʾٓāَbāَء", "root": "ابو"}, {"id": 23, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 24, "arabic": "بُيُوتِ", "translit": "ِtwُyُb", "root": "بيت"}, {"id": 25, "arabic": "أُمَّهَٰتِكُمْ", "translit": "ْmُkِtَٰhَّmُaʾ", "root": "امم"}, {"id": 26, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 27, "arabic": "بُيُوتِ", "translit": "ِtwُyُb", "root": "بيت"}, {"id": 28, "arabic": "إِخْوَٰنِكُمْ", "translit": "ْmُkِnَٰwْhkِiʾ", "root": "اخو"}, {"id": 29, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 30, "arabic": "بُيُوتِ", "translit": "ِtwُyُb", "root": "بيت"}, {"id": 31, "arabic": "أَخَوَٰتِكُمْ", "translit": "ْmُkِtَٰwَhkَaʾ", "root": "اخو"}, {"id": 32, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 33, "arabic": "بُيُوتِ", "translit": "ِtwُyُb", "root": "بيت"}, {"id": 34, "arabic": "أَعْمَٰمِكُمْ", "translit": "ْmُkِmَٰmْʿعَaʾ", "root": "عمم"}, {"id": 35, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 36, "arabic": "بُيُوتِ", "translit": "ِtwُyُb", "root": "بيت"}, {"id": 37, "arabic": "عَمَّٰتِكُمْ", "translit": "ْmُkِtَّٰmَʿع", "root": "عمم"}, {"id": 38, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 39, "arabic": "بُيُوتِ", "translit": "ِtwُyُb", "root": "بيت"}, {"id": 40, "arabic": "أَخْوَٰلِكُمْ", "translit": "ْmُkِlَٰwْhkَaʾ", "root": "خول"}, {"id": 41, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 42, "arabic": "بُيُوتِ", "translit": "ِtwُyُb", "root": "بيت"}, {"id": 43, "arabic": "خَٰلَٰتِكُمْ", "translit": "ْmُkِtَٰlَٰhk", "root": "خول"}, {"id": 44, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 45, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 46, "arabic": "مَلَكْتُم", "translit": "mُtْkَlَm", "root": "ملك"}, {"id": 47, "arabic": "مَّفَاتِحَهُۥٓ", "translit": "ٓۥُhَḥِtāَfَّm", "root": "فتح"}, {"id": 48, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 49, "arabic": "صَدِيقِكُمْ", "translit": "ْmُkِqyِdَṣ", "root": "صدق"}, {"id": 50, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 51, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 52, "arabic": "جُنَاحٌ", "translit": "ٌḥāَnُjg", "root": "جنح"}, {"id": 53, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 54, "arabic": "تَأْكُلُوا۟", "translit": "۟āwُlُkْaʾَt", "root": "اكل"}, {"id": 55, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 56, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 57, "arabic": "أَشْتَاتًا", "translit": "āًtāَtْhsَaʾ", "root": "شتت"}, {"id": 58, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 59, "arabic": "دَخَلْتُم", "translit": "mُtْlَhkَd", "root": "دخل"}, {"id": 60, "arabic": "بُيُوتًا", "translit": "āًtwُyُb", "root": "بيت"}, {"id": 61, "arabic": "فَسَلِّمُوا۟", "translit": "۟āwُmِّlَsَf", "root": "سلم"}, {"id": 62, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 63, "arabic": "أَنفُسِكُمْ", "translit": "ْmُkِsُfnَaʾ", "root": "نفس"}, {"id": 64, "arabic": "تَحِيَّةً", "translit": "ًẗَّyِḥَt", "root": "حيي"}, {"id": 65, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 66, "arabic": "عِندِ", "translit": "ِdnِʿع", "root": "عند"}, {"id": 67, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 68, "arabic": "مُبَٰرَكَةً", "translit": "ًẗَkَrَٰbُm", "root": "برك"}, {"id": 69, "arabic": "طَيِّبَةً", "translit": "ًẗَbِّyَṭ", "root": "طيب"}, {"id": 70, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 71, "arabic": "يُبَيِّنُ", "translit": "ُnِّyَbُy", "root": "بين"}, {"id": 72, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 73, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 74, "arabic": "ٱلْءَايَٰتِ", "translit": "ِtَٰyāَءْlٱ", "root": "ايي"}, {"id": 75, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 76, "arabic": "تَعْقِلُونَ", "translit": "َnwُlِqْʿعَt", "root": "عقل"}], "hasIhya": true}, {"ayah": 62, "text": "إِنَّمَا ٱلْمُؤْمِنُونَ ٱلَّذِينَ ءَامَنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ وَإِذَا كَانُوا۟ مَعَهُۥ عَلَىٰٓ أَمْرٍ جَامِعٍ لَّمْ يَذْهَبُوا۟ حَتَّىٰ يَسْتَـْٔذِنُوهُۚ إِنَّ ٱلَّذِينَ يَسْتَـْٔذِنُونَكَ أُو۟لَٰٓئِكَ ٱلَّذِينَ يُؤْمِنُونَ بِٱللَّهِ وَرَسُولِهِۦۚ فَإِذَا ٱسْتَـْٔذَنُوكَ لِبَعْضِ شَأْنِهِمْ فَأْذَن لِّمَن شِئْتَ مِنْهُمْ وَٱسْتَغْفِرْ لَهُمُ ٱللَّهَۚ إِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ", "translation": "The believers are only those who believe in Allāh and His Messenger and, when they are [meeting] with him for a matter of common interest, do not depart until they have asked his permission. Indeed, those who ask your permission, [O Muḥammad] - those are the ones who believe in Allāh and His Messenger. So when they ask your permission due to something of their affairs, then give permission to whom you will among them and ask forgiveness for them of Allāh. Indeed, Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلْمُؤْمِنُونَ", "translit": "َnwُnِmْwʾُmْlٱ", "root": "امن"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 5, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 6, "arabic": "وَرَسُولِهِۦ", "translit": "ۦِhِlwُsَrَw", "root": "رسل"}, {"id": 7, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 8, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 9, "arabic": "مَعَهُۥ", "translit": "ۥُhَʿعَm", "root": ""}, {"id": 10, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 11, "arabic": "أَمْرٍ", "translit": "ٍrْmَaʾ", "root": "امر"}, {"id": 12, "arabic": "جَامِعٍ", "translit": "ٍʿعِmāَjg", "root": "جمع"}, {"id": 13, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 14, "arabic": "يَذْهَبُوا۟", "translit": "۟āwُbَhْhdَy", "root": "ذهب"}, {"id": 15, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 16, "arabic": "يَسْتَـْٔذِنُوهُ", "translit": "ُhwُnِhdْٔـَtْsَy", "root": "اذن"}, {"id": 17, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 18, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 19, "arabic": "يَسْتَـْٔذِنُونَكَ", "translit": "َkَnwُnِhdْٔـَtْsَy", "root": "اذن"}, {"id": 20, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 21, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 22, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 23, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 24, "arabic": "وَرَسُولِهِۦ", "translit": "ۦِhِlwُsَrَw", "root": "رسل"}, {"id": 25, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 26, "arabic": "ٱسْتَـْٔذَنُوكَ", "translit": "َkwُnَhdْٔـَtْsٱ", "root": "اذن"}, {"id": 27, "arabic": "لِبَعْضِ", "translit": "ِḍْʿعَbِl", "root": "بعض"}, {"id": 28, "arabic": "شَأْنِهِمْ", "translit": "ْmِhِnْaʾَhs", "root": "شان"}, {"id": 29, "arabic": "فَأْذَن", "translit": "nَhdْaʾَf", "root": "اذن"}, {"id": 30, "arabic": "لِّمَن", "translit": "nَmِّl", "root": ""}, {"id": 31, "arabic": "شِئْتَ", "translit": "َtْyʾِhs", "root": "شيا"}, {"id": 32, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 33, "arabic": "وَٱسْتَغْفِرْ", "translit": "ْrِfْغَtْsٱَw", "root": "غفر"}, {"id": 34, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 35, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 36, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 37, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 38, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 39, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 63, "text": "لَّا تَجْعَلُوا۟ دُعَآءَ ٱلرَّسُولِ بَيْنَكُمْ كَدُعَآءِ بَعْضِكُم بَعْضًاۚ قَدْ يَعْلَمُ ٱللَّهُ ٱلَّذِينَ يَتَسَلَّلُونَ مِنكُمْ لِوَاذًاۚ فَلْيَحْذَرِ ٱلَّذِينَ يُخَالِفُونَ عَنْ أَمْرِهِۦٓ أَن تُصِيبَهُمْ فِتْنَةٌ أَوْ يُصِيبَهُمْ عَذَابٌ أَلِيمٌ ", "translation": "Do not make [your] calling of the Messenger among yourselves as the call of one of you to another. Already Allāh knows those of you who slip away, concealed by others. So let those beware who dissent from his [i.e., the Prophet's] order,[1] lest fitnah[2] strike them or a painful punishment.", "words": [{"id": 1, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 2, "arabic": "تَجْعَلُوا۟", "translit": "۟āwُlَʿعْjgَt", "root": "جعل"}, {"id": 3, "arabic": "دُعَآءَ", "translit": "َءٓāَʿعُd", "root": "دعو"}, {"id": 4, "arabic": "ٱلرَّسُولِ", "translit": "ِlwُsَّrlٱ", "root": "رسل"}, {"id": 5, "arabic": "بَيْنَكُمْ", "translit": "ْmُkَnْyَb", "root": "بين"}, {"id": 6, "arabic": "كَدُعَآءِ", "translit": "ِءٓāَʿعُdَk", "root": "دعو"}, {"id": 7, "arabic": "بَعْضِكُم", "translit": "mُkِḍْʿعَb", "root": "بعض"}, {"id": 8, "arabic": "بَعْضًا", "translit": "āًḍْʿعَb", "root": "بعض"}, {"id": 9, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 10, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 11, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 13, "arabic": "يَتَسَلَّلُونَ", "translit": "َnwُlَّlَsَtَy", "root": "سلل"}, {"id": 14, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 15, "arabic": "لِوَاذًا", "translit": "āًhdāَwِl", "root": "لوذ"}, {"id": 16, "arabic": "فَلْيَحْذَرِ", "translit": "ِrَhdْḥَyْlَf", "root": "حذر"}, {"id": 17, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 18, "arabic": "يُخَالِفُونَ", "translit": "َnwُfِlāَhkُy", "root": "خلف"}, {"id": 19, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 20, "arabic": "أَمْرِهِۦٓ", "translit": "ٓۦِhِrْmَaʾ", "root": "امر"}, {"id": 21, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 22, "arabic": "تُصِيبَهُمْ", "translit": "ْmُhَbyِṣُt", "root": "صوب"}, {"id": 23, "arabic": "فِتْنَةٌ", "translit": "ٌẗَnْtِf", "root": "فتن"}, {"id": 24, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 25, "arabic": "يُصِيبَهُمْ", "translit": "ْmُhَbyِṣُy", "root": "صوب"}, {"id": 26, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 27, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 64, "text": "أَلَآ إِنَّ لِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ قَدْ يَعْلَمُ مَآ أَنتُمْ عَلَيْهِ وَيَوْمَ يُرْجَعُونَ إِلَيْهِ فَيُنَبِّئُهُم بِمَا عَمِلُوا۟ۗ وَٱللَّهُ بِكُلِّ شَىْءٍ عَلِيمٌۢ ", "translation": "Unquestionably, to Allāh belongs whatever is in the heavens and earth. Already He knows that upon which you [stand][1] and [knows] the Day[2] when they will be returned to Him and He will inform them of what they have done. And Allāh is Knowing of all things.", "words": [{"id": 1, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 3, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 7, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 8, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 9, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 10, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 11, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 12, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 13, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 14, "arabic": "يُرْجَعُونَ", "translit": "َnwُʿعَjgْrُy", "root": "رجع"}, {"id": 15, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 16, "arabic": "فَيُنَبِّئُهُم", "translit": "mُhُyʾِّbَnُyَf", "root": "نبا"}, {"id": 17, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 18, "arabic": "عَمِلُوا۟", "translit": "۟āwُlِmَʿع", "root": "عمل"}, {"id": 19, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 20, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 21, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 22, "arabic": "عَلِيمٌۢ", "translit": "ٌۢmyِlَʿع", "root": "علم"}], "hasIhya": true}], "tafsir": {"2": [{"arabic": "يعني في الدين وقال تعالى {ولا تأخذكم بهما رأفة في دين الله} بل من فقد الغضب عجز عن رياضة نفسه إذ لا تتم الرياضة إلا بتسليط الغضب على الشهوة حتى يغضب على نفسه عند الميل إلى الشهوات الخسيسة ففقد الغضب مذموم وإنما المحمود غضب ينتظر إشارة العقل والدين فينبعث حيث تجب الحمية وينطفيء حيث يحسن الحلم وحفظه على حد الاعتدال هو الاستقامة التي كلف الله بها عباده وهو الوسط الذي وصفه رسول الله صلى الله عليه وسلم حيث قال خير الأمور أوساطها (1) فمن مال غضبه إلى الفتور حتى أحس من نفسه بضعف الغيرة وخسة النفس في ا", "english": "As for deficiency: it is the loss of this power or its weakness. This is blameworthy, and it is of such a one that it is said: \"He has no protective zeal (ḥamiyyah).\" For this reason al-Shāfiʿī — may God have mercy on him — said: \"Whoever is provoked to anger and does not become angry is a donkey.\" Whoever loses the power of anger and protective zeal entirely is utterly deficient. God — exalted be He — described the Companions of the Prophet — peace be upon him — with severity and protective zeal, saying: {«أشداء على الكفار رحماء بينهم»} \"Severe against the disbelievers, merciful among themselves\" (Q 48:29). And He said to His Prophet — peace be upon him: {«جاهد الكفار والمنافقين واغلظ عليهم»} \"Strive against the disbelievers and the hypocrites and be harsh with them\" (Q 9:73) — the verse. Harshness and severity are but effects of the power of protective zeal, which is anger.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 703", "section_title_en": "The Reality of Anger (Ghaḍab) and Its Degrees — Book 21, Section 703", "section_index": 703, "anchors": "- Root: غضب (Ghaḍab)\n  * Lisan / Ayn: Core root denotes anger, rage, fury; the surge of blood in the heart seeking vengeance.\n  * Al-Raghib (Mufradat): \"الغضب: ثوران دم القلب إرادة الانتقام\" — when attributed to God, it means solely His retribution, not an emotional state.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"غضبت لفلان\" (anger for the living); Metaphorical (majāz): \"غضبت به\" (anger over the dead), and the poetic extension to inanimate objects like fire or reins.\n- Root: نفس (Nafs)\n  * Lisan / Ayn: Self, soul, spirit; the vital principle.\n  * Al-Raghib (Mufradat): The soul as the seat of blameworthy traits when unrestrained; its purification is the goal of spiritual struggle.\n  * Al-Zamakhshari (Asas): Literal: the self; Metaphorical: \"دفق نفسه\" (spilled his blood/life).\n- Root: قلب (Qalb)\n  * Lisan / Ayn: The heart; to turn over, to flip.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named for its constant fluctuation and turning.\n  * Al-Zamakhshari (Asas): Literal: physical turning; Metaphorical: the heart as the seat of intellect and spiritual perception, which anger overturns and blinds.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — Used to distinguish the three degrees of anger (deficiency, excess, moderation) as mutually exclusive categories.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Envy'", "badge": "Ethics"}], "9": [{"arabic": "ويقال إن لله تعالى ملائكة لم يضحك أحد منهم منذ خلقت النار مخافة أن يغضب الله عليهم فيعذبهم بها وقال ابن عمر رضي الله عنهما خرجت مع رسول الله صلى الله عليه وسلم حتى دخل بعض حيطان الأنصار فجعل يلتقط من التمر ويأكل فقال يا ابن عمر مالك لا تأكل فقلت يا رسول الله لا أشتهيه فقال لكني أشتهيه وهذا صبح رابعة لم أذق طعاما ولم أجده ولو سألت ربي لأعطاني ملك قيصر وكسرى فكيف بك يا ابن عمر إذا بقيت في قوم يخبئون رزق سنتهم ويضعف اليقين في قلوبهم قال فوالله ما برحنا ولا قمنا حتى نزلت {وكأين من دابة لا تحمل رزقها الله يرزقها وإياكم وهو السمي", "english": "And he — may God's peace and blessings be upon him — said: \"Never did Gabriel come to me except that he was trembling, in fear of the Almighty\" (3).", "book_title": "Fear and Hope", "section_title_ar": "Section 1059", "section_title_en": "The Fear of God and the Weeping of the Prophets — On the Terror of the Angels and the Lamentation of David (Peace Be Upon Him)", "section_index": 1059, "anchors": "- Root: وجل (wajila)\n  * Lisan / Ayn: Core meaning is \"to fear, to be apprehensive, to tremble inwardly.\" Al-Farahidi notes its intensity — a trembling that seizes the heart.\n  * Al-Raghib (Mufradat): In theological usage, *wajal* is the fear born of awe before divine majesty (*haybah*), distinct from mere dread of punishment; it is the trembling of the heart at the threshold of the Sacred.\n  * Al-Zamakhshari (Asas): Literal (*haqiqah*): physical trembling. Metaphorical (*majaz*): the soul's quaking before divine power — as in the *azīz* (boiling) of the breast during prayer, a sound likened to a cauldron.\n- Root: بكى (baka)\n  * Lisan / Ayn: \"To weep, to shed tears.\" Ibn Manzur records the intensive forms *bakkā'* (much-weeping) and the noun *bukā'* as the outward expression of inward grief (*ḥuzn*).\n  * Al-Raghib (Mufradat): Weeping is the physical sign of the heart's brokenness (*inkisār*); in the prophets, it is the overflow of *khashyah* — reverent fear — not mere sorrow.\n  * Al-Zamakhshari (Asas): Literal: tears flowing. Metaphorical: the \"weeping\" of the sky (rain) and the \"weeping\" of the heart (contrition) — as in David's lament, where tears substitute for speech.\n- Root: خطأ (khaṭi'a)\n  * Lisan / Ayn: \"To err, to commit a fault.\" Al-Farahidi distinguishes *khaṭī'ah* (a sin committed unintentionally or through weakness) from *ithm* (deliberate transgression).\n  * Al-Raghib (Mufradat): In Kalam, *khaṭī'ah* for a prophet is a *tark al-awlā* — the abandonment of the more excellent course — not moral depravity; its gravity lies in the station of the one who errs.\n  * Al-Zamakhshari (Asas): Literal: missing the mark. Metaphorical: the soul's deviation from the straight path of intimacy (*uns*) with God, producing *waḥshah* (estrangement).\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated conditional and vocative structures (*yā Dāwūd*, *idhā dhakartu khaṭī'atī*) serve to restrict the predicate to the speaker's subjective state, emphasizing the direct, unmediated dialogue between the prophet and his Lord.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'", "badge": "Insight"}], "15": [{"arabic": "المعاصي بالجوارح ولذلك قال تعالى في مثله وتحسبونه هينا وهو عند الله عظيم فمن أين تعلم أن غيرك أعصى منك ثم لعله قد أخرت عقوبته إلى الآخرة وعجلت عقوبتك في الدنيا فلم لا تشكر الله تعالى على ذلك وهذا هو الوجه الثالث في الشكر وهو أنه ما من عقوبة إلا وكان يتصور أن تؤخر إلى الآخرة ومصائب الدنيا يتسلى عنها بأسباب أخر تهون المصيبة فيخف وقعها ومصيبة الآخرة تدوم وإن لم تدم فلا سبيل إلى تخفيفها بالتسلي إذ أسباب التسلي مقطوعة بالكلية في الآخرة عن المعذبين ومن عجلت عقوبته في الدنيا فلا يعاقب ثانيا إذ قال رسول الله صلى الله عليه وسلم", "english": "You might say: \"What you have mentioned concerning graces (niʿam) indicates that for God most high there is in every existing thing a grace — and this suggests that trial (balā') has no existence at all. So what then is the meaning of patience (ṣabr)? And if trial does exist, then what is the meaning of gratitude (shukr) for trial? For some claimants have asserted that we give thanks for trial, let alone for grace. So how is gratitude for trial conceivable? And how does one give thanks for that which one endures with patience? For patience in trial demands pain, while gratitude demands joy, and the two are mutually opposed. And what is the meaning of what you have mentioned — that for God most high there is in everything He has brought into existence a grace upon His servants?\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 1018", "section_title_en": "On the Reconciliation of Patience and Gratitude in the Face of Trial — Section 1018", "section_index": 1018, "anchors": "- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Core sense of softness, ease, and well-being; al-Farahidi notes it as a name for the leopard and tiger, indicating inherent vigor in the state of grace.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — the goodly state; divided into absolute (mutlaqah) and restricted (muqayyadah), the former being felicity in the Hereafter (nearness to God) and faith in this world.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the actual state of well-being; metaphorical (Majaz) extension applies to any beneficial circumstance, even apparent hardship, when considered relative to the recipient's ultimate good.\n- Root: بلي (b-l-w)\n  * Lisan / Ayn: Testing, affliction, and wear of the body; the root implies a state of being tried or proven.\n  * Al-Raghib (Mufradat): Trial (balā') is that which tests one's state; its existence is affirmed alongside grace (niʿmah) as its contrary, for the absence of grace is a trial and the absence of trial is a grace.\n  * Al-Zamakhshari (Asas): Literal sense is calamity or hardship; metaphorical sense applies to any condition that, while painful in one respect, may be a vehicle for divine benefit in another.\n- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Restraint and forbearance; al-Farahidi ties it to holding back the self from complaint.\n  * Al-Raghib (Mufradat): Patience is the withholding of the soul from agitation and complaint; it is only commanded where the trial cannot be repelled by the servant's own effort.\n  * Al-Zamakhshari (Asas): Literal usage is enduring pain; metaphorical usage extends to steadfastness in obedience and abstention from sin, which are acts of patience toward the soul's base inclinations.\n- Root: شكر (sh-k-r)\n  * Lisan / Ayn: Gratitude as acknowledgment of benefit; al-Farahidi links it to fullness, as a full udder (shukrā).\n  * Al-Raghib (Mufradat): \"الشكر: تصور النعمة وإظهارها\" — gratitude is the conception of the grace and its manifestation; it is threefold: of the heart (perceiving the grace), of the tongue (praising the Benefactor), and of the limbs (rewarding the grace through obedience).\n  * Al-Zamakhshari (Asas): Literal sense is verbal and inward acknowledgment; metaphorical sense is the \"grateful beast\" (dābbah shakūr) that thrives on little fodder — so the servant thrives on little trial, seeing in it abundant divine favor.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to delimit the scope of patience and gratitude: patience is restricted to unavoidable pain, while gratitude is focused on the relative good within that pain, preventing the logical contradiction of their simultaneous application.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Patience and Gratitude'", "badge": "Ethics"}, {"arabic": "واحد كان يحسبه هينا وهو عند الله عظيم وقد مقته به وإذا كان هذا ممكنا كان على نفسه خائفا فإذا كان كل واحد من العابد والعالم خائفا على نفسه وقد كلف أمر نفسه لا أمر غيره فينبغي أن يكون الغالب عليه في حق نفسه الخوف وفي حق غيره الرجاء وذلك يمنعه من التكبر بكل حال فهذا العابد مع العالم فأما مع غير العالم فهم منقسمون في حقه إلى مستورين وإلى مكشوفين فينبغي أن لا يتكبر على المستور فلعله أقل عنه ذنوبا وأكثر منه عبادة وأشد منه حبا لله وأما المكشوف حاله إن لم يظهر لك من الذنوب إلا ما تزيد عليه", "english": "If the worshiper said that to a scholar who acts upon his knowledge — and this scholar is a wicked transgressor — then it is said to him: \"Have you not known that good deeds erase evil deeds? And just as knowledge can be a proof against the scholar, so too can it be a means for him and an expiation for his sins. Each of the two is possible, and the reports (al-akhbār) have come attesting to that. And since this matter is hidden from him, it is not permissible for him to hold a scholar in contempt; rather, he must show humility toward him.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 871", "section_title_en": "On the Humility of the Learned Toward the Open Sinner, and the Fear of the Final Outcome", "section_index": 871, "anchors": "- Root: حسن (Ḥ-S-N)\n  * Lisan / Ayn: Core meaning of beauty and goodness, both in outward form and inward virtue; al-ḥasanāt are acts of beneficence and obedience.\n  * Al-Raghib (Mufradat): Al-ḥasanah is that which brings joy to the soul and is praiseworthy in its consequence; its opposite is al-sayyi'ah (the evil deed). The verse {«إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ»} (Hūd 11:114) establishes the divinely ordained mechanism of expiation through good works.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes intrinsic goodness; metaphorical (majāz) usage extends to acts that erase prior sins, as in the prophetic tradition cited here.\n- Root: خطر (Kha-Ṭ-R)\n  * Lisan / Ayn: To be in peril; khaṭar is the looming danger that makes one tremble for one's fate.\n  * Al-Raghib (Mufradat): Khaṭar denotes the imminent threat of punishment; the one who is mushfiq (apprehensive) weighs the unseen consequences of his state.\n  * Al-Zamakhshari (Asas): Literal: a spear's quivering threat; metaphorical: the soul's dread of the unknown decree (al-qaḍā' al-azalī).\n- Root: ستر (S-T-R)\n  * Lisan / Ayn: To cover, conceal; mastūr is one whose sins are veiled from public view.\n  * Al-Raghib (Mufradat): Al-sitr is the divine concealment of faults, a mercy that prevents presumption of another's inferiority.\n  * Al-Zamakhshari (Asas): Literal: physical covering; metaphorical: the hidden state of a person's moral condition, contrasted with makshūf (exposed).\n- Sibawayh Rule: Bāb al-ḥaṣr wa-al-taqyīd bi-innamā (Restriction and Focused Predication) — The conditional structures (fa-in qāla... fa-in qulta...) and the restrictive phrasing (fa-lā yajūz... bal yajibu) govern the logical progression, binding each hypothetical objection to its necessary response.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "21": [{"arabic": "قال تعالى {ربنا الذي أعطى كل شيء خلقه ثم هدى} وقال تعالى ولولا فضل الله عليكم ورحمته ما زكى منكم أحد أبدا ولكن الله يزكي من يشاء وقال صلى الله عليه وسلم ما من أحد يدخل الجنة إلا برحمة الله تعالى أي بهدايته فقيل ولا أنت يا رسول الله قال ولا أنا (1) وللهداية ثلاث منازل {الأولى} معرفة طريق الخير والشر المشار إليه بقوله تعالى {وهديناه النجدين} وقد أنعم الله تعالى به على كافة عباده بعضه بالعقل وبعضه على لسان الرسل ولذلك قال تعالى {وأما ثمود فهديناهم فاستحبوا العمى على الهدى} فأسباب الهدى هي الكتاب والرسل وبصائر العقول وهي مبذولة ولا يمنع منها إلا", "english": "PageV04P107\nBut if one does not know what constitutes the welfare of his hereafter—so that he even supposes corruption to be welfare—then from where would mere volition benefit him? There is no benefit in volition, power, and causes except after guidance (hidāyah). For this reason, God—exalted is He—said: {«ربنا الذي أعطى كل شيء خلقه ثم هدى»} \"Our Lord who gave everything its creation, then guided.\" And He said—exalted is He—: {«ولولا فضل الله عليكم ورحمته ما زكى منكم أحد أبدا ولكن الله يزكي من يشاء»} \"And were it not for God's bounty upon you and His mercy, not one of you would ever be purified; but God purifies whom He wills.\" And the Prophet—peace be upon him—said: \"No one enters Paradise except by the mercy of God—exalted is He—,\" that is, by His guidance. So it was said: \"Not even you, O Messenger of God?\" He said: \"Not even I\" (1). And guidance (hidāyah) has three stations (manāzil):", "book_title": "Patience and Gratitude", "section_title_ar": "Section 999", "section_title_en": "The Degrees of Divine Guidance (Hidāyah), Righteous Discernment (Rushd), Straightening (Tasdīd), and Divine Support (Ta'yīd)", "section_index": 999, "anchors": "- Root: هدي (H-D-Y)\n  * Lisan / Ayn: Core meaning of gentle, gracious direction (dalālah bi-luṭf); the root also yields \"gift\" (hadiyyah) and the leading beasts of prey (hawādī) that guide the herd.\n  * Al-Raghib (Mufradat): Guidance is \"directional indication with gentleness\" (dalālah bi-luṭf), distinct from mere intellectual proof; it is a divine act that may be general (to all) or specific (to the elect), and its withholding is a form of abandonment.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"He guided him to the path\" (hadāhu lil-sabīl). Metaphorical (majāz): \"He guided him\" meaning \"he preceded him\" (taqaddamahu), as a leader precedes the caravan; hence guidance is not merely pointing but active leading.\n- Root: رشد (R-SH-D)\n  * Lisan / Ayn: The state of being rightly directed in one's affairs; integrity of judgment; names Rāshid, Rushayd derive from it.\n  * Al-Raghib (Mufradat): Rushd is the opposite of ghayy (error/ruin); it is used like hidāyah but with a nuance of practical, executive discernment—knowing the good AND being moved to pursue it. Al-Raghib explicitly distinguishes the rushd of Abraham (given before, as a special gift) from the mere legal competence (rushd) of an orphan.\n  * Al-Zamakhshari (Asas): Literal: \"A man is rāshid or rashīd\" (possessing rightness in conduct). Metaphorical: \"He is of sound lineage\" (huwa li-rushdah), i.e., legitimate—showing the root's extension to ontological soundness.\n- Root: سدد (S-D-D)\n  * Lisan / Ayn: To aim correctly, to hit the mark; the arrow that flies straight (sadīd); the opposite of deviation (ighrāḍ).\n  * Al-Raghib (Mufradat): (Not in the retrieved scholia, but by extension from the root's usage in the Qur'an, e.g., {wa-saddidū}, \"and be straight/aim rightly\")—it denotes the divine facilitation of the creature's movements so they align with the intended good.\n  * Al-Zamakhshari (Asas): Literal: \"He aimed the arrow and it went straight.\" Metaphorical: \"He was granted success in speech and action\" (sudda li-l-ṣawāb).\n- Root: أيد (A-Y-D)\n  * Lisan / Ayn: Strength, support, reinforcement; the \"aid\" (ayd) of God is His empowering of His servant.\n  * Al-Raghib (Mufradat): (By extension from {إذ أيدتك بروح القدس})—divine reinforcement through a holy spirit, i.e., an immaterial power that fortifies both inner perception (baṣīrah) and outer action.\n  * Al-Zamakhshari (Asas): Literal: \"He strengthened him\" (ayyadahu). Metaphorical: Used for the conferral of spiritual power that makes the servant invincible against error.\n- Sibawayh Rule: Rule of Gradation and Specification (Tartīb wa-Takhṣīṣ) — The author structures a sequence of terms (hidāyah → rushd → tasdīd → ta'yīd) where each subsequent term is syntactically and semantically superordinate, building a hierarchy of divine acts. The particle \"wa-ammā\" (وأما) marks a new topic with contrastive focus, and the anaphoric references (هو، وهي) bind the exposition into a single periodic argument.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "عليكم ورحمته ما زكى منكم أحد أبدا ولكن الله يزكي من يشاء وقال صلى الله عليه وسلم ما من أحد يدخل الجنة إلا برحمة الله تعالى أي بهدايته فقيل ولا أنت يا رسول الله قال ولا أنا (1) وللهداية ثلاث منازل {الأولى} معرفة طريق الخير والشر المشار إليه بقوله تعالى {وهديناه النجدين} وقد أنعم الله تعالى به على كافة عباده بعضه بالعقل وبعضه على لسان الرسل ولذلك قال تعالى {وأما ثمود فهديناهم فاستحبوا العمى على الهدى} فأسباب الهدى هي الكتاب والرسل وبصائر العقول وهي مبذولة ولا يمنع منها إلا الحسد والكبر وحب الدنيا والأسبا", "english": "PageV04P107\nBut if one does not know what constitutes the welfare of his hereafter—so that he even supposes corruption to be welfare—then from where would mere volition benefit him? There is no benefit in volition, power, and causes except after guidance (hidāyah). For this reason, God—exalted is He—said: {«ربنا الذي أعطى كل شيء خلقه ثم هدى»} \"Our Lord who gave everything its creation, then guided.\" And He said—exalted is He—: {«ولولا فضل الله عليكم ورحمته ما زكى منكم أحد أبدا ولكن الله يزكي من يشاء»} \"And were it not for God's bounty upon you and His mercy, not one of you would ever be purified; but God purifies whom He wills.\" And the Prophet—peace be upon him—said: \"No one enters Paradise except by the mercy of God—exalted is He—,\" that is, by His guidance. So it was said: \"Not even you, O Messenger of God?\" He said: \"Not even I\" (1). And guidance (hidāyah) has three stations (manāzil):", "book_title": "Patience and Gratitude", "section_title_ar": "Section 999", "section_title_en": "The Degrees of Divine Guidance (Hidāyah), Righteous Discernment (Rushd), Straightening (Tasdīd), and Divine Support (Ta'yīd)", "section_index": 999, "anchors": "- Root: هدي (H-D-Y)\n  * Lisan / Ayn: Core meaning of gentle, gracious direction (dalālah bi-luṭf); the root also yields \"gift\" (hadiyyah) and the leading beasts of prey (hawādī) that guide the herd.\n  * Al-Raghib (Mufradat): Guidance is \"directional indication with gentleness\" (dalālah bi-luṭf), distinct from mere intellectual proof; it is a divine act that may be general (to all) or specific (to the elect), and its withholding is a form of abandonment.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"He guided him to the path\" (hadāhu lil-sabīl). Metaphorical (majāz): \"He guided him\" meaning \"he preceded him\" (taqaddamahu), as a leader precedes the caravan; hence guidance is not merely pointing but active leading.\n- Root: رشد (R-SH-D)\n  * Lisan / Ayn: The state of being rightly directed in one's affairs; integrity of judgment; names Rāshid, Rushayd derive from it.\n  * Al-Raghib (Mufradat): Rushd is the opposite of ghayy (error/ruin); it is used like hidāyah but with a nuance of practical, executive discernment—knowing the good AND being moved to pursue it. Al-Raghib explicitly distinguishes the rushd of Abraham (given before, as a special gift) from the mere legal competence (rushd) of an orphan.\n  * Al-Zamakhshari (Asas): Literal: \"A man is rāshid or rashīd\" (possessing rightness in conduct). Metaphorical: \"He is of sound lineage\" (huwa li-rushdah), i.e., legitimate—showing the root's extension to ontological soundness.\n- Root: سدد (S-D-D)\n  * Lisan / Ayn: To aim correctly, to hit the mark; the arrow that flies straight (sadīd); the opposite of deviation (ighrāḍ).\n  * Al-Raghib (Mufradat): (Not in the retrieved scholia, but by extension from the root's usage in the Qur'an, e.g., {wa-saddidū}, \"and be straight/aim rightly\")—it denotes the divine facilitation of the creature's movements so they align with the intended good.\n  * Al-Zamakhshari (Asas): Literal: \"He aimed the arrow and it went straight.\" Metaphorical: \"He was granted success in speech and action\" (sudda li-l-ṣawāb).\n- Root: أيد (A-Y-D)\n  * Lisan / Ayn: Strength, support, reinforcement; the \"aid\" (ayd) of God is His empowering of His servant.\n  * Al-Raghib (Mufradat): (By extension from {إذ أيدتك بروح القدس})—divine reinforcement through a holy spirit, i.e., an immaterial power that fortifies both inner perception (baṣīrah) and outer action.\n  * Al-Zamakhshari (Asas): Literal: \"He strengthened him\" (ayyadahu). Metaphorical: Used for the conferral of spiritual power that makes the servant invincible against error.\n- Sibawayh Rule: Rule of Gradation and Specification (Tartīb wa-Takhṣīṣ) — The author structures a sequence of terms (hidāyah → rushd → tasdīd → ta'yīd) where each subsequent term is syntactically and semantically superordinate, building a hierarchy of divine acts. The particle \"wa-ammā\" (وأما) marks a new topic with contrastive focus, and the anaphoric references (هو، وهي) bind the exposition into a single periodic argument.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Patience and Gratitude'", "badge": "Ethics"}, {"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "22": [{"arabic": "وفيه نزل قوله تعالى ولا يأتل أولوا الفضل منكم والسعة إلى قوله تعالى {ألا تحبون أن يغفر الله لكم} إذ تكلم مسطح بن أثاثة في واقعة الإفك (1) فحلف أبو بكر أن يقطع عنه رفقه وقد كان يواسيه بالمال فنزلت الآية مع عظم معصية مسطح وأية معصية تزيد على التعرض لحرم رسول الله صلى الله عليه وسلم وإطالة اللسان في مثل عائشة رضي الله عنها إلا أن الصديق رضي الله عنه كان كالمجني عليه في نفسه بتلك الواقعة والعفو عمن ظلم والإحسان إلى من أساء من أخلاق الصديقين وإنما يحسن الإحسان إلى من ظلمك فأما من ظلم غيرك وعصى الله به", "english": "**QUAD_ANCHORS:**\n- Root: ط-و-ع (ṭ-w-ʿ)\n  * Lisan / Ayn: Core meaning of obedience, submission, compliance; ṭāʿah is the act of conforming to command\n  * Al-Raghib (Mufradat): In theological usage, ṭāʿah is specifically obedience to Allah's commands as distinguished from maʿṣiyah (disobedience); the root carries the sense of voluntary compliance versus coerced submission\n  * Al-Zamakhshari (Asas): Literal sense is yielding and complying; in religious context it denotes conformity to divine law as opposed to transgression (maʿṣiyah)\n- Root: ب-غ-ض (b-gh-ḍ)\n  * Lisan / Ayn: Hatred, aversion, detestation; the opposite of ḥubb (love)\n  * Al-Raghib (Mufradat): In theological ethics, bughḍ is the soul's aversion to something; religiously it must be directed toward disobedience while preserving love for the believer's faith\n  * Al-Zamakhshari (Asas): Literal: intense dislike; metaphorical: the heart's turning away from what displeases Allah\n- Root: ج-ن-ي (j-n-y)\n  * Lisan / Ayn: To commit a crime or offense; picking fruit (jināyah as reaping what one has sown)\n  * Al-Raghib (Mufradat): Jināyah is any act that harms another; in legal-theological usage, it denotes transgression against rights — whether Allah's rights (ḥuqūq Allāh) or human rights (ḥuqūq al-ʿibād)\n  * Al-Zamakhshari (Asas): Literal: reaping/cutting fruit; metaphorical: committing an offense whose consequences one \"reaps\"\n- Root: ع-ف-و (ʿ-f-w)\n  * Lisan / Ayn: To pardon, forgive, efface; the root also carries the sense of leaving something and desisting from it\n  * Al-Raghib (Mufradat): ʿAfw is to relinquish retaliation and erase the trace of the offense; it is the highest form of forgiveness, coupled with iḥsān (beneficence)\n  * Al-Zamakhshari (Asas): Literal: obliteration and effacement; metaphorical: the soul's effacement of resentment toward the offender\n- Root: م-د-ه-ن (m-d-h-n)\n  * Lisan / Ayn: Flattery, hypocrisy, dissimulation; from the sense of softening and pliability\n  * Al-Raghib (Mufradat): Mudāhanah is to show outward friendliness while concealing enmity, or to overlook sins out of worldly motive rather than genuine mercy\n  * Al-Zamakhshari (Asas): Literal: to be soft and pliant like oil (duhn); metaphorical: hypocritical leniency in religious matters\n- Sibawayh Rule: باب التقسيم والتفصيل (Division and Specification) — The text employs systematic bipartite and tripartite divisions (taqsīm) to enumerate degrees and categories, each with its own governing rule, requiring the translator to preserve the structural parallelism of conditional clauses (sharṭ/jazā') and their apodoses.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 411", "section_title_en": "Section 411", "section_index": 411, "anchors": "*(Anchors established)*", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Envy'", "badge": "Ethics"}, {"arabic": "{ألا تحبون أن يغفر الله لكم} إذ تكلم مسطح بن أثاثة في واقعة الإفك (1) فحلف أبو بكر أن يقطع عنه رفقه وقد كان يواسيه بالمال فنزلت الآية مع عظم معصية مسطح وأية معصية تزيد على التعرض لحرم رسول الله صلى الله عليه وسلم وإطالة اللسان في مثل عائشة رضي الله عنها إلا أن الصديق رضي الله عنه كان كالمجني عليه في نفسه بتلك الواقعة والعفو عمن ظلم والإحسان إلى من أساء من أخلاق الصديقين وإنما يحسن الإحسان إلى من ظلمك فأما من ظلم غيرك وعصى الله به فلا يحسن إحسانك إليه لأن في الإحسان إلى الظالم إ", "english": "**QUAD_ANCHORS:**\n- Root: ط-و-ع (ṭ-w-ʿ)\n  * Lisan / Ayn: Core meaning of obedience, submission, compliance; ṭāʿah is the act of conforming to command\n  * Al-Raghib (Mufradat): In theological usage, ṭāʿah is specifically obedience to Allah's commands as distinguished from maʿṣiyah (disobedience); the root carries the sense of voluntary compliance versus coerced submission\n  * Al-Zamakhshari (Asas): Literal sense is yielding and complying; in religious context it denotes conformity to divine law as opposed to transgression (maʿṣiyah)\n- Root: ب-غ-ض (b-gh-ḍ)\n  * Lisan / Ayn: Hatred, aversion, detestation; the opposite of ḥubb (love)\n  * Al-Raghib (Mufradat): In theological ethics, bughḍ is the soul's aversion to something; religiously it must be directed toward disobedience while preserving love for the believer's faith\n  * Al-Zamakhshari (Asas): Literal: intense dislike; metaphorical: the heart's turning away from what displeases Allah\n- Root: ج-ن-ي (j-n-y)\n  * Lisan / Ayn: To commit a crime or offense; picking fruit (jināyah as reaping what one has sown)\n  * Al-Raghib (Mufradat): Jināyah is any act that harms another; in legal-theological usage, it denotes transgression against rights — whether Allah's rights (ḥuqūq Allāh) or human rights (ḥuqūq al-ʿibād)\n  * Al-Zamakhshari (Asas): Literal: reaping/cutting fruit; metaphorical: committing an offense whose consequences one \"reaps\"\n- Root: ع-ف-و (ʿ-f-w)\n  * Lisan / Ayn: To pardon, forgive, efface; the root also carries the sense of leaving something and desisting from it\n  * Al-Raghib (Mufradat): ʿAfw is to relinquish retaliation and erase the trace of the offense; it is the highest form of forgiveness, coupled with iḥsān (beneficence)\n  * Al-Zamakhshari (Asas): Literal: obliteration and effacement; metaphorical: the soul's effacement of resentment toward the offender\n- Root: م-د-ه-ن (m-d-h-n)\n  * Lisan / Ayn: Flattery, hypocrisy, dissimulation; from the sense of softening and pliability\n  * Al-Raghib (Mufradat): Mudāhanah is to show outward friendliness while concealing enmity, or to overlook sins out of worldly motive rather than genuine mercy\n  * Al-Zamakhshari (Asas): Literal: to be soft and pliant like oil (duhn); metaphorical: hypocritical leniency in religious matters\n- Sibawayh Rule: باب التقسيم والتفصيل (Division and Specification) — The text employs systematic bipartite and tripartite divisions (taqsīm) to enumerate degrees and categories, each with its own governing rule, requiring the translator to preserve the structural parallelism of conditional clauses (sharṭ/jazā') and their apodoses.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 411", "section_title_en": "Section 411", "section_index": 411, "anchors": "*(Anchors established)*", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Envy'", "badge": "Ethics"}, {"arabic": "وقرأ {وليعفوا وليصفحوا ألا تحبون أن يغفر الله لكم والله غفور رحيم} (1) وفي رواية فكأنما سفي في وجه رسول الله صلى الله عليه وسلم رماد لشدة تغيره وروى أن عمر رضي الله عنه كان يعس بالمدينة من الليل فسمع صوت رجل في بيت يتغنى فتسور عليه فوجده عنده امرأة وعنده خمر فقال يا عدو الله أظننت أن الله يسترك وأنت على معصيته فقال وأنت يا أمير المؤمنين فلا تعجل فإن كنت قد عصيت الله واحدة فقد عصيت الله في ثلاثا قال الله تعالى {ولا تجسسوا} وقد تجسست وقال الله تعالى {وليس البر بأن تأتوا البيوت من ظهورها} وقد تسورت علي وقد قال الله تعالى {لا تدخلوا بي", "english": "**First**: That you greet him with peace (*salām*) when you meet him, and respond to his invitation when he invites you, and say \"may Allah have mercy on you\" (*tashmīt*) when he sneezes, and visit him when he is ill, and attend his funeral procession when he dies, and fulfill his oath when he swears by you, and give him sincere counsel when he seeks your advice, and protect him in his absence when he is away from you, and love for him what you love for yourself, and dislike for him what you dislike for yourself. (1)", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 433", "section_title_en": "The Rights of Brotherhood — Section 433: The Duties of a Muslim Toward His Fellow Muslims", "section_index": 433, "anchors": "- Root: سلم (s-l-m)\n  * Lisan / Ayn: Core meaning of safety, security, freedom from harm; the root from which *islām* (submission/surrender) and *salām* (peace) derive\n  * Al-Raghib (Mufradat): *Salām* as the theological state of being secure from harm — both giving and receiving safety; *islām* as the total surrender of the heart to Allah\n  * Al-Zamakhshari (Asas): Literal (*ḥaqīqah*): physical safety from tongue and hand; Metaphorical (*majāz*): the comprehensive spiritual safety that defines true Muslim brotherhood\n- Root: عون (ʿ-w-n)\n  * Lisan / Ayn: Assistance, aid, helping another in need\n  * Al-Raghib (Mufradat): Mutual assistance as a divine ordinance among believers\n  * Al-Zamakhshari (Asas): Literal: physical aid; Metaphorical: intercession (*shafāʿah*) and advocacy on behalf of others\n- Root: ستر (s-t-r)\n  * Lisan / Ayn: Covering, concealing, veiling; protection from exposure\n  * Al-Raghib (Mufradat): *Sitr* as the divine attribute of concealment — Allah's covering of sins in this world and the next\n  * Al-Zamakhshari (Asas): Literal: covering a physical defect; Metaphorical: concealing another's faults and sins — a cardinal virtue of brotherhood\n- Root: عذر (ʿ-dh-r)\n  * Lisan / Ayn: Excuse, pardon, acceptance of apology\n  * Al-Raghib (Mufradat): *ʿAfw* (pardon) as the higher station of forgiveness that elevates the forgiver\n  * Al-Zamakhshari (Asas): Literal: releasing from obligation; Metaphorical: the noble trait of overlooking others' offenses\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated use of restrictive constructions (e.g., \"المسلم من سلم المسلمون\") establishes definitional boundaries through predicate restriction, indicating that the *ḥaqīqah* of faith is manifested through specific observable actions.\n\n---\n\n##", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Duties of Brotherhood'", "badge": "Ethics"}], "25": [{"arabic": "قال وأن الله هو الحق المبين اللهم فصل على محمد عبدك ورسولك ونبيك وحبيبك وأمينك وخيرتك وصفوتك بأفضل ما صليت به على أحد من خلقك اللهم واجعل صلواتك ومعافاتك ورحمتك على سيد المرسلين وخاتم النبيين وإمام المتقين محمد قائد الخير وإمام الخير ورسول الرحمة اللهم قرب زلفته وعظم برهانه وكرم مقامه وابعثه مقاما محمودا يغبطه به الأولون وألاخرون وانفعنا بمقامه المحمود يوم القيامة واخلفه فينا في الدنيا والآخرة وبلغه الدرجة والوسيلة في الجنة اللهم صلي على محمد وعلى آل محمد وبارك على محمد وع", "english": "O people! Whoever worshipped Muhammad — then Muhammad has died. And whoever worshipped God — then God is Living, He dies not. And God has already sent forward to you in His command — so do not call upon him out of anguish (jazaʿan). For God, Mighty and Majestic, has chosen for His Prophet ﷺ what is with Him over what is with you, and has taken him to His reward, and has left among you His Book and the Sunnah of His Prophet ﷺ. Whoever clings to both has recognized (ʿarafa), and whoever separates between them has denied (ankara). {«يا أيها الذين آمنوا كونوا قوامين بالقسط»} — \"O you who believe, be steadfast in justice\" {Q. 5:8}. Let not Satan distract you by the death of your Prophet, nor seduce you away from your religion. Combat Satan with goodness and you will overcome him; do not grant him respite, lest he overtake you and seduce you.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1301", "section_title_en": "The Death of the Prophet ﷺ — Consolation and the Steadfastness of the Faithful", "section_index": 1301, "anchors": "- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: To bring forth anew after non-existence; that which is newly originated (muḥdath).\n  * Al-Raghib (Mufradat): \"Al-ḥudūth: the coming-to-be of a thing after it was not — whether accident or substance. Its creation (iḥdāth) belongs solely to God.\"\n  * Al-Zamakhshari (Asas): Literal: \"He is a youth of recent age (ḥadath).\" Metaphorical: \"ʿUmar was muḥaddath — one whose conjecture is true, as if things were spoken (ḥudditha) to him.\"\n- Root: موت (m-w-t)\n  * Lisan / Ayn: Death; the cessation of the vital faculty; contrasted with ḥayāt (life).\n  * Al-Raghib (Mufradat): Death is the privation of life; for the Prophet ﷺ, it is the transition (intiqāl) to the highest companionship, not annihilation of his reality.\n  * Al-Zamakhshari (Asas): Literal: \"He died.\" Metaphorical: \"Death is the messenger (rasūl) of separation.\"\n- Root: قدم (q-d-m)\n  * Lisan / Ayn: To precede, to send forward; also \"foot\" — that by which one advances.\n  * Al-Raghib (Mufradat): \"Qaddama\" — to send forth (a deed) before one; God \"sent forward\" His Prophet to what is with Him, i.e., His reward.\n  * Al-Zamakhshari (Asas): Literal: \"He advanced.\" Metaphorical: \"He sent him ahead to honor (qāddama ilā karāmatihi).\"\n- Sibawayh Rule: Rule of Prepositional Interposition (Bāb al-faṣl bayna al-jār wa al-majrūr) — The periodic structure here (e.g., \"وإن الله قد قدم إليكم في أمره\") interposes the object of consolation between the verb and its complement, governing the listener's attention toward the divine decree rather than the human loss.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}], "26": [{"arabic": "كأنك حفي عنها أي يسألونك عنها كأنك حفي بها وقوله عز وجل لهم مغفرة ورزق كريم كما أخرجك ربك من بيتك بالحق فهذا الكلام غير متصل وإنما هو عائد إلى قوله السابق قل الأنفال لله والرسول كما أخرجك ربك من بيتك بالحق أي فصارت أنفال الغنائم لك إذ أنت راض بخروجك وهم كارهون فاعترض بين الكلام الأمر بالتقوى وغيره ومن هذا النوع قوله عز وجل حتى تؤمنوا بالله وحده إلا قول إبراهيم لأبيه الآية ومنها المبهم وهو اللفظ المشترك بين معن من كلمة أو حرف أما الكلمة فكالشيء والقرين والأمة والروح ونظائرها قال الله تعالى ضرب الله مثلا عبدا مملوكا لا ي", "english": "I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 233", "section_title_en": "The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation", "section_index": 233, "anchors": "- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}], "27": [{"arabic": "البيوت من أبوابها وقد تسورت من السطح وقال لا تدخلوا بيوتا غير بيوتكم حتى تستأنسوا وتسلموا على أهلها وما سلمت فتركه عمر وشرط عليه التوبة ولذلك شاور عمر الصحابة رضي الله عنهم وهو على المنبر وسألهم عن الإمام إذا شاهد بنفسه منكرا فهل له إقامة الحد فيه فأشار علي رضي الله عنه بأن ذلك منوط بعدلين فلا يكفي فيه واحد وقد أوردنا هذه الأخبار في بيان حق المسلم من كتاب آداب الصحبة فلا نعيدها فإن قلت فما حد الظهور والاستتار فاعلم أن من أغلق باب داره وتستر بحيطانه فلا يجوز الدخول عليه بغير إذنه لنعرف المعصية إلا أن يظهر في الدار ظهورا يعرفه من هو خارج الدار كأ", "english": "The Book of the Etiquettes of Companionship. And likewise, it is narrated that ʿUmar, may God be pleased with him, climbed onto the roof of a man's house and saw him in a reprehensible state, so he rebuked him. The man said: \"O Commander of the Believers, if I have disobeyed God in one respect, you have disobeyed Him in three respects.\" ʿUmar said: \"And what are they?\" He said: \"God, exalted is He, has said: {وَلَا تَجَسَّسُوا} ('And do not spy.') [Q. 49:12] — and you have spied. And He has said: {وَأْتُوا الْبُيُوتَ مِنْ أَبْوَابِهَا} ('And enter houses from their doors.') [Q. 2:189] — and you have climbed over from the roof. And He has said: {لَا تَدْخُلُوا بُيُوتًا غَيْرَ بُيُوتِكُمْ حَتَّىٰ تَسْتَأْنِسُوا وَتُسَلِّمُوا عَلَىٰ أَهْلِهَا} ('Do not enter houses other than your own until you have sought permission and greeted their inhabitants.') [Q. 24:27] — and you did not greet.\" So ʿUmar left him, but stipulated upon him repentance.", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 535", "section_title_en": "The Book of the Etiquettes of Companionship — Section 535: On the Limits of Openness (Ẓuhūr) and Concealment (Istitār) in Enjoining Good and Forbidding Evil", "section_index": 535, "anchors": "- Root: ظهر (ẓ-h-r)\n  * Lisan / Ayn: Core meaning is \"to become visible, apparent, or manifest\"; the opposite of concealment (khabā').\n  * Al-Raghib (Mufradat): In theological discourse, ẓuhūr denotes the state of a matter becoming perceptible or known through sensory or evidentiary means, moving it from the realm of the hidden (ghayb) to the witnessed (shahādah).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to physical visibility (e.g., \"ظهر على السطح\" — he appeared on the roof). Metaphorical (majāz) usage extends to intellectual or auditory manifestation, as in \"ظهرت الحجة\" (the proof became manifest). Here, it is applied to sounds and smells that \"emerge\" beyond physical barriers.\n- Root: ستر (s-t-r)\n  * Lisan / Ayn: Core meaning is \"to cover, conceal, or screen\" something from perception.\n  * Al-Raghib (Mufradat): Al-Sitr is the covering of a thing; al-istitār is self-concealment. In the Kalam context, God's attribute of al-Sattār (the Concealer) establishes the normative principle of covering faults.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage is physical covering (e.g., \"استترت بالثوب\" — she covered herself with a garment). Metaphorical (majāz) usage is the concealment of moral faults, as in \"هتك الله سترك\" (God exposed your secrets). The text navigates between these: physical concealment (walls, sleeves) and the moral obligation to respect it unless a clear sign (amārah) indicates a public violation.\n- Root: حسب (ḥ-s-b)\n  * Lisan / Ayn: Core meaning is \"to count, reckon, or calculate.\"\n  * Al-Raghib (Mufradat): Al-Ḥisbah is the act of seeking reward (iḥtisāb) from God by performing a commanded act. Technically, it becomes the institution of enjoining good and forbidding evil.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage is arithmetic reckoning. Metaphorical (majāz) usage is \"to reckon or consider\" a matter as sufficient or binding, as in \"احْتَسَبَ عَلَيْهِ\" (he acted against him by way of correction). The text uses \"الحسبة\" (al-ḥisbah) as the technical term for this institutional duty.\n- Sibawayh Rule: Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā (Restriction and Focused Predication). The phrase \"فَإِنَّمَا يُدْرَكُ مَعَ تَخَلُّلِ الْحِيطَانِ صَوْتٌ أَوْ رَائِحَةٌ\" (For it is only perceived through the interpenetration of walls as a sound or a smell) uses innamā to restrict the means of legitimate perception to sensory evidence that breaches the barrier of concealment, thereby specifying the legal trigger for intervention.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Enjoining Good and Forbidding Evil'", "badge": "Insight"}, {"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}, {"arabic": "وقد تسورت علي وقد قال الله تعالى {لا تدخلوا بيوتا غير بيوتكم} الآية وقد دخلت بيتي بغير إذن ولا سلام فقال عمر رضي الله عنه هل عندك من خير إن عفوت عنك قال نعم والله يا أمير المؤمنين لئن عفوت عني لا أعود إلى مثلها أبدا فعفا عنه وخرج وتركه وقال رجل لعبد الله بن عمر يا أبا عبد الرحمن كيف سمعت رسول الله صلى الله عليه وسلم يقول في النجوى يوم القيامة قال سمعته يقول إن الله ليدني منه المؤمن فيضع عليه كنفه ويستره من الناس فيقول أتعرف ذنب كذا أتعرف ذنب كذا فيقول نعم يارب حتى إذا قرره بذنوبه فرأى في نفسه أنه قد هلك قال له يا عبدي إني", "english": "**First**: That you greet him with peace (*salām*) when you meet him, and respond to his invitation when he invites you, and say \"may Allah have mercy on you\" (*tashmīt*) when he sneezes, and visit him when he is ill, and attend his funeral procession when he dies, and fulfill his oath when he swears by you, and give him sincere counsel when he seeks your advice, and protect him in his absence when he is away from you, and love for him what you love for yourself, and dislike for him what you dislike for yourself. (1)", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 433", "section_title_en": "The Rights of Brotherhood — Section 433: The Duties of a Muslim Toward His Fellow Muslims", "section_index": 433, "anchors": "- Root: سلم (s-l-m)\n  * Lisan / Ayn: Core meaning of safety, security, freedom from harm; the root from which *islām* (submission/surrender) and *salām* (peace) derive\n  * Al-Raghib (Mufradat): *Salām* as the theological state of being secure from harm — both giving and receiving safety; *islām* as the total surrender of the heart to Allah\n  * Al-Zamakhshari (Asas): Literal (*ḥaqīqah*): physical safety from tongue and hand; Metaphorical (*majāz*): the comprehensive spiritual safety that defines true Muslim brotherhood\n- Root: عون (ʿ-w-n)\n  * Lisan / Ayn: Assistance, aid, helping another in need\n  * Al-Raghib (Mufradat): Mutual assistance as a divine ordinance among believers\n  * Al-Zamakhshari (Asas): Literal: physical aid; Metaphorical: intercession (*shafāʿah*) and advocacy on behalf of others\n- Root: ستر (s-t-r)\n  * Lisan / Ayn: Covering, concealing, veiling; protection from exposure\n  * Al-Raghib (Mufradat): *Sitr* as the divine attribute of concealment — Allah's covering of sins in this world and the next\n  * Al-Zamakhshari (Asas): Literal: covering a physical defect; Metaphorical: concealing another's faults and sins — a cardinal virtue of brotherhood\n- Root: عذر (ʿ-dh-r)\n  * Lisan / Ayn: Excuse, pardon, acceptance of apology\n  * Al-Raghib (Mufradat): *ʿAfw* (pardon) as the higher station of forgiveness that elevates the forgiver\n  * Al-Zamakhshari (Asas): Literal: releasing from obligation; Metaphorical: the noble trait of overlooking others' offenses\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated use of restrictive constructions (e.g., \"المسلم من سلم المسلمون\") establishes definitional boundaries through predicate restriction, indicating that the *ḥaqīqah* of faith is manifested through specific observable actions.\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "30": [{"arabic": "بني إسرائيل كانت من قبل النساء (3) وقال تعالى {قل للمؤمنين يغضوا من أبصارهم} الآية وقال صلى الله عليه وسلم لكل ابن آدم حظ من الزنا فالعينان تزنيان وزناهما النظر واليدان تزنيان وزناهما البطش والرجلان تزنيان وزناهما المشي والفم يزني وزناه القبلة والقلب يهم أو يتمنى ويصدق ذلك الفرج أو يكذبه (4) وقالت أم سلمة استأذن ابن أم مكتوم الأعمى على رسول الله وأنا وميمونة جالستانفقال صلى الله عليه وسلم احتجبا فقلنا أو ليس بأعمى لا يبصر فقال وأنتما لا تبصرانه (5) وهذا يدل على أنه لا يجوز للنساء مجالسة العميان كما جرت به العادة", "english": "Know that the seeker (al-murīd), at the beginning of his affair, ought not to occupy himself with marriage (al-tazwīj), for that is a distracting occupation (shughl shāghil) that prevents him from the Path (al-sulūk) and drags him toward intimacy (al-uns) with the wife. And whoever is intimate with other than God — exalted — is distracted from God. Let him not be deceived by the multiplicity of the marriages of the Messenger of God — may God bless him and grant him peace — for his heart was not occupied by all that is in this world away from God — exalted. So the angels are not to be compared with the blacksmiths (lā tuqās al-malā'ikah bi-l-ḥaddādīn). For this reason, Abū Sulaymān al-Dārānī said: \"Whoever marries has inclined to this world.\" And he said: \"I never saw a seeker who married and then remained steadfast upon his former state.\" And it was said to him once: \"How much you need a woman with whom you might find intimacy!\" He replied: \"May God not grant me intimacy with her\" — meaning that intimacy with her would prevent intimacy with God — exalted. He also said: \"Everything that distracts you from God — of family, wealth, and children — is ill-omened (mash'ūm) upon you.\" So how can anyone other than the Messenger of God — may God bless him and grant him peace — be compared to him? For his absorption in the love of God — exalted — was such that he would find his burning within it to a degree that he feared, in some states, that it might spread to his body (qālibihi) and destroy him. For that reason, he would sometimes strike his hand upon the thigh of ʿĀ'ishah and say: \"Speak to me, O ʿĀ'ishah\" — to distract himself with her speech from the immensity of what he was in, due to the insufficiency of his body's capacity for it. For his natural disposition (ṭab'uhu) was intimacy with God — mighty and majestic — and his intimacy with creatures was merely incidental (ʿāriḍ), as an act of gentleness toward his body. Then, when he could not bear to remain with people if he sat with them, and his breast became constricted, he would say: \"Give us rest by it, O Bilāl\" — until he returned to what was the delight of his eye. The hadith that prayer was the delight of his eye has also preceded. So the weak one, if he observes his own states in such matters, is deluded (maghrūr), for intellects fall short of grasping the secrets of his actions — may God bless him and grant him peace. Therefore, the condition for the seeker is celibacy (al-ʿuzbah) at the beginning, until he grows strong in gnosis (al-maʿrifah). This is [the ruling] when lust does not overcome him. But if lust overcomes him, let him break it with prolonged hunger and continuous fasting. If lust is not subdued by that, and he is in a state where he cannot guard his eye — for example — though he can guard his private parts, then success (al-najāḥ) is more appropriate for him, so that lust may be calmed. Otherwise, if he does not guard his eye, his thought (fikruhu) will not be preserved for him, his concern (hammuhu) will be scattered, and perhaps he will fall into an affliction (balīyah) he cannot bear. For the adultery of the eye (zinā al-ʿayn) is among the greater of the minor sins (kabā'ir al-ṣaghā'ir), and it leads to the approach to the great obscenity, which is the adultery of the private parts (zinā al-farj). And whoever cannot lower his gaze cannot guard his private parts.", "book_title": "Harms of the Tongue", "section_title_ar": "Section 652", "section_title_en": "On the Seeker's (Murīd) Beginning: Concerning Marriage, the Gaze, and the Trials of Youth", "section_index": 652, "anchors": "- Root: زوج (z-w-j)\n  * Lisan / Ayn: Pairing, coupling; each of the two mates in a pair.\n  * Al-Raghib (Mufradat): Used for each of the two companions (male and female) in animals that copulate, and for every two things that are paired, whether similar or opposite. \"زوجة\" is a poor (radī'ah) dialectal form.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"He is her husband (zawj) and she is his wife (zawj/zawjah).\" Metaphorical (Majaz): \"The two speeches paired (tazāwajā) and harmonized (izdawajā).\"\n- Root: عين (ʿ-yn)\n  * Lisan / Ayn: The eye (the organ); also the spring of water.\n  * Al-Raghib (Mufradat): The eye is the organ. \"He is under my eye (bi-ʿaynī)\" means: I guard and watch over him, as in {«فإنك بأعيننا»} [Q. 52:48].\n  * Al-Zamakhshari (Asas): Literal: \"He is watchful (ʿayyān).\" Metaphorical: The gaze (al-naẓar) as the act of the eye, and its extension to the heart's desire.\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn, overturn, or flip a thing from one face to another.\n  * Al-Raghib (Mufradat): \"Qalb al-shay': to turn it and divert it from one face to another, like turning a garment.\" The heart (qalb) is so named for its constant turning (taqallub).\n  * Al-Zamakhshari (Asas): Literal: \"He turned the thing over.\" Metaphorical: \"A man of turning (qalb) and resourcefulness (ḥawal): one who turns matters over and devises stratagems.\"\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle \"innamā\" restricts the predicate to the subject alone, negating any share for others. This governs the critical distinction in the text between the Prophet's ﷺ unique state and that of all others.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Harms of the Tongue'", "badge": "Insight"}], "31": [{"arabic": "فيها نفسه وقال تعالى {وتوبوا إلى الله جميعا أيها المؤمنون لعلكم تفلحون} والتوبة نظر في الفعل بعد الفراغ منه بالندم عليه وقد قال صلى الله عليه وسلم إني لأستغفر الله تعالى وأتوب إليه في اليوم مائة مرة (2) وقال تعالى {إن الذين اتقوا إذا مسهم طائف من الشيطان تذكروا فإذا هم مبصرون} وعن عمر رضي الله عنه انه كان يضرب قدميه بالدره إذا جنه الليل ويقول لنفسه ماذا عملت اليوم وعن ميمون ابن مهران أنه قال لا يكون العبد من المتقين حتى يحاسب نفسه أشد من محاسبة شريكه والشريكان يتحاسبان بعد العمل وروى عن عائشة رضي الله تعالى", "english": "As for its virtue, God most high has said: {«يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَلْتَنْظُرْ نَفْسٌ مَا قَدَّمَتْ لِغَدٍ»} (O you who believe, fear God, and let every soul look to what it has sent forward for the morrow) — and this is an allusion to reckoning over past deeds. For this reason, ʿUmar — may God most high be pleased with him — said: \"Call yourselves to account before you are called to account, and weigh yourselves before you are weighed.\" And in the report, a man came to him — peace be upon him — and said: \"O Messenger of God, counsel me.\" He said: \"Are you asking for counsel?\" He replied: \"Yes.\" He said: \"When you resolve upon a matter, then ponder its consequence: if it be right guidance, proceed with it; and if it be error, desist from it.\" And in the report: \"It behooves the intelligent man to have four hours: an hour in which he calls himself to account.\" And God most high said: {«وَتُوبُوا إِلَى اللَّهِ جَمِيعًا أَيُّهَا الْمُؤْمِنُونَ لَعَلَّكُمْ تُفْلِحُونَ»} (And turn in repentance to God all together, O believers, that you might succeed) — and repentance is a scrutiny of the deed after its completion, through regret over it. And he — peace be upon him — said: \"Verily I seek forgiveness from God most high and turn to Him in repentance a hundred times a day.\" And God most high said: {«إِنَّ الَّذِينَ اتَّقَوْا إِذَا مَسَّهُمْ طَائِفٌ مِنَ الشَّيْطَانِ تَذَكَّرُوا فَإِذَا هُمْ مُبْصِرُونَ»} (Verily those who fear God, when a whisper from Satan touches them, they remember — and behold, they are seeing clearly). And it is related of ʿUmar — may God be pleased with him — that he would strike his own feet with a whip when night fell upon him, saying to himself: \"What have you done today?\" And it is related of Maymūn ibn Mihrān that he said: \"A servant does not become one of the God-fearing until he calls himself to account more severely than he would his partner — and two partners reckon with each other after the work.\" And it is narrated from ʿĀʾishah — may God most high be pleased with her — that Abū Bakr — God's good pleasure be upon him — said to her at death: \"There is no one among mankind more beloved to me than ʿUmar.\" Then he said to her: \"How did I put it?\" So she repeated to him what he had said, whereupon he said: \"There is no one more honored by me than ʿUmar.\"", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 1238", "section_title_en": "The Third Watch: Self-Reckoning After Deeds — Its Virtue and Its Reality", "section_index": 1238, "anchors": "- Root: ح س ب (ḥ-s-b)\n  * Lisan / Ayn: Core meaning of counting, reckoning, and sufficient estimation; al-ḥisāb is the act of numbering and settling accounts.\n  * Al-Raghib (Mufradat): Theological nuance: muḥāsabah is the soul's voluntary audit of its deeds against divine command, prefiguring the eschatological reckoning (ḥisāb) by God.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): arithmetic counting; Metaphorical (majāz): self-interrogation and weighing of one's actions, as in \"ḥāsaba nafsahu\" (he called his soul to account).\n- Root: ن ظ ر (n-ẓ-r)\n  * Lisan / Ayn: To look, consider, reflect; naẓar implies deliberate examination with the eye or intellect.\n  * Al-Raghib (Mufradat): Theological nuance: taḍabbur (deep reflection) on consequences of actions, aligning sight with insight (baṣīrah).\n  * Al-Zamakhshari (Asas): Literal: physical gazing; Metaphorical: intellectual deliberation and foresight, as in \"tadabbar al-amr\" (he pondered the matter).\n- Root: ن ف س (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that which breathes and possesses volition.\n  * Al-Raghib (Mufradat): Theological nuance: al-nafs al-lawwāmah (the blaming soul) is the conscience that reproaches its owner for misdeeds, distinct from the corporeal body.\n  * Al-Zamakhshari (Asas): Literal: the animate self; Metaphorical: the inner tribunal where the soul is both accused and judge.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (باب الحصر والتقييد) — Constructions like \"إنما\" and conditional clauses (idhā... fa-) establish causal sequencing, as in \"if a whim touches them, they remember\" — the protasis governs the apodosis, binding reflection to action.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'", "badge": "Insight"}], "32": [{"arabic": "الغنى في الفراق والنكاح جميعا فقال {وأنكحوا الأيامى منكم والصالحين من عبادكم وإمائكم إن يكونوا فقراء يغنهم الله من فضله} وقال سبحانه وتعالى {وإن يتفرقا يغن الله كلا من سعته} الرابع أن لا يفشي سرها لا في الطلاق ولا عند النكاح فقد ورد في إفشاء سر النساء في الخبر الصحيح وعيد عظيم (1) ويروى عن بعض الصالحين أنه أراد طلاق امرأة فقيل له ما الذي يريبك فيها فقال العاقل لا يهتك ستر امرأته فلما طلقها قيل له لم طلقتها فقال مالي ولا مرأة غيري فهذا بيان ما على الزوج", "english": "Among those whose many divorces were mentioned from the Messenger of God — peace be upon him — was ʿAbd al-Raḥmān ibn al-Ḥārith ibn Hishām. Al-Ḥasan entered upon him in his house, and ʿAbd al-Raḥmān honored him greatly, seated him in his own place, and said: \"Would you not have sent for me, and I would have come to you?\" Al-Ḥasan said: \"I have a need.\" He said: \"What is it?\" He said: \"I have come to you as a suitor for your daughter.\" ʿAbd al-Raḥmān lowered his head, then raised it and said: \"By God, there is no one upon the face of the earth who walks upon it more beloved to me than you. But you know that my daughter is a piece of me (baḍʿah minnī) — what grieves her grieves me, and what delights her delights me — and you are a frequent divorcer (miṭlāq). I fear that you will divorce her, and if you do, I dread that my heart would change toward you in my love — and I would hate for my heart to change toward you, for you are a piece of the Messenger of God — peace be upon him. If you will stipulate that you will not divorce her, I will marry her to you.\" Al-Ḥasan remained silent, then rose and went out. One of his household said: \"I heard him walking and saying: 'ʿAbd al-Raḥmān only wanted to make his daughter a collar around my neck.'\"", "book_title": "Etiquette of Marriage", "section_title_ar": "Section 308", "section_title_en": "** On the Husband's Obligations: The Fourth Duty — Concealing the Wife's Secrets, and the Narratives Concerning al-Ḥasan's Many Divorces", "section_index": 308, "anchors": "**\n- Root: بضع (baḍʿa)\n  * Lisan / Ayn: \"بضع من الشاة بضعة إذا قطع قطعة\" — to cut a piece; the piece itself\n  * Al-Raghib (Mufradat): \"الأصل في هذه الكلمة: البضع وهو جملة من اللحم تبضع، أي: تقطع... وكني بالبضع عن الفرج\" — the root denotes a piece of flesh cut off; metaphorically extended to the pudendum, and by further extension to the child as \"a piece\" of the parent\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"من رضع معك رضعه، فهو منك بضعه، أي هو بعضك\" — the child is \"a piece\" (baḍʿah) of the father, as though cut from him, sharing his substance and nature\n- Root: طلق (ṭalaqa)\n  * Lisan / Ayn: \"متحرك. وطَلْقٌ وطَلَق: اسمان\" — the core sense of release from a tether\n  * Al-Raghib (Mufradat): \"أصل الطلاق: التخلية من الوثاق... ومنه استعير: طلقت المرأة، نحو: خليتها فهي طالق، أي: مخلاة عن حبالة النكاح\" — divorce is the release from the bond of marriage, as releasing a camel from its hobble\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"أطلقت الأسير، وهو طليق\" — literal release of a captive; \"طلقت المرأة وطلقت فهي طالق وهن طوالق\" — metaphorical extension to the divorced woman\n- Root: حسن (ḥasana)\n  * Lisan / Ayn: \"المَلقَة\" — beauty, goodness\n  * Al-Raghib (Mufradat): \"الحسن: عبارة عن كل مبهج مرغوب فيه\" — that which pleases and is desired; \"الحسنة يعبر عنها عن كل ما يسر\" — a good thing is what brings joy\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"اجلس حسنا\" — used adverbially for \"well\"; \"فلان لا يحسن شيئا\" — to do well, to master\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — the permissibility of interposing elements between a governing word and its governed prepositional phrase when the intervening material constitutes a complete, self-sufficient clause, as in the conditional constructions employed in the marriage stipulation narrative\n\n---\n\n**", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Marriage'", "badge": "Insight"}], "35": [{"arabic": "يكاد زيتها يضيء ولو لم تمسسه نار نور على نور وذلك مثل الأنبياء عليهم السلام إذ يتضح لهم في بواطنهم أمور غامضة من غير تعلم وسماع ويعبر عن ذلك بالإلهام وعن مثله عبر النبي صلى الله عليه وسلم حيث قال إن روح القدس نفث في روعي أحبب من أحببت فإنك مفارقه وعش ما شئت فإنك ميت واعمل ما شئت فإنك مجزي به (1) وهذا النمط من تعريف الملائكة للأنبياء يخالف الوحي الصريح الذي هو سماع الصوت بحاسة الأذن ومشاهدة الملك بحاسة البصر ولذلك أخبر عن هذا بالنفث في الروع ودرجات الوحي كثيرة والخوض فيها لا يليق بع", "english": "The variance in the light of inner vision (nūr al-baṣīrah) is like the variance in the light of eyesight — the difference between the dim-sighted (al-aʿmash) and the sharp-sighted is perceptible. Nay, the Sunnah of God, Mighty and Majestic, runs through all His creation with gradualness in bringing things into existence, such that even the instinct of appetite does not appear in the boy at puberty all at once and suddenly, but appears little by little, gradually. And likewise all powers and attributes. Whoever denies the variance of people in this innate faculty is as though he has slipped free of the collar of the intellect. And whoever supposes that the intellect of the Prophet ﷺ is like the intellect of the common rabble (āḥād al-sawādiyyah) and the coarse Bedouins (ajlāf al-bawādī) is himself viler in his own self than the common rabble. How can one deny the variance of the innate faculty? Were it not for it, people would not differ in understanding the sciences, nor would they be divided into the dull who does not understand even with explanation except after great toil from the teacher, and the intelligent who understands with the slightest hint and gesture, and the perfect one from whose very self the realities of things arise without instruction — as God Most High said: {«يَكَادُ زَيْتُهَا يُضِيءُ وَلَوْ لَمْ تَمْسَسْهُ نَارٌ ۚ نُّورٌ عَلَىٰ نُورٍ»} — \"Its oil would almost shine forth even if no fire touched it; light upon light\" (24:35). And that is the likeness of the prophets, peace be upon them, for obscure matters become clear to them in their inner selves without learning and without hearing, and this is expressed as inspiration (ilhām). And of its like the Prophet ﷺ gave expression when he said: \"Verily the Holy Spirit (Rūḥ al-Quds) breathed into my heart (nafatha fī rawʿī): Love whom you love, for you shall part from him; and live as you will, for you shall die; and work what you will, for you shall be recompensed for it.\" This mode of the angels' informing the prophets is different from explicit revelation (al-waḥy al-ṣarīḥ), which is the hearing of a voice through the sense of hearing and the seeing of the angel through the sense of sight. Therefore he reported this one as \"breathing into the heart\" (al-nafth fī al-rawʿ). The degrees of revelation are many, and delving into them is not befitting the science of practical religion (ʿilm al-muʿāmalah); rather, it belongs to the science of unveiling (ʿilm al-mukāshafah).", "book_title": "Patience and Gratitude", "section_title_ar": "Section 70", "section_title_en": "The Fourth Division: The Power's Mastery in Suppressing Desires, and the Divergence in the Innate Faculty of Intellect", "section_index": 70, "anchors": "- Root: قمع (qamaʿa)\n  * Lisan / Ayn: To crush, suppress, subdue, break the head of something; to beat down.\n  * Al-Raghib (Mufradat): The forceful restraint of a lower faculty by a higher one; the act of dominating a passion so it does not incline toward its object.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) for physically crushing; metaphorical (Majaz) for subduing the appetites, as the soul's power \"crushes\" the rebellious urge.\n- Root: غريزة (gharīzah)\n  * Lisan / Ayn: The innate, original disposition; the natural constitution with which one is created.\n  * Al-Raghib (Mufradat): The primordial faculty placed in the soul by the Creator, distinct from acquired knowledge; the raw material for intellectual and moral development.\n  * Al-Zamakhshari (Asas): Literal for the natural temper of a thing; here, the specific innate capacity for intellection ('aql) that varies among individuals.\n- Root: عقل (ʿaql)\n  * Al-Raghib (Al-Mufradat): \"العقل يقال للقوة المتهيئة لقبول العلم، ويقال للعلم الذي يستفيده الإنسان بتلك القوة عقل\" — The intellect is said of the faculty prepared to receive knowledge, and the knowledge one acquires by that faculty is also called ʿaql.\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"ما لفلان مقول، ولا معقول\" — The faculty of discernment and restraint.\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"نخلة لا تعقل الإبار إذا لم تقبله\" — A palm tree that does not \"accept\" pollination; metaphorically, the soul that does not receive and grasp truth.\n- Root: وحي (waḥy)\n  * Al-Raghib (Al-Mufradat): \"والإلهام: ما يلقى في الروع\" — Inspiration is what is cast into the inner self; distinguished from explicit revelation (waḥy) which involves sensory perception of the angel's voice or form.\n  * Kitab al-Ayn: The root indicates swift, hidden communication; the rushing of meaning into the heart without an apparent sensory intermediary.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to distinguish the true 'ālim (scholar) from the mere wearers of cloaks, and to restrict the meaning of 'aql against its misappropriation by dialectical theologians.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "ذكر شرفه وقد سماه الله نورا في قوله تعالى الله نور السموات والأرض مثل نوره كمشكاة وسمى العلم المستفاد منه روحا ووحيا وحياة فقال تعالى {وكذلك أوحينا إليك روحا من أمرنا} وقال سبحانه أومن كان ميتا فأحييناه وجعلنا له نورا يمشي به في الناس وحيث ذكر النور والظلمة أراد به العلم والجهل كقوله {يخرجهم من الظلمات إلى النور} وقال صلى الله عليه وسلم يا أيها الناس اعقلوا عن ربكم وتواصوا بالعقل تعرفوا ما أمرتم به وما نهيتم عنه واعلموا أنه ينجدكم عند ربكم واعلموا أن العاقل من أطاع الله وإن كان دميم المنظر حقير الخطر دنيء المنزلة رث الهيئة وأ", "english": "The Book of Seclusion ('Uzlah) — its explanation, God Most High willing. For this reason, Yūsuf ibn Asbāṭ wrote to Ḥudhayfah al-Marʿashī: \"What is your opinion of one who remains, finding no one with whom to remember God Most High except that he is either sinful, or his remembrance in company is itself an act of disobedience — and that because he finds no one of his own kind?\" And indeed he spoke truly, for mixing with people is never free from backbiting (ghībah), or listening to backbiting, or remaining silent upon wrongdoing (munkar). And the best of his states is that he either imparts knowledge or acquires it. Yet were this poor wretch to reflect, and to know that his imparting of knowledge is never free from the taints of ostentation (riyā'), the seeking of followers, and the desire for leadership (ri'āsah), he would know that the one who acquires knowledge from him only seeks to make it an instrument for pursuing the world and a means toward evil — so that the teacher becomes his helper therein, his support and his backer, preparing its causes for him, like one who sells a sword to a highway robber. For knowledge is like the sword: its soundness for good is like the soundness of the sword for warfare. And for this reason, it is not permitted to sell it to one whom one knows, by the indications of his circumstances, intends to use it to aid in cutting off the road.", "book_title": "Book of Knowledge", "section_title_ar": "Section 65", "section_title_en": "The Book of Seclusion ('Uzlah) — Section 65, and The Seventh Book: On the Intellect, Its Nobility, Its Reality, and Its Divisions", "section_index": 65, "anchors": "- Root: عقل (ʿaql)\n  * Lisan / Ayn: The root denotes binding, restraining, and holding back; the intellect is that which restrains the soul from base desires and prevents it from straying.\n  * Al-Raghib (Mufradat): \"العقل يقال للقوة المتهيئة لقبول العلم، ويقال للعلم الذي يستفيده الإنسان بتلك القوة عقل\" — The intellect is said of the faculty prepared for the reception of knowledge, and it is also said of the knowledge which man acquires by means of that faculty.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): intellectual apprehension and understanding. Metaphorical (Majaz): \"نخلة لا تعقل الإبار\" — a palm tree that does not accept pollination, i.e., does not grasp or take in.\n- Root: علم (ʿilm)\n  * Lisan / Ayn: Knowledge as the mark or sign by which a thing is known; the trace or landmark that guides.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — Knowledge is the apprehension of a thing in its true reality; it is of two kinds: apprehension of the essence of a thing, and judgment upon a thing regarding what exists for it or is negated of it.\n  * Al-Zamakhshari (Asas): Literal: certain awareness. Metaphorical: \"هو من أعلام العلم الخافقه\" — he is among the lofty banners of knowledge; knowledge as a guiding landmark (maʿlam).\n- Root: نور (nūr)\n  * Lisan / Ayn: Light; the first to set up beacons (manār) on his path in his campaigns to guide his return.\n  * Al-Raghib (Mufradat): \"النور: الضوء المنتشر الذي يعين على الإبصار\" — Light is the diffused radiance that aids vision; it is of two kinds: that perceived by the eye of inner insight (baṣīrah) — such as the light of the intellect and the light of the Qur'an — and that perceived by the eye of the head, such as the celestial bodies.\n  * Al-Zamakhshari (Asas): Literal: illumination. Metaphorical: \"نور الأمر: بينه\" — he illuminated the matter: he made it clear; \"وهذا أنور من ذاك: أبين\" — this is more luminous than that: more evident.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the exclusive attribution of a predicate to a subject, as in the author's restriction of the scholar's condition to one of two men, and the exclusion of the third.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "المسماة أنوارا ما أريد بها الضوء المحسوس بالبصر بل أريد بها ما أريد بقوله تعالى الله نور السموات والأرض مثل نوره كمشكاة فيها مصباح الآية ولنتجاوز هذه المعاني فإنها خارجة عن علم المعاملة ولا يوصل إلى حقائقها إلا الكشف التابع للفكر الصافي وقل من ينفتح له بابه والمتيسر على جماهير الخلائق الفكر فيما يفيد في علم المعاملة وذلك أيضا مما تغزر فائدته ويعظم نفعه فهذه الوظائف الأربعة أعني الدعاء والذكر والقراءة والفكر ينبغي أن تكون وظيفة المريد بعد صلاة الصبح بل في كل ورد بعد الفراغ من وظيفة الصلاة فليس بعد الصلاة وظيفة سوى هذه الأربع ويقوى على ذلك بأن يأخذ سلاحه ومجنته", "english": "Now, the first watch (al-wird al-awwal) is that which extends from the dawn prayer (ṣalāt al-ṣubḥ) until sunrise (ṭulūʿ al-shams). When the servant has completed his obligatory prayer, he should remain seated in his place of prayer, occupying himself with the remembrance of God most High, until the sun has risen. For it has been reported that the Messenger of God, peace and blessings be upon him, said: \"That I should sit in my assembly, remembering God most High therein, from the morning prayer until sunrise, is more beloved to me than freeing four slaves.\" {«لأن أقعد في مجلسي أذكر الله تعالى فيه من صلاة الغداة إلى طلوع الشمس أحب إلي من أن أعتق أربع رقاب»} And it is related that he, peace and blessings be upon him, when he had prayed the morning prayer, would sit in his place of prayer until the sun rose; and in some versions [it is added] that he would pray two rakʿahs—that is, after sunrise. Concerning the virtue of this [practice], an incalculable number of reports have come down. Al-Ḥasan related that the Messenger of God, peace and blessings be upon him, used to mention, among what he recounted of his Lord's mercy, that He said: \"O son of Adam, remember Me for an hour after the dawn prayer and for an hour after the afternoon prayer, and I shall suffice you for what lies between them.\" {«يا ابن آدم اذكرني بعد صلاة الفجر ساعة وبعد صلاة العصر ساعة أكفك ما بينهما»}", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 260", "section_title_en": "The Daily Liturgy of the Devout Servant: The First Watch (After Dawn Prayer until Sunrise)", "section_index": 260, "anchors": "- Root: ذكر (dhakara)\n  * Lisan / Ayn: Remembrance, invocation, mention; the opposite of forgetfulness (nisyān).\n  * Al-Raghib (Mufradat): Remembrance of God (dhikr) is the heart's presence with the Divine, ranging from the tongue's utterance to the heart's contemplation; it is the noblest act when accompanied by presence of heart.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): verbal mention. Metaphorical (majāz): the heart's steadfastness in knowledge of God, which is the reality of dhikr.\n- Root: صلا (ṣallā)\n  * Lisan / Ayn: Prayer (ṣalāh); root meaning of supplication and blessing; also \"to kindle a fire\" (as in ṣalā al-nār).\n  * Al-Raghib (Mufradat): Ṣalāh is the servant's standing before God in humility and devotion, comprising praise, recitation, bowing, and prostration; its perfection lies in the heart's presence.\n  * Al-Zamakhshari (Asas): Literal: the ritual prayer with its pillars. Metaphorical: supplication (duʿā') and blessing (taṣliyah) upon the Prophet.\n- Root: ورد (warada)\n  * Lisan / Ayn: To arrive at water; a portion or share of something that comes regularly.\n  * Al-Raghib (Mufradat): The daily portion (wird) of devotion—a set liturgy of prayers, recitations, and remembrances that the servant regularly performs at appointed times.\n  * Al-Zamakhshari (Asas): Literal: arriving at a watering place. Metaphorical: the soul's regular approach to the fountain of divine grace through prescribed acts of worship.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd) — governing the precise enumeration of the four functions (adʿiyah, adhkār, qirā'ah, fikr) after the dawn prayer, each specified by its own governing verb and object.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Arrangement of Litanies'", "badge": "Insight"}, {"arabic": "بقوله تعالى الله نور السموات والأرض مثل نوره كمشكاة فيها مصباح الآية ولنتجاوز هذه المعاني فإنها خارجة عن علم المعاملة ولا يوصل إلى حقائقها إلا الكشف التابع للفكر الصافي وقل من ينفتح له بابه والمتيسر على جماهير الخلائق الفكر فيما يفيد في علم المعاملة وذلك أيضا مما تغزر فائدته ويعظم نفعه فهذه الوظائف الأربعة أعني الدعاء والذكر والقراءة والفكر ينبغي أن تكون وظيفة المريد بعد صلاة الصبح بل في كل ورد بعد الفراغ من وظيفة الصلاة فليس بعد الصلاة وظيفة سوى هذه الأربع ويقوى على ذلك بأن يأخذ سلاحه ومجنت", "english": "Now, the first watch (al-wird al-awwal) is that which extends from the dawn prayer (ṣalāt al-ṣubḥ) until sunrise (ṭulūʿ al-shams). When the servant has completed his obligatory prayer, he should remain seated in his place of prayer, occupying himself with the remembrance of God most High, until the sun has risen. For it has been reported that the Messenger of God, peace and blessings be upon him, said: \"That I should sit in my assembly, remembering God most High therein, from the morning prayer until sunrise, is more beloved to me than freeing four slaves.\" {«لأن أقعد في مجلسي أذكر الله تعالى فيه من صلاة الغداة إلى طلوع الشمس أحب إلي من أن أعتق أربع رقاب»} And it is related that he, peace and blessings be upon him, when he had prayed the morning prayer, would sit in his place of prayer until the sun rose; and in some versions [it is added] that he would pray two rakʿahs—that is, after sunrise. Concerning the virtue of this [practice], an incalculable number of reports have come down. Al-Ḥasan related that the Messenger of God, peace and blessings be upon him, used to mention, among what he recounted of his Lord's mercy, that He said: \"O son of Adam, remember Me for an hour after the dawn prayer and for an hour after the afternoon prayer, and I shall suffice you for what lies between them.\" {«يا ابن آدم اذكرني بعد صلاة الفجر ساعة وبعد صلاة العصر ساعة أكفك ما بينهما»}", "book_title": "Disciplining the Soul", "section_title_ar": "Section 260", "section_title_en": "The Daily Liturgy of the Devout Servant: The First Watch (After Dawn Prayer until Sunrise)", "section_index": 260, "anchors": "- Root: ذكر (dhakara)\n  * Lisan / Ayn: Remembrance, invocation, mention; the opposite of forgetfulness (nisyān).\n  * Al-Raghib (Mufradat): Remembrance of God (dhikr) is the heart's presence with the Divine, ranging from the tongue's utterance to the heart's contemplation; it is the noblest act when accompanied by presence of heart.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): verbal mention. Metaphorical (majāz): the heart's steadfastness in knowledge of God, which is the reality of dhikr.\n- Root: صلا (ṣallā)\n  * Lisan / Ayn: Prayer (ṣalāh); root meaning of supplication and blessing; also \"to kindle a fire\" (as in ṣalā al-nār).\n  * Al-Raghib (Mufradat): Ṣalāh is the servant's standing before God in humility and devotion, comprising praise, recitation, bowing, and prostration; its perfection lies in the heart's presence.\n  * Al-Zamakhshari (Asas): Literal: the ritual prayer with its pillars. Metaphorical: supplication (duʿā') and blessing (taṣliyah) upon the Prophet.\n- Root: ورد (warada)\n  * Lisan / Ayn: To arrive at water; a portion or share of something that comes regularly.\n  * Al-Raghib (Mufradat): The daily portion (wird) of devotion—a set liturgy of prayers, recitations, and remembrances that the servant regularly performs at appointed times.\n  * Al-Zamakhshari (Asas): Literal: arriving at a watering place. Metaphorical: the soul's regular approach to the fountain of divine grace through prescribed acts of worship.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd) — governing the precise enumeration of the four functions (adʿiyah, adhkār, qirā'ah, fikr) after the dawn prayer, each specified by its own governing verb and object.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "فالأكياس وأرباب البصائر قلوبهم كمشكاة فيها مصباح المصباح في زجاجة الزجاجة كأنها كوكب دري يوقد من شجرة مباركة زيتونة لا شرقية ولا غريبة يكاد زيتها يضيء ولو لم تمسسه نار نور على نور والمغترون قلوبهم {كظلمات في بحر لجى يغشاه موج من فوقه موج من فوقه سحاب ظلمات بعضها فوق بعض إذا أخرج يده لم يكد يراها ومن لم يجعل الله له نورا فما له من نور} فالأكياس هم الذين أراد الله أن يهديهم فشرح صدورهم للإسلام والهدى والمغترون هم الذين أراد الله أن يضلهم فجعل صدرهم ضيقا حرجا كأنما يصعد في السماء والمغرور هو الذي لم تنفتح بصيرته ليكون بهداية نفسه كفيلا وبقي في العمى فاتخذ الهوى قائدا والشيطان دليلا {ومن كان في هذه أعمى فهو في الآخ", "english": "Thus the shrewd ones (akyās) and the possessors of inner sight (arbāb al-baṣā'ir) — their hearts are like a niche (mishkāh) in which is a lamp (miṣbāḥ), the lamp in a glass, the glass as though it were a pearly star, kindled from a blessed olive tree, neither of the east nor of the west, whose oil would almost glow even if no fire touched it — light upon light (nūrun 'alā nūr). But the self-deceived (maghrūrūn) — their hearts are {«كَظُلُمَاتٍ فِي بَحْرٍ لُجِّيٍّ يَغْشَاهُ مَوْجٌ مِنْ فَوْقِهِ مَوْجٌ مِنْ فَوْقِهِ سَحَابٌ ظُلُمَاتٌ بَعْضُهَا فَوْقَ بَعْضٍ إِذَا أَخْرَجَ يَدَهُ لَمْ يَكَدْ يَرَاهَا وَمَنْ لَمْ يَجْعَلِ اللَّهُ لَهُ نُورًا فَمَا لَهُ مِنْ نُورٍ»} (Q. 24:40) — like darknesses in a vast deep sea, covered by a wave, above which is another wave, above which is a cloud — darknesses, one above another; when he stretches out his hand, he can scarcely see it. And he to whom God grants no light, for him there is no light.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 883", "section_title_en": "The Book of Censure of Self-Deception (Kitāb Dhamm al-Ghurūr) — Book Ten of the Quarter of the Destroyers from The Revival of the Religious Sciences", "section_index": 883, "anchors": "- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Core sense of an overlooked flaw, a heedless state, or a deceptive glitter; the \"white blaze\" on a horse's forehead that draws the eye but conceals the animal's true nature.\n  * Al-Raghib (Mufradat): \"Ghurūr\" is a heedlessness (ghaflah) in wakefulness, rooted in the pursuit of a perceived gain (ghurrah) that is in fact a loss; it is the state of being deluded by the apparent good while the inner reality is ruinous, as in {«مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ»} (Q. 82:6).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): to approach someone off-guard (ghirrah). Metaphorical (majāz): the \"white-blazed day\" (yawm agharr) of intense heat — a dazzling surface that misleads; the deluded man is like a gazelle that grazes in moonlight, deceived into thinking it is daylight, until the predator seizes it.\n- Root: نور (n-w-r)\n  * Lisan / Ayn: Light that renders things visible; the first thing created by God to dispel darkness.\n  * Al-Raghib (Mufradat): Two kinds: sensory light (perceived by the eye) and intellectual/divine light (perceived by the inner eye of insight, baṣīrah) — the latter being the light of reason and of the Qur'an, as in {«قَدْ جَاءَكُمْ مِنَ اللَّهِ نُورٌ وَكِتَابٌ مُبِينٌ»} (Q. 5:15).\n  * Al-Zamakhshari (Asas): Literal: illumination of a lamp or fire. Metaphorical: clarification and manifestation — \"nawwara al-amr\" (he made the matter clear); the light of guidance is that which makes the path of salvation evident to the heart.\n- Root: صدر (ṣ-d-r)\n  * Lisan / Ayn: The chest, the seat of the heart; also the \"foremost\" part of anything.\n  * Al-Raghib (Mufradat): Literally the bodily chest; metaphorically extended to the \"front\" of a thing (ṣadr al-majlis, the head of the assembly). When used of the heart's expansion (sharḥ al-ṣadr), it denotes the spiritual opening of the breast to receive divine light and guidance, as in {«رَبِّ اشْرَحْ لِي صَدْرِي»} (Q. 20:25).\n  * Al-Zamakhshari (Asas): Literal: to return from water (ṣadara). Metaphorical: the beginning or origin of an affair — \"akhadha al-amra bi-ṣadrihi\" (he took the matter from its very outset); the \"sources and returns\" (mawārid wa maṣādir) of all things.\n- Root: ربع (r-b-')\n  * Lisan / Ayn: Four; the fourth part; a place of dwelling and spring pasturage.\n  * Al-Raghib (Mufradat): The root of \"four\" and its derivatives; used for the four categories or classes into which a thing is divided.\n  * Al-Zamakhshari (Asas): Literal: to dwell (raba'a bi-l-makān). Metaphorical: to raise and restore (rabba'ahu Allāh — God raised him up); here, the \"Quarter of the Destroyers\" (rub' al-muhlikāt) is the fourth part of the Iḥyā' devoted to the vices that ruin the soul.\n- Sibawayh Rule: Interposition of the Prepositional Phrase (bāb al-faṣl bayna al-jār wa al-majrūr) — The periodic sentence structure in the opening doxology (\"الحمد لله الذي بيده مقاليد الأمور\") places the prepositional phrase \"bi-yadihi\" (in His hand) before its governing noun to achieve rhetorical emphasis (takhṣīṣ) and to signal the theological priority of divine agency over all affairs.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Delusion'", "badge": "Insight"}], "36": [{"arabic": "وإيتاء الزكاة وقال الله تعالى في بيوت أذن الله أن ترفع ويذكر فيها اسمه فينبغي أن يجعل أول النهار إلى وقت دخول السوق لآخرته فيلازم المسجد ويواظب على الأوراد كان عمر رضي الله عنه يقول للتجار اجعلوا أول نهاركم لآخرتكم وما بعده لدنياكم وكان صالحو السلف يجعلون أول النهار وآخره للآخرة والوسط للتجارة ولم يكن يبيع الهريسة والرءوس بكرة إلا الصبيان وأهل الذمة لأنهم كانوا في المساجد بعد وفي الخبر إن الملائكة إذا صعدت بصحيفة العبد وفيها في أول النهار وفي آخره ذكر الله وخير كفر الله عنهما ما بينهما من سيئ الأعمال (1) و", "english": "Some of the Salaf (may God be pleased with them) said: \"The thing most worthy of the intelligent man is that which he most needs in the immediate term; and the thing he most needs in the immediate term is that whose consequence is most praiseworthy in the long term.\"", "book_title": "Etiquette of Earning", "section_title_ar": "Section 332", "section_title_en": "On the Merchant's Vigilance Over His Religion: Seven Matters of Concern in Trade", "section_index": 332, "anchors": "- Root: دنا (d-n-w)\n  * Lisan / Ayn: Proximity, nearness in place, time, or rank; the nearer (adnā) as opposed to the farther.\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات، أو بالحكم\" — nearness by essence or by judgment; used of place, time, and station. The \"nearer life\" (al-ḥayāh al-dunyā) is the proximate, lower life.\n  * Al-Zamakhshari (Asas): Literal: physical nearness. Metaphorical: the worldly life (al-dunyā) as that which is \"nearer\" and lower, contrasted with the Hereafter (al-ākhirah) which is \"farther\" but enduring.\n- Root: سوق (s-w-q)\n  * Lisan / Ayn: To drive, to impel, to lead; a market (sūq) where goods are driven and circulated.\n  * Al-Raghib (Mufradat): The driving of one's self toward a goal; the market as the arena of exchange and transaction.\n  * Al-Zamakhshari (Asas): Literal: \"ساق النعم فانساقت\" — he drove the cattle and they were driven. Metaphorical: \"ساق الله إليه خيرا\" — God drove good to him; \"ساق إليها المهر\" — he sent the dowry to her. The \"market of the Hereafter\" (sūq al-ākhirah) is the mosque, where one trades deeds for the next life.\n- Root: جار (j-w-r)\n  * Lisan / Ayn: To deviate from the right path, to wrong, to oppress; also a neighbor (jār) whose rights are sacred.\n  * Al-Raghib (Mufradat): \"الجار: من يقرب مسكنه منك\" — the neighbor is one whose dwelling is near yours; a reciprocal term. God's right and the neighbor's right are conjoined in the Qur'anic verse {والجار ذي القربى والجار الجنب} (Al-Nisā': 36).\n  * Al-Zamakhshari (Asas): Literal: oppression and transgression. Metaphorical: the \"oppressive oath\" (yamīn fājirah) — an oath that swerves from truth and justice.\n- Root: الي (a-l-w)\n  * Lisan / Ayn: To fall short, to fail; also related to رسالة (message) via مألكة.\n  * Al-Raghib (Mufradat): The root conveys the idea of commission and conveyance of a message; \"المألكة: الرسالة\" — the message, because it is \"chewed\" in the mouth (from ألك, to masticate).\n  * Al-Zamakhshari (Asas): Literal: to chew. Metaphorical: the angelic conveyance of revelation as a \"message\" delivered.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — When the author says \"وإنما تتم شفقة التاجر على دينه بمراعاة سبعة أمور\" (\"The merchant's compassion for his religion is only completed by observing seven matters\"), the particle إنما restricts and confines the predicate to the subject, establishing that these seven matters are the exclusive and exhaustive means to the end.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Etiquette of Earning'", "badge": "Dhikr"}], "37": [{"arabic": "قال الله تعالى رجال لا تلهيهم تجارة ولا بيع عن ذكر الله وإقام الصلاة وإيتاء الزكاة وقال الله تعالى في بيوت أذن الله أن ترفع ويذكر فيها اسمه فينبغي أن يجعل أول النهار إلى وقت دخول السوق لآخرته فيلازم المسجد ويواظب على الأوراد كان عمر رضي الله عنه يقول للتجار اجعلوا أول نهاركم لآخرتكم وما بعده لدنياكم وكان صالحو السلف يجعلون أول النهار وآخره للآخرة والوسط للتجارة ولم يكن يبيع الهريسة والرءوس بكرة إلا الصبيان وأهل الذمة لأنهم كانوا في المساجد بعد وفي الخبر إن الملائكة إذا صعدت بصحيفة العبد وفيها في", "english": "Some of the Salaf (may God be pleased with them) said: \"The thing most worthy of the intelligent man is that which he most needs in the immediate term; and the thing he most needs in the immediate term is that whose consequence is most praiseworthy in the long term.\"", "book_title": "Condemnation of Envy", "section_title_ar": "Section 332", "section_title_en": "On the Merchant's Vigilance Over His Religion: Seven Matters of Concern in Trade", "section_index": 332, "anchors": "- Root: دنا (d-n-w)\n  * Lisan / Ayn: Proximity, nearness in place, time, or rank; the nearer (adnā) as opposed to the farther.\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات، أو بالحكم\" — nearness by essence or by judgment; used of place, time, and station. The \"nearer life\" (al-ḥayāh al-dunyā) is the proximate, lower life.\n  * Al-Zamakhshari (Asas): Literal: physical nearness. Metaphorical: the worldly life (al-dunyā) as that which is \"nearer\" and lower, contrasted with the Hereafter (al-ākhirah) which is \"farther\" but enduring.\n- Root: سوق (s-w-q)\n  * Lisan / Ayn: To drive, to impel, to lead; a market (sūq) where goods are driven and circulated.\n  * Al-Raghib (Mufradat): The driving of one's self toward a goal; the market as the arena of exchange and transaction.\n  * Al-Zamakhshari (Asas): Literal: \"ساق النعم فانساقت\" — he drove the cattle and they were driven. Metaphorical: \"ساق الله إليه خيرا\" — God drove good to him; \"ساق إليها المهر\" — he sent the dowry to her. The \"market of the Hereafter\" (sūq al-ākhirah) is the mosque, where one trades deeds for the next life.\n- Root: جار (j-w-r)\n  * Lisan / Ayn: To deviate from the right path, to wrong, to oppress; also a neighbor (jār) whose rights are sacred.\n  * Al-Raghib (Mufradat): \"الجار: من يقرب مسكنه منك\" — the neighbor is one whose dwelling is near yours; a reciprocal term. God's right and the neighbor's right are conjoined in the Qur'anic verse {والجار ذي القربى والجار الجنب} (Al-Nisā': 36).\n  * Al-Zamakhshari (Asas): Literal: oppression and transgression. Metaphorical: the \"oppressive oath\" (yamīn fājirah) — an oath that swerves from truth and justice.\n- Root: الي (a-l-w)\n  * Lisan / Ayn: To fall short, to fail; also related to رسالة (message) via مألكة.\n  * Al-Raghib (Mufradat): The root conveys the idea of commission and conveyance of a message; \"المألكة: الرسالة\" — the message, because it is \"chewed\" in the mouth (from ألك, to masticate).\n  * Al-Zamakhshari (Asas): Literal: to chew. Metaphorical: the angelic conveyance of revelation as a \"message\" delivered.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — When the author says \"وإنما تتم شفقة التاجر على دينه بمراعاة سبعة أمور\" (\"The merchant's compassion for his religion is only completed by observing seven matters\"), the particle إنما restricts and confines the predicate to the subject, establishing that these seven matters are the exclusive and exhaustive means to the end.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Condemnation of Envy'", "badge": "Dhikr"}], "38": [{"arabic": "{وقال} فيكشف ما تدعون إليه إن شاء {وقال} يرزق من يشاء بغير حساب {وقال} ويغفر ما دون ذلك لمن يشاء {وقال} ويتوب الله على من يشاء وهو خلق من أخلاق الربوبية إذ قال تعالى والله شكور حليم وقد جعل الله الشكر مفتاح كلام أهل الجنة فقال تعالى وقالوا الحمد لله الذي صدقناه وعده {وقال} وآخر دعواهم أن الحمد لله رب العالمين", "english": "So then, what we have mentioned concerning the treatment of patience (ṣabr) regarding whispered insinuation (waswās), regarding lust (shahwah), and regarding status (jāh) — annex this to what we have already set down concerning the canons of the paths of spiritual striving (mujāhadah) in the Book of the Discipline of the Soul (Kitāb Riyāḍat al-Nafs) from the Quarter of the Destroyers (rubʿ al-muhlikāt). Adopt it as your manual (dastūr) by which you may come to know the treatment of patience in all the categories which we have previously detailed; for the detailing of individual cases is prolix. Whoever observes gradual progression (tadrīj), patience will elevate him to a state wherein patience without it becomes as arduous as it once was with it — so his affairs become inverted, and what was once beloved to him becomes loathed, and what was once detested to him becomes a sweet, wholesome draught from which he cannot bear to be patient [in abstaining]. This is known only through experience (tajribah) and tasting (dhawq). It has an analogue in customary habits: for a boy is compelled to learning in the beginning by force, and so patience with play and patience with knowledge are both arduous for him — until, when his inner sight is opened and he finds intimacy with knowledge, the matter is inverted, and it becomes arduous for him to be patient in abstaining from knowledge, and to endure play. To this points what is narrated of one of the knowers (ʿārifīn) that he asked al-Shiblī: \"Patience — which of its kinds is the most severe?\" He said: \"Patience in God (fī Allāh).\" He said: \"No.\" He said: \"Patience for God (li-Allāh).\" He said: \"No.\" He said: \"Patience with God (maʿa Allāh).\" He said: \"No.\" He said: \"Then what?\" He said: \"Patience from God (ʿan Allāh).\" At that al-Shiblī cried out a cry by which his soul nearly perished. And it has been said concerning the meaning of His saying, the Exalted: {«اصبروا وصابروا ورابطوا»} \"Be patient, and vie in patience, and be steadfast\" (Q. 3:200): \"Be patient in God, vie in patience by God, and be steadfast with God.\" And it was said: \"Patience for God is sufficiency (ghināʾ); patience by God is endurance (baqāʾ); patience with God is fidelity (wafāʾ); and patience from God is abandonment (jafāʾ).\" And it was said concerning its meaning:", "book_title": "Patience and Gratitude", "section_title_ar": "Section 972", "section_title_en": "The Revival of the Religious Sciences — Section 972: On Patience (al-Sabr) and the Commencement of Gratitude (al-Shukr)", "section_index": 972, "anchors": "- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning of restraint and withholding; al-Khalil notes its application to holding back an animal from fodder, and to enduring constraint.\n  * Al-Raghib (Mufradat): \"الصبر: الإمساك في ضيق\" — the withholding of the self in constriction; it is a general term whose specific names (shajāʿah, ḥilm, etc.) vary by context, and its opposite is al-jazaʿ (panic/vexation).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صبرت على ما أكره. وصبرت عما أحب\" — enduring what is disliked and restraining from what is loved. Metaphorical (majāz): \"صبرت يمينه\" — binding an oath strenuously; \"أصبر على الضرب من الأرض\" — more enduring than the earth.\n- Root: شكر (sh-k-r)\n  * Lisan / Ayn: The root denotes manifestation and fullness; al-Ayn links it to an overflowing udder (shukrā).\n  * Al-Raghib (Mufradat): \"الشكر: تصور النعمة وإظهارها\" — the perception of a blessing and its display; it is the opposite of kufr (covering/denial). It has three degrees: of the heart (perception), of the tongue (praise), and of the limbs (requital).\n  * Al-Zamakhshari (Asas): Literal: \"شكرت لله تعالى نعمته\" — thanking God for His grace. Metaphorical: \"دابة شكور\" — a beast that thrives on little fodder, displaying its owner's care through its fatness.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as the apprehension of a thing's reality; al-Ayn treats it under the entry of umm (source/origin), indicating that knowledge is the root to which all else is annexed.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — apprehension of a thing by its true reality, either by grasping its essence or by affirming/denying a predicate of it.\n  * Al-Zamakhshari (Asas): Literal: \"ما علمت بخبرك: ما شعرت به\" — to be aware/perceive. It is also used for the landmarks (maʿālim) of the road, i.e., traces by which one is guided.\n- Root: وقد (w-q-d)\n  * Lisan / Ayn: The kindling and blazing of fire; al-Ayn records it under the entry of w-q-d with the sense of fuel and flame.\n  * Al-Raghib (Mufradat): \"وقدت النار تقد وقودا ووقدا\" — the fire blazed; al-wuqūd is both the fuel and the resulting flame, as in {«وقودها الناس والحجارة»} (Q. 2:24).\n  * Al-Zamakhshari (Asas): Literal: \"وقدت النار وقودا ووقدا، واتقدت وتوقدت\" — the fire blazed and blazed fiercely. Metaphorical: \"قلب وقاد\" — a blazing, keen heart; \"وقدة الصيف\" — the blazing heat of summer.\n- Sibawayh Rule: Interposition between the operative word and its object (al-faṣl bayna al-ʿāmil wa al-maʿmūl fīhi) — governing the placement of circumstantial qualifiers (ḥāl) and prepositional phrases to preserve the intended semantic restriction, as in the verse \"اصبروا وصابروا ورابطوا\" where each imperative carries a distinct operative scope.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "40": [{"arabic": "بحر لجى يغشاه موج من فوقه موج من فوقه سحاب ظلمات بعضها فوق بعض فإذن لا سعادة إلا في معرفة الله تعالى وأما ما عدا ذلك من المعارف فمنها ما لا فائدة له أصلا كمعرفة الشعر وأنساب العرب وغيرهما ومنها ما له منفعة في الإعانة على معرفة الله تعالى كمعرفة لغة العرب والتفسير والفقه والأخبار فإن معرفة لغة العرب تعين على معرفة تفسير القرآن ومعرفة التفسير تعين على معرفة ما في القرآن من كيفية العبادات والأعمال التي تفيد تزكية النفس ومعرفة طريق تزكية النفس تفيد استعداد النفس لقبول الهدايا إلى معرفة الله سبحانه وتعالى كما ق", "english": "All of these divisions are comprised within knowledge of God — of what is necessary for Him, what is impossible in His attributes, and what is permissible in His acts. Thus, knowledge of God — exalted be He — of His attributes, His acts, His wisdom in the dominion (malakūt) of the heavens and the earth, the ordering of this world and the Hereafter, and what pertains to that — this is the true perfection that draws near to God — exalted be He — the one who is described by it, and it remains a perfection for the soul after death. And this knowledge becomes a light for the knowers after death: {their light running before them and on their right hands, they saying: \"Our Lord, perfect for us our light\"} {«ربنا أتمم لنا نورنا»} — that is, this knowledge is the capital that leads to the disclosure of what was not disclosed in this world. Just as one who carries a hidden lamp — it is possible that this becomes the cause of increased light by another lamp from which he kindles, so that the hidden light is completed by way of supplementation — while one who has no lamp at all has no hope of that. So too, one who has no root of knowledge of God — exalted be He — has no hope in that light; he remains like one whose similitude is in darkness, not emerging from it — nay, {like darknesses in a vast deep sea, covered by wave above wave, above which is cloud: darknesses, one above another} {«كظلمات في بحر لجي يغشاه موج من فوقه موج من فوقه سحاب ظلمات بعضها فوق بعض»}. Therefore, there is no happiness save in knowledge of God — exalted be He.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 799", "section_title_en": "The True Perfection of Knowledge and Its Degrees of Proximity to God", "section_index": 799, "anchors": "- Root: علم (ʿ-L-M)\n  * Lisan / Ayn: Core sense of \"knowing\" as the impression of a thing's reality upon the mind; the root also carries the sense of a \"mark\" or \"sign\" by which something is distinguished and recognized.\n  * Al-Raghib (Mufradat): Knowledge (ʿilm) is \"the apprehension of a thing by its true reality\" — divided into apprehension of the essence of a thing, and judgment upon a thing regarding what is or is not predicated of it. It is the broadest epistemic term, applicable to God and creatures alike.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage: \"He is a sign (ʿalam) of knowledge\" — knowledge is that which marks and distinguishes. The metaphorical (majāz) extension: \"I knew of your news\" = \"I perceived it\" — indicating that knowledge as proximity to God is not mere information but a transformative mark upon the soul.\n- Root: عرف (ʿ-R-F)\n  * Lisan / Ayn: Recognition through traces and effects; the root denotes \"coming to know by way of discernment of distinguishing features.\"\n  * Al-Raghib (Mufradat): Maʿrifah is \"apprehension of a thing through reflection and deliberation upon its effect\" — more specific than ʿilm. It is the term used for the creature's knowledge of God, since it proceeds from contemplating His works, not from grasping His essence.\n  * Al-Zamakhshari (Asas): Literal: \"I will make you recognize (la-ʾuʿarrifanna-ka) what you did\" = \"I will requite you for it.\" This underscores that maʿrifah is knowledge that returns upon the knower as a state of recompense or illumination.\n- Root: نور (N-W-R)\n  * Lisan / Ayn: Light as that which renders visible; the root also yields \"beacon\" (manār) — a landmark set upon a path for guidance.\n  * Al-Raghib (Mufradat): \"Light is the diffused radiance that aids vision\" — of two kinds: the sensory (perceived by the eye) and the intellectual (perceived by the inner eye of insight), the latter being \"the light of the intellect and the light of the Qur'an.\"\n  * Al-Zamakhshari (Asas): Metaphorical (majāz): \"The matter became luminous (nāra)\" = \"it became clear.\" Light is thus the very clarity of knowledge that guides the knower through the darkness of ignorance.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd) — governing the use of \"إنما\" (innamā) to restrict perfection exclusively to knowledge of God, and the conditional-connective structure (fa-innahu, fa-kullamā) that links degrees of knowledge to degrees of proximity.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "مطمع في هذا النور فيبقى كمن مثله في الظلمات ليس بخارج منها بل كظلمات في بحر لجى يغشاه موج من فوقه موج من فوقه سحاب ظلمات بعضها فوق بعض فإذن لا سعادة إلا في معرفة الله تعالى وأما ما عدا ذلك من المعارف فمنها ما لا فائدة له أصلا كمعرفة الشعر وأنساب العرب وغيرهما ومنها ما له منفعة في الإعانة على معرفة الله تعالى كمعرفة لغة العرب والتفسير والفقه والأخبار فإن معرفة لغة العرب تعين على معرفة تفسير القرآن ومعرفة التفسير تعين على معرفة ما في القرآن من كيفية العبادات والأعمال التي تفيد تزكية النفس ومعرفة طريق تزكية النفس تفيد استعداد النفس لقبول الهدايا إلى معرفة الله سبحانه وتعالى كما قال ت", "english": "All of these divisions are comprised within knowledge of God — of what is necessary for Him, what is impossible in His attributes, and what is permissible in His acts. Thus, knowledge of God — exalted be He — of His attributes, His acts, His wisdom in the dominion (malakūt) of the heavens and the earth, the ordering of this world and the Hereafter, and what pertains to that — this is the true perfection that draws near to God — exalted be He — the one who is described by it, and it remains a perfection for the soul after death. And this knowledge becomes a light for the knowers after death: {their light running before them and on their right hands, they saying: \"Our Lord, perfect for us our light\"} {«ربنا أتمم لنا نورنا»} — that is, this knowledge is the capital that leads to the disclosure of what was not disclosed in this world. Just as one who carries a hidden lamp — it is possible that this becomes the cause of increased light by another lamp from which he kindles, so that the hidden light is completed by way of supplementation — while one who has no lamp at all has no hope of that. So too, one who has no root of knowledge of God — exalted be He — has no hope in that light; he remains like one whose similitude is in darkness, not emerging from it — nay, {like darknesses in a vast deep sea, covered by wave above wave, above which is cloud: darknesses, one above another} {«كظلمات في بحر لجي يغشاه موج من فوقه موج من فوقه سحاب ظلمات بعضها فوق بعض»}. Therefore, there is no happiness save in knowledge of God — exalted be He.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 799", "section_title_en": "The True Perfection of Knowledge and Its Degrees of Proximity to God", "section_index": 799, "anchors": "- Root: علم (ʿ-L-M)\n  * Lisan / Ayn: Core sense of \"knowing\" as the impression of a thing's reality upon the mind; the root also carries the sense of a \"mark\" or \"sign\" by which something is distinguished and recognized.\n  * Al-Raghib (Mufradat): Knowledge (ʿilm) is \"the apprehension of a thing by its true reality\" — divided into apprehension of the essence of a thing, and judgment upon a thing regarding what is or is not predicated of it. It is the broadest epistemic term, applicable to God and creatures alike.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage: \"He is a sign (ʿalam) of knowledge\" — knowledge is that which marks and distinguishes. The metaphorical (majāz) extension: \"I knew of your news\" = \"I perceived it\" — indicating that knowledge as proximity to God is not mere information but a transformative mark upon the soul.\n- Root: عرف (ʿ-R-F)\n  * Lisan / Ayn: Recognition through traces and effects; the root denotes \"coming to know by way of discernment of distinguishing features.\"\n  * Al-Raghib (Mufradat): Maʿrifah is \"apprehension of a thing through reflection and deliberation upon its effect\" — more specific than ʿilm. It is the term used for the creature's knowledge of God, since it proceeds from contemplating His works, not from grasping His essence.\n  * Al-Zamakhshari (Asas): Literal: \"I will make you recognize (la-ʾuʿarrifanna-ka) what you did\" = \"I will requite you for it.\" This underscores that maʿrifah is knowledge that returns upon the knower as a state of recompense or illumination.\n- Root: نور (N-W-R)\n  * Lisan / Ayn: Light as that which renders visible; the root also yields \"beacon\" (manār) — a landmark set upon a path for guidance.\n  * Al-Raghib (Mufradat): \"Light is the diffused radiance that aids vision\" — of two kinds: the sensory (perceived by the eye) and the intellectual (perceived by the inner eye of insight), the latter being \"the light of the intellect and the light of the Qur'an.\"\n  * Al-Zamakhshari (Asas): Metaphorical (majāz): \"The matter became luminous (nāra)\" = \"it became clear.\" Light is thus the very clarity of knowledge that guides the knower through the darkness of ignorance.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd) — governing the use of \"إنما\" (innamā) to restrict perfection exclusively to knowledge of God, and the conditional-connective structure (fa-innahu, fa-kullamā) that links degrees of knowledge to degrees of proximity.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Status and Ostentation'", "badge": "Insight"}, {"arabic": "أبي بن كعب رضي الله عنه معناه مثل نور المؤمن وقلبه وقوله تعالى أو كظلمات في بحر لجى مثل قلب المنافق وقال زيد بن أسلم في قوله تعالى في لوح محفوظ وهو قلب المؤمن وقال سهل مثل القلب والصدر مثل العرش والكرسي فهذه أمثلة القلب", "english": "Know that just as the rational person does not know the necessary sciences (al-ʿulūm al-ḍarūriyyah) nor what distinguishes the state of the rational one from what he has acquired of the theoretical sciences, so too does the rational person not know what Allah has opened for His friends (awliyāʾ) and His prophets of the prerogatives of His gentleness (luṭf) and mercy. Whatever mercy Allah opens to people, none can withhold it. This mercy is dispensed by the decree of bounty and generosity from Allah, Glorified and Exalted, not grudged to anyone. But it only appears in hearts that expose themselves to the wafts of the mercy of Allah, Exalted — as he, peace and blessings be upon him, said: \"Indeed, your Lord has, in the days of your time, wafts of mercy — so expose yourselves to them.\" (1) Hadith: Allah, Mighty and Majestic, says: \"Long has been the yearning of the righteous for My meeting\" — the hadith. I found no source for it except that the author of al-Firdaws transmitted it from the hadith of Abū al-Dardāʾ, and his son did not mention for it in the Musnad of al-Firdaws an isnād.", "book_title": "Disciplining the Soul", "section_title_ar": "Section 579", "section_title_en": "The Revival of the Religious Sciences — Section 579: The Human's Distinguishing Property is Knowledge and Wisdom; The Heart as the Seat of the King", "section_index": 579, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: Core meaning of turning over, revolving, and transformation from one state to another; the heart as that which is constantly turning and fluctuating.\n  * Al-Raghib (Mufradat): The heart (qalb) is so named for its constant turning (taqallub) between states; it is the seat of perception and understanding, the faculty by which one grasps realities.\n  * Al-Zamakhshari (Asas): Literal: turning a thing over. Metaphorical: the heart as the seat of understanding and the center of the human kingdom, that which governs and directs the faculties.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge, perception, and certainty; the mark or trace by which a thing is known.\n  * Al-Raghib (Mufradat): Knowledge is the apprehension of a thing as it truly is; it is the distinguishing property of the human being and the purpose of his creation.\n  * Al-Zamakhshari (Asas): Literal: knowing. Metaphorical: the light by which the heart perceives realities, the noblest of which is knowledge of God.\n- Root: ملك (m-l-k)\n  * Lisan / Ayn: Possession, sovereignty, and dominion; a king who rules over a domain.\n  * Al-Raghib (Mufradat): The king is one who possesses authority and commands; the heart is the king of the human body, ruling over its faculties.\n  * Al-Zamakhshari (Asas): Literal: a king. Metaphorical: the heart as the sovereign of the human kingdom, with the faculties as its subjects, messengers, and servants.\n- Sibawayh Rule: باب التشبيه والتمثيل (The Chapter of Simile and Analogy) — The use of extended analogies (tamthīl) to clarify abstract realities through concrete images, where the comparison is drawn between the relations of parts, not merely individual attributes.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "بحر لجى يغشاه موج من فوقه موج من فوقه سحاب ظلمات بعضها فوق بعض إذا أخرج يده لم يكد يراها ومن لم يجعل الله له نورا فما له من نور} فالأكياس هم الذين أراد الله أن يهديهم فشرح صدورهم للإسلام والهدى والمغترون هم الذين أراد الله أن يضلهم فجعل صدرهم ضيقا حرجا كأنما يصعد في السماء والمغرور هو الذي لم تنفتح بصيرته ليكون بهداية نفسه كفيلا وبقي في العمى فاتخذ الهوى قائدا والشيطان دليلا {ومن كان في هذه أعمى فهو في الآخرة أعمى وأضل سبيلا} وإذا عرف أن الغرور 2 هو أم الشقاوات ومنبع المهلكات فلا بد من شرح مداخله ومجاريه وتفصيل ما يكثر من وقوع الغرور فيه ليحذره المريد بعد م", "english": "Thus the shrewd ones (akyās) and the possessors of inner sight (arbāb al-baṣā'ir) — their hearts are like a niche (mishkāh) in which is a lamp (miṣbāḥ), the lamp in a glass, the glass as though it were a pearly star, kindled from a blessed olive tree, neither of the east nor of the west, whose oil would almost glow even if no fire touched it — light upon light (nūrun 'alā nūr). But the self-deceived (maghrūrūn) — their hearts are {«كَظُلُمَاتٍ فِي بَحْرٍ لُجِّيٍّ يَغْشَاهُ مَوْجٌ مِنْ فَوْقِهِ مَوْجٌ مِنْ فَوْقِهِ سَحَابٌ ظُلُمَاتٌ بَعْضُهَا فَوْقَ بَعْضٍ إِذَا أَخْرَجَ يَدَهُ لَمْ يَكَدْ يَرَاهَا وَمَنْ لَمْ يَجْعَلِ اللَّهُ لَهُ نُورًا فَمَا لَهُ مِنْ نُورٍ»} (Q. 24:40) — like darknesses in a vast deep sea, covered by a wave, above which is another wave, above which is a cloud — darknesses, one above another; when he stretches out his hand, he can scarcely see it. And he to whom God grants no light, for him there is no light.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 883", "section_title_en": "The Book of Censure of Self-Deception (Kitāb Dhamm al-Ghurūr) — Book Ten of the Quarter of the Destroyers from The Revival of the Religious Sciences", "section_index": 883, "anchors": "- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Core sense of an overlooked flaw, a heedless state, or a deceptive glitter; the \"white blaze\" on a horse's forehead that draws the eye but conceals the animal's true nature.\n  * Al-Raghib (Mufradat): \"Ghurūr\" is a heedlessness (ghaflah) in wakefulness, rooted in the pursuit of a perceived gain (ghurrah) that is in fact a loss; it is the state of being deluded by the apparent good while the inner reality is ruinous, as in {«مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ»} (Q. 82:6).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): to approach someone off-guard (ghirrah). Metaphorical (majāz): the \"white-blazed day\" (yawm agharr) of intense heat — a dazzling surface that misleads; the deluded man is like a gazelle that grazes in moonlight, deceived into thinking it is daylight, until the predator seizes it.\n- Root: نور (n-w-r)\n  * Lisan / Ayn: Light that renders things visible; the first thing created by God to dispel darkness.\n  * Al-Raghib (Mufradat): Two kinds: sensory light (perceived by the eye) and intellectual/divine light (perceived by the inner eye of insight, baṣīrah) — the latter being the light of reason and of the Qur'an, as in {«قَدْ جَاءَكُمْ مِنَ اللَّهِ نُورٌ وَكِتَابٌ مُبِينٌ»} (Q. 5:15).\n  * Al-Zamakhshari (Asas): Literal: illumination of a lamp or fire. Metaphorical: clarification and manifestation — \"nawwara al-amr\" (he made the matter clear); the light of guidance is that which makes the path of salvation evident to the heart.\n- Root: صدر (ṣ-d-r)\n  * Lisan / Ayn: The chest, the seat of the heart; also the \"foremost\" part of anything.\n  * Al-Raghib (Mufradat): Literally the bodily chest; metaphorically extended to the \"front\" of a thing (ṣadr al-majlis, the head of the assembly). When used of the heart's expansion (sharḥ al-ṣadr), it denotes the spiritual opening of the breast to receive divine light and guidance, as in {«رَبِّ اشْرَحْ لِي صَدْرِي»} (Q. 20:25).\n  * Al-Zamakhshari (Asas): Literal: to return from water (ṣadara). Metaphorical: the beginning or origin of an affair — \"akhadha al-amra bi-ṣadrihi\" (he took the matter from its very outset); the \"sources and returns\" (mawārid wa maṣādir) of all things.\n- Root: ربع (r-b-')\n  * Lisan / Ayn: Four; the fourth part; a place of dwelling and spring pasturage.\n  * Al-Raghib (Mufradat): The root of \"four\" and its derivatives; used for the four categories or classes into which a thing is divided.\n  * Al-Zamakhshari (Asas): Literal: to dwell (raba'a bi-l-makān). Metaphorical: to raise and restore (rabba'ahu Allāh — God raised him up); here, the \"Quarter of the Destroyers\" (rub' al-muhlikāt) is the fourth part of the Iḥyā' devoted to the vices that ruin the soul.\n- Sibawayh Rule: Interposition of the Prepositional Phrase (bāb al-faṣl bayna al-jār wa al-majrūr) — The periodic sentence structure in the opening doxology (\"الحمد لله الذي بيده مقاليد الأمور\") places the prepositional phrase \"bi-yadihi\" (in His hand) before its governing noun to achieve rhetorical emphasis (takhṣīṣ) and to signal the theological priority of divine agency over all affairs.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Delusion'", "badge": "Insight"}], "41": [{"arabic": "وهو أحد والآصال التي ذكرها الله تعالى إذ قال ولله يسجد من في السموات والأرض طوعا وكرها وظلالهم بالغدو والآصال وإذا سجد لله عز وجل الجمادات فكيف يجوز أن يغفل العبد العاقل عن أنواع العبادات الورد السادس إذا دخل وقت العصر دخل وقت الورد السادس وهو الذي أقسم الله تعالى به فقال تعالى {والعصر} هذا أحد معنيي الآية وهو المراد بالآصال في أحد التفسيرين وهو العشي المذكور في قوله {وعشيا} وفي قوله {بالعشي والإشراق} وليس في هذا الورد صلاة إلا أربع ركعات بين الأذان والإقامة كما سبق في الظهر ثم يصلي الفرض ويشتغل بالأقسام الأربعة المذكورة", "english": "I say: And just as knowledge and remembrance are the nourishment of the heart, which can never be cut off from it, so too the measure of moderation is this; and deficiency from it may lead to the disturbance of the body — except for one who accustoms himself to wakefulness gradually, for he may train himself upon it without disturbance. And this litany (wird) is among the longest of the litanies and the most delightful for the worshippers, and it is one of the \"evenings and mornings\" (al-āṣāl) which God Most High mentioned when He said: {«ولله يسجد من في السموات والأرض طوعا وكرها وظلالهم بالغدو والآصال»} \"And to God prostrates whoever is in the heavens and the earth, willingly or unwillingly, and their shadows, in the mornings and the evenings\" (Q. 13:15). And when inanimate objects prostrate to God, Mighty and Majestic, how then can the intelligent servant be heedless of the varieties of worship?", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 261", "section_title_en": "The Seventh Daily Litany (Al-Wird al-Sābiʿ): The Time of Sunset — The Completion of the Day's Litanies and Self-Accounting", "section_index": 261, "anchors": "- Root: ورد (warada)\n  * Lisan / Ayn: The root denotes arriving at water, seeking it, and drinking from it; also the portion or share of water allotted for drinking at a specific time.\n  * Al-Raghib (Mufradat): \"الورود أصله: قصد الماء\" — the core meaning is the intentional approach to water; the litany (wird) is the appointed portion of devotional recitation, likened to the daily share of water that a person must take to sustain life.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): the act of arriving at water. Metaphorical (Majaz): \"ورد علي كتاب سرني مورده\" — a book arrived upon me whose arrival pleased me; likewise, the wird is the arrival of the appointed time for worship, and the soul's approach to the fountain of divine remembrance.\n- Root: عصر (ʿaṣr)\n  * Lisan / Ayn: The root denotes pressing, squeezing, and extracting; also the time of afternoon, so called because it is the pressing of the day's end.\n  * Al-Raghib (Mufradat): The ʿaṣr is the latter part of the day; God swore by it in {«والعصر»} (Q. 103:1), indicating its great merit.\n  * Al-Zamakhshari (Asas): Literal: the afternoon time. Metaphorical: the pressing of one's life — as the day is pressed at its end, so the life of man is pressed at its term.\n- Root: غرب (gharaba)\n  * Lisan / Ayn: The root denotes disappearance, absence, and setting; the sun's setting (ghurūb) is its concealment from the eye.\n  * Al-Raghib (Mufradat): The setting of the sun marks the boundary between the day's works and the night's; it is the terminus of the visible world's diurnal cycle.\n  * Al-Zamakhshari (Asas): Literal: the sun's descent below the horizon. Metaphorical: the setting of the sun of life — the death of man, after which there is no rising.\n- Root: حاسب (ḥāsaba)\n  * Lisan / Ayn: The root denotes reckoning, counting, and taking account; muḥāsabah is the mutual reckoning between two parties.\n  * Al-Raghib (Mufradat): Self-accounting (muḥāsabat al-nafs) is the soul's reckoning with itself over its deeds before the Day of Reckoning, for \"one who reckons himself before he is reckoned\" is among the wise.\n  * Al-Zamakhshari (Asas): Literal: the arithmetic counting of sums. Metaphorical: the soul's audit of its own works, weighing the day's deeds against the standard of the Sacred Law.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of the prepositional phrase from its governing verb, as in the construction \"فسبحان الله حين تمسون\" where the adverbial clause is interposed to emphasize the temporal specification of the act of glorification.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Remembrance of Death and Afterlife'", "badge": "Dhikr"}], "44": [{"arabic": "لما رأيت ابني يتعثر لم أملك نفسي أن أخذته ففي ذلك عبرة لأولي الأبصار فالرجل كل الرجل من يصبر على العافية ومعنى الصبر عليها أن لا يركن إليها ويعلم أن كل ذلك مستودع عنده وعسى أن يسترجع على القرب وأن لا يرسل نفسه في الفرح بها ولا ينهمك في التنعم واللذة واللهو واللعب وأن يرعى حقوق الله في ماله بالإنفاق وفي بدنه ببذل المعونة للخلق وفي لسانه ببذل الصدق وكذلك في سائر ما أنعم الله به عليه وهذا الصبر متصل بالشكر فلا يتم إلا بالقيام بحق الشكر كما سيأتي وإنما كان الصبر على السراء أشد لأنه مقرون بالقدرة ومن العص", "english": "The first kind is that which accords with caprice (al-hawā) — namely, sound health and well-being, wealth and status, the abundance of kinsfolk, the expanse of means, the multitude of followers and helpers, and all the pleasures of this world. How greatly the servant stands in need of patience over these very things! For if he does not restrain his soul (nafsahu) from letting loose toward them, from reposing in them, and from plunging into their permissible pleasures, that drives him to insolence (al-baṭar) and transgression (al-ṭughyān) — for indeed {verily man doth transgress when he sees himself self-sufficient} {«إن الإنسان ليطغى أن رآه استغنى»}. Hence one of the knowers of God (al-ʿārifīn) said: \"Affliction — the believer can bear it; but well-being — none bears it save the veracious (al-ṣiddīq).\" And Sahl said: \"Patience over well-being is more severe than patience over affliction.\" When the doors of this world were opened upon the Companions — may God be well pleased with them — they said: \"We were tried with the trial of adversity (fitnat al-ḍarrāʾ) and we bore it patiently; and we were tried with the trial of prosperity (fitnat al-sarrāʾ) and we did not bear it patiently.\" For this reason God — mighty and majestic — warned His servants against the trial of wealth, spouse, and child, saying — exalted is He: {O you who believe! Let not your wealth nor your children divert you from the remembrance of God} {«يا أيها الذين آمنوا لا تلهكم أموالكم ولا أولادكم عن ذكر الله»}. And He said — mighty and majestic: {Indeed, among your spouses and your children there is an enemy unto you, so beware of them} {«إن من أزواجكم وأولادكم عدوا لكم فاحذروهم»}. And the Prophet — peace be upon him — said: \"The child is a cause of miserliness (mubakhkhilah), a cause of cowardice (mujabinah), a cause of grief (muḥzinah).\" When he — peace be upon him — looked upon his son al-Ḥasan — may God be well pleased with him — stumbling in his shirt, he descended from the pulpit and embraced him, then said: {God has spoken truly} {«صدق الله»} — {Indeed, your wealth and your children are a trial} {«إنما أموالكم وأولادكم فتنة»} — \"When I saw my son stumbling, I could not control myself (lam amlik nafsī) from taking him up.\" In that is a lesson for those of insight. So the man — the complete man — is he who bears patience over well-being. And the meaning of patience over it is that he does not repose in it, and knows that all of it is but a trust (mustawdaʿ) deposited with him, that it may well be reclaimed at any near moment; and that he does not release his soul to rejoice in it, nor plunge into comfort, pleasure, play, and amusement; and that he observes the rights of God in his wealth by spending, in his body by expending aid to creation, in his tongue by expending truthfulness (al-ṣidq) — and likewise in all the rest of what God has bestowed upon him.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 963", "section_title_en": "On Patience in Prosperity and Adversity — Section 963", "section_index": 963, "anchors": "- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning of restraint and holding back; al-Farahidi notes \"صبر على قليه\" (endurance upon hardship).\n  * Al-Raghib (Mufradat): \"الصبر: الإمساك في ضيق... حبس النفس على ما يقتضيه العقل والشرع، أو عما يقتضيان حبسها عنه\" — Patience is the soul's restraint upon what reason and Law require, or from what they require restraining it; its names vary by context (shajāʿah in battle, etc.).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صبرت على ما أكره. وصبرت عما أحب\" — patience over the disliked and patience away from the beloved. Metaphorical (majāz): \"هو أصبر على الضرب من الأرض\" — extreme endurance likened to earth's impassivity.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that which one guards and restrains.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" and in divine attribution, \"نفسه: ذاته\" — the self as the locus of volition and desire.\n  * Al-Zamakhshari (Asas): Literal: \"نفس\" as the animate self; metaphorical: \"دفق نفسه أي دمه\" — extended to blood/life.\n- Root: ولد (w-l-d)\n  * Lisan / Ayn: Offspring, child; al-Farahidi notes singular/plural usage.\n  * Al-Raghib (Mufradat): \"الولد: المولود. يقال للواحد والجمع والصغير والكبير\" — child, born one, applied to one or many, young or old.\n  * Al-Zamakhshari (Asas): Literal: biological progeny; metaphorical (majāz): \"ولدوا حديثا وكلاما: استحدثوه\" — newly invented speech; here, children as a trial.\n- Root: صدق (ṣ-d-q)\n  * Lisan / Ayn: Truthfulness; al-Farahidi links it to earnestness in word and deed.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول\" — truth and falsehood originate in speech, but extend to action and intention.\n  * Al-Zamakhshari (Asas): Literal: truthful speech; metaphorical: \"رجل صادق الحملة\" — one whose charge in battle is true/earnest.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما\" restricts the predicate exclusively to the subject, as in the prophetic citation {إنما أموالكم وأولادكم فتنة}, affirming trial as the sole designated function of wealth and children.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "48": [{"arabic": "والذين يكثرون البغضاء لإخوانهم في صدورهم فإذا لقوهم تملقوا لهم والذين إذا دعوا إلى الله ورسوله كانوا بطاء وإذا دعوا إلى الشيطان وأمره كانوا سراعا (3) وقال ابن مسعود لا يكونن أحدكم إمعة قالوا وما الإمعة قال الذي يجري مع كل ريح واتفقوا على أن ملاقاة الاثنين بوجهين نفاق وللنفاق علامات كثيرة وهذه من جملتها وقد روي أن رجلا من أصحاب رسول الله صلى الله عليه وسلم مات فلم يصل عليه حذيفة فقال له عمر يموت رجل من أصحاب رسول الله صلى الله عليه وسلم ولم تصل عليه فقال يا أمير المؤمنين إنه منهم فقال نشدتك الله أنا منهم أم لا قال اللهم لا ولا أؤمن منها", "english": "ʿAmmār ibn Yāsir said: The Messenger of God, peace and blessings be upon him, said: \"Whoever has two faces in this world shall have two tongues of fire on the Day of Resurrection.\" {«من كان له وجهان في الدنيا كان له لسانان من نار يوم القيامة»} (1)", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 695", "section_title_en": "On the Two-Tongued Man (Dhū Lisānayn): The Marks of Hypocrisy in Dealing with Opposing Parties", "section_index": 695, "anchors": "- Root: لسن (L-S-N)\n  * Lisan / Ayn: The tongue (al-lisān); by extension, speech, language, and mode of expression. \"Dhū lisānayn\" (possessor of two tongues) is a metaphorical construction denoting one who speaks differently to different parties.\n  * Al-Raghib (Mufradat): Speech is the instrument of disclosure (kashf) of what lies in the heart. Two tongues signify a duplicity of inward disposition manifesting as contradictory outward utterances — a rupture between the inner reality (sirr) and outward expression.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): the physical tongue. Metaphorical (majāz): \"dhū lisānayn\" as one who flatters each faction with agreeable speech, regardless of truth — the rhetorical figure of metonymy where the instrument of speech stands for the moral character of the speaker.\n- Root: وجه (W-J-H)\n  * Lisan / Ayn: The face; front; aspect; direction. \"Dhū wajhayn\" (possessor of two faces) — one who presents a different countenance to each party.\n  * Al-Raghib (Mufradat): The face is the locus of human dignity and the mirror of inner states. Two faces signify a分裂 of the self between outward display and inward reality — a form of spiritual duplicity.\n  * Al-Zamakhshari (Asas): Literal: the physical face. Metaphorical: \"coming to these with a face and to those with a face\" — i.e., showing amity and honor to each while harboring enmity or contempt — a majāz for hypocrisy (nifāq).\n- Root: وفق (W-F-Q)\n  * Lisan / Ayn: To agree, to be suitable, to conform. \"Yuwāfiq\" — he speaks in a manner that accords with the listener's disposition.\n  * Al-Raghib (Mufradat): True agreement (tawfīq) is from God and aligns with truth; false agreement is mere accommodation to passion and self-interest.\n  * Al-Zamakhshari (Asas): Literal: concordance. Metaphorical: the hypocrite's \"agreement\" is a simulation of concord while the heart is estranged — a majāz for flattery (mudāhanah).\n- Sibawayh Rule: Rule of Predication with Dual Subjects (Bāb al-ʿAṭf ʿalā al-Mubtadaʾ) — The construction \"man kāna lahu wajhān... kāna lahu lisānān\" employs a conditional-relative clause where the apodosis mirrors the protasis in grammatical form, emphasizing the moral correspondence between outward duplicity and its eschatological recompense.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Anger and Hatred'", "badge": "Afterlife"}], "52": [{"arabic": "وخطب رجل عند رسول الله صلى الله عليه وسلم فقال من يطع الله ورسوله فقد رشد ومن يعصهما فقد غوى فقال قل ومن يعص الله ورسوله فقد غوى (2) فكره رسول الله صلى الله عليه وسلم قوله ومن يعصهما لأنه تسوية وجمع وكان إبراهيم يكره أن يقول الرجل أعوذ بالله وبك ويجوز أن يقول أعوذ بالله ثم بك وأن يقول لولا الله ثم فلان ولا يقول لولا الله وفلان وكره بعضهم أن يقال اللهم أعتقنا من النار وكان يقول العتق يكون بعد الورود وكانوا يستجيرون من النار ويتعوذون من النار وقال رجل اللهم اجعلني ممن تصيبه شفاعة محمد صلى الله عليه وسلم فق", "english": "An example of this is what Ḥudhayfah reported: The Prophet, peace be upon him, said: \"Let none of you say: 'What Allah willed and you willed' — but rather let him say: 'What Allah willed, then you willed.'\" (5) This is because in the absolute conjunction [with \"and\"] there is an association and an equalization, which is contrary to [the due measure of] reverence. And Ibn ʿAbbās, may Allah be pleased with them both, said: A man came to the Messenger of Allah, peace be upon him, speaking to him concerning some matter, and he said: \"What Allah willed and you willed.\" The Prophet, peace be upon him, said: \"Have you made me an equal to Allah? Rather, [say]: 'What Allah willed alone.'\" (1)", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 698", "section_title_en": "The Revival of the Religious Sciences — Section 698: The Nineteenth Affliction — Heedlessness Regarding Subtle Errors in the Import of Speech", "section_index": 698, "anchors": "- Root: غفل (ghafla)\n  * Lisan / Ayn: Core meaning of heedlessness, neglect, and inattention; the absence of vigilance over a matter.\n  * Al-Raghib (Mufradat): Heedlessness (al-ghafla) is the soul's failure to attend to what it is obligated to know or consider; it is the opposite of mindfulness (al-tayaqquẓ) and remembrance (al-dhikr).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes the absence of guarding; metaphorical (majāz) usage extends to the tongue's straying from precise expression in sacred matters.\n- Root: عطف (ʿaṭf)\n  * Lisan / Ayn: Inclination, turning, or joining one thing to another; grammatically, the conjunction that links two items in a shared ruling.\n  * Al-Raghib (Mufradat): Joining (al-ʿaṭf) implies equal treatment of the conjoined items; in theological speech, absolute conjunction (al-ʿaṭf al-muṭlaq) with Allah entails an inadmissible association.\n  * Al-Zamakhshari (Asas): Literal: the bending of a staff or the inclining of a branch; metaphorical: the grammatical coupling that levels two referents under one predicate.\n- Root: شرك (shirk)\n  * Lisan / Ayn: Sharing, partnership, or association; the root of polytheism (al-shirk) as the ascription of a partner to Allah.\n  * Al-Raghib (Mufradat): Association (al-shirk) is the equalization of two things in a shared ruling; in theology, it is the gravest form when applied to the Divine, whether in belief or in the mere wording of speech.\n  * Al-Zamakhshari (Asas): Literal: co-participation in ownership; metaphorical: any verbal or creedal equalization of the creature with the Creator.\n- Sibawayh Rule: Rule of Conjunction (al-ʿaṭf) and Restriction (al-ḥaṣr) — The particle \"thumma\" (then) indicates sequential ordering and distinction of rank, whereas \"wa\" (and) denotes absolute conjunction and mutual equivalence; thus the Prophet's command to replace \"wa\" with \"thumma\" in \"what Allah willed and you willed\" is a syntactic correction to abolish the implication of equal partnership.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Condemnation of Anger and Hatred'", "badge": "Du'a"}], "56": [{"arabic": "الصلاة التي هي أعلى الأعلام فقال تعالى {وأقيموا الصلاة وآتوا الزكاة} وقال صلى الله عليه وسلم بني الإسلام على خمس شهادة أن لا إله إلا الله وأن محمدا عبده ورسوله وإقام الصلاة وإيتاء الزكاة (2) وشدد الوعيد على المقصرين فيها فقال {والذين يكنزون الذهب والفضة ولا ينفقونها في سبيل الله فبشرهم بعذاب أليم} ومعنى الإنفاق في سبيل الله إخراج حق الزكاة قال الأحنف بن قيس كنت في نفر من قريش فمر أبو ذر فقال بشر الكانزين بكي في ظهورهم يخرج من جنوبهم وبكي في أقفائهم يخرج من جباههم وفي رواية أنه يوضع على حلمة ثدي أحده", "english": "To proceed: God Most High made alms (al-zakāh) one of the pillars of Islam, and joined its mention with prayer (al-ṣalāh), which is the loftiest of symbols. He said Most High: {«وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ»} — \"And establish prayer and give alms.\" And he, peace and blessings be upon him, said: \"Islam is built upon five: the testimony that there is no god but God and that Muhammad is His servant and Messenger, the establishment of prayer, and the giving of alms.\" And He intensified the threat against those who fall short in it, saying: {«وَالَّذِينَ يَكْنِزُونَ الذَّهَبَ وَالْفِضَّةَ وَلَا يُنفِقُونَهَا فِي سَبِيلِ اللَّهِ فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ»} — \"And those who hoard gold and silver and do not spend them in the way of God — give them tidings of a painful chastisement.\" And the meaning of \"spending in the way of God\" is the payment of the due right of alms (zakāh).", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 167", "section_title_en": "The Book of the Secrets of Alms (Zakat) — Section 167", "section_index": 167, "anchors": "- Root: زكا (Z-K-Y)\n  * Lisan / Ayn: \"Zakā al-zar'u yazkū zakā'an: it increased and grew.\" Core meaning: growth, increase, purification.\n  * Al-Raghib (Mufradat): \"The origin of zakāh is the growth that occurs through the blessing of God Most High... and from it is zakāh: what a person pays of God's right to the poor, so named for the hope of blessing in it, or for the purification (tazkiyah) of the soul, i.e., its growth.\"\n  * Al-Zamakhshari (Asas): Literal (haqīqah): growth and increase. Metaphorical (majāz): the purification of wealth through payment of the obligatory due.\n- Root: نعم (N-'-M)\n  * Lisan / Ayn: \"Na'ima 'ayshuhu: his life was pleasant.\" Core meaning: bounty, well-being, grace.\n  * Al-Raghib (Mufradat): \"Al-Ni'mah: the good state... and al-Ni'mah (with kasrah) is used for the genus, said of both little and much.\"\n  * Al-Zamakhshari (Asas): Literal: \"Jallat ni'mat Allāh wa na'mā'uh\" — God's grace and bounty are immense. Metaphorical: \"Khāfat na'āmatuhum\" — their ostriches departed (i.e., they fled), showing the root's extended usage.\n- Root: ظهر (Z-H-R)\n  * Lisan / Ayn: \"Zahara: to become apparent, to be victorious.\" Core meaning: back, outward appearance, manifestation.\n  * Al-Raghib (Mufradat): \"Al-Zahr: the back (body part)... and it is used metaphorically for the surface of the earth.\"\n  * Al-Zamakhshari (Asas): Literal: \"Rajul muzhir: a man strong of back.\" Metaphorical: \"Qalabtu al-amra zahrān li-baṭn\" — I turned the matter over back and belly (examined it thoroughly).\n- Root: سرر (S-R-R)\n  * Lisan / Ayn: \"Sarra: to conceal, to keep secret.\" Core meaning: secret, inner self, joy.\n  * Al-Raghib (Mufradat): \"Al-Isrār: the opposite of al-i'lān (declaring)... and al-sirr is the speech concealed in the soul.\"\n  * Al-Zamakhshari (Asas): Literal: \"Asarra al-ḥadīth: he concealed the speech.\" Metaphorical: \"Aṭaytuka sirrah: I gave you its choicest part (the secret/core of something).\"\n- Sibawayh Rule: Bāb al-faṣl bayna al-jār wa al-majrūr (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening clause is complete in itself, as in \"fa'āfa 'alayhim min ni'matihi mā...\" where the prepositional phrase is completed after an intervening relative clause.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Zakat'", "badge": "Du'a"}], "58": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}, {"arabic": "ويحكى عن يحيى بن معاذ أنه رأى أبا يزيد في بعض مشاهداته من بعد صلاة العشاء إلى طلوع الفجر مستوفزا على صدور قدميه رافعا أخمصيه مع عقبيه عن الأرض ضاربا بذقنه على صدره شاخصا بعينيه لايطرف قال ثم سجد عند السحر فأطاله ثم قعد فقال اللهم إن قوما طلبوك فأعطيتهم الشىء على الماء والمشي في الهواء فرضوا بذلك وإني أعوذ بك من ذلك وإن قوما طلبوك فأعطيتهم طى الأرض فرضوا بذل وإني أعوذ بك من ذلك وإن قوما طلبوك فأعطيتهم كنوز الأرض فرضوا بذلك وإني أعوذ بك من ذلك حتى عد نيفا وعشرين مقاما من كرامات الأولياء ثم التفت فرآني فقال يحيى قلت نعم", "english": "And it was said to Abu Yazid al-Bistami, may God have mercy on him, on one occasion: \"Tell us of your witnessing (mushāhadah) of God, the Exalted.\" So he cried out, then said: \"Woe to you! It is not fitting for you to know that.\" It was said: \"Then tell us of your severest struggle against your own soul (nafs) for God, the Exalted.\" He said: \"This also — it is not permissible for me to disclose it to you.\" It was said: \"Then tell us of the discipline (riyāḍah) of your soul in your beginning.\" He said: \"Yes. I called my soul to God, and it bolted against me (jamahat). So I imposed a firm resolve ('azm) upon it that I would not drink water for a year, nor taste sleep for a year, and it fulfilled that for me.\"", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1200", "section_title_en": "The Wonders of the Saints: On the States of Abu Yazid al-Bistami and Others — Section 1200", "section_index": 1200, "anchors": "- Root: شهد (shahida)\n  * Lisan / Ayn: To witness, to be present, to testify to what one has seen.\n  * Al-Raghib (Mufradat): In the mystical context, 'mushāhadah' denotes direct, unmediated witnessing of divine realities by the heart, distinct from mere knowledge ('ilm').\n  * Al-Zamakhshari (Asas): Literal: physical sight. Metaphorical: the soul's direct apprehension of spiritual truths, as in 'shahida 'alā nafsihi' (he bore witness against himself).\n- Root: جمح (jamaha)\n  * Lisan / Ayn: To be headstrong, to refuse the rein, to bolt (of a horse); obstinate rebellion.\n  * Al-Raghib (Mufradat): Used of the lower soul (nafs) when it refuses obedience and charges headlong into disobedience.\n  * Al-Zamakhshari (Asas): Literal: a horse that throws its rider and runs wild. Metaphorical: the unruliness of the carnal self against the divine command.\n- Root: عزم ('azama)\n  * Lisan / Ayn: To resolve firmly, to intend with determination; the knot of a thing made firm.\n  * Al-Raghib (Mufradat): Firm resolution ('azm) is the binding of the heart to a course of action for God, severing hesitation.\n  * Al-Zamakhshari (Asas): Literal: to tie a knot tightly. Metaphorical: the soul's solemn covenant with God, as in 'azm al-'azā'im (firm resolves).\n- Root: عاذ ('ādha)\n  * Lisan / Ayn: To seek refuge, to cling to a protector for safety.\n  * Al-Raghib (Mufradat): 'Isti'ādhah' is seeking protection from a feared evil by clinging to one who can repel it; here, seeking refuge in God from being deluded by lesser gifts.\n  * Al-Zamakhshari (Asas): Literal: seeking shelter in a fortress. Metaphorical: the soul's flight to God from the distractions of miraculous favors (karāmāt).\n- Root: صعق (ṣa'iqa)\n  * Lisan / Ayn: To be thunderstruck, to lose consciousness, to fall down dead from a shock.\n  * Al-Raghib (Al-Mufradat): 'Ṣā'iqa' is the overwhelming blast that seizes one; in the spiritual path, it denotes being overcome by a vision that the heart cannot bear.\n  * Al-Zamakhshari (Asas): Literal: the thunderbolt that kills. Metaphorical: the sudden unveiling of a hidden secret that shatters the unprepared soul.\n- Sibawayh Rule: Rule of Interposition (al-Faṣl bayna al-Jār wa al-Majrūr) — The narrative employs periodic suspensions where the subject's state is described before the predicate completes, as in \"فصاح بي صيحة وقال\" (he cried out to me with a cry and said), where the circumstantial clause (ḥāl) interposes to convey the intensity of the moment.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Love, Longing, Intimacy and Contentment'", "badge": "Du'a"}], "61": [{"arabic": "قال الله تعالى {أو صديقكم} وقال {أو ما ملكتم مفاتحه} إذ كان الأخ يدفع مفاتيح بيته إلى أخيه ويفوض له التصرف كما يريد وكان أخوه يتحرج عن الأكل بحكم التقوى حتى أنزل الله تعالى هذه الآية وأذن لهم في الانبساط في طعام الإخوان والأصدقاء", "english": "The Messenger of God, may God bless him and grant him peace, said: \"The likeness of two brothers is like the likeness of two hands — one washes the other.\" {«مثل الأخوين مثل اليدين تغسل إحداهما الأخرى»}", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 417", "section_title_en": "Section 417", "section_index": 417, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "62": [{"arabic": "فقد قال الله تعالى إنما المؤمنون الذين آمنوا بالله ورسوله ثم لم يرتابوا وجاهدوا بأموالهم وأنفسهم في سبيل الله أولئك هم الصادقون {فيكون}", "english": "If you say: \"What is the meaning of the Salaf's statement, 'I am a believer, if God wills' — given that the exception (istithnā') implies doubt, and doubt in faith is unbelief? Yet they all refrained from giving an unqualified answer affirming faith and were cautious about it.\"", "book_title": "Fear and Hope", "section_title_ar": "Section 102", "section_title_en": "On the Meaning of the Salaf's Statement \"I am a Believer, If God Wills\" — Section 102", "section_index": 102, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which is breathed; the innermost reality of a person.\n  * Al-Raghib (Mufradat): النفس is used for the rūḥ (spirit), for the dhāt (essence/self), and for the seat of intention and knowledge. When one says \"he knows in himself (nafsihi) that he is a believer,\" it denotes certitude residing in the very core of one's being, not a corporeal faculty.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the soul's reflexive self-awareness; metaphorical (majāz) usage extends to \"blood\" (dam) or \"the eye\" (ʿayn) of envy. Here, \"in himself\" (fī nafsihi) is literal self-knowledge, not mere outward profession.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: Face, countenance; the foremost part; a mode, aspect, or direction.\n  * Al-Raghib (Mufradat): The face is the most noble apparent part of a thing; hence it is used for the \"aspect\" or \"manner\" (wajh) of an affair. \"Four aspects\" (wujūh) means four distinct modes of interpretation or rational grounds.\n  * Al-Zamakhshari (Asas): Literal: the face of a person or object. Metaphorical: \"the face of the matter\" (wajh al-amr) — its most salient and honorable dimension. Here, the \"aspects\" are hermeneutical angles, not physical parts.\n- Root: ايم (a-y-m)\n  * Al-Raghib (Mufradat): The unmarried state (aym); one who has no spouse. Not applicable here directly, but the root's semantic field of \"being alone/without attachment\" contrasts with īmān's root (a-m-n) — security and trust — which is the operative term in this text.\n  * Al-Zamakhshari (Asas): Not directly relevant; the operative root is أمن (a-m-n), meaning security from fear, and by extension, faith (īmān) as the state of being secure in God's truth.\n- Root: كان (k-w-n)\n  * Lisan / Ayn: To be, to exist; the copula of predication.\n  * Al-Raghib (Mufradat): Kāna denotes existence and becoming; in theological usage, it grounds the distinction between what is (mawjūd) and what is merely asserted. The question \"Are you a believer?\" (a-mu'min anta?) uses kāna implicitly to ask about actual, present state — not future contingency.\n  * Al-Zamakhshari (Asas): Literal: existence. Metaphorical: the \"being-so\" of a predicate. The istithnā' (exception) with \"in shā' Allāh\" suspends the copula's certainty, shifting from assertive existence to contingent hope.\n- Sibawayh Rule: باب الاستثناء والتعليق بالمشيئة (The Chapter of Exception and Suspension by the Divine Will) — When an exception clause (istithnā') follows a positive assertion, it grammatically suspends the universality or certainty of the predication. In theological discourse, this suspension may be semantic (doubt) or pragmatic (deference, etiquette, or self-deprecation), and Sibawayh's parsing of conditional suspension (taʿlīq) shows that the apodosis need not be negated — only its absolute, unqualified force is tempered.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'", "badge": "Insight"}], "64": [{"arabic": "وقال صلى الله عليه وسلم يستغفر للعالم ما في السموات والأرض (3) وأي منصب يزيد على منصب من تشتغل ملائكة السموات والأرض بالاستغفار له وقال صلى الله عليه وسلم إن الحكمة تزيد الشريف شرفا وترفع المملوك حتى يدرك مدارك الملوك (4) وقد نبه بهذا على ثمراته في الدنيا ومعلوم أن الآخرة خير وأبقى وقال صلى الله عليه وسلم خصلتان لا يكونان في منافق حسن سمت وفقه في الدين (5) ولا تشكن في الحديث لنفاق بعض فقهاء الزمان فإنه ما أراد به الفقه الذي ظننته وسيأتي معنى الفقه وأدنى درجات الفقيه أن يعلم أن الآخرة خير من الدنيا", "english": "How He, Glorified and Exalted, began with Himself, then seconded with the angels, and thirded with the people of knowledge — and sufficient for you is this as honor, excellence, splendor, and nobility. And God, Exalted, said: {«يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات»} — \"God will raise those who have believed among you and those who have been given knowledge, in degrees.\" Ibn ʿAbbās, may God be pleased with them both, said: For the scholars there are degrees above the believers, seven hundred degrees, and between each two degrees is a distance of five hundred years' journey.", "book_title": "Contemplation", "section_title_ar": "Section 4", "section_title_en": "The Book of Knowledge — Section 4: The Excellence of Knowledge and the Scholars", "section_index": 4, "anchors": "- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Core root meaning of knowing, perceiving a thing in its true reality; the act of apprehension and judgment.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment of existence or non-existence.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes genuine knowing; metaphorical (majāz) usage extends to signs, landmarks, and traces that guide to knowledge.\n- Root: درج (d-r-j)\n  * Lisan / Ayn: Degrees, steps, ascending stations; the root denotes gradation and progressive elevation.\n  * Al-Raghib (Mufradat): \"الدرجة نحو المنزلة، لكن يقال للمنزلة: درجة إذا اعتبرت بالصعود\" — a degree is a station considered by ascent, not horizontal extension.\n  * Al-Zamakhshari (Asas): Literal: physical steps of ascent. Metaphorical: \"لفلان درجة رفيعة\" — lofty rank; \"امش في مدارج الحق\" — walk in the paths of truth.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day denotes the time of the sun's rising to its setting, and may denote any period of time whatsoever.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"ذكر في أيام العرب كذا\" — historical battles and events; \"وذكرهم بأيام الله\" — His mighty deeds against the disbelievers.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication) — The particle \"innamā\" restricts and confines the predicate to the subject alone, as in {«إنما يخشى الله من عباده العلماء»}, where fear of God is restricted exclusively to the scholars.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Contemplation'", "badge": "Hadith"}]}, "wordTiming": {"minshawi": {"1": [[1, 400, 1425], [2, 1425, 3282], [3, 3282, 5420], [4, 5420, 7413], [5, 7413, 9812], [6, 9812, 11240], [7, 11240, 12788], [8, 12788, 14094], [9, 14094, 15690]], "24:1": [[1, 400, 1425], [2, 1425, 3282], [3, 3282, 5420], [4, 5420, 7413], [5, 7413, 9812], [6, 9812, 11240], [7, 11240, 12788], [8, 12788, 14094], [9, 14094, 15690]], "2": [[1, 800, 2744], [2, 2744, 