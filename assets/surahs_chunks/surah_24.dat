{"surah":24,"verses":[{"ayah":1,"text":"سُورَةٌ أَنزَلْنَٰهَا وَفَرَضْنَٰهَا وَأَنزَلْنَا فِيهَآ ءَايَٰتٍۭ بَيِّنَٰتٍ لَّعَلَّكُمْ تَذَكَّرُونَ ","translation":"[This is] a sūrah which We have sent down and made [that within it] obligatory and revealed therein verses of clear evidence that you might remember.","words":[{"id":1,"arabic":"سُورَةٌ","translit":"ٌẗَrwُs","root":"سور"},{"id":2,"arabic":"أَنزَلْنَٰهَا","translit":"āَhَٰnْlَznَaʾ","root":"نزل"},{"id":3,"arabic":"وَفَرَضْنَٰهَا","translit":"āَhَٰnْḍَrَfَw","root":"فرض"},{"id":4,"arabic":"وَأَنزَلْنَا","translit":"āَnْlَznَaʾَw","root":"نزل"},{"id":5,"arabic":"فِيهَآ","translit":"ٓāَhyِf","root":""},{"id":6,"arabic":"ءَايَٰتٍۭ","translit":"ٍۭtَٰyāَء","root":"ايي"},{"id":7,"arabic":"بَيِّنَٰتٍ","translit":"ٍtَٰnِّyَb","root":"بين"},{"id":8,"arabic":"لَّعَلَّكُمْ","translit":"ْmُkَّlَʿعَّl","root":""},{"id":9,"arabic":"تَذَكَّرُونَ","translit":"َnwُrَّkَhdَt","root":"ذكر"}],"hasIhya":false},{"ayah":2,"text":"ٱلزَّانِيَةُ وَٱلزَّانِى فَٱجْلِدُوا۟ كُلَّ وَٰحِدٍ مِّنْهُمَا مِا۟ئَةَ جَلْدَةٍۖ وَلَا تَأْخُذْكُم بِهِمَا رَأْفَةٌ فِى دِينِ ٱللَّهِ إِن كُنتُمْ تُؤْمِنُونَ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِۖ وَلْيَشْهَدْ عَذَابَهُمَا طَآئِفَةٌ مِّنَ ٱلْمُؤْمِنِينَ ","translation":"The [unmarried] woman or [unmarried] man found guilty of sexual intercourse[1] - lash each one of them with a hundred lashes,[2] and do not be taken by pity for them in the religion [i.e., law] of Allāh,[3] if you should believe in Allāh and the Last Day. And let a group of the believers witness their punishment.","words":[{"id":1,"arabic":"ٱلزَّانِيَةُ","translit":"ُẗَyِnāَّzlٱ","root":"زني"},{"id":2,"arabic":"وَٱلزَّانِى","translit":"àِnāَّzlٱَw","root":"زني"},{"id":3,"arabic":"فَٱجْلِدُوا۟","translit":"۟āwُdِlْjgٱَf","root":"جلد"},{"id":4,"arabic":"كُلَّ","translit":"َّlُk","root":"كلل"},{"id":5,"arabic":"وَٰحِدٍ","translit":"ٍdِḥَٰw","root":"وحد"},{"id":6,"arabic":"مِّنْهُمَا","translit":"āَmُhْnِّm","root":""},{"id":7,"arabic":"مِا۟ئَةَ","translit":"َẗَyʾ۟āِm","root":"ماي"},{"id":8,"arabic":"جَلْدَةٍ","translit":"ٍẗَdْlَjg","root":"جلد"},{"id":9,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":10,"arabic":"تَأْخُذْكُم","translit":"mُkْhdُhkْaʾَt","root":"اخذ"},{"id":11,"arabic":"بِهِمَا","translit":"āَmِhِb","root":""},{"id":12,"arabic":"رَأْفَةٌ","translit":"ٌẗَfْaʾَr","root":"راف"},{"id":13,"arabic":"فِى","translit":"àِf","root":""},{"id":14,"arabic":"دِينِ","translit":"ِnyِd","root":"دين"},{"id":15,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":16,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":17,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":18,"arabic":"تُؤْمِنُونَ","translit":"َnwُnِmْwʾُt","root":"امن"},{"id":19,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":20,"arabic":"وَٱلْيَوْمِ","translit":"ِmْwَyْlٱَw","root":"يوم"},{"id":21,"arabic":"ٱلْءَاخِرِ","translit":"ِrِhkāَءْlٱ","root":"اخر"},{"id":22,"arabic":"وَلْيَشْهَدْ","translit":"ْdَhْhsَyْlَw","root":"شهد"},{"id":23,"arabic":"عَذَابَهُمَا","translit":"āَmُhَbāَhdَʿع","root":"عذب"},{"id":24,"arabic":"طَآئِفَةٌ","translit":"ٌẗَfِyʾٓāَṭ","root":"طوف"},{"id":25,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":26,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"}],"hasIhya":true},{"ayah":3,"text":"ٱلزَّانِى لَا يَنكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً وَٱلزَّانِيَةُ لَا يَنكِحُهَآ إِلَّا زَانٍ أَوْ مُشْرِكٌۚ وَحُرِّمَ ذَٰلِكَ عَلَى ٱلْمُؤْمِنِينَ ","translation":"The fornicator does not marry except a [female] fornicator or polytheist, and none marries her except a fornicator[1] or a polytheist, and that [i.e., marriage to such persons] has been made unlawful to the believers.","words":[{"id":1,"arabic":"ٱلزَّانِى","translit":"àِnāَّzlٱ","root":"زني"},{"id":2,"arabic":"لَا","translit":"āَl","root":""},{"id":3,"arabic":"يَنكِحُ","translit":"ُḥِknَy","root":"نكح"},{"id":4,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":5,"arabic":"زَانِيَةً","translit":"ًẗَyِnāَ