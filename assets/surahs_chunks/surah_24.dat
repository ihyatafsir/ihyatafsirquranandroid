ranslit":"āًʿعyِmَjg","root":"جمع"},{"id":75,"arabic":"أَيُّهَ","translit":"َhُّyَaʾ","root":"ايي"},{"id":76,"arabic":"ٱلْمُؤْمِنُونَ","translit":"َnwُnِmْwʾُmْlٱ","root":"امن"},{"id":77,"arabic":"لَعَلَّكُمْ","translit":"ْmُkَّlَʿعَl","root":""},{"id":78,"arabic":"تُفْلِحُونَ","translit":"َnwُḥِlْfُt","root":"فلح"}],"hasIhya":true},{"ayah":32,"text":"وَأَنكِحُوا۟ ٱلْأَيَٰمَىٰ مِنكُمْ وَٱلصَّٰلِحِينَ مِنْ عِبَادِكُمْ وَإِمَآئِكُمْۚ إِن يَكُونُوا۟ فُقَرَآءَ يُغْنِهِمُ ٱللَّهُ مِن فَضْلِهِۦۗ وَٱللَّهُ وَٰسِعٌ عَلِيمٌ ","translation":"And marry the unmarried among you and the righteous among your male slaves and female slaves. If they should be poor, Allāh will enrich them from His bounty, and Allāh is all-Encompassing and Knowing.","words":[{"id":1,"arabic":"وَأَنكِحُوا۟","translit":"۟āwُḥِknَaʾَw","root":"نكح"},{"id":2,"arabic":"ٱلْأَيَٰمَىٰ","translit":"ٰàَmَٰyَaʾْlٱ","root":"ايم"},{"id":3,"arabic":"مِنكُمْ","translit":"ْmُknِm","root":""},{"id":4,"arabic":"وَٱلصَّٰلِحِينَ","translit":"َnyِḥِlَّٰṣlٱَw","root":"صلح"},{"id":5,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":6,"arabic":"عِبَادِكُمْ","translit":"ْmُkِdāَbِʿع","root":"عبد"},{"id":7,"arabic":"وَإِمَآئِكُمْ","translit":"ْmُkِyʾٓāَmِiʾَw","root":"امو"},{"id":8,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":9,"arabic":"يَكُونُوا۟","translit":"۟āwُnwُkَy","root":"كون"},{"id":10,"arabic":"فُقَرَآءَ","translit":"َءٓāَrَqُf","root":"فقر"},{"id":11,"arabic":"يُغْنِهِمُ","translit":"ُmِhِnْغُy","root":"غني"},{"id":12,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":13,"arabic":"مِن","translit":"nِm","root":""},{"id":14,"arabic":"فَضْلِهِۦ","translit":"ۦِhِlْḍَf","root":"فضل"},{"id":15,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":16,"arabic":"وَٰسِعٌ","translit":"ٌʿعِsَٰw","root":"وسع"},{"id":17,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"}],"hasIhya":true},{"ayah":33,"text":"وَلْيَسْتَعْفِفِ ٱلَّذِينَ لَا يَجِدُونَ نِكَاحًا حَتَّىٰ يُغْنِيَهُمُ ٱللَّهُ مِن فَضْلِهِۦۗ وَٱلَّذِينَ يَبْتَغُونَ ٱلْكِتَٰبَ مِمَّا مَلَكَتْ أَيْمَٰنُكُمْ فَكَاتِبُوهُمْ إِنْ عَلِمْتُمْ فِيهِمْ خَيْرًاۖ وَءَاتُوهُم مِّن مَّالِ ٱللَّهِ ٱلَّذِىٓ ءَاتَىٰكُمْۚ وَلَا تُكْرِهُوا۟ فَتَيَٰتِكُمْ عَلَى ٱلْبِغَآءِ إِنْ أَرَدْنَ تَحَصُّنًا لِّتَبْتَغُوا۟ عَرَضَ ٱلْحَيَوٰةِ ٱلدُّنْيَاۚ وَمَن يُكْرِههُّنَّ فَإِنَّ ٱللَّهَ مِنۢ بَعْدِ إِكْرَٰهِهِنَّ غَفُورٌ رَّحِيمٌ ","translation":"But let them who find not [the means for] marriage abstain [from sexual relations] until Allāh enriches them from His bounty. And those who seek a contract [for eventual emancipation] from among whom your right hands possess[1] - then make a contract with them if you know there is within them goodness and give them from the wealth of Allāh which He has given you. And do not compel your slave girls to prostitution, if they desire chastity, to seek [thereby] the temporary interests of worldly life. And if someone should compel them, then indeed, Allāh is [to them], after their compulsion, Forgiving and Merciful.","words":[{"id":1,"arabic":"وَلْيَسْتَعْفِفِ","translit":"ِfِfْʿعَtْsَyْlَw","root":"عفف"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"لَا","translit":"āَl","root":""},{"id":4,"arabic":"يَجِدُونَ","translit":"َnwُdِjgَy","root":"وجد"},{"id":5,"arabic":"نِكَاحًا","translit":"āًḥāَkِn","root":"نكح"},{"id":6,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":7,"arabic":"يُغْنِيَهُمُ","translit":"ُmُhَyِnْغُy","root":"غني"},{"id":8,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":9,"arabic":"مِن","translit":"nِm","root":""},{"id":10,"arabic":"فَضْلِهِۦ","translit":"ۦِhِlْḍَf","root":"فضل"},{"id":11,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":12,"arabic":"يَبْتَغُونَ","translit":"َnwُغَtْbَy","root":"بغي"},{"id":13,"arabic":"ٱلْكِتَٰبَ","translit":"َbَٰtِkْlٱ","root":"كتب"},{"id":14,"arabic":"مِمَّا","translit":"āَّmِm","root":""},{"id":15,"arabic":"مَلَكَتْ","translit":"ْtَkَlَm","root":"ملك"},{"id":16,"arabic":"أَيْمَٰنُكُمْ","translit":"ْmُkُnَٰmْyَaʾ","root":"يمن"},{"id":17,"arabic":"فَكَاتِبُوهُمْ","translit":"ْmُhwُbِtāَkَf","root":"كتب"},{"id":18,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":19,"arabic":"عَلِمْتُمْ","translit":"ْmُtْmِlَʿع","root":"علم"},{"id":20,"arabic":"فِيهِمْ","translit":"ْmِhyِf","root":""},{"id":21,"arabic":"خَيْرًا","translit":"āًrْyَhk","root":"خير"},{"id":22,"arabic":"وَءَاتُوهُم","translit":"mُhwُtāَءَw","root":"اتي"},{"id":23,"arabic":"مِّن","translit":"nِّm","root":""},{"id":24,"arabic":"مَّالِ","translit":"ِlāَّm","root":"مول"},{"id":25,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":26,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":27,"arabic":"ءَاتَىٰكُمْ","translit":"ْmُkٰàَtāَء","root":"اتي"},{"id":28,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":29,"arabic":"تُكْرِهُوا۟","translit":"۟āwُhِrْkُt","root":"كره"},{"id":30,"arabic":"فَتَيَٰتِكُمْ","translit":"ْmُkِtَٰyَtَf","root":"فتي"},{"id":31,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":32,"arabic":"ٱلْبِغَآءِ","translit":"ِءٓāَغِbْlٱ","root":"بغي"},{"id":33,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":34,"arabic":"أَرَدْنَ","translit":"َnْdَrَaʾ","root":"رود"},{"id":35,"arabic":"تَحَصُّنًا","translit":"āًnُّṣَḥَt","root":"حصن"},{"id":36,"arabic":"لِّتَبْتَغُوا۟","translit":"۟āwُغَtْbَtِّl","root":"بغي"},{"id":37,"arabic":"عَرَضَ","translit":"َḍَrَʿع","root":"عرض"},{"id":38,"arabic":"ٱلْحَيَوٰةِ","translit":"ِẗٰwَyَḥْlٱ","root":"حيي"},{"id":39,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":40,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":41,"arabic":"يُكْرِههُّنَّ","translit":"َّnُّhhِrْkُy","root":"كره"},{"id":42,"arabic":"فَإِنَّ","translit":"َّnِiʾَf","root":""},{"id":43,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":44,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":45,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":46,"arabic":"إِكْرَٰهِهِنَّ","translit":"َّnِhِhَٰrْkِiʾ","root":"كره"},{"id":47,"arabic":"غَفُورٌ","translit":"ٌrwُfَغ","root":"غفر"},{"id":48,"arabic":"رَّحِيمٌ","translit":"ٌmyِḥَّr","root":"رحم"}],"hasIhya":false},{"ayah":34,"text":"وَلَقَدْ أَنزَلْنَآ إِلَيْكُمْ ءَايَٰتٍ مُّبَيِّنَٰتٍ وَمَثَلًا مِّنَ ٱلَّذِينَ خَلَوْا۟ مِن قَبْلِكُمْ وَمَوْعِظَةً لِّلْمُتَّقِينَ ","translation":"And We have certainly sent down to you distinct verses[1] and examples from those who passed on before you and an admonition for those who fear Allāh.","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"أَنزَلْنَآ","translit":"ٓāَnْlَznَaʾ","root":"نزل"},{"id":3,"arabic":"إِلَيْكُمْ","translit":"ْmُkْyَlِiʾ","root":""},{"id":4,"arabic":"ءَايَٰتٍ","translit":"ٍtَٰyāَء","root":"ايي"},{"id":5,"arabic":"مُّبَيِّنَٰتٍ","translit":"ٍtَٰnِّyَbُّm","root":"بين"},{"id":6,"arabic":"وَمَثَلًا","translit":"āًlَhtَmَw","root":"مثل"},{"id":7,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":8,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":9,"arabic":"خَلَوْا۟","translit":"۟āْwَlَhk","root":"خلو"},{"id":10,"arabic":"مِن","translit":"nِm","root":""},{"id":11,"arabic":"قَبْلِكُمْ","translit":"ْmُkِlْbَq","root":"قبل"},{"id":12,"arabic":"وَمَوْعِظَةً","translit":"ًẗَẓِʿعْwَmَw","root":"وعظ"},{"id":13,"arabic":"لِّلْمُتَّقِينَ","translit":"َnyِqَّtُmْlِّl","root":"وقي"}],"hasIhya":false},{"ayah":35,"text":"ٱللَّهُ نُورُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ مَثَلُ نُورِهِۦ كَمِشْكَوٰةٍ فِيهَا مِصْبَاحٌۖ ٱلْمِصْبَاحُ فِى زُجَاجَةٍۖ ٱلزُّجَاجَةُ كَأَنَّهَا كَوْكَبٌ دُرِّىٌّ يُوقَدُ مِن شَجَرَةٍ مُّبَٰرَكَةٍ زَيْتُونَةٍ لَّا شَرْقِيَّةٍ وَلَا غَرْبِيَّةٍ يَكَادُ زَيْتُهَا يُضِىٓءُ وَلَوْ لَمْ تَمْسَسْهُ نَارٌۚ نُّورٌ عَلَىٰ نُورٍۗ يَهْدِى ٱللَّهُ لِنُورِهِۦ مَن يَشَآءُۚ وَيَضْرِبُ ٱللَّهُ ٱلْأَمْثَٰلَ لِلنَّاسِۗ وَٱللَّهُ بِكُلِّ شَىْءٍ عَلِيمٌ ","translation":"Allāh is the Light[1] of the heavens and the earth. The example of His light[2] is like a niche within which is a lamp;[3] the lamp is within glass, the glass as if it were a pearly [white] star lit from [the oil of] a blessed olive tree, neither of the east nor of the west, whose oil would almost glow even if untouched by fire. Light upon light. Allāh guides to His light whom He wills. And Allāh presents examples for the people, and Allāh is Knowing of all things.","words":[{"id":1,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":2,"arabic":"نُورُ","translit":"ُrwُn","root":"نور"},{"id":3,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":4,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":5,"arabic":"مَثَلُ","translit":"ُlَhtَm","root":"مثل"},{"id":6,"arabic":"نُورِهِۦ","translit":"ۦِhِrwُn","root":"نور"},{"id":7,"arabic":"كَمِشْكَوٰةٍ","translit":"ٍẗٰwَkْhsِmَk","root":"شكو"},{"id":8,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":9,"arabic":"مِصْبَاحٌ","translit":"ٌḥāَbْṣِm","root":"صبح"},{"id":10,"arabic":"ٱلْمِصْبَاحُ","translit":"ُḥāَbْṣِmْlٱ","root":"صبح"},{"id":11,"arabic":"فِى","translit":"àِf","root":""},{"id":12,"arabic":"زُجَاجَةٍ","translit":"ٍẗَjgāَjgُz","root":"زجج"},{"id":13,"arabic":"ٱلزُّجَاجَةُ","translit":"ُẗَjgāَjgُّzlٱ","root":"زجج"},{"id":14,"arabic":"كَأَنَّهَا","translit":"āَhَّnَaʾَk","root":""},{"id":15,"arabic":"كَوْكَبٌ","translit":"ٌbَkْwَk","root":"كوكب"},{"id":16,"arabic":"دُرِّىٌّ","translit":"ٌّàِّrُd","root":"درر"},{"id":17,"arabic":"يُوقَدُ","translit":"ُdَqwُy","root":"وقد"},{"id":18,"arabic":"مِن","translit":"nِm","root":""},{"id":19,"arabic":"شَجَرَةٍ","translit":"ٍẗَrَjgَhs","root":"شجر"},{"id":20,"arabic":"مُّبَٰرَكَةٍ","translit":"ٍẗَkَrَٰbُّm","root":"برك"},{"id":21,"arabic":"زَيْتُونَةٍ","translit":"ٍẗَnwُtْyَz","root":"زيت"},{"id":22,"arabic":"لَّا","translit":"āَّl","root":""},{"id":23,"arabic":"شَرْقِيَّةٍ","translit":"ٍẗَّyِqْrَhs","root":"شرق"},{"id":24,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":25,"arabic":"غَرْبِيَّةٍ","translit":"ٍẗَّyِbْrَغ","root":"غرب"},{"id":26,"arabic":"يَكَادُ","translit":"ُdāَkَy","root":"كود"},{"id":27,"arabic":"زَيْتُهَا","translit":"āَhُtْyَz","root":"زيت"},{"id":28,"arabic":"يُضِىٓءُ","translit":"ُءٓàِḍُy","root":"ضوا"},{"id":29,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":30,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":31,"arabic":"تَمْسَسْهُ","translit":"ُhْsَsْmَt","root":"مسس"},{"id":32,"arabic":"نَارٌ","translit":"ٌrāَn","root":"نور"},{"id":33,"arabic":"نُّورٌ","translit":"ٌrwُّn","root":"نور"},{"id":34,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":35,"arabic":"نُورٍ","translit":"ٍrwُn","root":"نور"},{"id":36,"arabic":"يَهْدِى","translit":"àِdْhَy","root":"هدي"},{"id":37,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":38,"arabic":"لِنُورِهِۦ","translit":"ۦِhِrwُnِl","root":"نور"},{"id":39,"arabic":"مَن","translit":"nَm","root":""},{"id":40,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":41,"arabic":"وَيَضْرِبُ","translit":"ُbِrْḍَyَw","root":"ضرب"},{"id":42,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":43,"arabic":"ٱلْأَمْثَٰلَ","translit":"َlَٰhtْmَaʾْlٱ","root":"مثل"},{"id":44,"arabic":"لِلنَّاسِ","translit":"ِsāَّnlِl","root":"انس"},{"id":45,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":46,"arabic":"بِكُلِّ","translit":"ِّlُkِb","root":"كلل"},{"id":47,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":48,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"}],"hasIhya":true},{"ayah":36,"text":"فِى بُيُوتٍ أَذِنَ ٱللَّهُ أَن تُرْفَعَ وَيُذْكَرَ فِيهَا ٱسْمُهُۥ يُسَبِّحُ لَهُۥ فِيهَا بِٱلْغُدُوِّ وَٱلْءَاصَالِ ","translation":"[Such niches are] in houses [i.e., mosques] which Allāh has ordered to be raised and that His name be mentioned [i.e., praised] therein; exalting Him within them in the morning and the evenings[1]","words":[{"id":1,"arabic":"فِى","translit":"àِf","root":""},{"id":2,"arabic":"بُيُوتٍ","translit":"ٍtwُyُb","root":"بيت"},{"id":3,"arabic":"أَذِنَ","translit":"َnِhdَaʾ","root":"اذن"},{"id":4,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":5,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":6,"arabic":"تُرْفَعَ","translit":"َʿعَfْrُt","root":"رفع"},{"id":7,"arabic":"وَيُذْكَرَ","translit":"َrَkْhdُyَw","root":"ذكر"},{"id":8,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":9,"arabic":"ٱسْمُهُۥ","translit":"ۥُhُmْsٱ","root":"سمو"},{"id":10,"arabic":"يُسَبِّحُ","translit":"ُḥِّbَsُy","root":"سبح"},{"id":11,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":12,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":13,"arabic":"بِٱلْغُدُوِّ","translit":"ِّwُdُغْlٱِb","root":"غدو"},{"id":14,"arabic":"وَٱلْءَاصَالِ","translit":"ِlāَṣāَءْlٱَw","root":"اصل"}],"hasIhya":true},{"ayah":37,"text":"رِجَالٌ لَّا تُلْهِيهِمْ تِجَٰرَةٌ وَلَا بَيْعٌ عَن ذِكْرِ ٱللَّهِ وَإِقَامِ ٱلصَّلَوٰةِ وَإِيتَآءِ ٱلزَّكَوٰةِۙ يَخَافُونَ يَوْمًا تَتَقَلَّبُ فِيهِ ٱلْقُلُوبُ وَٱلْأَبْصَٰرُ ","translation":"[Are] men whom neither commerce nor sale distracts from the remembrance of Allāh and performance of prayer and giving of zakāh. They fear a Day in which the hearts and eyes will [fearfully] turn about -","words":[{"id":1,"arabic":"رِجَالٌ","translit":"ٌlāَjgِr","root":"رجل"},{"id":2,"arabic":"لَّا","translit":"āَّl","root":""},{"id":3,"arabic":"تُلْهِيهِمْ","translit":"ْmِhyِhْlُt","root":"لهو"},{"id":4,"arabic":"تِجَٰرَةٌ","translit":"ٌẗَrَٰjgِt","root":"تجر"},{"id":5,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":6,"arabic":"بَيْعٌ","translit":"ٌʿعْyَb","root":"بيع"},{"id":7,"arabic":"عَن","translit":"nَʿع","root":""},{"id":8,"arabic":"ذِكْرِ","translit":"ِrْkِhd","root":"ذكر"},{"id":9,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":10,"arabic":"وَإِقَامِ","translit":"ِmāَqِiʾَw","root":"قوم"},{"id":11,"arabic":"ٱلصَّلَوٰةِ","translit":"ِẗٰwَlَّṣlٱ","root":"صلو"},{"id":12,"arabic":"وَإِيتَآءِ","translit":"ِءٓāَtyِiʾَw","root":"اتي"},{"id":13,"arabic":"ٱلزَّكَوٰةِ","translit":"ِẗٰwَkَّzlٱ","root":"زكو"},{"id":14,"arabic":"يَخَافُونَ","translit":"َnwُfāَhkَy","root":"خوف"},{"id":15,"arabic":"يَوْمًا","translit":"āًmْwَy","root":"يوم"},{"id":16,"arabic":"تَتَقَلَّبُ","translit":"ُbَّlَqَtَt","root":"قلب"},{"id":17,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":18,"arabic":"ٱلْقُلُوبُ","translit":"ُbwُlُqْlٱ","root":"قلب"},{"id":19,"arabic":"وَٱلْأَبْصَٰرُ","translit":"ُrَٰṣْbَaʾْlٱَw","root":"بصر"}],"hasIhya":true},{"ayah":38,"text":"لِيَجْزِيَهُمُ ٱللَّهُ أَحْسَنَ مَا عَمِلُوا۟ وَيَزِيدَهُم مِّن فَضْلِهِۦۗ وَٱللَّهُ يَرْزُقُ مَن يَشَآءُ بِغَيْرِ حِسَابٍ ","translation":"That Allāh may reward them [according to] the best of what they did and increase them from His bounty. And Allāh gives provision to whom He wills without account [i.e., limit].","words":[{"id":1,"arabic":"لِيَجْزِيَهُمُ","translit":"ُmُhَyِzْjgَyِl","root":"جزي"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"أَحْسَنَ","translit":"َnَsْḥَaʾ","root":"حسن"},{"id":4,"arabic":"مَا","translit":"āَm","root":""},{"id":5,"arabic":"عَمِلُوا۟","translit":"۟āwُlِmَʿع","root":"عمل"},{"id":6,"arabic":"وَيَزِيدَهُم","translit":"mُhَdyِzَyَw","root":"زيد"},{"id":7,"arabic":"مِّن","translit":"nِّm","root":""},{"id":8,"arabic":"فَضْلِهِۦ","translit":"ۦِhِlْḍَf","root":"فضل"},{"id":9,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":10,"arabic":"يَرْزُقُ","translit":"ُqُzْrَy","root":"رزق"},{"id":11,"arabic":"مَن","translit":"nَm","root":""},{"id":12,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":13,"arabic":"بِغَيْرِ","translit":"ِrْyَغِb","root":"غير"},{"id":14,"arabic":"حِسَابٍ","translit":"ٍbāَsِḥ","root":"حسب"}],"hasIhya":true},{"ayah":39,"text":"وَٱلَّذِينَ كَفَرُوٓا۟ أَعْمَٰلُهُمْ كَسَرَابٍۭ بِقِيعَةٍ يَحْسَبُهُ ٱلظَّمْـَٔانُ مَآءً حَتَّىٰٓ إِذَا جَآءَهُۥ لَمْ يَجِدْهُ شَيْـًٔا وَوَجَدَ ٱللَّهَ عِندَهُۥ فَوَفَّىٰهُ حِسَابَهُۥۗ وَٱللَّهُ سَرِيعُ ٱلْحِسَابِ ","translation":"But those who disbelieved - their deeds are like a mirage in a lowland which a thirsty one thinks is water until, when he comes to it, he finds it is nothing but finds Allāh before him, and He will pay him in full his due; and Allāh is swift in account.","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"كَفَرُوٓا۟","translit":"۟āٓwُrَfَk","root":"كفر"},{"id":3,"arabic":"أَعْمَٰلُهُمْ","translit":"ْmُhُlَٰmْʿعَaʾ","root":"عمل"},{"id":4,"arabic":"كَسَرَابٍۭ","translit":"ٍۭbāَrَsَk","root":"سرب"},{"id":5,"arabic":"بِقِيعَةٍ","translit":"ٍẗَʿعyِqِb","root":"قوع"},{"id":6,"arabic":"يَحْسَبُهُ","translit":"ُhُbَsْḥَy","root":"حسب"},{"id":7,"arabic":"ٱلظَّمْـَٔانُ","translit":"ُnāَٔـْmَّẓlٱ","root":"ظما"},{"id":8,"arabic":"مَآءً","translit":"ًءٓāَm","root":"موه"},{"id":9,"arabic":"حَتَّىٰٓ","translit":"ٰٓàَّtَḥ","root":""},{"id":10,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":11,"arabic":"جَآءَهُۥ","translit":"ۥُhَءٓāَjg","root":"جيا"},{"id":12,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":13,"arabic":"يَجِدْهُ","translit":"ُhْdِjgَy","root":"وجد"},{"id":14,"arabic":"شَيْـًٔا","translit":"āًٔـْyَhs","root":"شيا"},{"id":15,"arabic":"وَوَجَدَ","translit":"َdَjgَwَw","root":"وجد"},{"id":16,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":17,"arabic":"عِندَهُۥ","translit":"ۥُhَdnِʿع","root":"عند"},{"id":18,"arabic":"فَوَفَّىٰهُ","translit":"ُhٰàَّfَwَf","root":"وفي"},{"id":19,"arabic":"حِسَابَهُۥ","translit":"ۥُhَbāَsِḥ","root":"حسب"},{"id":20,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":21,"arabic":"سَرِيعُ","translit":"ُʿعyِrَs","root":"سرع"},{"id":22,"arabic":"ٱلْحِسَابِ","translit":"ِbāَsِḥْlٱ","root":"حسب"}],"hasIhya":false},{"ayah":40,"text":"أَوْ كَظُلُمَٰتٍ فِى بَحْرٍ لُّجِّىٍّ يَغْشَىٰهُ مَوْجٌ مِّن فَوْقِهِۦ مَوْجٌ مِّن فَوْقِهِۦ سَحَابٌۚ ظُلُمَٰتٌۢ بَعْضُهَا فَوْقَ بَعْضٍ إِذَآ أَخْرَجَ يَدَهُۥ لَمْ يَكَدْ يَرَىٰهَاۗ وَمَن لَّمْ يَجْعَلِ ٱللَّهُ لَهُۥ نُورًا فَمَا لَهُۥ مِن نُّورٍ ","translation":"Or [they are] like darknesses within an unfathomable sea which is covered by waves, upon which are waves, over which are clouds - darknesses, some of them upon others. When one puts out his hand [therein], he can hardly see it. And he to whom Allāh has not granted light - for him there is no light.","words":[{"id":1,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":2,"arabic":"كَظُلُمَٰتٍ","translit":"ٍtَٰmُlُẓَk","root":"ظلم"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"بَحْرٍ","translit":"ٍrْḥَb","root":"بحر"},{"id":5,"arabic":"لُّجِّىٍّ","translit":"ٍّàِّjgُّl","root":"لجج"},{"id":6,"arabic":"يَغْشَىٰهُ","translit":"ُhٰàَhsْغَy","root":"غشو"},{"id":7,"arabic":"مَوْجٌ","translit":"ٌjgْwَm","root":"موج"},{"id":8,"arabic":"مِّن","translit":"nِّm","root":""},{"id":9,"arabic":"فَوْقِهِۦ","translit":"ۦِhِqْwَf","root":"فوق"},{"id":10,"arabic":"مَوْجٌ","translit":"ٌjgْwَm","root":"موج"},{"id":11,"arabic":"مِّن","translit":"nِّm","root":""},{"id":12,"arabic":"فَوْقِهِۦ","translit":"ۦِhِqْwَf","root":"فوق"},{"id":13,"arabic":"سَحَابٌ","translit":"ٌbāَḥَs","root":"سحب"},{"id":14,"arabic":"ظُلُمَٰتٌۢ","translit":"ٌۢtَٰmُlُẓ","root":"ظلم"},{"id":15,"arabic":"بَعْضُهَا","translit":"āَhُḍْʿعَb","root":"بعض"},{"id":16,"arabic":"فَوْقَ","translit":"َqْwَf","root":"فوق"},{"id":17,"arabic":"بَعْضٍ","translit":"ٍḍْʿعَb","root":"بعض"},{"id":18,"arabic":"إِذَآ","translit":"ٓāَhdِiʾ","root":""},{"id":19,"arabic":"أَخْرَجَ","translit":"َjgَrْhkَaʾ","root":"خرج"},{"id":20,"arabic":"يَدَهُۥ","translit":"ۥُhَdَy","root":"يدي"},{"id":21,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":22,"arabic":"يَكَدْ","translit":"ْdَkَy","root":"كود"},{"id":23,"arabic":"يَرَىٰهَا","translit":"āَhٰàَrَy","root":"راي"},{"id":24,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":25,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":26,"arabic":"يَجْعَلِ","translit":"ِlَʿعْjgَy","root":"جعل"},{"id":27,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":28,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":29,"arabic":"نُورًا","translit":"āًrwُn","root":"نور"},{"id":30,"arabic":"فَمَا","translit":"āَmَf","root":""},{"id":31,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":32,"arabic":"مِن","translit":"nِm","root":""},{"id":33,"arabic":"نُّورٍ","translit":"ٍrwُّn","root":"نور"}],"hasIhya":true},{"ayah":41,"text":"أَلَمْ تَرَ أَنَّ ٱللَّهَ يُسَبِّحُ لَهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَٱلطَّيْرُ صَٰٓفَّٰتٍۖ كُلٌّ قَدْ عَلِمَ صَلَاتَهُۥ وَتَسْبِيحَهُۥۗ وَٱللَّهُ عَلِيمٌۢ بِمَا يَفْعَلُونَ ","translation":"Do you not see that Allāh is exalted by whomever is within the heavens and the earth and [by] the birds with wings spread [in flight]? Each [of them] has known his [means of] prayer and exalting [Him], and Allāh is Knowing of what they do.","words":[{"id":1,"arabic":"أَلَمْ","translit":"ْmَlَaʾ","root":""},{"id":2,"arabic":"تَرَ","translit":"َrَt","root":"راي"},{"id":3,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":4,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":5,"arabic":"يُسَبِّحُ","translit":"ُḥِّbَsُy","root":"سبح"},{"id":6,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":7,"arabic":"مَن","translit":"nَm","root":""},{"id":8,"arabic":"فِى","translit":"àِf","root":""},{"id":9,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":10,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":11,"arabic":"وَٱلطَّيْرُ","translit":"ُrْyَّṭlٱَw","root":"طير"},{"id":12,"arabic":"صَٰٓفَّٰتٍ","translit":"ٍtَّٰfَٰٓṣ","root":"صفف"},{"id":13,"arabic":"كُلٌّ","translit":"ٌّlُk","root":"كلل"},{"id":14,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":15,"arabic":"عَلِمَ","translit":"َmِlَʿع","root":"علم"},{"id":16,"arabic":"صَلَاتَهُۥ","translit":"ۥُhَtāَlَṣ","root":"صلو"},{"id":17,"arabic":"وَتَسْبِيحَهُۥ","translit":"ۥُhَḥyِbْsَtَw","root":"سبح"},{"id":18,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":19,"arabic":"عَلِيمٌۢ","translit":"ٌۢmyِlَʿع","root":"علم"},{"id":20,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":21,"arabic":"يَفْعَلُونَ","translit":"َnwُlَʿعْfَy","root":"فعل"}],"hasIhya":true},{"ayah":42,"text":"وَلِلَّهِ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ وَإِلَى ٱللَّهِ ٱلْمَصِيرُ ","translation":"And to Allāh belongs the dominion of the heavens and the earth, and to Allāh is the destination.","words":[{"id":1,"arabic":"وَلِلَّهِ","translit":"ِhَّlِlَw","root":"اله"},{"id":2,"arabic":"مُلْكُ","translit":"ُkْlُm","root":"ملك"},{"id":3,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":4,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":5,"arabic":"وَإِلَى","translit":"àَlِiʾَw","root":""},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"ٱلْمَصِيرُ","translit":"ُryِṣَmْlٱ","root":"صير"}],"hasIhya":false},{"ayah":43,"text":"أَلَمْ تَرَ أَنَّ ٱللَّهَ يُزْجِى سَحَابًا ثُمَّ يُؤَلِّفُ بَيْنَهُۥ ثُمَّ يَجْعَلُهُۥ رُكَامًا فَتَرَى ٱلْوَدْقَ يَخْرُجُ مِنْ خِلَٰلِهِۦ وَيُنَزِّلُ مِنَ ٱلسَّمَآءِ مِن جِبَالٍ فِيهَا مِنۢ بَرَدٍ فَيُصِيبُ بِهِۦ مَن يَشَآءُ وَيَصْرِفُهُۥ عَن مَّن يَشَآءُۖ يَكَادُ سَنَا بَرْقِهِۦ يَذْهَبُ بِٱلْأَبْصَٰرِ ","translation":"Do you not see that Allāh drives clouds? Then He brings them together; then He makes them into a mass, and you see the rain emerge from within it. And He sends down from the sky, mountains [of clouds] within which is hail, and He strikes with it whom He wills and averts it from whom He wills. The flash of its lightning almost takes away the eyesight.","words":[{"id":1,"arabic":"أَلَمْ","translit":"ْmَlَaʾ","root":""},{"id":2,"arabic":"تَرَ","translit":"َrَt","root":"راي"},{"id":3,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":4,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":5,"arabic":"يُزْجِى","translit":"àِjgْzُy","root":"زجو"},{"id":6,"arabic":"سَحَابًا","translit":"āًbāَḥَs","root":"سحب"},{"id":7,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":8,"arabic":"يُؤَلِّفُ","translit":"ُfِّlَwʾُy","root":"الف"},{"id":9,"arabic":"بَيْنَهُۥ","translit":"ۥُhَnْyَb","root":"بين"},{"id":10,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":11,"arabic":"يَجْعَلُهُۥ","translit":"ۥُhُlَʿعْjgَy","root":"جعل"},{"id":12,"arabic":"رُكَامًا","translit":"āًmāَkُr","root":"ركم"},{"id":13,"arabic":"فَتَرَى","translit":"àَrَtَf","root":"راي"},{"id":14,"arabic":"ٱلْوَدْقَ","translit":"َqْdَwْlٱ","root":"ودق"},{"id":15,"arabic":"يَخْرُجُ","translit":"ُjgُrْhkَy","root":"خرج"},{"id":16,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":17,"arabic":"خِلَٰلِهِۦ","translit":"ۦِhِlَٰlِhk","root":"خلل"},{"id":18,"arabic":"وَيُنَزِّلُ","translit":"ُlِّzَnُyَw","root":"نزل"},{"id":19,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":20,"arabic":"ٱلسَّمَآءِ","translit":"ِءٓāَmَّslٱ","root":"سمو"},{"id":21,"arabic":"مِن","translit":"nِm","root":""},{"id":22,"arabic":"جِبَالٍ","translit":"ٍlāَbِjg","root":"جبل"},{"id":23,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":24,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":25,"arabic":"بَرَدٍ","translit":"ٍdَrَb","root":"برد"},{"id":26,"arabic":"فَيُصِيبُ","translit":"ُbyِṣُyَf","root":"صوب"},{"id":27,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":28,"arabic":"مَن","translit":"nَm","root":""},{"id":29,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":30,"arabic":"وَيَصْرِفُهُۥ","translit":"ۥُhُfِrْṣَyَw","root":"صرف"},{"id":31,"arabic":"عَن","translit":"nَʿع","root":""},{"id":32,"arabic":"مَّن","translit":"nَّm","root":""},{"id":33,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":34,"arabic":"يَكَادُ","translit":"ُdāَkَy","root":"كود"},{"id":35,"arabic":"سَنَا","translit":"āَnَs","root":"سنو"},{"id":36,"arabic":"بَرْقِهِۦ","translit":"ۦِhِqْrَb","root":"برق"},{"id":37,"arabic":"يَذْهَبُ","translit":"ُbَhْhdَy","root":"ذهب"},{"id":38,"arabic":"بِٱلْأَبْصَٰرِ","translit":"ِrَٰṣْbَaʾْlٱِb","root":"بصر"}],"hasIhya":false},{"ayah":44,"text":"يُقَلِّبُ ٱللَّهُ ٱلَّيْلَ وَٱلنَّهَارَۚ إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّأُو۟لِى ٱلْأَبْصَٰرِ ","translation":"Allāh alternates the night and the day. Indeed in that is a lesson for those who have vision.","words":[{"id":1,"arabic":"يُقَلِّبُ","translit":"ُbِّlَqُy","root":"قلب"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"ٱلَّيْلَ","translit":"َlْyَّlٱ","root":"ليل"},{"id":4,"arabic":"وَٱلنَّهَارَ","translit":"َrāَhَّnlٱَw","root":"نهر"},{"id":5,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":6,"arabic":"فِى","translit":"àِf","root":""},{"id":7,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":8,"arabic":"لَعِبْرَةً","translit":"ًẗَrْbِʿعَl","root":"عبر"},{"id":9,"arabic":"لِّأُو۟لِى","translit":"àِl۟wُaʾِّl","root":""},{"id":10,"arabic":"ٱلْأَبْصَٰرِ","translit":"ِrَٰṣْbَaʾْlٱ","root":"بصر"}],"hasIhya":true},{"ayah":45,"text":"وَٱللَّهُ خَلَقَ كُلَّ دَآبَّةٍ مِّن مَّآءٍۖ فَمِنْهُم مَّن يَمْشِى عَلَىٰ بَطْنِهِۦ وَمِنْهُم مَّن يَمْشِى عَلَىٰ رِجْلَيْنِ وَمِنْهُم مَّن يَمْشِى عَلَىٰٓ أَرْبَعٍۚ يَخْلُقُ ٱللَّهُ مَا يَشَآءُۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ","translation":"Allāh has created every [living] creature from water. And of them are those that move on their bellies, and of them are those that walk on two legs, and of them are those that walk on four. Allāh creates what He wills. Indeed, Allāh is over all things competent.","words":[{"id":1,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":2,"arabic":"خَلَقَ","translit":"َqَlَhk","root":"خلق"},{"id":3,"arabic":"كُلَّ","translit":"َّlُk","root":"كلل"},{"id":4,"arabic":"دَآبَّةٍ","translit":"ٍẗَّbٓāَd","root":"دبب"},{"id":5,"arabic":"مِّن","translit":"nِّm","root":""},{"id":6,"arabic":"مَّآءٍ","translit":"ٍءٓāَّm","root":"موه"},{"id":7,"arabic":"فَمِنْهُم","translit":"mُhْnِmَf","root":""},{"id":8,"arabic":"مَّن","translit":"nَّm","root":""},{"id":9,"arabic":"يَمْشِى","translit":"àِhsْmَy","root":"مشي"},{"id":10,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":11,"arabic":"بَطْنِهِۦ","translit":"ۦِhِnْṭَb","root":"بطن"},{"id":12,"arabic":"وَمِنْهُم","translit":"mُhْnِmَw","root":""