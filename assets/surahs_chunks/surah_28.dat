َ رَبِّ نَجِّنِے مِنَ اَ۬لْقَوْمِ اِ۬لظَّٰلِمِينَۖ", "words": [{"id": 1, "arabic": "فَخَرَجَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِنْهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "خَآئِفاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَتَرَقَّبُۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 6, "arabic": "رَبِّ", "translit": "", "root": ""}, {"id": 7, "arabic": "نَجِّنِے", "translit": "", "root": ""}, {"id": 8, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لْقَوْمِ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لظَّٰلِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 28, "ayah": 22, "text": "۞وَلَمَّا تَوَجَّهَ تِلْقَآءَ مَدْيَنَ قَالَ عَس۪يٰ رَبِّيَ أَنْ يَّهْدِيَنِے سَوَآءَ اَ۬لسَّبِيلِۖ", "words": [{"id": 1, "arabic": "۞وَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَوَجَّهَ", "translit": "", "root": ""}, {"id": 3, "arabic": "تِلْقَآءَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَدْيَنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَس۪يٰ", "translit": "", "root": ""}, {"id": 7, "arabic": "رَبِّيَ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 9, "arabic": "يَّهْدِيَنِے", "translit": "", "root": ""}, {"id": 10, "arabic": "سَوَآءَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لسَّبِيلِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 28, "ayah": 23, "text": "وَلَمَّا وَرَدَ مَآءَ مَدْيَنَ وَجَدَ عَلَيْهِ أُمَّةࣰ مِّنَ اَ۬لنَّاسِ يَسْقُونَ وَوَجَدَ مِن دُونِهِمُ اُ۪مْرَأَتَيْنِ تَذُودَٰنِۖ قَالَ مَا خَطْبُكُمَاۖ قَالَتَا لَا نَسْقِے حَتَّيٰ يُصْدِرَ اَ۬لرِّعَآءُ وَأَبُونَا شَيْخࣱ كَبِيرࣱۖ", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "وَرَدَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَآءَ", "translit