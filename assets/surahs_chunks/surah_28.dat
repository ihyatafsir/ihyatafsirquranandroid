{"surah": 28, "verses": [{"ayah": 1, "text": "طسٓمٓ ", "translation": "Ṭā, Seen, Meem.[1]", "words": [{"id": 1, "arabic": "طسٓمٓ", "translit": "ٓmٓsṭ", "root": ""}], "hasIhya": false}, {"ayah": 2, "text": "تِلْكَ ءَايَٰتُ ٱلْكِتَٰبِ ٱلْمُبِينِ ", "translation": "These are verses of the clear Book.", "words": [{"id": 1, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 2, "arabic": "ءَايَٰتُ", "translit": "ُtَٰyāَء", "root": "ايي"}, {"id": 3, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 4, "arabic": "ٱلْمُبِينِ", "translit": "ِnyِbُmْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 3, "text": "نَتْلُوا۟ عَلَيْكَ مِن نَّبَإِ مُوسَىٰ وَفِرْعَوْنَ بِٱلْحَقِّ لِقَوْمٍ يُؤْمِنُونَ ", "translation": "We recite to you from the news of Moses and Pharaoh in truth for a people who believe.", "words": [{"id": 1, "arabic": "نَتْلُوا۟", "translit": "۟āwُlْtَn", "root": "تلو"}, {"id": 2, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "نَّبَإِ", "translit": "ِiʾَbَّn", "root": "نبا"}, {"id": 5, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 6, "arabic": "وَفِرْعَوْنَ", "translit": "َnْwَʿعْrِfَw", "root": ""}, {"id": 7, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 8, "arabic": "لِقَوْمٍ", "translit": "ٍmْwَqِl", "root": "قوم"}, {"id": 9, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 4, "text": "إِنَّ فِرْعَوْنَ عَلَا فِى ٱلْأَرْضِ وَجَعَلَ أَهْلَهَا شِيَعًا يَسْتَضْعِفُ طَآئِفَةً مِّنْهُمْ يُذَبِّحُ أَبْنَآءَهُمْ وَيَسْتَحْىِۦ نِسَآءَهُمْۚ إِنَّهُۥ كَانَ مِنَ ٱلْمُفْسِدِينَ ", "translation": "Indeed, Pharaoh exalted himself in the land and made its people into factions, oppressing a sector among them, slaughtering their [newborn] sons and keeping their females alive. Indeed, he was of the corrupters.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 3, "arabic": "عَلَا", "translit": "āَlَʿع", "root": "علو"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 7, "arabic": "أَهْلَهَا", "translit": "āَhَlْhَaʾ", "root": "اهل"}, {"id": 8, "arabic": "شِيَعًا", "translit": "āًʿعَyِhs", "root": "شيع"}, {"id": 9, "arabic": "يَسْتَضْعِفُ", "translit": "ُfِʿعْḍَtْsَy", "root": "ضعف"}, {"id": 10, "arabic": "طَآئِفَةً", "translit": "ًẗَfِyʾٓāَṭ", "root": "طوف"}, {"id": 11, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 12, "arabic": "يُذَبِّحُ", "translit": "ُḥِّbَhdُy", "root": "ذبح"}, {"id": 13, "arabic": "أَبْنَآءَهُمْ", "translit": "ْmُhَءٓāَnْbَaʾ", "root": "بني"}, {"id": 14, "arabic": "وَيَسْتَحْىِۦ", "translit": "ۦِàْḥَtْsَyَw", "root": "حيي"}, {"id": 15, "arabic": "نِسَآءَهُمْ", "translit": "ْmُhَءٓāَsِn", "root": "نسو"}, {"id": 16, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 17, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 18, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 19, "arabic": "ٱلْمُفْسِدِينَ", "translit": "َnyِdِsْfُmْlٱ", "root": "فسد"}], "hasIhya": false}, {"ayah": 5, "text": "وَنُرِيدُ أَن نَّمُنَّ عَلَى ٱلَّذِينَ ٱسْتُضْعِفُوا۟ فِى ٱلْأَرْضِ وَنَجْعَلَهُمْ أَئِمَّةً وَنَجْعَلَهُمُ ٱلْوَٰرِثِينَ ", "translation": "And We wanted to confer favor upon those who were oppressed in the land and make them leaders and make them inheritors", "words": [{"id": 1, "arabic": "وَنُرِيدُ", "translit": "ُdyِrُnَw", "root": "رود"}, {"id": 2, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 3, "arabic": "نَّمُنَّ", "translit": "َّnُmَّn", "root": "منن"}, {"id": 4, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "ٱسْتُضْعِفُوا۟", "translit": "۟āwُfِʿعْḍُtْsٱ", "root": "ضعف"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "وَنَجْعَلَهُمْ", "translit": "ْmُhَlَʿعْjgَnَw", "root": "جعل"}, {"id": 10, "arabic": "أَئِمَّةً", "translit": "ًẗَّmِyʾَaʾ", "root": "امم"}, {"id": 11, "arabic": "وَنَجْعَلَهُمُ", "translit": "ُmُhَlَʿعْjgَnَw", "root": "جعل"}, {"id": 12, "arabic": "ٱلْوَٰرِثِينَ", "translit": "َnyِhtِrَٰwْlٱ", "root": "ورث"}], "hasIhya": false}, {"ayah": 6, "text": "وَنُمَكِّنَ لَهُمْ فِى ٱلْأَرْضِ وَنُرِىَ فِرْعَوْنَ وَهَٰمَٰنَ وَجُنُودَهُمَا مِنْهُم مَّا كَانُوا۟ يَحْذَرُونَ ", "translation": "And establish them in the land and show Pharaoh and [his minister] Hāmān and their soldiers through them[1] that which they had feared.", "words": [{"id": 1, "arabic": "وَنُمَكِّنَ", "translit": "َnِّkَmُnَw", "root": "مكن"}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 5, "arabic": "وَنُرِىَ", "translit": "َàِrُnَw", "root": "راي"}, {"id": 6, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 7, "arabic": "وَهَٰمَٰنَ", "translit": "َnَٰmَٰhَw", "root": ""}, {"id": 8, "arabic": "وَجُنُودَهُمَا", "translit": "āَmُhَdwُnُjgَw", "root": "جند"}, {"id": 9, "arabic": "مِنْهُم", "translit": "mُhْnِm", "root": ""}, {"id": 10, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 11, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 12, "arabic": "يَحْذَرُونَ", "translit": "َnwُrَhdْḥَy", "root": "حذر"}], "hasIhya": false}, {"ayah": 7, "text": "وَأَوْحَيْنَآ إِلَىٰٓ أُمِّ مُوسَىٰٓ أَنْ أَرْضِعِيهِۖ فَإِذَا خِفْتِ عَلَيْهِ فَأَلْقِيهِ فِى ٱلْيَمِّ وَلَا تَخَافِى وَلَا تَحْزَنِىٓۖ إِنَّا رَآدُّوهُ إِلَيْكِ وَجَاعِلُوهُ مِنَ ٱلْمُرْسَلِينَ ", "translation": "And We inspired to the mother of Moses, \"Suckle him; but when you fear for him, cast him into the river and do not fear and do not grieve. Indeed, We will return him to you and will make him [one] of the messengers.\"", "words": [{"id": 1, "arabic": "وَأَوْحَيْنَآ", "translit": "ٓāَnْyَḥْwَaʾَw", "root": "وحي"}, {"id": 2, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 3, "arabic": "أُمِّ", "translit": "ِّmُaʾ", "root": "امم"}, {"id": 4, "arabic": "مُوسَىٰٓ", "translit": "ٰٓàَswُm", "root": ""}, {"id": 5, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 6, "arabic": "أَرْضِعِيهِ", "translit": "ِhyِʿعِḍْrَaʾ", "root": "رضع"}, {"id": 7, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 8, "arabic": "خِفْتِ", "translit": "ِtْfِhk", "root": "خوف"}, {"id": 9, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 10, "arabic": "فَأَلْقِيهِ", "translit": "ِhyِqْlَaʾَf", "root": "لقي"}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ٱلْيَمِّ", "translit": "ِّmَyْlٱ", "root": "يمم"}, {"id": 13, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 14, "arabic": "تَخَافِى", "translit": "àِfāَhkَt", "root": "خوف"}, {"id": 15, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 16, "arabic": "تَحْزَنِىٓ", "translit": "ٓàِnَzْḥَt", "root": "حزن"}, {"id": 17, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 18, "arabic": "رَآدُّوهُ", "translit": "ُhwُّdٓāَr", "root": "ردد"}, {"id": 19, "arabic": "إِلَيْكِ", "translit": "ِkْyَlِiʾ", "root": ""}, {"id": 20, "arabic": "وَجَاعِلُوهُ", "translit": "ُhwُlِʿعāَjgَw", "root": "جعل"}, {"id": 21, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 22, "arabic": "ٱلْمُرْسَلِينَ", "translit": "َnyِlَsْrُmْlٱ", "root": "رسل"}], "hasIhya": false}, {"ayah": 8, "text": "فَٱلْتَقَطَهُۥٓ ءَالُ فِرْعَوْنَ لِيَكُونَ لَهُمْ عَدُوًّا وَحَزَنًاۗ إِنَّ فِرْعَوْنَ وَهَٰمَٰنَ وَجُنُودَهُمَا كَانُوا۟ خَٰطِـِٔينَ ", "translation": "And the family of Pharaoh picked him up [out of the river] so that he would become to them an enemy and a [cause of] grief. Indeed, Pharaoh and Hāmān and their soldiers were deliberate sinners.", "words": [{"id": 1, "arabic": "فَٱلْتَقَطَهُۥٓ", "translit": "ٓۥُhَṭَqَtْlٱَf", "root": "لقط"}, {"id": 2, "arabic": "ءَالُ", "translit": "ُlāَء", "root": "اول"}, {"id": 3, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 4, "arabic": "لِيَكُونَ", "translit": "َnwُkَyِl", "root": "كون"}, {"id": 5, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 6, "arabic": "عَدُوًّا", "translit": "āًّwُdَʿع", "root": "عدو"}, {"id": 7, "arabic": "وَحَزَنًا", "translit": "āًnَzَḥَw", "root": "حزن"}, {"id": 8, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 9, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 10, "arabic": "وَهَٰمَٰنَ", "translit": "َnَٰmَٰhَw", "root": ""}, {"id": 11, "arabic": "وَجُنُودَهُمَا", "translit": "āَmُhَdwُnُjgَw", "root": "جند"}, {"id": 12, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 13, "arabic": "خَٰطِـِٔينَ", "translit": "َnyِٔـِṭَٰhk", "root": "خطا"}], "hasIhya": false}, {"ayah": 9, "text": "وَقَالَتِ ٱمْرَأَتُ فِرْعَوْنَ قُرَّتُ عَيْنٍ لِّى وَلَكَۖ لَا تَقْتُلُوهُ عَسَىٰٓ أَن يَنفَعَنَآ أَوْ نَتَّخِذَهُۥ وَلَدًا وَهُمْ لَا يَشْعُرُونَ ", "translation": "And the wife of Pharaoh said, \"[He will be] a comfort of the eye [i.e., pleasure] for me and for you. Do not kill him; perhaps he may benefit us, or we may adopt him as a son.\" And they perceived not.[1]", "words": [{"id": 1, "arabic": "وَقَالَتِ", "translit": "ِtَlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱمْرَأَتُ", "translit": "ُtَaʾَrْmٱ", "root": "مرا"}, {"id": 3, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 4, "arabic": "قُرَّتُ", "translit": "ُtَّrُq", "root": "قرر"}, {"id": 5, "arabic": "عَيْنٍ", "translit": "ٍnْyَʿع", "root": "عين"}, {"id": 6, "arabic": "لِّى", "translit": "àِّl", "root": ""}, {"id": 7, "arabic": "وَلَكَ", "translit": "َkَlَw", "root": ""}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "تَقْتُلُوهُ", "translit": "ُhwُlُtْqَt", "root": "قتل"}, {"id": 10, "arabic": "عَسَىٰٓ", "translit": "ٰٓàَsَʿع", "root": "عسي"}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "يَنفَعَنَآ", "translit": "ٓāَnَʿعَfnَy", "root": "نفع"}, {"id": 13, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 14, "arabic": "نَتَّخِذَهُۥ", "translit": "ۥُhَhdِhkَّtَn", "root": "اخذ"}, {"id": 15, "arabic": "وَلَدًا", "translit": "āًdَlَw", "root": "ولد"}, {"id": 16, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 17, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 18, "arabic": "يَشْعُرُونَ", "translit": "َnwُrُʿعْhsَy", "root": "شعر"}], "hasIhya": false}, {"ayah": 10, "text": "وَأَصْبَحَ فُؤَادُ أُمِّ مُوسَىٰ فَٰرِغًاۖ إِن كَادَتْ لَتُبْدِى بِهِۦ لَوْلَآ أَن رَّبَطْنَا عَلَىٰ قَلْبِهَا لِتَكُونَ مِنَ ٱلْمُؤْمِنِينَ ", "translation": "And the heart of Moses' mother became empty [of all else]. She was about to disclose [the matter concerning] him had We not bound fast her heart that she would be of the believers.", "words": [{"id": 1, "arabic": "وَأَصْبَحَ", "translit": "َḥَbْṣَaʾَw", "root": "صبح"}, {"id": 2, "arabic": "فُؤَادُ", "translit": "ُdāَwʾُf", "root": "فاد"}, {"id": 3, "arabic": "أُمِّ", "translit": "ِّmُaʾ", "root": "امم"}, {"id": 4, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 5, "arabic": "فَٰرِغًا", "translit": "āًغِrَٰf", "root": "فرغ"}, {"id": 6, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 7, "arabic": "كَادَتْ", "translit": "ْtَdāَk", "root": "كود"}, {"id": 8, "arabic": "لَتُبْدِى", "translit": "àِdْbُtَl", "root": "بدو"}, {"id": 9, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 10, "arabic": "لَوْلَآ", "translit": "ٓāَlْwَl", "root": ""}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "رَّبَطْنَا", "translit": "āَnْṭَbَّr", "root": "ربط"}, {"id": 13, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 14, "arabic": "قَلْبِهَا", "translit": "āَhِbْlَq", "root": "قلب"}, {"id": 15, "arabic": "لِتَكُونَ", "translit": "َnwُkَtِl", "root": "كون"}, {"id": 16, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 17, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}], "hasIhya": false}, {"ayah": 11, "text": "وَقَالَتْ لِأُخْتِهِۦ قُصِّيهِۖ فَبَصُرَتْ بِهِۦ عَن جُنُبٍ وَهُمْ لَا يَشْعُرُونَ ", "translation": "And she said to his sister, \"Follow him\"; so she watched him from a distance while they perceived not.", "words": [{"id": 1, "arabic": "وَقَالَتْ", "translit": "ْtَlāَqَw", "root": "قول"}, {"id": 2, "arabic": "لِأُخْتِهِۦ", "translit": "ۦِhِtْhkُaʾِl", "root": "اخو"}, {"id": 3, "arabic": "قُصِّيهِ", "translit": "ِhyِّṣُq", "root": "قصص"}, {"id": 4, "arabic": "فَبَصُرَتْ", "translit": "ْtَrُṣَbَf", "root": "بصر"}, {"id": 5, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 6, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 7, "arabic": "جُنُبٍ", "translit": "ٍbُnُjg", "root": "جنب"}, {"id": 8, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "يَشْعُرُونَ", "translit": "َnwُrُʿعْhsَy", "root": "شعر"}], "hasIhya": false}, {"ayah": 12, "text": "وَحَرَّمْنَا عَلَيْهِ ٱلْمَرَاضِعَ مِن قَبْلُ فَقَالَتْ هَلْ أَدُلُّكُمْ عَلَىٰٓ أَهْلِ بَيْتٍ يَكْفُلُونَهُۥ لَكُمْ وَهُمْ لَهُۥ نَٰصِحُونَ ", "translation": "And We had prevented from him [all] wet nurses before,[1] so she said, \"Shall I direct you to a household that will be responsible for him for you while they are to him [for his upbringing] sincere?\"", "words": [{"id": 1, "arabic": "وَحَرَّمْنَا", "translit": "āَnْmَّrَḥَw", "root": "حرم"}, {"id": 2, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلْمَرَاضِعَ", "translit": "َʿعِḍāَrَmْlٱ", "root": "رضع"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 6, "arabic": "فَقَالَتْ", "translit": "ْtَlāَqَf", "root": "قول"}, {"id": 7, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 8, "arabic": "أَدُلُّكُمْ", "translit": "ْmُkُّlُdَaʾ", "root": "دلل"}, {"id": 9, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 10, "arabic": "أَهْلِ", "translit": "ِlْhَaʾ", "root": "اهل"}, {"id": 11, "arabic": "بَيْتٍ", "translit": "ٍtْyَb", "root": "بيت"}, {"id": 12, "arabic": "يَكْفُلُونَهُۥ", "translit": "ۥُhَnwُlُfْkَy", "root": "كفل"}, {"id": 13, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 14, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 15, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 16, "arabic": "نَٰصِحُونَ", "translit": "َnwُḥِṣَٰn", "root": "نصح"}], "hasIhya": false}, {"ayah": 13, "text": "فَرَدَدْنَٰهُ إِلَىٰٓ أُمِّهِۦ كَىْ تَقَرَّ عَيْنُهَا وَلَا تَحْزَنَ وَلِتَعْلَمَ أَنَّ وَعْدَ ٱللَّهِ حَقٌّ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ ", "translation": "So We restored him to his mother that she might be content and not grieve and that she would know that the promise of Allāh is true. But most of them [i.e., the people] do not know.", "words": [{"id": 1, "arabic": "فَرَدَدْنَٰهُ", "translit": "ُhَٰnْdَdَrَf", "root": "ردد"}, {"id": 2, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 3, "arabic": "أُمِّهِۦ", "translit": "ۦِhِّmُaʾ", "root": "امم"}, {"id": 4, "arabic": "كَىْ", "translit": "ْàَk", "root": ""}, {"id": 5, "arabic": "تَقَرَّ", "translit": "َّrَqَt", "root": "قرر"}, {"id": 6, "arabic": "عَيْنُهَا", "translit": "āَhُnْyَʿع", "root": "عين"}, {"id": 7, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 8, "arabic": "تَحْزَنَ", "translit": "َnَzْḥَt", "root": "حزن"}, {"id": 9, "arabic": "وَلِتَعْلَمَ", "translit": "َmَlْʿعَtِlَw", "root": "علم"}, {"id": 10, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 11, "arabic": "وَعْدَ", "translit": "َdْʿعَw", "root": "وعد"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "حَقٌّ", "translit": "ٌّqَḥ", "root": "حقق"}, {"id": 14, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 15, "arabic": "أَكْثَرَهُمْ", "translit": "ْmُhَrَhtْkَaʾ", "root": "كثر"}, {"id": 16, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 17, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 14, "text": "وَلَمَّا بَلَغَ أَشُدَّهُۥ وَٱسْتَوَىٰٓ ءَاتَيْنَٰهُ حُكْمًا وَعِلْمًاۚ وَكَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ ", "translation": "And when he attained his full strength and was [mentally] mature, We bestowed upon him judgement and knowledge. And thus do We reward the doers of good.", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 2, "arabic": "بَلَغَ", "translit": "َغَlَb", "root": "بلغ"}, {"id": 3, "arabic": "أَشُدَّهُۥ", "translit": "ۥُhَّdُhsَaʾ", "root": "شدد"}, {"id": 4, "arabic": "وَٱسْتَوَىٰٓ", "translit": "ٰٓàَwَtْsٱَw", "root": "سوي"}, {"id": 5, "arabic": "ءَاتَيْنَٰهُ", "translit": "ُhَٰnْyَtāَء", "root": "اتي"}, {"id": 6, "arabic": "حُكْمًا", "translit": "āًmْkُḥ", "root": "حكم"}, {"id": 7, "arabic": "وَعِلْمًا", "translit": "āًmْlِʿعَw", "root": "علم"}, {"id": 8, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 9, "arabic": "نَجْزِى", "translit": "àِzْjgَn", "root": "جزي"}, {"id": 10, "arabic": "ٱلْمُحْسِنِينَ", "translit": "َnyِnِsْḥُmْlٱ", "root": "حسن"}], "hasIhya": false}, {"ayah": 15, "text": "وَدَخَلَ ٱلْمَدِينَةَ عَلَىٰ حِينِ غَفْلَةٍ مِّنْ أَهْلِهَا فَوَجَدَ فِيهَا رَجُلَيْنِ يَقْتَتِلَانِ هَٰذَا مِن شِيعَتِهِۦ وَهَٰذَا مِنْ عَدُوِّهِۦۖ فَٱسْتَغَٰثَهُ ٱلَّذِى مِن شِيعَتِهِۦ عَلَى ٱلَّذِى مِنْ عَدُوِّهِۦ فَوَكَزَهُۥ مُوسَىٰ فَقَضَىٰ عَلَيْهِۖ قَالَ هَٰذَا مِنْ عَمَلِ ٱلشَّيْطَٰنِۖ إِنَّهُۥ عَدُوٌّ مُّضِلٌّ مُّبِينٌ ", "translation": "And he entered the city at a time of inattention by its people[1] and found therein two men fighting: one from his faction and one from among his enemy. And the one from his faction called for help to him against the one from his enemy, so Moses struck him and [unintentionally] killed him. [Moses] said, \"This is from the work of Satan. Indeed, he is a manifest, misleading enemy.\"", "words": [{"id": 1, "arabic": "وَدَخَلَ", "translit": "َlَhkَdَw", "root": "دخل"}, {"id": 2, "arabic": "ٱلْمَدِينَةَ", "translit": "َẗَnyِdَmْlٱ", "root": "مدن"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "حِينِ", "translit": "ِnyِḥ", "root": "حين"}, {"id": 5, "arabic": "غَفْلَةٍ", "translit": "ٍẗَlْfَغ", "root": "غفل"}, {"id": 6, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 7, "arabic": "أَهْلِهَا", "translit": "āَhِlْhَaʾ", "root": "اهل"}, {"id": 8, "arabic": "فَوَجَدَ", "translit": "َdَjgَwَf", "root": "وجد"}, {"id": 9, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 10, "arabic": "رَجُلَيْنِ", "translit": "ِnْyَlُjgَr", "root": "رجل"}, {"id": 11, "arabic": "يَقْتَتِلَانِ", "translit": "ِnāَlِtَtْqَy", "root": "قتل"}, {"id": 12, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "شِيعَتِهِۦ", "translit": "ۦِhِtَʿعyِhs", "root": "شيع"}, {"id": 15, "arabic": "وَهَٰذَا", "translit": "āَhdَٰhَw", "root": ""}, {"id": 16, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 17, "arabic": "عَدُوِّهِۦ", "translit": "ۦِhِّwُdَʿع", "root": "عدو"}, {"id": 18, "arabic": "فَٱسْتَغَٰثَهُ", "translit": "ُhَhtَٰغَtْsٱَf", "root": "غوث"}, {"id": 19, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 20, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 21, "arabic": "شِيعَتِهِۦ", "translit": "ۦِhِtَʿعyِhs", "root": "شيع"}, {"id": 22, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 23, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 24, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 25, "arabic": "عَدُوِّهِۦ", "translit": "ۦِhِّwُdَʿع", "root": "عدو"}, {"id": 26, "arabic": "فَوَكَزَهُۥ", "translit": "ۥُhَzَkَwَf", "root": "وكز"}, {"id": 27, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 28, "arabic": "فَقَضَىٰ", "translit": "ٰàَḍَqَf", "root": "قضي"}, {"id": 29, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 30, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 31, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 32, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 33, "arabic": "عَمَلِ", "translit": "ِlَmَʿع", "root": "عمل"}, {"id": 34, "arabic": "ٱلشَّيْطَٰنِ", "translit": "ِnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 35, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 36, "arabic": "عَدُوٌّ", "translit": "ٌّwُdَʿع", "root": "عدو"}, {"id": 37, "arabic": "مُّضِلٌّ", "translit": "ٌّlِḍُّm", "root": "ضلل"}, {"id": 38, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": true}, {"ayah": 16, "text": "قَالَ رَبِّ إِنِّى ظَلَمْتُ نَفْسِى فَٱغْفِرْ لِى فَغَفَرَ لَهُۥٓۚ إِنَّهُۥ هُوَ ٱلْغَفُورُ ٱلرَّحِيمُ ", "translation": "He said, \"My Lord, indeed I have wronged myself, so forgive me,\" and He forgave him. Indeed, He is the Forgiving, the Merciful.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 3, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 4, "arabic": "ظَلَمْتُ", "translit": "ُtْmَlَẓ", "root": "ظلم"}, {"id": 5, "arabic": "نَفْسِى", "translit": "àِsْfَn", "root": "نفس"}, {"id": 6, "arabic": "فَٱغْفِرْ", "translit": "ْrِfْغٱَf", "root": "غفر"}, {"id": 7, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 8, "arabic": "فَغَفَرَ", "translit": "َrَfَغَf", "root": "غفر"}, {"id": 9, "arabic": "لَهُۥٓ", "translit": "ٓۥُhَl", "root": ""}, {"id": 10, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 11, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 12, "arabic": "ٱلْغَفُورُ", "translit": "ُrwُfَغْlٱ", "root": "غفر"}, {"id": 13, "arabic": "ٱلرَّحِيمُ", "translit": "ُmyِḥَّrlٱ", "root": "رحم"}], "hasIhya": true}, {"ayah": 17, "text": "قَالَ رَبِّ بِمَآ أَنْعَمْتَ عَلَىَّ فَلَنْ أَكُونَ ظَهِيرًا لِّلْمُجْرِمِينَ ", "translation": "He said, \"My Lord, for the favor You bestowed upon me, I will never be an assistant to the criminals.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 3, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 4, "arabic": "أَنْعَمْتَ", "translit": "َtْmَʿعْnَaʾ", "root": "نعم"}, {"id": 5, "arabic": "عَلَىَّ", "translit": "َّàَlَʿع", "root": ""}, {"id": 6, "arabic": "فَلَنْ", "translit": "ْnَlَf", "root": ""}, {"id": 7, "arabic": "أَكُونَ", "translit": "َnwُkَaʾ", "root": "كون"}, {"id": 8, "arabic": "ظَهِيرًا", "translit": "āًryِhَẓ", "root": "ظهر"}, {"id": 9, "arabic": "لِّلْمُجْرِمِينَ", "translit": "َnyِmِrْjgُmْlِّl", "root": "جرم"}], "hasIhya": false}, {"ayah": 18, "text": "فَأَصْبَحَ فِى ٱلْمَدِينَةِ خَآئِفًا يَتَرَقَّبُ فَإِذَا ٱلَّذِى ٱسْتَنصَرَهُۥ بِٱلْأَمْسِ يَسْتَصْرِخُهُۥۚ قَالَ لَهُۥ مُوسَىٰٓ إِنَّكَ لَغَوِىٌّ مُّبِينٌ ", "translation": "And he became inside the city fearful and anticipating [exposure], when suddenly the one who sought his help the previous day cried out to him [once again]. Moses said to him, \"Indeed, you are an evident, [persistent] deviator.\"", "words": [{"id": 1, "arabic": "فَأَصْبَحَ", "translit": "َḥَbْṣَaʾَf", "root": "صبح"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ٱلْمَدِينَةِ", "translit": "ِẗَnyِdَmْlٱ", "root": "مدن"}, {"id": 4, "arabic": "خَآئِفًا", "translit": "āًfِyʾٓāَhk", "root": "خوف"}, {"id": 5, "arabic": "يَتَرَقَّبُ", "translit": "ُbَّqَrَtَy", "root": "رقب"}, {"id": 6, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 7, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "ٱسْتَنصَرَهُۥ", "translit": "ۥُhَrَṣnَtْsٱ", "root": "نصر"}, {"id": 9, "arabic": "بِٱلْأَمْسِ", "translit": "ِsْmَaʾْlٱِb", "root": ""}, {"id": 10, "arabic": "يَسْتَصْرِخُهُۥ", "translit": "ۥُhُhkِrْṣَtْsَy", "root": "صرخ"}, {"id": 11, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 12, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 13, "arabic": "مُوسَىٰٓ", "translit": "ٰٓàَswُm", "root": ""}, {"id": 14, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 15, "arabic": "لَغَوِىٌّ", "translit": "ٌّàِwَغَl", "root": "غوي"}, {"id": 16, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 19, "text": "فَلَمَّآ أَنْ أَرَادَ أَن يَبْطِشَ بِٱلَّذِى هُوَ عَدُوٌّ لَّهُمَا قَالَ يَٰمُوسَىٰٓ أَتُرِيدُ أَن تَقْتُلَنِى كَمَا قَتَلْتَ نَفْسًۢا بِٱلْأَمْسِۖ إِن تُرِيدُ إِلَّآ أَن تَكُونَ جَبَّارًا فِى ٱلْأَرْضِ وَمَا تُرِيدُ أَن تَكُونَ مِنَ ٱلْمُصْلِحِينَ ", "translation": "And when he wanted to strike the one who was an enemy to both of them, he[1] said, \"O Moses, do you intend to kill me as you killed someone yesterday? You only want to be a tyrant in the land and do not want to be of the amenders.\"", "words": [{"id": 1, "arabic": "فَلَمَّآ", "translit": "ٓāَّmَlَf", "root": ""}, {"id": 2, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 3, "arabic": "أَرَادَ", "translit": "َdāَrَaʾ", "root": "رود"}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يَبْطِشَ", "translit": "َhsِṭْbَy", "root": "بطش"}, {"id": 6, "arabic": "بِٱلَّذِى", "translit": "àِhdَّlٱِb", "root": ""}, {"id": 7, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 8, "arabic": "عَدُوٌّ", "translit": "ٌّwُdَʿع", "root": "عدو"}, 