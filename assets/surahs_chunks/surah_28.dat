َطَاوَلَ عَلَيْهِمُ ٱلْعُمُرُۚ وَمَا كُنتَ ثَاوِيًا فِىٓ أَهْلِ مَدْيَنَ تَتْلُوا۟ عَلَيْهِمْ ءَايَٰتِنَا وَلَٰكِنَّا كُنَّا مُرْسِلِينَ ", "translation": "But We produced [many] generations [after Moses], and prolonged was their duration.[1] And you were not a resident among the people of Madyan, reciting to them Our verses, but We were senders [of this message].[2]", "words": [{"id": 1, "arabic": "وَلَٰكِنَّآ", "translit": "ٓāَّnِkَٰlَw", "root": ""}, {"id": 2, "arabic": "أَنشَأْنَا", "translit": "āَnْaʾَhsnَaʾ", "root": "نشا"}, {"id": 3, "arabic": "قُرُونًا", "translit": "āًnwُrُq", "root": "قرن"}, {"id": 4, "arabic": "فَتَطَاوَلَ", "translit": "َlَwāَṭَtَf", "root": "طول"}, {"id": 5, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلْعُمُرُ", "translit": "ُrُmُʿعْlٱ", "root": "عمر"}, {"id": 7, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 8, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 9, "arabic": "ثَاوِيًا", "translit": "āًyِwāَht", "root": "ثوي"}, {"id": 10, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 11, "arabic": "أَهْلِ", "translit": "ِlْhَaʾ", "root": "اهل"}, {"id": 12, "arabic": "مَدْيَنَ", "translit": "َnَyْdَm", "root": "مدن"}, {"id": 13, "arabic": "تَتْلُوا۟", "translit": "۟āwُlْtَt", "root": "تلو"}, {"id": 14, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 15, "arabic": "ءَايَٰتِنَا", "translit": "āَnِtَٰyāَء", "root": "ايي"}, {"id": 16, "arabic": "وَلَٰكِنَّا", "translit": "āَّnِkَٰlَw", "root": ""}, {"id": 17, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 18, "arabic": "مُرْسِلِينَ", "translit": "َnyِlِsْrُm", "root": "رسل"}], "hasIhya": false}, {"ayah": 46, "text": "وَمَا كُنتَ بِجَانِبِ ٱلطُّورِ إِذْ نَادَيْنَا وَلَٰكِن رَّحْمَةً مِّن رَّبِّكَ لِتُنذِرَ قَوْمًا مَّآ أَتَىٰهُم مِّن نَّذِيرٍ مِّن قَبْلِكَ لَعَلَّهُمْ يَتَذَكَّرُونَ ", "translation": "And you were not at the side of the mount when We called [Moses] but [were sent] as a mercy from your Lord to warn a people to whom no warner had come before you that they might be reminded.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 3, "arabic": "بِجَانِبِ", "translit": "ِbِnāَjgِb", "root": "جنب"}, {"id": 4, "arabic": "ٱلطُّورِ", "translit": "ِrwُّṭlٱ", "root": "طور"}, {"id": 5, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 6, "arabic": "نَادَيْنَا", "translit": "āَnْyَdāَn", "root": "ندي"}, {"id": 7, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 8, "arabic": "رَّحْمَةً", "translit": "ًẗَmْḥَّr", "root": "رحم"}, {"id": 9, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 10, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 11, "arabic": "لِتُنذِرَ", "translit": "َrِhdnُtِl", "root": "نذر"}, {"id": 12, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 13, "arabic": "مَّآ", "translit": "ٓāَّm", "root": ""}, {"id": 14, "arabic": "أَتَىٰهُم", "translit": "mُhٰàَtَaʾ", "root": "اتي"}, {"id": 15, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 16, "arabic": "نَّذِيرٍ", "translit": "ٍryِhdَّn", "root": "نذر"}, {"id": 17, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 18, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 19, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 20, "arabic": "يَتَذَكَّرُونَ", "translit": "َnwُrَّkَhdَtَy", "root": "ذكر"}], "hasIhya": false}, {"ayah": 47, "text": "وَلَوْلَآ أَن تُصِيبَهُم مُّصِيبَةٌۢ بِمَا قَدَّمَتْ أَيْدِيهِمْ فَيَقُولُوا۟ رَبَّنَا لَوْلَآ أَرْسَلْتَ إِلَيْنَا رَسُولًا فَنَتَّبِعَ ءَايَٰتِكَ وَنَكُونَ مِنَ ٱلْمُؤْمِنِينَ ", "translation": "And if not that a disaster should strike them for what their hands put forth [of sins] and they would say, \"Our Lord, why did You not send us a messenger so we could have followed Your verses and been among the believers?\"...[1]", "words": [{"id": 1, "arabic": "وَلَوْلَآ", "translit": "ٓāَlْwَlَw", "root": ""}, {"id": 2, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 3, "arabic": "تُصِيبَهُم", "translit": "mُhَbyِṣُt", "root": "صوب"}, {"id": 4, "arabic": "مُّصِيبَةٌۢ", "translit": "ٌۢẗَbyِṣُّm", "root": "صوب"}, {"id": 5, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 6, "arabic": "قَدَّمَتْ", "translit": "ْtَmَّdَq", "root": "قدم"}, {"id": 7, "arabic": "أَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾ", "root": "يدي"}, {"id": 8, "arabic": "فَيَقُولُوا۟", "translit": "۟āwُlwُqَyَf", "root": "قول"}, {"id": 9, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 10, "arabic": "لَوْلَآ", "translit": "ٓāَlْwَl", "root": ""}, {"id": 11, "arabic": "أَرْسَلْتَ", "translit": "َtْlَsْrَaʾ", "root": "رسل"}, {"id": 12, "arabic": "إِلَيْنَا", "translit": "āَnْyَlِiʾ", "root": ""}, {"id": 13, "arabic": "رَسُولًا", "translit": "āًlwُsَr", "root": "رسل"}, {"id": 14, "arabic": "فَنَتَّبِعَ", "translit": "َʿعِbَّtَnَf", "root": "تبع"}, {"id": 15, "arabic": "ءَايَٰتِكَ", "translit": "َkِtَٰyāَء", "root": "ايي"}, {"id": 16, "arabic": "وَنَكُونَ", "translit": "َnwُkَnَw", "root": "كون"}, {"id": 17, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 18, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}], "hasIhya": false}, {"ayah": 48, "text": "فَلَمَّا جَآءَهُمُ ٱلْحَقُّ مِنْ عِندِنَا قَالُوا۟ لَوْلَآ أُوتِىَ مِثْلَ مَآ أُوتِىَ مُوسَىٰٓۚ أَوَلَمْ يَكْفُرُوا۟ بِمَآ أُوتِىَ مُوسَىٰ مِن قَبْلُۖ قَالُوا۟ سِحْرَانِ تَظَٰهَرَا وَقَالُوٓا۟ إِنَّا بِكُلٍّ كَٰفِرُونَ ", "translation": "But when the truth came to them from Us, they said, \"Why was he not given like that which was given to Moses?\" Did they not disbelieve in that which was given to Moses before? They said, \"[They are but] two works of magic supporting each other,[1] and indeed we are, in both, disbelievers.\"", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "جَآءَهُمُ", "translit": "ُmُhَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 4, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 5, "arabic": "عِندِنَا", "translit": "āَnِdnِʿع", "root": "عند"}, {"id": 6, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 7, "arabic": "لَوْلَآ", "translit": "ٓāَlْwَl", "root": ""}, {"id": 8, "arabic": "أُوتِىَ", "translit": "َàِtwُaʾ", "root": "اتي"}, {"id": 9, "arabic": "مِثْلَ", "translit": "َlْhtِm", "root": "مثل"}, {"id": 10, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 11, "arabic": "أُوتِىَ", "translit": "َàِtwُaʾ", "root": "اتي"}, {"id": 12, "arabic": "مُوسَىٰٓ", "translit": "ٰٓàَswُm", "root": ""}, {"id": 13, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 14, "arabic": "يَكْفُرُوا۟", "translit": "۟āwُrُfْkَy", "root": "كفر"}, {"id": 15, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 16, "arabic": "أُوتِىَ", "translit": "َàِtwُaʾ", "root": "اتي"}, {"id": 17, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 18, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 19, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 20, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 21, "arabic": "سِحْرَانِ", "translit": "ِnāَrْḥِs", "root": "سحر"}, {"id": 22, "arabic": "تَظَٰهَرَا", "translit": "āَrَhَٰẓَt", "root": "ظهر"}, {"id": 23, "arabic": "وَقَالُوٓا۟", "translit": "۟āٓwُlāَqَw", "root": "قول"}, {"id": 24, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 25, "arabic": "بِكُلٍّ", "translit": "ٍّlُkِb", "root": "كلل"}, {"id": 26, "arabic": "كَٰفِرُونَ", "translit": "َnwُrِfَٰk", "root": "كفر"}], "hasIhya": true}, {"ayah": 49, "text": "قُلْ فَأْتُوا۟ بِكِتَٰبٍ مِّنْ عِندِ ٱللَّهِ هُوَ أَهْدَىٰ مِنْهُمَآ أَتَّبِعْهُ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "Say, \"Then bring a scripture from Allāh which is more guiding than either of them that I may follow it, if you should be truthful.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "فَأْتُوا۟", "translit": "۟āwُtْaʾَf", "root": "اتي"}, {"id": 3, "arabic": "بِكِتَٰبٍ", "translit": "ٍbَٰtِkِb", "root": "كتب"}, {"id": 4, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 5, "arabic": "عِندِ", "translit": "ِdnِʿع", "root": "عند"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 8, "arabic": "أَهْدَىٰ", "translit": "ٰàَdْhَaʾ", "root": "هدي"}, {"id": 9, "arabic": "مِنْهُمَآ", "translit": "ٓāَmُhْnِm", "root": ""}, {"id": 10, "arabic": "أَتَّبِعْهُ", "translit": "ُhْʿعِbَّtَaʾ", "root": "تبع"}, {"id": 11, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 12, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 13, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": false}, {"ayah": 50, "text": "فَإِن لَّمْ يَسْتَجِيبُوا۟ لَكَ فَٱعْلَمْ أَنَّمَا يَتَّبِعُونَ أَهْوَآءَهُمْۚ وَمَنْ أَضَلُّ مِمَّنِ ٱتَّبَعَ هَوَىٰهُ بِغَيْرِ هُدًى مِّنَ ٱللَّهِۚ إِنَّ ٱللَّهَ لَا يَهْدِى ٱلْقَوْمَ ٱلظَّٰلِمِينَ ", "translation": "But if they do not respond to you - then know that they only follow their [own] desires. And who is more astray than one who follows his desire without guidance from Allāh? Indeed, Allāh does not guide the wrongdoing people.", "words": [{"id": 1, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 2, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 3, "arabic": "يَسْتَجِيبُوا۟", "translit": "۟āwُbyِjgَtْsَy", "root": "جوب"}, {"id": 4, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 5, "arabic": "فَٱعْلَمْ", "translit": "ْmَlْʿعٱَf", "root": "علم"}, {"id": 6, "arabic": "أَنَّمَا", "translit": "āَmَّnَaʾ", "root": ""}, {"id": 7, "arabic": "يَتَّبِعُونَ", "translit": "َnwُʿعِbَّtَy", "root": "تبع"}, {"id": 8, "arabic": "أَهْوَآءَهُمْ", "translit": "ْmُhَءٓāَwْhَaʾ", "root": "هوي"}, {"id": 9, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 10, "arabic": "أَضَلُّ", "translit": "ُّlَḍَaʾ", "root": "ضلل"}, {"id": 11, "arabic": "مِمَّنِ", "translit": "ِnَّmِm", "root": ""}, {"id": 12, "arabic": "ٱتَّبَعَ", "translit": "َʿعَbَّtٱ", "root": "تبع"}, {"id": 13, "arabic": "هَوَىٰهُ", "translit": "ُhٰàَwَh", "root": "هوي"}, {"id": 14, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 15, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 16, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 19, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 21, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 22, "arabic": "ٱلْقَوْمَ", "translit": "َmْwَqْlٱ", "root": "قوم"}, {"id": 23, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": true}, {"ayah": 51, "text": "وَلَقَدْ وَصَّلْنَا لَهُمُ ٱلْقَوْلَ لَعَلَّهُمْ يَتَذَكَّرُونَ ", "translation": "And We have [repeatedly] conveyed to them the word [i.e., the Qur’ān] that they might be reminded.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "وَصَّلْنَا", "translit": "āَnْlَّṣَw", "root": "وصل"}, {"id": 3, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 4, "arabic": "ٱلْقَوْلَ", "translit": "َlْwَqْlٱ", "root": "قول"}, {"id": 5, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 6, "arabic": "يَتَذَكَّرُونَ", "translit": "َnwُrَّkَhdَtَy", "root": "ذكر"}], "hasIhya": false}, {"ayah": 52, "text": "ٱلَّذِينَ ءَاتَيْنَٰهُمُ ٱلْكِتَٰبَ مِن قَبْلِهِۦ هُم بِهِۦ يُؤْمِنُونَ ", "translation": "Those to whom We gave the Scripture before it - they[1] are believers in it.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَٰهُمُ", "translit": "ُmُhَٰnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "قَبْلِهِۦ", "translit": "ۦِhِlْbَq", "root": "قبل"}, {"id": 6, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 7, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 8, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 53, "text": "وَإِذَا يُتْلَىٰ عَلَيْهِمْ قَالُوٓا۟ ءَامَنَّا بِهِۦٓ إِنَّهُ ٱلْحَقُّ مِن رَّبِّنَآ إِنَّا كُنَّا مِن قَبْلِهِۦ مُسْلِمِينَ ", "translation": "And when it is recited to them, they say, \"We have believed in it; indeed, it is the truth from our Lord. Indeed we were, [even] before it, Muslims [i.e., submitting to Allāh].\"", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "يُتْلَىٰ", "translit": "ٰàَlْtُy", "root": "تلو"}, {"id": 3, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 5, "arabic": "ءَامَنَّا", "translit": "āَّnَmāَء", "root": "امن"}, {"id": 6, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 7, "arabic": "إِنَّهُ", "translit": "ُhَّnِiʾ", "root": ""}, {"id": 8, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "رَّبِّنَآ", "translit": "ٓāَnِّbَّr", "root": "ربب"}, {"id": 11, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 12, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "قَبْلِهِۦ", "translit": "ۦِhِlْbَq", "root": "قبل"}, {"id": 15, "arabic": "مُسْلِمِينَ", "translit": "َnyِmِlْsُm", "root": "سلم"}], "hasIhya": false}, {"ayah": 54, "text": "أُو۟لَٰٓئِكَ يُؤْتَوْنَ أَجْرَهُم مَّرَّتَيْنِ بِمَا صَبَرُوا۟ وَيَدْرَءُونَ بِٱلْحَسَنَةِ ٱلسَّيِّئَةَ وَمِمَّا رَزَقْنَٰهُمْ يُنفِقُونَ ", "translation": "Those will be given their reward twice for what they patiently endured and [because] they avert evil through good, and from what We have provided them they spend.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "يُؤْتَوْنَ", "translit": "َnْwَtْwʾُy", "root": "اتي"}, {"id": 3, "arabic": "أَجْرَهُم", "translit": "mُhَrْjgَaʾ", "root": "اجر"}, {"id": 4, "arabic": "مَّرَّتَيْنِ", "translit": "ِnْyَtَّrَّm", "root": "مرر"}, {"id": 5, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 6, "arabic": "صَبَرُوا۟", "translit": "۟āwُrَbَṣ", "root": "صبر"}, {"id": 7, "arabic": "وَيَدْرَءُونَ", "translit": "َnwُءَrْdَyَw", "root": "درا"}, {"id": 8, "arabic": "بِٱلْحَسَنَةِ", "translit": "ِẗَnَsَḥْlٱِb", "root": "حسن"}, {"id": 9, "arabic": "ٱلسَّيِّئَةَ", "translit": "َẗَyʾِّyَّslٱ", "root": "سوا"}, {"id": 10, "arabic": "وَمِمَّا", "translit": "āَّmِmَw", "root": ""}, {"id": 11, "arabic": "رَزَقْنَٰهُمْ", "translit": "ْmُhَٰnْqَzَr", "root": "رزق"}, {"id": 12, "arabic": "يُنفِقُونَ", "translit": "َnwُqِfnُy", "root": "نفق"}], "hasIhya": true}, {"ayah": 55, "text": "وَإِذَا سَمِعُوا۟ ٱللَّغْوَ أَعْرَضُوا۟ عَنْهُ وَقَالُوا۟ لَنَآ أَعْمَٰلُنَا وَلَكُمْ أَعْمَٰلُكُمْ سَلَٰمٌ عَلَيْكُمْ لَا نَبْتَغِى ٱلْجَٰهِلِينَ ", "translation": "And when they hear ill speech, they turn away from it and say, \"For us are our deeds, and for you are your deeds. Peace will be upon you;[1] we seek not the ignorant.\"", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "سَمِعُوا۟", "translit": "۟āwُʿعِmَs", "root": "سمع"}, {"id": 3, "arabic": "ٱللَّغْوَ", "translit": "َwْغَّllٱ", "root": "لغو"}, {"id": 4, "arabic": "أَعْرَضُوا۟", "translit": "۟āwُḍَrْʿعَaʾ", "root": "عرض"}, {"id": 5, "arabic": "عَنْهُ", "translit": "ُhْnَʿع", "root": ""}, {"id": 6, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 7, "arabic": "لَنَآ", "translit": "ٓāَnَl", "root": ""}, {"id": 8, "arabic": "أَعْمَٰلُنَا", "translit": "āَnُlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 9, "arabic": "وَلَكُمْ", "translit": "ْmُkَlَw", "root": ""}, {"id": 10, "arabic": "أَعْمَٰلُكُمْ", "translit": "ْmُkُlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 11, "arabic": "سَلَٰمٌ", "translit": "ٌmَٰlَs", "root": "سلم"}, {"id": 12, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 13, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 14, "arabic": "نَبْتَغِى", "translit": "àِغَtْbَn", "root": "بغي"}, {"id": 15, "arabic": "ٱلْجَٰهِلِينَ", "translit": "َnyِlِhَٰjgْlٱ", "root": "جهل"}], "hasIhya": false}, {"ayah": 56, "text": "إِنَّكَ لَا تَهْدِى مَنْ أَحْبَبْتَ وَلَٰكِنَّ ٱللَّهَ يَهْدِى مَن يَشَآءُۚ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ ", "translation": "Indeed, [O Muḥammad], you do not guide whom you like, but Allāh guides whom He wills. And He is most knowing of the [rightly] guided.", "words": [{"id": 1, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "تَهْدِى", "translit": "àِdْhَt", "root": "هدي"}, {"id": 4, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 5, "arabic": "أَحْبَبْتَ", "translit": "َtْbَbْḥَaʾ", "root": "حبب"}, {"id": 6, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 7, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 9, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 10, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 11, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 12, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 13, "arabic": "بِٱلْمُهْتَدِينَ", "translit": "َnyِdَtْhُmْlٱِb", "root": "هدي"}], "hasIhya": false}, {"ayah": 57, "text": "وَقَالُوٓا۟ إِن نَّتَّبِعِ ٱلْهُدَىٰ مَعَكَ نُتَخَطَّفْ مِنْ أَرْضِنَآۚ أَوَلَمْ نُمَكِّن لَّهُمْ حَرَمًا ءَامِنًا يُجْبَىٰٓ إِلَيْهِ ثَمَرَٰتُ كُلِّ شَىْءٍ رِّزْقًا مِّن لَّدُنَّا وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ ", "translation": "And they [i.e., the Quraysh] say, \"If we were to follow the guidance with you, we would be swept[1] from our land.\" Have We not established for them a safe sanctuary to which are brought the fruits of all things as provision from Us? But most of them do not know.", "words": [{"id": 1, "arabic": "وَقَالُوٓا۟", "translit": "۟āٓwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 3, "arabic": "نَّتَّبِعِ", "translit": "ِʿعِbَّtَّn", "root": "تبع"}, {"id": 4, "arabic": "ٱلْهُدَىٰ", "translit": "ٰàَdُhْlٱ", "root": "هدي"}, {"id": 5, "arabic": "مَعَكَ", "translit": "َkَʿعَm", "root": ""}, {"id": 6, "arabic": "نُتَخَطَّفْ", "translit": "ْfَّṭَhkَtُn", "root": "خطف"}, {"id": 7, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 8, "arabic": "أَرْضِنَآ", "translit": "ٓāَnِḍْrَaʾ", "root": "ارض"}, {"id": 9, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 10, "arabic": "نُمَكِّن", "translit": "nِّkَmُn", "root": "مكن"}, {"id": 11, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 12, "arabic": "حَرَمًا", "translit": "āًmَrَḥ", "root": "حرم"}, {"id": 13, "arabic": "ءَامِنًا", "translit": "āًnِmāَء", "root": "امن"}, {"id": 14, "arabic": "يُجْبَىٰٓ", "translit": "ٰٓàَbْjgُy", "root": "جبي"}, {"id": 15, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 16, "arabic": "ثَمَرَٰتُ", "translit": "ُtَٰrَmَht", "root": "ثمر"}, {"id": 17, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 18, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 19, "arabic": "رِّزْقًا", "translit": "āًqْzِّr", "root": "رزق"}, {"id": 20, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 21, "arabic": "لَّدُنَّا", "translit": "āَّnُdَّl", "root": "لدن"}, {"id": 22, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 23, "arabic": "أَكْثَرَهُمْ", "translit": "ْmُhَrَhtْkَaʾ", "root": "كثر"}, {"id": 24, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 25, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 58, "text": "وَكَمْ أَهْلَكْنَا مِن قَرْيَةٍۭ بَطِرَتْ مَعِيشَتَهَاۖ فَتِلْكَ مَسَٰكِنُهُمْ لَمْ تُسْكَن مِّنۢ بَعْدِهِمْ إِلَّا قَلِيلًاۖ وَكُنَّا نَحْنُ ٱلْوَٰرِثِينَ ", "translation": "And how many a city have We destroyed that was insolent in its [way of] living, and those are their dwellings which have not been inhabited after them except briefly.[1] And it is We who were the inheritors.", "words": [{"id": 1, "arabic": "وَكَمْ", "translit": "ْmَkَw", "root": ""}, {"id": 2, "arabic": "أَهْلَكْنَا", "translit": "āَnْkَlْhَaʾ", "root": "هلك"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "قَرْيَةٍۭ", "translit": "ٍۭẗَyْrَq", "root": "قري"}, {"id": 5, "arabic": "بَطِرَتْ", "translit": "ْtَrِṭَb", "root": "بطر"}, {"id": 6, "arabic": "مَعِيشَتَهَا", "translit": "āَhَtَhsyِʿعَm", "root": "عيش"}, {"id": 7, "arabic": "فَتِلْكَ", "translit": "َkْlِtَf", "root": ""}, {"id": 8, "arabic": "مَسَٰكِنُهُمْ", "translit": "ْmُhُnِkَٰsَm", "root": "سكن"}, {"id": 9, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 10, "arabic": "تُسْكَن", "translit": "nَkْsُt", "root": "سكن"}, {"id": 11, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 12, "arabic": "بَعْدِهِمْ", "translit": "ْmِhِdْʿعَb", "root": "بعد"}, {"id": 13, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 14, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 15, "arabic": "وَكُنَّا", "translit": "āَّnُkَw", "root": "كون"}, {"id": 16, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 17, "arabic": "ٱلْوَٰرِثِينَ", "translit": "َnyِhtِrَٰwْlٱ", "root": "ورث"}], "hasIhya": false}, {"ayah": 59, "text": "وَمَا كَانَ رَبُّكَ مُهْلِكَ ٱلْقُرَىٰ حَتَّىٰ يَبْعَثَ فِىٓ أُمِّهَا رَسُولًا يَتْلُوا۟ عَلَيْهِمْ ءَايَٰتِنَاۚ وَمَا كُنَّا مُهْلِكِى ٱلْقُرَىٰٓ إِلَّا وَأَهْلُهَا ظَٰلِمُونَ ", "translation": "And never would your Lord have destroyed the cities until He had sent to their mother [i.e., principal city] a messenger reciting to them Our verses. And We would not destroy the cities except while their people were wrongdoers.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 4, "arabic": "مُهْلِكَ", "translit": "َkِlْhُm", "root": "هلك"}, {"id": 5, "arabic": "ٱلْقُرَىٰ", "translit": "ٰàَrُqْlٱ", "root": "قري"}, {"id": 6, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 7, "arabic": "يَبْعَثَ", "translit": "َhtَʿعْbَy", "root": "بعث"}, {"id": 8, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 9, "arabic": "أُمِّهَا", "translit": "āَhِّmُaʾ", "root": "امم"}, {"id": 10, "arabic": "رَسُولًا", "translit": "āًlwُsَr", "root": "رسل"}, {"id": 11, "arabic": "يَتْلُوا۟", "translit": "۟āwُlْtَy", "root": "تلو"}, {"id": 12, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 13, "arabic": "ءَايَٰتِنَا", "translit": "āَnِtَٰyāَء", "root": "ايي"}, {"id": 14, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 15, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 16, "arabic": "مُهْلِكِى", "translit": "àِkِlْhُm", "root": "هلك"}, {"id": 17, "arabic": "ٱلْقُرَىٰٓ", "translit": "ٰٓàَrُqْlٱ", "root": "قري"}, {"id": 18, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 19, "arabic": "وَأَهْلُهَا", "translit": "āَhُlْhَaʾَw", "root": "اهل"}, {"id": 20, "arabic": "ظَٰلِمُونَ", "translit": "َnwُmِlَٰẓ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 60, "text": "وَمَآ أُوتِيتُم مِّن شَىْءٍ فَمَتَٰعُ ٱلْحَيَوٰةِ ٱلدُّنْيَا وَزِينَتُهَاۚ وَمَا عِندَ ٱللَّهِ خَيْرٌ وَأَبْقَىٰٓۚ أَفَلَا تَعْقِلُونَ ", "translation": "And whatever thing you [people] have been given - it is [only for] the enjoyment of worldly life and its adornment. And what is with Allāh is better and more lasting; so will you not use reason?", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أُوتِيتُم", "translit": "mُtyِtwُaʾ", "root": "اتي"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 5, "arabic": "فَمَتَٰعُ", "translit": "ُʿعَٰtَmَf", "root": "متع"}, {"id": 6, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 7, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 8, "arabic": "وَزِينَتُهَا", "translit": "āَhُtَnyِzَw", "root": "زين"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 13, "arabic": "وَأَبْقَىٰٓ", "translit": "ٰٓàَqْbَaʾَw", "root": "بقي"}, {"id": 14, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 15, "arabic": "تَعْقِلُونَ", "translit": "َnwُlِqْʿعَt", "root": "عقل"}], "hasIhya": true}, {"ayah": 61, "text": "أَفَمَن وَعَدْنَٰهُ وَعْدًا حَسَنًا فَهُوَ لَٰقِيهِ كَمَن مَّتَّعْنَٰهُ مَتَٰعَ ٱلْحَيَوٰةِ ٱلدُّنْيَا ثُمَّ هُوَ يَوْمَ ٱلْقِيَٰمَةِ مِنَ ٱلْمُحْضَرِينَ ", "translation": "Then is he whom We have promised a good promise which he will meet [i.e., obtain] like he for whom We provided enjoyment of worldly life [but] then he is, on the Day of Resurrection, among those presented [for punishment in Hell]?", "words": [{"id": 1, "arabic": "أَفَمَن", "translit": "nَmَfَaʾ", "root": ""}, {"id": 2, "arabic": "وَعَدْنَٰهُ", "translit": "ُhَٰnْdَʿعَw", "root": "وعد"}, {"id": 3, "arabic": "وَعْدًا", "translit": "āًdْʿعَw", "root": "وعد"}, {"id": 4, "arabic": "حَسَنًا", "translit": "āًnَsَḥ", "root": "حسن"}, {"id": 5, "arabic": "فَهُوَ", "translit": "َwُhَf", "root": ""}, {"id": 6, "arabic": "لَٰقِيهِ", "translit": "ِhyِqَٰl", "root": "لقي"}, {"id": 7, "arabic": "كَمَن", "translit": "nَmَk", "root": ""}, {"id": 8, "arabic": "مَّتَّعْنَٰهُ", "translit": "ُhَٰnْʿعَّtَّm", "root": "متع"}, {"id": 9, "arabic": "مَتَٰعَ", "translit": "َʿعَٰtَm", "root": "متع"}, {"id": 10, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 11, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 12, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 13, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 14, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 15, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 16, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 17, "arabic": "ٱلْمُحْضَرِينَ", "translit": "َnyِrَḍْḥُmْlٱ", "root": "حضر"}], "hasIhya": false}, {"ayah": 62, "text": "وَيَوْمَ يُنَادِيهِمْ فَيَقُولُ أَيْنَ شُرَكَآءِىَ ٱلَّذِينَ كُنتُمْ تَزْعُمُونَ ", "translation": "And [warn of] the Day He will call them and say, \"Where are My 'partners' which you used to claim?\"", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "يُنَادِيهِمْ", "translit": "ْmِhyِdāَnُy", "root": "ندي"}, {"id": 3, "arabic": "فَيَقُولُ", "translit": "ُlwُqَyَf", "root": "قول"}, {"id": 4, "arabic": "أَيْنَ", "translit": "َnْyَaʾ", "root": ""}, {"id": 5, "arabic": "شُرَكَآءِىَ", "translit": "َàِءٓāَkَrُhs", "root": "شرك"}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 8, "arabic": "تَزْعُمُونَ", "translit": "َnwُmُʿعْzَt", "root": "زعم"}], "hasIhya": false}, {"ayah": 63, "text": "قَالَ ٱلَّذِينَ حَقَّ عَلَيْهِمُ ٱلْقَوْلُ رَبَّنَا هَٰٓؤُلَآءِ ٱلَّذِينَ أَغْوَيْنَآ أَغْوَيْنَٰهُمْ كَمَا غَوَيْنَاۖ تَبَرَّأْنَآ إِلَيْكَۖ مَا كَانُوٓا۟ إِيَّانَا يَعْبُدُونَ ", "translation": "Those upon whom the word[1] will have come into effect will say, \"Our Lord, these are the ones we led to error. We led them to error just as we were in error. We declare our disassociation [from them] to You. They did not used to worship [i.e., obey] us.\"[2]", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "حَقَّ", "translit": "َّqَḥ", "root": "حقق"}, {"id": 4, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱلْقَوْلُ", "translit": "ُlْwَqْlٱ", "root": "قول"}, {"id": 6, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 7, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "أَغْوَيْنَآ", "translit": "ٓāَnْyَwْغَaʾ", "root": "غوي"}, {"id": 10, "arabic": "أَغْوَيْنَٰهُمْ", "translit": "ْmُhَٰnْyَwْغَaʾ", "root": "غوي"}, {"id": 11, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 12, "arabic": "غَوَيْنَا", "translit": "āَnْyَwَغ", "root": "غوي"}, {"id": 13, "arabic": "تَبَرَّأْنَآ", "translit": "ٓāَnْaʾَّrَbَt", "root": "برا"}, {"id": 14, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 15, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 16, "arabic": "كَانُوٓا۟", "translit": "۟āٓwُnāَk", "root": "كون"}, {"id": 17, "arabic": "إِيَّانَا", "translit": "āَnāَّyِiʾ", "root": ""}, {"id": 18, "arabic": "يَعْبُدُونَ", "translit": "َnwُdُbْʿعَy", "root": "عبد"}], "hasIhya": false}, {"ayah": 64, "text": "وَقِيلَ ٱدْعُوا۟ شُرَكَآءَكُمْ فَدَعَوْهُمْ فَلَمْ يَسْتَجِيبُوا۟ لَهُمْ وَرَأَوُا۟ ٱلْعَذَابَۚ لَوْ أَنَّهُمْ كَانُوا۟ يَهْتَدُونَ ", "translation": "And it will be said, \"Invoke your 'partners,'\" and they will invoke them; but they will not respond to them, and they will see the punishment. If only they had followed guidance!", "words": [{"id": 1, "arabic": "وَقِيلَ", "translit": "َlyِqَw", "root": "قول"}, {"id": 2, "arabic": "ٱدْعُوا۟", "translit": "۟āwُʿعْdٱ", "root": "دعو"}, {"id": 3, "arabic": "شُرَكَآءَكُمْ", "translit": "ْmُkَءٓāَkَrُhs", "root": "شرك"}, {"id": 4, "arabic": "فَدَعَوْهُمْ", "translit": "ْmُhْwَʿعَdَf", "root": "دعو"}, {"id": 5, "arabic": "فَلَمْ", "translit": "ْmَlَf", "root": ""}, {"id": 6, "arabic": "يَسْتَجِيبُوا۟", "translit": "۟āwُbyِjgَtْsَy", "root": "جوب"}, {"id": 7, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 8, "arabic": "وَرَأَوُا۟", "translit": "۟āُwَaʾَrَw", "root": "راي"}, {"id": 9, "arabic": "ٱلْعَذَابَ", "translit": "َbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 10, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 11, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 12, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 13, "arabic": "يَهْتَدُونَ", "translit": "َnwُdَtْhَy", "root": "هدي"}], "hasIhya": false}, {"ayah": 65, "text": "وَيَوْمَ يُنَادِيهِمْ فَيَقُولُ مَاذَآ أَجَبْتُمُ ٱلْمُرْسَلِينَ ", "translation": "And [mention] the Day He will call them and say, \"What did you answer the messengers?\"", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "يُنَادِيهِمْ", "translit": "ْmِhyِdāَnُy", "root": "ندي"}, {"id": 3, "arabic": "فَيَقُولُ", "translit": "ُlwُqَyَf", "root": "قول"}, {"id": 4, "arabic": "مَاذَآ", "translit": "ٓāَhdāَm", "root": ""}, {"id": 5, "arabic": "أَجَبْتُمُ", "translit": "ُmُtْbَjgَaʾ", "root": "جوب"}, {"id": 6, "arabic": "ٱلْمُرْسَلِينَ", "translit": "َnyِlَsْrُmْlٱ", "root": "رسل"}], "hasIhya": false}, {"ayah": 66, "text": "فَعَمِيَتْ عَلَيْهِمُ ٱلْأَنۢبَآءُ يَوْمَئِذٍ فَهُمْ لَا يَتَسَآءَلُونَ ", "translation": "But the information[1] will be unapparent to them that Day, so they will not [be able to] ask one another.", "words": [{"id": 1, "arabic": "فَعَمِيَتْ", "translit": "ْtَyِmَʿعَf", "root": "عمي"}, {"id": 2, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلْأَنۢبَآءُ", "translit": "ُءٓāَbۢnَaʾْlٱ", "root": "نبا"}, {"id": 4, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 5, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يَتَسَآءَلُونَ", "translit": "َnwُlَءٓāَsَtَy", "root": "سال"}], "hasIhya": false}, {"ayah": 67, "text": "فَأَمَّا مَن تَابَ وَءَامَنَ وَعَمِلَ صَٰلِحًا فَعَسَىٰٓ أَن يَكُونَ مِنَ ٱلْمُفْلِحِينَ ", "translation": "But as for one who had repented, believed, and done righteousness, it is expected [i.e., promised by Allāh] that he will be among the successful.", "words": [{"id": 1, "arabic": "فَأَمَّا", "translit": "āَّmَaʾَf", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "تَابَ", "translit": "َbāَt", "root": "توب"}, {"id": 4, "arabic": "وَءَامَنَ", "translit": "َnَmāَءَw", "root": "امن"}, {"id": 5, "arabic": "وَعَمِلَ", "translit": "َlِmَʿعَw", "root": "عمل"}, {"id": 6, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 7, "arabic": "فَعَسَىٰٓ", "translit": "ٰٓàَsَʿعَf", "root": "عسي"}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "يَكُونَ", "translit": "َnwُkَy", "root": "كون"}, {"id": 10, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 11, "arabic": "ٱلْمُفْلِحِينَ", "translit": "َnyِḥِlْfُmْlٱ", "root": "فلح"}], "hasIhya": true}, {"ayah": 68, "text": "وَرَبُّكَ يَخْلُقُ مَا يَشَآءُ وَيَخْتَارُۗ مَا كَانَ لَهُمُ ٱلْخِيَرَةُۚ سُبْحَٰنَ ٱللَّهِ وَتَعَٰلَىٰ عَمَّا يُشْرِكُونَ ", "translation": "And your Lord creates what He wills and chooses; not for them was the choice. Exalted is Allāh and high above what they associate with Him.", "words": [{"id": 1, "arabic": "وَرَبُّكَ", "translit": "َkُّbَrَw", "root": "ربب"}, {"id": 2, "arabic": "يَخْلُقُ", "translit": "ُqُlْhkَy", "root": "خلق"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 5, "arabic": "وَيَخْتَارُ", "translit": "ُrāَtْhkَyَw", "root": "خير"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 8, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 9, "arabic": "ٱلْخِيَرَةُ", "translit": "ُẗَrَyِhkْlٱ", "root": "خير"}, {"id": 10, "arabic": "سُبْحَٰنَ", "translit": "َnَٰḥْbُs", "root": "سبح"}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "وَتَعَٰلَىٰ", "translit": "ٰàَlَٰʿعَtَw", "root": "علو"}, {"id": 13, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 14, "arabic": "يُشْرِكُونَ", "translit": "َnwُkِrْhsُy", "root": "شرك"}], "hasIhya": false}, {"ayah": 69, "text": "وَرَبُّكَ يَعْلَمُ مَا تُكِنُّ صُدُورُهُمْ وَمَا يُعْلِنُونَ ", "translation": "And your Lord knows what their breasts conceal and what they declare.", "words": [{"id": 1, "arabic": "وَرَبُّكَ", "translit": "َkُّbَrَw", "root": "ربب"}, {"id": 2, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "تُكِنُّ", "translit": "ُّnِkُt", "root": "كنن"}, {"id": 5, "arabic": "صُدُورُهُمْ", "translit": "ْmُhُrwُdُṣ", "root": "صدر"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "يُعْلِنُونَ", "translit": "َnwُnِlْʿعُy", "root": "علن"}], "hasIhya": false}, {"ayah": 70, "text": "وَهُوَ ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَۖ لَهُ ٱلْحَمْدُ فِى ٱلْأُولَىٰ وَٱلْءَاخِرَةِۖ وَلَهُ ٱلْحُكْمُ وَإِلَيْهِ تُرْجَعُونَ ", "translation": "And He is Allāh; there is no deity except Him. To Him is [due all] praise in the first [life] and the Hereafter. And His is the [final] decision, and to Him you will be returned.", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 4, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 7, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 8, "arabic": "ٱلْحَمْدُ", "translit": "ُdْmَḥْlٱ", "root": "حمد"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "ٱلْأُولَىٰ", "translit": "ٰàَlwُaʾْlٱ", "root": "اول"}, {"id": 11, "arabic": "وَٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱَw", "root": "اخر"}, {"id": 12, "arabic": "وَلَهُ", "translit": "ُhَlَw", "root": ""}, {"id": 13, "arabic": "ٱلْحُكْمُ", "translit": "ُmْkُḥْlٱ", "root": "حكم"}, {"id": 14, "arabic": "وَإِلَيْهِ", "translit": "ِhْyَlِiʾَw", "root": ""}, {"id": 15, "arabic": "تُرْجَعُونَ", "translit": "َnwُʿعَjgْrُt", "root": "رجع"}], "hasIhya": true}, {"ayah": 71, "text": "قُلْ أَرَءَيْتُمْ إِن جَعَلَ ٱللَّهُ عَلَيْكُمُ ٱلَّيْلَ سَرْمَدًا إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ مَنْ إِلَٰهٌ غَيْرُ ٱللَّهِ يَأْتِيكُم بِضِيَآءٍۖ أَفَلَا تَسْمَعُونَ ", "translation": "Say, \"Have you considered:[1] if Allāh should make for you the night continuous until the Day of Resurrection, what deity other than Allāh could bring you light? Then will you not hear?\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَرَءَيْتُمْ", "translit": "ْmُtْyَءَrَaʾ", "root": "راي"}, {"id": 3, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 4, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "عَلَيْكُمُ", "translit": "ُmُkْyَlَʿع", "root": ""}, {"id": 7, "arabic": "ٱلَّيْلَ", "translit": "َlْyَّlٱ", "root": "ليل"}, {"id": 8, "arabic": "سَرْمَدًا", "translit": "āًdَmْrَs", "root": "سرمد"}, {"id": 9, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 10, "arabic": "يَوْمِ", "translit": "ِmْwَy", "root": "يوم"}, {"id": 11, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 12, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 13, "arabic": "إِلَٰهٌ", "translit": "ٌhَٰlِiʾ", "root": "اله"}, {"id": 14, "arabic": "غَيْرُ", "translit": "ُrْyَغ", "root": "غير"}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "يَأْتِيكُم", "translit": "mُkyِtْaʾَy", "root": "اتي"}, {"id": 17, "arabic": "بِضِيَآءٍ", "translit": "ٍءٓāَyِḍِb", "root": "ضوا"}, {"id": 18, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 19, "arabic": "تَسْمَعُونَ", "translit": "َnwُʿعَmْsَt", "root": "سمع"}], "hasIhya": false}, {"ayah": 72, "text": "قُلْ أَرَءَيْتُمْ إِن جَعَلَ ٱللَّهُ عَلَيْكُمُ ٱلنَّهَارَ سَرْمَدًا إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ مَنْ إِلَٰهٌ غَيْرُ ٱللَّهِ يَأْتِيكُم بِلَيْلٍ تَسْكُنُونَ فِيهِۖ أَفَلَا تُبْصِرُونَ ", "translation": "Say, \"Have you considered: if Allāh should make for you the day continuous until the Day of Resurrection, what deity other than Allāh could bring you a night in which you may rest? Then will you not see?\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَرَءَيْتُمْ", "translit": "ْmُtْyَءَrَaʾ", "root": "راي"}, {"id": 3, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 4, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "عَلَيْكُمُ", "translit": "ُmُkْyَlَʿع", "root": ""}, {"id": 7, "arabic": "ٱلنَّهَارَ", "translit": "َrāَhَّnlٱ", "root": "نهر"}, {"id": 8, "arabic": "سَرْمَدًا", "translit": "āًdَmْrَs", "root": "سرمد"}, {"id": 9, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 10, "arabic": "يَوْمِ", "translit": "ِmْwَy", "root": "يوم"}, {"id": 11, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 12, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 13, "arabic": "إِلَٰهٌ", "translit": "ٌhَٰlِiʾ", "root": "اله"}, {"id": 14, "arabic": "غَيْرُ", "translit": "ُrْyَغ", "root": "غير"}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "يَأْتِيكُم", "translit": "mُkyِtْaʾَy", "root": "اتي"}, {"id": 17, "arabic": "بِلَيْلٍ", "translit": "ٍlْyَlِb", "root": "ليل"}, {"id": 18, "arabic": "تَسْكُنُونَ", "translit": "َnwُnُkْsَt", "root": "سكن"}, {"id": 19, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 20, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 21, "arabic": "تُبْصِرُونَ", "translit": "َnwُrِṣْbُt", "root": "بصر"}], "hasIhya": false}, {"ayah": 73, "text": "وَمِن رَّحْمَتِهِۦ جَعَلَ لَكُمُ ٱلَّيْلَ وَٱلنَّهَارَ لِتَسْكُنُوا۟ فِيهِ وَلِتَبْتَغُوا۟ مِن فَضْلِهِۦ وَلَعَلَّكُمْ تَشْكُرُونَ ", "translation": "And out of His mercy He made for you the night and the day that you may rest therein and [by day] seek from His bounty and [that] perhaps you will be grateful.", "words": [{"id": 1, "arabic": "وَمِن", "translit": "nِmَw", "root": ""}, {"id": 2, "arabic": "رَّحْمَتِهِۦ", "translit": "ۦِhِtَmْḥَّr", "root": "رحم"}, {"id": 3, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 4, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 5, "arabic": "ٱلَّيْلَ", "translit": "َlْyَّlٱ", "root": "ليل"}, {"id": 6, "arabic": "وَٱلنَّهَارَ", "translit": "َrāَhَّnlٱَw", "root": "نهر"}, {"id": 7, "arabic": "لِتَسْكُنُوا۟", "translit": "۟āwُnُkْsَtِl", "root": "سكن"}, {"id": 8, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 9, "arabic": "وَلِتَبْتَغُوا۟", "translit": "۟āwُغَtْbَtِlَw", "root": "بغي"}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "فَضْلِهِۦ", "translit": "ۦِhِlْḍَf", "root": "فضل"}, {"id": 12, "arabic": "وَلَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَlَw", "root": ""}, {"id": 13, "arabic": "تَشْكُرُونَ", "translit": "َnwُrُkْhsَt", "root": "شكر"}], "hasIhya": false}, {"ayah": 74, "text": "وَيَوْمَ يُنَادِيهِمْ فَيَقُولُ أَيْنَ شُرَكَآءِىَ ٱلَّذِينَ كُنتُمْ تَزْعُمُونَ ", "translation": "And [warn of] the Day He will call them and say, \"Where are My 'partners' which you used to claim?\"", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "يُنَادِيهِمْ", "translit": "ْmِhyِdāَnُy", "root": "ندي"}, {"id": 3, "arabic": "فَيَقُولُ", "translit": "ُlwُqَyَf", "root": "قول"}, {"id": 4, "arabic": "أَيْنَ", "translit": "َnْyَaʾ", "root": ""}, {"id": 5, "arabic": "شُرَكَآءِىَ", "translit": "َàِءٓāَkَrُhs", "root": "شرك"}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 8, "arabic": "تَزْعُمُونَ", "translit": "َnwُmُʿعْzَt", "root": "زعم"}], "hasIhya": false}, {"ayah": 75, "text": "وَنَزَعْنَا مِن كُلِّ أُمَّةٍ شَهِيدًا فَقُلْنَا هَاتُوا۟ بُرْهَٰنَكُمْ فَعَلِمُوٓا۟ أَنَّ ٱلْحَقَّ لِلَّهِ وَضَلَّ عَنْهُم مَّا كَانُوا۟ يَفْتَرُونَ ", "translation": "And We will extract from every nation a witness and say, \"Produce your proof,\" and they will know that the truth belongs to Allāh, and lost from them is that which they used to invent.", "words": [{"id": 1, "arabic": "وَنَزَعْنَا", "translit": "āَnْʿعَzَnَw", "root": "نزع"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 4, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 5, "arabic": "شَهِيدًا", "translit": "āًdyِhَhs", "root": "شهد"}, {"id": 6, "arabic": "فَقُلْنَا", "translit": "āَnْlُqَf", "root": "قول"}, {"id": 7, "arabic": "هَاتُوا۟", "translit": "۟āwُtāَh", "root": "هات"}, {"id": 8, "arabic": "بُرْهَٰنَكُمْ", "translit": "ْmُkَnَٰhْrُb", "root": "برهن"}, {"id": 9, "arabic": "فَعَلِمُوٓا۟", "translit": "۟āٓwُmِlَʿعَf", "root": "علم"}, {"id": 10, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 11, "arabic": "ٱلْحَقَّ", "translit": "َّqَḥْlٱ", "root": "حقق"}, {"id": 12, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 13, "arabic": "وَضَلَّ", "translit": "َّlَḍَw", "root": "ضلل"}, {"id": 14, "arabic": "عَنْهُم", "translit": "mُhْnَʿع", "root": ""}, {"id": 15, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 16, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 17, "arabic": "يَفْتَرُونَ", "translit": "َnwُrَtْfَy", "root": "فري"}], "hasIhya": false}, {"ayah": 76, "text": "إِنَّ قَٰرُونَ كَانَ مِن قَوْمِ مُوسَىٰ فَبَغَىٰ عَلَيْهِمْۖ وَءَاتَيْنَٰهُ مِنَ ٱلْكُنُوزِ مَآ إِنَّ مَفَاتِحَهُۥ لَتَنُوٓأُ بِٱلْعُصْبَةِ أُو۟لِى ٱلْقُوَّةِ إِذْ قَالَ لَهُۥ قَوْمُهُۥ لَا تَفْرَحْۖ إِنَّ ٱللَّهَ لَا يُحِبُّ ٱلْفَرِحِينَ ", "translation": "Indeed, Qārūn was from the people of Moses, but he tyrannized them. And We gave him of treasures whose keys would burden a band of strong men; thereupon his people said to him, \"Do not exult. Indeed, Allāh does not like the exultant.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "قَٰرُونَ", "translit": "َnwُrَٰq", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "قَوْمِ", "translit": "ِmْwَq", "root": "قوم"}, {"id": 6, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 7, "arabic": "فَبَغَىٰ", "translit": "ٰàَغَbَf", "root": "بغي"}, {"id": 8, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "وَءَاتَيْنَٰهُ", "translit": "ُhَٰnْyَtāَءَw", "root": "اتي"}, {"id": 10, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 11, "arabic": "ٱلْكُنُوزِ", "translit": "ِzwُnُkْlٱ", "root": "كنز"}, {"id": 12, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 13, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 14, "arabic": "مَفَاتِحَهُۥ", "translit": "ۥُhَḥِtāَfَm", "root": "فتح"}, {"id": 15, "arabic": "لَتَنُوٓأُ", "translit": "ُaʾٓwُnَtَl", "root": "نوا"}, {"id": 16, "arabic": "بِٱلْعُصْبَةِ", "translit": "ِẗَbْṣُʿعْlٱِb", "root": "عصب"}, {"id": 17, "arabic": "أُو۟لِى", "translit": "àِl۟wُaʾ", "root": ""}, {"id": 18, "arabic": "ٱلْقُوَّةِ", "translit": "ِẗَّwُqْlٱ", "root": "قوي"}, {"id": 19, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 20, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 21, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 22, "arabic": "قَوْمُهُۥ", "translit": "ۥُhُmْwَq", "root": "قوم"}, {"id": 23, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 24, "arabic": "تَفْرَحْ", "translit": "ْḥَrْfَt", "root": "فرح"}, {"id": 25, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 26, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 27, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 28, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 29, "arabic": "ٱلْفَرِحِينَ", "translit": "َnyِḥِrَfْlٱ", "root": "فرح"}], "hasIhya": true}, {"ayah": 77, "text": "وَٱبْتَغِ فِيمَآ ءَاتَىٰكَ ٱللَّهُ ٱلدَّارَ ٱلْءَاخِرَةَۖ وَلَا تَنسَ نَصِيبَكَ مِنَ ٱلدُّنْيَاۖ وَأَحْسِن كَمَآ أَحْسَنَ ٱللَّهُ إِلَيْكَۖ وَلَا تَبْغِ ٱلْفَسَادَ فِى ٱلْأَرْضِۖ إِنَّ ٱللَّهَ لَا يُحِبُّ ٱلْمُفْسِدِينَ ", "translation": "But seek, through that which Allāh has given you, the home of the Hereafter; and [yet], do not forget your share of the world. And do good as Allāh has done good to you. And desire not corruption in the land. Indeed, Allāh does not like corrupters.\"", "words": [{"id": 1, "arabic": "وَٱبْتَغِ", "translit": "ِغَtْbٱَw", "root": "بغي"}, {"id": 2, "arabic": "فِيمَآ", "translit": "ٓāَmyِf", "root": ""}, {"id": 3, "arabic": "ءَاتَىٰكَ", "translit": "َkٰàَtāَء", "root": "اتي"}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "ٱلدَّارَ", "translit": "َrāَّdlٱ", "root": "دور"}, {"id": 6, "arabic": "ٱلْءَاخِرَةَ", "translit": "َẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 7, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 8, "arabic": "تَنسَ", "translit": "َsnَt", "root": "نسي"}, {"id": 9, "arabic": "نَصِيبَكَ", "translit": "َkَbyِṣَn", "root": "نصب"}, {"id": 10, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 11, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 12, "arabic": "وَأَحْسِن", "translit": "nِsْḥَaʾَw", "root": "حسن"}, {"id": 13, "arabic": "كَمَآ", "translit": "ٓāَmَk", "root": ""}, {"id": 14, "arabic": "أَحْسَنَ", "translit": "َnَsْḥَaʾ", "root": "حسن"}, {"id": 15, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 17, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 18, "arabic": "تَبْغِ", "translit": "ِغْbَt", "root": "بغي"}, {"id": 19, "arabic": "ٱلْفَسَادَ", "translit": "َdāَsَfْlٱ", "root": "فسد"}, {"id": 20, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 21, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 22, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 23, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 25, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 26, "arabic": "ٱلْمُفْسِدِينَ", "translit": "َnyِdِsْfُmْlٱ", "root": "فسد"}], "hasIhya": true}, {"ayah": 78, "text": "قَالَ إِنَّمَآ أُوتِيتُهُۥ عَلَىٰ عِلْمٍ عِندِىٓۚ أَوَلَمْ يَعْلَمْ أَنَّ ٱللَّهَ قَدْ أَهْلَكَ مِن قَبْلِهِۦ مِنَ ٱلْقُرُونِ مَنْ هُوَ أَشَدُّ مِنْهُ قُوَّةً وَأَكْثَرُ جَمْعًاۚ وَلَا يُسْـَٔلُ عَن ذُنُوبِهِمُ ٱلْمُجْرِمُونَ ", "translation": "He said, \"I was only given it because of knowledge I have.\" Did he not know that Allāh had destroyed before him of generations those who were greater than him in power and greater in accumulation [of wealth]? But the criminals, about their sins, will not be asked.[1]", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 3, "arabic": "أُوتِيتُهُۥ", "translit": "ۥُhُtyِtwُaʾ", "root": "اتي"}, {"id": 4, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 5, "arabic": "عِلْمٍ", "translit": "ٍmْlِʿع", "root": "علم"}, {"id": 6, "arabic": "عِندِىٓ", "translit": "ٓàِdnِʿع", "root": "عند"}, {"id": 7, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 8, "arabic": "يَعْلَمْ", "translit": "ْmَlْʿعَy", "root": "علم"}, {"id": 9, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 12, "arabic": "أَهْلَكَ", "translit": "َkَlْhَaʾ", "root": "هلك"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "قَبْلِهِۦ", "translit": "ۦِhِlْbَq", "root": "قبل"}, {"id": 15, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 16, "arabic": "ٱلْقُرُونِ", "translit": "ِnwُrُqْlٱ", "root": "قرن"}, {"id": 17, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 18, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 19, "arabic": "أَشَدُّ", "translit": "ُّdَhsَaʾ", "root": "شدد"}, {"id": 20, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 21, "arabic": "قُوَّةً", "translit": "ًẗَّwُq", "root": "قوي"}, {"id": 22, "arabic": "وَأَكْثَرُ", "translit": "ُrَhtْkَaʾَw", "root": "كثر"}, {"id": 23, "arabic": "جَمْعًا", "translit": "āًʿعْmَjg", "root": "جمع"}, {"id": 24, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 25, "arabic": "يُسْـَٔلُ", "translit": "ُlَٔـْsُy", "root": "سال"}, {"id": 26, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 27, "arabic": "ذُنُوبِهِمُ", "translit": "ُmِhِbwُnُhd", "root": "ذنب"}, {"id": 28, "arabic": "ٱلْمُجْرِمُونَ", "translit": "َnwُmِrْjgُmْlٱ", "root": "جرم"}], "hasIhya": false}, {"ayah": 79, "text": "فَخَرَجَ عَلَىٰ قَوْمِهِۦ فِى زِينَتِهِۦۖ قَالَ ٱلَّذِينَ يُرِيدُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا يَٰلَيْتَ لَنَا مِثْلَ مَآ أُوتِىَ قَٰرُونُ إِنَّهُۥ لَذُو حَظٍّ عَظِيمٍ ", "translation": "So he came out before his people in his adornment. Those who desired the worldly life said, \"Oh, would that we had like what was given to Qārūn. Indeed, he is one of great fortune.\"", "words": [{"id": 1, "arabic": "فَخَرَجَ", "translit": "َjgَrَhkَf", "root": "خرج"}, {"id": 2, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 3, "arabic": "قَوْمِهِۦ", "translit": "ۦِhِmْwَq", "root": "قوم"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "زِينَتِهِۦ", "translit": "ۦِhِtَnyِz", "root": "زين"}, {"id": 6, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 7, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "يُرِيدُونَ", "translit": "َnwُdyِrُy", "root": "رود"}, {"id": 9, "arabic": "ٱلْحَيَوٰةَ", "translit": "َẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 10, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 11, "arabic": "يَٰلَيْتَ", "translit": "َtْyَlَٰy", "root": ""}, {"id": 12, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 13, "arabic": "مِثْلَ", "translit": "َlْhtِm", "root": "مثل"}, {"id": 14, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 15, "arabic": "أُوتِىَ", "translit": "َàِtwُaʾ", "root": "اتي"}, {"id": 16, "arabic": "قَٰرُونُ", "translit": "ُnwُrَٰq", "root": ""}, {"id": 17, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 18, "arabic": "لَذُو", "translit": "wُhdَl", "root": ""}, {"id": 19, "arabic": "حَظٍّ", "translit": "ٍّẓَḥ", "root": "حظظ"}, {"id": 20, "arabic": "عَظِيمٍ", "translit": "ٍmyِẓَʿع", "root": "عظم"}], "hasIhya": true}, {"ayah": 80, "text": "وَقَالَ ٱلَّذِينَ أُوتُوا۟ ٱلْعِلْمَ وَيْلَكُمْ ثَوَابُ ٱللَّهِ خَيْرٌ لِّمَنْ ءَامَنَ وَعَمِلَ صَٰلِحًا وَلَا يُلَقَّىٰهَآ إِلَّا ٱلصَّٰبِرُونَ ", "translation": "But those who had been given knowledge said, \"Woe to you! The reward of Allāh is better for he who believes and does righteousness. And none are granted it except the patient.\"", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 4, "arabic": "ٱلْعِلْمَ", "translit": "َmْlِʿعْlٱ", "root": "علم"}, {"id": 5, "arabic": "وَيْلَكُمْ", "translit": "ْmُkَlْyَw", "root": ""}, {"id": 6, "arabic": "ثَوَابُ", "translit": "ُbāَwَht", "root": "ثوب"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 9, "arabic": "لِّمَنْ", "translit": "ْnَmِّl", "root": ""}, {"id": 10, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 11, "arabic": "وَعَمِلَ", "translit": "َlِmَʿعَw", "root": "عمل"}, {"id": 12, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 13, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 14, "arabic": "يُلَقَّىٰهَآ", "translit": "ٓāَhٰàَّqَlُy", "root": "لقي"}, {"id": 15, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 16, "arabic": "ٱلصَّٰبِرُونَ", "translit": "َnwُrِbَّٰṣlٱ", "root": "صبر"}], "hasIhya": true}, {"ayah": 81, "text": "فَخَسَفْنَا بِهِۦ وَبِدَارِهِ ٱلْأَرْضَ فَمَا كَانَ لَهُۥ مِن فِئَةٍ يَنصُرُونَهُۥ مِن دُونِ ٱللَّهِ وَمَا كَانَ مِنَ ٱلْمُنتَصِرِينَ ", "translation": "And We caused the earth to swallow him and his home. And there was for him no company to aid him other than Allāh, nor was he of those who [could] defend themselves.", "words": [{"id": 1, "arabic": "فَخَسَفْنَا", "translit": "āَnْfَsَhkَf", "root": "خسف"}, {"id": 2, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 3, "arabic": "وَبِدَارِهِ", "translit": "ِhِrāَdِbَw", "root": "دور"}, {"id": 4, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 5, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 6, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 7, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "فِئَةٍ", "translit": "ٍẗَyʾِf", "root": "فاي"}, {"id": 10, "arabic": "يَنصُرُونَهُۥ", "translit": "ۥُhَnwُrُṣnَy", "root": "نصر"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 15, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 16, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 17, "arabic": "ٱلْمُنتَصِرِينَ", "translit": "َnyِrِṣَtnُmْlٱ", "root": "نصر"}], "hasIhya": false}, {"ayah": 82, "text": "وَأَصْبَحَ ٱلَّذِينَ تَمَنَّوْا۟ مَكَانَهُۥ بِٱلْأَمْسِ يَقُولُونَ وَيْكَأَنَّ ٱللَّهَ يَبْسُطُ ٱلرِّزْقَ لِمَن يَشَآءُ مِنْ عِبَادِهِۦ وَيَقْدِرُۖ لَوْلَآ أَن مَّنَّ ٱللَّهُ عَلَيْنَا لَخَسَفَ بِنَاۖ وَيْكَأَنَّهُۥ لَا يُفْلِحُ ٱلْكَٰفِرُونَ ", "translation": "And those who had wished for his position the previous day began to say, \"Oh, how Allāh extends provision to whom He wills of His servants and restricts it! If not that Allāh had conferred favor on us, He would have caused it to swallow us. Oh, how the disbelievers do not succeed!\"", "words": [{"id": 1, "arabic": "وَأَصْبَحَ", "translit": "َḥَbْṣَaʾَw", "root": "صبح"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "تَمَنَّوْا۟", "translit": "۟āْwَّnَmَt", "root": "مني"}, {"id": 4, "arabic": "مَكَانَهُۥ", "translit": "ۥُhَnāَkَm", "root": "كون"}, {"id": 5, "arabic": "بِٱلْأَمْسِ", "translit": "ِsْmَaʾْlٱِb", "root": ""}, {"id": 6, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 7, "arabic": "وَيْكَأَنَّ", "translit": "َّnَaʾَkْyَw", "root": ""}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "يَبْسُطُ", "translit": "ُṭُsْbَy", "root": "بسط"}, {"id": 10, "arabic": "ٱلرِّزْقَ", "translit": "َqْzِّrlٱ", "root": "رزق"}, {"id": 11, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 12, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 13, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 14, "arabic": "عِبَادِهِۦ", "translit": "ۦِhِdāَbِʿع", "root": "عبد"}, {"id": 15, "arabic": "وَيَقْدِرُ", "translit": "ُrِdْqَyَw", "root": "قدر"}, {"id": 16, "arabic": "لَوْلَآ", "translit": "ٓāَlْwَl", "root": ""}, {"id": 17, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 18, "arabic": "مَّنَّ", "translit": "َّnَّm", "root": "منن"}, {"id": 19, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "عَلَيْنَا", "translit": "āَnْyَlَʿع", "root": ""}, {"id": 21, "arabic": "لَخَسَفَ", "translit": "َfَsَhkَl", "root": "خسف"}, {"id": 22, "arabic": "بِنَا", "translit": "āَnِb", "root": ""}, {"id": 23, "arabic": "وَيْكَأَنَّهُۥ", "translit": "ۥُhَّnَaʾَkْyَw", "root": ""}, {"id": 24, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 25, "arabic": "يُفْلِحُ", "translit": "ُḥِlْfُy", "root": "فلح"}, {"id": 26, "arabic": "ٱلْكَٰفِرُونَ", "translit": "َnwُrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": false}, {"ayah": 83, "text": "تِلْكَ ٱلدَّارُ ٱلْءَاخِرَةُ نَجْعَلُهَا لِلَّذِينَ لَا يُرِيدُونَ عُلُوًّا فِى ٱلْأَرْضِ وَلَا فَسَادًاۚ وَٱلْعَٰقِبَةُ لِلْمُتَّقِينَ ", "translation": "That home of the Hereafter We assign to those who do not desire exaltedness upon the earth or corruption. And the [best] outcome is for the righteous.", "words": [{"id": 1, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 2, "arabic": "ٱلدَّارُ", "translit": "ُrāَّdlٱ", "root": "دور"}, {"id": 3, "arabic": "ٱلْءَاخِرَةُ", "translit": "ُẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 4, "arabic": "نَجْعَلُهَا", "translit": "āَhُlَʿعْjgَn", "root": "جعل"}, {"id": 5, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يُرِيدُونَ", "translit": "َnwُdyِrُy", "root": "رود"}, {"id": 8, "arabic": "عُلُوًّا", "translit": "āًّwُlُʿع", "root": "علو"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "فَسَادًا", "translit": "āًdāَsَf", "root": "فسد"}, {"id": 13, "arabic": "وَٱلْعَٰقِبَةُ", "translit": "ُẗَbِqَٰʿعْlٱَw", "root": "عقب"}, {"id": 14, "arabic": "لِلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlِl", "root": "وقي"}], "hasIhya": true}, {"ayah": 84, "text": "مَن جَآءَ بِٱلْحَسَنَةِ فَلَهُۥ خَيْرٌ مِّنْهَاۖ وَمَن جَآءَ بِٱلسَّيِّئَةِ فَلَا يُجْزَى ٱلَّذِينَ عَمِلُوا۟ ٱلسَّيِّـَٔاتِ إِلَّا مَا كَانُوا۟ يَعْمَلُونَ ", "translation": "Whoever comes [on the Day of Judgement] with a good deed will have better than it; and whoever comes with an evil deed - then those who did evil deeds will not be recompensed except [as much as] what they used to do.", "words": [{"id": 1, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "بِٱلْحَسَنَةِ", "translit": "ِẗَnَsَḥْlٱِb", "root": "حسن"}, {"id": 4, "arabic": "فَلَهُۥ", "translit": "ۥُhَlَf", "root": ""}, {"id": 5, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 6, "arabic": "مِّنْهَا", "translit": "āَhْnِّm", "root": ""}, {"id": 7, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 8, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 9, "arabic": "بِٱلسَّيِّئَةِ", "translit": "ِẗَyʾِّyَّslٱِb", "root": "سوا"}, {"id": 10, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 11, "arabic": "يُجْزَى", "translit": "àَzْjgُy", "root": "جزي"}, {"id": 12, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 13, "arabic": "عَمِلُوا۟", "translit": "۟āwُlِmَʿع", "root": "عمل"}, {"id": 14, "arabic": "ٱلسَّيِّـَٔاتِ", "translit": "ِtāَٔـِّyَّslٱ", "root": "سوا"}, {"id": 15, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 16, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 17, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 18, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 85, "text": "إِنَّ ٱلَّذِى فَرَضَ عَلَيْكَ ٱلْقُرْءَانَ لَرَآدُّكَ إِلَىٰ مَعَادٍۚ قُل رَّبِّىٓ أَعْلَمُ مَن جَآءَ بِٱلْهُدَىٰ وَمَنْ هُوَ فِى ضَلَٰلٍ مُّبِينٍ ", "translation": "Indeed, [O Muḥammad], He who imposed upon you the Qur’ān will take you back to a place of return.[1] Say, \"My Lord is most knowing of who brings guidance and who is in clear error.\"", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "فَرَضَ", "translit": "َḍَrَf", "root": "فرض"}, {"id": 4, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱلْقُرْءَانَ", "translit": "َnāَءْrُqْlٱ", "root": "قرا"}, {"id": 6, "arabic": "لَرَآدُّكَ", "translit": "َkُّdٓāَrَl", "root": "ردد"}, {"id": 7, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 8, "arabic": "مَعَادٍ", "translit": "ٍdāَʿعَm", "root": "عود"}, {"id": 9, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 10, "arabic": "رَّبِّىٓ", "translit": "ٓàِّbَّr", "root": "ربب"}, {"id": 11, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 12, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 13, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 14, "arabic": "بِٱلْهُدَىٰ", "translit": "ٰàَdُhْlٱِb", "root": "هدي"}, {"id": 15, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 16, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 17, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 18, "arabic": "ضَلَٰلٍ", "translit": "ٍlَٰlَḍ", "root": "ضلل"}, {"id": 19, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 86, "text": "وَمَا كُنتَ تَرْجُوٓا۟ أَن يُلْقَىٰٓ إِلَيْكَ ٱلْكِتَٰبُ إِلَّا رَحْمَةً مِّن رَّبِّكَۖ فَلَا تَكُونَنَّ ظَهِيرًا لِّلْكَٰفِرِينَ ", "translation": "And you were not expecting that the Book would be conveyed to you, but [it is] a mercy from your Lord. So do not be an assistant to the disbelievers.[1]", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 3, "arabic": "تَرْجُوٓا۟", "translit": "۟āٓwُjgْrَt", "root": "رجو"}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يُلْقَىٰٓ", "translit": "ٰٓàَqْlُy", "root": "لقي"}, {"id": 6, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 7, "arabic": "ٱلْكِتَٰبُ", "translit": "ُbَٰtِkْlٱ", "root": "كتب"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "رَحْمَةً", "translit": "ًẗَmْḥَr", "root": "رحم"}, {"id": 10, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 11, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 12, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 13, "arabic": "تَكُونَنَّ", "translit": "َّnَnwُkَt", "root": "كون"}, {"id": 14, "arabic": "ظَهِيرًا", "translit": "āًryِhَẓ", "root": "ظهر"}, {"id": 15, "arabic": "لِّلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlِّl", "root": "كفر"}], "hasIhya": false}, {"ayah": 87, "text": "وَلَا يَصُدُّنَّكَ عَنْ ءَايَٰتِ ٱللَّهِ بَعْدَ إِذْ أُنزِلَتْ إِلَيْكَۖ وَٱدْعُ إِلَىٰ رَبِّكَۖ وَلَا تَكُونَنَّ مِنَ ٱلْمُشْرِكِينَ ", "translation": "And never let them avert you from the verses of Allāh after they have been revealed to you. And invite [people] to your Lord. And never be of those who associate others with Allāh.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "يَصُدُّنَّكَ", "translit": "َkَّnُّdُṣَy", "root": "صدد"}, {"id": 3, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 4, "arabic": "ءَايَٰتِ", "translit": "ِtَٰyāَء", "root": "ايي"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 7, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 8, "arabic": "أُنزِلَتْ", "translit": "ْtَlِznُaʾ", "root": "نزل"}, {"id": 9, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 10, "arabic": "وَٱدْعُ", "translit": "ُʿعْdٱَw", "root": "دعو"}, {"id": 11, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 12, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 13, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 14, "arabic": "تَكُونَنَّ", "translit": "َّnَnwُkَt", "root": "كون"}, {"id": 15, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 16, "arabic": "ٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱ", "root": "شرك"}], "hasIhya": false}, {"ayah": 88, "text": "وَلَا تَدْعُ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَۘ لَآ إِلَٰهَ إِلَّا هُوَۚ كُلُّ شَىْءٍ هَالِكٌ إِلَّا وَجْهَهُۥۚ لَهُ ٱلْحُكْمُ وَإِلَيْهِ تُرْجَعُونَ ", "translation": "And do not invoke with Allāh another deity. There is no deity except Him. Everything will be destroyed except His Face.[1] His is the judgement, and to Him you will be returned.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَدْعُ", "translit": "ُʿعْdَt", "root": "دعو"}, {"id": 3, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "إِلَٰهًا", "translit": "āًhَٰlِiʾ", "root": "اله"}, {"id": 6, "arabic": "ءَاخَرَ", "translit": "َrَhkāَء", "root": "اخر"}, {"id": 7, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 8, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 11, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 12, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 13, "arabic": "هَالِكٌ", "translit": "ٌkِlāَh", "root": "هلك"}, {"id": 14, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 15, "arabic": "وَجْهَهُۥ", "translit": "ۥُhَhْjgَw", "root": "وجه"}, {"id": 16, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 17, "arabic": "ٱلْحُكْمُ", "translit": "ُmْkُḥْlٱ", "root": "حكم"}, {"id": 18, "arabic": "وَإِلَيْهِ", "translit": "ِhْyَlِiʾَw", "root": ""}, {"id": 19, "arabic": "تُرْجَعُونَ", "translit": "َnwُʿعَjgْrُt", "root": "رجع"}], "hasIhya": true}], "tafsir": {"15": [{"arabic": "موسى عليه السلام فيما أخبر عنه تعالى هذا من عمل الشيطان ولذلك حذر الله منه جميع الخلق فقال الله تعالى يا بني آدم لا يفتننكم الشيطان كما أخرج أبويكم من الجنة وقال عز وجل إنه يراكم هو وقبيله من حيث لا ترونهم والقرآن من أوله إلى آخره تحذير من الشيطان فكيف يدع الأمن منه وأخذ الحذر من حيث أمر الله به لا ينافي الاشتغال بحب الله فإن من الحب له امتثال أمره وقد أمر بالحذر من العدو كما أمر بالحذر من الكفار فقال تعالى وليأخذوا حذرهم وأسلحتهم وقال تعالى وأعدوا لهم ما استطعتم من قوة ومن رباط الخيل فإذا لزمك بأمر الله", "english": "...and the world, which is the source of trials and tribulations, the mine of forbidden pleasures and lusts. And Moses, peace be upon him, said—as God Most High has related concerning him—{«هذا من عمل الشيطان»} (\"This is of Satan's doing\" — Qur'an 28:15). For this reason, God warned all of creation against him, saying: {«يا بني آدم لا يفتننكم الشيطان كما أخرج أبويكم من الجنة»} (\"O children of Adam, let not Satan tempt you as he brought your parents out of Paradise\" — Qur'an 7:27). And He, Glorified and Exalted, said: {«إنه يراكم هو وقبيله من حيث لا ترونهم»} (\"Indeed, he sees you, he and his tribe, from where you do not see them\" — Qur'an 7:27). The Qur'an, from its beginning to its end, is a warning against Satan. So how could one claim security from him? And taking precaution against him, in the manner God has commanded, does not contradict occupation with the love of God. For part of loving Him is obeying His command. He has commanded vigilance against the enemy just as He commanded vigilance against the disbelievers, saying: {«وليعأخذوا حذرهم وأسلحتهم»} (\"And let them take their precautions and their weapons\" — Qur'an 4:102), and saying: {«وأعدوا لهم ما استطعتم من قوة ومن رباط الخيل»} (\"And prepare against them whatever you are able of power and of steeds of war\" — Qur'an 8:60). So if, by God's command, you are obligated to be wary of a disbelieving enemy whom you can see, then it is all the more fitting that you be obligated to be wary of an enemy who sees you while you do not see him.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 830", "section_title_en": "On the Necessity of Vigilance Against Satan and Its Harmony with Trust in God and Remembrance of Him", "section_index": 830, "anchors": "- Root: شيط (Shayṭ)\n  * Lisan / Ayn: Core root denotes burning, scorching, or spoiling (as meat over a fire), and by extension, perishing or being ruined.\n  * Al-Raghib (Mufradat): \"الشيطان\" (Satan) is derived from this root, signifying one who is burned, ruined, or cast away from mercy—the archetype of the adversary who destroys through temptation.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"شاط دمه\" — his blood went in vain (was wasted). Metaphorical (Majaz): \"أشاط السلطان دمه\" — the ruler declared his blood permissible (wasted). Thus, Satan is the one who causes spiritual ruin and waste.\n- Root: حذر (Ḥadhar)\n  * Lisan / Ayn: Caution, wariness, and taking precautions against a feared harm.\n  * Al-Raghib (Mufradat): \"الحذر: احتراز من مخيف\" — vigilance is a protective withdrawal from what is frightening. It is a commanded state, as in {«خذوا حذركم»} (Take your precautions — Qur'an 4:71).\n  * Al-Zamakhshari (Asas): Literal: \"حذرته وحاذرته\" — I was wary of him. Metaphorical: \"حذار من أرماحنا حذار\" — a poetic imperative to beware. Vigilance is both a physical and spiritual act of self-preservation.\n- Root: قلب (Qalb)\n  * Lisan / Ayn: To turn, overturn, or flip something from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart (qalb) is so named for its constant turning and fluctuation between states.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — to turn a thing from its face. Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and devises stratagems. The heart's occupation is decisive: it turns either toward God or toward the enemy.\n- Root: وكل (Wakal)\n  * Lisan / Ayn: To entrust, delegate, or rely upon another.\n  * Al-Raghib (Mufradat): \"التوكيل: أن تعتمد على غيرك وتجعله نائبا عنك\" — trust (tawakkul) is reliance upon another as your deputy. God says: {«وكفى بالله وكيلا»} (And sufficient is Allah as Disposer of affairs — Qur'an 4:81).\n  * Al-Zamakhshari (Asas): Literal: \"وكل إليه الأمر\" — he delegated the matter to him. Metaphorical: \"فلان وكل\" — a weak man who leans on others. True tawakkul does not negate taking means; it purifies the heart's reliance.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The particle \"إنما\" and restrictive constructions (e.g., \"ليس ... إلا\") are used to delimit predicates, as in the author's argument that vigilance is not a contradiction of love or trust but a fulfillment of the divine command.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Status and Ostentation'", "badge": "Afterlife"}], "16": [{"arabic": "الجبار (10) سبحانك اللهم وبحمدك لا إله إلا أنت عملت سوءا وظلمت نفسي فاغفر لي ذنبي إنك أنت ربي ولا يغفر الذنوب إلا أنت (11) اللهم ألهمني رشدي وقني شر نفسي (12) اللهم ارزقني حلالا لا تعاقبني عليه وقنعني بما رزقتني واستعملني به صالحا تقبله مني (1) اللهم إني أسألك العفو والعافية وحسن اليقين والمعافاة في الدنيا والآخرة (2) يا من لا تضره الذنوب ولا تنقصه المغفرة هب لي ما لا يضرك وأعطني ما لا ينقصك ربنا أفرغ علينا صبرا وتوفنا مسلمين أنت ولي في الدنيا والآخرة توفني مسلما وألحقني بالصالحين أنت ولينا فاغفر لنا وارح", "english": "And employ me in righteous deeds which You will accept from me. (1) O God, I ask You for pardon, well-being, good certainty, and soundness in this world and the next. (2) O You Whom sins do not harm and from Whom forgiveness does not diminish anything — grant me that which will not harm You, and give me that which will not diminish You. Our Lord, pour upon us patience and cause us to die as Muslims. You are our Protector in this world and the next; cause me to die as a Muslim and join me with the righteous. You are our Protector, so forgive us and have mercy upon us, and You are the Best of forgivers. And write for us good in this world and in the Hereafter — indeed, we have turned to You in repentance. Our Lord, upon You we rely, to You we turn in repentance, and to You is the final return. Our Lord, make us not a trial for the wrongdoing people. Our Lord, make us not a trial for those who disbelieve, and forgive us, our Lord — indeed, You are the Mighty, the Wise. Our Lord, forgive us our sins and our excesses in our affairs, make firm our feet, and grant us victory over the disbelieving people. Our Lord, forgive us and our brothers who preceded us in faith, and place not in our hearts any rancor toward those who believe — our Lord, indeed You are Kind, Merciful. Our Lord, grant us from Yourself mercy and prepare for us from our affair right guidance. Our Lord, give us good in this world and good in the Hereafter, and protect us from the chastisement of the Fire. Our Lord, indeed we have heard a caller calling to faith — to His saying, Mighty and Majestic: {«إنك لا تخلف الميعاد»} [آل عمران/ 194] — Our Lord, do not take us to task if we forget or err. Our Lord, to the end of the surah. (3) My Lord, forgive me and my parents, and have mercy upon them as they raised me when I was small; and forgive the believing men and the believing women, and the Muslim men and the Muslim women, the living among them and the dead. (4) My Lord, forgive, have mercy, and overlook what You know — and You are the Most Exalted, the Most Generous, the Best of the merciful, and the Best of the forgivers. And indeed, to God we belong and to Him we return; and there is no might and no power except through God, the Exalted, the Magnificent; and God suffices us, and He is the Best Disposer of affairs. And may God send blessings upon Muhammad, the Seal of the Prophets, and upon his family and his companions, and grant them abundant peace. (5)", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 252", "section_title_en": "Section 252 — Supplications for Morning and Evening: Comprehensive Prayers of the Prophet (ﷺ)", "section_index": 252, "anchors": "- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core meaning of swallowing/ingesting (iltihām); from this derives the sense of something being cast directly into the innermost recess of the heart (al-rawʿ).\n  * Al-Raghib (Mufradat): \"الإلهام: إلقاء الشيء في الروع\" — ilhām is the casting of a thing into the innermost consciousness, specifically from God or the higher assembly (al-malaʾ al-aʿlā). It is that which the Prophet (ﷺ) called \"the touch of the angel\" (limat al-malak) and \"the breath of the Holy Spirit in my innermost heart\" (nafth rūḥ al-qudus fī rawʿī).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ألهمه الله الخير: ألقاه في روعه\" — God inspired him with good: He cast it into his innermost consciousness. Metaphorical (majāz): A horse that \"swallows the ground\" (yaltaḥimu al-arḍ) in swiftness; thus ilhām is the swift, direct ingress of divine guidance into the soul without intermediary effort.\n- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: The root denotes praise arising from recognition of voluntary excellence and beneficence; al-ḥamd is commendation of the beloved for their attributes and acts of goodness.\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence (niʿmah) with reverence and love; it is distinguished from mere thanks (shukr) in that it is directed to the essence and attributes of the praised one, not solely to the benefit received.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — I praise God with all His praiseworthy attributes. Metaphorical: \"أحمدت صنيعه\" — I found his deed praiseworthy; thus the tongue's praise must be matched by the heart's recognition of the praised one's perfection.\n- Root: غفر (gh-f-r)\n  * Lisan / Ayn: The root denotes covering and shielding; al-mighfar is the helmet that protects the head in battle.\n  * Al-Raghib (Mufradat): \"الغفر: إلباس ما يصونه عن الدنس\" — Forgiveness is the clothing of that which shields from filth. God's forgiveness (maghfirah) is His shielding of the servant from the touch of chastisement, covering the sin so that it is as though it never were.\n  * Al-Zamakhshari (Asas): Literal: \"اللهم غفرًا\" — O God, forgive. Metaphorical: The she-beasts that \"did not forgive\" their heedlessness (lam taghfir la-hā ghaflātuhā) — i.e., they did not shield their young from destruction; thus forgiveness is active protection, not mere erasure.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which breathes and has vital spirit; also used for the very essence of a thing.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul is the spirit; and in God's saying {«ويحذركم الله نفسه»} [آل عمران/ 28], \"His Self\" means His very essence (dhāt), which — though grammatically expressed as an annexation implying distinction — is in reality identical, with no multiplicity in the Divine Essence.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس\" — a precious thing. Metaphorical: \"دفق نفسه\" — he poured out his blood/life; thus nafs is the seat of life, passion, and moral responsibility.\n- Sibawayh Rule: باب الدعاء والخبر (The Chapter of Supplication and Assertion) — Supplications (duʿāʾ) are grammatically constructed as optative sentences (inshāʾ ṭalabī) using the imperative (rabbighfir), the jussive (lā tuʾākhidhnā), and the vocative (rabbanā), yet they may embed assertive clauses (khabar) of praise (al-ḥamdu lillāh) and attestation (lā ilāha illā anta). The periodic structure of these prayers alternates between direct address to God (munādāh) and self-referential confession, requiring the translator to preserve the vocative force of \"O God\" and \"Our Lord\" without flattening into mere description.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}, {"arabic": "استطعت أعوذ بك اللهم من شر ما صنعت ومن شر كل ذي شر اللهم إني ظلمت نفسي فاغفر لي ذنوبي فإنه لا يغفر الذنوب إلا أنت واهدني لأحسن الأخلاق فإنه لا يهدي لأحسنها إلا أنت واصرف عني سيئها فإنه لا يصرف سيئها إلا أنت لبيك وسعديك والخير كله بيديك أنا لك وإليك أستغفرك وأتوب إليك آمنت اللهم بما أرسلته من رسول وآمنت اللهم بما أنزلت من كتاب وصلى الله على محمد النبي الأمي وعلى آله وسلم تسليما كثيرا خاتم كلامي ومفتاحه وعلى أنبيائه ورسله أجمعين آمين يا رب العالمين اللهم أوردنا حوض محمد واسقنا بكأسه مشربا رويا سائغا هنيا لا نظمأ بعد", "english": "It is narrated that Yūnus ibn ʿUbayd saw a man in a dream — a man who had been killed as a martyr in the lands of the Byzantines — and he said to him: \"What is the most excellent deed that you witnessed?\" He replied: \"I witnessed the glorifications (tasbīḥāt) of Ibn al-Muʿtamir holding a station with Allah, Mighty and Majestic.\" And they are these: \"Glory be to Allah (subḥāna Allāh), and praise be to Allah (al-ḥamdu li-Allāh), and there is no god but Allah (lā ilāha illā Allāh), and Allah is the Greatest (Allāhu akbar), and there is no might and no power except through Allah, the Most High, the Magnificent — to the number of what He has created, and the number of what He is creating, and the weight of what He has created, and the weight of what He is creating, and the fill of what He has created, and the fill of what He is creating, and the fill of His heavens and the fill of His earth, and the like of that, and multiples of that, and the number of His creation, and the weight of His Throne, and the utmost extent of His mercy, and the ink of His words, and the limit of His good pleasure, until He is pleased, and when He is pleased, [then] the number of what His creation has remembered Him with in all that has passed, and the number of what they will remember Him with in what remains, in every year, and month, and Friday, and day, and night, and hour of the hours, and breath of the breaths, and age of the ages, from eternity to eternity — the eternity of this world and the eternity of the Hereafter — and more than that, whose beginning does not cease and whose end does not come to an end.\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 250", "section_title_en": "The Supplications of Ibn al-Muʿtamir (Sulaymān al-Taymī) and His Glorifications, and the Supplication of Ibrāhīm ibn Adham — May Allah Be Well Pleased with Them", "section_index": 250, "anchors": "- Root: سبح (s-b-ḥ)\n  * Lisan / Ayn: Core meaning of swift motion (in water or air); extended to the act of prayer and glorification.\n  * Al-Raghib (Mufradat): \"التسبيح: تنزيه الله تعالى. وأصله: المر السريع في عبادة الله تعالى\" — Glorification is the declaration of Allah's transcendence; its root is the swift passage in worship of Allah.\n  * Al-Zamakhshari (Asas): Literal: \"سبحت الله وسبحت له\" — to declare Him transcendent. Metaphorical: \"والنجوم تسبح في الفلك\" — the stars glide in their orbits, a metaphor for their obedient motion.\n- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: Core meaning of praise and commendation for a beneficial act.\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence with reverence; it is due to Allah alone in His absolute perfection.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — to praise Allah with all His praiseworthy attributes. Metaphorical: \"أحمدت الأرض: رضيت سكناها\" — to find a thing agreeable, extending praise to non-verbal contexts.\n- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core meaning of swift swallowing or devouring.\n  * Al-Raghib (Mufradat): \"الإلهام: إلقاء الشيء في الروع\" — Inspiration is the casting of a thing into the heart/mind (al-rawʿ), specifically from Allah or the higher assembly.\n  * Al-Zamakhshari (Asas): Literal: \"ألهمه الله الخير: ألقاه في روعه\" — Allah inspired him with good. Metaphorical: \"جواد يلتهم الأرض\" — a swift horse devours the ground, extending to rapid comprehension.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the clause remains grammatically sound, as seen in the extended supplicatory sentences.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}, {"arabic": "أنفسهم لا تقنطوا من رحمة الله إن الله يغفر الذنوب جميعا إنه هو الغفور الرحيم وأنيبوا إلى ربكم أمرهم بالإنابة وقال تعالى وإني لغفار لمن تاب وآمن وعمل صالحا ثم اهتدى فإذا توقع المغفرة مع التوبة فهو راج وإن توقع المغفرة مع الإصرار فهو مغرور كما أن من ضاق عليه وقت الجمعة وهو في السوق فخطر له أن يسعى إلى الجمعة فقال له الشيطان إنك لا تدرك الجمعة فأقم على موضعك فكذب الشيطان ومر يعدو وهو يرجو أن يدرك الجمعة فهو راج وإن استمر على التجارة وأخذ يرجو تأخير الإمام للصلاة لأجله إلى وسط الوقت أو لأجل غيره أو لسبب من الأسباب التي لا يعر", "english": "Every soul shall taste what it has earned. And {«وَأَنَّ كُلَّ نَفْسٍ بِمَا كَسَبَتْ رَهِينَةٌ»} — \"And that every soul is a pledge for what it has earned.\" So what has deluded you concerning God, after you have heard and comprehended? They will say: \"Had we but listened or reasoned, we would not be among the companions of the Blaze.\" Thus they will confess their sin. So away with the companions of the Blaze!", "book_title": "Fear and Hope", "section_title_ar": "Section 890", "section_title_en": "The Anatomy of Hope (Rajā') and Delusion (Ghurūr): A Kalamic Dissection of the Soul's Two States", "section_index": 890, "anchors": "- Root: نفس (Nafs)\n  * Lisan / Ayn: The self, soul, or spirit; that which desires proximity and discourse; the locus of breath and life.\n  * Al-Raghib (Mufradat): Nafs denotes the rūḥ (spirit) and, in divine attribution, the very Dhāt (Essence) of God—as in {«وَيُحَذِّرُكُمُ اللَّهُ نَفْسَهُ»}—entailing no real multiplicity despite grammatical annexation.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to the living, breathing self; metaphorical (Majaz) usage extends to \"blood\" (nafs sā'ilah) and the \"evil eye\" (nafs as 'ayn). Here, it signifies the moral agent bearing responsibility.\n- Root: توب (Tawb)\n  * Lisan / Ayn: Return, repentance; the act of turning back from error.\n  * Al-Raghib (Mufradat): Tawbah is abandoning the sin in the most excellent manner—the third and highest form of excuse (after denial and pretext). In Sacred Law: forsaking the sin due to its ugliness, remorse for the past, resolve against recurrence, and restitution of what can be restored.\n  * Al-Zamakhshari (Asas): Literal: \"The servant repents to God from his sin; God turns in mercy to the servant.\" The reciprocal dynamic—God's acceptance (tawbah) meeting the servant's return (inābah)—is operative in this text.\n- Root: ذنب (Dhanb)\n  * Lisan / Ayn: The tail of an animal; what trails behind; by extension, a fault or crime as the \"consequence\" one drags after oneself.\n  * Al-Raghib (Mufradat): In origin, \"taking hold of a thing's tail\"—i.e., seizing the outcome. Sin is that which trails the soul and binds it as a pledge (rahīnah).\n  * Al-Zamakhshari (Asas): Metaphorical: \"He is among the tails (adhnāb) of the people\"—the laggards. The sinner is one who follows his lower tail, and the verse {«كُلُّ نَفْسٍ بِمَا كَسَبَتْ رَهِينَةٌ»} makes the soul a hostage to its own trailing deeds.\n- Root: غفر (Ghafr)\n  * Lisan / Ayn: To cover, shield, or protect; the Ghifār tribe's name; a helmet (mighfar) that shields the head.\n  * Al-Raghib (Mufradat): Ghufrān from God is His shielding the servant from the touch of chastisement—a protective covering, not mere erasure. It may also mean outward forbearance.\n  * Al-Zamakhshari (Asas): Literal: \"O God, forgive (ghufrānan)!\"—a covering over the stain. Metaphorical: Zuhayr's beasts \"did not forgive\" their negligence—i.e., did not shield the offspring from destruction. Hope of forgiveness without repentance is thus not ghufrān but ghurūr (delusion).\n- Sibawayh Rule: باب الفصل بين العامل والمعمول (Interposition between Operator and Operand) — The periodic structure of verses like {«إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا»} delays the predicate to heighten rhetorical impact; the conditional \"if you say... know that\" (fa-in qulta... fa-'lam) governs the entire dialectical sequence, requiring the apodosis to resolve the protasis with logical necessity.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'", "badge": "Insight"}], "23": [{"arabic": "وأما الأمة فتطلق على ثمانية أوجه الأمة الجماعة كقوله تعالى وجد عليه أمة من الناس يسقون وأتباع الأنبياء كقولك عن أمة محمد صلى الله عليه وسلم ورجل جامع للخير يقتدى به كقوله تعالى إن إبراهيم كان أمة قانتا لله والأمة الدين كقوله عز وجل إنا وجدنا آباءنا على أمة والأمة الحين والزمان كقوله عز وجل إلى أمة معدودة وقوله عز وجل وادكر بعد أمة والأمة القامة يقال فلان حسن الأمة أي القامة وأمة رجل منفرد بدين لا يشركه فيه أحد قال صلى الله عليه وسلم يبعث زيد بن عمرو بن نفيل أمة وحده (1) والأمة يقال هذه أمة زيد أي أم زيد والروح أيضا ورد في القرآن عل", "english": "I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 233", "section_title_en": "The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation", "section_index": 233, "anchors": "- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Quran Recitation'", "badge": "Hadith"}], "27": [{"arabic": "الورد بلغنا أن إبليس تمثل ليحيى بن زكريا عليهما السلام وقال إني أريد أن أنصحك قال لا حاجة لي في نصحك ولكن أخبرني عن بني آدم قال هم عندنا ثلاثة أصناف أما صنف منهم وهم أشد الأصناف علينا نقبل على أحدهم حتى نفتنه ونتمكن منه فيفزع إلى الاستغفار والتوبة فيفسد علينا كل شيء أدركنا منه ثم نعود إليه فيعود فلا نحن نيأس منه ولا نحن ندرك منه حاجتنا فنحن منه في عناء وأما الصنف الآخر فهم في أيدينا بمنزل الكرة في أيدي صبيانكم نقلبهم كيف شئنا قد كفونا أنفسهم وأما الصنف الثالث فهم مثلك معصومون لا نقدر منهم على شيء فإن قلت ف", "english": "As for the reports (al-akhbār), Mujāhid said: Iblīs has five offspring, each of whom he has appointed over a certain aspect of his affair: Thabr, al-Aʿwar, Mabsūṭ, Dāsim, and Zalanbūr. As for Thabr, he is the master of calamities, commanding [people] to cry \"Woe and destruction\" (al-thubūr), to tear their collars, to strike their cheeks, and to make the claims of the Age of Ignorance (daʿwā al-jāhiliyyah). As for al-Aʿwar, he is the master of fornication (al-zinā), commanding it and beautifying it. As for Mabsūṭ, he is the master of lying. As for Dāsim, he enters with a man to his family, casting blame upon them in his presence and angering him against them. As for Zalanbūr, he is the master of the marketplace, and because of him people never cease to be mutually aggrieved and complaining. The Satan of prayer is called Khinzab, and the Satan of ablution is called al-Walhān.", "book_title": "Disciplining the Soul", "section_title_ar": "Section 605", "section_title_en": "On the Visions of Satan and the Angel — Between True Form and Symbolic Representation", "section_index": 605, "anchors": "- Root: مثل (maththala)\n  * Lisan / Ayn: To stand before, to represent, to form an image or likeness of something.\n  * Al-Raghib (Mufradat): Al-mathal (the similitude) is the saying that depicts the state of the thing; al-tamthīl is the act of representing a meaning through a sensory form that corresponds to it.\n  * Al-Zamakhshari (Asas): Haqiqah: \"maththala\" means to stand erect before someone. Majaz: To set forth a parable (daraba mathalan) — the transfer from physical standing to the representation of an abstract meaning through a concrete image.\n- Root: صور (ṣawwara)\n  * Lisan / Ayn: To form, to shape, to give a figure or image to something.\n  * Al-Raghib (Mufradat): \"الصورة: ما ينتقش به الأعيان، ويتميز بها غيرها، وذلك ضربان: أحدهما محسوس يدركه الخاصة والعامة... والثاني: معقول يدركه الخاصة دون العامة\" — Form is twofold: sensory form perceived by all, and intelligible form perceived only by the elite.\n  * Al-Zamakhshari (Asas): Haqiqah: physical shaping and bending. Majaz: The inclination of the heart toward something — \"وأرى لك إليه صورة: ميلة بالمودة\" — a metaphorical \"form\" is an inclination of affection.\n- Root: كشف (kashafa)\n  * Lisan / Ayn: To uncover, to reveal, to remove a covering.\n  * Al-Raghib (Mufradat): Al-kashf is the removal of the veil (al-ḥijāb) between the perceiver and the perceived, whether sensory or intellectual.\n  * Al-Zamakhshari (Asas): Haqiqah: removing a physical covering. Majaz: Unveiling of spiritual realities (mukāshafah) to the hearts of the purified.\n- Root: خنس (khanasa)\n  * Lisan / Ayn: To withdraw, to shrink back, to lurk.\n  * Al-Raghib (Mufradat): Al-khunūs is the retreat of the whisperer (al-waswās) when God is remembered — as in {«الْخَنَّاسِ»} (Q. 114:4).\n  * Al-Zamakhshari (Asas): Haqiqah: physical retreat. Majaz: The withdrawal of Satan's influence from the heart upon the remembrance of God.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The use of \"إنما\" and restrictive constructions to distinguish the exclusive means of perceiving true forms (only through prophetic light) from the general means of symbolic perception.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}], "30": [{"arabic": "رواه عن النبي صلى الله عليه وسلم أنه قال إن الله تعالى يمجد نفسه كل يوم ويقول إني أنا الله رب العالمين إني أنا الله لا إله إلا أنا الحي القيوم إني أنا الله لا إله إلا أنا العلي العظيم إني أنا الله لا إله إلا أنا لم ألد ولم أولد إني أنا الله لا إله إلا أنا العفو الغفور إني أنا الله لا إله إلا أنا مبدىء كل شيء وإلي يعود العزيز الحكيم الرحمن الرحيم مالك يوم الدين خالق الخير والشر خالق الجنة والنار الواحد الأحد الفرد الصمد الذي لم يتخذ صاحبة ولا ولدا الفرد الوتر عالم الغيب والشهادة الملك القدوس السلام المؤمن المهيمن العزيز الجبار المتكبر", "english": "Muḥammad ibn Ḥassān said: Maʿrūf al-Karkhī — may God have mercy on him — said to me: \"Shall I not teach you ten words — five for this world and five for the Hereafter? Whoever supplicates God — Mighty and Majestic — with them shall find God — Most High — present with them.\" I said: \"Write them down for me.\" He said: \"No, but I shall repeat them to you as Bakr ibn Khunays — may God have mercy on him — repeated them to me:", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 249", "section_title_en": "Section 249 — Supplications of the Righteous (Adʿiyat al-Ṣāliḥīn)", "section_index": 249, "anchors": "- Root: حسب (ḥ-s-b)\n  * Lisan / Ayn: Core meaning of counting, reckoning, and sufficiency — \"ḥasb\" denotes that which suffices or is enough\n  * Al-Raghib (Mufradat): \"الحساب: استعمال العدد\" — the theological nuance of ḥasbī Allāh (\"God is my Sufficer\") carries the sense of complete reliance upon God's reckoning and provision, transcending mere numerical counting to signify total trust in divine sufficiency\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"حسب المال\" (he counted the wealth); Metaphorical (majāz): \"خرجا يتحسبان الأخبار\" (they go out seeking news) — in the supplication \"ḥasbī Allāh,\" the literal sense of \"sufficiency\" is intended, yet it carries the metaphorical extension of complete trust, as one who has God as his Sufficer has no need of any other reckoning\n\n- Root: اله (ʾ-l-h)\n  * Lisan / Ayn: Core meaning of worship, devotion, and seeking refuge; \"ilāh\" denotes that which is worshipped\n  * Al-Raghib (Mufradat): \"الله: قيل: أصله إله فحذفت همزته، وأدخل عليها الألف واللام، فخص بالباري تعالى\" — the name Allāh is the proper name of the Creator, distinguished from generic \"ilāh\" (any object of worship); in these supplications, the divine names invoked (al-Karīm, al-Ḥalīm, al-Qawī, al-Shadīd, al-Raḥīm, al-Raʾūf, al-Laṭīf, al-Qadīr) each specify particular attributes of the divine essence\n  * Al-Zamakhshari (Asas): Literal: \"فلان يتأله: يتعبد\" (he worships); the supplications employ the divine names in their literal theological sense, each name invoking a specific attribute relevant to the particular need mentioned\n\n- Root: انا (ʾ-n-y)\n  * Al-Raghib (Mufradat): \"أنا ضمير المخبر عن نفسه\" — the first-person pronoun; in the divine self-declaration \"innī anā Allāh,\" the repetition emphasizes divine self-identification\n  * Al-Zamakhshari (Asas): Literal: \"أنى الطعام أي إدراكه\" (the food ripened/reached its time) — the related sense of something reaching its appointed time appears in \"عند المسألة في القبر\" (at the questioning in the grave), indicating appointed moments of divine reckoning\n\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The supplications employ repeated prepositional phrases (ʿinda al-mawt, ʿinda al-masʾalah, ʿinda al-ḥisāb, ʿinda al-mīzān, ʿinda al-ṣirāṭ) in parallel construction, each governing a distinct divine name, creating a rhythmic liturgical structure where each clause stands as an independent invocation\n\n---\n\n##", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'On Invocations and Supplications'", "badge": "Ethics"}], "34": [{"arabic": "في التعليل والاعتذار لما قيل له اذهب إلى فرعون {فقال} ولهم على ذنب وقوله إني أخاف أن يكذبون ويضيق صدري ولا ينطلق لساني وقوله إننا نخاف أن يفرط علينا أو أن يطغى وهذا من غير موسى عليه السلام من سوء الأدب لأن الذي أقيم مقام الأنس يلاطف ويحتمل ولم يحتمل ليونس عليه السلام ما دون هذا لما أقيم مقام القبض والهيبة فعوقب بالسجن في بطن الحوت في ظلمات ثلاث ونودي عليه إلى يوم القيامة لولا أن تداركه نعمة من ربه لنبذ بالعراء وهو مذموم قال الحسن العراء هو القيامة ونهى نبينا صلى الله عليه وسلم أن يقتدى به وقيل له فاصبر لحكم ربك ولا تكن كصاحب الحوت إذ", "english": "As for Adam (peace be upon him), it was said concerning him: {«وعصى آدم ربه فغوى»} \"And Adam disobeyed his Lord, so he went astray\" (Q. 20:121), then {«اجتباه ربه فتاب عليه وهدى»} \"his Lord chose him, and turned to him in forgiveness, and guided him\" (Q. 20:122).", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1187", "section_title_en": "On the Varieties of Divine Proximity (Al-Inbisāṭ) and Awe (Al-Haybah) in the States of the Prophets and Saints", "section_index": 1187, "anchors": "- Root: بسط (B-S-T)\n  * Lisan / Ayn: Core meaning is \"to spread out, extend, expand\" — both physically (basting a garment) and metaphorically.\n  * Al-Raghib (Mufradat): Theological nuance: \"بسط الشيء: نشره وتوسيعه\" — used for expansion of mercy, favor, and the soul's comfort. In Kalam, it contrasts with *qabḍ* (contraction/withholding).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"بسط الثوب والفراش إذا نشره.\" Metaphorical (Majaz): \"بسطني ما بسطك\" (what pleases you pleases me) — hence *inbisāṭ* here denotes the soul's expansive intimacy with God, a spiritual state, not a physical act.\n- Root: أبلس (B-L-S)\n  * Lisan / Ayn: \"أبلس: انقطعت حجته ويئس\" — to be reduced to silence, to despair.\n  * Al-Raghib (Mufradat): \"الإبلاس: الحزن المعترض من شدة اليأس\" — the despair of Iblis is a theological state of being cut off from mercy.\n  * Al-Zamakhshari (Asas): Literal: despair/silence. Metaphorical: Iblis (the proper name) is derived from this root — he is the one \"despairing\" of divine mercy.\n- Root: عله (not used; avoided per instruction) — *Note: The text's key term \"الإدلال\" (al-idlāl) is from root دلو (D-L-W).*\n- Root: دلو (D-L-W)\n  * Lisan / Ayn: \"دلا الدلو: أخرجها من البئر\" — to draw water from a well; hence *iddalā'a* (إدلال) means to advance boldly, relying on a familiar bond.\n  * Al-Raghib (Mufradat): Not a primary Quranic term, but lexically implies confident approach based on prior intimacy.\n  * Al-Zamakhshari (Asas): Literal: lowering the bucket. Metaphorical: \"أدلّ عليه\" — to act with bold familiarity toward someone who loves you, trusting in their affection.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Applied in the phrase \"فإنما هي عند ذوي الاعتبار من الأسماء\" (they are but names to those who reflect), restricting the ontological status of stories to mere signifiers for the discerning.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "38": [{"arabic": "بنيان هامان لفرعون يعني قول فرعون فأوقد لي يا هامان على الطين يعني به الآجر ويقال إن فرعون هو أول من بني له بالجص والآجر وأول من عمله هامان ثم تبعهما الجبابرة وهذا هو الزخرف ورأى بعض السلف جامعا في بعض الأمصار فقال أدركت هذا المسجد مبنيا من الجريد والسعف ثم رأيته من رهص ثم رأيته الآن مبنيا باللبن فكان أصحاب السعف خيرا من أصحاب الرهص وكان أصحاب الرهص خير من أصحاب اللبن وكان من السلف من يبني داره مرارا في مدة عمره لضعف بنائه وقصر أمله وزهده في إحكام البنيان وكان منهم من إذا حج أو غزا نزع بيته", "english": "ʿĀ'ishah, may God Most High be well pleased with her, said: \"Forty nights would pass over us without a lamp or fire being lit in the house of the Messenger of God, may God bless him and grant him peace.\" It was said to her: \"Then by what did you live?\" She said: \"By the two black things: dates and water.\" (1) This is the abandonment of meat, broth, and condiments.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 1096", "section_title_en": "The Revival of the Religious Sciences — Book on Poverty and Asceticism (Kitāb al-Faqr wa al-Zuhd): Section on the Ascetic's Conduct Regarding Food, Clothing, Dwelling, and Furnishings", "section_index": 1096, "anchors": "- Root: طوي (ṭ-w-y)\n  * Lisan / Ayn: To fold up, to roll up; to pass the night fasting (ṭawā); to traverse a distance.\n  * Al-Raghib (Mufradat): Implies enduring hunger by \"folding\" the stomach over itself—abstaining from filling it.\n  * Al-Zamakhshari (Asas): Literal: folding a garment. Metaphorical: the ascetic \"folds up\" his days in hunger, i.e., passes them without food.\n- Root: لبس (l-b-s)\n  * Lisan / Ayn: To cover, to clothe; to become confused/ambiguous (il tibās).\n  * Al-Raghib (Mufradat): Clothing as that which covers one's shame (saw'ah); extended metaphorically to the spouse as a \"garment\" (libās) for the other.\n  * Al-Zamakhshari (Asas): Literal: wearing a garment. Metaphorical: \"wearing\" a people's manner/dress (ziyy) entails becoming one of them—hence the Hadith cited: \"Whoever imitates a people's dress is of them.\"\n- Root: بني (b-n-y)\n  * Lisan / Ayn: To build, to erect a structure; binyān: edifice.\n  * Al-Raghib (Mufradat): Building beyond necessity is a sign of long hope (ṭūl al-amal) and worldly attachment, antithetical to zuhd.\n  * Al-Zamakhshari (Asas): Literal: construction with mortar and brick. Metaphorical: \"raising\" oneself in pride (ʿulūw) — condemned in the Qur'anic verse cited.\n- Root: سكن (s-k-n)\n  * Lisan / Ayn: To dwell, to be tranquil; maskan: dwelling place.\n  * Al-Raghib (Mufradat): The dwelling is for repelling harm (heat, cold, eyes) — its measure is necessity (ḍarūrah), not luxury.\n  * Al-Zamakhshari (Asas): Literal: a place of residence. Metaphorical: the heart's \"dwelling\" on God (sakīnah) — contrasted with physical dwellings that distract.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to delimit the degrees of zuhd: \"The least degree is only what repels heat and cold...\" (innamā yuqṣad), restricting the licit to the necessary.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}], "39": [{"arabic": "تعالى {واستكبر هو وجنوده في الأرض بغير الحق} فتكبر هو على الله وعلى رسله جميعا قال وهب قال له موسى عليه السلام آمن ولك ملكك قال حتى أشاور هامان فشاور هامان فقال هامان بينما أنت رب يعبد إذ صرت عبد تعبد فاسنكف عن عبودية الله وعن اتباع موسى عليه السلام وقالت قريش فيما أخبر الله تعالى عنهم {لولا نزل هذا القرآن على رجل من القريتين عظيم} قال قتاده عظيم القريتين هو الوليد بن المغيرة وأبو مسعود الثقفي طلبوا من هو أعظم رياسة من النبي صلى الله عليه وسلم إذ قالوا غلام يتيم كيف بعثه الله إلينا فقال تعال", "english": "Know that the one against whom pride is directed is either God—mighty and majestic—or His messengers, or the rest of His creation. Man has been created unjust and ignorant {«وخلق الإنسان ظلوما جهولا»}, so at times he grows proud against the creation, and at times he grows proud against the Creator. Thus, pride, considered with respect to the one against whom it is directed, falls into three divisions.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 855", "section_title_en": "Exposition of the One Against Whom Pride Is Directed, Its Degrees, Its Divisions, and the Fruits of Pride Within It", "section_index": 855, "anchors": "- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core root denotes magnitude, whether physical size, age, or rank; \"الكبرة\" specifically marks the state of advanced age or an ingrained, chronic condition.\n  * Al-Raghib (Mufradat): \"الكبير والصغير من الأسماء المتضايفة\" — bigness and smallness are relative terms. In the theological context, pride (الكبر) is the soul's self-magnification against another, a relational vice that distorts the creature's standing before the Creator.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage concerns physical or quantitative magnitude. Metaphorical (Majaz) usage transfers this to moral and spiritual stature, as in \"كبر علي ذلك\" (it weighed heavily upon him) — here, the soul's swelling against divine command is a metaphorical arrogation of greatness.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — Governing the syntactic tension between the agent of pride (المتكبر) and its object (المتكبر عليه), where the preposition \"على\" carries the full weight of opposition and elevation, structuring the periodic sentences that follow.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}], "48": [{"arabic": "له (3) وفي حديث آخر ثلاث من أوتيهن فقد أوتي مثل ما أوتي آل داود العدل في الرضا والغضب والقصد في الغنى والفقر وخشية الله في السر والعلانية (4) فهذه شروط ذكرها رسول الله صلى الله عليه وسلم لأولى الإيمان فالعجب ممن يدعي علم الدين ولا يصادف في نفسه ذرة من هذه الشروط ثم يكون نصيبه من علمه وعقله أن يجحد مالا يكون إلا بعد مجاوزة مقامات عظيمة علية وراء الإيمان وفي الأخبار أن الله تعالى أوحى إلى بعض أنبيائه إنما اتخذ لخلتي من لا يفتر عن ذكري ولا يكون له هم غيري ولا يؤثر علي شيئا من خلقي وإن حرق بالنار لم يج", "english": "I say: The servant does not complete his faith until the scarcity of a thing becomes more beloved to him than its abundance, and until his being unknown becomes more beloved to him than being known. (1) And he, peace be upon him, said: \"Three qualities — whoever possesses them has completed his faith: he does not fear, in [the cause of] God, the blame of any blamer; he does not show off (yura'i) with any of his deeds; and when two matters are presented to him — one for this world and the other for the Hereafter — he prefers the matter of the Hereafter over this world.\" (2) And he, peace be upon him, said: \"The faith of a servant is not completed until three traits are in him: when he becomes angry, his anger does not expel him from the truth; when he becomes pleased, his pleasure does not admit him into falsehood; and when he has power [over something], he does not seize what is not rightfully his.\" (3) And in another hadith: \"Three [things] — whoever is given them has been given the like of what was given to the family of David: justice in pleasure and anger, moderation in wealth and poverty, and fear of God in secret and in public.\" (4)", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1202", "section_title_en": "The Completion of Faith and Its Degrees — The Station of Love and the States of the Friends of God", "section_index": 1202, "anchors": "- Root: ق-ل-ل (Q-L-L)\n  * Lisan / Ayn: Core meaning of scarcity, fewness, and diminution; the opposite of kathrah (abundance).\n  * Al-Raghib (Mufradat): Theological nuance: qillah denotes a state of worldly paucity that, when loved for God's sake, becomes a mark of sincere detachment (zuhd) and complete reliance (tawakkul).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): numerical fewness. Metaphorical (Majaz): the soul's preference for obscurity and lowliness over fame and recognition, as a sign of humility before God.\n- Root: غ-ض-ب (Gh-D-B)\n  * Lisan / Ayn: Core meaning: boiling of the blood of the heart seeking vengeance; a natural human passion.\n  * Al-Raghib (Mufradat): When attributed to God, it denotes pure retributive justice (intiqam), not passion. For man, it is a test: whether anger overthrows truth ('adl) or remains subordinate to it.\n  * Al-Zamakhshari (Asas): Literal: the physical agitation of anger. Metaphorical: the moral restraint of anger so that it never veers from justice — as in the prophetic condition of faith.\n- Root: خ-ل-ل (Kh-L-L)\n  * Lisan / Ayn: Core meaning: penetration and interstice; khillah is the intense love that penetrates the very core of the heart, leaving no room for others.\n  * Al-Raghib (Mufradat): Khillah (intimate friendship) is the highest degree of divine love, exclusive to the Prophet ﷺ, as distinct from mahabah (love) which may be shared by the believers.\n  * Al-Zamakhshari (Asas): Literal: the state of being a khalil (intimate friend). Metaphorical: the Prophet's ﷺ declaration that his heart was so filled with God that no created being could share that rank — hence Abu Bakr was granted the station of companionship (suhbah), not khillah.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The divine revelation \"إنما اتخذت لخلتي...\" restricts the attainment of khillah exclusively to those whose entire being is consumed by remembrance of God, excluding all else.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "54": [{"arabic": "الصبر مرتين مرة بشربه ومرة برميه فلا جرم أولئك يؤتون أجرهم مرتين بما صبروا وهذا يضاهي طريق من يعطي جهرا فيأخذ ويرد سرا ليكسر نفسه بالذل جهرا وبالفقر سرا فمن فاته هذا فلا ينبغي أن يفوته إظهار شهوته ونقصانه والصدق فيه ولا ينبغي أن يغره قول الشيطان إنك إذا أظهرت اقتدى بك غيرك فاستره إصلاحا لغيرك فإنه لو قصد إصلاح غيره لكان إصلاح نفسه أهم عليه من غيره فهذا إنما يقصد الرياء المجرد ويروجه الشيطان عليه في معرض إصلاح غيره فلذلك ثقل عليه ظهور ذلك منه واعلم أن من اطلع عليه ليس يقتدى به في الفعل أو لا ينزجر باعتقاده أنه تا", "english": "**The First of Them:** That the soul is unable to abandon some desires, and so craves them — but he does not wish it to be known that he craves them. Thus he conceals the desire and eats in private what he does not eat in company. This is the covert associationism (al-shirk al-khafī). A certain scholar was asked about one of the ascetics (zuhhād), and he remained silent about him. It was said to him: \"Do you know any fault in him?\" He said: \"He eats in private what he does not eat in company.\" This is a mighty affliction. Rather, the right of the servant — when he is afflicted with desires and the love of them — is to make them manifest. For this is the truthfulness of one's state (ṣidq al-ḥāl), and it is a substitute for the loss of the spiritual struggles (mujāhadāt) performed through deeds. For concealing one's deficiency while displaying its opposite as perfection is two compounded deficiencies; and falsehood joined with concealment is two falsehoods. Thus he becomes deserving of two abhorrences, and nothing will satisfy on his behalf except two sincere repentances.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 649", "section_title_en": "The Revival of the Religious Sciences — Section 649: The Exposition of the Difference in the Ruling on Hunger and Its Excellence, and the Difference in People's States Regarding It; The Exposition of the Affliction of Ostentation (Riyāʾ) That Creeps Upon One Who Abandons Desires and Reduces Food", "section_index": 649, "anchors": "- Root: شهو (Shahwah)\n  * Lisan / Ayn: [Core linguistic root meaning: intense desire, craving, appetite — the soul's yearning for what pleases it]\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance: شهوة is the inclination of the natural constitution toward what is agreeable; in the Quranic context, it is that which must be restrained, yet its concealment can become a graver spiritual malady than its indulgence]\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction: Literal — craving for food and sensual pleasures; Metaphorical — شهوة الجاه (craving for status/reputation), which is the hidden desire that corrupts acts of renunciation]\n- Root: ريا (Riyāʾ)\n  * Lisan / Ayn: [Core linguistic root meaning: to show, to display; from الرؤية (sight/seeing)]\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance: الرياء is the seeking of station in the hearts of people through acts of obedience — a form of hidden associationism (shirk khafī)]\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction: Literal — making something visible; Metaphorical — performing acts of worship to be seen by creation rather than the Creator]\n- Root: صدق (Ṣidq)\n  * Lisan / Ayn: [Core linguistic root meaning: truthfulness, veracity, the correspondence of inward and outward]\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance: الصدق is primarily in speech/report, but secondarily in every act that manifests the truth of one's state; it is the foundation of the station of the ṣiddīqīn]\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction: Literal — truthful speech; Metaphorical — صادق الحملة (truthful in the charge), i.e., one whose outward act manifests his inward state without dissimulation]\n- Root: زهد (Zuhd)\n  * Lisan / Ayn: [Core linguistic root meaning: abstention, renunciation, regarding something as little/insignificant]\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance: الزهد is the soul's turning away from a thing and being content with little of it; its ultimate limit is renouncing even the renunciation itself (الزهد في الزهد)]\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction: Literal — abandoning what is lawful out of asceticism; Metaphorical — الزهد في الزهد (renouncing one's own renunciation by concealing it), which is the station of the ṣiddīqīn]\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — [The restriction of the predicate to the subject, as in \"إنما يقصد به تلبيس حاله\" — restricting the intent to the mere concealment of one's state, and \"هذا هو الشرك الخفي\" — the focused predication identifying hidden ostentation as covert associationism]", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}], "60": [{"arabic": "الليل يتلذذ به في رجاء إنعامه والرجاء في حق الله تعالى أصدق وما عند الله خير وأبقى وأنفع مما عند غيره فكيف لا يتلذذ بعرض الحاجات عليه في الخلوات وأما النقل فيشهد له أحوال قوام الليل في تلذذهم بقيام الليل واستقصارهم له كما يستقصر المحب ليلة وصال الحبيب حتى قيل لبعضهم كيف أنت والليل قال ما راعيته قط يريني وجهه ثم ينصرف وما تأملته بعد وقال آخر أنا والليل فرسا رهان مرة يسبقني إلى الفجر ومرة يقطعني عن الفكر وقيل لبعضهم كيف الليل عليك فقال ساعة أنا فيها بين حالتين أفرح بظلمته إذا جاء وأغتم بفجره إذا طلع ما تم فرحي به قط وقال علي بن ب", "english": "That if the beautiful Beloved were behind a veil or in a dark house, the lover would still take delight in mere proximity to Him, without vision and without coveting any other matter besides Him — and he would find joy in displaying his love before Him and in mentioning Him with his tongue within His hearing, even though that too were already known to Him. For if you say: \"He awaits His response\" — then let him delight in hearing His response; yet he does not hear the speech of God, exalted be He. Know then that if he knows that He will not answer him and will remain silent toward him, there still remains for him a delight in presenting his states before Him and in raising his innermost secret to Him. How [could it be otherwise], when the one who is certain (al-mūqin) hears from God, exalted be He, everything that occurs to his mind during the course of his whispered communion (munājāh), and thus takes delight in it? Likewise, one who secludes himself with a king and presents his needs to him in the depths of the night takes delight in it through hope of his beneficence — and hope with respect to God, exalted be He, is more truthful, and what is with God is better, more enduring, and more beneficial than what is with anyone else. So how would he not delight in presenting his needs before Him in private seclusions (khalawāt)?", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 277", "section_title_en": "On the Delight of Night Vigil and Whispered Communion — Section 277", "section_index": 277, "anchors": "- Root: ليل (layl)\n  * Lisan / Ayn: Night; the period of darkness following sunset until dawn; its diminutive is 'luyaylah' and its plural is 'layālin' — indicating a temporal span marked by stillness and concealment.\n  * Al-Raghib (Mufradat): Night (al-layl) is that which veils (yughashshī) and covers, as in {«وَاللَّيْلِ إِذَا يَغْشَى»} — a time when sensory distractions recede and the heart turns toward intimate communion (munājāh) with the Divine.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): the astronomical night. Metaphorical (majāz): the night of the heart — a state of spiritual wakefulness wherein the lover finds delight in solitude with the Beloved, as expressed in the sayings of the pious transmitted herein.\n- Root: نور (nūr)\n  * Lisan / Ayn: Light; illumination that renders things visible; also the fire-kindling and the beacon (manār) guiding travelers.\n  * Al-Raghib (Mufradat): Light is of two kinds: sensory light perceived by the eye, and intellectual/spiritual light (nūr al-ʿaql, nūr al-Qurʾān) perceived by the inner eye of insight (baṣīrah). The Divine light cast into the hearts of the vigilant is of this latter kind — an immaterial radiance (laṭīfah nūrāniyyah) that transforms the inner state.\n  * Al-Zamakhshari (Asas): Literal: physical illumination. Metaphorical: 'nawwara al-amr' — to clarify and illuminate a matter; here, the spreading of spiritual lights (anwār) from wakeful hearts to heedless ones is a metaphorical extension of this root, signifying the transmission of divine grace.\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart; also the turning and revolving of a thing from one state to another (taqlīb).\n  * Al-Raghib (Mufradat): The heart is so named for its constant fluctuation (taqallub) between states; it is the seat of perception and understanding, the locus of divine address and the receptacle of spiritual lights.\n  * Al-Zamakhshari (Asas): Literal: the physical organ. Metaphorical: 'qallaba al-amr' — to examine and turn over a matter; here, the hearts of the vigilant are 'turned over' by divine light, and from them 'spread' (tantašir) blessings to others — a metaphorical extension of physical turning to spiritual transformation.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle 'innamā' restricts and confines the predicate to the subject alone, as in the transmitted saying: \"The delight of whispered communion is not of this world; it is only (innamā) of Paradise\" — a focused predication that negates any worldly share of this pleasure and affirms its exclusive otherworldly origin.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Arrangement of Litanies'", "badge": "Insight"}], "70": [{"arabic": "الشكر فى السموات والأرض وله الحمد فى الأولى والآخرة والصلاة على محمد ذي المعجزات الظاهرة والآيات الباهرة وعلى آله وأصحابه وسلم تسليما كثيرا أما بعد فجدير بمن الموت مصرعه والتراب مضجعه والدود أنيسه ومنكر ونكير جليسه والقبر مقره وبطن الأرض مستقره والقيامة موعده والجنة أو النار مورده أن لا يكون له فكر إلا فى الموت ولا ذكر إلا له ولا استعداد إلا لأجله ولا تدبير إلا فيه ولا تطلع إلا إليه ولا تعريج إلا عليه ولا اهتمام إلا به ولا حول إلا حوله ولا انتظار وتربص إلا له وحقيق بأن يعد نفسه من الموتى ويراها", "english": "To proceed: Worthy is one whose place of downfall is death, whose bed is the dust, whose companion is the worm, whose boon-companions are Munkar and Nakīr, whose abode is the grave, whose resting-place is the belly of the earth, whose appointed time is the Resurrection, and whose destination is Paradise or the Fire — that he should have no thought except of death, no remembrance except of it, no preparation except for it, no deliberation except concerning it, no aspiration except toward it, no lingering except upon it, no concern except with it, no power except around it, and no waiting or tarrying except for it. And it is fitting that he should count himself among the dead and see himself among the inhabitants of the graves, for everything that is coming is near, and the distant is only that which is not coming. The Messenger of God, peace and blessings be upon him, said: \"The shrewd one (al-kayyis) is he who subdues his soul and works for what comes after death\" (1). And preparation for a thing will not be facilitated except upon the renewal of its remembrance in the heart, and its remembrance is not renewed except through recollection by lending ear to those things that remind of it and by looking upon those things that alert to it.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1281", "section_title_en": "The Book of the Remembrance of Death and What Follows It — Introduction and Opening Homily", "section_index": 1281, "anchors": "- Root: موت (m-w-t)\n  * Lisan / Ayn: Core root denotes cessation of vital faculty; death as transition, not annihilation.\n  * Al-Raghib (Mufradat): Death is the divinely ordained terminus of corporeal life, gateway to reckoning; \"أماته فأقبره\" {«عبس/ 21»} implies divine disposal of the deceased.\n  * Al-Zamakhshari (Asas): Literal: bodily death and burial. Metaphorical: \"أحيا الله البلد الميت\" — revival of barren land; death of hearts through heedlessness.\n- Root: قبر (q-b-r)\n  * Lisan / Ayn: Grave as the resting place of the dead; \"المقبرة\" as the site of interment.\n  * Al-Raghib (Mufradat): \"حتى زرتم المقابر\" {«التكاثر/ 2»} — metonymy for death itself; the grave as prelude to resurrection.\n  * Al-Zamakhshari (Asas): Literal: burial of the deceased. Metaphorical: \"رفع قبراه\" — the haughty one who raises his nose like a grave-mound, signifying pride.\n- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: Praise predicated upon volitional excellence; gratitude for beneficence.\n  * Al-Raghib (Mufradat): True praise (ḥamd) is due solely to God, whose acts are pure beneficence; distinct from mere thanks (shukr) for favors received.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله بجميع محامده\" — praising God with all praises. Metaphorical: \"أحمدت صنيعه\" — approving an act as praiseworthy.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic opening \"الحمد لله الذي...\" employs a suspended genitive construction (جار ومجرور) with a relative clause (صلة الموصول) that permits extended expansion, governing the entire homiletic sequence that follows.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}], "76": [{"arabic": "وسلم فقال نعم إن الله لا يحب المستكبرين فنزل وقعد معهم على الأرض وأكل ثم سلم عليهم وركب وقال قد أجبتكم فأجيبوني قالوا نعم فوعدهم وقتا معلوما فحضروا فقدم إليهم فاخر الطعام وجلس يأكل معهم وأما قول القائل إن من وضعت يدي في قصعته فقد ذلت له رقبتي فقد قال بعضهم هذا خلاف السنة وليس كذلك فإنه ذل إذا كان الداعي لا يفرح بالإجابة ولا يتقلد منة وكان يرى ذلك يدا له على المدعو ورسول الله صلى الله عليه وسلم كان يحضر لعلمه أن الداعي له يتقلد منة ويرى ذلك شرفا وذخرا لنفسه في الدنيا", "english": "The Prophet (peace and blessings be upon him) said: \"Do not burden your guest so that you make him hate you, for whoever hates his guest has hated Allah, and whoever hates Allah, Allah hates him.\"", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 290", "section_title_en": "The Etiquettes of Hospitality: Invitation, Response, Attendance, and the Serving of Food — Section 290 of The Revival of the Religious Sciences", "section_index": 290, "anchors": "- Root: ضيف (ḍ-y-f)\n  * Lisan / Ayn: Core meaning is \"to incline, to lean toward.\" The guest (al-ḍayf) is one who inclines toward you, alighting as a visitor; the root carries the sense of leaning or bending.\n  * Al-Raghib (Mufradat): The guest is \"one who inclines to you, alighting with you\"; hospitality (al-ḍiyāfah) became customary in the sense of receiving such a one. The word is originally a verbal noun, hence one and many are equal in most usage.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ḍāfa ilayhi: he inclined toward him\"; \"ḍāfat al-shams: the sun inclined toward setting.\" Metaphorical (majāz): \"aḍāfa ilayhi amran: he attributed a matter to him, leaning it upon him\"; \"al-muḍāf: the one constrained, hemmed in, in distress.\"\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the Prophet's statement \"innamā hādhihi al-akhlāq bi-yad Allāh\" (these morals are only in the hand of Allah), where innamā restricts the attribution of moral character exclusively to divine bestowal.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Anger and Hatred'", "badge": "Ethics"}], "77": [{"arabic": "قال الله وأحسن كما أحسن الله إليك وقال عز وجل إن الله يأمر بالعدل والإحسان وقال سبحانه إن رحمت الله قريب من المحسنين ونعني بالإحسان فعل ما ينتفع به المعامل وهو غير واجب عليه ولكنه تفضل منه فإن الواجب يدخل في باب العدل وترك الظلم وقد ذكرناه وتنال رتبة الإحسان بواحد من ستة أمور الأول في المغابنة فينبغي أن لا يغبن صاحبه بما لا يتغابن به في العادة فأما أصل المغابنة فمأذون فيه لأن البيع للربح ولا يمكن ذلك إلا بغبن ما ولكن يراعي فيه التقريب فإن بذل المشتري زيادة على الربح المعت", "english": "God (Exalted is He) has commanded both justice (al-ʿadl) and excellence (al-iḥsān) together. Justice is only the cause of deliverance (al-najāh), and it runs in trade as the course of capital (raʾs al-māl). Excellence is the cause of triumph (al-fawz) and the attainment of felicity (al-saʿādah), and it runs in trade as the course of profit (al-ribḥ). None is counted among the heedless who is content in his worldly transactions with merely his capital — and so likewise in the transactions of the Hereafter. Thus it behooves the religious person not to restrict himself to justice and the avoidance of wrongdoing (ẓulm), abandoning the doors of excellence. God has said: {«وَأَحْسِنْ كَمَا أَحْسَنَ اللَّهُ إِلَيْكَ»} (\"And do good as God has done good to you\") {«إِنَّ اللَّهَ يَأْمُرُ بِالْعَدْلِ وَالْإِحْسَانِ»} (\"Indeed, God commands justice and excellence\"), and He (Exalted is He) has said: {«إِنَّ رَحْمَتَ اللَّهِ قَرِيبٌ مِنَ الْمُحْسِنِينَ»} (\"Indeed, the mercy of God is near to the doers of excellence\").", "book_title": "Etiquette of Earning", "section_title_ar": "Section 328", "section_title_en": "Chapter Four: On Excellence (Iḥsān) in Transactional Dealings", "section_index": 328, "anchors": "- Root: ع د ل (ʿadala)\n  * Lisan / Ayn: Core meaning of equality, straightness, and balance; the root denotes that which is level and even, without crookedness or deviation.\n  * Al-Raghib (Mufradat): \"العدالة والمعادلة: لفظ يقتضي معنى المساواة\" — justice is that which is perceived by inner insight (al-baṣīrah), pertaining to judgments and rulings; it is the equitable apportioning of things on an even scale.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage pertains to physical evenness and moderation (e.g., a horse with an even blaze); metaphorical (majāz) extension applies to moral and legal equity.\n- Root: ر ب ح (rabiḥa)\n  * Lisan / Ayn: Gain, profit, increase in trade; the root signifies surplus and augmentation.\n  * Al-Raghib (Mufradat): \"الربح: الزيادة الحاصلة في المبايعة، ثم يتجوز به في كل ما يعود من ثمرة عمل\" — profit is the increase occurring in exchange, then metaphorically extended to every fruit that returns from a deed.\n  * Al-Zamakhshari (Asas): Literal usage in commerce; metaphorical usage: \"تجارة رابحة\" — a profitable transaction, extended to spiritual commerce.\n- Root: و ق د (waqada)\n  * Lisan / Ayn: Fire blazing and burning fiercely; kindling.\n  * Al-Raghib (Mufradat): Fire that burns; used in the Qur'an for the fuel of Hellfire.\n  * Al-Zamakhshari (Asas): Literal: fire blazing; Metaphorical: \"قلب وقاد\" — a blazing, keen intellect; \"وقدة الصيف\" — the intense heat of summer.\n- Sibawayh Rule: Chapter on the Interposition between the Preposition and its Object (Bāb al-Faṣl bayn al-Jār wa al-Majrūr) — governing the permissible separation between grammatical operators and their operands for rhetorical emphasis, as in the periodic construction of conditional and exceptive clauses.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Earning'", "badge": "Hadith"}, {"arabic": "قال الله تعالى ولا تنس نصيبك من الدنيا أي لا تنس في الدنيا نصيبك منها للآخرة فإنها مزرعة الآخرة وفيها تكتسب الحسنات وإنما تتم شفقة التاجر على دينه بمراعاة سبعة أمور الأول حسن النية والعقيدة في ابتداء التجارة فلينو بها الاستعفاف عن السؤال وكف الطمع عن الناس استغناء بالحلال عنهم واستعانة بما يكسبه على الدين وقياما بكفاية العيال ليكون من جملة المجاهدين به ولينو النصح للمسلمين وأن يحب لسائر الخلق ما يحب لنفسه ولينو اتباع طريق العدل والإحسان في معاملته كما ذكرناه ولينو الأمر بالمعروف والن", "english": "Some of the Salaf (may God be pleased with them) said: \"The thing most worthy of the intelligent man is that which he most needs in the immediate term; and the thing he most needs in the immediate term is that whose consequence is most praiseworthy in the long term.\"", "book_title": "Etiquette of Earning", "section_title_ar": "Section 332", "section_title_en": "On the Merchant's Vigilance Over His Religion: Seven Matters of Concern in Trade", "section_index": 332, "anchors": "- Root: دنا (d-n-w)\n  * Lisan / Ayn: Proximity, nearness in place, time, or rank; the nearer (adnā) as opposed to the farther.\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات، أو بالحكم\" — nearness by essence or by judgment; used of place, time, and station. The \"nearer life\" (al-ḥayāh al-dunyā) is the proximate, lower life.\n  * Al-Zamakhshari (Asas): Literal: physical nearness. Metaphorical: the worldly life (al-dunyā) as that which is \"nearer\" and lower, contrasted with the Hereafter (al-ākhirah) which is \"farther\" but enduring.\n- Root: سوق (s-w-q)\n  * Lisan / Ayn: To drive, to impel, to lead; a market (sūq) where goods are driven and circulated.\n  * Al-Raghib (Mufradat): The driving of one's self toward a goal; the market as the arena of exchange and transaction.\n  * Al-Zamakhshari (Asas): Literal: \"ساق النعم فانساقت\" — he drove the cattle and they were driven. Metaphorical: \"ساق الله إليه خيرا\" — God drove good to him; \"ساق إليها المهر\" — he sent the dowry to her. The \"market of the Hereafter\" (sūq al-ākhirah) is the mosque, where one trades deeds for the next life.\n- Root: جار (j-w-r)\n  * Lisan / Ayn: To deviate from the right path, to wrong, to oppress; also a neighbor (jār) whose rights are sacred.\n  * Al-Raghib (Mufradat): \"الجار: من يقرب مسكنه منك\" — the neighbor is one whose dwelling is near yours; a reciprocal term. God's right and the neighbor's right are conjoined in the Qur'anic verse {والجار ذي القربى والجار الجنب} (Al-Nisā': 36).\n  * Al-Zamakhshari (Asas): Literal: oppression and transgression. Metaphorical: the \"oppressive oath\" (yamīn fājirah) — an oath that swerves from truth and justice.\n- Root: الي (a-l-w)\n  * Lisan / Ayn: To fall short, to fail; also related to رسالة (message) via مألكة.\n  * Al-Raghib (Mufradat): The root conveys the idea of commission and conveyance of a message; \"المألكة: الرسالة\" — the message, because it is \"chewed\" in the mouth (from ألك, to masticate).\n  * Al-Zamakhshari (Asas): Literal: to chew. Metaphorical: the angelic conveyance of revelation as a \"message\" delivered.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — When the author says \"وإنما تتم شفقة التاجر على دينه بمراعاة سبعة أمور\" (\"The merchant's compassion for his religion is only completed by observing seven matters\"), the particle إنما restricts and confines the predicate to the subject, establishing that these seven matters are the exclusive and exhaustive means to the end.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Earning'", "badge": "Hadith"}, {"arabic": "وسلم فقال نعم إن الله لا يحب المستكبرين فنزل وقعد معهم على الأرض وأكل ثم سلم عليهم وركب وقال قد أجبتكم فأجيبوني قالوا نعم فوعدهم وقتا معلوما فحضروا فقدم إليهم فاخر الطعام وجلس يأكل معهم وأما قول القائل إن من وضعت يدي في قصعته فقد ذلت له رقبتي فقد قال بعضهم هذا خلاف السنة وليس كذلك فإنه ذل إذا كان الداعي لا يفرح بالإجابة ولا يتقلد منة وكان يرى ذلك يدا له على المدعو ورسول الله صلى الله عليه وسلم كان يحضر لعلمه أن الداعي له يتقلد منة ويرى ذلك شرفا وذخرا لنفسه في الدنيا", "english": "The Prophet (peace and blessings be upon him) said: \"Do not burden your guest so that you make him hate you, for whoever hates his guest has hated Allah, and whoever hates Allah, Allah hates him.\"", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 290", "section_title_en": "The Etiquettes of Hospitality: Invitation, Response, Attendance, and the Serving of Food — Section 290 of The Revival of the Religious Sciences", "section_index": 290, "anchors": "- Root: ضيف (ḍ-y-f)\n  * Lisan / Ayn: Core meaning is \"to incline, to lean toward.\" The guest (al-ḍayf) is one who inclines toward you, alighting as a visitor; the root carries the sense of leaning or bending.\n  * Al-Raghib (Mufradat): The guest is \"one who inclines to you, alighting with you\"; hospitality (al-ḍiyāfah) became customary in the sense of receiving such a one. The word is originally a verbal noun, hence one and many are equal in most usage.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ḍāfa ilayhi: he inclined toward him\"; \"ḍāfat al-shams: the sun inclined toward setting.\" Metaphorical (majāz): \"aḍāfa ilayhi amran: he attributed a matter to him, leaning it upon him\"; \"al-muḍāf: the one constrained, hemmed in, in distress.\"\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the Prophet's statement \"innamā hādhihi al-akhlāq bi-yad Allāh\" (these morals are only in the hand of Allah), where innamā restricts the attribution of moral character exclusively to divine bestowal.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Anger and Hatred'", "badge": "Ethics"}], "79": [{"arabic": "التواضع ومن العداوة إلى النصيحة (1) وقال تعالى فخرج على قومه في زينته قال الذين يريدون الحياة الدنيا يا ليت لنا مثل ما أوتي قارون إنه لذو حظ عظيم وقال الذين أوتوا العلم ويلكم ثواب الله خير لمن آمن الآية فعرف أهل العلم بإيثار الآخرة على الدنيا ومنها أن لا يخالف فعله قوله بل لا يأمر بالشيء ما لم يكن هو أول عامل به قال الله تعالى أتأمرون الناس بالبر وتنسون أنفسكم وقال تعالى كبر مقتا عند الله أن تقولوا ما لا تفعلون وقال تعالى في قصة شعيب وما أريد أن أخالفكم إلى ما أنهاكم عنه وقال تعالى واتقوا الله ويعلمكم الله وقال تعال", "english": "[Root: ملح]\n  • Lisan al-Arab: \"الملح: ما يصلح الطعام، وجمعه ملوح وأملاح. والمليح: الحسن. والملاحة: الحسن. وملح الرجل يملح ملاحة: حسن. وتملح: تزين.\"\n  • Al-Raghib (Al-Mufradat): \"الملح: ما يحفظ الطعام ويمنع فساده، ويستعار لما يحفظ الإيمان والعلم من الفساد.\"\n  • Al-Zamakhshari (Asas): \"ملح الماء: إذا كان فيه ملوحة. وملح الطعام: جعل فيه الملح. وهذا على الحقيقة، ويستعار الملح لما يصلح به الأمر.\"\n  • Kitab al-Ayn: \"الملح: معروف، والمليح: الحسن من كل شيء.\"", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 52", "section_title_en": "Section 52", "section_index": 52, "anchors": "*(Anchors established)*", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Poverty and Abstinence'", "badge": "Ethics"}], "80": [{"arabic": "وقال عز وجل {وقال الذين أوتوا العلم ويلكم ثواب الله خير لمن آمن وعمل صالحا} بين أن عظم قدر الآخرة يعلم بالعلم وقال تعالى {وتلك الأمثال نضربها للناس وما يعقلها إلا العالمون} وقال تعالى {ولو ردوه إلى الرسول وإلى أولي الأمر منهم لعلمه الذين يستنبطونه منهم} رد حكمه في الوقائع إلى استنباطهم وألحق رتبتهم برتبة الأنبياء في كشف حكم الله وقيل في قوله تعالى يا بني آدم قد أنزلنا عليكم لباسا يواري سوءاتكم يعني العلم وريشا يعني اليقين ولباس التقوى يعني الحياء وقال عز وجل {ولقد جئناهم بكتاب فصلناه على علم} وقال", "english": "How He, Glorified and Exalted, began with Himself, then seconded with the angels, and thirded with the people of knowledge — and sufficient for you is this as honor, excellence, splendor, and nobility. And God, Exalted, said: {«يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات»} — \"God will raise those who have believed among you and those who have been given knowledge, in degrees.\" Ibn ʿAbbās, may God be pleased with them both, said: For the scholars there are degrees above the believers, seven hundred degrees, and between each two degrees is a distance of five hundred years' journey.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 4", "section_title_en": "The Book of Knowledge — Section 4: The Excellence of Knowledge and the Scholars", "section_index": 4, "anchors": "- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Core root meaning of knowing, perceiving a thing in its true reality; the act of apprehension and judgment.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment of existence or non-existence.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes genuine knowing; metaphorical (majāz) usage extends to signs, landmarks, and traces that guide to knowledge.\n- Root: درج (d-r-j)\n  * Lisan / Ayn: Degrees, steps, ascending stations; the root denotes gradation and progressive elevation.\n  * Al-Raghib (Mufradat): \"الدرجة نحو المنزلة، لكن يقال للمنزلة: درجة إذا اعتبرت بالصعود\" — a degree is a station considered by ascent, not horizontal extension.\n  * Al-Zamakhshari (Asas): Literal: physical steps of ascent. Metaphorical: \"لفلان درجة رفيعة\" — lofty rank; \"امش في مدارج الحق\" — walk in the paths of truth.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day denotes the time of the sun's rising to its setting, and may denote any period of time whatsoever.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"ذكر في أيام العرب كذا\" — historical battles and events; \"وذكرهم بأيام الله\" — His mighty deeds against the disbelievers.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication) — The particle \"innamā\" restricts and confines the predicate to the subject alone, as in {«إنما يخشى الله من عباده العلماء»}, where fear of God is restricted exclusively to the scholars.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}], "83": [{"arabic": "في قبة له فسمعته يقول {تلك الدار الآخرة نجعلها للذين لا يريدون علوا في الأرض ولا فسادا والعاقبة للمتقين} ثم هدا فجعلت لا أسمع حركة ولا كلاما فقلت لوصيف له انظر أنائم هو فلما دخل صاح فوثبت فإذا هو ميت وقيل له لما حضره الموت أعهد يا أمير المؤمنين قال احذركم مثل مصرعي هذا فإنه لا بد لكم منه وروى أنه لما ثقل عمر بن عبد العزيز دعى له طبيب فلما نظر إليه قال أرى الرجل قد سقى السم ولا آمن عليه الموت فرفع عمر بصره وقال ولا تأمن الموت أيضا على من لم يسق السم قال الطبيب هل أحسست بذلك يا أمير المؤمنين قال نعم قد عرفت ذلك حين وقع في بطني قال فتعالج يا أمير ال", "english": "I say: Know that when death came to Muʿāwiyah ibn Abī Sufyān, he said, \"Seat me upright.\" So they seated him, and he began to glorify God Almighty and remember Him. Then he wept and said, \"Do you remember your Lord, O Muʿāwiyah, only after decrepitude and decline? Should this not have been while the branch of youth was fresh and verdant?\" And he wept until his weeping grew loud, then said, \"O Lord, have mercy on the sinful elder, the possessor of the hard heart. O Allah, overlook the misstep and forgive the slip, and repay with Your forbearance the one who hopes in none but You and trusts in none other than You.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1306", "section_title_en": "The Fifth Chapter: On the Deathbed Utterances of the Caliphs, Princes, and the Righteous", "section_index": 1306, "anchors": "- Root: حضر (ḥaḍara)\n  * Lisan / Ayn: Core meaning of presence, attendance, or arrival at a place or time.\n  * Al-Raghib (Mufradat): Often used for the arrival of an inevitable event, especially death (ḥuḍūr al-mawt), marking a temporal threshold.\n  * Al-Zamakhshari (Asas): Literal for physical presence; metaphorical for the onset of an inescapable decree.\n- Root: عهد (ʿahida)\n  * Lisan / Ayn: To covenant, to be charged with a trust, to make a bequest.\n  * Al-Raghib (Mufradat): Implies a binding injunction, often divine or paternal, that outlasts the speaker.\n  * Al-Zamakhshari (Asas): Literal for a written pact; metaphorical for the final counsel of the dying.\n- Root: وتر (watara)\n  * Lisan / Ayn: To make single, to sever, to deprive; also odd-numbered.\n  * Al-Raghib (Mufradat): In the passive (wutirat), signifies being left bereft or defrauded of one's due.\n  * Al-Zamakhshari (Asas): Literal for cutting off; metaphorical for the world's betrayal and stripping of its gifts.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — Governs the permissible separation of a preposition from its object for rhetorical emphasis, as seen in the dying men's abrupt, heartfelt exclamations.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}, {"arabic": "وقال الله تعالى {تلك الدار الآخرة نجعلها للذين لا يريدون علوا في الأرض ولا فسادا} جمع بين إرادة الفساد والعلو وبين أن الدار الآخرة للخالي عن الإرادتين جميعا فقال عز وجل ومن كان يريد الحياة الدنيا وزينتها نوف إليهم أعمالهم فيها وهم فيها لا يبخسون أولئك الذين ليس لهم في الآخرة إلا النار وحبط ما صنعوا فيها وباطل ما كانوا يعملون وهذا أيضا متناول بعمومه لحب الجاه فإنه أعظم لذة من لذات الحياة الدنيا وأكثر زينة من زينتها وقال رسول الله صلى الله عليه وسلم حب المال والجاه ينبتان النفاق في القلب كما ينبت الماء البقل (1) حديث م", "english": "And Allah Most High said: {«تلك الدار الآخرة نجعلها للذين لا يريدون علوا في الأرض ولا فسادا»} — \"That abode of the Hereafter — We appoint it for those who do not desire exaltation upon the earth, nor corruption.\" He joined together the desire for corruption and the desire for exaltation [in a single condemnation], and [declared] that the Hereafter belongs solely to the one who is free of both desires together.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 794", "section_title_en": "Section 794 — Exposition of the Blameworthiness of Prestige (Jāh) and Its True Meaning", "section_index": 794, "anchors": "- Root: جاه (J-W-H)\n  * Lisan / Ayn: Core root denotes \"face, countenance, standing, rank, dignity\" — the elevated position by which one is received with honor.\n  * Al-Raghib (Mufradat): Theological nuance: jāh is the \"station\" (manzilah) in hearts, distinct from mere wealth (māl); it is a spiritual sovereignty over others' inward dispositions.\n  * Al-Zamakhshari (Asas): Literal: \"place/standing before the king.\" Metaphorical: \"possession of hearts\" — the ruler's sway over subjects' wills, not their bodies.\n- Root: ملك (M-L-K)\n  * Lisan / Ayn: Possession, dominion, sovereign control over what one owns.\n  * Al-Raghib (Mufradat): Two modes: (1) tamalluk — actual possession and disposal; (2) quwwah — capacity to possess, whether or not exercised.\n  * Al-Zamakhshari (Asas): Literal: ownership of chattel. Metaphorical: \"malaka nafsahu\" (self-mastery), \"malaka al-mar'ah\" (marriage) — dominion over that which yields to one's authority.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: The heart; that which fluctuates, turns, and overturns between states.\n  * Al-Raghib (Mufradat): The heart is the seat of perception and volition; its \"turning\" (taqlīb) between conditions is its essential nature.\n  * Al-Zamakhshari (Asas): Literal: physical turning over. Metaphorical: \"qallaba al-umūr\" — to scrutinize and manage affairs; the heart as the organ of belief and inclination.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما هلاك الناس...\" restricts destruction solely to the two cited causes, excluding all others.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Poverty and Abstinence'", "badge": "Afterlife"}], "88": [{"arabic": "وهزم الأحزاب وحده (3) وفي بعض الروايات وكل شيء هالك إلا وجهه له الحكم وإليه ترجعون فينبغي أن يستعمل هذه السنة في رجوعه وإذا أشرف على مدينته يحرك الدابة ويقول اللهم اجعل لنا بها قرارا ورزقا حسنا ثم ليرسل إلى أهله من يخبرهم بقدومه كي لا يقدم عليهم بغتة فذلك هو السنة (4) ولا ينبغي أن يطرق أهله ليلا فإذا دخل البلد فليقصد المسجد أولا وليصل ركعتين فهو السنة (5) كذلك كان يفعل رسول الله صلى الله عليه وسلم فإذا دخل بيته قال توبا توبا لربنا أو با لا يغادر علينا حوبا فإذا استقر في منزله فلا ينبغي أن ينسى ما أنع", "english": "The Messenger of God, may God bless him and grant him peace, when he returned from a military expedition, or from the Pilgrimage (ḥajj), or the Lesser Pilgrimage (ʿumrah), would proclaim the greatness of God (takbīr) upon every elevated point of the land, three magnifications, and would say: \"There is no god but God alone, with no partner; His is the sovereignty, and His is the praise, and He is powerful over all things. Returning, repentant, worshipping, prostrating, to our Lord giving praise. God fulfilled His promise, and aided His servant, and defeated the confederates alone.\" {«لا إله إلا الله وحده لا شريك له له الملك وله الحمد وهو على كل شيء قدير آيبون تائبون عابدون ساجدون لربنا حامدون صدق الله وعده ونصر عبده وهزم الأحزاب وحده»} And in some narrations: \"And everything is perishing except His Face; His is the judgment, and to Him you shall be returned.\" {«وكل شيء هالك إلا وجهه له الحكم وإليه ترجعون»} It is therefore fitting that one should practice this sunnah upon his return.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 212", "section_title_en": "Section 212 — On the Sunnas of Returning from Travel", "section_index": 212, "anchors": "- Root: قفل (qafala)\n  * Lisan / Ayn: To return from a journey; the root denotes turning back from a course of travel.\n  * Al-Raghib (Mufradat): Return to a point of origin, whether spatial or temporal; here, the homeward journey after pilgrimage or expedition.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage — the physical act of coming back from travel.\n- Root: حمد (ḥamida)\n  * Lisan / Ayn: To praise; core sense of commendation for beneficence.\n  * Al-Raghib (Mufradat): Praise directed to God as the sole recipient of ultimate gratitude; distinct from mere flattery.\n  * Al-Zamakhshari (Asas): Literal — \"ḥāmidūn\" (those who praise); metaphorical (majāz) extension to all acts of grateful acknowledgment.\n- Root: سجد (sajada)\n  * Lisan / Ayn: To prostrate; physical lowering in submission.\n  * Al-Raghib (Mufradat): Prostration as the bodily expression of self-abasement before God; here, the voluntary prostration of the believer in worship.\n  * Al-Zamakhshari (Asas): Literal — the ritual act; metaphorical — any posture of humble obedience.\n- Sibawayh Rule: Prepositional Interposition (الفصل بين الجار والمجرور) — The phrase \"لربنا\" (to our Lord) is fronted for emphasis, governing the sequence of praise and worship, maintaining syntactic cohesion across the supplicatory formula.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Patience and Gratitude'", "badge": "Du'a"}, {"arabic": "يراه فكأنه ما عرفه ومن عرفه عرف أن كل شيء ما خلا الله باطل وأن كل شيء هالك إلا وجهه لا أنه سيبطل في ثاني الحال بل هو الآن باطل إن اعتبر ذاته من حيث هو إلا أن يعتبر وجوده من حيث إنه موجود بالله عز وجل وبقدرته فيكون له بطريق التبعية ثبات وبطريق الاستقلال بطلان محض وهذا مبدأ من مبادىء علم المكاشفة ولهذا ينبغي إذا قرأ التالي قوله عز وجل أفرأيتم ما تحرثون أفرأيتم ما تمنون أفرأيتم الماء الذي تشربون أفرأيتم النار التي تورون فلا يقصر نظره على الماء والنار والحرث والمني بل يتأمل في المني وهو نطفة متشابهة الأجزاء ثم ينظر في كيفية انقسامها إل", "english": "I say: These meanings are buried treasures that are not unveiled except to the divinely aided ones. To this 'Ali — may God be pleased with him — alluded by his saying: \"The Messenger of God — may God's peace and blessings be upon him — did not confide to me anything that he concealed from the people, except that God — mighty and majestic — grants to a servant understanding (fahm) of His Book. So let one be eager in seeking that understanding.\" (1) And Ibn Mas'ud — may God be pleased with him — said: \"Whoever desires the knowledge of the first and the last, let him stir up the Qur'an.\" And the greatest of the sciences of the Qur'an lie beneath the names of God — mighty and majestic — and His attributes, for most of creation have grasped from them only matters befitting their understandings and have not stumbled upon their depths.", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 228", "section_title_en": "The Revival of the Religious Sciences — Section 228: On the Inner Meanings of the Qur'an and the Removal of Obstacles to Understanding", "section_index": 228, "anchors": "- Root: فهم (f-h-m)\n  * Lisan / Ayn: Comprehension, discernment, the faculty by which one grasps meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — a disposition by which one verifies the realities of what is perceived; distinct from mere hearing or transmission\n  * Al-Zamakhshari (Asas): Literal: swift apprehension; Metaphorical: the divine gift of insight into hidden meanings, as in the verse {ففهمناها سليمان}\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: Turning, overturning, transformation from one state to another\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart as that which is perpetually turned and overturned between states\n  * Al-Zamakhshari (Asas): Literal: physical turning; Metaphorical: the heart as the seat of understanding that is veiled or illuminated, rusted or polished\n- Root: سمع (s-m-')\n  * Lisan / Ayn: Hearing, the auditory faculty\n  * Al-Raghib (Mufradat): \"السمع: قوة في الأذن به يدرك الأصوات\" — extends metaphorically to comprehension and obedience; \"أو ألقى السمع وهو شهيد\" — one who casts his hearing while present\n  * Al-Zamakhshari (Asas): Literal: auditory perception; Metaphorical: attentive obedience and receptive understanding\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — governing the precise delimitation of predicates such as \"إنما يتذكر أولوا الألباب\" where restriction confines the action to its proper subject", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}, {"arabic": "الله ولقوله ولا تجعلوا مع الله إلها آخر فمن لم يره في كل شيء فقد رأى غيره وكل ما التفت إليه العبد سوى الله تعالى تضمن التفاته شيئا من الشرك الخفي بل التوحيد الخالص أن لا يرى في كل شيء إلا الله عز وجل العاشر التبري وأعني به أن يتبرأ من حوله وقوته والالتفات إلى نفسه بين الرضا والتزكية فإذا تلا بآيات الوعد والمدح للصالحين فلا يشهد نفسه عند ذلك بل يشهد الموقنين والصديقين فيها ويتشوف إلى أن يلحقه الله عز وجل بهم وإذا تلا آيات المقت وذم العصاة والمقصرين شهد على نفسه هناك وقدر أنه المخا", "english": "For this reason, Yūsuf ibn Asbāṭ said: \"I intend to recite the Qur'an, but when I recall what is in it, I fear abhorrence (al-maqt), so I turn instead to glorification (al-tasbīḥ) and seeking forgiveness (al-istighfār).\"", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 231", "section_title_en": "** The Revival of the Religious Sciences — Section 231: On the Inward Conditions of Qur'anic Recitation (Continued)", "section_index": 231, "anchors": "**\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"الوجل: استشعار الخوف\" — the stirring of fear/apprehension within\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف. يقال: وجل يوجل وجلا، فهو وجل. قال تعالى: {إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم}\" — the theological state of the heart's trembling upon remembrance of God\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"رجل وجل، وقوم وجال، وقد وجل وجلا\" — the physical/emotional state of fear. Metaphorical (Majaz): The heart's trembling as the seat of spiritual perception\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — turning and transforming\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه، كقلب الثوب، وقلب الإنسان\" — the heart as that which is constantly turning/transforming between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — physical turning. Metaphorical: \"قلب المعلم الصبيان: صرفهم إلى بيوتهم\" — the heart's turning toward or away from spiritual realities\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, spirit — that which is breathed\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul as the animating principle; also the self as the locus of blameworthy attributes\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس ومنفس\" — preciousness. Metaphorical: \"دفق نفسه أي دمه\" — the self as that which must be transcended in spiritual realization\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise delimitation of spiritual states (أحوال) and their hierarchical gradation (درجات)\n\n---\n\n#", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'", "badge": "Insight"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 350, 7473]], "2": [[1, 350, 1124], [2, 1124, 2621], [3, 2621, 3886], [4, 3886, 5383]], "3": [[1, 400, 1780], [2, 1780, 2844], [3, 2844, 3297], [4, 3297, 4349], [5, 4349, 5707], [6, 5707, 7336], [7, 7336, 8581], [8, 8581, 9645], [9, 9645, 11296]], "4": [[1, 400, 1391], [2, 1391, 2939], [3, 2939, 3971], [4, 3971, 4650], [5, 4650, 5954], [6, 5954, 7231], [7, 7231, 8752], [8, 8752, 10246], [9, 10246, 12174], [10, 12174, 14499], [11, 14499, 15952], [12, 15952, 17432], [13, 17432, 20232], [14, 20232, 22323], [15, 22323, 24757], [16, 24757, 25993], [17, 25993, 26971], [18, 26971, 27514], [19, 27514, 29660]], "5": [[1, 400, 1898], [2, 1898, 2447], [3, 2447, 3920], [4, 3920, 4844], [5, 4844, 6254], [6, 6254, 8501], [7, 8501, 9125], [8, 9125, 10323], [9, 10323, 12282], [10, 12282, 13717], [11, 13717, 15676], [12, 15676, 17748]], "6": [[1, 400, 1943], [2, 1943, 2659], [3, 2659, 3276], [4, 3276, 4461], [5, 4461, 5695], [6, 5695, 7102], [7, 7102, 8469], [8, 8469, 10814], [9, 10814, 11777], [10, 11777, 12777], [11, 12777, 14431], [12, 14431, 16207]], "7": [[1, 400, 3700], [2, 3700, 5383], [3, 5383, 6390], [4, 6390, 8459], [5, 8459, 9066], [6, 9066, 11025], [7, 11025, 12377], [8, 12377, 13232], [