ration": "warsh"}, {"surah": 28, "ayah": 13, "text": "فَرَدَدْنَٰهُ إِلَيٰٓ أُمِّهِۦ كَےْ تَقَرَّ عَيْنُهَا وَلَا تَحْزَنَ وَلِتَعْلَمَ أَنَّ وَعْدَ اَ۬للَّهِ حَقࣱّۖ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "فَرَدَدْنَٰهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَيٰٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُمِّهِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَےْ", "translit": "", "root": ""}, {"id": 5, "arabic": "تَقَرَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَيْنُهَا", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 8, "arabic": "تَحْزَنَ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَلِتَعْلَمَ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَنَّ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَعْدَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 13, "arabic": "حَقࣱّۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَلَٰكِنَّ", "translit": "", "root": ""}, {"id": 15, "arabic": "أَكْثَرَهُمْ", "translit": "", "root": ""}, {"id": 16, "arabic": "لَا", "translit": "", "root": ""}, {"id": 17, "arabic": "يَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 28, "ayah": 14, "text": "وَلَمَّا بَلَغَ أَشُدَّهُۥ وَاسْتَو۪يٰٓ ءَاتَيْنَٰهُ حُكْماࣰ وَعِلْماࣰۖ وَكَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "بَلَغَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَشُدَّهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَاسْتَو۪يٰٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "ءَاتَيْنَٰهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "حُكْماࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَعِلْماࣰۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَكَذَٰلِكَ", "translit": "", "root": ""}, {"id": 9, "arabic": "نَجْزِے", "translit": ""