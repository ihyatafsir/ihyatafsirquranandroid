nslit": "", "root": ""}], "narration": "warsh"}, {"surah": 28, "ayah": 41, "text": "وَجَعَلْنَٰهُمُۥٓ أَئِمَّةࣰ يَدْعُونَ إِلَي اَ۬لنّ۪ارِۖ وَيَوْمَ اَ۬لْقِيَٰمَةِ لَا يُنصَرُونَۖ", "words": [{"id": 1, "arabic": "وَجَعَلْنَٰهُمُۥٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَئِمَّةࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَدْعُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لنّ۪ارِۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَيَوْمَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْقِيَٰمَةِ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَا", "translit": "", "root": ""}, {"id": 9, "arabic": "يُنصَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 28, "ayah": 42, "text": "وَأَتْبَعْنَٰهُمْ فِے هَٰذِهِ اِ۬لدُّنْي۪ا لَعْنَةࣰۖ وَيَوْمَ اَ۬لْقِيَٰمَةِ هُم مِّنَ اَ۬لْمَقْبُوحِينَۖ", "words": [{"id": 1, "arabic": "وَأَتْبَعْنَٰهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "هَٰذِهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لدُّنْي۪ا", "translit": "", "root": ""}, {"id": 5, "arabic": "لَعْنَةࣰۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَيَوْمَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْقِيَٰمَةِ", "translit": "", "root": ""}, {"id": 8, "arabic": "هُم", "translit": "", "root": ""}, {"id": 9, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لْمَقْبُوحِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 28, "ayah": 43, "text": "وَلَقَدَ اٰتَيْنَا مُوسَي اَ۬لْكِتَٰبَ مِنۢ بَعْدِ مَآ أَهْلَكْنَا اَ۬لْقُرُونَ اَ۬لُاول۪يٰ بَصَآئِرَ لِلنَّاسِ وَهُديࣰ وَرَحْمَةࣰ لَّعَلَّهُمْ يَتَذَكَّرُونَۖ", "words": [{"id": 1, "arabic": "وَلَقَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اٰتَيْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مُوسَي", "translit": "", "root": ""}, {"id": 4, "arab