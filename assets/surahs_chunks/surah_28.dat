abic": "لِقَوْمࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "يُومِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 28, "ayah": 4, "text": "إِنَّ فِرْعَوْنَ عَلَا فِے اِ۬لَارْضِ وَجَعَلَ أَهْلَهَا شِيَعاࣰ يَسْتَضْعِفُ طَآئِفَةࣰ مِّنْهُمْ يُذَبِّحُ أَبْنَآءَهُمْ وَيَسْتَحْيِۦ نِسَآءَهُمُۥٓۖ إِنَّهُۥ كَانَ مِنَ اَ۬لْمُفْسِدِينَۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِرْعَوْنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَا", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَجَعَلَ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَهْلَهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "شِيَعاࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "يَسْتَضْعِفُ", "translit": "", "root": ""}, {"id": 10, "arabic": "طَآئِفَةࣰ", "translit": "", "root": ""}, {"id": 11, "arabic": "مِّنْهُمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "يُذَبِّحُ", "translit": "", "root": ""}, {"id": 13, "arabic": "أَبْنَآءَهُمْ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَيَسْتَحْيِۦ", "translit": "", "root": ""}, {"id": 15, "arabic": "نِسَآءَهُمُۥٓۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 17, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 18, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 19, "arabic": "اَ۬لْمُفْسِدِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 28, "ayah": 5, "text": "وَنُرِيدُ أَن نَّمُنَّ عَلَي اَ۬لذِينَ اَ۟سْتُضْعِفُواْ فِے اِ۬لَارْضِ وَنَجْعَلَهُمُۥٓ أَئِمَّةࣰ وَنَجْعَلَهُمُ اُ۬لْوَٰرِثِينَ", "words": [{"id": 1, "arabic": "وَنُرِيدُ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَن", "translit": "", "root": ""}, {"id": 3, "arabic": "نَّمُنَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۟سْتُضْعِفُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَنَجْعَلَهُمُۥٓ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَئِمَّةࣰ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَنَجْعَلَهُمُ", "translit": "", "root": ""}, {"id": 12, "arabic": "اُ۬لْوَٰرِثِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 28, "ayah": 6, "text": "وَنُمَكِّنَ لَهُمْ فِے اِ۬لَارْضِ وَنُرِيَ فِرْعَوْنَ وَهَامَٰنَ وَجُنُودَهُمَا مِنْهُم مَّا كَانُواْ يَحْذَرُونَۖ", "words": [{"id": 1, "arabic": "وَنُمَكِّنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَنُرِيَ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِرْعَوْنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَهَامَٰنَ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَجُنُودَهُمَا", "translit": "", "root": ""}, {"id": 9, "arabic": "مِنْهُم", "translit": "", "root": ""}, {"id": 10, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 11, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 12, "arabic": "يَحْذَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 28, "ayah": 7, "text": "وَأَوْحَيْنَآ إِلَيٰٓ أُمِّ مُوس۪يٰٓ أَنَ اَرْضِعِيهِ فَإِذَا خِفْتِ عَلَيْهِ فَأَلْقِيهِ فِے اِ۬لْيَمِّ وَلَا تَخَافِے وَلَا تَحْزَنِےٓۖ إِنَّا رَآدُّوهُ إِلَيْكِ وَجَاعِلُوهُ مِنَ اَ۬لْمُرْسَلِينَۖ", "words": [{"id": 1, "arabic": "وَأَوْحَيْنَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَيٰٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُمِّ", "translit": "", "root": ""}, {"id": 4, "arabic": "مُوس۪يٰٓ", "translit": "", "root": ""}, {"id": 5,