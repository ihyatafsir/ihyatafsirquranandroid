 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "يُرْجَعُونَ", "translit": "َnwُʿعَjgْrُy", "root": "رجع"}], "hasIhya": true}, {"ayah": 40, "text": "فَأَخَذْنَٰهُ وَجُنُودَهُۥ فَنَبَذْنَٰهُمْ فِى ٱلْيَمِّۖ فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلظَّٰلِمِينَ ", "translation": "So We took him and his soldiers and threw them into the sea.[1] So see how was the end of the wrongdoers.", "words": [{"id": 1, "arabic": "فَأَخَذْنَٰهُ", "translit": "ُhَٰnْhdَhkَaʾَf", "root": "اخذ"}, {"id": 2, "arabic": "وَجُنُودَهُۥ", "translit": "ۥُhَdwُnُjgَw", "root": "جند"}, {"id": 3, "arabic": "فَنَبَذْنَٰهُمْ", "translit": "ْmُhَٰnْhdَbَnَf", "root": "نبذ"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْيَمِّ", "translit": "ِّmَyْlٱ", "root": "يمم"}, {"id": 6, "arabic": "فَٱنظُرْ", "translit": "ْrُẓnٱَf", "root": "نظر"}, {"id": 7, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 8, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 9, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 10, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 41, "text": "وَجَعَلْنَٰهُمْ أَئِمَّةً يَدْعُونَ إِلَى ٱلنَّارِۖ وَيَوْمَ ٱلْقِيَٰمَةِ لَا يُنصَرُونَ ", "translation": "And We made them leaders[1] inviting to the Fire, and on the Day of Resurrection they will not be helped.", "words": [{"id": 1, "arabic": "وَجَعَلْنَٰهُمْ", "translit": "ْmُhَٰnْlَʿعَjgَw", "root": "جعل"}, {"id": 2, "arabic": "أَئِمَّةً", "translit": "ًẗَّmِyʾَaʾ", "root": "امم"}, {"id": 3, "arabic": "يَدْعُونَ", "translit": "َnwُʿعْdَy", "root": "دعو"}, {"id": 4, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 5, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 6, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 7, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "يُنصَرُونَ", "translit": "َnwُrَṣnُy", "root": "نصر"}], "hasIhya": false}, {"ayah": 42, "text": "وَأَتْبَعْنَٰهُمْ فِى هَٰذِهِ ٱلدُّنْيَا لَعْنَةًۖ وَيَوْمَ ٱلْقِيَٰمَةِ هُم مِّنَ ٱلْمَقْبُوحِينَ ", "translation": "And We caused to overtake them in this world a curse, and on the Day of Resurrection they will be of the despised.[1]", "words": [{"id": 1, "arabic": "وَأَتْبَعْنَٰهُمْ", "translit": "ْmُhَٰnْʿعَbْtَaʾَw", "root": "تبع"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "هَٰذِهِ", "translit": "ِhِhdَٰh", "root": ""}, {"id": 4, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 5, "arabic": "لَعْنَةً", "translit": "ًẗَnْʿعَl", "root": "لعن"}, {"id": 6, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 7, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 8, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 9, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 10, "arabic": "ٱلْمَقْبُوحِينَ", "translit": "َnyِḥwُbْqَmْlٱ", "root": "قبح"}], "hasIhya": false}, {"ayah": 43, "text": "وَلَقَدْ ءَاتَيْنَا مُوسَى ٱلْكِتَٰبَ مِنۢ بَعْدِ مَآ أَهْلَكْنَا ٱلْقُرُونَ ٱلْأُولَىٰ بَصَآئِرَ لِلنَّاسِ وَهُدًى وَرَحْمَةً لَّعَلَّهُمْ يَتَذَكَّرُونَ ", "translation": "And We gave Moses the Scripture, after We had destroyed the former generations, as enlightenment for the people and guidance and mercy that they might be reminded.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَا", "translit": "āَnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "مُوسَى", "translit": "àَswُm", "root": ""}, {"id": 4, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 6, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 7, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 8, "arabi