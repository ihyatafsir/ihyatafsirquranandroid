ے", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 12, "arabic": "فَسَاداࣰۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَالْعَٰقِبَةُ", "translit": "", "root": ""}, {"id": 14, "arabic": "لِلْمُتَّقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 28, "ayah": 84, "text": "مَن جَآءَ بِالْحَسَنَةِ فَلَهُۥ خَيْرࣱ مِّنْهَاۖ وَمَن جَآءَ بِالسَّيِّئَةِ فَلَا يُجْزَي اَ۬لذِينَ عَمِلُواْ اُ۬لسَّيِّـَٔاتِ إِلَّا مَا كَانُواْ يَعْمَلُونَۖ", "words": [{"id": 1, "arabic": "مَن", "translit": "", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِالْحَسَنَةِ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَلَهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "خَيْرࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّنْهَاۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَمَن", "translit": "", "root": ""}, {"id": 8, "arabic": "جَآءَ", "translit": "", "root": ""}, {"id": 9, "arabic": "بِالسَّيِّئَةِ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 11, "arabic": "يُجْزَي", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 13, "arabic": "عَمِلُواْ", "translit": "", "root": ""}, {"id": 14, "arabic": "اُ۬لسَّيِّـَٔاتِ", "translit": "", "root": ""}, {"id": 15, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 16, "arabic": "مَا", "translit": "", "root": ""}, {"id": 17, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 18, "arabic": "يَعْمَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 28, "ayah": 85, "text": "إِنَّ اَ۬لذِے فَرَضَ عَلَيْكَ اَ۬لْقُرْءَانَ لَرَآدُّكَ إِلَيٰ مَعَادࣲۖ قُل رَّبِّيَ أَعْلَمُ مَن جَآءَ بِالْهُد۪يٰ وَمَنْ هُوَ فِے ضَلَٰلࣲ مُّبِينࣲۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 3, "arabic": "فَرَضَ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَيْكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْقُرْءَانَ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَرَآدُّكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَعَادࣲۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "قُل", "translit": "", "root": ""}, {"id": 10, "arabic": "رَّبِّيَ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَعْلَمُ", "translit": "", "root": ""}, {"id": 12, "arabic": "مَن", "translit": "", "root": ""}, {"id": 13, "arabic": "جَآءَ", "translit": "", "root": ""}, {"id": 14, "arabic": "بِالْهُد۪يٰ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَمَنْ", "translit": "", "root": ""}, {"id": 16, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 17, "arabic": "فِے", "translit": "", "root": ""}, {"id": 18, "arabic": "ضَلَٰلࣲ", "translit": "", "root": ""}, {"id": 19, "arabic": "مُّبِينࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 28, "ayah": 86, "text": "وَمَا كُنتَ تَرْجُوٓاْ أَنْ يُّلْق۪يٰٓ إِلَيْكَ اَ۬لْكِتَٰبُ إِلَّا رَحْمَةࣰ مِّن رَّبِّكَۖ فَلَا تَكُونَنَّ ظَهِيراࣰ لِّلْكٰ۪فِرِينَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "كُنتَ", "translit": "", "root": ""}, {"id": 3, "arabic": "تَرْجُوٓاْ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يُّلْق۪يٰٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِلَيْكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْكِتَٰبُ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "رَحْمَةࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 11, "arabic": "رَّبِّكَۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "فَلَا", "translit": "