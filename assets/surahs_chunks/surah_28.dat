ayah": 9, "text": "وَقَالَتِ اِ۪مْرَأَتُ فِرْعَوْنَ قُرَّتُ عَيْنࣲ لِّے وَلَكَ لَا تَقْتُلُوهُۖ عَس۪يٰٓ أَنْ يَّنفَعَنَآ أَوْ نَتَّخِذَهُۥ وَلَداࣰ وَهُمْ لَا يَشْعُرُونَۖ", "words": [{"id": 1, "arabic": "وَقَالَتِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۪مْرَأَتُ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِرْعَوْنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "قُرَّتُ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَيْنࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "لِّے", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَكَ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَا", "translit": "", "root": ""}, {"id": 9, "arabic": "تَقْتُلُوهُۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "عَس۪يٰٓ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 12, "arabic": "يَّنفَعَنَآ", "translit": "", "root": ""}, {"id": 13, "arabic": "أَوْ", "translit": "", "root": ""}, {"id": 14, "arabic": "نَتَّخِذَهُۥ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَلَداࣰ", "translit": "", "root": ""}, {"id": 16, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 17, "arabic": "لَا", "translit": "", "root": ""}, {"id": 18, "arabic": "يَشْعُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 28, "ayah": 10, "text": "وَأَصْبَحَ فُؤَادُ أُمِّ مُوس۪يٰ فَٰرِغاً اِن كَٰدَتْ لَتُبْدِے بِهِۦ لَوْلَآ أَن رَّبَطْنَا عَلَيٰ قَلْبِهَا لِتَكُونَ مِنَ اَ۬لْمُومِنِينَۖ", "words": [{"id": 1, "arabic": "وَأَصْبَحَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فُؤَادُ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُمِّ", "translit": "", "root": ""}, {"id": 4, "arabic": "مُوس۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَٰرِغاً", "translit": "", "root": ""}, {"id": 6, "arabic": "اِن", "translit": "", "root": ""}, {"id": 7, "arabic": "كَٰدَتْ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَتُبْدِے", "translit": "", "root": ""}, {"id": 9, "