ِ۬لَارْضُ زِلْزَالَهَا", "words": [{"id": 1, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "زُلْزِلَتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لَارْضُ", "translit": "", "root": ""}, {"id": 4, "arabic": "زِلْزَالَهَا", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 99, "ayah": 2, "text": "وَأَخْرَجَتِ اِ۬لَارْضُ أَثْقَالَهَا", "words": [{"id": 1, "arabic": "وَأَخْرَجَتِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لَارْضُ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَثْقَالَهَا", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 99, "ayah": 3, "text": "وَقَالَ اَ۬لِانسَٰنُ مَا لَهَا", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لِانسَٰنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "لَهَا", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 99, "ayah": 4, "text": "يَوْمَئِذࣲ تُحَدِّثُ أَخْبَارَهَا", "words": [{"id": 1, "arabic": "يَوْمَئِذࣲ", "translit": "", "root": ""}, {"id": 2, "arabic": "تُحَدِّثُ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَخْبَارَهَا", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 99, "ayah": 5, "text": "بِأَنَّ رَبَّكَ أَوْح۪يٰ لَهَاۖ", "words": [{"id": 1, "arabic": "بِأَنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَوْح۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَهَاۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 99, "ayah": 6, "text": "يَوْمَئِذࣲ يَصْدُرُ اُ۬لنَّاسُ أَشْتَاتاࣰ لِّيُرَوَاْ اَعْمَٰلَهُمْۖ", "words": [{"id": 1, "arabic": "يَوْمَئِذࣲ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَصْدُرُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لنَّاسُ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَشْتَاتاࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِّيُرَوَاْ",