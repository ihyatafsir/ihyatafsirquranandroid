{"surah":71,"verses":[{"ayah":1,"text":"إِنَّآ أَرْسَلْنَا نُوحًا إِلَىٰ قَوْمِهِۦٓ أَنْ أَنذِرْ قَوْمَكَ مِن قَبْلِ أَن يَأْتِيَهُمْ عَذَابٌ أَلِيمٌ ","translation":"Indeed, We sent Noah to his people, [saying], \"Warn your people before there comes to them a painful punishment.\"","words":[{"id":1,"arabic":"إِنَّآ","translit":"ٓāَّnِiʾ","root":""},{"id":2,"arabic":"أَرْسَلْنَا","translit":"āَnْlَsْrَaʾ","root":"رسل"},{"id":3,"arabic":"نُوحًا","translit":"āًḥwُn","root":""},{"id":4,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":5,"arabic":"قَوْمِهِۦٓ","translit":"ٓۦِhِmْwَq","root":"قوم"},{"id":6,"arabic":"أَنْ","translit":"ْnَaʾ","root":""},{"id":7,"arabic":"أَنذِرْ","translit":"ْrِhdnَaʾ","root":"نذر"},{"id":8,"arabic":"قَوْمَكَ","translit":"َkَmْwَq","root":"قوم"},{"id":9,"arabic":"مِن","translit":"nِm","root":""},{"id":10,"arabic":"قَبْلِ","translit":"ِlْbَq","root":"قبل"},{"id":11,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":12,"arabic":"يَأْتِيَهُمْ","translit":"ْmُhَyِtْaʾَy","root":"اتي"},{"id":13,"arabic":"عَذَابٌ","translit":"ٌbāَhdَʿع","root":"عذب"},{"id":14,"arabic":"أَلِيمٌ","translit":"ٌmyِlَaʾ","root":"الم"}],"hasIhya":false},{"ayah":2,"text":"قَالَ يَٰقَوْمِ إِنِّى لَكُمْ نَذِيرٌ مُّبِينٌ ","translation":"He said, \"O my people, indeed I am to you a clear warner -","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"يَٰقَوْمِ","translit":"ِmْwَqَٰy","root":"قوم"},{"id":3,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":4,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":5,"arabic":"نَذِيرٌ","translit":"ٌryِhdَn","root":"نذر"},{"id":6,"arabic":"مُّبِينٌ","translit":"ٌnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":3,"text":"أَنِ ٱعْبُدُوا۟ ٱللَّهَ وَٱتَّقُوهُ وَأَطِيعُونِ ","translation":"To worship Allāh, fear Him and obey me.","words":[{"id":1,"arabic":"أَنِ","translit":"ِnَaʾ","root":""},{"id":2,"arabic":"ٱعْبُدُوا۟","translit":"۟āwُdُbْʿعٱ","root":"عبد"},{"id":3,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":4,"arabic":"وَٱتَّقُوهُ","translit":"ُhwُqَّtٱَw","root":"وقي"},{"id":5,"arabic":"وَأَطِيعُونِ","translit":"ِnwُʿعyِṭَaʾَw","root":"طوع"}],"hasIhya":false},{"ayah":4,"text":"يَغْفِرْ لَكُم مِّن ذُنُوبِكُمْ وَيُؤَخِّرْكُمْ إِلَىٰٓ أَجَلٍ مُّسَمًّىۚ إِنَّ أَجَلَ ٱللَّهِ إِذَا جَآءَ لَا يُؤَخَّرُۖ لَوْ كُنتُمْ تَعْلَمُونَ ","translation":"He [i.e., Allāh] will forgive you of your sins and delay you for a specified term. Indeed, the time [set by] Allāh, when it comes, will not be delayed, if you only knew.\"","words":[{"id":1,"arabic":"يَغْفِرْ","translit":"ْrِfْغَy","root":"غفر"},{"id":2,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":3,"arabic":"مِّن","translit":"nِّm","root":""},{"id":4,"arabic":"ذُنُوبِكُمْ","translit":"ْmُkِbwُnُhd","root":"ذنب"},{"id":5,"arabic":"وَيُؤَخِّرْكُمْ","translit":"ْmُkْrِّhkَwʾُyَw","root":"اخر"},{"id":6,"arabic":"إِلَىٰٓ","translit":"ٰٓàَlِiʾ","root":""},{"id":7,"arabic":"أَجَلٍ","translit":"ٍlَjgَaʾ","root":"اجل"},{"id":8,"arabic":"مُّسَمًّى","translit":"àًّmَsُّm","root":"سمو"},{"id":9,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":10,"arabic":"أَجَلَ","translit":"َlَjgَaʾ","root":"اجل"},{"id":11,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":12,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":13,"arabic":"جَآءَ","translit":"َءٓāَjg","root":"جيا"},{"id":14,"arabic":"لَا","translit":"āَl","root":""},{"id":15,"arabic":"يُؤَخَّرُ","translit":"ُrَّhkَwʾُy","root":"اخر"},{"id":16,"arabic":"لَوْ","translit":"ْwَl","root":""},{"id":17,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":18,"arabic":"تَعْلَمُونَ","translit":"َnwُmَlْʿعَt","root":"علم"}],"hasIhya":false},{"ayah":5,"text":"قَالَ رَبِّ إِنِّى دَعَوْتُ قَوْمِى لَيْلًا وَنَهَارًا ","translation":"He said, \"My Lord, indeed I invited my people [to truth] night and day.","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"رَبِّ","translit":"ِّbَr","root":"ربب"},{"id":3,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":4,"arabic":"دَعَوْتُ","translit":"ُtْwَʿعَd","root":"دعو"},{"id":5,"arabic":"قَوْمِى","translit":"àِmْwَq","root":"قوم"},{"id":6,"arabic":"لَيْلًا","translit":"āًlْyَl","root":"ليل"},{"id":7,"arabic":"وَنَهَارًا","translit":"āًrāَhَnَw","root":"نهر"}],"hasIhya":false},{"ayah":6,"text":"فَلَمْ يَزِدْهُمْ دُعَآءِىٓ إِلَّا فِرَارًا ","translation":"But my invitation increased them not except in flight [i.e., aversion].","words":[{"id":1,"arabic":"فَلَمْ","translit":"ْmَlَf","root":""},{"id":2,"arabic":"يَزِدْهُمْ","translit":"ْmُhْdِzَy","root":"زيد"},{"id":3,"arabic":"دُعَآءِىٓ","translit":"ٓàِءٓāَʿعُd","root":"دعو"},{"id":4,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":5,"arabic":"فِرَارًا","translit":"āًrāَrِf","root":"فرر"}],"hasIhya":false},{"ayah":7,"text":"وَإِنِّى كُلَّمَا دَعَوْتُهُمْ لِتَغْفِرَ لَهُمْ جَعَلُوٓا۟ أَصَٰبِعَهُمْ فِىٓ ءَاذَانِهِمْ وَٱسْتَغْشَوْا۟ ثِيَابَهُمْ وَأَصَرُّوا۟ وَٱسْتَكْبَرُوا۟ ٱسْتِكْبَارًا ","translation":"And indeed, every time I invited them that You may forgive them, they put their fingers in their ears, covered themselves with their garments,[1] persisted, and were arrogant with [great] arrogance.","words":[{"id":1,"arabic":"وَإِنِّى","translit":"àِّnِiʾَw","root":""},{"id":2,"arabic":"كُلَّمَا","translit":"āَmَّlُk","root":"كلل"},{"id":3,"arabic":"دَعَوْتُهُمْ","translit":"ْmُhُtْwَʿعَd","root":"دعو"},{"id":4,"arabic":"لِتَغْفِرَ","translit":"َrِfْغَtِl","root":"غفر"},{"id":5,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":6,"arabic":"جَعَلُوٓا۟","translit":"۟āٓwُlَʿعَjg","root":"جعل"},{"id":7,"arabic":"أَصَٰبِعَهُمْ","translit":"ْmُhَʿعِbَٰṣَaʾ","root":"صبع"},{"id":8,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":9,"arabic":"ءَاذَانِهِمْ","translit":"ْmِhِnāَhdāَء","root":"اذن"},{"id":10,"arabic":"وَٱسْتَغْشَوْا۟","translit":"۟āْwَhsْغَtْsٱَw","root":"غشو"},{"id":11,"arabic":"ثِيَابَهُمْ","translit":"ْmُhَbāَyِht","root":"ثوب"},{"id":12,"arabic":"وَأَصَرُّوا۟","translit":"۟āwُّrَṣَaʾَw","root":"صرر"},{"id":13,"arabic":"وَٱسْتَكْبَرُوا۟","translit":"۟āwُrَbْkَtْsٱَw","root":"كبر"},{"id":14,"arabic":"ٱسْتِكْبَارًا","translit":"āًrāَbْkِtْsٱ","root":"كبر"}],"hasIhya":false},{"ayah":8,"text":"ثُمَّ إِنِّى دَعَوْتُهُمْ جِهَارًا ","translation":"Then I invited them publicly.","words":[{"id":1,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":2,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":3,"arabic":"دَعَوْتُهُمْ","translit":"ْmُhُtْwَʿعَd","root":"دعو"},{"id":4,"arabic":"جِهَارًا","translit":"āًrāَhِjg","root":"جهر"}],"hasIhya":false},{"ayah":9,"text":"ثُمَّ إِنِّىٓ أَعْلَنتُ لَهُمْ وَأَسْرَرْتُ لَهُمْ إِسْرَارًا ","translation":"Then I announced to them and [also] confided to them secretly","words":[{"id":1,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":2,"arabic":"إِنِّىٓ","translit":"ٓàِّnِiʾ","root":""},{"id":3,"arabic":"أَعْلَنتُ","translit":"ُtnَlْʿعَaʾ","root":"علن"},{"id":4,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":5,"arabic":"وَأَسْرَرْتُ","translit":"ُtْrَrْsَaʾَw","root":"سرر"},{"id":6,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":7,"arabic":"إِسْرَارًا","translit":"āًrāَrْsِiʾ","root":"سرر"}],"hasIhya":false},{"ayah":10,"text":"فَقُلْتُ ٱسْتَغْفِرُوا۟ رَبَّكُمْ إِنَّهُۥ كَانَ غَفَّارًا ","translation":"And said, 'Ask forgiveness of your Lord. Indeed, He is ever a Perpetual Forgiver.","words":[{"id":1,"arabic":"فَقُلْتُ","translit":"ُtْlُqَf","root":"قول"},{"id":2,"arabic":"ٱسْتَغْفِرُوا۟","translit":"۟āwُrِfْغَtْsٱ","root":"غفر"},{"id":3,"arabic":"رَبَّكُمْ","translit":"ْmُkَّbَr","root":"ربب"},{"id":4,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":5,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":6,"arabic":"غَفَّارًا","translit":"āًrāَّfَغ","root":"غفر"}],"hasIhya":false},{"ayah":11,"text":"يُرْسِلِ ٱلسَّمَآءَ عَلَيْكُم مِّدْرَارًا ","translation":"He will send [rain from] the sky upon you in [continuing] showers","words":[{"id":1,"arabic":"يُرْسِلِ","translit":"ِlِsْrُy","root":"رسل"},{"id":2,"arabic":"ٱلسَّمَآءَ","translit":"َءٓāَmَّslٱ","root":"سمو"},{"id":3,"arabic":"عَلَيْكُم","translit":"mُkْyَlَʿع","root":""},{"id":4,"arabic":"مِّدْرَارًا","translit":"āًrāَrْdِّm","root":"درر"}],"hasIhya":false},{"ayah":12,"text":"وَيُمْدِدْكُم بِأَمْوَٰلٍ وَبَنِينَ وَيَجْعَل لَّكُمْ جَنَّٰتٍ وَيَجْعَل لَّكُمْ أَنْهَٰرًا ","translation":"And give you increase in wealth and children and provide for you gardens and provide for you rivers.","words":[{"id":1,"arabic":"وَيُمْدِدْكُم","translit":"mُkْdِdْmُyَw","root":"مدد"},{"id":2,"arabic":"بِأَمْوَٰلٍ","translit":"ٍlَٰwْmَaʾِb","root":"مول"},{"id":3,"arabic":"وَبَنِينَ","translit":"َnyِnَbَw","root":"بني"},{"id":4,"arabic":"وَيَجْعَل","translit":"lَʿعْjgَyَw","root":"جعل"},{"id":5,"arabic":"لَّكُمْ","translit":"ْmُkَّl","root":""},{"id":6,"arabic":"جَنَّٰتٍ","translit":"ٍtَّٰnَjg","root":"جنن"},{"id":7,"arabic":"وَيَجْعَل","translit":"lَʿعْjgَyَw","root":"جعل"},{"id":8,"arabic":"لَّكُمْ","translit":"ْmُkَّl","root":""},{"id":9,"arabic":"أَنْهَٰرًا","translit":"āًrَٰhْnَaʾ","root":"نهر"}],"hasIhya":true},{"ayah":13,"text":"مَّا لَكُمْ لَا تَرْجُونَ لِلَّهِ وَقَارًا ","translation":"What is [the matter] with you that you do not attribute to Allāh [due] grandeur","words":[{"id":1,"arabic":"مَّا","translit":"āَّm","root":""},{"id":2,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":3,"arabic":"لَا","translit":"āَl","root":""},{"id":4,"arabic":"تَرْجُونَ","translit":"َnwُjgْrَt","root":"رجو"},{"id":5,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":6,"arabic":"وَقَارًا","translit":"āًrāَqَw","root":"وقر"}],"hasIhya":true},{"ayah":14,"text":"وَقَدْ خَلَقَكُمْ أَطْوَارًا ","translation":"While He has created you in stages?[1]","words":[{"id":1,"arabic":"وَقَدْ","translit":"ْdَqَw","root":""},{"id":2,"arabic":"خَلَقَكُمْ","translit":"ْmُkَqَlَhk","root":"خلق"},{"id":3,"arabic":"أَطْوَارًا","translit":"āًrāَwْṭَaʾ","root":"طور"}],"hasIhya":false},{"ayah":15,"