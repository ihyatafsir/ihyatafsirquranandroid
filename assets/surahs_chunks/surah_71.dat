ds":[{"id":1,"arabic":"وَقَدْ","translit":"ْdَqَw","root":""},{"id":2,"arabic":"أَضَلُّوا۟","translit":"۟āwُّlَḍَaʾ","root":"ضلل"},{"id":3,"arabic":"كَثِيرًا","translit":"āًryِhtَk","root":"كثر"},{"id":4,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":5,"arabic":"تَزِدِ","translit":"ِdِzَt","root":"زيد"},{"id":6,"arabic":"ٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱ","root":"ظلم"},{"id":7,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":8,"arabic":"ضَلَٰلًا","translit":"āًlَٰlَḍ","root":"ضلل"}],"hasIhya":false},{"ayah":25,"text":"مِّمَّا خَطِيٓـَٰٔتِهِمْ أُغْرِقُوا۟ فَأُدْخِلُوا۟ نَارًا فَلَمْ يَجِدُوا۟ لَهُم مِّن دُونِ ٱللَّهِ أَنصَارًا ","translation":"Because of their sins they were drowned and put into the Fire, and they found not for themselves besides Allāh [any] helpers.","words":[{"id":1,"arabic":"مِّمَّا","translit":"āَّmِّm","root":""},{"id":2,"arabic":"خَطِيٓـَٰٔتِهِمْ","translit":"ْmِhِtَٰٔـٓyِṭَhk","root":"خطا"},{"id":3,"arabic":"أُغْرِقُوا۟","translit":"۟āwُqِrْغُaʾ","root":"غرق"},{"id":4,"arabic":"فَأُدْخِلُوا۟","translit":"۟āwُlِhkْdُaʾَf","root":"دخل"},{"id":5,"arabic":"نَارًا","translit":"āًrāَn","root":"نور"},{"id":6,"arabic":"فَلَمْ","translit":"ْmَlَf","root":""},{"id":7,"arabic":"يَجِدُوا۟","translit":"۟āwُdِjgَy","root":"وجد"},{"id":8,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":9,"arabic":"مِّن","translit":"nِّm","root":""},{"id":10,"arabic":"دُونِ","translit":"ِnwُd","root":"دون"},{"id":11,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":12,"arabic":"أَنصَارًا","translit":"āًrāَṣnَaʾ","root":"نصر"}],"hasIhya":false},{"ayah":26,"text":"وَقَالَ نُوحٌ رَّبِّ لَا تَذَرْ عَلَى ٱلْأَرْضِ مِنَ ٱلْكَٰفِرِينَ دَيَّارًا ","translation":"And Noah said, \"My Lord, do not leave upon the earth from among the disbelievers an inhabitant.","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"نُوحٌ","translit":"ٌḥwُn","root":""},{"id":3,"arabic":"رَّبِّ","translit":"ِّbَّr","root":"ربب"},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"تَذَرْ","translit":"ْrَhdَt","root":"وذر"},{"id":6,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":7,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":8,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":9,"arabic":"ٱلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlٱ","root":"كفر"},{"id":10,"arabic":"دَيَّارًا","translit":"āًrāَّyَd","root":"دور"}],"hasIhya":true},{"ayah":27,"text":"إِنَّكَ إِن تَذَرْهُمْ يُضِلُّوا۟ عِبَادَكَ وَلَا يَلِدُوٓا۟ إِلَّا فَاجِرًا كَفَّارًا ","translation":"Indeed, if You leave them, they will mislead Your servants and not beget except [every] wicked one and [confirmed] disbeliever.","words":[{"id":1,"arabic":"إِنَّكَ","translit":"َkَّnِiʾ","root":""},{"id":2,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":3,"arabic":"تَذَرْهُمْ","translit":"ْmُhْrَhdَt","root":"وذر"},{"id":4,"arabic":"يُضِلُّوا۟","translit":"۟āwُّlِḍُy","root":"ضلل"},{"id":5,"arabic":"عِبَادَكَ","translit":"َkَdāَbِʿع","root":"عبد"},{"id":6,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":7,"arabic":"يَلِدُوٓا۟","translit":"۟āٓwُdِlَy","root":"ولد"},{"id":8,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":9,"arabic":"فَاجِرًا","translit":"āًrِjgāَf","root":"فجر"},{"id":10,"arabic":"كَفَّارًا","translit":"āًrāَّfَk","root":"كفر"}],"hasIhya":false},{"ayah":28,"text":"رَّبِّ ٱغْفِرْ لِى وَلِوَٰلِدَىَّ وَلِمَن دَخَلَ بَيْتِىَ مُؤْمِنًا وَلِلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ وَلَا تَزِدِ ٱلظَّٰلِمِينَ إِلَّا تَبَارًۢا ","translation":"My Lord, forgive me and my parents and whoever enters my house a believer and the believing men and believing women. And do not increase the wrongdoers except in destruction.\"","words":[{"id":1,"arabic":"رَّبِّ","translit":"ِّbَّr","root":"ربب"},{"id":2,"arabic":"ٱغْفِرْ","translit":"ْrِfْغٱ","root":"غفر"},{"id":3,"arabic":"لِى","translit":"àِl","root":""},{"id":4,"arabic":"وَلِوَٰلِدَىَّ","translit":"َّàَdِlَٰwِlَw","root":"ولد"},{"id":5,"arabic":"وَلِمَن","translit":"nَmِlَw","root":""},{"id":6,"arabic":"دَخَلَ","translit":"َlَhkَd","root":"دخل"},{"id":7,"arabic":"بَيْتِىَ","translit":"َàِtْyَb","root":"بيت"},{"id":8,"arabic":"مُؤْمِنًا","translit":"āًnِmْwʾُm","root":"امن"},{"id":9,"arabic":"وَلِلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlِlَw","root":"امن"},{"id":10,"arabic":"وَٱلْمُؤْمِنَٰتِ","translit":"ِtَٰnِmْwʾُmْlٱَw","root":"امن"},{"id":11,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":12,"arabic":"تَزِدِ","translit":"ِdِzَt","root":"زيد"},{"id":13,"arabic":"ٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱ","root":"ظلم"},{"id":14,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":15,"arabic":"تَبَارًۢا","translit":"āًۢrāَbَt","root":"تبر"}],"hasIhya":true}],"tafsir":{"12":[{"arabic":"على عباده {ويمددكم بأموال وبنين ويجعل لكم جنات ويجعل لكم أنهارا} وقال صلى الله عليه وسلم كاد الفقر أن يكون كفرا (2) حديث من أكرم الناس وأكيسهم قال أكثرهم للموت ذكرا الحديث أخرجه ابن ماجه من حديث ابن عمر بلفظ أي المؤمنين أكيس ورواه ابن أبي الدنيا في الموت بلفظ المصنف وإسناده جيد //","english":"It is related from Maslamah ibn ʿAbd al-Malik that he entered upon ʿUmar ibn ʿAbd al-ʿAzīz, may God have mercy on him, at the time of his death, and said: \"O Commander of the Believers, you have done a deed that no one before you has done — you have left your children with neither a dirham nor a dinar.\" And he had thirteen children. ʿUmar said: \"Seat me upright.\" So they seated him upright. He said: \"As for your saying that I have not left them a dinar or a dirham — I have not withheld from them any right that was theirs, nor have I given them any right that belonged to others. Rather, my children are one of two men: either one obedient to God — and God suffices him, for God takes charge of the righteous; or one disobedient to God — and then I care not upon what he falls.\"","book_title":"Condemnation of Miserliness and Love of Wealth","section_title_ar":"Section 754","section_title_en":"The Dispraise of Wealth and the Reconciliation Between Its Dispraise and Praise","section_index":754,"anchors":"- Root: ورع (wariʿa)\n  * Lisan / Ayn: Abstinence, scrupulous avoidance of what is doubtful or forbidden; the root conveys a shrinking back and restraint.\n  * Al-Raghib (Mufradat): The theological virtue of scrupulous piety (waraʿ) — the soul's restraint from anything that might taint one's standing before God.\n  * Al-Zamakhshari (Asas): Literal: to avoid, to withdraw. Metaphorical: the heart's recoiling from sin as the body recoils from a harmful thing.\n- Root: ولد (walada)\n  * Lisan / Ayn: To beget, to give birth; offspring (walad) — used for both singular and plural, young and old.\n  * Al-Raghib (Mufradat): Offspring; in the Qur'anic context, the concern for one's children and the question of providing for them after death.\n  * Al-Zamakhshari (Asas): Literal: biological progeny. Metaphorical: \"to generate\" new things — here, the tension between leaving wealth for heirs versus sending it forward for oneself.\n- Root: مال (māl)\n  * Lisan / Ayn: Property, wealth, possessions — from the root meaning to incline or tend toward something.\n  * Al-Raghib (Mufradat): In the Qur'an, wealth is called \"good\" (khayr) — {«إن ترك خيرا»} — indicating its potential as a means to goodness.\n  * Al-Zamakhshari (Asas): Literal: what one owns. Metaphorical: the \"true wealth\" is what is sent forward for the Hereafter, not what is left behind.\n- Root: خير (khayr)\n  * Lisan / Ayn: Goodness, benefit, that which is choice-worthy.\n  * Al-Raghib (Mufradat): The Qur'anic designation of wealth as khayr — a conditional good, dependent on its use.\n  * Al-Zamakhshari (Asas): Literal: good. Metaphorical: the \"good\" of wealth is only realized through righteous expenditure.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The use of \"innamā\" to restrict and focus the predicate, as in the reconciliation between the dispraise and praise of wealth, where each applies under distinct conditions.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Miserliness and Love of Wealth'","badge":"Hadith"}],"13":[{"arabic":"بالرجاء فقال تعالى {ما لكم لا ترجون لله وقارا} أي لا تخافون وكثيرا ما ورد في القرآن الرجاء بمعنى الخوف وذلك لتلازمهما إذ عادة العرب التعبير عن الشيء بما يلازمه بل أقول كل ما ورد في فضل البكاء من خشية الله فهو إظهار لفضيلة الخشية فإن البكاء ثمرة الخشية فقد قال تعالى {فليضحكوا قليلا وليبكوا كثيرا} وقال تعالى {يبكون ويزيدهم خشوعا} وقال عز وجل {أفمن هذا","english":"For they possess the Highest Companion (al-Rafīq al-Aʿlā) in which none share with them. Consider how He singled them out for the companionship of the Highest Companion — and that is because they are the scholars (ʿulamāʾ), and the scholars hold the rank of companionship with the prophets, for they are the heirs of the prophets. And the companionship of the Highest Companion belongs to the prophets and to those who attach themselves to them. For this reason, when the Messenger of God — may God's blessings and peace be upon him — was given the choice during his death-illness between remaining in this world and proceeding to God — may He be exalted — he would say: \"I ask of Thee the Highest Companion\" {«الرفيق الأعلى»}.","book_title":"Fear and Hope","section_title_ar":"Section 1042","section_title_en":"On the Excellence of Fear (Khawf) and Its Inseparability from Faith — Section 1042","section_index":1042,"anchors":"- Root: خوف (Khawf)\n  * Lisan / Ayn: Core root denotes trepidation, apprehension, and the state of being afraid; its opposite is amn (security).\n  * Al-Raghib (Mufradat): \"الخوف: توقع مكروه عن أمارة مظنونة، أو معلومة\" — anticipation of something disliked based on an indication, whether conjectural or certain; it is the direct opposite of amn (security), and applies to both worldly and otherworldly matters.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"خفته على مالي خوفا وخيفة\" — to fear for something. Metaphorical (Majaz): \"تخوفه: تنقصه\" — to diminish gradually, as fear erodes the soul's complacency.\n- Root: حدث (Hadath)\n  * Lisan / Ayn: Newness, origination after non-existence; also that which is recent in time.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — the coming-to-be of a thing after it was not; true origination belongs to God alone.\n  * Al-Zamakhshari (Asas): Literal: \"هو حدث من الأحداث\" — one who is recent/young. Metaphorical: \"كان عمر محدثا أي صادق الحدس\" — one whose intuition is true, as if divinely inspired.\n- Root: يوم (Yawm)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — used for the day proper or any extended period; \"أيام الله\" refers to His mighty deeds and visitations upon the wicked.\n  * Al-Zamakhshari (Asas): Literal: \"ما رأيته اليوم\" — temporal designation. Metaphorical: \"ذكر في أيام العرب كذا أي في وقائعها\" — \"days\" as battles and momentous events.\n- Root: قوي (Quwwa)\n  * Lisan / Ayn: Strength, power, capability; the opposite of weakness.\n  * Al-Raghib (Mufradat): \"القوة تستعمل تارة في معنى القدرة\" — power as capability; also potentiality, as when a date-stone is said to be \"potentially\" a palm-tree.\n  * Al-Zamakhshari (Asas): Literal: \"هو قوي مقو\" — physically strong. Metaphorical: strength of heart, of conviction, and of allies.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — When the particle innamā is employed, it restricts the predicate exclusively to the subject mentioned, negating it for all others. This governs the author's argument that taqwā is exclusively attributed to God's nearness and that the \"Highest Companion\" (al-Rafīq al-Aʿlā) is uniquely reserved for the prophets and their heirs.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'","badge":"Insight"}],"15":[{"arabic":"المسخر بين السماء والأرض لآيات لقوم يعقلون وقال تعالى ألم تروا كيف خلق الله سبع سموات طباقا وجعل القمر فيهن نورا وجعل الشمس سراجا والله أنبتكم من الأرض نباتا ثم يعيدكم فيها ويخرجكم إخراجا وقال تعالى أفرأيتم ما تمنون أأنتم تخلقونه أم نحن الخالقون إلى قوله للمقوين فليس يخفي على من معه أدنى مسكة من عقل إذا تأمل بأدنى فكرة مضمون هذه الآيات وأدار نظره على عجائب خلق الله في الأرض والسموات وبدائع فطرة الحيوان والنبات أن هذا الأمر العجيب والترتيب المحكم لا يستغني عن صانع يدبره وفاعل يحكمه ويقدره بل تكاد فطرة النفوس تشهد بكونها مقهورة تحت تسخيره ومصرفة بمقتضى تدبيره ولذلك قال الله تعالى أفي الله شك فاطر السموات والأرض ولهذا بعث الأنبياء صل","english":"The First Principle: the knowledge of His existence, the Exalted. The first thing by which one is illuminated from among the lights, and the path of reflection (ṭarīq al-iʿtibār) by which one proceeds, is that to which the Qurʾān has guided. For after the explanation of God, glorified be He, there is no explanation. He, the Exalted, has said: {«أَلَمْ نَجْعَلِ الْأَرْضَ مِهَادًا وَالْجِبَالَ أَوْتَادًا وَخَلَقْنَاكُمْ أَزْوَاجًا وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا وَجَعَلْنَا اللَّيْلَ لِبَاسًا وَجَعَلْنَا النَّهَارَ مَعَاشًا وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا وَجَعَلْنَا سِرَاجًا وَهَّاجًا وَأَنزَلْنَا مِنَ الْمُعْصِرَاتِ مَاءً ثَجَّاجًا لِّنُخْرِجَ بِهِ حَبًّا وَنَبَاتًا وَجَنَّاتٍ أَلْفَافًا»} — \"Have We not made the earth a resting place, and the mountains as pegs, and created you in pairs, and made your sleep a repose, and made the night a covering, and made the day for livelihood, and built above you seven strong heavens, and made a blazing lamp, and sent down from the rain-clouds pouring water, that We may bring forth thereby grain and vegetation, and gardens dense with foliage?\" (Q 78:6–16). And He, the Exalted, has said: {«إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافِ اللَّيْلِ وَالنَّهَارِ وَالْفُلْكِ الَّتِي تَجْرِي فِي الْبَحْرِ بِمَا يَنفَعُ النَّاسَ وَمَا أَنزَلَ اللَّهُ مِنَ السَّمَاءِ مِن مَّاءٍ فَأَحْيَا بِهِ الْأَرْضَ بَعْدَ مَوْتِهَا وَبَثَّ فِيهَا مِن كُلِّ دَابَّةٍ وَتَصْرِيفِ الرِّيَاحِ وَالسَّحَابِ الْمُسَخَّرِ بَيْنَ السَّمَاءِ وَالْأَرْضِ لَآيَاتٍ لِّقَوْمٍ يَعْقِلُونَ»} — \"Indeed, in the creation of the heavens and the earth, and the alternation of the night and the day, and the ships which sail through the sea with that which benefits people, and what God has sent down from the sky of water, thereby reviving the earth after its death, and dispersing therein every creature, and the directing of the winds, and the clouds subservient between the heaven and the earth — are signs for a people who reason\" (Q 2:164). And He, the Exalted, has said: {«أَلَمْ تَرَوْا كَيْفَ خَلَقَ اللَّهُ سَبْعَ سَمَاوَاتٍ طِبَاقًا وَجَعَلَ الْقَمَرَ فِيهِنَّ نُورًا وَجَعَلَ الشَّمْسَ سِرَاجًا وَاللَّهُ أَنبَتَكُم مِّنَ الْأَرْضِ نَبَاتًا ثُمَّ يُعِيدُكُمْ فِيهَا وَيُخْرِجُكُمْ إِخْرَاجًا»} — \"Have you not seen how God created seven heavens in layers, and made the moon therein a light, and made the sun a lamp? And God caused you to grow from the earth a growth; then He returns you into it, and brings you forth a bringing forth\" (Q 71:15–18). And He, the Exalted, has said: {«أَفَرَأَيْتُم مَّا تُمْنُونَ أَأَنتُمْ تَخْلُقُونَهُ أَمْ نَحْنُ الْخَالِقُونَ»} — \"Have you considered what you emit? Do you create it, or are We the Creator?\" — up to His saying: {«لِلْمُقْوِينَ»} — \"for the settlers\" (Q 56:58–73).","book_title":"Foundations of Belief","section_title_ar":"Section 87","section_title_en":"The Pillars of Faith: Knowledge of God, His Attributes, His Acts, and the Audibles — Section 87","section_index":87,"anchors":"- Root: وجود (w-j-d)\n  * Lisan / Ayn: [Core linguistic root meaning: to find, to perceive, to be; existence as that which is found or discovered]\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance: al-wujūd as necessary existence (wujūb) versus contingent existence (imkān); the self-evident reality of the Creator's being]\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction: haqīqah — existence as affirmed reality; majāz — \"finding\" as in discovery, not applicable to God's necessary being]\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: [Core linguistic root meaning: measuring, proportioning, fashioning; origination of a thing upon a measure]\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم، ويستعمل في إبداع الشيء من غير أصل ولا احتذاء\" — creation as origination from nothing without prior model\n  * Al-Zamakhshari (Asas): [Literal: خلق الله الخلق: أوجده على تقدير أوجبته الحكمة — brought into existence upon a measure necessitated by wisdom; Majaz: not applicable to God's act as pure origination]\n- Root: فطر (f-t-r)\n  * Lisan / Ayn: [Core linguistic root meaning: to split, cleave, rend; to originate, to bring forth as a new creation]\n  * Al-Raghib (Mufradat): \"فطر الله الخلق\" — God's origination of creation as a primordial act; \"الفطرة\" as the innate disposition\n  * Al-Zamakhshari (Asas): [Literal: فطر الله الخلق، وهو فاطر السموات: مبتدعها — originator without precedent; Majaz: \"رأيه فطير\" — immature opinion, not applicable to divine]\n- Root: ارض (ar-d)\n  * Lisan / Ayn: [Core linguistic root meaning: the earth, the lower sphere; that which is beneath]\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء\" — the body opposite the heaven\n  * Al-Zamakhshari (Asas): [Literal: the earth as a resting place (مهادا); Majaz: not applicable in this context of divine creation]\n- Root: ركن (r-k-n)\n  * Lisan / Ayn: [Core linguistic root meaning: corner, pillar, support; that to which one leans for strength]\n  * Al-Raghib (Mufradat): \"ركن الشيء: جانبه الذي يسكن إليه\" — the side of a thing to which one repairs; used metaphorically for strength\n  * Al-Zamakhshari (Asas): [Literal: physical pillar/corner; Majaz: \"فلان يأوي من عز قومه إلى ركن شديد\" — one who repairs to a mighty support; here, the \"pillars\" (أركان) of faith as structural supports]\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure \"مداره على عشرة أصول\" (its circuit revolves upon ten principles) employs a prepositional phrase governing the verbal noun, establishing the necessary grammatical dependency that mirrors the ontological dependency of the created upon the Creator.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Foundations of Belief'","badge":"Afterlife"}],"26":[{"arabic":"فإني مسمومة بأبي أنت وأمي يا رسول الله لقد دعا نوح على قومه فقال رب لا تذر على الأرض من الكافرين ديارا ولو دعوت علينا بمثلها لهلكنا فلقد وطىء ظهرك وأدمي وجهك وكسرت رباعيتك فأبيت أن تقول إلا خيرا فقلت اللهم اغفر لقومي فإنهم لا يعلمون بأبي أنت وأمي يا رسول الله لقد اتبعك في قلة سنك وقصر عمرك ما لم يتبع نوحا في كثرة سنه وطول عمره ولقد آمن بك الكثير وما آمن معه إلا القليل بأبي أنت وأمي يا رسول الله لو لم تجالس إلا كفؤا لك ما جالستنا ولو لم تنكح إلا كفؤا لك ما نكحت إلينا ولو لم تؤاكل إلا كفؤا لك ما واكلتنا فلقد والله جالستنا ونكحت إلينا وواكلتنا ولبس","english":"God Most High has said: {«Indeed, God and His angels send blessings upon the Prophet. O you who have believed, send blessings upon him and greet him with a greeting of peace»} (Q. 33:56). And it is related that he, peace be upon him, came one day with the signs of glad tidings visible upon his face, and he, peace be upon him, said: \"Gabriel came to me, peace be upon him, and said: 'Are you not pleased, O Muhammad, that no one from your community sends a single blessing upon you except that I send ten blessings upon him, and no one from your community greets you with peace except that I greet him with peace ten times?'\" (1) And he, peace be upon him, said: \"Whoever sends blessings upon me, the angels send blessings upon him as long as he continues to send blessings upon me — so let him reduce or increase at that.\" (2) And he, peace be upon him, said: \"The people most deserving of me are those who send the most blessings upon me.\" (3) And he, peace be upon him, said: \"It suffices a believer for miserliness that I am mentioned in his presence and he does not send blessings upon me.\" (4) And he, peace be upon him, said: \"Multiply your sending of blessings upon me on the day of Friday.\" (5) And he, peace be upon him, said: \"Whoever sends blessings upon me from my community, ten good deeds are written for him and ten evil deeds are erased from him.\" (6) And he, peace be upon him, said: \"Whoever says upon hearing the call to prayer and the iqāmah: 'O God, Lord of this perfect call and the established prayer, send blessings upon Muhammad, Your servant and Your Messenger, and grant him the means (al-wasīlah) and the excellence (al-faḍīlah) and the lofty rank (al-darajah al-rafīʿah) and the intercession (al-shafāʿah) on the Day of Resurrection' — my intercession becomes permissible for him.\" (7) And the Messenger of God, peace be upon him, said: \"Whoever sends blessings upon me in a book, the angels continue to seek forgiveness for him as long as my name remains in that book.\" (8) And he, peace be upon him, said: \"Indeed, upon the earth there are traveling angels who convey to me the greetings of peace from my community.\" (9) And he, peace be upon him, said: \"No one greets me with peace except that God returns my soul to me until I respond to his greeting.\" (1) And it was said to him: \"O Messenger of God, how do we send blessings upon you?\" He said: \"Say: 'O God, send blessings upon Muhammad, Your servant, and upon his family, his wives, and his descendants, as You sent blessings upon Abraham and the family of Abraham; and bless Muhammad, his wives, and his descendants, as You blessed Abraham and the family of Abraham. Indeed, You are Praiseworthy, Glorious.'\" (2)","book_title":"On Invocations and Supplications","section_title_ar":"Section 244","section_title_en":"Section 244 — On the Virtues of Invoking Blessings upon the Prophet (Ṣalawāt) and the Excellence of His Rank","section_index":244,"anchors":"- Root: صلو (Ṣ-L-W)\n  * Lisan / Ayn: Core root denotes prayer, blessing, supplication; al-ṣalāh from God is mercy (raḥmah), from angels is seeking forgiveness (istighfār), from believers is supplication (duʿā').\n  * Al-Raghib (Mufradat): Al-ṣalāh from God is pure mercy and beneficence; from angels it is their petition for forgiveness; from humans it is humble supplication. The divine ṣalāh upon the Prophet is an elevation of his mention and an increase in his honor.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): supplication and bending in worship. Metaphorical (majāz): God's ṣalāh upon the Prophet is His mercy and His exaltation of him before the angels; the believers' ṣalāh is their invocation and reverence.\n- Root: سلم (S-L-M)\n  * Lisan / Ayn: Root denotes safety, peace, deliverance; taslīm is the greeting of peace and submission.\n  * Al-Raghib (Mufradat): Salām from God is His safeguarding; the greeting of salām upon the Prophet is an acknowledgment of his prophetic rank and a prayer for his perfect safety.\n  * Al-Zamakhshari (Asas): Literal: greeting of peace. Metaphorical: the angels' conveyance of the believers' salām to the Prophet even after his death, indicating the enduring bond.\n- Root: حمد (Ḥ-M-D)\n  * Lisan / Ayn: Core root denotes praise, commendation; maḥmūd is the one praised.\n  * Al-Raghib (Mufradat): Ḥamd is praise for voluntary beneficence; al-ḥamd li-Llāh encompasses all praise due to God's perfect attributes.\n  * Al-Zamakhshari (Asas): Literal: to praise for good. Metaphorical: to find praiseworthy (aḥmadtu al-arḍ: I found the land agreeable).\n- Sibawayh Rule: Rule of Interposition (al-faṣl bayna al-jār wa al-majrūr) — The periodic structure of the ḥadīth reports here follows the canonical pattern of embedding quoted speech within narrative frames, maintaining syntactic cohesion across multiple levels of reported discourse.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'","badge":"Du'a"}],"28":[{"arabic":"إلى آخر السورة (3) رب اغفر لي ولوالدي وارحمهما كما ربياني صغيرا واغفر للمؤمنين والمؤمنات والمسلمين والمسلمات الأحياء منهم والأموات (4) رب اغفر وارحم وتجاوز عما تعلم وأنت الأعز الأكرم وأنت خير الراحمين وأنت خير الغافرين وإنا لله وإنا إليه راجعون ولا حول ولا قوة إلا بالله العلي العظيم وحسبنا الله ونعم الوكيل وصلى الله على محمد خاتم النبيين وآله وصحبه وسلم تسليما كثيرا (5)","english":"And employ me in righteous deeds which You will accept from me. (1) O God, I ask You for pardon, well-being, good certainty, and soundness in this world and the next. (2) O You Whom sins do not harm and from Whom forgiveness does not diminish anything — grant me that which will not harm You, and give me that which will not diminish You. Our Lord, pour upon us patience and cause us to die as Muslims. You are our Protector in this world and the next; cause me to die as a Muslim and join me with the righteous. You are our Protector, so forgive us and have mercy upon us, and You are the Best of forgivers. And write for us good in this world and in the Hereafter — indeed, we have turned to You in repentance. Our Lord, upon You we rely, to You we turn in repentance, and to You is the final return. Our Lord, make us not a trial for the wrongdoing people. Our Lord, make us not a trial for those who disbelieve, and forgive us, our Lord — indeed, You are the Mighty, the Wise. Our Lord, forgive us our sins and our excesses in our affairs, make firm our feet, and grant us victory over the disbelieving people. Our Lord, forgive us and our brothers who preceded us in faith, and place not in our hearts any rancor toward those who believe — our Lord, indeed You are Kind, Merciful. Our Lord, grant us from Yourself mercy and prepare for us from our affair right guidance. Our Lord, give us good in this world and good in the Hereafter, and protect us from the chastisement of the Fire. Our Lord, indeed we have heard a caller calling to faith — to His saying, Mighty and Majestic: {«إنك لا تخلف الميعاد»} [آل عمران/ 194] — Our Lord, do not take us to task if we forget or err. Our Lord, to the end of the surah. (3) My Lord, forgive me and my parents, and have mercy upon them as they raised me when I was small; and forgive the believing men and the believing women, and the Muslim men and the Muslim women, the living among them and the dead. (4) My Lord, forgive, have mercy, and overlook what You know — and You are the Most Exalted, the Most Generous, the Best of the merciful, and the Best of the forgivers. And indeed, to God we belong and to Him we return; and there is no might and no power except through God, the Exalted, the Magnificent; and God suffices us, and He is the Best Disposer of affairs. And may God send blessings upon Muhammad, the Seal of the Prophets, and upon his family and his companions, and grant them abundant peace. (5)","book_title":"On Invocations and Supplications","section_title_ar":"Section 252","section_title_en":"Section 252 — Supplications for Morning and Evening: Comprehensive Prayers of the Prophet (ﷺ)","section_index":252,"anchors":"- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core meaning of swallowing/ingesting (iltihām); from this derives the sense of something being cast directly into the innermost recess of the heart (al-rawʿ).\n  * Al-Raghib (Mufradat): \"الإلهام: إلقاء الشيء في الروع\" — ilhām is the casting of a thing into the innermost consciousness, specifically from God or the higher assembly (al-malaʾ al-aʿlā). It is that which the Prophet (ﷺ) called \"the touch of the angel\" (limat al-malak) and \"the breath of the Holy Spirit in my innermost heart\" (nafth rūḥ al-qudus fī rawʿī).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ألهمه الله الخير: ألقاه في روعه\" — God inspired him with good: He cast it into his innermost consciousness. Metaphorical (majāz): A horse that \"swallows the ground\" (yaltaḥimu al-arḍ) in swiftness; thus ilhām is the swift, direct ingress of divine guidance into the soul without intermediary effort.\n- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: The root denotes praise arising from recognition of voluntary excellence and beneficence; al-ḥamd is commendation of the beloved for their attributes and acts of goodness.\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence (niʿmah) with reverence and love; it is distinguished from mere thanks (shukr) in that it is directed to the essence and attributes of the praised one, not solely to the benefit received.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — I praise God with all His praiseworthy attributes. Metaphorical: \"أحمدت صنيعه\" — I found his deed praiseworthy; thus the tongue's praise must be matched by the heart's recognition of the praised one's perfection.\n- Root: غفر (gh-f-r)\n  * Lisan / Ayn: The root denotes covering and shielding; al-mighfar is the helmet that protects the head in battle.\n  * Al-Raghib (Mufradat): \"الغفر: إلباس ما يصونه عن الدنس\" — Forgiveness is the clothing of that which shields from filth. God's forgiveness (maghfirah) is His shielding of the servant from the touch of chastisement, covering the sin so that it is as though it never were.\n  * Al-Zamakhshari (Asas): Literal: \"اللهم غفرًا\" — O God, forgive. Metaphorical: The she-beasts that \"did not forgive\" their heedlessness (lam taghfir la-hā ghaflātuhā) — i.e., they did not shield their young from destruction; thus forgiveness is active protection, not mere erasure.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which breathes and has vital spirit; also used for the very essence of a thing.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul is the spirit; and in God's saying {«ويحذركم الله نفسه»} [آل عمران/ 28], \"His Self\" means His very essence (dhāt), which — though grammatically expressed as an annexation implying distinction — is in reality identical, with no multiplicity in the Divine Essence.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس\" — a precious thing. Metaphorical: \"دفق نفسه\" — he poured out his blood/life; thus nafs is the seat of life, passion, and moral responsibility.\n- Sibawayh Rule: باب الدعاء والخبر (The Chapter of Supplication and Assertion) — Supplications (duʿāʾ) are grammatically constructed as optative sentences (inshāʾ ṭalabī) using the imperative (rabbighfir), the jussive (lā tuʾākhidhnā), and the vocative (rabbanā), yet they may embed assertive clauses (khabar) of praise (al-ḥamdu lillāh) and attestation (lā ilāha illā anta). The periodic structure of these prayers alternates between direct address to God (munādāh) and self-referential confession, requiring the translator to preserve the vocative force of \"O God\" and \"Our Lord\" without flattening into mere description.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'","badge":"Du'a"}]},"wordTiming":{"abdulbasit":{"1":[[1,400,2721],[2,2721,4772],[3,4772,6318],[4,6318,7685],[5,7685,9480],[6,9480,10134],[7,10134,11412],[8,11412,12809],[9,12809,13403],[10,13403,14428],[11,14428,15082],[12,15082,17192],[13,17192,18648],[14,18648,20047]],"2":[[1,400,1414],[2,1414,3041],[3,3041,4415],[4,4415,5215],[5,5215,6442],[6,6442,8030]],"3":[[1,350,813],[2,813,2203],[3,2203,3035],[4,3035,4541],[5,4541,6480]],"4":[[1,400,1843],[2,1843,2784],[3,2784,3866],[4,3866,5936],[5,5936,8830],[6,8830,10744],[7,10744,11748],[8,11748,14101],[9,14101,15246],[10,15246,16250],[11,16250,17489],[12,17489,18712],[13,18712,20582],[14,20582,21398],[15,21398,23194],[16,23194,23978],[17,23978,25233],[18,25233,27335]],"5":[[1,400,1355],[2,1355,2046],[3,2046,3341],[4,3341,4523],[5,4523,5830],[6,5830,7112],[7,7112,9023]],"6":[[1,400,1151],[2,1151,2566],[3,2566,5336],[4,5336,6476],[5,6476,8030]],"7":[[1,400,2219],[2,2219,3682],[3,3682,5487],[4,5487,6882],[5,6882,767