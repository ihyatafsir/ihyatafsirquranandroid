n.","words":[{"id":1,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":2,"arabic":"يُعِيدُكُمْ","translit":"ْmُkُdyِʿعُy","root":"عود"},{"id":3,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":4,"arabic":"وَيُخْرِجُكُمْ","translit":"ْmُkُjgِrْhkُyَw","root":"خرج"},{"id":5,"arabic":"إِخْرَاجًا","translit":"āًjgāَrْhkِiʾ","root":"خرج"}],"hasIhya":false},{"ayah":19,"text":"وَٱللَّهُ جَعَلَ لَكُمُ ٱلْأَرْضَ بِسَاطًا ","translation":"And Allāh has made for you the earth an expanse","words":[{"id":1,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":2,"arabic":"جَعَلَ","translit":"َlَʿعَjg","root":"جعل"},{"id":3,"arabic":"لَكُمُ","translit":"ُmُkَl","root":""},{"id":4,"arabic":"ٱلْأَرْضَ","translit":"َḍْrَaʾْlٱ","root":"ارض"},{"id":5,"arabic":"بِسَاطًا","translit":"āًṭāَsِb","root":"بسط"}],"hasIhya":false},{"ayah":20,"text":"لِّتَسْلُكُوا۟ مِنْهَا سُبُلًا فِجَاجًا ","translation":"That you may follow therein roads of passage.'\"","words":[{"id":1,"arabic":"لِّتَسْلُكُوا۟","translit":"۟āwُkُlْsَtِّl","root":"سلك"},{"id":2,"arabic":"مِنْهَا","translit":"āَhْnِm","root":""},{"id":3,"arabic":"سُبُلًا","translit":"āًlُbُs","root":"سبل"},{"id":4,"arabic":"فِجَاجًا","translit":"āًjgāَjgِf","root":"فجج"}],"hasIhya":false},{"ayah":21,"text":"قَالَ نُوحٌ رَّبِّ إِنَّهُمْ عَصَوْنِى وَٱتَّبَعُوا۟ مَن لَّمْ يَزِدْهُ مَالُهُۥ وَوَلَدُهُۥٓ إِلَّا خَسَارًا ","translation":"Noah said, \"My Lord, indeed they have disobeyed me and followed him whose wealth and children will not increase him except in loss.","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"نُوحٌ","translit":"ٌḥwُn","root":""},{"id":3,"arabic":"رَّبِّ","translit":"ِّbَّr","root":"ربب"},{"id":4,"arabic":"إِنَّهُمْ","translit":"ْmُhَّnِiʾ","root":""},{"id":5,"arabic":"عَصَوْنِى","translit":"àِnْwَṣَʿع","root":"عصي"},{"id":6,"arabic":"وَٱتَّبَعُوا۟","translit":"۟āwُʿعَbَّtٱَw","root":"تبع"},{"id":7,"arabic":"مَن","translit":"nَm","root":""},{"id":8,"arabic":"لَّمْ","tran