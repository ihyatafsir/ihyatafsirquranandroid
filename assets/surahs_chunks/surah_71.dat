بِينٌ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 71, "ayah": 3, "text": "اَنُ اُ۟عْبُدُواْ اُ۬للَّهَ وَاتَّقُوهُ وَأَطِيعُونِ", "words": [{"id": 1, "arabic": "اَنُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۟عْبُدُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬للَّهَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَاتَّقُوهُ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَأَطِيعُونِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 71, "ayah": 4, "text": "يَغْفِرْ لَكُم مِّن ذُنُوبِكُمْ وَيُوَ۬خِّرْكُمُۥٓ إِلَيٰٓ أَجَلࣲ مُّسَمّيًۖ اِنَّ أَجَلَ اَ۬للَّهِ إِذَا جَآءَ لَا يُوَ۬خَّرُ لَوْ كُنتُمْ تَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "يَغْفِرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَكُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 4, "arabic": "ذُنُوبِكُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَيُوَ۬خِّرْكُمُۥٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِلَيٰٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَجَلࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُّسَمّيًۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَجَلَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 12, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 13, "arabic": "جَآءَ", "translit": "", "root": ""}, {"id": 14, "arabic": "لَا", "translit": "", "root": ""}, {"id": 15, "arabic": "يُوَ۬خَّرُ", "translit": "", "root": ""}, {"id": 16, "arabic": "لَوْ", "translit": "", "root": ""}, {"id": 17, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 18, "arabic": "تَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 71, "ayah": 5, "text": "قَالَ رَبِّ إِنِّے دَعَوْتُ قَوْمِے لَيْلاࣰ وَنَهَاراࣰ‏", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 4, "arabic": "دَعَوْتُ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَوْمِے", "translit": "", "root": ""}, {"id": 6, "arabic": "لَيْلاࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَنَهَاراࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 71, "ayah": 6, "text": "فَلَمْ يَزِدْهُمْ دُعَآءِيَ إِلَّا فِرَاراࣰۖ", "words": [{"id": 1, "arabic": "فَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَزِدْهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "دُعَآءِيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "فِرَاراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 71, "ayah": 7, "text": "وَإِنِّے كُلَّمَا دَعَوْتُهُمْ لِتَغْفِرَ لَهُمْ جَعَلُوٓاْ أَصَٰبِعَهُمْ فِےٓ ءَاذَانِهِمْ وَاسْتَغْشَوْاْ ثِيَابَهُمْ وَأَصَرُّواْ وَاسْتَكْبَرُواْ اُ۪سْتِكْبَاراࣰۖ", "words": [{"id": 1, "arabic": "وَإِنِّے", "translit": "", "root": ""}, {"id": 2, "arabic": "كُلَّمَا", "translit": "", "root": ""}, {"id": 3, "arabic": "دَعَوْتُهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِتَغْفِرَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "جَعَلُوٓاْ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَصَٰبِعَهُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 9, "arabic": "ءَاذَانِهِمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَاسْتَغْشَوْاْ", "translit": "", "root": ""}, {"id": 11, "arabic": "ثِيَابَهُمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَأَصَرُّواْ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَاسْتَكْبَرُواْ", "translit": "", "root": ""}, {"id": 14, "arabic": "اُ۪سْتِكْبَاراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 71, "ayah": 8, "text": "ثُمَّ إِنِّے دَعَوْت