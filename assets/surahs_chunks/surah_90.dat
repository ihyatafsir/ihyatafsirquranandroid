}, {"surah": 90, "ayah": 4, "text": "لَقَدْ خَلَقْنَا اَ۬لِانسَٰنَ فِے كَبَدٍۖ", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لِانسَٰنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "كَبَدٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 90, "ayah": 5, "text": "اَيَحْسِبُ أَن لَّنْ يَّقْدِرَ عَلَيْهِ أَحَدࣱ‏", "words": [{"id": 1, "arabic": "اَيَحْسِبُ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَن", "translit": "", "root": ""}, {"id": 3, "arabic": "لَّنْ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَّقْدِرَ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَحَدࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 90, "ayah": 6, "text": "يَقُولُ أَهْلَكْتُ مَالاࣰ لُّبَداًۖ", "words": [{"id": 1, "arabic": "يَقُولُ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَهْلَكْتُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَالاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "لُّبَداًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 90, "ayah": 7, "text": "اَيَحْسِبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌۖ", "words": [{"id": 1, "arabic": "اَيَحْسِبُ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَن", "translit": "", "root": ""}, {"id": 3, "arabic": "لَّمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَرَهُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَحَدٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 90, "ayah": 8, "text": "اَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ", "words": [{"id": 1, "arabic": "اَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَجْعَل", "translit": "", "root": ""}, {"id": 3, "arabic": "لَّهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَيْنَيْنِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 90, "ayah": 9, "text": "وَلِسَاناࣰ وَشَفَتَيْنِ", "words": [{"id": 1, "arabic": "وَلِسَاناࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَشَفَتَيْنِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 90, "ayah": 10, "text": "وَهَدَيْنَٰهُ اُ۬لنَّجْدَيْنِۖ", "words": [{"id": 1, "arabic": "وَهَدَيْنَٰهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لنَّجْدَيْنِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 90, "ayah": 11, "text": "فَلَا اَ۪قْتَحَمَ اَ۬لْعَقَبَةَۖ", "words": [{"id": 1, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۪قْتَحَمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْعَقَبَةَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 90, "ayah": 12, "text": "وَمَآ أَدْر۪يٰكَ مَا اَ۬لْعَقَبَةُۖ", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَدْر۪يٰكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْعَقَبَةُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 90, "ayah": 13, "text": "فَكُّ رَقَبَةٍ", "words": [{"id": 1, "arabic": "فَكُّ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَقَبَةٍ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 90, "ayah": 14, "text": "اَوِ اِطْعَامࣱ فِے يَوْمࣲ ذِے مَسْغَبَةࣲ‏", "words": [{"id": 1, "arabic": "اَوِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِطْعَامࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "يَوْمࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "ذِے", "translit": "", "root": ""}, {"id": 6, "arabic": "مَسْغَبَةࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 90, "ayah": 15, "text": "يَتِيماࣰ ذَا مَقْرَبَةٍ", "words": [{"id": 1, "arabic": "يَتِيماࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "ذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مَقْرَبَةٍ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 90, "ayah": 16, "text": "اَوْ مِسْكِيناࣰ ذَا مَتْرَبَةࣲۖ", "words": [{"id": 1, "arabic": "اَوْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِسْكِيناࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "ذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مَتْرَبَةࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 90, "ayah": 17, "text": "ثُمَّ كَانَ مِنَ اَ۬لذِينَ ءَامَنُواْ وَتَوَاصَوْاْ بِالصَّبْرِ وَتَوَاصَوْاْ بِالْمَرْحَمَةِۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَتَوَاصَوْاْ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِالصَّبْرِ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَتَوَاصَوْاْ", "translit": "", "root": ""}, {"id": 9, "arabic": "بِالْمَرْحَمَةِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 90, "ayah": 18, "text": "أُوْلَٰٓئِكَ أَصْحَٰبُ اُ۬لْمَيْمَنَةِۖ", "words": [{"id": 1, "arabic": "أُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَصْحَٰبُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْمَيْمَنَةِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 90, "ayah": 19, "text": "وَالذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمُۥٓ أَصْحَٰبُ اُ۬لْمَشْـَٔمَةِۖ", "words": [{"id": 1, "arabic": "وَالذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِـَٔايَٰتِنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "هُمُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَصْحَٰبُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لْمَشْـَٔمَةِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 90, "ayah": 20, "text": "عَلَيْهِمْ نَارࣱ مُّوصَدَةࣱۖ", "words": [{"id": 1, "arabic": "عَلَيْهِمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَارࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "مُّوصَدَةࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}]}