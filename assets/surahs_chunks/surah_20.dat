 {"surah": 20, "ayah": 78, "text": "فَأَتْبَعَهُمْ فِرْعَوْنُ بِجُنُودِهِۦ فَغَشِيَهُم مِّنَ اَ۬لْيَمِّ مَا غَشِيَهُمْۖ", "words": [{"id": 1, "arabic": "فَأَتْبَعَهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِرْعَوْنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِجُنُودِهِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَغَشِيَهُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْيَمِّ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَا", "translit": "", "root": ""}, {"id": 8, "arabic": "غَشِيَهُمْۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 79, "text": "وَأَضَلَّ فِرْعَوْنُ قَوْمَهُۥ وَمَا هَد۪يٰۖ", "words": [{"id": 1, "arabic": "وَأَضَلَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِرْعَوْنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَوْمَهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "هَد۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 80, "text": "يَٰبَنِےٓ إِسْرَآءِيلَ قَدَ اَنجَيْنَٰكُم مِّنْ عَدُوِّكُمْ وَوَٰعَدْنَٰكُمْ جَانِبَ اَ۬لطُّورِ اِ۬لَايْمَنَ وَنَزَّلْنَا عَلَيْكُمُ اُ۬لْمَنَّ وَالسَّلْو۪يٰۖ", "words": [{"id": 1, "arabic": "يَٰبَنِےٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِسْرَآءِيلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَدَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَنجَيْنَٰكُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَدُوِّكُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَوَٰعَدْنَٰكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "جَانِبَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لطُّورِ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لَايْمَنَ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَنَزَّلْنَا", "translit": "", "root": ""}, {"id": 12, "a