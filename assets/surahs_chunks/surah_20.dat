: "كُلُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَارْعَوَاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَنْعَٰمَكُمُۥٓۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَأٓيَٰتࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "لِّأُوْلِے", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لنُّه۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 55, "text": "۞مِنْهَا خَلَقْنَٰكُمْ وَفِيهَا نُعِيدُكُمْ وَمِنْهَا نُخْرِجُكُمْ تَارَةً ا۟خْر۪يٰۖ", "words": [{"id": 1, "arabic": "۞مِنْهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْنَٰكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَفِيهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "نُعِيدُكُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمِنْهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "نُخْرِجُكُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "تَارَةً", "translit": "", "root": ""}, {"id": 8, "arabic": "ا۟خْر۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 56, "text": "وَلَقَدَ اَرَيْنَٰهُ ءَايَٰتِنَا كُلَّهَا فَكَذَّبَ وَأَب۪يٰۖ", "words": [{"id": 1, "arabic": "وَلَقَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَرَيْنَٰهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَايَٰتِنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "كُلَّهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "فَكَذَّبَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَب۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 57, "text": "قَالَ أَجِئْتَنَا لِتُخْرِجَنَا مِنَ اَرْضِنَا بِسِحْرِكَ يَٰمُوس۪يٰ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَجِئْتَنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لِتُخ