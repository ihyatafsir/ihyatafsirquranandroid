": 20, "ayah": 22, "text": "وَاضْمُمْ يَدَكَ إِلَيٰ جَنَاحِكَ تَخْرُجْ بَيْضَآءَ مِنْ غَيْرِ سُوٓءٍ اٰيَةً ا۟خْر۪يٰ", "words": [{"id": 1, "arabic": "وَاضْمُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَدَكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "جَنَاحِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "تَخْرُجْ", "translit": "", "root": ""}, {"id": 6, "arabic": "بَيْضَآءَ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 8, "arabic": "غَيْرِ", "translit": "", "root": ""}, {"id": 9, "arabic": "سُوٓءٍ", "translit": "", "root": ""}, {"id": 10, "arabic": "اٰيَةً", "translit": "", "root": ""}, {"id": 11, "arabic": "ا۟خْر۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 23, "text": "لِنُرِيَكَ مِنَ اٰيَٰتِنَا اَ۬لْكُبْرَيۖ", "words": [{"id": 1, "arabic": "لِنُرِيَكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اٰيَٰتِنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْكُبْرَيۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 24, "text": "اَ۪ذْهَبِ اِلَيٰ فِرْعَوْنَ إِنَّهُۥ طَغ۪يٰۖ", "words": [{"id": 1, "arabic": "اَ۪ذْهَبِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِلَيٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِرْعَوْنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "طَغ۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 25, "text": "قَالَ رَبِّ اِ۪شْرَحْ لِے صَدْرِے", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۪شْرَحْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِے", "translit": "", "root": ""}, {"id": 5, "arabic": "صَدْرِے", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 26, "text": "وَيَسِّرْ لِيَ أَمْرِے", "words": [{"id": 1, "arabic": "وَيَسِّرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِيَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَمْرِے", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 27, "text": "وَاحْلُلْ عُقْدَةࣰ مِّن لِّسَانِے", "words": [{"id": 1, "arabic": "وَاحْلُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عُقْدَةࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 4, "arabic": "لِّسَانِے", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 28, "text": "يَفْقَهُواْ قَوْلِے", "words": [{"id": 1, "arabic": "يَفْقَهُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَوْلِے", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 29, "text": "وَاجْعَل لِّے وَزِيراࣰ مِّنَ اَهْلِے", "words": [{"id": 1, "arabic": "وَاجْعَل", "translit": "", "root": ""}, {"id": 2, "arabic": "لِّے", "translit": "", "root": ""}, {"id": 3, "arabic": "وَزِيراࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَهْلِے", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 30, "text": "هَٰرُونَ أَخِےۖ", "words": [{"id": 1, "arabic": "هَٰرُونَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَخِےۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 31, "text": "اِ۟شْدُدْ بِهِۦٓ أَزْرِے", "words": [{"id": 1, "arabic": "اِ۟شْدُدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِهِۦٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَزْرِے", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 32, "text": "وَأَشْرِكْهُ فِےٓ أَمْرِے", "words": [{"id": 1, "arabic": "وَأَشْرِكْهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَمْرِے", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 33, "text": "كَےْ نُسَبِّحَكَ كَثِيراࣰ‏", "words": [{"id": 1, "arabic": "كَےْ", "translit": "", "root": ""}, {"id": 2, "arabic": "نُسَبِّحَكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَثِيراࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 34, "text": "وَنَذْكُرَكَ كَثِيراً", "words": [{"id": 1, "arabic": "وَنَذْكُرَكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَثِيراً", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 35, "text": "اِنَّكَ كُنتَ بِنَا بَصِيراࣰۖ", "words": [{"id": 1, "arabic": "اِنَّكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "كُنتَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "بَصِيراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 36, "text": "۞قَالَ قَدُ ا۟وتِيتَ سُؤْلَكَ يَٰمُوس۪يٰۖ", "words": [{"id": 1, "arabic": "۞قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَدُ", "translit": "", "root": ""}, {"id": 3, "arabic": "ا۟وتِيتَ", "translit": "", "root": ""}, {"id": 4, "arabic": "سُؤْلَكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَٰمُوس۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 37, "text": "وَلَقَدْ مَنَنَّا عَلَيْكَ مَرَّةً ا۟خْر۪يٰٓ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنَنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَرَّةً", "translit": "", "root": ""}, {"id": 5, "arabic": "ا۟خْر۪يٰٓ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 38, "text": "إِذَ اَوْحَيْنَآ إِلَيٰٓ أُمِّكَ مَا يُوح۪يٰٓ", "words": [{"id": 1, "arabic": "إِذَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَوْحَيْنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيٰٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أُمِّكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "", "root": ""}, {"id": 6, "arabic": "يُوح۪يٰٓ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 39, "text": "أَنِ اِ۪قْذِفِيهِ فِے اِ۬لتَّابُوتِ فَاقْذِفِيهِ فِے اِ۬لْيَمِّۖ فَلْيُلْقِهِ اِ۬لْيَمُّ بِالسَّاحِلِ يَاخُذْهُ عَدُوࣱّ لِّے وَعَدُوࣱّ لَّهُۥۖ وَأَلْقَيْتُ عَلَيْكَ مَحَبَّةࣰ مِّنِّے وَلِتُصْنَعَ عَلَيٰ عَيْنِيَ", "words": [{"id": 1, "arabic": "أَنِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۪قْذِفِيهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لتَّابُوتِ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَاقْذِفِيهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْيَمِّۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَلْيُلْقِهِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لْيَمُّ", "translit": "", "root": ""}, {"id": 10, "arabic": "بِالسَّاحِلِ", "translit": "", "root": ""}, {"id": 11, "arabic": "يَاخُذْهُ", "translit": "", "root": ""}, {"id": 12, "arabic": "عَدُوࣱّ", "translit": "", "root": ""}, {"id": 13, "arabic": "لِّے", "translit": "", "root": ""}, {"id": 14, "arabic": "وَعَدُوࣱّ", "translit": "", "root": ""}, {"id": 15, "arabic": "لَّهُۥۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "وَأَلْقَيْتُ", "translit": "", "root": ""}, {"id": 17, "arabic": "عَلَيْكَ", "translit": "", "root": ""}, {"id": 18, "arabic": "مَحَبَّةࣰ", "translit": "", "root": ""}, {"id": 19, "arabic": "مِّنِّے", "translit": "", "root": ""}, {"id": 20, "arabic": "وَلِتُصْنَعَ", "translit": "", "root": ""}, {"id": 21, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 22, "arabic": "عَيْنِيَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 40, "text": "إِذْ تَمْشِےٓ أُخْتُكَ فَتَقُولُ هَلَ اَدُلُّكُمْ عَلَيٰ مَنْ يَّكْفُلُهُۥۖ فَرَجَعْنَٰكَ إِلَيٰٓ أُمِّكَ كَےْ تَقَرَّ عَيْنُهَا وَ