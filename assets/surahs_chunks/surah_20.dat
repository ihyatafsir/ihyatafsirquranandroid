xt": "اِنَّكَ كُنتَ بِنَا بَصِيراࣰۖ", "words": [{"id": 1, "arabic": "اِنَّكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "كُنتَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "بَصِيراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 36, "text": "۞قَالَ قَدُ ا۟وتِيتَ سُؤْلَكَ يَٰمُوس۪يٰۖ", "words": [{"id": 1, "arabic": "۞قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَدُ", "translit": "", "root": ""}, {"id": 3, "arabic": "ا۟وتِيتَ", "translit": "", "root": ""}, {"id": 4, "arabic": "سُؤْلَكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَٰمُوس۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 37, "text": "وَلَقَدْ مَنَنَّا عَلَيْكَ مَرَّةً ا۟خْر۪يٰٓ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنَنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَرَّةً", "translit": "", "root": ""}, {"id": 5, "arabic": "ا۟خْر۪يٰٓ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 38, "text": "إِذَ اَوْحَيْنَآ إِلَيٰٓ أُمِّكَ مَا يُوح۪يٰٓ", "words": [{"id": 1, "arabic": "إِذَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَوْحَيْنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيٰٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أُمِّكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "", "root": ""}, {"id": 6, "arabic": "يُوح۪يٰٓ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 39, "text": "أَنِ اِ۪قْذِفِيهِ فِے اِ۬لتَّابُوتِ فَاقْذِفِيهِ فِے اِ۬لْيَمِّۖ فَلْيُلْقِهِ اِ۬لْيَمُّ بِالسَّاحِلِ يَاخُذْهُ عَدُوࣱّ لِّے وَعَدُوࣱّ لَّهُۥۖ وَأَلْقَيْتُ عَلَيْكَ مَحَبَّةࣰ مِّنِّے وَلِتُصْنَعَ عَلَيٰ عَيْنِيَ", "words": [{"id": 1, "arabic": "أَنِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۪قْذِفِيهِ", "translit": ""