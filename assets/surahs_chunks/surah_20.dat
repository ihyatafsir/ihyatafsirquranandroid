ic": "إِنَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "ءَامَنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "بِرَبِّنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "لِيَغْفِرَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "خَطَٰيٰ۪نَا", "translit": "", "root": ""}, {"id": 7, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَكْرَهْتَنَا", "translit": "", "root": ""}, {"id": 9, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لسِّحْرِۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَاللَّهُ", "translit": "", "root": ""}, {"id": 13, "arabic": "خَيْرࣱ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَأَبْق۪يٰٓۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 74, "text": "إِنَّهُۥ مَنْ يَّاتِ رَبَّهُۥ مُجْرِماࣰ فَإِنَّ لَهُۥ جَهَنَّمَ لَا يَمُوتُ فِيهَا وَلَا يَحْي۪يٰۖ", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَّاتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبَّهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُجْرِماࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَإِنَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 8, "arabic": "جَهَنَّمَ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَا", "translit": "", "root": ""}, {"id": 10, "arabic": "يَمُوتُ", "translit": "", "root": ""}, {"id": 11, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 12, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 13, "arabic": "يَحْي۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 75, "text": "وَمَنْ يَّاتِهِۦ مُومِناࣰ قَدْ عَمِلَ اَ۬لصَّٰلِحَٰتِ فَأُوْلَٰٓئِكَ لَهُمُ اُ۬لدَّرَجَٰتُ اُ۬لْعُل۪يٰۖ", "words": [{"id": 1, "ar