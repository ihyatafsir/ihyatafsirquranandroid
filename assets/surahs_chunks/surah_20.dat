d": 8, "arabic": "وَمُوس۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 71, "text": "قَالَ ءَاٰ۬مَنتُمْ لَهُۥ قَبْلَ أَنَ اٰذَنَ لَكُمُۥٓ إِنَّهُۥ لَكَبِيرُكُمُ اُ۬لذِے عَلَّمَكُمُ اُ۬لسِّحْرَۖ فَلَأُقَطِّعَنَّ أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ خِلَٰفࣲ وَلَأُصَلِّبَنَّكُمْ فِے جُذُوعِ اِ۬لنَّخْلِ وَلَتَعْلَمُنَّ أَيُّنَآ أَشَدُّ عَذَاباࣰ وَأَبْق۪يٰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "ءَاٰ۬مَنتُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَبْلَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اٰذَنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَكُمُۥٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَكَبِيرُكُمُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لذِے", "translit": "", "root": ""}, {"id": 11, "arabic": "عَلَّمَكُمُ", "translit": "", "root": ""}, {"id": 12, "arabic": "اُ۬لسِّحْرَۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "فَلَأُقَطِّعَنَّ", "translit": "", "root": ""}, {"id": 14, "arabic": "أَيْدِيَكُمْ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَأَرْجُلَكُم", "translit": "", "root": ""}, {"id": 16, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 17, "arabic": "خِلَٰفࣲ", "translit": "", "root": ""}, {"id": 18, "arabic": "وَلَأُصَلِّبَنَّكُمْ", "translit": "", "root": ""}, {"id": 19, "arabic": "فِے", "translit": "", "root": ""}, {"id": 20, "arabic": "جُذُوعِ", "translit": "", "root": ""}, {"id": 21, "arabic": "اِ۬لنَّخْلِ", "translit": "", "root": ""}, {"id": 22, "arabic": "وَلَتَعْلَمُنَّ", "translit": "", "root": ""}, {"id": 23, "arabic": "أَيُّنَآ", "translit": "", "root": ""}, {"id": 24, "arabic": "أَشَدُّ", "translit": "", "root": ""}, {"id": 25, "arabic": "عَذَاباࣰ", "translit": "", "root": ""}, {"id": 26, "ar