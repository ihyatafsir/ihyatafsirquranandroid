{"surah": 20, "verses": [{"ayah": 1, "text": "طه ", "translation": "Ṭā, Hā.[1]", "words": [{"id": 1, "arabic": "طه", "translit": "hṭ", "root": ""}], "hasIhya": false}, {"ayah": 2, "text": "مَآ أَنزَلْنَا عَلَيْكَ ٱلْقُرْءَانَ لِتَشْقَىٰٓ ", "translation": "We have not sent down to you the Qur’ān that you be distressed", "words": [{"id": 1, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 2, "arabic": "أَنزَلْنَا", "translit": "āَnْlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلْقُرْءَانَ", "translit": "َnāَءْrُqْlٱ", "root": "قرا"}, {"id": 5, "arabic": "لِتَشْقَىٰٓ", "translit": "ٰٓàَqْhsَtِl", "root": "شقو"}], "hasIhya": false}, {"ayah": 3, "text": "إِلَّا تَذْكِرَةً لِّمَن يَخْشَىٰ ", "translation": "But only as a reminder for those who fear [Allāh] -", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "تَذْكِرَةً", "translit": "ًẗَrِkْhdَt", "root": "ذكر"}, {"id": 3, "arabic": "لِّمَن", "translit": "nَmِّl", "root": ""}, {"id": 4, "arabic": "يَخْشَىٰ", "translit": "ٰàَhsْhkَy", "root": "خشي"}], "hasIhya": false}, {"ayah": 4, "text": "تَنزِيلًا مِّمَّنْ خَلَقَ ٱلْأَرْضَ وَٱلسَّمَٰوَٰتِ ٱلْعُلَى ", "translation": "A revelation from He who created the earth and highest heavens,", "words": [{"id": 1, "arabic": "تَنزِيلًا", "translit": "āًlyِznَt", "root": "نزل"}, {"id": 2, "arabic": "مِّمَّنْ", "translit": "ْnَّmِّm", "root": ""}, {"id": 3, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 4, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 5, "arabic": "وَٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱَw", "root": "سمو"}, {"id": 6, "arabic": "ٱلْعُلَى", "translit": "àَlُʿعْlٱ", "root": "علو"}], "hasIhya": false}, {"ayah": 5, "text": "ٱلرَّحْمَٰنُ عَلَى ٱلْعَرْشِ ٱسْتَوَىٰ ", "translation": "The Most Merciful [who is] above the Throne established.[1]", "words": [{"id": 1, "arabic": "ٱلرَّحْمَٰنُ", "translit": "ُnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 2, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلْعَرْشِ", "translit": "ِhsْrَʿعْlٱ", "root": "عرش"}, {"id": 4, "arabic": "ٱسْتَوَىٰ", "translit": "ٰàَwَtْsٱ", "root": "سوي"}], "hasIhya": false}, {"ayah": 6, "text": "لَهُۥ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِ وَمَا بَيْنَهُمَا وَمَا تَحْتَ ٱلثَّرَىٰ ", "translation": "To Him belongs what is in the heavens and what is on the earth and what is between them and what is under the soil.", "words": [{"id": 1, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 9, "arabic": "بَيْنَهُمَا", "translit": "āَmُhَnْyَb", "root": "بين"}, {"id": 10, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 11, "arabic": "تَحْتَ", "translit": "َtْḥَt", "root": "تحت"}, {"id": 12, "arabic": "ٱلثَّرَىٰ", "translit": "ٰàَrَّhtlٱ", "root": "ثري"}], "hasIhya": false}, {"ayah": 7, "text": "وَإِن تَجْهَرْ بِٱلْقَوْلِ فَإِنَّهُۥ يَعْلَمُ ٱلسِّرَّ وَأَخْفَى ", "translation": "And if you speak aloud - then indeed, He knows the secret and what is [even] more hidden.", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "تَجْهَرْ", "translit": "ْrَhْjgَt", "root": "جهر"}, {"id": 3, "arabic": "بِٱلْقَوْلِ", "translit": "ِlْwَqْlٱِb", "root": "قول"}, {"id": 4, "arabic": "فَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَf", "root": ""}, {"id": 5, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 6, "arabic": "ٱلسِّرَّ", "translit": "َّrِّslٱ", "root": "سرر"}, {"id": 7, "arabic": "وَأَخْفَى", "translit": "àَfْhkَaʾَw", "root": "خفي"}], "hasIhya": false}, {"ayah": 8, "text": "ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَۖ لَهُ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ ", "translation": "Allāh - there is no deity except Him. To Him belong the best names.", "words": [{"id": 1, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 2, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 3, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 6, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 7, "arabic": "ٱلْأَسْمَآءُ", "translit": "ُءٓāَmْsَaʾْlٱ", "root": "سمو"}, {"id": 8, "arabic": "ٱلْحُسْنَىٰ", "translit": "ٰàَnْsُḥْlٱ", "root": "حسن"}], "hasIhya": false}, {"ayah": 9, "text": "وَهَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ ", "translation": "And has the story of Moses reached you? -", "words": [{"id": 1, "arabic": "وَهَلْ", "translit": "ْlَhَw", "root": ""}, {"id": 2, "arabic": "أَتَىٰكَ", "translit": "َkٰàَtَaʾ", "root": "اتي"}, {"id": 3, "arabic": "حَدِيثُ", "translit": "ُhtyِdَḥ", "root": "حدث"}, {"id": 4, "arabic": "مُوسَىٰٓ", "translit": "ٰٓàَswُm", "root": ""}], "hasIhya": false}, {"ayah": 10, "text": "إِذْ رَءَا نَارًا فَقَالَ لِأَهْلِهِ ٱمْكُثُوٓا۟ إِنِّىٓ ءَانَسْتُ نَارًا لَّعَلِّىٓ ءَاتِيكُم مِّنْهَا بِقَبَسٍ أَوْ أَجِدُ عَلَى ٱلنَّارِ هُدًى ", "translation": "When he saw a fire and said to his family, \"Stay here; indeed, I have perceived a fire; perhaps I can bring you a torch or find at the fire some guidance.\"", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "رَءَا", "translit": "āَءَr", "root": "راي"}, {"id": 3, "arabic": "نَارًا", "translit": "āًrāَn", "root": "نور"}, {"id": 4, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 5, "arabic": "لِأَهْلِهِ", "translit": "ِhِlْhَaʾِl", "root": "اهل"}, {"id": 6, "arabic": "ٱمْكُثُوٓا۟", "translit": "۟āٓwُhtُkْmٱ", "root": "مكث"}, {"id": 7, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 8, "arabic": "ءَانَسْتُ", "translit": "ُtْsَnāَء", "root": "انس"}, {"id": 9, "arabic": "نَارًا", "translit": "āًrāَn", "root": "نور"}, {"id": 10, "arabic": "لَّعَلِّىٓ", "translit": "ٓàِّlَʿعَّl", "root": ""}, {"id": 11, "arabic": "ءَاتِيكُم", "translit": "mُkyِtāَء", "root": "اتي"}, {"id": 12, "arabic": "مِّنْهَا", "translit": "āَhْnِّm", "root": ""}, {"id": 13, "arabic": "بِقَبَسٍ", "translit": "ٍsَbَqِb", "root": "قبس"}, {"id": 14, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 15, "arabic": "أَجِدُ", "translit": "ُdِjgَaʾ", "root": "وجد"}, {"id": 16, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 17, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 18, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}], "hasIhya": false}, {"ayah": 11, "text": "فَلَمَّآ أَتَىٰهَا نُودِىَ يَٰمُوسَىٰٓ ", "translation": "And when he came to it, he was called, \"O Moses,", "words": [{"id": 1, "arabic": "فَلَمَّآ", "translit": "ٓāَّmَlَf", "root": ""}, {"id": 2, "arabic": "أَتَىٰهَا", "translit": "āَhٰàَtَaʾ", "root": "اتي"}, {"id": 3, "arabic": "نُودِىَ", "translit": "َàِdwُn", "root": "ندي"}, {"id": 4, "arabic": "يَٰمُوسَىٰٓ", "translit": "ٰٓàَswُmَٰy", "root": ""}], "hasIhya": false}, {"ayah": 12, "text": "إِنِّىٓ أَنَا۠ رَبُّكَ فَٱخْلَعْ نَعْلَيْكَۖ إِنَّكَ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى ", "translation": "Indeed, I am your Lord, so remove your sandals. Indeed, you are in the blessed valley of Ṭuwā.", "words": [{"id": 1, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 2, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 3, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 4, "arabic": "فَٱخْلَعْ", "translit": "ْʿعَlْhkٱَf", "root": "خلع"}, {"id": 5, "arabic": "نَعْلَيْكَ", "translit": "َkْyَlْʿعَn", "root": "نعل"}, {"id": 6, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 7, "arabic": "بِٱلْوَادِ", "translit": "ِdāَwْlٱِb", "root": "ودي"}, {"id": 8, "arabic": "ٱلْمُقَدَّسِ", "translit": "ِsَّdَqُmْlٱ", "root": "قدس"}, {"id": 9, "arabic": "طُوًى", "translit": "àًwُṭ", "root": "طوي"}], "hasIhya": false}, {"ayah": 13, "text": "وَأَنَا ٱخْتَرْتُكَ فَٱسْتَمِعْ لِمَا يُوحَىٰٓ ", "translation": "And I have chosen you, so listen to what is revealed [to you].", "words": [{"id": 1, "arabic": "وَأَنَا", "translit": "āَnَaʾَw", "root": ""}, {"id": 2, "arabic": "ٱخْتَرْتُكَ", "translit": "َkُtْrَtْhkٱ", "root": "خير"}, {"id": 3, "arabic": "فَٱسْتَمِعْ", "translit": "ْʿعِmَtْsٱَf", "root": "سمع"}, {"id": 4, "arabic": "لِمَا", "translit": "āَmِl", "root": ""}, {"id": 5, "arabic": "يُوحَىٰٓ", "translit": "ٰٓàَḥwُy", "root": "وحي"}], "hasIhya": false}, {"ayah": 14, "text": "إِنَّنِىٓ أَنَا ٱللَّهُ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱعْبُدْنِى وَأَقِمِ ٱلصَّلَوٰةَ لِذِكْرِىٓ ", "translation": "Indeed, I am Allāh. There is no deity except Me, so worship Me and establish prayer for My remembrance.", "words": [{"id": 1, "arabic": "إِنَّنِىٓ", "translit": "ٓàِnَّnِiʾ", "root": ""}, {"id": 2, "arabic": "أَنَا", "translit": "āَnَaʾ", "root": ""}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 5, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 6, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 7, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 8, "arabic": "فَٱعْبُدْنِى", "translit": "àِnْdُbْʿعٱَf", "root": "عبد"}, {"id": 9, "arabic": "وَأَقِمِ", "translit": "ِmِqَaʾَw", "root": "قوم"}, {"id": 10, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 11, "arabic": "لِذِكْرِىٓ", "translit": "ٓàِrْkِhdِl", "root": "ذكر"}], "hasIhya": true}, {"ayah": 15, "text": "إِنَّ ٱلسَّاعَةَ ءَاتِيَةٌ أَكَادُ أُخْفِيهَا لِتُجْزَىٰ كُلُّ نَفْسٍۭ بِمَا تَسْعَىٰ ", "translation": "Indeed, the Hour is coming - I almost conceal it[1] - so that every soul may be recompensed according to that for which it strives.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلسَّاعَةَ", "translit": "َẗَʿعāَّslٱ", "root": "سوع"}, {"id": 3, "arabic": "ءَاتِيَةٌ", "translit": "ٌẗَyِtāَء", "root": "اتي"}, {"id": 4, "arabic": "أَكَادُ", "translit": "ُdāَkَaʾ", "root": "كود"}, {"id": 5, "arabic": "أُخْفِيهَا", "translit": "āَhyِfْhkُaʾ", "root": "خفي"}, {"id": 6, "arabic": "لِتُجْزَىٰ", "translit": "ٰàَzْjgُtِl", "root": "جزي"}, {"id": 7, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 8, "arabic": "نَفْسٍۭ", "translit": "ٍۭsْfَn", "root": "نفس"}, {"id": 9, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 10, "arabic": "تَسْعَىٰ", "translit": "ٰàَʿعْsَt", "root": "سعي"}], "hasIhya": false}, {"ayah": 16, "text": "فَلَا يَصُدَّنَّكَ عَنْهَا مَن لَّا يُؤْمِنُ بِهَا وَٱتَّبَعَ هَوَىٰهُ فَتَرْدَىٰ ", "translation": "So do not let one avert you from it[1] who does not believe in it and follows his desire, for you [then] would perish.", "words": [{"id": 1, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 2, "arabic": "يَصُدَّنَّكَ", "translit": "َkَّnَّdُṣَy", "root": "صدد"}, {"id": 3, "arabic": "عَنْهَا", "translit": "āَhْnَʿع", "root": ""}, {"id": 4, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 5, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 6, "arabic": "يُؤْمِنُ", "translit": "ُnِmْwʾُy", "root": "امن"}, {"id": 7, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 8, "arabic": "وَٱتَّبَعَ", "translit": "َʿعَbَّtٱَw", "root": "تبع"}, {"id": 9, "arabic": "هَوَىٰهُ", "translit": "ُhٰàَwَh", "root": "هوي"}, {"id": 10, "arabic": "فَتَرْدَىٰ", "translit": "ٰàَdْrَtَf", "root": "ردي"}], "hasIhya": true}, {"ayah": 17, "text": "وَمَا تِلْكَ بِيَمِينِكَ يَٰمُوسَىٰ ", "translation": "And what is that in your right hand, O Moses?\"", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 3, "arabic": "بِيَمِينِكَ", "translit": "َkِnyِmَyِb", "root": "يمن"}, {"id": 4, "arabic": "يَٰمُوسَىٰ", "translit": "ٰàَswُmَٰy", "root": ""}], "hasIhya": false}, {"ayah": 18, "text": "قَالَ هِىَ عَصَاىَ أَتَوَكَّؤُا۟ عَلَيْهَا وَأَهُشُّ بِهَا عَلَىٰ غَنَمِى وَلِىَ فِيهَا مَـَٔارِبُ أُخْرَىٰ ", "translation": "He said, \"It is my staff; I lean upon it, and I bring down leaves for my sheep and I have therein other uses.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 3, "arabic": "عَصَاىَ", "translit": "َàāَṣَʿع", "root": "عصو"}, {"id": 4, "arabic": "أَتَوَكَّؤُا۟", "translit": "۟āُwʾَّkَwَtَaʾ", "root": "وكا"}, {"id": 5, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 6, "arabic": "وَأَهُشُّ", "translit": "ُّhsُhَaʾَw", "root": "هشش"}, {"id": 7, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 8, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 9, "arabic": "غَنَمِى", "translit": "àِmَnَغ", "root": "غنم"}, {"id": 10, "arabic": "وَلِىَ", "translit": "َàِlَw", "root": ""}, {"id": 11, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 12, "arabic": "مَـَٔارِبُ", "translit": "ُbِrāَٔـَm", "root": "ارب"}, {"id": 13, "arabic": "أُخْرَىٰ", "translit": "ٰàَrْhkُaʾ", "root": "اخر"}], "hasIhya": false}, {"ayah": 19, "text": "قَالَ أَلْقِهَا يَٰمُوسَىٰ ", "translation": "[Allāh] said, \"Throw it down, O Moses.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "أَلْقِهَا", "translit": "āَhِqْlَaʾ", "root": "لقي"}, {"id": 3, "arabic": "يَٰمُوسَىٰ", "translit": "ٰàَswُmَٰy", "root": ""}], "hasIhya": false}, {"ayah": 20, "text": "فَأَلْقَىٰهَا فَإِذَا هِىَ حَيَّةٌ تَسْعَىٰ ", "translation": "So he threw it down, and thereupon it was a snake, moving swiftly.", "words": [{"id": 1, "arabic": "فَأَلْقَىٰهَا", "translit": "āَhٰàَqْlَaʾَf", "root": "لقي"}, {"id": 2, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 3, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 4, "arabic": "حَيَّةٌ", "translit": "ٌẗَّyَḥ", "root": "حيي"}, {"id": 5, "arabic": "تَسْعَىٰ", "translit": "ٰàَʿعْsَt", "root": "سعي"}], "hasIhya": false}, {"ayah": 21, "text": "قَالَ خُذْهَا وَلَا تَخَفْۖ سَنُعِيدُهَا سِيرَتَهَا ٱلْأُولَىٰ ", "translation": "[Allāh] said, \"Seize it and fear not; We will return it to its former condition.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "خُذْهَا", "translit": "āَhْhdُhk", "root": "اخذ"}, {"id": 3, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 4, "arabic": "تَخَفْ", "translit": "ْfَhkَt", "root": "خوف"}, {"id": 5, "arabic": "سَنُعِيدُهَا", "translit": "āَhُdyِʿعُnَs", "root": "عود"}, {"id": 6, "arabic": "سِيرَتَهَا", "translit": "āَhَtَryِs", "root": "سير"}, {"id": 7, "arabic": "ٱلْأُولَىٰ", "translit": "ٰàَlwُaʾْlٱ", "root": "اول"}], "hasIhya": false}, {"ayah": 22, "text": "وَٱضْمُمْ يَدَكَ إِلَىٰ جَنَاحِكَ تَخْرُجْ بَيْضَآءَ مِنْ غَيْرِ سُوٓءٍ ءَايَةً أُخْرَىٰ ", "translation": "And draw in your hand to your side; it will come out white without disease - another sign,", "words": [{"id": 1, "arabic": "وَٱضْمُمْ", "translit": "ْmُmْḍٱَw", "root": "ضمم"}, {"id": 2, "arabic": "يَدَكَ", "translit": "َkَdَy", "root": "يدي"}, {"id": 3, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 4, "arabic": "جَنَاحِكَ", "translit": "َkِḥāَnَjg", "root": "جنح"}, {"id": 5, "arabic": "تَخْرُجْ", "translit": "ْjgُrْhkَt", "root": "خرج"}, {"id": 6, "arabic": "بَيْضَآءَ", "translit": "َءٓāَḍْyَb", "root": "بيض"}, {"id": 7, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 8, "arabic": "غَيْرِ", "translit": "ِrْyَغ", "root": "غير"}, {"id": 9, "arabic": "سُوٓءٍ", "translit": "ٍءٓwُs", "root": "سوا"}, {"id": 10, "arabic": "ءَايَةً", "translit": "ًẗَyāَء", "root": "ايي"}, {"id": 11, "arabic": "أُخْرَىٰ", "translit": "ٰàَrْhkُaʾ", "root": "اخر"}], "hasIhya": false}, {"ayah": 23, "text": "لِنُرِيَكَ مِنْ ءَايَٰتِنَا ٱلْكُبْرَى ", "translation": "That We may show you [some] of Our greater signs.", "words": [{"id": 1, "arabic": "لِنُرِيَكَ", "translit": "َkَyِrُnِl", "root": "راي"}, {"id": 2, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 3, "arabic": "ءَايَٰتِنَا", "translit": "āَnِtَٰyāَء", "root": "ايي"}, {"id": 4, "arabic": "ٱلْكُبْرَى", "translit": "àَrْbُkْlٱ", "root": "كبر"}], "hasIhya": false}, {"ayah": 24, "text": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ ", "translation": "Go to Pharaoh. Indeed, he has transgressed [i.e., tyrannized].\"", "words": [{"id": 1, "arabic": "ٱذْهَبْ", "translit": "ْbَhْhdٱ", "root": "ذهب"}, {"id": 2, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 3, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 4, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 5, "arabic": "طَغَىٰ", "translit": "ٰàَغَṭ", "root": "طغي"}], "hasIhya": true}, {"ayah": 25, "text": "قَالَ رَبِّ ٱشْرَحْ لِى صَدْرِى ", "translation": "[Moses] said, \"My Lord, expand [i.e., relax] for me my breast [with assurance]", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 3, "arabic": "ٱشْرَحْ", "translit": "ْḥَrْhsٱ", "root": "شرح"}, {"id": 4, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 5, "arabic": "صَدْرِى", "translit": "àِrْdَṣ", "root": "صدر"}], "hasIhya": true}, {"ayah": 26, "text": "وَيَسِّرْ لِىٓ أَمْرِى ", "translation": "And ease for me my task", "words": [{"id": 1, "arabic": "وَيَسِّرْ", "translit": "ْrِّsَyَw", "root": "يسر"}, {"id": 2, "arabic": "لِىٓ", "translit": "ٓàِl", "root": ""}, {"id": 3, "arabic": "أَمْرِى", "translit": "àِrْmَaʾ", "root": "امر"}], "hasIhya": false}, {"ayah": 27, "text": "وَٱحْلُلْ عُقْدَةً مِّن لِّسَانِى ", "translation": "And untie the knot from my tongue", "words": [{"id": 1, "arabic": "وَٱحْلُلْ", "translit": "ْlُlْḥٱَw", "root": "حلل"}, {"id": 2, "arabic": "عُقْدَةً", "translit": "ًẗَdْqُʿع", "root": "عقد"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "لِّسَانِى", "translit": "àِnāَsِّl", "root": "لسن"}], "hasIhya": true}, {"ayah": 28, "text": "يَفْقَهُوا۟ قَوْلِى ", "translation": "That they may understand my speech.", "words": [{"id": 1, "arabic": "يَفْقَهُوا۟", "translit": "۟āwُhَqْfَy", "root": "فقه"}, {"id": 2, "arabic": "قَوْلِى", "translit": "àِlْwَq", "root": "قول"}], "hasIhya": false}, {"ayah": 29, "text": "وَٱجْعَل لِّى وَزِيرًا مِّنْ أَهْلِى ", "translation": "And appoint for me a minister [i.e., assistant] from my family -", "words": [{"id": 1, "arabic": "وَٱجْعَل", "translit": "lَʿعْjgٱَw", "root": "جعل"}, {"id": 2, "arabic": "لِّى", "translit": "àِّl", "root": ""}, {"id": 3, "arabic": "وَزِيرًا", "translit": "āًryِzَw", "root": "وزر"}, {"id": 4, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 5, "arabic": "أَهْلِى", "translit": "àِlْhَaʾ", "root": "اهل"}], "hasIhya": false}, {"ayah": 30, "text": "هَٰرُونَ أَخِى ", "translation": "Aaron, my brother.", "words": [{"id": 1, "arabic": "هَٰرُونَ", "translit": "َnwُrَٰh", "root": ""}, {"id": 2, "arabic": "أَخِى", "translit": "àِhkَaʾ", "root": "اخو"}], "hasIhya": false}, {"ayah": 31, "text": "ٱشْدُدْ بِهِۦٓ أَزْرِى ", "translation": "Increase through him my strength", "words": [{"id": 1, "arabic": "ٱشْدُدْ", "translit": "ْdُdْhsٱ", "root": "شدد"}, {"id": 2, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 3, "arabic": "أَزْرِى", "translit": "àِrْzَaʾ", "root": "ازر"}], "hasIhya": false}, {"ayah": 32, "text": "وَأَشْرِكْهُ فِىٓ أَمْرِى ", "translation": "And let him share my task", "words": [{"id": 1, "arabic": "وَأَشْرِكْهُ", "translit": "ُhْkِrْhsَaʾَw", "root": "شرك"}, {"id": 2, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 3, "arabic": "أَمْرِى", "translit": "àِrْmَaʾ", "root": "امر"}], "hasIhya": false}, {"ayah": 33, "text": "كَىْ نُسَبِّحَكَ كَثِيرًا ", "translation": "That we may exalt You much", "words": [{"id": 1, "arabic": "كَىْ", "translit": "ْàَk", "root": ""}, {"id": 2, "arabic": "نُسَبِّحَكَ", "translit": "َkَḥِّbَsُn", "root": "سبح"}, {"id": 3, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}], "hasIhya": false}, {"ayah": 34, "text": "وَنَذْكُرَكَ كَثِيرًا ", "translation": "And remember You much.", "words": [{"id": 1, "arabic": "وَنَذْكُرَكَ", "translit": "َkَrُkْhdَnَw", "root": "ذكر"}, {"id": 2, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}], "hasIhya": false}, {"ayah": 35, "text": "إِنَّكَ كُنتَ بِنَا بَصِيرًا ", "translation": "Indeed, You are of us ever Seeing.\"", "words": [{"id": 1, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 2, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 3, "arabic": "بِنَا", "translit": "āَnِb", "root": ""}, {"id": 4, "arabic": "بَصِيرًا", "translit": "āًryِṣَb", "root": "بصر"}], "hasIhya": false}, {"ayah": 36, "text": "قَالَ قَدْ أُوتِيتَ سُؤْلَكَ يَٰمُوسَىٰ ", "translation": "[Allāh] said, \"You have been granted your request, O Moses.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 3, "arabic": "أُوتِيتَ", "translit": "َtyِtwُaʾ", "root": "اتي"}, {"id": 4, "arabic": "سُؤْلَكَ", "translit": "َkَlْwʾُs", "root": "سال"}, {"id": 5, "arabic": "يَٰمُوسَىٰ", "translit": "ٰàَswُmَٰy", "root": ""}], "hasIhya": false}, {"ayah": 37, "text": "وَلَقَدْ مَنَنَّا عَلَيْكَ مَرَّةً أُخْرَىٰٓ ", "translation": "And We had already conferred favor upon you another time,", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "مَنَنَّا", "translit": "āَّnَnَm", "root": "منن"}, {"id": 3, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 4, "arabic": "مَرَّةً", "translit": "ًẗَّrَm", "root": "مرر"}, {"id": 5, "arabic": "أُخْرَىٰٓ", "translit": "ٰٓàَrْhkُaʾ", "root": "اخر"}], "hasIhya": false}, {"ayah": 38, "text": "إِذْ أَوْحَيْنَآ إِلَىٰٓ أُمِّكَ مَا يُوحَىٰٓ ", "translation": "When We inspired to your mother what We inspired,", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "أَوْحَيْنَآ", "translit": "ٓāَnْyَḥْwَaʾ", "root": "وحي"}, {"id": 3, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 4, "arabic": "أُمِّكَ", "translit": "َkِّmُaʾ", "root": "امم"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "يُوحَىٰٓ", "translit": "ٰٓàَḥwُy", "root": "وحي"}], "hasIhya": false}, {"ayah": 39, "text": "أَنِ ٱقْذِفِيهِ فِى ٱلتَّابُوتِ فَٱقْذِفِيهِ فِى ٱلْيَمِّ فَلْيُلْقِهِ ٱلْيَمُّ بِٱلسَّاحِلِ يَأْخُذْهُ عَدُوٌّ لِّى وَعَدُوٌّ لَّهُۥۚ وَأَلْقَيْتُ عَلَيْكَ مَحَبَّةً مِّنِّى وَلِتُصْنَعَ عَلَىٰ عَيْنِىٓ ", "translation": "[Saying], 'Cast him into the chest and cast it into the river, and the river will throw it onto the bank; there will take him an enemy to Me and an enemy to him.' And I bestowed upon you love from Me[1] that you would be brought up under My eye [i.e., observation and care].", "words": [{"id": 1, "arabic": "أَنِ", "translit": "ِnَaʾ", "root": ""}, {"id": 2, "arabic": "ٱقْذِفِيهِ", "translit": "ِhyِfِhdْqٱ", "root": "قذف"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلتَّابُوتِ", "translit": "ِtwُbāَّtlٱ", "root": ""}, {"id": 5, "arabic": "فَٱقْذِفِيهِ", "translit": "ِhyِfِhdْqٱَf", "root": "قذف"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْيَمِّ", "translit": "ِّmَyْlٱ", "root": "يمم"}, {"id": 8, "arabic": "فَلْيُلْقِهِ", "translit": "ِhِqْlُyْlَf", "root": "لقي"}, {"id": 9, "arabic": "ٱلْيَمُّ", "translit": "ُّmَyْlٱ", "root": "يمم"}, {"id": 10, "arabic": "بِٱلسَّاحِلِ", "translit": "ِlِḥāَّslٱِb", "root": "سحل"}, {"id": 11, "arabic": "يَأْخُذْهُ", "translit": "ُhْhdُhkْaʾَy", "root": "اخذ"}, {"id": 12, "arabic": "عَدُوٌّ", "translit": "ٌّwُdَʿع", "root": "عدو"}, {"id": 13, "arabic": "لِّى", "translit": "àِّl", "root": ""}, {"id": 14, "arabic": "وَعَدُوٌّ", "translit": "ٌّwُdَʿعَw", "root": "عدو"}, {"id": 15, "arabic": "لَّهُۥ", "translit": "ۥُhَّl", "root": ""}, {"id": 16, "arabic": "وَأَلْقَيْتُ", "translit": "ُtْyَqْlَaʾَw", "root": "لقي"}, {"id": 17, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 18, "arabic": "مَحَبَّةً", "translit": "ًẗَّbَḥَm", "root": "حبب"}, {"id": 19, "arabic": "مِّنِّى", "translit": "àِّnِّm", "root": ""}, {"id": 20, "arabic": "وَلِتُصْنَعَ", "translit": "َʿعَnْṣُtِlَw", "root": "صنع"}, {"id": 21, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 22, "arabic": "عَيْنِىٓ", "translit": "ٓàِnْyَʿع", "root": "عين"}], "hasIhya": false}, {"ayah": 40, "text": "إِذْ تَمْشِىٓ أُخْتُكَ فَتَقُولُ هَلْ أَدُلُّكُمْ عَلَىٰ مَن يَكْفُلُهُۥۖ فَرَجَعْنَٰكَ إِلَىٰٓ أُمِّكَ كَىْ تَقَرَّ عَيْنُهَا وَلَا تَحْزَنَۚ وَقَتَلْتَ نَفْسًا فَنَجَّيْنَٰكَ مِنَ ٱلْغَمِّ وَفَتَنَّٰكَ فُتُونًاۚ فَلَبِثْتَ سِنِينَ فِىٓ أَهْلِ مَدْيَنَ ثُمَّ جِئْتَ عَلَىٰ قَدَرٍ يَٰمُوسَىٰ ", "translation": "[And We favored you] when your sister went and said, 'Shall I direct you to someone who will be responsible for him?' So We restored you to your mother that she might be content and not grieve. And you killed someone,[1] but We saved you from retaliation and tried you with a [severe] trial. And you remained [some] years among the people of Madyan. Then you came [here] at the decreed time, O Moses.", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "تَمْشِىٓ", "translit": "ٓàِhsْmَt", "root": "مشي"}, {"id": 3, "arabic": "أُخْتُكَ", "translit": "َkُtْhkُaʾ", "root": "اخو"}, {"id": 4, "arabic": "فَتَقُولُ", "translit": "ُlwُqَtَf", "root": "قول"}, {"id": 5, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 6, "arabic": "أَدُلُّكُمْ", "translit": "ْmُkُّlُdَaʾ", "root": "دلل"}, {"id": 7, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 8, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 9, "arabic": "يَكْفُلُهُۥ", "translit": "ۥُhُlُfْkَy", "root": "كفل"}, {"id": 10, "arabic": "فَرَجَعْنَٰكَ", "translit": "َkَٰnْʿعَjgَrَf", "root": "رجع"}, {"id": 11, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 12, "arabic": "أُمِّكَ", "translit": "َkِّmُaʾ", "root": "امم"}, {"id": 13, "arabic": "كَىْ", "translit": "ْàَk", "root": ""}, {"id": 14, "arabic": "تَقَرَّ", "translit": "َّrَqَt", "root": "قرر"}, {"id": 15, "arabic": "عَيْنُهَا", "translit": "āَhُnْyَʿع", "root": "عين"}, {"id": 16, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 17, "arabic": "تَحْزَنَ", "translit": "َnَzْḥَt", "root": "حزن"}, {"id": 18, "arabic": "وَقَتَلْتَ", "translit": "َtْlَtَqَw", "root": "قتل"}, {"id": 19, "arabic": "نَفْسًا", "translit": "āًsْfَn", "root": "نفس"}, {"id": 20, "arabic": "فَنَجَّيْنَٰكَ", "translit": "َkَٰnْyَّjgَnَf", "root": "نجو"}, {"id": 21, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 22, "arabic": "ٱلْغَمِّ", "translit": "ِّmَغْlٱ", "root": "غمم"}, {"id": 23, "arabic": "وَفَتَنَّٰكَ", "translit": "َkَّٰnَtَfَw", "root": "فتن"}, {"id": 24, "arabic": "فُتُونًا", "translit": "āًnwُtُf", "root": "فتن"}, {"id": 25, "arabic": "فَلَبِثْتَ", "translit": "َtْhtِbَlَf", "root": "لبث"}, {"id": 26, "arabic": "سِنِينَ", "translit": "َnyِnِs", "root": "سنو"}, {"id": 27, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 28, "arabic": "أَهْلِ", "translit": "ِlْhَaʾ", "root": "اهل"}, {"id": 29, "arabic": "مَدْيَنَ", "translit": "َnَyْdَm", "root": "مدن"}, {"id": 30, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 31, "arabic": "جِئْتَ", "translit": "َtْyʾِjg", "root": "جيا"}, {"id": 32, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 33, "arabic": "قَدَرٍ", "translit": "ٍrَdَq", "root": "قدر"}, {"id": 34, "arabic": "يَٰمُوسَىٰ", "translit": "ٰàَswُmَٰy", "root": ""}], "hasIhya": false}, {"ayah": 41, "text": "وَٱصْطَنَعْتُكَ لِنَفْسِى ", "translation": "And I produced you for Myself.[1]", "words": [{"id": 1, "arabic": "وَٱصْطَنَعْتُكَ", "translit": "َkُtْʿعَnَṭْṣٱَw", "root": "صنع"}, {"id": 2, "arabic": "لِنَفْسِى", "translit": "àِsْfَnِl", "root": "نفس"}], "hasIhya": false}, {"ayah": 42, "text": "ٱذْهَبْ أَنتَ وَأَخُوكَ بِـَٔايَٰتِى وَلَا تَنِيَا فِى ذِكْرِى ", "translation": "Go, you and your brother, with My signs and do not slacken in My remembrance.", "words": [{"id": 1, "arabic": "ٱذْهَبْ", "translit": "ْbَhْhdٱ", "root": "ذهب"}, {"id": 2, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 3, "arabic": "وَأَخُوكَ", "translit": "َkwُhkَaʾَw", "root": "اخو"}, {"id": 4, "arabic": "بِـَٔايَٰتِى", "translit": "àِtَٰyāَٔـِb", "root": "ايي"}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "تَنِيَا", "translit": "āَyِnَt", "root": "وني"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ذِكْرِى", "translit": "àِrْkِhd", "root": "ذكر"}], "hasIhya": false}, {"ayah": 43, "text": "ٱذْهَبَآ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ ", "translation": "Go, both of you, to Pharaoh. Indeed, he has transgressed.", "words": [{"id": 1, "arabic": "ٱذْهَبَآ", "translit": "ٓāَbَhْhdٱ", "root": "ذهب"}, {"id": 2, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 3, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 4, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 5, "arabic": "طَغَىٰ", "translit": "ٰàَغَṭ", "root": "طغي"}], "hasIhya": false}, {"ayah": 44, "text": "فَقُولَا لَهُۥ قَوْلًا لَّيِّنًا لَّعَلَّهُۥ يَتَذَكَّرُ أَوْ يَخْشَىٰ ", "translation": "And speak to him with gentle speech that perhaps he may be reminded or fear [Allāh].\"", "words": [{"id": 1, "arabic": "فَقُولَا", "translit": "āَlwُqَf", "root": "قول"}, {"id": 2, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 3, "arabic": "قَوْلًا", "translit": "āًlْwَq", "root": "قول"}, {"id": 4, "arabic": "لَّيِّنًا", "translit": "āًnِّyَّl", "root": "لين"}, {"id": 5, "arabic": "لَّعَلَّهُۥ", "translit": "ۥُhَّlَʿعَّl", "root": ""}, {"id": 6, "arabic": "يَتَذَكَّرُ", "translit": "ُrَّkَhdَtَy", "root": "ذكر"}, {"id": 7, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 8, "arabic": "يَخْشَىٰ", "translit": "ٰàَhsْhkَy", "root": "خشي"}], "hasIhya": true}, {"ayah": 45, "text": "قَالَا رَبَّنَآ إِنَّنَا نَخَافُ أَن يَفْرُطَ عَلَيْنَآ أَوْ أَن يَطْغَىٰ ", "translation": "They said, \"Our Lord, indeed we are afraid that he will hasten [punishment] against us or that he will transgress.\"", "words": [{"id": 1, "arabic": "قَالَا", "translit": "āَlāَq", "root": "قول"}, {"id": 2, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 3, "arabic": "إِنَّنَا", "translit": "āَnَّnِiʾ", "root": ""}, {"id": 4, "arabic": "نَخَافُ", "translit": "ُfāَhkَn", "root": "خوف"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "يَفْرُطَ", "translit": "َṭُrْfَy", "root": "فرط"}, {"id": 7, "arabic": "عَلَيْنَآ", "translit": "ٓāَnْyَlَʿع", "root": ""}, {"id": 8, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 9, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 10, "arabic": "يَطْغَىٰ", "translit": "ٰàَغْṭَy", "root": "طغي"}], "hasIhya": true}, {"ayah": 46, "text": "قَالَ لَا تَخَافَآۖ إِنَّنِى مَعَكُمَآ أَسْمَعُ وَأَرَىٰ ", "translation": "[Allāh] said, \"Fear not. Indeed, I am with you both; I hear and I see.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "تَخَافَآ", "translit": "ٓāَfāَhkَt", "root": "خوف"}, {"id": 4, "arabic": "إِنَّنِى", "translit": "àِnَّnِiʾ", "root": ""}, {"id": 5, "arabic": "مَعَكُمَآ", "translit": "ٓāَmُkَʿعَm", "root": ""}, {"id": 6, "arabic": "أَسْمَعُ", "translit": "ُʿعَmْsَaʾ", "root": "سمع"}, {"id": 7, "arabic": "وَأَرَىٰ", "translit": "ٰàَrَaʾَw", "root": "راي"}], "hasIhya": false}, {"ayah": 47, "text": "فَأْتِيَاهُ فَقُولَآ إِنَّا رَسُولَا رَبِّكَ فَأَرْسِلْ مَعَنَا بَنِىٓ إِسْرَٰٓءِيلَ وَلَا تُعَذِّبْهُمْۖ قَدْ جِئْنَٰكَ بِـَٔايَةٍ مِّن رَّبِّكَۖ وَٱلسَّلَٰمُ عَلَىٰ مَنِ ٱتَّبَعَ ٱلْهُدَىٰٓ ", "translation": "So go to him and say, 'Indeed, we are messengers of your Lord, so send with us the Children of Israel and do not torment them. We have come to you with a sign from your Lord. And peace[1] will be upon he who follows the guidance.", "words": [{"id": 1, "arabic": "فَأْتِيَاهُ", "translit": "ُhāَyِtْaʾَf", "root": "اتي"}, {"id": 2, "arabic": "فَقُولَآ", "translit": "ٓāَlwُqَf", "root": "قول"}, {"id": 3, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 4, "arabic": "رَسُولَا", "translit": "āَlwُsَr", "root": "رسل"}, {"id": 5, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 6, "arabic": "فَأَرْسِلْ", "translit": "ْlِsْrَaʾَf", "root": "رسل"}, {"id": 7, "arabic": "مَعَنَا", "translit": "āَnَʿعَm", "root": ""}, {"id": 8, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 9, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "تُعَذِّبْهُمْ", "translit": "ْmُhْbِّhdَʿعُt", "root": "عذب"}, {"id": 12, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 13, "arabic": "جِئْنَٰكَ", "translit": "َkَٰnْyʾِjg", "root": "جيا"}, {"id": 14, "arabic": "بِـَٔايَةٍ", "translit": "ٍẗَyāَٔـِb", "root": "ايي"}, {"id": 15, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 16, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 17, "arabic": "وَٱلسَّلَٰمُ", "translit": "ُmَٰlَّslٱَw", "root": "سلم"}, {"id": 18, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 19, "arabic": "مَنِ", "translit": "ِnَm", "root": ""}, {"id": 20, "arabic": "ٱتَّبَعَ", "translit": "َʿعَbَّtٱ", "root": "تبع"}, {"id": 21, "arabic": "ٱلْهُدَىٰٓ", "translit": "ٰٓàَdُhْlٱ", "root": "هدي"}], "hasIhya": false}, {"ayah": 48, "text": "إِنَّا قَدْ أُوحِىَ إِلَيْنَآ أَنَّ ٱلْعَذَابَ عَلَىٰ مَن كَذَّبَ وَتَوَلَّىٰ ", "translation": "Indeed, it has been revealed to us that the punishment will be upon whoever denies and turns away.'\"", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 2, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 3, "arabic": "أُوحِىَ", "translit": "َàِḥwُaʾ", "root": "وحي"}, {"id": 4, "arabic": "إِلَيْنَآ", "translit": "ٓāَnْyَlِiʾ", "root": ""}, {"id": 5, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 6, "arabic": "ٱلْعَذَابَ", "translit": "َbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 7, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 8, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 9, "arabic": "كَذَّبَ", "translit": "َbَّhdَk", "root": "كذب"}, {"id": 10, "arabic": "وَتَوَلَّىٰ", "translit": "ٰàَّlَwَtَw", "root": "ولي"}], "hasIhya": false}, {"ayah": 49, "text": "قَالَ فَمَن رَّبُّكُمَا يَٰمُوسَىٰ ", "translation": "[Pharaoh] said, \"So who is the Lord of you two, O Moses?\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 3, "arabic": "رَّبُّكُمَا", "translit": "āَmُkُّbَّr", "root": "ربب"}, {"id": 4, "arabic": "يَٰمُوسَىٰ", "translit": "ٰàَswُmَٰy", "root": ""}], "hasIhya": false}, {"ayah": 50, "text": "قَالَ رَبُّنَا ٱلَّذِىٓ أَعْطَىٰ كُلَّ شَىْءٍ خَلْقَهُۥ ثُمَّ هَدَىٰ ", "translation": "He said, \"Our Lord is He who gave each thing its form and then guided [it].\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "رَبُّنَا", "translit": "āَnُّbَr", "root": "ربب"}, {"id": 3, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "أَعْطَىٰ", "translit": "ٰàَṭْʿعَaʾ", "root": "عطو"}, {"id": 5, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 6, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 7, "arabic": "خَلْقَهُۥ", "translit": "ۥُhَqْlَhk", "root": "خلق"}, {"id": 8, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 9, "arabic": "هَدَىٰ", "translit": "ٰàَdَh", "root": "هدي"}], "hasIhya": true}, {"ayah": 51, "text": "قَالَ فَمَا بَالُ ٱلْقُرُونِ ٱلْأُولَىٰ ", "translation": "[Pharaoh] said, \"Then what is the case of the former generations?\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 3, "arabic": "بَالُ", "translit": "ُlāَb", "root": "بول"}, {"id": 4, "arabic": "ٱلْقُرُونِ", "translit": "ِnwُrُqْlٱ", "root": "قرن"}, {"id": 5, "arabic": "ٱلْأُولَىٰ", "translit": "ٰàَlwُaʾْlٱ", "root": "اول"}], "hasIhya": false}, {"ayah": 52, "text": "قَالَ عِلْمُهَا عِندَ رَبِّى فِى كِتَٰبٍۖ لَّا يَضِلُّ رَبِّى وَلَا يَنسَى ", "translation": "[Moses] said, \"The knowledge thereof is with my Lord in a record. My Lord neither errs nor forgets.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "عِلْمُهَا", "translit": "āَhُmْlِʿع", "root": "علم"}, {"id": 3, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 4, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "كِتَٰبٍ", "translit": "ٍbَٰtِk", "root": "كتب"}, {"id": 7, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 8, "arabic": "يَضِلُّ", "translit": "ُّlِḍَy", "root": "ضلل"}, {"id": 9, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "يَنسَى", "translit": "àَsnَy", "root": "نسي"}], "hasIhya": false}, {"ayah": 53, "text": "ٱلَّذِى جَعَلَ لَكُمُ ٱلْأَرْضَ مَهْدًا وَسَلَكَ لَكُمْ فِيهَا سُبُلًا وَأَنزَلَ مِنَ ٱلسَّمَآءِ مَآءً فَأَخْرَجْنَا بِهِۦٓ أَزْوَٰجًا مِّن نَّبَاتٍ شَتَّىٰ ", "translation": "[It is He] who has made for you the earth as a bed [spread out] and inserted therein for you roadways and sent down from the sky, rain and produced thereby categories of various plants.", "words": [{"id": 1, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 4, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 5, "arabic": "مَهْدًا", "translit": "āًdْhَm", "root": "مهد"}, {"id": 6, "arabic": "وَسَلَكَ", "translit": "َkَlَsَw", "root": "سلك"}, {"id": 7, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 8, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 9, "arabic": "سُبُلًا", "translit": "āًlُbُs", "root": "سبل"}, {"id": 10, "arabic": "وَأَنزَلَ", "translit": "َlَznَaʾَw", "root": "نزل"}, {"id": 11, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 12, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 13, "arabic": "مَآءً", "translit": "ًءٓāَm", "root": "موه"}, {"id": 14, "arabic": "فَأَخْرَجْنَا", "translit": "āَnْjgَrْhkَaʾَf", "root": "خرج"}, {"id": 15, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 16, "arabic": "أَزْوَٰجًا", "translit": "āًjgَٰwْzَaʾ", "root": "زوج"}, {"id": 17, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 18, "arabic": "نَّبَاتٍ", "translit": "ٍtāَbَّn", "root": "نبت"}, {"id": 19, "arabic": "شَتَّىٰ", "translit": "ٰàَّtَhs", "root": "شتت"}], "hasIhya": false}, {"ayah": 54, "text": "كُلُوا۟ وَٱرْعَوْا۟ أَنْعَٰمَكُمْۗ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّأُو۟لِى ٱلنُّهَىٰ ", "translation": "Eat [therefrom] and pasture your livestock. Indeed in that are signs for those of intelligence.", "words": [{"id": 1, "arabic": "كُلُوا۟", "translit": "۟āwُlُk", "root": "اكل"}, {"id": 2, "arabic": "وَٱرْعَوْا۟", "translit": "۟āْwَʿعْrٱَw", "root": "رعي"}, {"id": 3, "arabic": "أَنْعَٰمَكُمْ", "translit": "ْmُkَmَٰʿعْnَaʾ", "root": "نعم"}, {"id": 4, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 7, "arabic": "لَءَايَٰتٍ", "translit": "ٍtَٰyāَءَl", "root": "ايي"}, {"id": 8, "arabic": "لِّأُو۟لِى", "translit": "àِl۟wُaʾِّl", "root": ""}, {"id": 9, "arabic": "ٱلنُّهَىٰ", "translit": "ٰàَhُّnlٱ", "root": "نهي"}], "hasIhya": false}, {"ayah": 55, "text": "مِنْهَا خَلَقْنَٰكُمْ وَفِيهَا نُعِيدُكُمْ وَمِنْهَا نُخْرِجُكُمْ تَارَةً أُخْرَىٰ ", "translation": "From it [i.e., the earth] We created you, and into it We will return you, and from it We will extract you another time.", "words": [{"id": 1, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 2, "arabic": "خَلَقْنَٰكُمْ", "translit": "ْmُkَٰnْqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "وَفِيهَا", "translit": "āَhyِfَw", "root": ""}, {"id": 4, "arabic": "نُعِيدُكُمْ", "translit": "ْmُkُdyِʿعُn", "root": "عود"}, {"id": 5, "arabic": "وَمِنْهَا", "translit": "āَhْnِmَw", "root": ""}, {"id": 6, "arabic": "نُخْرِجُكُمْ", "translit": "ْmُkُjgِrْhkُn", "root": "خرج"}, {"id": 7, "arabic": "تَارَةً", "translit": "ًẗَrāَt", "root": "تور"}, {"id": 8, "arabic": "أُخْرَىٰ", "translit": "ٰàَrْhkُaʾ", "root": "اخر"}], "hasIhya": true}, {"ayah": 56, "text": "وَلَقَدْ أَرَيْنَٰهُ ءَايَٰتِنَا كُلَّهَا فَكَذَّبَ وَأَبَىٰ ", "translation": "And We certainly showed him [i.e., Pharaoh] Our signs - all of them - but he denied and refused.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "أَرَيْنَٰهُ", "translit": "ُhَٰnْyَrَaʾ", "root": "راي"}, {"id": 3, "arabic": "ءَايَٰتِنَا", "translit": "āَnِtَٰyāَء", "root": "ايي"}, {"id": 4, "arabic": "كُلَّهَا", "translit": "āَhَّlُk", "root": "كلل"}, {"id": 5, "arabic": "فَكَذَّبَ", "translit": "َbَّhdَkَf", "root": "كذب"}, {"id": 6, "arabic": "وَأَبَىٰ", "translit": "ٰàَbَaʾَw", "root": "ابي"}], "hasIhya": false}, {"ayah": 57, "text": "قَالَ أَجِئْتَنَا لِتُخْرِجَنَا مِنْ أَرْضِنَا بِسِحْرِكَ يَٰمُوسَىٰ ", "translation": "He said, \"Have you come to us to drive us out of our land with your magic, O Moses?", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "أَجِئْتَنَا", "translit": "āَnَtْyʾِjgَaʾ", "root": "جيا"}, {"id": 3, "arabic": "لِتُخْرِجَنَا", "translit": "āَnَjgِrْhkُtِl", "root": "خرج"}, {"id": 4, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 5, "arabic": "أَرْضِنَا", "translit": "āَnِḍْrَaʾ", "root": "ارض"}, {"id": 6, "arabic": "بِسِحْرِكَ", "translit": "َkِrْḥِsِb", "root": "سحر"}, {"id": 7, "arabic": "يَٰمُوسَىٰ", "translit": "ٰàَswُmَٰy", "root": ""}], "hasIhya": false}, {"ayah": 58, "text": "فَلَنَأْتِيَنَّكَ بِسِحْرٍ مِّثْلِهِۦ فَٱجْعَلْ بَيْنَنَا وَبَيْنَكَ مَوْعِدًا لَّا نُخْلِفُهُۥ نَحْنُ وَلَآ أَنتَ مَكَانًا سُوًى ", "translation": "Then we will surely bring you magic like it, so make between us and you an appointment, which we will not fail to keep and neither will you, in a place assigned.\"[1]", "words": [{"id": 1, "arabic": "فَلَنَأْتِيَنَّكَ", "translit": "َkَّnَyِtْaʾَnَlَf", "root": "اتي"}, {"id": 2, "arabic": "بِسِحْرٍ", "translit": "ٍrْḥِsِb", "root": "سحر"}, {"id": 3, "arabic": "مِّثْلِهِۦ", "translit": "ۦِhِlْhtِّm", "root": "مثل"}, {"id": 4, "arabic": "فَٱجْعَلْ", "translit": "ْlَʿعْjgٱَf", "root": "جعل"}, {"id": 5, "arabic": "بَيْنَنَا", "translit": "āَnَnْyَb", "root": "بين"}, {"id": 6, "arabic": "وَبَيْنَكَ", "translit": "َkَnْyَbَw", "root": "بين"}, {"id": 7, "arabic": "مَوْعِدًا", "translit": "āًdِʿعْwَm", "root": "وعد"}, {"id": 8, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 9, "arabic": "نُخْلِفُهُۥ", "translit": "ۥُhُfِlْhkُn", "root": "خلف"}, {"id": 10, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 11, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 12, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 13, "arabic": "مَكَانًا", "translit": "āًnāَkَm", "root": "كون"}, {"id": 14, "arabic": "سُوًى", "translit": "àًwُs", "root": "سوي"}], "hasIhya": false}, {"ayah": 59, "text": "قَالَ مَوْعِدُكُمْ يَوْمُ ٱلزِّينَةِ وَأَن يُحْشَرَ ٱلنَّاسُ ضُحًى ", "translation": "[Moses] said, \"Your appointment is on the day of the festival when the people assemble at mid-morning.\"[1]", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "مَوْعِدُكُمْ", "translit": "ْmُkُdِʿعْwَm", "root": "وعد"}, {"id": 3, "arabic": "يَوْمُ", "translit": "ُmْwَy", "root": "يوم"}, {"id": 4, "arabic": "ٱلزِّينَةِ", "translit": "ِẗَnyِّzlٱ", "root": "زين"}, {"id": 5, "arabic": "وَأَن", "translit": "nَaʾَw", "root": ""}, {"id": 6, "arabic": "يُحْشَرَ", "translit": "َrَhsْḥُy", "root": "حشر"}, {"id": 7, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 8, "arabic": "ضُحًى", "translit": "àًḥُḍ", "root": "ضحو"}], "hasIhya": false}, {"ayah": 60, "text": "فَتَوَلَّىٰ فِرْعَوْنُ فَجَمَعَ كَيْدَهُۥ ثُمَّ أَتَىٰ ", "translation": "So Pharaoh went away, put together his plan, and then came [to Moses].", "words": [{"id": 1, "arabic": "فَتَوَلَّىٰ", "translit": "ٰàَّlَwَtَf", "root": "ولي"}, {"id": 2, "arabic": "فِرْعَوْنُ", "translit": "ُnْwَʿعْrِf", "root": ""}, {"id": 3, "arabic": "فَجَمَعَ", "translit": "َʿعَmَjgَf", "root": "جمع"}, {"id": 4, "arabic": "كَيْدَهُۥ", "translit": "ۥُhَdْyَk", "root": "كيد"}, {"id": 5, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 6, "arabic": "أَتَىٰ", "translit": "ٰàَtَaʾ", "root": "اتي"}], "hasIhya": false}, {"ayah": 61, "text": "قَالَ لَهُم مُّوسَىٰ وَيْلَكُمْ لَا تَفْتَرُوا۟ عَلَى ٱللَّهِ كَذِبًا فَيُسْحِتَكُم بِعَذَابٍۖ وَقَدْ خَابَ مَنِ ٱفْتَرَىٰ ", "translation": "Moses said to them [i.e., the magicians summoned by Pharaoh], \"Woe to you! Do not invent a lie against Allāh or He will exterminate you with a punishment; and he has failed who invents [such falsehood].\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 3, "arabic": "مُّوسَىٰ", "translit": "ٰàَswُّm", "root": ""}, {"id": 4, "arabic": "وَيْلَكُمْ", "translit": "ْmُkَlْyَw", "root": ""}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "تَفْتَرُوا۟", "translit": "۟āwُrَtْfَt", "root": "فري"}, {"id": 7, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "كَذِبًا", "translit": "āًbِhdَk", "root": "كذب"}, {"id": 10, "arabic": "فَيُسْحِتَكُم", "translit": "mُkَtِḥْsُyَf", "root": "سحت"}, {"id": 11, "arabic": "بِعَذَابٍ", "translit": "ٍbāَhdَʿعِb", "root": "عذب"}, {"id": 12, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 13, "arabic": "خَابَ", "translit": "َbāَhk", "root": "خيب"}, {"id": 14, "arabic": "مَنِ", "translit": "ِnَm", "root": ""}, {"id": 15, "arabic": "ٱفْتَرَىٰ", "translit": "ٰàَrَtْfٱ", "root": "فري"}], "hasIhya": false}, {"ayah": 62, "text": "فَتَنَٰزَعُوٓا۟ أَمْرَهُم بَيْنَهُمْ وَأَسَرُّوا۟ ٱلنَّجْوَىٰ ", "translation": "So they disputed over their affair among themselves and concealed their private conversation.", "words": [{"id": 1, "arabic": "فَتَنَٰزَعُوٓا۟", "translit": "۟āٓwُʿعَzَٰnَtَf", "root": "نزع"}, {"id": 2, "arabic": "أَمْرَهُم", "translit": "mُhَrْmَaʾ", "root": "امر"}, {"id": 3, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 4, "arabic": "وَأَسَرُّوا۟", "translit": "۟āwُّrَsَaʾَw", "root": "سرر"}, {"id": 5, "arabic": "ٱلنَّجْوَىٰ", "translit": "ٰàَwْjgَّnlٱ", "root": "نجو"}], "hasIhya": false}, {"ayah": 63, "text": "قَالُوٓا۟ إِنْ هَٰذَٰنِ لَسَٰحِرَٰنِ يُرِيدَانِ أَن يُخْرِجَاكُم مِّنْ أَرْضِكُم بِسِحْرِهِمَا وَيَذْهَبَا بِطَرِيقَتِكُمُ ٱلْمُثْلَىٰ ", "translation": "They said, \"Indeed, these are two magicians who want to drive you out of your land with their magic and do away with your most exemplary way [i.e., religion or tradition].", "words": [{"id": 1, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 2, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 3, "arabic": "هَٰذَٰنِ", "translit": "ِnَٰhdَٰh", "root": ""}, {"id": 4, "arabic": "لَسَٰحِرَٰنِ", "translit": "ِnَٰrِḥَٰsَl", "root": "سحر"}, {"id": 5, "arabic": "يُرِيدَانِ", "translit": "ِnāَdyِrُy", "root": "رود"}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "يُخْرِجَاكُم", "translit": "mُkāَjgِrْhkُy", "root": "خرج"}, {"id": 8, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 9, "arabic": "أَرْضِكُم", "translit": "mُkِḍْrَaʾ", "root": "ارض"}, {"id": 10, "arabic": "بِسِحْرِهِمَا", "translit": "āَmِhِrْḥِsِb", "root": "سحر"}, {"id": 11, "arabic": "وَيَذْهَبَا", "translit": "āَbَhْhdَyَw", "root": "ذهب"}, {"id": 12, "arabic": "بِطَرِيقَتِكُمُ", "translit": "ُmُkِtَqyِrَṭِb", "root": "طرق"}, {"id": 13, "arabic": "ٱلْمُثْلَىٰ", "translit": "ٰàَlْhtُmْlٱ", "root": "مثل"}], "hasIhya": false}, {"ayah": 64, "text": "فَأَجْمِعُوا۟ كَيْدَكُمْ ثُمَّ ٱئْتُوا۟ صَفًّاۚ وَقَدْ أَفْلَحَ ٱلْيَوْمَ مَنِ ٱسْتَعْلَىٰ ", "translation": "So resolve upon your plan and then come [forward] in line. And he has succeeded today who overcomes.\"", "words": [{"id": 1, "arabic": "فَأَجْمِعُوا۟", "translit": "۟āwُʿعِmْjgَaʾَf", "root": "جمع"}, {"id": 2, "arabic": "كَيْدَكُمْ", "translit": "ْmُkَdْyَk", "root": "كيد"}, {"id": 3, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 4, "arabic": "ٱئْتُوا۟", "translit": "۟āwُtْyʾٱ", "root": "اتي"}, {"id": 5, "arabic": "صَفًّا", "translit": "āًّfَṣ", "root": "صفف"}, {"id": 6, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 7, "arabic": "أَفْلَحَ", "translit": "َḥَlْfَaʾ", "root": "فلح"}, {"id": 8, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 9, "arabic": "مَنِ", "translit": "ِnَm", "root": ""}, {"id": 10, "arabic": "ٱسْتَعْلَىٰ", "translit": "ٰàَlْʿعَtْsٱ", "root": "علو"}], "hasIhya": false}, {"ayah": 65, "text": "قَالُوا۟ يَٰمُوسَىٰٓ إِمَّآ أَن تُلْقِىَ وَإِمَّآ أَن نَّكُونَ أَوَّلَ مَنْ أَلْقَىٰ ", "translation": "They said, \"O Moses, either you throw or we will be the first to throw.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰمُوسَىٰٓ", "translit": "ٰٓàَswُmَٰy", "root": ""}, {"id": 3, "arabic": "إِمَّآ", "translit": "ٓāَّmِiʾ", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "تُلْقِىَ", "translit": "َàِqْlُt", "root": "لقي"}, {"id": 6, "arabic": "وَإِمَّآ", "translit": "ٓāَّmِiʾَw", "root": ""}, {"id": 7, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 8, "arabic": "نَّكُونَ", "translit": "َnwُkَّn", "root": "كون"}, {"id": 9, "arabic": "أَوَّلَ", "translit": "َlَّwَaʾ", "root": "اول"}, {"id": 10, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 11, "arabic": "أَلْقَىٰ", "translit": "ٰàَqْlَaʾ", "root": "لقي"}], "hasIhya": false}, {"ayah": 66, "text": "قَالَ بَلْ أَلْقُوا۟ۖ فَإِذَا حِبَالُهُمْ وَعِصِيُّهُمْ يُخَيَّلُ إِلَيْهِ مِن سِحْرِهِمْ أَنَّهَا تَسْعَىٰ ", "translation": "He said, \"Rather, you throw.\" And suddenly their ropes and staffs seemed to him from their magic that they were moving [like snakes].", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 3, "arabic": "أَلْقُوا۟", "translit": "۟āwُqْlَaʾ", "root": "لقي"}, {"id": 4, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 5, "arabic": "حِبَالُهُمْ", "translit": "ْmُhُlāَbِḥ", "root": "حبل"}, {"id": 6, "arabic": "وَعِصِيُّهُمْ", "translit": "ْmُhُّyِṣِʿعَw", "root": "عصو"}, {"id": 7, "arabic": "يُخَيَّلُ", "translit": "ُlَّyَhkُy", "root": "خيل"}, {"id": 8, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "سِحْرِهِمْ", "translit": "ْmِhِrْḥِs", "root": "سحر"}, {"id": 11, "arabic": "أَنَّهَا", "translit": "āَhَّnَaʾ", "root": ""}, {"id": 12, "arabic": "تَسْعَىٰ", "translit": "ٰàَʿعْsَt", "root": "سعي"}], "hasIhya": false}, {"ayah": 67, "text": "فَأَوْجَسَ فِى نَفْسِهِۦ خِيفَةً مُّوسَىٰ ", "translation": "And he sensed within himself apprehension, did Moses.", "words": [{"id": 1, "arabic": "فَأَوْجَسَ", "translit": "َsَjgْwَaʾَf", "root": "وجس"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "نَفْسِهِۦ", "translit": "ۦِhِsْfَn", "root": "نفس"}, {"id": 4, "arabic": "خِيفَةً", "translit": "ًẗَfyِhk", "root": "خوف"}, {"id": 5, "arabic": "مُّوسَىٰ", "translit": "ٰàَswُّm", "root": ""}], "hasIhya": false}, {"ayah": 68, "text": "قُلْنَا لَا تَخَفْ إِنَّكَ أَنتَ ٱلْأَعْلَىٰ ", "translation": "We [i.e., Allāh] said, \"Fear not. Indeed, it is you who are superior.", "words": [{"id": 1, "arabic": "قُلْنَا", "translit": "āَnْlُq", "root": "قول"}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "تَخَفْ", "translit": "ْfَhkَt", "root": "خوف"}, {"id": 4, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 5, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 6, "arabic": "ٱلْأَعْلَىٰ", "translit": "ٰàَlْʿعَaʾْlٱ", "root": "علو"}], "hasIhya": true}, {"ayah": 69, "text": "وَأَلْقِ مَا فِى يَمِينِكَ تَلْقَفْ مَا صَنَعُوٓا۟ۖ إِنَّمَا صَنَعُوا۟ كَيْدُ سَٰحِرٍۖ وَلَا يُفْلِحُ ٱلسَّاحِرُ حَيْثُ أَتَىٰ ", "translation": "And throw what is in your right hand; it will swallow up what they have crafted. What they have crafted is but the trick of a magician, and the magician will not succeed wherever he is.\"", "words": [{"id": 1, "arabic": "وَأَلْقِ", "translit": "ِqْlَaʾَw", "root": "لقي"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "يَمِينِكَ", "translit": "َkِnyِmَy", "root": "يمن"}, {"id": 5, "arabic": "تَلْقَفْ", "translit": "ْfَqْlَt", "root": "لقف"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "صَنَعُوٓا۟", "translit": "۟āٓwُʿعَnَṣ", "root": "صنع"}, {"id": 8, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 9, "arabic": "صَنَعُوا۟", "translit": "۟āwُʿعَnَṣ", "root": "صنع"}, {"id": 10, "arabic": "كَيْدُ", "translit": "ُdْyَk", "root": "كيد"}, {"id": 11, "arabic": "سَٰحِرٍ", "translit": "ٍrِḥَٰs", "root": "سحر"}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "يُفْلِحُ", "translit": "ُḥِlْfُy", "root": "فلح"}, {"id": 14, "arabic": "ٱلسَّاحِرُ", "translit": "ُrِḥāَّslٱ", "root": "سحر"}, {"id": 15, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 16, "arabic": "أَتَىٰ", "translit": "ٰàَtَaʾ", "root": "اتي"}], "hasIhya": false}, {"ayah": 70, "text": "فَأُلْقِىَ ٱلسَّحَرَةُ سُجَّدًا قَالُوٓا۟ ءَامَنَّا بِرَبِّ هَٰرُونَ وَمُوسَىٰ ", "translation": "So the magicians fell down in prostration.[1] They said, \"We have believed in the Lord of Aaron and Moses.\"", "words": [{"id": 1, "arabic": "فَأُلْقِىَ", "translit": "َàِqْlُaʾَf", "root": "لقي"}, {"id": 2, "arabic": "ٱلسَّحَرَةُ", "translit": "ُẗَrَḥَّslٱ", "root": "سحر"}, {"id": 3, "arabic": "سُجَّدًا", "translit": "āًdَّjgُs", "root": "سجد"}, {"id": 4, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 5, "arabic": "ءَامَنَّا", "translit": "āَّnَmāَء", "root": "امن"}, {"id": 6, "arabic": "بِرَبِّ", "translit": "ِّbَrِb", "root": "ربب"}, {"id": 7, "arabic": "هَٰرُونَ", "translit": "َnwُrَٰh", "root": ""}, {"id": 8, "arabic": "وَمُوسَىٰ", "translit": "ٰàَswُmَw", "root": ""}], "hasIhya": false}, {"ayah": 71, "text": "قَالَ ءَامَنتُمْ لَهُۥ قَبْلَ أَنْ ءَاذَنَ لَكُمْۖ إِنَّهُۥ لَكَبِيرُكُمُ ٱلَّذِى عَلَّمَكُمُ ٱلسِّحْرَۖ فَلَأُقَطِّعَنَّ أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ خِلَٰفٍ وَلَأُصَلِّبَنَّكُمْ فِى جُذُوعِ ٱلنَّخْلِ وَلَتَعْلَمُنَّ أَيُّنَآ أَشَدُّ عَذَابًا وَأَبْقَىٰ ", "translation": "[Pharaoh] said, \"You believed him [i.e., Moses] before I gave you permission. Indeed, he is your leader who has taught you magic. So I will surely cut off your hands and your feet on opposite sides, and I will crucify you on the trunks of palm trees, and you will surely know which of us is more severe in [giving] punishment and more enduring.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "ءَامَنتُمْ", "translit": "ْmُtnَmāَء", "root": "امن"}, {"id": 3, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 4, "arabic": "قَبْلَ", "translit": "َlْbَq", "root": "قبل"}, {"id": 5, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 6, "arabic": "ءَاذَنَ", "translit": "َnَhdāَء", "root": "اذن"}, {"id": 7, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 8, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 9, "arabic": "لَكَبِيرُكُمُ", "translit": "ُmُkُryِbَkَl", "root": "كبر"}, {"id": 10, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "عَلَّمَكُمُ", "translit": "ُmُkَmَّlَʿع", "root": "علم"}, {"id": 12, "arabic": "ٱلسِّحْرَ", "translit": "َrْḥِّslٱ", "root": "سحر"}, {"id": 13, "arabic": "فَلَأُقَطِّعَنَّ", "translit": "َّnَʿعِّṭَqُaʾَlَf", "root": "قطع"}, {"id": 14, "arabic": "أَيْدِيَكُمْ", "translit": "ْmُkَyِdْyَaʾ", "root": "يدي"}, {"id": 15, "arabic": "وَأَرْجُلَكُم", "translit": "mُkَlُjgْrَaʾَw", "root": "رجل"}, {"id": 16, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 17, "arabic": "خِلَٰفٍ", "translit": "ٍfَٰlِhk", "root": "خلف"}, {"id": 18, "arabic": "وَلَأُصَلِّبَنَّكُمْ", "translit": "ْmُkَّnَbِّlَṣُaʾَlَw", "root": "صلب"}, {"id": 19, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 20, "arabic": "جُذُوعِ", "translit": "ِʿعwُhdُjg", "root": "جذع"}, {"id": 21, "arabic": "ٱلنَّخْلِ", "translit": "ِlْhkَّnlٱ", "root": "نخل"}, {"id": 22, "arabic": "وَلَتَعْلَمُنَّ", "translit": "َّnُmَlْʿعَtَlَw", "root": "علم"}, {"id": 23, "arabic": "أَيُّنَآ", "translit": "ٓāَnُّyَaʾ", "root": "ايي"}, {"id": 24, "arabic": "أَشَدُّ", "translit": "ُّdَhsَaʾ", "root": "شدد"}, {"id": 25, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 26, "arabic": "وَأَبْقَىٰ", "translit": "ٰàَqْbَaʾَw", "root": "بقي"}], "hasIhya": false}, {"ayah": 72, "text": "قَالُوا۟ لَن نُّؤْثِرَكَ عَلَىٰ مَا جَآءَنَا مِنَ ٱلْبَيِّنَٰتِ وَٱلَّذِى فَطَرَنَاۖ فَٱقْضِ مَآ أَنتَ قَاضٍۖ إِنَّمَا تَقْضِى هَٰذِهِ ٱلْحَيَوٰةَ ٱلدُّنْيَآ ", "translation": "They said, \"Never will we prefer you over what has come to us of clear proofs and [over] He who created us.[1] So decree whatever you are to decree. You can only decree for this worldly life.", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 3, "arabic": "نُّؤْثِرَكَ", "translit": "َkَrِhtْwʾُّn", "root": "اثر"}, {"id": 4, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "جَآءَنَا", "translit": "āَnَءٓāَjg", "root": "جيا"}, {"id": 7, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 8, "arabic": "ٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱ", "root": "بين"}, {"id": 9, "arabic": "وَٱلَّذِى", "translit": "àِhdَّlٱَw", "root": ""}, {"id": 10, "arabic": "فَطَرَنَا", "translit": "āَnَrَṭَf", "root": "فطر"}, {"id": 11, "arabic": "فَٱقْضِ", "translit": "ِḍْqٱَf", "root": "قضي"}, {"id": 12, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 13, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 14, "arabic": "قَاضٍ", "translit": "ٍḍāَq", "root": "قضي"}, {"id": 15, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 16, "arabic": "تَقْضِى", "translit": "àِḍْqَt", "root": "قضي"}, {"id": 17, "arabic": "هَٰذِهِ", "translit": "ِhِhdَٰh", "root": ""}, {"id": 18, "arabic": "ٱلْحَيَوٰةَ", "translit": "َẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 19, "arabic": "ٱلدُّنْيَآ", "translit": "ٓāَyْnُّdlٱ", "root": "دنو"}], "hasIhya": true}, {"ayah": 73, "text": "إِنَّآ ءَامَنَّا بِرَبِّنَا لِيَغْفِرَ لَنَا خَطَٰيَٰنَا وَمَآ أَكْرَهْتَنَا عَلَيْهِ مِنَ ٱلسِّحْرِۗ وَٱللَّهُ خَيْرٌ وَأَبْقَىٰٓ ", "translation": "Indeed, we have believed in our Lord that He may forgive us our sins and what you compelled us [to do] of magic. And Allāh is better and more enduring.\"[1]", "words": [{"id": 1, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 2, "arabic": "ءَامَنَّا", "translit": "āَّnَmāَء", "root": "امن"}, {"id": 3, "arabic": "بِرَبِّنَا", "translit": "āَnِّbَrِb", "root": "ربب"}, {"id": 4, "arabic": "لِيَغْفِرَ", "translit": "َrِfْغَyِl", "root": "غفر"}, {"id": 5, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 6, "arabic": "خَطَٰيَٰنَا", "translit": "āَnَٰyَٰṭَhk", "root": "خطا"}, {"id": 7, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 8, "arabic": "أَكْرَهْتَنَا", "translit": "āَnَtْhَrْkَaʾ", "root": "كره"}, {"id": 9, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 10, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 11, "arabic": "ٱلسِّحْرِ", "translit": "ِrْḥِّslٱ", "root": "سحر"}, {"id": 12, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 13, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 14, "arabic": "وَأَبْقَىٰٓ", "translit": "ٰٓàَqْbَaʾَw", "root": "بقي"}], "hasIhya": false}, {"ayah": 74, "text": "إِنَّهُۥ مَن يَأْتِ رَبَّهُۥ مُجْرِمًا فَإِنَّ لَهُۥ جَهَنَّمَ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ ", "translation": "Indeed, whoever comes to his Lord as a criminal - indeed, for him is Hell; he will neither die therein nor live.", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "يَأْتِ", "translit": "ِtْaʾَy", "root": "اتي"}, {"id": 4, "arabic": "رَبَّهُۥ", "translit": "ۥُhَّbَr", "root": "ربب"}, {"id": 5, "arabic": "مُجْرِمًا", "translit": "āًmِrْjgُm", "root": "جرم"}, {"id": 6, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 7, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 8, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "يَمُوتُ", "translit": "ُtwُmَy", "root": "موت"}, {"id": 11, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "يَحْيَىٰ", "translit": "ٰàَyْḥَy", "root": "حيي"}], "hasIhya": false}, {"ayah": 75, "text": "وَمَن يَأْتِهِۦ مُؤْمِنًا قَدْ عَمِلَ ٱلصَّٰلِحَٰتِ فَأُو۟لَٰٓئِكَ لَهُمُ ٱلدَّرَجَٰتُ ٱلْعُلَىٰ ", "translation": "But whoever comes to Him as a believer having done righteous deeds - for those will be the highest degrees [in position]:", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يَأْتِهِۦ", "translit": "ۦِhِtْaʾَy", "root": "اتي"}, {"id": 3, "arabic": "مُؤْمِنًا", "translit": "āًnِmْwʾُm", "root": "امن"}, {"id": 4, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 5, "arabic": "عَمِلَ", "translit": "َlِmَʿع", "root": "عمل"}, {"id": 6, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 7, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 8, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 9, "arabic": "ٱلدَّرَجَٰتُ", "translit": "ُtَٰjgَrَّdlٱ", "root": "درج"}, {"id": 10, "arabic": "ٱلْعُلَىٰ", "translit": "ٰàَlُʿعْlٱ", "root": "علو"}], "hasIhya": false}, {"ayah": 76, "text": "جَنَّٰتُ عَدْنٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَاۚ وَذَٰلِكَ جَزَآءُ مَن تَزَكَّىٰ ", "translation": "Gardens of perpetual residence beneath which rivers flow, wherein they abide eternally. And that is the reward of one who purifies himself.[1]", "words": [{"id": 1, "arabic": "جَنَّٰتُ", "translit": "ُtَّٰnَjg", "root": "جنن"}, {"id": 2, "arabic": "عَدْنٍ", "translit": "ٍnْdَʿع", "root": ""}, {"id": 3, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 6, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 7, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 8, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 9, "arabic": "وَذَٰلِكَ", "translit": "َkِlَٰhdَw", "root": ""}, {"id": 10, "arabic": "جَزَآءُ", "translit": "ُءٓāَzَjg", "root": "جزي"}, {"id": 11, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 12, "arabic": "تَزَكَّىٰ", "translit": "ٰàَّkَzَt", "root": "زكو"}], "hasIhya": false}, {"ayah": 77, "text": "وَلَقَدْ أَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ أَنْ أَسْرِ بِعِبَادِى فَٱضْرِبْ لَهُمْ طَرِيقًا فِى ٱلْبَحْرِ يَبَسًا لَّا تَخَٰفُ دَرَكًا وَلَا تَخْشَىٰ ", "translation": "And We had inspired to Moses, \"Travel by night with My servants and strike for them a dry path through the sea; you will not fear being overtaken [by Pharaoh] nor be afraid [of drowning].\"", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "أَوْحَيْنَآ", "translit": "ٓāَnْyَḥْwَaʾ", "root": "وحي"}, {"id": 3, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 4, "arabic": "مُوسَىٰٓ", "translit": "ٰٓàَswُm", "root": ""}, {"id": 5, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 6, "arabic": "أَسْرِ", "translit": "ِrْsَaʾ", "root": "سري"}, {"id": 7, "arabic": "بِعِبَادِى", "translit": "àِdāَbِʿعِb", "root": "عبد"}, {"id": 8, "arabic": "فَٱضْرِبْ", "translit": "ْbِrْḍٱَf", "root": "ضرب"}, {"id": 9, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 10, "arabic": "طَرِيقًا", "translit": "āًqyِrَṭ", "root": "طرق"}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ٱلْبَحْرِ", "translit": "ِrْḥَbْlٱ", "root": "بحر"}, {"id": 13, "arabic": "يَبَسًا", "translit": "āًsَbَy", "root": "يبس"}, {"id": 14, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 15, "arabic": "تَخَٰفُ", "translit": "ُfَٰhkَt", "root": "خوف"}, {"id": 16, "arabic": "دَرَكًا", "translit": "āًkَrَd", "root": "درك"}, {"id": 17, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 18, "arabic": "تَخْشَىٰ", "translit": "ٰàَhsْhkَt", "root": "خشي"}], "hasIhya": false}, {"ayah": 78, "text": "فَأَتْبَعَهُمْ فِرْعَوْنُ بِجُنُودِهِۦ فَغَشِيَهُم مِّنَ ٱلْيَمِّ مَا غَشِيَهُمْ ", "translation": "So Pharaoh pursued them with his soldiers, and there covered them from the sea that which covered them,[1]", "words": [{"id": 1, "arabic": "فَأَتْبَعَهُمْ", "translit": "ْmُhَʿعَbْtَaʾَf", "root": "تبع"}, {"id": 2, "arabic": "فِرْعَوْنُ", "translit": "ُnْwَʿعْrِf", "root": ""}, {"id": 3, "arabic": "بِجُنُودِهِۦ", "translit": "ۦِhِdwُnُjgِb", "root": "جند"}, {"id": 4, "arabic": "فَغَشِيَهُم", "translit": "mُhَyِhsَغَf", "root": "غشو"}, {"id": 5, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 6, "arabic": "ٱلْيَمِّ", "translit": "ِّmَyْlٱ", "root": "يمم"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "غَشِيَهُمْ", "translit": "ْmُhَyِhsَغ", "root": "غشو"}], "hasIhya": false}, {"ayah": 79, "text": "وَأَضَلَّ فِرْعَوْنُ قَوْمَهُۥ وَمَا هَدَىٰ ", "translation": "And Pharaoh led his people astray and did not guide [them].", "words": [{"id": 1, "arabic": "وَأَضَلَّ", "translit": "َّlَḍَaʾَw", "root": "ضلل"}, {"id": 2, "arabic": "فِرْعَوْنُ", "translit": "ُnْwَʿعْrِf", "root": ""}, {"id": 3, "arabic": "قَوْمَهُۥ", "translit": "ۥُhَmْwَq", "root": "قوم"}, {"id": 4, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 5, "arabic": "هَدَىٰ", "translit": "ٰàَdَh", "root": "هدي"}], "hasIhya": false}, {"ayah": 80, "text": "يَٰبَنِىٓ إِسْرَٰٓءِيلَ قَدْ أَنجَيْنَٰكُم مِّنْ عَدُوِّكُمْ وَوَٰعَدْنَٰكُمْ جَانِبَ ٱلطُّورِ ٱلْأَيْمَنَ وَنَزَّلْنَا عَلَيْكُمُ ٱلْمَنَّ وَٱلسَّلْوَىٰ ", "translation": "O Children of Israel, We delivered you from your enemy, and We made an appointment with you[1] at the right side of the mount, and We sent down to you manna and quails,", "words": [{"id": 1, "arabic": "يَٰبَنِىٓ", "translit": "ٓàِnَbَٰy", "root": "بني"}, {"id": 2, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 3, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 4, "arabic": "أَنجَيْنَٰكُم", "translit": "mُkَٰnْyَjgnَaʾ", "root": "نجو"}, {"id": 5, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 6, "arabic": "عَدُوِّكُمْ", "translit": "ْmُkِّwُdَʿع", "root": "عدو"}, {"id": 7, "arabic": "وَوَٰعَدْنَٰكُمْ", "translit": "ْmُkَٰnْdَʿعَٰwَw", "root": "وعد"}, {"id": 8, "arabic": "جَانِبَ", "translit": "َbِnāَjg", "root": "جنب"}, {"id": 9, "arabic": "ٱلطُّورِ", "translit": "ِrwُّṭlٱ", "root": "طور"}, {"id": 10, "arabic": "ٱلْأَيْمَنَ", "translit": "َnَmْyَaʾْlٱ", "root": "يمن"}, {"id": 11, "arabic": "وَنَزَّلْنَا", "translit": "āَnْlَّzَnَw", "root": "نزل"}, {"id": 12, "arabic": "عَلَيْكُمُ", "translit": "ُmُkْyَlَʿع", "root": ""}, {"id": 13, "arabic": "ٱلْمَنَّ", "translit": "َّnَmْlٱ", "root": "منن"}, {"id": 14, "arabic": "وَٱلسَّلْوَىٰ", "translit": "ٰàَwْlَّslٱَw", "root": "سلو"}], "hasIhya": false}, {"ayah": 81, "text": "كُلُوا۟ مِن طَيِّبَٰتِ مَا رَزَقْنَٰكُمْ وَلَا تَطْغَوْا۟ فِيهِ فَيَحِلَّ عَلَيْكُمْ غَضَبِىۖ وَمَن يَحْلِلْ عَلَيْهِ غَضَبِى فَقَدْ هَوَىٰ ", "translation": "[Saying], \"Eat from the good things with which We have provided you and do not transgress [or oppress others] therein, lest My anger should descend upon you. And he upon whom My anger descends has certainly fallen [i.e., perished].\"", "words": [{"id": 1, "arabic": "كُلُوا۟", "translit": "۟āwُlُk", "root": "اكل"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "طَيِّبَٰتِ", "translit": "ِtَٰbِّyَṭ", "root": "طيب"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "رَزَقْنَٰكُمْ", "translit": "ْmُkَٰnْqَzَr", "root": "رزق"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "تَطْغَوْا۟", "translit": "۟āْwَغْṭَt", "root": "طغي"}, {"id": 8, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 9, "arabic": "فَيَحِلَّ", "translit": "َّlِḥَyَf", "root": "حلل"}, {"id": 10, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 11, "arabic": "غَضَبِى", "translit": "àِbَḍَغ", "root": "غضب"}, {"id": 12, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 13, "arabic": "يَحْلِلْ", "translit": "ْlِlْḥَy", "root": "حلل"}, {"id": 14, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 15, "arabic": "غَضَبِى", "translit": "àِbَḍَغ", "root": "غضب"}, {"id": 16, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 17, "arabic": "هَوَىٰ", "translit": "ٰàَwَh", "root": "هوي"}], "hasIhya": false}, {"ayah": 82, "text": "وَإِنِّى لَغَفَّارٌ لِّمَن تَابَ وَءَامَنَ وَعَمِلَ صَٰلِحًا ثُمَّ ٱهْتَدَىٰ ", "translation": "But indeed, I am the Perpetual Forgiver of whoever repents and believes and does righteousness and then continues in guidance.", "words": [{"id": 1, "arabic": "وَإِنِّى", "translit": "àِّnِiʾَw", "root": ""}, {"id": 2, "arabic": "لَغَفَّارٌ", "translit": "ٌrāَّfَغَl", "root": "غفر"}, {"id": 3, "arabic": "لِّمَن", "translit": "nَmِّl", "root": ""}, {"id": 4, "arabic": "تَابَ", "translit": "َbāَt", "root": "توب"}, {"id": 5, "arabic": "وَءَامَنَ", "translit": "َnَmāَءَw", "root": "امن"}, {"id": 6, "arabic": "وَعَمِلَ", "translit": "َlِmَʿعَw", "root": "عمل"}, {"id": 7, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 8, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 9, "arabic": "ٱهْتَدَىٰ", "translit": "ٰàَdَtْhٱ", "root": "هدي"}], "hasIhya": true}, {"ayah": 83, "text": "وَمَآ أَعْجَلَكَ عَن قَوْمِكَ يَٰمُوسَىٰ ", "translation": "[Allāh said], \"And what made you hasten from your people, O Moses?\"", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَعْجَلَكَ", "translit": "َkَlَjgْʿعَaʾ", "root": "عجل"}, {"id": 3, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 4, "arabic": "قَوْمِكَ", "translit": "َkِmْwَq", "root": "قوم"}, {"id": 5, "arabic": "يَٰمُوسَىٰ", "translit": "ٰàَswُmَٰy", "root": ""}], "hasIhya": false}, {"ayah": 84, "text": "قَالَ هُمْ أُو۟لَآءِ عَلَىٰٓ أَثَرِى وَعَجِلْتُ إِلَيْكَ رَبِّ لِتَرْضَىٰ ", "translation": "He said, \"They are close upon my tracks, and I hastened to You, my Lord, that You be pleased.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 3, "arabic": "أُو۟لَآءِ", "translit": "ِءٓāَl۟wُaʾ", "root": ""}, {"id": 4, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 5, "arabic": "أَثَرِى", "translit": "àِrَhtَaʾ", "root": "اثر"}, {"id": 6, "arabic": "وَعَجِلْتُ", "translit": "ُtْlِjgَʿعَw", "root": "عجل"}, {"id": 7, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 8, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 9, "arabic": "لِتَرْضَىٰ", "translit": "ٰàَḍْrَtِl", "root": "رضو"}], "hasIhya": false}, {"ayah": 85, "text": "قَالَ فَإِنَّا قَدْ فَتَنَّا قَوْمَكَ مِنۢ بَعْدِكَ وَأَضَلَّهُمُ ٱلسَّامِرِىُّ ", "translation": "[Allāh] said, \"But indeed, We have tried your people after you [departed], and the Sāmirī[1] has led them astray.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "فَإِنَّا", "translit": "āَّnِiʾَf", "root": ""}, {"id": 3, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 4, "arabic": "فَتَنَّا", "translit": "āَّnَtَf", "root": "فتن"}, {"id": 5, "arabic": "قَوْمَكَ", "translit": "َkَmْwَq", "root": "قوم"}, {"id": 6, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 7, "arabic": "بَعْدِكَ", "translit": "َkِdْʿعَb", "root": "بعد"}, {"id": 8, "arabic": "وَأَضَلَّهُمُ", "translit": "ُmُhَّlَḍَaʾَw", "root": "ضلل"}, {"id": 9, "arabic": "ٱلسَّامِرِىُّ", "translit": "ُّàِrِmāَّslٱ", "root": "سمر"}], "hasIhya": false}, {"ayah": 86, "text": "فَرَجَعَ مُوسَىٰٓ إِلَىٰ قَوْمِهِۦ غَضْبَٰنَ أَسِفًاۚ قَالَ يَٰقَوْمِ أَلَمْ يَعِدْكُمْ رَبُّكُمْ وَعْدًا حَسَنًاۚ أَفَطَالَ عَلَيْكُمُ ٱلْعَهْدُ أَمْ أَرَدتُّمْ أَن يَحِلَّ عَلَيْكُمْ غَضَبٌ مِّن رَّبِّكُمْ فَأَخْلَفْتُم مَّوْعِدِى ", "translation": "So Moses returned to his people, angry and grieved.[1] He said, \"O my people, did your Lord not make you a good promise?[2] Then, was the time [of its fulfillment] too long for you, or did you wish that wrath from your Lord descend upon you, so you broke your promise [of obedience] to me?\"", "words": [{"id": 1, "arabic": "فَرَجَعَ", "translit": "َʿعَjgَrَf", "root": "رجع"}, {"id": 2, "arabic": "مُوسَىٰٓ", "translit": "ٰٓàَswُm", "root": ""}, {"id": 3, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 4, "arabic": "قَوْمِهِۦ", "translit": "ۦِhِmْwَq", "root": "قوم"}, {"id": 5, "arabic": "غَضْبَٰنَ", "translit": "َnَٰbْḍَغ", "root": "غضب"}, {"id": 6, "arabic": "أَسِفًا", "translit": "āًfِsَaʾ", "root": "اسف"}, {"id": 7, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 8, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 9, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 10, "arabic": "يَعِدْكُمْ", "translit": "ْmُkْdِʿعَy", "root": "وعد"}, {"id": 11, "arabic": "رَبُّكُمْ", "translit": "ْmُkُّbَr", "root": "ربب"}, {"id": 12, "arabic": "وَعْدًا", "translit": "āًdْʿعَw", "root": "وعد"}, {"id": 13, "arabic": "حَسَنًا", "translit": "āًnَsَḥ", "root": "حسن"}, {"id": 14, "arabic": "أَفَطَالَ", "translit": "َlāَṭَfَaʾ", "root": "طول"}, {"id": 15, "arabic": "عَلَيْكُمُ", "translit": "ُmُkْyَlَʿع", "root": ""}, {"id": 16, "arabic": "ٱلْعَهْدُ", "translit": "ُdْhَʿعْlٱ", "root": "عهد"}, {"id": 17, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 18, "arabic": "أَرَدتُّمْ", "translit": "ْmُّtdَrَaʾ", "root": "رود"}, {"id": 19, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 20, "arabic": "يَحِلَّ", "translit": "َّlِḥَy", "root": "حلل"}, {"id": 21, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 22, "arabic": "غَضَبٌ", "translit": "ٌbَḍَغ", "root": "غضب"}, {"id": 23, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 24, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 25, "arabic": "فَأَخْلَفْتُم", "translit": "mُtْfَlْhkَaʾَf", "root": "خلف"}, {"id": 26, "arabic": "مَّوْعِدِى", "translit": "àِdِʿعْwَّm", "root": "وعد"}], "hasIhya": false}, {"ayah": 87, "text": "قَالُوا۟ مَآ أَخْلَفْنَا مَوْعِدَكَ بِمَلْكِنَا وَلَٰكِنَّا حُمِّلْنَآ أَوْزَارًا مِّن زِينَةِ ٱلْقَوْمِ فَقَذَفْنَٰهَا فَكَذَٰلِكَ أَلْقَى ٱلسَّامِرِىُّ ", "translation": "They said, \"We did not break our promise to you by our will, but we were made to carry burdens from the ornaments of the people [of Pharaoh], so we threw them [into the fire], and thus did the Sāmirī throw.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 3, "arabic": "أَخْلَفْنَا", "translit": "āَnْfَlْhkَaʾ", "root": "خلف"}, {"id": 4, "arabic": "مَوْعِدَكَ", "translit": "َkَdِʿعْwَm", "root": "وعد"}, {"id": 5, "arabic": "بِمَلْكِنَا", "translit": "āَnِkْlَmِb", "root": "ملك"}, {"id": 6, "arabic": "وَلَٰكِنَّا", "translit": "āَّnِkَٰlَw", "root": ""}, {"id": 7, "arabic": "حُمِّلْنَآ", "translit": "ٓāَnْlِّmُḥ", "root": "حمل"}, {"id": 8, "arabic": "أَوْزَارًا", "translit": "āًrāَzْwَaʾ", "root": "وزر"}, {"id": 9, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 10, "arabic": "زِينَةِ", "translit": "ِẗَnyِz", "root": "زين"}, {"id": 11, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 12, "arabic": "فَقَذَفْنَٰهَا", "translit": "āَhَٰnْfَhdَqَf", "root": "قذف"}, {"id": 13, "arabic": "فَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَf", "root": ""}, {"id": 14, "arabic": "أَلْقَى", "translit": "àَqْlَaʾ", "root": "لقي"}, {"id": 15, "arabic": "ٱلسَّامِرِىُّ", "translit": "ُّàِrِmāَّslٱ", "root": "سمر"}], "hasIhya": false}, {"ayah": 88, "text": "فَأَخْرَجَ لَهُمْ عِجْلًا جَسَدًا لَّهُۥ خُوَارٌ فَقَالُوا۟ هَٰذَآ إِلَٰهُكُمْ وَإِلَٰهُ مُوسَىٰ فَنَسِىَ ", "translation": "And he extracted for them [the statue of] a calf which had a lowing sound, and they said, \"This is your god and the god of Moses, but he forgot.\"", "words": [{"id": 1, "arabic": "فَأَخْرَجَ", "translit": "َjgَrْhkَaʾَf", "root": "خرج"}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "عِجْلًا", "translit": "āًlْjgِʿع", "root": "عجل"}, {"id": 4, "arabic": "جَسَدًا", "translit": "āًdَsَjg", "root": "جسد"}, {"id": 5, "arabic": "لَّهُۥ", "translit": "ۥُhَّl", "root": ""}, {"id": 6, "arabic": "خُوَارٌ", "translit": "ٌrāَwُhk", "root": "خور"}, {"id": 7, "arabic": "فَقَالُوا۟", "translit": "۟āwُlāَqَf", "root": "قول"}, {"id": 8, "arabic": "هَٰذَآ", "translit": "ٓāَhdَٰh", "root": ""}, {"id": 9, "arabic": "إِلَٰهُكُمْ", "translit": "ْmُkُhَٰlِiʾ", "root": "اله"}, {"id": 10, "arabic": "وَإِلَٰهُ", "translit": "ُhَٰlِiʾَw", "root": "اله"}, {"id": 11, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 12, "arabic": "فَنَسِىَ", "translit": "َàِsَnَf", "root": "نسي"}], "hasIhya": true}, {"ayah": 89, "text": "أَفَلَا يَرَوْنَ أَلَّا يَرْجِعُ إِلَيْهِمْ قَوْلًا وَلَا يَمْلِكُ لَهُمْ ضَرًّا وَلَا نَفْعًا ", "translation": "Did they not see that it could not return to them any speech [i.e., response] and that it did not possess for them any harm or benefit?", "words": [{"id": 1, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 2, "arabic": "يَرَوْنَ", "translit": "َnْwَrَy", "root": "راي"}, {"id": 3, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 4, "arabic": "يَرْجِعُ", "translit": "ُʿعِjgْrَy", "root": "رجع"}, {"id": 5, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 6, "arabic": "قَوْلًا", "translit": "āًlْwَq", "root": "قول"}, {"id": 7, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 8, "arabic": "يَمْلِكُ", "translit": "ُkِlْmَy", "root": "ملك"}, {"id": 9, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 10, "arabic": "ضَرًّا", "translit": "āًّrَḍ", "root": "ضرر"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "نَفْعًا", "translit": "āًʿعْfَn", "root": "نفع"}], "hasIhya": true}, {"ayah": 90, "text": "وَلَقَدْ قَالَ لَهُمْ هَٰرُونُ مِن قَبْلُ يَٰقَوْمِ إِنَّمَا فُتِنتُم بِهِۦۖ وَإِنَّ رَبَّكُمُ ٱلرَّحْمَٰنُ فَٱتَّبِعُونِى وَأَطِيعُوٓا۟ أَمْرِى ", "translation": "And Aaron had already told them before [the return of Moses], \"O my people, you are only being tested by it, and indeed, your Lord is the Most Merciful, so follow me and obey my order.\"", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 4, "arabic": "هَٰرُونُ", "translit": "ُnwُrَٰh", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 7, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 8, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 9, "arabic": "فُتِنتُم", "translit": "mُtnِtُf", "root": "فتن"}, {"id": 10, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 11, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 12, "arabic": "رَبَّكُمُ", "translit": "ُmُkَّbَr", "root": "ربب"}, {"id": 13, "arabic": "ٱلرَّحْمَٰنُ", "translit": "ُnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 14, "arabic": "فَٱتَّبِعُونِى", "translit": "àِnwُʿعِbَّtٱَf", "root": "تبع"}, {"id": 15, "arabic": "وَأَطِيعُوٓا۟", "translit": "۟āٓwُʿعyِṭَaʾَw", "root": "طوع"}, {"id": 16, "arabic": "أَمْرِى", "translit": "àِrْmَaʾ", "root": "امر"}], "hasIhya": false}, {"ayah": 91, "text": "قَالُوا۟ لَن نَّبْرَحَ عَلَيْهِ عَٰكِفِينَ حَتَّىٰ يَرْجِعَ إِلَيْنَا مُوسَىٰ ", "translation": "They said, \"We will never cease being devoted to it [i.e., the calf] until Moses returns to us.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 3, "arabic": "نَّبْرَحَ", "translit": "َḥَrْbَّn", "root": "برح"}, {"id": 4, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 5, "arabic": "عَٰكِفِينَ", "translit": "َnyِfِkَٰʿع", "root": "عكف"}, {"id": 6, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 7, "arabic": "يَرْجِعَ", "translit": "َʿعِjgْrَy", "root": "رجع"}, {"id": 8, "arabic": "إِلَيْنَا", "translit": "āَnْyَlِiʾ", "root": ""}, {"id": 9, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}], "hasIhya": false}, {"ayah": 92, "text": "قَالَ يَٰهَٰرُونُ مَا مَنَعَكَ إِذْ رَأَيْتَهُمْ ضَلُّوٓا۟ ", "translation": "[Moses] said, \"O Aaron, what prevented you, when you saw them going astray,", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰهَٰرُونُ", "translit": "ُnwُrَٰhَٰy", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "مَنَعَكَ", "translit": "َkَʿعَnَm", "root": "منع"}, {"id": 5, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 6, "arabic": "رَأَيْتَهُمْ", "translit": "ْmُhَtْyَaʾَr", "root": "راي"}, {"id": 7, "arabic": "ضَلُّوٓا۟", "translit": "۟āٓwُّlَḍ", "root": "ضلل"}], "hasIhya": false}, {"ayah": 93, "text": "أَلَّا تَتَّبِعَنِۖ أَفَعَصَيْتَ أَمْرِى ", "translation": "From following me? Then have you disobeyed my order?\"", "words": [{"id": 1, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 2, "arabic": "تَتَّبِعَنِ", "translit": "ِnَʿعِbَّtَt", "root": "تبع"}, {"id": 3, "arabic": "أَفَعَصَيْتَ", "translit": "َtْyَṣَʿعَfَaʾ", "root": "عصي"}, {"id": 4, "arabic": "أَمْرِى", "translit": "àِrْmَaʾ", "root": "امر"}], "hasIhya": false}, {"ayah": 94, "text": "قَالَ يَبْنَؤُمَّ لَا تَأْخُذْ بِلِحْيَتِى وَلَا بِرَأْسِىٓۖ إِنِّى خَشِيتُ أَن تَقُولَ فَرَّقْتَ بَيْنَ بَنِىٓ إِسْرَٰٓءِيلَ وَلَمْ تَرْقُبْ قَوْلِى ", "translation": "[Aaron] said, \"O son of my mother, do not seize [me] by my beard or by my head. Indeed, I feared that you would say, 'You caused division among the Children of Israel, and you did not observe [or await] my word.'\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "يَبْنَؤُمَّ", "translit": "َّmُwʾَnْbَy", "root": "امم"}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "تَأْخُذْ", "translit": "ْhdُhkْaʾَt", "root": "اخذ"}, {"id": 5, "arabic": "بِلِحْيَتِى", "translit": "àِtَyْḥِlِb", "root": "لحي"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "بِرَأْسِىٓ", "translit": "ٓàِsْaʾَrِb", "root": "راس"}, {"id": 8, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 9, "arabic": "خَشِيتُ", "translit": "ُtyِhsَhk", "root": "خشي"}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 11, "arabic": "تَقُولَ", "translit": "َlwُqَt", "root": "قول"}, {"id": 12, "arabic": "فَرَّقْتَ", "translit": "َtْqَّrَf", "root": "فرق"}, {"id": 13, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 14, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 15, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 16, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 17, "arabic": "تَرْقُبْ", "translit": "ْbُqْrَt", "root": "رقب"}, {"id": 18, "arabic": "قَوْلِى", "translit": "àِlْwَq", "root": "قول"}], "hasIhya": true}, {"ayah": 95, "text": "قَالَ فَمَا خَطْبُكَ يَٰسَٰمِرِىُّ ", "translation": "[Moses] said, \"And what is your case, O Sāmirī?\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 3, "arabic": "خَطْبُكَ", "translit": "َkُbْṭَhk", "root": "خطب"}, {"id": 4, "arabic": "يَٰسَٰمِرِىُّ", "translit": "ُّàِrِmَٰsَٰy", "root": "سمر"}], "hasIhya": false}, {"ayah": 96, "text": "قَالَ بَصُرْتُ بِمَا لَمْ يَبْصُرُوا۟ بِهِۦ فَقَبَضْتُ قَبْضَةً مِّنْ أَثَرِ ٱلرَّسُولِ فَنَبَذْتُهَا وَكَذَٰلِكَ سَوَّلَتْ لِى نَفْسِى ", "translation": "He said, \"I saw what they did not see, so I took a handful [of dust] from the track of the messenger[1] and threw it,[2] and thus did my soul entice me.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "بَصُرْتُ", "translit": "ُtْrُṣَb", "root": "بصر"}, {"id": 3, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 4, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 5, "arabic": "يَبْصُرُوا۟", "translit": "۟āwُrُṣْbَy", "root": "بصر"}, {"id": 6, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 7, "arabic": "فَقَبَضْتُ", "translit": "ُtْḍَbَqَf", "root": "قبض"}, {"id": 8, "arabic": "قَبْضَةً", "translit": "ًẗَḍْbَq", "root": "قبض"}, {"id": 9, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 10, "arabic": "أَثَرِ", "translit": "ِrَhtَaʾ", "root": "اثر"}, {"id": 11, "arabic": "ٱلرَّسُولِ", "translit": "ِlwُsَّrlٱ", "root": "رسل"}, {"id": 12, "arabic": "فَنَبَذْتُهَا", "translit": "āَhُtْhdَbَnَf", "root": "نبذ"}, {"id": 13, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 14, "arabic": "سَوَّلَتْ", "translit": "ْtَlَّwَs", "root": "سول"}, {"id": 15, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 16, "arabic": "نَفْسِى", "translit": "àِsْfَn", "root": "نفس"}], "hasIhya": false}, {"ayah": 97, "text": "قَالَ فَٱذْهَبْ فَإِنَّ لَكَ فِى ٱلْحَيَوٰةِ أَن تَقُولَ لَا مِسَاسَۖ وَإِنَّ لَكَ مَوْعِدًا لَّن تُخْلَفَهُۥۖ وَٱنظُرْ إِلَىٰٓ إِلَٰهِكَ ٱلَّذِى ظَلْتَ عَلَيْهِ عَاكِفًاۖ لَّنُحَرِّقَنَّهُۥ ثُمَّ لَنَنسِفَنَّهُۥ فِى ٱلْيَمِّ نَسْفًا ", "translation": "[Moses] said, \"Then go. And indeed, it is [decreed] for you in [this] life to say, 'No contact.'[1] And indeed, you have an appointment [in the Hereafter] you will not fail to keep. And look at your 'god' to which you remained devoted. We will surely burn it and blow it [i.e., its ashes] into the sea with a blast.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "فَٱذْهَبْ", "translit": "ْbَhْhdٱَf", "root": "ذهب"}, {"id": 3, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 4, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 7, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 8, "arabic": "تَقُولَ", "translit": "َlwُqَt", "root": "قول"}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "مِسَاسَ", "translit": "َsāَsِm", "root": "مسس"}, {"id": 11, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 12, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 13, "arabic": "مَوْعِدًا", "translit": "āًdِʿعْwَm", "root": "وعد"}, {"id": 14, "arabic": "لَّن", "translit": "nَّl", "root": ""}, {"id": 15, "arabic": "تُخْلَفَهُۥ", "translit": "ۥُhَfَlْhkُt", "root": "خلف"}, {"id": 16, "arabic": "وَٱنظُرْ", "translit": "ْrُẓnٱَw", "root": "نظر"}, {"id": 17, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 18, "arabic": "إِلَٰهِكَ", "translit": "َkِhَٰlِiʾ", "root": "اله"}, {"id": 19, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 20, "arabic": "ظَلْتَ", "translit": "َtْlَẓ", "root": "ظلل"}, {"id": 21, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 22, "arabic": "عَاكِفًا", "translit": "āًfِkāَʿع", "root": "عكف"}, {"id": 23, "arabic": "لَّنُحَرِّقَنَّهُۥ", "translit": "ۥُhَّnَqِّrَḥُnَّl", "root": "حرق"}, {"id": 24, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 25, "arabic": "لَنَنسِفَنَّهُۥ", "translit": "ۥُhَّnَfِsnَnَl", "root": "نسف"}, {"id": 26, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 27, "arabic": "ٱلْيَمِّ", "translit": "ِّmَyْlٱ", "root": "يمم"}, {"id": 28, "arabic": "نَسْفًا", "translit": "āًfْsَn", "root": "نسف"}], "hasIhya": false}, {"ayah": 98, "text": "إِنَّمَآ إِلَٰهُكُمُ ٱللَّهُ ٱلَّذِى لَآ إِلَٰهَ إِلَّا هُوَۚ وَسِعَ كُلَّ شَىْءٍ عِلْمًا ", "translation": "Your god is only Allāh, except for whom there is no deity. He has encompassed all things in knowledge.\"", "words": [{"id": 1, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "إِلَٰهُكُمُ", "translit": "ُmُkُhَٰlِiʾ", "root": "اله"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 6, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 7, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 8, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 9, "arabic": "وَسِعَ", "translit": "َʿعِsَw", "root": "وسع"}, {"id": 10, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 11, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 12, "arabic": "عِلْمًا", "translit": "āًmْlِʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 99, "text": "كَذَٰلِكَ نَقُصُّ عَلَيْكَ مِنْ أَنۢبَآءِ مَا قَدْ سَبَقَۚ وَقَدْ ءَاتَيْنَٰكَ مِن لَّدُنَّا ذِكْرًا ", "translation": "Thus, [O Muḥammad], We relate to you from the news of what has preceded. And We have certainly given you from Us a message [i.e., the Qur’ān].", "words": [{"id": 1, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 2, "arabic": "نَقُصُّ", "translit": "ُّṣُqَn", "root": "قصص"}, {"id": 3, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 4, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 5, "arabic": "أَنۢبَآءِ", "translit": "ِءٓāَbۢnَaʾ", "root": "نبا"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 8, "arabic": "سَبَقَ", "translit": "َqَbَs", "root": "سبق"}, {"id": 9, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 10, "arabic": "ءَاتَيْنَٰكَ", "translit": "َkَٰnْyَtāَء", "root": "اتي"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "لَّدُنَّا", "translit": "āَّnُdَّl", "root": "لدن"}, {"id": 13, "arabic": "ذِكْرًا", "translit": "āًrْkِhd", "root": "ذكر"}], "hasIhya": false}, {"ayah": 100, "text": "مَّنْ أَعْرَضَ عَنْهُ فَإِنَّهُۥ يَحْمِلُ يَوْمَ ٱلْقِيَٰمَةِ وِزْرًا ", "translation": "Whoever turns away from it - then indeed, he will bear on the Day of Resurrection a burden [i.e., great sin],", "words": [{"id": 1, "arabic": "مَّنْ", "translit": "ْnَّm", "root": ""}, {"id": 2, "arabic": "أَعْرَضَ", "translit": "َḍَrْʿعَaʾ", "root": "عرض"}, {"id": 3, "arabic": "عَنْهُ", "translit": "ُhْnَʿع", "root": ""}, {"id": 4, "arabic": "فَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَf", "root": ""}, {"id": 5, "arabic": "يَحْمِلُ", "translit": "ُlِmْḥَy", "root": "حمل"}, {"id": 6, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 7, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 8, "arabic": "وِزْرًا", "translit": "āًrْzِw", "root": "وزر"}], "hasIhya": false}, {"ayah": 101, "text": "خَٰلِدِينَ فِيهِۖ وَسَآءَ لَهُمْ يَوْمَ ٱلْقِيَٰمَةِ حِمْلًا ", "translation": "[Abiding] eternally therein,[1] and evil it is for them on the Day of Resurrection as a load -", "words": [{"id": 1, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 2, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 3, "arabic": "وَسَآءَ", "translit": "َءٓāَsَw", "root": "سوا"}, {"id": 4, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 5, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 6, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 7, "arabic": "حِمْلًا", "translit": "āًlْmِḥ", "root": "حمل"}], "hasIhya": false}, {"ayah": 102, "text": "يَوْمَ يُنفَخُ فِى ٱلصُّورِۚ وَنَحْشُرُ ٱلْمُجْرِمِينَ يَوْمَئِذٍ زُرْقًا ", "translation": "The Day the Horn will be blown. And We will gather the criminals, that Day, blue-eyed.[1]", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "يُنفَخُ", "translit": "ُhkَfnُy", "root": "نفخ"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلصُّورِ", "translit": "ِrwُّṣlٱ", "root": "صور"}, {"id": 5, "arabic": "وَنَحْشُرُ", "translit": "ُrُhsْḥَnَw", "root": "حشر"}, {"id": 6, "arabic": "ٱلْمُجْرِمِينَ", "translit": "َnyِmِrْjgُmْlٱ", "root": "جرم"}, {"id": 7, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 8, "arabic": "زُرْقًا", "translit": "āًqْrُz", "root": "زرق"}], "hasIhya": false}, {"ayah": 103, "text": "يَتَخَٰفَتُونَ بَيْنَهُمْ إِن لَّبِثْتُمْ إِلَّا عَشْرًا ", "translation": "They will murmur among themselves, \"You remained not but ten [days in the world].\"", "words": [{"id": 1, "arabic": "يَتَخَٰفَتُونَ", "translit": "َnwُtَfَٰhkَtَy", "root": "خفت"}, {"id": 2, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 3, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 4, "arabic": "لَّبِثْتُمْ", "translit": "ْmُtْhtِbَّl", "root": "لبث"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "عَشْرًا", "translit": "āًrْhsَʿع", "root": "عشر"}], "hasIhya": false}, {"ayah": 104, "text": "نَّحْنُ أَعْلَمُ بِمَا يَقُولُونَ إِذْ يَقُولُ أَمْثَلُهُمْ طَرِيقَةً إِن لَّبِثْتُمْ إِلَّا يَوْمًا ", "translation": "We are most knowing of what they say when the best of them in manner [i.e., wisdom or speech] will say, \"You remained not but one day.\"", "words": [{"id": 1, "arabic": "نَّحْنُ", "translit": "ُnْḥَّn", "root": ""}, {"id": 2, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 3, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 4, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 5, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 6, "arabic": "يَقُولُ", "translit": "ُlwُqَy", "root": "قول"}, {"id": 7, "arabic": "أَمْثَلُهُمْ", "translit": "ْmُhُlَhtْmَaʾ", "root": "مثل"}, {"id": 8, "arabic": "طَرِيقَةً", "translit": "ًẗَqyِrَṭ", "root": "طرق"}, {"id": 9, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 10, "arabic": "لَّبِثْتُمْ", "translit": "ْmُtْhtِbَّl", "root": "لبث"}, {"id": 11, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 12, "arabic": "يَوْمًا", "translit": "āًmْwَy", "root": "يوم"}], "hasIhya": false}, {"ayah": 105, "text": "وَيَسْـَٔلُونَكَ عَنِ ٱلْجِبَالِ فَقُلْ يَنسِفُهَا رَبِّى نَسْفًا ", "translation": "And they ask you about the mountains, so say, \"My Lord will blow them away with a blast.[1]", "words": [{"id": 1, "arabic": "وَيَسْـَٔلُونَكَ", "translit": "َkَnwُlَٔـْsَyَw", "root": "سال"}, {"id": 2, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 3, "arabic": "ٱلْجِبَالِ", "translit": "ِlāَbِjgْlٱ", "root": "جبل"}, {"id": 4, "arabic": "فَقُلْ", "translit": "ْlُqَf", "root": "قول"}, {"id": 5, "arabic": "يَنسِفُهَا", "translit": "āَhُfِsnَy", "root": "نسف"}, {"id": 6, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 7, "arabic": "نَسْفًا", "translit": "āًfْsَn", "root": "نسف"}], "hasIhya": false}, {"ayah": 106, "text": "فَيَذَرُهَا قَاعًا صَفْصَفًا ", "translation": "And He will leave it [i.e., the earth] a level plain;", "words": [{"id": 1, "arabic": "فَيَذَرُهَا", "translit": "āَhُrَhdَyَf", "root": "وذر"}, {"id": 2, "arabic": "قَاعًا", "translit": "āًʿعāَq", "root": "قوع"}, {"id": 3, "arabic": "صَفْصَفًا", "translit": "āًfَṣْfَṣ", "root": "صفصف"}], "hasIhya": false}, {"ayah": 107, "text": "لَّا تَرَىٰ فِيهَا عِوَجًا وَلَآ أَمْتًا ", "translation": "You will not see therein a depression or an elevation.\"", "words": [{"id": 1, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 2, "arabic": "تَرَىٰ", "translit": "ٰàَrَt", "root": "راي"}, {"id": 3, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 4, "arabic": "عِوَجًا", "translit": "āًjgَwِʿع", "root": "عوج"}, {"id": 5, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 6, "arabic": "أَمْتًا", "translit": "āًtْmَaʾ", "root": "امت"}], "hasIhya": true}, {"ayah": 108, "text": "يَوْمَئِذٍ يَتَّبِعُونَ ٱلدَّاعِىَ لَا عِوَجَ لَهُۥۖ وَخَشَعَتِ ٱلْأَصْوَاتُ لِلرَّحْمَٰنِ فَلَا تَسْمَعُ إِلَّا هَمْسًا ", "translation": "That Day, they [i.e., everyone] will follow [the call of] the Caller[1] [with] no deviation therefrom, and [all] voices will be stilled before the Most Merciful, so you will not hear except a whisper [of footsteps].", "words": [{"id": 1, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 2, "arabic": "يَتَّبِعُونَ", "translit": "َnwُʿعِbَّtَy", "root": "تبع"}, {"id": 3, "arabic": "ٱلدَّاعِىَ", "translit": "َàِʿعāَّdlٱ", "root": "دعو"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "عِوَجَ", "translit": "َjgَwِʿع", "root": "عوج"}, {"id": 6, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 7, "arabic": "وَخَشَعَتِ", "translit": "ِtَʿعَhsَhkَw", "root": "خشع"}, {"id": 8, "arabic": "ٱلْأَصْوَاتُ", "translit": "ُtāَwْṣَaʾْlٱ", "root": "صوت"}, {"id": 9, "arabic": "لِلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlِl", "root": "رحم"}, {"id": 10, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 11, "arabic": "تَسْمَعُ", "translit": "ُʿعَmْsَt", "root": "سمع"}, {"id": 12, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 13, "arabic": "هَمْسًا", "translit": "āًsْmَh", "root": "همس"}], "hasIhya": false}, {"ayah": 109, "text": "يَوْمَئِذٍ لَّا تَنفَعُ ٱلشَّفَٰعَةُ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَرَضِىَ لَهُۥ قَوْلًا ", "translation": "That Day, no intercession will benefit except [that of] one to whom the Most Merciful has given permission and has accepted his word.", "words": [{"id": 1, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 2, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 3, "arabic": "تَنفَعُ", "translit": "ُʿعَfnَt", "root": "نفع"}, {"id": 4, "arabic": "ٱلشَّفَٰعَةُ", "translit": "ُẗَʿعَٰfَّhslٱ", "root": "شفع"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 7, "arabic": "أَذِنَ", "translit": "َnِhdَaʾ", "root": "اذن"}, {"id": 8, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 9, "arabic": "ٱلرَّحْمَٰنُ", "translit": "ُnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 10, "arabic": "وَرَضِىَ", "translit": "َàِḍَrَw", "root": "رضو"}, {"id": 11, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 12, "arabic": "قَوْلًا", "translit": "āًlْwَq", "root": "قول"}], "hasIhya": true}, {"ayah": 110, "text": "يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَلَا يُحِيطُونَ بِهِۦ عِلْمًا ", "translation": "He [i.e., Allāh] knows what is [presently] before them and what will be after them,[1] but they do not encompass it [i.e., what He knows] in knowledge.", "words": [{"id": 1, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 4, "arabic": "أَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾ", "root": "يدي"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "خَلْفَهُمْ", "translit": "ْmُhَfْlَhk", "root": "خلف"}, {"id": 7, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 8, "arabic": "يُحِيطُونَ", "translit": "َnwُṭyِḥُy", "root": "حوط"}, {"id": 9, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 10, "arabic": "عِلْمًا", "translit": "āًmْlِʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 111, "text": "وَعَنَتِ ٱلْوُجُوهُ لِلْحَىِّ ٱلْقَيُّومِۖ وَقَدْ خَابَ مَنْ حَمَلَ ظُلْمًا ", "translation": "And [all] faces will be humbled before the Ever-Living, the Self-Sustaining.[1] And he will have failed who carries injustice.[2]", "words": [{"id": 1, "arabic": "وَعَنَتِ", "translit": "ِtَnَʿعَw", "root": "عنو"}, {"id": 2, "arabic": "ٱلْوُجُوهُ", "translit": "ُhwُjgُwْlٱ", "root": "وجه"}, {"id": 3, "arabic": "لِلْحَىِّ", "translit": "ِّàَḥْlِl", "root": "حيي"}, {"id": 4, "arabic": "ٱلْقَيُّومِ", "translit": "ِmwُّyَqْlٱ", "root": "قوم"}, {"id": 5, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 6, "arabic": "خَابَ", "translit": "َbāَhk", "root": "خيب"}, {"id": 7, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 8, "arabic": "حَمَلَ", "translit": "َlَmَḥ", "root": "حمل"}, {"id": 9, "arabic": "ظُلْمًا", "translit": "āًmْlُẓ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 112, "text": "وَمَن يَعْمَلْ مِنَ ٱلصَّٰلِحَٰتِ وَهُوَ مُؤْمِنٌ فَلَا يَخَافُ ظُلْمًا وَلَا هَضْمًا ", "translation": "But he who does of righteous deeds while he is a believer - he will neither fear injustice nor deprivation.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يَعْمَلْ", "translit": "ْlَmْʿعَy", "root": "عمل"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 5, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 6, "arabic": "مُؤْمِنٌ", "translit": "ٌnِmْwʾُm", "root": "امن"}, {"id": 7, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 8, "arabic": "يَخَافُ", "translit": "ُfāَhkَy", "root": "خوف"}, {"id": 9, "arabic": "ظُلْمًا", "translit": "āًmْlُẓ", "root": "ظلم"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "هَضْمًا", "translit": "āًmْḍَh", "root": "هضم"}], "hasIhya": false}, {"ayah": 113, "text": "وَكَذَٰلِكَ أَنزَلْنَٰهُ قُرْءَانًا عَرَبِيًّا وَصَرَّفْنَا فِيهِ مِنَ ٱلْوَعِيدِ لَعَلَّهُمْ يَتَّقُونَ أَوْ يُحْدِثُ لَهُمْ ذِكْرًا ", "translation": "And thus We have sent it down as an Arabic Qur’ān[1] and have diversified therein the warnings that perhaps they will avoid [sin] or it would cause them remembrance.", "words": [{"id": 1, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 2, "arabic": "أَنزَلْنَٰهُ", "translit": "ُhَٰnْlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "قُرْءَانًا", "translit": "āًnāَءْrُq", "root": "قرا"}, {"id": 4, "arabic": "عَرَبِيًّا", "translit": "āًّyِbَrَʿع", "root": "عرب"}, {"id": 5, "arabic": "وَصَرَّفْنَا", "translit": "āَnْfَّrَṣَw", "root": "صرف"}, {"id": 6, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 7, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 8, "arabic": "ٱلْوَعِيدِ", "translit": "ِdyِʿعَwْlٱ", "root": "وعد"}, {"id": 9, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 10, "arabic": "يَتَّقُونَ", "translit": "َnwُqَّtَy", "root": "وقي"}, {"id": 11, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 12, "arabic": "يُحْدِثُ", "translit": "ُhtِdْḥُy", "root": "حدث"}, {"id": 13, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 14, "arabic": "ذِكْرًا", "translit": "āًrْkِhd", "root": "ذكر"}], "hasIhya": true}, {"ayah": 114, "text": "فَتَعَٰلَى ٱللَّهُ ٱلْمَلِكُ ٱلْحَقُّۗ وَلَا تَعْجَلْ بِٱلْقُرْءَانِ مِن قَبْلِ أَن يُقْضَىٰٓ إِلَيْكَ وَحْيُهُۥۖ وَقُل رَّبِّ زِدْنِى عِلْمًا ", "translation": "So high [above all] is Allāh, the Sovereign,[1] the Truth.[2] And, [O Muḥammad], do not hasten with [recitation of] the Qur’ān before its revelation is completed to you, and say, \"My Lord, increase me in knowledge.\"", "words": [{"id": 1, "arabic": "فَتَعَٰلَى", "translit": "àَlَٰʿعَtَf", "root": "علو"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱلْمَلِكُ", "translit": "ُkِlَmْlٱ", "root": "ملك"}, {"id": 4, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "تَعْجَلْ", "translit": "ْlَjgْʿعَt", "root": "عجل"}, {"id": 7, "arabic": "بِٱلْقُرْءَانِ", "translit": "ِnāَءْrُqْlٱِb", "root": "قرا"}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "قَبْلِ", "translit": "ِlْbَq", "root": "قبل"}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 11, "arabic": "يُقْضَىٰٓ", "translit": "ٰٓàَḍْqُy", "root": "قضي"}, {"id": 12, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 13, "arabic": "وَحْيُهُۥ", "translit": "ۥُhُyْḥَw", "root": "وحي"}, {"id": 14, "arabic": "وَقُل", "translit": "lُqَw", "root": "قول"}, {"id": 15, "arabic": "رَّبِّ", "translit": "ِّbَّr", "root": "ربب"}, {"id": 16, "arabic": "زِدْنِى", "translit": "àِnْdِz", "root": "زيد"}, {"id": 17, "arabic": "عِلْمًا", "translit": "āًmْlِʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 115, "text": "وَلَقَدْ عَهِدْنَآ إِلَىٰٓ ءَادَمَ مِن قَبْلُ فَنَسِىَ وَلَمْ نَجِدْ لَهُۥ عَزْمًا ", "translation": "And We had already taken a promise from Adam before, but he forgot; and We found not in him determination.[1]", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "عَهِدْنَآ", "translit": "ٓāَnْdِhَʿع", "root": "عهد"}, {"id": 3, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 4, "arabic": "ءَادَمَ", "translit": "َmَdāَء", "root": "ادم"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 7, "arabic": "فَنَسِىَ", "translit": "َàِsَnَf", "root": "نسي"}, {"id": 8, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 9, "arabic": "نَجِدْ", "translit": "ْdِjgَn", "root": "وجد"}, {"id": 10, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 11, "arabic": "عَزْمًا", "translit": "āًmْzَʿع", "root": "عزم"}], "hasIhya": false}, {"ayah": 116, "text": "وَإِذْ قُلْنَا لِلْمَلَٰٓئِكَةِ ٱسْجُدُوا۟ لِءَادَمَ فَسَجَدُوٓا۟ إِلَّآ إِبْلِيسَ أَبَىٰ ", "translation": "And [mention] when We said to the angels, \"Prostrate to Adam,\" and they prostrated, except Iblees;[1] he refused.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قُلْنَا", "translit": "āَnْlُq", "root": "قول"}, {"id": 3, "arabic": "لِلْمَلَٰٓئِكَةِ", "translit": "ِẗَkِyʾَٰٓlَmْlِl", "root": "ملك"}, {"id": 4, "arabic": "ٱسْجُدُوا۟", "translit": "۟āwُdُjgْsٱ", "root": "سجد"}, {"id": 5, "arabic": "لِءَادَمَ", "translit": "َmَdāَءِl", "root": "ادم"}, {"id": 6, "arabic": "فَسَجَدُوٓا۟", "translit": "۟āٓwُdَjgَsَf", "root": "سجد"}, {"id": 7, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 8, "arabic": "إِبْلِيسَ", "translit": "َsyِlْbِiʾ", "root": ""}, {"id": 9, "arabic": "أَبَىٰ", "translit": "ٰàَbَaʾ", "root": "ابي"}], "hasIhya": true}, {"ayah": 117, "text": "فَقُلْنَا يَٰٓـَٔادَمُ إِنَّ هَٰذَا عَدُوٌّ لَّكَ وَلِزَوْجِكَ فَلَا يُخْرِجَنَّكُمَا مِنَ ٱلْجَنَّةِ فَتَشْقَىٰٓ ", "translation": "So We said, \"O Adam, indeed this is an enemy to you and to your wife. Then let him not remove you from Paradise so you would suffer.", "words": [{"id": 1, "arabic": "فَقُلْنَا", "translit": "āَnْlُqَf", "root": "قول"}, {"id": 2, "arabic": "يَٰٓـَٔادَمُ", "translit": "ُmَdāَٔـَٰٓy", "root": "ادم"}, {"id": 3, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 4, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 5, "arabic": "عَدُوٌّ", "translit": "ٌّwُdَʿع", "root": "عدو"}, {"id": 6, "arabic": "لَّكَ", "translit": "َkَّl", "root": ""}, {"id": 7, "arabic": "وَلِزَوْجِكَ", "translit": "َkِjgْwَzِlَw", "root": "زوج"}, {"id": 8, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 9, "arabic": "يُخْرِجَنَّكُمَا", "translit": "āَmُkَّnَjgِrْhkُy", "root": "خرج"}, {"id": 10, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 11, "arabic": "ٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱ", "root": "جنن"}, {"id": 12, "arabic": "فَتَشْقَىٰٓ", "translit": "ٰٓàَqْhsَtَf", "root": "شقو"}], "hasIhya": true}, {"ayah": 118, "text": "إِنَّ لَكَ أَلَّا تَجُوعَ فِيهَا وَلَا تَعْرَىٰ ", "translation": "Indeed, it is [promised] for you not to be hungry therein or be unclothed.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 3, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 4, "arabic": "تَجُوعَ", "translit": "َʿعwُjgَt", "root": "جوع"}, {"id": 5, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "تَعْرَىٰ", "translit": "ٰàَrْʿعَt", "root": "عري"}], "hasIhya": true}, {"ayah": 119, "text": "وَأَنَّكَ لَا تَظْمَؤُا۟ فِيهَا وَلَا تَضْحَىٰ ", "translation": "And indeed, you will not be thirsty therein or be hot from the sun.\"", "words": [{"id": 1, "arabic": "وَأَنَّكَ", "translit": "َkَّnَaʾَw", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "تَظْمَؤُا۟", "translit": "۟āُwʾَmْẓَt", "root": "ظما"}, {"id": 4, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "تَضْحَىٰ", "translit": "ٰàَḥْḍَt", "root": "ضحو"}], "hasIhya": false}, {"ayah": 120, "text": "فَوَسْوَسَ إِلَيْهِ ٱلشَّيْطَٰنُ قَالَ يَٰٓـَٔادَمُ هَلْ أَدُلُّكَ عَلَىٰ شَجَرَةِ ٱلْخُلْدِ وَمُلْكٍ لَّا يَبْلَىٰ ", "translation": "Then Satan whispered to him; he said, \"O Adam, shall I direct you to the tree of eternity and possession that will not deteriorate?\"", "words": [{"id": 1, "arabic": "فَوَسْوَسَ", "translit": "َsَwْsَwَf", "root": "وسوس"}, {"id": 2, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 3, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 4, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 5, "arabic": "يَٰٓـَٔادَمُ", "translit": "ُmَdāَٔـَٰٓy", "root": "ادم"}, {"id": 6, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 7, "arabic": "أَدُلُّكَ", "translit": "َkُّlُdَaʾ", "root": "دلل"}, {"id": 8, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 9, "arabic": "شَجَرَةِ", "translit": "ِẗَrَjgَhs", "root": "شجر"}, {"id": 10, "arabic": "ٱلْخُلْدِ", "translit": "ِdْlُhkْlٱ", "root": "خلد"}, {"id": 11, "arabic": "وَمُلْكٍ", "translit": "ٍkْlُmَw", "root": "ملك"}, {"id": 12, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 13, "arabic": "يَبْلَىٰ", "translit": "ٰàَlْbَy", "root": "بلو"}], "hasIhya": false}, {"ayah": 121, "text": "فَأَكَلَا مِنْهَا فَبَدَتْ لَهُمَا سَوْءَٰتُهُمَا وَطَفِقَا يَخْصِفَانِ عَلَيْهِمَا مِن وَرَقِ ٱلْجَنَّةِۚ وَعَصَىٰٓ ءَادَمُ رَبَّهُۥ فَغَوَىٰ ", "translation": "And they [i.e., Adam and his wife] ate of it, and their private parts became apparent to them, and they began to fasten over themselves from the leaves of Paradise. And Adam disobeyed his Lord and erred.", "words": [{"id": 1, "arabic": "فَأَكَلَا", "translit": "āَlَkَaʾَf", "root": "اكل"}, {"id": 2, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 3, "arabic": "فَبَدَتْ", "translit": "ْtَdَbَf", "root": "بدو"}, {"id": 4, "arabic": "لَهُمَا", "translit": "āَmُhَl", "root": ""}, {"id": 5, "arabic": "سَوْءَٰتُهُمَا", "translit": "āَmُhُtَٰءْwَs", "root": "سوا"}, {"id": 6, "arabic": "وَطَفِقَا", "translit": "āَqِfَṭَw", "root": "طفق"}, {"id": 7, "arabic": "يَخْصِفَانِ", "translit": "ِnāَfِṣْhkَy", "root": "خصف"}, {"id": 8, "arabic": "عَلَيْهِمَا", "translit": "āَmِhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "وَرَقِ", "translit": "ِqَrَw", "root": "ورق"}, {"id": 11, "arabic": "ٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱ", "root": "جنن"}, {"id": 12, "arabic": "وَعَصَىٰٓ", "translit": "ٰٓàَṣَʿعَw", "root": "عصي"}, {"id": 13, "arabic": "ءَادَمُ", "translit": "ُmَdāَء", "root": "ادم"}, {"id": 14, "arabic": "رَبَّهُۥ", "translit": "ۥُhَّbَr", "root": "ربب"}, {"id": 15, "arabic": "فَغَوَىٰ", "translit": "ٰàَwَغَf", "root": "غوي"}], "hasIhya": true}, {"ayah": 122, "text": "ثُمَّ ٱجْتَبَٰهُ رَبُّهُۥ فَتَابَ عَلَيْهِ وَهَدَىٰ ", "translation": "Then his Lord chose him and turned to him in forgiveness and guided [him].", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "ٱجْتَبَٰهُ", "translit": "ُhَٰbَtْjgٱ", "root": "جبي"}, {"id": 3, "arabic": "رَبُّهُۥ", "translit": "ۥُhُّbَr", "root": "ربب"}, {"id": 4, "arabic": "فَتَابَ", "translit": "َbāَtَf", "root": "توب"}, {"id": 5, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 6, "arabic": "وَهَدَىٰ", "translit": "ٰàَdَhَw", "root": "هدي"}], "hasIhya": false}, {"ayah": 123, "text": "قَالَ ٱهْبِطَا مِنْهَا جَمِيعًۢاۖ بَعْضُكُمْ لِبَعْضٍ عَدُوٌّۖ فَإِمَّا يَأْتِيَنَّكُم مِّنِّى هُدًى فَمَنِ ٱتَّبَعَ هُدَاىَ فَلَا يَضِلُّ وَلَا يَشْقَىٰ ", "translation": "[Allāh] said, \"Descend from it [i.e., Paradise] - all, [your descendants] being enemies to one another. And if there should come to you guidance from Me - then whoever follows My guidance will neither go astray [in the world] nor suffer [in the Hereafter].", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱهْبِطَا", "translit": "āَṭِbْhٱ", "root": "هبط"}, {"id": 3, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 4, "arabic": "جَمِيعًۢا", "translit": "āًۢʿعyِmَjg", "root": "جمع"}, {"id": 5, "arabic": "بَعْضُكُمْ", "translit": "ْmُkُḍْʿعَb", "root": "بعض"}, {"id": 6, "arabic": "لِبَعْضٍ", "translit": "ٍḍْʿعَbِl", "root": "بعض"}, {"id": 7, "arabic": "عَدُوٌّ", "translit": "ٌّwُdَʿع", "root": "عدو"}, {"id": 8, "arabic": "فَإِمَّا", "translit": "āَّmِiʾَf", "root": ""}, {"id": 9, "arabic": "يَأْتِيَنَّكُم", "translit": "mُkَّnَyِtْaʾَy", "root": "اتي"}, {"id": 10, "arabic": "مِّنِّى", "translit": "àِّnِّm", "root": ""}, {"id": 11, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 12, "arabic": "فَمَنِ", "translit": "ِnَmَf", "root": ""}, {"id": 13, "arabic": "ٱتَّبَعَ", "translit": "َʿعَbَّtٱ", "root": "تبع"}, {"id": 14, "arabic": "هُدَاىَ", "translit": "َàāَdُh", "root": "هدي"}, {"id": 15, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 16, "arabic": "يَضِلُّ", "translit": "ُّlِḍَy", "root": "ضلل"}, {"id": 17, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 18, "arabic": "يَشْقَىٰ", "translit": "ٰàَqْhsَy", "root": "شقو"}], "hasIhya": false}, {"ayah": 124, "text": "وَمَنْ أَعْرَضَ عَن ذِكْرِى فَإِنَّ لَهُۥ مَعِيشَةً ضَنكًا وَنَحْشُرُهُۥ يَوْمَ ٱلْقِيَٰمَةِ أَعْمَىٰ ", "translation": "And whoever turns away from My remembrance - indeed, he will have a depressed [i.e., difficult] life, and We will gather [i.e., raise] him on the Day of Resurrection blind.\"", "words": [{"id": 1, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 2, "arabic": "أَعْرَضَ", "translit": "َḍَrْʿعَaʾ", "root": "عرض"}, {"id": 3, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 4, "arabic": "ذِكْرِى", "translit": "àِrْkِhd", "root": "ذكر"}, {"id": 5, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 6, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 7, "arabic": "مَعِيشَةً", "translit": "ًẗَhsyِʿعَm", "root": "عيش"}, {"id": 8, "arabic": "ضَنكًا", "translit": "āًknَḍ", "root": "ضنك"}, {"id": 9, "arabic": "وَنَحْشُرُهُۥ", "translit": "ۥُhُrُhsْḥَnَw", "root": "حشر"}, {"id": 10, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 11, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 12, "arabic": "أَعْمَىٰ", "translit": "ٰàَmْʿعَaʾ", "root": "عمي"}], "hasIhya": true}, {"ayah": 125, "text": "قَالَ رَبِّ لِمَ حَشَرْتَنِىٓ أَعْمَىٰ وَقَدْ كُنتُ بَصِيرًا ", "translation": "He will say, \"My Lord, why have you raised me blind while I was [once] seeing?\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 3, "arabic": "لِمَ", "translit": "َmِl", "root": ""}, {"id": 4, "arabic": "حَشَرْتَنِىٓ", "translit": "ٓàِnَtْrَhsَḥ", "root": "حشر"}, {"id": 5, "arabic": "أَعْمَىٰ", "translit": "ٰàَmْʿعَaʾ", "root": "عمي"}, {"id": 6, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 7, "arabic": "كُنتُ", "translit": "ُtnُk", "root": "كون"}, {"id": 8, "arabic": "بَصِيرًا", "translit": "āًryِṣَb", "root": "بصر"}], "hasIhya": false}, {"ayah": 126, "text": "قَالَ كَذَٰلِكَ أَتَتْكَ ءَايَٰتُنَا فَنَسِيتَهَاۖ وَكَذَٰلِكَ ٱلْيَوْمَ تُنسَىٰ ", "translation": "[Allāh] will say, \"Thus did Our signs come to you, and you forgot [i.e., disregarded] them; and thus will you this Day be forgotten.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 3, "arabic": "أَتَتْكَ", "translit": "َkْtَtَaʾ", "root": "اتي"}, {"id": 4, "arabic": "ءَايَٰتُنَا", "translit": "āَnُtَٰyāَء", "root": "ايي"}, {"id": 5, "arabic": "فَنَسِيتَهَا", "translit": "āَhَtyِsَnَf", "root": "نسي"}, {"id": 6, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 7, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 8, "arabic": "تُنسَىٰ", "translit": "ٰàَsnُt", "root": "نسي"}], "hasIhya": true}, {"ayah": 127, "text": "وَكَذَٰلِكَ نَجْزِى مَنْ أَسْرَفَ وَلَمْ يُؤْمِنۢ بِـَٔايَٰتِ رَبِّهِۦۚ وَلَعَذَابُ ٱلْءَاخِرَةِ أَشَدُّ وَأَبْقَىٰٓ ", "translation": "And thus do We recompense he who transgressed and did not believe in the signs of his Lord. And the punishment of the Hereafter is more severe and more enduring.[1]", "words": [{"id": 1, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 2, "arabic": "نَجْزِى", "translit": "àِzْjgَn", "root": "جزي"}, {"id": 3, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 4, "arabic": "أَسْرَفَ", "translit": "َfَrْsَaʾ", "root": "سرف"}, {"id": 5, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 6, "arabic": "يُؤْمِنۢ", "translit": "ۢnِmْwʾُy", "root": "امن"}, {"id": 7, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 8, "arabic": "رَبِّهِۦ", "translit": "ۦِhِّbَr", "root": "ربب"}, {"id": 9, "arabic": "وَلَعَذَابُ", "translit": "ُbāَhdَʿعَlَw", "root": "عذب"}, {"id": 10, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 11, "arabic": "أَشَدُّ", "translit": "ُّdَhsَaʾ", "root": "شدد"}, {"id": 12, "arabic": "وَأَبْقَىٰٓ", "translit": "ٰٓàَqْbَaʾَw", "root": "بقي"}], "hasIhya": false}, {"ayah": 128, "text": "أَفَلَمْ يَهْدِ لَهُمْ كَمْ أَهْلَكْنَا قَبْلَهُم مِّنَ ٱلْقُرُونِ يَمْشُونَ فِى مَسَٰكِنِهِمْۗ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّأُو۟لِى ٱلنُّهَىٰ ", "translation": "Then, has it not become clear to them how many generations We destroyed before them as they walk among their dwellings? Indeed in that are signs for those of intelligence.", "words": [{"id": 1, "arabic": "أَفَلَمْ", "translit": "ْmَlَfَaʾ", "root": ""}, {"id": 2, "arabic": "يَهْدِ", "translit": "ِdْhَy", "root": "هدي"}, {"id": 3, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 4, "arabic": "كَمْ", "translit": "ْmَk", "root": ""}, {"id": 5, "arabic": "أَهْلَكْنَا", "translit": "āَnْkَlْhَaʾ", "root": "هلك"}, {"id": 6, "arabic": "قَبْلَهُم", "translit": "mُhَlْbَq", "root": "قبل"}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلْقُرُونِ", "translit": "ِnwُrُqْlٱ", "root": "قرن"}, {"id": 9, "arabic": "يَمْشُونَ", "translit": "َnwُhsْmَy", "root": "مشي"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "مَسَٰكِنِهِمْ", "translit": "ْmِhِnِkَٰsَm", "root": "سكن"}, {"id": 12, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 15, "arabic": "لَءَايَٰتٍ", "translit": "ٍtَٰyāَءَl", "root": "ايي"}, {"id": 16, "arabic": "لِّأُو۟لِى", "translit": "àِl۟wُaʾِّl", "root": ""}, {"id": 17, "arabic": "ٱلنُّهَىٰ", "translit": "ٰàَhُّnlٱ", "root": "نهي"}], "hasIhya": false}, {"ayah": 129, "text": "وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِن رَّبِّكَ لَكَانَ لِزَامًا وَأَجَلٌ مُّسَمًّى ", "translation": "And if not for a word[1] that preceded from your Lord, it [i.e., punishment] would have been an obligation [due immediately],[2] and [if not for] a specified term [decreed].", "words": [{"id": 1, "arabic": "وَلَوْلَا", "translit": "āَlْwَlَw", "root": ""}, {"id": 2, "arabic": "كَلِمَةٌ", "translit": "ٌẗَmِlَk", "root": "كلم"}, {"id": 3, "arabic": "سَبَقَتْ", "translit": "ْtَqَbَs", "root": "سبق"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 6, "arabic": "لَكَانَ", "translit": "َnāَkَl", "root": "كون"}, {"id": 7, "arabic": "لِزَامًا", "translit": "āًmāَzِl", "root": "لزم"}, {"id": 8, "arabic": "وَأَجَلٌ", "translit": "ٌlَjgَaʾَw", "root": "اجل"}, {"id": 9, "arabic": "مُّسَمًّى", "translit": "àًّmَsُّm", "root": "سمو"}], "hasIhya": true}, {"ayah": 130, "text": "فَٱصْبِرْ عَلَىٰ مَا يَقُولُونَ وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ ٱلشَّمْسِ وَقَبْلَ غُرُوبِهَاۖ وَمِنْ ءَانَآئِ ٱلَّيْلِ فَسَبِّحْ وَأَطْرَافَ ٱلنَّهَارِ لَعَلَّكَ تَرْضَىٰ ", "translation": "So be patient over what they say and exalt [Allāh] with praise of your Lord before the rising of the sun and before its setting; and during periods of the night [exalt Him] and at the ends of the day, that you may be satisfied.", "words": [{"id": 1, "arabic": "فَٱصْبِرْ", "translit": "ْrِbْṣٱَf", "root": "صبر"}, {"id": 2, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 5, "arabic": "وَسَبِّحْ", "translit": "ْḥِّbَsَw", "root": "سبح"}, {"id": 6, "arabic": "بِحَمْدِ", "translit": "ِdْmَḥِb", "root": "حمد"}, {"id": 7, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 8, "arabic": "قَبْلَ", "translit": "َlْbَq", "root": "قبل"}, {"id": 9, "arabic": "طُلُوعِ", "translit": "ِʿعwُlُṭ", "root": "طلع"}, {"id": 10, "arabic": "ٱلشَّمْسِ", "translit": "ِsْmَّhslٱ", "root": "شمس"}, {"id": 11, "arabic": "وَقَبْلَ", "translit": "َlْbَqَw", "root": "قبل"}, {"id": 12, "arabic": "غُرُوبِهَا", "translit": "āَhِbwُrُغ", "root": "غرب"}, {"id": 13, "arabic": "وَمِنْ", "translit": "ْnِmَw", "root": ""}, {"id": 14, "arabic": "ءَانَآئِ", "translit": "ِyʾٓāَnāَء", "root": "اني"}, {"id": 15, "arabic": "ٱلَّيْلِ", "translit": "ِlْyَّlٱ", "root": "ليل"}, {"id": 16, "arabic": "فَسَبِّحْ", "translit": "ْḥِّbَsَf", "root": "سبح"}, {"id": 17, "arabic": "وَأَطْرَافَ", "translit": "َfāَrْṭَaʾَw", "root": "طرف"}, {"id": 18, "arabic": "ٱلنَّهَارِ", "translit": "ِrāَhَّnlٱ", "root": "نهر"}, {"id": 19, "arabic": "لَعَلَّكَ", "translit": "َkَّlَʿعَl", "root": ""}, {"id": 20, "arabic": "تَرْضَىٰ", "translit": "ٰàَḍْrَt", "root": "رضو"}], "hasIhya": true}, {"ayah": 131, "text": "وَلَا تَمُدَّنَّ عَيْنَيْكَ إِلَىٰ مَا مَتَّعْنَا بِهِۦٓ أَزْوَٰجًا مِّنْهُمْ زَهْرَةَ ٱلْحَيَوٰةِ ٱلدُّنْيَا لِنَفْتِنَهُمْ فِيهِۚ وَرِزْقُ رَبِّكَ خَيْرٌ وَأَبْقَىٰ ", "translation": "And do not extend your eyes toward that by which We have given enjoyment to [some] categories of them, [its being but] the splendor of worldly life by which We test them. And the provision of your Lord is better and more enduring.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَمُدَّنَّ", "translit": "َّnَّdُmَt", "root": "مدد"}, {"id": 3, "arabic": "عَيْنَيْكَ", "translit": "َkْyَnْyَʿع", "root": "عين"}, {"id": 4, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "مَتَّعْنَا", "translit": "āَnْʿعَّtَm", "root": "متع"}, {"id": 7, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 8, "arabic": "أَزْوَٰجًا", "translit": "āًjgَٰwْzَaʾ", "root": "زوج"}, {"id": 9, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 10, "arabic": "زَهْرَةَ", "translit": "َẗَrْhَz", "root": "زهر"}, {"id": 11, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 12, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 13, "arabic": "لِنَفْتِنَهُمْ", "translit": "ْmُhَnِtْfَnِl", "root": "فتن"}, {"id": 14, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 15, "arabic": "وَرِزْقُ", "translit": "ُqْzِrَw", "root": "رزق"}, {"id": 16, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 17, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 18, "arabic": "وَأَبْقَىٰ", "translit": "ٰàَqْbَaʾَw", "root": "بقي"}], "hasIhya": true}, {"ayah": 132, "text": "وَأْمُرْ أَهْلَكَ بِٱلصَّلَوٰةِ وَٱصْطَبِرْ عَلَيْهَاۖ لَا نَسْـَٔلُكَ رِزْقًاۖ نَّحْنُ نَرْزُقُكَۗ وَٱلْعَٰقِبَةُ لِلتَّقْوَىٰ ", "translation": "And enjoin prayer upon your family [and people] and be steadfast therein. We ask you not for provision; We provide for you, and the [best] outcome is for [those of] righteousness.", "words": [{"id": 1, "arabic": "وَأْمُرْ", "translit": "ْrُmْaʾَw", "root": "امر"}, {"id": 2, "arabic": "أَهْلَكَ", "translit": "َkَlْhَaʾ", "root": "اهل"}, {"id": 3, "arabic": "بِٱلصَّلَوٰةِ", "translit": "ِẗٰwَlَّṣlٱِb", "root": "صلو"}, {"id": 4, "arabic": "وَٱصْطَبِرْ", "translit": "ْrِbَṭْṣٱَw", "root": "صبر"}, {"id": 5, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "نَسْـَٔلُكَ", "translit": "َkُlَٔـْsَn", "root": "سال"}, {"id": 8, "arabic": "رِزْقًا", "translit": "āًqْzِr", "root": "رزق"}, {"id": 9, "arabic": "نَّحْنُ", "translit": "ُnْḥَّn", "root": ""}, {"id": 10, "arabic": "نَرْزُقُكَ", "translit": "َkُqُzْrَn", "root": "رزق"}, {"id": 11, "arabic": "وَٱلْعَٰقِبَةُ", "translit": "ُẗَbِqَٰʿعْlٱَw", "root": "عقب"}, {"id": 12, "arabic": "لِلتَّقْوَىٰ", "translit": "ٰàَwْqَّtlِl", "root": "وقي"}], "hasIhya": true}, {"ayah": 133, "text": "وَقَالُوا۟ لَوْلَا يَأْتِينَا بِـَٔايَةٍ مِّن رَّبِّهِۦٓۚ أَوَلَمْ تَأْتِهِم بَيِّنَةُ مَا فِى ٱلصُّحُفِ ٱلْأُولَىٰ ", "translation": "And they say, \"Why does he not bring us a sign from his Lord?\" Has there not come to them evidence of what was in the former scriptures?[1]", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "لَوْلَا", "translit": "āَlْwَl", "root": ""}, {"id": 3, "arabic": "يَأْتِينَا", "translit": "āَnyِtْaʾَy", "root": "اتي"}, {"id": 4, "arabic": "بِـَٔايَةٍ", "translit": "ٍẗَyāَٔـِb", "root": "ايي"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "رَّبِّهِۦٓ", "translit": "ٓۦِhِّbَّr", "root": "ربب"}, {"id": 7, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 8, "arabic": "تَأْتِهِم", "translit": "mِhِtْaʾَt", "root": "اتي"}, {"id": 9, "arabic": "بَيِّنَةُ", "translit": "ُẗَnِّyَb", "root": "بين"}, {"id": 10, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ٱلصُّحُفِ", "translit": "ِfُḥُّṣlٱ", "root": "صحف"}, {"id": 13, "arabic": "ٱلْأُولَىٰ", "translit": "ٰàَlwُaʾْlٱ", "root": "اول"}], "hasIhya": false}, {"ayah": 134, "text": "وَلَوْ أَنَّآ أَهْلَكْنَٰهُم بِعَذَابٍ مِّن قَبْلِهِۦ لَقَالُوا۟ رَبَّنَا لَوْلَآ أَرْسَلْتَ إِلَيْنَا رَسُولًا فَنَتَّبِعَ ءَايَٰتِكَ مِن قَبْلِ أَن نَّذِلَّ وَنَخْزَىٰ ", "translation": "And if We had destroyed them with a punishment before him,[1] they would have said, \"Our Lord, why did You not send to us a messenger so we could have followed Your verses [i.e., teachings] before we were humiliated and disgraced?\"", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "أَنَّآ", "translit": "ٓāَّnَaʾ", "root": ""}, {"id": 3, "arabic": "أَهْلَكْنَٰهُم", "translit": "mُhَٰnْkَlْhَaʾ", "root": "هلك"}, {"id": 4, "arabic": "بِعَذَابٍ", "translit": "ٍbāَhdَʿعِb", "root": "عذب"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "قَبْلِهِۦ", "translit": "ۦِhِlْbَq", "root": "قبل"}, {"id": 7, "arabic": "لَقَالُوا۟", "translit": "۟āwُlāَqَl", "root": "قول"}, {"id": 8, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 9, "arabic": "لَوْلَآ", "translit": "ٓāَlْwَl", "root": ""}, {"id": 10, "arabic": "أَرْسَلْتَ", "translit": "َtْlَsْrَaʾ", "root": "رسل"}, {"id": 11, "arabic": "إِلَيْنَا", "translit": "āَnْyَlِiʾ", "root": ""}, {"id": 12, "arabic": "رَسُولًا", "translit": "āًlwُsَr", "root": "رسل"}, {"id": 13, "arabic": "فَنَتَّبِعَ", "translit": "َʿعِbَّtَnَf", "root": "تبع"}, {"id": 14, "arabic": "ءَايَٰتِكَ", "translit": "َkِtَٰyāَء", "root": "ايي"}, {"id": 15, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 16, "arabic": "قَبْلِ", "translit": "ِlْbَq", "root": "قبل"}, {"id": 17, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 18, "arabic": "نَّذِلَّ", "translit": "َّlِhdَّn", "root": "ذلل"}, {"id": 19, "arabic": "وَنَخْزَىٰ", "translit": "ٰàَzْhkَnَw", "root": "خزي"}], "hasIhya": false}, {"ayah": 135, "text": "قُلْ كُلٌّ مُّتَرَبِّصٌ فَتَرَبَّصُوا۟ۖ فَسَتَعْلَمُونَ مَنْ أَصْحَٰبُ ٱلصِّرَٰطِ ٱلسَّوِىِّ وَمَنِ ٱهْتَدَىٰ ", "translation": "Say, \"Each [of us] is waiting;[1] so wait. For you will know who are the companions of the sound path and who is guided.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "كُلٌّ", "translit": "ٌّlُk", "root": "كلل"}, {"id": 3, "arabic": "مُّتَرَبِّصٌ", "translit": "ٌṣِّbَrَtُّm", "root": "ربص"}, {"id": 4, "arabic": "فَتَرَبَّصُوا۟", "translit": "۟āwُṣَّbَrَtَf", "root": "ربص"}, {"id": 5, "arabic": "فَسَتَعْلَمُونَ", "translit": "َnwُmَlْʿعَtَsَf", "root": "علم"}, {"id": 6, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 7, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 8, "arabic": "ٱلصِّرَٰطِ", "translit": "ِṭَٰrِّṣlٱ", "root": "صرط"}, {"id": 9, "arabic": "ٱلسَّوِىِّ", "translit": "ِّàِwَّslٱ", "root": "سوي"}, {"id": 10, "arabic": "وَمَنِ", "translit": "ِnَmَw", "root": ""}, {"id": 11, "arabic": "ٱهْتَدَىٰ", "translit": "ٰàَdَtْhٱ", "root": "هدي"}], "hasIhya": false}], "tafsir": {"14": [{"arabic": "وجل في كلام يردده في نفسه كما لو سمع وهو يقول {إنني أنا الله لا إله إلا أنا فاعبدني} فإنه ما كان ينبغي أن يفهم منه ذلك إلا على سبيل الحكاية الصنف الثاني من الشطح كلمات غير مفهومة لها ظواهر رائقة وفيها عبارات هائلة وليس وراءها طائل إما أن تكون غير مفهومة عند قائلها بل يصدرها عن خبط في عقله وتشويش في خياله لقلة إحاطته بمعنى كلام قرع سمعه وهذا هو الأكثر وإما أن تكون مفهومة له ولكنه لا يقدر على تفهيمها وإيرادها بعبارة تدل على ضميره لقلة ممارسته للعلم وعدم تعلمه طريق التعبير عن المعاني بالألفاظ الرشيقة ولا فائدة لهذا الجنس من ا", "english": "Saʿd ibn Abī Waqqāṣ, may God be pleased with him, said to his son ʿUmar — having heard him composing sajʿ — \"This is what makes me dislike you. I will never fulfill your need until you repent.\" This was said when his son had come to him seeking a favor. And the Prophet, may God bless him and grant him peace, said to ʿAbd Allāh ibn Rawāḥah when he spoke in sajʿ of three words: \"Beware of sajʿ, O Ibn Rawāḥah.\" Thus, the forbidden sajʿ is the artificially contrived kind that exceeds two words. For this reason, when a man spoke concerning the blood-money for a fetus — saying, \"How shall we pay blood-money for one who neither drank, nor ate, nor cried out, nor wailed? Such a one's blood is void\" — the Prophet, may God bless him and grant him peace, replied: \"Sajʿ like the sajʿ of the bedouins!\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 31", "section_title_en": "On the Etiquette of Preaching: The Condemnation of Artificial Sajʿ, Excessive Poetry, and the Perils of Shataḥ and Taʿwīl", "section_index": 31, "anchors": "- Root: سجع (sajʿa)\n  * Lisan / Ayn: Rhymed prose; from the root meaning \"to coo\" (as a dove), indicating a measured, melodious cadence in speech.\n  * Al-Raghib (Mufradat): In theological discourse, sajʿ is permissible when natural but blameworthy when artificially cultivated (takalluf), as it shifts focus from meaning to ornamentation.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — natural rhythmic speech; Metaphorical (majāz) — the \"sajʿ of the bedouins\" (sajʿ al-aʿrāb) as a pejorative for empty, affected eloquence.\n- Root: شعر (shiʿr)\n  * Lisan / Ayn: Poetry; from the root denoting perception and fine discernment (shuʿūr), as the poet grasps subtle meanings.\n  * Al-Raghib (Mufradat): Poetry is blameworthy when it stirs base appetites, but praiseworthy when it conveys wisdom (ḥikmah), as in the prophetic saying \"Indeed from poetry there is wisdom.\"\n  * Al-Zamakhshari (Asas): Literal — metered, rhymed speech; Metaphorical — the \"poetry\" of the heart's inclination, where listeners project their own passions onto what they hear.\n- Root: شطح (shaṭaḥa)\n  * Lisan / Ayn: To overflow, to gush forth; originally of a water-skin bursting, then applied to ecstatic utterances that overflow the bounds of conventional discourse.\n  * Al-Raghib (Mufradat): In Sufi terminology, shataḥ refers to utterances arising from overwhelming spiritual states (ḥāl) that, when voiced to the unworthy, cause corruption.\n  * Al-Zamakhshari (Asas): Literal — physical overflowing; Metaphorical — the soul's overflow in speech that exceeds the speaker's intentional control.\n- Root: أول (taʿwīl)\n  * Lisan / Ayn: To return something to its origin or end; interpretation that traces a word back to its intended meaning.\n  * Al-Raghib (Mufradat): Taʿwīl is legitimate only when supported by textual (naqlī) or rational (ʿaqlī) evidence; arbitrary taʿwīl that severs words from their established senses destroys religious trust.\n  * Al-Zamakhshari (Asas): Literal — the apparent sense (ẓāhir); Metaphorical — the inner sense (bāṭin), which is only valid when the literal sense is impossible or when transmitted authority sanctions it.\n- Sibawayh Rule: Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā (Restriction and Focused Predication) — The text repeatedly uses restrictive constructions (innamā, laysa...illā) to delimit permissible preaching, poetry, and interpretation, distinguishing the praiseworthy from the blameworthy with syntactic precision.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}, {"arabic": "لا إله إلا أنا كما أوردناه في الأول فمن دعا بهذه الأسماء فليقل إنك أنت الله لا إله إلا أنت كذا وكذا فمن دعا بهن كتب من الساجدين المخبتين الذين يجاورون محمدا وإبراهيم وموسى وعيسى والنبيين صلوات الله عليهم في دار الجلال وله ثواب العابدين في السموات والأرضين وصلى الله على محمد وعلى كل عبد مصطفى", "english": "Muḥammad ibn Ḥassān said: Maʿrūf al-Karkhī — may God have mercy on him — said to me: \"Shall I not teach you ten words — five for this world and five for the Hereafter? Whoever supplicates God — Mighty and Majestic — with them shall find God — Most High — present with them.\" I said: \"Write them down for me.\" He said: \"No, but I shall repeat them to you as Bakr ibn Khunays — may God have mercy on him — repeated them to me:", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 249", "section_title_en": "Section 249 — Supplications of the Righteous (Adʿiyat al-Ṣāliḥīn)", "section_index": 249, "anchors": "- Root: حسب (ḥ-s-b)\n  * Lisan / Ayn: Core meaning of counting, reckoning, and sufficiency — \"ḥasb\" denotes that which suffices or is enough\n  * Al-Raghib (Mufradat): \"الحساب: استعمال العدد\" — the theological nuance of ḥasbī Allāh (\"God is my Sufficer\") carries the sense of complete reliance upon God's reckoning and provision, transcending mere numerical counting to signify total trust in divine sufficiency\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"حسب المال\" (he counted the wealth); Metaphorical (majāz): \"خرجا يتحسبان الأخبار\" (they go out seeking news) — in the supplication \"ḥasbī Allāh,\" the literal sense of \"sufficiency\" is intended, yet it carries the metaphorical extension of complete trust, as one who has God as his Sufficer has no need of any other reckoning\n\n- Root: اله (ʾ-l-h)\n  * Lisan / Ayn: Core meaning of worship, devotion, and seeking refuge; \"ilāh\" denotes that which is worshipped\n  * Al-Raghib (Mufradat): \"الله: قيل: أصله إله فحذفت همزته، وأدخل عليها الألف واللام، فخص بالباري تعالى\" — the name Allāh is the proper name of the Creator, distinguished from generic \"ilāh\" (any object of worship); in these supplications, the divine names invoked (al-Karīm, al-Ḥalīm, al-Qawī, al-Shadīd, al-Raḥīm, al-Raʾūf, al-Laṭīf, al-Qadīr) each specify particular attributes of the divine essence\n  * Al-Zamakhshari (Asas): Literal: \"فلان يتأله: يتعبد\" (he worships); the supplications employ the divine names in their literal theological sense, each name invoking a specific attribute relevant to the particular need mentioned\n\n- Root: انا (ʾ-n-y)\n  * Al-Raghib (Mufradat): \"أنا ضمير المخبر عن نفسه\" — the first-person pronoun; in the divine self-declaration \"innī anā Allāh,\" the repetition emphasizes divine self-identification\n  * Al-Zamakhshari (Asas): Literal: \"أنى الطعام أي إدراكه\" (the food ripened/reached its time) — the related sense of something reaching its appointed time appears in \"عند المسألة في القبر\" (at the questioning in the grave), indicating appointed moments of divine reckoning\n\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The supplications employ repeated prepositional phrases (ʿinda al-mawt, ʿinda al-masʾalah, ʿinda al-ḥisāb, ʿinda al-mīzān, ʿinda al-ṣirāṭ) in parallel construction, each governing a distinct divine name, creating a rhythmic liturgical structure where each clause stands as an independent invocation\n\n---\n\n##", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "16": [{"arabic": "{فلا يصدنك عنها من لا يؤمن بها واتبع هواه} وقال تعالى فأعرض عمن تولى عن", "english": "Know that not every person is fit for companionship. The Prophet (peace and blessings be upon him) said: {«A man follows the religion of his intimate friend; so let each of you consider whom he takes as an intimate friend»}. One must therefore be distinguished by traits and qualities on account of which his companionship is desired, and those qualities are stipulated according to the benefits sought from companionship — for the meaning of a condition (sharṭ) is that without which the attainment of the intended object is impossible. Thus, in relation to the intended object, the conditions become manifest.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 414", "section_title_en": "Exposition of the Qualities Required in One Whose Companionship Is Chosen", "section_index": 414, "anchors": "- Root: صحب (ṣ-ḥ-b)\n  * Lisan / Ayn: Companionship, association, intimacy of attachment — whether by body, place, or time; the companion is the one who is constantly attendant upon another.\n  * Al-Raghib (Mufradat): Companionship (ṣuḥbah) may be physical — which is the original and most common sense — or by care and concern; the term extends to every thing that is attached to another as its possessor or associate.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): bodily association and fellowship. Metaphorical (majāz): \"companion of wealth or knowledge\" — i.e., one who is attached to it in concern; \"companion of the sword and spear\" for the warrior.\n- Root: عقل (ʿ-q-l)\n  * Lisan / Ayn: Intellect; that which restrains and binds one from error; the faculty of understanding and discernment.\n  * Al-Raghib (Mufradat): ʿAql is said of the faculty disposed to receive knowledge, and also of the knowledge acquired by that faculty; it is the instrument by which one apprehends things as they are.\n  * Al-Zamakhshari (Asas): Literal: understanding and discernment after ignorance. Metaphorical: \"a palm tree that does not accept pollination\" — i.e., does not take in what would benefit it.\n- Root: غرض (gh-r-ḍ)\n  * Lisan / Ayn: Target, aim, purpose; that at which one shoots; then applied to every goal one seeks to attain.\n  * Al-Raghib (Mufradat): The object aimed at; divided into deficient aims (those pursued for the sake of something beyond them) and complete aims (those sought for their own sake, like Paradise).\n  * Al-Zamakhshari (Asas): Literal: the target of archery. Metaphorical: any sought-after end or purpose.\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn, overturn, transform a thing from one state to another; the heart — so named for its constant fluctuation and turning.\n  * Al-Raghib (Mufradat): Taqlīb: the turning of a thing from one face to another; the heart is so named because of its perpetual turning between states.\n  * Al-Zamakhshari (Asas): Literal: to turn a thing over. Metaphorical: \"to turn matters over\" — i.e., to examine and deliberate; the heart's turning between states.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The conditional structure \"لا بد أن يتميز\" (it is necessary that he be distinguished) governs the subsequent specification of qualities, where the conditions (shurūṭ) are semantically dependent upon the ends (aghrāḍ) sought, requiring careful parsing of the periodic sentence to preserve the logical priority of purpose over condition.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Duties of Brotherhood'", "badge": "Hadith"}], "24": [{"arabic": "ومثال تأويل أهل الطامات قول بعضهم في تأويل قوله تعالى {اذهب إلى فرعون إنه طغى} أنه إشارة إلى قلبه وقال هو المراد بفرعون وهو الطاغي على كل إنسان وفي قوله تعالى {وأن ألق عصاك} أي ما يتوكأ عليه ويعتمده مما سوى الله عز وجل فينبغي أن يلقيه وفي قوله صلى الله عليه وسلم تسحروا فإن في السحور بركة (1) أراد به الاستغفار في الأسحار وأمثال ذلك حتى يحرفون القرآن من أوله إلى آخره عن ظاهره وعن تفسيره المنقول عن ابن عباس وسائر العلماء وبعض هذه التأويلات يعلم بطلانها قطعا كتنزيل فرعون على القلب فإن فرعون شخص محسوس تواتر إلينا النقل بوجوده ودعوة موس", "english": "Saʿd ibn Abī Waqqāṣ, may God be pleased with him, said to his son ʿUmar — having heard him composing sajʿ — \"This is what makes me dislike you. I will never fulfill your need until you repent.\" This was said when his son had come to him seeking a favor. And the Prophet, may God bless him and grant him peace, said to ʿAbd Allāh ibn Rawāḥah when he spoke in sajʿ of three words: \"Beware of sajʿ, O Ibn Rawāḥah.\" Thus, the forbidden sajʿ is the artificially contrived kind that exceeds two words. For this reason, when a man spoke concerning the blood-money for a fetus — saying, \"How shall we pay blood-money for one who neither drank, nor ate, nor cried out, nor wailed? Such a one's blood is void\" — the Prophet, may God bless him and grant him peace, replied: \"Sajʿ like the sajʿ of the bedouins!\"", "book_title": "Book of Knowledge", "section_title_ar": "Section 31", "section_title_en": "On the Etiquette of Preaching: The Condemnation of Artificial Sajʿ, Excessive Poetry, and the Perils of Shataḥ and Taʿwīl", "section_index": 31, "anchors": "- Root: سجع (sajʿa)\n  * Lisan / Ayn: Rhymed prose; from the root meaning \"to coo\" (as a dove), indicating a measured, melodious cadence in speech.\n  * Al-Raghib (Mufradat): In theological discourse, sajʿ is permissible when natural but blameworthy when artificially cultivated (takalluf), as it shifts focus from meaning to ornamentation.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — natural rhythmic speech; Metaphorical (majāz) — the \"sajʿ of the bedouins\" (sajʿ al-aʿrāb) as a pejorative for empty, affected eloquence.\n- Root: شعر (shiʿr)\n  * Lisan / Ayn: Poetry; from the root denoting perception and fine discernment (shuʿūr), as the poet grasps subtle meanings.\n  * Al-Raghib (Mufradat): Poetry is blameworthy when it stirs base appetites, but praiseworthy when it conveys wisdom (ḥikmah), as in the prophetic saying \"Indeed from poetry there is wisdom.\"\n  * Al-Zamakhshari (Asas): Literal — metered, rhymed speech; Metaphorical — the \"poetry\" of the heart's inclination, where listeners project their own passions onto what they hear.\n- Root: شطح (shaṭaḥa)\n  * Lisan / Ayn: To overflow, to gush forth; originally of a water-skin bursting, then applied to ecstatic utterances that overflow the bounds of conventional discourse.\n  * Al-Raghib (Mufradat): In Sufi terminology, shataḥ refers to utterances arising from overwhelming spiritual states (ḥāl) that, when voiced to the unworthy, cause corruption.\n  * Al-Zamakhshari (Asas): Literal — physical overflowing; Metaphorical — the soul's overflow in speech that exceeds the speaker's intentional control.\n- Root: أول (taʿwīl)\n  * Lisan / Ayn: To return something to its origin or end; interpretation that traces a word back to its intended meaning.\n  * Al-Raghib (Mufradat): Taʿwīl is legitimate only when supported by textual (naqlī) or rational (ʿaqlī) evidence; arbitrary taʿwīl that severs words from their established senses destroys religious trust.\n  * Al-Zamakhshari (Asas): Literal — the apparent sense (ẓāhir); Metaphorical — the inner sense (bāṭin), which is only valid when the literal sense is impossible or when transmitted authority sanctions it.\n- Sibawayh Rule: Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā (Restriction and Focused Predication) — The text repeatedly uses restrictive constructions (innamā, laysa...illā) to delimit permissible preaching, poetry, and interpretation, distinguishing the praiseworthy from the blameworthy with syntactic precision.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Book of Knowledge'", "badge": "Hadith"}], "25": [{"arabic": "اللهم اشرح لي صدري ويسر لي أمري وليقل اللهم رب الحمد لك الحمد كما تقول وخيرا مما نقول لك صلاتي ونسكي ومحياي ومماتي وإليك مآبي وإليك ثوابي اللهم إني أعوذ بك من وساوس الصدر وشتات الأمر وعذاب القبر اللهم إني أعوذ بك من شر ما يلج في الليل ومن شر ما يلج في النهار ومن شر ما تهب به الرياح ومن شر بوائق الدهر اللهم إني أعوذ بك من تحول عافيتك وفجأة نقمتك وجميع سخطك اللهم اهدني بالهدى واغفر لي في الآخرة والأولى يا خير مقصود وأسنى منزول به وأكرم مسئول ما لديه أعطني العشية أفضل ما أعطيت أ", "english": "On the Day of 'Arafah, the first thing with which one supplicates, let him say: There is no god but God alone, with no partner; His is the sovereignty and His is the praise; He gives life and causes death, and He is Living, He does not die; in His hand is all good, and He is over all things Omnipotent. O God, place in my heart a light, and in my hearing a light, and in my sight a light, and in my tongue a light. O God, expand for me my breast and make easy for me my affair. And let him say: O God, Lord of the praise, to You is the praise as You say, and better than what we say. To You is my prayer, my sacrifice, my living, and my dying; to You is my return, and to You is my recompense. O God, I seek refuge in You from the whisperings of the breast, the scattering of affairs, and the torment of the grave. O God, I seek refuge in You from the evil of what enters in the night, and from the evil of what enters in the day, and from the evil of what the winds bring, and from the evil of the calamities of time. O God, I seek refuge in You from the withdrawal of Your well-being, the suddenness of Your retribution, and all of Your wrath. O God, guide me with guidance, and forgive me in the Hereafter and the First. O Best of all sought goals, and Most Exalted of all that is alighted upon, and Most Generous of all who are asked — whatever is with You — grant me this evening the best of what You have given to any of Your creatures and pilgrims of Your Sacred House, O Most Merciful of the merciful. O God, O Raiser of degrees and Sender of blessings, O Originator of the earths and the heavens, voices have clamored to You in diverse languages, asking You their needs. And my need of You is that You not forget me in the abode of trial when the people of this world have forgotten me. O God, You hear my speech and see my place and know my secret and my public, and nothing of my affair is hidden from You. I am the wretched one, the poor one, the seeker of aid, the seeker of refuge, the fearful, the apprehensive, the confessor of his sin. I ask You with the asking of the destitute, and I supplicate to You with the supplication of the abased sinner, and I call upon You with the call of the fearful and distressed — the call of one whose neck has bowed to You, whose tears have flowed for You, whose body has humbled before You, and whose nose has been rubbed in the dust for You. O God, do not make me, by my supplication to You, O Lord, wretched, and be to me kind and merciful, O Best of those who are asked and Most Generous of those who give. My God, whoever has praised his own soul to You — for I am one who blames his own soul. My God, sins have silenced my tongue, so I have no means of intercession other than deeds, and no intercessor other than hope. My God, I know that my sins have left me no standing with You, nor any face for excuse — but You are the Most Generous of the generous. My God, if I am not worthy to attain Your mercy, then Your mercy is worthy to attain me, for Your mercy encompasses all things, and I am a thing. My God, though my sins be great, yet they are small beside Your pardon, so forgive them for me, O Generous One. My God, You are You, and I am I. I am the one who returns to sins, and You are the One who returns to forgiveness. My God, if You show mercy only to the people of obedience, then to whom shall the sinners flee? My God, I turned away from Your obedience deliberately, and I headed toward Your disobedience intentionally. Glory be to You — how great is Your proof against me, and how generous is Your pardon toward me! By the necessity of Your proof against me, and the severance of my excuse from You, and my poverty toward You, and Your richness from me — forgive me, O Best of those whom a caller has called, and Most Excellent of those whom a hope has hoped in. By the sanctity of Islam and by the covenant of Muhammad, may God bless him and grant him peace, I seek intercession with You, so forgive me all my sins, and turn me away from this standing place of mine with my needs fulfilled, and grant me what I have asked, and realize my hope in what I have wished. My God, I have called upon You with the supplication that You taught me, so do not deprive me of the hope that You made known to me. My God, what will You do this evening with a servant who confesses to You his sin, who is humble before You in his abasement, who is submissive in his offense, who pleads to You concerning his deed, who repents to You from his transgression, who seeks Your forgiveness for his wrong, who supplicates to You for pardon of him, who asks of You the success of his needs, who hopes in You at his standing place — despite the abundance of his sins? O Refuge of every living thing, and Protector of every believer — whoever does well, it is by Your mercy that he triumphs, and whoever errs, it is by his error that he perishes. O God, to You we have come forth, and in Your courtyard we have alighted, and You alone we hope, and what is with You we seek, and to Your beneficence we expose ourselves, and Your mercy we hope for, and from Your chastisement we are fearful, and to You with the heavy burdens of sins we have fled, and to Your Sacred House we have performed the pilgrimage. O You who owns the needs of those who ask, and knows the consciences of the silent — O You who has no lord with Him who is invoked, and no creator above Him who is feared, and no minister to whom one comes, and no chamberlain who is bribed — O You who increases not by the abundance of asking except in bounty and generosity, nor by the abundance of needs except in favor and beneficence. O God, You have made for every guest a hospitality, and we are Your guests, so make Your hospitality to us Paradise. O God, for every delegation there is a gift, and for every visitor there is an honor, and for every asker there is a giving, and for every one who hopes there is a reward, and for every seeker there is with You a recompense, and for every...", "book_title": "Mysteries of Hajj", "section_title_ar": "Section 206", "section_title_en": "The Supplications of the Day of 'Arafah — Section 206", "section_index": 206, "anchors": "- Root: دعو (d-'-w)\n  * Lisan / Ayn: Core meaning: to call, summon, invoke; du'a is the act of calling upon God with humble petition.\n  * Al-Raghib (Mufradat): In theological usage, du'a is the essence of worship ('ibadah), the creature's acknowledgment of need (iftiqar) before the Creator, and a means of drawing near (taqarrub).\n  * Al-Zamakhshari (Asas): Literal (haqiqah): vocal calling. Metaphorical (majaz): the soul's inward turning to God, even without utterance.\n- Root: نور (n-w-r)\n  * Lisan / Ayn: Light; that by which one sees physically and, by extension, that by which the heart perceives truth.\n  * Al-Raghib (Mufradat): Light (nur) is of two kinds: sensory (hissi) and intellectual ('aqli). The prophetic prayer for light in heart, hearing, sight, and tongue seeks the illumination of all faculties for obedience and gnosis (ma'rifah).\n  * Al-Zamakhshari (Asas): Literal: physical luminosity. Metaphorical: guidance (huda) and clarity of perception in religious and moral matters.\n- Root: عفو ('-f-w)\n  * Lisan / Ayn: To pardon, to efface, to leave unpunished; to exceed in generosity.\n  * Al-Raghib (Mufradat): 'Afw is the erasure of sin and the lifting of its consequence; it is an attribute of God's mercy (rahmah) that supersedes His justice when the servant repents.\n  * Al-Zamakhshari (Asas): Literal: to obliterate a trace. Metaphorical: God's complete remission of sin, leaving no mark of accountability.\n- Root: رجا (r-j-w)\n  * Lisan / Ayn: Hope, expectation of good; the opposite of despair (ya's).\n  * Al-Raghib (Mufradat): Raja' is the heart's confident expectation of God's bounty, paired with fear (khawf); it is a station (maqam) of the sincere.\n  * Al-Zamakhshari (Asas): Literal: to await. Metaphorical: the soul's reliance on divine mercy despite unworthiness.\n- Sibawayh Rule: Rule of Conjunction and Apposition (al-'Atf wa al-Badal) — The repeated vocatives \"Ilahi\" (My God) and \"Allahumma\" (O God) function as independent invocations, each followed by coordinated clauses that build a cumulative structure of petition, confession, and praise, requiring faithful preservation of each unit without conflation.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Mysteries of Hajj'", "badge": "Afterlife"}, {"arabic": "رب اشرح لي صدري ويسر لي أمري وتقول عند النظر إلى السماء ربنا ما خلقت هذا باطلا سبحانك فقنا عذاب النار تبارك الذي جعل في السماء بروجا وجعل فيها سراجا وقمرا منيرا وإذا سمعت صوت الرعد فقل سبحان من يسبح الرعد بحمده والملائكة من خيفته (7) فإن رأيت الصواعق فقل اللهم لا تقتلنا بغضبك ولا تهلكنا بعذابك وعافنا قبل ذلك (8) قاله كعب فإذا أمطرت السماء فقل اللهم سقيا هنيئا وصيبا نافعا (9) اللهم اجعله صيب رحمة ولا تجعله صيب عذاب (10) فإذا غضبت فقل اللهم اغفر لي ذنبي وأذهب غيظ قلبي PageV01P", "english": "When you rise in the morning and hear the call to prayer (adhān), it is recommended for you to respond to the caller of prayer (mu'adhdhin) — and we have already mentioned this, along with the supplications for entering and leaving the privy, and the supplications of ablution (wuḍū'), in the Book of Purification. When you set out toward the mosque, say: \"O Allah, place light (nūr) in my heart, and light in my tongue, and place light in my hearing, and place light in my sight, and place light behind me, and light before me, and place light above me. O Allah, grant me light.\" And also say: \"O Allah, I ask You by the right of those who ask of You, and by the right of this my walking unto You — for I have not gone out in insolence, nor in vanity, nor for show, nor for reputation. I have gone out seeking protection from Your wrath and seeking Your good pleasure. So I ask You to deliver me from the Fire and to forgive me my sins — verily, none forgives sins but You.\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 254", "section_title_en": "Section 254 — Supplications for the Hours of Day and Night: From Dawn to Sleep", "section_index": 254, "anchors": "- Root: ن و ر (n-w-r)\n  * Lisan / Ayn: النور: الضوء المنتشر الذي يُبصر به، وهو ضد الظلمة\n  * Al-Raghib (Mufradat): النور في القرآن يقع على ضروب: منها المعقول كالإيمان والحكمة، قال تعالى: {قد جاءكم من الله نور وكتاب مبين}، ومنها المحسوس كضوء الشمس والقمر\n  * Al-Zamakhshari (Asas): النور حقيقة في الضوء المحسوس، ومجاز في الهدى والإيمان والعلم — فدعاء النبي صلى الله عليه وسلم بطلب النور يشمل المعنيين جميعاً\n- Root: س ج د (s-j-d)\n  * Lisan / Ayn: السجود: وضع الجبهة على الأرض تعظيماً، وأصله التطامن والانخفاض\n  * Al-Raghib (Mufradat): السجود ضربان: سجود عبادة وهو وضع الجبهة على الأرض تقرباً، وسجود طاعة وهو الانقياد والخضوع — قال تعالى: {ولله يسجد من في السموات والأرض طوعاً وكرهاً}\n  * Al-Zamakhshari (Asas): سجد حقيقة في وضع الجبهة، ومجاز في الخضوع والانقياد — وقوله \"سجد لك سوادي وخيالي\" من المجاز المرسل\n- Root: ذ ك ر (dh-k-r)\n  * Lisan / Ayn: الذكر: نقيض النسيان، والذكر: الصوت الذي يُذكر به الشيء، والذكر: الشرف والصيت\n  * Al-Raghib (Mufradat): الذكر ضربان: ذكر بالقلب وهو التفكر في عظمة الله، وذكر باللسان وهو التلفظ بأسمائه — وأعلى مراتبه ما اجتمع فيه القلب واللسان\n  * Al-Zamakhshari (Asas): الذكر حقيقة في استحضار الشيء بالقلب أو اللسان، ومجاز في الصلاة والدعاء والثناء\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — جواز تقديم المعمول وتأخيره مع بقاء العامل عاملاً في المعنى، كقوله \"لك الحمد\" حيث تقدم الجار والمجرور على المبتدأ للاختصاص والاهتمام", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "27": [{"arabic": "وأبتهل بين يديك فأقول اشرح لي صدري لأعرفك واحلل عقدة من لساني لأثني عليك فنودي من وراء الحجاب إياك أن تطمع في الثناء وتزيد على سيد الأنبياء بل ارجع إليه فما آتاك فخذه وما نهاك عنه فانته عنه وما قاله لك فقله فإنه ما زاد في هذه الحضرة على أن قال سبحانك لا أحصي ثناء عليك أنت كما أثنيت على نفسك (1) فقال إلهي إن لم يكن للسان جراءة على الثناء عليك فهل للقلب مطمع في معرفتك فنودي إياك أن تتخطى رقاب الصديقين فارجع إلى الصديق الأكبر فاقتد به فإن أصحاب سيد الأنبياء كالنجوم بأيهم اقتديتم اهتديتم أما سمعته يقول العجز ع", "english": "...its mover is Power (al-qudrah) without any doubt. So the seeker (al-sālik) journeyed on to the world of Power, and there he beheld wonders before which all that had preceded seemed contemptible. He asked Power concerning the movement of the right hand, and it said: \"I am but an attribute (innamā anā ṣifah) — ask the Powerful One (al-Qādir), for the reliance is upon the described substances (al-mawṣūfāt), not upon the attributes.\" At that point he almost deviated and unleashed the tongue of questioning with audacity, but he was steadied by the firm word (al-qawl al-thābit), and a caller cried out from behind the veils of the pavilions of the Divine Presence: \"He is not asked about what He does, but they shall be asked\" {«لَا يُسْأَلُ عَمَّا يَفْعَلُ وَهُمْ يُسْأَلُونَ»}. Then the awe of the Presence overwhelmed him, and he fell down stricken, convulsing in his swoon. When he regained consciousness, he said: \"Glory be to You — how magnificent is Your majesty! I repent unto You, and I place my trust in You, and I believe that You are the Sovereign, the Compeller, the One, the Subduer. I fear none but You, I hope for none other than You, and I seek refuge only in Your pardon from Your punishment, and in Your good pleasure from Your wrath. I have nothing but to ask of You and to supplicate before You, and to plead humbly in Your presence, saying: 'Expand my breast that I may know You, and loosen the knot from my tongue that I may praise You.'\"", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 1111", "section_title_en": "The Unification of the Acts — The Journey of the Seekers to the Oneness of the Agent", "section_index": 1111, "anchors": "- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core meaning of measuring, determining, and empowering; al-Qadir as the One whose power is absolute and unbounded.\n  * Al-Raghib (Mufradat): Power (qudrah) when ascribed to God is the negation of incapacity ('ajz); when ascribed to man it is a contingent capacity limited by divine ordainment.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) — \"He is Qadir, Muqtadir, possessor of power\"; metaphorical (majaz) — \"a far-reaching steed\" (ba'id al-qadr), indicating extension of effect.\n- Root: وحد (w-ḥ-d)\n  * Lisan / Ayn: Oneness and singularity; al-Wahid as that which has no part whatsoever.\n  * Al-Raghib (Mufradat): True unity (wahdah) is absolute indivisibility; applied to God exclusively in the sense of unique sovereignty.\n  * Al-Zamakhshari (Asas): \"He is one (wahid), and they are singular (wuhdan)\"; literal unity versus numerical oneness.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as perception of a thing's reality; the mark or sign by which something is known.\n  * Al-Raghib (Mufradat): Knowledge ('ilm) is the apprehension of a thing in its true reality — either grasping the essence or judging its attributes.\n  * Al-Zamakhshari (Asas): Literal — \"I knew not of your news\" (ma 'alimtu bi-khabarika); the knower as one marked by discernment.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — \"Innamā anā ṣifah\" (I am but an attribute) restricts the speaker's essence to being a mere accident, redirecting inquiry to the substantive subject (al-mawṣūf).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monotheism and Reliance'", "badge": "Insight"}], "44": [{"arabic": "فقال تعالى فقولا له قولا لينا لعله يتذكر أو يخشى فليكن اقتداء المحتسب في الرفق بالأنبياء صلوات الله عليهم فقد روى أبو إمامة أن غلاما شابا أتى النبي صلى الله عليه وسلم فقال يا نبي الله تأذن لي في الزنا فصاح الناس به فقال النبي صلى الله عليه وسلم قربوه أدن فدنا حتى جلس بين يديه فقال النبي صلى الله عليه وسلم أتحبه لأمك فقال لا جعلني الله فداك قال كذلك الناس لا يحبونه لأمهاتهم أتحبه لابنتك قال لا جعلني الله فداك قال كذلك الناس لا يحبونه لبناتهم أتحبه لأختك (3) وزاد ابن عوف حتى ذكر العمة والخالة وه", "english": "We do not mean by this that commanding right becomes prohibited by reason of one's sinfulness — rather, its effect upon hearts falls away by the manifestation of his sinfulness to the people. For it has been related from Anas, may God be pleased with him, who said: \"We said, 'O Messenger of God, shall we not command right until we have acted upon it entirely, and shall we not forbid wrong until we have shunned it entirely?' He said, may God's peace and blessings be upon him: 'Rather, command right even if you do not act upon it entirely, and forbid wrong even if you do not shun it entirely.'\"", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 543", "section_title_en": "On Gentleness in Commanding Right and Forbidding Wrong — The Etiquette of the Muḥtasib", "section_index": 543, "anchors": "- Root: عيب (ʿayb)\n  * Lisan / Ayn: Core root meaning — defect, blemish, reproach; to find fault with something.\n  * Al-Raghib (Mufradat): Theological nuance — the reproach of intellect (ʿaql) is the severest form of deficiency, for it touches the very faculty by which one is distinguished from beasts.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — here used metaphorically: the reproach falls upon his intellect, i.e., the deficiency of his discernment becomes manifest.\n- Sibawayh Rule: Rule of Restriction (Bāb al-Ḥaṣr) — \"فإنما يزرى على عقله\" restricts the object of reproach to the intellect alone, excluding the person's faith or status.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Enjoining Good and Forbidding Evil'", "badge": "Insight"}], "45": [{"arabic": "عن موسى صلى الله عليه وسلم حيث قال إننا نخاف أن يفرط علينا أو أن يطغى قال لا تخافا إنني معكما أسمع وأرى ومع هذا لما ألقى السحرة سحرهم أوجس موسى في نفسه خيفة إذا لم يأمن مكر الله والتبس الأمر عليه حتى جدد عليه الأمن وقيل له لا تخف إنك أنت الأعلى ولما ضعفت شوكة المسلمين يوم بدر قال صلى الله عليه وسلم اللهم إن تهلك هذه العصابة لم يبق على وجه الأرض أحد يعبدك // حديث قال يوم بدر اللهم إن تهلك هذه العصابة لم يبق على وجه الأرض أحد يعبدك أخرجه البخاري من حديث ابن عباس بلفظ اللهم إن شئت لم تعبد بعد اليوم الحديث فقال أبو بكر رضي الله تعالى عنه دع عنك مناشدتك", "english": "Just as Abraham (peace be upon him), when he was placed in the catapult, said: \"God is sufficient for me\" {حسبي الله} — and this was among the greatest supplications — he was tested and was confronted by Gabriel in mid-air, who said to him: \"Do you have any need?\" He replied: \"As for you, no.\" And that was the fulfillment of the very reality of his words: \"God is sufficient for me.\" So God Most High informed us about him, saying: \"And Abraham who fulfilled\" {وإبراهيم الذي وفى} — that is, fulfilled the requirement of his saying \"God is sufficient for me.\" And in like manner, He informed us about Moses (peace be upon him), where he said: \"Indeed, we fear that he may assault us or that he may transgress\" {إننا نخاف أن يفرط علينا أو أن يطغى}. He said: \"Fear not; indeed, I am with you both; I hear and I see\" {لا تخافا إنني معكما أسمع وأرى}. Yet despite this, when the sorcerers cast their sorcery, Moses conceived within himself a fear — because he did not feel secure from the deception (makar) of God, and the matter became obscure to him — until security was renewed for him, and it was said to him: \"Fear not; indeed, you are the most exalted\" {لا تخف إنك أنت الأعلى}. And when the strength of the Muslims weakened on the Day of Badr, he (peace be upon him) said: \"O God, if You destroy this band, there will remain no one on the face of the earth who worships You\" — a hadith reported on the Day of Badr: \"O God, if You destroy this band, there will remain no one on the face of the earth who worships You,\" transmitted by al-Bukhari from the hadith of Ibn Abbas with the wording: \"O God, if You will, You will not be worshipped after this day\" — to the end of the hadith. So Abu Bakr (may God be pleased with him) said: \"Leave off your importuning of your Lord, for He will surely fulfill what He has promised you.\" Thus, the station of al-Siddiq (may God be pleased with him) was the station of trust in God's promise, while the station of the Messenger of God (peace be upon him) was the station of fear of God's deception (makar) — and this latter is more complete, for it issues only from the perfection of knowledge of God's secrets, the hidden aspects of His acts, and the meanings of His attributes, some of whose manifestations are expressed as \"deception\" (makar). And no human being can stand upon the ultimate reality (kunnah) of God's attributes. Whoever knows the true nature of knowledge — that his knowledge falls short of encompassing the ultimate reality of things — his fear inevitably magnifies. For this reason, the Messiah (peace be upon him), when it was said to him: \"Did you say to the people: 'Take me and my mother as two gods besides God?'\" replied: \"Glory be to You! It was not mine to say what I had no right to say. If I had said it, You would have known it. You know what is in my self, and I do not know what is in Your Self\" {سبحانك ما يكون لي أن أقول ما ليس لي بحق إن كنت قلته فقد علمته تعلم ما في نفسي ولا أعلم ما في نفسك}. And he said: \"If You punish them, indeed they are Your servants; and if You forgive them...\" {إن تعذبهم فإنهم عبادك وإن تغفر لهم} — to the end of the verse. So he delegated the matter entirely to the divine will (mashī'ah) and removed himself completely from the equation, knowing that he had no say in the affair whatsoever, and that all matters are linked to the divine will in a linkage that exceeds the bounds of rational categories and habitual patterns — such that no judgment can be passed upon them by analogy, nor by conjecture, nor by reckoning (ḥisbān), let alone by verification and certainty. And this is precisely what has rent the hearts of the knowers (ʿārifīn) asunder — for the supreme calamity (al-ṭāmmah al-kubrā) is the linkage of your affair to the will of One who does not care about you: if He destroys you, He has destroyed countless others like you, and He has never ceased in this world to torment them with various kinds of pains and diseases, and to sicken their hearts thereby with disbelief and hypocrisy, and then to perpetuate the punishment upon them for all eternity. Then He informs us about this, saying: \"And had We willed, We would have given every soul its guidance, but the word from Me has taken effect: I will surely fill Hell with jinn and people all together\" {ولو شئنا لآتينا كل نفس هداها ولكن حق القول مني لأملأن جهنم من الجنة والناس أجمعين}. And He Most High said: \"And the word of your Lord has been fulfilled: I will surely fill Hell...\" {وتمت كلمة ربك لأملأن جهنم}. So how should one not fear what has been decreed as a word from eternity (al-azal), and not hope for its reversal? Had the matter been recent, then hopes might extend toward some stratagem regarding it — but there is nothing except submission to it, and the discernment of the hidden precedent (al-sābiqah) from the manifest outward causes upon the heart and the bodily members. For whoever is facilitated toward the causes of evil, and is barred from the causes of good, and whose attachment to this world is firmly secured — it is as if the secret of the prior decree that destined him to wretchedness has been unveiled to him with certainty, since \"everyone is facilitated toward that for which he was created\" {كل ميسر لما خلق له}. And even if all good things were facilitated, and the heart were entirely severed from this world, with its outward and inward aspects turned wholly toward God, this would necessitate a lightening of fear — were continuity in that state to be trusted. But the peril of the final end (khātimah) and the difficulty of steadfastness only fan the flames of fear into greater blaze and prevent them from being extinguished. For how can one feel secure from the change of state, when the believer's heart lies between two fingers of the fingers of the Merciful? And indeed, the heart is more prone to turning than a boiling pot. And the Turner of Hearts (Glory be to Him) has said: \"Indeed, the punishment of their Lord is not to be felt secure from\" {إن عذاب ربهم غير مأمون}. So the most ignorant of people is the one who feels secure from it, while He proclaims the warning against security. And were God to show kindness to His knowing servants by reviving their hearts with the spirit of hope (rajā'), their hearts would still burn from the fire of fear. Thus, the causes of hope are a mercy for God's elect, and the causes of heedlessness are a mercy upon the common folk of creation in one respect — for were the veil to be lifted, souls would perish and hearts would be torn asunder from the fear of the Turner of Hearts. One of the knowers said: \"If fifty were to intervene between me and the One I have known through tawḥīd...\"", "book_title": "Fear and Hope", "section_title_ar": "Section 1051", "section_title_en": "The Reality of Fear and the Station of Abraham, Moses, and the Messenger (Peace Be Upon Them) — On the Inescapable Terror of the Divine Decree", "section_index": 1051, "anchors": "- Root: حسب (ḥ-s-b)\n  * Lisan / Ayn: Core meaning of counting, reckoning, and sufficiency; \"ḥasbī Allāh\" signifies God as the sufficient reckoner.\n  * Al-Raghib (Mufradat): Theological nuance of ḥisāb as divine accounting; \"ḥasbī Allāh\" is a declaration of total reliance on God's sufficiency, transcending mere numerical count.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — reckoning by number; Metaphorical (majāz) — trusting in God's sufficiency as an act of spiritual accounting, where the servant counts God as enough against all else.\n- Root: خوف (kh-w-f)\n  * Lisan / Ayn: Core meaning of fear, dread, and apprehension of harm.\n  * Al-Raghib (Mufradat): Khawf is the expectation of a disliked outcome based on a probable or known sign; it opposes amn (security) and applies to both worldly and otherworldly matters.\n  * Al-Zamakhshari (Asas): Literal — fear of loss or harm; Metaphorical — a \"fearful path\" (ṭarīq khā'if) where danger inheres in the object, and \"takhawwuf\" as gradual diminishment, implying fear's erosive effect on the soul.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: Core meaning of self, soul, breath; the essence of a thing.\n  * Al-Raghib (Mufradat): Nafs as the self or essence (dhāt), as in \"ta'lamu mā fī nafsī\" (You know what is in my self), denoting the innermost reality distinct from the body.\n  * Al-Zamakhshari (Asas): Literal — the soul as animate essence; Metaphorical — \"nafs sā'ilah\" (flowing blood) as the life-principle, and the soul's hidden movements as the locus of divine knowledge.\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: Core meaning of turning, overturning, and transformation.\n  * Al-Raghib (Mufradat): Qalb is the turning of a thing from one state to another; the heart is so named for its constant fluctuation (taqallub) between states.\n  * Al-Zamakhshari (Asas): Literal — physical overturning; Metaphorical — the heart's perpetual oscillation, as in the prophetic hadith of the heart between two fingers of the Merciful, and the \"turning\" of affairs by divine decree.\n- Sibawayh Rule: Rule of Interposition and Apposition (al-ʿaṭf wa al-faṣl) — The periodic structure of \"fa-kayfa lā yakhāfu...\" (How then should one not fear...) employs a rhetorical question governed by an implied causal clause, where the apodosis is suspended across multiple subordinate clauses, requiring the translator to preserve the cumulative force of the argument without breaking the syntactic chain.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Fear and Hope'", "badge": "Hadith"}], "50": [{"arabic": "قال تعالى {ربنا الذي أعطى كل شيء خلقه ثم هدى} وقال تعالى ولولا فضل الله عليكم ورحمته ما زكى منكم أحد أبدا ولكن الله يزكي من يشاء وقال صلى الله عليه وسلم ما من أحد يدخل الجنة إلا برحمة الله تعالى أي بهدايته فقيل ولا أنت يا رسول الله قال ولا أنا (1) وللهداية ثلاث منازل {الأولى} معرفة طريق الخير والشر المشار إليه بقوله تعالى {وهديناه النجدين} وقد أنعم الله تعالى به على كافة عباده بعضه بالعقل وبعضه على لسان الرسل ولذلك قال تعالى {وأما ثمود فهديناهم فاستحبوا العمى على الهدى} فأسباب الهدى هي الكتاب", "english": "PageV04P107\nBut if one does not know what constitutes the welfare of his hereafter—so that he even supposes corruption to be welfare—then from where would mere volition benefit him? There is no benefit in volition, power, and causes except after guidance (hidāyah). For this reason, God—exalted is He—said: {«ربنا الذي أعطى كل شيء خلقه ثم هدى»} \"Our Lord who gave everything its creation, then guided.\" And He said—exalted is He—: {«ولولا فضل الله عليكم ورحمته ما زكى منكم أحد أبدا ولكن الله يزكي من يشاء»} \"And were it not for God's bounty upon you and His mercy, not one of you would ever be purified; but God purifies whom He wills.\" And the Prophet—peace be upon him—said: \"No one enters Paradise except by the mercy of God—exalted is He—,\" that is, by His guidance. So it was said: \"Not even you, O Messenger of God?\" He said: \"Not even I\" (1). And guidance (hidāyah) has three stations (manāzil):", "book_title": "Patience and Gratitude", "section_title_ar": "Section 999", "section_title_en": "The Degrees of Divine Guidance (Hidāyah), Righteous Discernment (Rushd), Straightening (Tasdīd), and Divine Support (Ta'yīd)", "section_index": 999, "anchors": "- Root: هدي (H-D-Y)\n  * Lisan / Ayn: Core meaning of gentle, gracious direction (dalālah bi-luṭf); the root also yields \"gift\" (hadiyyah) and the leading beasts of prey (hawādī) that guide the herd.\n  * Al-Raghib (Mufradat): Guidance is \"directional indication with gentleness\" (dalālah bi-luṭf), distinct from mere intellectual proof; it is a divine act that may be general (to all) or specific (to the elect), and its withholding is a form of abandonment.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"He guided him to the path\" (hadāhu lil-sabīl). Metaphorical (majāz): \"He guided him\" meaning \"he preceded him\" (taqaddamahu), as a leader precedes the caravan; hence guidance is not merely pointing but active leading.\n- Root: رشد (R-SH-D)\n  * Lisan / Ayn: The state of being rightly directed in one's affairs; integrity of judgment; names Rāshid, Rushayd derive from it.\n  * Al-Raghib (Mufradat): Rushd is the opposite of ghayy (error/ruin); it is used like hidāyah but with a nuance of practical, executive discernment—knowing the good AND being moved to pursue it. Al-Raghib explicitly distinguishes the rushd of Abraham (given before, as a special gift) from the mere legal competence (rushd) of an orphan.\n  * Al-Zamakhshari (Asas): Literal: \"A man is rāshid or rashīd\" (possessing rightness in conduct). Metaphorical: \"He is of sound lineage\" (huwa li-rushdah), i.e., legitimate—showing the root's extension to ontological soundness.\n- Root: سدد (S-D-D)\n  * Lisan / Ayn: To aim correctly, to hit the mark; the arrow that flies straight (sadīd); the opposite of deviation (ighrāḍ).\n  * Al-Raghib (Mufradat): (Not in the retrieved scholia, but by extension from the root's usage in the Qur'an, e.g., {wa-saddidū}, \"and be straight/aim rightly\")—it denotes the divine facilitation of the creature's movements so they align with the intended good.\n  * Al-Zamakhshari (Asas): Literal: \"He aimed the arrow and it went straight.\" Metaphorical: \"He was granted success in speech and action\" (sudda li-l-ṣawāb).\n- Root: أيد (A-Y-D)\n  * Lisan / Ayn: Strength, support, reinforcement; the \"aid\" (ayd) of God is His empowering of His servant.\n  * Al-Raghib (Mufradat): (By extension from {إذ أيدتك بروح القدس})—divine reinforcement through a holy spirit, i.e., an immaterial power that fortifies both inner perception (baṣīrah) and outer action.\n  * Al-Zamakhshari (Asas): Literal: \"He strengthened him\" (ayyadahu). Metaphorical: Used for the conferral of spiritual power that makes the servant invincible against error.\n- Sibawayh Rule: Rule of Gradation and Specification (Tartīb wa-Takhṣīṣ) — The author structures a sequence of terms (hidāyah → rushd → tasdīd → ta'yīd) where each subsequent term is syntactically and semantically superordinate, building a hierarchy of divine acts. The particle \"wa-ammā\" (وأما) marks a new topic with contrastive focus, and the anaphoric references (هو، وهي) bind the exposition into a single periodic argument.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "55": [{"arabic": "منها خلقناكم وفيها نعيدكم ومنها نخرجكم تارة أخرى وإنه ليسمع خفق نعالهم إذا ولوا مدبرين حتى يقال يا هذا من ربك وما دينك وما نبيك فيقول ربي الله وديني الإسلام ونبي محمد صلى الله عليه وسلم قال فينتهرأنه انتهارا شديدا وهي آخر فرصة تعرض على الميت فإذا قال ذلك نادى مناد أن قد صدقت وهي معنى قوله تعالى {يثبت الله الذين آمنوا بالقول الثابت} ثم يأتيه آت حسن الوجه طيب الريح حسن الثياب فيقول أبشر برحمة ربك وجنات فيها نعيم مقيم فيقول وأنت فبشرك الله بخير من أنت فيقول أنا عملك الصالح والله ما علمت أن كنت لسريعا إ", "english": "Al-Barā' ibn ʿĀzib said: We went out with the Messenger of God, may God bless him and grant him peace, in the funeral procession of a man from the Anṣār. The Messenger of God, may God bless him and grant him peace, sat at his grave with his head bowed, then said: \"O God, I seek refuge in You from the torment of the grave\" — three times. Then he said: \"Verily, the believer, when he is in the final stage of the Hereafter and the severance from this world, God sends down to him angels whose faces are like the sun, bearing with them his embalming perfume and his shroud. They sit before him as far as his eye can reach. When his soul departs, every angel between heaven and earth prays for him, and every angel in heaven [prays for him], and the gates of heaven are opened — there is no gate but that it yearns for his soul to enter through it. When his soul ascends, it is said: 'O Lord, Your servant so-and-so.' He says: 'Return him, and show him what I have prepared for him of honor, for I promised him: {From it We created you, and into it We shall return you, and from it We shall bring you forth another time} [Ta-Ha/ 55].' And he indeed hears the shuffling of their sandals when they turn away departing, until it is said to him: 'O this one, who is your Lord, and what is your religion, and who is your Prophet?' He says: 'My Lord is God, my religion is Islam, and my Prophet is Muhammad, may God bless him and grant him peace.' He said: Then he is rebuked with a severe rebuke — and this is the last opportunity presented to the dead — and when he says that, a caller calls out: 'He has spoken the truth' — and this is the meaning of His saying, the Exalted: {God establishes those who believe with the firm word} [Ibrahim/ 27]. Then there comes to him a visitor of beautiful countenance, pleasant fragrance, and fine garments, who says: 'Rejoice in the mercy of your Lord and gardens of enduring delight.' He says: 'And you — may God give you good news of good. Who are you?' He says: 'I am your righteous deed. By God, I knew not but that you were swift to the obedience of God and slow to the disobedience of God — so may God reward you with good.' He said: Then a caller calls out: 'Spread for him from the carpets of Paradise, and open for him a gate to Paradise.' So carpets of Paradise are spread for him, and a gate to Paradise is opened for him. He says: 'O God, hasten the establishment of the Hour, so that I may return to my family and my wealth.' He said: And as for the disbeliever — when he is in the final stage of the Hereafter and the severance from this world, there descend to him angels, harsh and severe, bearing with them garments of fire and tunics of molten pitch. They surround him completely. When his soul departs, every angel between heaven and earth curses him, and every angel in heaven [curses him], and the gates of heaven are shut — there is no gate but that it abhors his soul to enter through it. When his soul ascends, it is cast away, and it is said: 'O Lord, Your servant so-and-so — neither heaven nor earth accepted him.' So God, Mighty and Majestic, says: 'Return him, and show him what I have prepared for him of evil, for I promised him: {From it We created you, and into it We shall return you, and from it We shall bring you forth another time}.' And he indeed hears the shuffling of their sandals when they turn away departing, until it is said to him: 'O this one, who is your Lord, and who is your Prophet, and what is your religion?' He says: 'I do not know.' It is said: 'You did not know!' Then there comes to him a visitor of ugly countenance, foul stench, and vile garments, who says: 'Rejoice in the wrath of God and a painful enduring torment.' He says: 'May God give you evil news. Who are you?' He says: 'I am your wicked deed. By God, I knew not but that you were swift in the disobedience of God and slow to the obedience of God — so may God reward you with evil.' He says: 'And you — may God reward you with evil.' Then there is appointed for him a blind, deaf, and mute one, bearing with him an iron mace — were the two heavy species (thaqalān, i.e., jinn and men) to gather upon it to lift it, they could not — and were he to strike a mountain with it, it would become dust. He strikes him with it a blow, and he becomes dust. Then the soul is returned to him, and he strikes him with it between his eyes a blow whose sound is heard by all upon the earths, save the two heavy species. He said: Then a caller calls out: 'Spread for him two planks of fire, and open for him a gate to the Fire.' So two planks of fire are spread for him, and a gate to the Fire is opened for him.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1323", "section_title_en": "The Torments of the Grave and the Visions of the Soul at Death — Section 1323", "section_index": 1323, "anchors": "- Root: قبر (q-b-r)\n  * Lisan / Ayn: The grave as the abode of the dead; the act of interment.\n  * Al-Raghib (Mufradat): The grave is the place of repose for the dead, and the term extends metaphorically to the state of the barzakh (intermediate realm). The Quranic phrase {حتى زرتم المقابر} [التكاثر/ 2] is a metonymy for death itself.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) — the physical grave. Metaphorical (Majaz) — the spiritual state of the soul after death, as in \"رفع قبراه\" (raising one's grave-mound), i.e., arrogance, indicating that the grave's true reality transcends mere earth.\n- Root: ملك (m-l-k)\n  * Lisan / Ayn: Dominion and authority; the angels as emissaries of divine command.\n  * Al-Raghib (Mufradat): \"الملك: هو المتصرف بالأمر والنهي\" — the one who disposes by command and prohibition. Angels are termed \"رسل\" (messengers) of God, as in {الله يصطفي من الملائكة رسلا} [الحج/ 75], and their acts are entirely subordinate to divine will.\n  * Al-Zamakhshari (Asas): Literal — angels as corporeal agents of punishment or mercy. Metaphorical — their true nature is immaterial (laṭīfah rabbāniyyah), imperceptible to the physical senses of the living.\n- Root: روح (r-w-ḥ)\n  * Lisan / Ayn: Breath, spirit, the animating principle.\n  * Al-Raghib (Mufradat): The soul (rūḥ) is a subtle divine reality (laṭīfah rabbāniyyah) that departs the body at death; its extraction is described in degrees of ease or violence according to faith or disbelief.\n  * Al-Zamakhshari (Asas): Literal — the breath of life. Metaphorical — the spiritual essence that perceives the malakūt (invisible dominion) after death, a realm beyond the reach of the corporeal eye.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic structure of the hadith, e.g., \"خرجنا مع رسول الله صلى الله عليه وسلم في جنازة رجل من الأنصار,\" demonstrates how prepositional phrases (مع، في، من) interlock to build a narrative sequence, each clause grammatically complete yet subordinate to the overarching report, mirroring the unbroken chain of transmission (isnād).", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}], "68": [{"arabic": "الأمن وقيل له لا تخف إنك أنت الأعلى ولما ضعفت شوكة المسلمين يوم بدر قال صلى الله عليه وسلم اللهم إن تهلك هذه العصابة لم يبق على وجه الأرض أحد يعبدك // حديث قال يوم بدر اللهم إن تهلك هذه العصابة لم يبق على وجه الأرض أحد يعبدك أخرجه البخاري من حديث ابن عباس بلفظ اللهم إن شئت لم تعبد بعد اليوم الحديث فقال أبو بكر رضي الله تعالى عنه دع عنك مناشدتك ربك فإنه واف لك بما وعدك فكان مقام الصديق رضي الله عنه مقام الثقة بوعد الله وكان مقام رسول الله صلى الله عليه وسلم مقام الخوف من مكر الله وه", "english": "Just as Abraham (peace be upon him), when he was placed in the catapult, said: \"God is sufficient for me\" {حسبي الله} — and this was among the greatest supplications — he was tested and was confronted by Gabriel in mid-air, who said to him: \"Do you have any need?\" He replied: \"As for you, no.\" And that was the fulfillment of the very reality of his words: \"God is sufficient for me.\" So God Most High informed us about him, saying: \"And Abraham who fulfilled\" {وإبراهيم الذي وفى} — that is, fulfilled the requirement of his saying \"God is sufficient for me.\" And in like manner, He informed us about Moses (peace be upon him), where he said: \"Indeed, we fear that he may assault us or that he may transgress\" {إننا نخاف أن يفرط علينا أو أن يطغى}. He said: \"Fear not; indeed, I am with you both; I hear and I see\" {لا تخافا إنني معكما أسمع وأرى}. Yet despite this, when the sorcerers cast their sorcery, Moses conceived within himself a fear — because he did not feel secure from the deception (makar) of God, and the matter became obscure to him — until security was renewed for him, and it was said to him: \"Fear not; indeed, you are the most exalted\" {لا تخف إنك أنت الأعلى}. And when the strength of the Muslims weakened on the Day of Badr, he (peace be upon him) said: \"O God, if You destroy this band, there will remain no one on the face of the earth who worships You\" — a hadith reported on the Day of Badr: \"O God, if You destroy this band, there will remain no one on the face of the earth who worships You,\" transmitted by al-Bukhari from the hadith of Ibn Abbas with the wording: \"O God, if You will, You will not be worshipped after this day\" — to the end of the hadith. So Abu Bakr (may God be pleased with him) said: \"Leave off your importuning of your Lord, for He will surely fulfill what He has promised you.\" Thus, the station of al-Siddiq (may God be pleased with him) was the station of trust in God's promise, while the station of the Messenger of God (peace be upon him) was the station of fear of God's deception (makar) — and this latter is more complete, for it issues only from the perfection of knowledge of God's secrets, the hidden aspects of His acts, and the meanings of His attributes, some of whose manifestations are expressed as \"deception\" (makar). And no human being can stand upon the ultimate reality (kunnah) of God's attributes. Whoever knows the true nature of knowledge — that his knowledge falls short of encompassing the ultimate reality of things — his fear inevitably magnifies. For this reason, the Messiah (peace be upon him), when it was said to him: \"Did you say to the people: 'Take me and my mother as two gods besides God?'\" replied: \"Glory be to You! It was not mine to say what I had no right to say. If I had said it, You would have known it. You know what is in my self, and I do not know what is in Your Self\" {سبحانك ما يكون لي أن أقول ما ليس لي بحق إن كنت قلته فقد علمته تعلم ما في نفسي ولا أعلم ما في نفسك}. And he said: \"If You punish them, indeed they are Your servants; and if You forgive them...\" {إن تعذبهم فإنهم عبادك وإن تغفر لهم} — to the end of the verse. So he delegated the matter entirely to the divine will (mashī'ah) and removed himself completely from the equation, knowing that he had no say in the affair whatsoever, and that all matters are linked to the divine will in a linkage that exceeds the bounds of rational categories and habitual patterns — such that no judgment can be passed upon them by analogy, nor by conjecture, nor by reckoning (ḥisbān), let alone by verification and certainty. And this is precisely what has rent the hearts of the knowers (ʿārifīn) asunder — for the supreme calamity (al-ṭāmmah al-kubrā) is the linkage of your affair to the will of One who does not care about you: if He destroys you, He has destroyed countless others like you, and He has never ceased in this world to torment them with various kinds of pains and diseases, and to sicken their hearts thereby with disbelief and hypocrisy, and then to perpetuate the punishment upon them for all eternity. Then He informs us about this, saying: \"And had We willed, We would have given every soul its guidance, but the word from Me has taken effect: I will surely fill Hell with jinn and people all together\" {ولو شئنا لآتينا كل نفس هداها ولكن حق القول مني لأملأن جهنم من الجنة والناس أجمعين}. And He Most High said: \"And the word of your Lord has been fulfilled: I will surely fill Hell...\" {وتمت كلمة ربك لأملأن جهنم}. So how should one not fear what has been decreed as a word from eternity (al-azal), and not hope for its reversal? Had the matter been recent, then hopes might extend toward some stratagem regarding it — but there is nothing except submission to it, and the discernment of the hidden precedent (al-sābiqah) from the manifest outward causes upon the heart and the bodily members. For whoever is facilitated toward the causes of evil, and is barred from the causes of good, and whose attachment to this world is firmly secured — it is as if the secret of the prior decree that destined him to wretchedness has been unveiled to him with certainty, since \"everyone is facilitated toward that for which he was created\" {كل ميسر لما خلق له}. And even if all good things were facilitated, and the heart were entirely severed from this world, with its outward and inward aspects turned wholly toward God, this would necessitate a lightening of fear — were continuity in that state to be trusted. But the peril of the final end (khātimah) and the difficulty of steadfastness only fan the flames of fear into greater blaze and prevent them from being extinguished. For how can one feel secure from the change of state, when the believer's heart lies between two fingers of the fingers of the Merciful? And indeed, the heart is more prone to turning than a boiling pot. And the Turner of Hearts (Glory be to Him) has said: \"Indeed, the punishment of their Lord is not to be felt secure from\" {إن عذاب ربهم غير مأمون}. So the most ignorant of people is the one who feels secure from it, while He proclaims the warning against security. And were God to show kindness to His knowing servants by reviving their hearts with the spirit of hope (rajā'), their hearts would still burn from the fire of fear. Thus, the causes of hope are a mercy for God's elect, and the causes of heedlessness are a mercy upon the common folk of creation in one respect — for were the veil to be lifted, souls would perish and hearts would be torn asunder from the fear of the Turner of Hearts. One of the knowers said: \"If fifty were to intervene between me and the One I have known through tawḥīd...\"", "book_title": "Fear and Hope", "section_title_ar": "Section 1051", "section_title_en": "The Reality of Fear and the Station of Abraham, Moses, and the Messenger (Peace Be Upon Them) — On the Inescapable Terror of the Divine Decree", "section_index": 1051, "anchors": "- Root: حسب (ḥ-s-b)\n  * Lisan / Ayn: Core meaning of counting, reckoning, and sufficiency; \"ḥasbī Allāh\" signifies God as the sufficient reckoner.\n  * Al-Raghib (Mufradat): Theological nuance of ḥisāb as divine accounting; \"ḥasbī Allāh\" is a declaration of total reliance on God's sufficiency, transcending mere numerical count.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — reckoning by number; Metaphorical (majāz) — trusting in God's sufficiency as an act of spiritual accounting, where the servant counts God as enough against all else.\n- Root: خوف (kh-w-f)\n  * Lisan / Ayn: Core meaning of fear, dread, and apprehension of harm.\n  * Al-Raghib (Mufradat): Khawf is the expectation of a disliked outcome based on a probable or known sign; it opposes amn (security) and applies to both worldly and otherworldly matters.\n  * Al-Zamakhshari (Asas): Literal — fear of loss or harm; Metaphorical — a \"fearful path\" (ṭarīq khā'if) where danger inheres in the object, and \"takhawwuf\" as gradual diminishment, implying fear's erosive effect on the soul.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: Core meaning of self, soul, breath; the essence of a thing.\n  * Al-Raghib (Mufradat): Nafs as the self or essence (dhāt), as in \"ta'lamu mā fī nafsī\" (You know what is in my self), denoting the innermost reality distinct from the body.\n  * Al-Zamakhshari (Asas): Literal — the soul as animate essence; Metaphorical — \"nafs sā'ilah\" (flowing blood) as the life-principle, and the soul's hidden movements as the locus of divine knowledge.\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: Core meaning of turning, overturning, and transformation.\n  * Al-Raghib (Mufradat): Qalb is the turning of a thing from one state to another; the heart is so named for its constant fluctuation (taqallub) between states.\n  * Al-Zamakhshari (Asas): Literal — physical overturning; Metaphorical — the heart's perpetual oscillation, as in the prophetic hadith of the heart between two fingers of the Merciful, and the \"turning\" of affairs by divine decree.\n- Sibawayh Rule: Rule of Interposition and Apposition (al-ʿaṭf wa al-faṣl) — The periodic structure of \"fa-kayfa lā yakhāfu...\" (How then should one not fear...) employs a rhetorical question governed by an implied causal clause, where the apodosis is suspended across multiple subordinate clauses, requiring the translator to preserve the cumulative force of the argument without breaking the syntactic chain.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Fear and Hope'", "badge": "Hadith"}], "72": [{"arabic": "حقيقة الأمر فلم يكترثوا بقول فرعون لأقطعن أيديكم وأرجلكم من خلاف {بل} قالوا لن نؤثرك على ما جاءنا من البينات والذي فطرنا قاقض ما أنت قاض إنما تقضي هذه الحياة الدنيا فإن البيان والكشف يمنع التغيير وأما أصحاب السامري لما كان إيمانهم عن النظر إلى ظاهر الثعبان فلما نظروا إلى عجل السامري وسمعوا خواره تغيروا وسمعوا قوله هذا إلهكم وإله موسى ونسوا أنه لا يرجع إليهم قولا ولا يملك لهم ضرا ولا نفعا فكل من آمن بالنظر إلى ثعبان يكفر لا محالة إذا نظر إلى عجل لأن كليهما من عالم الشهادة والاختلاف والتضاد في عالم الشهادة كثير وأما عالم الملكوت فهو من عند الله تعالى فلذلك لا نجد فيه اختلافا وتضادا أصلا فإن قلت ما ذكرته من الت", "english": "...its mover is Power (al-qudrah) without any doubt. So the seeker (al-sālik) journeyed on to the world of Power, and there he beheld wonders before which all that had preceded seemed contemptible. He asked Power concerning the movement of the right hand, and it said: \"I am but an attribute (innamā anā ṣifah) — ask the Powerful One (al-Qādir), for the reliance is upon the described substances (al-mawṣūfāt), not upon the attributes.\" At that point he almost deviated and unleashed the tongue of questioning with audacity, but he was steadied by the firm word (al-qawl al-thābit), and a caller cried out from behind the veils of the pavilions of the Divine Presence: \"He is not asked about what He does, but they shall be asked\" {«لَا يُسْأَلُ عَمَّا يَفْعَلُ وَهُمْ يُسْأَلُونَ»}. Then the awe of the Presence overwhelmed him, and he fell down stricken, convulsing in his swoon. When he regained consciousness, he said: \"Glory be to You — how magnificent is Your majesty! I repent unto You, and I place my trust in You, and I believe that You are the Sovereign, the Compeller, the One, the Subduer. I fear none but You, I hope for none other than You, and I seek refuge only in Your pardon from Your punishment, and in Your good pleasure from Your wrath. I have nothing but to ask of You and to supplicate before You, and to plead humbly in Your presence, saying: 'Expand my breast that I may know You, and loosen the knot from my tongue that I may praise You.'\"", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 1111", "section_title_en": "The Unification of the Acts — The Journey of the Seekers to the Oneness of the Agent", "section_index": 1111, "anchors": "- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core meaning of measuring, determining, and empowering; al-Qadir as the One whose power is absolute and unbounded.\n  * Al-Raghib (Mufradat): Power (qudrah) when ascribed to God is the negation of incapacity ('ajz); when ascribed to man it is a contingent capacity limited by divine ordainment.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) — \"He is Qadir, Muqtadir, possessor of power\"; metaphorical (majaz) — \"a far-reaching steed\" (ba'id al-qadr), indicating extension of effect.\n- Root: وحد (w-ḥ-d)\n  * Lisan / Ayn: Oneness and singularity; al-Wahid as that which has no part whatsoever.\n  * Al-Raghib (Mufradat): True unity (wahdah) is absolute indivisibility; applied to God exclusively in the sense of unique sovereignty.\n  * Al-Zamakhshari (Asas): \"He is one (wahid), and they are singular (wuhdan)\"; literal unity versus numerical oneness.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as perception of a thing's reality; the mark or sign by which something is known.\n  * Al-Raghib (Mufradat): Knowledge ('ilm) is the apprehension of a thing in its true reality — either grasping the essence or judging its attributes.\n  * Al-Zamakhshari (Asas): Literal — \"I knew not of your news\" (ma 'alimtu bi-khabarika); the knower as one marked by discernment.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — \"Innamā anā ṣifah\" (I am but an attribute) restricts the speaker's essence to being a mere accident, redirecting inquiry to the substantive subject (al-mawṣūf).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monotheism and Reliance'", "badge": "Insight"}], "82": [{"arabic": "وأما المعتزلة فشبهتهم قوله تعالى وإني لغفار لمن تاب وآمن وعمل صالحا ثم اهتدى وقوله تعالى والعصر إن الإنسان لفي خسر إلا الذين آمنوا وعملوا الصالحات وقوله تعالى وإن منكم إلا واردها كان على ربك حتما مقضيا {ثم قال} ثم ننجي الذين اتقوا وقوله تعالى ومن يعص الله ورسوله فإن له نار جهنم وكل آية ذكر الله عز وجل العمل الصالح فيها مقرونا بالإيمان وقوله تعالى ومن يقتل مؤمنا متعمدا فجزاؤه جهنم خالدا فيها وهذه العمومات أيضا مخصوصة بدليل قوله تعالى ويغفر ما دون ذلك لمن يشاء فينبغي أن تبقى له مشيئة في مغفرة ما سوى الشرك وكذلك", "english": "He was asked, \"Which deed is most excellent?\" The Prophet (peace and blessings be upon him) said: \"Islam.\" It was then asked, \"Which aspect of Islam is most excellent?\" He (peace and blessings be upon him) said: \"Faith (Īmān).\" This is evidence for both the distinction (ikhtilāf) between the two terms and their overlap (tadākhul). This usage is the most consistent with the conventions of the language, because faith is a deed among deeds, and it is the most excellent of them. Islam is submission (taslīm), whether by the heart, by the tongue, or by the limbs. The most excellent of these is that which is by the heart, which is the assent (taṣdīq) that is called faith. Using the two terms in a way that indicates distinction, overlap, or even complete synonymy (tarāduf) is all within the bounds of metaphorical usage (tajawwuz) in the language.", "book_title": "Foundations of Belief", "section_title_ar": "Section 99", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 99: On the Distinction, Overlap, and Synonymy of Faith (Īmān) and Submission (Islām), and Their Worldly and Otherworldly Judgments", "section_index": 99, "anchors": "- Root: ايم (A-Y-M)\n  * Lisan / Ayn: Core meaning of remaining unmarried, or a state of being without a spouse; extended metaphorically to describe one who is solitary or without support.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها... والحرب مأيمة، أي: يفرق بين الزوج والزوجة.\" The root carries the sense of separation or a state of lacking union, which informs the theological discussion of what constitutes the essential bond of faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the state of being unmarried; metaphorical (Majaz) usage extends to anything that separates or leaves one bereft. This distinction between literal and metaphorical application is central to the chapter's method.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه... والانقلاب: الانصراف.\" The heart (qalb) is so named for its constant fluctuation and turning. In theological terms, it is the seat of taṣdīq (assent), the immaterial faculty of cognition and conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is physical turning; metaphorical (Majaz) usage is \"قلب الأمور\" — to deliberate, scrutinize, and manage affairs. This supports the distinction between the heart's internal act of assent and the external acts of the limbs.\n- Root: عمل (ʿ-A-M-L)\n  * Lisan / Ayn: Any deed or action performed with purpose and intent.\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد، فهو أخص من الفعل.\" Work is more specific than mere action, as it implies deliberate, intentional agency. It is used for both righteous and sinful deeds, and is the external manifestation of internal conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to physical labor or deeds. The chapter explores whether \"work\" is an integral part of the reality of faith or a separate, consequent requirement.\n- Root: صدق (S-D-Q)\n  * Lisan / Ayn: To be truthful, to speak the truth, to verify.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول.\" Truth and falsehood are primarily properties of speech and reports. Taṣdīq (assent) is the heart's affirmation of the truth of a report, which is the core reality of Īmān.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is truthful speech; metaphorical (Majaz) usage is \"صادق الحملة\" — one who is true and firm in battle or resolve. This shows that taṣdīq is not merely verbal but a firm, internal resolution.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication). This rule governs how restriction (ḥaṣr) is achieved in Arabic, often through particles like \"innamā\" or through contextual specification (takhṣīṣ). The chapter's core argument hinges on how terms like Īmān and Islām are semantically restricted, expanded, or made synonymous through contextual usage (majāz), requiring precise parsing of the predicate and its scope.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'", "badge": "Insight"}], "88": [{"arabic": "وسمعوا خواره تغيروا وسمعوا قوله هذا إلهكم وإله موسى ونسوا أنه لا يرجع إليهم قولا ولا يملك لهم ضرا ولا نفعا فكل من آمن بالنظر إلى ثعبان يكفر لا محالة إذا نظر إلى عجل لأن كليهما من عالم الشهادة والاختلاف والتضاد في عالم الشهادة كثير وأما عالم الملكوت فهو من عند الله تعالى فلذلك لا نجد فيه اختلافا وتضادا أصلا فإن قلت ما ذكرته من التوحيد ظاهر مهما ثبت أن الوسائط والأسباب مسخرات وكل ذلك ظاهر إلا في حركات الإنسان فإنه يتحرك إن شاء ويسكن إن شاء فكيف يكون مسخرا فاعلم أنه لو كان مع هذا يشاء إن أراد أن ي", "english": "...its mover is Power (al-qudrah) without any doubt. So the seeker (al-sālik) journeyed on to the world of Power, and there he beheld wonders before which all that had preceded seemed contemptible. He asked Power concerning the movement of the right hand, and it said: \"I am but an attribute (innamā anā ṣifah) — ask the Powerful One (al-Qādir), for the reliance is upon the described substances (al-mawṣūfāt), not upon the attributes.\" At that point he almost deviated and unleashed the tongue of questioning with audacity, but he was steadied by the firm word (al-qawl al-thābit), and a caller cried out from behind the veils of the pavilions of the Divine Presence: \"He is not asked about what He does, but they shall be asked\" {«لَا يُسْأَلُ عَمَّا يَفْعَلُ وَهُمْ يُسْأَلُونَ»}. Then the awe of the Presence overwhelmed him, and he fell down stricken, convulsing in his swoon. When he regained consciousness, he said: \"Glory be to You — how magnificent is Your majesty! I repent unto You, and I place my trust in You, and I believe that You are the Sovereign, the Compeller, the One, the Subduer. I fear none but You, I hope for none other than You, and I seek refuge only in Your pardon from Your punishment, and in Your good pleasure from Your wrath. I have nothing but to ask of You and to supplicate before You, and to plead humbly in Your presence, saying: 'Expand my breast that I may know You, and loosen the knot from my tongue that I may praise You.'\"", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 1111", "section_title_en": "The Unification of the Acts — The Journey of the Seekers to the Oneness of the Agent", "section_index": 1111, "anchors": "- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core meaning of measuring, determining, and empowering; al-Qadir as the One whose power is absolute and unbounded.\n  * Al-Raghib (Mufradat): Power (qudrah) when ascribed to God is the negation of incapacity ('ajz); when ascribed to man it is a contingent capacity limited by divine ordainment.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) — \"He is Qadir, Muqtadir, possessor of power\"; metaphorical (majaz) — \"a far-reaching steed\" (ba'id al-qadr), indicating extension of effect.\n- Root: وحد (w-ḥ-d)\n  * Lisan / Ayn: Oneness and singularity; al-Wahid as that which has no part whatsoever.\n  * Al-Raghib (Mufradat): True unity (wahdah) is absolute indivisibility; applied to God exclusively in the sense of unique sovereignty.\n  * Al-Zamakhshari (Asas): \"He is one (wahid), and they are singular (wuhdan)\"; literal unity versus numerical oneness.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as perception of a thing's reality; the mark or sign by which something is known.\n  * Al-Raghib (Mufradat): Knowledge ('ilm) is the apprehension of a thing in its true reality — either grasping the essence or judging its attributes.\n  * Al-Zamakhshari (Asas): Literal — \"I knew not of your news\" (ma 'alimtu bi-khabarika); the knower as one marked by discernment.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — \"Innamā anā ṣifah\" (I am but an attribute) restricts the speaker's essence to being a mere accident, redirecting inquiry to the substantive subject (al-mawṣūf).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monotheism and Reliance'", "badge": "Insight"}], "89": [{"arabic": "وسمعوا خواره تغيروا وسمعوا قوله هذا إلهكم وإله موسى ونسوا أنه لا يرجع إليهم قولا ولا يملك لهم ضرا ولا نفعا فكل من آمن بالنظر إلى ثعبان يكفر لا محالة إذا نظر إلى عجل لأن كليهما من عالم الشهادة والاختلاف والتضاد في عالم الشهادة كثير وأما عالم الملكوت فهو من عند الله تعالى فلذلك لا نجد فيه اختلافا وتضادا أصلا فإن قلت ما ذكرته من التوحيد ظاهر مهما ثبت أن الوسائط والأسباب مسخرات وكل ذلك ظاهر إلا في حركات الإنسان فإنه يتحرك إن شاء ويسكن إن شاء فكيف يكون مسخرا فاعلم أنه لو كان مع هذا يشاء إن أراد أن يشاء ولا يشاء إن لم يرد أن يشاء لكان هذا مزلة القدم وموقع ال", "english": "...its mover is Power (al-qudrah) without any doubt. So the seeker (al-sālik) journeyed on to the world of Power, and there he beheld wonders before which all that had preceded seemed contemptible. He asked Power concerning the movement of the right hand, and it said: \"I am but an attribute (innamā anā ṣifah) — ask the Powerful One (al-Qādir), for the reliance is upon the described substances (al-mawṣūfāt), not upon the attributes.\" At that point he almost deviated and unleashed the tongue of questioning with audacity, but he was steadied by the firm word (al-qawl al-thābit), and a caller cried out from behind the veils of the pavilions of the Divine Presence: \"He is not asked about what He does, but they shall be asked\" {«لَا يُسْأَلُ عَمَّا يَفْعَلُ وَهُمْ يُسْأَلُونَ»}. Then the awe of the Presence overwhelmed him, and he fell down stricken, convulsing in his swoon. When he regained consciousness, he said: \"Glory be to You — how magnificent is Your majesty! I repent unto You, and I place my trust in You, and I believe that You are the Sovereign, the Compeller, the One, the Subduer. I fear none but You, I hope for none other than You, and I seek refuge only in Your pardon from Your punishment, and in Your good pleasure from Your wrath. I have nothing but to ask of You and to supplicate before You, and to plead humbly in Your presence, saying: 'Expand my breast that I may know You, and loosen the knot from my tongue that I may praise You.'\"", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 1111", "section_title_en": "The Unification of the Acts — The Journey of the Seekers to the Oneness of the Agent", "section_index": 1111, "anchors": "- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core meaning of measuring, determining, and empowering; al-Qadir as the One whose power is absolute and unbounded.\n  * Al-Raghib (Mufradat): Power (qudrah) when ascribed to God is the negation of incapacity ('ajz); when ascribed to man it is a contingent capacity limited by divine ordainment.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) — \"He is Qadir, Muqtadir, possessor of power\"; metaphorical (majaz) — \"a far-reaching steed\" (ba'id al-qadr), indicating extension of effect.\n- Root: وحد (w-ḥ-d)\n  * Lisan / Ayn: Oneness and singularity; al-Wahid as that which has no part whatsoever.\n  * Al-Raghib (Mufradat): True unity (wahdah) is absolute indivisibility; applied to God exclusively in the sense of unique sovereignty.\n  * Al-Zamakhshari (Asas): \"He is one (wahid), and they are singular (wuhdan)\"; literal unity versus numerical oneness.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as perception of a thing's reality; the mark or sign by which something is known.\n  * Al-Raghib (Mufradat): Knowledge ('ilm) is the apprehension of a thing in its true reality — either grasping the essence or judging its attributes.\n  * Al-Zamakhshari (Asas): Literal — \"I knew not of your news\" (ma 'alimtu bi-khabarika); the knower as one marked by discernment.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — \"Innamā anā ṣifah\" (I am but an attribute) restricts the speaker's essence to being a mere accident, redirecting inquiry to the substantive subject (al-mawṣūf).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monotheism and Reliance'", "badge": "Insight"}, {"arabic": "ضعيف لا يملك له ضرا ولا نفعا وهل ذلك إلا لأنه يظن أن ذلك العبد أقدر على تحصيل أغراضه من الله وأنه أولى بالتقريب إليه من الله إذ آثره على ملك الملوك فجعله مقصود عبادته وأي استهزاء يزيد على رفع العبد فوق المولى فهذا من كبائر المهلكات ولهذا", "english": "The evidence for this is what was narrated from ʿĀ'ishah, may God be pleased with her, that the Messenger of God, peace and blessings be upon him, intended one day to go out to the Companions, so he looked into the well-water [as a mirror] and straightened his turban and his hair. She said: \"Do you do that, O Messenger of God?\" He said: \"Yes. Indeed God the Exalted loves that a servant beautify himself for his brothers when he goes out to them.\" // The ḥadīth of ʿĀ'ishah — he intended to go out to his Companions and looked into the well-water, straightening his turban and his hair — this ḥadīth was transmitted by Ibn ʿAdī in al-Kāmil, and it has already preceded in the Book of Purification.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 816", "section_title_en": "On the Status (Jāh) Sought Without Greed, and the Ruling on Showing Off in Worldly Adornments", "section_index": 816, "anchors": "- Root: جاه (w-j-h)\n  * Lisan / Ayn: The root conveys \"face, front, prominence, standing before others\"; al-jāh is derived from wajh (face), denoting one's elevated position in the eyes of people.\n  * Al-Raghib (Mufradat): Al-jāh is \"al-manzilah 'inda al-sulṭān\" — a station of honor before authority; in theological terms, it is a worldly accident (ʿaraḍ) tied to social estimation, not a spiritual virtue.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"wajuhā\" — to be honored; metaphorical (majāz): seeking jāh is \"talab al-ri'āsah\" (pursuit of leadership), which is permissible in itself but becomes blameworthy when it diverts the heart from God.\n- Root: راءى (r-'-y)\n  * Lisan / Ayn: Arā'a — to show, to display; riyā' is \"al-taẓāhur bi al-ṭā'ah qaṣdan li al-ḥaqīqah\" — feigning obedience for the sake of being seen.\n  * Al-Raghib (Mufradat): Riyā' is a branch of shirk (associationism), because the actor directs his act toward a creature rather than the Creator; it nullifies the act's spiritual reward (thawāb).\n  * Al-Zamakhshari (Asas): Literal: \"rā'āhu\" — he saw him; metaphorical: \"rā'ā bi 'amalihi\" — he showed off his deed, i.e., he made the creature his qiblah (focus) in worship.\n- Root: تلبيس (l-b-s)\n  * Lisan / Ayn: Labasa — to clothe, to cover; talbīs is \"khalṭ al-shay' bi ghayrihi\" — confusing a thing with another, i.e., deception by cloaking falsehood in the garment of truth.\n  * Al-Raghib (Mufradat): Talbīs is \"ishkāl al-amr wa tashbīhuhu\" — obscuring an affair and making it ambiguous; it is a moral vice because it corrupts epistemic trust.\n  * Al-Zamakhshari (Asas): Literal: \"labastu al-thawb\" — I wore the garment; metaphorical: \"labbasa 'alayhi al-amr\" — he made the matter obscure to him, i.e., he dressed falsehood in the appearance of sincerity.\n- Sibawayh Rule: Bāb al-ḥaṣr wa al-taqyīd bi-innamā (Restriction and Specification with \"innamā\") — used to delimit the scope of permissibility, prohibition, and nullification in the conditional rulings below.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Status and Ostentation'", "badge": "Hadith"}], "94": [{"arabic": "إنه قال يا ابن آدم اذكرني بعد صلاة الفجر ساعة وبعد صلاة العصر ساعة أكفك ما بينهما (3) وإذا ظهر فضل ذلك فليقعد ولا يتكلم إلى طلوع الشمس بل ينبغي أن تكون وظيفته إلى الطلوع أربعة أنواع أدعية وأذكار ويكررها في سبحة وقراءة قرآن وتفكر أما الأدعية فكلما يفرغ من صلاته فليبدأ وليقل اللهم صلي على محمد وعلى آل محمد وسلم اللهم أنت السلام ومنك السلام وإليك يعود السلام حينا ربنا بالسلام وأدخلنا دار السلام تباركت يا ذا الجلال والإكرام ثم يفتتح الدعاء بما كان يفتتح به رسول الله صل", "english": "Now, the first watch (al-wird al-awwal) is that which extends from the dawn prayer (ṣalāt al-ṣubḥ) until sunrise (ṭulūʿ al-shams). When the servant has completed his obligatory prayer, he should remain seated in his place of prayer, occupying himself with the remembrance of God most High, until the sun has risen. For it has been reported that the Messenger of God, peace and blessings be upon him, said: \"That I should sit in my assembly, remembering God most High therein, from the morning prayer until sunrise, is more beloved to me than freeing four slaves.\" {«لأن أقعد في مجلسي أذكر الله تعالى فيه من صلاة الغداة إلى طلوع الشمس أحب إلي من أن أعتق أربع رقاب»} And it is related that he, peace and blessings be upon him, when he had prayed the morning prayer, would sit in his place of prayer until the sun rose; and in some versions [it is added] that he would pray two rakʿahs—that is, after sunrise. Concerning the virtue of this [practice], an incalculable number of reports have come down. Al-Ḥasan related that the Messenger of God, peace and blessings be upon him, used to mention, among what he recounted of his Lord's mercy, that He said: \"O son of Adam, remember Me for an hour after the dawn prayer and for an hour after the afternoon prayer, and I shall suffice you for what lies between them.\" {«يا ابن آدم اذكرني بعد صلاة الفجر ساعة وبعد صلاة العصر ساعة أكفك ما بينهما»}", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 260", "section_title_en": "The Daily Liturgy of the Devout Servant: The First Watch (After Dawn Prayer until Sunrise)", "section_index": 260, "anchors": "- Root: ذكر (dhakara)\n  * Lisan / Ayn: Remembrance, invocation, mention; the opposite of forgetfulness (nisyān).\n  * Al-Raghib (Mufradat): Remembrance of God (dhikr) is the heart's presence with the Divine, ranging from the tongue's utterance to the heart's contemplation; it is the noblest act when accompanied by presence of heart.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): verbal mention. Metaphorical (majāz): the heart's steadfastness in knowledge of God, which is the reality of dhikr.\n- Root: صلا (ṣallā)\n  * Lisan / Ayn: Prayer (ṣalāh); root meaning of supplication and blessing; also \"to kindle a fire\" (as in ṣalā al-nār).\n  * Al-Raghib (Mufradat): Ṣalāh is the servant's standing before God in humility and devotion, comprising praise, recitation, bowing, and prostration; its perfection lies in the heart's presence.\n  * Al-Zamakhshari (Asas): Literal: the ritual prayer with its pillars. Metaphorical: supplication (duʿā') and blessing (taṣliyah) upon the Prophet.\n- Root: ورد (warada)\n  * Lisan / Ayn: To arrive at water; a portion or share of something that comes regularly.\n  * Al-Raghib (Mufradat): The daily portion (wird) of devotion—a set liturgy of prayers, recitations, and remembrances that the servant regularly performs at appointed times.\n  * Al-Zamakhshari (Asas): Literal: arriving at a watering place. Metaphorical: the soul's regular approach to the fountain of divine grace through prescribed acts of worship.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd) — governing the precise enumeration of the four functions (adʿiyah, adhkār, qirā'ah, fikr) after the dawn prayer, each specified by its own governing verb and object.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}, {"arabic": "نفسه وقال منك أتيت لو كان فيك خير لأعطيت حاجتك فنزل إليه ملك وقال يا ابن آدم ساعتك هذه خير من عبادتك التي مضت وقد قضى الله حاجتك وقال عبد الله بن قيس كنا في غزاة لنا فحضر العدو فصيح في الناس فقاموا إلى المصاف في يوم شديد الريح وإذا رجل أمامي وهو يخاطب نفسه ويقول أي نفسي ألم أشهد مشهد كذا فقلت لي أهلك وعيالك فأطعتك ورجعت ألم أشهد مشهد كذا وكذا فقلت لي أهلك وعيالك فأطعتك ورجعت والله لأعرضنك اليوم على الله أخذك أو تركك فقلت لأرمقنه اليوم فرمقته فحمل الناس على عدوهم فكان في أوائلهم ثم أن العدو حمل على الناس فانكشفوا فكان", "english": "A woman said: \"You speak of what you do not know. Indeed, God has a covenant upon me which I shall never break: I shall not lay you upon the earth in sleep for a full year, except due to an obstructing illness or a departing intellect. Shame upon you! Do you not feel ashamed? How often you rebuke, yet from your error you do not desist.\" He said: And he began to weep, unaware of my presence. When I saw that, I departed and left him.", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 1241", "section_title_en": "The Discipline of the Self: Accounts of the Pious in Reckoning and Punishing Their Souls", "section_index": 1241, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, spirit; that which breathes and desires; the locus of blameworthy and praiseworthy traits.\n  * Al-Raghib (Mufradat): Al-nafs denotes the soul as the principle of life and moral responsibility; its reckoning (muḥāsabah) is the essence of religious discipline.\n  * Al-Zamakhshari (Asas): Literal: the self as animate entity. Metaphorical: \"دفق نفسه\" (he poured out his self, i.e., his blood) — here, the self is addressed as a distinct interlocutor, a rhetorical personification of the lower impulses.\n- Sibawayh Rule: باب النداء والتوبيخ (The Chapter of Direct Address and Rebuke) — The self is vocatively addressed (يا نفسي) as a second party, establishing the grammatical frame of moral confrontation.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'", "badge": "Insight"}], "98": [{"arabic": "القلوب فوالله الذي لا إله إلا هو ما ذلك إلا لأن المعلمين علموا لغير الله تعالى والمتعلمين تعلموا لغير الله تعالى وفي التوراة والإنجيل مكتوب لا تطلبوا علم ما لم تعلموا حتى تعملوا بما علمتم وقال حذيفة رضي الله عنه إنكم في زمان من ترك فيه عشر ما يعلم هلك وسيأتي زمان من عمل فيه بعشر ما يعلم نجا وذلك لكثرة البطالين واعلم أن مثل العالم مثل القاضي وقد قال صلى الله عليه وسلم القضاة ثلاثة قاض قضى بالحق وهو يعلم فذلك في الجنة وقاض قضى بالجور وهو يعلم أو لا يعلم فهو في النار وقاض ق", "english": "Know that the scholar who does not act upon his knowledge is condemned by the Book, the Sunnah, and the sayings of the sages. God, exalted be He, said: {«يا أيها الذين آمنوا لم تقولون ما لا تفعلون * كبر مقتا عند الله أن تقولوا ما لا تفعلون»} (\"O you who believe, why do you say what you do not do? Most hateful it is to God that you say what you do not do\"). And He said: {«أتأمرون الناس بالبر وتنسون أنفسكم»} (\"Do you command people to righteousness while you forget yourselves?\"). And He said: {«ومن الناس من يعجبك قوله في الحياة الدنيا ويشهد الله على ما في قلبه وهو ألد الخصام»} (\"And among people is he whose speech pleases you in the worldly life, and he calls God to witness what is in his heart, yet he is the fiercest of opponents\").", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 54", "section_title_en": "Section 54", "section_index": 54, "anchors": "*(Anchors established)*", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}], "107": [{"arabic": "ثم انظر كيف يساقون بعد البعث والنشور حفاة عراة غرلا إلى أرض المحشر أرض بيضاء قاع صفصف لا ترى فيها عوجا ولا أمتا ولا ترى عليها ربوة يختفى الإنسان وراءها ولا وهدة ينخفض عن الأعين فيها بل هو صعيد واحد بسيط لا تفاوت فيه يساقون إليه زمرا فسبحان من جمع الخلائق على اختلاف أصنافهم من أقطار الأرض إذ ساقهم بالراجفة تتبعها الرادفة والراجفة هى النفخة الأولى والرادفة هى النفخة الثانية وحقيق لتلك القلوب أن تكون يومئذ واجفة ولتلك الأبصار أن تكون خاشعة قال رسول الله صلى الله عليه وسلم يحشر الناس يوم القيامة على أرض بيضاء عفراء كقرص النقي ليس فيها معلم", "english": "Know, O seeker, that after the resurrection and the arising from the graves, consider how they are driven — barefoot, naked, uncircumcised — to the land of the Gathering. It is a white land, a level plain, smooth and even, wherein you see no crookedness nor any curve, and upon which you see no hillock behind which a person might hide, nor any hollow that would sink him from view. Rather, it is one single, simple expanse with no variation whatsoever, and to it they are driven in troops. Glory be to Him who gathered all creatures, despite their differing kinds, from the far quarters of the earth, when He drove them by the Rajīfah (the Trembling Blast) followed by the Rādifah (the Second Blast). The Rajīfah is the first trumpet-blast, and the Rādifah is the second. Rightly are those hearts on that day agitated, and rightly are those eyes humbled. The Messenger of God, peace and blessings be upon him, said: «The people will be gathered on the Day of Resurrection upon a white, ʿafrāʾ earth, like a pure loaf of bread, upon which there is no marker for anyone.» The narrator said: \"ʿAfrah is a whiteness that is not brilliant, and al-naqī is the bread purified of its bran and husk. 'No marker' means no building that conceals, and no unevenness that repels the eye.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1336", "section_title_en": "The Description of the Trumpet-Blast and the Land of the Gathering", "section_index": 1336, "anchors": "- Root: صور (ṣ-w-r)\n  * Lisan / Ayn: Core root denotes form/shape; the \"trumpet\" (ṣūr) is that which shapes and transforms states through its blast.\n  * Al-Raghib (Mufradat): Theological nuance — the ṣūr is the instrument of cosmic transformation, linking the two blasts (rajīfah and rādifah) to the divine command of resurrection.\n  * Al-Zamakhshari (Asas): Literal — a horn/trumpet; metaphorical — the blast as the signal of universal upheaval, not a mere physical sound.\n- Root: حشر (ḥ-sh-r)\n  * Lisan / Ayn: Core meaning: to gather, drive, or assemble a multitude forcibly.\n  * Al-Raghib (Mufradat): Theologically, ḥashr is the divine gathering of all creatures to the plain of reckoning, distinct from ordinary aggregation by its comprehensiveness and compulsion.\n  * Al-Zamakhshari (Asas): Literal — herding animals; metaphorical — the compelled assembly of humanity before God, stripped of all worldly coverings.\n- Root: عفر (ʿ-f-r)\n  * Lisan / Ayn: ʿafrāʾ denotes a whitish hue tinged with redness or dust-color; the \"white\" earth of the gathering is not pure white but a dusty, pale expanse.\n  * Al-Raghib (Mufradat): The earth's transformation (tabdīl al-arḍ) signifies a new creation, not mere alteration of accidents.\n  * Al-Zamakhshari (Asas): Literal — color description; metaphorical — the earth's purity from sin and bloodshed, as the narrator glosses ʿafrāʾ as \"whiteness not brilliant.\"\n- Sibawayh Rule: Interposition of descriptive clauses (ṣifah) between subject and predicate — the extended adjectival chains (e.g., \"arḍ bayḍāʾ qāʿ ṣafṣaf...\") delay the main verb to build cumulative, awe-inducing imagery, permissible due to the semantic completeness of each descriptive unit.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}], "109": [{"arabic": "يملكون الشفاعة إلا من أذن له الرحمن ورضى له قولا فتأمل في طول هذا اليوم وشدة الانتظار فيه حتى يخف عليك انتظار الصبر عن المعاصى فى عمرك المختصر واعلم أن من طال انتظاره فى الدنيا للموت لشدة مقاساته للصبر عن الشهوات فإنه يقصر انتظاره فى ذلك اليوم خاصة قال رسول الله صلى الله عليه وسلم لما سئل عن طول ذلك اليوم فقال والذي نفسي بيده إنه ليخفف على المؤمن حتى يكون أهون عليه من الصلاة المكتوبة يصليها فى الدنيا (2) فاجتهد أن تكون من أولئك المؤمنين فما دام يبقى لك نفس من عمرك فالأمر إليك والاستعداد ب", "english": "It is a Day on which all creatures stand, their eyes fixed in a stare, their hearts split asunder. They are not spoken to, and no one looks into their affairs. They stand for three hundred years, eating not therein a single eating, drinking not therein a single drink, and finding not therein the breath of any breeze. Ka'b and Qatadah said: \"The Day when mankind shall stand before the Lord of the Worlds\" {«يوم يقوم الناس لرب العالمين»} (Al-Mutaffifin: 6) — they stand for the measure of three hundred years. Nay — 'Abdullah ibn 'Amr said: The Messenger of Allah, peace be upon him, recited this verse, then said: \"How will it be with you when Allah gathers you as arrows are gathered in a quiver, for fifty thousand years, and He does not look upon you?\" (1) And Al-Hasan said: What is your opinion of a Day on which they stand upon their feet for the measure of fifty thousand years, eating not therein a single eating, drinking not therein a single drink — until, when their necks are severed by thirst and their innards are burnt by hunger, they are turned away to the Fire and given to drink from a boiling spring whose heat has reached its peak and whose scorching blast has grown fierce. Then when the utmost exhaustion reaches them, beyond what they have strength to bear, they speak one to another, seeking one who is honored before his Lord to intercede on their behalf. They cling to no prophet but that he repels them, saying: \"Leave me, leave me — my own self, my own self; my own affair has occupied me from the affair of another.\" And each one excuses himself by the severity of God's wrath, saying: \"Today our Lord has become wrathful with a wrath the like of which He has never been wrathful before, nor will He be wrathful with its like after.\" — until our Prophet, peace be upon him, intercedes for those to whom permission is granted therein; they possess not intercession save for him whom the Merciful has permitted and with whose word He is pleased {«لا يملكون الشفاعة إلا من أذن له الرحمن ورضي له قولا»} (Ta-Ha: 109).", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1338", "section_title_en": "The Description of the Length of the Day of Resurrection", "section_index": 1338, "anchors": "- Root: يوم (yawm)\n  * Lisan / Ayn: Core meaning is the period from sunrise to sunset; extended to any span of time, however long.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the term denotes any duration whatsoever, as in {«وذكرهم بأيام الله»} (Ibrahim: 5), where \"days\" are attributed to God as an honorific for His mighty acts.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to the solar day; metaphorical (Majaz) usage extends to \"days of the Arabs\" meaning their battles and epochal events. Here, the \"day\" of fifty thousand years is a real duration, not a metaphor.\n- Root: نفس (nafs)\n  * Lisan / Ayn: The self, soul, or spirit; also breath.\n  * Al-Raghib (Mufradat): \"نفسه: ذاته\" — God's \"Self\" is His very Essence. In the prophetic oath \"والذي نفسي بيده\" (By Him in Whose hand is my soul), the soul is the living self.\n  * Al-Zamakhshari (Asas): Literal: the soul/spirit; metaphorical: \"دفق نفسه\" (he poured out his soul = his blood). The Prophet's cry \"نفسي نفسي\" (myself, myself) is literal self-reference — each prophet is absorbed in his own deliverance.\n- Root: اكل (akl)\n  * Lisan / Ayn: Eating, consuming food.\n  * Al-Raghib (Mufradat): \"الأكل: تناول المطعم\" — partaking of nourishment; metaphorically extended to fire consuming fuel.\n  * Al-Zamakhshari (Asas): Literal: eating; metaphorical: \"أكل مالي وشربه\" (he ate my wealth and drank it = he fed it to people). The negation \"لا يأكلون فيه أكلة\" (they eat not therein a single eating) is literal — total deprivation of food.\n- Root: شرب (sharb)\n  * Lisan / Ayn: Drinking; also a share or portion.\n  * Al-Raghib (Mufradat): \"الشرب: تناول كل مائع\" — partaking of any liquid; \"الشرب: النصيب منه\" — the share of it.\n  * Al-Zamakhshari (Asas): Literal: drinking water, milk, medicine; metaphorical: \"أشرب الثوب حمرة\" (the garment was saturated with redness). \"ولا يشربون فيه شربة\" (nor drink therein a single drink) is literal — total deprivation of drink.\n- Sibawayh Rule: Interposition of the subject between the conditional and its apodosis; also the construction of \"حتى إذا\" (until when) marking a temporal sequence where the subordinate clause (انقطعت أعناقهم) is completed before the main clause (انصرف بهم) — a periodic structure requiring careful temporal parsing.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "113": [{"arabic": "والقناعة وقيل هو الذى يحدث مشاهدة وتقوى ولذلك قال تعالى {لعلهم يتقون أو يحدث لهم ذكرا} وإن أردت أن تفهم كيفية تغير الحال بالفكر فمثاله ما ذكرناه من أمر الآخرة فإن الفكر يعرفنا أن الآخرة أولى بالإيثار فإذا رسخت هذه المعرفة يقينا", "english": "Thus, thought is more excellent than the totality of works. For this reason it was said: \"An hour of reflection is better than a year of worship\" (tafakkur sāʿah khayr min ʿibādah sanah). And it was said [of the reflector] that he is the one who moves from detested things (al-makārih) to beloved things (al-maḥābb), and from desire (al-raghbah) and greed (al-ḥirṣ) to renunciation (al-zuhd) and contentment (al-qanāʿah). And it was said that he is the one who engenders witnessing (mushāhadah) and god-fearingness (taqwā). Therefore God Most High said: {«لعلهم يتقون أو يحدث لهم ذكرا»} — \"That perhaps they may fear [God], or that it may produce for them a remembrance\" (Q. 20:113). And if you wish to understand how the state is changed by thought, its example is what we have mentioned concerning the matter of the Hereafter: for thought makes us know that the Hereafter is more worthy of preference; and when this knowledge becomes firmly rooted as certainty (yaqīnan)...", "book_title": "Contemplation", "section_title_ar": "Section 1260", "section_title_en": "On Reflection and Contemplation — The Fruits of Thought and the Hierarchy of Knowledge", "section_index": 1260, "anchors": "- Root: فكر (F-K-R)\n  * Lisan / Ayn: Core meaning of turning a matter over in the mind, deliberating.\n  * Al-Raghib (Mufradat): \"الفكرة: قوة مطرقة للعلم إلى المعلوم، والتفكر: جولان تلك القوة بحسب نظر العقل\" — Thought is the power that drives knowledge toward the known; reflection is the circulation of that power according to rational consideration, unique to humans.\n  * Al-Zamakhshari (Asas): Literal sense of mental movement and circulation; metaphorically, \"مازالت فكرتك مغاص الدرر\" — one's thought as a diver's plunge for pearls.\n- Root: عرف (ʿ-R-F)\n  * Lisan / Ayn: To know by tracing the mark (ʿaraf) of a thing.\n  * Al-Raghib (Mufradat): \"المعرفة والعرفان: إدراك الشيء بتفكر وتدبر لأثره\" — Knowledge (maʿrifah) is the apprehension of a thing through reflection and deliberation upon its trace/effect; it is more specific than ʿilm.\n  * Al-Zamakhshari (Asas): Literal: to recognize; metaphorical: \"لأعرفن لك ما صنعت\" — to requite/reward one for one's deed.\n- Root: ذكر (Dh-K-R)\n  * Lisan / Ayn: To remember, to recall, to keep present in the mind.\n  * Al-Raghib (Mufradat): Remembrance as the opposite of forgetfulness (nisyān); the heart's retention of what was previously apprehended.\n  * Al-Zamakhshari (Asas): Literal: verbal mention; metaphorical: the heart's presence with what is remembered.\n- Root: عبر (ʿ-B-R)\n  * Lisan / Ayn: To cross over, to traverse from one side to another.\n  * Al-Raghib (Mufradat): ʿIʿtibār (consideration) is derived from ʿubūr (crossing) — passing from known things to unknown things.\n  * Al-Zamakhshari (Asas): Literal: crossing a valley or river; metaphorical: interpreting a dream (ʿabara al-ruʾyā) — passing from the image to its meaning.\n- Sibawayh Rule: باب الترادف والتغاير (Synonymy and Distinction) — Terms may share a single referent (musammā) yet differ in semantic specification (takhṣīṣ), like al-ṣārim, al-muhannad, and al-sayf all denoting the sword but from different aspects.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'", "badge": "Insight"}], "114": [{"arabic": "في الجنة ولا أبالي وهؤلاء في النار ولا أبالي (1) فتعالى الله الملك الحق لا يسئل عما يفعل وهم يسئلون ولنقتصر على هذا القدر اليسير من ذكر عجائب القلب فإن استقصاءه لا يليق بعلم المعاملة وإنما ذكرنا منه ما يحتاج إليه لمعرفة أغوار علوم المعاملة وأسرارها لينتفع بها من لا يقنع بالظواهر ولا يجتزئ بالقشر عن اللباب بل يتشوق إلى معرفة دقائق حقائق الأسباب وفيما ذكرناه كفاية له ومقنع إن شاء الله تعالى والله ولي التوفيق تم كتاب عجائب القلب ولله الحمد والمنة ويتلوه كتاب رياضة النفس وتهذيب الأخلاق والحمد لله وحده وصلى الله على ك", "english": "I say: Know that when the Shayṭān prevails and the heart inclines to its own kind among the parties of the Shayṭān, turning away from the party of God—Exalted is He—and His saints, and aiding the party of the Shayṭān and His enemies, then there flows upon its bodily members, by virtue of the prior decree, that which is the cause of its distance from God—Exalted is He. But if the angelic attributes are predominant over the heart, the heart does not lend its ear to the Shayṭān's seduction, nor to his incitement toward the immediate world, nor to his belittling of the matter of the Hereafter. Rather, it inclines to the party of God—Exalted is He—and obedience appears upon its members in accordance with what has preceded in the decree. Thus, the heart of the believer is between two fingers of the fingers of the All-Merciful—that is, between the mutual tugging of these two hosts—and this is the meaning of \"turning\" (taqlīb): the transition from one party to another. As for perpetual constancy, whether with the party of the angels or with the party of the Shayṭān, that is rare on both sides. These acts of obedience and disobedience emerge from the treasuries of the Unseen into the world of witness by way of the treasury of the heart, for it is among the treasuries of the Malakūt. And when they do emerge, they become signs by which the masters of hearts recognize the prior decree. For whomever is created for Paradise, the means of obedience are made easy for him; and whomever is created for the Fire, the means of disobedience are made easy for him, and evil companions are given sway over him, and the rule of the Shayṭān is cast into his heart. For by various kinds of deceptions he beguiles the foolish, saying: \"God is Merciful, so do not care\"; and \"All people do not fear God, so do not oppose them\"; and \"Life is long, so be patient until you repent tomorrow.\" He promises them and fills them with desires—{يَعِدُهُمْ وَيُمَنِّيهِمْ وَمَا يَعِدُهُمُ الشَّيْطَانُ إِلَّا غُرُورًا} \"He promises them and fills them with desires, and the Shayṭān promises them nothing but delusion\" {النساء/120}. He promises them repentance and fills them with hopes of forgiveness, and thus destroys them, by God's permission, through these ruses and what runs in their course. So he expands their hearts to accept delusion and constricts them from accepting the truth. And all of that is by God's decree and destiny: {فَمَن يُرِدِ اللَّهُ أَن يَهْدِيَهُ يَشْرَحْ صَدْرَهُ لِلْإِسْلَامِ وَمَن يُرِدْ أَن يُضِلَّهُ يَجْعَلْ صَدْرَهُ ضَيِّقًا حَرَجًا كَأَنَّمَا يَصَّعَّدُ فِي السَّمَاءِ} \"Whomsoever God wishes to guide, He expands his breast to Islam; and whomsoever He wishes to lead astray, He makes his breast narrow and constricted, as though he were climbing into the sky\" {الأنعام/125}. {إِن يَنصُرْكُمُ اللَّهُ فَلَا غَالِبَ لَكُمْ وَإِن يَخْذُلْكُمْ فَمَن ذَا الَّذِي يَنصُرُكُم مِّن بَعْدِهِ} \"If God helps you, none can overcome you; and if He forsakes you, who is there to help you after Him?\" {آل عمران/160}. He is the Guide and the Misleader; He does what He wills and decrees what He desires. There is no repeller of His judgment and no reverser of His decree. He created Paradise and created for it its people, and employed them in obedience; and He created the Fire and created for it its people, and employed them in disobedience. And He made known to creation the mark of the people of Paradise and the people of the Fire, saying: {إِنَّ الْأَبْرَارَ لَفِي نَعِيمٍ وَإِنَّ الْفُجَّارَ لَفِي جَحِيمٍ} \"Verily, the righteous shall be in bliss, and verily, the wicked shall be in the Blazing Fire\" {الانفطار/13-14}. Then He—Exalted is He—said, as related from His Prophet, peace be upon him: \"These are in Paradise, and I do not care; and these are in the Fire, and I do not care.\" Exalted is God, the King, the Truth! {لَا يُسْأَلُ عَمَّا يَفْعَلُ وَهُمْ يُسْأَلُونَ} \"He is not questioned about what He does, but they shall be questioned\" {الأنبياء/23}.", "book_title": "Disciplining the Soul", "section_title_ar": "Section 611", "section_title_en": "The Explanation of the Heart's Rapid Fluctuation and the Division of Hearts Between Change and Constancy", "section_index": 611, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: Core meaning of turning, overturning, and revolving a thing from one face to another; the heart is so named for its constant oscillation.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart's essence is its perpetual turning and redirection; its fluctuation is not accidental but constitutive of its nature.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): physical overturning. Metaphorical (Majaz): \"رجل قلب حول: يقلب الأمور ويحتال\" — the heart's movement between the two hosts (jundān) is a real, dynamic turnover of allegiance.\n- Root: شيط (sh-y-t)\n  * Lisan / Ayn: Burning, scorching, or spoiling meat by over-smoking; blood going to waste.\n  * Al-Raghib (Mufradat): The Shayṭān is so named for his being burned and banished from mercy.\n  * Al-Zamakhshari (Asas): Metaphorical: \"شاط دمه إذا بطل\" — the Shayṭān's work is to render the servant's spiritual life wasted and nullified, as blood spilled in vain.\n- Root: حزب (ḥ-z-b)\n  * Lisan / Ayn: A group or party with cohesion and strength; al-Ḥayzabūn (the old woman) shows the root's extension to a gathered mass.\n  * Al-Raghib (Mufradat): \"الحزب: جماعة فيها غلظ\" — the party of God (ḥizb Allāh) versus the party of the Shayṭān (ḥizb al-Shayṭān) are two opposing, organized camps in cosmic conflict.\n  * Al-Zamakhshari (Asas): Literal: a band of partisans. Metaphorical: \"قرأ حزبه من القرآن\" — a portion assigned; here, the heart is assigned to one of the two parties by divine decree.\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Measuring and smoothing; creating as precise estimation.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — creation is origination upon a just measure; God's creative act entails the pre-ordainment of ends.\n  * Al-Zamakhshari (Asas): Literal: shaping leather before cutting. Metaphorical: \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation of Paradise and Hellfire and their inhabitants is an act of wise, pre-eternal determination.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The phrase \"إنما ذكرنا منه ما يحتاج إليه\" restricts the author's purpose: only the necessary measure of the heart's wonders is expounded, not exhaustive treatment, signaling a deliberate boundary of the science of practical religion (ʿilm al-muʿāmalah).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "لنبيه صلى الله عليه وسلم {ولا تعجل بالقرآن من قبل أن يقضي إليك وحيه} وهذا لأن الأعمال ينبغي أن تكون بعد التبصرة والمعرفة والتبصرة تحتاج إلى تأمل وتمهل والعجلة تمنع من ذلك وعند الاستعجال يروج الشيطان شره على الإنسان من حيث لا يدري فقد روي أنه لما ولد عيسى بن مريم عليه السلام أتت الشياطين إبليس فقالوا أصبحت الأصنام قد نكست رءوسها فقال هذا حادث مكانكم فطار حتى أتي خافقي الأرض فلم يجد شيئا ثم وجد عيسى عليه السلام قد ولد وإذا الملائكة حافين به فرجع إليهم فقال إن نبيا قد ولد البارحة ما حملت أنثى قط ولا وضعت إلا وأنا", "english": "And among its great gateways is satiety from food, even if it be lawful and pure. For satiety strengthens the lusts, and the lusts are the weapons of Satan. It has been related that Iblis appeared to Yahya ibn Zakariyya (peace be upon them both), and he saw upon him attachments of every kind of thing. He said to him: \"O Iblis, what are these attachments?\" He said: \"These are the lusts by which I overcome the son of Adam.\" He said: \"Is there anything among them [that you use against me]?\" He said: \"Perhaps I make you satiated, and so I weigh you down from prayer and from remembrance.\" He said: \"Is there anything other than that?\" He said: \"No.\" He said: \"Upon God, I shall never fill my belly with food ever again.\" Iblis then said to him: \"And upon God, I shall never advise a Muslim ever again.\"", "book_title": "Disciplining the Soul", "section_title_ar": "Section 601", "section_title_en": "The Revival of the Religious Sciences — Book on Hope and Fear, Section 601: The Great Gateways of Satan's Ingress into the Heart", "section_index": 601, "anchors": "- Root: كذب (kadhaba)\n  * Lisan / Ayn: To lie, to falsify; the core sense of contradicting reality with speech.\n  * Al-Raghib (Mufradat): In theological usage, denotes the antithesis of ṣidq (truthfulness) — a rupture in the correspondence between inward conviction and outward expression.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — utterance contrary to fact; metaphorical (majāz) — the breaking of a promise or covenant, as when Satan says \"they will not belie me\" meaning they will not break their word to me.\n- Root: حرص (ḥaraṣa)\n  * Lisan / Ayn: Intense eager desire for something, covetousness; the soul's grasping beyond its need.\n  * Al-Raghib (Mufradat): A blameworthy trait in the Quranic lexicon, being the unrestrained appetite of the soul for worldly increase; it is the root of Adam's transgression.\n  * Al-Zamakhshari (Asas): Literal — the eager pursuit of provision; metaphorical — the soul's insatiable craving that overrides rational restraint.\n- Root: شبع (shabi'a)\n  * Lisan / Ayn: Satiety, fullness of the stomach; the cessation of hunger.\n  * Al-Raghib (Mufradat): In the moral theology of the Revival, satiety is not merely physical but a state that invigorates the lower appetites (shahawāt), which are the very weapons of Satan.\n  * Al-Zamakhshari (Asas): Literal — fullness of the belly; metaphorical — the satiety that breeds heedlessness (ghaflah) and weighs down the limbs from obedience.\n- Root: عجل (ʿajila)\n  * Lisan / Ayn: Haste, urgency; acting before the proper time.\n  * Al-Raghib (Al-Mufradat): \"العجلة: طلب الشيء وتحريه قبل أوانه، وهو من مقتضى الشهوة، فلذلك صارت مذمومة في عامة القرآن حتى قيل: «العجلة من الشيطان»\" — Haste is the seeking of a thing before its due time, and it proceeds from lust, therefore it is blameworthy throughout the Quran.\n  * Al-Zamakhshari (Asas): Literal — swiftness of movement; metaphorical — acting without deliberation (tathabbut), which opens the door to Satan's deception.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a governing word and its governed prepositional phrase when the intervening clause is complete in itself, as in the periodic constructions of this section where conditional clauses and parenthetical citations are interposed between the subject (the gateways) and their explanatory predicates.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Disciplining the Soul'", "badge": "Du'a"}], "116": [{"arabic": "فقال وما هو قال إياك والكبر فإنه أول ذنب عصي الله به ثم قرأ {وإذ قلنا للملائكة اسجدوا لآدم فسجدوا إلا إبليس} الآية وإياك والحرص فإنه أخرج آدم من الجنة أمكنه الله سبحانه من جنة عرضها السموات والأرض يأكل منها إلا شجرة واحدة نهاه الله عنها فأكل منها فأخرجه الله تعالى منها ثم قال {اهبطوا منها} إلى آخر الآية وإياك والحسد فإنما قتل ابن آدم أخاه حين حسده ثم قرأ {واتل عليهم نبأ ابني آدم بالحق} الآيات وإذا ذكر أصحاب رسول الله صلى الله عليه وسلم فأمسك وإذا ذكر القدر فاسكت وإذا ذكرت النجوم فاسكت وقال بكر بن عبد الله كان رجل يغشى بعض الملوك فيقوم بحذاء الملك ف", "english": "Know that envy (ḥasad) is likewise among the fruits of rancor (ḥiqd), and rancor is among the fruits of anger (ghaḍab) — so envy is a branch of a branch, while anger is the root of the root. Then envy has, among its blameworthy branches, that which can scarcely be enumerated. And there have come down, specifically in condemnation of envy, many reports (akhbār). The Messenger of God, may God bless him and grant him peace, said: {«Envy consumes good deeds just as fire consumes wood»} (1). The ḥadīth: {«Do not cut one another off, nor turn your backs on one another, nor hate one another»} — agreed upon (muttafaq ʿalayh), and it has already preceded. (2) The ḥadīth of Anas: \"We were sitting one day with the Messenger of God, may God bless him and grant him peace, when he said: 'There will now come upon you from this mountain pass a man from among the people of Paradise'\" — the ḥadīth in its entirety, and in it: that man said, \"I do not find in myself any rancor toward any of the Muslims, nor envy of anyone for the good that God has given him.\" Narrated by Aḥmad with a sound chain (isnād) upon the condition of the two Shaykhs (al-Bukhārī and Muslim), and narrated by al-Bazzār, and the man was named in one of its narrations as Saʿd — though in it there is Ibn Lahīʿah. (3) The ḥadīth: {«Three things from which no one escapes: suspicion, slander, and envy»} — and in another narration: \"And few are those who escape them.\" It was related by Ibn Abī al-Dunyā in his book \"Dhamm al-Ḥasad\" (The Condemnation of Envy) from the ḥadīth of Abū Hurayrah — though in its chain there are Yaʿqūb ibn Muḥammad al-Zuhrī and Mūsā ibn Yaʿqūb al-Zamaʿī, both of whom the majority of scholars have declared weak. The second narration was also related by Ibn Abī al-Dunyā from the narration of ʿAbd al-Raḥmān ibn Muʿāwiyah, and it is mursal (broken chain) and weak. Al-Ṭabarānī has something similar from the ḥadīth of Ḥārithah ibn al-Nuʿmān, and it has already preceded in the section on the afflictions of the tongue. And in one narration: {«Three things from which no one escapes — and few are those who escape them»} — so this narration affirms the possibility of deliverance. And he, may God bless him and grant him peace, said: {«There has crept upon you the disease of the nations before you: envy and hatred. And hatred is the clipper — I do not say it clips the hair, but rather it clips the religion. By Him in whose hand is the soul of Muḥammad, you shall not enter Paradise until you believe, and you shall not believe until you love one another. Shall I not inform you of that which will establish this for you? Spread peace (salām) among you»} (4). And he, may God bless him and grant him peace, said: {«Poverty almost becomes unbelief, and envy almost overcomes destiny (qadar)»} (5). And he, may God bless him and grant him peace, said: {«Indeed, my community will be afflicted with the disease of the nations.» They said: \"And what is the disease of the nations?\" He said: {«Extravagance, arrogance, accumulation, rivalry in worldly things, mutual distance, and mutual envy — until transgression (baghy) comes, and then destruction (harj)»} (6). And he, may God bless him and grant him peace, said: {«Do not show gloating (shamātah) over your brother, lest God heal him and afflict you»} (7). And it is narrated that Moses, peace be upon him, when he hastened to his Lord, Exalted is He, saw a man in the shade of the Throne (ʿArsh) and envied him his station (ghabaṭahu), saying: \"This one is honored before his Lord.\" So he asked his Lord, Exalted is He, to inform him of his name, but He did not inform him, and said: \"I shall tell you of three of his deeds: he did not envy people for what God had given them of His bounty, he was not undutiful to his parents, and he did not go about with slander (namīmah).\" And Zechariah, peace be upon him, said: God, Exalted is He, said: {«The envier is an enemy of My blessing, resentful of My decree, dissatisfied with My apportioning which I have apportioned among My servants»}. And he, may God bless him and grant him peace, said: {«The thing I most fear for my community is that wealth will increase among them, and they will envy one another and fight one another»} (1). And he, may God bless him and grant him peace, said: {«Seek help in fulfilling your needs by keeping them secret, for everyone who possesses a blessing is envied»} (2). And he, may God bless him and grant him peace, said: {«Indeed, the blessings of God have enemies.» It was said: \"And who are they?\" He said: {«Those who envy people for what God has given them of His bounty»} (3). The ḥadīth: {«Six will enter the Fire before the Reckoning by a year.» It was said: \"O Messenger of God, who are they?\" He said: {«The unjust rulers»} — the ḥadīth — and in it: {«And the scholars who envy»}. Narrated by Abū Manṣūr al-Daylamī from the ḥadīth of Ibn ʿUmar and Anas with two weak chains of transmission.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 718", "section_title_en": "Section 718 — On Envy (Ḥasad): Its Roots, Branches, and Blameworthy Fruits", "section_index": 718, "anchors": "- Root: حسد (Ḥ-S-D)\n  * Lisan / Ayn: Core meaning of wishing for removal of a blessing from its possessor, rooted in spite and resentment.\n  * Al-Raghib (Mufradat): \"الحسد: تمني زوال نعمة من مستحق لها\" — Envy is the desire for the removal of a blessing from one who rightly deserves it, sometimes accompanied by active striving to effect its removal. The believer envies not, but the hypocrite does.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"حسده على نعمة الله\" — to envy him for God's blessing. Metaphorical (majāz): \"إن الحسد يأكل الجسد\" — envy consumes the body, as fire consumes wood, indicating its destructive spiritual effect.\n- Root: حدث (Ḥ-D-TH)\n  * Lisan / Ayn: Origination after non-existence; bringing into being after nothingness.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination is a thing's coming to be after it was not. The ḥadīth (report) is so-called for its temporal proximity to the event it narrates.\n  * Al-Zamakhshari (Asas): Literal: \"هو حدث من الأحداث\" — he is a youth among youths. Metaphorical: \"صاروا أحاديث\" — they became subjects of talk, indicating fame or infamy spread by tongues.\n- Root: ملك (M-L-K)\n  * Lisan / Ayn: Possession, dominion, sovereignty; the one who possesses and disposes.\n  * Al-Raghib (Mufradat): \"الملك: هو المتصرف بالأمر والنهي\" — dominion is disposal by command and prohibition. Two kinds: actual possession/sovereignty, and the power/capacity to exercise it.\n  * Al-Zamakhshari (Asas): Literal: \"ملكت فلانة\" — he married her (possessed her in wedlock). Metaphorical: \"ملك نفسه عند الغضب\" — he mastered himself at the moment of anger, i.e., self-restraint.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — When the Prophet (ﷺ) says \"إنما قتل ابن آدم أخاه حين حسده\" (It was only envy that led the son of Adam to kill his brother), the restrictive particle إنما confines the cause of the first murder to envy alone, isolating it as the sole efficient cause of that primordial transgression.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Envy'", "badge": "Ethics"}], "117": [{"arabic": "قال الله لهما إن هذا عدو لك ولزوجك فلا يخرجنكما من الجنة فتشقى إن لك ألا تجوع فيها ولا تعرى وأنك لا تظمأ فيها ولا تضحى ومع أنه لم ينه إلى عن شجرة واحدة وأطلق له وراء ذلك ما أراد فإذا لم يأمن من نبي من الأنبياء وهو في الجنة دار الأمن والسعادة من كيد الشيطان فكيف يجوز لغيره أن يأمن في دار", "english": "If you say: \"Whoever finds in himself a dislike of ostentation (riyā'), and this dislike compels him to refuse it, yet he is not entirely free from the soul's inclination toward it, its love for it, and its striving after it — except that he dislikes his own love and his own inclination, and it is not beloved to him — is he then among the ranks of the ostentatious?\" — Know that God has not burdened His servants except with what they can bear. It is not within the servant's power to prevent the Devil from his incitements (nazaghāt), nor to suppress nature entirely so that it neither inclines to lusts nor strives after them. His utmost limit is only that he confront his lust with a dislike born of his knowledge of consequences, his understanding of religion, and his roots of faith in God and the Last Day. When he does this, he has reached the utmost limit of performing what he has been charged with.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 829", "section_title_en": "On the Degrees of Resistance to Ostentation and the Devil's Wiles — Section 829", "section_index": 829, "anchors": "- Root: شيط (Shayṭ)\n  * Lisan / Ayn: Core meaning of burning, scorching, or spoiling by fire; the Devil as that which burns and destroys.\n  * Al-Raghib (Mufradat): الشيطان as the one who leads astray and incites; his \"نزغات\" (incitements) are his piercing stings of temptation.\n  * Al-Zamakhshari (Asas): Literal: \"شاط اللحم\" (meat scorched/ruined). Metaphorical: \"أشاط دمه\" (shed his blood vainly) — the Devil's aim is to ruin the soul's deeds.\n- Root: كره (K-R-H)\n  * Lisan / Ayn: Dislike, aversion, abhorrence; the opposite of love (ḥubb) and desire (mīl).\n  * Al-Raghib (Mufradat): The moral faculty of repulsion against sin; a trait of faith (īmān) distinguishing the believer's higher self from the lower nature.\n  * Al-Zamakhshari (Asas): Literal: \"كرهت الشيء\" (I disliked it). Metaphorical: The heart's rejection of the soul's base inclinations as an act of worship.\n- Root: نفس (Nafs)\n  * Lisan / Ayn: The self, soul, or spirit; the seat of desires and passions.\n  * Al-Raghib (Mufradat): النفس as the lower commanding soul (النفس الأمارة) that inclines to lusts, distinct from the intellect (عقل) and faith.\n  * Al-Zamakhshari (Asas): Literal: \"نفس سائلة\" (flowing blood/life). Metaphorical: The inner self that must be opposed when it inclines to ostentation.\n- Root: جهد (J-H-D) / مجادلة (Jadal)\n  * Lisan / Ayn: Striving, exertion, argumentation; from جدل (twisting ropes tightly).\n  * Al-Raghib (Mufradat): المجادلة as disputation that can distract from divine remembrance (ذكر الله).\n  * Al-Zamakhshari (Asas): Literal: \"جادله\" (he argued with him). Metaphorical: The soul's engagement with the Devil's whispers as a subtle trap, diverting from sincere worship.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to delimit the four ranks of resistance, each defined by what it exclusively does or omits.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Status and Ostentation'", "badge": "Insight"}], "118": [{"arabic": "قال الله لهما إن هذا عدو لك ولزوجك فلا يخرجنكما من الجنة فتشقى إن لك ألا تجوع فيها ولا تعرى وأنك لا تظمأ فيها ولا تضحى ومع أنه لم ينه إلى عن شجرة واحدة وأطلق له وراء ذلك ما أراد فإذا لم يأمن من نبي من الأنبياء وهو في الجنة دار الأمن والسعادة من كيد الشيطان فكيف يجوز لغيره أن يأمن في دار", "english": "If you say: \"Whoever finds in himself a dislike of ostentation (riyā'), and this dislike compels him to refuse it, yet he is not entirely free from the soul's inclination toward it, its love for it, and its striving after it — except that he dislikes his own love and his own inclination, and it is not beloved to him — is he then among the ranks of the ostentatious?\" — Know that God has not burdened His servants except with what they can bear. It is not within the servant's power to prevent the Devil from his incitements (nazaghāt), nor to suppress nature entirely so that it neither inclines to lusts nor strives after them. His utmost limit is only that he confront his lust with a dislike born of his knowledge of consequences, his understanding of religion, and his roots of faith in God and the Last Day. When he does this, he has reached the utmost limit of performing what he has been charged with.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 829", "section_title_en": "On the Degrees of Resistance to Ostentation and the Devil's Wiles — Section 829", "section_index": 829, "anchors": "- Root: شيط (Shayṭ)\n  * Lisan / Ayn: Core meaning of burning, scorching, or spoiling by fire; the Devil as that which burns and destroys.\n  * Al-Raghib (Mufradat): الشيطان as the one who leads astray and incites; his \"نزغات\" (incitements) are his piercing stings of temptation.\n  * Al-Zamakhshari (Asas): Literal: \"شاط اللحم\" (meat scorched/ruined). Metaphorical: \"أشاط دمه\" (shed his blood vainly) — the Devil's aim is to ruin the soul's deeds.\n- Root: كره (K-R-H)\n  * Lisan / Ayn: Dislike, aversion, abhorrence; the opposite of love (ḥubb) and desire (mīl).\n  * Al-Raghib (Mufradat): The moral faculty of repulsion against sin; a trait of faith (īmān) distinguishing the believer's higher self from the lower nature.\n  * Al-Zamakhshari (Asas): Literal: \"كرهت الشيء\" (I disliked it). Metaphorical: The heart's rejection of the soul's base inclinations as an act of worship.\n- Root: نفس (Nafs)\n  * Lisan / Ayn: The self, soul, or spirit; the seat of desires and passions.\n  * Al-Raghib (Mufradat): النفس as the lower commanding soul (النفس الأمارة) that inclines to lusts, distinct from the intellect (عقل) and faith.\n  * Al-Zamakhshari (Asas): Literal: \"نفس سائلة\" (flowing blood/life). Metaphorical: The inner self that must be opposed when it inclines to ostentation.\n- Root: جهد (J-H-D) / مجادلة (Jadal)\n  * Lisan / Ayn: Striving, exertion, argumentation; from جدل (twisting ropes tightly).\n  * Al-Raghib (Mufradat): المجادلة as disputation that can distract from divine remembrance (ذكر الله).\n  * Al-Zamakhshari (Asas): Literal: \"جادله\" (he argued with him). Metaphorical: The soul's engagement with the Devil's whispers as a subtle trap, diverting from sincere worship.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to delimit the four ranks of resistance, each defined by what it exclusively does or omits.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Status and Ostentation'", "badge": "Insight"}], "121": [{"arabic": "قال آدم فهل وجدت فيها {وعصى آدم ربه فغوى} قال نعم قال أفتلومني على", "english": "I say: Know that what we have mentioned concerning the state of patience and what we have elaborated in the Book of Patience and Gratitude is sufficient for this purpose. For patience cannot be realized except after the attainment of fear (*khawf*) and hope (*rajāʾ*). This is because the first of the stations of religion is certainty (*yaqīn*), which is an expression for the strength of faith in God — may He be exalted — in the Last Day, Paradise, and Hellfire. This certainty, by necessity, stirs up fear of the Fire and hope for the Garden. And hope and fear together strengthen one for patience. For Paradise has been enveloped by distasteful things (*huffat bil-makārih*), so none can bear them except by the strength of hope; and the Fire has been enveloped by lusts (*huffat bil-shahawāt*), so none can suppress them except by the strength of fear. For this reason, ʿAlī — may God honor his face — said: \"Whoever yearns for Paradise turns away from lusts, and whoever dreads the Fire desists from forbidden things.\"", "book_title": "Fear and Hope", "section_title_ar": "Section 1048", "section_title_en": "The Station of Fear (Khawf) — Its Two Degrees and the Path to Certainty", "section_index": 1048, "anchors": "- Root: خوف (Khawf)\n  * Lisan / Ayn: Core root denotes trepidation, apprehension, and the state of being afraid; its verbal forms encompass both the internal emotion and the external causing of fear in another.\n  * Al-Raghib (Mufradat): Fear is \"the anticipation of something disliked, based on a conjectured or known indication,\" standing in direct opposition to *amn* (security). It applies to both worldly and otherworldly matters, as in {«يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا»} (They call upon their Lord in fear and hope).\n  * Al-Zamakhshari (Asas): Literal (*haqiqah*): \"I feared for my wealth\" — direct, unmediated dread of a known cause. Metaphorical (*majaz*): \"A fearful road\" — where the road itself is described as fearsome because of what it contains, or \"the journey consumed the camel's hump little by little,\" i.e., gradual diminution as if out of fear.\n- Root: عرف (ʿArifa)\n  * Lisan / Ayn: To know by tracing a thing's distinctive mark (*ʿaraf*); recognition through discernment of identifying features.\n  * Al-Raghib (Mufradat): \"Knowledge (*maʿrifah*) and recognition (*ʿirfān*): the apprehension of a thing through reflection and deliberation upon its trace — more specific than mere knowledge (*ʿilm*).\" It is said of a human that he \"knows God\" (*yaʿrifu Allāh*), not that he \"knows God\" (*yaʿlamu Allāh*) transitively to a single object, because human knowledge of God is through contemplating His effects, not grasping His essence.\n  * Al-Zamakhshari (Asas): Literal: \"I will surely make you recognize what I have done\" — i.e., requite you for it. Recognition here is tied to direct encounter and consequence.\n- Root: صبر (Ṣabr)\n  * Lisan / Ayn: Restraint and holding back; endurance in constriction.\n  * Al-Raghib (Mufradat): \"Patience: self-restraint within hardship... the withholding of the soul upon what reason and Law require, or from what they require withholding it from.\" Its specific names vary by context: in battle it is courage; in calamity it is patience proper; against desire it is continence.\n  * Al-Zamakhshari (Asas): Literal: \"I bore patiently what I dislike, and refrained from what I love.\" Metaphorical: \"My hand does not endure the cold\" — attributing endurance to a limb as a vehicle for the self's capacity.\n- Sibawayh Rule: Restriction and Focused Predication (باب الحصر والتقييد بإنما) — The construction \"إنما يخشى الله من عباده العلماء\" (Only the learned among His servants fear God) restricts the predicate of true, vision-based fear exclusively to the scholars, distinguishing it from the general, imitative fear of the common believers.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Fear and Hope'", "badge": "Afterlife"}, {"arabic": "شهواتهما حتى أكلا منها فبدت لهما سوآتهما والبطن على التحقيق ينبوع الشهوات ومنبت الأدواء والآفات إذ يتبعها شهوة الفرج وشدة الشبق إلى المنكوحات ثم تتبع شهوة الطعام والنكاح شدة الرغبة في الجاه والمال اللذين هما وسيلة إلى التوسع في المنكوحات والمطعومات ثم يتبع استكثار المال والجاه أنواع الرعونات وضروب المنافسات والمحاسدات ثم يتولد بينهما آفة الرياء وغائلة التفاخر والتكاثر والكبرياء ثم يتداعى ذلك إلى الحقد والحسد والعداوة والبغضاء ثم يفضي ذلك بصاحبه إلى اقتحام البغي والمنكر والفحشاء وك", "english": "And praise belongs to God alone, and blessings upon our master Muḥammad, upon his Family, his Companions, and upon every chosen servant from among the people of the earth and the heavens. And my success is only through God; upon Him I rely and unto Him I turn in repentance.", "book_title": "Harms of the Tongue", "section_title_ar": "Section 638", "section_title_en": "Section 638", "section_index": 638, "anchors": "*(Anchors established)*", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Harms of the Tongue'", "badge": "Ethics"}, {"arabic": "وأما آدم عليه السلام فقيل فيه وعصى آدم ربه فغوى ثم اجتباه ربه فتاب عليه وهدى وقد عاتب الله نبيه صلى الله عليه وسلم في الإعراض عن عبد والإقبال على عبد وهما في العبودية سيان ولكن في الحال مختلفان فقال وأما من جاءك يسعى وهو يخشى فأنت عنه تلهى وقال فى الآخرة أما من استغنى فأنت له تصدى وكذلك أمره بالقعود مع طائفة فقال عز وجل وإذا جاءك الذين يؤمنون بآياتنا فقل سلام عليكم وأمره بالإعراض عن غيرهم فقال وإذا رأيت الذين يخوضون في آياتنا فأعرض عنهم حتى قال فلا تقعد بعد الذكرى مع القوم الظالمبن وقال تعالى واصبر نفسك مع الذين", "english": "As for Adam (peace be upon him), it was said concerning him: {«وعصى آدم ربه فغوى»} \"And Adam disobeyed his Lord, so he went astray\" (Q. 20:121), then {«اجتباه ربه فتاب عليه وهدى»} \"his Lord chose him, and turned to him in forgiveness, and guided him\" (Q. 20:122).", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1187", "section_title_en": "On the Varieties of Divine Proximity (Al-Inbisāṭ) and Awe (Al-Haybah) in the States of the Prophets and Saints", "section_index": 1187, "anchors": "- Root: بسط (B-S-T)\n  * Lisan / Ayn: Core meaning is \"to spread out, extend, expand\" — both physically (basting a garment) and metaphorically.\n  * Al-Raghib (Mufradat): Theological nuance: \"بسط الشيء: نشره وتوسيعه\" — used for expansion of mercy, favor, and the soul's comfort. In Kalam, it contrasts with *qabḍ* (contraction/withholding).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"بسط الثوب والفراش إذا نشره.\" Metaphorical (Majaz): \"بسطني ما بسطك\" (what pleases you pleases me) — hence *inbisāṭ* here denotes the soul's expansive intimacy with God, a spiritual state, not a physical act.\n- Root: أبلس (B-L-S)\n  * Lisan / Ayn: \"أبلس: انقطعت حجته ويئس\" — to be reduced to silence, to despair.\n  * Al-Raghib (Mufradat): \"الإبلاس: الحزن المعترض من شدة اليأس\" — the despair of Iblis is a theological state of being cut off from mercy.\n  * Al-Zamakhshari (Asas): Literal: despair/silence. Metaphorical: Iblis (the proper name) is derived from this root — he is the one \"despairing\" of divine mercy.\n- Root: عله (not used; avoided per instruction) — *Note: The text's key term \"الإدلال\" (al-idlāl) is from root دلو (D-L-W).*\n- Root: دلو (D-L-W)\n  * Lisan / Ayn: \"دلا الدلو: أخرجها من البئر\" — to draw water from a well; hence *iddalā'a* (إدلال) means to advance boldly, relying on a familiar bond.\n  * Al-Raghib (Mufradat): Not a primary Quranic term, but lexically implies confident approach based on prior intimacy.\n  * Al-Zamakhshari (Asas): Literal: lowering the bucket. Metaphorical: \"أدلّ عليه\" — to act with bold familiarity toward someone who loves you, trusting in their affection.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Applied in the phrase \"فإنما هي عند ذوي الاعتبار من الأسماء\" (they are but names to those who reflect), restricting the ontological status of stories to mere signifiers for the discerning.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "124": [{"arabic": "جدير بأن يكون هو المراد بقوله تعالى {ومن أعرض عن ذكري فإن له معيشة ضنكا ونحشره يوم القيامة أعمى} وبقوله عز وجل {كذلك أتتك آياتنا فنسيتها وكذلك اليوم تنسى} أي تركتها ولم تنظر إليها ولم تعبأ بها فإن المقصر في الأمر يقال إنه نسي الأمر وتلاوة القرآن حق تلاوته هو أن يشترك فيه اللسان والعقل والقلب فحظ اللسان تصحيح الحروف بالترتيل وحظ العقل تفسير المعاني وحظ القلب الاتعاظ والتأثر بالانزجار والائتمار فاللسان يرتل والعقل يترجم والقلب يتعظ التاسع الترقي وأعني به أن يترقى إلى أن يسمع الكلام من الله عز وجل لا من نفسه فد", "english": "For this reason, Yūsuf ibn Asbāṭ said: \"I intend to recite the Qur'an, but when I recall what is in it, I fear abhorrence (al-maqt), so I turn instead to glorification (al-tasbīḥ) and seeking forgiveness (al-istighfār).\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 231", "section_title_en": "** The Revival of the Religious Sciences — Section 231: On the Inward Conditions of Qur'anic Recitation (Continued)", "section_index": 231, "anchors": "**\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"الوجل: استشعار الخوف\" — the stirring of fear/apprehension within\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف. يقال: وجل يوجل وجلا، فهو وجل. قال تعالى: {إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم}\" — the theological state of the heart's trembling upon remembrance of God\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"رجل وجل، وقوم وجال، وقد وجل وجلا\" — the physical/emotional state of fear. Metaphorical (Majaz): The heart's trembling as the seat of spiritual perception\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — turning and transforming\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه، كقلب الثوب، وقلب الإنسان\" — the heart as that which is constantly turning/transforming between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — physical turning. Metaphorical: \"قلب المعلم الصبيان: صرفهم إلى بيوتهم\" — the heart's turning toward or away from spiritual realities\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, spirit — that which is breathed\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul as the animating principle; also the self as the locus of blameworthy attributes\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس ومنفس\" — preciousness. Metaphorical: \"دفق نفسه أي دمه\" — the self as that which must be transcended in spiritual realization\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise delimitation of spiritual states (أحوال) and their hierarchical gradation (درجات)\n\n---\n\n#", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "126": [{"arabic": "ونحشره يوم القيامة أعمى} وبقوله عز وجل {كذلك أتتك آياتنا فنسيتها وكذلك اليوم تنسى} أي تركتها ولم تنظر إليها ولم تعبأ بها فإن المقصر في الأمر يقال إنه نسي الأمر وتلاوة القرآن حق تلاوته هو أن يشترك فيه اللسان والعقل والقلب فحظ اللسان تصحيح الحروف بالترتيل وحظ العقل تفسير المعاني وحظ القلب الاتعاظ والتأثر بالانزجار والائتمار فاللسان يرتل والعقل يترجم والقلب يتعظ التاسع الترقي وأعني به أن يترقى إلى أن يسمع الكلام من الله عز وجل لا من نفسه فدرجات القراءة ثلاث أدناها ان يقدر العبد كأنه يقرؤه على الله عز وجل واقفا بين يدي", "english": "For this reason, Yūsuf ibn Asbāṭ said: \"I intend to recite the Qur'an, but when I recall what is in it, I fear abhorrence (al-maqt), so I turn instead to glorification (al-tasbīḥ) and seeking forgiveness (al-istighfār).\"", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 231", "section_title_en": "** The Revival of the Religious Sciences — Section 231: On the Inward Conditions of Qur'anic Recitation (Continued)", "section_index": 231, "anchors": "**\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"الوجل: استشعار الخوف\" — the stirring of fear/apprehension within\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف. يقال: وجل يوجل وجلا، فهو وجل. قال تعالى: {إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم}\" — the theological state of the heart's trembling upon remembrance of God\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"رجل وجل، وقوم وجال، وقد وجل وجلا\" — the physical/emotional state of fear. Metaphorical (Majaz): The heart's trembling as the seat of spiritual perception\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — turning and transforming\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه، كقلب الثوب، وقلب الإنسان\" — the heart as that which is constantly turning/transforming between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — physical turning. Metaphorical: \"قلب المعلم الصبيان: صرفهم إلى بيوتهم\" — the heart's turning toward or away from spiritual realities\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, spirit — that which is breathed\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul as the animating principle; also the self as the locus of blameworthy attributes\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس ومنفس\" — preciousness. Metaphorical: \"دفق نفسه أي دمه\" — the self as that which must be transcended in spiritual realization\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise delimitation of spiritual states (أحوال) and their hierarchical gradation (درجات)\n\n---\n\n#", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}], "129": [{"arabic": "كقوله عز وجل ولولا كلمة سبقت من ربك لكان لزاما وأجل مسمى معناه لولا الكلمة وأجل مسمى لكان لزاما ولولاه لكان نصبا كاللزام وقوله تعالى يسألونك كأنك حفي عنها أي يسألونك عنها كأنك حفي بها وقوله عز وجل لهم مغفرة ورزق كريم كما أخرجك ربك من بيتك بالحق فهذا الكلام غير متصل وإنما هو عائد إلى قوله السابق قل الأنفال لله والرسول كما أخرجك ربك من بيتك بالحق أي فصارت أنفال الغنائم لك إذ أنت راض بخروجك وهم كارهون فاعترض بين الكلام الأمر بالتقوى وغيره ومن هذا النوع قوله عز وجل حتى تؤمنوا بالله وحده إلا قول إبراهيم لأبيه", "english": "I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 233", "section_title_en": "The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation", "section_index": 233, "anchors": "- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Quran Recitation'", "badge": "Hadith"}], "130": [{"arabic": "{إن ناشئة الليل هي أشد وطأ وأقوم قيلا} وقال تعالى {ومن آناء الليل فسبح وأطراف النهار لعلك ترضى} وقال عز وجل {وأقم الصلاة طرفي النهار وزلفا من الليل أن الحسنات يذهبن السيئات} ثم انظر كيف وصف الفائزين من عباده وبماذا وصفهم فقال تعالى {أم من هو قانت}", "english": "This is what has been unveiled to those who gaze with the light of inner vision. But if you are not among its people, then look to the address of God Most High to His Messenger and derive it by the light of faith. For God Most High said to the nearest of His servants to Him and the highest of them in rank before Him: {«Indeed, for you in the day is prolonged occupation and [in the night] long travail. And remember the name of your Lord and devote yourself to Him with [complete] devotion»} (73:7-8). And He said Most High: {«And remember the name of your Lord [in prayer] morning and evening. And from [part of] the night, prostrate to Him and exalt Him a long [part of the] night»} (76:25-26). And He said Most High: {«And exalt [Allah] with praise of your Lord before the rising of the sun and before its setting, and during periods of the night [exalt Him] and after the [performance of] prostrations»} (50:39-40). And He said, Glorified be He: {«And exalt [Allah] with praise of your Lord when you arise. And during part of the night exalt Him and after the stars»} (52:48-49). And He said Most High: {«Indeed, the rising by night is more potent for directing the soul and more suitable for the recitation [of the Qur'an]»} (73:6). And He said Most High: {«And from [part of] the night, exalt Him and after the setting of the stars»} (52:49). And He said Most High: {«And during parts of the night, exalt Him and at the ends of the day, that you may be satisfied»} (20:130). And He said, Mighty and Majestic: {«And establish prayer at the two ends of the day and at the approach of the night. Indeed, good deeds do away with misdeeds»} (11:114).", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 257", "section_title_en": "The Virtue of the Liturgies of Remembrance (Awrād) and the Elucidation That Perseverance Upon Them Is the Path to God Most High", "section_index": 257, "anchors": "- Root: ورد (w-r-d)\n  * Lisan / Ayn: The root denotes arriving at water, approaching a watering-place; the awrād (pl. of wird) are the appointed portions of devotional recitation assigned to fixed times, as one approaches the fountain of divine mercy.\n  * Al-Raghib (Mufradat): The wird is the allocated share of worship apportioned to a specific hour; its theological nuance is the systematic distribution of remembrance (dhikr) and reflection (fikr) across the昼夜 cycle to combat the soul's innate restlessness.\n  * Al-Zamakhshari (Asas): Literal: the portion of water one drinks. Metaphorical: the fixed liturgical portion one \"drinks\" from the fountain of gnosis—the shift from physical quenching to spiritual saturation.\n- Root: لطف (l-ṭ-f)\n  * Lisan / Ayn: Gentleness, subtlety, graciousness; to treat with kindness and refinement.\n  * Al-Raghib (Mufradat): The divine subtlety (al-luṭf) by which God gently draws His servant; here, the soul's need for gentle management (talṭīf) through variety in worship, lest it weary.\n  * Al-Zamakhshari (Asas): Literal: physical gentleness of touch. Metaphorical: the strategic, compassionate variation of devotional acts to sustain the soul's momentum—a haqīqah of spiritual governance.\n- Root: سأم (s-'-m)\n  * Lisan / Ayn: Weariness, boredom, satiety that breeds aversion; the soul's constitutional fatigue with a single monotonous mode.\n  * Al-Raghib (Mufradat): The psychological impediment to perseverance; overcome only by the divine mercy of variety, as the Prophet said: «إن الله لا يمل حتى تملوا» — God does not weary, but He has ordained that you may.\n  * Al-Zamakhshari (Asas): Literal: the nausea of over-satiation. Metaphorical: the spiritual listlessness that overtakes the heart when devotion becomes mechanical—requiring the \"turn\" (tanqul) between genres of worship.\n- Sibawayh Rule: باب التنويع والتقسيم (The Chapter of Division and Distribution) — The periodic structure here distributes predicates across multiple conditional clauses (fa-in... fa-in...), each governing a distinct outcome, requiring the translator to preserve the balanced, correlative syntax of proportional reward.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}, {"arabic": "بحمد ربك قبل طلوع الشمس وقبل الغروب ومن الليل فسبحه وأدبار السجود} وقال سبحانه {وسبح بحمد ربك حين تقوم ومن الليل فسبحه وإدبار النجوم} وقال تعالى {إن ناشئة الليل هي أشد وطأ وأقوم قيلا} وقال تعالى {ومن آناء الليل فسبح وأطراف النهار لعلك ترضى} وقال عز وجل {وأقم الصلاة طرفي النهار وزلفا من الليل أن الحسنات يذهبن السيئات} ثم انظر كيف وصف الفائزين من عباده وبماذا وصفهم فقال تعالى {أم من هو قانت}", "english": "This is what has been unveiled to those who gaze with the light of inner vision. But if you are not among its people, then look to the address of God Most High to His Messenger and derive it by the light of faith. For God Most High said to the nearest of His servants to Him and the highest of them in rank before Him: {«Indeed, for you in the day is prolonged occupation and [in the night] long travail. And remember the name of your Lord and devote yourself to Him with [complete] devotion»} (73:7-8). And He said Most High: {«And remember the name of your Lord [in prayer] morning and evening. And from [part of] the night, prostrate to Him and exalt Him a long [part of the] night»} (76:25-26). And He said Most High: {«And exalt [Allah] with praise of your Lord before the rising of the sun and before its setting, and during periods of the night [exalt Him] and after the [performance of] prostrations»} (50:39-40). And He said, Glorified be He: {«And exalt [Allah] with praise of your Lord when you arise. And during part of the night exalt Him and after the stars»} (52:48-49). And He said Most High: {«Indeed, the rising by night is more potent for directing the soul and more suitable for the recitation [of the Qur'an]»} (73:6). And He said Most High: {«And from [part of] the night, exalt Him and after the setting of the stars»} (52:49). And He said Most High: {«And during parts of the night, exalt Him and at the ends of the day, that you may be satisfied»} (20:130). And He said, Mighty and Majestic: {«And establish prayer at the two ends of the day and at the approach of the night. Indeed, good deeds do away with misdeeds»} (11:114).", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 257", "section_title_en": "The Virtue of the Liturgies of Remembrance (Awrād) and the Elucidation That Perseverance Upon Them Is the Path to God Most High", "section_index": 257, "anchors": "- Root: ورد (w-r-d)\n  * Lisan / Ayn: The root denotes arriving at water, approaching a watering-place; the awrād (pl. of wird) are the appointed portions of devotional recitation assigned to fixed times, as one approaches the fountain of divine mercy.\n  * Al-Raghib (Mufradat): The wird is the allocated share of worship apportioned to a specific hour; its theological nuance is the systematic distribution of remembrance (dhikr) and reflection (fikr) across the昼夜 cycle to combat the soul's innate restlessness.\n  * Al-Zamakhshari (Asas): Literal: the portion of water one drinks. Metaphorical: the fixed liturgical portion one \"drinks\" from the fountain of gnosis—the shift from physical quenching to spiritual saturation.\n- Root: لطف (l-ṭ-f)\n  * Lisan / Ayn: Gentleness, subtlety, graciousness; to treat with kindness and refinement.\n  * Al-Raghib (Mufradat): The divine subtlety (al-luṭf) by which God gently draws His servant; here, the soul's need for gentle management (talṭīf) through variety in worship, lest it weary.\n  * Al-Zamakhshari (Asas): Literal: physical gentleness of touch. Metaphorical: the strategic, compassionate variation of devotional acts to sustain the soul's momentum—a haqīqah of spiritual governance.\n- Root: سأم (s-'-m)\n  * Lisan / Ayn: Weariness, boredom, satiety that breeds aversion; the soul's constitutional fatigue with a single monotonous mode.\n  * Al-Raghib (Mufradat): The psychological impediment to perseverance; overcome only by the divine mercy of variety, as the Prophet said: «إن الله لا يمل حتى تملوا» — God does not weary, but He has ordained that you may.\n  * Al-Zamakhshari (Asas): Literal: the nausea of over-satiation. Metaphorical: the spiritual listlessness that overtakes the heart when devotion becomes mechanical—requiring the \"turn\" (tanqul) between genres of worship.\n- Sibawayh Rule: باب التنويع والتقسيم (The Chapter of Division and Distribution) — The periodic structure here distributes predicates across multiple conditional clauses (fa-in... fa-in...), each governing a distinct outcome, requiring the translator to preserve the balanced, correlative syntax of proportional reward.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}, {"arabic": "تمسون وحين تصبحون} وبقوله تعالى فسبح بحمد ربك قبل طلوع الشمس وقبل غروبها وقوله عز وجل {ومن آناء الليل فسبح وأطراف النهار لعلك ترضى} وقوله تعالى {واذكر اسم ربك بكرة وأصيلا} فأما ترتيبه فليأخذ من وقت انتباهه من النوم فإذا انتبه فينبغي أن يبتدىء بذكر الله تعالى فيقول الحمد لله الذي أحيانا بعد ما أماتنا وإليه النشور إلى آخر الأدعية والآيات التي ذكرناها في دعاء الاستيقاظ من كتاب الدعوات وليلبس ثوبه وهو في الدعاء وينوي به ستر عورته امتثالا لأمر الله تعالى واستعانة به على عبادته من غير قصد رياء ولا رعونة", "english": "{«آناء الليل ساجدا وقائما يحذر الآخرة ويرجو رحمة ربه قل هل يستوي الذين يعلمون والذين لا يعلمون»} — \"During the hours of the night, prostrating and standing, fearing the Hereafter and hoping for the mercy of his Lord. Say: Are those who know equal to those who do not know?\" (Q. 39:9). And God Most High said: {«تتجافى جنوبهم عن المضاجع يدعون ربهم خوفا وطمعا»} — \"Their sides forsake their beds, calling upon their Lord in fear and hope\" (Q. 32:16). And God, Mighty and Majestic, said: {«والذين يبيتون لربهم سجدا وقياما»} — \"And those who pass the night prostrating and standing before their Lord\" (Q. 25:64). And God, Mighty and Majestic, said: {«كانوا قليلا من الليل ما يهجعون وبالأسحار هم يستغفرون»} — \"They used to sleep but little of the night, and in the dawn-hours they would seek forgiveness\" (Q. 51:17-18). And God, Mighty and Majestic, said: {«فسبحان الله حين تمسون وحين تصبحون»} — \"So glory be to God when you enter the evening and when you enter the morning\" (Q. 30:17). And God Most High said: {«ولا تطرد الذين يدعون ربهم بالغداة والعشي يريدون وجهه»} — \"And do not drive away those who call upon their Lord morning and evening, desiring His Face\" (Q. 6:52). All of this makes clear to you that the path to God Most High is the watchfulness over the times (murāqabat al-awqāt) and the cultivation of them with the appointed devotions (al-awrād) in a perpetual manner.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 258", "section_title_en": "The Revival of the Religious Sciences — Section 258: The Virtues of the Watches (Awrād) and Their Ordering", "section_index": 258, "anchors": "- Root: ورد (w-r-d)\n  * Lisan / Ayn: Core meaning is \"to arrive at water\" — the quenching of thirst at a watering place; al-Wird (pl. Awrād) denotes a set portion or appointed round of devotional recitation, by extension from the regular \"arrival\" at a source.\n  * Al-Raghib (Mufradat): Al-Wurūd is originally \"the intending of water,\" then used for other things. The theological nuance: the awrād are the appointed \"watering places\" of the soul — fixed times at which the servant presents himself before God to drink from the fountain of remembrance (dhikr).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"warda al-mā'a\" — to arrive at water. Metaphorical (Majāz): \"warada ʿalayhi amrun lam yuṭiqhu\" — an affair he could not bear arrived upon him; \"waradat-hu al-ḥummā\" — fever came upon him. Here, the awrād are the appointed times that \"come upon\" the servant, demanding their due of devotion.\n- Root: طلع (ṭ-l-ʿ)\n  * Lisan / Ayn: To rise, to appear above the horizon (of the sun); to ascend; to come upon suddenly.\n  * Al-Raghib (Mufradat): \"Ṭalaʿa al-shams ṭulūʿan wa-maṭlaʿan\" — the sun rose. From this is borrowed: \"ṭalaʿa ʿalaynā fulān\" — so-and-so came upon us. The maṭlaʿ is the place of rising.\n  * Al-Zamakhshari (Asas): Literal: \"ṭalaʿat al-shams\" — the sun rose. Metaphorical: \"ṭalaʿa ʿalaynā fulān\" — he descended upon us suddenly. The \"rising of the sun\" is the boundary-marker of the first watch.\n- Root: ليل (l-y-l)\n  * Lisan / Ayn: The night — from the time of sunset to sunrise; its root suggests \"enveloping\" and \"concealing.\"\n  * Al-Raghib (Mufradat): The night (al-layl) and the day (al-nahār) are two signs (āyatān) of God; the night is for stillness and the day for seeking provision.\n  * Al-Zamakhshari (Asas): Literal: the period of darkness. Metaphorical: \"layl al-hamm\" — the night of anxiety (a dark affair). The night is divided into watches for the one who stands in prayer.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-al-taqyīd bi-innamā (Restriction and Focused Predication) — The particle innamā restricts the predicate to the subject alone, negating all else. Applied here: \"the purpose of the sun and moon's course is not for worldly matters, but only (innamā) for knowing the measures of the times.\"", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Remembrance of Death and Afterlife'", "badge": "Dhikr"}, {"arabic": "فافعلوا ثم قرأ {وسبح بحمد ربك قبل طلوع الشمس وقبل غروبها} (1) وهو مخرج في الصحيحين وروى مسلم في الصحيح عن صهيب قال قرأ رسول الله صلى الله عليه وسلم قوله تعالى للذين أحسنوا الحسنى وزيادة {قال} إذا دخل أهل الجنة الجنة وأهل النار النار نادى مناد يا أهل الجنة إن لكم عند الله موعدا يريد أن ينجزكموه قالوا ما هذا الموعد ألم يثقل موازيننا ويبيض وجوهنا ويدخلنا الجنة ويجرنا من النار قال فيرفع الحجاب وينظرون إلى وجه الله عز وجل فما أعطوا شيئا أحب إليهم من النظر إليه (2) وقد روى حديث الرؤيا جماعة من الصحابة وهذه", "english": "And Mujāhid said: \"The lowest of the people of Paradise in station is one who travels through his dominion for a thousand years, seeing its farthest as he sees its nearest. And the highest of them is the one who gazes upon his Lord morning and evening.\" And Saʿīd ibn al-Musayyib said: \"There is none among the people of Paradise except that in his hand are three bracelets: a bracelet of gold, a bracelet of pearl, and a bracelet of silver.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1358", "section_title_en": "The Vision of Allah and the Gaze Upon His Face — The Supreme Bliss of the Hereafter", "section_index": 1358, "anchors": "- Root: حسن (ḥ-s-n)\n  * Lisan / Ayn: Core meaning of beauty, goodness, and excellence in form and act.\n  * Al-Raghib (Mufradat): \"الحسنى\" denotes the superlative good (al-ḥusnā), and \"زيادة\" (increase) is the added bounty beyond merit — a theological term for the beatific vision.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for moral beauty; metaphorical (majāz) elevation when applied to divine reward, where \"increase\" transcends all corporeal delights.\n- Root: رءي (r-'-y)\n  * Lisan / Ayn: Visual perception (ru'yā) and sight (naẓar), both sensory and intellectual.\n  * Al-Raghib (Mufradat): In Kalam, \"ru'yat Allāh\" is the vision of the divine essence — an immaterial perception granted to the blessed, not a corporeal sight of a spatial object.\n  * Al-Zamakhshari (Asas): Literal for physical sight; metaphorical transfer (naql) when applied to God, signifying direct, unveiled apprehension of His glory.\n- Root: نعم (n-'-m)\n  * Lisan / Ayn: \"النعمة\" is the state of well-being; \"النعمى\" is the superlative felicity.\n  * Al-Raghib (Mufradat): \"النعمة\" as the good state (ḥālah ḥasanah), and \"النعمى\" as the ultimate bliss — here contrasted with the lesser delights of Paradise.\n  * Al-Zamakhshari (Asas): Literal for sensory comfort; metaphorical for the spiritual joy of divine proximity, which surpasses all bodily pleasures.\n- Root: اهل ('-h-l)\n  * Lisan / Ayn: People of a household or place; \"أهل الجنة\" — the inhabitants of Paradise.\n  * Al-Raghib (Mufradat): \"أهل الرجل\" — those united by kinship, religion, or abode; here, the denizens of the Garden as a community of the blessed.\n  * Al-Zamakhshari (Asas): Literal for residents; metaphorical extension to those who merit a station by virtue of their deeds.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used in the closing exhortation to restrict the servant's aspiration solely to the vision of the Lord, excluding all lesser aims.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}], "131": [{"arabic": "من نصيب وقال تعالى ولا تمدن عينيك إلى ما متعنا به أزواجا منهم زهرة الحياة الدنيا لنفتنهم فيه ورزق ربك خير وأبقى وقال تعالى الذين يستحبون الحياة الدنيا على الآخرة فوصف الكفار بذلك فمفهومه أن المؤمن هو الذي يتصف بنقيضه وهو أن يستحب الآخرة على الحياة الدنيا وأما الأخبار فما ورد منها في ذم الدنيا كثير وقد أوردنا بعضها في كتاب ذم الدنيا مع ربع المهلكات إذ حب الدنيا من المهلكات ونحن الآن نقتصر على فضيلة بغض الدنيا فإنه من المنجيات وهو المعني بالزهد وقد قال رسول الله صلى الله عليه وسلم من أصبح وهمه الدنيا شتت الله عليه أمره وفرق عليه ضيعته وجعل فقره بين", "english": "Allah the Exalted said: {فخرج على قومه في زينته} [He went out to his people in his adornment] up to His saying, the Exalted: {وقال الذين أوتوا العلم ويلكم ثواب الله خير لمن آمن} [And those who had been given knowledge said, \"Woe to you! The reward of Allah is better for he who believes.\"] Thus He attributed renunciation (al-zuhd) to the learned, and described its people as possessing knowledge—and this is the ultimate praise. And He said, the Exalted: {أولئك يؤتون أجرهم مرتين بما صبروا} [Those will be given their reward twice for what they patiently endured], and it came in the exegesis (al-tafsīr) that this refers to renunciation of the world. And He said, Mighty and Majestic: {إنا جعلنا ما على الأرض زينة لها لنبلوهم أيهم أحسن عملا} [Indeed We have made that which is on the earth adornment for it that We may test them as to which of them is best in deed]. It was said its meaning is: which of them is most renunciant (azhad) in it. So He described renunciation as being among the most excellent of deeds. And He said, the Exalted: {من كان يريد حرث الآخرة نزد له في حرثه ومن كان يريد حرث الدنيا نؤته منها وما له في الآخرة من نصيب} [Whoever desires the harvest of the Hereafter—We increase for him in his harvest. And whoever desires the harvest of this world—We give him from it, but he has no share in the Hereafter]. And He said, the Exalted: {ولا تمدن عينيك إلى ما متعنا به أزواجا منهم زهرة الحياة الدنيا لنفتنهم فيه ورزق ربك خير وأبقى} [And do not extend your eyes to that which We have given enjoyment to categories of them—the splendor of the life of this world—that We may test them thereby. And the provision of your Lord is better and more enduring]. And He said, the Exalted: {الذين يستحبون الحياة الدنيا على الآخرة} [Those who prefer the life of this world over the Hereafter]—thus He described the disbelievers with that. So its understood implication (mafhūmuhu) is that the believer is the one characterized by its opposite, namely, that he prefers the Hereafter over the life of this world. [PageV04P219]", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 1090", "section_title_en": "The Book of Renunciation (Kitāb al-Zuhd) — Section on the Virtue of Despising the World", "section_index": 1090, "anchors": "- Root: زهد (z-h-d)\n  * Lisan / Ayn: Core meaning of abstaining, forsaking, and turning away from something, deeming it insignificant and paltry.\n  * Al-Raghib (Mufradat): Theological nuance: الزهد is the voluntary turning of the heart away from the world (al-dunyā) as a deliberate act of spiritual preference for the Hereafter, not mere physical poverty.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes abstention from a thing due to its worthlessness; Metaphorical (Majaz) usage in the religious context signifies the heart's detachment from worldly allurements while the body may still function within it.\n- Root: دنا (d-n-w)\n  * Lisan / Ayn: Nearness, proximity; the world (al-dunyā) is so named for its closeness and lower station relative to the Hereafter.\n  * Al-Raghib (Mufradat): الدنو: القرب بالذات أو بالحكم; al-dunyā is the lower, nearer abode, contrasted with the ultimate and enduring one.\n  * Al-Zamakhshari (Asas): Literal: spatial or temporal nearness; Metaphorical: the world as the inferior, immediate realm that precedes the eternal one.\n- Root: عقل (ʿ-q-l) — implied in \"مفهومه\" (its understood implication)\n  * Lisan / Ayn: Understanding, intellect, that which binds and restrains.\n  * Al-Raghib (Mufradat): The intellect perceives the conceptual implication (mafhūm) of a statement, deriving the necessary opposite or corollary.\n  * Al-Zamakhshari (Asas): Literal: the articulated text; Metaphorical: the understood converse (mafhūm al-mukhālafah) which the author here employs to establish the believer's trait.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic structure of the author's argumentation, where the governing verb (e.g., \"قال تعالى\") is separated from its quoted object by lengthy parenthetical citations, mirrors the classical allowance for interposition to maintain rhetorical flow and emphasis.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Poverty and Abstinence'", "badge": "Dhikr"}, {"arabic": "ومهما اعتزل لم يشاهد وإذا لم يشاهد لم يشته ولم يطمع ولذلك قال الله تعالى {ولا تمدن عينيك إلى ما متعنا به أزواجا منهم} وقال صلى الله عليه وسلم انظروا الى من هو دونكم ولا تنظروا الى من هو فوقكم فإنه أجدر أن لا تزدروا نعمة الله عليكم (1) وقال عون بن عبد الله كنت أجالس الأغنياء فلم أزل مغموما كنت أرى ثوبا أحسن من ثوبي ودابة أفره من دابتي فجالست الفقراء فاسترحت وحكى أن المزني رحمه الله خرج من باب جامع الفسطاط وقد أقبل ابن عبد الحكم في موكبه فبهره ما رأى من حسن حاله وحسن هيئته فتلا قوله تعالى {وجعلنا بعضكم لبعض فتنة أتصبرون} ثم قال بلى أصبر وأر", "english": "As for the cutting off of people's hope in you, therein lie benefits. For the satisfaction of people is a goal that can never be attained; thus a man's occupation with reforming his own soul is more fitting. Among the easiest and lightest of obligations are attending funerals, visiting the sick, and attending banquets and wedding feasts — yet in these there is the squandering of hours and exposure to afflictions. Moreover, obstacles may hinder one from some of them, and excuses arise in facing them, yet one cannot disclose every excuse. So they say to him: \"You fulfilled so-and-so's right, but you fell short regarding our right\" — and this becomes a cause of enmity. For it has been said: Whoever does not visit the sick at the time of visiting — they wish for his death, fearing the shame he would bring upon them if he recovered, on account of his having fallen short.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 455", "section_title_en": "The Revival of the Religious Sciences — Section 455: On the Fourth through Sixth Benefits of Seclusion", "section_index": 455, "anchors": "- Root: طمع (ṭamaʿ)\n  * Lisan / Ayn: Core lexical sense of craving, eager desire, and longing for something.\n  * Al-Raghib (Mufradat): \"الطمع: نزوع النفس إلى الشيء شهوة له\" — the soul's inclination toward a thing out of desire; often censured when it exceeds bounds, for \"الطمع طبع\" (greed is an innate disposition).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes the soul's craving; metaphorical (majāz) usage extends to \"أطماع الجند\" (soldiers' rations) — that which is hoped for and expected. Here, the term oscillates between the blameworthy craving for worldly goods and the cutting off of such craving as a spiritual virtue.\n- Root: دنا (danā)\n  * Lisan / Ayn: Nearness in place, time, or rank; the world (al-dunyā) is so named because it is the nearer, lower abode.\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات، أو بالحكم\" — proximity by essence or by judgment; used of place, time, and station. The \"lower\" (adnā) is contrasted with the \"better\" (khayr) in {«أتستبدلون الذي هو أدنى بالذي هو خير»} [Al-Baqarah: 61].\n  * Al-Zamakhshari (Asas): Distinguishes dunuww (nearness) from danāʾah (baseness) — a crucial distinction, for the seclusion sought here is not base withdrawal but a drawing near to God through cutting worldly attachments.\n- Root: جنب (janb)\n  * Lisan / Ayn: The side or flank; extended metaphorically to mean \"beside,\" \"alongside,\" or \"avoiding.\"\n  * Al-Raghib (Mufradat): \"ثم يستعار من الناحية التي تليها\" — the side is used metaphorically for the region adjacent to it. From this root derives ijtināb (avoidance) — the act of keeping oneself to the side, away from harm.\n  * Al-Zamakhshari (Asas): Majāz: \"اتق الله الذي لا جنيبة له\" — fear God who has no equal; and \"فرطت في جنب الله\" — I fell short in God's side (i.e., His due). The root thus carries both the sense of physical separation and the higher spiritual connotation of keeping oneself apart for God's sake.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing permissible separation between a preposition and its object, allowing for rhetorical emphasis and periodic sentence structure. Applied here in the extended conditional and causal constructions (fa-inna... fa-fīhi fawāʾid) where the apodosis is deferred for effect.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}, {"arabic": "فلما خرجت نزلت هذه الآية {ولا تمدن عينيك إلى ما متعنا به أزواجا منهم زهرة الحياة الدنيا} (1) الآية وهذه الآية تعزية لرسول الله صلى الله عليه وسلم عن الدنيا وقال صلى الله عليه وسلم الفقر أزين بالمؤمن من العذار الحسن على خد الفرس (2) وقال صلى الله عليه وسلم من أصبح منكم معافى في جسمه آمنا في سربه عنده قوت يومه فكأنما حيزت له الدنيا بحذافيرها (3) وقال كعب الأحبار قال الله تعالى لموسى عليه السلام يا موسى إذا رأيت الفقر مقبلا فقل مرحبا بشعار الصالحين وقال عطاء الخراساني مر نبي من الأنبياء بساحل فإذا هو برجل يصطاد حيتانا فقال بسم الله وأل", "english": "As for the verses [of the Qur'an], that is indicated by His saying, the Exalted: {«لِلْفُقَرَاءِ الْمُهَاجِرِينَ الَّذِينَ أُخْرِجُوا مِنْ دِيَارِهِمْ وَأَمْوَالِهِمْ»} [To the poor emigrants who were driven out of their homes and their wealth] (59:8), to the end of the verse. And He said, the Exalted: {«لِلْفُقَرَاءِ الَّذِينَ أُحْصِرُوا فِي سَبِيلِ اللَّهِ لَا يَسْتَطِيعُونَ ضَرْبًا فِي الْأَرْضِ»} [To the poor who are confined in the way of Allah, unable to travel in the land] (2:273). He directed the discourse in the context of praise, then He advanced their description with poverty before their description with emigration and confinement. In this there is an evident indication of the praise of poverty.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 1069", "section_title_en": "The Virtue of Poverty: Scriptural Evidences and Their Interpretation", "section_index": 1069, "anchors": "- Root: فقر (F-Q-R)\n  * Lisan / Ayn: Core meaning of need, indigence, and the state of lacking possessions; also the notches of a vertebra or the joints of the back, indicating structural dependence.\n  * Al-Raghib (Mufradat): Poverty is of four degrees: (1) essential neediness before God (universal to all creatures), (2) lack of worldly goods (the subject here), (3) voluntary renunciation (zuhd), and (4) the perfection of the heart's detachment. The praise of poverty here targets the second and third degrees, not destitution that breeds discontent.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) poverty is the absence of wealth; metaphorical (Majaz) poverty is the soul's humility and its \"notches\" of dependence on God. The Prophet's praise of the \"poor\" (fuqara') must be read as praise of the virtuous poor (mutafaQQir), not the covetous.\n- Root: هجر (H-J-R)\n  * Lisan / Ayn: To abandon, emigrate, or sever ties; the act of leaving one's homeland for a religious purpose.\n  * Al-Raghib (Mufradat): Hijrah (emigration) is a physical act of devotion, but the Quranic verse pairs it with poverty, elevating the state of neediness as a spiritual station above the mere act of relocation.\n  * Al-Zamakhshari (Asas): The verse's structure (taqdim) places \"poverty\" before \"emigration\" and \"confinement,\" signaling its superior rank in the divine estimation.\n- Root: قدر (Q-D-R)\n  * Lisan / Ayn: Measure, decree, power, and estimation; the act of determining a precise limit or quantity.\n  * Al-Raghib (Mufradat): When applied to God, Qadar is His eternal decree; when applied to the Prophet's speech, it denotes precise, divinely-inspired measurement—never arbitrary or haphazard.\n  * Al-Zamakhshari (Asas): Literal: to measure out (qaddara). Metaphorical: the \"measure\" of a thing's worth or rank. The Prophet's numerical estimates (e.g., 500 years, 46 parts) are literal measures of spiritual realities, though their exact rationale may be hidden from non-prophetic intellects.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The Quranic construction {للفقراء المهاجرين} uses prepositional fronting (taqdim) to restrict the praise to a specific class, and the sequence of descriptors (poverty before hijrah) establishes a hierarchy of virtues through syntactic ordering.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Poverty and Abstinence'", "badge": "Du'a"}], "132": [{"arabic": "أمرني ربي عز وجل قال عز وجل {وأمر أهلك بالصلاة واصطبر عليها} (5) الآية وقال صلى الله عليه وسلم لم يتوكل من استرقى واكتوى (6) وروي أنه لما قال جبريل لإبراهيم عليهما السلام وقد رمي إلى النار بالمنجنيق ألك حاجة قال أما إليك فلا وفاء بقوله حسبي الله ونعم الوكيل إذ قال ذلك حين أخذ ليرمى فأنزل الله تعالى {وإبراهيم الذي وفى} وأوحى الله تعالى إلى داود عليه السلام يا داود ما من عبد يعتصم بي دون خلقي فتكيده السموات والأرض إلا جعلت له مخرجا وأما الآثار فقد قال سعيد بن جبير لدغتني عقرب فأقسمت علي أمي لتسترقين فناولت الرا", "english": "His protection and His sanctuary, and He is a Wise One who does not fall short in managing the affairs of one who entrusts His management to Him. And He, exalted is He, said: {إِنَّ الَّذِينَ تَدْعُونَ مِن دُونِ اللَّهِ عِبَادٌ أَمْثَالُكُمْ} — \"Indeed, those you call upon besides Allah are servants like yourselves\" — thereby making clear that everything other than Allah, exalted is He, is a subjugated servant, whose need is like your need; so how then can one rely upon him?", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 1103", "section_title_en": "Section 1103 — On the First Part Concerning Divine Unity (Tawḥīd) and the Perfection of Trust in Allah", "section_index": 1103, "anchors": "- Root: وكل (W-K-L)\n  * Lisan / Ayn: Core meaning of delegating, entrusting, and appointing another as a deputy or guardian over one's affairs.\n  * Al-Raghib (Mufradat): \"التوكيل: أن تعتمد على غيرك وتجعله نائبا عنك\" — Trust (tawakkul) is to rely upon another and make him a deputy; the true Wakīl is Allah alone, as in {وَكَفَىٰ بِاللَّهِ وَكِيلًا}.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"توكل على الله ولا تتكل على غيره\" — reliance on Allah. Metaphorical (majāz): \"وكل همه بكذا\" — one who delegates his care to a thing, implying abandonment by Allah of those who turn to other than Him.\n- Root: عبد (ʿ-B-D)\n  * Lisan / Ayn: Servitude, submission, and humble obedience; the created being as subjugated servant.\n  * Al-Raghib (Mufradat): \"العبودية: إظهار التذلل، والعبادة أبلغ منها\" — servitude is the display of humility; worship is its utmost degree, due only to Allah. All besides Allah are \"عباد أمثالكم\" — servants like yourselves, incapable of independent provision.\n  * Al-Zamakhshari (Asas): Literal: \"عبد بين العبودية\" — a slave bound in servitude. Metaphorical: \"استعبده الطمع\" — greed enslaves a man, just as reliance on creatures enslaves the heart.\n- Root: رسل (R-S-L)\n  * Lisan / Ayn: Sending forth with ease and gentleness; a messenger dispatched with a message.\n  * Al-Raghib (Mufradat): \"أصل الرسل: الانبعاث على التؤدة\" — the root is gentle dispatch; the messenger is one sent, and the verse {وَأْمُرْ أَهْلَكَ بِالصَّلَاةِ} is a divine sending of command.\n  * Al-Zamakhshari (Asas): Literal: \"أرسل الله في الأمم رسلا\" — Allah sent messengers to nations. Metaphorical: \"أرسل الله عليهم العذاب\" — Allah loosed punishment upon them, showing His sole agency.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of the preposition from its object for rhetorical emphasis, as in \"على ربهم يتوكلون\" where the preposition \"على\" is fronted before its governed noun \"ربهم\" to highlight exclusive reliance, a construction permissible when the clause is semantically complete and the fronting serves emphasis (takhrīṣ).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monotheism and Reliance'", "badge": "Insight"}]}, "wordTiming": {"minshawi": {"1": [[1, 100, 1410]], "20:1": [[1, 100, 1410]], "2": [[1, 250, 1947], [2, 1947, 3420], [3, 3420, 4325], [4, 4325, 5826], [5, 5826, 7990]], "20:2": [[1, 250, 1947], [2, 1947, 3420], [3, 3420, 4325], [4, 4325, 5826], [5, 5826, 7990]], "3": [[1, 800, 2020], [2, 2020, 3078], [3, 3078, 3887], [4, 3887, 5810]], "20:3": [[1, 800, 2020], [2, 2020, 3078], [3, 3078, 3887], [4, 3887, 5810]], "4": [[1, 520, 2498], [2, 2498, 3672], [3, 3672, 4400], [4, 4400, 5443], [5, 5443, 7911], [6, 7911, 9040]], "20:4": [[1, 520, 2498], [2, 2498, 3672], [3, 3672, 4400], [4, 4400, 5443], [5, 5443, 7911], [6, 7911, 9040]], "5": [[1, 390, 1619], [2, 1619, 2295], [3, 2295, 3138], [4, 3138, 4720]], "20:5": [[1, 390, 1619], [2, 1619, 2295], [3, 2295, 3138], [4, 3138, 4720]], "6": [[1, 430, 724], [2, 724, 1297], [3, 1297, 1700], [4, 1700, 3086], [5, 3086, 4030], [6, 4030, 4433], [7, 4433, 5176], [8, 5176, 6120], [9, 6120, 7389], [10, 7389, 8333], [11, 8333, 8813], [12, 8813, 10120]], "20:6": [[1, 430, 724], [2, 724, 1297], [3, 1297, 1700], [4, 1700, 3086], [5, 3086, 4030], [6, 4030, 4433], [7, 4433, 5176], [8, 5176, 6120], [9, 6120, 7389], [10, 7389, 8333], [11, 8333, 8813], [12, 8813, 10120]], "7": [[1, 2180, 3292], [2, 3292, 4307], [3, 4307, 5793], [4, 5793, 7074], [5, 7074, 8439], [6, 8439, 9653], [7, 9653, 11430]], "20:7": [[1, 2180, 3292], [2, 3292, 4307], [3, 4307, 5793], [4, 5793, 7074], [5, 7074, 8439], [6, 8439, 9653], [7, 9653, 11430]], "8": [[1, 460, 1214], [2, 1214, 2930], [3, 2930, 3665], [4, 3665, 4731], [5, 4731, 5353], [6, 5353, 5711], [7, 5711, 8266], [8, 8266, 9910]], "20:8": [[1, 460, 1214], [2, 1214, 2930], [3, 2930, 3665], [4, 3665, 4731], [5, 4731, 5353], [6, 5353, 5711], [7, 5711, 8266], [8, 8266, 9910]], "9": [[1, 670, 1273], [2, 1273, 2125], [3, 2125, 2910], [4, 2910, 4550]], "20:9": [[1, 670, 1273], [2, 1273, 2125], [3, 2125, 2910], [4, 2910, 4550]], "10": [[1, 530, 1153], [2, 1153, 2373], [3, 2373, 4379], [4, 4379, 5978], [5, 5978, 7333], [6, 7333, 10951], [7, 10951, 13824], [8, 13824, 15613], [9, 15613, 17619], [10, 17619, 20858], [11, 20858, 23270], [12, 23270, 25113], [13, 25113, 26278], [14, 26278, 27037], [15, 27037, 27904], [16, 27904, 28947], [17, 28947, 30912], [18, 30912, 31860]], "20:10": [[1, 530, 1153], [2, 1153, 2373], [3, 2373, 4379], [4, 4379, 5978], [5, 5978, 7333], [6, 7333, 10951], [7, 10951, 13824], [8, 13824, 15613], [9, 15613, 17619], [10, 17619, 20858], [11, 20858, 23270], [12, 23270, 25113], [13, 25113, 26278], [14, 26278, 27037], [15, 27037, 27904], [16, 27904, 28947], [17, 28947, 30912], [18, 30912, 31860]], "11": [[1, 1240, 3193], [2, 3193, 4571], [3, 4571, 5524], [4, 5524, 7840]], "20:11": [[1, 1240, 3193], [2, 3193, 4571], [3, 4571, 5524], [4, 5524, 7840]], "12": [[1, 60, 2537], [2, 2537, 3682], [3, 3682, 4558], [4, 4558, 5668], [5, 5668, 7035], [6, 7035, 8063], [7, 8063, 10038], [8, 10038, 11533], [9, 11533, 12760]], "20:12": [[1, 60, 2537], [2, 2537, 3682], [3, 3682, 4558], [4, 4558, 5668], [5, 5668, 7035], [6, 7035, 8063], [7, 8063, 10038], [8, 10038, 11533], [9, 11533, 12760]], "13": [[1, 400, 1432], [2, 1432, 2209], [3, 2209, 3015], [4, 3015, 3679], [5, 3679, 5530]], "20:13": [[1, 400, 1432], [2, 1432, 2209], [3, 2209, 3015], [4, 3015, 3679], [5, 3679, 5530]], "14": [[1, 570, 2475], [2, 2475, 3280], [3, 3280, 3937], [4, 3937, 5431], [5, 5431, 6071], [6, 6071, 7886], [7, 7886, 8691], [8, 8691, 9923], [9, 9923, 10875], [10, 10875, 12224], [11, 12224, 14080]], "20:14": [[1, 570, 2475], [2, 2475, 3280], [3, 3280, 3937], [4, 3937, 5431], [5, 5431, 6071], [6, 6071, 7886], [7, 7886, 8691], [8, 8691, 9923], [9, 9923, 10875], [10, 10875, 12224], [11, 12224, 14080]], "15": [[1, 1360, 2051], [2, 2051, 3681], [3, 3681, 5245], [4, 5245, 6444], [5, 6444, 8343], [6, 8343, 9802], [7, 9802, 10361], [8, 10361, 10991], [9, 10991, 11946], [10, 11946, 13470]], "20:15": [[1, 1360, 2051], [2, 2051, 3681], [3, 3681, 5245], [4, 5245, 6444], [5, 6444, 8343], [6, 8343, 9802], [7, 9802, 10361], [8, 10361, 10991], [9, 10991, 11946], [10, 11946, 13470]], "16": [[1, 920, 1718], [2, 1718, 3178], [3, 3178, 4171], [4, 4171, 4511], [5, 4511, 5267], [6, 5267, 6235], [7, 6235, 7016], [8, 7016, 8162], [9, 8162, 9364], [10, 9364, 10750]], "20:16": [[1, 920, 1718], [2, 1718, 3178], [3, 3178, 4171], [4, 4171, 4511], [5, 4511, 5267], [6, 5267, 6235], [7, 6235, 7016], [8, 7016, 8162], [9, 8162, 9364], [10, 9364, 10750]],