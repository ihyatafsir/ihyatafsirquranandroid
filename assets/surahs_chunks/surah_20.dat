c": "اَ۬لثَّر۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 7, "text": "وَإِن تَجْهَرْ بِالْقَوْلِ فَإِنَّهُۥ يَعْلَمُ اُ۬لسِّرَّ وَأَخْفَيۖ", "words": [{"id": 1, "arabic": "وَإِن", "translit": "", "root": ""}, {"id": 2, "arabic": "تَجْهَرْ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِالْقَوْلِ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَإِنَّهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَعْلَمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لسِّرَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَأَخْفَيۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 8, "text": "اَ۬للَّهُ لَآ إِلَٰهَ إِلَّا هُوَۖ لَهُ اُ۬لَاسْمَآءُ اُ۬لْحُسْن۪يٰۖ", "words": [{"id": 1, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَٰهَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "هُوَۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَهُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لَاسْمَآءُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لْحُسْن۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 9, "text": "وَهَلَ اَت۪يٰكَ حَدِيثُ مُوس۪يٰٓ", "words": [{"id": 1, "arabic": "وَهَلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَت۪يٰكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "حَدِيثُ", "translit": "", "root": ""}, {"id": 4, "arabic": "مُوس۪يٰٓ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 10, "text": "إِذْ ر۪ء۪ا نَاراࣰ فَقَالَ لِأَهْلِهِ اِ۟مْكُثُوٓاْ إِنِّيَ ءَانَسْتُ نَاراࣰ لَّعَلِّيَ ءَاتِيكُم مِّنْهَا بِقَبَسٍ اَوَ اَجِدُ عَلَي اَ۬لنّ۪ارِ هُديࣰۖ", "words": [{"id": 1, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "ر۪ء۪ا", "translit": "", "root": ""}, {"id": 3, "arabic": "نَاراࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَقَالَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِأَهْلِهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۟مْكُثُوٓاْ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنِّيَ", "translit": "", "root": ""}, {"id": 8, "arabic": "ءَانَسْتُ", "translit": "", "root": ""}, {"id": 9, "arabic": "نَاراࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَّعَلِّيَ", "translit": "", "root": ""}, {"id": 11, "arabic": "ءَاتِيكُم", "translit": "", "root": ""}, {"id": 12, "arabic": "مِّنْهَا", "translit": "", "root": ""}, {"id": 13, "arabic": "بِقَبَسٍ", "translit": "", "root": ""}, {"id": 14, "arabic": "اَوَ", "translit": "", "root": ""}, {"id": 15, "arabic": "اَجِدُ", "translit": "", "root": ""}, {"id": 16, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 17, "arabic": "اَ۬لنّ۪ارِ", "translit": "", "root": ""}, {"id": 18, "arabic": "هُديࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 11, "text": "فَلَمَّآ أَت۪يٰهَا نُودِيَ يَٰمُوس۪يٰٓ", "words": [{"id": 1, "arabic": "فَلَمَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَت۪يٰهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "نُودِيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَٰمُوس۪يٰٓ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 12, "text": "إِنِّيَ أَنَا رَبُّكَ فَاخْلَعْ نَعْلَيْكَ إِنَّكَ بِالْوَادِ اِ۬لْمُقَدَّسِ طُو۪يٰۖ", "words": [{"id": 1, "arabic": "إِنِّيَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبُّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَاخْلَعْ", "translit": "", "root": ""}, {"id": 5, "arabic": "نَعْلَيْكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِنَّكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِالْوَادِ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لْمُقَدَّسِ", "translit": "", "root": ""}, {"id": 9, "arabic": "طُو۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 13, "text": "وَأَنَا اَ۪خْتَرْتُكَ فَاسْتَمِعْ لِمَا يُوح۪يٰٓ", "words": [{"id": 1, "arabic": "وَأَنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۪خْتَرْتُكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَاسْتَمِعْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يُوح۪يٰٓ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 14, "text": "إِنَّنِيَ أَنَا اَ۬للَّهُ لَآ إِلَٰهَ إِلَّآ أَنَا فَاعْبُدْنِے وَأَقِمِ اِ۬لصَّلَوٰةَ لِذِكْرِيَۖ", "words": [{"id": 1, "arabic": "إِنَّنِيَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَٰهَ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 8, "arabic": "فَاعْبُدْنِے", "translit": "", "root": ""}, {"id": 9, "arabic": "وَأَقِمِ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لصَّلَوٰةَ", "translit": "", "root": ""}, {"id": 11, "arabic": "لِذِكْرِيَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 15, "text": "إِنَّ اَ۬لسَّاعَةَ ءَاتِيَةٌ اَكَادُ أُخْفِيهَا لِتُجْز۪يٰ كُلُّ نَفْسِۢ بِمَا تَسْع۪يٰۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لسَّاعَةَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَاتِيَةٌ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَكَادُ", "translit": "", "root": ""}, {"id": 5, "arabic": "أُخْفِيهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "لِتُجْز۪يٰ", "translit": "", "root": ""}, {"id": 7, "arabic": "كُلُّ", "translit": "", "root": ""}, {"id": 8, "arabic": "نَفْسِۢ", "translit": "", "root": ""}, {"id": 9, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 10, "arabic": "تَسْع۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 16, "text": "فَلَا يَصُدَّنَّكَ عَنْهَا مَن لَّا يُومِنُ بِهَا وَاتَّبَعَ هَو۪يٰهُ فَتَرْد۪يٰۖ", "words": [{"id": 1, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَصُدَّنَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَنْهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مَن", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "يُومِنُ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "وَاتَّبَعَ", "translit": "", "root": ""}, {"id": 9, "arabic": "هَو۪يٰهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَتَرْد۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 17, "text": "وَمَا تِلْكَ بِيَمِينِكَ يَٰمُوس۪يٰۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تِلْكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِيَمِينِكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَٰمُوس۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 18, "text": "قَالَ هِيَ عَصَايَ أَتَوَكَّؤُاْ عَلَيْهَا وَأَهُشُّ بِهَا عَلَيٰ غَنَمِے وَلِيَ فِيهَا مَـَٔارِبُ أُخْر۪يٰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "هِيَ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَصَايَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَتَوَكَّؤُاْ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيْهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَهُشُّ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 9, "arabic": "غَنَمِے", "translit": "", "root": ""}, {"id": 10, "arabic": "وَلِيَ", "translit": "", "root": ""}, {"id": 11, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 12, "arabic": "مَـَٔارِبُ", "translit": "", "root": ""}, {"id": 13, "arabic": "أُخْر۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 19, "text": "قَالَ أَلْقِهَا يَٰمُوس۪يٰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَلْقِهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "يَٰمُوس۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 20, "text": "فَأَلْق۪يٰهَا فَإِذَا هِيَ حَيَّةࣱ تَسْع۪يٰۖ", "words": [{"id": 1, "arabic": "فَأَلْق۪يٰهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "هِيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "حَيَّةࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "تَسْع۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 21, "text": "قَالَ خُذْهَا وَلَا تَخَفْ سَنُعِيدُهَا سِيرَتَهَا اَ۬لُاول۪يٰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "خُذْهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 4, "arabic": "تَخَفْ", "translit": "", "root": ""}, {"id": 5, "arabic": "سَنُعِيدُهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "سِيرَتَهَا", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لُاول۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 22, "text": "وَاضْمُمْ يَدَكَ إِلَيٰ جَنَاحِكَ تَخْرُجْ بَيْضَآءَ مِنْ غَيْرِ سُوٓءٍ اٰيَةً ا۟خْر۪يٰ", "words": [{"id": 1, "arabic": "وَاضْمُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَدَكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "جَنَاحِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "تَخْرُجْ", "translit": "", "root": ""}, {"id": 6, "arabic": "بَيْضَآءَ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِنْ", "translit": "", "r