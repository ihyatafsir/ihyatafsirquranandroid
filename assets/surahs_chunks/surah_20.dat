ion": "warsh"}, {"surah": 20, "ayah": 60, "text": "فَتَوَلّ۪يٰ فِرْعَوْنُ فَجَمَعَ كَيْدَهُۥ ثُمَّ أَت۪يٰۖ", "words": [{"id": 1, "arabic": "فَتَوَلّ۪يٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِرْعَوْنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَجَمَعَ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَيْدَهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَت۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 61, "text": "قَالَ لَهُم مُّوس۪يٰ وَيْلَكُمْ لَا تَفْتَرُواْ عَلَي اَ۬للَّهِ كَذِباࣰ فَيَسْحَتَكُم بِعَذَابࣲۖ وَقَدْ خَابَ مَنِ اِ۪فْتَر۪يٰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مُّوس۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَيْلَكُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَا", "translit": "", "root": ""}, {"id": 6, "arabic": "تَفْتَرُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 9, "arabic": "كَذِباࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَيَسْحَتَكُم", "translit": "", "root": ""}, {"id": 11, "arabic": "بِعَذَابࣲۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَقَدْ", "translit": "", "root": ""}, {"id": 13, "arabic": "خَابَ", "translit": "", "root": ""}, {"id": 14, "arabic": "مَنِ", "translit": "", "root": ""}, {"id": 15, "arabic": "اِ۪فْتَر۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 62, "text": "فَتَنَٰزَعُوٓاْ أَمْرَهُم بَيْنَهُمْ وَأَسَرُّواْ اُ۬لنَّجْو۪يٰۖ", "words": [{"id": 1, "arabic": "فَتَنَٰزَعُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَمْرَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "بَيْنَهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَأَسَرُّواْ", "translit": "", "root": ""}, 