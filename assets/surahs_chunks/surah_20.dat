مَّآ أَن نَّكُونَ أَوَّلَ مَنَ اَلْق۪يٰۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰمُوس۪يٰٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِمَّآ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "", "root": ""}, {"id": 5, "arabic": "تُلْقِيَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَإِمَّآ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَن", "translit": "", "root": ""}, {"id": 8, "arabic": "نَّكُونَ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَوَّلَ", "translit": "", "root": ""}, {"id": 10, "arabic": "مَنَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَلْق۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 66, "text": "قَالَ بَلَ اَلْقُواْۖ فَإِذَا حِبَالُهُمْ وَعِصِيُّهُمْ يُخَيَّلُ إِلَيْهِ مِن سِحْرِهِمُۥٓ أَنَّهَا تَسْع۪يٰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَلْقُواْۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 5, "arabic": "حِبَالُهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَعِصِيُّهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "يُخَيَّلُ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِلَيْهِ", "translit": "", "root": ""}, {"id": 9, "arabic": "مِن", "translit": "", "root": ""}, {"id": 10, "arabic": "سِحْرِهِمُۥٓ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَنَّهَا", "translit": "", "root": ""}, {"id": 12, "arabic": "تَسْع۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 67, "text": "فَأَوْجَسَ فِے نَفْسِهِۦ خِيفَةࣰ مُّوس۪يٰۖ", "words": [{"id": 1, "arabic": "فَأَوْجَسَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "نَفْسِهِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "خِيفَةࣰ", "translit": "", "root":