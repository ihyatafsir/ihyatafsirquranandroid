c": "مَن", "translit": "", "root": ""}, {"id": 9, "arabic": "كَذَّبَ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَتَوَلّ۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 49, "text": "قَالَ فَمَن رَّبُّكُمَا يَٰمُوس۪يٰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَمَن", "translit": "", "root": ""}, {"id": 3, "arabic": "رَّبُّكُمَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يَٰمُوس۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 50, "text": "قَالَ رَبُّنَا اَ۬لذِےٓ أَعْط۪يٰ كُلَّ شَےْءٍ خَلْقَهُۥ ثُمَّ هَد۪يٰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبُّنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِےٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَعْط۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "كُلَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "شَےْءٍ", "translit": "", "root": ""}, {"id": 7, "arabic": "خَلْقَهُۥ", "translit": "", "root": ""}, {"id": 8, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 9, "arabic": "هَد۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 51, "text": "قَالَ فَمَا بَالُ اُ۬لْقُرُونِ اِ۬لُاول۪يٰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 3, "arabic": "بَالُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْقُرُونِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لُاول۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 52, "text": "قَالَ عِلْمُهَا عِندَ رَبِّے فِے كِتَٰبࣲۖ لَّا يَضِلُّ رَبِّے وَلَا يَنسَيۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "عِلْمُهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "عِندَ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبِّے", "translit": "", "root": ""},