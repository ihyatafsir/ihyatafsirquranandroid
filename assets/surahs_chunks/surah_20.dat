 9467], [10, 9467, 10277], [11, 10277, 11290], [12, 11290, 12283], [13, 12283, 13438]], "19": [[1, 350, 1083], [2, 1083, 2221], [3, 2221, 3842]], "20": [[1, 350, 2647], [2, 2647, 3857], [3, 3857, 4450], [4, 4450, 5568], [5, 5568, 6976]], "21": [[1, 400, 1184], [2, 1184, 2154], [3, 2154, 3000], [4, 3000, 3640], [5, 3640, 5353], [6, 5353, 6818], [7, 6818, 8344]], "22": [[1, 400, 1606], [2, 1606, 2434], [3, 2434, 3522], [4, 3522, 4870], [5, 4870, 5899], [6, 5899, 7970], [7, 7970, 8443], [8, 8443, 9294], [9, 9294, 10665], [10, 10665, 11776], [11, 11776, 13124]], "23": [[1, 350, 1539], [2, 1539, 1971], [3, 1971, 3787], [4, 3787, 5096]], "24": [[1, 350, 1312], [2, 1312, 2559], [3, 2559, 4104], [4, 4104, 5337], [5, 5337, 6637]], "25": [[1, 350, 1139], [2, 1139, 1710], [3, 1710, 2457], [4, 2457, 2976], [5, 2976, 4025]], "26": [[1, 350, 1912], [2, 1912, 3204], [3, 3204, 4442]], "27": [[1, 350, 1447], [2, 1447, 2454], [3, 2454, 3226], [4, 3226, 4782]], "28": [[1, 250, 1875], [2, 1875, 2973]], "29": [[1, 350, 1491], [2, 1491, 2198], [3, 2198, 3633], [4, 3633, 4383], [5, 4383, 5383]], "30": [[1, 250, 1671], [2, 1671, 2764]], "31": [[1, 350, 1436], [2, 1436, 2403], [3, 2403, 3763]], "32": [[1, 350, 2036], [2, 2036, 3251], [3, 3251, 4416]], "33": [[1, 350, 901], [2, 901, 2213], [3, 2213, 3580]], "34": [[1, 350, 2096], [2, 2096, 3737]], "35": [[1, 350, 1710], [2, 1710, 2588], [3, 2588, 3641], [4, 3641, 5514]], "36": [[1, 350, 1151], [2, 1151, 1667], [3, 1667, 2973], [4, 2973, 3900], [5, 3900, 5670]], "37": [[1, 350, 1624], [2, 1624, 3181], [3, 3181, 4391], [4, 4391, 5305], [5, 5305, 7159]], "38": [[1, 400, 890], [2, 890, 3118], [3, 3118, 4417], [4, 4417, 5407], [5, 5407, 5961], [6, 5961, 7664]], "39": [[1, 400, 921], [2, 921, 2413], [3, 2413, 3005], [4, 3005, 4935], [5, 4935, 6663], [6, 6663, 7255], [7, 7255, 8498], [8, 8498, 10061], [9, 10061, 11304], [10, 11304, 13180], [11, 13180, 14553], [12, 14553, 15695], [13, 15695, 16464], [14, 16464, 17961], [15, 17961, 18588], [16, 18588