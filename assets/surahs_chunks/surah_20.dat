nslit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 6, "text": "لَهُۥ مَا فِے اِ۬لسَّمَٰوَٰتِ وَمَا فِے اِ۬لَارْضِ وَمَا بَيْنَهُمَا وَمَا تَحْتَ اَ۬لثَّر۪يٰۖ", "words": [{"id": 1, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 9, "arabic": "بَيْنَهُمَا", "translit": "", "root": ""}, {"id": 10, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 11, "arabic": "تَحْتَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬لثَّر۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 7, "text": "وَإِن تَجْهَرْ بِالْقَوْلِ فَإِنَّهُۥ يَعْلَمُ اُ۬لسِّرَّ وَأَخْفَيۖ", "words": [{"id": 1, "arabic": "وَإِن", "translit": "", "root": ""}, {"id": 2, "arabic": "تَجْهَرْ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِالْقَوْلِ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَإِنَّهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَعْلَمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لسِّرَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَأَخْفَيۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 8, "text": "اَ۬للَّهُ لَآ إِلَٰهَ إِلَّا هُوَۖ لَهُ اُ۬لَاسْمَآءُ اُ۬لْحُسْن۪يٰۖ", "words": [{"id": 1, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَٰهَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "هُوَۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَهُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لَاسْمَآءُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لْحُسْن۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 9, "text": "وَهَلَ اَت۪يٰكَ حَدِيثُ مُوس۪يٰٓ", "words": [{"id": 1, "arabic": "وَهَلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَت۪يٰكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "حَدِيثُ", "translit": "", "root": ""}, {"id": 4, "arabic": "مُوس۪يٰٓ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 10, "text": "إِذْ ر۪ء۪ا نَاراࣰ فَقَالَ لِأَهْلِهِ اِ۟مْكُثُوٓاْ إِنِّيَ ءَانَسْتُ نَاراࣰ لَّعَلِّيَ ءَاتِيكُم مِّنْهَا بِقَبَسٍ اَوَ اَجِدُ عَلَي اَ۬لنّ۪ارِ هُديࣰۖ", "words": [{"id": 1, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "ر۪ء۪ا", "translit": "", "root": ""}, {"id": 3, "arabic": "نَاراࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَقَالَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِأَهْلِهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۟مْكُثُوٓاْ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنِّيَ", "translit": "", "root": ""}, {"id": 8, "arabic": "ءَانَسْتُ", "translit": "", "root": ""}, {"id": 9, "arabic": "نَاراࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَّعَلِّيَ", "translit": "", "root": ""}, {"id": 11, "arabic": "ءَاتِيكُم", "translit": "", "root": ""}, {"id": 12, "arabic": "مِّنْهَا", "translit": "", "root": ""}, {"id": 13, "arabic": "بِقَبَسٍ", "translit": "", "root": ""}, {"id": 14, "arabic": "اَوَ", "translit": "", "root": ""}, {"id": 15, "arabic": "اَجِدُ", "translit": "", "root": ""}, {"id": 16, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 17, "arabic": "اَ۬لنّ۪ارِ", "translit": "", "root": ""}, {"id": 18, "arabic": "هُديࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 11, "text": "فَلَمَّآ أَت۪يٰهَا نُودِيَ يَٰمُوس۪يٰٓ", "words": [{"id": 1, "arabic": "فَلَمَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَت۪يٰهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "نُودِيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَٰمُوس۪يٰٓ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 12, "text": "إِنِّيَ أَنَا رَبُّكَ فَاخْلَعْ نَعْلَيْكَ إِنَّكَ بِالْوَادِ اِ۬لْمُقَدَّسِ طُو۪يٰۖ", "words": [{"id": 1, "arabic": "إِنِّيَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبُّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَاخْلَعْ", "translit": "", "root": ""}, {"id": 5, "arabic": "نَعْلَيْكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِنَّكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِالْوَادِ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لْمُقَدَّسِ", "translit": "", "root": ""}, {"id": 9, "arabic": "طُو۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 13, "text": "وَأَنَا اَ۪خْتَرْتُكَ فَاسْتَمِعْ لِمَا يُوح۪يٰٓ", "words": [{"id": 1, "arabic": "وَأَنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۪خْتَرْتُكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَاسْتَمِعْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يُوح۪يٰٓ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 14, "text": "إِنَّنِيَ أَنَا اَ۬للَّهُ لَآ إِلَٰهَ إِلَّآ أَنَا فَاعْبُدْنِے وَأَقِمِ اِ۬لصَّلَوٰةَ لِذِكْرِيَۖ", "words": [{"id": 1, "arabic": "إِنَّنِيَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَٰهَ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 8, "arabic": "فَاعْبُدْنِے", "translit": "", "root": ""}, {"id": 9, "arabic": "وَأَقِمِ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لصَّلَوٰةَ", "translit": "", "root": ""}, {"id": 11, "arabic": "لِذِكْرِيَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 15, "text": "إِنَّ اَ۬لسَّاعَةَ ءَاتِيَةٌ اَكَادُ أُخْفِيهَا لِتُجْز۪يٰ كُلُّ نَفْسِۢ بِمَا تَسْع۪يٰۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لسَّاعَةَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَاتِيَةٌ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَكَادُ", "translit": "", "root": ""}, {"id": 5, "arabic": "أُخْفِيهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "لِتُجْز۪يٰ", "translit": "", "root": ""}, {"id": 7, "arabic": "كُلُّ", "translit": "", "root": ""}, {"id": 8, "arabic": "نَفْسِۢ", "translit": "", "root": ""}, {"id": 9, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 10, "arabic": "تَسْع۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 16, "text": "فَلَا يَصُدَّنَّكَ عَنْهَا مَن لَّا يُومِنُ بِهَا وَاتَّبَعَ هَو۪يٰهُ فَتَرْد۪يٰۖ", "words": [{"id": 1, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَصُدَّنَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَنْهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مَن", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "يُومِنُ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "وَاتَّبَعَ", "translit": "", "root": ""}, {"id": 9, "arabic": "هَو۪يٰهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَتَرْد۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 17, "text": "وَمَا تِلْكَ بِيَمِينِكَ يَٰمُوس۪يٰۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تِلْكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِيَمِينِكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَٰمُوس۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 18, "text": "قَالَ هِيَ عَصَايَ أَتَوَكَّؤُاْ عَلَيْهَا وَأَهُشُّ بِهَا عَلَيٰ غَنَمِے وَلِيَ فِيهَا مَـَٔارِبُ أُخْر۪يٰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "هِيَ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَصَايَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَتَوَكَّؤُاْ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيْهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَهُشُّ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 9, "arabic": "غَنَمِے", "translit": "", "root": ""}, {"id": 10, "arabic": "وَلِيَ", "translit": "", "root": ""}, {"id": 11, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 12, "arabic": "مَـَٔارِبُ", "translit": "", "root": ""}, {"id": 13, "arabic": "أُخْر۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 19, "text": "قَالَ أَلْقِهَا يَٰمُوس۪يٰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَلْقِهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "يَٰمُوس۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 20, "text": "فَأَلْق۪يٰهَا فَإِذَا هِيَ حَيَّةࣱ تَسْع۪يٰۖ", "words": [{"id": 1, "arabic": "فَأَلْق۪يٰهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "هِيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "حَيَّةࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "تَسْع۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 21, "text": "قَالَ خُذْهَا وَلَا تَخَفْ سَنُعِيدُهَا سِيرَتَهَا اَ۬لُاول۪يٰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "خُذْهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 4, "arabic": "تَخَفْ", "translit": "", "root": ""}, {"id": 5, "arabic": "سَنُعِيدُهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "سِيرَتَهَا", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لُاول۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 22, "text": "وَاضْمُمْ يَدَكَ إِلَيٰ جَنَاحِكَ تَخْرُجْ بَيْضَآءَ مِنْ غَيْرِ سُوٓءٍ اٰيَةً ا۟خْر۪يٰ", "words": [{"id": 1, "arabic": "وَاضْمُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَدَكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "جَنَاحِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "تَخْرُجْ", "translit": "", "root": ""}, {"id": 6, "arabic": "بَيْضَآءَ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 8, "arabic": "غَيْرِ", "translit": "", "root": ""}, {"id": 9, "arabic": "سُوٓءٍ", "translit": "", "root": ""}, {"id": 10, "arabic": "اٰيَةً", "translit": "", "root": ""}, {"id": 11, "arabic": "ا۟خْر۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 23, "text": "لِنُرِيَكَ مِنَ اٰيَٰتِنَا اَ۬لْكُبْرَيۖ", "words": [{"id": 1, "arabic": "لِنُرِيَكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اٰيَٰتِنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْكُبْرَيۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 24, "text": "اَ۪ذْهَبِ اِلَيٰ فِرْعَوْنَ إِنَّهُۥ طَغ۪يٰۖ", "words": [{"id": 1, "arabic": "اَ۪ذْهَبِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِلَيٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِرْعَوْنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "طَغ۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 25, "text": "قَالَ رَبِّ اِ۪شْرَحْ لِے صَدْرِے", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۪شْرَحْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِے", "translit": "", "root": ""}, {"id": 5, "arabic": "صَدْرِے", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 26, "text": "وَيَسِّرْ لِيَ أَمْرِے", "words": [{"id": 1, "arabic": "وَيَسِّرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِيَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَمْرِے", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 27, "text": "وَاحْلُلْ عُقْدَةࣰ مِّن لِّسَانِے", "words": [{"id": 1, "arabic": "وَاحْلُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عُقْدَةࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 4, "arabic": "لِّسَانِے", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 28, "text": "يَفْقَهُواْ قَوْلِے", "words": [{"id": 1, "arabic": "يَفْقَهُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَوْلِے", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 29, "text": "وَاجْعَل لِّے وَزِيراࣰ مِّنَ اَهْلِے", "words": [{"id": 1, "arabic": "وَاجْعَل", "translit": "", "root": ""}, {"id": 2, "arabic": "لِّے", "translit": "", "root": ""}, {"id": 3, "arabic": "وَزِيراࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَهْلِے", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 30, "text": "هَٰرُونَ أَخِےۖ", "words": [{"id": 1, "arabic": "هَٰرُونَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَخِےۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 31, "text": "اِ۟شْدُدْ بِهِۦٓ أَزْرِے", "words": [{"id": 1, "arabic": "اِ۟شْدُدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِهِۦٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَزْرِے", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 32, "text": "وَأَشْرِكْهُ فِےٓ أَمْرِے", "words": [{"id": 1, "arabic": "وَأَشْرِكْهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَمْرِے", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 33, "text": "كَےْ نُسَبِّحَكَ كَثِيراࣰ‏", "words": [{"id": 1, "arabic": "كَےْ", "translit": "", "root": ""}, {"id": 2, "arabic": "نُسَبِّحَكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَثِيراࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 34, "text": "وَنَذْكُرَكَ كَثِيراً", "words": [{"id": 1, "arabic": "وَنَذْكُرَكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَثِيراً", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 35, "text": "اِنَّكَ كُنتَ بِنَا بَصِيراࣰۖ", "words": [{"id": 1, "arabic": "اِنَّكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "كُنتَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "بَصِيراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 36, "text": "۞قَالَ قَدُ ا۟وتِيتَ سُؤْلَكَ يَٰمُوس۪يٰۖ", "words": [{"id": 1, "arabic": "۞قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَدُ", "translit": "", "root": ""}, {"id": 3, "arabic": "ا۟وتِيتَ", "translit": "", "root": ""}, {"id": 4, "arabic": "سُؤْلَكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَٰمُوس۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 37, "text": "وَلَقَدْ مَنَنَّا عَلَيْكَ مَرَّةً ا۟خْر۪يٰٓ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنَنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَرَّةً", "translit": "", "root": ""}, {"id": 5, "arabic": "ا۟خْر۪يٰٓ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 38, "text": "إِذَ اَوْحَيْنَآ إِلَيٰٓ أُمِّكَ مَا يُوح۪يٰٓ", "words": [{"id": 1, "arabic": "إِذَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَوْحَيْنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيٰٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أُمِّكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "", "root": ""}, {"id": 6, "arabic": "يُوح۪يٰٓ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 39, "text": "أَنِ اِ۪قْذِفِيهِ فِے اِ۬لتَّابُوتِ فَاقْذِفِيهِ فِے اِ۬لْيَمِّۖ فَلْيُلْقِهِ اِ۬لْيَمُّ بِالسَّاحِلِ يَاخُذْهُ عَدُوࣱّ لِّے وَعَدُوࣱّ لَّهُۥۖ وَأَلْقَيْتُ عَلَيْكَ مَحَبَّةࣰ مِّنِّے وَلِتُصْنَعَ عَلَيٰ عَيْنِيَ", "words": [{"id": 1, "arabic": "أَنِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۪قْذِفِيهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لتَّابُوتِ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَاقْذِفِيهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْيَمِّۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَلْيُلْقِهِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لْيَمُّ", "translit": "", "root": ""}, {"id": 10, "arabic": "بِالسَّاحِلِ", "translit": "", "root": ""}, {"id": 11, "arabic": "يَاخُذْهُ", "translit": "", "root": ""}, {"id": 12, "arabic": "عَدُوࣱّ", "translit": "", "root": ""}, {"id": 13, "arabic": "لِّے", "translit": "", "root": ""}, {"id": 14, "arabic": "وَعَدُوࣱّ", "translit": "", "root": ""}, {"id": 15, "arabic": "لَّهُۥۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "وَأَلْقَيْتُ", "translit": "", "root": ""}, {"id": 17, "arabic": "عَلَيْكَ", "translit": "", "root": ""}, {"id": 18, "arabic": "مَحَبَّةࣰ", "translit": "", "root": ""}, {"id": 19, "arabic": "مِّنِّے", "translit": "", "root": ""}, {"id": 20, "arabic": "وَلِتُصْنَعَ", "translit": "", "root": ""}, {"id": 21, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 22, "arabic": "عَيْنِيَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 40, "text": "إِذْ تَمْشِےٓ أُخْتُكَ فَتَقُولُ هَلَ اَدُلُّكُمْ عَلَيٰ مَنْ يَّكْفُلُهُۥۖ فَرَجَعْنَٰكَ إِلَيٰٓ أُمِّكَ كَےْ تَقَرَّ عَيْنُهَا وَلَا تَحْزَنَۖ وَقَتَلْتَ نَفْساࣰ فَنَجَّيْنَٰكَ مِنَ اَ۬لْغَمِّ وَفَتَنَّٰكَ فُتُوناࣰۖ فَلَبِثْتَ سِنِينَ فِےٓ أَهْلِ مَدْيَنَ ثُمَّ جِئْتَ عَلَيٰ قَدَرࣲ يَٰمُوس۪يٰۖ", "words": [{"id": 1, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَمْشِےٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُخْتُكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَتَقُولُ", "translit": "", "root": ""}, {"id": 5, "arabic": "هَلَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَدُلُّكُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَنْ", "translit": "", "root": ""}, {"id": 9, "arabic": "يَّكْفُلُهُۥۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَرَجَعْنَٰكَ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِلَيٰٓ", "translit": "", "root": ""}, {"id": 12, "arabic": "أُمِّكَ", "translit": "", "root": ""}, {"id": 13, "arabic": "كَےْ", "translit": "", "root": ""}, {"id": 14, "arabic": "تَقَرَّ", "translit": "", "root": ""}, {"id": 15, "arabic": "عَيْنُهَا", "translit": "", "root": ""}, {"id": 16, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 17, "arabic": "تَحْزَنَۖ", "translit": "", "root": ""}, {"id": 18, "arabic": "وَقَتَلْتَ", "translit": "", "root": ""}, {"id": 19, "arabic": "نَفْساࣰ", "translit": "", "root": ""}, {"id": 20, "arabic": "فَنَجَّيْنَٰكَ", "translit": "", "root": ""}, {"id": 21, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 22, "arabic": "اَ۬لْغَمِّ", "translit": "", "root": ""}, {"id": 23, "arabic": "وَفَتَنَّٰكَ", "translit": "", "root": ""}, {"id": 24, "arabic": "فُتُوناࣰۖ", "translit": "", "root": ""}, {"id": 25, "ara