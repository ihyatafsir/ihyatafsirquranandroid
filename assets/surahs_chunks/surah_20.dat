: "فَأَخْرَجَ لَهُمْ عِجْلاࣰ جَسَداࣰ لَّهُۥ خُوَارࣱ فَقَالُواْ هَٰذَآ إِلَٰهُكُمْ وَإِلَٰهُ مُوس۪يٰ فَنَسِيَۖ", "words": [{"id": 1, "arabic": "فَأَخْرَجَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عِجْلاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "جَسَداࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "خُوَارࣱ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَقَالُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "هَٰذَآ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِلَٰهُكُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَإِلَٰهُ", "translit": "", "root": ""}, {"id": 11, "arabic": "مُوس۪يٰ", "translit": "", "root": ""}, {"id": 12, "arabic": "فَنَسِيَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 89, "text": "أَفَلَا يَرَوْنَ أَلَّا يَرْجِعُ إِلَيْهِمْ قَوْلاࣰ وَلَا يَمْلِكُ لَهُمْ ضَرّاࣰ وَلَا نَفْعاࣰۖ", "words": [{"id": 1, "arabic": "أَفَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَرَوْنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "يَرْجِعُ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَيْهِمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَوْلاࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 8, "arabic": "يَمْلِكُ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "ضَرّاࣰ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 12, "arabic": "نَفْعاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 90, "text": "وَلَقَدْ قَالَ لَهُمْ هَٰرُونُ مِن قَبْلُ يَٰقَوْمِ إِنَّمَا فُتِنتُم بِهِۦۖ وَإِنَّ رَبَّكُمُ اُ۬لرَّحْمَٰنُ فَاتَّبِعُونِے وَأَطِيعُوٓاْ أَمْرِےۖ", "words": [{"id": 1, "arabic