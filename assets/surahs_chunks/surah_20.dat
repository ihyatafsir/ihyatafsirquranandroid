, "ayah": 86, "text": "فَرَجَعَ مُوس۪يٰٓ إِلَيٰ قَوْمِهِۦ غَضْبَٰنَ أَسِفاࣰۖ قَالَ يَٰقَوْمِ أَلَمْ يَعِدْكُمْ رَبُّكُمْ وَعْداً حَسَناًۖ اَفَطَالَ عَلَيْكُمُ اُ۬لْعَهْدُ أَمَ اَرَدتُّمُۥٓ أَنْ يَّحِلَّ عَلَيْكُمْ غَضَبࣱ مِّن رَّبِّكُمْ فَأَخْلَفْتُم مَّوْعِدِےۖ", "words": [{"id": 1, "arabic": "فَرَجَعَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مُوس۪يٰٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَوْمِهِۦ", "translit": "", "root": ""}, {"id": 5, "arabic": "غَضْبَٰنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَسِفاࣰۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَٰقَوْمِ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَلَمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "يَعِدْكُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "رَبُّكُمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَعْداً", "translit": "", "root": ""}, {"id": 13, "arabic": "حَسَناًۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "اَفَطَالَ", "translit": "", "root": ""}, {"id": 15, "arabic": "عَلَيْكُمُ", "translit": "", "root": ""}, {"id": 16, "arabic": "اُ۬لْعَهْدُ", "translit": "", "root": ""}, {"id": 17, "arabic": "أَمَ", "translit": "", "root": ""}, {"id": 18, "arabic": "اَرَدتُّمُۥٓ", "translit": "", "root": ""}, {"id": 19, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 20, "arabic": "يَّحِلَّ", "translit": "", "root": ""}, {"id": 21, "arabic": "عَلَيْكُمْ", "translit": "", "root": ""}, {"id": 22, "arabic": "غَضَبࣱ", "translit": "", "root": ""}, {"id": 23, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 24, "arabic": "رَّبِّكُمْ", "translit": "", "root": ""}, {"id": 25, "arabic": "فَأَخْلَفْتُم", "translit": "", "root": ""}, {"id": 26, "arabic": "مَّوْعِدِےۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 87, "text": "قَالُواْ مَآ أَخْلَفْنَا مَوْعِدَكَ بِمَلْك