oot": ""}, {"id": 2, "arabic": "فَمَن", "translit": "", "root": ""}, {"id": 3, "arabic": "رَّبُّكُمَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يَٰمُوس۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 50, "text": "قَالَ رَبُّنَا اَ۬لذِےٓ أَعْط۪يٰ كُلَّ شَےْءٍ خَلْقَهُۥ ثُمَّ هَد۪يٰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبُّنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِےٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَعْط۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "كُلَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "شَےْءٍ", "translit": "", "root": ""}, {"id": 7, "arabic": "خَلْقَهُۥ", "translit": "", "root": ""}, {"id": 8, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 9, "arabic": "هَد۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 51, "text": "قَالَ فَمَا بَالُ اُ۬لْقُرُونِ اِ۬لُاول۪يٰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 3, "arabic": "بَالُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْقُرُونِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لُاول۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 52, "text": "قَالَ عِلْمُهَا عِندَ رَبِّے فِے كِتَٰبࣲۖ لَّا يَضِلُّ رَبِّے وَلَا يَنسَيۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "عِلْمُهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "عِندَ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبِّے", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "كِتَٰبࣲۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "يَضِلُّ", "translit": "", "root": ""}, {"id": 9, "arabic": "رَبِّے", "translit": "", "root": ""}, {"id": 10, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 11, "arabic": "يَنسَيۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 53, "text": "اَ۬لذِے جَعَلَ لَكُمُ اُ۬لَارْضَ مِهَٰداࣰ وَسَلَكَ لَكُمْ فِيهَا سُبُلاࣰ وَأَنزَلَ مِنَ اَ۬لسَّمَآءِ مَآءࣰۖ فَأَخْرَجْنَا بِهِۦٓ أَزْوَٰجاࣰ مِّن نَّبَاتࣲ شَتّ۪يٰۖ", "words": [{"id": 1, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 2, "arabic": "جَعَلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَكُمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لَارْضَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِهَٰداࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَسَلَكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 9, "arabic": "سُبُلاࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَأَنزَلَ", "translit": "", "root": ""}, {"id": 11, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 13, "arabic": "مَآءࣰۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "فَأَخْرَجْنَا", "translit": "", "root": ""}, {"id": 15, "arabic": "بِهِۦٓ", "translit": "", "root": ""}, {"id": 16, "arabic": "أَزْوَٰجاࣰ", "translit": "", "root": ""}, {"id": 17, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 18, "arabic": "نَّبَاتࣲ", "translit": "", "root": ""}, {"id": 19, "arabic": "شَتّ۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 54, "text": "كُلُواْ وَارْعَوَاْ اَنْعَٰمَكُمُۥٓۖ إِنَّ فِے ذَٰلِكَ لَأٓيَٰتࣲ لِّأُوْلِے اِ۬لنُّه۪يٰۖ", "words": [{"id": 1, "arabic": "كُلُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَارْعَوَاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَنْعَٰمَكُمُۥٓۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَأٓيَٰتࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "لِّأُوْلِے", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لنُّه۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 55, "text": "۞مِنْهَا خَلَقْنَٰكُمْ وَفِيهَا نُعِيدُكُمْ وَمِنْهَا نُخْرِجُكُمْ تَارَةً ا۟خْر۪يٰۖ", "words": [{"id": 1, "arabic": "۞مِنْهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْنَٰكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَفِيهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "نُعِيدُكُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمِنْهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "نُخْرِجُكُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "تَارَةً", "translit": "", "root": ""}, {"id": 8, "arabic": "ا۟خْر۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 56, "text": "وَلَقَدَ اَرَيْنَٰهُ ءَايَٰتِنَا كُلَّهَا فَكَذَّبَ وَأَب۪يٰۖ", "words": [{"id": 1, "arabic": "وَلَقَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَرَيْنَٰهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَايَٰتِنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "كُلَّهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "فَكَذَّبَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَب۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 57, "text": "قَالَ أَجِئْتَنَا لِتُخْرِجَنَا مِنَ اَرْضِنَا بِسِحْرِكَ يَٰمُوس۪يٰ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَجِئْتَنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لِتُخْرِجَنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَرْضِنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "بِسِحْرِكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَٰمُوس۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 58, "text": "فَلَنَاتِيَنَّكَ بِسِحْرࣲ مِّثْلِهِۦۖ فَاجْعَلْ بَيْنَنَا وَبَيْنَكَ مَوْعِداࣰ لَّا نُخْلِفُهُۥ نَحْنُ وَلَآ أَنتَ مَكَاناࣰ سِويࣰۖ", "words": [{"id": 1, "arabic": "فَلَنَاتِيَنَّكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِسِحْرࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّثْلِهِۦۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَاجْعَلْ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَيْنَنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَبَيْنَكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَوْعِداࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "نُخْلِفُهُۥ", "translit": "", "root": ""}, {"id": 10, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَلَآ", "translit": "", "root": ""}, {"id": 12, "arabic": "أَنتَ", "translit": "", "root": ""}, {"id": 13, "arabic": "مَكَاناࣰ", "translit": "", "root": ""}, {"id": 14, "arabic": "سِويࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 59, "text": "قَالَ مَوْعِدُكُمْ يَوْمُ اُ۬لزِّينَةِ وَأَنْ يُّحْشَرَ اَ۬لنَّاسُ ضُحيࣰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَوْعِدُكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَوْمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لزِّينَةِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَأَنْ", "translit": "", "root": ""}, {"id": 6, "arabic": "يُّحْشَرَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لنَّاسُ", "translit": "", "root": ""}, {"id": 8, "arabic": "ضُحيࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 60, "text": "فَتَوَلّ۪يٰ فِرْعَوْنُ فَجَمَعَ كَيْدَهُۥ ثُمَّ أَت۪يٰۖ", "words": [{"id": 1, "arabic": "فَتَوَلّ۪يٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِرْعَوْنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَجَمَعَ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَيْدَهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَت۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 61, "text": "قَالَ لَهُم مُّوس۪يٰ وَيْلَكُمْ لَا تَفْتَرُواْ عَلَي اَ۬للَّهِ كَذِباࣰ فَيَسْحَتَكُم بِعَذَابࣲۖ وَقَدْ خَابَ مَنِ اِ۪فْتَر۪يٰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مُّوس۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَيْلَكُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَا", "translit": "", "root": ""}, {"id": 6, "arabic": "تَفْتَرُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 9, "arabic": "كَذِباࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَيَسْحَتَكُم", "translit": "", "root": ""}, {"id": 11, "arabic": "بِعَذَابࣲۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَقَدْ", "translit": "", "root": ""}, {"id": 13, "arabic": "خَابَ", "translit": "", "root": ""}, {"id": 14, "arabic": "مَنِ", "translit": "", "root": ""}, {"id": 15, "arabic": "اِ۪فْتَر۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 62, "text": "فَتَنَٰزَعُوٓاْ أَمْرَهُم بَيْنَهُمْ وَأَسَرُّواْ اُ۬لنَّجْو۪يٰۖ", "words": [{"id": 1, "arabic": "فَتَنَٰزَعُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَمْرَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "بَيْنَهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَأَسَرُّواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لنَّجْو۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 63, "text": "قَالُوٓاْ إِنَّ هَٰذَٰنِ لَسَٰحِرَٰنِ يُرِيدَٰنِ أَنْ يُّخْرِجَٰكُم مِّنَ اَرْضِكُم بِسِحْرِهِمَا وَيَذْهَبَا بِطَرِيقَتِكُمُ اُ۬لْمُثْل۪يٰۖ", "words": [{"id": 1, "arabic": "قَالُوٓاْ", "trans