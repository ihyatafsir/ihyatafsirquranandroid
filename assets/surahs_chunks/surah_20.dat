, "ayah": 42, "text": "اَ۪ذْهَبَ اَنتَ وَأَخُوكَ بِـَٔايَٰتِے وَلَا تَنِيَا فِے ذِكْرِيَۖ", "words": [{"id": 1, "arabic": "اَ۪ذْهَبَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَنتَ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَأَخُوكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِـَٔايَٰتِے", "translit": "", "root": ""}, {"id": 5, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 6, "arabic": "تَنِيَا", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "ذِكْرِيَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 43, "text": "اَ۪ذْهَبَآ إِلَيٰ فِرْعَوْنَ إِنَّهُۥ طَغ۪يٰ", "words": [{"id": 1, "arabic": "اَ۪ذْهَبَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِرْعَوْنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "طَغ۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 44, "text": "فَقُولَا لَهُۥ قَوْلاࣰ لَّيِّناࣰ لَّعَلَّهُۥ يَتَذَكَّرُ أَوْ يَخْش۪يٰۖ", "words": [{"id": 1, "arabic": "فَقُولَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَوْلاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَّيِّناࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّعَلَّهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَتَذَكَّرُ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَوْ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَخْش۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 45, "text": "قَالَا رَبَّنَآ إِنَّنَا نَخَافُ أَنْ يَّفْرُطَ عَلَيْنَآ أَوَ اَنْ يَّطْغ۪يٰۖ", "words": [{"id": 1, "arabic": "قَالَا", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِنَّنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "نَخَافُ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَّفْرُطَ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلَيْنَآ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَوَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَنْ", "translit": "", "root": ""}, {"id": 10, "arabic": "يَّطْغ۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 46, "text": "قَالَ لَا تَخَافَآ إِنَّنِے مَعَكُمَآ أَسْمَعُ وَأَر۪يٰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "", "root": ""}, {"id": 3, "arabic": "تَخَافَآ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّنِے", "translit": "", "root": ""}, {"id": 5, "arabic": "مَعَكُمَآ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَسْمَعُ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَأَر۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 47, "text": "فَاتِيَٰهُ فَقُولَآ إِنَّا رَسُولَا رَبِّكَ فَأَرْسِلْ مَعَنَا بَنِےٓ إِسْرَآءِيلَ وَلَا تُعَذِّبْهُمْ قَدْ جِئْنَٰكَ بِـَٔايَةࣲ مِّن رَّبِّكَۖ وَالسَّلَٰمُ عَلَيٰ مَنِ اِ۪تَّبَعَ اَ۬لْهُد۪يٰٓۖ", "words": [{"id": 1, "arabic": "فَاتِيَٰهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَقُولَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "رَسُولَا", "translit": "", "root": ""}, {"id": 5, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَأَرْسِلْ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَعَنَا", "translit": "", "root": ""}, {"id": 8, "arabic": "بَنِےٓ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِسْرَآءِيلَ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 11, "arabic": "تُعَذِّبْهُمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "قَدْ", "translit": "", "root": ""}, {"id": 13, "arabic": "ج