, "narration": "warsh"}, {"surah": 20, "ayah": 89, "text": "أَفَلَا يَرَوْنَ أَلَّا يَرْجِعُ إِلَيْهِمْ قَوْلاࣰ وَلَا يَمْلِكُ لَهُمْ ضَرّاࣰ وَلَا نَفْعاࣰۖ", "words": [{"id": 1, "arabic": "أَفَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَرَوْنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "يَرْجِعُ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَيْهِمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَوْلاࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 8, "arabic": "يَمْلِكُ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "ضَرّاࣰ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 12, "arabic": "نَفْعاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 90, "text": "وَلَقَدْ قَالَ لَهُمْ هَٰرُونُ مِن قَبْلُ يَٰقَوْمِ إِنَّمَا فُتِنتُم بِهِۦۖ وَإِنَّ رَبَّكُمُ اُ۬لرَّحْمَٰنُ فَاتَّبِعُونِے وَأَطِيعُوٓاْ أَمْرِےۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "هَٰرُونُ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "قَبْلُ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَٰقَوْمِ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنَّمَا", "translit": "", "root": ""}, {"id": 9, "arabic": "فُتِنتُم", "translit": "", "root": ""}, {"id": 10, "arabic": "بِهِۦۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَإِنَّ", "translit": "", "root": ""}, {"id": 12, "arabic": "رَبَّكُمُ", "translit": "", "root": ""}, {"id": 13, "arabic": "اُ۬لرَّحْمَٰنُ", "translit": "", "root": ""}, {"id": 14, "arabic": "فَاتَّبِعُونِے", "translit": "", "root": ""}, {"id": 15, "arabic":