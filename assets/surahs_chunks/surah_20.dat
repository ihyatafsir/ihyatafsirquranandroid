عْط۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "كُلَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "شَےْءٍ", "translit": "", "root": ""}, {"id": 7, "arabic": "خَلْقَهُۥ", "translit": "", "root": ""}, {"id": 8, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 9, "arabic": "هَد۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 51, "text": "قَالَ فَمَا بَالُ اُ۬لْقُرُونِ اِ۬لُاول۪يٰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 3, "arabic": "بَالُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْقُرُونِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لُاول۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 52, "text": "قَالَ عِلْمُهَا عِندَ رَبِّے فِے كِتَٰبࣲۖ لَّا يَضِلُّ رَبِّے وَلَا يَنسَيۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "عِلْمُهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "عِندَ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبِّے", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "كِتَٰبࣲۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "يَضِلُّ", "translit": "", "root": ""}, {"id": 9, "arabic": "رَبِّے", "translit": "", "root": ""}, {"id": 10, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 11, "arabic": "يَنسَيۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 53, "text": "اَ۬لذِے جَعَلَ لَكُمُ اُ۬لَارْضَ مِهَٰداࣰ وَسَلَكَ لَكُمْ فِيهَا سُبُلاࣰ وَأَنزَلَ مِنَ اَ۬لسَّمَآءِ مَآءࣰۖ فَأَخْرَجْنَا بِهِۦٓ أَزْوَٰجاࣰ مِّن نَّبَاتࣲ شَتّ۪يٰۖ", "words": [{"id": 1, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 2, "arabic": "جَعَلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَكُمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لَارْضَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِهَٰداࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَسَلَكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 9, "arabic": "سُبُلاࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَأَنزَلَ", "translit": "", "root": ""}, {"id": 11, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 13, "arabic": "مَآءࣰۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "فَأَخْرَجْنَا", "translit": "", "root": ""}, {"id": 15, "arabic": "بِهِۦٓ", "translit": "", "root": ""}, {"id": 16, "arabic": "أَزْوَٰجاࣰ", "translit": "", "root": ""}, {"id": 17, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 18, "arabic": "نَّبَاتࣲ", "translit": "", "root": ""}, {"id": 19, "arabic": "شَتّ۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 54, "text": "كُلُواْ وَارْعَوَاْ اَنْعَٰمَكُمُۥٓۖ إِنَّ فِے ذَٰلِكَ لَأٓيَٰتࣲ لِّأُوْلِے اِ۬لنُّه۪يٰۖ", "words": [{"id": 1, "arabic": "كُلُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَارْعَوَاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَنْعَٰمَكُمُۥٓۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَأٓيَٰتࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "لِّأُوْلِے", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لنُّه۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 55, "text": "۞مِنْهَا خَلَقْنَٰكُمْ وَفِيهَا نُعِيدُكُمْ وَمِنْهَا نُخْرِجُكُمْ تَارَةً ا۟خْر۪يٰۖ", "words": [{"id": 1, "arabic": "۞مِنْهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْنَٰكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَفِيهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "نُعِيدُكُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمِنْهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "نُخْرِجُكُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "تَارَةً", "translit": "", "root": ""}, {"id": 8, "arabic": "ا۟خْر۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 56, "text": "وَلَقَدَ اَرَيْنَٰهُ ءَايَٰتِنَا كُلَّهَا فَكَذَّبَ وَأَب۪يٰۖ", "words": [{"id": 1, "arabic": "وَلَقَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَرَيْنَٰهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَايَٰتِنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "كُلَّهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "فَكَذَّبَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَب۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 57, "text": "قَالَ أَجِئْتَنَا لِتُخْرِجَنَا مِنَ اَرْضِنَا بِسِحْرِكَ يَٰمُوس۪يٰ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَجِئْتَنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لِتُخْرِجَنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَرْضِنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "بِسِحْرِكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَٰمُوس۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 20, "ayah": 58, "text": "فَلَنَاتِيَنَّكَ بِسِحْرࣲ مِّثْلِهِۦۖ فَاجْعَلْ بَيْنَنَا وَبَيْنَكَ مَوْعِداࣰ لَّا نُخْلِفُهُۥ نَحْنُ وَلَآ أَنتَ مَكَاناࣰ سِويࣰۖ", "words": [{"id": 1, "arabic": "فَلَنَاتِيَنَّكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِسِحْرࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّثْلِهِۦۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَاجْعَلْ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَيْنَنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَبَيْنَكَ", "translit": "", "root"