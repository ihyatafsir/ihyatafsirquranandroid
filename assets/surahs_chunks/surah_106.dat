{"surah": 106, "verses": [{"ayah": 1, "text": "لِإِيلَٰفِ قُرَيْشٍ ", "translation": "For the accustomed security of the Quraysh[1] -", "words": [{"id": 1, "arabic": "لِإِيلَٰفِ", "translit": "ِfَٰlyِiʾِl", "root": "الف"}, {"id": 2, "arabic": "قُرَيْشٍ", "translit": "ٍhsْyَrُq", "root": "قرش"}], "hasIhya": false}, {"ayah": 2, "text": "إِۦلَٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ ", "translation": "Their accustomed security [in] the caravan of winter and summer[1] -", "words": [{"id": 1, "arabic": "إِۦلَٰفِهِمْ", "translit": "ْmِhِfَٰlۦِiʾ", "root": "الف"}, {"id": 2, "arabic": "رِحْلَةَ", "translit": "َẗَlْḥِr", "root": "رحل"}, {"id": 3, "arabic": "ٱلشِّتَآءِ", "translit": "ِءٓāَtِّhslٱ", "root": "شتو"}, {"id": 4, "arabic": "وَٱلصَّيْفِ", "translit": "ِfْyَّṣlٱَw", "root": "صيف"}], "hasIhya": false}, {"ayah": 3, "text": "فَلْيَعْبُدُوا۟ رَبَّ هَٰذَا ٱلْبَيْتِ ", "translation": "Let them worship the Lord of this House,[1]", "words": [{"id": 1, "arabic": "فَلْيَعْبُدُوا۟", "translit": "۟āwُdُbْʿعَyْlَf", "root": "عبد"}, {"id": 2, "arabic": "رَبَّ", "translit": "َّbَr", "root": "ربب"}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "ٱلْبَيْتِ", "translit": "ِtْyَbْlٱ", "root": "بيت"}], "hasIhya": false}, {"ayah": 4, "text": "ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ ", "translation": "Who has fed them, [saving them] from hunger and made them safe, [saving them] from fear.", "words": [{"id": 1, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "أَطْعَمَهُم", "translit": "mُhَmَʿعْṭَaʾ", "root": "طعم"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "جُوعٍ", "translit": "ٍʿعwُjg", "root": "جوع"}, {"id": 5, "arabic": "وَءَامَنَهُم", "translit": "mُhَnَmāَءَw", "root": "امن"}, {"id": 6, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 7, "arabic": "خَوْفٍۭ", "translit": "ٍۭfْwَhk", "root": "خوف"}], "hasIhya": false}], "tafsir": {}, "wordTiming