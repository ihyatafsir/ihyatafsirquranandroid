arsh"}, {"surah": 79, "ayah": 2, "text": "وَالنَّٰشِطَٰتِ نَشْطاࣰ‏", "words": [{"id": 1, "arabic": "وَالنَّٰشِطَٰتِ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَشْطاࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 3, "text": "وَالسَّٰبِحَٰتِ سَبْحاࣰ‏", "words": [{"id": 1, "arabic": "وَالسَّٰبِحَٰتِ", "translit": "", "root": ""}, {"id": 2, "arabic": "سَبْحاࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 4, "text": "فَالسَّٰبِقَٰتِ سَبْقاࣰ‏", "words": [{"id": 1, "arabic": "فَالسَّٰبِقَٰتِ", "translit": "", "root": ""}, {"id": 2, "arabic": "سَبْقاࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 5, "text": "فَالْمُدَبِّرَٰتِ أَمْراࣰ‏", "words": [{"id": 1, "arabic": "فَالْمُدَبِّرَٰتِ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَمْراࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 6, "text": "يَوْمَ تَرْجُفُ اُ۬لرَّاجِفَةُ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَرْجُفُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لرَّاجِفَةُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 7, "text": "تَتْبَعُهَا اَ۬لرَّادِفَةُۖ", "words": [{"id": 1, "arabic": "تَتْبَعُهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لرَّادِفَةُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 8, "text": "قُلُوبࣱ يَوْمَئِذࣲ وَاجِفَةٌ", "words": [{"id": 1, "arabic": "قُلُوبࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَوْمَئِذࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَاجِفَةٌ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 9, "text": "اَبْصَٰرُهَا خَٰشِعَةࣱۖ", "words": [{"id": 1, "arabic": "اَبْصَٰرُهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "خَٰشِعَةࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 10, "text": "يَقُولُونَ أَ۟نَّا لَمَرْدُو