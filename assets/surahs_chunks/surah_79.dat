": 3, "arabic": "فَسَوَّيٰهَا", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 29, "text": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَيٰهَاۖ", "words": [{"id": 1, "arabic": "وَأَغْطَشَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَيْلَهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "وَأَخْرَجَ", "translit": "", "root": ""}, {"id": 4, "arabic": "ضُحَيٰهَاۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 30, "text": "وَالَارْضَ بَعْدَ ذَٰلِكَ دَحَيٰهَآ", "words": [{"id": 1, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَعْدَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "دَحَيٰهَآ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 31, "text": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَيٰهَا", "words": [{"id": 1, "arabic": "أَخْرَجَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِنْهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مَآءَهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمَرْعَيٰهَا", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 32, "text": "وَالْجِبَالَ أَرْسَيٰهَا", "words": [{"id": 1, "arabic": "وَالْجِبَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَرْسَيٰهَا", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 33, "text": "مَتَٰعاࣰ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ", "words": [{"id": 1, "arabic": "مَتَٰعاࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَّكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَلِأَنْعَٰمِكُمْۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 34, "text": "فَإِذَا جَآءَتِ اِ۬لطَّآمَّةُ اُ۬لْكُبْر۪يٰ", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَآءَتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لطَّآمَّةُ", "translit": "", "root": ""}, {"id": 4, "arabic":