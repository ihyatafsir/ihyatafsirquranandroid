, "translit": "", "root": ""}, {"id": 4, "arabic": "مُوس۪يٰٓ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 16, "text": "إِذْ نَاد۪يٰهُ رَبُّهُۥ بِالْوَادِ اِ۬لْمُقَدَّسِ طُوَيۖ", "words": [{"id": 1, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَاد۪يٰهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبُّهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِالْوَادِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْمُقَدَّسِ", "translit": "", "root": ""}, {"id": 6, "arabic": "طُوَيۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 17, "text": "اَ۪ذْهَبِ اِلَيٰ فِرْعَوْنَ إِنَّهُۥ طَغ۪يٰ", "words": [{"id": 1, "arabic": "اَ۪ذْهَبِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِلَيٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِرْعَوْنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "طَغ۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 18, "text": "فَقُلْ هَل لَّكَ إِلَيٰٓ أَن تَزَّكّ۪يٰ", "words": [{"id": 1, "arabic": "فَقُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَل", "translit": "", "root": ""}, {"id": 3, "arabic": "لَّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَيٰٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَن", "translit": "", "root": ""}, {"id": 6, "arabic": "تَزَّكّ۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 19, "text": "وَأَهْدِيَكَ إِلَيٰ رَبِّكَ فَتَخْش۪يٰۖ", "words": [{"id": 1, "arabic": "وَأَهْدِيَكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَتَخْش۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 20, "text": "فَأَر۪يٰهُ اُ۬لَايَةَ اَ۬لْكُبْر۪يٰ", "words": [{"id": 1, "arabic": "فَأَر۪يٰهُ", "translit": "",