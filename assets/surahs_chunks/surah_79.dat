{"surah": 79, "verses": [{"ayah": 1, "text": "وَٱلنَّٰزِعَٰتِ غَرْقًا ", "translation": "By those [angels] who extract with violence[1]", "words": [{"id": 1, "arabic": "وَٱلنَّٰزِعَٰتِ", "translit": "ِtَٰʿعِzَّٰnlٱَw", "root": "نزع"}, {"id": 2, "arabic": "غَرْقًا", "translit": "āًqْrَغ", "root": "غرق"}], "hasIhya": false}, {"ayah": 2, "text": "وَٱلنَّٰشِطَٰتِ نَشْطًا ", "translation": "And [by] those who remove with ease[1]", "words": [{"id": 1, "arabic": "وَٱلنَّٰشِطَٰتِ", "translit": "ِtَٰṭِhsَّٰnlٱَw", "root": "نشط"}, {"id": 2, "arabic": "نَشْطًا", "translit": "āًṭْhsَn", "root": "نشط"}], "hasIhya": false}, {"ayah": 3, "text": "وَٱلسَّٰبِحَٰتِ سَبْحًا ", "translation": "And [by] those who glide [as if] swimming[1]", "words": [{"id": 1, "arabic": "وَٱلسَّٰبِحَٰتِ", "translit": "ِtَٰḥِbَّٰslٱَw", "root": "سبح"}, {"id": 2, "arabic": "سَبْحًا", "translit": "āًḥْbَs", "root": "سبح"}], "hasIhya": false}, {"ayah": 4, "text": "فَٱلسَّٰبِقَٰتِ سَبْقًا ", "translation": "And those who race each other in a race[1]", "words": [{"id": 1, "arabic": "فَٱلسَّٰبِقَٰتِ", "translit": "ِtَٰqِbَّٰslٱَf", "root": "سبق"}, {"id": 2, "arabic": "سَبْقًا", "translit": "āًqْbَs", "root": "سبق"}], "hasIhya": false}, {"ayah": 5, "text": "فَٱلْمُدَبِّرَٰتِ أَمْرًا ", "translation": "And those who arrange [each] matter,[1]", "words": [{"id": 1, "arabic": "فَٱلْمُدَبِّرَٰتِ", "translit": "ِtَٰrِّbَdُmْlٱَf", "root": "دبر"}, {"id": 2, "arabic": "أَمْرًا", "translit": "āًrْmَaʾ", "root": "امر"}], "hasIhya": false}, {"ayah": 6, "text": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ ", "translation": "On the Day the blast [of the Horn] will convulse [creation],", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "تَرْجُفُ", "translit": "ُfُjgْrَt", "root": "رجف"}, {"id": 3, "arabic": "ٱلرَّاجِفَةُ", "translit": "ُẗَfِjgāَّrlٱ", "root": "رجف"}], "hasIhya": false}, {"ayah": 7, "text": "تَتْبَعُهَا ٱلرَّادِفَةُ ", "translation": "There will follow it the subsequent [one].", "words": [{"id": 1, "arabic": "تَتْبَعُهَا", "translit": "āَhُʿعَbْtَt", "root": "تبع"}, {"id": 2, "arabic": "ٱلرَّادِفَةُ", "translit": "ُẗَfِdāَّrlٱ", "root": "ردف"}], "hasIhya": false}, {"ayah": 8, "text": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ ", "translation": "Hearts,[1] that Day, will tremble,", "words": [{"id": 1, "arabic": "قُلُوبٌ", "translit": "ٌbwُlُq", "root": "قلب"}, {"id": 2, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 3, "arabic": "وَاجِفَةٌ", "translit": "ٌẗَfِjgāَw", "root": "وجف"}], "hasIhya": false}, {"ayah": 9, "text": "أَبْصَٰرُهَا خَٰشِعَةٌ ", "translation": "Their eyes[1] humbled.", "words": [{"id": 1, "arabic": "أَبْصَٰرُهَا", "translit": "āَhُrَٰṣْbَaʾ", "root": "بصر"}, {"id": 2, "arabic": "خَٰشِعَةٌ", "translit": "ٌẗَʿعِhsَٰhk", "root": "خشع"}], "hasIhya": false}, {"ayah": 10, "text": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ ", "translation": "They are [presently] saying, \"Will we indeed be returned to [our] former state [of life]?", "words": [{"id": 1, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 2, "arabic": "أَءِنَّا", "translit": "āَّnِءَaʾ", "root": ""}, {"id": 3, "arabic": "لَمَرْدُودُونَ", "translit": "َnwُdwُdْrَmَl", "root": "ردد"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْحَافِرَةِ", "translit": "ِẗَrِfāَḥْlٱ", "root": "حفر"}], "hasIhya": false}, {"ayah": 11, "text": "أَءِذَا كُنَّا عِظَٰمًا نَّخِرَةً ", "translation": "Even if we should be decayed bones?\"[1]", "words": [{"id": 1, "arabic": "أَءِذَا", "translit": "āَhdِءَaʾ", "root": ""}, {"id": 2, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 3, "arabic": "عِظَٰمًا", "translit": "āًmَٰẓِʿع", "root": "عظم"}, {"id": 4, "arabic": "نَّخِرَةً", "translit": "ًẗَrِhkَّn", "root": "نخر"}], "hasIhya": false}, {"ayah": 12, "text": "قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ ", "translation": "They say, \"That, then, would be a losing return.\"[1]", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 3, "arabic": "إِذًا", "translit": "āًhdِiʾ", "root": ""}, {"id": 4, "arabic": "كَرَّةٌ", "translit": "ٌẗَّrَk", "root": "كرر"}, {"id": 5, "arabic": "خَاسِرَةٌ", "translit": "ٌẗَrِsāَhk", "root": "خسر"}], "hasIhya": false}, {"ayah": 13, "text": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ ", "translation": "Indeed, it will be but one shout,", "words": [{"id": 1, "arabic": "فَإِنَّمَا", "translit": "āَmَّnِiʾَf", "root": ""}, {"id": 2, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 3, "arabic": "زَجْرَةٌ", "translit": "ٌẗَrْjgَz", "root": "زجر"}, {"id": 4, "arabic": "وَٰحِدَةٌ", "translit": "ٌẗَdِḥَٰw", "root": "وحد"}], "hasIhya": false}, {"ayah": 14, "text": "فَإِذَا هُم بِٱلسَّاهِرَةِ ", "translation": "And suddenly they will be [alert] upon the earth's surface.", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 2, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 3, "arabic": "بِٱلسَّاهِرَةِ", "translit": "ِẗَrِhāَّslٱِb", "root": "سهر"}], "hasIhya": false}, {"ayah": 15, "text": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ ", "translation": "Has there reached you the story of Moses? -", "words": [{"id": 1, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 2, "arabic": "أَتَىٰكَ", "translit": "َkٰàَtَaʾ", "root": "اتي"}, {"id": 3, "arabic": "حَدِيثُ", "translit": "ُhtyِdَḥ", "root": "حدث"}, {"id": 4, "arabic": "مُوسَىٰٓ", "translit": "ٰٓàَswُm", "root": ""}], "hasIhya": false}, {"ayah": 16, "text": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى ", "translation": "When his Lord called to him in the sacred valley of Ṭuwā,", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "نَادَىٰهُ", "translit": "ُhٰàَdāَn", "root": "ندي"}, {"id": 3, "arabic": "رَبُّهُۥ", "translit": "ۥُhُّbَr", "root": "ربب"}, {"id": 4, "arabic": "بِٱلْوَادِ", "translit": "ِdāَwْlٱِb", "root": "ودي"}, {"id": 5, "arabic": "ٱلْمُقَدَّسِ", "translit": "ِsَّdَqُmْlٱ", "root": "قدس"}, {"id": 6, "arabic": "طُوًى", "translit": "àًwُṭ", "root": "طوي"}], "hasIhya": false}, {"ayah": 17, "text": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ ", "translation": "\"Go to Pharaoh. Indeed, he has transgressed.", "words": [{"id": 1, "arabic": "ٱذْهَبْ", "translit": "ْbَhْhdٱ", "root": "ذهب"}, {"id": 2, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 3, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 4, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 5, "arabic": "طَغَىٰ", "translit": "ٰàَغَṭ", "root": "طغي"}], "hasIhya": true}, {"ayah": 18, "text": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ ", "translation": "And say to him, 'Would you [be willing to] purify yourself", "words": [{"id": 1, "arabic": "فَقُلْ", "translit": "ْlُqَf", "root": "قول"}, {"id": 2, "arabic": "هَل", "translit": "lَh", "root": ""}, {"id": 3, "arabic": "لَّكَ", "translit": "َkَّl", "root": ""}, {"id": 4, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "تَزَكَّىٰ", "translit": "ٰàَّkَzَt", "root": "زكو"}], "hasIhya": false}, {"ayah": 19, "text": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ ", "translation": "And let me guide you to your Lord so you would fear [Him]?'\"", "words": [{"id": 1, "arabic": "وَأَهْدِيَكَ", "translit": "َkَyِdْhَaʾَw", "root": "هدي"}, {"id": 2, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 3, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "فَتَخْشَىٰ", "translit": "ٰàَhsْhkَtَf", "root": "خشي"}], "hasIhya": false}, {"ayah": 20, "text": "فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ ", "translation": "And he showed him the greatest sign,[1]", "words": [{"id": 1, "arabic": "فَأَرَىٰهُ", "translit": "ُhٰàَrَaʾَf", "root": "راي"}, {"id": 2, "arabic": "ٱلْءَايَةَ", "translit": "َẗَyāَءْlٱ", "root": "ايي"}, {"id": 3, "arabic": "ٱلْكُبْرَىٰ", "translit": "ٰàَrْbُkْlٱ", "root": "كبر"}], "hasIhya": false}, {"ayah": 21, "text": "فَكَذَّبَ وَعَصَىٰ ", "translation": "But he [i.e., Pharaoh] denied and disobeyed.", "words": [{"id": 1, "arabic": "فَكَذَّبَ", "translit": "َbَّhdَkَf", "root": "كذب"}, {"id": 2, "arabic": "وَعَصَىٰ", "translit": "ٰàَṣَʿعَw", "root": "عصي"}], "hasIhya": false}, {"ayah": 22, "text": "ثُمَّ أَدْبَرَ يَسْعَىٰ ", "translation": "Then he turned his back, striving [i.e., plotting].[1]", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "أَدْبَرَ", "translit": "َrَbْdَaʾ", "root": "دبر"}, {"id": 3, "arabic": "يَسْعَىٰ", "translit": "ٰàَʿعْsَy", "root": "سعي"}], "hasIhya": false}, {"ayah": 23, "text": "فَحَشَرَ فَنَادَىٰ ", "translation": "And he gathered [his people] and called out", "words": [{"id": 1, "arabic": "فَحَشَرَ", "translit": "َrَhsَḥَf", "root": "حشر"}, {"id": 2, "arabic": "فَنَادَىٰ", "translit": "ٰàَdāَnَf", "root": "ندي"}], "hasIhya": false}, {"ayah": 24, "text": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ ", "translation": "And said, \"I am your most exalted lord.\"", "words": [{"id": 1, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 2, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 3, "arabic": "رَبُّكُمُ", "translit": "ُmُkُّbَr", "root": "ربب"}, {"id": 4, "arabic": "ٱلْأَعْلَىٰ", "translit": "ٰàَlْʿعَaʾْlٱ", "root": "علو"}], "hasIhya": false}, {"ayah": 25, "text": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ ", "translation": "So Allāh seized him in exemplary punishment for the last and the first [transgression].[1].", "words": [{"id": 1, "arabic": "فَأَخَذَهُ", "translit": "ُhَhdَhkَaʾَf", "root": "اخذ"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "نَكَالَ", "translit": "َlāَkَn", "root": "نكل"}, {"id": 4, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 5, "arabic": "وَٱلْأُولَىٰٓ", "translit": "ٰٓàَlwُaʾْlٱَw", "root": "اول"}], "hasIhya": false}, {"ayah": 26, "text": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ ", "translation": "Indeed in that is a lesson [i.e., warning] for whoever would fear [Allāh].", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 4, "arabic": "لَعِبْرَةً", "translit": "ًẗَrْbِʿعَl", "root": "عبر"}, {"id": 5, "arabic": "لِّمَن", "translit": "nَmِّl", "root": ""}, {"id": 6, "arabic": "يَخْشَىٰٓ", "translit": "ٰٓàَhsْhkَy", "root": "خشي"}], "hasIhya": false}, {"ayah": 27, "text": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا ", "translation": "Are you a more difficult creation or is the heaven? He [i.e., Allāh] constructed it.", "words": [{"id": 1, "arabic": "ءَأَنتُمْ", "translit": "ْmُtnَaʾَء", "root": ""}, {"id": 2, "arabic": "أَشَدُّ", "translit": "ُّdَhsَaʾ", "root": "شدد"}, {"id": 3, "arabic": "خَلْقًا", "translit": "āًqْlَhk", "root": "خلق"}, {"id": 4, "arabic": "أَمِ", "translit": "ِmَaʾ", "root": ""}, {"id": 5, "arabic": "ٱلسَّمَآءُ", "translit": "ُءٓāَmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "بَنَىٰهَا", "translit": "āَhٰàَnَb", "root": "بني"}], "hasIhya": true}, {"ayah": 28, "text": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا ", "translation": "He raised its ceiling and proportioned it.", "words": [{"id": 1, "arabic": "رَفَعَ", "translit": "َʿعَfَr", "root": "رفع"}, {"id": 2, "arabic": "سَمْكَهَا", "translit": "āَhَkْmَs", "root": "سمك"}, {"id": 3, "arabic": "فَسَوَّىٰهَا", "translit": "āَhٰàَّwَsَf", "root": "سوي"}], "hasIhya": false}, {"ayah": 29, "text": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا ", "translation": "And He darkened its night and extracted its brightness.[1]", "words": [{"id": 1, "arabic": "وَأَغْطَشَ", "translit": "َhsَṭْغَaʾَw", "root": "غطش"}, {"id": 2, "arabic": "لَيْلَهَا", "translit": "āَhَlْyَl", "root": "ليل"}, {"id": 3, "arabic": "وَأَخْرَجَ", "translit": "َjgَrْhkَaʾَw", "root": "خرج"}, {"id": 4, "arabic": "ضُحَىٰهَا", "translit": "āَhٰàَḥُḍ", "root": "ضحو"}], "hasIhya": false}, {"ayah": 30, "text": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ ", "translation": "And after that He spread the earth.", "words": [{"id": 1, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 2, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 3, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 4, "arabic": "دَحَىٰهَآ", "translit": "ٓāَhٰàَḥَd", "root": "دحو"}], "hasIhya": false}, {"ayah": 31, "text": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا ", "translation": "He extracted from it its water and its pasture,", "words": [{"id": 1, "arabic": "أَخْرَجَ", "translit": "َjgَrْhkَaʾ", "root": "خرج"}, {"id": 2, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 3, "arabic": "مَآءَهَا", "translit": "āَhَءٓāَm", "root": "موه"}, {"id": 4, "arabic": "وَمَرْعَىٰهَا", "translit": "āَhٰàَʿعْrَmَw", "root": "رعي"}], "hasIhya": false}, {"ayah": 32, "text": "وَٱلْجِبَالَ أَرْسَىٰهَا ", "translation": "And the mountains He set firmly", "words": [{"id": 1, "arabic": "وَٱلْجِبَالَ", "translit": "َlāَbِjgْlٱَw", "root": "جبل"}, {"id": 2, "arabic": "أَرْسَىٰهَا", "translit": "āَhٰàَsْrَaʾ", "root": "رسو"}], "hasIhya": false}, {"ayah": 33, "text": "مَتَٰعًا لَّكُمْ وَلِأَنْعَٰمِكُمْ ", "translation": "As enjoyment [i.e., provision] for you and your grazing livestock.", "words": [{"id": 1, "arabic": "مَتَٰعًا", "translit": "āًʿعَٰtَm", "root": "متع"}, {"id": 2, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 3, "arabic": "وَلِأَنْعَٰمِكُمْ", "translit": "ْmُkِmَٰʿعْnَaʾِlَw", "root": "نعم"}], "hasIhya": false}, {"ayah": 34, "text": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ ", "translation": "But when there comes the greatest Overwhelming Calamity[1] -", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 2, "arabic": "جَآءَتِ", "translit": "ِtَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "ٱلطَّآمَّةُ", "translit": "ُẗَّmٓāَّṭlٱ", "root": "طمم"}, {"id": 4, "arabic": "ٱلْكُبْرَىٰ", "translit": "ٰàَrْbُkْlٱ", "root": "كبر"}], "hasIhya": false}, {"ayah": 35, "text": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَٰنُ مَا سَعَىٰ ", "translation": "The Day when man will remember that for which he strove,", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "يَتَذَكَّرُ", "translit": "ُrَّkَhdَtَy", "root": "ذكر"}, {"id": 3, "arabic": "ٱلْإِنسَٰنُ", "translit": "ُnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "سَعَىٰ", "translit": "ٰàَʿعَs", "root": "سعي"}], "hasIhya": false}, {"ayah": 36, "text": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ ", "translation": "And Hellfire will be exposed for [all] those who see -", "words": [{"id": 1, "arabic": "وَبُرِّزَتِ", "translit": "ِtَzِّrُbَw", "root": "برز"}, {"id": 2, "arabic": "ٱلْجَحِيمُ", "translit": "ُmyِḥَjgْlٱ", "root": "جحم"}, {"id": 3, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 4, "arabic": "يَرَىٰ", "translit": "ٰàَrَy", "root": "راي"}], "hasIhya": false}, {"ayah": 37, "text": "فَأَمَّا مَن طَغَىٰ ", "translation": "So as for he who transgressed", "words": [{"id": 1, "arabic": "فَأَمَّا", "translit": "āَّmَaʾَf", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "طَغَىٰ", "translit": "ٰàَغَṭ", "root": "طغي"}], "hasIhya": true}, {"ayah": 38, "text": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا ", "translation": "And preferred the life of the world,", "words": [{"id": 1, "arabic": "وَءَاثَرَ", "translit": "َrَhtāَءَw", "root": "اثر"}, {"id": 2, "arabic": "ٱلْحَيَوٰةَ", "translit": "َẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 3, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}], "hasIhya": false}, {"ayah": 39, "text": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ ", "translation": "Then indeed, Hellfire will be [his] refuge.", "words": [{"id": 1, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 2, "arabic": "ٱلْجَحِيمَ", "translit": "َmyِḥَjgْlٱ", "root": "جحم"}, {"id": 3, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 4, "arabic": "ٱلْمَأْوَىٰ", "translit": "ٰàَwْaʾَmْlٱ", "root": "اوي"}], "hasIhya": false}, {"ayah": 40, "text": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ ", "translation": "But as for he who feared the position of his Lord[1] and prevented the soul from [unlawful] inclination,", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "āَّmَaʾَw", "root": ""}, {"id": 2, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 3, "arabic": "خَافَ", "translit": "َfāَhk", "root": "خوف"}, {"id": 4, "arabic": "مَقَامَ", "translit": "َmāَqَm", "root": "قوم"}, {"id": 5, "arabic": "رَبِّهِۦ", "translit": "ۦِhِّbَr", "root": "ربب"}, {"id": 6, "arabic": "وَنَهَى", "translit": "àَhَnَw", "root": "نهي"}, {"id": 7, "arabic": "ٱلنَّفْسَ", "translit": "َsْfَّnlٱ", "root": "نفس"}, {"id": 8, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 9, "arabic": "ٱلْهَوَىٰ", "translit": "ٰàَwَhْlٱ", "root": "هوي"}], "hasIhya": true}, {"ayah": 41, "text": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ ", "translation": "Then indeed, Paradise will be [his] refuge.", "words": [{"id": 1, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 2, "arabic": "ٱلْجَنَّةَ", "translit": "َẗَّnَjgْlٱ", "root": "جنن"}, {"id": 3, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 4, "arabic": "ٱلْمَأْوَىٰ", "translit": "ٰàَwْaʾَmْlٱ", "root": "اوي"}], "hasIhya": false}, {"ayah": 42, "text": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا ", "translation": "They ask you, [O Muḥammad], about the Hour: when is its arrival?[1]", "words": [{"id": 1, "arabic": "يَسْـَٔلُونَكَ", "translit": "َkَnwُlَٔـْsَy", "root": "سال"}, {"id": 2, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 3, "arabic": "ٱلسَّاعَةِ", "translit": "ِẗَʿعāَّslٱ", "root": "سوع"}, {"id": 4, "arabic": "أَيَّانَ", "translit": "َnāَّyَaʾ", "root": ""}, {"id": 5, "arabic": "مُرْسَىٰهَا", "translit": "āَhٰàَsْrُm", "root": "رسو"}], "hasIhya": false}, {"ayah": 43, "text": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ ", "translation": "In what [position] are you that you should mention it?[1]", "words": [{"id": 1, "arabic": "فِيمَ", "translit": "َmyِf", "root": ""}, {"id": 2, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "ذِكْرَىٰهَآ", "translit": "ٓāَhٰàَrْkِhd", "root": "ذكر"}], "hasIhya": false}, {"ayah": 44, "text": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ ", "translation": "To your Lord is its finality.[1]", "words": [{"id": 1, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 2, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 3, "arabic": "مُنتَهَىٰهَآ", "translit": "ٓāَhٰàَhَtnُm", "root": "نهي"}], "hasIhya": false}, {"ayah": 45, "text": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا ", "translation": "You are only a warner for those who fear it.", "words": [{"id": 1, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 3, "arabic": "مُنذِرُ", "translit": "ُrِhdnُm", "root": "نذر"}, {"id": 4, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 5, "arabic": "يَخْشَىٰهَا", "translit": "āَhٰàَhsْhkَy", "root": "خشي"}], "hasIhya": false}, {"ayah": 46, "text": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا ", "translation": "It will be, on the Day they see it,[1] as though they had not remained [in the world] except for an afternoon or a morning thereof.", "words": [{"id": 1, "arabic": "كَأَنَّهُمْ", "translit": "ْmُhَّnَaʾَk", "root": ""}, {"id": 2, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 3, "arabic": "يَرَوْنَهَا", "translit": "āَhَnْwَrَy", "root": "راي"}, {"id": 4, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 5, "arabic": "يَلْبَثُوٓا۟", "translit": "۟āٓwُhtَbْlَy", "root": "لبث"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "عَشِيَّةً", "translit": "ًẗَّyِhsَʿع", "root": "عشو"}, {"id": 8, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 9, "arabic": "ضُحَىٰهَا", "translit": "āَhٰàَḥُḍ", "root": "ضحو"}], "hasIhya": false}], "tafsir": {"17": [{"arabic": "ومثال تأويل أهل الطامات قول بعضهم في تأويل قوله تعالى {اذهب إلى فرعون إنه طغى} أنه إشارة إلى قلبه وقال هو المراد بفرعون وهو الطاغي على كل إنسان وفي قوله تعالى {وأن ألق عصاك} أي ما يتوكأ عليه ويعتمده مما سوى الله عز وجل فينبغي أن يلقيه وفي قوله صلى الله عليه وسلم تسحروا فإن في السحور بركة (1) أراد به الاستغفار في الأسحار وأمثال ذلك حتى يحرفون القرآن من أوله إلى آخره عن ظاهره وعن تفسيره المنقول عن ابن عباس وسائر العلماء وبعض هذه التأويلات يعلم بطلانها قطعا كتنزيل فرعون على القلب فإن فرعون شخص محسوس تواتر إلينا النقل بوجوده ودعوة موس", "english": "Saʿd ibn Abī Waqqāṣ, may God be pleased with him, said to his son ʿUmar — having heard him composing sajʿ — \"This is what makes me dislike you. I will never fulfill your need until you repent.\" This was said when his son had come to him seeking a favor. And the Prophet, may God bless him and grant him peace, said to ʿAbd Allāh ibn Rawāḥah when he spoke in sajʿ of three words: \"Beware of sajʿ, O Ibn Rawāḥah.\" Thus, the forbidden sajʿ is the artificially contrived kind that exceeds two words. For this reason, when a man spoke concerning the blood-money for a fetus — saying, \"How shall we pay blood-money for one who neither drank, nor ate, nor cried out, nor wailed? Such a one's blood is void\" — the Prophet, may God bless him and grant him peace, replied: \"Sajʿ like the sajʿ of the bedouins!\"", "book_title": "Book of Knowledge", "section_title_ar": "Section 31", "section_title_en": "On the Etiquette of Preaching: The Condemnation of Artificial Sajʿ, Excessive Poetry, and the Perils of Shataḥ and Taʿwīl", "section_index": 31, "anchors": "- Root: سجع (sajʿa)\n  * Lisan / Ayn: Rhymed prose; from the root meaning \"to coo\" (as a dove), indicating a measured, melodious cadence in speech.\n  * Al-Raghib (Mufradat): In theological discourse, sajʿ is permissible when natural but blameworthy when artificially cultivated (takalluf), as it shifts focus from meaning to ornamentation.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — natural rhythmic speech; Metaphorical (majāz) — the \"sajʿ of the bedouins\" (sajʿ al-aʿrāb) as a pejorative for empty, affected eloquence.\n- Root: شعر (shiʿr)\n  * Lisan / Ayn: Poetry; from the root denoting perception and fine discernment (shuʿūr), as the poet grasps subtle meanings.\n  * Al-Raghib (Mufradat): Poetry is blameworthy when it stirs base appetites, but praiseworthy when it conveys wisdom (ḥikmah), as in the prophetic saying \"Indeed from poetry there is wisdom.\"\n  * Al-Zamakhshari (Asas): Literal — metered, rhymed speech; Metaphorical — the \"poetry\" of the heart's inclination, where listeners project their own passions onto what they hear.\n- Root: شطح (shaṭaḥa)\n  * Lisan / Ayn: To overflow, to gush forth; originally of a water-skin bursting, then applied to ecstatic utterances that overflow the bounds of conventional discourse.\n  * Al-Raghib (Mufradat): In Sufi terminology, shataḥ refers to utterances arising from overwhelming spiritual states (ḥāl) that, when voiced to the unworthy, cause corruption.\n  * Al-Zamakhshari (Asas): Literal — physical overflowing; Metaphorical — the soul's overflow in speech that exceeds the speaker's intentional control.\n- Root: أول (taʿwīl)\n  * Lisan / Ayn: To return something to its origin or end; interpretation that traces a word back to its intended meaning.\n  * Al-Raghib (Mufradat): Taʿwīl is legitimate only when supported by textual (naqlī) or rational (ʿaqlī) evidence; arbitrary taʿwīl that severs words from their established senses destroys religious trust.\n  * Al-Zamakhshari (Asas): Literal — the apparent sense (ẓāhir); Metaphorical — the inner sense (bāṭin), which is only valid when the literal sense is impossible or when transmitted authority sanctions it.\n- Sibawayh Rule: Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā (Restriction and Focused Predication) — The text repeatedly uses restrictive constructions (innamā, laysa...illā) to delimit permissible preaching, poetry, and interpretation, distinguishing the praiseworthy from the blameworthy with syntactic precision.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Book of Knowledge'", "badge": "Hadith"}], "27": [{"arabic": "الإنسان بل لا نسبة لجميع ما في الأرض إلى عجائب السموات ولذلك قال تعالى أأنتم أشد خلقا أم السماء بناها رفع سمكها فسواها وأغطش ليلها وأخرج ضحاها فارجع الآن إلى النطفة وتأمل حالها أولا وما صارت إليه ثانيا وتأمل أنه لو اجتمع الجن والإنس على أن يخلقوا للنطفة سمعا أو بصرا أو عقلا أو قدرة أو علما أو روحا أو يخلقوا فيها عظما أو عرقا أو عصبا أو جلدا أو شعرا هل يقدرون على ذلك بل لو أرادوا أن يعرفوا كنه حقيقته وكيفية خلقته بعد أن خلق الله تعالى ذلك لعجزوا عنه فالعجب منك لو نظرت إلى صورة إنسان مصور على حائط تأنق النقاش فى تصويرها حتى قرب ذلك من صورة الإنسان وقال الناظر إليها كأنه إنسان عظم تعجبك من صن", "english": "So look now at the outward of the human being and his inward, and at his body and his attributes, and you will see in him such wonders and craftsmanship as would make wonder reach its limit. And all of that is the making (ṣunʿ) of God in a filthy drop of water. So you see from this His making in a drop of water — then what of His making in the dominion of the heavens (malakūt al-samāwāt) and their stars, and His wisdom in their positions, and their forms, and their quantities, and their numbers, and the coming together of some of them and the separation of others, and the diversity of their forms, and the disparity of their risings and their settings? So do not ever think that a single atom of the dominion of the heavens is free from wisdom and a wise purpose. Rather, they are more wise in constitution, more perfect in making, and more comprehensive of wonders than the human body. Indeed, there is no proportion at all between all that is on the earth and the wonders of the heavens. And for that reason God — exalted be He — said: {«أأنتم أشد خلقا أم السماء بناها رفع سمكها فسواها وأغطش ليلها وأخرج ضحاها»} — \"Are you harder to create, or the heaven? He built it. He raised high its roof and fashioned it, and darkened its night and brought forth its forenoon\" (Q. 79:27–29).", "book_title": "Contemplation", "section_title_ar": "Section 1270", "section_title_en": "The Wonders of the Bodily Frame and the Wisdom of Its Limbs — Section 1270", "section_index": 1270, "anchors": "- Root: زيد (z-y-d)\n  * Lisan / Ayn: Increase, augmentation; its opposite is deficiency (nuqṣān).\n  * Al-Raghib (Mufradat): Ziyādah and nuqṣān are relative accidents (aʿrāḍ) indicating measured proportion (taqdīr) in created things.\n  * Al-Zamakhshari (Asas): Literal in quantities; metaphorical in describing divine wisdom as \"increasing\" or \"decreasing\" only by way of created effect.\n- Root: صور (ṣ-w-r)\n  * Lisan / Ayn: Form, shape, image; ṣūrah is that by which a thing is distinguished.\n  * Al-Raghib (Mufradat): Two types — sensible form (perceived by senses) and intelligible form (perceived by intellect alone); God is al-Muṣawwir (the Fashioner of forms).\n  * Al-Zamakhshari (Asas): Literal for physical shape; metaphorical for spiritual or intelligible configuration.\n- Root: صنع (ṣ-n-ʿ)\n  * Lisan / Ayn: Skilled making, craftsmanship; ṣunʿ is excellent, precise action.\n  * Al-Raghib (Mufradat): \"الصنع: إجادة الفعل\" — ṣunʿ is the perfecting of act; every ṣunʿ is an act, but not every act is ṣunʿ; it is attributed to God alone in absolute sense.\n  * Al-Zamakhshari (Asas): Literal for human craft; metaphorical for divine creation as ultimate craftsmanship.\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Measuring, proportioning, then creating; khilqah is the innate constitution.\n  * Al-Raghib (Mufradat): Creation as bringing into being with precise measure and wisdom.\n  * Al-Zamakhshari (Asas): Literal for origination; metaphorical when applied to human \"making\" of images.\n- Sibawayh Rule: باب التعجب والتفضيل (Wonder and Preference) — Structures like \"فشتان بين النظرين\" and \"أعجب من هذا كله\" employ the pattern of exaggerated wonder (taʿajjub) and comparative preference (tafḍīl) to establish hierarchy of contemplation.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'", "badge": "Insight"}], "37": [{"arabic": "عدلت عن سبيله ورغبت عن متابعته والتحقت بالذين قال الله تعالى فيهم {فأما من طغى وآثر الحياة الدنيا فإن الجحيم هي المأوى} فلو خرجت من مكمن الغرور وأنصفت نفسك يا رجل وكلنا ذلك الرجل لعلمت أنك من حين تصبح إلى حين تمسي لا تسعى إلا في الحظوظ العاجلة ولا تتحرك ولا تسكن إلا لعاجل الدنيا ثم تطمع أن تكون غدا من أمته وأتباعه وما أبعد ظنك وما أبرد طمعك {أفنجعل المسلمين كالمجرمين ما لكم كيف تحكمون} ولنرجع إلى ما كنا فيه وبصدده فقد امتد عنان الكلام إلى غير مقصده ولنذكر الآن من المنامات الكاشفة لأحوال الموتى ما يعظم الانتفاع به إذ ذهبت النبوة وبقيت المبشرات وليس ذلك إلا الم", "english": "If [the matter of death] were a lasting misery or an enduring felicity, that alone would suffice to consume the entirety of one's lifespan. And the wonder is at our heedlessness while these enormities lie before our very eyes; and more wondrous still is our rejoicing over our wealth, our families, our means, our offspring — nay, even over our limbs, our hearing, and our sight — despite our certain knowledge that we shall part from all of that. But where is the one who breathes the Spirit of Holiness (rūḥ al-quds) into his breast such that he utters what was said to the Master of the Prophets: \"Love whom you will, for you shall part from him; live as you will, for you shall die; and do what you will, for you shall be recompensed for it\" {«أحبب من أحببت فإنك مفارقه وعش ما شئت فإنك ميت واعمل ما شئت فإنك مجزي به»}? Without doubt, since that was unveiled to him with the eye of certainty (ʿayn al-yaqīn), he was in this world like a wayfarer passing through: he laid no brick upon brick, nor reed upon reed {«لم يضع لبنة على لبنة ولا قصبة على قصبة»}, he left behind no dinar nor dirham {«ولم يخلف دينارا ولا درهما»}, and he took no beloved nor intimate friend. Indeed, he said: \"Had I taken an intimate friend (khalīl), I would have taken Abū Bakr as a friend; but your companion is the intimate friend of the Merciful\" {«لو كنت متخذا خليلا لاتخذت أبا بكر خليلا ولكن صاحبكم خليل الرحمن»}. Thus he made clear that the intimacy of the Merciful (khullat al-Raḥmān) had permeated the innermost depth of his heart, and that his love had taken firm hold upon the very core of his heart, leaving therein no space for any friend or beloved. And he said to his community: {«إن كنتم تحبون الله فاتبعوني يحببكم الله»} — \"If you love God, then follow me, and God will love you.\" For his community is only those who follow him; and none follows him save one who turns away from this world and turns toward the Hereafter. For he called only to God and the Last Day, and he turned away only from this world and its fleeting appetites. So to the extent that you turn away from this world and turn toward the Hereafter, to that extent you have trodden his path which he trod; and to the extent that you tread his path, to that extent you have followed him; and to the extent that you follow him, to that extent you have become of his community; and to the extent that you turn toward this world, to that extent you have deviated from his path, turned away from following him, and joined those of whom God the Exalted said: {«فأما من طغى وآثر الحياة الدنيا فإن الجحيم هي المأوى»} — \"As for him who transgressed and preferred the life of this world, then indeed the Fire is the abode.\" So if you were to emerge from the hiding-place of delusion and deal justly with yourself — O man, and each of us is that man — you would know that from the moment you rise in the morning until the moment you retire at night, you strive only for fleeting appetites, and you move not nor rest save for something immediate in this world; then you aspire that tomorrow you shall be of his community and his followers. How far is your conjecture, and how cold is your hope! {«أفنجعل المسلمين كالمجرمين ما لكم كيف تحكمون»} — \"Shall We make the Muslims like the criminals? What is the matter with you, how do you judge?\" Let us now return to what we were upon and what was its purpose, for the reins of discourse have stretched far beyond its intended aim. Let us now mention, from among the dreams that unveil the states of the dead, that whose benefit is great — since prophethood has ceased while the glad tidings (mubashshirāt) remain, and that is none other than dreams.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1328", "section_title_en": "The Eighth Book: On What Has Been Revealed of the States of the Dead through Unveiling (Mukāshafah) in Dreams", "section_index": 1328, "anchors": "- Root: سبل (s-b-l)\n  * Lisan / Ayn: The path that is easy and trodden; the wayfarer (sābil) is one who traverses it.\n  * Al-Raghib (Mufradat): Al-Sabīl is the road of ease; when used absolutely, it designates the path of truth (ṭarīq al-ḥaqq).\n  * Al-Zamakhshari (Asas): Literal: a beaten road. Metaphorical: \"asbala al-maṭar\" — the rain poured forth as if letting down a veil (sitār).\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the exclusive linkage of following the Prophet to turning away from this world.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "40": [{"arabic": "تحمل عليه يلهث أو تتركه يلهث وقال عز وجل فيمن نهى النفس عن الهوى وأما من خاف مقام ربه ونهى النفس عن الهوى فإن الجنة هي المأوى وسيأتي كيفية مجاهدة هذه الجنود وتسليط بعضها على بعض في كتاب رياضة النفس إن شاء الله تعالى المثال الثاني اعلم أن البدن كالمدينة والعقل أعني المدرك من الإنسان كملك مدبر لها وقواه المدركة من الحواس الظاهرة والباطنة كجنوده وأعوانه وأعضاؤه كرعيته والنفس الأمارة بالسوء التي هي الشهوة والغضب كعدو ينازعه في مملكته ويسعى في إهلاك رعيته فصار بدنه كرباط وثغر ونفسه كمقيم فيه مرابط فإن هو جاهد عدوه وهزمه وقهره على ما يحب حمد أثره وإذا عاد إلى الحضرة كما قال ا", "english": "But whoever turns away from this path is like the one of whom Allah, the Exalted, said: {أفرأيت من اتخذ إلهه هواه وأضله الله على علم} — \"Have you seen the one who takes as his god his own desire, and Allah has led him astray out of knowledge?\" (Q 45:23). And He, the Exalted, said: {واتبع هواه فمثله كمثل الكلب إن تحمل عليه يلهث أو تتركه يلهث} — \"And he followed his desire, so his example is like the example of a dog: if you drive him away, he pants, or if you leave him, he pants\" (Q 7:176). And He, the Exalted and Glorious, said concerning the one who restrains the soul from passion: {وأما من خاف مقام ربه ونهى النفس عن الهوى فإن الجنة هي المأوى} — \"But as for he who feared the standing before his Lord and restrained the soul from passion, then indeed, Paradise will be the refuge\" (Q 79:40-41).", "book_title": "Disciplining the Soul", "section_title_ar": "Section 577", "section_title_en": "** The Body as Kingdom: The Governance of the Soul's Faculties — Section 577", "section_index": 577, "anchors": "**\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, breath; that which is breathed forth; the essence of a thing\n  * Al-Raghib (Mufradat): النفس: الروح — the soul as the immaterial spiritual reality; when attributed to Allah, denotes His very essence (al-dhāt), not a separate entity\n  * Al-Zamakhshari (Asas): Literal: the self/essence; Metaphorical: نفس سائلة — a \"flowing self\" (blood) as the criterion for ritual purity\n- Root: عقل (ʿ-q-l)\n  * Lisan / Ayn: Intellect, reason; that which restrains and binds\n  * Al-Raghib (Mufradat): العقل يقال للقوة المتهيئة لقبول العلم — the faculty prepared for receiving knowledge; and the knowledge acquired through that faculty\n  * Al-Zamakhshari (Asas): Literal: intellectual apprehension; Metaphorical: نخلة لا تعقل الإبار — a palm that does not \"accept\" pollination (i.e., does not receive)\n- Root: غضب (gh-d-b)\n  * Lisan / Ayn: Anger, wrath; the boiling of the blood of the heart desiring vengeance\n  * Al-Raghib (Mufradat): ثوران دم القلب إرادة الانتقام — when attributed to Allah, it means retribution alone, not an emotional state\n  * Al-Zamakhshari (Asas): Literal: anger toward the living (غضبت لفلان); Metaphorical: anger toward the dead (غضبت به) — the preposition shift marking the distinction\n- Root: نصح (n-s-ḥ)\n  * Lisan / Ayn: Sincere counsel; to be pure and unadulterated; to sew (as a tailor)\n  * Al-Raghib (Mufradat): تحري فعل أو قول فيه صلاح صاحبه — the earnest pursuit of action or speech containing the welfare of its recipient\n  * Al-Zamakhshari (Asas): Literal: sincere advice; Metaphorical: نصح الغيث البلاد — rain \"counseling\" the land (i.e., giving it its due generously)\n- Sibawayh Rule: باب التشبيه التمثيلي (The Chapter of Illustrative Simile) — extended analogical comparisons (tamthīl) where multiple relations are mapped across domains, governed by the syntactic pattern of predicate assignment (isnād) to establish parallel structures\n\n---\n\n**", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "الله عز وجل وأما من خاف مقام ربه ونهى النفس عن الهوى فإن الجنة هي المأوى فعلمت أن قوله سبحانه وتعالى هو الحق فأجهدت نفسي في دفع الهوى حتى استقرت على طاعة الله تعالى الثالثة أني نظرت إلى هذا الخلق فرأيت كل ممن معه شيء له قيمة ومقدار رفعه وحفظه ثم نظرت إلى قول الله عز وجل ما عندكم ينفذ وما عند الله باق فكلما وقع معي شيء له قيمة ومقدار وجهته إلى الله ليبقى عنده محفوظا الرابعة أني نظرت إلى هذا الخلق فرأيت كل واحد منهم يرجع إلى المال وإلى الحسب والشرف والنسب فنظرت فيها فإذا هي لا شيء ثم نظرت إلى قول الله تعالى إن أكرمك", "english": "Know that the scholar who does not act upon his knowledge is condemned by the Book, the Sunnah, and the sayings of the sages. God, exalted be He, said: {«يا أيها الذين آمنوا لم تقولون ما لا تفعلون * كبر مقتا عند الله أن تقولوا ما لا تفعلون»} (\"O you who believe, why do you say what you do not do? Most hateful it is to God that you say what you do not do\"). And He said: {«أتأمرون الناس بالبر وتنسون أنفسكم»} (\"Do you command people to righteousness while you forget yourselves?\"). And He said: {«ومن الناس من يعجبك قوله في الحياة الدنيا ويشهد الله على ما في قلبه وهو ألد الخصام»} (\"And among people is he whose speech pleases you in the worldly life, and he calls God to witness what is in his heart, yet he is the fiercest of opponents\").", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 54", "section_title_en": "Section 54", "section_index": 54, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}]}, "wordTiming": {"minshawi": {"1": [[1, 480, 3023], [2, 3023, 4730]], "79:1": [[1, 480, 3023], [2, 3023, 4730]], "2": [[1, 20, 2795], [2, 2795, 4650]], "79:2": [[1, 20, 2795], [2, 2795, 4650]], "3": [[1, 70, 2375], [2, 2375, 4060]], "79:3": [[1, 70, 2375], [2, 2375, 4060]], "4": [[1, 20, 2277], [2, 2277, 4150]], "79:4": [[1, 20, 2277], [2, 2277, 4150]], "5": [[1, 200, 2385], [2, 2385, 4320]], "79:5": [[1, 200, 2385], [2, 2385, 4320]], "6": [[1, 320, 1448], [2, 1448, 2350], [3, 2350, 4290]], "79:6": [[1, 320, 1448], [2, 1448, 2350], [3, 2350, 4290]], "7": [[1, 10, 1757], [2, 1757, 3670]], "79:7": [[1, 10, 1757], [2, 1757, 3670]