 "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 6, "text": "يَوْمَ تَرْجُفُ اُ۬لرَّاجِفَةُ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَرْجُفُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لرَّاجِفَةُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 7, "text": "تَتْبَعُهَا اَ۬لرَّادِفَةُۖ", "words": [{"id": 1, "arabic": "تَتْبَعُهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لرَّادِفَةُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 8, "text": "قُلُوبࣱ يَوْمَئِذࣲ وَاجِفَةٌ", "words": [{"id": 1, "arabic": "قُلُوبࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَوْمَئِذࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَاجِفَةٌ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 9, "text": "اَبْصَٰرُهَا خَٰشِعَةࣱۖ", "words": [{"id": 1, "arabic": "اَبْصَٰرُهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "خَٰشِعَةࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 10, "text": "يَقُولُونَ أَ۟نَّا لَمَرْدُودُونَ فِے اِ۬لْحَافِرَةِ", "words": [{"id": 1, "arabic": "يَقُولُونَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَ۟نَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "لَمَرْدُودُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْحَافِرَةِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 11, "text": "إِذَا كُنَّا عِظَٰماࣰ نَّخِرَةࣰۖ", "words": [{"id": 1, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "عِظَٰماࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "نَّخِرَةࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 79, "ayah": 12, "text": "قَالُواْ تِلْكَ إِذاࣰ كَرَّةٌ خَاسِرَةࣱ‏", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "