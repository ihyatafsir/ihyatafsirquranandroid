 "يَرْتَعِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَيَلْعَبْ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَإِنَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَحَٰفِظُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 13, "text": "قَالَ إِنِّے لَيُحْزِنُنِيَ أَن تَذْهَبُواْ بِهِۦ وَأَخَافُ أَنْ يَّاكُلَهُ اُ۬لذِّيبُ وَأَنتُمْ عَنْهُ غَٰفِلُونَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 3, "arabic": "لَيُحْزِنُنِيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "", "root": ""}, {"id": 5, "arabic": "تَذْهَبُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَأَخَافُ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 9, "arabic": "يَّاكُلَهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لذِّيبُ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَأَنتُمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "عَنْهُ", "translit": "", "root": ""}, {"id": 13, "arabic": "غَٰفِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 14, "text": "قَالُواْ لَئِنَ اَكَلَهُ اُ۬لذِّيبُ وَنَحْنُ عُصْبَةٌ اِنَّآ إِذاࣰ لَّخَٰسِرُونَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَئِنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَكَلَهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لذِّيبُ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَنَحْنُ", "translit": "", "root": ""}, {"id": 6, "arabic": "عُصْبَةٌ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِنَّآ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِذاࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَّخَٰسِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 15, "text": "فَلَمَّا ذَهَبُواْ بِهِۦ وَأَجْمَعُوٓاْ أَنْ يَّجْعَلُوهُ فِے غَيَٰبَٰتِ اِ۬لْجُبِّ وَأَوْحَيْنَآ إِلَيْهِ لَتُنَبِّئَنَّهُم بِأَمْرِهِمْ هَٰذَا وَهُمْ لَا يَشْعُرُونَۖ", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "ذَهَبُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَأَجْمَعُوٓاْ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَّجْعَلُوهُ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "غَيَٰبَٰتِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لْجُبِّ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَأَوْحَيْنَآ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِلَيْهِ", "translit": "", "root": ""}, {"id": 12, "arabic": "لَتُنَبِّئَنَّهُم", "translit": "", "root": ""}, {"id": 13, "arabic": "بِأَمْرِهِمْ", "translit": "", "root": ""}, {"id": 14, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 15, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 16, "arabic": "لَا", "translit": "", "root": ""}, {"id": 17, "arabic": "يَشْعُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 16, "text": "وَجَآءُوٓ أَبَاهُمْ عِشَآءࣰ يَبْكُونَ", "words": [{"id": 1, "arabic": "وَجَآءُوٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَبَاهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عِشَآءࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَبْكُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 17, "text": "قَالُواْ يَٰٓأَبَانَآ إِنَّا ذَهَبْنَا نَسْتَبِقُ وَتَرَكْنَا يُوسُفَ عِندَ مَتَٰعِنَا فَأَكَلَهُ اُ۬لذِّيبُۖ وَمَآ أَنتَ بِمُومِنࣲ لَّنَا وَلَوْ كُنَّا صَٰدِقِينَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰٓأَ