ic": "تَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 87, "text": "يَٰبَنِيَّ اَ۪ذْهَبُواْ فَتَحَسَّسُواْ مِنْ يُّوسُفَ وَأَخِيهِ وَلَا تَاْيْـَٔسُواْ مِن رَّوْحِ اِ۬للَّهِۖ إِنَّهُۥ لَا يَاْيْـَٔسُ مِن رَّوْحِ اِ۬للَّهِ إِلَّا اَ۬لْقَوْمُ اُ۬لْكَٰفِرُونَۖ", "words": [{"id": 1, "arabic": "يَٰبَنِيَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۪ذْهَبُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَتَحَسَّسُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يُّوسُفَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَخِيهِ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 8, "arabic": "تَاْيْـَٔسُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "مِن", "translit": "", "root": ""}, {"id": 10, "arabic": "رَّوْحِ", "translit": "", "root": ""}, {"id": 11, "arabic": "اِ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 13, "arabic": "لَا", "translit": "", "root": ""}, {"id": 14, "arabic": "يَاْيْـَٔسُ", "translit": "", "root": ""}, {"id": 15, "arabic": "مِن", "translit": "", "root": ""}, {"id": 16, "arabic": "رَّوْحِ", "translit": "", "root": ""}, {"id": 17, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 18, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 19, "arabic": "اَ۬لْقَوْمُ", "translit": "", "root": ""}, {"id": 20, "arabic": "اُ۬لْكَٰفِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 88, "text": "۞فَلَمَّا دَخَلُواْ عَلَيْهِ قَالُواْ يَٰٓأَيُّهَا اَ۬لْعَزِيزُ مَسَّنَا وَأَهْلَنَا اَ۬لضُّرُّ وَجِئْنَا بِبِضَٰعَةࣲ مُّزْج۪يٰةࣲۖ فَأَوْفِ لَنَا اَ۬لْكَيْلَ وَتَصَدَّقْ عَلَيْنَآۖ إِنَّ اَ۬للَّهَ يَجْزِے اِ۬لْمُتَصَدِّقِينَۖ", "words": [{"id": 1, "arabic": "۞فَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "دَخَلُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَٰٓأَيُّهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْعَزِيزُ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَسَّنَا", "translit": "", "root": ""}, {"id": 8, "arabic": "وَأَهْلَنَا", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لضُّرُّ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَجِئْنَا", "translit": "", "root": ""}, {"id": 11, "arabic": "بِبِضَٰعَةࣲ", "translit": "", "root": ""}, {"id": 12, "arabic": "مُّزْج۪يٰةࣲۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "فَأَوْفِ", "translit": "", "root": ""}, {"id": 14, "arabic": "لَنَا", "translit": "", "root": ""}, {"id": 15, "arabic": "اَ۬لْكَيْلَ", "translit": "", "root": ""}, {"id": 16, "arabic": "وَتَصَدَّقْ", "translit": "", "root": ""}, {"id": 17, "arabic": "عَلَيْنَآۖ", "translit": "", "root": ""}, {"id": 18, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 19, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 20, "arabic": "يَجْزِے", "translit": "", "root": ""}, {"id": 21, "arabic": "اِ۬لْمُتَصَدِّقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 89, "text": "قَالَ هَلْ عَلِمْتُم مَّا فَعَلْتُم بِيُوسُفَ وَأَخِيهِ إِذَ اَنتُمْ جَٰهِلُونَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَلْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلِمْتُم", "translit": "", "root": ""}, {"id": 4, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "فَعَلْتُم", "translit": "", "root": ""}, {"id": 6, "arabic": "بِيُوسُفَ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَأَخِيهِ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِذَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَنتُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "جَٰهِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 90, "text": "قَالُوٓاْ أَ۟نَّكَ لَأَنتَ يُوسُفُۖ قَالَ أَنَا يُوسُفُ وَهَٰذَآ أَخِےۖ قَدْ مَنَّ اَ۬للَّهُ عَلَيْنَآۖ إِنَّهُۥ مَنْ يَّتَّقِ وَيَصْبِرْ فَإِنَّ اَ۬للَّهَ لَا يُضِيعُ أَجْرَ اَ۬لْمُحْسِنِينَۖ", "words": [{"id": 1, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَ۟نَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَأَنتَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يُوسُفُۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "يُوسُفُ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَهَٰذَآ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَخِےۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "قَدْ", "translit": "", "root": ""}, {"id": 11, "arabic": "مَنَّ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 13, "arabic": "عَلَيْنَآۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 15, "arabic": "مَنْ", "translit": "", "root": ""}, {"id": 16, "arabic": "يَّتَّقِ", "translit": "", "root": ""}, {"id": 17, "arabic": "وَيَصْبِرْ", "translit": "", "root": ""}, {"id": 18, "arabic": "فَإِنَّ", "translit": "", "root": ""}, {"id": 19, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 20, "arabic": "لَا", "translit": "", "root": ""}, {"id": 21, "arabic": "يُضِيعُ", "translit": "", "root": ""}, {"id": 22, "arabic": "أَجْرَ", "translit": "", "root": ""}, {"id": 23, "arabic": "اَ۬لْمُحْسِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 91, "text": "قَالُواْ تَاللَّهِ لَقَدَ اٰثَرَكَ اَ۬للَّهُ عَلَيْنَا وَإِن كُنَّا لَخَٰطِـِٕينَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَاللَّهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَقَدَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اٰ