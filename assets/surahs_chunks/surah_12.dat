"arabic":"لَا","translit":"āَl","root":""},{"id":10,"arabic":"يَهْدِى","translit":"àِdْhَy","root":"هدي"},{"id":11,"arabic":"كَيْدَ","translit":"َdْyَk","root":"كيد"},{"id":12,"arabic":"ٱلْخَآئِنِينَ","translit":"َnyِnِyʾٓāَhkْlٱ","root":"خون"}],"hasIhya":false},{"ayah":53,"text":"وَمَآ أُبَرِّئُ نَفْسِىٓۚ إِنَّ ٱلنَّفْسَ لَأَمَّارَةٌۢ بِٱلسُّوٓءِ إِلَّا مَا رَحِمَ رَبِّىٓۚ إِنَّ رَبِّى غَفُورٌ رَّحِيمٌ ","translation":"And I do not acquit myself. Indeed, the soul is a persistent enjoiner of evil, except those upon which my Lord has mercy. Indeed, my Lord is Forgiving and Merciful.\"[1]","words":[{"id":1,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":2,"arabic":"أُبَرِّئُ","translit":"ُyʾِّrَbُaʾ","root":"برا"},{"id":3,"arabic":"نَفْسِىٓ","translit":"ٓàِsْfَn","root":"نفس"},{"id":4,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":5,"arabic":"ٱلنَّفْسَ","translit":"َsْfَّnlٱ","root":"نفس"},{"id":6,"arabic":"لَأَمَّارَةٌۢ","translit":"ٌۢẗَrāَّmَaʾَl","root":"امر"},{"id":7,"arabic":"بِٱلسُّوٓءِ","translit":"ِءٓwُّslٱِb","root":"سوا"},{"id":8,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":9,"arabic":"مَا","translit":"āَm","root":""},{"id":10,"arabic":"رَحِمَ","translit":"َmِḥَr","root":"رحم"},{"id":11,"arabic":"رَبِّىٓ","translit":"ٓàِّbَr","root":"ربب"},{"id":12,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":13,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":14,"arabic":"غَفُورٌ","translit":"ٌrwُfَغ","root":"غفر"},{"id":15,"arabic":"رَّحِيمٌ","translit":"ٌmyِḥَّr","root":"رحم"}],"hasIhya":true},{"ayah":54,"text":"وَقَالَ ٱلْمَلِكُ ٱئْتُونِى بِهِۦٓ أَسْتَخْلِصْهُ لِنَفْسِىۖ فَلَمَّا كَلَّمَهُۥ قَالَ إِنَّكَ ٱلْيَوْمَ لَدَيْنَا مَكِينٌ أَمِينٌ ","translation":"And the king said, \"Bring him to me; I will appoint him exclusively for myself.\" And when he spoke to him, he said, \"Indeed, you are today established [in position] and trusted.\"","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"ٱلْمَلِكُ","translit":"ُkِlَmْlٱ","root":"ملك"},{"id":3,"arabic":"ٱئْتُونِى","translit":"àِnwُtْyʾٱ","root":"اتي"},{"id":4,"arabic":"بِهِۦٓ","translit":"ٓۦِhِb","root":""},{"id":5,"arabic":"أَسْتَخْلِصْهُ","translit":"ُhْṣِlْhkَtْsَaʾ","root":"خلص"},{"id":6,"arabic":"لِنَفْسِى","translit":"àِsْfَnِl","root":"نفس"},{"id":7,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":8,"arabic":"كَلَّمَهُۥ","translit":"ۥُhَmَّlَk","root":"كلم"},{"id":9,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":10,"arabic":"إِنَّكَ","translit":"َkَّnِiʾ","root":""},{"id":11,"arabic":"ٱلْيَوْمَ","translit":"َmْwَyْlٱ","root":"يوم"},{"id":12,"arabic":"لَدَيْنَا","translit":"āَnْyَdَl","root":""},{"id":13,"arabic":"مَكِينٌ","translit":"ٌnyِkَm","root":"مكن"},{"id":14,"arabic":"أَمِينٌ","translit":"ٌnyِmَaʾ","root":"امن"}],"hasIhya":false},{"ayah":55,"text":"قَالَ ٱجْعَلْنِى عَلَىٰ خَزَآئِنِ ٱلْأَرْضِۖ إِنِّى حَفِيظٌ عَلِيمٌ ","translation":"[Joseph] said, \"Appoint me over the storehouses of the land. Indeed, I will be a knowing guardian.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"ٱجْعَلْنِى","translit":"àِnْlَʿعْjgٱ","root":"جعل"},{"id":3,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":4,"arabic":"خَزَآئِنِ","translit":"ِnِyʾٓāَzَhk","root":"خزن"},{"id":5,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":6,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":7,"arabic":"حَفِيظٌ","translit":"ٌẓyِfَḥ","root":"حفظ"},{"id":8,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"}],"hasIhya":true},{"ayah":56,"text":"وَكَذَٰلِكَ مَكَّنَّا لِيُوسُفَ فِى ٱلْأَرْضِ يَتَبَوَّأُ مِنْهَا حَيْثُ يَشَآءُۚ نُصِيبُ بِرَحْمَتِنَا مَن نَّشَآءُۖ وَلَا نُضِيعُ أَجْرَ ٱلْمُحْسِنِينَ ","translation":"And thus We established Joseph in the land to settle therein wherever he willed. We touch with Our mercy whom We will, and We do not allow to be lost the reward of those who do good.","words":[{"id":1,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":2,"arabic":"مَكَّنَّا","translit":"āَّnَّkَm","root":"مكن"},{"id":3,"arabic":"لِيُوسُفَ","translit":"َfُswُyِl","root":""},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":6,"arabic":"يَتَبَوَّأُ","translit":"ُaʾَّwَbَtَy","root":"بوا"},{"id":7,"arabic":"مِنْهَا","translit":"āَhْnِm","root":""},{"id":8,"arabic":"حَيْثُ","translit":"ُhtْyَḥ","root":"حيث"},{"id":9,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":10,"arabic":"نُصِيبُ","translit":"ُbyِṣُn","root":"صوب"},{"id":11,"arabic":"بِرَحْمَتِنَا","translit":"āَnِtَmْḥَrِb","root":"رحم"},{"id":12,"arabic":"مَن","translit":"nَm","root":""},{"id":13,"arabic":"نَّشَآءُ","translit":"ُءٓāَhsَّn","root":"شيا"},{"id":14,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":15,"arabic":"نُضِيعُ","translit":"ُʿعyِḍُn","root":"ضيع"},{"id":16,"arabic":"أَجْرَ","translit":"َrْjgَaʾ","root":"اجر"},{"id":17,"arabic":"ٱلْمُحْسِنِينَ","translit":"َnyِnِsْḥُmْlٱ","root":"حسن"}],"hasIhya":true},{"ayah":57,"text":"وَلَأَجْرُ ٱلْءَاخِرَةِ خَيْرٌ لِّلَّذِينَ ءَامَنُوا۟ وَكَانُوا۟ يَتَّقُونَ ","translation":"And the reward of the Hereafter is better for those who believed and were fearing Allāh.","words":[{"id":1,"arabic":"وَلَأَجْرُ","translit":"ُrْjgَaʾَlَw","root":"اجر"},{"id":2,"arabic":"ٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱ","root":"اخر"},{"id":3,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":4,"arabic":"لِّلَّذِينَ","translit":"َnyِhdَّlِّl","root":""},{"id":5,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":6,"arabic":"وَكَانُوا۟","translit":"۟āwُnāَkَw","root":"كون"},{"id":7,"arabic":"يَتَّقُونَ","translit":"َnwُqَّtَy","root":"وقي"}],"hasIhya":false},{"ayah":58,"text":"وَجَآءَ إِخْوَةُ يُوسُفَ فَدَخَلُوا۟ عَلَيْهِ فَعَرَفَهُمْ وَهُمْ لَهُۥ مُنكِرُونَ ","translation":"And the brothers of Joseph came [seeking food], and they entered upon him; and he recognized them, but he was to them unknown.[1]","words":[{"id":1,"arabic":"وَجَآءَ","translit":"َءٓāَjgَw","root":"جيا"},{"id":2,"arabic":"إِخْوَةُ","translit":"ُẗَwْhkِiʾ","root":"اخو"},{"id":3,"arabic":"يُوسُفَ","translit":"َfُswُy","root":""},{"id":4,"arabic":"فَدَخَلُوا۟","translit":"۟āwُlَhkَdَf","root":"دخل"},{"id":5,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":6,"arabic":"فَعَرَفَهُمْ","translit":"ْmُhَfَrَʿعَf","root":"عرف"},{"id":7,"arabic":"وَهُمْ","translit":"ْmُhَw","root":""},{"id":8,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":9,"arabic":"مُنكِرُونَ","translit":"َnwُrِknُm","root":"نكر"}],"hasIhya":false},{"ayah":59,"text":"وَلَمَّا جَهَّزَهُم بِجَهَازِهِمْ قَالَ ٱئْتُونِى بِأَخٍ لَّكُم مِّنْ أَبِيكُمْۚ أَلَا تَرَوْنَ أَنِّىٓ أُوفِى ٱلْكَيْلَ وَأَنَا۠ خَيْرُ ٱلْمُنزِلِينَ ","translation":"And when he had furnished them with their supplies, he said, \"Bring me a brother of yours from your father.[1] Do you not see that I give full measure and that I am the best of accommodators?","words":[{"id":1,"arabic":"وَلَمَّا","translit":"āَّmَlَw","root":""},{"id":2,"arabic":"جَهَّزَهُم","translit":"mُhَzَّhَjg","root":"جهز"},{"id":3,"arabic":"بِجَهَازِهِمْ","translit":"ْmِhِzāَhَjgِb","root":"جهز"},{"id":4,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":5,"arabic":"ٱئْتُونِى","translit":"àِnwُtْyʾٱ","root":"اتي"},{"id":6,"arabic":"بِأَخٍ","translit":"ٍhkَaʾِb","root":"اخو"},{"id":7,"arabic":"لَّكُم","translit":"mُkَّl","root":""},{"id":8,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":9,"arabic":"أَبِيكُمْ","translit":"ْmُkyِbَaʾ","root":"ابو"},{"id":10,"arabic":"أَلَا","translit":"āَlَaʾ","root":""},{"id":11,"arabic":"تَرَوْنَ","translit":"َnْwَrَt","root":"راي"},{"id":12,"arabic":"أَنِّىٓ","translit":"ٓàِّnَaʾ","root":""},{"id":13,"arabic":"أُوفِى","translit":"àِfwُaʾ","root":"وفي"},{"id":14,"arabic":"ٱلْكَيْلَ","translit":"َlْyَkْlٱ","root":"كيل"},{"id":15,"arabic":"وَأَنَا۠","translit":"۠āَnَaʾَw","root":""},{"id":16,"arabic":"خَيْرُ","translit":"ُrْyَhk","root":"خير"},{"id":17,"arabic":"ٱلْمُنزِلِينَ","translit":"َnyِlِznُmْlٱ","root":"نزل"}],"hasIhya":false},{"ayah":60,"text":"فَإِن لَّمْ تَأْتُونِى بِهِۦ فَلَا كَيْلَ لَكُمْ عِندِى وَلَا تَقْرَبُونِ ","translation":"But if you do not bring him to me, no measure will there be [hereafter] for you from me, nor will you approach me.\"","words":[{"id":1,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":2,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":3,"arabic":"تَأْتُونِى","translit":"àِnwُtْaʾَt","root":"اتي"},{"id":4,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":5,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":6,"arabic":"كَيْلَ","translit":"َlْyَk","root":"كيل"},{"id":7,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":8,"arabic":"عِندِى","translit":"àِdnِʿع","root":"عند"},{"id":9,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":10,"arabic":"تَقْرَبُونِ","translit":"ِnwُbَrْqَt","root":"قرب"}],"hasIhya":false},{"ayah":61,"text":"قَالُوا۟ سَنُرَٰوِدُ عَنْهُ أَبَاهُ وَإِنَّا لَفَٰعِلُونَ ","translation":"They said, \"We will attempt to dissuade his father from [keeping] him, and indeed, we will do [it].\"","words":[{"id":1,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":2,"arabic":"سَنُرَٰوِدُ","translit":"ُdِwَٰrُnَs","root":"رود"},{"id":3,"arabic":"عَنْهُ","translit":"ُhْnَʿع","root":""},{"id":4,"arabic":"أَبَاهُ","translit":"ُhāَbَaʾ","root":"ابو"},{"id":5,"arabic":"وَإِنَّا","translit":"āَّnِiʾَw","root":""},{"id":6,"arabic":"لَفَٰعِلُونَ","translit":"َnwُlِʿعَٰfَl","root":"فعل"}],"hasIhya":false},{"ayah":62,"text":"وَقَالَ لِفِتْيَٰنِهِ ٱجْعَلُوا۟ بِضَٰعَتَهُمْ فِى رِحَالِهِمْ لَعَلَّهُمْ يَعْرِفُونَهَآ إِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمْ لَعَلَّهُمْ يَرْجِعُونَ ","translation":"And [Joseph] said to his servants, \"Put their merchandise[1] into their saddlebags so they might recognize it when they have gone back to their people that perhaps they will [again] return.\"","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"لِفِتْيَٰنِهِ","translit":"ِhِnَٰyْtِfِl","root":"فتي"},{"id":3,"arabic":"ٱجْعَلُوا۟","translit":"۟āwُlَʿعْjgٱ","root":"جعل"},{"id":4,"arabic":"بِضَٰعَتَهُمْ","translit":"ْmُhَtَʿعَٰḍِb","root":"بضع"},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"رِحَالِهِمْ","translit":"ْmِhِlāَḥِr","root":"رحل"},{"id":7,"arabic":"لَعَلَّهُمْ","translit":"ْmُhَّlَʿعَl","root":""},{"id":8,"arabic":"يَعْرِفُونَهَآ","translit":"ٓāَhَnwُfِrْʿعَy","root":"عرف"},{"id":9,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":10,"arabic":"ٱنقَلَبُوٓا۟","translit":"۟āٓwُbَlَqnٱ","root":"قلب"},{"id":11,"arabic":"إِلَىٰٓ","translit":"ٰٓàَlِiʾ","root":""},{"id":12,"arabic":"أَهْلِهِمْ","translit":"ْmِhِlْhَaʾ","root":"اهل"},{"id":13,"arabic":"لَعَلَّهُمْ","translit":"ْmُhَّlَʿعَl","root":""},{"id":14,"arabic":"يَرْجِعُونَ","translit":"َnwُʿعِjgْrَy","root":"رجع"}],"hasIhya":false},{"ayah":63,"text":"فَلَمَّا رَجَعُوٓا۟ إِلَىٰٓ أَبِيهِمْ قَالُوا۟ يَٰٓأَبَانَا مُنِعَ مِنَّا ٱلْكَيْلُ فَأَرْسِلْ مَعَنَآ أَخَانَا نَكْتَلْ وَإِنَّا لَهُۥ لَحَٰفِظُونَ ","translation":"So when they returned to their father, they said, \"O our father, [further] measure has been denied to us, so send with us our brother [that] we will be given measure. And indeed, we will be his guardians.\"","words":[{"id":1,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":2,"arabic":"رَجَعُوٓا۟","translit":"۟āٓwُʿعَjgَr","root":"رجع"},{"id":3,"arabic":"إِلَىٰٓ","translit":"ٰٓàَlِiʾ","root":""},{"id":4,"arabic":"أَبِيهِمْ","translit":"ْmِhyِbَaʾ","root":"ابو"},{"id":5,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":6,"arabic":"يَٰٓأَبَانَا","translit":"āَnāَbَaʾَٰٓy","root":"ابو"},{"id":7,"arabic":"مُنِعَ","translit":"َʿعِnُm","root":"منع"},{"id":8,"arabic":"مِنَّا","translit":"āَّnِm","root":""},{"id":9,"arabic":"ٱلْكَيْلُ","translit":"ُlْyَkْlٱ","root":"كيل"},{"id":10,"arabic":"فَأَرْسِلْ","translit":"ْlِsْrَaʾَf","root":"رسل"},{"id":11,"arabic":"مَعَنَآ","translit":"ٓāَnَʿعَm","root":""},{"id":12,"arabic":"أَخَانَا","translit":"āَnāَhkَaʾ","root":"اخو"},{"id":13,"arabic":"نَكْتَلْ","translit":"ْlَtْkَn","root":"كيل"},{"id":14,"arabic":"وَإِنَّا","translit":"āَّnِiʾَw","root":""},{"id":15,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":16,"arabic":"لَحَٰفِظُونَ","translit":"َnwُẓِfَٰḥَl","root":"حفظ"}],"hasIhya":false},{"ayah":64,"text":"قَالَ هَلْ ءَامَنُكُمْ عَلَيْهِ إِلَّا كَمَآ أَمِنتُكُمْ عَلَىٰٓ أَخِيهِ مِن قَبْلُۖ فَٱللَّهُ خَيْرٌ حَٰفِظًاۖ وَهُوَ أَرْحَمُ ٱلرَّٰحِمِينَ ","translation":"He said, \"Should I entrust you with him except [under coercion] as I entrusted you with his brother before? But Allāh is the best guardian, and He is the most merciful of the merciful.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"هَلْ","translit":"ْlَh","root":""},{"id":3,"arabic":"ءَامَنُكُمْ","translit":"ْmُkُnَmāَء","root":"امن"},{"id":4,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":5,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":6,"arabic":"كَمَآ","translit":"ٓāَmَk","root":""},{"id":7,"arabic":"أَمِنتُكُمْ","translit":"ْmُkُtnِmَaʾ","root":"امن"},{"id":8,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":9,"arabic":"أَخِيهِ","translit":"ِhyِhkَaʾ","root":"اخو"},{"id":10,"arabic":"مِن","translit":"nِm","root":""},{"id":11,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":12,"arabic":"فَٱللَّهُ","translit":"ُhَّllٱَf","root":"اله"},{"id":13,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":14,"arabic":"حَٰفِظًا","translit":"āًẓِfَٰḥ","root":"حفظ"},{"id":15,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":16,"arabic":"أَرْحَمُ","translit":"ُmَḥْrَaʾ","root":"رحم"},{"id":17,"arabic":"ٱلرَّٰحِمِينَ","translit":"َnyِmِḥَّٰrlٱ","root":"رحم"}],"hasIhya":false},{"ayah":65,"text":"وَلَمَّا فَتَحُوا۟ مَتَٰعَهُمْ وَجَدُوا۟ بِضَٰعَتَهُمْ رُدَّتْ إِلَيْهِمْۖ قَالُوا۟ يَٰٓأَبَانَا مَا نَبْغِىۖ هَٰذِهِۦ بِضَٰعَتُنَا رُدَّتْ إِلَيْنَاۖ وَنَمِيرُ أَهْلَنَا وَنَحْفَظُ أَخَانَا وَنَزْدَادُ كَيْلَ بَعِيرٍۖ ذَٰلِكَ كَيْلٌ يَسِيرٌ ","translation":"And when they opened their baggage, they found their merchandise returned to them. They said, \"O our father, what [more] could we desire? This is our merchandise returned to us. And we will obtain supplies [i.e., food] for our family and protect our brother and obtain an increase of a camel's load; that is an easy measurement.\"[1]","words":[{"id":1,"arabic":"وَلَمَّا","translit":"āَّmَlَw","root":""},{"id":2,"arabic":"فَتَحُوا۟","translit":"۟āwُḥَtَf","root":"فتح"},{"id":3,"arabic":"مَتَٰعَهُمْ","translit":"ْmُhَʿعَٰtَm","root":"متع"},{"id":4,"arabic":"وَجَدُوا۟","translit":"۟āwُdَjgَw","root":"وجد"},{"id":5,"arabic":"بِضَٰعَتَهُمْ","translit":"ْmُhَtَʿعَٰḍِb","root":"بضع"},{"id":6,"arabic":"رُدَّتْ","translit":"ْtَّdُr","root":"ردد"},{"id":7,"arabic":"إِلَيْهِمْ","translit":"ْmِhْyَlِiʾ","root":""},{"id":8,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":9,"arabic":"يَٰٓأَبَانَا","translit":"āَnāَbَaʾَٰٓy","root":"ابو"},{"id":10,"arabic":"مَا","translit":"āَm","root":""},{"id":11,"arabic":"نَبْغِى","translit":"àِغْbَn","root":"بغي"},{"id":12,"arabic":"هَٰذِهِۦ","translit":"ۦِhِhdَٰh","root":""},{"id":13,"arabic":"بِضَٰعَتُنَا","translit":"āَnُtَʿعَٰḍِb","root":"بضع"},{"id":14,"arabic":"رُدَّتْ","translit":"ْtَّdُr","root":"ردد"},{"id":15,"arabic":"إِلَيْنَا","translit":"āَnْyَlِiʾ","root":""},{"id":16,"arabic":"وَنَمِيرُ","translit":"ُryِmَnَw","root":"مير"},{"id":17,"arabic":"أَهْلَنَا","translit":"āَnَlْhَaʾ","root":"اهل"},{"id":18,"arabic":"وَنَحْفَظُ","translit":"ُẓَfْḥَnَw","root":"حفظ"},{"id":19,"arabic":"أَخَانَا","translit":"āَnāَhkَaʾ","root":"اخو"},{"id":20,"arabic":"وَنَزْدَادُ","translit":"ُdāَdْzَnَw","root":"زيد"},{"id":21,"arabic":"كَيْلَ","translit":"َlْyَk","root":"كيل"},{"id":22,"arabic":"بَعِيرٍ","translit":"ٍryِʿعَb","root":"بعر"},{"id":23,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":24,"arabic":"كَيْلٌ","translit":"ٌlْyَk","root":"كيل"},{"id":25,"arabic":"يَسِيرٌ","translit":"ٌryِsَy","root":"يسر"}],"hasIhya":false},{"ayah":66,"text":"قَالَ لَنْ أُرْسِلَهُۥ مَعَكُمْ حَتَّىٰ تُؤْتُونِ مَوْثِقًا مِّنَ ٱللَّهِ لَتَأْتُنَّنِى بِهِۦٓ إِلَّآ أَن يُحَاطَ بِكُمْۖ فَلَمَّآ ءَاتَوْهُ مَوْثِقَهُمْ قَالَ ٱللَّهُ عَلَىٰ مَا نَقُولُ وَكِيلٌ ","translation":"[Jacob] said, \"Never will I send him with you until you give me a promise [i.e., oath] by Allāh that you will bring him [back] to me, unless you should be surrounded [i.e., overcome by enemies].\" And when they had given their promise, he said, \"Allāh, over what we say, is Entrusted.\"[1]","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"لَنْ","translit":"ْnَl","root":""},{"id":3,"arabic":"أُرْسِلَهُۥ","translit":"ۥُhَlِsْrُaʾ","root":"رسل"},{"id":4,"arabic":"مَعَكُمْ","translit":"ْmُkَʿعَm","root":""},{"id":5,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":6,"arabic":"تُؤْتُونِ","translit":"ِnwُtْwʾُt","root":"اتي"},{"id":7,"arabic":"مَوْثِقًا","translit":"āًqِhtْwَm","root":"وثق"},{"id":8,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":9,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":10,"arabic":"لَتَأْتُنَّنِى","translit":"àِnَّnُtْaʾَtَl","root":"اتي"},{"id":11,"arabic":"بِهِۦٓ","translit":"ٓۦِhِb","root":""},{"id":12,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":13,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":14,"arabic":"يُحَاطَ","translit":"َṭāَḥُy","root":"حوط"},{"id":15,"arabic":"بِكُمْ","translit":"ْmُkِb","root":""},{"id":16,"arabic":"فَلَمَّآ","translit":"ٓāَّmَlَf","root":""},{"id":17,"arabic":"ءَاتَوْهُ","translit":"ُhْwَtāَء","root":"اتي"},{"id":18,"arabic":"مَوْثِقَهُمْ","translit":"ْmُhَqِhtْwَm","root":"وثق"},{"id":19,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":20,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":21,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":22,"arabic":