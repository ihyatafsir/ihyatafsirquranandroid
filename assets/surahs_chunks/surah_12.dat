َٰلَمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 105, "text": "وَكَأَيِّن مِّنَ اٰيَةࣲ فِے اِ۬لسَّمَٰوَٰتِ وَالَارْضِ يَمُرُّونَ عَلَيْهَا وَهُمْ عَنْهَا مُعْرِضُونَۖ", "words": [{"id": 1, "arabic": "وَكَأَيِّن", "translit": "", "root": ""}, {"id": 2, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اٰيَةࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَالَارْضِ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَمُرُّونَ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَلَيْهَا", "translit": "", "root": ""}, {"id": 9, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "عَنْهَا", "translit": "", "root": ""}, {"id": 11, "arabic": "مُعْرِضُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 106, "text": "وَمَا يُومِنُ أَكْثَرُهُم بِاللَّهِ إِلَّا وَهُم مُّشْرِكُونَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يُومِنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَكْثَرُهُم", "translit": "", "root": ""}, {"id": 4, "arabic": "بِاللَّهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَهُم", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّشْرِكُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 107, "text": "أَفَأَمِنُوٓاْ أَن تَاتِيَهُمْ غَٰشِيَةࣱ مِّنْ عَذَابِ اِ۬للَّهِ أَوْ تَاتِيَهُمُ اُ۬لسَّاعَةُ بَغْتَةࣰ وَهُمْ لَا يَشْعُرُونَۖ", "words": [{"id": 1, "arabic": "أَفَأَمِنُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَن", "translit": "", "root": ""}, {"id": 3, "arabic": "تَاتِيَهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "غَٰشِيَةࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 6, "arabic": "ع