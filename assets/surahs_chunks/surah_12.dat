{"surah":12,"verses":[{"ayah":1,"text":"الٓرۚ تِلْكَ ءَايَٰتُ ٱلْكِتَٰبِ ٱلْمُبِينِ ","translation":"Alif, Lām, Rā.[1] These are the verses of the clear Book.","words":[{"id":1,"arabic":"الٓر","translit":"rٓlā","root":""},{"id":2,"arabic":"تِلْكَ","translit":"َkْlِt","root":""},{"id":3,"arabic":"ءَايَٰتُ","translit":"ُtَٰyāَء","root":"ايي"},{"id":4,"arabic":"ٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱ","root":"كتب"},{"id":5,"arabic":"ٱلْمُبِينِ","translit":"ِnyِbُmْlٱ","root":"بين"}],"hasIhya":false},{"ayah":2,"text":"إِنَّآ أَنزَلْنَٰهُ قُرْءَٰنًا عَرَبِيًّا لَّعَلَّكُمْ تَعْقِلُونَ ","translation":"Indeed, We have sent it down as an Arabic Qur’ān[1] that you might understand.","words":[{"id":1,"arabic":"إِنَّآ","translit":"ٓāَّnِiʾ","root":""},{"id":2,"arabic":"أَنزَلْنَٰهُ","translit":"ُhَٰnْlَznَaʾ","root":"نزل"},{"id":3,"arabic":"قُرْءَٰنًا","translit":"āًnَٰءْrُq","root":"قرا"},{"id":4,"arabic":"عَرَبِيًّا","translit":"āًّyِbَrَʿع","root":"عرب"},{"id":5,"arabic":"لَّعَلَّكُمْ","translit":"ْmُkَّlَʿعَّl","root":""},{"id":6,"arabic":"تَعْقِلُونَ","translit":"َnwُlِqْʿعَt","root":"عقل"}],"hasIhya":false},{"ayah":3,"text":"نَحْنُ نَقُصُّ عَلَيْكَ أَحْسَنَ ٱلْقَصَصِ بِمَآ أَوْحَيْنَآ إِلَيْكَ هَٰذَا ٱلْقُرْءَانَ وَإِن كُنتَ مِن قَبْلِهِۦ لَمِنَ ٱلْغَٰفِلِينَ ","translation":"We relate to you, [O Muḥammad], the best of stories in what We have revealed to you of this Qur’ān although you were, before it, among the unaware.","words":[{"id":1,"arabic":"نَحْنُ","translit":"ُnْḥَn","root":""},{"id":2,"arabic":"نَقُصُّ","translit":"ُّṣُqَn","root":"قصص"},{"id":3,"arabic":"عَلَيْكَ","translit":"َkْyَlَʿع","root":""},{"id":4,"arabic":"أَحْسَنَ","translit":"َnَsْḥَaʾ","root":"حسن"},{"id":5,"arabic":"ٱلْقَصَصِ","translit":"ِṣَṣَqْlٱ","root":"قصص"},{"id":6,"arabic":"بِمَآ","translit":"ٓāَmِb","root":""},{"id":7,"arabic":"أَوْحَيْنَآ","translit":"ٓāَnْyَḥْwَaʾ","root":"وحي"},{"id":8,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":9,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":10,"arabic":"ٱلْقُرْءَانَ","translit":"َnāَءْrُqْlٱ","root":"قرا"},{"id":11,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":12,"arabic":"كُنتَ","translit":"َtnُk","root":"كون"},{"id":13,"arabic":"مِن","translit":"nِm","root":""},{"id":14,"arabic":"قَبْلِهِۦ","translit":"ۦِhِlْbَq","root":"قبل"},{"id":15,"arabic":"لَمِنَ","translit":"َnِmَl","root":""},{"id":16,"arabic":"ٱلْغَٰفِلِينَ","translit":"َnyِlِfَٰغْlٱ","root":"غفل"}],"hasIhya":false},{"ayah":4,"text":"إِذْ قَالَ يُوسُفُ لِأَبِيهِ يَٰٓأَبَتِ إِنِّى رَأَيْتُ أَحَدَ عَشَرَ كَوْكَبًا وَٱلشَّمْسَ وَٱلْقَمَرَ رَأَيْتُهُمْ لِى سَٰجِدِينَ ","translation":"[Of these stories mention] when Joseph said to his father,[1] \"O my father, indeed I have seen [in a dream] eleven stars and the sun and the moon; I saw them prostrating to me.\"","words":[{"id":1,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":2,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":3,"arabic":"يُوسُفُ","translit":"ُfُswُy","root":""},{"id":4,"arabic":"لِأَبِيهِ","translit":"ِhyِbَaʾِl","root":"ابو"},{"id":5,"arabic":"يَٰٓأَبَتِ","translit":"ِtَbَaʾَٰٓy","root":"ابو"},{"id":6,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":7,"arabic":"رَأَيْتُ","translit":"ُtْyَaʾَr","root":"راي"},{"id":8,"arabic":"أَحَدَ","translit":"َdَḥَaʾ","root":"احد"},{"id":9,"arabic":"عَشَرَ","translit":"َrَhsَʿع","root":"عشر"},{"id":10,"arabic":"كَوْكَبًا","translit":"āًbَkْwَk","root":"كوكب"},{"id":11,"arabic":"وَٱلشَّمْسَ","translit":"َsْmَّhslٱَw","root":"شمس"},{"id":12,"arabic":"وَٱلْقَمَرَ","translit":"َrَmَqْlٱَw","root":"قمر"},{"id":13,"arabic":"رَأَيْتُهُمْ","translit":"ْmُhُtْyَaʾَr","root":"راي"},{"id":14,"arabic":"لِى","translit":"àِl","root":""},{"id":15,"arabic":"سَٰجِدِينَ","translit":"َnyِdِjgَٰs","root":"سجد"}],"hasIhya":false},{"ayah":5,"text":"قَالَ يَٰبُنَىَّ لَا تَقْصُصْ رُءْيَاكَ عَلَىٰٓ إِخْوَتِكَ فَيَكِيدُوا۟ لَكَ كَيْدًاۖ إِنَّ ٱلشَّيْطَٰنَ لِلْإِنسَٰنِ عَدُوٌّ مُّبِينٌ ","translation":"He said, \"O my son, do not relate your vision to your brothers or they will contrive against you a plan. Indeed Satan, to man, is a manifest enemy.","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"يَٰبُنَىَّ","translit":"َّàَnُbَٰy","root":"بني"},{"id":3,"arabic":"لَا","translit":"āَl","root":""},{"id":4,"arabic":"تَقْصُصْ","translit":"ْṣُṣْqَt","root":"قصص"},{"id":5,"arabic":"رُءْيَاكَ","translit":"َkāَyْءُr","root":"راي"},{"id":6,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":7,"arabic":"إِخْوَتِكَ","translit":"َkِtَwْhkِiʾ","root":"اخو"},{"id":8,"arabic":"فَيَكِيدُوا۟","translit":"۟āwُdyِkَyَf","root":"كيد"},{"id":9,"arabic":"لَكَ","translit":"َkَl","root":""},{"id":10,"arabic":"كَيْدًا","translit":"āًdْyَk","root":"كيد"},{"id":11,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":12,"arabic":"ٱلشَّيْطَٰنَ","translit":"َnَٰṭْyَّhslٱ","root":"شطن"},{"id":13,"arabic":"لِلْإِنسَٰنِ","translit":"ِnَٰsnِiʾْlِl","root":"انس"},{"id":14,"arabic":"عَدُوٌّ","translit":"ٌّwُdَʿع","root":"عدو"},{"id":15,"arabic":"مُّبِينٌ","translit":"ٌnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":6,"text":"وَكَذَٰلِكَ يَجْتَبِيكَ رَبُّكَ وَيُعَلِّمُكَ مِن تَأْوِيلِ ٱلْأَحَادِيثِ وَيُتِمُّ نِعْمَتَهُۥ عَلَيْكَ وَعَلَىٰٓ ءَالِ يَعْقُوبَ كَمَآ أَتَمَّهَا عَلَىٰٓ أَبَوَيْكَ مِن قَبْلُ إِبْرَٰهِيمَ وَإِسْحَٰقَۚ إِنَّ رَبَّكَ عَلِيمٌ حَكِيمٌ ","translation":"And thus will your Lord choose you and teach you the interpretation of narratives [i.e., events or dreams] and complete His favor upon you and upon the family of Jacob, as He completed it upon your fathers before, Abraham and Isaac. Indeed, your Lord is Knowing and Wise.\"","words":[{"id":1,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":2,"arabic":"يَجْتَبِيكَ","translit":"َkyِbَtْjgَy","root":"جبي"},{"id":3,"arabic":"رَبُّكَ","translit":"َkُّbَr","root":"ربب"},{"id":4,"arabic":"وَيُعَلِّمُكَ","translit":"َkُmِّlَʿعُyَw","root":"علم"},{"id":5,"arabic":"مِن","translit":"nِm","root":""},{"id":