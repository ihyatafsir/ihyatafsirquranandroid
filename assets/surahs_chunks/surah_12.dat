, "translit": "", "root": ""}, {"id": 46, "arabic": "اُ۬لْحَكِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 101, "text": "۞رَبِّ قَدَ اٰتَيْتَنِے مِنَ اَ۬لْمُلْكِ وَعَلَّمْتَنِے مِن تَاوِيلِ اِ۬لَاحَادِيثِۖ فَاطِرَ اَ۬لسَّمَٰوَٰتِ وَالَارْضِ أَنتَ وَلِيِّۦ فِے اِ۬لدُّنْي۪ا وَالَاخِرَةِ تَوَفَّنِے مُسْلِماࣰ وَأَلْحِقْنِے بِالصَّٰلِحِينَۖ", "words": [{"id": 1, "arabic": "۞رَبِّ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَدَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اٰتَيْتَنِے", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْمُلْكِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَعَلَّمْتَنِے", "translit": "", "root": ""}, {"id": 7, "arabic": "مِن", "translit": "", "root": ""}, {"id": 8, "arabic": "تَاوِيلِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لَاحَادِيثِۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَاطِرَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَالَارْضِ", "translit": "", "root": ""}, {"id": 13, "arabic": "أَنتَ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَلِيِّۦ", "translit": "", "root": ""}, {"id": 15, "arabic": "فِے", "translit": "", "root": ""}, {"id": 16, "arabic": "اِ۬لدُّنْي۪ا", "translit": "", "root": ""}, {"id": 17, "arabic": "وَالَاخِرَةِ", "translit": "", "root": ""}, {"id": 18, "arabic": "تَوَفَّنِے", "translit": "", "root": ""}, {"id": 19, "arabic": "مُسْلِماࣰ", "translit": "", "root": ""}, {"id": 20, "arabic": "وَأَلْحِقْنِے", "translit": "", "root": ""}, {"id": 21, "arabic": "بِالصَّٰلِحِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 102, "text": "ذَٰلِكَ مِنَ اَنۢبَآءِ اِ۬لْغَيْبِ نُوحِيهِ إِلَيْكَۖ وَمَا كُنتَ لَدَيْهِمُۥٓ إِذَ اَجْمَعُوٓاْ أَمْرَهُمْ وَهُمْ يَمْكُرُونَۖ", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِن