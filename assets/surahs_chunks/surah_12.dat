ext":"ٱرْجِعُوٓا۟ إِلَىٰٓ أَبِيكُمْ فَقُولُوا۟ يَٰٓأَبَانَآ إِنَّ ٱبْنَكَ سَرَقَ وَمَا شَهِدْنَآ إِلَّا بِمَا عَلِمْنَا وَمَا كُنَّا لِلْغَيْبِ حَٰفِظِينَ ","translation":"Return to your father and say, 'O our father, indeed your son has stolen, and we did not testify except to what we knew. And we were not witnesses of the unseen.[1]","words":[{"id":1,"arabic":"ٱرْجِعُوٓا۟","translit":"۟āٓwُʿعِjgْrٱ","root":"رجع"},{"id":2,"arabic":"إِلَىٰٓ","translit":"ٰٓàَlِiʾ","root":""},{"id":3,"arabic":"أَبِيكُمْ","translit":"ْmُkyِbَaʾ","root":"ابو"},{"id":4,"arabic":"فَقُولُوا۟","translit":"۟āwُlwُqَf","root":"قول"},{"id":5,"arabic":"يَٰٓأَبَانَآ","translit":"ٓāَnāَbَaʾَٰٓy","root":"ابو"},{"id":6,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":7,"arabic":"ٱبْنَكَ","translit":"َkَnْbٱ","root":"بني"},{"id":8,"arabic":"سَرَقَ","translit":"َqَrَs","root":"سرق"},{"id":9,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":10,"arabic":"شَهِدْنَآ","translit":"ٓāَnْdِhَhs","root":"شهد"},{"id":11,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":12,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":13,"arabic":"عَلِمْنَا","translit":"āَnْmِlَʿع","root":"علم"},{"id":14,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":15,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":16,"arabic":"لِلْغَيْبِ","translit":"ِbْyَغْlِl","root":"غيب"},{"id":17,"arabic":"حَٰفِظِينَ","translit":"َnyِẓِfَٰḥ","root":"حفظ"}],"hasIhya":false},{"ayah":82,"text":"وَسْـَٔلِ ٱلْقَرْيَةَ ٱلَّتِى كُنَّا فِيهَا وَٱلْعِيرَ ٱلَّتِىٓ أَقْبَلْنَا فِيهَاۖ وَإِنَّا لَصَٰدِقُونَ ","translation":"And ask the city in which we were and the caravan in which we came - and indeed, we are truthful.'\"","words":[{"id":1,"arabic":"وَسْـَٔلِ","translit":"ِlَٔـْsَw","root":"سال"},{"id":2,"arabic":"ٱلْقَرْيَةَ","translit":"َẗَyْrَqْlٱ","root":"قري"},{"id":3,"arabic":"ٱلَّتِى","translit":"àِtَّlٱ","root":""},{"id":4,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":5,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":6,"arabic":"وَٱلْعِيرَ","translit":"َryِʿعْlٱَw","root":"عير"},{"id":7,"arabic":"ٱلَّتِىٓ","translit":"ٓàِtَّlٱ","root":""},{"id":8,"arabic":"أَقْبَلْنَا","translit":"āَnْlَbْqَaʾ","root":"قبل"},{"id":9,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":10,"arabic":"وَإِنَّا","translit":"āَّnِiʾَw","root":""},{"id":11,"arabic":"لَصَٰدِقُونَ","translit":"َnwُqِdَٰṣَl","root":"صدق"}],"hasIhya":true},{"ayah":83,"text":"قَالَ بَلْ سَوَّلَتْ لَكُمْ أَنفُسُكُمْ أَمْرًاۖ فَصَبْرٌ جَمِيلٌۖ عَسَى ٱللَّهُ أَن يَأْتِيَنِى بِهِمْ جَمِيعًاۚ إِنَّهُۥ هُوَ ٱلْعَلِيمُ ٱلْحَكِيمُ ","translation":"[Jacob] said, \"Rather, your souls have enticed you to something, so patience is most fitting. Perhaps Allāh will bring them to me all together. Indeed, it is He who is the Knowing, the Wise.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":3,"arabic":"سَوَّلَتْ","translit":"ْtَlَّwَs","root":"سول"},{"id":4,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":5,"arabic":"أَنفُسُكُمْ","translit":"ْmُkُsُfnَaʾ","root":"نفس"},{"id":6,"arabic":"أَمْرًا","translit":"āًrْmَaʾ","root":"امر"},{"id":7,"arabic":"فَصَبْرٌ","translit":"ٌrْbَṣَf","root":"صبر"},{"id":8,"arabic":"جَمِيلٌ","translit":"ٌlyِmَjg","root":"جمل"},{"id":9,"arabic":"عَسَى","translit":"àَsَʿع","root":"عسي"},{"id":10,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":11,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":12,"arabic":"يَأْتِيَنِى","translit":"àِnَyِtْaʾَy","root":"اتي"},{"id":13,"arabic":"بِهِمْ","translit":"ْmِhِb","root":""},{"id":14,"arabic":"جَمِيعًا","translit":"āًʿعyِmَjg","root":"جمع"},{"id":15,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":16,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":17,"arabic":"ٱلْعَلِيمُ","translit":"ُmyِlَʿعْlٱ","root":"علم"},{"id":18,"arabic":"ٱلْحَكِيمُ","translit":"ُmyِkَḥْlٱ","root":"حكم"}],"hasIhya":false},{"ayah":84,"text":"وَتَوَلَّىٰ عَنْهُمْ وَقَالَ يَٰٓأَسَفَىٰ عَلَىٰ يُوسُفَ وَٱبْيَضَّتْ عَيْنَاهُ مِنَ ٱلْحُزْنِ فَهُوَ كَظِيمٌ ","translation":"And he turned away from them and said, \"Oh, my sorrow over Joseph,\" and his eyes became white[1] from grief, for he was [of that] a suppressor.[2]","words":[{"id":1,"arabic":"وَتَوَلَّىٰ","translit":"ٰàَّlَwَtَw","root":"ولي"},{"id":2,"arabic":"عَنْهُمْ","translit":"ْmُhْnَʿع","root":""},{"id":3,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":4,"arabic":"يَٰٓأَسَفَىٰ","translit":"ٰàَfَsَaʾَٰٓy","root":"اسف"},{"id":5,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":6,"arabic":"يُوسُفَ","translit":"َfُswُy","root":""},{"id":7,"arabic":"وَٱبْيَضَّتْ","translit":"ْtَّḍَyْbٱَw","root":"بيض"},{"id":8,"arabic":"عَيْنَاهُ","translit":"ُhāَnْyَʿع","root":"عين"},{"id":9,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":10,"arabic":"ٱلْحُزْنِ","translit":"ِnْzُḥْlٱ","root":"حزن"},{"id":11,"arabic":"فَهُوَ","translit":"َwُhَf","root":""},{"id":12,"arabic":"كَظِيمٌ","translit":"ٌmyِẓَk","root":"كظم"}],"hasIhya":false},{"ayah":85,"text":"قَالُوا۟ تَٱللَّهِ تَفْتَؤُا۟ تَذْكُرُ يُوسُفَ حَتَّىٰ تَكُونَ حَرَضًا أَوْ تَكُونَ مِنَ ٱلْهَٰلِكِينَ ","translation":"They said, \"By Allāh, you will not cease remembering Joseph until you become fatally ill or become of those who perish.\"","words":[{"id":1,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":2,"arabic":"تَٱللَّهِ","translit":"ِhَّllٱَt","root":"اله"},{"id":3,"arabic":"تَفْتَؤُا۟","translit":"۟āُwʾَtْfَt","root":"فتا"},{"id":4,"arabic":"تَذْكُرُ","translit":"ُrُkْhdَt","root":"ذكر"},{"id":5,"arabic":"يُوسُفَ","translit":"َfُswُy","root":""},{"id":6,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":7,"arabic":"تَكُونَ","translit":"َnwُkَt","root":"كون"},{"id":8,"arabic":"حَرَضًا","translit":"āًḍَrَḥ","root":"حرض"},{"id":9,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":10,"arabic":"تَكُونَ","translit":"َnwُkَt","root":"كون"},{"id":11,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":12,"arabic":"ٱلْهَٰلِكِينَ","translit":"َnyِkِlَٰhْlٱ","root":"هلك"}],"hasIhya":false},{"ayah":86,"text":"قَالَ إِنَّمَآ أَشْكُوا۟ بَثِّى وَحُزْنِىٓ إِلَى ٱللَّهِ وَأَعْلَمُ مِنَ ٱللَّهِ مَا لَا تَعْلَمُونَ ","translation":"He said, \"I only complain of my suffering and my grief to Allāh, and I know from Allāh that which you do not know.","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"إِنَّمَآ","translit":"ٓāَmَّnِiʾ","root":""},{"id":3,"arabic":"أَشْكُوا۟","translit":"۟āwُkْhsَaʾ","root":"شكو"},{"id":4,"arabic":"بَثِّى","translit":"àِّhtَb","root":"بثث"},{"id":5,"arabic":"وَحُزْنِىٓ","translit":"ٓàِnْzُḥَw","root":"حزن"},{"id":6,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"وَأَعْلَمُ","translit":"ُmَlْʿعَaʾَw","root":"علم"},{"id":9,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":10,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":11,"arabic":"مَا","translit":"āَm","root":""},{"id":12,"arabic":"لَا","translit":"āَl","root":""},{"id":13,"arabic":"تَعْلَمُونَ","translit":"َnwُmَlْʿعَt","root":"علم"}],"hasIhya":false},{"ayah":87,"text":"يَٰبَنِىَّ ٱذْهَبُوا۟ فَتَحَسَّسُوا۟ مِن يُوسُفَ وَأَخِيهِ وَلَا تَا۟يْـَٔسُوا۟ مِن رَّوْحِ ٱللَّهِۖ إِنَّهُۥ لَا يَا۟يْـَٔسُ مِن رَّوْحِ ٱللَّهِ إِلَّا ٱلْقَوْمُ ٱلْكَٰفِرُونَ ","translation":"O my sons, go and find out about Joseph and his brother and despair not of relief from Allāh. Indeed, no one despairs of relief from Allāh except the disbelieving people.\"","words":[{"id":1,"arabic":"يَٰبَنِىَّ","translit":"َّàِnَbَٰy","root":"بني"},{"id":2,"arabic":"ٱذْهَبُوا۟","translit":"۟āwُbَhْhdٱ","root":"ذهب"},{"id":3,"arabic":"فَتَحَسَّسُوا۟","translit":"۟āwُsَّsَḥَtَf","root":"حسس"},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"يُوسُفَ","translit":"َfُswُy","root":""},{"id":6,"arabic":"وَأَخِيهِ","translit":"ِhyِhkَaʾَw","root":"اخو"},{"id":7,"arabic":"وَلَا","translit":"āَlَw","r