 "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "دُبُرࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَكَذَبَتْۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 9, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لصَّٰدِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 28, "text": "فَلَمَّا ر۪ء۪ا قَمِيصَهُۥ قُدَّ مِن دُبُرࣲ قَالَ إِنَّهُۥ مِن كَيْدِكُنَّ إِنَّ كَيْدَكُنَّ عَظِيمࣱۖ", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "ر۪ء۪ا", "translit": "", "root": ""}, {"id": 3, "arabic": "قَمِيصَهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "قُدَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "دُبُرࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 9, "arabic": "مِن", "translit": "", "root": ""}, {"id": 10, "arabic": "كَيْدِكُنَّ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 12, "arabic": "كَيْدَكُنَّ", "translit": "", "root": ""}, {"id": 13, "arabic": "عَظِيمࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 29, "text": "يُوسُفُ أَعْرِضْ عَنْ هَٰذَاۖ وَاسْتَغْفِرِے لِذَنۢبِكِ إِنَّكِ كُنتِ مِنَ اَ۬لْخَاطِـِٕينَۖ", "words": [{"id": 1, "arabic": "يُوسُفُ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَعْرِضْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَنْ", "translit": "", "root": ""}, {"id": 4, "arabic": "هَٰذَاۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَاسْتَغْفِرِے", "translit": "", "root": ""}, {"id": 6, "arabic": "لِذَنۢبِكِ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنَّكِ", "translit": "", "root": ""}, {"id": 8, "arabic": "كُنتِ", "translit": "", "root":