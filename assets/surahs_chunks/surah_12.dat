":""},{"id":4,"arabic":"مَّاذَا","translit":"āَhdāَّm","root":""},{"id":5,"arabic":"تَفْقِدُونَ","translit":"َnwُdِqْfَt","root":"فقد"}],"hasIhya":false},{"ayah":72,"text":"قَالُوا۟ نَفْقِدُ صُوَاعَ ٱلْمَلِكِ وَلِمَن جَآءَ بِهِۦ حِمْلُ بَعِيرٍ وَأَنَا۠ بِهِۦ زَعِيمٌ ","translation":"They said, \"We are missing the measure of the king. And for he who produces it is [the reward of] a camel's load, and I am responsible for it.\"","words":[{"id":1,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":2,"arabic":"نَفْقِدُ","translit":"ُdِqْfَn","root":"فقد"},{"id":3,"arabic":"صُوَاعَ","translit":"َʿعāَwُṣ","root":"صوع"},{"id":4,"arabic":"ٱلْمَلِكِ","translit":"ِkِlَmْlٱ","root":"ملك"},{"id":5,"arabic":"وَلِمَن","translit":"nَmِlَw","root":""},{"id":6,"arabic":"جَآءَ","translit":"َءٓāَjg","root":"جيا"},{"id":7,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":8,"arabic":"حِمْلُ","translit":"ُlْmِḥ","root":"حمل"},{"id":9,"arabic":"بَعِيرٍ","translit":"ٍryِʿعَb","root":"بعر"},{"id":10,"arabic":"وَأَنَا۠","translit":"۠āَnَaʾَw","root":""},{"id":11,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":12,"arabic":"زَعِيمٌ","translit":"ٌmyِʿعَz","root":"زعم"}],"hasIhya":false},{"ayah":73,"text":"قَالُوا۟ تَٱللَّهِ لَقَدْ عَلِمْتُم مَّا جِئْنَا لِنُفْسِدَ فِى ٱلْأَرْضِ وَمَا كُنَّا سَٰرِقِينَ ","translation":"They said, \"By Allāh, you have certainly known that we did not come to cause corruption in the land, and we have not been thieves.\"","words":[{"id":1,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":2,"arabic":"تَٱللَّهِ","translit":"ِhَّllٱَt","root":"اله"},{"id":3,"arabic":"لَقَدْ","translit":"ْdَqَl","root":""},{"id":4,"arabic":"عَلِمْتُم","translit":"mُtْmِlَʿع","root":"علم"},{"id":5,"arabic":"مَّا","translit":"āَّm","root":""},{"id":6,"arabic":"جِئْنَا","translit":"āَnْyʾِjg","root":"جيا"},{"id":7,"arabic":"لِنُفْسِدَ","translit":"َdِsْfُnِl","root":"فسد"},{"id":8,"arabic":"فِى","translit":"àِf","root":""},{"id":9,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":10,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":11,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":12,"arabic":"سَٰرِقِينَ","translit":"َnyِqِrَٰs","root":"سرق"}],"hasIhya":false},{"ayah":74,"text":"قَالُوا۟ فَمَا جَزَٰٓؤُهُۥٓ إِن كُنتُمْ كَٰذِبِينَ ","translation":"They [the accusers] said, \"Then what would be its recompense[1] if you should be liars?\"","words":[{"id":1,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":2,"arabic":"فَمَا","translit":"āَmَf","root":""},{"id":3,"arabic":"جَزَٰٓؤُهُۥٓ","translit":"ٓۥُhُwʾَٰٓzَjg","root":"جزي"},{"id":4,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":5,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":6,"arabic":"كَٰذِبِينَ","translit":"َnyِbِhdَٰk","root":"كذب"}],"hasIhya":false},{"ayah":75,"text":"قَالُوا۟ جَزَٰٓؤُهُۥ مَن وُجِدَ فِى رَحْلِهِۦ فَهُوَ جَزَٰٓؤُهُۥۚ كَذَٰلِكَ نَجْزِى ٱلظَّٰلِمِينَ ","translation":"[The brothers] said, \"Its recompense is that he in whose bag it is found - he [himself] will be its recompense.[1] Thus do we recompense the wrongdoers.\"","words":[{"id":1,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":2,"arabic":"جَزَٰٓؤُهُۥ","translit":"ۥُhُwʾَٰٓzَjg","root":"جزي"},{"id":3,"arabic":"مَن","translit":"nَm","root":""},{"id":4,"arabic":"وُجِدَ","translit":"َdِjgُw","root":"وجد"},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"رَحْلِهِۦ","translit":"ۦِhِlْḥَr","root":"رحل"},{"id":7,"arabic":"فَهُوَ","translit":"َwُhَf","root":""},{"id":8,"arabic":"جَزَٰٓؤُهُۥ","translit":"ۥُhُwʾَٰٓzَjg","root":"جزي"},{"id":9,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":10,"arabic":"نَجْزِى","translit":"àِzْjgَn","root":"جزي"},{"id":11,"arabic":"ٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱ","root":"ظلم"}],"hasIhya":false},{"ayah":76,"text":"فَبَدَأَ بِأَوْعِيَتِهِمْ قَبْلَ وِعَآءِ أَخِيهِ ثُمَّ ٱسْتَخْرَجَهَا مِن وِعَآءِ أَخِيهِۚ كَذَٰلِكَ كِدْنَا لِيُوسُفَۖ مَا كَانَ لِيَأْخُذَ أَخَاهُ فِى دِينِ ٱلْمَلِكِ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ نَرْفَعُ دَرَجَٰتٍ مَّن نَّشَآءُۗ وَفَوْقَ كُلِّ ذِى عِلْمٍ عَلِيمٌ ","translation":"So he began [the search] with their bags before the bag of his brother; then he extracted it from the bag of his brother. Thus did We plan for Joseph. He could not have taken his brother within the religion [i.e., law] of the king except that Allāh willed. We raise in degrees whom We will, but over every possessor of knowledge is one [more] knowing.[1]","words":[{"id":1,"arabic":"فَبَدَأَ","translit":"َaʾَdَbَf","root":"بدا"},{"id":2,"arabic":"بِأَوْعِيَتِهِمْ","translit":"ْmِhِtَyِʿعْwَaʾِb","root":"وعي"},{"id":3,"arabic":"قَبْلَ","translit":"َlْbَq","root":"قبل"},{"id":4,"arabic":"وِعَآءِ","translit":"ِءٓāَʿعِw","root":"وعي"},{"id":5,"arabic":"أَخِيهِ","translit":"ِhyِhkَaʾ","root":"اخو"},{"id":6,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":7,"arabic":"ٱسْتَخْرَجَهَا","translit":"āَhَjgَrْhkَtْsٱ","root":"خرج"},{"id":8,"arabic":"مِن","translit":"nِm","root":""},{"id":9,"arabic":"وِعَآءِ","translit":"ِءٓāَʿعِw","root":"وعي"},{"id":10,"arabic":"أَخِيهِ","translit":"ِhyِhkَaʾ","root":"اخو"},{"id":11,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":12,"arabic":"كِدْنَا","translit":"āَnْdِk","root":"كيد"},{"id":13,"arabic":"لِيُوسُفَ","translit":"َfُswُyِl","root":""},{"id":14,"arabic":"مَا","translit":"āَm","root":""},{"id":15,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":16,"arabic":"لِيَأْخُذَ","translit":"َhdُhkْaʾَyِl","root":"اخذ"},{"id":17,"arabic":"أَخَاهُ","translit":"ُhāَhkَaʾ","root":"اخو"},{"id":18,"arabic":"فِى","translit":"àِf","root":""},{"id":19,"arabic":"دِينِ","translit":"ِnyِd","root":"دين"},{"id":20,"arabic":"ٱلْمَلِكِ","translit":"ِkِlَmْlٱ","root":"ملك"},{"id":21,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":22,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":23,"arabic":"يَشَآءَ","translit":"َءٓāَhsَy","root":"شيا"},{"id":24,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":25,"arabic":"نَرْفَعُ","translit":"ُʿعَfْrَn","root":"رفع"},{"id":26,"arabic":"دَرَجَٰتٍ","translit":"ٍtَٰjgَrَd","root":"درج"},{"id":27,"arabic":"مَّن","translit":"nَّm","root":""},{"id":28,"arabic":"نَّشَآءُ","translit":"ُءٓāَhsَّn","root":"شيا"},{"id":29,"arabic":"وَفَوْقَ","translit":"َqْwَfَw","root":"فوق"},{"id":30,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":31,"arabic":"ذِى","translit":"àِhd","root":""},{"id":32,"arabic":"عِلْمٍ","translit":"ٍmْlِʿع","root":"علم"},{"id":33,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"}],"hasIhya":true},{"ayah":77,"text":"قَالُوٓا۟ إِن يَسْرِقْ فَقَدْ سَرَقَ أَخٌ لَّهُۥ مِن قَبْلُۚ فَأَسَرَّهَا يُوسُفُ فِى نَفْسِهِۦ وَلَمْ يُبْدِهَا لَهُمْۚ قَالَ أَنتُمْ شَرٌّ مَّكَانًاۖ وَٱللَّهُ أَعْلَمُ بِمَا تَصِفُونَ ","translation":"They said, \"If he steals - a brother of his has stolen before.\" But Joseph kept it within himself and did not reveal it to them.[1] He said, \"You are worse in position, and Allāh is most knowing of what you describe.\"","words":[{"id":1,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":2,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":3,"arabic":"يَسْرِقْ","translit":"ْqِrْsَy","root":"سرق"},{"id":4,"arabic":"فَقَدْ","translit":"ْdَqَf","root":""},{"id":5,"arabic":"سَرَقَ","translit":"َqَrَs","root":"سرق"},{"id":6,"arabic":"أَخٌ","translit":"ٌhkَaʾ","root":"اخو"},{"id":7,"arabic":"لَّهُۥ","translit":"ۥُhَّl","root":""},{"id":8,"arabic":"مِن","translit":"nِm","root":""},{"id":9,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":10,"arabic":"فَأَسَرَّهَا","translit":"āَhَّrَsَaʾَf","root":"سرر"},{"id":11,"arabic":"يُوسُفُ","translit":"ُfُswُy","root":""},{"id":12,"arabic":"فِى","translit":"àِf","root":""},{"id":13,"arabic":"نَفْسِهِۦ","translit":"ۦِhِsْfَn","root":"نفس"},{"id":14,"arabic":"وَلَمْ","translit":"ْmَlَw","root":""},{"id":15,"arabic":"يُبْدِهَا","translit":"āَhِdْbُy","root":"بدو"},{"id":16,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":17,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":18,"arabic":"أَنتُمْ","translit":"ْmُtnَaʾ","root":""},{"id":19,"arabic":"شَرٌّ","translit":"ٌّrَhs","root":"شرر"},{"id":20,"arabic":"مَّكَانًا","translit":"āًnāَkَّm","root":"كون"},{"id":21,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":22,"arabic":"أَعْلَمُ","translit":"ُmَlْʿعَaʾ","root":"علم"},{"id":23,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":24,"arabic":"تَصِفُونَ","translit":"َnwُfِṣَt","root":"وصف"}],"hasIhya":false},{"ayah":78,"text":"قَالُوا۟ يَٰٓأَيُّهَا ٱلْعَزِيزُ إِنَّ لَهُۥٓ أَبًا شَيْخًا كَبِيرًا فَخُذْ أَحَدَنَا مَكَانَهُۥٓۖ إِنَّا نَرَىٰكَ مِنَ ٱلْمُحْسِنِينَ ","translation":"They said, \"O ʿAzeez,[1] indeed he has a father [who is] an old man, so take one of us in place of him. Indeed, we see you as a doer of good.\"","words":[{"id":1,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":2,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":3,"arabic":"ٱلْعَزِيزُ","translit":"ُzyِzَʿعْlٱ","root":"عزز"},{"id":4,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":5,"arabic":"لَهُۥٓ","translit":"ٓۥُhَl","root":""},{"id":6,"arabic":"أَبًا","translit":"āًbَaʾ","root":"ابو"},{"id":7,"arabic":"شَيْخًا","translit":"āًhkْyَhs","root":"شيخ"},{"id":8,"arabic":"كَبِيرًا","translit":"āًryِbَk","root":"كبر"},{"id":9,"arabic":"فَخُذْ","translit":"ْhdُhkَf","root":"اخذ"},{"id":10,"arabic":"أَحَدَنَا","translit":"āَnَdَḥَaʾ","root":"احد"},{"id":11,"arabic":"مَكَانَهُۥٓ","translit":"ٓۥُhَnāَkَm","root":"كون"},{"id":12,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":13,"arabic":"نَرَىٰكَ","translit":"َkٰàَrَn","root":"راي"},{"id":14,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":15,"arabic":"ٱلْمُحْسِنِينَ","translit":"َnyِnِsْḥُmْlٱ","root":"حسن"}],"hasIhya":false},{"ayah":79,"text":"قَالَ مَعَاذَ ٱللَّهِ أَن نَّأْخُذَ إِلَّا مَن وَجَدْنَا مَتَٰعَنَا عِندَهُۥٓ إِنَّآ إِذًا لَّظَٰلِمُونَ ","translation":"He said, \"[I seek] the refuge of Allāh [to prevent] that we take except him with whom we found our possession. Indeed, we would then be unjust.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"مَعَاذَ","translit":"َhdāَʿعَm","root":"عوذ"},{"id":3,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":4,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":5,"arabic":"نَّأْخُذَ","translit":"َhdُhkْaʾَّn","root":"اخذ"},{"id":6,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":7,"arabic":"مَن","translit":"nَm","root":""},{"id":8,"arabic":"وَجَدْنَا","translit":"āَnْdَjgَw","root":"وجد"},{"id":9,"arabic":"مَتَٰعَنَا","translit":"āَnَʿعَٰtَm","root":"متع"},{"id":10,"arabic":"عِندَهُۥٓ","translit":"ٓۥُhَdnِʿع","root":"عند"},{"id":11,"arabic":"إِنَّآ","translit":"ٓāَّnِiʾ","root":""},{"id":12,"arabic":"إِذًا","translit":"āًhdِiʾ","root":""},{"id":13,"arabic":"لَّظَٰلِمُونَ","translit":"َnwُmِlَٰẓَّl","root":"ظلم"}],"hasIhya":false},{"ayah":80,"text":"فَلَمَّا ٱسْتَيْـَٔسُوا۟ مِنْهُ خَلَصُوا۟ نَجِيًّاۖ قَالَ كَبِيرُهُمْ أَلَمْ تَعْلَمُوٓا۟ أَنَّ أَبَاكُمْ قَدْ أَخَذَ عَلَيْكُم مَّوْثِقًا مِّنَ ٱللَّهِ وَمِن قَبْلُ مَا فَرَّطتُمْ فِى يُوسُفَۖ فَلَنْ أَبْرَحَ ٱلْأَرْضَ حَتَّىٰ يَأْذَنَ لِىٓ أَبِىٓ أَوْ يَحْكُمَ ٱللَّهُ لِىۖ وَهُوَ خَيْرُ ٱلْحَٰكِمِينَ ","translation":"So when they had despaired of him, they secluded themselves in private consultation. The eldest of them said, \"Do you not know that your father has taken upon you an oath by Allāh and [that] before you failed in [your duty to] Joseph? So I will never leave [this] land until my father permits me or Allāh decides for me,[1] and He is the best of judges.","words":[{"id":1,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":2,"arabic":"ٱسْتَيْـَٔسُوا۟","translit":"۟āwُsَٔـْyَtْsٱ","root":"ياس"},{"id":3,"arabic":"مِنْهُ","translit":"ُhْnِm","root":""},{"id":4,"arabic":"خَلَصُوا۟","translit":"۟āwُṣَlَhk","root":"خلص"},{"id":5,"arabic":"نَجِيًّا","translit":"āًّyِjgَn","root":"نجو"},{"