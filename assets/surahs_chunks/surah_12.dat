 110, "text": "حَتَّيٰٓ إِذَا اَ۪سْتَيْـَٔسَ اَ۬لرُّسُلُ وَظَنُّوٓاْ أَنَّهُمْ قَدْ كُذِّبُواْ جَآءَهُمْ نَصْرُنَا فَنُۨجِے مَن نَّشَآءُۖ وَلَا يُرَدُّ بَأْسُنَا عَنِ اِ۬لْقَوْمِ اِ۬لْمُجْرِمِينَۖ", "words": [{"id": 1, "arabic": "حَتَّيٰٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۪سْتَيْـَٔسَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لرُّسُلُ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَظَنُّوٓاْ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَنَّهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَدْ", "translit": "", "root": ""}, {"id": 8, "arabic": "كُذِّبُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "جَآءَهُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "نَصْرُنَا", "translit": "", "root": ""}, {"id": 11, "arabic": "فَنُۨجِے", "translit": "", "root": ""}, {"id": 12, "arabic": "مَن", "translit": "", "root": ""}, {"id": 13, "arabic": "نَّشَآءُۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 15, "arabic": "يُرَدُّ", "translit": "", "root": ""}, {"id": 16, "arabic": "بَأْسُنَا", "translit": "", "root": ""}, {"id": 17, "arabic": "عَنِ", "translit": "", "root": ""}, {"id": 18, "arabic": "اِ۬لْقَوْمِ", "translit": "", "root": ""}, {"id": 19, "arabic": "اِ۬لْمُجْرِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 111, "text": "۞لَقَدْ كَانَ فِے قَصَصِهِمْ عِبْرَةࣱ لِّأُوْلِے اِ۬لَالْبَٰبِۖ مَا كَانَ حَدِيثاࣰ يُفْتَر۪يٰۖ وَلَٰكِن تَصْدِيقَ اَ۬لذِے بَيْنَ يَدَيْهِ وَتَفْصِيلَ كُلِّ شَےْءࣲ وَهُديࣰ وَرَحْمَةࣰ لِّقَوْمࣲ يُومِنُونَۖ", "words": [{"id": 1, "arabic": "۞لَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "قَصَصِهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "عِبْرَةࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "لِّاُ