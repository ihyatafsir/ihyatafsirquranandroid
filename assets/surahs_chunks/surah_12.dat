, then indeed, Allāh does not allow to be lost the reward of those who do good.\"","words":[{"id":1,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":2,"arabic":"أَءِنَّكَ","translit":"َkَّnِءَaʾ","root":""},{"id":3,"arabic":"لَأَنتَ","translit":"َtnَaʾَl","root":""},{"id":4,"arabic":"يُوسُفُ","translit":"ُfُswُy","root":""},{"id":5,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":6,"arabic":"أَنَا۠","translit":"۠āَnَaʾ","root":""},{"id":7,"arabic":"يُوسُفُ","translit":"ُfُswُy","root":""},{"id":8,"arabic":"وَهَٰذَآ","translit":"ٓāَhdَٰhَw","root":""},{"id":9,"arabic":"أَخِى","translit":"àِhkَaʾ","root":"اخو"},{"id":10,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":11,"arabic":"مَنَّ","translit":"َّnَm","root":"منن"},{"id":12,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":13,"arabic":"عَلَيْنَآ","translit":"ٓāَnْyَlَʿع","root":""},{"id":14,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":15,"arabic":"مَن","translit":"nَm","root":""},{"id":16,"arabic":"يَتَّقِ","translit":"ِqَّtَy","root":"وقي"},{"id":17,"arabic":"وَيَصْبِرْ","translit":"ْrِbْṣَyَw","root":"صبر"},{"id":18,"arabic":"فَإِنَّ","translit":"َّnِiʾَf","root":""},{"id":19,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":20,"arabic":"لَا","translit":"āَl","root":""},{"id":21,"arabic":"يُضِيعُ","translit":"ُʿعyِḍُy","root":"ضيع"},{"id":22,"arabic":"أَجْرَ","translit":"َrْjgَaʾ","root":"اجر"},{"id":23,"arabic":"ٱلْمُحْسِنِينَ","translit":"َnyِnِsْḥُmْlٱ","root":"حسن"}],"hasIhya":true},{"ayah":91,"text":"قَالُوا۟ تَٱللَّهِ لَقَدْ ءَاثَرَكَ ٱللَّهُ عَلَيْنَا وَإِن كُنَّا لَخَٰطِـِٔينَ ","translation":"They said, \"By Allāh, certainly has Allāh preferred you over us, and indeed, we have been sinners.\"","words":[{"id":1,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":2,"arabic":"تَٱللَّهِ","translit":"ِhَّllٱَt","root":"اله"},{"id":3,"arabic":"لَقَدْ","translit":"ْdَqَl","root":""},{"id":4,"arabic":"ءَاثَرَكَ","translit":"َkَrَhtāَء","root":"اثر"},{"id":5,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":6,"arabic":"عَلَيْنَا","translit":"āَnْyَlَʿع","root":""},{"id":7,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":8,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":9,"arabic":"لَخَٰطِـِٔينَ","translit":"َnyِٔـِṭَٰhkَl","root":"خطا"}],"hasIhya":false},{"ayah":92,"text":"قَالَ لَا تَثْرِيبَ عَلَيْكُمُ ٱلْيَوْمَۖ يَغْفِرُ ٱللَّهُ لَكُمْۖ وَهُوَ أَرْحَمُ ٱلرَّٰحِمِينَ ","translation":"He said, \"No blame will there be upon you today. May Allāh forgive you; and He is the most merciful of the merciful.","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"لَا","translit":"āَl","root":""},{"id":3,"arabic":"تَثْرِيبَ","translit":"َbyِrْhtَt","root":"ثرب"},{"id":4,"arabic":"عَلَيْكُمُ","translit":"ُmُkْyَlَʿع","root":""},{"id":5,"arabic":"ٱلْيَوْمَ","translit":"َmْwَyْlٱ","root":"يوم"},{"id":6,"arabic":"يَغْفِرُ","translit":"ُrِfْغَy","root":"غفر"},{"id":7,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":8,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":9,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":10,"arabic":"أَرْحَمُ","translit":"ُmَḥْrَaʾ","root":"رحم"},{"id":11,"arabic":"ٱلرَّٰحِمِينَ","translit":"َnyِmِḥَّٰrlٱ","root":"رحم"}],"hasIhya":true},{"ayah":93,"text":"ٱذْهَبُوا۟ بِقَمِيصِى هَٰذَا فَأَلْقُوهُ عَلَىٰ وَجْهِ أَبِى يَأْتِ بَصِيرًا وَأْتُونِى بِأَهْلِكُمْ أَجْمَعِينَ ","translation":"Take this, my shirt, and cast it over the face of my father; he will become seeing. And bring me your family, all together.\"","words":[{"id":1,"arabic":"ٱذْهَبُوا۟","translit":"۟āwُbَhْhdٱ","root":"ذهب"},{"id":2,"arabic":"بِقَمِيصِى","translit":"àِṣyِmَqِb","root":"قمص"},{"id":3,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":4,"arabic":"فَأَلْقُوهُ","translit":"ُhwُqْlَaʾَf","root":"لقي"},{"id":5,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":6,"arabic":"وَجْهِ","translit":"ِhْjgَw","root":"وجه"},{"id":7,"arabic":"أَبِى","translit":"àِbَaʾ","root":"ابو"},{"id":8,"arabic":"يَأْتِ","translit":"ِtْaʾَy","root":"اتي"},{"id":9,"arabic":"بَصِيرًا","translit":"āًryِṣَb","root":"بصر"},{"id":10,"arabic":"وَأْتُونِى","translit":"àِnwُtْaʾَw","root":"اتي"},{"id":11,"arabic":"بِأَهْلِكُمْ","translit":"ْmُkِlْhَaʾِb","root":"اهل"},{"id":12,"arabic":"أَجْمَعِينَ","translit":"َnyِʿعَmْjgَaʾ","root":"جمع"}],"hasIhya":false},{"ayah":94,"text":"وَلَمَّا فَصَلَتِ ٱلْعِيرُ قَالَ أَبُوهُمْ إِنِّى لَأَجِدُ رِيحَ يُوسُفَۖ لَوْلَآ أَن تُفَنِّدُونِ ","translation":"And when the caravan departed [from Egypt], their father said,[1] \"Indeed, I find the smell of Joseph [and would say that he was alive] if you did not think me weakened in mind.\"","words":[{"id":1,"arabic":"وَلَمَّا","translit":"āَّmَlَw","root":""},{"id":2,"arabic":"فَصَلَتِ","translit":"ِtَlَṣَf","root":"فصل"},{"id":3,"arabic":"ٱلْعِيرُ","translit":"ُryِʿعْlٱ","root":"عير"},{"id":4,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":5,"arabic":"أَبُوهُمْ","translit":"ْmُhwُbَaʾ","root":"ابو"},{"id":6,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":7,"arabic":"لَأَجِدُ","translit":"ُdِjgَaʾَl","root":"وجد"},{"id":8,"arabic":"رِيحَ","translit":"َḥyِr","root":"روح"},{"id":9,"arabic":"يُوسُفَ","translit":"َfُswُy","root":""},{"id":10,"arabic":"لَوْلَآ","translit":"ٓāَlْwَl","root":""},{"id":11,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":12,"arabic":"تُفَنِّدُونِ","translit":"ِnwُdِّnَfُt","root":"فند"}],"hasIhya":false},{"ayah":95,"text":"قَالُوا۟ تَٱللَّهِ إِنَّكَ لَفِى ضَلَٰلِكَ ٱلْقَدِيمِ ","translation":"They said, \"By Allāh, indeed you are in your [same] old error.\"","words":[{"id":1,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":2,"arabic":"تَٱللَّهِ","translit":"ِhَّllٱَt","root":"اله"},{"id":3,"arabic":"إِنَّكَ","translit":"َkَّnِiʾ","root":""},{"id":4,"arabic":"لَفِى","translit":"àِfَl","root":""},{"id":5,"arabic":"ضَلَٰلِكَ","translit":"َkِlَٰlَḍ","root":"ضلل"},{"id":6,"arabic":"ٱلْقَدِيمِ","t