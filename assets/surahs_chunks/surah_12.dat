abic":"أَنفُسُكُمْ","translit":"ْmُkُsُfnَaʾ","root":"نفس"},{"id":11,"arabic":"أَمْرًا","translit":"āًrْmَaʾ","root":"امر"},{"id":12,"arabic":"فَصَبْرٌ","translit":"ٌrْbَṣَf","root":"صبر"},{"id":13,"arabic":"جَمِيلٌ","translit":"ٌlyِmَjg","root":"جمل"},{"id":14,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":15,"arabic":"ٱلْمُسْتَعَانُ","translit":"ُnāَʿعَtْsُmْlٱ","root":"عون"},{"id":16,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":17,"arabic":"مَا","translit":"āَm","root":""},{"id":18,"arabic":"تَصِفُونَ","translit":"َnwُfِṣَt","root":"وصف"}],"hasIhya":false},{"ayah":19,"text":"وَجَآءَتْ سَيَّارَةٌ فَأَرْسَلُوا۟ وَارِدَهُمْ فَأَدْلَىٰ دَلْوَهُۥۖ قَالَ يَٰبُشْرَىٰ هَٰذَا غُلَٰمٌۚ وَأَسَرُّوهُ بِضَٰعَةًۚ وَٱللَّهُ عَلِيمٌۢ بِمَا يَعْمَلُونَ ","translation":"And there came a company of travelers; then they sent their water drawer, and he let down his bucket. He said, \"Good news! Here is a boy.\" And they concealed him, [taking him] as merchandise;[1] and Allāh was Knowing of what they did.","words":[{"id":1,"arabic":"وَجَآءَتْ","translit":"ْtَءٓāَjgَw","root":"جيا"},{"id":2,"arabic":"سَيَّارَةٌ","translit":"ٌẗَrāَّyَs","root":"سير"},{"id":3,"arabic":"فَأَرْسَلُوا۟","translit":"۟āwُlَsْrَaʾَf","root":"رسل"},{"id":4,"arabic":"وَارِدَهُمْ","translit":"ْmُhَdِrāَw","root":"ورد"},{"id":5,"arabic":"فَأَدْلَىٰ","translit":"ٰàَlْdَaʾَf","root":"دلو"},{"id":6,"arabic":"دَلْوَهُۥ","translit":"ۥُhَwْlَd","root":"دلو"},{"id":7,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":8,"arabic":"يَٰبُشْرَىٰ","translit":"ٰàَrْhsُbَٰy","root":"بشر"},{"id":9,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":10,"arabic":"غُلَٰمٌ","translit":"ٌmَٰlُغ","root":"غلم"},{"id":11,"arabic":"وَأَسَرُّوهُ","translit":"ُhwُّrَsَaʾَw","root":"سرر"},{"id":12,"arabic":"بِضَٰعَةً","translit":"ًẗَʿعَٰḍِb","root":"بضع"},{"id":13,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":14,"arabic":"عَلِيمٌۢ","translit":"ٌۢmyِlَʿع","root":"علم"},{"id":15,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":16,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":false},{"ayah":20,"text":"وَشَرَوْهُ بِثَمَنٍۭ بَخْسٍ دَرَٰهِمَ مَعْدُودَةٍ وَكَانُوا۟ فِيهِ مِنَ ٱلزَّٰهِدِينَ ","translation":"And they sold him for a reduced price - a few dirhams - and they were, concerning him, of those content with little.","words":[{"id":1,"arabic":"وَشَرَوْهُ","translit":"ُhْwَrَhsَw","root":"شري"},{"id":2,"arabic":"بِثَمَنٍۭ","translit":"ٍۭnَmَhtِb","root":"ثمن"},{"id":3,"arabic":"بَخْسٍ","translit":"ٍsْhkَb","root":"بخس"},{"id":4,"arabic":"دَرَٰهِمَ","translit":"َmِhَٰrَd","root":"درهم"},{"id":5,"arabic":"مَعْدُودَةٍ","translit":"ٍẗَdwُdْʿعَm","root":"عدد"},{"id":6,"arabic":"وَكَانُوا۟","translit":"۟āwُnāَkَw","root":"كون"},{"id":7,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":8,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":9,"arabic":"ٱلزَّٰهِدِينَ","translit":"َnyِdِhَّٰzlٱ","root":"زهد"}],"hasIhya":true},{"ayah":21,"text":"وَقَالَ ٱلَّذِى ٱشْتَرَىٰهُ مِن مِّصْرَ لِٱمْرَأَتِهِۦٓ أَكْرِمِى مَثْوَىٰهُ عَسَىٰٓ أَن يَنفَعَنَآ أَوْ نَتَّخِذَهُۥ وَلَدًاۚ وَكَذَٰلِكَ مَكَّنَّا لِيُوسُفَ فِى ٱلْأَرْضِ وَلِنُعَلِّمَهُۥ مِن تَأْوِيلِ ٱلْأَحَادِيثِۚ وَٱللَّهُ غَالِبٌ عَلَىٰٓ أَمْرِهِۦ وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَعْلَمُونَ ","translation":"And the one from Egypt[1] who bought him said to his wife, \"Make his residence comfortable. Perhaps he will benefit us, or we will adopt him as a son.\" And thus, We established Joseph in the land that We might teach him the interpretation of events [i.e., dreams]. And Allāh is predominant over His affair, but most of the people do not know.","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"ٱشْتَرَىٰهُ","translit":"ُhٰàَrَtْhsٱ","root":"شري"},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"مِّصْرَ","translit":"َrْṣِّm","root":"مصر"},{"id":6,"arabic":"لِٱ