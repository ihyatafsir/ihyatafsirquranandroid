2, "ayah": 10, "text": "۞قَالَ قَآئِلࣱ مِّنْهُمْ لَا تَقْتُلُواْ يُوسُفَ وَأَلْقُوهُ فِے غَيَٰبَٰتِ اِ۬لْجُبِّ يَلْتَقِطْهُ بَعْضُ اُ۬لسَّيَّارَةِ إِن كُنتُمْ فَٰعِلِينَۖ", "words": [{"id": 1, "arabic": "۞قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَآئِلࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّنْهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "", "root": ""}, {"id": 5, "arabic": "تَقْتُلُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "يُوسُفَ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَأَلْقُوهُ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "غَيَٰبَٰتِ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لْجُبِّ", "translit": "", "root": ""}, {"id": 11, "arabic": "يَلْتَقِطْهُ", "translit": "", "root": ""}, {"id": 12, "arabic": "بَعْضُ", "translit": "", "root": ""}, {"id": 13, "arabic": "اُ۬لسَّيَّارَةِ", "translit": "", "root": ""}, {"id": 14, "arabic": "إِن", "translit": "", "root": ""}, {"id": 15, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 16, "arabic": "فَٰعِلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 11, "text": "قَالُواْ يَٰٓأَبَانَا مَا لَكَ لَا تَامَ۬نَّا عَلَيٰ يُوسُفَ وَإِنَّا لَهُۥ لَنَٰصِحُونَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰٓأَبَانَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "لَكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَا", "translit": "", "root": ""}, {"id": 6, "arabic": "تَامَ۬نَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "يُوسُفَ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَإِنَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 11, "arabic": "لَنَٰصِحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 12, "text": "أَرْسِلْهُ مَعَنَا غَداࣰ يَرْتَعِ وَيَلْعَبْ وَإِنَّا لَهُۥ لَحَٰفِظُونَۖ", "words": [{"id": 1, "arabic": "أَرْسِلْهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَعَنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "غَداࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَرْتَعِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَيَلْعَبْ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَإِنَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَحَٰفِظُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 13, "text": "قَالَ إِنِّے لَيُحْزِنُنِيَ أَن تَذْهَبُواْ بِهِۦ وَأَخَافُ أَنْ يَّاكُلَهُ اُ۬لذِّيبُ وَأَنتُمْ عَنْهُ غَٰفِلُونَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 3, "arabic": "لَيُحْزِنُنِيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "", "root": ""}, {"id": 5, "arabic": "تَذْهَبُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَأَخَافُ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 9, "arabic": "يَّاكُلَهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لذِّيبُ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَأَنتُمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "عَنْهُ", "translit": "", "root": ""}, {"id": 13, "arabic": "غَٰفِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 14, "text": "قَالُواْ لَئِنَ اَكَلَهُ اُ۬لذِّيبُ وَنَحْنُ عُصْبَةٌ اِنَّآ إِذاࣰ لَّخَٰسِرُونَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَئِنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَكَلَهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لذِّيبُ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَنَحْنُ", "translit": "", "root": ""}, {"id": 6, "arabic": "عُصْبَةٌ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِنَّآ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِذاࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَّخَٰسِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 15, "text": "فَلَمَّا ذَهَبُواْ بِهِۦ وَأَجْمَعُوٓاْ أَنْ يَّجْعَلُوهُ فِے غَيَٰبَٰتِ اِ۬لْجُبِّ وَأَوْحَيْنَآ إِلَيْهِ لَتُنَبِّئَنَّهُم بِأَمْرِهِمْ هَٰذَا وَهُمْ لَا يَشْعُرُونَۖ", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "ذَهَبُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَأَجْمَعُوٓاْ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَّجْعَلُوهُ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "غَيَٰبَٰتِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لْجُبِّ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَأَوْحَيْنَآ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِلَيْهِ", "translit": "", "root": ""}, {"id": 12, "arabic": "لَتُنَبِّئَنَّهُم", "translit": "", "root": ""}, {"id": 13, "arabic": "بِأَمْرِهِمْ", "translit": "", "root": ""}, {"id": 14, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 15, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 16, "arabic": "لَا", "translit": "", "root": ""}, {"id": 17, "arabic": "يَشْعُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 16, "text": "وَجَآءُوٓ أَبَاهُمْ عِشَآءࣰ يَبْكُونَ", "words": [{"id": 1, "arabic": "وَجَآءُوٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَبَاهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عِشَآءࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَبْكُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 17, "text": "قَالُواْ يَٰٓأَبَانَآ إِنَّا ذَهَبْنَا نَسْتَبِقُ وَتَرَكْنَا يُوسُفَ عِندَ مَتَٰعِنَا فَأَكَلَهُ اُ۬لذِّيبُۖ وَمَآ أَنتَ بِمُومِنࣲ لَّنَا وَلَوْ كُنَّا صَٰدِقِينَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰٓأَبَانَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "ذَهَبْنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "نَسْتَبِقُ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَتَرَكْنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "يُوسُفَ", "translit": "", "root": ""}, {"id": 8, "arabic": "عِندَ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَتَٰعِنَا", "translit": "", "root": ""}, {"id": 10, "arabic": "فَأَكَلَهُ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬لذِّيبُۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 13, "arabic": "أَنتَ", "translit": "", "root": ""}, {"id": 14, "arabic": "بِمُومِنࣲ", "translit": "", "root": ""}, {"id": 15, "arabic": "لَّنَا", "translit": "", "root": ""}, {"id": 16, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 17, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 18, "arabic": "صَٰدِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 18, "text": "وَجَآءُو عَلَيٰ قَمِيصِهِۦ بِدَمࣲ كَذِبࣲۖ قَالَ بَلْ سَوَّلَتْ لَكُمُۥٓ أَنفُسُكُمُۥٓ أَمْراࣰۖ فَصَبْرࣱ جَمِيلࣱۖ وَاللَّهُ اُ۬لْمُسْتَعَانُ عَلَيٰ مَا تَصِفُونَۖ", "words": [{"id": 1, "arabic": "وَجَآءُو", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَمِيصِهِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِدَمࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "كَذِبࣲۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 7, "arabic": "ب