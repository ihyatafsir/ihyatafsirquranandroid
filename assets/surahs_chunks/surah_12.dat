oot":""},{"id":17,"arabic":"ٱلْجَٰهِلِينَ","translit":"َnyِlِhَٰjgْlٱ","root":"جهل"}],"hasIhya":false},{"ayah":34,"text":"فَٱسْتَجَابَ لَهُۥ رَبُّهُۥ فَصَرَفَ عَنْهُ كَيْدَهُنَّۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ ","translation":"So his Lord responded to him and averted from him their plan. Indeed, He is the Hearing, the Knowing.","words":[{"id":1,"arabic":"فَٱسْتَجَابَ","translit":"َbāَjgَtْsٱَf","root":"جوب"},{"id":2,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":3,"arabic":"رَبُّهُۥ","translit":"ۥُhُّbَr","root":"ربب"},{"id":4,"arabic":"فَصَرَفَ","translit":"َfَrَṣَf","root":"صرف"},{"id":5,"arabic":"عَنْهُ","translit":"ُhْnَʿع","root":""},{"id":6,"arabic":"كَيْدَهُنَّ","translit":"َّnُhَdْyَk","root":"كيد"},{"id":7,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":8,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":9,"arabic":"ٱلسَّمِيعُ","translit":"ُʿعyِmَّslٱ","root":"سمع"},{"id":10,"arabic":"ٱلْعَلِيمُ","translit":"ُmyِlَʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":35,"text":"ثُمَّ بَدَا لَهُم مِّنۢ بَعْدِ مَا رَأَوُا۟ ٱلْءَايَٰتِ لَيَسْجُنُنَّهُۥ حَتَّىٰ حِينٍ ","translation":"Then it appeared to them after they had seen the signs[1] that he [i.e., al-ʿAzeez] should surely imprison him for a time.[2]","words":[{"id":1,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":2,"arabic":"بَدَا","translit":"āَdَb","root":"بدو"},{"id":3,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":4,"arabic":"مِّنۢ","translit":"ۢnِّm","root":""},{"id":5,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":6,"arabic":"مَا","translit":"āَm","root":""},{"id":7,"arabic":"رَأَوُا۟","translit":"۟āُwَaʾَr","root":"راي"},{"id":8,"arabic":"ٱلْءَايَٰتِ","translit":"ِtَٰyāَءْlٱ","root":"ايي"},{"id":9,"arabic":"لَيَسْجُنُنَّهُۥ","translit":"ۥُhَّnُnُjgْsَyَl","root":"سجن"},{"id":10,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":11,"arabic":"حِينٍ","translit":"ٍnyِḥ","root":"حين"}],"hasIhya":false},{"ayah":36,"text":"وَدَخَلَ مَعَهُ ٱلسِّجْنَ فَتَيَانِۖ قَالَ أَحَدُهُمَآ إِنِّىٓ أَرَىٰنِىٓ أَعْصِرُ خَمْرًاۖ وَقَالَ ٱلْءَاخَرُ إِنِّىٓ أَرَىٰنِىٓ أَحْمِلُ فَوْقَ رَأْسِى خُبْزًا تَأْكُلُ ٱلطَّيْرُ مِنْهُۖ نَبِّئْنَا بِتَأْوِيلِهِۦٓۖ إِنَّا نَرَىٰكَ مِنَ ٱلْمُحْسِنِينَ ","translation":"And there entered the prison with him two young men. One of them said, \"Indeed, I have seen myself [in a dream] pressing [grapes for] wine.\" The other said, \"Indeed, I have seen myself carrying upon my head [some] bread, from which the birds were eating. Inform us of its interpretation; indeed, we see you to be of those who do good.\"","words":[{"id":1,"arabic":"وَدَخَلَ","translit":"َlَhkَdَw","root":"دخل"},{"id":2,"arabic":"مَعَهُ","translit":"ُhَʿعَm","root":""},{"id":3,"arabic":"ٱلسِّجْنَ","translit":"َnْjgِّslٱ","root":"سجن"},{"id":4,"arabic":"فَتَيَانِ","translit":"ِnāَyَtَf","root":"فتي"},{"id":5,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":6,"arabic":"أَحَدُهُمَآ","translit":"ٓāَmُhُdَḥَaʾ","root":"احد"},{"id":7,"arabic":"إِنِّىٓ","translit":"ٓàِّnِiʾ","root":""},{"id":8,"arabic":"أَرَىٰنِىٓ","translit":"ٓàِnٰàَrَaʾ","root":"راي"},{"id":9,"arabic":"أَعْصِرُ","translit":"ُrِṣْʿعَaʾ","root":"عصر"},{"id":10,"arabic":"خَمْرًا","translit":"āًrْmَhk","root":"خمر"},{"id":11,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":12,"arabic":"ٱلْءَاخَرُ","translit":"ُrَhkāَءْlٱ","root":"اخر"},{"id":13,"arabic":"إِنِّىٓ","translit":"ٓàِّnِiʾ","root":""},{"id":14,"arabic":"أَرَىٰنِىٓ","translit":"ٓàِnٰàَrَaʾ","root":"راي"},{"id":15,"arabic":"أَحْمِلُ","translit":"ُlِmْḥَaʾ","root":"حمل"},{"id":16,"arabic":"فَوْقَ","translit":"َqْwَf","root":"فوق"},{"id":17,"arabic":"رَأْسِى","translit":"àِsْaʾَr","root":"راس"},{"id":18,"arabic":"خُبْزًا","translit":"āًzْbُhk","root":"خبز"},{"id":19,"arabic":"تَأْكُلُ","translit":"ُlُkْaʾَt","root":"اكل"},{"id":20,"arabic":"ٱلطَّيْرُ","translit":"ُrْyَّṭlٱ","root":"طير"},{"id":21,"arabic":"مِنْهُ","translit":"ُhْnِm","root":""},{"id":22,"arabic":"نَبِّئْنَا","translit":"āَnْyʾِّbَn","root":"نبا"},{"id":23,"arabic":"بِتَأْوِيلِهِۦٓ","translit":"ٓۦِhِlyِwْaʾَtِb","root":"اول"},{"id":24,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":25,"arabic":"نَرَىٰكَ","translit":"َkٰàَrَn","root":"راي"},{"id":26,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":27,"arabic":"ٱلْمُحْسِنِينَ","translit":"َnyِnِsْḥُmْlٱ","root":"حسن"}],"hasIhya":false},{"ayah":37,"text":"قَالَ لَا يَأْتِيكُمَا طَعَامٌ تُرْزَقَانِهِۦٓ إِلَّا نَبَّأْتُكُمَا بِتَأْوِيلِهِۦ قَبْلَ أَن يَأْتِيَكُمَاۚ ذَٰلِكُمَا مِمَّا عَلَّمَنِى رَبِّىٓۚ إِنِّى تَرَكْتُ مِلَّةَ قَوْمٍ لَّا يُؤْمِنُونَ بِٱللَّهِ وَهُم بِٱلْءَاخِرَةِ هُمْ كَٰفِرُونَ ","translation":"He said, \"You will not receive food that is provided to you except that I will inform you of its interpretation before it comes to you. That is from what my Lord has taught me. Indeed, I have left the religion of a people who do not believe in Allāh, and they, in the Hereafter, are disbelievers.","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"لَا","translit":"āَl","root":""},{"id":3,"arabic":"يَأْتِيكُمَا","translit":"āَmُkyِtْaʾَy","root":"اتي"},{"id":4,"arabic":"طَعَامٌ","translit":"ٌmāَʿعَṭ","root":"طعم"},{"id":5,"arabic":"تُرْزَقَانِهِۦٓ","translit":"ٓۦِhِnāَqَzْrُt","root":"رزق"},{"id":6,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":7,"arabic":"نَبَّأْتُكُمَا","translit":"āَmُkُtْaʾَّbَn","root":"نبا"},{"id":8,"arabic":"بِتَأْوِيلِهِۦ","translit":"ۦِhِlyِwْaʾَtِb","root":"اول"},{"id":9,"arabic":"قَبْلَ","translit":"َlْbَq","root":"قبل"},{"id":10,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":11,"arabic":"يَأْتِيَكُمَا","translit":"āَmُkَyِtْaʾَy","root":"اتي"},{"id":12,"arabic":"ذَٰلِكُمَا","translit":"āَmُkِlَٰhd","root":""},{"id":13,"arabic":"مِمَّا","translit":"āَّmِm","root":""},{"id":14,"arabic":"عَلَّمَنِى","translit":"àِnَmَّlَʿع","root":"علم"},{"id":15,"arabic":"رَبِّىٓ","translit":"ٓàِّbَr","root":"ربب"},{"id":16,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":17,"arabic":"تَرَكْتُ","translit":"ُtْkَrَt","root":"ترك"},{"id":18,"arabic":"مِلَّةَ","translit":"َẗَّlِm","root":"ملل"},{"id":19,"arabic":"قَوْمٍ","translit":"ٍmْwَq","root":"قوم"},{"id":20,"arabic":"لَّا","translit":"āَّl","root":""},{"id":21,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"},{"id":22,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":23,"arabic":"وَهُم","translit":"mُhَw","root":""},{"id":24,"arabic":"بِٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱِb","root":"اخر"},{"id":25,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":26,"arabic":"كَٰفِرُونَ","translit":"َnwُrِfَٰk","root":"كفر"}],"hasIhya":false},{"ayah":38,"text":"وَٱتَّبَعْتُ مِلَّةَ ءَابَآءِىٓ إِبْرَٰهِيمَ وَإِسْحَٰقَ وَيَعْقُوبَۚ مَا كَانَ لَنَآ أَن نُّشْرِكَ بِٱللَّهِ مِن شَىْءٍۚ ذَٰلِكَ مِن فَضْلِ ٱللَّهِ عَلَيْنَا وَعَلَى ٱلنَّاسِ وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَشْكُرُونَ ","translation":"And I have followed the religion of my fathers, Abraham, Isaac and Jacob. And it was not for us to associate anything with Allāh. That is from the favor of Allāh upon us and upon the people, but most of the people are not grateful.","words":[{"id":1,"arabic":"وَٱتَّبَعْتُ","translit":"ُtْʿعَbَّtٱَw","root":"تبع"},{"id":2,"arabic":"مِلَّةَ","translit":"َẗَّlِm","root":"ملل"},{"id":3,"arabic":"ءَابَآءِىٓ","translit":"ٓàِءٓāَbāَء","root":"ابو"},{"id":4,"arabic":"إِبْرَٰهِيمَ","translit":"َmyِhَٰrْbِiʾ","root":""},{"id":5,"arabic":"وَإِسْحَٰقَ","translit":"َqَٰḥْsِiʾَw","root":""},{"id":6,"arabic":"وَيَعْقُوبَ","translit":"َbwُqْʿعَyَw","root":""},{"id":7,"arabic":"مَا","translit":"āَm","root":""},{"id":8,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":9,"arabic":"لَنَآ","translit":"ٓāَnَl","root":""},{"id":10,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":11,"arabic":"نُّشْرِكَ","translit":"َkِrْhsُّn","root":"شرك"},{"id":12,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":13,"arabic":"مِن","translit":"nِm","root":""},{"id":14,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":15,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":16,"arabic":"مِن","translit":"nِm","root":""},{"id":17,"arabic":"فَضْلِ","translit":"ِlْḍَf","root":"فضل"},{"id":18,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":19,"arabic":"عَلَيْنَا","translit":"āَnْyَlَʿع","root":""},{"id":20,"arabic":"وَعَلَى","translit":"àَlَʿعَw","root":""},{"id":21,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":22,"arabic":"وَلَٰكِنَّ","translit":"َّnِkَٰlَw","root":""},{"id":23,"arabic":"أَكْثَرَ","translit":"َrَhtْkَaʾ","root":"كثر"},{"id":24,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":25,"arabic":"لَا","translit":"āَl","root":""},{"id":26,"arabic":"يَشْكُرُونَ","translit":"َnwُrُkْhsَy","root":"شكر"}],"hasIhya":false},{"ayah":39,"text":"يَٰصَىٰحِبَىِ ٱلسِّجْنِ ءَأَرْبَابٌ مُّتَفَرِّقُونَ خَيْرٌ أَمِ ٱللَّهُ ٱلْوَٰحِدُ ٱلْقَهَّارُ ","translation":"O [my] two companions of prison, are separate lords better or Allāh, the One,[1] the Prevailing?[2]","words":[{"id":1,"arabic":"يَٰصَىٰحِبَىِ","translit":"ِàَbِḥٰàَṣَٰy","root":"صحب"},{"id":2,"arabic":"ٱلسِّجْنِ","translit":"ِnْjgِّslٱ","root":"سجن"},{"id":3,"arabic":"ءَأَرْبَابٌ","translit":"ٌbāَbْrَaʾَء","root":"ربب"},{"id":4,"arabic":"مُّتَفَرِّقُونَ","translit":"َnwُqِّrَfَtُّm","root":"فرق"},{"id":5,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":6,"arabic":"أَمِ","translit":"ِmَaʾ","root":""},{"id":7,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":8,"arabic":"ٱلْوَٰحِدُ","translit":"ُdِḥَٰwْlٱ","root":"وحد"},{"id":9,"arabic":"ٱلْقَهَّارُ","translit":"ُrāَّhَqْlٱ","root":"قهر"}],"hasIhya":false},{"ayah":40,"text":"مَا تَعْبُدُونَ مِن دُونِهِۦٓ إِلَّآ أَسْمَآءً سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَٰنٍۚ إِنِ ٱلْحُكْمُ إِلَّا لِلَّهِۚ أَمَرَ أَلَّا تَعْبُدُوٓا۟ إِلَّآ إِيَّاهُۚ ذَٰلِكَ ٱلدِّينُ ٱلْقَيِّمُ وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَعْلَمُونَ ","translation":"You worship not besides Him except [mere] names you have named them,[1] you and your fathers, for which Allāh has sent down no evidence. Legislation is not but for Allāh. He has commanded that you worship not except Him. That is the correct religion, but most of the people do not know.","words":[{"id":1,"arabic":"مَا","translit":"āَm","root":""},{"id":2,"arabic":"تَعْبُدُونَ","translit":"َnwُdُbْʿعَt","root":"عبد"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"دُونِهِۦٓ","translit":"ٓۦِhِnwُd","root":"دون"},{"id":5,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":6,"arabic":"أَسْمَآءً","translit":"ًءٓāَmْsَaʾ","root":"سمو"},{"id":7,"arabic":"سَمَّيْتُمُوهَآ","translit":"ٓāَhwُmُtْyَّmَs","root":"سمو"},{"id":8,"arabic":"أَنتُمْ","translit":"ْmُtnَaʾ","root":""},{"id":9,"arabic":"وَءَابَآؤُكُم","translit":"mُkُwʾٓāَbāَءَw","root":"ابو"},{"id":10,"arabic":"مَّآ","translit":"ٓāَّm","root":""},{"id":11,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":12,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":13,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":14,"arabic":"مِن","translit":"nِm","root":""},{"id":15,"arabic":"سُلْطَٰنٍ","translit":"ٍnَٰṭْlُs","root":"سلط"},{"id":16,"arabic":"إِنِ","translit":"ِnِiʾ","root":""},{"id":17,"arabic":"ٱلْحُكْمُ","translit":"ُmْkُḥْlٱ","root":"حكم"},{"id":18,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":19,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":20,"arabic":"أَمَرَ","translit":"َrَmَaʾ","root":"امر"},{"id":21,"arabic":"أَلَّا","translit":"āَّlَaʾ","root":""},{"id":22,"arabic":"تَعْبُدُوٓا۟","translit":"۟āٓwُdُbْʿعَt","root":"عبد"},{"id":23,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":24,"arabic":"إِيَّاهُ","translit":"ُhāَّyِiʾ","root":""},{"id":25,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":26,"arabic":"ٱلدِّينُ","translit":"ُnyِّdlٱ","root":"دين"},{"id":27,"arabic":"ٱلْقَيِّمُ","translit":"ُmِّyَqْlٱ","root":"قوم"},{"id":28,"arabic":"وَلَٰكِنَّ","translit":"َّnِkَٰlَw","root":""},{"id":29,"arabic":"أَكْثَرَ","translit":"َrَhtْkَaʾ","root":"كثر"},{"id":30,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":31,"arabic":"لَا","translit":"āَl","root":""},{"id":32,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":false},{"ayah":41,"text":"يَٰصَىٰحِبَىِ ٱلسِّجْنِ أَمَّآ أَحَدُكُمَا فَيَسْقِى رَبَّهُۥ خَمْرًاۖ وَأَمَّا ٱلْءَاخَرُ فَيُصْلَبُ فَتَأْكُلُ ٱلطَّيْرُ مِن رَّأْسِهِۦۚ قُضِىَ ٱلْأَمْرُ ٱلَّذِى فِيهِ تَسْتَفْتِيَانِ ","translation":"O two companions of prison, as for one of you, he will give drink to his master of wine; but as for the other, he will be crucified, and the birds will eat from his head. The matter has been decreed about which you both inquire.\"","words":[{"id":1,"arabic":"يَٰصَىٰحِبَىِ","translit":"ِàَbِḥٰàَṣَٰy","root":"صحب"},{"id":2,"arabic":"ٱلسِّجْنِ","translit":"ِnْjgِّslٱ","root":"سجن"},{"id":3,"arabic":"أَمَّآ","translit":"ٓāَّmَaʾ","root":""},{"id":4,"arabic":"أَحَدُكُمَا","translit":"āَmُkُdَḥَaʾ","root":"احد"},{"id":5,"arabic":"فَيَسْقِى","translit":"àِqْsَyَf","root":"سقي"},{"id":6,"arabic":"رَبَّهُۥ","translit":"ۥُhَّbَr","root":"ربب"},{"id":7,"arabic":"خَمْرًا","translit":"āًrْmَhk","root":"خمر"},{"id":8,"arabic":"وَأَمَّا","translit":"āَّmَaʾَw","root":""},{"id":9,"arabic":"ٱلْءَاخَرُ","translit":"ُrَhkāَءْlٱ","root":"اخر"},{"id":10,"arabic":"فَيُصْلَبُ","translit":"ُbَlْṣُyَf","root":"صلب"},{"id":11,"arabic":"فَتَأْكُلُ","translit":"ُlُkْaʾَtَf","root":"اكل"},{"id":12,"arabic":"ٱلطَّيْرُ","translit":"ُrْyَّṭlٱ","root":"طير"},{"id":13,"arabic":"مِن","translit":"nِm","root":""},{"id":14,"arabic":"رَّأْسِهِۦ","translit":"ۦِhِsْaʾَّr","root":"راس"},{"id":15,"arabic":"قُضِىَ","translit":"َàِḍُq","root":"قضي"},{"id":16,"arabic":"ٱلْأَمْرُ","translit":"ُrْmَaʾْlٱ","root":"امر"},{"id":17,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":18,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":19,"arabic":"تَسْتَفْتِيَانِ","translit":"ِnāَyِtْfَtْsَt","root":"فتي"}],"hasIhya":false},{"ayah":42,"text":"وَقَالَ لِلَّذِى ظَنَّ أَنَّهُۥ نَاجٍ مِّنْهُمَا ٱذْكُرْنِى عِندَ رَبِّكَ فَأَنسَىٰهُ ٱلشَّيْطَٰنُ ذِكْرَ رَبِّهِۦ فَلَبِثَ فِى ٱلسِّجْنِ بِضْعَ سِنِينَ ","translation":"And he said to the one whom he knew would go free, \"Mention me before your master.\" But Satan made him forget the mention [to] his master, and he [i.e., Joseph] remained in prison several years.","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"لِلَّذِى","translit":"àِhdَّlِl","root":""},{"id":3,"arabic":"ظَنَّ","translit":"َّnَẓ","root":"ظنن"},{"id":4,"arabic":"أَنَّهُۥ","translit":"ۥُhَّnَaʾ","root":""},{"id":5,"arabic":"نَاجٍ","translit":"ٍjgāَn","root":"نجو"},{"id":6,"arabic":"مِّنْهُمَا","translit":"āَmُhْnِّm","root":""},{"id":7,"arabic":"ٱذْكُرْنِى","translit":"àِnْrُkْhdٱ","root":"ذكر"},{"id":8,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":9,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":10,"arabic":"فَأَنسَىٰهُ","translit":"ُhٰàَsnَaʾَf","root":"نسي"},{"id":11,"arabic":"ٱلشَّيْطَٰنُ","translit":"ُnَٰṭْyَّhslٱ","root":"شطن"},{"id":12,"arabic":"ذِكْرَ","translit":"َrْkِhd","root":"ذكر"},{"id":13,"arabic":"رَبِّهِۦ","translit":"ۦِhِّbَr","root":"ربب"},{"id":14,"arabic":"فَلَبِثَ","translit":"َhtِbَlَf","root":"لبث"},{"id":15,"arabic":"فِى","translit":"àِf","root":""},{"id":16,"arabic":"ٱلسِّجْنِ","translit":"ِnْjgِّslٱ","root":"سجن"},{"id":17,"arabic":"بِضْعَ","translit":"َʿعْḍِb","root":"بضع"},{"id":18,"arabic":"سِنِينَ","translit":"َnyِnِs","root":"سنو"}],"hasIhya":false},{"ayah":43,"text":"وَقَالَ ٱلْمَلِكُ إِنِّىٓ أَرَىٰ سَبْعَ بَقَرَٰتٍ سِمَانٍ يَأْكُلُهُنَّ سَبْعٌ عِجَافٌ وَسَبْعَ سُنۢبُلَٰتٍ خُضْرٍ وَأُخَرَ يَابِسَٰتٍۖ يَٰٓأَيُّهَا ٱلْمَلَأُ أَفْتُونِى فِى رُءْيَٰىَ إِن كُنتُمْ لِلرُّءْيَا تَعْبُرُونَ ","translation":"And [subsequently] the king said, \"Indeed, I have seen [in a dream] seven fat cows being eaten by seven [that were] lean, and seven green spikes [of grain] and others [that were] dry. O eminent ones, explain to me my vision, if you should interpret visions.\"","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"ٱلْمَلِكُ","translit":"ُkِlَmْlٱ","root":"ملك"},{"id":3,"arabic":"إِنِّىٓ","translit":"ٓàِّnِiʾ","root":""},{"id":4,"arabic":"أَرَىٰ","translit":"ٰàَrَaʾ","root":"راي"},{"id":5,"arabic":"سَبْعَ","translit":"َʿعْbَs","root":"سبع"},{"id":6,"arabic":"بَقَرَٰتٍ","translit":"ٍtَٰrَqَb","root":"بقر"},{"id":7,"arabic":"سِمَانٍ","translit":"ٍnāَmِs","root":"سمن"},{"id":8,"arabic":"يَأْكُلُهُنَّ","translit":"َّnُhُlُkْaʾَy","root":"اكل"},{"id":9,"arabic":"سَبْعٌ","translit":"ٌʿعْbَs","root":"سبع"},{"id":10,"arabic":"عِجَافٌ","translit":"ٌfāَjgِʿع","root":"عجف"},{"id":11,"arabic":"وَسَبْعَ","translit":"َʿعْbَsَw","root":"سبع"},{"id":12,"arabic":"سُنۢبُلَٰتٍ","translit":"ٍtَٰlُbۢnُs","root":"سنبل"},{"id":13,"arabic":"خُضْرٍ","translit":"ٍrْḍُhk","root":"خضر"},{"id":14,"arabic":"وَأُخَرَ","translit":"َrَhkُaʾَw","root":"اخر"},{"id":15,"arabic":"يَابِسَٰتٍ","translit":"ٍtَٰsِbāَy","root":"يبس"},{"id":16,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":17,"arabic":"ٱلْمَلَأُ","translit":"ُaʾَlَmْlٱ","root":"ملا"},{"id":18,"arabic":"أَفْتُونِى","translit":"àِnwُtْfَaʾ","root":"فتي"},{"id":19,"arabic":"فِى","translit":"àِf","root":""},{"id":20,"arabic":"رُءْيَٰىَ","translit":"َàَٰyْءُr","root":"راي"},{"id":21,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":22,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":23,"arabic":"لِلرُّءْيَا","translit":"āَyْءُّrlِl","root":"راي"},{"id":24,"arabic":"تَعْبُرُونَ","translit":"َnwُrُbْʿعَt","root":"عبر"}],"hasIhya":false},{"ayah":44,"text":"قَالُوٓا۟ أَضْغَٰثُ أَحْلَٰمٍۖ وَمَا نَحْنُ بِتَأْوِيلِ ٱلْأَحْلَٰمِ بِعَٰلِمِينَ ","translation":"They said, \"[It is but] a mixture of false dreams, and we are not learned in the interpretation of dreams.\"","words":[{"id":1,"arabic":"قَالُوٓا۟","translit":"۟āٓwُ