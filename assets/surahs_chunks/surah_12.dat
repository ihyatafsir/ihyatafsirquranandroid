6]], "21": [[1, 400, 1637], [2, 1637, 2723], [3, 2723, 4311], [4, 4311, 4778], [5, 4778, 5887], [6, 5887, 7717], [7, 7717, 9048], [8, 9048, 10659], [9, 10659, 12107], [10, 12107, 12621], [11, 12621, 14923], [12, 14923, 15553], [13, 15553, 16919], [14, 16919, 18110], [15, 18110, 19572], [16, 19572, 21160], [17, 21160, 22584], [18, 22584, 23168], [19, 23168, 24289], [20, 24289, 26239], [21, 26239, 26706], [22, 26706, 28154], [23, 28154, 30209], [24, 30209, 31481], [25, 31481, 32578], [26, 32578, 34002], [27, 34002, 34959], [28, 34959, 36488], [29, 36488, 37492], [30, 37492, 38998], [31, 38998, 39605], [32, 39605, 41284]], "22": [[1, 400, 2122], [2, 2122, 2937], [3, 2937, 4644], [4, 4644, 6590], [5, 6590, 7826], [6, 7826, 9483], [7, 9483, 11129], [8, 11129, 12378], [9, 12378, 14482]], "23": [[1, 400, 2090], [2, 2090, 3115], [3, 3115, 3656], [4, 3656, 4219], [5, 4219, 5571], [6, 5571, 6067], [7, 6067, 7295], [8, 7295, 8771], [9, 8771, 10382], [10, 10382, 11801], [11, 11801, 12567], [12, 12567, 13018], [13, 13018, 13874], [14, 13874, 14978], [15, 14978, 15868], [16, 15868, 16893], [17, 16893, 18391], [18, 18391, 19382], [19, 19382, 20891], [20, 20891, 21916], [21, 21916, 22502], [22, 22502, 23538], [23, 23538, 25663]], "24": [[1, 400, 1675], [2, 1675, 2795], [3, 2795, 3284], [4, 3284, 4533], [5, 4533, 5435], [6, 5435, 7408], [7, 7408, 7975], [8, 7975, 9044], [9, 9044, 10188], [10, 10188, 11128], [11, 11128, 12354], [12, 12354, 13719], [13, 13719, 14518], [14, 14518, 16559], [15, 16559, 19408], [16, 19408, 20580], [17, 20580, 21095], [18, 21095, 23001], [19, 23001, 25114]], "25": [[1, 400, 2089], [2, 2089, 3164], [3, 3164, 4359], [4, 4359, 5653], [5, 5653, 6092], [6, 6092, 6750], [7, 6750, 8460], [8, 8460, 10044], [9, 10044, 10833], [10, 10833, 11908], [11, 11908, 12961], [12, 12961, 13531], [13, 13531, 15057], [14, 15057, 15496], [15, 15496, 16549], [16, 16549, 17667], [17, 17667, 19290], [18, 19290, 20849], [19, 20849, 21331], [20, 21331, 22340], [21, 22340, 22932], [22