8, 3534], [3, 3534, 4552], [4, 4552, 5291], [5, 5291, 7219], [6, 7219, 8596], [7, 8596, 10413], [8, 10413, 10932], [9, 10932, 12136], [10, 12136, 12954], [11, 12954, 14576], [12, 14576, 15275], [13, 15275, 17665], [14, 17665, 18104], [15, 18104, 18902], [16, 18902, 20390]], "11": [[1, 1180, 2987], [2, 2987, 5842], [3, 5842, 6510], [4, 6510, 6871], [5, 6871, 7539], [6, 7539, 9002], [7, 9002, 9929], [8, 9929, 11176], [9, 11176, 12712], [10, 12712, 13055], [11, 13055, 14600]], "12:11": [[1, 1180, 2987], [2, 2987, 5842], [3, 5842, 6510], [4, 6510, 6871], [5, 6871, 7539], [6, 7539, 9002], [7, 9002, 9929], [8, 9929, 11176], [9, 11176, 12712], [10, 12712, 13055], [11, 13055, 14600]], "12": [[1, 600, 1699], [2, 1699, 2956], [3, 2956, 3981], [4, 3981, 5175], [5, 5175, 6939], [6, 6939, 8735], [7, 8735, 9136], [8, 9136, 10960]], "12:12": [[1, 600, 1699], [2, 1699, 2956], [3, 2956, 3981], [4, 3981, 5175], [5, 5175, 6939], [6, 6939, 8735], [7, 8735, 9136], [8, 9136, 10960]], "13": [[1, 620, 1730], [2, 1730, 2863], [3, 2863, 6193], [4, 6193, 6691], [5, 6691, 8752], [6, 8752, 9182], [7, 9182, 11096], [8, 11096, 11594], [9, 11594, 13066], [10, 13066, 14329], [11, 14329, 15824], [12, 15824, 16538], [13, 16538, 18230]], "12:13": [[1, 620, 1730], [2, 1730, 2863], [3, 2863, 6193], [4, 6193, 6691], [5, 6691, 8752], [6, 8752, 9182], [7, 9182, 11096], [8, 11096, 11594], [9, 11594, 13066], [10, 13066, 14329], [11, 14329, 15824], [12, 15824, 16538], [13, 16538, 18230]], "14": [[1, 1080, 3097], [2, 3097, 3763], [3, 3763, 4590], [4, 4590, 5715], [5, 5715, 6824], [6, 6824, 7691], [7, 7691, 10011], [8, 10011, 11020], [9, 11020, 12900]], "12:14": [[1, 1080, 3097], [2, 3097, 3763], [3, 3763, 4590], [4, 4590, 5715], [5, 5715, 6824], [6, 6824, 7691], [7, 7691, 10011], [8, 10011, 11020], [9, 11020, 12900]], "15": [[1, 1240, 2751], [2, 2751, 4525], [3, 4525, 4941], [4, 4941, 8675], [5, 8675, 9157], [6, 9157, 11183], [7, 11183, 11752], [8, 11752, 13073], [9, 13073, 13971], [10, 13971, 17695], [11, 176