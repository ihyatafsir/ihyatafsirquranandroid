ey will know [about you].\"","words":[{"id":1,"arabic":"يُوسُفُ","translit":"ُfُswُy","root":""},{"id":2,"arabic":"أَيُّهَا","translit":"āَhُّyَaʾ","root":"ايي"},{"id":3,"arabic":"ٱلصِّدِّيقُ","translit":"ُqyِّdِّṣlٱ","root":"صدق"},{"id":4,"arabic":"أَفْتِنَا","translit":"āَnِtْfَaʾ","root":"فتي"},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"سَبْعِ","translit":"ِʿعْbَs","root":"سبع"},{"id":7,"arabic":"بَقَرَٰتٍ","translit":"ٍtَٰrَqَb","root":"بقر"},{"id":8,"arabic":"سِمَانٍ","translit":"ٍnāَmِs","root":"سمن"},{"id":9,"arabic":"يَأْكُلُهُنَّ","translit":"َّnُhُlُkْaʾَy","root":"اكل"},{"id":10,"arabic":"سَبْعٌ","translit":"ٌʿعْbَs","root":"سبع"},{"id":11,"arabic":"عِجَافٌ","translit":"ٌfāَjgِʿع","root":"عجف"},{"id":12,"arabic":"وَسَبْعِ","translit":"ِʿعْbَsَw","root":"سبع"},{"id":13,"arabic":"سُنۢبُلَٰتٍ","translit":"ٍtَٰlُbۢnُs","root":"سنبل"},{"id":14,"arabic":"خُضْرٍ","translit":"ٍrْḍُhk","root":"خضر"},{"id":15,"arabic":"وَأُخَرَ","translit":"َrَhkُaʾَw","root":"اخر"},{"id":16,"arabic":"يَابِسَٰتٍ","translit":"ٍtَٰsِbāَy","root":"يبس"},{"id":17,"arabic":"لَّعَلِّىٓ","translit":"ٓàِّlَʿعَّl","root":""},{"id":18,"arabic":"أَرْجِعُ","translit":"ُʿعِjgْrَaʾ","root":"رجع"},{"id":19,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":20,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":21,"arabic":"لَعَلَّهُمْ","translit":"ْmُhَّlَʿعَl","root":""},{"id":22,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":false},{"ayah":47,"text":"قَالَ تَزْرَعُونَ سَبْعَ سِنِينَ دَأَبًا فَمَا حَصَدتُّمْ فَذَرُوهُ فِى سُنۢبُلِهِۦٓ إِلَّا قَلِيلًا مِّمَّا تَأْكُلُونَ ","translation":"[Joseph] said, \"You will plant for seven years consecutively; and what you harvest leave in its spikes, except a little from which you will eat.","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"تَزْرَعُونَ","translit":"َnwُʿعَrْzَt","root":"زرع"},{"id":3,"arabic":"سَبْعَ","translit":"َʿعْbَs","root":"سبع"},{"id