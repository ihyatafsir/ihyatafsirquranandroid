2, "ayah": 2, "text": "إِنَّآ أَنزَلْنَٰهُ قُرْءَٰناً عَرَبِيّاࣰ لَّعَلَّكُمْ تَعْقِلُونَۖ", "words": [{"id": 1, "arabic": "إِنَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَنزَلْنَٰهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "قُرْءَٰناً", "translit": "", "root": ""}, {"id": 4, "arabic": "عَرَبِيّاࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّعَلَّكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "تَعْقِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 3, "text": "نَحْنُ نَقُصُّ عَلَيْكَ أَحْسَنَ اَ۬لْقَصَصِ بِمَآ أَوْحَيْنَآ إِلَيْكَ هَٰذَا اَ۬لْقُرْءَانَ وَإِن كُنتَ مِن قَبْلِهِۦ لَمِنَ اَ۬لْغَٰفِلِينَۖ", "words": [{"id": 1, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَقُصُّ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَحْسَنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْقَصَصِ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِمَآ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَوْحَيْنَآ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِلَيْكَ", "translit": "", "root": ""}, {"id": 9, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لْقُرْءَانَ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَإِن", "translit": "", "root": ""}, {"id": 12, "arabic": "كُنتَ", "translit": "", "root": ""}, {"id": 13, "arabic": "مِن", "translit": "", "root": ""}, {"id": 14, "arabic": "قَبْلِهِۦ", "translit": "", "root": ""}, {"id": 15, "arabic": "لَمِنَ", "translit": "", "root": ""}, {"id": 16, "arabic": "اَ۬لْغَٰفِلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 4, "text": "إِذْ قَالَ يُوسُفُ لِأَبِيهِ يَٰٓأَبَتِ إِنِّے رَأَيْتُ أَحَدَ عَشَرَ كَوْكَباࣰ وَالشَّمْسَ وَالْقَمَرَۖ رَأَيْتُهُمْ لِے سَٰجِدِينَۖ", "words": [{"id": 1, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يُوسُفُ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِأَبِيهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَٰٓأَبَتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 7, "arabic": "رَأَيْتُ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَحَدَ", "translit": "", "root": ""}, {"id": 9, "arabic": "عَشَرَ", "translit": "", "root": ""}, {"id": 10, "arabic": "كَوْكَباࣰ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَالشَّمْسَ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَالْقَمَرَۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "رَأَيْتُهُمْ", "translit": "", "root": ""}, {"id": 14, "arabic": "لِے", "translit": "", "root": ""}, {"id": 15, "arabic": "سَٰجِدِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 5, "text": "قَالَ يَٰبُنَيِّ لَا تَقْصُصْ رُءْي۪اكَ عَلَيٰٓ إِخْوَتِكَ فَيَكِيدُواْ لَكَ كَيْداًۖ اِنَّ اَ۬لشَّيْطَٰنَ لِلِانسَٰنِ عَدُوࣱّ مُّبِينࣱۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰبُنَيِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "", "root": ""}, {"id": 4, "arabic": "تَقْصُصْ", "translit": "", "root": ""}, {"id": 5, "arabic": "رُءْي۪اكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِخْوَتِكَ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَيَكِيدُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَكَ", "translit": "", "root": ""}, {"id": 10, "arabic": "كَيْداًۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬لشَّيْطَٰنَ", "translit": "", "root": ""}, {"id": 13, "arabic": "لِلِانسَٰنِ", "translit": "", "root": ""}, {"id": 14, "arabic": "عَدُوࣱّ", "translit": "", "root": ""}, {"id": 15, "arabic": "مُّبِينࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 6, "text": "وَكَذَٰلِكَ يَجْتَبِيكَ رَبُّكَ وَيُعَلِّمُكَ مِن تَاوِيلِ اِ۬لَاحَادِيثِۖ وَيُتِمُّ نِعْمَتَهُۥ عَلَيْكَ وَعَلَيٰٓ ءَالِ يَعْقُوبَ كَمَآ أَتَمَّهَا عَلَيٰٓ أَبَوَيْكَ مِن قَبْلُ إِبْرَٰهِيمَ وَإِسْحَٰقَۖ إِنَّ رَبَّكَ عَلِيمٌ حَكِيمࣱۖ", "words": [{"id": 1, "arabic": "وَكَذَٰلِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَجْتَبِيكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبُّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَيُعَلِّمُكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "تَاوِيلِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لَاحَادِيثِۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَيُتِمُّ", "translit": "", "root": ""}, {"id": 9, "arabic": "نِعْمَتَهُۥ", "translit": "", "root": ""}, {"id": 10, "arabic": "عَلَيْكَ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَعَلَيٰٓ", "translit": "", "root": ""}, {"id": 12, "arabic": "ءَالِ", "translit": "", "root": ""}, {"id": 13, "arabic": "يَعْقُوبَ", "translit": "", "root": ""}, {"id": 14, "arabic": "كَمَآ", "translit": "", "root": ""}, {"id": 15, "arabic": "أَتَمَّهَا", "translit": "", "root": ""}, {"id": 16, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 17, "arabic": "أَبَوَيْكَ", "translit": "", "root": ""}, {"id": 18, "arabic": "مِن", "translit": "", "root": ""}, {"id": 19, "arabic": "قَبْلُ", "translit": "", "root": ""}, {"id": 20, "arabic": "إِبْرَٰهِيمَ", "translit": "", "root": ""}, {"id": 21, "arabic": "وَإِسْحَٰقَۖ", "translit": "", "root": ""}, {"id": 22, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 23, "arabic": "رَبَّكَ", "translit": "", "root": ""}, {"id": 24, "arabic": "عَلِيمٌ", "translit": "", "root": ""}, {"id": 25, "arabic": "حَكِيمࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 12, "ayah": 7, "text": "لَّقَدْ كَانَ فِے يُوسُفَ وَإِخْوَتِهِۦٓ ءَايَٰتࣱ لِّلسَّآئِلِينَۖ", "words": [{"id": 1, "arabic": "ل