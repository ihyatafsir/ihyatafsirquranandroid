"يَٰٓأَبَانَا","translit":"āَnāَbَaʾَٰٓy","root":"ابو"},{"id":3,"arabic":"ٱسْتَغْفِرْ","translit":"ْrِfْغَtْsٱ","root":"غفر"},{"id":4,"arabic":"لَنَا","translit":"āَnَl","root":""},{"id":5,"arabic":"ذُنُوبَنَآ","translit":"ٓāَnَbwُnُhd","root":"ذنب"},{"id":6,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":7,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":8,"arabic":"خَٰطِـِٔينَ","translit":"َnyِٔـِṭَٰhk","root":"خطا"}],"hasIhya":false},{"ayah":98,"text":"قَالَ سَوْفَ أَسْتَغْفِرُ لَكُمْ رَبِّىٓۖ إِنَّهُۥ هُوَ ٱلْغَفُورُ ٱلرَّحِيمُ ","translation":"He said, \"I will ask forgiveness for you from my Lord. Indeed, it is He who is the Forgiving, the Merciful.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"سَوْفَ","translit":"َfْwَs","root":""},{"id":3,"arabic":"أَسْتَغْفِرُ","translit":"ُrِfْغَtْsَaʾ","root":"غفر"},{"id":4,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":5,"arabic":"رَبِّىٓ","translit":"ٓàِّbَr","root":"ربب"},{"id":6,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":7,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":8,"arabic":"ٱلْغَفُورُ","translit":"ُrwُfَغْlٱ","root":"غفر"},{"id":9,"arabic":"ٱلرَّحِيمُ","translit":"ُmyِḥَّrlٱ","root":"رحم"}],"hasIhya":true},{"ayah":99,"text":"فَلَمَّا دَخَلُوا۟ عَلَىٰ يُوسُفَ ءَاوَىٰٓ إِلَيْهِ أَبَوَيْهِ وَقَالَ ٱدْخُلُوا۟ مِصْرَ إِن شَآءَ ٱللَّهُ ءَامِنِينَ ","translation":"And when they entered upon Joseph, he took his parents to himself [i.e., embraced them] and said, \"Enter Egypt, Allāh willing, safe [and secure].\"","words":[{"id":1,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":2,"arabic":"دَخَلُوا۟","translit":"۟āwُlَhkَd","root":"دخل"},{"id":3,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":4,"arabic":"يُوسُفَ","translit":"َfُswُy","root":""},{"id":5,"arabic":"ءَاوَىٰٓ","translit":"ٰٓàَwāَء","root":"اوي"},{"id":6,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":7,"arabic":"أَبَوَيْهِ","translit":"ِhْyَwَbَaʾ","root":"ابو"},{"id":8,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":9,"arabic":"ٱدْخُلُوا۟","translit":"۟āwُlُhkْdٱ","root":"دخل"},{"id":10,"arabic":"مِصْرَ","translit":"َrْṣِm","root":"مصر"},{"id":11,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":12,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":13,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":14,"arabic":"ءَامِنِينَ","translit":"َnyِnِmāَء","root":"امن"}],"hasIhya":false},{"ayah":100,"text":"وَرَفَعَ أَبَوَيْهِ عَلَى ٱلْعَرْشِ وَخَرُّوا۟ لَهُۥ سُجَّدًاۖ وَقَالَ يَٰٓأَبَتِ هَٰذَا تَأْوِيلُ رُءْيَٰىَ مِن قَبْلُ قَدْ جَعَلَهَا رَبِّى حَقًّاۖ وَقَدْ أَحْسَنَ بِىٓ إِذْ أَخْرَجَنِى مِنَ ٱلسِّجْنِ وَجَآءَ بِكُم مِّنَ ٱلْبَدْوِ مِنۢ بَعْدِ أَن نَّزَغَ ٱلشَّيْطَٰنُ بَيْنِى وَبَيْنَ إِخْوَتِىٓۚ إِنَّ رَبِّى لَطِيفٌ لِّمَا يَشَآءُۚ إِنَّهُۥ هُوَ ٱلْعَلِيمُ ٱلْحَكِيمُ ","translation":"And he raised his parents upon the throne, and they bowed to him in prostration.[1] And he said, \"O my father, this is the explanation of my vision of before. My Lord has made it reality. And He was certainly good to me when He took me out of prison and brought you [here] from bedouin life after Satan had induced [estrangement] between me and my brothers. Indeed, my Lord is Subtle[2] in what He wills. Indeed, it is He who is the Knowing, the Wise.","words":[{"id":1,"arabic":"وَرَفَعَ","translit":"َʿعَfَrَw","root":"رفع"},{"id":2,"arabic":"أَبَوَيْهِ","translit":"ِhْyَwَbَaʾ","root":"ابو"},{"id":3,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":4,"arabic":"ٱلْعَرْشِ","translit":"ِhsْrَʿعْlٱ","root":"عرش"},{"id":5,"arabic":"وَخَرُّوا۟","translit":"۟āwُّrَhkَw","root":"خرر"},{"id":6,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":7,"arabic":"سُجَّدًا","translit":"āًdَّjgُs","root":"سجد"},{"id":8,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":9,"arabic":"يَٰٓأَبَتِ","translit":"ِtَbَaʾَٰٓy","root":"ابو"},{"id":10,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":11,