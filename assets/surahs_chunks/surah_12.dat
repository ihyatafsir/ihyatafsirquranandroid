يُوسُفُ وَأَخُوهُ أَحَبُّ إِلَىٰٓ أَبِينَا مِنَّا وَنَحْنُ عُصْبَةٌ إِنَّ أَبَانَا لَفِى ضَلَٰلٍ مُّبِينٍ ","translation":"When they said, \"Joseph and his brother[1] are more beloved to our father than we, while we are a clan. Indeed, our father is in clear error.","words":[{"id":1,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":2,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":3,"arabic":"لَيُوسُفُ","translit":"ُfُswُyَl","root":""},{"id":4,"arabic":"وَأَخُوهُ","translit":"ُhwُhkَaʾَw","root":"اخو"},{"id":5,"arabic":"أَحَبُّ","translit":"ُّbَḥَaʾ","root":"حبب"},{"id":6,"arabic":"إِلَىٰٓ","translit":"ٰٓàَlِiʾ","root":""},{"id":7,"arabic":"أَبِينَا","translit":"āَnyِbَaʾ","root":"ابو"},{"id":8,"arabic":"مِنَّا","translit":"āَّnِm","root":""},{"id":9,"arabic":"وَنَحْنُ","translit":"ُnْḥَnَw","root":""},{"id":10,"arabic":"عُصْبَةٌ","translit":"ٌẗَbْṣُʿع","root":"عصب"},{"id":11,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":12,"arabic":"أَبَانَا","translit":"āَnāَbَaʾ","root":"ابو"},{"id":13,"arabic":"لَفِى","translit":"àِfَl","root":""},{"id":14,"arabic":"ضَلَٰلٍ","translit":"ٍlَٰlَḍ","root":"ضلل"},{"id":15,"arabic":"مُّبِينٍ","translit":"ٍnyِbُّm","root":"بين"}],"hasIhya":true},{"ayah":9,"text":"ٱقْتُلُوا۟ يُوسُفَ أَوِ ٱطْرَحُوهُ أَرْضًا يَخْلُ لَكُمْ وَجْهُ أَبِيكُمْ وَتَكُونُوا۟ مِنۢ بَعْدِهِۦ قَوْمًا صَٰلِحِينَ ","translation":"Kill Joseph or cast him out to [another] land; the countenance [i.e., attention] of your father will [then] be only for you, and you will be after that a righteous people.\"[1]","words":[{"id":1,"arabic":"ٱقْتُلُوا۟","translit":"۟āwُlُtْqٱ","root":"قتل"},{"id":2,"arabic":"يُوسُفَ","translit":"َfُswُy","root":""},{"id":3,"arabic":"أَوِ","translit":"ِwَaʾ","root":""},{"id":4,"arabic":"ٱطْرَحُوهُ","translit":"ُhwُḥَrْṭٱ","root":"طرح"},{"id":5,"arabic":"أَرْضًا","translit":"āًḍْrَaʾ","root":"ارض"},{"id":6,"arabic":"يَخْلُ","translit":"ُlْhkَy","root":"خلو"},{"id":7,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id"