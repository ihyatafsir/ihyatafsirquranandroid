 "warsh"}, {"surah": 70, "ayah": 41, "text": "عَلَيٰٓ أَن نُّبَدِّلَ خَيْراࣰ مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَۖ", "words": [{"id": 1, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَن", "translit": "", "root": ""}, {"id": 3, "arabic": "نُّبَدِّلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "خَيْراࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّنْهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 8, "arabic": "بِمَسْبُوقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 70, "ayah": 42, "text": "فَذَرْهُمْ يَخُوضُواْ وَيَلْعَبُواْ حَتَّيٰ يُلَٰقُواْ يَوْمَهُمُ اُ۬لذِے يُوعَدُونَ", "words": [{"id": 1, "arabic": "فَذَرْهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَخُوضُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَيَلْعَبُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "حَتَّيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "يُلَٰقُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَوْمَهُمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لذِے", "translit": "", "root": ""}, {"id": 8, "arabic": "يُوعَدُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 70, "ayah": 43, "text": "يَوْمَ يَخْرُجُونَ مِنَ اَ۬لَاجْدَاثِ سِرَاعاࣰ كَأَنَّهُمُۥٓ إِلَيٰ نَصْبࣲ يُوفِضُونَ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَخْرُجُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لَاجْدَاثِ", "translit": "", "root": ""}, {"id": 5, "arabic": "سِرَاعاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَأَنَّهُمُۥٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "نَصْبࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "يُوفِضُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 70, "ayah": 44, "text": "خَٰشِعَةً اَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةࣱۖ ذَٰلِكَ اَ۬لْيَوْمُ اُ۬لذِے كَانُواْ يُوعَدُونَۖ", "words": [{"id": 1, "arabic": "خَٰشِعَةً", "translit": "", "root": ""}, {"id": 2, "arabic": "اَبْصَٰرُهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "تَرْهَقُهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "ذِلَّةࣱۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْيَوْمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لذِے", "translit": "", "root": ""}, {"id": 8, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "يُوعَدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}]}