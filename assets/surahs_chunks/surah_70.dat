{"surah": 70, "verses": [{"ayah": 1, "text": "سَأَلَ سَآئِلٌۢ بِعَذَابٍ وَاقِعٍ ", "translation": "A supplicant asked for a punishment bound to happen[1]", "words": [{"id": 1, "arabic": "سَأَلَ", "translit": "َlَaʾَs", "root": "سال"}, {"id": 2, "arabic": "سَآئِلٌۢ", "translit": "ٌۢlِyʾٓāَs", "root": "سال"}, {"id": 3, "arabic": "بِعَذَابٍ", "translit": "ٍbāَhdَʿعِb", "root": "عذب"}, {"id": 4, "arabic": "وَاقِعٍ", "translit": "ٍʿعِqāَw", "root": "وقع"}], "hasIhya": false}, {"ayah": 2, "text": "لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌ ", "translation": "To the disbelievers; of it there is no preventer.", "words": [{"id": 1, "arabic": "لِّلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlِّl", "root": "كفر"}, {"id": 2, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 3, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 4, "arabic": "دَافِعٌ", "translit": "ٌʿعِfāَd", "root": "دفع"}], "hasIhya": false}, {"ayah": 3, "text": "مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ ", "translation": "[It is] from Allāh, owner of the ways of ascent.", "words": [{"id": 1, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 2, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ذِى", "translit": "àِhd", "root": ""}, {"id": 4, "arabic": "ٱلْمَعَارِجِ", "translit": "ِjgِrāَʿعَmْlٱ", "root": "عرج"}], "hasIhya": false}, {"ayah": 4, "text": "تَعْرُجُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ ", "translation": "The angels and the Spirit [i.e., Gabriel] will ascend to Him during a Day the extent of which is fifty thousand years.", "words": [{"id": 1, "arabic": "تَعْرُجُ", "translit": "ُjgُrْʿعَt", "root": "عرج"}, {"id": 2, "arabic": "ٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 3, "arabic": "وَٱلرُّوحُ", "translit": "ُḥwُّrlٱَw", "root": "روح"}, {"id": 4, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "يَوْمٍ", "translit": "ٍmْwَy", "root": "يوم"}, {"id": 7, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 8, "arabic": "مِقْدَارُهُۥ", "translit": "ۥُhُrāَdْqِm", "root": "قدر"}, {"id": 9, "arabic": "خَمْسِينَ", "translit": "َnyِsْmَhk", "root": "خمس"}, {"id": 10, "arabic": "أَلْفَ", "translit": "َfْlَaʾ", "root": "الف"}, {"id": 11, "arabic": "سَنَةٍ", "translit": "ٍẗَnَs", "root": "سنو"}], "hasIhya": true}, {"ayah": 5, "text": "فَٱصْبِرْ صَبْرًا جَمِيلًا ", "translation": "So be patient with gracious patience.", "words": [{"id": 1, "arabic": "فَٱصْبِرْ", "translit": "ْrِbْṣٱَf", "root": "صبر"}, {"id": 2, "arabic": "صَبْرًا", "translit": "āًrْbَṣ", "root": "صبر"}, {"id": 3, "arabic": "جَمِيلًا", "translit": "āًlyِmَjg", "root": "جمل"}], "hasIhya": false}, {"ayah": 6, "text": "إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًا ", "translation": "Indeed, they see it [as] distant,", "words": [{"id": 1, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "يَرَوْنَهُۥ", "translit": "ۥُhَnْwَrَy", "root": "راي"}, {"id": 3, "arabic": "بَعِيدًا", "translit": "āًdyِʿعَb", "root": "بعد"}], "hasIhya": true}, {"ayah": 7, "text": "وَنَرَىٰهُ قَرِيبًا ", "translation": "But We see it [as] near.", "words": [{"id": 1, "arabic": "وَنَرَىٰهُ", "translit": "ُhٰàَrَnَw", "root": "راي"}, {"id": 2, "arabic": "قَرِيبًا", "translit": "āًbyِrَq", "root": "قرب"}], "hasIhya": false}, {"ayah": 8, "text": "يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ ", "translation": "On the Day the sky will be like murky oil,[1]", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "تَكُونُ", "translit": "ُnwُkَt", "root": "كون"}, {"id": 3, "arabic": "ٱلسَّمَآءُ", "translit": "ُءٓāَmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "كَٱلْمُهْلِ", "translit": "ِlْhُmْlٱَk", "root": "مهل"}], "hasIhya": false}, {"ayah": 9, "text": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ", "translation": "And the mountains will be like wool,[1]", "words": [{"id": 1, "arabic": "وَتَكُونُ", "translit": "ُnwُkَtَw", "root": "كون"}, {"id": 2, "arabic": "ٱلْجِبَالُ", "translit": "ُlāَbِjgْlٱ", "root": "جبل"}, {"id": 3, "arabic": "كَٱلْعِهْنِ", "translit": "ِnْhِʿعْlٱَk", "root": "عهن"}], "hasIhya": false}, {"ayah": 10, "text": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا ", "translation": "And no friend will ask [anything of] a friend,", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "يَسْـَٔلُ", "translit": "ُlَٔـْsَy", "root": "سال"}, {"id": 3, "arabic": "حَمِيمٌ", "translit": "ٌmyِmَḥ", "root": "حمم"}, {"id": 4, "arabic": "حَمِيمًا", "translit": "āًmyِmَḥ", "root": "حمم"}], "hasIhya": false}, {"ayah": 11, "text": "يُبَصَّرُونَهُمْۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ ", "translation": "They will be shown each other. The criminal will wish that he could be ransomed from the punishment of that Day by his children", "words": [{"id": 1, "arabic": "يُبَصَّرُونَهُمْ", "translit": "ْmُhَnwُrَّṣَbُy", "root": "بصر"}, {"id": 2, "arabic": "يَوَدُّ", "translit": "ُّdَwَy", "root": "ودد"}, {"id": 3, "arabic": "ٱلْمُجْرِمُ", "translit": "ُmِrْjgُmْlٱ", "root": "جرم"}, {"id": 4, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 5, "arabic": "يَفْتَدِى", "translit": "àِdَtْfَy", "root": "فدي"}, {"id": 6, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 7, "arabic": "عَذَابِ", "translit": "ِbāَhdَʿع", "root": "عذب"}, {"id": 8, "arabic": "يَوْمِئِذٍۭ", "translit": "ٍۭhdِyʾِmْwَy", "root": "يوم"}, {"id": 9, "arabic": "بِبَنِيهِ", "translit": "ِhyِnَbِb", "root": "بني"}], "hasIhya": false}, {"ayah": 12, "text": "وَصَٰحِبَتِهِۦ وَأَخِيهِ ", "translation": "And his wife and his brother", "words": [{"id": 1, "arabic": "وَصَٰحِبَتِهِۦ", "translit": "ۦِhِtَbِḥَٰṣَw", "root": "صحب"}, {"id": 2, "arabic": "وَأَخِيهِ", "translit": "ِhyِhkَaʾَw", "root": "اخو"}], "hasIhya": false}, {"ayah": 13, "text": "وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ ", "translation": "And his nearest kindred who shelter him", "words": [{"id": 1, "arabic": "وَفَصِيلَتِهِ", "translit": "ِhِtَlyِṣَfَw", "root": "فصل"}, {"id": 2, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 3, "arabic": "تُـْٔوِيهِ", "translit": "ِhyِwْٔـُt", "root": "اوي"}], "hasIhya": false}, {"ayah": 14, "text": "وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ ", "translation": "And whoever is on earth entirely [so] then it could save him.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 4, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 5, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 6, "arabic": "يُنجِيهِ", "translit": "ِhyِjgnُy", "root": "نجو"}], "hasIhya": false}, {"ayah": 15, "text": "كَلَّآۖ إِنَّهَا لَظَىٰ ", "translation": "No![1] Indeed, it is the Flame [of Hell],", "words": [{"id": 1, "arabic": "كَلَّآ", "translit": "ٓāَّlَk", "root": ""}, {"id": 2, "arabic": "إِنَّهَا", "translit": "āَhَّnِiʾ", "root": ""}, {"id": 3, "arabic": "لَظَىٰ", "translit": "ٰàَẓَl", "root": ""}], "hasIhya": false}, {"ayah": 16, "text": "نَزَّاعَةً لِّلشَّوَىٰ ", "translation": "A remover of exteriors.[1]", "words": [{"id": 1, "arabic": "نَزَّاعَةً", "translit": "ًẗَʿعāَّzَn", "root": "نزع"}, {"id": 2, "arabic": "لِّلشَّوَىٰ", "translit": "ٰàَwَّhslِّl", "root": "شوي"}], "hasIhya": false}, {"ayah": 17, "text": "تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ ", "translation": "It invites he who turned his back [on truth] and went away [from obedience]", "words": [{"id": 1, "arabic": "تَدْعُوا۟", "translit": "۟āwُʿعْdَt", "root": "دعو"}, {"id": 2, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 3, "arabic": "أَدْبَرَ", "translit": "َrَbْdَaʾ", "root": "دبر"}, {"id": 4, "arabic": "وَتَوَلَّىٰ", "translit": "ٰàَّlَwَtَw", "root": "ولي"}], "hasIhya": false}, {"ayah": 18, "text": "وَجَمَعَ فَأَوْعَىٰٓ ", "translation": "And collected [wealth] and hoarded.", "words": [{"id": 1, "arabic": "وَجَمَعَ", "translit": "َʿعَmَjgَw", "root": "جمع"}, {"id": 2, "arabic": "فَأَوْعَىٰٓ", "translit": "ٰٓàَʿعْwَaʾَf", "root": "وعي"}], "hasIhya": false}, {"ayah": 19, "text": "إِنَّ ٱلْإِنسَٰنَ خُلِقَ هَلُوعًا ", "translation": "Indeed, mankind was created anxious:", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلْإِنسَٰنَ", "translit": "َnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 3, "arabic": "خُلِقَ", "translit": "َqِlُhk", "root": "خلق"}, {"id": 4, "arabic": "هَلُوعًا", "translit": "āًʿعwُlَh", "root": "هلع"}], "hasIhya": false}, {"ayah": 20, "text": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا ", "translation": "When evil touches him, impatient,", "words": [{"id": 1, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 2, "arabic": "مَسَّهُ", "translit": "ُhَّsَm", "root": "مسس"}, {"id": 3, "arabic": "ٱلشَّرُّ", "translit": "ُّrَّhslٱ", "root": "شرر"}, {"id": 4, "arabic": "جَزُوعًا", "translit": "āًʿعwُzَjg", "root": "جزع"}], "hasIhya": false}, {"ayah": 21, "text": "وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا ", "translation": "And when good touches him, withholding [of it],", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "مَسَّهُ", "translit": "ُhَّsَm", "root": "مسس"}, {"id": 3, "arabic": "ٱلْخَيْرُ", "translit": "ُrْyَhkْlٱ", "root": "خير"}, {"id": 4, "arabic": "مَنُوعًا", "translit": "āًʿعwُnَm", "root": "منع"}], "hasIhya": false}, {"ayah": 22, "text": "إِلَّا ٱلْمُصَلِّينَ ", "translation": "Except the observers of prayer -", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلْمُصَلِّينَ", "translit": "َnyِّlَṣُmْlٱ", "root": "صلو"}], "hasIhya": false}, {"ayah": 23, "text": "ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ ", "translation": "Those who are constant in their prayer", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "صَلَاتِهِمْ", "translit": "ْmِhِtāَlَṣ", "root": "صلو"}, {"id": 5, "arabic": "دَآئِمُونَ", "translit": "َnwُmِyʾٓāَd", "root": "دوم"}], "hasIhya": true}, {"ayah": 24, "text": "وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ ", "translation": "And those within whose wealth is a known right[1]", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 3, "arabic": "أَمْوَٰلِهِمْ", "translit": "ْmِhِlَٰwْmَaʾ", "root": "مول"}, {"id": 4, "arabic": "حَقٌّ", "translit": "ٌّqَḥ", "root": "حقق"}, {"id": 5, "arabic": "مَّعْلُومٌ", "translit": "ٌmwُlْʿعَّm", "root": "علم"}], "hasIhya": false}, {"ayah": 25, "text": "لِّلسَّآئِلِ وَٱلْمَحْرُومِ ", "translation": "For the petitioner and the deprived -", "words": [{"id": 1, "arabic": "لِّلسَّآئِلِ", "translit": "ِlِyʾٓāَّslِّl", "root": "سال"}, {"id": 2, "arabic": "وَٱلْمَحْرُومِ", "translit": "ِmwُrْḥَmْlٱَw", "root": "حرم"}], "hasIhya": false}, {"ayah": 26, "text": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ ", "translation": "And those who believe in the Day of Recompense", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "يُصَدِّقُونَ", "translit": "َnwُqِّdَṣُy", "root": "صدق"}, {"id": 3, "arabic": "بِيَوْمِ", "translit": "ِmْwَyِb", "root": "يوم"}, {"id": 4, "arabic": "ٱلدِّينِ", "translit": "ِnyِّdlٱ", "root": "دين"}], "hasIhya": false}, {"ayah": 27, "text": "وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ ", "translation": "And those who are fearful of the punishment of their Lord -", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 3, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 4, "arabic": "عَذَابِ", "translit": "ِbāَhdَʿع", "root": "عذب"}, {"id": 5, "arabic": "رَبِّهِم", "translit": "mِhِّbَr", "root": "ربب"}, {"id": 6, "arabic": "مُّشْفِقُونَ", "translit": "َnwُqِfْhsُّm", "root": "شفق"}], "hasIhya": false}, {"ayah": 28, "text": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ ", "translation": "Indeed, the punishment of their Lord is not that from which one is safe -", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 3, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 4, "arabic": "غَيْرُ", "translit": "ُrْyَغ", "root": "غير"}, {"id": 5, "arabic": "مَأْمُونٍ", "translit": "ٍnwُmْaʾَm", "root": "امن"}], "hasIhya": true}, {"ayah": 29, "text": "وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ ", "translation": "And those who guard their private parts", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 3, "arabic": "لِفُرُوجِهِمْ", "translit": "ْmِhِjgwُrُfِl", "root": "فرج"}, {"id": 4, "arabic": "حَٰفِظُونَ", "translit": "َnwُẓِfَٰḥ", "root": "حفظ"}], "hasIhya": false}, {"ayah": 30, "text": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ ", "translation": "Except from their wives or those their right hands possess,[1] for indeed, they are not to be blamed -", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 3, "arabic": "أَزْوَٰجِهِمْ", "translit": "ْmِhِjgَٰwْzَaʾ", "root": "زوج"}, {"id": 4, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "مَلَكَتْ", "translit": "ْtَkَlَm", "root": "ملك"}, {"id": 7, "arabic": "أَيْمَٰنُهُمْ", "translit": "ْmُhُnَٰmْyَaʾ", "root": "يمن"}, {"id": 8, "arabic": "فَإِنَّهُمْ", "translit": "ْmُhَّnِiʾَf", "root": ""}, {"id": 9, "arabic": "غَيْرُ", "translit": "ُrْyَغ", "root": "غير"}, {"id": 10, "arabic": "مَلُومِينَ", "translit": "َnyِmwُlَm", "root": "لوم"}], "hasIhya": false}, {"ayah": 31, "text": "فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْعَادُونَ ", "translation": "But whoever seeks beyond that, then they are the transgressors -", "words": [{"id": 1, "arabic": "فَمَنِ", "translit": "ِnَmَf", "root": ""}, {"id": 2, "arabic": "ٱبْتَغَىٰ", "translit": "ٰàَغَtْbٱ", "root": "بغي"}, {"id": 3, "arabic": "وَرَآءَ", "translit": "َءٓāَrَw", "root": "وري"}, {"id": 4, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 5, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 6, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 7, "arabic": "ٱلْعَادُونَ", "translit": "َnwُdāَʿعْlٱ", "root": "عدو"}], "hasIhya": false}, {"ayah": 32, "text": "وَٱلَّذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ ", "translation": "And those who are to their trusts and promises attentive", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 3, "arabic": "لِأَمَٰنَٰتِهِمْ", "translit": "ْmِhِtَٰnَٰmَaʾِl", "root": "امن"}, {"id": 4, "arabic": "وَعَهْدِهِمْ", "translit": "ْmِhِdْhَʿعَw", "root": "عهد"}, {"id": 5, "arabic": "رَٰعُونَ", "translit": "َnwُʿعَٰr", "root": "رعي"}], "hasIhya": true}, {"ayah": 33, "text": "وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمْ قَآئِمُونَ ", "translation": "And those who are in their testimonies upright", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 3, "arabic": "بِشَهَٰدَٰتِهِمْ", "translit": "ْmِhِtَٰdَٰhَhsِb", "root": "شهد"}, {"id": 4, "arabic": "قَآئِمُونَ", "translit": "َnwُmِyʾٓāَq", "root": "قوم"}], "hasIhya": false}, {"ayah": 34, "text": "وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ ", "translation": "And those who [carefully] maintain their prayer:", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "صَلَاتِهِمْ", "translit": "ْmِhِtāَlَṣ", "root": "صلو"}, {"id": 5, "arabic": "يُحَافِظُونَ", "translit": "َnwُẓِfāَḥُy", "root": "حفظ"}], "hasIhya": false}, {"ayah": 35, "text": "أُو۟لَٰٓئِكَ فِى جَنَّٰتٍ مُّكْرَمُونَ ", "translation": "They will be in gardens,[1] honored.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 4, "arabic": "مُّكْرَمُونَ", "translit": "َnwُmَrْkُّm", "root": "كرم"}], "hasIhya": false}, {"ayah": 36, "text": "فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ ", "translation": "So what is [the matter] with those who disbelieve, hastening [from] before you, [O Muḥammad],", "words": [{"id": 1, "arabic": "فَمَالِ", "translit": "ِlāَmَf", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "قِبَلَكَ", "translit": "َkَlَbِq", "root": "قبل"}, {"id": 5, "arabic": "مُهْطِعِينَ", "translit": "َnyِʿعِṭْhُm", "root": "هطع"}], "hasIhya": false}, {"ayah": 37, "text": "عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ ", "translation": "[To sit] on [your] right and [your] left in separate groups?[1]", "words": [{"id": 1, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 2, "arabic": "ٱلْيَمِينِ", "translit": "ِnyِmَyْlٱ", "root": "يمن"}, {"id": 3, "arabic": "وَعَنِ", "translit": "ِnَʿعَw", "root": ""}, {"id": 4, "arabic": "ٱلشِّمَالِ", "translit": "ِlāَmِّhslٱ", "root": "شمل"}, {"id": 5, "arabic": "عِزِينَ", "translit": "َnyِzِʿع", "root": "عزو"}], "hasIhya": false}, {"ayah": 38, "text": "أَيَطْمَعُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ ", "translation": "Does every person among them aspire to enter a garden of pleasure?", "words": [{"id": 1, "arabic": "أَيَطْمَعُ", "translit": "ُʿعَmْṭَyَaʾ", "root": "طمع"}, {"id": 2, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 3, "arabic": "ٱمْرِئٍ", "translit": "ٍyʾِrْmٱ", "root": "مرا"}, {"id": 4, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "يُدْخَلَ", "translit": "َlَhkْdُy", "root": "دخل"}, {"id": 7, "arabic": "جَنَّةَ", "translit": "َẗَّnَjg", "root": "جنن"}, {"id": 8, "arabic": "نَعِيمٍ", "translit": "ٍmyِʿعَn", "root": "نعم"}], "hasIhya": false}, {"ayah": 39, "text": "كَلَّآۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَ ", "translation": "No! Indeed, We have created them from that which they know.[1]", "words": [{"id": 1, "arabic": "كَلَّآ", "translit": "ٓāَّlَk", "root": ""}, {"id": 2, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 3, "arabic": "خَلَقْنَٰهُم", "translit": "mُhَٰnْqَlَhk", "root": "خلق"}, {"id": 4, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 5, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 40, "text": "فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَٰرِقِ وَٱلْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ ", "translation": "So I swear by the Lord of [all] risings and settings[1] that indeed We are able", "words": [{"id": 1, "arabic": "فَلَآ", "translit": "ٓāَlَf", "root": ""}, {"id": 2, "arabic": "أُقْسِمُ", "translit": "ُmِsْqُaʾ", "root": "قسم"}, {"id": 3, "arabic": "بِرَبِّ", "translit": "ِّbَrِb", "root": "ربب"}, {"id": 4, "arabic": "ٱلْمَشَٰرِقِ", "translit": "ِqِrَٰhsَmْlٱ", "root": "شرق"}, {"id": 5, "arabic": "وَٱلْمَغَٰرِبِ", "translit": "ِbِrَٰغَmْlٱَw", "root": "غرب"}, {"id": 6, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 7, "arabic": "لَقَٰدِرُونَ", "translit": "َnwُrِdَٰqَl", "root": "قدر"}], "hasIhya": false}, {"ayah": 41, "text": "عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ ", "translation": "To replace them with better than them; and We are not to be outdone.", "words": [{"id": 1, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 2, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 3, "arabic": "نُّبَدِّلَ", "translit": "َlِّdَbُّn", "root": "بدل"}, {"id": 4, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 5, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 8, "arabic": "بِمَسْبُوقِينَ", "translit": "َnyِqwُbْsَmِb", "root": "سبق"}], "hasIhya": false}, {"ayah": 42, "text": "فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ ", "translation": "So leave them to converse vainly and amuse themselves until they meet their Day which they are promised -", "words": [{"id": 1, "arabic": "فَذَرْهُمْ", "translit": "ْmُhْrَhdَf", "root": "وذر"}, {"id": 2, "arabic": "يَخُوضُوا۟", "translit": "۟āwُḍwُhkَy", "root": "خوض"}, {"id": 3, "arabic": "وَيَلْعَبُوا۟", "translit": "۟āwُbَʿعْlَyَw", "root": "لعب"}, {"id": 4, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 5, "arabic": "يُلَٰقُوا۟", "translit": "۟āwُqَٰlُy", "root": "لقي"}, {"id": 6, "arabic": "يَوْمَهُمُ", "translit": "ُmُhَmْwَy", "root": "يوم"}, {"id": 7, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "يُوعَدُونَ", "translit": "َnwُdَʿعwُy", "root": "وعد"}], "hasIhya": false}, {"ayah": 43, "text": "يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًا كَأَنَّهُمْ إِلَىٰ نُصُبٍ يُوفِضُونَ ", "translation": "The Day they will emerge from the graves rapidly as if they were, toward an erected idol, hastening.[1]", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "يَخْرُجُونَ", "translit": "َnwُjgُrْhkَy", "root": "خرج"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلْأَجْدَاثِ", "translit": "ِhtāَdْjgَaʾْlٱ", "root": "جدث"}, {"id": 5, "arabic": "سِرَاعًا", "translit": "āًʿعāَrِs", "root": "سرع"}, {"id": 6, "arabic": "كَأَنَّهُمْ", "translit": "ْmُhَّnَaʾَk", "root": ""}, {"id": 7, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 8, "arabic": "نُصُبٍ", "translit": "ٍbُṣُn", "root": "نصب"}, {"id": 9, "arabic": "يُوفِضُونَ", "translit": "َnwُḍِfwُy", "root": "وفض"}], "hasIhya": false}, {"ayah": 44, "text": "خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۚ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ ", "translation": "Their eyes humbled, humiliation will cover them. That is the Day which they had been promised.", "words": [{"id": 1, "arabic": "خَٰشِعَةً", "translit": "ًẗَʿعِhsَٰhk", "root": "خشع"}, {"id": 2, "arabic": "أَبْصَٰرُهُمْ", "translit": "ْmُhُrَٰṣْbَaʾ", "root": "بصر"}, {"id": 3, "arabic": "تَرْهَقُهُمْ", "translit": "ْmُhُqَhْrَt", "root": "رهق"}, {"id": 4, "arabic": "ذِلَّةٌ", "translit": "ٌẗَّlِhd", "root": "ذلل"}, {"id": 5, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 6, "arabic": "ٱلْيَوْمُ", "translit": "ُmْwَyْlٱ", "root": "يوم"}, {"id": 7, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 9, "arabic": "يُوعَدُونَ", "translit": "َnwُdَʿعwُy", "root": "وعد"}], "hasIhya": false}], "tafsir": {"4": [{"arabic": "وكان كرز بن وبرة يختم القرآن في كل يوم ثلاث مرات ويجاهد نفسه في العبادات غاية المجاهدة فقيل له قد أجهدت نفسك فقال كم عمر الدنيا فقيل سبعة آلاف سنة فقال كم مقدار يوم القيامة فقيل خمسون ألف سنة فقال كيف يعجز أحدكم أن يعمل سبع يوم حتى يأمن ذلك اليوم يعنى أنك لو عشت عمر الدنيا واجتهدت سبعة آلاف سنة وتخلصت من يوم واحد كان مقداره خمسين ألف سنة لكان ربحك كثيرا وكنت بالرغبة فيه جديرا فكيف وعمرك قصير والآخرة لا غاية لها", "english": "And Karaz ibn Wabra used to complete the Quran three times every day and strive against his soul (Nafs) in acts of worship to the utmost striving (Mujahada). It was said to him: 'You have exhausted your soul (Nafs).' He said: 'How long is the lifespan of the world?' It was said: 'Seven thousand years.' He said: 'What is the measure of the Day of Resurrection?' It was said: 'Fifty thousand years.' He said: 'How can one of you be incapable of working for a seventh of a day until he is secure from that Day?' Meaning: If you lived the lifespan of the world and strove for seven thousand years and were saved from one day whose measure is fifty thousand years, your profit would be great and you would be worthy of desire for it. So how [can this be] when your lifespan is short and the Hereafter has no limit?", "book_file": "vol4_j4-k08.doc.txt", "book_title": "Monitoring and Accounting", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monitoring and Accounting'", "badge": "Insight"}], "6": [{"arabic": "ثم يعرفنا قرب القيامة فيقول اقتربت الساعة وانشق القمر ﴿ إنهم يرونه بعيدا ونراه قريبا ﴾ {} ﴿ وما يدريك لعل الساعة تكون قريبا ﴾ {} ثم يكون أحسن أحوالنا أن نتخذ دراسة هذا القرآن عملا فلا نتدبر معانيه ولا ننظر فى كثرة أوصاف هذا اليوم وأساميه ولا نستعد للتخلص من دواهيه فنعوذ بالله من هذه الغفلة إن لم يداركنا الله بواسع رحمته.", "english": "Then He makes known to us the nearness of the Resurrection (Qiyamah) and says: 'The Hour (Saa'ah) has drawn near and the moon has split' (Quran 54:1). 'Indeed, they see it as distant, but We see it as near' (Quran 70:6-7). 'And what will make you perceive? Perhaps the Hour (Saa'ah) is near' (Quran 33:63). Then the best of our states becomes that we take the study of this Quran as an action, yet we do not ponder its meanings, nor do we look at the multitude of descriptions of this Day (Yawm) and its names, nor do we prepare to be delivered from its calamities. So we seek refuge in Allah from this heedlessness (Ghaflah) if Allah does not reach us with His vast mercy.", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Book of Repentance'", "badge": "Afterlife"}], "23": [{"arabic": "فهذا تفصيل صلاة الخاشعين الذين هم في صلاتهم خاشعون والذين هم على صلواتهم يحافظون والذين هم على صلاتهم دائمون والذين هم يناجون الله على قدر استطاعتهم في العبودية فليعرض الإنسان نفسه على هذه الصلاة فبالقدر الذي يسر له منه ينبغي أن يفرح وعلى ما يفوته ينبغي أن يتحسر وفي مداراة ذلك ينبغي أن يجتهد.", "english": "This is the detailed description of the prayer of the humble ones (Al-Khashi'un) who are in their prayer humble, and those who are over their prayers preserving, and those who are over their prayer constant (Da'imun), and those who are conversing with Allah (Munajun) according to their capability in servitude (Al-'Ubudiyyah). So let a person present himself to this prayer; for the amount that is made easy for him from it, he should rejoice, and for what he misses, he should grieve, and in managing that, he should strive.", "book_file": "vol1_Vol1-book-4.doc.txt", "book_title": "Mysteries of Prayer", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Mysteries of Prayer'", "badge": "Du'a"}], "28": [{"arabic": "وكيف يؤمن تغير الحال وقلب المؤمن بين أصبعين من أصابع الرحمن وأن القلب أشد تقلبا من القدر في غليانها وقد قال مقلب القلوب عز وجل: ﴿ إن عذاب ربهم غير مأمون ﴾ {} فأجهل الناس من أمنه وهو ينادي بالتحذير من الأمن ولو أن الله لطف بعباده العارفين إذ روح قلوبهم بروح الرجاء لاحترقت قلوبهم من نار الخوف.", "english": "And how can one feel secure about the changing of states when the heart (Qalb) of the believer is between two fingers of the fingers of the Most Merciful (Ar-Rahman), and the heart is more fluctuating than a pot in its boiling? And the Turner of Hearts (Muqallib al-Qulub), may He be glorified and exalted, has said: 'Indeed, the punishment of their Lord is not to be felt secure from.' So the most ignorant of people is he who feels secure from it while He calls out with warning against feeling secure. And if Allah had been gentle with His servants, the knowers (al-'Arifin), by reviving their hearts with the spirit (Ruh) of hope, their hearts would have burned from the fire of fear.", "book_file": "vol4_Vol4-book3.doc.txt", "book_title": "Fear and Hope", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Fear and Hope'", "badge": "Insight"}], "32": [{"arabic": "وقال تعالى والذين هم لأماناتهم وعهدهم راعون والذين هم بشهاداتهم قائمون وقال ابن المبارك لرجل راقب الله تعالى فسأله عن تفسيره فقال كن أبدا كأنك ترى الله عز وجل", "english": "And Allah the Exalted said: 'And those who are for their trusts (Amanat) and their covenants (Ahd) caretakers (Ra'un), and those who are for their testimonies upright.' And Ibn Al-Mubarak said to a man: 'Observe (Raqib) Allah the Exalted,' and he asked him about its interpretation, so he said: 'Be always as if you see Allah, the Mighty and Majestic.'", "book_file": "vol4_j4-k08.doc.txt", "book_title": "Monitoring and Accounting", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Monitoring and Accounting'", "badge": "General"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 1454], [2, 1454, 3868], [3, 3868, 5752], [4, 5752, 7508]], "2": [[1, 350, 2483], [2, 2483, 3351], [3, 3351, 3809], [4, 3809, 4965]], "3": [[1, 350, 1039], [2, 1039, 1827], [3, 1827, 2346], [4, 2346, 3763]], "4": [[1, 400, 1505], [2, 1505, 3609], [3, 3609, 5490], [4, 5490, 6700], [5, 6700, 7358], [6, 7358, 8410], [7, 8410, 9357], [8, 9357, 11198], [9, 11198, 12697], [10, 12697, 13539], [11, 13539, 14300]], "5": [[1, 350, 1553], [2, 1553, 2900], [3, 2900, 4495]], "6": [[1, 350, 1981], [2, 1981, 3715], [3, 3715, 5566]], "7": [[1, 250, 1785], [2, 1785