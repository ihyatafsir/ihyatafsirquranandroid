ur] right and [your] left in separate groups?[1]","words":[{"id":1,"arabic":"عَنِ","translit":"ِnَʿع","root":""},{"id":2,"arabic":"ٱلْيَمِينِ","translit":"ِnyِmَyْlٱ","root":"يمن"},{"id":3,"arabic":"وَعَنِ","translit":"ِnَʿعَw","root":""},{"id":4,"arabic":"ٱلشِّمَالِ","translit":"ِlāَmِّhslٱ","root":"شمل"},{"id":5,"arabic":"عِزِينَ","translit":"َnyِzِʿع","root":"عزو"}],"hasIhya":false},{"ayah":38,"text":"أَيَطْمَعُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ ","translation":"Does every person among them aspire to enter a garden of pleasure?","words":[{"id":1,"arabic":"أَيَطْمَعُ","translit":"ُʿعَmْṭَyَaʾ","root":"طمع"},{"id":2,"arabic":"كُلُّ","translit":"ُّlُk","root":"كلل"},{"id":3,"arabic":"ٱمْرِئٍ","translit":"ٍyʾِrْmٱ","root":"مرا"},{"id":4,"arabic":"مِّنْهُمْ","translit":"ْmُhْnِّm","root":""},{"id":5,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":6,"arabic":"يُدْخَلَ","translit":"َlَhkْdُy","root":"دخل"},{"id":7,"arabic":"جَنَّةَ","translit":"َẗَّnَjg","root":"جنن"},{"id":8,"arabic":"نَعِيمٍ","translit":"ٍmyِʿعَn","root":"نعم"}],"hasIhya":false},{"ayah":39,"text":"كَلَّآۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَ ","translation":"No! Indeed, We have created them from that which they know.[1]","words":[{"id":1,"arabic":"كَلَّآ","translit":"ٓāَّlَk","root":""},{"id":2,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":3,"arabic":"خَلَقْنَٰهُم","translit":"mُhَٰnْqَlَhk","root":"خلق"},{"id":4,"arabic":"مِّمَّا","translit":"āَّmِّm","root":""},{"id":5,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":false},{"ayah":40,"text":"فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَٰرِقِ وَٱلْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ ","translation":"So I swear by the Lord of [all] risings and settings[1] that indeed We are able","words":[{"id":1,"arabic":"فَلَآ","translit":"ٓāَlَf","root":""},{"id":2,"arabic":"أُقْسِمُ","translit":"ُmِsْqُaʾ","root":"قسم"},{"id":3,"arabic":"بِرَبِّ","translit":"ِّbَrِb","root":"ربب"},{"id":4,"arabic":"ٱلْمَشَٰرِقِ","translit":"ِqِrَٰhsَmْlٱ","root":"شرق"},{"id":5,"arabic":"وَٱلْمَغَٰرِبِ","translit":"ِbِrَٰغَmْlٱَw","root":"غرب"},{"id":6,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":7,"arabic":"لَقَٰدِرُونَ","translit":"َnwُrِdَٰqَl","root":"قدر"}],"hasIhya":false},{"ayah":41,"text":"عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ ","translation":"To replace them with better than them; and We are not to be outdone.","words":[{"id":1,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":2,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":3,"arabic":"نُّبَدِّلَ","translit":"َlِّdَbُّn","root":"بدل"},{"id":4,"arabic":"خَيْرًا","translit":"āًrْyَhk","root":"خير"},{"id":5,"arabic":"مِّنْهُمْ","translit":"ْmُhْnِّm","root":""},{"id":6,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":7,"arabic":"نَحْنُ","translit":"ُnْḥَn","root":""},{"id":8,"arabic":"بِمَسْبُوقِينَ","translit":"َnyِqwُbْsَmِb","root":"سبق"}],"hasIhya":false},{"ayah":42,"text":"فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ ","translation":"So leave them to converse vainly and amuse themselves until they meet their Day which they are promised -","words":[{"id":1,"arabic":"فَذَرْهُمْ","translit":"ْmُhْrَhdَf","root":"وذر"},{"id":2,"arabic":"يَخُوضُوا۟","translit":"۟āwُḍwُhkَy","root":"خوض"},{"id":3,"arabic":"وَيَلْعَبُوا۟","translit":"۟āwُbَʿعْlَyَw","root":"لعب"},{"id":4,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":5,"arabic":"يُلَٰقُوا۟","translit":"۟āwُqَٰlُy","root":"لقي"},{"id":6,"arabic":"يَوْمَهُمُ","translit":"ُmُhَmْwَy","root":"يوم"},{"id":7,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":8,"arabic":"يُوعَدُونَ","translit":"َnwُdَʿعwُy","root":"وعد"}],"hasIhya":false},{"ayah":43,"text":"يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًا كَأَنَّهُمْ إِلَىٰ نُصُبٍ يُوفِضُونَ ","translation":"The Day they will emerge from the graves rapidly as if they were, toward an erected idol, hastening.[1]","words":[{"id":1,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":2,"arabic":"يَخْرُجُونَ","translit":"َnwُjgُrْhkَy","root":"خرج"},{"id":3,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":4,"arabic":"ٱلْأَجْدَاثِ","translit":"ِhtāَdْjgَaʾْlٱ","root":"جدث"},{"id":5,"arabic":"سِرَاعًا","translit":"āًʿعāَrِs","root":"سرع"},{"id":6,"arabic":"كَأَنَّهُمْ","translit":"ْmُhَّnَaʾَk","root":""},{"id":7,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":8,"arabic":"نُصُبٍ","translit":"ٍbُṣُn","root":"نصب"},{"id":9,"arabic":"يُوفِضُونَ","translit":"َnwُḍِfwُy","root":"وفض"}],"hasIhya":false},{"ayah":44,"text":"خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۚ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ ","translation":"Their eyes humbled, humiliation will cover them. That is the Day which they had been promised.","words":[{"id":1,"arabic":"خَٰشِعَةً","translit":"ًẗَʿعِhsَٰhk","root":"خشع"},{"id":2,"arabic":"أَبْصَٰرُهُمْ","translit":"ْmُhُrَٰṣْbَaʾ","root":"بصر"},{"id":3,"arabic":"تَرْهَقُهُمْ","translit":"ْmُhُqَhْrَt","root":"رهق"},{"id":4,"arabic":"ذِلَّةٌ","translit":"ٌẗَّlِhd","root":"ذلل"},{"id":5,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":6,"arabic":"ٱلْيَوْمُ","translit":"ُmْwَyْlٱ","root":"يوم"},{"id":7,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":8,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":9,"arabic":"يُوعَدُونَ","translit":"َnwُdَʿعwُy","root":"وعد"}],"hasIhya":false}],"tafsir":{"4":[{"arabic":"سبعة آلاف سنة وتخلصت من يوم واحد كان مقداره خمسين ألف سنة لكان ربحك كثيرا وكنت بالرغبة فيه جديرا فكيف وعمرك قصير والآخرة لا غاية لها فهكذا كانت سيرة السلف الصالحين في مرابطة النفس ومراقبتها فمهما تمردت نفسك عليك وامتنعت من المواظبة على العبادة فطالع أحوال هؤلاء فإنه قد عز الآن وجود مثلهم ولو قدرت على مشاهدة من اقتدى بهم فهو أنجع في القلب وأبعث على الاقتداء فليس الخبر كالمعاينة وإذا عجزت عن هذا فلا تغفل عن سماع أحوال هؤلاء فإن لم تكن إبل فمعزى وخير نفسك بين الاقتداء بهم والكون في زمرتهم وغمارهم وهم العق","english":"It has been related of Ḥabībah al-ʿAdawiyyah that when she prayed the night prayer (al-ʿatamah), she would stand upon a roof of hers, and would tighten upon herself her shift and her veil, then say: \"My God! The stars have set, and the eyes have slept, and the kings have shut their doors, and every lover is alone with his beloved—and this is my station before You.\" Then she would devote herself to her prayer. And when dawn broke, she would say: \"My God! This night has retreated, and this day has shone forth. Would that I knew—has my night been accepted from me, so that I may rejoice, or has it been returned to me, so that I may grieve? By Your might, this is my habit and Your habit, as long as You keep me alive. By Your might, were You to drive me from Your door, I would not leave—because of what has settled in my soul of Your bounty and generosity.\"","book_title":"Monitoring and Accounting","section_title_ar":"Section 1248","section_title_en":"The Vigilance of the Righteous Forebears and the Devotion of Ascetic Women","section_index":1248,"anchors":"- Root: ر-ب-ط (r-b-ṭ)\n  * Lisan / Ayn: To bind, tie fast, or tether; steadfastness in holding firm.\n  * Al-Raghib (Mufradat): Moral steadfastness and constancy in obedience; the soul's tethering against its errant impulses.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): physical binding; metaphorical (majāz): persistent self-discipline and vigilance (murābaṭah) over the soul.\n- Root: ن-ف-س (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; the animating essence of a person.\n  * Al-Raghib (Mufradat): The soul as the locus of moral struggle—its base inclinations (amārah) versus its rational, God-seeking faculty.\n  * Al-Zamakhshari (Asas): Literal: the self as an entity; metaphorical: the soul's caprice (hawā) that must be opposed and trained.\n- Root: ع-ج-ز (ʿ-j-z)\n  * Lisan / Ayn: Weakness, incapacity, or falling short of a standard.\n  * Al-Raghib (Mufradat): Human limitation contrasted with divine power; the acknowledgment of one's insufficiency before God.\n  * Al-Zamakhshari (Asas): Literal: physical inability; metaphorical: moral and spiritual inadequacy that spurs one to emulate the virtuous.\n- Sibawayh Rule: Bāb al-istiṭābah wa al-istifhām al-inkārī (Rhetorical Rebuke and Interrogative) — The use of interrogative forms (e.g., \"كيف\" and \"فكيف\") to convey rebuke and wonder, heightening the exhortative force of the periodic admonition.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'","badge":"Insight"}],"6":[{"arabic":"الساعة وانشق القمر إنهم يرونه بعيدا ونراه قريبا وما يدريك لعل الساعة تكون قريبا ثم يكون أحسن أحوالنا أن نتخذ دراسة هذا القرآن عملا فلا نتدبر معانيه ولا ننظر في كثرة أوصاف هذا اليوم وأساميه ولا نستعد للتخلص من دواهيه فنعوذ بالله من هذه الغفلة إن لم يداركنا الله بواسع رحمته","english":"So prepare yourself, O wretched one, for this Day of immense magnitude, of prolonged duration, of overwhelming dominion, whose appointed time is near — a Day when you shall see the heaven split asunder, and the stars scattered in its terror, and the shining planets extinguished, and the sun folded up, and the mountains set in motion, and the pregnant camels neglected, and the wild beasts gathered together, and the seas set ablaze, and the souls paired with their bodies, and the Hellfire ignited, and Paradise brought near, and the mountains pulverized, and the earth stretched out — a Day when you shall see the earth shaken with its quaking, and the earth casts forth its burdens. On that Day shall people issue forth in scattered groups to be shown their deeds — a Day when the earth and the mountains are lifted and crushed with a single crushing. Then on that Day the Imminent Event shall come to pass, and the heaven shall split open, for on that Day it shall be frail, and the angels shall be at its edges, and eight shall bear the Throne of your Lord above them on that Day. On that Day you shall be presented — no secret of yours shall remain hidden. A Day when the mountains shall move and you shall see the earth laid bare — a Day when the earth shall be shaken with a violent shaking, and the mountains crumbled to dust, becoming scattered particles — a Day when people shall be like scattered moths, and the mountains like carded wool — a Day when every nursing mother shall forget what she nursed, and every pregnant female shall cast down her burden, and you shall see people drunk, yet they are not drunk, but the chastisement of God is severe — a Day when the earth shall be changed to other than this earth, and the heavens, and they shall appear before God, the One, the All-Compelling — a Day when the mountains shall be blown away as dust, leaving a level, bare plain, wherein you see no crookedness nor curve — a Day when you see the mountains and suppose them solid, yet they pass by like the passing of clouds — a Day when the heaven shall split open and become rosy like molten oil. Then on that Day no human nor jinn shall be asked about his sin. A Day when the disobedient shall be prevented from speech, and shall not be asked about their crimes, but shall be seized by their forelocks and their feet — a Day when every soul shall find what it did of good brought forth present, and what it did of evil, wishing that between it and that evil there were a far distance — a Day when every soul shall know what it has sent ahead, and shall witness what it has forwarded and what it has left behind — a Day when tongues shall be struck mute and the bodily members shall speak — a Day whose mention turned the hair of the Master of the Messengers white, when al-Ṣiddīq (may God be pleased with him) said to him: \"I see that you have turned white-haired, O Messenger of God.\" He said: \"Sūrat Hūd and its sisters have made me white-haired\" — namely, al-Wāqiʿah, al-Mursalāt, ʿAmma Yatasāʾalūn, and Idhā al-Shamsu Kuwwirat.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1339","section_title_en":"The Names and Attributes of the Day of Resurrection — An Exhortation to the Negligent","section_index":1339,"anchors":"- Root: يوم (yawm)\n  * Lisan / Ayn: \"اليوم: وقت طلوع الشمس إلى غروبها، وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day as a temporal span, extended metaphorically to any epoch or era.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — theological usage denotes the appointed time of reckoning, magnified by divine attribution (أيام الله).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): a measured solar period. Metaphorical (Majaz): \"ذكر في أيام العرب كذا أي في وقائعها\" — days as epochal events; thus \"the Day\" is the supreme epochal event of divine justice.\n- Root: نفس (nafs)\n  * Lisan / Ayn: النفس: الروح والذات — the self, soul, or very essence.\n  * Al-Raghib (Mufradat): \"النفس: الروح... وقوله: ويحذركم الله نفسه فنفسه: ذاته\" — nafs as the innermost reality of a being; in the eschatological context, souls are \"paired\" (زوجت) with bodies for judgment.\n  * Al-Zamakhshari (Asas): Literal: the soul as life-principle. Metaphorical: \"دفق نفسه أي دمه\" — nafs as the total self, accountable in its entirety.\n- Root: ارض (arḍ)\n  * Lisan / Ayn: الأرض: الجرم المقابل للسماء — the earth as the corporeal substratum beneath the heavens.\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء... ويعبر بها عن أسفل الشيء\" — the earth as the lowest register of creation, subject to total transformation on that Day.\n  * Al-Zamakhshari (Asas): Literal: the physical earth. Metaphorical: \"تأرض فلان: لزم الأرض\" — to cling low; on that Day the earth itself is leveled, flattened, and replaced.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated \"يوم\" clauses function as temporal restrictors (ẓurūf) binding each predicate to that single, all-encompassing moment; the accumulation of names (أسامي) serves not as mere repetition but as focused predication upon the multifarious realities of a single event.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"}],"23":[{"arabic":"صلواتهم يحافظون والذين هم على صلاتهم دائمون والذين هم يناجون الله على قدر استطاعتهم في العبودية فليعرض الإنسان نفسه على هذه الصلاة فبالقدر الذي يسر له منه ينبغي أن يفرح وعلى ما يفوته ينبغي أن يتحسر وفي مداراة ذلك ينبغي أن يجتهد وأما صلاة الغافلين فهي مخطرة إلا أن يتغمده الله برحمته والرحمة واسعة والكرم فائض فنسأل الله أن يتغمدنا برحمته ويغمرنا بمغفرته إذ لا وسيلة لنا إلا الاعتراف بالعجز عن القيام بطاعته واعلم ان تخليص الصلاة عن الآفات وإخلاصها لوجه الله عز وجل وأداءها بالشروط الباطنة التي","english":"For the friends of God (awliyāʾ Allāh) who are granted unveiling of the dominion of the heavens and the earth (malakūt al-samāwāt wa-al-arḍ) and the secrets of lordship (asrār al-rubūbiyyah) — they are unveiled only in prayer, especially in prostration (sujūd), for the servant draws near to his Lord (Mighty and Majestic) through prostration. For this reason, He said, Most High: {«And prostrate and draw near»} (Q 96:19). And the unveiling of each worshiper is only to the measure of his purity from the turbidities of this world. It varies in strength and weakness, in abundance and scarcity, and in clarity and obscurity — until some are unveiled the very thing itself (al-shayʾ bi-ʿaynihi), while others are unveiled its likeness (al-shayʾ bi-mithālihi), just as some were shown this world in the form of a corpse, and Satan in the form of a dog crouching upon it, calling people to it.","book_title":"Mysteries of Prayer","section_title_ar":"Section 140","section_title_en":"The Prayer of the Humble and the Unveiling of the Unveiled — Section 140","section_index":140,"anchors":"- Root: خ ش ع (kh-sh-ʿ)\n  * Lisan / Ayn: Core meaning of humility, submissiveness, and lowering oneself; the physical posture of one who is abased before a greater power.\n  * Al-Raghib (Mufradat): In theological terms, khushūʿ is the state of the heart's stillness and trembling before divine majesty, manifesting in the body's composure during ritual prayer (ṣalāh).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) refers to the physical lowering of the gaze and voice; metaphorical (majāz) extends to the soul's inner quietude and awe before God.\n- Root: ك ش ف (k-sh-f)\n  * Lisan / Ayn: To remove a covering, unveil, disclose; the act of stripping away an obstruction to reveal what lies beneath.\n  * Al-Raghib (Mufradat): In Quranic usage, kashf denotes divine removal of veils (kashf al-ḥijāb) — the uncovering of unseen realities (ghayb) to the heart, as in {«We have removed from you your covering»} (Q 50:22).\n  * Al-Zamakhshari (Asas): Literal: uncovering a physical object; metaphorical: the disclosure of spiritual truths (mukāshafah) to the purified heart, a technical term in Sufi epistemology.\n- Root: ص ل و (ṣ-l-w)\n  * Lisan / Ayn: The root denotes supplication, blessing, and the act of ritual prayer; also the burning of fire (iṣlāʾ), suggesting the consuming fervor of devotion.\n  * Al-Raghib (Mufradat): Al-ṣalāh is the act of turning toward God in worship, encompassing both the physical rites and the inner orientation of the soul; its perfection lies in the presence of the heart.\n  * Al-Zamakhshari (Asas): Literal: the performance of the prescribed ritual; metaphorical: the soul's \"burning\" with longing and its purification through the fire of sincere devotion.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The use of restrictive particles to single out the specific quality (khushūʿ) as the defining attribute of the believers' prayer, distinguishing it from mere mechanical performance.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Prayer'","badge":"Insight"}],"28":[{"arabic":"وجل إن عذاب ربهم غير مأمون فأجهل الناس من أمنه وهو ينادي بالتحذير من الأمن ولو أن الله لطف بعباده العارفين إذ روح قلوبهم بروح الرجاء لاحترقت قلوبهم من نار الخوف فأسباب الرجاء رحمة لخواص الله وأسباب الغفلة رحمة على عوام الخلق من وجه إذ لو انكشف الغطاء لزهقت النفوس وتقطعت القلوب من خوف مقلب القلوب قال بعض العارفين لو حالت بيني وبين من عرفته بالتوحيد خمسين","english":"Just as Abraham (peace be upon him), when he was placed in the catapult, said: \"God is sufficient for me\" {حسبي الله} — and this was among the greatest supplications — he was tested and was confronted by Gabriel in mid-air, who said to him: \"Do you have any need?\" He replied: \"As for you, no.\" And that was the fulfillment of the very reality of his words: \"God is sufficient for me.\" So God Most High informed us about him, saying: \"And Abraham who fulfilled\" {وإبراهيم الذي وفى} — that is, fulfilled the requirement of his saying \"God is sufficient for me.\" And in like manner, He informed us about Moses (peace be upon him), where he said: \"Indeed, we fear that he may assault us or that he may transgress\" {إننا نخاف أن يفرط علينا أو أن يطغى}. He said: \"Fear not; indeed, I am with you both; I hear and I see\" {لا تخافا إنني معكما أسمع وأرى}. Yet despite this, when the sorcerers cast their sorcery, Moses conceived within himself a fear — because he did not feel secure from the deception (makar) of God, and the matter became obscure to him — until security was renewed for him, and it was said to him: \"Fear not; indeed, you are the most exalted\" {لا تخف إنك أنت الأعلى}. And when the strength of the Muslims weakened on the Day of Badr, he (peace be upon him) said: \"O God, if You destroy this band, there will remain no one on the face of the earth who worships You\" — a hadith reported on the Day of Badr: \"O God, if You destroy this band, there will remain no one on the face of the earth who worships You,\" transmitted by al-Bukhari from the hadith of Ibn Abbas with the wording: \"O God, if You will, You will not be worshipped after this day\" — to the end of the hadith. So Abu Bakr (may God be pleased with him) said: \"Leave off your importuning of your Lord, for He will surely fulfill what He has promised you.\" Thus, the station of al-Siddiq (may God be pleased with him) was the station of trust in God's promise, while the station of the Messenger of God (peace be upon him) was the station of fear of God's deception (makar) — and this latter is more complete, for it issues only from the perfection of knowledge of God's secrets, the hidden aspects of His acts, and the meanings of His attributes, some of whose manifestations are expressed as \"deception\" (makar). And no human being can stand upon the ultimate reality (kunnah) of God's attributes. Whoever knows the true nature of knowledge — that his knowledge falls short of encompassing the ultimate reality of things — his fear inevitably magnifies. For this reason, the Messiah (peace be upon him), when it was said to him: \"Did you say to the people: 'Take me and my mother as two gods besides God?'\" replied: \"Glory be to You! It was not mine to say what I had no right to say. If I had said it, You would have known it. You know what is in my self, and I do not know what is in Your Self\" {سبحانك ما يكون لي أن أقول ما ليس لي بحق إن كنت قلته فقد علمته تعلم ما في نفسي ولا أعلم ما في نفسك}. And he said: \"If You punish them, indeed they are Your servants; and if You forgive them...\" {إن تعذبهم فإنهم عبادك وإن تغفر لهم} — to the end of the verse. So he delegated the matter entirely to the divine will (mashī'ah) and removed himself completely from the equation, knowing that he had no say in the affair whatsoever, and that all matters are linked to the divine will in a linkage that exceeds the bounds of rational categories and habitual patterns — such that no judgment can be passed upon them by analogy, nor by conjecture, nor by reckoning (ḥisbān), let alone by verification and certainty. And this is precisely what has rent the hearts of the knowers (ʿārifīn) asunder — for the supreme calamity (al-ṭāmmah al-kubrā) is the linkage of your affair to the will of One who does not care about you: if He destroys you, He has destroyed countless others like you, and He has never ceased in this world to torment them with various kinds of pains and diseases, and to sicken their hearts thereby with disbelief and hypocrisy, and then to perpetuate the punishment upon them for all eternity. Then He informs us about this, saying: \"And had We willed, We would have given every soul its guidance, but the word from Me has taken effect: I will surely fill Hell with jinn and people all together\" {ولو شئنا لآتينا كل نفس هداها ولكن حق القول مني لأملأن جهنم من الجنة والناس أجمعين}. And He Most High said: \"And the word of your Lord has been fulfilled: I will surely fill Hell...\" {وتمت كلمة ربك لأملأن جهنم}. So how should one not fear what has been decreed as a word from eternity (al-azal), and not hope for its reversal? Had the matter been recent, then hopes might extend toward some stratagem regarding it — but there is nothing except submission to it, and the discernment of the hidden precedent (al-sābiqah) from the manifest outward causes upon the heart and the bodily members. For whoever is facilitated toward the causes of evil, and is barred from the causes of good, and whose attachment to this world is firmly secured — it is as if the secret of the prior decree that destined him to wretchedness has been unveiled to him with certainty, since \"everyone is facilitated toward that for which he was created\" {كل ميسر لما خلق له}. And even if all good things were facilitated, and the heart were entirely severed from this world, with its outward and inward aspects turned wholly toward God, this would necessitate a lightening of fear — were continuity in that state to be trusted. But the peril of the final end (khātimah) and the difficulty of steadfastness only fan the flames of fear into greater blaze and prevent them from being extinguished. For how can one feel secure from the change of state, when the believer's heart lies between two fingers of the fingers of the Merciful? And indeed, the heart is more prone to turning than a boiling pot. And the Turner of Hearts (Glory be to Him) has said: \"Indeed, the punishment of their Lord is not to be felt secure from\" {إن عذاب ربهم غير مأمون}. So the most ignorant of people is the one who feels secure from it, while He proclaims the warning against security. And were God to show kindness to His knowing servants by reviving their hearts with the spirit of hope (rajā'), their hearts would still burn from the fire of fear. Thus, the causes of hope are a mercy for God's elect, and the causes of heedlessness are a mercy upon the common folk of creation in one respect — for were the veil to be lifted, souls would perish and hearts would be torn asunder from the fear of the Turner of Hearts. One of the knowers said: \"If fifty were to intervene between me and the One I have known through tawḥīd...\"","book_title":"Fear and Hope","section_title_ar":"Section 1051","section_title_en":"The Reality of Fear and the Station of Abraham, Moses, and the Messenger (Peace Be Upon Them) — On the Inescapable Terror of the Divine Decree","section_index":1051,"anchors":"- Root: حسب (ḥ-s-b)\n  * Lisan / Ayn: Core meaning of counting, reckoning, and sufficiency; \"ḥasbī Allāh\" signifies God as the sufficient reckoner.\n  * Al-Raghib (Mufradat): Theological nuance of ḥisāb as divine accounting; \"ḥasbī Allāh\" is a declaration of total reliance on God's sufficiency, transcending mere numerical count.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — reckoning by number; Metaphorical (majāz) — trusting in God's sufficiency as an act of spiritual accounting, where the servant counts God as enough against all else.\n- Root: خوف (kh-w-f)\n  * Lisan / Ayn: Core meaning of fear, dread, and apprehension of harm.\n  * Al-Raghib (Mufradat): Khawf is the expectation of a disliked outcome based on a probable or known sign; it opposes amn (security) and applies to both worldly and otherworldly matters.\n  * Al-Zamakhshari (Asas): Literal — fear of loss or harm; Metaphorical — a \"fearful path\" (ṭarīq khā'if) where danger inheres in the object, and \"takhawwuf\" as gradual diminishment, implying fear's erosive effect on the soul.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: Core meaning of self, soul, breath; the essence of a thing.\n  * Al-Raghib (Mufradat): Nafs as the self or essence (dhāt), as in \"ta'lamu mā fī nafsī\" (You know what is in my self), denoting the innermost reality distinct from the body.\n  * Al-Zamakhshari (Asas): Literal — the soul as animate essence; Metaphorical — \"nafs sā'ilah\" (flowing blood) as the life-principle, and the soul's hidden movements as the locus of divine knowledge.\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: Core meaning of turning, overturning, and transformation.\n  * Al-Raghib (Mufradat): Qalb is the turning of a thing from one state to another; the heart is so named for its constant fluctuation (taqallub) between states.\n  * Al-Zamakhshari (Asas): Literal — physical overturning; Metaphorical — the heart's perpetual oscillation, as in the prophetic hadith of the heart between two fingers of the Merciful, and the \"turning\" of affairs by divine decree.\n- Sibawayh Rule: Rule of Interposition and Apposition (al-ʿaṭf wa al-faṣl) — The periodic structure of \"fa-kayfa lā yakhāfu...\" (How then should one not fear...) employs a rhetorical question governed by an implied causal clause, where the apodosis is suspended across multiple subordinate clauses, requiring the translator to preserve the cumulative force of the argument without breaking the syntactic chain.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'","badge":"Insight"}],"32":[{"arabic":"يعلم بأن الله يرى وقال الله تعالى إن الله كان عليكم رقيبا وقال تعالى والذين هم لأماناتهم وعهدهم راعون والذين هم بشهاداتهم قائمون وقال ابن المبارك لرجل راقب الله تعالى فسأله عن تفسيره فقال كن أبدا كأنك ترى الله عز وجل وقال عبد الواحد بن زيد إذا كان سيدي رقيبا على فلا أبالى بغيره وقال أبو عثمان المغربي أفضل ما يلزم الإنسان نفسه في هذه الطريقة المحاسبة والمراقبة وسياسة عمله بالعلم وقال ابن عطاء أفضل الطاعات مراقبة الحق على دوام الأوقات وقال الجريري أمرنا هذا مبنى على أصلين أن تلزم نفسك المراقبة لله عز وجل ويكون العلم على ظاهرك قائما وقال أبو عثمان قال لي أبو حفص إذا ج","english":"As for its excellence: Gabriel, peace be upon him, asked about iḥsān (perfection of worship), and he, peace be upon him, replied: \"That you worship Allah as though you see Him.\" {«أن تعبد الله كأنك تراه»} And he, peace be upon him, also said: \"Worship Allah as though you see Him; for if you do not see Him, verily He sees you.\" {«اعبد الله كأنك تراه فإن لم تكن تراه فإنه يراك»} And Allah, Exalted is He, has said: {«أفمن هو قائم على كل نفس بما كسبت»} — \"Is He who stands over every soul with what it has earned [like any other]?\" And He said: {«ألم يعلم بأن الله يرى»} — \"Does he not know that Allah sees?\" And Allah, Exalted is He, said: {«إن الله كان عليكم رقيبا»} — \"Verily, Allah is ever a Watcher (raqīb) over you.\" And He said: {«والذين هم لأماناتهم وعهدهم راعون والذين هم بشهاداتهم قائمون»} — \"And those who are keepers of their trusts and their covenant, and those who stand firm in their testimonies.\"","book_title":"Monitoring and Accounting","section_title_ar":"Section 1233","section_title_en":"The Second Station of Vigilance: Murāqabah (Spiritual Watchfulness)","section_index":1233,"anchors":"- Root: رقب (R-Q-B)\n  * Lisan / Ayn: To watch, guard, observe attentively; the neck (as that which turns to observe); a lookout post.\n  * Al-Raghib (Mufradat): Murāqabah entails the heart's persistent awareness of divine proximity; it is the theological state wherein the servant knows Allah is witness over his secret and public acts.\n  * Al-Zamakhshari (Asas): Haqiqah (literal): physical watching/awaiting. Majaz (metaphorical): \"This matter is upon your necks\" (في رقابكم) — i.e., an inescapable obligation; likewise, murāqabah of Allah is the soul's standing under the watchful eye of the King, a transferred sense denoting reverent vigilance.\n- Sibawayh Rule: Restriction & Focused Predication (باب الحصر والتقييد) — governing the conditional structures \"إذا... فلا يبقى إلا...\" and \"إنها إن تركت طغت وفسدت,\" where the apodosis is restricted to a single remaining duty.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'","badge":"Insight"}]},"wordTiming":{"abdulbasit":{"1":[[1,400,1454],[2,1454,3868],[3,3868,5752],[4,5752,7508]],"2":[[1,350,2483],[2,2483,3351],[3,3351,3809],[4,3809,4965]],"3":[[1,350,1039],[2,1039,1827],[3,1827,2346],[4,2346,3763]],"4":[[1,400,1505],[2,1505,3609],[3,3609,5490],[4,5490,6700],[5,6700,7358],[6,7358,8410],[7,8410,9357],[8,9357,11198],[9,11198,12697],[10,12697,13539],[11,13539,14300]],"5":[[1,350,1553],[2,1553,2900],[3,2900,4495]],"6":[[1,350,1981],[2,1981,3715],[3,3715,5566]],"7":[[1,250,1785],[2,1785,3208]],"8":[[1,350,1426],[2,1426,2636],[3,2636,5107],[4,5107,6506]],"9":[[1,350,1779],[2,1779,3184],[3,3184,4469]],"10":[[1,350,1288],[2,1288,2180],[3,2180,3232],[4,3232,4651]],"11":[[1,400,3043],[2,3043,4277],[3,4277,5719],[4,5719,6368],[5,6368,7927],[6,7927,8447],[7,8447,9720],[8,9720,11382],[9,11382,12784]],"12":[[1,350,2142],[2,2142,3607]],"13":[[1,350,2327],[2,2327,3424],[3,3424,4678]],"14":[[1,400,1420],[2,1420,2148],[3,2148,3546],[4,3546,5381],[5,5381,6415],[6,6415,8135]],"15":[[1,350,2237],[2,2237,3916],[3,3916,5200]],"16":[[1,350,1720],[2,1720,3607]],"17":[[1,350,1723],[2,1723,2142],[3,2142,3075],[4,3075,4782]],"18":[[1,250,1134],[2,1134,2790]],"19":[[1,350,1454],[2,1454,3347],[3,3347,4345],[4,4345,6219]],"20":[[1,350,1230],[2,1230,2093],[3,2093,3255],[4,3255,46