{"surah":70,"verses":[{"ayah":1,"text":"سَأَلَ سَآئِلٌۢ بِعَذَابٍ وَاقِعٍ ","translation":"A supplicant asked for a punishment bound to happen[1]","words":[{"id":1,"arabic":"سَأَلَ","translit":"َlَaʾَs","root":"سال"},{"id":2,"arabic":"سَآئِلٌۢ","translit":"ٌۢlِyʾٓāَs","root":"سال"},{"id":3,"arabic":"بِعَذَابٍ","translit":"ٍbāَhdَʿعِb","root":"عذب"},{"id":4,"arabic":"وَاقِعٍ","translit":"ٍʿعِqāَw","root":"وقع"}],"hasIhya":false},{"ayah":2,"text":"لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌ ","translation":"To the disbelievers; of it there is no preventer.","words":[{"id":1,"arabic":"لِّلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlِّl","root":"كفر"},{"id":2,"arabic":"لَيْسَ","translit":"َsْyَl","root":"ليس"},{"id":3,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":4,"arabic":"دَافِعٌ","translit":"ٌʿعِfāَd","root":"دفع"}],"hasIhya":false},{"ayah":3,"text":"مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ ","translation":"[It is] from Allāh, owner of the ways of ascent.","words":[{"id":1,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":2,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":3,"arabic":"ذِى","translit":"àِhd","root":""},{"id":4,"arabic":"ٱلْمَعَارِجِ","translit":"ِjgِrāَʿعَmْlٱ","root":"عرج"}],"hasIhya":false},{"ayah":4,"text":"تَعْرُجُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ ","translation":"The angels and the Spirit [i.e., Gabriel] will ascend to Him during a Day the extent of which is fifty thousand years.","words":[{"id":1,"arabic":"تَعْرُجُ","translit":"ُjgُrْʿعَt","root":"عرج"},{"id":2,"arabic":"ٱلْمَلَٰٓئِكَةُ","translit":"ُẗَkِyʾَٰٓlَmْlٱ","root":"ملك"},{"id":3,"arabic":"وَٱلرُّوحُ","translit":"ُḥwُّrlٱَw","root":"روح"},{"id":4,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"يَوْمٍ","translit":"ٍmْwَy","root":"يوم"},{"id":7,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":8,"arabic":"مِقْدَارُهُۥ","translit":"ۥُhُrāَdْqِm","root":"قدر"},{"id":9,"arabic":"خَمْسِينَ","translit":"َnyِsْmَhk","root":"خمس"},{"id":10,"arabic":"أَلْفَ","translit":"َfْlَaʾ","root":"الف"},{"id":11,"arabic":"سَنَةٍ","translit":"ٍẗَnَs","root":"سنو"}],"hasIhya":true},{"ayah":5,"text":"فَٱصْبِرْ صَبْرًا جَمِيلًا ","translation":"So be patient with gracious patience.","words":[{"id":1,"arabic":"فَٱصْبِرْ","translit":"ْrِbْṣٱَf","root":"صبر"},{"id":2,"arabic":"صَبْرًا","translit":"āًrْbَṣ","root":"صبر"},{"id":3,"arabic":"جَمِيلًا","translit":"āًlyِmَjg","root":"جمل"}],"hasIhya":false},{"ayah":6,"text":"إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًا ","translation":"Indeed, they see it [as] distant,","words":[{"id":1,"arabic":"إِنَّهُمْ","translit":"ْmُhَّnِiʾ","root":""},{"id":2,"arabic":"يَرَوْنَهُۥ","translit":"ۥُhَnْwَrَy","root":"راي"},{"id":3,"arabic":"بَعِيدًا","translit":"āًdyِʿعَb","root":"بعد"}],"hasIhya":true},{"ayah":7,"text":"وَنَرَىٰهُ قَرِيبًا ","translation":"But We see it [as] near.","words":[{"id":1,"arabic":"وَنَرَىٰهُ","translit":"ُhٰàَrَnَw","root":"راي"},{"id":2,"arabic":"قَرِيبًا","translit":"āًbyِrَq","root":"قرب"}],"hasIhya":false},{"ayah":8,"text":"يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ ","translation":"On the Day the sky will be like murky oil,[1]","words":[{"id":1,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":2,"arabic":"تَكُونُ","translit":"ُnwُkَt","root":"كون"},{"id":3,"arabic":"ٱلسَّمَآءُ","translit":"ُءٓāَmَّslٱ","root":"سمو"},{"id":4,"arabic":"كَٱلْمُهْلِ","translit":"ِlْhُmْlٱَk","root":"مهل"}],"hasIhya":false},{"ayah":9,"text":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ","translation":"And the mountains will be like wool,[1]","words":[{"id":1,"arabic":"وَتَكُونُ","translit":"ُnwُkَtَw","root":"كون"},{"id":2,"arabic":"ٱلْجِبَالُ","translit":"ُlāَbِjgْlٱ","root":"جبل"},{"id":3,"arabic":"كَٱلْعِهْنِ","translit":"ِnْhِʿعْlٱَk","root":"عهن"}],"hasIhya":false},{"ayah":10,"text":"وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا ","translation":"And no friend will ask [anything of] a friend,","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"يَسْـَٔلُ","translit":"ُlَٔـْsَy","root":"سال"},{"id":3,"arabic":"حَمِيمٌ","translit":"ٌmyِmَḥ","root":"حمم"},{"id":4,"arabic":"حَمِيمًا","translit":"āًmyِmَḥ","root":"حمم"}],"hasIhya":false},{"ayah":11,"text":"يُبَصَّرُونَهُمْۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ ","translation":"They will be shown each other. The criminal will wish that he could be ransomed from the punishment of that Day by his children","words":[{"id":1,"arabic":"يُبَصَّرُونَهُمْ","translit":"ْmُhَnwُrَّṣَbُy","root":"بصر"},{"id":2,"arabic":"يَوَدُّ","translit":"ُّdَwَy","root":"ودد"},{"id":3,"arabic":"ٱلْمُجْرِمُ","translit":"ُmِrْjgُmْlٱ","root":"جرم"},{"id":4,"arabic":"لَوْ","translit":"ْwَl","root":""},{"id":5,"arabic":"يَفْتَدِى","translit":"àِdَtْfَy","root":"فدي"},{"id":6,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":7,"arabic":"عَذَابِ","translit":"ِbāَhdَʿع","root":"عذب"},{"id":8,"arabic":"يَوْمِئِذٍۭ","translit":"ٍۭhdِyʾِmْwَy","root":"يوم"},{"id":9,"arabic":"بِبَنِيهِ","translit":"ِhyِnَbِb","root":"بني"}],"hasIhya":false},{"ayah":12,"text":"وَصَٰحِبَتِهِۦ وَأَخِيهِ ","translation":"And his wife and his brother","words":[{"id":1,"arabic":"وَصَٰحِبَتِهِۦ","translit":"ۦِhِtَbِḥَٰṣَw","root":"صحب"},{"id":2,"arabic":"وَأَخِيهِ","translit":"ِhyِhkَaʾَw","root":"اخو"}],"hasIhya":false},{"ayah":13,"text":"وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ ","translation":"And his nearest kindred who shelter him","words":[{"id":1,"arabic":"وَفَصِيلَتِهِ","translit":"ِhِtَlyِṣَfَw","root":"فصل"},{"id":2,"arabic":"ٱلَّتِى","translit":"àِtَّlٱ","root":""},{"id":3,"arabic":"تُـْٔوِيهِ","translit":"ِhyِwْٔـُt","root":"اوي"}],"hasIhya":false},{"ayah":14,"text":"وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ ","translation":"And whoever is on earth entirely [so] then it could save him.","words":[{"id":1,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":2,"arabic":"فِى","translit":"àِf","root":""},{"id":3,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":4,"arabic":"جَمِيعًا","translit":"āًʿعyِmَjg","root":"جمع"},{"id":5,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":6,"arabic":"يُنجِيهِ","translit":"ِhyِjgnُy","root":"نجو"}],"hasIhya":false},{"ayah":15,"text":"كَلَّآۖ إِنَّهَا لَظَىٰ ","translation":"No![1] Indeed, it is the Flame [of Hell],","words":[{"id":1,"arabic":"كَلَّآ","translit":"ٓāَّlَk","root":""},{"id":2,"arabic":"إِنَّهَا","translit":"āَhَّnِiʾ","root":""},{"id":3,"arabic":"لَظَىٰ","translit":"ٰàَẓَl","root":""}],"hasIhya":false},{"ayah":16,"text":"نَزَّاعَةً لِّلشَّوَىٰ ","translation":"A remover of exteriors.[1]","words":[{"id":1,"arabic":"نَزَّاعَةً","translit":"ًẗَʿعāَّzَn","root":"نزع"},{"id":2,"arabic":"لِّلشَّوَىٰ","translit":"ٰàَwَّhslِّl","root":"شوي"}],"hasIhya":false},{"ayah":17,"text":"تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ ","translation":"It invites he who turned his back [on truth] and went away [from obedience]","words":[{"id":1,"arabic":"تَدْعُوا۟","translit":"۟āwُʿعْdَt","root":"دعو"},{"id":2,"arabic":"مَنْ","translit":"ْnَm","root":""},{"id":3,"arabic":"أَدْبَرَ","translit":"َrَbْdَaʾ","root":"دبر"},{"id":4,"arabic":"وَتَوَلَّىٰ","translit":"ٰàَّlَwَtَw","root":"ولي"}],"hasIhya":false},{"ayah":18,"text":"وَجَمَعَ فَأَوْعَىٰٓ ","translation":"And collected [wealth] and hoarded.","words":[{"id":1,"arabic":"وَجَمَعَ","translit":"َʿعَmَjgَw","root":"جمع"},{"id":2,"arabic":"فَأَوْعَىٰٓ","translit":"ٰٓàَʿعْwَaʾَf","root":"وعي"}],"hasIhya":false},{"ayah":19,"text":"إِنَّ ٱلْإِنسَٰنَ خُلِقَ هَلُوعًا ","translation":"Indeed, mankind was created anxious:","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلْإِنسَٰنَ","translit":"َnَٰsnِiʾْlٱ","root":"انس"},{"id":3,"arabic":"خُلِقَ","translit":"َqِlُhk","root":"خلق"},{"id":4,"arabic":"هَلُوعًا","translit":"āًʿعwُlَh","root":"هلع"}],"hasIhya":false},{"ayah":20,"text":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا ","translation":"When evil touches him, impatient,","words":[{"id":1,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":2,"arabic":"مَسَّهُ","translit":"ُhَّsَm","root":"مسس"},{"id":3,"arabic":"ٱلشَّرُّ","translit":"ُّrَّhslٱ","root":"شرر"},{"id":4,"arabic":"جَزُوعًا","translit":"āًʿعwُzَjg","root":"جزع"}],"hasIhya":false},{"ayah":21,"text":"وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا ","translation":"And when good touches him, withholding [of it],","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"مَسَّهُ","translit":"ُhَّsَm","root":"مسس"},{"id":3,"arabic":"ٱلْخَيْرُ","translit":"ُrْyَhkْlٱ","root":"خير"},{"id":4,"arabic":"مَنُوعًا","translit":"āًʿعwُnَm","root":"منع"}],"hasIhya":false},{"ayah":22,"text":"إِلَّا ٱلْمُصَلِّينَ ","translation":"Except the observers of prayer -","words":[{"id":1,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":2,"arabic":"ٱلْمُصَلِّينَ","translit":"َnyِّlَṣُmْlٱ","root":"صلو"}],"hasIhya":false},{"ayah":23,"text":"ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ ","translation":"Those who are constant in their prayer","words":[{"id":1,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":2,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":3,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":4,"arabic":"صَلَاتِهِمْ","translit":"ْmِhِtāَlَṣ","root":"صلو"},{"id":5,"arabic":"دَآئِمُونَ","translit":"َnwُmِyʾٓāَd","root":"دوم"}],"hasIhya":true},{"ayah":24,"text":"وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ ","translation":"And those within whose wealth is a known right[1]","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":3,"arabic":"أَمْوَٰلِهِمْ","translit":"ْmِhِlَٰwْmَaʾ","root":"مول"},{"id":4,"arabic":"حَقٌّ","translit":"ٌّqَḥ","root":"حقق"},{"id":5,"arabic":"مَّعْلُومٌ","translit":"ٌmwُlْʿعَّm","root":"علم"}],"hasIhya":false},{"ayah":25,"text":"لِّلسَّآئِلِ وَٱلْمَحْرُومِ ","translation":"For the petitioner and the deprived -","words":[{"id":1,"arabic":"لِّلسَّا