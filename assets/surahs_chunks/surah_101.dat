{"surah": 101, "verses": [{"ayah": 1, "text": "ٱلْقَارِعَةُ ", "translation": "The Striking Calamity -", "words": [{"id": 1, "arabic": "ٱلْقَارِعَةُ", "translit": "ُẗَʿعِrāَqْlٱ", "root": "قرع"}], "hasIhya": true}, {"ayah": 2, "text": "مَا ٱلْقَارِعَةُ ", "translation": "What is the Striking Calamity?", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "ٱلْقَارِعَةُ", "translit": "ُẗَʿعِrāَqْlٱ", "root": "قرع"}], "hasIhya": false}, {"ayah": 3, "text": "وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ ", "translation": "And what can make you know what is the Striking Calamity?", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَدْرَىٰكَ", "translit": "َkٰàَrْdَaʾ", "root": "دري"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "ٱلْقَارِعَةُ", "translit": "ُẗَʿعِrāَqْlٱ", "root": "قرع"}], "hasIhya": false}, {"ayah": 4, "text": "يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ ", "translation": "It is the Day when people will be like moths, dispersed,[1]", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "يَكُونُ", "translit": "ُnwُkَy", "root": "كون"}, {"id": 3, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 4, "arabic": "كَٱلْفَرَاشِ", "translit": "ِhsāَrَfْlٱَk", "root": "فرش"}, {"id": 5, "arabic": "ٱلْمَبْثُوثِ", "translit": "ِhtwُhtْbَmْlٱ", "root": "بثث"}], "hasIhya": true}, {"ayah": 5, "text": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ ", "translation": "And the mountains will be like wool, fluffed up.[1]", "words": [{"id": 1, "arabic": "وَتَكُونُ", "translit": "ُnwُkَtَw", "root": "كون"}, {"id": 2, "arabic": "ٱلْجِبَالُ", "translit": "ُlāَbِjgْlٱ", "root": "جبل"}, {"id": 3, "arabic": "كَٱلْعِهْنِ", "translit": "ِnْhِʿعْlٱَk", "root": "عهن"}, {"id": 4, "arabic": "ٱلْمَنفُوشِ", "translit": "ِhswُfnَmْlٱ", "root": "نفش"}], "hasIhya": false}, {"ayah": 6, "text": "فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ ", "translation": "Then as for one whose scales are heavy [with good deeds],", "words": [{"id": 1, "arabic": "فَأَمَّا", "translit": "āَّmَaʾَf", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "ثَقُلَتْ", "translit": "ْtَlُqَht", "root": "ثقل"}, {"id": 4, "arabic": "مَوَٰزِينُهُۥ", "translit": "ۥُhُnyِzَٰwَm", "root": "وزن"}], "hasIhya": true}, {"ayah": 7, "text": "فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ ", "translation": "He will be in a pleasant life.", "words": [{"id": 1, "arabic": "فَهُوَ", "translit": "َwُhَf", "root": ""}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "عِيشَةٍ", "translit": "ٍẗَhsyِʿع", "root": "عيش"}, {"id": 4, "arabic": "رَّاضِيَةٍ", "translit": "ٍẗَyِḍāَّr", "root": "رضو"}], "hasIhya": false}, {"ayah": 8, "text": "وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ ", "translation": "But as for one whose scales are light,", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "āَّmَaʾَw", "root": ""}, {"id": 2, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 3, "arabic": "خَفَّتْ", "translit": "ْtَّfَhk", "root": "خفف"}, {"id": 4, "arabic": "مَوَٰزِينُهُۥ", "translit": "ۥُhُnyِzَٰwَm", "root": "وزن"}], "hasIhya": false}, {"ayah": 9, "text": "فَأُمُّهُۥ هَاوِيَةٌ ", "translation": "His refuge[1] will be an abyss.[2]", "words": [{"id": 1, "arabic": "فَأُمُّهُۥ", "translit": "ۥُhُّmُaʾَf", "root": "امم"}, {"id": 2, "arabic": "هَاوِيَةٌ", "translit": "ٌẗَyِwāَh", "root": "هوي"}], "hasIhya": false}, {"ayah": 10, "text": "وَمَآ أَدْرَىٰكَ مَا هِيَهْ ", "translation": "And what can make you know what that is?", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَدْرَىٰكَ", "translit": "َkٰàَrْdَaʾ", "root": "دري"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "هِيَهْ", "translit": "ْhَyِh", "root": ""}], "hasIhya": false}, {"ayah": 11, "text": "نَارٌ حَامِيَةٌۢ ", "translation": "It is a Fire, intensely hot.", "words": [{"id": 1, "arabic": "نَارٌ", "translit": "ٌrāَn", "root": "نور"}, {"id": 2, "arabic": "حَامِيَةٌۢ", "translit": "ٌۢẗَyِmāَḥ", "root": "حمي"}], "hasIhya": false}], "tafsir": {"4": [{"arabic": "هباء منبثا يوم يكون الناس كالفراش المبثوث وتكون الجبال كالعهن المنفوش يوم تذهل فيه كل مرضعة عما أرضعت وتضع كل ذات حمل حملها وترى الناس سكارى وما هم بسكارى ولكن عذاب الله شديد يوم تبدل الأرض غير الأرض والسموات وبرزوا لله الواحد القهار يوم تنسف فيه الجبال نسفا فتترك قاعا صفصفا لا ترى فيها عوجا ولا أمتا يوم ترى الجبال تحسبها جامدة وهي تمر مر السحاب يوم تنشق فيه السماء فتكون وردة كالدهان فيومئذ لا يسئل عن ذنبه إنس ولا جان يوم يمنع فيه العاصى من الكلام ولا يسئل فيه عن الأجرام بل يؤخذ بالنواصى", "english": "So prepare yourself, O wretched one, for this Day of immense magnitude, of prolonged duration, of overwhelming dominion, whose appointed time is near — a Day when you shall see the heaven split asunder, and the stars scattered in its terror, and the shining planets extinguished, and the sun folded up, and the mountains set in motion, and the pregnant camels neglected, and the wild beasts gathered together, and the seas set ablaze, and the souls paired with their bodies, and the Hellfire ignited, and Paradise brought near, and the mountains pulverized, and the earth stretched out — a Day when you shall see the earth shaken with its quaking, and the earth casts forth its burdens. On that Day shall people issue forth in scattered groups to be shown their deeds — a Day when the earth and the mountains are lifted and crushed with a single crushing. Then on that Day the Imminent Event shall come to pass, and the heaven shall split open, for on that Day it shall be frail, and the angels shall be at its edges, and eight shall bear the Throne of your Lord above them on that Day. On that Day you shall be presented — no secret of yours shall remain hidden. A Day when the mountains shall move and you shall see the earth laid bare — a Day when the earth shall be shaken with a violent shaking, and the mountains crumbled to dust, becoming scattered particles — a Day when people shall be like scattered moths, and the mountains like carded wool — a Day when every nursing mother shall forget what she nursed, and every pregnant female shall cast down her burden, and you shall see people drunk, yet they are not drunk, but the chastisement of God is severe — a Day when the earth shall be changed to other than this earth, and the heavens, and they shall appear before God, the One, the All-Compelling — a Day when the mountains shall be blown away as dust, leaving a level, bare plain, wherein you see no crookedness nor curve — a Day when you see the mountains and suppose them solid, yet they pass by like the passing of clouds — a Day when the heaven shall split open and become rosy like molten oil. Then on that Day no human nor jinn shall be asked about his sin. A Day when the disobedient shall be prevented from speech, and shall not be asked about their crimes, but shall be seized by their forelocks and their feet — a Day when every soul shall find what it did of good brought forth present, and what it did of evil, wishing that between it and that evil there were a far distance — a Day when every soul shall know what it has sent ahead, and shall witness what it has forwarded and what it has left behind — a Day when tongues shall be struck mute and the bodily members shall speak — a Day whose mention turned the hair of the Master of the Messengers white, when al-Ṣiddīq (may God be pleased with him) said to him: \"I see that you have turned white-haired, O Messenger of God.\" He said: \"Sūrat Hūd and its sisters have made me white-haired\" — namely, al-Wāqiʿah, al-Mursalāt, ʿAmma Yatasāʾalūn, and Idhā al-Shamsu Kuwwirat.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1339", "section_title_en": "The Names and Attributes of the Day of Resurrection — An Exhortation to the Negligent", "section_index": 1339, "anchors": "- Root: يوم (yawm)\n  * Lisan / Ayn: \"اليوم: وقت طلوع الشمس إلى غروبها، وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day as a temporal span, extended metaphorically to any epoch or era.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — theological usage denotes the appointed time of reckoning, magnified by divine attribution (أيام الله).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): a measured solar period. Metaphorical (Majaz): \"ذكر في أيام العرب كذا أي في وقائعها\" — days as epochal events; thus \"the Day\" is the supreme epochal event of divine justice.\n- Root: نفس (nafs)\n  * Lisan / Ayn: النفس: الروح والذات — the self, soul, or very essence.\n  * Al-Raghib (Mufradat): \"النفس: الروح... وقوله: ويحذركم الله نفسه فنفسه: ذاته\" — nafs as the innermost reality of a being; in the eschatological context, souls are \"paired\" (زوجت) with bodies for judgment.\n  * Al-Zamakhshari (Asas): Literal: the soul as life-principle. Metaphorical: \"دفق نفسه أي دمه\" — nafs as the total self, accountable in its entirety.\n- Root: ارض (arḍ)\n  * Lisan / Ayn: الأرض: الجرم المقابل للسماء — the earth as the corporeal substratum beneath the heavens.\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء... ويعبر بها عن أسفل الشيء\" — the earth as the lowest register of creation, subject to total transformation on that Day.\n  * Al-Zamakhshari (Asas): Literal: the physical earth. Metaphorical: \"تأرض فلان: لزم الأرض\" — to cling low; on that Day the earth itself is leveled, flattened, and replaced.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated \"يوم\" clauses function as temporal restrictors (ẓurūf) binding each predicate to that single, all-encompassing moment; the accumulation of names (أسامي) serves not as mere repetition but as focused predication upon the multifarious realities of a single event.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}, {"arabic": "فصارت وردة كالدهان وصارت السماء كالمهل وصارت الجبال كالعهن واشتبك الناس كالفراش المبثوث وهم حفاة عراة مشاة قال رسول الله صلى الله عليه وسلم يبعث الناس حفاة عراة غرلا قد ألجمهم العرق وبلغ شحوم الآذان قالت سودة زوج النبي صلى الله عليه وسلم راوية الحديث قلت يا رسول الله واسوأتاه ينظر بعضنا إلى بعض فقال شغل الناس عن ذلك بهم لكل امرىء يومئذ شأن يغنيه (2) فأعظم بيوم تنكشف فيه العورات ويؤمن فيه مع ذلك النظر والالتفات كيف وبعضهم يمشون على بطونهم ووجوههم فلا قدرة لهم على الالتفات إلى غيرهم قال أبو هريرة رضي الله عنه قال رسول الله صلى الله عليه وسلم يحشر الناس يوم القيامة ثلاثة أصناف ركبانا ومشاة وعلى وجوههم فقال رجل يا رسول الله وكيف يمشون على وجوههم قال الذى أمشاهم على أقدامهم قادر على أن يمشيهم على وجوههم (1) فى طبع الآدمى إنكار كل ما لم يأنس به ولو لم يشاهد الإنسان الحية وهى تمشى على بطنها كالبرق الخاطف لأنكر تصور المشى على غير رجل والمشى بالرجل أيضا مستبعد عند من لم يشاهد ذلك فإياك أن تنكر شيئا من عجائب يوم القيامة لمخالفته قياس ما فى الدنيا فإنك لو لم تكن قد شاهدت عجائب الدنيا ثم عرضت عليك قبل المشاهدة لكنت أشد إنكارا لها فأحضر فى قلبك صورتك وأنت واقف عاريا مكشوفا ذليلا مدحورا متحيرا مبهوتا منتظرا لما يجرى عليك من القضاء بالسعادة أو بالشقاوة وأعظم هذه الحال فإنها عظيمة", "english": "Know, O seeker, that after the resurrection and the arising from the graves, consider how they are driven — barefoot, naked, uncircumcised — to the land of the Gathering. It is a white land, a level plain, smooth and even, wherein you see no crookedness nor any curve, and upon which you see no hillock behind which a person might hide, nor any hollow that would sink him from view. Rather, it is one single, simple expanse with no variation whatsoever, and to it they are driven in troops. Glory be to Him who gathered all creatures, despite their differing kinds, from the far quarters of the earth, when He drove them by the Rajīfah (the Trembling Blast) followed by the Rādifah (the Second Blast). The Rajīfah is the first trumpet-blast, and the Rādifah is the second. Rightly are those hearts on that day agitated, and rightly are those eyes humbled. The Messenger of God, peace and blessings be upon him, said: «The people will be gathered on the Day of Resurrection upon a white, ʿafrāʾ earth, like a pure loaf of bread, upon which there is no marker for anyone.» The narrator said: \"ʿAfrah is a whiteness that is not brilliant, and al-naqī is the bread purified of its bran and husk. 'No marker' means no building that conceals, and no unevenness that repels the eye.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1336", "section_title_en": "The Description of the Trumpet-Blast and the Land of the Gathering", "section_index": 1336, "anchors": "- Root: صور (ṣ-w-r)\n  * Lisan / Ayn: Core root denotes form/shape; the \"trumpet\" (ṣūr) is that which shapes and transforms states through its blast.\n  * Al-Raghib (Mufradat): Theological nuance — the ṣūr is the instrument of cosmic transformation, linking the two blasts (rajīfah and rādifah) to the divine command of resurrection.\n  * Al-Zamakhshari (Asas): Literal — a horn/trumpet; metaphorical — the blast as the signal of universal upheaval, not a mere physical sound.\n- Root: حشر (ḥ-sh-r)\n  * Lisan / Ayn: Core meaning: to gather, drive, or assemble a multitude forcibly.\n  * Al-Raghib (Mufradat): Theologically, ḥashr is the divine gathering of all creatures to the plain of reckoning, distinct from ordinary aggregation by its comprehensiveness and compulsion.\n  * Al-Zamakhshari (Asas): Literal — herding animals; metaphorical — the compelled assembly of humanity before God, stripped of all worldly coverings.\n- Root: عفر (ʿ-f-r)\n  * Lisan / Ayn: ʿafrāʾ denotes a whitish hue tinged with redness or dust-color; the \"white\" earth of the gathering is not pure white but a dusty, pale expanse.\n  * Al-Raghib (Mufradat): The earth's transformation (tabdīl al-arḍ) signifies a new creation, not mere alteration of accidents.\n  * Al-Zamakhshari (Asas): Literal — color description; metaphorical — the earth's purity from sin and bloodshed, as the narrator glosses ʿafrāʾ as \"whiteness not brilliant.\"\n- Sibawayh Rule: Interposition of descriptive clauses (ṣifah) between subject and predicate — the extended adjectival chains (e.g., \"arḍ bayḍāʾ qāʿ ṣafṣaf...\") delay the main verb to build cumulative, awe-inducing imagery, permissible due to the semantic completeness of each descriptive unit.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "6": [{"arabic": "قد عرفت هول الميزان وخطره وأن الأعين شاخصة إلى لسان الميزان فأما من ثقلت موازينه فهو في عيشة راضية وأما من خفت موازينه فأمه هاوية وما أدراك ماهيه نار حامية واعلم أنه لا ينجو من خطر الميزان إلا من حاسب في الدنيا نفسه ووزن فيها بميزان الشرع أعماله وأقواله وخطراته ولحظاته كما قال عمر رضي الله عنه حاسبوا أنفسكم قبل أن تحاسبوا وزنوها قبل أن توزنوا وإنما حسابه لنفسه أن يتوب عن كل معصية قبل الموت توبة نصوحا ويتدارك ما فرط من تقصيره في فرائض الله تعالى ويرد المظالم حبة بعد حبة ويستحل كل من تعرض له بلسانه ويده وسوء ظنه بقلبه وبطيب قل", "english": "Know that none is saved from the peril of the Scale except him who, in this world, called his own soul to account, and weighed therein — by the scale of the Sacred Law — his deeds, his words, his passing thoughts, and his glances, just as ʿUmar — may God be well pleased with him — said: \"Call yourselves to account before you are called to account, and weigh yourselves before you are weighed.\" Indeed, his calling himself to account consists in his repenting, before death, from every act of disobedience with a sincere repentance (tawbah naṣūḥ), and in his making up for what was neglected of his shortcomings regarding the obligatory commands of God — may He be exalted — and in his restoring rights to those he wronged, grain by grain, and in his seeking absolution from everyone whom he harmed by his tongue, his hand, or his evil suspicion harbored in his heart — and this by winning their hearts' contentment — until he dies with no outstanding wrong against him, nor any neglected obligation.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1343", "section_title_en": "The Perils of the Scale and the Reckoning of Wrongs Against Others", "section_index": 1343, "anchors": "- Root: وزن (w-z-n)\n  * Lisan / Ayn: Core meaning is weighing, measuring, and balancing; al-mīzān (the Scale) is the instrument of equitable judgment.\n  * Al-Raghib (Mufradat): In theological context, al-mīzān is the divine instrument of justice on the Day of Resurrection, weighing deeds to manifest equitable recompense, not a corporeal balance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes physical weighing; metaphorical (majāz) usage extends to moral and spiritual accounting, as in \"weighing one's deeds by the scale of the Sacred Law.\"\n- Sibawayh Rule: Conditional and Exceptive Constructions (الشّرط والاستثناء) — governing the protasis-apodosis structure in \"whoever's scales are heavy... whoever's scales are light,\" and the exceptive force in \"none is saved... except he who reckons.\"", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}, {"arabic": "لا يقبل النافلة حتى تؤدى الفريضة وإنما ثقلت موازين من ثقلت موازينهم يوم القيامة باتباعهم الحق في الدنيا وثقله عليهم وحق لميزان لا يوضع فيه إلا الحق أن يثقل وإنما خفت موازين من خفت موزاينهم يوم القيامة باتباع الباطل وخفته عليهم وحق لميزان لا يوضع فيه إلاالباطل أن يخف وإن الله ذكر أهل الجنة بأحسن أعمالهم وتجاوز عن سيئاتهم فيقول القائل أنا دون هؤلاء ولا أبلغ مبلغ صالح الذي عملوا فيقول القائل أنا أفضل من هؤلاء وإن الله ذكر آية الرحمة وآية العذاب ليكون المؤمن راغبا راهبا ولا يلقى بيديه إلى التهلكة ولا يتمنى على الله غير الحق فإن حفظت وصيتي هذه فلا يكون غائب أحب إليك من الموت ولا بد لك منه وإن ضيعت وصيتي فلا يكون غائب أبغض إليك من الموت ولا بد لك منه ولست بمعجزه وقال سعيد بن المسيب لما احتضر أبو بكر رضي الله عنه أتاه ناس من الصحابة فقالوا يا خليفة رسول الله صلى الله عليه وسلم زودنا فإنا نراك لما بك فقالوا أبو بكر من قال هؤلاء الكلمات ثم مات جعل الله روحه في الأفق المبين قالوا وما الأفق المبين قال قاع بين يديالعرش فيه رياض الله وأنهار وأشجار يغشاه كل يوم مائة رحمة فمن قال هذا القول جعل الله روحه في هذا المكان اللهم إنك ابتدأت الخلق من غير حاجة بك إليهم ثم جعلتهم فريقين فريقا للنعيم وفريقا للسعير فاجعلني للنعيم ولا تجعلني للسعير اللهم إنك خلقت الخلق فرقا وميزتهم قبل أن تخلقهم فجعلت منهم شقيا وسعيدا وغويا ورشيدا فلا تشقني بمعاصيك اللهم إنك علمت ما تكسب كل نفس قبل أن تخلقها فلا محيص لها مما علمت فاجعلني ممن تستعمله بطاعتك اللهم إن أحدا لا يشاء حتى تشاء فاجعل مشيئتك أن أشاء ما يقربني إليك اللهم إنك قد قدرت حركات العباد فلا يتحرك شيء إلا بإذنك فاجعل حركاتي في تقواك اللهم إنك خلقت الخير والشر وجعلت لكل واحد منهما عاملا يعمل به فاجعلني من خير القسمين اللهم إنك خلقت الجنة والنار وجعلت لكل واحدة منهما أهلا فاجعلني من سكان جنتك اللهم إنك أردت بقوم الضلال وضيقت به صدورهم فاشرح صدري للإيمان وزينه في قلبي اللهم إنك دبرت الأمور وجعلت مصيرها إليك فأحيني بعد الموت حياة طيبة وقربني إليك زلفى اللهم من أصبح وأمسى ثقته ورجاؤه غيرك فأنت ثقتي ورجائي ولا حول ولا قوة إلا بالله قال أبو بكر هذا كله في كتاب الله عز وجل", "english": "When Abu Bakr (may Allah Most High be pleased with him) was in the throes of death, ʿĀʾishah (may Allah be pleased with her) came and recited this verse: \"By your life, wealth avails not the youth... when the breath rattles in his chest one day, and the breast is straitened thereby.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1302", "section_title_en": "The Death of Abu Bakr al-Siddiq (may Allah Most High be pleased with him)", "section_index": 1302, "anchors": "- Root: حشرج (ḥashraja)\n  * Lisan / Ayn: [Core linguistic root meaning: The rattling, gurgling sound of the death-throe in the throat; the final breath struggling in the chest.]\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance: The terminal state of the soul's separation from the body, the moment of overwhelming divine decree.]\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction: Literal — the physical rattle of the dying; Metaphorical — the constriction of the breast as the soul is drawn forth.]\n- Root: سكر (sakara)\n  * Lisan / Ayn: [Core linguistic root meaning: The veiling of the intellect; intoxication; the stupor that overcomes one at the onset of death.]\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance: The stupor of death (sakrat al-mawt) as the removal of all veils, wherein the truth of the Hereafter becomes undeniably present.]\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction: Literal — intoxication from drink; Metaphorical — the overwhelming bewilderment of the soul at death's onset.]\n- Root: ذمم (dhimam)\n  * Lisan / Ayn: [Core linguistic root meaning: The covenant of protection; the bond of safe-conduct; that which one is obligated to honor and safeguard.]\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance: The divine guarantee (dhimmat Allah) extended to the believer who prays the dawn prayer — a sacred pact not to be violated.]\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction: Literal — a pledge of security between men; Metaphorical — the inviolable covenant between the servant and his Lord.]\n- Root: وزن (wazana)\n  * Lisan / Ayn: [Core linguistic root meaning: To weigh; the balance; the measure of equivalence between two things.]\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance: The weighing of deeds on the Day of Resurrection as the manifestation of divine justice — the scales (mawāzīn) receiving only truth or falsehood.]\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction: Literal — the physical act of weighing; Metaphorical — the spiritual weighing of deeds by their conformity to truth (ḥaqq) or falsehood (bāṭil).]\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — [The particle innamā restricts the predicate exclusively to its subject, as in Abu Bakr's dictum: \"It is only that the scales of those whose scales are heavy on the Day of Resurrection are weighed down by their following the truth in this world.\"]", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}]}, "wordTiming": {"minshawi": {"1": [[1, 210, 2310]], "101:1": [[1, 210, 2310]], "2": [[1, 290, 959], [2, 959, 2460]], "101:2": [[1, 290, 959], [2, 959, 2460]], "3": [[1, 490, 2590], [2, 2590, 3938], [3, 3938, 4614], [4, 4614, 6130]], "101:3": [[1, 490, 2590], [2, 2590, 3938], [3, 3938, 4614], [4, 4614, 6130]], "4": [[1, 290, 1315], [2, 1315, 2709], [3, 2709, 4216], [4, 4216, 5908], [5, 5908, 7600]], "101:4": [[1, 290, 1315], [2, 1315, 2709], [3, 2709, 4216], [4, 4216, 5908], [5, 5908, 7600]], "5": [[1, 370, 2244], [2, 2244, 3938], [3, 3938, 5260], [4, 5260, 7170]], "101:5": [[1, 370, 2244], [2, 2244, 3938], [3, 3938, 5260], [4, 5260, 7170]], "6": [[1, 320, 2175], [2, 2175, 2698], [3, 2698, 3822], [4, 3822, 6220]], "101:6": [[1, 320, 2175], [2, 2175, 2698], [3, 2698, 3822], [4, 3822, 6220]], "7": [[1, 320, 1220], [2, 1220, 1764], [3, 1764, 2947], [4, 2947, 4810]], "101:7": [[1, 320, 1220], [2, 1220, 1764], [3, 1764, 2947], [4, 2947, 4810]], "8": [[1, 360, 2418], [2, 2418, 2902], [3, 2902, 3846], [4, 3846, 6070]], "101:8": [[1, 360, 2418], [2, 2418, 2902], [3, 2902, 3846], [4, 3846, 6070]], "9": [[1, 330, 1708], [2, 1708, 4100]], "101:9": [[1, 330, 1708], [2, 1708, 4100]], "10": [[1, 70, 2247], [2, 2247, 3644], [3, 3644, 4344], [4, 4344, 5140]], "101:10": [[1, 70, 2247], [2, 2247, 3644], [3, 3644, 4344], [4, 4344, 5140]], "11": [[1, 30, 1092], [2, 1092, 2900]], "101:11": [[1, 30, 1092], [2, 1092, 2900]]}, "abdulbasit": {"1": [[1, 500, 2080]], "101:1": [[1, 500, 2080]], "2": [[1, 650, 780], [2, 790, 2320]], "101:2": [[1, 650, 780], [2, 790, 2320]], "3": [[1, 550, 780], [2, 790, 3330], [3, 3340, 3510], [4, 3520, 4970]], "101:3": [[1, 550, 780], [2, 790, 3330], [3, 3340, 3510], [4, 3520, 4970]], "4": [[1, 900, 1420], [2, 1430, 3000], [3, 3010, 3540], [4, 3550, 5050], [5, 5060, 6370]], "101:4": [[1, 900, 1420], [2, 1430, 3000], [3, 3010, 3540], [4, 3550, 5050], [5, 5060, 6370]], "5": [[1, 850, 1820], [2, 1830, 2830], [3, 2840, 3950], [4, 3960, 6110]], "101:5": [[1, 850, 1820], [2, 1830, 2830], [3, 2840, 3950], [4, 3960, 6110]], "6": [[1, 1100, 2690], [2, 2700, 3600], [3, 3610, 4570], [4, 4580, 6080]], "101:6": [[1, 1100, 2690], [2, 2700, 3600], [3, 3610, 4570], [4, 4580, 6080]], "7": [[1, 500, 1030], [2, 1040, 1460], [3, 1470, 2370], [4, 2380, 3810]], "101:7": [[1, 500, 1030], [2, 1040, 1460], [3, 1470, 2370], [4, 2380, 3810]], "8": [[1, 600, 2280], [2, 2290, 2610], [3, 2620, 3590], [4, 3600, 5090]], "101:8": [[1, 600, 2280], [2, 2290, 2610], [3, 2620, 3590], [4, 3600, 5090]], "9": [[1, 350, 2000], [2, 2010, 3250]], "101:9": [[1, 350, 2000], [2, 2010, 3250]], "10": [[1, 500, 730], [2, 740, 3050], [3, 3060, 3480], [4, 3490, 4170]], "101:10": [[1, 500, 730], [2, 740, 3050], [3, 3060, 3480], [4, 3490, 4170]], "11": [[1, 500, 1240], [2, 1250, 2540]], "101:11": [[1, 500, 1240], [2, 1250, 2540]]}, "abdulbasit_mujawwad": {"1": [[1, 2250, 5280]], "101:1": [[1, 2250, 5280]], "2": [[1, 1200, 3490], [2, 3500, 5310]], "101:2": [[1, 1200, 3490], [2, 3500, 5310]], "3": [[1, 1900, 2610], [2, 2620, 6320], [3, 6330, 6650], [4, 6660, 9670]], "101:3": [[1, 1900, 2610], [2, 2620, 6320], [3, 6330, 6650], [4, 6660, 9670]], "4": [[1, 1700, 2480], [2, 2490, 4050], [3, 4060, 6060], [4, 6070, 8960], [5, 8970, 13380]], "101:4": [[1, 1700, 2480], [2, 2490, 4050], [3, 4060, 6060], [4, 6070, 8960], [5, 8970, 13380]], "5": [[1, 3300, 4830], [2, 4840, 6940], [3, 6950, 9320], [4, 9330, 13670]], "101:5": [[1, 3300, 4830], [2, 4840, 6940], [3, 6950, 9320], [4, 9330, 13670]], "6": [[1, 3050, 4370], [2, 4380, 6270], [3, 6280, 8050], [4, 8060, 10630]], "101:6": [[1, 3050, 4370], [2, 4380, 6270], [3, 6280, 8050], [4, 8060, 10630]], "7": [[1, 3100, 4010], [2, 4020, 4240], [3, 4250, 6410], [4, 6420, 9830]], "101:7": [[1, 3100, 4010], [2, 4020, 4240], [3, 4250, 6410], [4, 6420, 9830]], "8": [[1, 2350, 4660], [2, 4670, 5470], [3, 5480, 7140], [4, 7150, 9960]], "101:8": [[1, 2350, 4660], [2, 4670, 5470], [3, 5480, 7140], [4, 7150, 9960]], "9": [[1, 1200, 3860], [2, 3870, 6620]], "101:9": [[1, 1200, 3860], [2, 3870, 6620]], "10": [[1, 1520, 3880], [2, 3890, 5970], [3, 5980, 6770], [4, 6780, 9060]], "101:10": [[1, 1520, 3880], [2, 3890, 5970], [3, 5980, 6770], [4, 6780, 9060]], "11": [[1, 1260, 2790], [2, 2800, 6040]], "101:11": [[1, 1260, 2790], [2, 2800, 6040]]}, "abdulbasit_warsh": {"1": [[1, 450, 5259]], "101:1": [[1, 450, 5259]], "2": [[1, 450, 1737], [2, 1737, 5781]], "101:2": [[1, 450, 1737], [2, 1737, 5781]], "3": [[1, 450, 2156], [2, 2156, 4494], [3, 4494, 5378], [4, 5378, 8158]], "101:3": [[1, 450, 2156], [2, 2156, 4494], [3, 4494, 5378], [4, 5378, 8158]], "4": [[1, 450, 1401], [2, 1401, 2601], [3, 2601, 4140], [4, 4140, 6133], [5, 6133, 8080]], "101:4": [[1, 450, 1401], [2, 1401, 2601], [3, 2601, 4140], [4, 4140, 6133], [5, 6133, 8080]], "5": [[1, 450, 1714], [2, 1714, 3258], [3, 3258, 4663], [4, 4663, 6408]], "101:5": [[1, 450, 1714], [2, 1714, 3258], [3, 3258, 4663], [4, 4663, 6408]], "6": [[1, 450, 1757], [2, 1757, 2172], [3, 2172, 3023], [4, 3023, 4449]], "101:6": [[1, 450, 1757], [2, 1757, 2172], [3, 2172, 3023], [4, 3023, 4449]], "7": [[1, 450, 1413], [2, 1413, 1963], [3, 1963, 3559], [4, 3559, 5650]], "101:7": [[1, 450, 1413], [2, 1413, 1963], [3, 1963, 3559], [4, 3559, 5650]], "8": [[1, 450, 1730], [2, 1730, 2103], [3, 2103, 2672], [4, 2672, 3952]], "101:8": [[1, 450, 1730], [2, 1730, 2103], [3, 2