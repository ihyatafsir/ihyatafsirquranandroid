{"surah": 53, "verses": [{"ayah": 1, "text": "وَٱلنَّجْمِ إِذَا هَوَىٰ ", "translation": "By the star when it descends,", "words": [{"id": 1, "arabic": "وَٱلنَّجْمِ", "translit": "ِmْjgَّnlٱَw", "root": "نجم"}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "هَوَىٰ", "translit": "ٰàَwَh", "root": "هوي"}], "hasIhya": false}, {"ayah": 2, "text": "مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ ", "translation": "Your companion [i.e., Muḥammad] has not strayed, nor has he erred,", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "ضَلَّ", "translit": "َّlَḍ", "root": "ضلل"}, {"id": 3, "arabic": "صَاحِبُكُمْ", "translit": "ْmُkُbِḥāَṣ", "root": "صحب"}, {"id": 4, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 5, "arabic": "غَوَىٰ", "translit": "ٰàَwَغ", "root": "غوي"}], "hasIhya": false}, {"ayah": 3, "text": "وَمَا يَنطِقُ عَنِ ٱلْهَوَىٰٓ ", "translation": "Nor does he speak from [his own] inclination.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "يَنطِقُ", "translit": "ُqِṭnَy", "root": "نطق"}, {"id": 3, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 4, "arabic": "ٱلْهَوَىٰٓ", "translit": "ٰٓàَwَhْlٱ", "root": "هوي"}], "hasIhya": true}, {"ayah": 4, "text": "إِنْ هُوَ إِلَّا وَحْىٌ يُوحَىٰ ", "translation": "It is not but a revelation revealed,", "words": [{"id": 1, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "وَحْىٌ", "translit": "ٌàْḥَw", "root": "وحي"}, {"id": 5, "arabic": "يُوحَىٰ", "translit": "ٰàَḥwُy", "root": "وحي"}], "hasIhya": false}, {"ayah": 5, "text": "عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ ", "translation": "Taught to him by one intense in strength [i.e., Gabriel] -", "words": [{"id": 1, "arabic": "عَلَّمَهُۥ", "translit": "ۥُhَmَّlَʿع", "root": "علم"}, {"id": 2, "arabic": "شَدِيدُ", "translit": "ُdyِdَhs", "root": "شدد"}, {"id": 3, "arabic": "ٱلْقُوَىٰ", "translit": "ٰàَwُqْlٱ", "root": "قوي"}], "hasIhya": true}, {"ayah": 6, "text": "ذُو مِرَّةٍ فَٱسْتَوَىٰ ", "translation": "One of soundness.[1] And he rose to [his] true form[2]", "words": [{"id": 1, "arabic": "ذُو", "translit": "wُhd", "root": ""}, {"id": 2, "arabic": "مِرَّةٍ", "translit": "ٍẗَّrِm", "root": "مرر"}, {"id": 3, "arabic": "فَٱسْتَوَىٰ", "translit": "ٰàَwَtْsٱَf", "root": "سوي"}], "hasIhya": false}, {"ayah": 7, "text": "وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ ", "translation": "While he was in the higher [part of the] horizon.[1]", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 2, "arabic": "بِٱلْأُفُقِ", "translit": "ِqُfُaʾْlٱِb", "root": "افق"}, {"id": 3, "arabic": "ٱلْأَعْلَىٰ", "translit": "ٰàَlْʿعَaʾْlٱ", "root": "علو"}], "hasIhya": false}, {"ayah": 8, "text": "ثُمَّ دَنَا فَتَدَلَّىٰ ", "translation": "Then he approached and descended", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "دَنَا", "translit": "āَnَd", "root": "دنو"}, {"id": 3, "arabic": "فَتَدَلَّىٰ", "translit": "ٰàَّlَdَtَf", "root": "دلو"}], "hasIhya": false}, {"ayah": 9, "text": "فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ ", "translation": "And was at a distance of two bow lengths or nearer.", "words": [{"id": 1, "arabic": "فَكَانَ", "translit": "َnāَkَf", "root": "كون"}, {"id": 2, "arabic": "قَابَ", "translit": "َbāَq", "root": "قوب"}, {"id": 3, "arabic": "قَوْسَيْنِ", "translit": "ِnْyَsْwَq", "root": "قوس"}, {"id": 4, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 5, "arabic": "أَدْنَىٰ", "translit": "ٰàَnْdَaʾ", "root": "دنو"}], "hasIhya": false}, {"ayah": 10, "text": "فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ ", "translation": "And he revealed to His Servant[1] what he revealed [i.e., conveyed].", "words": [{"id": 1, "arabic": "فَأَوْحَىٰٓ", "translit": "ٰٓàَḥْwَaʾَf", "root": "وحي"}, {"id": 2, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 3, "arabic": "عَبْدِهِۦ", "translit": "ۦِhِdْbَʿع", "root": "عبد"}, {"id": 4, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 5, "arabic": "أَوْحَىٰ", "translit": "ٰàَḥْwَaʾ", "root": "وحي"}], "hasIhya": false}, {"ayah": 11, "text": "مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ ", "translation": "The heart[1] did not lie [about] what it saw.", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "كَذَبَ", "translit": "َbَhdَk", "root": "كذب"}, {"id": 3, "arabic": "ٱلْفُؤَادُ", "translit": "ُdāَwʾُfْlٱ", "root": "فاد"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "رَأَىٰٓ", "translit": "ٰٓàَaʾَr", "root": "راي"}], "hasIhya": true}, {"ayah": 12, "text": "أَفَتُمَٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ ", "translation": "So will you dispute with him over what he saw?", "words": [{"id": 1, "arabic": "أَفَتُمَٰرُونَهُۥ", "translit": "ۥُhَnwُrَٰmُtَfَaʾ", "root": "مري"}, {"id": 2, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "يَرَىٰ", "translit": "ٰàَrَy", "root": "راي"}], "hasIhya": false}, {"ayah": 13, "text": "وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ ", "translation": "And he certainly saw him in another descent[1]", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "رَءَاهُ", "translit": "ُhāَءَr", "root": "راي"}, {"id": 3, "arabic": "نَزْلَةً", "translit": "ًẗَlْzَn", "root": "نزل"}, {"id": 4, "arabic": "أُخْرَىٰ", "translit": "ٰàَrْhkُaʾ", "root": "اخر"}], "hasIhya": false}, {"ayah": 14, "text": "عِندَ سِدْرَةِ ٱلْمُنتَهَىٰ ", "translation": "At the Lote Tree of the Utmost Boundary -", "words": [{"id": 1, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 2, "arabic": "سِدْرَةِ", "translit": "ِẗَrْdِs", "root": "سدر"}, {"id": 3, "arabic": "ٱلْمُنتَهَىٰ", "translit": "ٰàَhَtnُmْlٱ", "root": "نهي"}], "hasIhya": false}, {"ayah": 15, "text": "عِندَهَا جَنَّةُ ٱلْمَأْوَىٰٓ ", "translation": "Near it is the Garden of Refuge [i.e., Paradise] -", "words": [{"id": 1, "arabic": "عِندَهَا", "translit": "āَhَdnِʿع", "root": "عند"}, {"id": 2, "arabic": "جَنَّةُ", "translit": "ُẗَّnَjg", "root": "جنن"}, {"id": 3, "arabic": "ٱلْمَأْوَىٰٓ", "translit": "ٰٓàَwْaʾَmْlٱ", "root": "اوي"}], "hasIhya": false}, {"ayah": 16, "text": "إِذْ يَغْشَى ٱلسِّدْرَةَ مَا يَغْشَىٰ ", "translation": "When there covered the Lote Tree that which covered [it].[1]", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "يَغْشَى", "translit": "àَhsْغَy", "root": "غشو"}, {"id": 3, "arabic": "ٱلسِّدْرَةَ", "translit": "َẗَrْdِّslٱ", "root": "سدر"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "يَغْشَىٰ", "translit": "ٰàَhsْغَy", "root": "غشو"}], "hasIhya": false}, {"ayah": 17, "text": "مَا زَاغَ ٱلْبَصَرُ وَمَا طَغَىٰ ", "translation": "The sight [of the Prophet (ﷺ)] did not swerve, nor did it transgress [its limit].", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "زَاغَ", "translit": "َغāَz", "root": "زيغ"}, {"id": 3, "arabic": "ٱلْبَصَرُ", "translit": "ُrَṣَbْlٱ", "root": "بصر"}, {"id": 4, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 5, "arabic": "طَغَىٰ", "translit": "ٰàَغَṭ", "root": "طغي"}], "hasIhya": false}, {"ayah": 18, "text": "لَقَدْ رَأَىٰ مِنْ ءَايَٰتِ رَبِّهِ ٱلْكُبْرَىٰٓ ", "translation": "He certainly saw of the greatest signs of his Lord.", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 2, "arabic": "رَأَىٰ", "translit": "ٰàَaʾَr", "root": "راي"}, {"id": 3, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 4, "arabic": "ءَايَٰتِ", "translit": "ِtَٰyāَء", "root": "ايي"}, {"id": 5, "arabic": "رَبِّهِ", "translit": "ِhِّbَr", "root": "ربب"}, {"id": 6, "arabic": "ٱلْكُبْرَىٰٓ", "translit": "ٰٓàَrْbُkْlٱ", "root": "كبر"}], "hasIhya": false}, {"ayah": 19, "text": "أَفَرَءَيْتُمُ ٱللَّٰتَ وَٱلْعُزَّىٰ ", "translation": "So have you considered al-Lāt and al-ʿUzzā?", "words": [{"id": 1, "arabic": "أَفَرَءَيْتُمُ", "translit": "ُmُtْyَءَrَfَaʾ", "root": "راي"}, {"id": 2, "arabic": "ٱللَّٰتَ", "translit": "َtَّٰllٱ", "root": ""}, {"id": 3, "arabic": "وَٱلْعُزَّىٰ", "translit": "ٰàَّzُʿعْlٱَw", "root": "عزز"}], "hasIhya": false}, {"ayah": 20, "text": "وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ ", "translation": "And Manāt, the third - the other one?[1]", "words": [{"id": 1, "arabic": "وَمَنَوٰةَ", "translit": "َẗٰwَnَmَw", "root": "مني"}, {"id": 2, "arabic": "ٱلثَّالِثَةَ", "translit": "َẗَhtِlāَّhtlٱ", "root": "ثلث"}, {"id": 3, "arabic": "ٱلْأُخْرَىٰٓ", "translit": "ٰٓàَrْhkُaʾْlٱ", "root": "اخر"}], "hasIhya": false}, {"ayah": 21, "text": "أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ ", "translation": "Is the male for you and for Him the female?", "words": [{"id": 1, "arabic": "أَلَكُمُ", "translit": "ُmُkَlَaʾ", "root": ""}, {"id": 2, "arabic": "ٱلذَّكَرُ", "translit": "ُrَkَّhdlٱ", "root": "ذكر"}, {"id": 3, "arabic": "وَلَهُ", "translit": "ُhَlَw", "root": ""}, {"id": 4, "arabic": "ٱلْأُنثَىٰ", "translit": "ٰàَhtnُaʾْlٱ", "root": "انث"}], "hasIhya": false}, {"ayah": 22, "text": "تِلْكَ إِذًا قِسْمَةٌ ضِيزَىٰٓ ", "translation": "That, then, is an unjust division.[1]", "words": [{"id": 1, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 2, "arabic": "إِذًا", "translit": "āًhdِiʾ", "root": ""}, {"id": 3, "arabic": "قِسْمَةٌ", "translit": "ٌẗَmْsِq", "root": "قسم"}, {"id": 4, "arabic": "ضِيزَىٰٓ", "translit": "ٰٓàَzyِḍ", "root": "ضيز"}], "hasIhya": false}, {"ayah": 23, "text": "إِنْ هِىَ إِلَّآ أَسْمَآءٌ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَٰنٍۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ ", "translation": "They are not but [mere] names you have named them - you and your forefathers - for which Allāh has sent down no authority. They follow not except assumption and what [their] souls desire, and there has already come to them from their Lord guidance.", "words": [{"id": 1, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 2, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 3, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 4, "arabic": "أَسْمَآءٌ", "translit": "ٌءٓāَmْsَaʾ", "root": "سمو"}, {"id": 5, "arabic": "سَمَّيْتُمُوهَآ", "translit": "ٓāَhwُmُtْyَّmَs", "root": "سمو"}, {"id": 6, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 7, "arabic": "وَءَابَآؤُكُم", "translit": "mُkُwʾٓāَbāَءَw", "root": "ابو"}, {"id": 8, "arabic": "مَّآ", "translit": "ٓāَّm", "root": ""}, {"id": 9, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 12, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 13, "arabic": "سُلْطَٰنٍ", "translit": "ٍnَٰṭْlُs", "root": "سلط"}, {"id": 14, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 15, "arabic": "يَتَّبِعُونَ", "translit": "َnwُʿعِbَّtَy", "root": "تبع"}, {"id": 16, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 17, "arabic": "ٱلظَّنَّ", "translit": "َّnَّẓlٱ", "root": "ظنن"}, {"id": 18, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 19, "arabic": "تَهْوَى", "translit": "àَwْhَt", "root": "هوي"}, {"id": 20, "arabic": "ٱلْأَنفُسُ", "translit": "ُsُfnَaʾْlٱ", "root": "نفس"}, {"id": 21, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 22, "arabic": "جَآءَهُم", "translit": "mُhَءٓāَjg", "root": "جيا"}, {"id": 23, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 24, "arabic": "رَّبِّهِمُ", "translit": "ُmِhِّbَّr", "root": "ربب"}, {"id": 25, "arabic": "ٱلْهُدَىٰٓ", "translit": "ٰٓàَdُhْlٱ", "root": "هدي"}], "hasIhya": true}, {"ayah": 24, "text": "أَمْ لِلْإِنسَٰنِ مَا تَمَنَّىٰ ", "translation": "Or is there for man whatever he wishes?", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "لِلْإِنسَٰنِ", "translit": "ِnَٰsnِiʾْlِl", "root": "انس"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "تَمَنَّىٰ", "translit": "ٰàَّnَmَt", "root": "مني"}], "hasIhya": false}, {"ayah": 25, "text": "فَلِلَّهِ ٱلْءَاخِرَةُ وَٱلْأُولَىٰ ", "translation": "Rather, to Allāh belongs the Hereafter and the first [life].", "words": [{"id": 1, "arabic": "فَلِلَّهِ", "translit": "ِhَّlِlَf", "root": "اله"}, {"id": 2, "arabic": "ٱلْءَاخِرَةُ", "translit": "ُẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 3, "arabic": "وَٱلْأُولَىٰ", "translit": "ٰàَlwُaʾْlٱَw", "root": "اول"}], "hasIhya": false}, {"ayah": 26, "text": "وَكَم مِّن مَّلَكٍ فِى ٱلسَّمَٰوَٰتِ لَا تُغْنِى شَفَٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ ", "translation": "And how many angels there are in the heavens whose intercession will not avail at all except [only] after Allāh has permitted [it] to whom He wills and approves.", "words": [{"id": 1, "arabic": "وَكَم", "translit": "mَkَw", "root": ""}, {"id": 2, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 3, "arabic": "مَّلَكٍ", "translit": "ٍkَlَّm", "root": "ملك"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "تُغْنِى", "translit": "àِnْغُt", "root": "غني"}, {"id": 8, "arabic": "شَفَٰعَتُهُمْ", "translit": "ْmُhُtَʿعَٰfَhs", "root": "شفع"}, {"id": 9, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 10, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 11, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 12, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 13, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 14, "arabic": "يَأْذَنَ", "translit": "َnَhdْaʾَy", "root": "اذن"}, {"id": 15, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 17, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 18, "arabic": "وَيَرْضَىٰٓ", "translit": "ٰٓàَḍْrَyَw", "root": "رضو"}], "hasIhya": false}, {"ayah": 27, "text": "إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْءَاخِرَةِ لَيُسَمُّونَ ٱلْمَلَٰٓئِكَةَ تَسْمِيَةَ ٱلْأُنثَىٰ ", "translation": "Indeed, those who do not believe in the Hereafter name the angels female names,", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 5, "arabic": "بِٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱِb", "root": "اخر"}, {"id": 6, "arabic": "لَيُسَمُّونَ", "translit": "َnwُّmَsُyَl", "root": "سمو"}, {"id": 7, "arabic": "ٱلْمَلَٰٓئِكَةَ", "translit": "َẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 8, "arabic": "تَسْمِيَةَ", "translit": "َẗَyِmْsَt", "root": "سمو"}, {"id": 9, "arabic": "ٱلْأُنثَىٰ", "translit": "ٰàَhtnُaʾْlٱ", "root": "انث"}], "hasIhya": false}, {"ayah": 28, "text": "وَمَا لَهُم بِهِۦ مِنْ عِلْمٍۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّۖ وَإِنَّ ٱلظَّنَّ لَا يُغْنِى مِنَ ٱلْحَقِّ شَيْـًٔا ", "translation": "And they have thereof no knowledge. They follow not except assumption, and indeed, assumption avails not against the truth at all.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 3, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 4, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 5, "arabic": "عِلْمٍ", "translit": "ٍmْlِʿع", "root": "علم"}, {"id": 6, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 7, "arabic": "يَتَّبِعُونَ", "translit": "َnwُʿعِbَّtَy", "root": "تبع"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "ٱلظَّنَّ", "translit": "َّnَّẓlٱ", "root": "ظنن"}, {"id": 10, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 11, "arabic": "ٱلظَّنَّ", "translit": "َّnَّẓlٱ", "root": "ظنن"}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "يُغْنِى", "translit": "àِnْغُy", "root": "غني"}, {"id": 14, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 15, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 16, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}], "hasIhya": false}, {"ayah": 29, "text": "فَأَعْرِضْ عَن مَّن تَوَلَّىٰ عَن ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا ٱلْحَيَوٰةَ ٱلدُّنْيَا ", "translation": "So turn away from whoever turns his back on Our message and desires not except the worldly life.", "words": [{"id": 1, "arabic": "فَأَعْرِضْ", "translit": "ْḍِrْʿعَaʾَf", "root": "عرض"}, {"id": 2, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 3, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 4, "arabic": "تَوَلَّىٰ", "translit": "ٰàَّlَwَt", "root": "ولي"}, {"id": 5, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 6, "arabic": "ذِكْرِنَا", "translit": "āَnِrْkِhd", "root": "ذكر"}, {"id": 7, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 8, "arabic": "يُرِدْ", "translit": "ْdِrُy", "root": "رود"}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "ٱلْحَيَوٰةَ", "translit": "َẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 11, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}], "hasIhya": true}, {"ayah": 30, "text": "ذَٰلِكَ مَبْلَغُهُم مِّنَ ٱلْعِلْمِۚ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِمَنِ ٱهْتَدَىٰ ", "translation": "That is their sum of knowledge. Indeed, your Lord is most knowing of who strays from His way, and He is most knowing of who is guided.", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "مَبْلَغُهُم", "translit": "mُhُغَlْbَm", "root": "بلغ"}, {"id": 3, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 4, "arabic": "ٱلْعِلْمِ", "translit": "ِmْlِʿعْlٱ", "root": "علم"}, {"id": 5, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 6, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 7, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 8, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 9, "arabic": "بِمَن", "translit": "nَmِb", "root": ""}, {"id": 10, "arabic": "ضَلَّ", "translit": "َّlَḍ", "root": "ضلل"}, {"id": 11, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 12, "arabic": "سَبِيلِهِۦ", "translit": "ۦِhِlyِbَs", "root": "سبل"}, {"id": 13, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 14, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 15, "arabic": "بِمَنِ", "translit": "ِnَmِb", "root": ""}, {"id": 16, "arabic": "ٱهْتَدَىٰ", "translit": "ٰàَdَtْhٱ", "root": "هدي"}], "hasIhya": false}, {"ayah": 31, "text": "وَلِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِ لِيَجْزِىَ ٱلَّذِينَ أَسَٰٓـُٔوا۟ بِمَا عَمِلُوا۟ وَيَجْزِىَ ٱلَّذِينَ أَحْسَنُوا۟ بِٱلْحُسْنَى ", "translation": "And to Allāh belongs whatever is in the heavens and whatever is in the earth - that He may recompense those who do evil with [the penalty of] what they have done and recompense those who do good with the best [reward] -", "words": [{"id": 1, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "لِيَجْزِىَ", "translit": "َàِzْjgَyِl", "root": "جزي"}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "أَسَٰٓـُٔوا۟", "translit": "۟āwُٔـَٰٓsَaʾ", "root": "سوا"}, {"id": 11, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 12, "arabic": "عَمِلُوا۟", "translit": "۟āwُlِmَʿع", "root": "عمل"}, {"id": 13, "arabic": "وَيَجْزِىَ", "translit": "َàِzْjgَyَw", "root": "جزي"}, {"id": 14, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 15, "arabic": "أَحْسَنُوا۟", "translit": "۟āwُnَsْḥَaʾ", "root": "حسن"}, {"id": 16, "arabic": "بِٱلْحُسْنَى", "translit": "àَnْsُḥْlٱِb", "root": "حسن"}], "hasIhya": true}, {"ayah": 32, "text": "ٱلَّذِينَ يَجْتَنِبُونَ كَبَٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ إِلَّا ٱللَّمَمَۚ إِنَّ رَبَّكَ وَٰسِعُ ٱلْمَغْفِرَةِۚ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنشَأَكُم مِّنَ ٱلْأَرْضِ وَإِذْ أَنتُمْ أَجِنَّةٌ فِى بُطُونِ أُمَّهَٰتِكُمْۖ فَلَا تُزَكُّوٓا۟ أَنفُسَكُمْۖ هُوَ أَعْلَمُ بِمَنِ ٱتَّقَىٰٓ ", "translation": "Those who avoid the major sins and immoralities, only [committing] slight ones. Indeed, your Lord is vast in forgiveness. He was most knowing of you when He produced you from the earth and when you were fetuses in the wombs of your mothers. So do not claim yourselves to be pure; He is most knowing of who fears Him.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يَجْتَنِبُونَ", "translit": "َnwُbِnَtْjgَy", "root": "جنب"}, {"id": 3, "arabic": "كَبَٰٓئِرَ", "translit": "َrِyʾَٰٓbَk", "root": "كبر"}, {"id": 4, "arabic": "ٱلْإِثْمِ", "translit": "ِmْhtِiʾْlٱ", "root": "اثم"}, {"id": 5, "arabic": "وَٱلْفَوَٰحِشَ", "translit": "َhsِḥَٰwَfْlٱَw", "root": "فحش"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "ٱللَّمَمَ", "translit": "َmَmَّllٱ", "root": "لمم"}, {"id": 8, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 9, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 10, "arabic": "وَٰسِعُ", "translit": "ُʿعِsَٰw", "root": "وسع"}, {"id": 11, "arabic": "ٱلْمَغْفِرَةِ", "translit": "ِẗَrِfْغَmْlٱ", "root": "غفر"}, {"id": 12, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 13, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 14, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": ""}, {"id": 15, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 16, "arabic": "أَنشَأَكُم", "translit": "mُkَaʾَhsnَaʾ", "root": "نشا"}, {"id": 17, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 18, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 19, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 20, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 21, "arabic": "أَجِنَّةٌ", "translit": "ٌẗَّnِjgَaʾ", "root": "جنن"}, {"id": 22, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 23, "arabic": "بُطُونِ", "translit": "ِnwُṭُb", "root": "بطن"}, {"id": 24, "arabic": "أُمَّهَٰتِكُمْ", "translit": "ْmُkِtَٰhَّmُaʾ", "root": "امم"}, {"id": 25, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 26, "arabic": "تُزَكُّوٓا۟", "translit": "۟āٓwُّkَzُt", "root": "زكو"}, {"id": 27, "arabic": "أَنفُسَكُمْ", "translit": "ْmُkَsُfnَaʾ", "root": "نفس"}, {"id": 28, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 29, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 30, "arabic": "بِمَنِ", "translit": "ِnَmِb", "root": ""}, {"id": 31, "arabic": "ٱتَّقَىٰٓ", "translit": "ٰٓàَqَّtٱ", "root": "وقي"}], "hasIhya": true}, {"ayah": 33, "text": "أَفَرَءَيْتَ ٱلَّذِى تَوَلَّىٰ ", "translation": "Have you seen the one who turned away", "words": [{"id": 1, "arabic": "أَفَرَءَيْتَ", "translit": "َtْyَءَrَfَaʾ", "root": "راي"}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "تَوَلَّىٰ", "translit": "ٰàَّlَwَt", "root": "ولي"}], "hasIhya": false}, {"ayah": 34, "text": "وَأَعْطَىٰ قَلِيلًا وَأَكْدَىٰٓ ", "translation": "And gave a little and [then] refrained?", "words": [{"id": 1, "arabic": "وَأَعْطَىٰ", "translit": "ٰàَṭْʿعَaʾَw", "root": "عطو"}, {"id": 2, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 3, "arabic": "وَأَكْدَىٰٓ", "translit": "ٰٓàَdْkَaʾَw", "root": "كدي"}], "hasIhya": false}, {"ayah": 35, "text": "أَعِندَهُۥ عِلْمُ ٱلْغَيْبِ فَهُوَ يَرَىٰٓ ", "translation": "Does he have knowledge of the unseen, so he sees?[1]", "words": [{"id": 1, "arabic": "أَعِندَهُۥ", "translit": "ۥُhَdnِʿعَaʾ", "root": "عند"}, {"id": 2, "arabic": "عِلْمُ", "translit": "ُmْlِʿع", "root": "علم"}, {"id": 3, "arabic": "ٱلْغَيْبِ", "translit": "ِbْyَغْlٱ", "root": "غيب"}, {"id": 4, "arabic": "فَهُوَ", "translit": "َwُhَf", "root": ""}, {"id": 5, "arabic": "يَرَىٰٓ", "translit": "ٰٓàَrَy", "root": "راي"}], "hasIhya": false}, {"ayah": 36, "text": "أَمْ لَمْ يُنَبَّأْ بِمَا فِى صُحُفِ مُوسَىٰ ", "translation": "Or has he not been informed of what was in the scriptures of Moses", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 3, "arabic": "يُنَبَّأْ", "translit": "ْaʾَّbَnُy", "root": "نبا"}, {"id": 4, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "صُحُفِ", "translit": "ِfُḥُṣ", "root": "صحف"}, {"id": 7, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}], "hasIhya": true}, {"ayah": 37, "text": "وَإِبْرَٰهِيمَ ٱلَّذِى وَفَّىٰٓ ", "translation": "And [of] Abraham, who fulfilled [his obligations] -", "words": [{"id": 1, "arabic": "وَإِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "وَفَّىٰٓ", "translit": "ٰٓàَّfَw", "root": "وفي"}], "hasIhya": false}, {"ayah": 38, "text": "أَلَّا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَىٰ ", "translation": "That no bearer of burdens will bear the burden of another", "words": [{"id": 1, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 2, "arabic": "تَزِرُ", "translit": "ُrِzَt", "root": "وزر"}, {"id": 3, "arabic": "وَازِرَةٌ", "translit": "ٌẗَrِzāَw", "root": "وزر"}, {"id": 4, "arabic": "وِزْرَ", "translit": "َrْzِw", "root": "وزر"}, {"id": 5, "arabic": "أُخْرَىٰ", "translit": "ٰàَrْhkُaʾ", "root": "اخر"}], "hasIhya": false}, {"ayah": 39, "text": "وَأَن لَّيْسَ لِلْإِنسَٰنِ إِلَّا مَا سَعَىٰ ", "translation": "And that there is not for man except that [good] for which he strives", "words": [{"id": 1, "arabic": "وَأَن", "translit": "nَaʾَw", "root": ""}, {"id": 2, "arabic": "لَّيْسَ", "translit": "َsْyَّl", "root": "ليس"}, {"id": 3, "arabic": "لِلْإِنسَٰنِ", "translit": "ِnَٰsnِiʾْlِl", "root": "انس"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "سَعَىٰ", "translit": "ٰàَʿعَs", "root": "سعي"}], "hasIhya": true}, {"ayah": 40, "text": "وَأَنَّ سَعْيَهُۥ سَوْفَ يُرَىٰ ", "translation": "And that his effort is going to be seen -", "words": [{"id": 1, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 2, "arabic": "سَعْيَهُۥ", "translit": "ۥُhَyْʿعَs", "root": "سعي"}, {"id": 3, "arabic": "سَوْفَ", "translit": "َfْwَs", "root": ""}, {"id": 4, "arabic": "يُرَىٰ", "translit": "ٰàَrُy", "root": "راي"}], "hasIhya": false}, {"ayah": 41, "text": "ثُمَّ يُجْزَىٰهُ ٱلْجَزَآءَ ٱلْأَوْفَىٰ ", "translation": "Then he will be recompensed for it with the fullest recompense -", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "يُجْزَىٰهُ", "translit": "ُhٰàَzْjgُy", "root": "جزي"}, {"id": 3, "arabic": "ٱلْجَزَآءَ", "translit": "َءٓāَzَjgْlٱ", "root": "جزي"}, {"id": 4, "arabic": "ٱلْأَوْفَىٰ", "translit": "ٰàَfْwَaʾْlٱ", "root": "وفي"}], "hasIhya": false}, {"ayah": 42, "text": "وَأَنَّ إِلَىٰ رَبِّكَ ٱلْمُنتَهَىٰ ", "translation": "And that to your Lord is the finality", "words": [{"id": 1, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 2, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 3, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "ٱلْمُنتَهَىٰ", "translit": "ٰàَhَtnُmْlٱ", "root": "نهي"}], "hasIhya": false}, {"ayah": 43, "text": "وَأَنَّهُۥ هُوَ أَضْحَكَ وَأَبْكَىٰ ", "translation": "And that it is He who makes [one] laugh and weep", "words": [{"id": 1, "arabic": "وَأَنَّهُۥ", "translit": "ۥُhَّnَaʾَw", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "أَضْحَكَ", "translit": "َkَḥْḍَaʾ", "root": "ضحك"}, {"id": 4, "arabic": "وَأَبْكَىٰ", "translit": "ٰàَkْbَaʾَw", "root": "بكي"}], "hasIhya": false}, {"ayah": 44, "text": "وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحْيَا ", "translation": "And that it is He who causes death and gives life", "words": [{"id": 1, "arabic": "وَأَنَّهُۥ", "translit": "ۥُhَّnَaʾَw", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "أَمَاتَ", "translit": "َtāَmَaʾ", "root": "موت"}, {"id": 4, "arabic": "وَأَحْيَا", "translit": "āَyْḥَaʾَw", "root": "حيي"}], "hasIhya": false}, {"ayah": 45, "text": "وَأَنَّهُۥ خَلَقَ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰ ", "translation": "And that He creates the two mates - the male and female -", "words": [{"id": 1, "arabic": "وَأَنَّهُۥ", "translit": "ۥُhَّnَaʾَw", "root": ""}, {"id": 2, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "ٱلزَّوْجَيْنِ", "translit": "ِnْyَjgْwَّzlٱ", "root": "زوج"}, {"id": 4, "arabic": "ٱلذَّكَرَ", "translit": "َrَkَّhdlٱ", "root": "ذكر"}, {"id": 5, "arabic": "وَٱلْأُنثَىٰ", "translit": "ٰàَhtnُaʾْlٱَw", "root": "انث"}], "hasIhya": false}, {"ayah": 46, "text": "مِن نُّطْفَةٍ إِذَا تُمْنَىٰ ", "translation": "From a sperm-drop when it is emitted", "words": [{"id": 1, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 2, "arabic": "نُّطْفَةٍ", "translit": "ٍẗَfْṭُّn", "root": "نطف"}, {"id": 3, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 4, "arabic": "تُمْنَىٰ", "translit": "ٰàَnْmُt", "root": "مني"}], "hasIhya": false}, {"ayah": 47, "text": "وَأَنَّ عَلَيْهِ ٱلنَّشْأَةَ ٱلْأُخْرَىٰ ", "translation": "And that [incumbent] upon Him is the other [i.e., next] creation.", "words": [{"id": 1, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 2, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلنَّشْأَةَ", "translit": "َẗَaʾْhsَّnlٱ", "root": "نشا"}, {"id": 4, "arabic": "ٱلْأُخْرَىٰ", "translit": "ٰàَrْhkُaʾْlٱ", "root": "اخر"}], "hasIhya": false}, {"ayah": 48, "text": "وَأَنَّهُۥ هُوَ أَغْنَىٰ وَأَقْنَىٰ ", "translation": "And that it is He who enriches and suffices", "words": [{"id": 1, "arabic": "وَأَنَّهُۥ", "translit": "ۥُhَّnَaʾَw", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "أَغْنَىٰ", "translit": "ٰàَnْغَaʾ", "root": "غني"}, {"id": 4, "arabic": "وَأَقْنَىٰ", "translit": "ٰàَnْqَaʾَw", "root": "قني"}], "hasIhya": false}, {"ayah": 49, "text": "وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعْرَىٰ ", "translation": "And that it is He who is the Lord of Sirius[1]", "words": [{"id": 1, "arabic": "وَأَنَّهُۥ", "translit": "ۥُhَّnَaʾَw", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "رَبُّ", "translit": "ُّbَr", "root": "ربب"}, {"id": 4, "arabic": "ٱلشِّعْرَىٰ", "translit": "ٰàَrْʿعِّhslٱ", "root": "شعر"}], "hasIhya": false}, {"ayah": 50, "text": "وَأَنَّهُۥٓ أَهْلَكَ عَادًا ٱلْأُولَىٰ ", "translation": "And that He destroyed the first [people of] ʿAad", "words": [{"id": 1, "arabic": "وَأَنَّهُۥٓ", "translit": "ٓۥُhَّnَaʾَw", "root": ""}, {"id": 2, "arabic": "أَهْلَكَ", "translit": "َkَlْhَaʾ", "root": "هلك"}, {"id": 3, "arabic": "عَادًا", "translit": "āًdāَʿع", "root": "عود"}, {"id": 4, "arabic": "ٱلْأُولَىٰ", "translit": "ٰàَlwُaʾْlٱ", "root": "اول"}], "hasIhya": false}, {"ayah": 51, "text": "وَثَمُودَا۟ فَمَآ أَبْقَىٰ ", "translation": "And Thamūd - and He did not spare [them] -", "words": [{"id": 1, "arabic": "وَثَمُودَا۟", "translit": "۟āَdwُmَhtَw", "root": ""}, {"id": 2, "arabic": "فَمَآ", "translit": "ٓāَmَf", "root": ""}, {"id": 3, "arabic": "أَبْقَىٰ", "translit": "ٰàَqْbَaʾ", "root": "بقي"}], "hasIhya": false}, {"ayah": 52, "text": "وَقَوْمَ نُوحٍ مِّن قَبْلُۖ إِنَّهُمْ كَانُوا۟ هُمْ أَظْلَمَ وَأَطْغَىٰ ", "translation": "And the people of Noah before. Indeed, it was they who were [even] more unjust and oppressing.", "words": [{"id": 1, "arabic": "وَقَوْمَ", "translit": "َmْwَqَw", "root": "قوم"}, {"id": 2, "arabic": "نُوحٍ", "translit": "ٍḥwُn", "root": ""}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 5, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 6, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 7, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 8, "arabic": "أَظْلَمَ", "translit": "َmَlْẓَaʾ", "root": "ظلم"}, {"id": 9, "arabic": "وَأَطْغَىٰ", "translit": "ٰàَغْṭَaʾَw", "root": "طغي"}], "hasIhya": false}, {"ayah": 53, "text": "وَٱلْمُؤْتَفِكَةَ أَهْوَىٰ ", "translation": "And the overturned towns[1] He hurled down", "words": [{"id": 1, "arabic": "وَٱلْمُؤْتَفِكَةَ", "translit": "َẗَkِfَtْwʾُmْlٱَw", "root": "افك"}, {"id": 2, "arabic": "أَهْوَىٰ", "translit": "ٰàَwْhَaʾ", "root": "هوي"}], "hasIhya": false}, {"ayah": 54, "text": "فَغَشَّىٰهَا مَا غَشَّىٰ ", "translation": "And covered them by that which He covered.[1]", "words": [{"id": 1, "arabic": "فَغَشَّىٰهَا", "translit": "āَhٰàَّhsَغَf", "root": "غشو"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "غَشَّىٰ", "translit": "ٰàَّhsَغ", "root": "غشو"}], "hasIhya": false}, {"ayah": 55, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكَ تَتَمَارَىٰ ", "translation": "Then which of the favors of your Lord do you doubt?", "words": [{"id": 1, "arabic": "فَبِأَىِّ", "translit": "ِّàَaʾِbَf", "root": "ايي"}, {"id": 2, "arabic": "ءَالَآءِ", "translit": "ِءٓāَlāَء", "root": "الو"}, {"id": 3, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "تَتَمَارَىٰ", "translit": "ٰàَrāَmَtَt", "root": "مري"}], "hasIhya": false}, {"ayah": 56, "text": "هَٰذَا نَذِيرٌ مِّنَ ٱلنُّذُرِ ٱلْأُولَىٰٓ ", "translation": "This [Prophet (ﷺ)] is a warner from [i.e., like] the former warners.", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 2, "arabic": "نَذِيرٌ", "translit": "ٌryِhdَn", "root": "نذر"}, {"id": 3, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 4, "arabic": "ٱلنُّذُرِ", "translit": "ِrُhdُّnlٱ", "root": "نذر"}, {"id": 5, "arabic": "ٱلْأُولَىٰٓ", "translit": "ٰٓàَlwُaʾْlٱ", "root": "اول"}], "hasIhya": false}, {"ayah": 57, "text": "أَزِفَتِ ٱلْءَازِفَةُ ", "translation": "The Approaching Day has approached.", "words": [{"id": 1, "arabic": "أَزِفَتِ", "translit": "ِtَfِzَaʾ", "root": "ازف"}, {"id": 2, "arabic": "ٱلْءَازِفَةُ", "translit": "ُẗَfِzāَءْlٱ", "root": "ازف"}], "hasIhya": false}, {"ayah": 58, "text": "لَيْسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ ", "translation": "Of it, [from those] besides Allāh, there is no remover.", "words": [{"id": 1, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 2, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "كَاشِفَةٌ", "translit": "ٌẗَfِhsāَk", "root": "كشف"}], "hasIhya": false}, {"ayah": 59, "text": "أَفَمِنْ هَٰذَا ٱلْحَدِيثِ تَعْجَبُونَ ", "translation": "Then at this statement do you wonder?", "words": [{"id": 1, "arabic": "أَفَمِنْ", "translit": "ْnِmَfَaʾ", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 3, "arabic": "ٱلْحَدِيثِ", "translit": "ِhtyِdَḥْlٱ", "root": "حدث"}, {"id": 4, "arabic": "تَعْجَبُونَ", "translit": "َnwُbَjgْʿعَt", "root": "عجب"}], "hasIhya": true}, {"ayah": 60, "text": "وَتَضْحَكُونَ وَلَا تَبْكُونَ ", "translation": "And you laugh and do not weep", "words": [{"id": 1, "arabic": "وَتَضْحَكُونَ", "translit": "َnwُkَḥْḍَtَw", "root": "ضحك"}, {"id": 2, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 3, "arabic": "تَبْكُونَ", "translit": "َnwُkْbَt", "root": "بكي"}], "hasIhya": false}, {"ayah": 61, "text": "وَأَنتُمْ سَٰمِدُونَ ", "translation": "While you are proudly sporting?[1]", "words": [{"id": 1, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 2, "arabic": "سَٰمِدُونَ", "translit": "َnwُdِmَٰs", "root": "سمد"}], "hasIhya": false}, {"ayah": 62, "text": "فَٱسْجُدُوا۟ لِلَّهِ وَٱعْبُدُوا۟۩ ", "translation": "So prostrate to Allāh and worship [Him].", "words": [{"id": 1, "arabic": "فَٱسْجُدُوا۟", "translit": "۟āwُdُjgْsٱَf", "root": "سجد"}, {"id": 2, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 3, "arabic": "وَٱعْبُدُوا۟", "translit": "۟āwُdُbْʿعٱَw", "root": "عبد"}], "hasIhya": false}], "tafsir": {"3": [{"arabic": "ولا تظنن أن تقدير رسول الله صلى الله عليه وسلم يجري على لسانه جزافاً وبالاتفاق، بل لا يستنطق صلى الله عليه وسلم إلا بحقيقة الحق فإنه لا ينطق عن الهوى إن هو إلا وحي يوحى، وهذا كقوله صلى الله عليه وسلم: \"الرؤيا الصالحة جزء من ستة وأربعين جزءاً من النبوة\" فإنه تقدير تحقيق لا محالة، لكن ليس في قوة غيره أن يعرف علة تلك النسبة إلا بتخمين، فأما بالتحقيق فلا، إذ يعلم أن النبوة عبارة عما يختص به النبي ويفارق به غيره، وهو يختص بأنواع من الخواص: أحدها أن يعرف حقائق الأمور المتعلقة بالله وصفاته والملائكة وا", "english": "And do not think that the estimation of the Messenger of Allah (peace and blessings be upon him) proceeds upon his tongue arbitrarily and by coincidence, rather he is not made to speak (peace and blessings be upon him) except with the truth of reality, for he does not speak from desire (al-Hawa), it is not except revelation being revealed. And this is like his saying (peace and blessings be upon him): \"The righteous dream is one part from forty-six parts of prophethood (al-Nubuwwah)\" for it is an estimation of verification without doubt, but it is not in the power of anyone else to know the cause of that proportion except by conjecture, but as for by verification, no, since it is known that prophethood (al-Nubuwwah) is an expression for what is specific to the Prophet and distinguishes him from others, and he is specific with types of special characteristics: The first is that he knows the realities (Haqa'iq) of matters related to Allah and His attributes and the angels and the Abode of the Hereafter (al-Dar al-Akhirah), not as others know it but differing from it in abundance and with increase of certainty (al-Yaqin) and verification (al-Tahqiq) and unveiling (al-Kashf).", "book_file": "vol4_Vol4-book4.doc.txt", "book_title": "Poverty and Abstinence", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Poverty and Abstinence'", "badge": "Ethics"}], "5": [{"arabic": "وقد رأى رسول الله صلى الله عليه وسلم جبريل عليه السلام مرتين في صورته وأخبر عنه بأنه سد الأفق حديث رأى جبريل عليه السلام مرتين في صورته فأخبر أنه سد الأفق متفق عليه من حديث عائشة وهو المراد بقوله تعالى علمه شديد القوى ذو مرة فاستوى وهو بالافق الأعلى إلى آخر هذه الآيات وفي مثل هذه الأحوال من الصفاء يقع الاطلاع على ضمائر القلوب وقد يعبر عن ذلك الاطلاع بالتفرس ولذلك قال صلى الله عليه وسلم اتقوا فراسة المؤمن فإنه ينظر بنور الله حديث اتقوا فراسة المؤمن فإنه ينظر بنور الله تعالى أخرجه الترمذي من حديث ", "english": "And the Messenger of Allah (peace be upon him) saw Gabriel (upon him be peace) twice in his form and informed about him that he filled the horizon. The hadith: 'He saw Gabriel (upon him be peace) twice in his form, so he informed that he filled the horizon' is agreed upon from the narration of Aisha. And this is what is intended by His saying, the Exalted: 'Taught him the one of intense strength (Shadid al-Quwa), possessor of power (Dhu Mirrah), so he rose, and he was at the highest horizon' to the end of these verses. And in such states of purity (Safa'), insight into the secrets of the hearts (Qulub) occurs, and that insight may be expressed as discernment (Tafarrus). Therefore, he (peace be upon him) said: 'Beware of the discernment (Firasa) of the believer, for he sees by the light of Allah.' The hadith: 'Beware of the discernment (Firasa) of the believer, for he sees by the light of Allah, the Exalted' was reported by Al-Tirmidhi from the narration of Abu Sa'id, and he said it is a rare hadith.", "book_file": "vol2_j2-k08.doc.txt", "book_title": "Audition and Ecstasy", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Audition and Ecstasy'", "badge": "Hadith"}], "11": [{"arabic": "ولمشابهة بصيرة الباطن لبصيرة الظاهر قال الله تعالى ما كذب الفؤاد ما رأى وقال تعالى وكذلك نرى إبراهيم ملكوت السموات والأرض الآية وسمى ضده عمى فقال تعالى فإنها لا تعمى الأبصار ولكن تعمى القلوب التي في الصدور وقال تعالى ومن كان في هذه أعمى فهو في الآخرة أعمى وأضل سبيلا وهذه الأمور التي كشفت للأنبياء بعضها كان بالبصر وبعضها كان بالبصيرة وسمى الكل رؤية وبالجملة من لم تكن بصيرته الباطنة ثاقبة لم يعلق به من الدين إلا قشوره وأمثلته دون لبابه وحقائقه", "english": "And due to the similarity between the inner insight (Bassira) and the outer insight, Allah the Exalted said: 'The Heart (Fu'ad) did not lie about what it saw' and He said: 'And thus We showed Abraham the dominion of the heavens and the earth' (the verse). And He named its opposite blindness, saying: 'For indeed, it is not the eyes that become blind, but it is the Hearts (Qulub) in the chests that become blind' and He said: 'And whoever is blind in this [world] will be blind in the Hereafter and more astray in way.' And these matters that were revealed to the prophets, some of them were through sight (Basar) and some of them were through insight (Bassira), and He named all of it vision (Ru'ya). And in summary, whoever does not have their inner insight (Bassira) penetrating, nothing will attach to them from the religion except its outer shells and its examples, without its core and its truths.", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "ولموازنة البصيرة الباطنة للبصر الظاهر سماه الله تعالى باسمه فقال ما كذب الفؤاد ما رأى سمى إدراك الفؤاد رؤية وكذلك قوله تعالى وكذلك نري إبراهيم ملكوت السموات والأرض وما أراد به الرؤية الظاهرة فإن ذلك غير مخصوص بإبراهيم عليه السلام حتى يعرض في معرض الامتنان ولذلك سمى ضد إدراكه عمى فقال تعالى فإنها لا تعمى الأبصار ولكن تعمى القلوب التي في الصدور وقال تعالى ومن كان في هذه أعمى فهو في الآخرة أعمى وأضل سبيلا", "english": "And due to the analogy between the inner insight (Bāṭinah) and the outer sight (Ẓāhir), Allah the Exalted named it with His name, so He said: 'The Heart (Fu'ād) did not lie about what it saw' - He named the perception of the Heart (Fu'ād) as seeing. And likewise His saying, the Exalted: 'And thus We showed Abraham the dominion of the heavens and the earth' - and He did not intend by it the apparent seeing, for that is not specific to Abraham, peace be upon him, until it is presented in the context of favor. And for that reason, He named the opposite of its perception as blindness, so He said, the Exalted: 'For indeed, it is not the eyes that are blinded, but blinded are the Hearts (Qulūb) that are in the breasts.' And He said, the Exalted: 'And whoever is blind in this [world] will be blind in the Hereafter and more astray in way.'", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}], "23": [{"arabic": "وَكَمْ مِنْ مُطْمَئِنٍ لَا يَقِينَ لَهُ كَسَائِرِ أَرْبَابِ الْمِلَلِ وَالْمَذَاهِبِ، فَإِنَّ الْيَهُودِيَّ مُطْمَئِنُّ الْقَلْبِ إِلَى تَهْوُدِهِ، وَكَذَا النَّصْرَانِيُّ وَلَا يَقِينَ لَهُمْ أَصْلًا، وَإِنَّمَا يَتَّبِعُونَ الظَّنَّ وَمَا تَهْوَى الْأَنْفُسُ وَلَقَدْ جَاءَهُمْ مِنْ رَبِّهِمُ الْهُدَى وَهُوَ سَبَبُ الْيَقِينِ، إِلَّا أَنَّهُمْ مُعْرِضُونَ عَنْهُ، فَإِذَنَ الْجُبْنُ وَالْجَرَاءَةُ غَرَائِزُ وَلَا يَنْفَعُ الْيَقِينُ مَعَهَا، فَهِيَ أَحَدُ الْأَسْبَابِ الَّتِي تُضَادُّ حَالَ التّ", "english": "And how many are those who are at peace (mumtani) but have no certainty (yaqin) like all the people of religions and schools of thought, for indeed the Jew is at peace in the heart (qalb) to his Judaism, and likewise the Christian, and they have no certainty at all, and they only follow conjecture (al-zann) and what the souls (al-anfus) desire, and indeed guidance (al-huda) has come to them from their Lord, and it is the cause of certainty, except that they are turning away from it. Therefore, cowardice and boldness are instincts, and certainty does not benefit with them, so they are one of the causes that oppose the state of reliance (tawakkul), just as weakness of certainty in the four qualities is one of the causes. And when these causes gather, trust (thiqah) in God Almighty is attained. And it has been said: It is written in the Torah: Cursed is he whose trust is in a human like him. And the Prophet (peace be upon him) said: \"Whoever seeks might through slaves, God Almighty will humiliate him.\" And when the meaning of reliance is unveiled to you and you know the state that is named reliance, then know that that state has in strength and weakness three degrees: The first degree is what we mentioned: that his state regarding God Almighty and trust in His guarantee and care be like his state in trust in an agent.", "book_file": "vol4_Vol4-book5.doc.txt", "book_title": "Monotheism and Reliance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monotheism and Reliance'", "badge": "Insight"}], "29": [{"arabic": "وقال تعالى: \" فأعرض عمن تولى عن ذكرنا ولم يرد إلا الحياة الدنيا، ذلك مبلغهم من العلم\"، فأحال ذلك كله على الغفلة وعدم العلم، ولذلك قال رجل لعيسى عليه السلام: احملني معك في سياحتك، فقال: أخرج مالك والحقني، فقال: لا أستطيع، فقال عيسى عليه السلام: بعجب يدخل الغني الجنة - أو قال بشدة.", "english": "And He (Allah), the Exalted, said: \"So turn away from whoever turns away from Our Remembrance (Dhikr) and desires only the worldly life (al-Hayat al-Dunya), that is the extent of their knowledge.\" So He attributed all of that to heedlessness (Ghafala) and lack of knowledge, and for that reason a man said to Jesus (Isa), peace be upon him: 'Carry me with you in your journeying.' He said: 'Take out your wealth and follow me.' He said: 'I am not able.' So Jesus, peace be upon him, said: 'With difficulty does the rich person enter Paradise' - or he said: 'with hardship.'", "book_file": "vol4_Vol4-book4.doc.txt", "book_title": "Poverty and Abstinence", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Poverty and Abstinence'", "badge": "Ethics"}], "31": [{"arabic": "فكيف بكم لو عاينتم الأمور وبعثرت القبور وحصل ما في الصدور وأوقفتم للتحصيل بين يدي الملك الجليل فطارت القلوب لإشفاقها من سالف الذنوب وهتكت عنكم الحجب والأستار وظهرت منكم العيوب والأسرار؟ هنالك تجزى كل نفس بما كسبت إن الله عز وجل يقول \"ليجزى الذي أساءوا بما عملوا ويجزى الذي أحسنوا بالحسنى\" وقال تعالى \"ووضع الكتاب فترى المجرمين مشفقين مما فيه\" الآية جعلنا الله وإياكم عاملين بكتابة متبعين لأوليائه حتى يحلنا وإياكم دار المقامة من فضله إنه حميد مجيد.", "english": "How would it be for you if you witnessed the matters and the graves were overturned and what is in the chests (Sudur) was gathered and you were stood for the accounting before the Glorious King (Al-Malik Al-Jalil), so the hearts (Qulub) flew from their fear of past sins and the veils (Hujub) and curtains (Astār) were torn away from you and the faults (ʿUyūb) and secrets (Asrār) appeared from you? There, every soul (Nafs) will be recompensed for what it earned. Indeed, Allah, the Exalted and Majestic, says: \"So that He may recompense those who did evil (Asāʾū) with what they did and recompense those who did good (Aḥsanū) with the best (Al-Ḥusnā).\" And He, the Exalted, said: \"And the Book will be placed, and you will see the criminals fearful of what is in it\" (the verse). May Allah make us and you among those who act according to His Book, following His allies (Awliyāʾ), until He settles us and you in the Abode of Permanence (Dār Al-Maqāmah) from His bounty. Indeed, He is Praiseworthy (Ḥamīd), Glorious (Majīd).", "book_file": "vol3_Vol3-book-6a.doc.txt", "book_title": "Condemnation of the World", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of the World'", "badge": "Insight"}, {"arabic": "وثلاث آيات من آخر سورة البقرة من قوله لله ما في السموات وما في الأرض إلى آخرها", "english": "And three verses from the end of Surah Al-Baqarah from His saying 'To Allah belongs what is in the heavens and what is in the earth' to its end.", "book_file": "vol1_Vol1-book-10.doc.txt", "book_title": "Book of Knowledge", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Book of Knowledge'", "badge": "General"}], "32": [{"arabic": "ومنها تزكية النفس، قال الله سبحانه وتعالى (فلا تزكوا أنفسكم هو أعلم بمن اتقى( (النجم: 32) وقيل لحكيم: ما الصدق القبيح فقال: (ثناء المرء على نفسه). ولا يخلو المناظر من الثناء على نفسه بالقوة والغلبة والتقدم على الأقران ولا ينفك في أثناء المناظرة عن قوله لست ممن يخفى عليه أمثال هذه الأمور وأنا المتفنن في العلوم والمستقل بالأصول وحفظ الأحاديث وغير ذلك مما يتمدح به تارة على سبيل الصلف وتارة للحاجة إلى ترويج كلامه ومعلوم أن الصلف والتمدح مذمومان شرعا وعقلا.", "english": "And among them is self-purification (Tazkiyat al-Nafs), Allah the Exalted said: 'So do not purify yourselves (Tazakku Anfusakum), He knows best who is God-conscious (Yattaqi)' (An-Najm: 32). And it was said to a wise man: What is ugly truth? He said: 'A person's praise of himself.' And the disputant is not free from praising himself with strength, victory, and precedence over peers, nor does he refrain during disputation from saying: I am not one from whom such matters are hidden, and I am the one proficient in sciences, independent in principles, and memorizer of hadiths, and other than that which he boasts of, sometimes on the path of arrogance (Salf) and sometimes for the need to promote his speech. And it is known that arrogance (Salf) and boasting (Tamaddah) are blameworthy religiously and rationally.", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}], "36": [{"arabic": "وقال: أرأيت إن جئتك بكتاب من أمير المؤمنين تخلي سبيلي؟ قال نعم قال فأنا آتيك بكتاب من العزيز الحكيم وأقيم عليه شاهدين إبراهيم وموسى ثم تلا \"أم لم ينبأ بما في صحف موسى وإبراهيم الذي وفى أن لا تزر وازرة وزر أخرى\" فقال زياد خلوا سبيله، هذا رجل قد لقن حجته، وقيل مكتوب في الإنجيل. من استغفر لمن ظلمه فقد هزم الشيطان.", "english": "And he said: 'What if I bring you a letter from the Commander of the Believers that releases my captivity?' He said: 'Yes.' He said: 'Then I will bring you a letter from the Mighty, the Wise (Al-Azeez Al-Hakeem) and establish upon it two witnesses: Abraham (Ibrahim) and Moses (Musa).' Then he recited: 'Or has he not been informed of what is in the scriptures (suhuf) of Moses (Musa) and Abraham (Ibrahim) who fulfilled [his obligations] - that no bearer of burdens will bear the burden of another?' Then Ziyad said: 'Release his way, this man has been taught his argument.' And it is said: 'It is written in the Gospel (Injeel): Whoever seeks forgiveness (istaghfara) for the one who wronged him has defeated Satan (Shaytan).'", "book_file": "vol3_Vol3-book5a.doc.txt", "book_title": "Condemnation of Envy", "content_type": "fiqh", "topic": "Al-Ghazali on the outer and inner dimensions of worship, from 'Condemnation of Envy'", "badge": "Worship"}], "39": [{"arabic": "ثم كل ذلك لا ينبهنا ولا يخرجنا عن أودية غرورنا وأمانينا فما هذه إلا محنة هائلة إن لم يتفضل الله علينا بتوبة نصوح يتداركنا بها ويجيرنا فنسأل الله تعالى أن يتوب علينا بل نسأله أن يشوق إلى التوبة سرائر قلوبنا وأن لا يجعل حركة اللسان بسؤال التوبة غاية حظنا فنكون ممن يقول ولا يعمل ويسمع ولا يقبل إذا سمعنا الوعظ بكينا وإذا جاء وقت العمل بما سمعناه عصينا علامة للخذلان أعظم من هذا فنسأل الله تعالى أن يمن علينا بالتوفيق والرشد بمنه وفضله ولنقتصر من حكاية أحوال الخائفين على ما أوردناه فإن القليل من هذا يص", "english": "Then all of that does not awaken us nor bring us out from the valleys of our delusion (Ghurur) and our hopes, so this is nothing but a tremendous trial if Allah does not favor us with a sincere repentance (Tawbah Nasuh) by which He rescues us and grants us refuge, so we ask Allah the Exalted to grant us repentance, rather we ask Him to make the innermost secrets (Sara'ir) of our hearts (Qulub) yearn for repentance and not to make the movement of the tongue in asking for repentance the ultimate portion of our share, so we become among those who speak but do not act and hear but do not accept; when we hear the admonition we weep, but when the time comes for action according to what we have heard, we disobey—a sign of abandonment greater than this. So we ask Allah the Exalted to bestow upon us success (Tawfiq) and right guidance (Rushd) through His grace and favor. And let us limit ourselves from recounting the states of the fearful to what we have mentioned, for a little of this encounters the receptive heart (Qalb Al-Qabil) and suffices, and much of it, even if poured upon the heedless heart (Qalb Al-Ghafil), does not benefit. And indeed, the monk spoke truthfully, about whom Isa ibn Malik Al-Khawlani narrated—and he was among the best of worshippers—that he saw him at the gate of Bayt Al-Maqdis standing like one in sorrow from the intensity of passionate longing (Walah), his tears hardly ceasing from the abundance of weeping. So Isa said when he saw him, his appearance alarmed me, and I said, 'O monk, advise me with an admonition that I may preserve from you.' He said, 'O my brother, with what shall I advise you? If you are able to be in the position of a man whom wild beasts and venomous creatures have surrounded, he is...'", "book_file": "vol4_Vol4-book3.doc.txt", "book_title": "Fear and Hope", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Fear and Hope'", "badge": "Insight"}, {"arabic": "فكذلك لا يحصل في الآخرة ثواب وأجر إلا بعمل صالح فارجعنا نعمل صالحاً فقد علمنا الآن صدقك في قولك \"وأن ليس للإنسان إلا ما سعى وأن سعيه سوف يرى -كلما ألقى فيها فوج سألهم خزنتها ألم يأتكم نذير قالوا بلى قد جاءنا نذير\" أي ألم نسمعكم سنة الله في عباده وأنه \"توفى كل نفس ما كسبت\" وأن \"كل نفس بما كسبت رهينة\" فما الذي غركم بالله بعد أن سمعتم وعقلتم؟ \"قالوا لو كنا نسمع أو نعقل ما كنا في أصحاب السعير فاعترفوا بذنبهم فسحقاً لأصحاب السعير\".", "english": "Thus, in the Hereafter, reward and recompense are not attained except through righteous deeds, so return us that we may work righteousness, for we have now known the truthfulness of Your saying: \"And that for the human being there is nothing except what he strives for, and that his striving will be seen - whenever a group is cast into it, its keepers ask them: 'Did there not come to you a warner?' They say: 'Yes indeed, a warner came to us'\" meaning: Did we not hear you regarding the established way of Allah with His servants, and that \"He takes every soul what it has earned\" and that \"Every soul is a pledge for what it has earned\"? So what deluded you regarding Allah after you heard and comprehended? \"They said: 'If we had been hearing or comprehending, we would not have been among the companions of the Blaze.' So they confessed their sin, so destruction to the companions of the Blaze.\"", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Delusion'", "badge": "Insight"}, {"arabic": "أفتحسبين أن الله كريم في الآخرة دون الدنيا وقد عرفت أن سنة الله لا تبديل لها وأن رب الآخرة والدنيا واحد وأن ليس للإنسان إلا ما سعى ويحك يا نفس ما أعجب نفاقك ودواعيك الباطلة فإنك تدعين الإيمان بلسانك وأثر النفاق ظاهر عليك ألم يقل لك سيدك ومولاك وما من دابة في الأرض إلا على الله رزقها وقال في أمر الآخرة وأن ليس للإنسان إلا ما سعى فقد تكفل لك بأمر الدنيا خاصة وصرفك عن السعى فيها فكذبته بأفعالك وأصبحت تتكالبين على طلبها تكالب المدهوش المستهتر ووكل أمر الآخرة إلى سعيك فأعرضت عنها إعراض المغرور المستح", "english": "Do you think that Allah is generous in the Hereafter but not in this world, when you know that the way of Allah has no change and that the Lord of the Hereafter and this world is one, and that there is not for the human except what he strives for? Woe to you, O Soul (Nafs), how amazing is your hypocrisy and your false motives, for you claim faith with your tongue while the effect of hypocrisy is apparent upon you. Did not your Master and Lord say to you: 'And there is no creature on earth except that its provision is upon Allah' (Quran 11:6), and He said regarding the matter of the Hereafter: 'And that there is not for the human except what he strives for' (Quran 53:39)? So He has guaranteed for you the matter of this world specifically and diverted you from striving in it, yet you have contradicted Him with your actions and have become eagerly scrambling after seeking it like the bewildered and reckless, and He has entrusted the matter of the Hereafter to your striving, yet you have turned away from it like the deluded and contemptuous.", "book_file": "vol4_j4-k08.doc.txt", "book_title": "Monitoring and Accounting", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Monitoring and Accounting'", "badge": "Ethics"}, {"arabic": "أم الحاجة الضرورية فكحاجة سعادة الآخرة إلى الإيمان وحسن الخلق إذ لا سبيل إلى الوصول إلى سعادة الآخرة ألبته إلا بهما فليس للإنسان إلا ما سعى وليس لأحد في الآخرة إلا ما تزود من الدنيا فكذلك حاجة الفضائل النفسية التي تكسب هذه العلوم وتهذب الأخلاق إلى صحة البدن ضروري.", "english": "As for the necessary need, it is like the need of the happiness of the Hereafter (al-Akhirah) for faith (al-Iman) and good character (Husn al-Khuluq), for there is absolutely no way to reach the happiness of the Hereafter except through them, so 'there is not for man except what he strives for' (Quran 53:39), and there is not for anyone in the Hereafter except what he provisioned from the world (al-Dunya). Likewise, the need of the spiritual virtues (al-Fada'il al-Nafsiyyah) that acquire these knowledges and refine the character traits (al-Akhlaq) for the health of the body is necessary.", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}], "59": [{"arabic": "واحتجوا بقوله تعالى أفمن هذا الحديث تعجبون وتضحكون ولا تبكون وأنتم سامدون قال ابن عباس رضي الله عنهما هو الغناء بلغة حمير يعني السمد فنقول ينبغي أن يحرم الضحك وعدم البكاء أيضا لأن الآية تشتمل عليه فإن قيل إن ذلك مخصوص بالضحك على المسلمين لإسلامهم فهذا أيضا مخصوص بأشعارهم وغنائهم في معرض الاستهزاء بالمسلمين كما قال تعالى والشعراء يتبعهم الغاوون وأراد به شعراء الكفار ولم يدل ذلك على تحريم نظم الشعر في نفسه", "english": "And they argued with His statement, the Exalted: 'Do you then wonder at this discourse (Hadith)? And you laugh and do not weep, while you are indulging (Samidun)?' Ibn Abbas, may Allah be pleased with them both, said: 'It is singing (Ghina') in the language of Himyar, meaning the indulgence (Samd).' So we say: It should be prohibited to laugh and not weep also because the verse encompasses that. If it is said that this is specific to laughing at the Muslims for their Islam, then this is also specific to their poems and their singing in the context of mocking the Muslims, as He, the Exalted, said: 'And the poets are followed by the misguided ones (Al-Ghawun),' and He intended by it the poets of the disbelievers, and that does not indicate the prohibition of composing poetry in itself.", "book_file": "vol2_j2-k08.doc.txt", "book_title": "Audition and Ecstasy", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Audition and Ecstasy'", "badge": "Hadith"}, {"arabic": "بل أقول كل ما ورد في فضل البكاء من خشية الله فهو إظهار لفضيلة الخشية فإن البكاء ثمرة الخشية فقد قال تعالى: ﴿ فليضحكوا قليلا وليبكوا كثيرا ﴾ {} وقال تعالى: ﴿ يبكون ويزيدهم خشوعا ﴾ {} وقال عز وجل: ﴿ أفمن هذا الحديث تعجبون وتضحكون ولا تبكون وأنتم سامدون ﴾ {}", "english": "Rather, I say that everything that has come regarding the virtue of weeping from the fear (Khashya) of Allah is a manifestation of the virtue of the fear (Khashya), for weeping is the fruit of the fear (Khashya). Indeed, Allah the Exalted has said: 'So let them laugh a little and weep much' (Quran 9:82). And He the Exalted has said: 'They weep, and it increases them in humility (Khushu')' (Quran 17:109). And He the Mighty and Majestic has said: 'Then at this discourse (Hadith) do you wonder? And you laugh and do not weep, while you are indulging (in vanities)?' (Quran 53:59-61).", "book_file": "vol4_Vol4-book3.doc.txt", "book_title": "Fear and Hope", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Fear and Hope'", "badge": "Hadith"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 350, 2027], [2, 2027, 2899], [3, 2899, 3972]], "2": [[1, 350, 861], [2, 861, 1460], [3, 1460, 2836], [4, 2836, 3642], [5, 3642, 4625]], "3": [[1, 350, 1215], [2, 1215, 2270], [3, 2270, 2734], [4, 2734, 4338]], "4": [[1, 350, 911], [2, 911, 1523], [3, 1523, 2683], [4, 2683, 3728], [5, 3728, 5383]], "5": [[1, 350, 1475], [2, 1475, 2566], [3, 2566, 4051]], "6": [[1, 350, 1040], [2, 1040, 1982], [3, 1982, 3920]], "7": [[1, 350, 1086], [2, 1086, 2162], [3, 2162, 3502]], "8": [[1, 350, 1288], [2, 1288, 2239], [3, 2239, 4129]], "9": [[1, 350, 1263], [2, 1263, 2017], [3, 2017, 3268], [4, 3268, 3804], [5, 3804, 4965]], "10": [[1, 350, 2462], [2, 2462, 3579], [3, 3579, 4635], [4, 4635, 5888], [5, 5888, 7394]], "11": [[1, 350, 814], [2, 814, 1367], [3, 1367, 2473], [4, 2473, 2937], [5, 2937, 4025]], "12": [[1, 350, 2366], [2, 2366, 3374], [3, 3374, 3944], [4, 3944, 5017]], "13": [[1, 350, 1485], [2, 1485, 2471], [3, 2471, 3343], [4, 3343, 4651]], "14": [[1, 350, 1394], [2, 1394, 2748], [3, 2748, 5226]], "15": [[1, 350, 1840], [2, 1840, 2951], [3, 2951, 5278]], "16": [[1, 350, 773], [2, 773, 1748], [3, 1748, 2902], [4, 2902, 3380], [5, 3380, 4521]], "17": [[1, 350, 860], [2, 860, 1586], [3, 1586, 2488], [4, 2488, 3292], [5, 3292, 4234]], "18": [[1, 350, 1081], [2, 1081, 2055], [3, 2055, 2479], [4, 2479, 3708], [5, 3708, 4481], [6, 4481, 6271]], "19": [[1, 350, 1961], [2, 1961, 3057], [3, 3057, 4808]], "20": [[1, 350, 1523], [2, 1523, 2876], [3, 2876, 4364]], "21": [[1, 350, 1400], [2, 1400, 2706], [3, 2706, 3556], [4, 3556, 5305]], "22": [[1, 350, 1203], [2, 1203, 2313], [3, 2313, 3479], [4, 3479, 5670]], "23": [[1, 400, 1037], [2, 1037, 1732], [3, 1732, 3792], [4, 3792, 6185], [5, 6185, 10128], [6, 10128, 11345], [7, 11345, 14926], [8, 14926, 16841], [9, 16841, 18058], [10, 18058, 19202], [11, 19202, 20216], [12, 20216, 20795], [13, 20795, 22296], [14, 22296, 22933], [15, 22933, 25236], [16, 25236, 26554], [17, 26554, 28300], [18, 28300, 