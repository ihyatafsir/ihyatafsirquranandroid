bic": "مَا", "translit": "", "root": ""}, {"id": 6, "arabic": "سَع۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 53, "ayah": 40, "text": "وَأَنَّ سَعْيَهُۥ سَوْفَ يُر۪يٰۖ", "words": [{"id": 1, "arabic": "وَأَنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "سَعْيَهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "سَوْفَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يُر۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 53, "ayah": 41, "text": "ثُمَّ يُجْز۪يٰهُ اُ۬لْجَزَآءَ اَ۬لَاوْف۪يٰۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "يُجْز۪يٰهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْجَزَآءَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لَاوْف۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 53, "ayah": 42, "text": "وَأَنَّ إِلَيٰ رَبِّكَ اَ۬لْمُنتَه۪يٰۖ", "words": [{"id": 1, "arabic": "وَأَنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمُنتَه۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 53, "ayah": 43, "text": "وَأَنَّهُۥ هُوَ أَضْحَكَ وَأَبْك۪يٰۖ", "words": [{"id": 1, "arabic": "وَأَنَّهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَضْحَكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَأَبْك۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 53, "ayah": 44, "text": "وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحْي۪اۖ", "words": [{"id": 1, "arabic": "وَأَنَّهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَمَاتَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَأَحْي۪اۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 53, "ayah": 45, "text": "وَأَنَّهُۥ خَلَقَ اَ۬لزَّوْجَيْنِ اِ۬لذَّكَرَ و