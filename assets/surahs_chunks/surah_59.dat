{"surah": 59, "verses": [{"ayah": 1, "text": "سَبَّحَ لِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ ", "translation": "Whatever is in the heavens and whatever is on the earth exalts Allāh,[1] and He is the Exalted in Might, the Wise.", "words": [{"id": 1, "arabic": "سَبَّحَ", "translit": "َḥَّbَs", "root": "سبح"}, {"id": 2, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 10, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 11, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}, {"ayah": 2, "text": "هُوَ ٱلَّذِىٓ أَخْرَجَ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَٰبِ مِن دِيَٰرِهِمْ لِأَوَّلِ ٱلْحَشْرِۚ مَا ظَنَنتُمْ أَن يَخْرُجُوا۟ۖ وَظَنُّوٓا۟ أَنَّهُم مَّانِعَتُهُمْ حُصُونُهُم مِّنَ ٱللَّهِ فَأَتَىٰهُمُ ٱللَّهُ مِنْ حَيْثُ لَمْ يَحْتَسِبُوا۟ۖ وَقَذَفَ فِى قُلُوبِهِمُ ٱلرُّعْبَۚ يُخْرِبُونَ بُيُوتَهُم بِأَيْدِيهِمْ وَأَيْدِى ٱلْمُؤْمِنِينَ فَٱعْتَبِرُوا۟ يَٰٓأُو۟لِى ٱلْأَبْصَٰرِ ", "translation": "It is He who expelled the ones who disbelieved among the People of the Scripture[1] from their homes at the first gathering.[2] You did not think they would leave, and they thought that their fortresses would protect them from Allāh; but [the decree of] Allāh came upon them from where they had not expected, and He cast terror into their hearts [so] they destroyed their houses by their [own] hands and the hands of the believers. So take warning, O people of vision.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "أَخْرَجَ", "translit": "َjgَrْhkَaʾ", "root": "خرج"}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 6, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 7, "arabic": "أَهْلِ", "translit": "ِlْhَaʾ", "root": "اهل"}, {"id": 8, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "دِيَٰرِهِمْ", "translit": "ْmِhِrَٰyِd", "root": "دور"}, {"id": 11, "arabic": "لِأَوَّلِ", "translit": "ِlَّwَaʾِl", "root": "اول"}, {"id": 12, "arabic": "ٱلْحَشْرِ", "translit": "ِrْhsَḥْlٱ", "root": "حشر"}, {"id": 13, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 14, "arabic": "ظَنَنتُمْ", "translit": "ْmُtnَnَẓ", "root": "ظنن"}, {"id": 15, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 16, "arabic": "يَخْرُجُوا۟", "translit": "۟āwُjgُrْhkَy", "root": "خرج"}, {"id": 17, "arabic": "وَظَنُّوٓا۟", "translit": "۟āٓwُّnَẓَw", "root": "ظنن"}, {"id": 18, "arabic": "أَنَّهُم", "translit": "mُhَّnَaʾ", "root": ""}, {"id": 19, "arabic": "مَّانِعَتُهُمْ", "translit": "ْmُhُtَʿعِnāَّm", "root": "منع"}, {"id": 20, "arabic": "حُصُونُهُم", "translit": "mُhُnwُṣُḥ", "root": "حصن"}, {"id": 21, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 22, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "فَأَتَىٰهُمُ", "translit": "ُmُhٰàَtَaʾَf", "root": "اتي"}, {"id": 24, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 25, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 26, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 27, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 28, "arabic": "يَحْتَسِبُوا۟", "translit": "۟āwُbِsَtْḥَy", "root": "حسب"}, {"id": 29, "arabic": "وَقَذَفَ", "translit": "َfَhdَqَw", "root": "قذف"}, {"id": 30, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 31, "arabic": "قُلُوبِهِمُ", "translit": "ُmِhِbwُlُq", "root": "قلب"}, {"id": 32, "arabic": "ٱلرُّعْبَ", "translit": "َbْʿعُّrlٱ", "root": "رعب"}, {"id": 33, "arabic": "يُخْرِبُونَ", "translit": "َnwُbِrْhkُy", "root": "خرب"}, {"id": 34, "arabic": "بُيُوتَهُم", "translit": "mُhَtwُyُb", "root": "بيت"}, {"id": 35, "arabic": "بِأَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾِb", "root": "يدي"}, {"id": 36, "arabic": "وَأَيْدِى", "translit": "àِdْyَaʾَw", "root": "يدي"}, {"id": 37, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 38, "arabic": "فَٱعْتَبِرُوا۟", "translit": "۟āwُrِbَtْʿعٱَf", "root": "عبر"}, {"id": 39, "arabic": "يَٰٓأُو۟لِى", "translit": "àِl۟wُaʾَٰٓy", "root": ""}, {"id": 40, "arabic": "ٱلْأَبْصَٰرِ", "translit": "ِrَٰṣْbَaʾْlٱ", "root": "بصر"}], "hasIhya": true}, {"ayah": 3, "text": "وَلَوْلَآ أَن كَتَبَ ٱللَّهُ عَلَيْهِمُ ٱلْجَلَآءَ لَعَذَّبَهُمْ فِى ٱلدُّنْيَاۖ وَلَهُمْ فِى ٱلْءَاخِرَةِ عَذَابُ ٱلنَّارِ ", "translation": "And if not that Allāh had decreed for them evacuation, He would have punished them in [this] world, and for them in the Hereafter is the punishment of the Fire.", "words": [{"id": 1, "arabic": "وَلَوْلَآ", "translit": "ٓāَlْwَlَw", "root": ""}, {"id": 2, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 3, "arabic": "كَتَبَ", "translit": "َbَtَk", "root": "كتب"}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلْجَلَآءَ", "translit": "َءٓāَlَjgْlٱ", "root": "جلو"}, {"id": 7, "arabic": "لَعَذَّبَهُمْ", "translit": "ْmُhَbَّhdَʿعَl", "root": "عذب"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 10, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 13, "arabic": "عَذَابُ", "translit": "ُbāَhdَʿع", "root": "عذب"}, {"id": 14, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}], "hasIhya": false}, {"ayah": 4, "text": "ذَٰلِكَ بِأَنَّهُمْ شَآقُّوا۟ ٱللَّهَ وَرَسُولَهُۥۖ وَمَن يُشَآقِّ ٱللَّهَ فَإِنَّ ٱللَّهَ شَدِيدُ ٱلْعِقَابِ ", "translation": "That is because they opposed Allāh and His Messenger. And whoever opposes Allāh - then indeed, Allāh is severe in penalty.", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "بِأَنَّهُمْ", "translit": "ْmُhَّnَaʾِb", "root": ""}, {"id": 3, "arabic": "شَآقُّوا۟", "translit": "۟āwُّqٓāَhs", "root": "شقق"}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَرَسُولَهُۥ", "translit": "ۥُhَlwُsَrَw", "root": "رسل"}, {"id": 6, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 7, "arabic": "يُشَآقِّ", "translit": "ِّqٓāَhsُy", "root": "شقق"}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "شَدِيدُ", "translit": "ُdyِdَhs", "root": "شدد"}, {"id": 12, "arabic": "ٱلْعِقَابِ", "translit": "ِbāَqِʿعْlٱ", "root": "عقب"}], "hasIhya": false}, {"ayah": 5, "text": "مَا قَطَعْتُم مِّن لِّينَةٍ أَوْ تَرَكْتُمُوهَا قَآئِمَةً عَلَىٰٓ أُصُولِهَا فَبِإِذْنِ ٱللَّهِ وَلِيُخْزِىَ ٱلْفَٰسِقِينَ ", "translation": "Whatever you have cut down of [their] palm trees or left standing on their trunks - it was by permission of Allāh and so He would disgrace the defiantly disobedient.", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "قَطَعْتُم", "translit": "mُtْʿعَṭَq", "root": "قطع"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "لِّينَةٍ", "translit": "ٍẗَnyِّl", "root": "لين"}, {"id": 5, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 6, "arabic": "تَرَكْتُمُوهَا", "translit": "āَhwُmُtْkَrَt", "root": "ترك"}, {"id": 7, "arabic": "قَآئِمَةً", "translit": "ًẗَmِyʾٓāَq", "root": "قوم"}, {"id": 8, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 9, "arabic": "أُصُولِهَا", "translit": "āَhِlwُṣُaʾ", "root": "اصل"}, {"id": 10, "arabic": "فَبِإِذْنِ", "translit": "ِnْhdِiʾِbَf", "root": "اذن"}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "وَلِيُخْزِىَ", "translit": "َàِzْhkُyِlَw", "root": "خزي"}, {"id": 13, "arabic": "ٱلْفَٰسِقِينَ", "translit": "َnyِqِsَٰfْlٱ", "root": "فسق"}], "hasIhya": false}, {"ayah": 6, "text": "وَمَآ أَفَآءَ ٱللَّهُ عَلَىٰ رَسُولِهِۦ مِنْهُمْ فَمَآ أَوْجَفْتُمْ عَلَيْهِ مِنْ خَيْلٍ وَلَا رِكَابٍ وَلَٰكِنَّ ٱللَّهَ يُسَلِّطُ رُسُلَهُۥ عَلَىٰ مَن يَشَآءُۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "And what Allāh restored [of property] to His Messenger from them - you did not spur for it [in an expedition] any horses or camels,[1] but Allāh gives His messengers power over whom He wills, and Allāh is over all things competent.", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَفَآءَ", "translit": "َءٓāَfَaʾ", "root": "فيا"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 5, "arabic": "رَسُولِهِۦ", "translit": "ۦِhِlwُsَr", "root": "رسل"}, {"id": 6, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 7, "arabic": "فَمَآ", "translit": "ٓāَmَf", "root": ""}, {"id": 8, "arabic": "أَوْجَفْتُمْ", "translit": "ْmُtْfَjgْwَaʾ", "root": "وجف"}, {"id": 9, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 10, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 11, "arabic": "خَيْلٍ", "translit": "ٍlْyَhk", "root": "خيل"}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "رِكَابٍ", "translit": "ٍbāَkِr", "root": "ركب"}, {"id": 14, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 15, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "يُسَلِّطُ", "translit": "ُṭِّlَsُy", "root": "سلط"}, {"id": 17, "arabic": "رُسُلَهُۥ", "translit": "ۥُhَlُsُr", "root": "رسل"}, {"id": 18, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 19, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 20, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 21, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 22, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 23, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 24, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 25, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 7, "text": "مَّآ أَفَآءَ ٱللَّهُ عَلَىٰ رَسُولِهِۦ مِنْ أَهْلِ ٱلْقُرَىٰ فَلِلَّهِ وَلِلرَّسُولِ وَلِذِى ٱلْقُرْبَىٰ وَٱلْيَتَٰمَىٰ وَٱلْمَسَٰكِينِ وَٱبْنِ ٱلسَّبِيلِ كَىْ لَا يَكُونَ دُولَةًۢ بَيْنَ ٱلْأَغْنِيَآءِ مِنكُمْۚ وَمَآ ءَاتَىٰكُمُ ٱلرَّسُولُ فَخُذُوهُ وَمَا نَهَىٰكُمْ عَنْهُ فَٱنتَهُوا۟ۚ وَٱتَّقُوا۟ ٱللَّهَۖ إِنَّ ٱللَّهَ شَدِيدُ ٱلْعِقَابِ ", "translation": "And what Allāh restored to His Messenger from the people of the towns - it is for Allāh and for the Messenger and for [his] near relatives[1] and orphans and the needy and the [stranded] traveler[2] - so that it will not be a perpetual distribution among the rich from among you. And whatever the Messenger has given you - take; and what he has forbidden you - refrain from. And fear Allāh; indeed, Allāh is severe in penalty.", "words": [{"id": 1, "arabic": "مَّآ", "translit": "ٓāَّm", "root": ""}, {"id": 2, "arabic": "أَفَآءَ", "translit": "َءٓāَfَaʾ", "root": "فيا"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 5, "arabic": "رَسُولِهِۦ", "translit": "ۦِhِlwُsَr", "root": "رسل"}, {"id": 6, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 7, "arabic": "أَهْلِ", "translit": "ِlْhَaʾ", "root": "اهل"}, {"id": 8, "arabic": "ٱلْقُرَىٰ", "translit": "ٰàَrُqْlٱ", "root": "قري"}, {"id": 9, "arabic": "فَلِلَّهِ", "translit": "ِhَّlِlَf", "root": "اله"}, {"id": 10, "arabic": "وَلِلرَّسُولِ", "translit": "ِlwُsَّrlِlَw", "root": "رسل"}, {"id": 11, "arabic": "وَلِذِى", "translit": "àِhdِlَw", "root": ""}, {"id": 12, "arabic": "ٱلْقُرْبَىٰ", "translit": "ٰàَbْrُqْlٱ", "root": "قرب"}, {"id": 13, "arabic": "وَٱلْيَتَٰمَىٰ", "translit": "ٰàَmَٰtَyْlٱَw", "root": "يتم"}, {"id": 14, "arabic": "وَٱلْمَسَٰكِينِ", "translit": "ِnyِkَٰsَmْlٱَw", "root": "سكن"}, {"id": 15, "arabic": "وَٱبْنِ", "translit": "ِnْbٱَw", "root": "بني"}, {"id": 16, "arabic": "ٱلسَّبِيلِ", "translit": "ِlyِbَّslٱ", "root": "سبل"}, {"id": 17, "arabic": "كَىْ", "translit": "ْàَk", "root": ""}, {"id": 18, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 19, "arabic": "يَكُونَ", "translit": "َnwُkَy", "root": "كون"}, {"id": 20, "arabic": "دُولَةًۢ", "translit": "ًۢẗَlwُd", "root": "دول"}, {"id": 21, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 22, "arabic": "ٱلْأَغْنِيَآءِ", "translit": "ِءٓāَyِnْغَaʾْlٱ", "root": "غني"}, {"id": 23, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 24, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 25, "arabic": "ءَاتَىٰكُمُ", "translit": "ُmُkٰàَtāَء", "root": "اتي"}, {"id": 26, "arabic": "ٱلرَّسُولُ", "translit": "ُlwُsَّrlٱ", "root": "رسل"}, {"id": 27, "arabic": "فَخُذُوهُ", "translit": "ُhwُhdُhkَf", "root": "اخذ"}, {"id": 28, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 29, "arabic": "نَهَىٰكُمْ", "translit": "ْmُkٰàَhَn", "root": "نهي"}, {"id": 30, "arabic": "عَنْهُ", "translit": "ُhْnَʿع", "root": ""}, {"id": 31, "arabic": "فَٱنتَهُوا۟", "translit": "۟āwُhَtnٱَf", "root": "نهي"}, {"id": 32, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 33, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 34, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 35, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 36, "arabic": "شَدِيدُ", "translit": "ُdyِdَhs", "root": "شدد"}, {"id": 37, "arabic": "ٱلْعِقَابِ", "translit": "ِbāَqِʿعْlٱ", "root": "عقب"}], "hasIhya": false}, {"ayah": 8, "text": "لِلْفُقَرَآءِ ٱلْمُهَٰجِرِينَ ٱلَّذِينَ أُخْرِجُوا۟ مِن دِيَٰرِهِمْ وَأَمْوَٰلِهِمْ يَبْتَغُونَ فَضْلًا مِّنَ ٱللَّهِ وَرِضْوَٰنًا وَيَنصُرُونَ ٱللَّهَ وَرَسُولَهُۥٓۚ أُو۟لَٰٓئِكَ هُمُ ٱلصَّٰدِقُونَ ", "translation": "For the poor emigrants who were expelled from their homes and their properties, seeking bounty from Allāh and [His] approval and supporting [the cause of] Allāh and His Messenger, [there is also a share]. Those are the truthful.", "words": [{"id": 1, "arabic": "لِلْفُقَرَآءِ", "translit": "ِءٓāَrَqُfْlِl", "root": "فقر"}, {"id": 2, "arabic": "ٱلْمُهَٰجِرِينَ", "translit": "َnyِrِjgَٰhُmْlٱ", "root": "هجر"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "أُخْرِجُوا۟", "translit": "۟āwُjgِrْhkُaʾ", "root": "خرج"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "دِيَٰرِهِمْ", "translit": "ْmِhِrَٰyِd", "root": "دور"}, {"id": 7, "arabic": "وَأَمْوَٰلِهِمْ", "translit": "ْmِhِlَٰwْmَaʾَw", "root": "مول"}, {"id": 8, "arabic": "يَبْتَغُونَ", "translit": "َnwُغَtْbَy", "root": "بغي"}, {"id": 9, "arabic": "فَضْلًا", "translit": "āًlْḍَf", "root": "فضل"}, {"id": 10, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "وَرِضْوَٰنًا", "translit": "āًnَٰwْḍِrَw", "root": "رضو"}, {"id": 13, "arabic": "وَيَنصُرُونَ", "translit": "َnwُrُṣnَyَw", "root": "نصر"}, {"id": 14, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "وَرَسُولَهُۥٓ", "translit": "ٓۥُhَlwُsَrَw", "root": "رسل"}, {"id": 16, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 17, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 18, "arabic": "ٱلصَّٰدِقُونَ", "translit": "َnwُqِdَّٰṣlٱ", "root": "صدق"}], "hasIhya": true}, {"ayah": 9, "text": "وَٱلَّذِينَ تَبَوَّءُو ٱلدَّارَ وَٱلْإِيمَٰنَ مِن قَبْلِهِمْ يُحِبُّونَ مَنْ هَاجَرَ إِلَيْهِمْ وَلَا يَجِدُونَ فِى صُدُورِهِمْ حَاجَةً مِّمَّآ أُوتُوا۟ وَيُؤْثِرُونَ عَلَىٰٓ أَنفُسِهِمْ وَلَوْ كَانَ بِهِمْ خَصَاصَةٌۚ وَمَن يُوقَ شُحَّ نَفْسِهِۦ فَأُو۟لَٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ ", "translation": "And [also for] those who were settled in the Home [i.e.,al-Madīnah] and [adopted] the faith before them.[1] They love those who emigrated to them and find not any want in their breasts of what they [i.e., the emigrants] were given but give [them] preference over themselves, even though they are in privation. And whoever is protected from the stinginess of his soul - it is those who will be the successful.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "تَبَوَّءُو", "translit": "wُءَّwَbَt", "root": "بوا"}, {"id": 3, "arabic": "ٱلدَّارَ", "translit": "َrāَّdlٱ", "root": "دور"}, {"id": 4, "arabic": "وَٱلْإِيمَٰنَ", "translit": "َnَٰmyِiʾْlٱَw", "root": "امن"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "قَبْلِهِمْ", "translit": "ْmِhِlْbَq", "root": "قبل"}, {"id": 7, "arabic": "يُحِبُّونَ", "translit": "َnwُّbِḥُy", "root": "حبب"}, {"id": 8, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 9, "arabic": "هَاجَرَ", "translit": "َrَjgāَh", "root": "هجر"}, {"id": 10, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "يَجِدُونَ", "translit": "َnwُdِjgَy", "root": "وجد"}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "صُدُورِهِمْ", "translit": "ْmِhِrwُdُṣ", "root": "صدر"}, {"id": 15, "arabic": "حَاجَةً", "translit": "ًẗَjgāَḥ", "root": "حوج"}, {"id": 16, "arabic": "مِّمَّآ", "translit": "ٓāَّmِّm", "root": ""}, {"id": 17, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 18, "arabic": "وَيُؤْثِرُونَ", "translit": "َnwُrِhtْwʾُyَw", "root": "اثر"}, {"id": 19, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 20, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 21, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 22, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 23, "arabic": "بِهِمْ", "translit": "ْmِhِb", "root": ""}, {"id": 24, "arabic": "خَصَاصَةٌ", "translit": "ٌẗَṣāَṣَhk", "root": "خصص"}, {"id": 25, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 26, "arabic": "يُوقَ", "translit": "َqwُy", "root": "وقي"}, {"id": 27, "arabic": "شُحَّ", "translit": "َّḥُhs", "root": "شحح"}, {"id": 28, "arabic": "نَفْسِهِۦ", "translit": "ۦِhِsْfَn", "root": "نفس"}, {"id": 29, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 30, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 31, "arabic": "ٱلْمُفْلِحُونَ", "translit": "َnwُḥِlْfُmْlٱ", "root": "فلح"}], "hasIhya": true}, {"ayah": 10, "text": "وَٱلَّذِينَ جَآءُو مِنۢ بَعْدِهِمْ يَقُولُونَ رَبَّنَا ٱغْفِرْ لَنَا وَلِإِخْوَٰنِنَا ٱلَّذِينَ سَبَقُونَا بِٱلْإِيمَٰنِ وَلَا تَجْعَلْ فِى قُلُوبِنَا غِلًّا لِّلَّذِينَ ءَامَنُوا۟ رَبَّنَآ إِنَّكَ رَءُوفٌ رَّحِيمٌ ", "translation": "And [there is a share for] those who come after them, saying, \"Our Lord, forgive us and our brothers who preceded us in faith and put not in our hearts [any] resentment toward those who have believed. Our Lord, indeed You are Kind and Merciful.\"", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "جَآءُو", "translit": "wُءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 4, "arabic": "بَعْدِهِمْ", "translit": "ْmِhِdْʿعَb", "root": "بعد"}, {"id": 5, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 6, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 7, "arabic": "ٱغْفِرْ", "translit": "ْrِfْغٱ", "root": "غفر"}, {"id": 8, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 9, "arabic": "وَلِإِخْوَٰنِنَا", "translit": "āَnِnَٰwْhkِiʾِlَw", "root": "اخو"}, {"id": 10, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "سَبَقُونَا", "translit": "āَnwُqَbَs", "root": "سبق"}, {"id": 12, "arabic": "بِٱلْإِيمَٰنِ", "translit": "ِnَٰmyِiʾْlٱِb", "root": "امن"}, {"id": 13, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 14, "arabic": "تَجْعَلْ", "translit": "ْlَʿعْjgَt", "root": "جعل"}, {"id": 15, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 16, "arabic": "قُلُوبِنَا", "translit": "āَnِbwُlُq", "root": "قلب"}, {"id": 17, "arabic": "غِلًّا", "translit": "āًّlِغ", "root": "غلل"}, {"id": 18, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 19, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 20, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 21, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 22, "arabic": "رَءُوفٌ", "translit": "ٌfwُءَr", "root": "راف"}, {"id": 23, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 11, "text": "أَلَمْ تَرَ إِلَى ٱلَّذِينَ نَافَقُوا۟ يَقُولُونَ لِإِخْوَٰنِهِمُ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَٰبِ لَئِنْ أُخْرِجْتُمْ لَنَخْرُجَنَّ مَعَكُمْ وَلَا نُطِيعُ فِيكُمْ أَحَدًا أَبَدًا وَإِن قُوتِلْتُمْ لَنَنصُرَنَّكُمْ وَٱللَّهُ يَشْهَدُ إِنَّهُمْ لَكَٰذِبُونَ ", "translation": "Have you not considered those who practice hypocrisy, saying to their brothers [i.e., associates] who have disbelieved among the People of the Scripture, \"If you are expelled, we will surely leave with you, and we will not obey, in regard to you, anyone - ever; and if you are fought, we will surely aid you.\" But Allāh testifies that they are liars.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "نَافَقُوا۟", "translit": "۟āwُqَfāَn", "root": "نفق"}, {"id": 6, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 7, "arabic": "لِإِخْوَٰنِهِمُ", "translit": "ُmِhِnَٰwْhkِiʾِl", "root": "اخو"}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 10, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 11, "arabic": "أَهْلِ", "translit": "ِlْhَaʾ", "root": "اهل"}, {"id": 12, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 13, "arabic": "لَئِنْ", "translit": "ْnِyʾَl", "root": ""}, {"id": 14, "arabic": "أُخْرِجْتُمْ", "translit": "ْmُtْjgِrْhkُaʾ", "root": "خرج"}, {"id": 15, "arabic": "لَنَخْرُجَنَّ", "translit": "َّnَjgُrْhkَnَl", "root": "خرج"}, {"id": 16, "arabic": "مَعَكُمْ", "translit": "ْmُkَʿعَm", "root": ""}, {"id": 17, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 18, "arabic": "نُطِيعُ", "translit": "ُʿعyِṭُn", "root": "طوع"}, {"id": 19, "arabic": "فِيكُمْ", "translit": "ْmُkyِf", "root": ""}, {"id": 20, "arabic": "أَحَدًا", "translit": "āًdَḥَaʾ", "root": "احد"}, {"id": 21, "arabic": "أَبَدًا", "translit": "āًdَbَaʾ", "root": "ابد"}, {"id": 22, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 23, "arabic": "قُوتِلْتُمْ", "translit": "ْmُtْlِtwُq", "root": "قتل"}, {"id": 24, "arabic": "لَنَنصُرَنَّكُمْ", "translit": "ْmُkَّnَrُṣnَnَl", "root": "نصر"}, {"id": 25, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 26, "arabic": "يَشْهَدُ", "translit": "ُdَhْhsَy", "root": "شهد"}, {"id": 27, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 28, "arabic": "لَكَٰذِبُونَ", "translit": "َnwُbِhdَٰkَl", "root": "كذب"}], "hasIhya": false}, {"ayah": 12, "text": "لَئِنْ أُخْرِجُوا۟ لَا يَخْرُجُونَ مَعَهُمْ وَلَئِن قُوتِلُوا۟ لَا يَنصُرُونَهُمْ وَلَئِن نَّصَرُوهُمْ لَيُوَلُّنَّ ٱلْأَدْبَٰرَ ثُمَّ لَا يُنصَرُونَ ", "translation": "If they are expelled, they will not leave with them, and if they are fought, they will not aid them. And [even] if they should aid them, they will surely turn their backs; then [thereafter] they will not be aided.", "words": [{"id": 1, "arabic": "لَئِنْ", "translit": "ْnِyʾَl", "root": ""}, {"id": 2, "arabic": "أُخْرِجُوا۟", "translit": "۟āwُjgِrْhkُaʾ", "root": "خرج"}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يَخْرُجُونَ", "translit": "َnwُjgُrْhkَy", "root": "خرج"}, {"id": 5, "arabic": "مَعَهُمْ", "translit": "ْmُhَʿعَm", "root": ""}, {"id": 6, "arabic": "وَلَئِن", "translit": "nِyʾَlَw", "root": ""}, {"id": 7, "arabic": "قُوتِلُوا۟", "translit": "۟āwُlِtwُq", "root": "قتل"}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "يَنصُرُونَهُمْ", "translit": "ْmُhَnwُrُṣnَy", "root": "نصر"}, {"id": 10, "arabic": "وَلَئِن", "translit": "nِyʾَlَw", "root": ""}, {"id": 11, "arabic": "نَّصَرُوهُمْ", "translit": "ْmُhwُrَṣَّn", "root": "نصر"}, {"id": 12, "arabic": "لَيُوَلُّنَّ", "translit": "َّnُّlَwُyَl", "root": "ولي"}, {"id": 13, "arabic": "ٱلْأَدْبَٰرَ", "translit": "َrَٰbْdَaʾْlٱ", "root": "دبر"}, {"id": 14, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 15, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 16, "arabic": "يُنصَرُونَ", "translit": "َnwُrَṣnُy", "root": "نصر"}], "hasIhya": false}, {"ayah": 13, "text": "لَأَنتُمْ أَشَدُّ رَهْبَةً فِى صُدُورِهِم مِّنَ ٱللَّهِۚ ذَٰلِكَ بِأَنَّهُمْ قَوْمٌ لَّا يَفْقَهُونَ ", "translation": "You [believers] are more fearful within their breasts than Allāh. That is because they are a people who do not understand.", "words": [{"id": 1, "arabic": "لَأَنتُمْ", "translit": "ْmُtnَaʾَl", "root": ""}, {"id": 2, "arabic": "أَشَدُّ", "translit": "ُّdَhsَaʾ", "root": "شدد"}, {"id": 3, "arabic": "رَهْبَةً", "translit": "ًẗَbْhَr", "root": "رهب"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "صُدُورِهِم", "translit": "mِhِrwُdُṣ", "root": "صدر"}, {"id": 6, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 9, "arabic": "بِأَنَّهُمْ", "translit": "ْmُhَّnَaʾِb", "root": ""}, {"id": 10, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 11, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 12, "arabic": "يَفْقَهُونَ", "translit": "َnwُhَqْfَy", "root": "فقه"}], "hasIhya": true}, {"ayah": 14, "text": "لَا يُقَٰتِلُونَكُمْ جَمِيعًا إِلَّا فِى قُرًى مُّحَصَّنَةٍ أَوْ مِن وَرَآءِ جُدُرٍۭۚ بَأْسُهُم بَيْنَهُمْ شَدِيدٌۚ تَحْسَبُهُمْ جَمِيعًا وَقُلُوبُهُمْ شَتَّىٰۚ ذَٰلِكَ بِأَنَّهُمْ قَوْمٌ لَّا يَعْقِلُونَ ", "translation": "They will not fight you all except within fortified cities or from behind walls. Their violence [i.e., enmity] among themselves is severe. You think they are together, but their hearts are diverse. That is because they are a people who do not reason.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "يُقَٰتِلُونَكُمْ", "translit": "ْmُkَnwُlِtَٰqُy", "root": "قتل"}, {"id": 3, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "قُرًى", "translit": "àًrُq", "root": "قري"}, {"id": 7, "arabic": "مُّحَصَّنَةٍ", "translit": "ٍẗَnَّṣَḥُّm", "root": "حصن"}, {"id": 8, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "وَرَآءِ", "translit": "ِءٓāَrَw", "root": "وري"}, {"id": 11, "arabic": "جُدُرٍۭ", "translit": "ٍۭrُdُjg", "root": "جدر"}, {"id": 12, "arabic": "بَأْسُهُم", "translit": "mُhُsْaʾَb", "root": "باس"}, {"id": 13, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 14, "arabic": "شَدِيدٌ", "translit": "ٌdyِdَhs", "root": "شدد"}, {"id": 15, "arabic": "تَحْسَبُهُمْ", "translit": "ْmُhُbَsْḥَt", "root": "حسب"}, {"id": 16, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 17, "arabic": "وَقُلُوبُهُمْ", "translit": "ْmُhُbwُlُqَw", "root": "قلب"}, {"id": 18, "arabic": "شَتَّىٰ", "translit": "ٰàَّtَhs", "root": "شتت"}, {"id": 19, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 20, "arabic": "بِأَنَّهُمْ", "translit": "ْmُhَّnَaʾِb", "root": ""}, {"id": 21, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 22, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 23, "arabic": "يَعْقِلُونَ", "translit": "َnwُlِqْʿعَy", "root": "عقل"}], "hasIhya": false}, {"ayah": 15, "text": "كَمَثَلِ ٱلَّذِينَ مِن قَبْلِهِمْ قَرِيبًاۖ ذَاقُوا۟ وَبَالَ أَمْرِهِمْ وَلَهُمْ عَذَابٌ أَلِيمٌ ", "translation": "[Theirs is] like the example of those shortly before them: they tasted the bad consequence of their affair, and they will have a painful punishment.", "words": [{"id": 1, "arabic": "كَمَثَلِ", "translit": "ِlَhtَmَk", "root": "مثل"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "قَبْلِهِمْ", "translit": "ْmِhِlْbَq", "root": "قبل"}, {"id": 5, "arabic": "قَرِيبًا", "translit": "āًbyِrَq", "root": "قرب"}, {"id": 6, "arabic": "ذَاقُوا۟", "translit": "۟āwُqāَhd", "root": "ذوق"}, {"id": 7, "arabic": "وَبَالَ", "translit": "َlāَbَw", "root": "وبل"}, {"id": 8, "arabic": "أَمْرِهِمْ", "translit": "ْmِhِrْmَaʾ", "root": "امر"}, {"id": 9, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 10, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 11, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 16, "text": "كَمَثَلِ ٱلشَّيْطَٰنِ إِذْ قَالَ لِلْإِنسَٰنِ ٱكْفُرْ فَلَمَّا كَفَرَ قَالَ إِنِّى بَرِىٓءٌ مِّنكَ إِنِّىٓ أَخَافُ ٱللَّهَ رَبَّ ٱلْعَٰلَمِينَ ", "translation": "[The hypocrites are] like the example of Satan when he says to man, \"Disbelieve.\" But when he disbelieves, he says, \"Indeed, I am disassociated from you. Indeed, I fear Allāh, Lord of the worlds.\"", "words": [{"id": 1, "arabic": "كَمَثَلِ", "translit": "ِlَhtَmَk", "root": "مثل"}, {"id": 2, "arabic": "ٱلشَّيْطَٰنِ", "translit": "ِnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 3, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 4, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 5, "arabic": "لِلْإِنسَٰنِ", "translit": "ِnَٰsnِiʾْlِl", "root": "انس"}, {"id": 6, "arabic": "ٱكْفُرْ", "translit": "ْrُfْkٱ", "root": "كفر"}, {"id": 7, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 8, "arabic": "كَفَرَ", "translit": "َrَfَk", "root": "كفر"}, {"id": 9, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 10, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 11, "arabic": "بَرِىٓءٌ", "translit": "ٌءٓàِrَb", "root": "برا"}, {"id": 12, "arabic": "مِّنكَ", "translit": "َknِّm", "root": ""}, {"id": 13, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 14, "arabic": "أَخَافُ", "translit": "ُfāَhkَaʾ", "root": "خوف"}, {"id": 15, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "رَبَّ", "translit": "َّbَr", "root": "ربب"}, {"id": 17, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": true}, {"ayah": 17, "text": "فَكَانَ عَٰقِبَتَهُمَآ أَنَّهُمَا فِى ٱلنَّارِ خَٰلِدَيْنِ فِيهَاۚ وَذَٰلِكَ جَزَٰٓؤُا۟ ٱلظَّٰلِمِينَ ", "translation": "So the outcome for both of them is that they will be in the Fire, abiding eternally therein. And that is the recompense of the wrongdoers.", "words": [{"id": 1, "arabic": "فَكَانَ", "translit": "َnāَkَf", "root": "كون"}, {"id": 2, "arabic": "عَٰقِبَتَهُمَآ", "translit": "ٓāَmُhَtَbِqَٰʿع", "root": "عقب"}, {"id": 3, "arabic": "أَنَّهُمَا", "translit": "āَmُhَّnَaʾ", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 6, "arabic": "خَٰلِدَيْنِ", "translit": "ِnْyَdِlَٰhk", "root": "خلد"}, {"id": 7, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 8, "arabic": "وَذَٰلِكَ", "translit": "َkِlَٰhdَw", "root": ""}, {"id": 9, "arabic": "جَزَٰٓؤُا۟", "translit": "۟āُwʾَٰٓzَjg", "root": "جزي"}, {"id": 10, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 18, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ وَلْتَنظُرْ نَفْسٌ مَّا قَدَّمَتْ لِغَدٍۖ وَٱتَّقُوا۟ ٱللَّهَۚ إِنَّ ٱللَّهَ خَبِيرٌۢ بِمَا تَعْمَلُونَ ", "translation": "O you who have believed, fear Allāh. And let every soul look to what it has put forth for tomorrow - and fear Allāh. Indeed, Allāh is Aware of what you do.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "ٱتَّقُوا۟", "translit": "۟āwُqَّtٱ", "root": "وقي"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَلْتَنظُرْ", "translit": "ْrُẓnَtْlَw", "root": "نظر"}, {"id": 7, "arabic": "نَفْسٌ", "translit": "ٌsْfَn", "root": "نفس"}, {"id": 8, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 9, "arabic": "قَدَّمَتْ", "translit": "ْtَmَّdَq", "root": "قدم"}, {"id": 10, "arabic": "لِغَدٍ", "translit": "ٍdَغِl", "root": "غدو"}, {"id": 11, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 12, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 14, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "خَبِيرٌۢ", "translit": "ٌۢryِbَhk", "root": "خبر"}, {"id": 16, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 17, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": true}, {"ayah": 19, "text": "وَلَا تَكُونُوا۟ كَٱلَّذِينَ نَسُوا۟ ٱللَّهَ فَأَنسَىٰهُمْ أَنفُسَهُمْۚ أُو۟لَٰٓئِكَ هُمُ ٱلْفَٰسِقُونَ ", "translation": "And be not like those who forgot Allāh, so He made them forget themselves. Those are the defiantly disobedient.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَكُونُوا۟", "translit": "۟āwُnwُkَt", "root": "كون"}, {"id": 3, "arabic": "كَٱلَّذِينَ", "translit": "َnyِhdَّlٱَk", "root": ""}, {"id": 4, "arabic": "نَسُوا۟", "translit": "۟āwُsَn", "root": "نسي"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "فَأَنسَىٰهُمْ", "translit": "ْmُhٰàَsnَaʾَf", "root": "نسي"}, {"id": 7, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 8, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 9, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 10, "arabic": "ٱلْفَٰسِقُونَ", "translit": "َnwُqِsَٰfْlٱ", "root": "فسق"}], "hasIhya": true}, {"ayah": 20, "text": "لَا يَسْتَوِىٓ أَصْحَٰبُ ٱلنَّارِ وَأَصْحَٰبُ ٱلْجَنَّةِۚ أَصْحَٰبُ ٱلْجَنَّةِ هُمُ ٱلْفَآئِزُونَ ", "translation": "Not equal are the companions of the Fire and the companions of Paradise. The companions of Paradise - they are the attainers [of success].", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "يَسْتَوِىٓ", "translit": "ٓàِwَtْsَy", "root": "سوي"}, {"id": 3, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 4, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 5, "arabic": "وَأَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾَw", "root": "صحب"}, {"id": 6, "arabic": "ٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱ", "root": "جنن"}, {"id": 7, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 8, "arabic": "ٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱ", "root": "جنن"}, {"id": 9, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 10, "arabic": "ٱلْفَآئِزُونَ", "translit": "َnwُzِyʾٓāَfْlٱ", "root": "فوز"}], "hasIhya": false}, {"ayah": 21, "text": "لَوْ أَنزَلْنَا هَٰذَا ٱلْقُرْءَانَ عَلَىٰ جَبَلٍ لَّرَأَيْتَهُۥ خَٰشِعًا مُّتَصَدِّعًا مِّنْ خَشْيَةِ ٱللَّهِۚ وَتِلْكَ ٱلْأَمْثَٰلُ نَضْرِبُهَا لِلنَّاسِ لَعَلَّهُمْ يَتَفَكَّرُونَ ", "translation": "If We had sent down this Qur’ān upon a mountain, you would have seen it humbled and splitting from fear of Allāh. And these examples We present to the people that perhaps they will give thought.", "words": [{"id": 1, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 2, "arabic": "أَنزَلْنَا", "translit": "āَnْlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "ٱلْقُرْءَانَ", "translit": "َnāَءْrُqْlٱ", "root": "قرا"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "جَبَلٍ", "translit": "ٍlَbَjg", "root": "جبل"}, {"id": 7, "arabic": "لَّرَأَيْتَهُۥ", "translit": "ۥُhَtْyَaʾَrَّl", "root": "راي"}, {"id": 8, "arabic": "خَٰشِعًا", "translit": "āًʿعِhsَٰhk", "root": "خشع"}, {"id": 9, "arabic": "مُّتَصَدِّعًا", "translit": "āًʿعِّdَṣَtُّm", "root": "صدع"}, {"id": 10, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 11, "arabic": "خَشْيَةِ", "translit": "ِẗَyْhsَhk", "root": "خشي"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "وَتِلْكَ", "translit": "َkْlِtَw", "root": ""}, {"id": 14, "arabic": "ٱلْأَمْثَٰلُ", "translit": "ُlَٰhtْmَaʾْlٱ", "root": "مثل"}, {"id": 15, "arabic": "نَضْرِبُهَا", "translit": "āَhُbِrْḍَn", "root": "ضرب"}, {"id": 16, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 17, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 18, "arabic": "يَتَفَكَّرُونَ", "translit": "َnwُrَّkَfَtَy", "root": "فكر"}], "hasIhya": true}, {"ayah": 22, "text": "هُوَ ٱللَّهُ ٱلَّذِى لَآ إِلَٰهَ إِلَّا هُوَۖ عَٰلِمُ ٱلْغَيْبِ وَٱلشَّهَٰدَةِۖ هُوَ ٱلرَّحْمَٰنُ ٱلرَّحِيمُ ", "translation": "He is Allāh, other than whom there is no deity, Knower of the unseen and the witnessed.[1] He is the Entirely Merciful, the Especially Merciful.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 5, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 8, "arabic": "عَٰلِمُ", "translit": "ُmِlَٰʿع", "root": "علم"}, {"id": 9, "arabic": "ٱلْغَيْبِ", "translit": "ِbْyَغْlٱ", "root": "غيب"}, {"id": 10, "arabic": "وَٱلشَّهَٰدَةِ", "translit": "ِẗَdَٰhَّhslٱَw", "root": "شهد"}, {"id": 11, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 12, "arabic": "ٱلرَّحْمَٰنُ", "translit": "ُnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 13, "arabic": "ٱلرَّحِيمُ", "translit": "ُmyِḥَّrlٱ", "root": "رحم"}], "hasIhya": true}, {"ayah": 23, "text": "هُوَ ٱللَّهُ ٱلَّذِى لَآ إِلَٰهَ إِلَّا هُوَ ٱلْمَلِكُ ٱلْقُدُّوسُ ٱلسَّلَٰمُ ٱلْمُؤْمِنُ ٱلْمُهَيْمِنُ ٱلْعَزِيزُ ٱلْجَبَّارُ ٱلْمُتَكَبِّرُۚ سُبْحَٰنَ ٱللَّهِ عَمَّا يُشْرِكُونَ ", "translation": "He is Allāh, other than whom there is no deity, the Sovereign,[1] the Pure,[2] the Perfection,[3] the Grantor of Security,[4] the Overseer,[5] the Exalted in Might,[6] the Compeller,[7] the Superior.[8] Exalted is Allāh above whatever they associate with Him.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 5, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 8, "arabic": "ٱلْمَلِكُ", "translit": "ُkِlَmْlٱ", "root": "ملك"}, {"id": 9, "arabic": "ٱلْقُدُّوسُ", "translit": "ُswُّdُqْlٱ", "root": "قدس"}, {"id": 10, "arabic": "ٱلسَّلَٰمُ", "translit": "ُmَٰlَّslٱ", "root": "سلم"}, {"id": 11, "arabic": "ٱلْمُؤْمِنُ", "translit": "ُnِmْwʾُmْlٱ", "root": "امن"}, {"id": 12, "arabic": "ٱلْمُهَيْمِنُ", "translit": "ُnِmْyَhُmْlٱ", "root": "همن"}, {"id": 13, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 14, "arabic": "ٱلْجَبَّارُ", "translit": "ُrāَّbَjgْlٱ", "root": "جبر"}, {"id": 15, "arabic": "ٱلْمُتَكَبِّرُ", "translit": "ُrِّbَkَtُmْlٱ", "root": "كبر"}, {"id": 16, "arabic": "سُبْحَٰنَ", "translit": "َnَٰḥْbُs", "root": "سبح"}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 19, "arabic": "يُشْرِكُونَ", "translit": "َnwُkِrْhsُy", "root": "شرك"}], "hasIhya": true}, {"ayah": 24, "text": "هُوَ ٱللَّهُ ٱلْخَٰلِقُ ٱلْبَارِئُ ٱلْمُصَوِّرُۖ لَهُ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰۚ يُسَبِّحُ لَهُۥ مَا فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ ", "translation": "He is Allāh, the Creator,[1] the Producer,[2] the Fashioner;[3] to Him belong the best names.[4] Whatever is in the heavens and earth is exalting Him. And He is the Exalted in Might, the Wise.[5]", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱلْخَٰلِقُ", "translit": "ُqِlَٰhkْlٱ", "root": "خلق"}, {"id": 4, "arabic": "ٱلْبَارِئُ", "translit": "ُyʾِrāَbْlٱ", "root": "برا"}, {"id": 5, "arabic": "ٱلْمُصَوِّرُ", "translit": "ُrِّwَṣُmْlٱ", "root": "صور"}, {"id": 6, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 7, "arabic": "ٱلْأَسْمَآءُ", "translit": "ُءٓāَmْsَaʾْlٱ", "root": "سمو"}, {"id": 8, "arabic": "ٱلْحُسْنَىٰ", "translit": "ٰàَnْsُḥْlٱ", "root": "حسن"}, {"id": 9, "arabic": "يُسَبِّحُ", "translit": "ُḥِّbَsُy", "root": "سبح"}, {"id": 10, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 14, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 15, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 16, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 17, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": true}], "tafsir": {"2": [{"arabic": "اعلم أن العجب مذموم في كتاب الله تعالى وسنة رسوله ﭬ. قال الله تعالى \"ويوم حنين إذ أعجبتكم كثرتكم فلم تغن عنكم شيئاً\" ذكر ذلك في معرض الإنكار وقال عز وجل \"وظنوا أنهم ما نعتهم حصونهم من الله فأتاهم الله من حيث لم يحتسبوا\" فرد على الكفار في أعجابهم بحصونهم وشوكتهم وقال تعالى \"وهم يحسبون أنهم يحسنون صنعاً -، وهذا أيضاً يرجع إلى العجب بالعمل. وقد يعجب الإنسان بالعمل هو مخطئ فيه كما يعجب بعمل هو مصيب فيه.", "english": "Know that self-conceit (Al-'Ujb) is condemned in the Book of Allah the Exalted and the Sunnah of His Messenger ﷺ. Allah the Exalted said: \"And on the day of Hunayn when your multitude made you self-conceited (A'jabatkum) but it availed you nothing\" - He mentioned that in the context of reproach. And He the Glorified said: \"And they thought that their fortresses would protect them from Allah, but Allah came upon them from where they did not expect\" - He refuted the disbelievers in their self-conceit (A'jabihim) regarding their fortresses and their might. And He the Exalted said: \"And they think that they are doing good work\" - and this also returns to self-conceit (Al-'Ujb) in action. And a person may be self-conceited (Yu'jab) about an action in which he is mistaken, just as he may be self-conceited about an action in which he is correct.", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}, {"arabic": "فمن الناس من يسر له نظر الاعتبار فلا ينظر في شىء من عالم الملك إلا ويعبر به إلى عالم الملكوت فيسمى عبوره عبرة وقد أمر الحق به فقال: ﴿ فاعتبروا يا أولى الأبصار ﴾ {} ومنهم من عميت بصيرته فلم يعتبر فاحتبس في عالم الملك والشهادة وستنفتح إلى حبسه أبواب جهنم وهذا الحبس مملوء نارا من شأنها أن تطلع على الأفئدة إلا أن بينه وبين إدراك ألمها حجابا فإذا رفع ذلك الحجاب بالموت أدرك وعن هذا أظهر الله تعالى الحق على لسان قوم استنطقهم بالحق فقالوا الجنة والنار مخلوقتان ولكن الجحيم تدرك مرة بإدراك يسمى علم اليقين", "english": "Among people, there is one for whom the gaze of consideration (nazar al-i'tibar) is made easy, so he does not look at anything from the world of dominion (alam al-mulk) except that he crosses over with it to the world of sovereignty (alam al-malakut), and his crossing is called a lesson (ibrah). And the Truth (al-Haqq) has commanded it, saying: 'So take lesson (i'tabiru), O you of insight (uli al-absar).' {} And among them is one whose insight (basirah) is blinded, so he does not take lesson, and he is confined in the world of dominion (alam al-mulk) and the witnessed world (alam al-shahadah), and the gates of Hell will open to his confinement. And this confinement is filled with a fire whose nature is to rise upon the hearts (af'idah), except that between him and the perception of its pain is a veil (hijab). So when that veil is lifted by death, he perceives. And from this, Allah the Exalted manifested the truth upon the tongue of a people whom He made speak with the truth, and they said: 'Paradise and Hell are created, but the Blazing Fire (al-Jahim) is perceived once with a perception called the knowledge of certainty (ilm al-yaqin), and once with another perception called the eye of certainty (ayn al-yaqin). And the eye of certainty (ayn al-yaqin) does not occur except in the Hereafter, and the knowledge of certainty (ilm al-yaqin) may occur in this world, but for those who have fulfilled their share of the light of certainty (nur al-yaqin). Therefore, Allah the Exalted said: 'No! If you knew with the knowledge of certainty (ilm al-yaqin), you would see the Blazing Fire (al-Jahim).' {} That is, in this world. 'Then you will see it with the eye of certainty (ayn al-yaqin).' {} That is, in the Hereafter. So then, it has become clear that the sound heart (al-qalb al-salih) for the dominion of the Hereafter is only noble, like the sound person for the dominion of this world.", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Patience and Gratitude'", "badge": "Afterlife"}], "8": [{"arabic": "أما من الآيات فيدل عليه قوله تعالى \" للفقراء المهاجرين الذين أخرجوا من ديارهم وأموالهم \" الآية. وقال تعالى: \" للفقراء الذين أحصروا في سبيل الله لا يستطيعون ضرباً في الأرض \" ساق الكلام في معرض المدح، ثم قدم وصفه بالفقر على وصفهم بالهجرة والإحصار وفيه دلالة ظاهرة على مدح الفقير.", "english": "As for from the verses, it indicates His saying, the Exalted: 'For the poor emigrants who were expelled from their homes and their properties' the verse. And He said, the Exalted: 'For the poor who were restricted in the path of Allah, unable to move about in the land' He directed the speech in the context of praise, then He presented their description with poverty before their description with emigration and restriction, and in it is an apparent indication of praising the poor person.", "book_file": "vol4_Vol4-book4.doc.txt", "book_title": "Poverty and Abstinence", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Poverty and Abstinence'", "badge": "General"}], "9": [{"arabic": "ومنها أن يكون مؤثراً ما أحبه الله تعالى على ما يحبه في ظاهره وباطنه فيلزم مشاق العمل ويجتنب إتباع الهوى ويعرض عنه دعة الكسل، ولا يزال مواظباً على طاعة الله ومتقرباً إليه بالنوافل وطالباً عنده مزايا الدرجات كما يطلب المحب مزيد القرب في قلب محبوبه، وقد وصف الله تعالى المحبين بالإيثار فقال: \"يحبون من هاجر إليهم ولا يجدون في صدورهم حاجة مما أوتوا ويؤثرون على أنفسهم ولو كان بهم خصاصة\" ومن بقي مستقراً على متابعة الهوى فمحبوبه ما يهواه، بل يترك المحب هوى نفسه كما قيل: |أريد وصاله   | |فأترك ما   | |وير", "english": "And among them is that one prefers what Allah the Exalted loves over what he loves in his outward and inward state, so he adheres to the hardships of work and avoids following the desire (Hawa) and turns away from the ease of laziness, and he remains constant in obedience to Allah and drawing near to Him through supererogatory acts and seeking with Him the merits of degrees as the lover seeks increased closeness in the heart of his beloved, and Allah the Exalted has described the lovers with preference (Ithar) saying: \"They love those who emigrated to them and do not find in their chests any need of what they were given and they prefer over themselves even if there is poverty with them.\" And whoever remains settled upon following the desire (Hawa), his beloved is what he desires, rather the lover abandons the desire (Hawa) of his soul (Nafs) as it is said: |I want his union   | |so I abandon what   | |and he wants my abandonment   | |I want for what  | |             | |he wants       |", "book_file": "vol4_Vol4-book6.doc.txt", "book_title": "Love, Longing, Intimacy and Contentment", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}, {"arabic": "اعلم أن المؤذي ممقوت بالطبع، ومن آذاك فلا يمكنك أن لا تبغضه غالباً، فإذا تيسرت له نعمة فلا يمكنك أن لا تكرهها له حتى يستوي عندك حسن حال عدوك وسوء حاله، بل لا تزال تدرك في النفس بينهما تفرقة، ولا يزال الشيطان ينازعك إلى الحسد له، ولكن عن قوي ذلك فيك حتى بعثك على إظهار الحسد بقول أو فعل بحيث يعرف ذلك من ظاهرهك بأفعالك الاختيارية فأنت حسود عاص بحسدك، وإن كففت ظاهرك بالكلية إلا أنك بباطنك تحب زوال النعمة وليس في نفسك كراهة لهذه الحالة فأنت أيضاً حسود عاص، لأن الحسد صفة القلب لا صفة الفعل، قال الله ت", "english": "Know that the one who harms is naturally hated, and if someone harms you, you cannot help but generally hate them. If a blessing is facilitated for them, you cannot help but dislike it for them until the good state of your enemy and their bad state become equal to you. Rather, you continuously perceive in the Soul (Nafs) a distinction between them, and Satan continuously contends with you towards envying them. But if that becomes strong in you until it incites you to manifest envy by word or deed such that it is known from your outward appearance through your voluntary actions, then you are an envious sinner with your envy. And if you completely restrain your outward appearance, yet in your inner self you desire the removal of the blessing and there is no aversion in your Soul (Nafs) to this state, then you are also an envious sinner, because envy is an attribute of the Heart (Qalb), not an attribute of action. Allah the Exalted said: \"And they find in their chests no need of what they have been given\" and He the Mighty and Majestic said: \"They wish that you would disbelieve as they have disbelieved so you would be equal\" and He said: \"If good touches you, it distresses them.\" As for the action, it is backbiting and lying, and it is an act emanating from envy and is not the essence of envy. Rather, the place of envy is the Heart (Qalb), not the limbs. Indeed, this envy is not an injustice requiring seeking permission for it, but it is a sin between you and Allah the Exalted. And seeking permission is only required for the apparent causes upon the limbs. So if you restrain your outward appearance and compel along with that your Heart (Qalb) to aversion to what naturally emanates from it of desiring the removal of the blessing, until it is as if you detest your Soul (Nafs) for what is in its nature, so that aversion is from the side of the intellect in opposition to the inclination from the side of nature, then you have fulfilled what is obligatory upon you. And in most circumstances, no more than this enters under your choice. As for changing the nature so that the one who harms and the one who does good become equal to him, and his joy or grief over what is facilitated for them of blessing or what befalls them of affliction becomes equal, this is something that nature does not comply with as long as one is attentive to worldly interests, except that one becomes absorbed in Allah the Exalted like the intoxicated, passionate one. Then his affair may reach the point that his Heart (Qalb) does not attend to the details of the conditions of the servants, rather he looks at all with one eye, and it is the eye of mercy, and he sees all as servants of Allah and their actions as actions of Allah, and he sees them as compelled and...", "book_file": "vol3_Vol3-book5a.doc.txt", "book_title": "Condemnation of Envy", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Envy'", "badge": "Insight"}, {"arabic": "اعلم أن السخاء والبخل كل منهما ينقسم إلى درجات. فأرفع درجة السخاء الإيثار، وهو أن يجود بالمال مع الحاجة. وإنما السخاء عبارة عن بذل ما لا يحتاج إليه لمحتاج أو لغير محتاج، والبذل مع الحاجة أشد. وكما أن السخاوة قد تنتهي إلى أن يسخو الإنسان على غيره مع الحاجة فالبخل قد ينتهي إلى أن يبخل على نفسه مع الحاجة، فكم من بخيل يمسك المال ويمرض فلا يتداوى، ويشتهي الشهوة فلا يمنعه منها إلا البخل بالثمن؛ ولو وجدها مجاناً لأكلها. فهذا بخيل على نفسه مع الحاجة؛ وذلك يؤثر على نفسه غيره مع أنه محتاج إليه. فانظر ما ب", "english": "Know that generosity (Sakhā') and miserliness (Bukhl) each divide into degrees. The highest degree of generosity is altruistic preference (Īthār), which is to give wealth while in need. Indeed, generosity is an expression of giving what one does not need to one in need or not in need, but giving while in need is more intense. Just as generosity may culminate in a person being generous to others while in need, miserliness may culminate in a person being miserly toward himself while in need, for how many misers hold onto wealth and fall ill yet do not seek treatment, and desire a craving yet nothing prevents them except miserliness with the price; if they found it for free, they would consume it. This is a miser toward himself while in need; that one prefers others over himself while he is in need of it. So look at the difference between the two men? For character traits are gifts that Allah places where He wills, and there is no degree in generosity beyond altruistic preference. And Allah praised the Companions, may Allah be pleased with them, with it, saying: \"And they prefer others over themselves even if there is poverty (khaṣāṣah) upon them.\" And the Prophet (peace be upon him) said: \"Any person who desires a craving and repels his craving and prefers others over himself, he is forgiven.\" [100] And 'Ā'ishah, may Allah be pleased with her, said: \"The Messenger of Allah (peace be upon him) did not eat his fill for three consecutive days until he departed the world, and if we wished, we could have eaten our fill, but we used to prefer others over ourselves.\" [101] And a guest came to the Messenger of Allah (peace be upon him) and he found nothing with his family, so a man from the Helpers (Anṣār) entered upon him and took the guest to his family, then placed food before him and ordered his wife to extinguish the lamp, and he began extending his hand to the food as if he were eating but not eating, until the guest ate. When morning came, the Messenger of Allah (peace be upon him) said to him: \"Indeed, Allah was amazed at your action toward your guest,\" and was revealed: \"And they prefer others over themselves even if there is poverty (khaṣāṣah) upon them.\" [102] So generosity is a character trait from the character traits of Allah the Exalted; and altruistic preference is the highest degree of generosity.", "book_file": "vol3_Vol3-book-7a.doc.txt", "book_title": "Condemnation of Miserliness and Love of Wealth", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Miserliness and Love of Wealth'", "badge": "Ethics"}, {"arabic": "[102] حديث نزل به ضيف فلم يجد عند أهله شيئا فدخل عليه رجل من الأنصار فذهب به إلى أهله الحديث في نزول قوله تعالى ويؤثرون على أنفسهم ولو كان بهم خصاصة متفق عليه من حديث أبي هريرة.", "english": "[102] A hadith: A guest came to him and he did not find anything with his family, so a man from the Ansar (Helpers) entered upon him and took him to his family. The hadith is about the revelation of His saying, the Exalted: 'And they give preference over themselves, even though they are in need (خصاصة).' Agreed upon from the hadith of Abu Huraira.", "book_file": "vol3_Vol3-book-7a.doc.txt", "book_title": "Condemnation of Miserliness and Love of Wealth", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Condemnation of Miserliness and Love of Wealth'", "badge": "Hadith"}, {"arabic": "المعنى الثاني التطهير من صفة البخل فإنه من المهلكات قال ﭬ: (ثلاث مهلكات شح مطاع وهوى متبع وإعجاب المرء بنفسه[9]) وقال تعالى: ﴿ ومن يوق شح نفسه فأولئك هم المفلحون ﴾ {} وسيأتي في ربع المهلكات وجه كونه مهلكا وكيفية التقصي منه وإنما تزول صفة البخل بأن تتعود بذل المال فحب الشيء لا ينقطع إلا بقهر النفس على مفارقته حتى يصير ذلك اعتيادا فالزكاة بهذا المعنى طهرة أي تطهر صاحبها عن خبث البخل المهلك وإنما طهارته بقدر بذله وبقدر فرحه بإخراجه واستبشاره بصرفه إلى الله تعالى.", "english": "The second meaning: purification from the attribute of miserliness (Bakhl), for it is among the destroyers. He (the Prophet) said: 'Three destroyers: obeyed greed (Shuhh), followed desire (Hawā), and self-admiration of a person.' And Allah the Exalted said: 'And whoever is protected from the greed (Shuhh) of his Soul (Nafs), then those are the successful ones.' And it will come in the quarter of the destroyers the aspect of its being a destroyer and how to be cautious from it. And the attribute of miserliness only vanishes by accustoming oneself to giving wealth, for the love of something does not cease except by compelling the Soul (Nafs) to part from it until that becomes habitual. So Zakat in this meaning is a purification (Taharah), meaning it purifies its possessor from the filth of the destructive miserliness. And its purification is according to the measure of his giving and according to the measure of his joy in expending it and his gladness in directing it to Allah the Exalted.", "book_file": "vol1_Vol1-book-5.doc.txt", "book_title": "Mysteries of Zakat", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Mysteries of Zakat'", "badge": "Ethics"}], "10": [{"arabic": "ربنا اغفر لنا ولإخواننا الذين سبقونا بالإيمان ولا تجعل في قلوبنا غلا للذين آمنوا ربنا إنك رؤوف رحيم", "english": "Our Lord, forgive us and our brothers who preceded us in faith, and do not place in our hearts any rancor (Ghilla) toward those who have believed. Our Lord, indeed You are Kind (Ra'uf), Merciful (Rahim).", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance", "badge": "Du'a"}], "13": [{"arabic": "قال تعالى: (لأنتم أشد رهبة في صدورهم من الله( (الحشر: 13) الآية. فأحال قلة خوفهم من الله واستعظامهم سطوة الخلق على قلة الفقه فانظر إن كان ذلك نتيجة عدم الحفظ لتفريعات الفتاوى أو هو نتيجة عدم ما ذكرناه من العلوم", "english": "Allah the Exalted said: 'Indeed, you are more feared in their chests (hearts) than Allah' (Al-Hashr: 13) the verse. So He attributed their lack of fear from Allah and their magnification of the might of creation to lack of understanding (Fiqh). So consider whether that is the result of not memorizing the subdivisions of legal opinions (Fatāwā) or it is the result of lacking what we have mentioned of the sciences.", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}], "16": [{"arabic": "فأتاه الشيطان فقال أنا الذي خنقتها وأنا الذي ألقيت في قلوب أهلها فأطعني تنج وأخلصك منهم قال بماذا قال اسجد لي سجدتين فسجد له سجدتين فقال له الشيطان إني برىء منك فهو الذي قال الله تعالى فيه كمثل الشيطان إذ قال للإنسان اكفر فلما كفر قال إني بريء منك[55] فانظر الآن إلى حيله واضطراره الراهب إلى هذه الكبائر وكل ذلك لطاعته له في قبول الجارية للمعالجة وهو أمر هين وربما يظن صاحبه أنه خير وحسنة فيحسن ذلك في قلبه بخفي الهوى فيقدم عليه كالراغب في الخير فيخرج الأمر بعد ذلك عن اختياره ويجره البعض إلى البعض ب", "english": "Then the Devil (Shaytan) came to him and said: 'I am the one who strangled her, and I am the one who cast into the hearts of her family. So obey me, you will be saved and I will deliver you from them.' He said: 'With what?' He said: 'Prostrate to me two prostrations.' So he prostrated to him two prostrations. Then the Devil (Shaytan) said to him: 'I am free from you.' He is the one about whom Allah the Exalted said: 'Like the example of the Devil (Shaytan) when he said to the human: Disbelieve. So when he disbelieved, he said: Indeed, I am free from you.' [55] So look now at his tricks and his forcing the monk to these major sins, and all of that for his obedience to him in accepting the slave girl for treatment, and it is a trivial matter, and perhaps its doer thinks that it is good and a good deed, so it becomes pleasing in his heart (Qalb) by the hidden desire (Hawa), so he proceeds upon it like one desiring good, then the matter after that goes beyond his choice, and it drags some to some until he finds no escape. So we seek refuge with Allah from wasting the beginnings of matters, and to it is the indication by his saying, peace be upon him: 'Whoever hovers around the forbidden area, he is about to fall into it.' [56].", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "وإنما الفضل والثواب الجزيل في تركه خوفاً من الله تعالى مع القدرة وارتفاع الموانع وتيسر الأسباب، لا سيما عند صدق الشهوة وهذه درجة الصديقين. ولذلك قال ﭬ \"من عشق فعف فكتم فمات فهو شهيد\"[69] وقال ﭬ \"سبعة يظلمهم الله يوم القيامة في ظل عرشه يوم لا ظل إلا ظله - وعد منهم\" رجل دعته امرأة ذات جمال وحسب إلى نفسها فقال إني أخاف الله رب العالمين\"[70] وقصة يوسف عليه السلام وامتناعه من زليخا مع القدرة ومع رغبتها معروفة، وقد أثنى الله تعالى عليه بذلك في كتابه العزيز، وهو إمام لكل من وفق لمجاهدة الشيطان في هذه ا", "english": "And indeed the virtue and great reward is in abandoning it out of fear of Allah (The Exalted) with capability and removal of obstacles and facilitation of means, especially at the time of genuine desire (Shahwah), and this is the rank of the Truthful Ones (Al-Siddiqin). Therefore, he (the Prophet) said: 'Whoever loves then remains chaste then conceals then dies, he is a martyr.' And he said: 'Seven whom Allah will shade on the Day of Resurrection under the shade of His Throne on a day when there is no shade except His shade - among them is' a man whom a woman of beauty and lineage invited to herself, so he said: 'Indeed I fear Allah, Lord of the worlds.' And the story of Yusuf (upon him be peace) and his refusal from Zulaykha with capability and with her desire is known, and Allah (The Exalted) praised him for that in His Noble Book, and he is an Imam (leader) for everyone who is granted success in struggling against the Satan (Shaytan) in this great desire (Shahwah). Then Allah (The Exalted) said: 'Like the example of the Satan (Shaytan) when he said to the human: Disbelieve! Then when he disbelieved, he said: Indeed I am free from you; indeed I fear Allah, Lord of the worlds.' So Allah (The Exalted) likened the Satan (Shaytan) to the woman who invites to immorality then absolves herself from the invited one when he falls into sin, just as the Satan (Shaytan) invites the human to disbelief then absolves himself from him when he disbelieves, and this is an eloquent similitude in warning against following forbidden desires (Shahawat).", "book_file": "vol3_Vol3-book3a.doc.txt", "book_title": "Harms of the Tongue", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Harms of the Tongue'", "badge": "Afterlife"}, {"arabic": "حديث كان راهب في بني إسرائيل فأخذ الشيطان جارية فخنقها وألقى في قلوب أهلها أن دواءها عند الراهب الحديث بطوله في قوله تعالى كمثل الشيطان إذ قال للإنسان اكفر رواه ابن أبي الدنيا في مكايد الشيطان وابن مردويه في تفسيره في حديث عبيد بن أبي رفاعة مرسلا وللحاكم نحوه موقوفا على علي بن أبي طالب وقال صحيح الإسناد ووصله بطين في مسنده من حديث علي", "english": "Hadith: There was a monk among the Children of Israel, then the Devil (Shaytan) took a young girl and strangled her, and cast into the hearts of her family that her cure was with the monk. The hadith in its length is in His saying, the Exalted: 'Like the example of the Devil (Shaytan) when he said to the human, disbelieve (kufr).' Narrated by Ibn Abi al-Dunya in 'The Stratagems of the Devil (Makayid al-Shaytan)' and Ibn Mardawayh in his Tafsir (interpretation) in the hadith of 'Ubayd ibn Abi Rafa'ah as mursal (interrupted chain), and al-Hakim has something similar as mawquf (attributed to a companion) on 'Ali ibn Abi Talib, and he said: 'Its chain is authentic (sahih al-isnad),' and he connected it with al-Tayalisi in his Musnad from the hadith of 'Ali.", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Disciplining the Soul'", "badge": "Hadith"}], "18": [{"arabic": "المرابطة الثالثة محاسبة النفس بعد العمل ولنذكر فضيلة المحاسبة ثم حقيقتها أما الفضيلة فقد قال الله تعالى يا أيها الذين آمنوا اتقوا الله ولتنظر نفس ما قدمت لغد وهذه إشارة إلى المحاسبة على ما مضى من الأعمال ولذلك قال عمر رضى الله تعالى عنه حاسبوا أنفسكم قبل أن تحاسبوا وزنوها قبل أن توزنوا وفي الخبر انه عليه السلام جاءه رجل فقال يا رسول الله أوصنى فقال أمستوص أنت فقال نعم قال إذا هممت بأمر فتتدبر عاقبته فإن كان رشدا فامضه وإن كان غيا فانته عنه وفي الخبر وينبغى للعاقل أن يكون له أربع ساعات ساعة يحاسب", "english": "The third spiritual station (Marabata) is the accounting of the Soul (Nafs) after the action. And let us mention the virtue of accounting, then its reality. As for the virtue, Allah the Exalted has said: 'O you who have believed, fear Allah (Taqwa) and let every Soul (Nafs) look at what it has put forth for tomorrow.' And this is an indication to the accounting for what has passed of deeds. And for that reason, Umar, may Allah be pleased with him, said: 'Account your souls before you are accounted, and weigh them before they are weighed.' And in the report, that upon him be peace, a man came to him and said: 'O Messenger of Allah, advise me.' He said: 'Are you seeking advice?' He said: 'Yes.' He said: 'When you intend a matter, then consider its consequence; if it is guidance (Rushd), then proceed with it, and if it is error (Ghayy), then desist from it.' And in the report: 'And it behooves the intelligent one to have four hours: an hour in which he accounts his soul.' And He the Exalted said: 'And turn in repentance (Tawbah) to Allah all together, O you who believe, that you may succeed.' And repentance (Tawbah) is looking at the action after finishing it with regret (Nadam) over it. And he, peace be upon him, said: 'Indeed, I seek forgiveness from Allah the Exalted and repent (Atubu) to Him one hundred times a day.' The report: 'Indeed, I seek forgiveness from Allah and repent to Him one hundred times a day' has preceded more than once. And He the Exalted said: 'Indeed, those who fear Allah (Taqwa), when an impulse from Satan touches them, they remember (Tadhakkuru), then at once they are seeing clearly.' And from Umar, may Allah be pleased with him, that he would strike his feet with a whip when night covered him and say to his soul: 'What have you done today?' And from Maymun ibn Mihran that he said: 'The servant does not become from those who fear Allah (Al-Muttaqin) until he accounts his soul more severely than the accounting of his partner, and the two partners account each other after the action.' And it is narrated from Aisha, may Allah be pleased with her, that Abu Bakr, may Allah's pleasure be upon him, said to her: '...'", "book_file": "vol4_j4-k08.doc.txt", "book_title": "Monitoring and Accounting", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monitoring and Accounting'", "badge": "Insight"}, {"arabic": "وقال كعب الأحبار ما في القرآن من يا أيها الذين آمنوا فهو في التوراة يا أيها المساكين", "english": "And Ka'b al-Ahbar said: Whatever is in the Quran of 'O you who have believed' is in the Torah 'O you poor ones (al-Masakin)'.", "book_file": "vol2_j2-k05.doc.txt", "book_title": "Duties of Brotherhood", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Duties of Brotherhood'", "badge": "General"}], "19": [{"arabic": "وأنه أمر رباني وحنينه إلى جواب الرب تعالى له طبعي ذاتي، إلا أن يصرفه عن مقتضى طبعه عوارض العالم الغريب من ذاته فينسى عند ذلك نفسه وربه. ومهما فعل ذلك فقد ظلم نفسه إذ قيل له \"ولا تكونوا كالذين نسوا الله فأنساهم أنفسهم أولئك هم الفاسقون\" أي الخارجون عن مقتضى طبعهم ومظنة استحقاقهم. يقال: فسقت الرطبة عن كمامها؛ إذا خرجت عن معدنها الفطري. وهذه إشارة إلى أسرار يهتز لاستنشاق روائحها العارفون وتشمئز من سماع ألفاظها القاصرون فإنهم تضر بهم كما تضر رياح الورد بالجعل، وتبهر أعينهم الضعيفة كما تبهر الشمس أبص", "english": "And it is a divine command (Amr Rabbani) and its yearning for the response of the Lord, the Exalted, is natural and intrinsic, except that it is diverted from the requirement of its nature by the alien occurrences of the world from its essence, so it forgets at that time itself and its Lord. And whenever it does that, it has wronged itself, as it is said to it: \"And do not be like those who forgot Allah, so He made them forget themselves. Those are the defiantly disobedient (Al-Fasiqun)\" meaning those who have exited from the requirement of their nature and the place of their deserving. It is said: The moist date (Al-Rutbah) has exited (Fasaqat) from its sheath (Kummaha); when it has exited from its natural mine. And this is an allusion to secrets that the knowers (Al-Arifun) tremble at inhaling their fragrances, and the deficient ones recoil from hearing their words, for they harm them just as the winds of the rose harm the beetle, and dazzle their weak eyes just as the sun dazzles the eyes of bats.", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Delusion'", "badge": "Insight"}, {"arabic": "ومن لم يعرف قلبه ليراقبه ويراعيه ويترصد لما يلوح من خزائن الملكوت عليه وفيه فهو ممن قال الله تعالى فيه نسوا الله فأنساهم أنفسهم أولئك هم الفاسقون فمعرفة القلب وحقيقة أوصافه أصل الدين وأساس طريق السالكين", "english": "And whoever does not know his Heart (Qalb) to observe it, guard it, and watch for what appears from the treasures of the Dominion (Malakūt) upon it and within it, he is among those about whom Allah the Exalted said: 'They forgot Allah, so He made them forget themselves; those are the defiantly disobedient (Fāsiqūn).' So knowledge of the Heart (Qalb) and the reality of its attributes is the foundation of the Religion (Dīn) and the basis of the path of the travelers (Sālikīn).", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}], "21": [{"arabic": "فإن قلت فما بال هؤلاء لا يظهر وجدهم عند سماع القرآن وهو كلام الله ويظهر عند الغناء وهو كلام الشعراء فلو كان ذلك حقا من لطف الله تعالى ولم يكن باطلا من غرور الشيطان لكان القرآن أولى به من الغناء فنقول الوجد الحق هو ما ينشأ من فرط حب الله تعالى وصدق إرادته والشوق إلى لقائه وذلك يهيج بسماع القرآن أيضا وإنما الذي لا يهيج بسماع القرآن حب الخلق وعشق المخلوق ويدل على ذلك قوله تعالى ألا بذكر الله تطمئن القلوب وقوله تعالى مثاني تقشعر منه جلود الذين يخشون ربهم ثم تلين جلودهم وقلوبهم إلى ذكر الله وكل ما يو", "english": "If you say: Why do these people not manifest spiritual state (Wajd) upon hearing the Quran, which is the Speech (Kalam) of Allah, while they manifest it upon hearing singing, which is the speech of poets? If that were truly from the grace (Lutf) of Allah the Exalted and not falsehood from the deception (Ghurur) of Satan, then the Quran would be more deserving of it than singing. We say: The true spiritual state (Wajd) is what arises from excessive love (Hubb) of Allah the Exalted and sincerity (Sidq) of His intention (Iradah) and longing (Shawq) for meeting Him, and that is also stirred by hearing the Quran. Rather, what is not stirred by hearing the Quran is love (Hubb) of creation and passion (Ishaq) for the created. Evidence for that is His saying the Exalted: 'Indeed, in the remembrance (Dhikr) of Allah do hearts find rest (Tatma'innu).' And His saying the Exalted: 'Verses (Mathani) at which the skins of those who fear their Lord shiver (Taqsha'irru), then their skins and their hearts soften (Talinna) at the remembrance (Dhikr) of Allah.' And everything that occurs in the soul (Nafs) following hearing is spiritual state (Wajd). So tranquility (Tuma'ninah), shivering (Iqsha'irrar), fear (Khashyah), and softening (Layn) of the heart (Qalb) - all of that is spiritual state (Wajd). And Allah the Exalted has said: 'The believers are only those who, when Allah is mentioned, their hearts tremble (Wajilat).' And He said: 'Had We sent down this Quran upon a mountain, you would have seen it humbled (Khashia'an), split asunder (Mutassadi'an) from fear (Khashyah) of Allah.' So trembling (Wajal) and humility (Khashu') are spiritual state (Wajd) from the category of states (Ahwal), even if not from the category of unveilings (Mukashafat), but they may become a cause for unveilings (Mukashafat) and alerts (Tanbihat).", "book_file": "vol2_j2-k08.doc.txt", "book_title": "Audition and Ecstasy", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Audition and Ecstasy'", "badge": "Dhikr"}, {"arabic": "حديث فضل خمس آيات من أول الحديد ذكر أبو القاسم الغافقي في فضائل القرآن من حديث علي إذا أردت أن تسأل الله حاجة فاقرأ خمس آيات من أول سورة الحديد إلى قوله عليم بذات الصدور ومن آخر سورة الحشر من قوله لو أنزلنا هذا القرآن على جبل إلى آخر السورة ثم تقول يا من هو كذا افعل بي كذا وتدعو بما تريد.", "english": "The narration regarding the virtue of five verses from the beginning of Al-Hadid (The Iron) - Abu Al-Qasim Al-Ghafiqi mentioned in the virtues of the Quran from the narration of Ali: 'If you wish to ask Allah for a need, then recite five verses from the beginning of Surah Al-Hadid up to His saying: 'All-Knowing of what is in the breasts (Alim bi-dhat al-sudur)' and from the end of Surah Al-Hashr (The Gathering) from His saying: 'Had We sent down this Quran upon a mountain, you would have seen it humbled and split asunder from the fear of Allah (Law anzalna hadha al-qur'ana 'ala jabalin la-ra'aytahu khashi'an mutasaddi'an min khashyati Allah). And these examples We present to the people that they might give thought (wa tilka al-amthalu nadribuha lil-nasi la'allahum yatafakkarun).' Then you say: 'O He who is such-and-such, do with me such-and-such' and supplicate with what you desire.", "book_file": "vol1_Vol1-book-10.doc.txt", "book_title": "Book of Knowledge", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Book of Knowledge'", "badge": "Hadith"}], "22": [{"arabic": "وإلى الله فقيرا وعلى الله متكلا وإلى الله منيبا أشهد الله وأشهد ملائكته وأنبيائه ورسله وحملة عرشه ومن خَلقه ومن هو خالقه بأنه هو الله الذي لا إله إلا هو وحده لا شريك له وأن محمدا عبده ورسوله ﭬ وأن الجنة حق وأن النار حق والحوض حق والشفاعة حق ومنكرا ونكيرا حق ووعدك حق ووعيدك حق ولقاءك حق والساعة آتية لا ريب فيها وأن الله يبعث من في القبور على ذلك أحيا وعليه أموت وعليه أبعث إن شاء الله اللهم أنت ربي لا إله إلا أنت خلقتني وأنا عبدك وأنا على عهدك ووعدك ما استطعت أعوذ بك اللهم من شر ما صنعت ومن شر كل ", "english": "And to Allah poor (Faqir) and upon Allah reliant (Mutakkil) and to Allah returning (Munib). I bear witness to Allah and I bear witness to His angels, His prophets, His messengers, the bearers of His Throne, and from His creation and from He who is its Creator, that He is Allah, there is no god except Him alone, no partner to Him, and that Muhammad is His servant and His messenger, and that Paradise is true, and that the Fire is true, and the Pool is true, and intercession is true, and Munkar and Nakir are true, and Your promise is true, and Your threat is true, and meeting You is true, and the Hour is coming, no doubt in it, and that Allah will resurrect those in the graves. Upon that I live, and upon it I die, and upon it I will be resurrected, if Allah wills. O Allah, You are my Lord, there is no god except You, You created me and I am Your servant, and I am upon Your covenant and Your promise as much as I am able. I seek refuge in You, O Allah, from the evil of what I have done and from the evil of every possessor of evil. O Allah, indeed I have wronged my soul (Nafs), so forgive me my sins, for indeed none forgives sins except You. And guide me to the best of character traits (Akhlaq), for indeed none guides to the best of them except You. And turn away from me the bad of them, for indeed none turns away the bad of them except You. At Your service and Your aid, and all good is in Your hands. I am Yours and to You I seek forgiveness and I repent to You. I have believed, O Allah, in what You have sent of a messenger, and I have believed, O Allah, in what You have revealed of a Book. And may Allah send prayers upon Muhammad, the unlettered Prophet, and upon his family and grant abundant peace. The seal of my speech and its key, and upon His prophets and His messengers all. Amen, O Lord of the worlds. O Allah, cause us to arrive at the Pool of Muhammad and give us to drink from his cup a drink, plentiful, pleasant, delightful, after which we will never thirst forever. And gather us in his company, not disgraced, nor breaking the covenant, nor doubting, nor afflicted by trials (Fitnah), nor those upon whom is anger, nor astray. O Allah, protect me from the trials (Fitnah) of the world and grant me success in what You love.", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance", "badge": "Du'a"}], "23": [{"arabic": "وإلى الله فقيرا وعلى الله متكلا وإلى الله منيبا أشهد الله وأشهد ملائكته وأنبيائه ورسله وحملة عرشه ومن خلقه ومن هو خالقه بأنه هو الله الذي لا إله إلا هو وحده لا شريك له وأن محمدا عبده ورسوله ﭬ وأن الجنة حق وأن النار حق والحوض حق والشفاعة حق ومنكرا ونكيرا حق ووعدك حق ووعيدك حق ولقاءك حق والساعة آتية لا ريب فيها وأن الله يبعث من في القبور على ذلك أحيا وعليه أموت وعليه أبعث إن شاء الله", "english": "And to Allah poor, and upon Allah reliant, and to Allah repentant. I bear witness to Allah and I bear witness to His angels, His prophets, His messengers, the bearers of His Throne, and from His creation and from He who is His Creator, that He is Allah who there is no god except Him alone, no partner to Him, and that Muhammad is His servant and His messenger, and that Paradise is true, and that the Fire is true, and the Basin is true, and intercession is true, and Munkar and Nakir are true, and Your promise is true, and Your threat is true, and meeting You is true, and the Hour is coming, no doubt in it, and that Allah will resurrect those in the graves. Upon that I live, and upon that I die, and upon that I will be resurrected, if Allah wills.", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter", "badge": "Afterlife"}], "24": [{"arabic": "وما يتعلق بالرب تعالى إما ان يكون نظرا في ذاته وصفاته وأسمائه الحسنى وإما أن يكون في أفعاله وملكه وملكوته وجميع ما في السموات والأرض وما بينهما", "english": "And what pertains to the Lord (Rabb) the Exalted is either a consideration of His Essence (Dhat) and His Attributes (Sifat) and His Beautiful Names (Asma' al-Husna), or it is in His Actions (Af'al) and His Dominion (Mulk) and His Sovereignty (Malakut) and all that is in the heavens and the earth and what is between them.", "book_file": "vol4_j4-k09.doc.txt", "book_title": "Contemplation", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Contemplation'", "badge": "Hadith"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 1213], [2, 1213, 1964], [3, 1964, 2499], [4, 2499, 3013], [5, 3013, 4706], [6, 4706, 5550], [7, 5550, 6064], [8, 6064, 7052], [9, 7052, 7855], [10, 7855, 9090], [11, 9090, 10303]], "2": [[1, 400, 969], [2, 969, 2639], [3, 2639, 3658], [4, 3658, 4997], [5, 4997, 6442], [6, 6442, 6916], [7, 6916, 7650], [8, 7650, 8811], [9, 8811, 9285], [10, 9285, 10778], [11, 10778, 12158], [12, 12158, 13248], [13, 13248, 13864], [14, 13864, 15120], [15, 15120, 15641], [16, 15641, 17465], [17, 17465, 20012], [18, 20012, 21327], [19, 21327, 23495], [20, 23495, 25106], [21, 25106, 25923], [22, 25923, 26859], [23, 26859, 28636], [24, 28636, 29572], [25, 29572, 30046], [26, 30046, 30923], [27, 30923, 31397], [28, 31397, 33482], [29, 33482, 34619], [30, 34619, 35211], [31, 35211, 36775], [32, 36775, 38019], [33, 38019, 39701], [34, 39701, 41336], [35, 41336, 43255], [36, 43255, 44842], [37, 44842, 46761], [38, 46761, 48798], [39, 48798, 50954], [40, 50954, 52569]], "3": [[1, 400, 2738], [2, 2738, 3300], [3, 3300, 4066], [4, 4066, 5074], [5, 5074, 6503], [6, 6503, 8611], [7, 8611, 10404], [8, 10404, 11042], [9, 11042, 12867], [10, 12867, 13990], [11, 13990, 14628], [12, 14628, 16313], [13, 16313, 17564], [14, 17564, 19184]], "4": [[1, 400, 1519], [2, 1519, 3469], [3, 3469, 6613], [4, 6613, 7789], [5, 7789, 9873], [6, 9873, 10915], [7, 10915, 13583], [8, 13583, 14759], [9, 14759, 16143], [10, 16143, 17319], [11, 17319, 18718], [12, 18718, 20595]], "5": [[1, 400, 1003], [2, 1003, 2325], [3, 2325, 3125], [4, 3125, 4297], [5, 4297, 4923], [6, 4923, 7011], [7, 7011, 8974], [8, 8974, 10389], [9, 10389, 12129], [10, 12129, 13359], [11, 13359, 14275], [12, 14275, 16038], [13, 16038, 17826]], "6": [[1, 400, 2758], [2, 2758, 5293], [3, 5293, 6692], [4, 6692, 8321], [5, 8321, 10268], [6, 10268, 11649], [7, 11649, 13830], [8, 13830, 16202], [9, 16202, 17831], [10, 17831, 18539], [11, 18539