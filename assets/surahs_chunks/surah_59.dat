ا۟","translit":"۟āwُjgِrْhkُaʾ","root":"خرج"},{"id":5,"arabic":"مِن","translit":"nِm","root":""},{"id":6,"arabic":"دِيَٰرِهِمْ","translit":"ْmِhِrَٰyِd","root":"دور"},{"id":7,"arabic":"وَأَمْوَٰلِهِمْ","translit":"ْmِhِlَٰwْmَaʾَw","root":"مول"},{"id":8,"arabic":"يَبْتَغُونَ","translit":"َnwُغَtْbَy","root":"بغي"},{"id":9,"arabic":"فَضْلًا","translit":"āًlْḍَf","root":"فضل"},{"id":10,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":11,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":12,"arabic":"وَرِضْوَٰنًا","translit":"āًnَٰwْḍِrَw","root":"رضو"},{"id":13,"arabic":"وَيَنصُرُونَ","translit":"َnwُrُṣnَyَw","root":"نصر"},{"id":14,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":15,"arabic":"وَرَسُولَهُۥٓ","translit":"ٓۥُhَlwُsَrَw","root":"رسل"},{"id":16,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":17,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":18,"arabic":"ٱلصَّٰدِقُونَ","translit":"َnwُqِdَّٰṣlٱ","root":"صدق"}],"hasIhya":true},{"ayah":9,"text":"وَٱلَّذِينَ تَبَوَّءُو ٱلدَّارَ وَٱلْإِيمَٰنَ مِن قَبْلِهِمْ يُحِبُّونَ مَنْ هَاجَرَ إِلَيْهِمْ وَلَا يَجِدُونَ فِى صُدُورِهِمْ حَاجَةً مِّمَّآ أُوتُوا۟ وَيُؤْثِرُونَ عَلَىٰٓ أَنفُسِهِمْ وَلَوْ كَانَ بِهِمْ خَصَاصَةٌۚ وَمَن يُوقَ شُحَّ نَفْسِهِۦ فَأُو۟لَٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ ","translation":"And [also for] those who were settled in the Home [i.e.,al-Madīnah] and [adopted] the faith before them.[1] They love those who emigrated to them and find not any want in their breasts of what they [i.e., the emigrants] were given but give [them] preference over themselves, even though they are in privation. And whoever is protected from the stinginess of his soul - it is those who will be the successful.","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"تَبَوَّءُو","translit":"wُءَّwَbَt","root":"بوا"},{"id":3,"arabic":"ٱلدَّارَ","translit":"َrāَّdlٱ","root":"دور"},{"id":4,"arabic":"وَٱلْإِيمَٰنَ","translit":"َnَٰmyِiʾْlٱَw","roo