e is a share for] those who come after them, saying, \"Our Lord, forgive us and our brothers who preceded us in faith and put not in our hearts [any] resentment toward those who have believed. Our Lord, indeed You are Kind and Merciful.\"","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"جَآءُو","translit":"wُءٓāَjg","root":"جيا"},{"id":3,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":4,"arabic":"بَعْدِهِمْ","translit":"ْmِhِdْʿعَb","root":"بعد"},{"id":5,"arabic":"يَقُولُونَ","translit":"َnwُlwُqَy","root":"قول"},{"id":6,"arabic":"رَبَّنَا","translit":"āَnَّbَr","root":"ربب"},{"id":7,"arabic":"ٱغْفِرْ","translit":"ْrِfْغٱ","root":"غفر"},{"id":8,"arabic":"لَنَا","translit":"āَnَl","root":""},{"id":9,"arabic":"وَلِإِخْوَٰنِنَا","translit":"āَnِnَٰwْhkِiʾِlَw","root":"اخو"},{"id":10,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":11,"arabic":"سَبَقُونَا","translit":"āَnwُqَbَs","root":"سبق"},{"id":12,"arabic":"بِٱلْإِيمَٰنِ","translit":"ِnَٰmyِiʾْlٱِb","root":"امن"},{"id":13,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":14,"arabic":"تَجْعَلْ","translit":"ْlَʿعْjgَt","root":"جعل"},{"id":15,"arabic":"فِى","translit":"àِf","root":""},{"id":16,"arabic":"قُلُوبِنَا","translit":"āَnِbwُlُq","root":"قلب"},{"id":17,"arabic":"غِلًّا","translit":"āًّlِغ","root":"غلل"},{"id":18,"arabic":"لِّلَّذِينَ","translit":"َnyِhdَّlِّl","root":""},{"id":19,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":20,"arabic":"رَبَّنَآ","translit":"ٓāَnَّbَr","root":"ربب"},{"id":21,"arabic":"إِنَّكَ","translit":"َkَّnِiʾ","root":""},{"id":22,"arabic":"رَءُوفٌ","translit":"ٌfwُءَr","root":"راف"},{"id":23,"arabic":"رَّحِيمٌ","translit":"ٌmyِḥَّr","root":"رحم"}],"hasIhya":true},{"ayah":11,"text":"أَلَمْ تَرَ إِلَى ٱلَّذِينَ نَافَقُوا۟ يَقُولُونَ لِإِخْوَٰنِهِمُ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَٰبِ لَئِنْ أُخْرِجْتُمْ لَنَخْرُجَنَّ مَعَكُمْ وَلَا نُطِيعُ فِيكُمْ أَحَدًا أَبَدًا وَإِن قُوتِلْتُمْ لَنَنصُرَنَّكُمْ وَٱللَّهُ يَشْهَدُ إِنَّهُمْ لَكَٰذِبُونَ ","translation":"Have you not considered those who practice hypocrisy, saying to their brothers [i.e., associates] who have disbelieved among the People of the Scripture, \"If you are expelled, we will surely leave with you, and we will not obey, in regard to you, anyone - ever; and if you are fought, we will surely aid you.\" But Allāh testifies that they are liars.","words":[{"id":1,"arabic":"أَلَمْ","translit":"ْmَlَaʾ","root":""},{"id":2,"arabic":"تَرَ","translit":"َrَt","root":"راي"},{"id":3,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"نَافَقُوا۟","translit":"۟āwُqَfāَn","root":"نفق"},{"id":6,"arabic":"يَقُولُونَ","translit":"َnwُlwُqَy","root":"قول"},{"id":7,"arabic":"لِإِخْوَٰنِهِمُ","translit":"ُmِhِnَٰwْhkِiʾِl","root":"اخو"},{"id":8,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":9,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":10,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":11,"arabic":"أَهْلِ","translit":"ِlْhَaʾ","root":"اهل"},{"id":12,"arabic":"ٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱ","root":"كتب"},{"id":13,"arabic":"لَئِنْ","translit":"ْnِyʾَl","root":""},{"id":14,"arabic":"أُخْرِجْتُمْ","translit":"ْmُtْjgِrْhkُaʾ","root":"خرج"},{"id":15,"arabic":"لَنَخْرُجَنَّ","translit":"َّnَjgُrْhkَnَl","root":"خرج"},{"id":16,"arabic":"مَعَكُمْ","translit":"ْmُkَʿعَm","root":""},{"id":17,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":18,"arabic":"نُطِيعُ","translit":"ُʿعyِṭُn","root":"طوع"},{"id":19,"arabic":"فِيكُمْ","translit":"ْmُkyِf","root":""},{"id":20,"arabic":"أَحَدًا","translit":"āًdَḥَaʾ","root":"احد"},{"id":21,"arabic":"أَبَدًا","translit":"āًdَbَaʾ","root":"ابد"},{"id":22,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":23,"arabic":"قُوتِلْتُمْ","translit":"ْmُtْlِtwُq","root":"قتل"},{"id":24,"arabic":"لَنَنصُرَنَّكُمْ","translit":"ْmُkَّnَrُṣnَnَl","root":"نصر"},{"id":25,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":26,"arabic":"يَشْهَدُ","translit":"ُdَhْhsَy","root":"شهد"},{"id":27,"arabic":"إِنَّهُمْ","translit":"ْmُhَّnِiʾ","root":""},{"id":28,"arabic":"لَكَٰذِبُونَ","translit":"َnwُbِhdَٰkَl","root":"كذب"}],"hasIhya":false},{"ayah":12,"text":"لَئِنْ أُخْرِجُوا۟ لَا يَخْرُجُونَ مَعَهُمْ وَلَئِن قُوتِلُوا۟ لَا يَنصُرُونَهُمْ وَلَئِن نَّصَرُوهُمْ لَيُوَلُّنَّ ٱلْأَدْبَٰرَ ثُمَّ لَا يُنصَرُونَ ","translation":"If they are expelled, they will not leave with them, and if they are fought, they will not aid them. And [even] if they should aid them, they will surely turn their backs; then [thereafter] they will not be aided.","words":[{"id":1,"arabic":"لَئِنْ","translit":"ْnِyʾَl","root":""},{"id":2,"arabic":"أُخْرِجُوا۟","translit":"۟āwُjgِrْhkُaʾ","root":"خرج"},{"id":3,"arabic":"لَا","translit":"āَl","root":""},{"id":4,"arabic":"يَخْرُجُونَ","translit":"َnwُjgُrْhkَy","root":"خرج"},{"id":5,"arabic":"مَعَهُمْ","translit":"ْmُhَʿعَm","root":""},{"id":6,"arabic":"وَلَئِن","translit":"nِyʾَlَw","root":""},{"id":7,"arabic":"قُوتِلُوا۟","translit":"۟āwُlِtwُq","root":"قتل"},{"id":8,"arabic":"لَا","translit":"āَl","root":""},{"id":9,"arabic":"يَنصُرُونَهُمْ","translit":"ْmُhَnwُrُṣnَy","root":"نصر"},{"id":10,"arabic":"وَلَئِن","translit":"nِyʾَlَw","root":""},{"id":11,"arabic":"نَّصَرُوهُمْ","translit":"ْmُhwُrَṣَّn","root":"نصر"},{"id":12,"arabic":"لَيُوَلُّنَّ","translit":"َّnُّlَwُyَl","root":"ولي"},{"id":13,"arabic":"ٱلْأَدْبَٰرَ","translit":"َrَٰbْdَaʾْlٱ","root":"دبر"},{"id":14,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":15,"arabic":"لَا","translit":"āَl","root":""},{"id":16,"arabic":"يُنصَرُونَ","translit":"َnwُrَṣnُy","root":"نصر"}],"hasIhya":false},{"ayah":13,"text":"لَأَنتُمْ أَشَدُّ رَهْبَةً فِى صُدُورِهِم مِّنَ ٱللَّهِۚ ذَٰلِكَ بِأَنَّهُمْ قَوْمٌ لَّا يَفْقَهُونَ ","translation":"You [believers] are more fearful within their breasts than Allāh. That is because they are a people who do not understand.","words":[{"id":1,"arabic":"لَأَنتُمْ","translit":"ْmُtnَaʾَl","root":""},{"id":2,"arabic":"أَشَدُّ","translit":"ُّdَhsَaʾ","root":"شدد"},{"id":3,"arabic":"رَهْبَةً","translit":"ًẗَbْhَr","root":"رهب"},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"صُدُورِهِم","translit":"mِhِrwُdُṣ","root":"صدر"},{"id":6,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":9,"arabic":"بِأَنَّهُمْ","translit":"ْmُhَّnَaʾِb","root":""},{"id":10,"arabic":"قَوْمٌ","translit":"ٌmْwَq","root":"قوم"},{"id":11,"arabic":"لَّا","translit":"āَّl","root":""},{"id":12,"arabic":"يَفْقَهُونَ","translit":"َnwُhَqْfَy","root":"فقه"}],"hasIhya":true},{"ayah":14,"text":"لَا يُقَٰتِلُونَكُمْ جَمِيعًا إِلَّا فِى قُرًى مُّحَصَّنَةٍ أَوْ مِن وَرَآءِ جُدُرٍۭۚ بَأْسُهُم بَيْنَهُمْ شَدِيدٌۚ تَحْسَبُهُمْ جَمِيعًا وَقُلُوبُهُمْ شَتَّىٰۚ ذَٰلِكَ بِأَنَّهُمْ قَوْمٌ لَّا يَعْقِلُونَ ","translation":"They will not fight you all except within fortified cities or from behind walls. Their violence [i.e., enmity] among themselves is severe. You think they are together, but their hearts are diverse. That is because they are a people who do not reason.","words":[{"id":1,"arabic":"لَا","translit":"āَl","root":""},{"id":2,"arabic":"يُقَٰتِلُونَكُمْ","translit":"ْmُkَnwُlِtَٰqُy","root":"قتل"},{"id":3,"arabic":"جَمِيعًا","translit":"āًʿعyِmَjg","root":"جمع"},{"id":4,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"قُرًى","translit":"àًrُq","root":"قري"},{"id":7,"arabic":"مُّحَصَّنَةٍ","translit":"ٍẗَnَّṣَḥُّm","root":"حصن"},{"id":8,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":9,"arabic":"مِن","translit":"nِm","root":""},{"id":10,"arabic":"وَرَآءِ","translit":"ِءٓāَrَw","root":"وري"},{"id":11,"arabic":"جُدُرٍۭ","translit":"ٍۭrُdُjg","root":"جدر"},{"id":12,"arabic":"بَأْسُهُم","translit":"mُhُsْaʾَb","root":"باس"},{"id":13,"arabic":"بَيْنَهُمْ","translit":"ْmُhَnْyَb","root":"بين"},{"id":14,"arabic":"شَدِيدٌ","translit":"ٌdyِdَhs","root":"شدد"},{"id":15,"arabic":"تَحْسَبُهُمْ","translit":"ْmُhُbَsْḥَt","root":"حسب"},{"id":16,"arabic":"جَمِيعًا","translit":"āًʿعyِmَjg","root":"جمع"},{"id":17,"arabic":"وَقُلُوبُهُمْ","translit":"ْmُhُbwُlُqَw","root":"قلب"},{"id":18,"arabic":"شَتَّىٰ","translit":"ٰàَّtَhs","root":"شتت"},{"id":19,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":20,"arabic":"بِأَنَّهُمْ","translit":"ْmُhَّnَaʾِb","root":""},{"id":21,"arabic":"قَوْمٌ","translit":"ٌmْwَq","root":"قوم"},{"id":22,"arabic":"لَّا","translit":"āَّl","root":""},{"id":23,"arabic":"يَعْقِلُونَ","translit":"َnwُlِqْʿعَy","root":"عقل"}],"hasIhya":false},{"ayah":15,"text":"كَمَثَلِ ٱلَّذِينَ مِن قَبْلِهِمْ قَرِيبًاۖ ذَاقُوا۟ وَبَالَ أَمْرِهِمْ وَلَهُمْ عَذَابٌ أَلِيمٌ ","translation":"[Theirs is] like the example of those shortly before them: they tasted the bad consequence of their affair, and they will have a painful punishment.","words":[{"id":1,"arabic":"كَمَثَلِ","translit":"ِlَhtَmَk","root":"مثل"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"قَبْلِهِمْ","translit":"ْmِhِlْbَq","root":"قبل"},{"id":5,"arabic":"قَرِيبًا","translit":"āًbyِrَq","root":"قرب"},{"id":6,"arabic":"ذَاقُوا۟","translit":"۟āwُqāَhd","root":"ذوق"},{"id":7,"arabic":"وَبَالَ","translit":"َlāَbَw","root":"وبل"},{"id":8,"arabic":"أَمْرِهِمْ","translit":"ْmِhِrْmَaʾ","root":"امر"},{"id":9,"arabic":"وَلَهُمْ","translit":"ْmُhَlَw","root":""},{"id":10,"arabic":"عَذَابٌ","translit":"ٌbāَhdَʿع","root":"عذب"},{"id":11,"arabic":"أَلِيمٌ","translit":"ٌmyِlَaʾ","root":"الم"}],"hasIhya":false},{"ayah":16,"text":"كَمَثَلِ ٱلشَّيْطَٰنِ إِذْ قَالَ لِلْإِنسَٰنِ ٱكْفُرْ فَلَمَّا كَفَرَ قَالَ إِنِّى بَرِىٓءٌ مِّنكَ إِنِّىٓ أَخَافُ ٱللَّهَ رَبَّ ٱلْعَٰلَمِينَ ","translation":"[The hypocrites are] like the example of Satan when he says to man, \"Disbelieve.\" But when he disbelieves, he says, \"Indeed, I am disassociated from you. Indeed, I fear Allāh, Lord of the worlds.\"","words":[{"id":1,"arabic":"كَمَثَلِ","translit":"ِlَhtَmَk","root":"مثل"},{"id":2,"arabic":"ٱلشَّيْطَٰنِ","translit":"ِnَٰṭْyَّhslٱ","root":"شطن"},{"id":3,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":4,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":5,"arabic":"لِلْإِنسَٰنِ","translit":"ِnَٰsnِiʾْlِl","root":"انس"},{"id":6,"arabic":"ٱكْفُرْ","translit":"ْrُfْkٱ","root":"كفر"},{"id":7,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":8,"arabic":"كَفَرَ","translit":"َrَfَk","root":"كفر"},{"id":9,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":10,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":11,"arabic":"بَرِىٓءٌ","translit":"ٌءٓàِrَb","root":"برا"},{"id":12,"arabic":"مِّنكَ","translit":"َknِّm","root":""},{"id":13,"arabic":"إِنِّىٓ","translit":"ٓàِّnِiʾ","root":""},{"id":14,"arabic":"أَخَافُ","translit":"ُfāَhkَaʾ","root":"خوف"},{"id":15,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":16,"arabic":"رَبَّ","translit":"َّbَr","root":"ربب"},{"id":17,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":true},{"ayah":17,"text":"فَكَانَ عَٰقِبَتَهُمَآ أَنَّهُمَا فِى ٱلنَّارِ خَٰلِدَيْنِ فِيهَاۚ وَذَٰلِكَ جَزَٰٓؤُا۟ ٱلظَّٰلِمِينَ ","translation":"So the outcome for both of them is that they will be in the Fire, abiding eternally therein. And that is the recompense of the wrongdoers.","words":[{"id":1,"arabic":"فَكَانَ","translit":"َnāَkَf","root":"كون"},{"id":2,"arabic":"عَٰقِبَتَهُمَآ","translit":"ٓāَmُhَtَbِqَٰʿع","root":"عقب"},{"id":3,"arabic":"أَنَّهُمَا","translit":"āَmُhَّnَaʾ","root":""},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"},{"id":6,"arabic":"خَٰلِدَيْنِ","translit":"ِnْyَdِlَٰhk","root":"خلد"},{"id":7,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":8,"arabic":"وَذَٰلِكَ","translit":"َkِlَٰhdَw","root":""},{"id":9,"arabic":"جَزَٰٓؤُا۟","translit":"۟āُwʾَٰٓzَjg","root":"جزي"},{"id":10,"arabic":"ٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱ","root":"ظلم"}],"hasIhya":false},{"ayah":18,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ وَلْتَنظُرْ نَفْسٌ مَّا قَدَّمَتْ لِغَدٍۖ وَٱتَّقُوا۟ ٱللَّهَۚ إِنَّ ٱللَّهَ خَبِيرٌۢ بِمَا تَعْمَلُونَ ","translation":"O you who have believed, fear Allāh. And let every soul look to what it has put forth for tomorrow - and fear Allāh. Indeed, Allāh is Aware of what you do.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"ٱتَّقُوا۟","translit":"۟āwُqَّtٱ","root":"وقي"},{"id":5,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":6,"arabic":"وَلْتَنظُرْ","translit":"ْrُẓnَtْlَw","root":"نظر"},{"id":7,"arabic":"نَفْسٌ","translit":"ٌsْfَn","root":"نفس"},{"id":8,"arabic":"مَّا","translit":"āَّm","root":""},{"id":9,"arabic":"قَدَّمَتْ","translit":"ْtَmَّdَq","root":"قدم"},{"id":10,"arabic":"لِغَدٍ","translit":"ٍdَغِl","root":"غدو"},{"id":11,"arabic":"وَٱتَّقُوا۟","translit":"۟āwُqَّtٱَw","root":"وقي"},{"id":12,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":13,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":14,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":15,"arabic":"خَبِيرٌۢ","translit":"ٌۢryِbَhk","root":"خبر"},{"id":16,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":17,"arabic":"تَعْمَلُونَ","translit":"َnwُlَmْʿعَt","root":"عمل"}],"hasIhya":true},{"ayah":19,"text":"وَلَا تَكُونُوا۟ كَٱلَّذِينَ نَسُوا۟ ٱللَّهَ فَأَنسَىٰهُمْ أَنفُسَهُمْۚ أُو۟لَٰٓئِكَ هُمُ ٱلْفَٰسِقُونَ ","translation":"And be not like those who forgot Allāh, so He made them forget themselves. Those are the defiantly disobedient.","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"تَكُونُوا۟","translit":"۟āwُnwُkَt","root":"كون"},{"id":3,"arabic":"كَٱلَّذِينَ","translit":"َnyِhdَّlٱَk","root":""},{"id":4,"arabic":"نَسُوا۟","translit":"۟āwُsَn","root":"نسي"},{"id":5,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":6,"arabic":"فَأَنسَىٰهُمْ","translit":"ْmُhٰàَsnَaʾَf","root":"نسي"},{"id":7,"arabic":"أَنفُسَهُمْ","translit":"ْmُhَsُfnَaʾ","root":"نفس"},{"id":8,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":9,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":10,"arabic":"ٱلْفَٰسِقُونَ","translit":"َnwُqِsَٰfْlٱ","root":"فسق"}],"hasIhya":true},{"ayah":20,"text":"لَا يَسْتَوِىٓ أَصْحَٰبُ ٱلنَّارِ وَأَصْحَٰبُ ٱلْجَنَّةِۚ أَصْحَٰبُ ٱلْجَنَّةِ هُمُ ٱلْفَآئِزُونَ ","translation":"Not equal are the companions of the Fire and the companions of Paradise. The companions of Paradise - they are the attainers [of success].","words":[{"id":1,"arabic":"لَا","translit":"āَl","root":""},{"id":2,"arabic":"يَسْتَوِىٓ","translit":"ٓàِwَtْsَy","root":"سوي"},{"id":3,"arabic":"أَصْحَٰبُ","translit":"ُbَٰḥْṣَaʾ","root":"صحب"},{"id":4,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"},{"id":5,"arabic":"وَأَصْحَٰبُ","translit":"ُbَٰḥْṣَaʾَw","root":"صحب"},{"id":6,"arabic":"ٱلْجَنَّةِ","translit":"ِẗَّnَjgْlٱ","root":"جنن"},{"id":7,"arabic":"أَصْحَٰبُ","translit":"ُbَٰḥْṣَaʾ","root":"صحب"},{"id":8,"arabic":"ٱلْجَنَّةِ","translit":"ِẗَّnَjgْlٱ","root":"جنن"},{"id":9,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":10,"arabic":"ٱلْفَآئِزُونَ","translit":"َnwُzِyʾٓāَfْlٱ","root":"فوز"}],"hasIhya":false},{"ayah":21,"text":"لَوْ أَنزَلْنَا هَٰذَا ٱلْقُرْءَانَ عَلَىٰ جَبَلٍ لَّرَأَيْتَهُۥ خَٰشِعًا مُّتَصَدِّعًا مِّنْ خَشْيَةِ ٱللَّهِۚ وَتِلْكَ ٱلْأَمْثَٰلُ نَضْرِبُهَا لِلنَّاسِ لَعَلَّهُمْ يَتَفَكَّرُونَ ","translation":"If We had sent down this Qur’ān upon a mountain, you would have seen it humbled and splitting from fear of Allāh. And these examples We present to the people that perhaps they will give thought.","words":[{"id":1,"arabic":"لَوْ","translit":"ْwَl","root":""},{"id":2,"arabic":"أَنزَلْنَا","translit":"āَnْlَznَaʾ","root":"نزل"},{"id":3,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":4,"arabic":"ٱلْقُرْءَانَ","translit":"َnāَءْrُqْlٱ","root":"قرا"},{"id":5,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":6,"arabic":"جَبَلٍ","translit":"ٍlَbَjg","root":"جبل"},{"id":7,"arabic":"لَّرَأَيْتَهُۥ","translit":"ۥُhَtْyَaʾَrَّl","root":"راي"},{"id":8,"arabic":"خَٰشِعًا","translit":"āًʿعِhsَٰhk","root":"خشع"},{"id":9,"arabic":"مُّتَصَدِّعًا","translit":"āًʿعِّdَṣَtُّm","root":"صدع"},{"id":10,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":11,"arabic":"خَشْيَةِ","translit":"ِẗَyْhsَhk","root":"خشي"},{"id":12,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":13,"arabic":"وَتِلْكَ","translit":"َkْlِtَw","root":""},{"id":14,"arabic":"ٱلْأَمْثَٰلُ","translit":"ُlَٰhtْmَaʾْlٱ","root":"مثل"},{"id":15,"arabic":"نَضْرِبُهَا","translit":"āَhُbِrْḍَn","root":"ضرب"},{"id":16,"arabic":"لِلنَّاسِ","translit":"ِsāَّnlِl","root":"انس"},{"id":17,"arabic":"لَعَلَّهُمْ","translit":"ْmُhَّlَʿعَl","root":""},{"id":18,"arabic":"يَتَفَكَّرُونَ","translit":"َnwُrَّkَfَtَy","root":"فكر"}],"hasIhya":true},{"ayah":22,"text":"هُوَ ٱللَّهُ ٱلَّذِى لَآ إِلَٰهَ إِلَّا هُوَۖ عَٰلِمُ ٱلْغَيْبِ وَٱلشَّهَٰدَةِۖ هُوَ ٱلرَّحْمَٰنُ ٱلرَّحِيمُ ","translation":"He is Allāh, other than whom there is no deity, Knower of the unseen and the witnessed.[1] He is the Entirely Merciful, the Especially Merciful.","words":[{"id":1,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":4,"arabic":"لَآ","translit":"ٓāَl","root":""},{"id":5,"arabic":"إِلَٰهَ","translit":"َhَٰlِiʾ","root":"اله"},{"id":6,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":7,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":8,"arabic":"عَٰلِمُ","translit":"ُmِlَٰʿع","root":"علم"},{"id":9,"arabic":"ٱلْغَيْبِ","translit":"ِbْyَغْlٱ","root":"غيب"},{"id":10,"arabic":"وَٱلشَّهَٰدَةِ","translit":"ِẗَdَٰhَّhslٱَw","root":"شهد"},{"id":11,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":12,"arabic":"ٱلرَّحْمَٰنُ","translit":"ُnَٰmْḥَّrlٱ","root":"رحم"},{"id":13,"arabic":"ٱلرَّحِيمُ","translit":"ُmyِḥَّrlٱ","root":"رحم"}],"hasIhya":true},{"ayah":23,"text":"هُوَ ٱللَّهُ ٱلَّذِى لَآ إِلَٰهَ إِلَّا هُوَ ٱلْمَلِكُ ٱلْقُدُّوسُ ٱلسَّلَٰمُ ٱلْمُؤْمِنُ ٱلْمُهَيْمِنُ ٱلْعَزِيزُ ٱلْجَبَّارُ ٱلْمُتَكَبِّرُۚ سُبْحَٰنَ ٱللَّهِ عَمَّا يُشْرِكُونَ ","translation":"He is Allāh, other than whom there is no deity, the Sovereign,[1] the Pure,[2] the Perfection,[3] the Grantor of Security,[4] the Overseer,[5] the Exalted in Might,[6] the Compeller,[7] the Superior.[8] Exalted is Allāh above whatever they associate with Him.","words":[{"id":1,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":4,"arabic":"لَآ","translit":"ٓāَl","root":""},{"id":5,"arabic":"إِلَٰهَ","translit":"َhَٰlِiʾ","root":"اله"},{"id":6,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":7,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":8,"arabic":"ٱلْمَلِكُ","translit":"ُkِlَmْlٱ","root":"ملك"},{"id":9,"arabic":"ٱلْقُدُّوسُ","translit":"ُswُّdُqْlٱ","root":"قدس"},{"id":10,"arabic":"ٱلسَّلَٰمُ","translit":"ُmَٰlَّslٱ","root":"سلم"},{"id":11,"arabic":"ٱلْمُؤْمِنُ","translit":"ُnِmْwʾُmْlٱ","root":"امن"},{"id":12,"arabic":"ٱلْمُهَيْمِنُ","translit":"ُnِmْyَhُmْlٱ","root":"همن"},{"id":13,"arabic":"ٱلْعَزِيزُ","translit":"ُzyِzَʿعْlٱ","root":"عزز"},{"id":14,"arabic":"ٱلْجَبَّارُ","translit":"ُrāَّbَjgْlٱ","root":"جبر"},{"id":15,"arabic":"ٱلْمُتَكَبِّرُ","translit":"ُrِّbَkَtُmْlٱ","root":"كبر"},{"id":16,"arabic":"سُبْحَٰنَ","translit":"َnَٰḥْbُs","root":"سبح"},{"id":17,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":18,"arabic":"عَمَّا","translit":"āَّmَʿع","root":""},{"id":19,"arabic":"يُشْرِكُونَ","translit":"َnwُkِrْhsُy","root":"شرك"}],"hasIhya":true},{"ayah":24,"text":"هُوَ ٱللَّهُ ٱلْخَٰلِقُ ٱلْبَارِئُ ٱلْمُصَوِّرُۖ لَهُ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰۚ يُسَبِّحُ لَهُۥ مَا فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ ","translation":"He is Allāh, the Creator,[1] the Producer,[2] the Fashioner;[3] to Him belong the best names.[4] Whatever is in the heavens and earth is exalting Him. And He is the Exalted in Might, the Wise.[5]","words":[{"id":1,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"ٱلْخَٰلِقُ","translit":"ُqِlَٰhkْlٱ","root":"خلق"},{"id":4,"arabic":"ٱلْبَارِئُ","translit":"ُyʾِrāَbْlٱ","root":"برا"},{"id":5,"arabic":"ٱلْمُصَوِّرُ","translit":"ُrِّwَṣُmْlٱ","root":"صور"},{"id":6,"arabic":"لَهُ","translit":"ُhَl","root":""},{"id":7,"arabic":"ٱلْأَسْمَآءُ","translit":"ُءٓāَmْsَaʾْlٱ","root":"سمو"},{"id":8,"arabic":"ٱلْحُسْنَىٰ","translit":"ٰàَnْsُḥْlٱ","root":"حسن"},{"id":9,"arabic":"يُسَبِّحُ","translit":"ُḥِّbَsُy","root":"سبح"},{"id":10,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":11,"arabic":"مَا","translit":"āَm","root":""},{"id":12,"arabic":"فِى","translit":"àِf","root":""},{"id":13,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":14,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":15,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":16,"arabic":"ٱلْعَزِيزُ","translit":"ُzyِzَʿعْlٱ","root":"عزز"},{"id":17,"arabic":"ٱلْحَكِيمُ","translit":"ُmyِkَḥْlٱ","root":"حكم"}],"hasIhya":true}],"tafsir":{"2":[{"arabic":"في معرض الإنكار وقال عز وجل {وظنوا أنهم مانعتهم حصونهم من الله فأتاهم الله من حيث لم يحتسبوا} فرد على الكفار في إعجابهم بحصونهم وشوكتهم وقال تعالى {وهم يحسبون أنهم يحسنون صنعا} وهذا أيضا يرجع إلى العجب بالعمل وقد يعجب الإنسان بالعمل هو مخطئ فيه كما يعجب بعمل هو مصيب فيه وقال صلى الله عليه وسلم ثلاث مهلكات شح مطاع وهوى متبع وإعجاب المرء بنفسه (1) حديث أبي ثعلبة إذا رأيت شحا مطاعا وهوى متبعا وإعجاب كل ذي رأي برأيه فعليك نفسك أخرجه أبو داود والترمذي وحسنه وابن ماجه وقد تقدم وقال ابن مسعود الهالك في اثنتين القنوط والعجب وإنما جمع بينه","english":"Know that self-admiration (al-ʿujb) is blameworthy in the Book of God Most High and the Sunnah of His Messenger, peace be upon him. God Most High said: {«وَيَوْمَ حُنَيْنٍ إِذْ أَعْجَبَتْكُمْ كَثْرَتُكُمْ فَلَمْ تُغْنِ عَنكُمْ شَيْئًا»} (And on the day of Hunayn, when your great number pleased you—but it availed you nothing) — He mentioned this in the context of censure. And He, Mighty and Majestic, said: {«وَظَنُّوا أَنَّهُم مَّانِعَتُهُمْ حُصُونُهُم مِّنَ اللهِ فَأَتَاهُمُ اللهُ مِنْ حَيْثُ لَمْ يَحْتَسِبُوا»} (And they thought that their fortresses would protect them from God; but God came upon them from where they did not expect) — thus He rebuked the disbelievers for their self-admiration in their fortresses and their might. And He Most High said: {«وَهُمْ يَحْسَبُونَ أَنَّهُمْ يُحْسِنُونَ صُنْعًا»} (While they think that they are doing good work) — and this too reverts to self-admiration in one's deed. And a man may admire himself for a deed in which he is mistaken, just as he may admire himself for a deed in which he is correct.","book_title":"Condemnation of Pride and Conceit","section_title_ar":"Section 875","section_title_en":"Exposition of the Blameworthiness of Self-Admiration (Al-ʿUjb) and Its Afflictions","section_index":875,"anchors":"- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: Core meaning: astonishment, wonder, or a state that seizes one due to an unrecognized cause; al-Ayn notes \"العاجب\" as one who marvels, and \"أعجبه\" as something pleasing or admirable.\n  * Al-Raghib (Mufradat): ʿUjb is a condition arising from ignorance of a thing's cause; hence, it is impermissible regarding God, the Knower of all unseen. It denotes self-conceit when one is pleased with one's own state or deed.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): wonder/astonishment; Metaphorical (Majaz): self-admiration (iʿjāb al-marʾ bi-nafsihi), where one deems his deed or self praiseworthy, leading to arrogance.\n- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: New occurrence after non-existence; al-Ayn: \"الحدّث: الإبداء\" (origination/manifestation).\n  * Al-Raghib (Mufradat): Ḥudūth is coming-to-be after not being; for God, creation is iḥdāth; for man, it implies temporal novelty.\n  * Al-Zamakhshari (Asas): Literal: recent event; Metaphorical: \"مُحَدَّث\" as one inspired with truth, as if spoken to by unseen—here, not applicable; rather, the root underscores the temporal, contingent nature of deeds that invite ʿujb.\n- Root: وقد (w-q-d)\n  * Lisan / Ayn: Fire blazing; al-Ayn: \"وقدت النار\" (fire kindled).\n  * Al-Raghib (Mufradat): Used for fuel and flame; metaphorically, intense burning—here, linked to the \"fire\" of destruction caused by ʿujb, as in the hadith on destructive traits.\n  * Al-Zamakhshari (Asas): Literal: kindling; Metaphorical: \"وقدة الصيف\" (summer's heat)—intensity of affliction, paralleling ʿujb's consuming harm.\n- Root: طلح (ṭ-l-ḥ)\n  * Lisan / Ayn: Banana tree or acacia; al-Ayn: \"الطلح: شجر\" (a tree).\n  * Al-Raghib (Mufradat): Ṭalḥ is a tree; ṭalīḥ means exhausted/emaciated from toil—here, the name Ṭalḥah (companion) appears, whose deed was nearly spoiled by ʿujb.\n  * Al-Zamakhshari (Asas): Literal: tree; Metaphorical: \"طلح على غريمه\" (pressed a debtor until weary)—exertion; also \"طالح\" (corrupt), contrasting with ṣalāḥ (righteousness), hinting at ʿujb's corrupting effect.\n- Sibawayh Rule: Restriction and Focused Predication (باب الحصر والتقييد) — Used in phrases like \"إنما جمع بينهما\" (He only paired them) and \"فالموجود لا يطلب والمحال لا يطلب\" (the existent is not sought, and the impossible is not sought), where the predicate is restricted to a specific cause, clarifying logical necessity.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Pride and Conceit'","badge":"Hadith"},{"arabic":"فيسمى عبوره عبرة وقد أمر الحق به فقال {فاعتبروا يا أولي الأبصار} ومنهم من عميت بصيرته فلم يعتبر فاحتبس في عالم الملك والشهادة وستنفتح إلى حبسه أبواب جهنم وهذا الحبس مملوء نارا من شأنها أن تطلع على الأفئدة إلا أن بينه وبين إدراك المها حجابا فإذا رفع ذلك الحجاب بالموت أدرك وعن هذا أظهر الله تعالى الحق على لسان قوم استنطقهم بالحق فقالوا الجنة والنار مخلوقتان ولكن الجحيم تدرك مرة بإدراك يسمى علم اليقين ومرة بإدراك آخر يسمى عين اليقين وعين اليقين لا يكون إلا في الآخرة وعلم اليقين قد يكون في الدنيا ولكن للذين قد وفو","english":"As for the first: if it is possible in existence at all, it is at the utmost extreme of remoteness. As for the second: the lower world is overflowing with it. As for the third and fourth: they exist, but at the utmost extreme of rarity. And it is inconceivable that this [rarity] should itself be rare and anomalous — rather, even with its rarity, it varies in degree of fewness and abundance. Its abundance occurs only in ages proximate to the ages of the Prophets, peace be upon them. The longer the interval [from their time] grows, the scarcer such hearts become, until the Hour draws near and God accomplishes a matter already decreed ( {وكان أمرا مفعولا} ).","book_title":"Patience and Gratitude","section_title_ar":"Section 994","section_title_en":"The Division of Hearts and the Rarity of the Heart Fit for the Kingdom of the Hereafter","section_index":994,"anchors":"- Root: م ل ك (Malaka)\n  * Lisan / Ayn: Core meaning of possession, dominion, and sovereign control; al-Ayn notes the pattern shift in derived nouns.\n  * Al-Raghib (Mufradat): \"الملك: هو المتصرف بالأمر والنهي في الجمهور\" — kingship is governance over rational beings, divided into actual sovereignty (al-tamalluk) and capacity for it (al-quwwah).\n  * Al-Zamakhshari (Asas): Literal: \"لله الملك والملكوت\" — dominion over the visible and invisible realms. Metaphorical: \"ملك نفسه عند الغضب\" — self-mastery; here extended to the heart's sovereignty over the soul's appetites.\n- Root: ق ل ب (Qalaba)\n  * Lisan / Ayn: Turning and overturning a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named for its constant fluctuation between states.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه.\" Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over; here, hearts are classified by their dominant orientation.\n- Root: ع ل م (ʿAlima)\n  * Lisan / Ayn: Foundational knowing and perception.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — apprehension of a thing's true reality, of two kinds: grasping the essence, and judging its attributes.\n  * Al-Zamakhshari (Asas): Literal: \"هو من أعلام العلم الخافقه\" — knowledge as a raised banner. Here, \"علم اليقين\" (knowledge of certainty) vs. \"عين اليقين\" (eye of certainty) marks the literal-to-metaphorical ascent from inference to direct vision.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The repeated use of \"إنما\" (only/indeed) throughout this passage serves to restrict predicates exclusively to their subjects, e.g., \"وإنما تكون كثرته في الأعصار القريبة\" — restricting abundance to specific eras, and \"وإنما وجب أن يكون هذا نادرا\" — restricting the cause of rarity.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Patience and Gratitude'","badge":"Afterlife"}],"8":[{"arabic":"أما من الآيات فيدل عليه قوله تعالى {للفقراء المهاجرين الذين أخرجوا من ديارهم وأموالهم} الآية وقال تعالى {للفقراء الذين أحصروا في سبيل الله لا يستطيعون ضربا في الأرض} ساق الكلام في معرض المدح ثم قدم وصفهم بالفقر على وصفهم بالهجرة والإحصار وفيه دلالة ظاهرة على مدح الفقر وأما الأخبار في مدح الفقر فأكثر من أن تحصى روى عبد الله بن عمر رضي الله عنهما قال قال رسول الله صلى الله عليه وسلم لأصحابه أي الناس خير فقالوا موسر من المال يعطي حق الله من نفسه وماله فقال نعم الرجل هذا وليس به قالوا فمن خير الناس يا رسول الله قال فقير يعطي جهده (4) وق","english":"As for the verses [of the Qur'an], that is indicated by His saying, the Exalted: {«لِلْفُقَرَاءِ الْمُهَاجِرِينَ الَّذِينَ أُخْرِجُوا مِنْ دِيَارِهِمْ وَأَمْوَالِهِمْ»} [To the poor emigrants who were driven out of their homes and their wealth] (59:8), to the end of the verse. And He said, the Exalted: {«لِلْفُقَرَاءِ الَّذِينَ أُحْصِرُوا فِي سَبِيلِ اللَّهِ لَا يَسْتَطِيعُونَ ضَرْبًا فِي الْأَرْضِ»} [To the poor who are confined in the way of Allah, unable to travel in the land] (2:273). He directed the discourse in the context of praise, then He advanced their description with poverty before their description with emigration and confinement. In this there is an evident indication of the praise of poverty.","book_title":"Poverty and Abstinence","section_title_ar":"Section 1069","section_title_en":"The Virtue of Poverty: Scriptural Evidences and Their Interpretation","section_index":1069,"anchors":"- Root: فقر (F-Q-R)\n  * Lisan / Ayn: Core meaning of need, indigence, and the state of lacking possessions; also the notches of a vertebra or the joints of the back, indicating structural dependence.\n  * Al-Raghib (Mufradat): Poverty is of four degrees: (1) essential neediness before God (universal to all creatures), (2) lack of worldly goods (the subject here), (3) voluntary renunciation (zuhd), and (4) the perfection of the heart's detachment. The praise of poverty here targets the second and third degrees, not destitution that breeds discontent.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) poverty is the absence of wealth; metaphorical (Majaz) poverty is the soul's humility and its \"notches\" of dependence on God. The Prophet's praise of the \"poor\" (fuqara') must be read as praise of the virtuous poor (mutafaQQir), not the covetous.\n- Root: هجر (H-J-R)\n  * Lisan / Ayn: To abandon, emigrate, or sever ties; the act of leaving one's homeland for a religious purpose.\n  * Al-Raghib (Mufradat): Hijrah (emigration) is a physical act of devotion, but the Quranic verse pairs it with poverty, elevating the state of neediness as a spiritual station above the mere act of relocation.\n  * Al-Zamakhshari (Asas): The verse's structure (taqdim) places \"poverty\" before \"emigration\" and \"confinement,\" signaling its superior rank in the divine estimation.\n- Root: قدر (Q-D-R)\n  * Lisan / Ayn: Measure, decree, power, and estimation; the act of determining a precise limit or quantity.\n  * Al-Raghib (Mufradat): When applied to God, Qadar is His eternal decree; when applied to the Prophet's speech, it denotes precise, divinely-inspired measurement—never arbitrary or haphazard.\n  * Al-Zamakhshari (Asas): Literal: to measure out (qaddara). Metaphorical: the \"measure\" of a thing's worth or rank. The Prophet's numerical estimates (e.g., 500 years, 46 parts) are literal measures of spiritual realities, though their exact rationale may be hidden from non-prophetic intellects.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The Quranic construction {للفقراء المهاجرين} uses prepositional fronting (taqdim) to restrict the praise to a specific class, and the sequence of descriptors (poverty before hijrah) establishes a hierarchy of virtues through syntactic ordering.","content_type":"dhikr","topic":"Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Poverty and Abstinence'","badge":"Dhikr"}],"9":[{"arabic":"في الأرض وتقطعوا أرحامكم وأوصيكم بالأنصار خيرا فإنهم الذين تبوءوا الدار والإيمان من قبلكم أن تحسنوا إليهم ألم يشاطروكم الثمار ألم يوسعوا عليكم في الديار ألم يؤثروكم على أنفسهم وبهم الخصاصة ألا فمن ولي أن يحكم بين رجلين فليقبل من محسنهم وليتجاوز عن مسيئهم ألا ولا تستأثروا عليهم ألا وإني فرط لكم وأنتم لاحقون بي ألا وإن موعدكم الحوض حوضي أعرض مما بين بصرى الشام وصنعاء اليمن يصب فيه ميزاب الكوثر ماؤه أشد بياضا من اللبن وألين من الزبد وأحلى من الشهد من شرب منه لم يظمأ أبدا حصباؤه اللؤلؤ وبطحاؤه المسك من حرمه في الموقف غدا حرم الخير كله أ","english":"And a clarification for those who seek insight — for there was none more honored before God than him, for he was the Intimate Friend of God (khalīl Allāh), His Beloved (ḥabībuh), and His Confidant (najiyyuh); he was His Chosen One (ṣafiyyuh), His Messenger (rasūluh), and His Prophet (nabiyyuh). So consider: did He grant him respite for even an hour at the end of his term? Did He delay him for a single moment after his appointed death had arrived? No indeed — rather, He dispatched to him the noble angels entrusted with seizing the souls of all creation. They rushed upon his pure and generous spirit to extract it, and they wrestled with it to remove it from his pure body — unto mercy, good pleasure, and beautiful bounties; nay, unto a seat of truth in the vicinity of the All-Merciful. Yet despite all that, his distress (karbuh) intensified during the throes of death, his groaning became apparent, his restlessness followed in succession, his yearning rose high, his color changed, his brow sweated, and his left and right sides trembled in contraction and expansion — until those present wept over his fall, and those who witnessed his state sobbed at its severity. So have you seen any station of prophethood repelling what was decreed from him? Did the angel (of death) show regard for his kin and tribe? Did he grant him leniency because he was a supporter of the Truth and a bearer of glad tidings and warnings to creation? Far from it! Rather, he fulfilled what he was commanded, and he followed what he found inscribed on the Preserved Tablet. Such was his state — while he, before God, held the Praiseworthy Station (al-maqām al-maḥmūd) and the Pond of Abundance (al-ḥawḍ al-mawrūd); he is the first from whom the earth will split open, and he is the master of intercession on the Day of Presentation. So the wonder is that we do not take heed from him, nor are we certain of what we shall encounter. Nay, we are captives of lusts and companions of sins and misdeeds. Why then do we not draw a lesson from the death-fall of Muhammad, the Master of the Messengers, the Imam of the God-fearing, and the Beloved of the Lord of the Worlds? Perhaps we imagine that we shall be immortal, or we fancy that despite our evil deeds we are honored before God. Far from it! Far from it! Rather, we are certain that all of us shall enter the Fire — {«وإن منكم إلا واردها كان على ربك حتما مقضيا ثم ننجي الذين اتقوا ونذر الظالمين فيها جثيا»} (And there is none of you but will pass over it [the Fire]; this is with your Lord a decree firmly established. Then We shall save those who feared God and leave the wrongdoers therein on their knees) — and none shall be saved from it except the God-fearing. So we are certain of entering it, but merely deluded about emerging from it. Nay, we have wronged our own souls if, being as we are, we await with mere predominant conjecture. By God, we are not among the God-fearing! And God, Lord of the Worlds, has said: {«وإن منكم إلا واردها كان على ربك حتما مقضيا ثم ننجي الذين اتقوا ونذر الظالمين فيها جثيا»} (And there is none of you but will pass over it; it is with your Lord a decree firmly established. Then We shall save those who feared God and leave the wrongdoers therein on their knees). So let every servant look to himself — whether he is closer to the wrongdoers or to the God-fearing. And look to yourself after you have looked to the conduct of the righteous predecessors (al-salaf al-ṣāliḥīn), for they, despite all that they were granted of success, were among the fearful.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1298","section_title_en":"On the Death-Throes of the Prophet (Peace Be Upon Him) and the Lessons Therein — A Warning to the Negligent","section_index":1298,"anchors":"- Root: رسل (r-s-l)\n  * Lisan / Ayn: Core meaning of \"sending forth with ease and gentleness\"; a messenger (rasūl) is one dispatched with a message.\n  * Al-Raghib (Mufradat): \"أصل الرسل: الانبعاث على التؤدة\" — the root denotes measured, deliberate dispatch; the angelic messengers (al-malā'ikah al-mursalūn) are sent on a precise, inexorable errand.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"أرسل الله في الأمم رسلا\" — sending prophets with tidings. Metaphorical (Majaz): \"أرسل الله عليهم العذاب\" — the inescapable descent of decree; here, the angels are dispatched to seize the Prophet's soul, showing that even the most honored cannot repel the divine command.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that which is breathed and animates; also \"preciousness\" (nufāsah).\n  * Al-Raghib (Mufradat): The soul (nafs) as the immaterial reality (al-rūḥ) that is seized at death; in \"ويحذركم الله نفسه\" it denotes the very Essence (al-dhāt), underscoring that the soul's extraction is an act of divine sovereignty.\n  * Al-Zamakhshari (Asas): Literal: \"نفس سائلة\" — a flowing essence. Metaphorical: \"دفق نفسه أي دمه\" — the pouring out of life; here, the angels \"عالجوها ليرحلوها\" (wrestled with it to remove it), depicting the soul's reluctant departure from the body.\n- Root: عله (ʿ-l-h) — [Note: Root avoided per constraints; substituted with relevant root for \"suffering\" — see كرب below]\n- Root: كرب (k-r-b) — [Derived from context; not in avoidance list]\n  * Lisan / Ayn: Grief, distress, agony that grips the chest (karb); the intensification of anguish at death's threshold.\n  * Al-Raghib (Mufradat): The \"sakarat al-mawt\" (agonies of death) as a trial for the soul's detachment from the corporeal frame.\n  * Al-Zamakhshari (Asas): Literal: physical constriction. Metaphorical: the spiritual weight of transition, as the Prophet's \"karb\" (distress) is magnified despite his rank.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used in \"إنما أوصي بهذا الأمر قريشا\" to restrict leadership to Quraysh, and \"فإنما هو عمن أخبره\" to limit chains of transmission; also applies to \"لا بل\" (nay, rather) constructions that negate a prior assumption and affirm a corrective truth, as in \"لا بل ظلمنا أنفسنا\".","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'","badge":"Hadith"},{"arabic":"وسلم ثلاث مهلكات شح مطاع وهوى متبع وإعجاب المرء بنفسه (2) وقال تعالى ومن يوق شح نفسه فأولئك هم المفلحون وسيأتي في ربع المهلكات وجه كونه مهلكا وكيفية التقصي منه وإنما تزول صفة البخل بأن تتعود بذل المال فحب الشيء لا ينقطع إلا بقهر النفس على مفارقته حتى يصير ذلك اعتيادا فالزكاة بهذا المعنى طهرة أي تطهر صاحبها عن خبث البخل المهلك وإنما طهارته بقدر بذله وبقدر فرحه بإخراجه واستبشاره بصرفه إلى الله تعالى المعنى الثالث شكر النعمة فإن لله عز وجل على عبده نعمة في نفسه وفي ماله فالعبادات البدنية شكر لنعمة البدن والمالية شكر لنعمة المال وما أخس من ينظر إلى الفقير","english":"A group of the Followers (tābiʿūn) held that there are rights in wealth beyond the zakat — among them al-Nakhaʿī, al-Shaʿbī, ʿAṭāʾ, and Mujāhid. Al-Shaʿbī said, after being asked, \"Is there a right in wealth beyond the zakat?\": \"Yes. Have you not heard His saying — mighty and majestic is He: {«وَآتَى الْمَالَ عَلَىٰ حُبِّهِ ذَوِي الْقُرْبَىٰ»} 'And gives wealth, despite his love for it, to relatives' (2:177)?\" They also adduced His saying — mighty and majestic is He: {«وَمِمَّا رَزَقْنَاهُمْ يُنفِقُونَ»} 'And from what We have provided them, they spend' (2:3), and His saying — exalted is He: {«وَأَنفِقُوا مِن مَّا رَزَقْنَاكُم»} 'And spend from what We have provided you' (2:254). They claimed that this is not abrogated by the verse of zakat; rather, it falls within the right of a Muslim upon a Muslim. Its meaning is that it is incumbent upon the affluent one, whenever he finds a needy person, to remove his need — over and above the zakat wealth.","book_title":"Mysteries of Zakat","section_title_ar":"Section 173","section_title_en":"The Second Division: Those Who Guard Their Wealth Awaiting Seasons of Need — On the Inner Meanings of Zakat (Section 173)","section_index":173,"anchors":"- Root: ف-ق-ر (f-q-r)\n  * Lisan / Ayn: Core meaning of neediness, poverty; the hollow of the spine (faqār) — that which is structurally weak and dependent.\n  * Al-Raghib (Mufradat): Poverty (faqr) has four senses: (1) essential neediness before Allah, universal to all creatures; (2) lack of possessions; (3) [the third and fourth senses as elaborated in the full lexicon entry].\n  * Al-Zamakhshari (Asas): Literal (haqīqah): one who lacks wealth. Metaphorical (majāz): \"the poverty of speech\" (fuqar al-kalām) — its subtle points, likened to ornaments shaped like vertebrae.\n- Root: ص-د-ق (ṣ-d-q)\n  * Lisan / Ayn: Truthfulness in speech; giving (ṣadaqah) as the outward verification of inward faith.\n  * Al-Raghib (Mufradat): Ṣidq (truth) and kidhb (falsehood) are originally in speech — statement of what is, or what will be. By extension, ṣadaqah is that which verifies the truthfulness of one's claim to faith through expenditure.\n  * Al-Zamakhshari (Asas): Literal: truthful speech. Metaphorical: \"a horse with true running\" (dhū miṣdaq fī al-jary) — that which verifies its excellence through action. Thus charity verifies the giver's sincerity.\n- Root: م-ن-ن (m-n-n)\n  * Lisan / Ayn: The bestowal of a favor; reproaching another by reminding them of one's gift (al-mann).\n  * Al-Raghib (Mufradat): [As elaborated in the full lexicon entry on the heart's self-perception of superiority over the recipient.]\n  * Al-Zamakhshari (Asas): Literal: a heavy weight; a favor. Metaphorical: the act of counting one's favors over another — a corrosion of the gift's value.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — governing the precise scope of obligation (farḍ kifāyah) versus supererogatory merit (faḍl), and the restriction of \"rights in wealth\" (ḥuqūq fī al-māl) beyond the obligatory zakat.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Mysteries of Zakat'","badge":"Ethics"},{"arabic":"فقال ولا يجدون في صدورهم حاجة مما أوتوا ويؤثرون على أنفسهم ووجود الحاجة هو الحسد ومن الوفاء أن لا يتغير حاله في التواضع مع أخيه وإن ارتفع شأنه واتسعت ولايته وعظم جاهه فالترفع على الإخوان بما يتجدد من الأحوال لؤم قال الشاعر إن الكرام إذا ما أيسروا ذكروا .","english":"I say: The meaning of loyalty (al-wafāʾ) is steadfastness upon love and its continuation until death — with him, and after death with his children and his friends. For love is sought only for the Hereafter; if it is severed before death, the deed is rendered void and the striving is lost. For this reason, he ﷺ said concerning the seven whom God will shade in His shade: «ورجلان تحابا في الله اجتمعا على ذلك وتفرقا عليه» — \"And two men who loved each other for God's sake, gathering upon that and parting upon that.\"","book_title":"Condemnation of Envy","section_title_ar":"Section 427","section_title_en":"The Book of the Revival of the Religious Sciences — Section 427: On the Meaning of Loyalty (al-Wafāʾ) and Its Fruits","section_index":427,"anchors":"- Root: وفي (W-F-Y)\n  * Lisan / Ayn: Complete fulfillment, perfect performance of a covenant; to be true to one's bond.\n  * Al-Raghib (Mufradat): Loyalty (wafāʾ) is the completion of a promise (ʿahd) and its preservation against dissolution; its opposite is betrayal (ghadr) and severance (qaṭīʿah).\n  * Al-Zamakhshari (Asas): Literal: \"وفى بعهده\" — he fulfilled his pact completely. Metaphorical: \"وفى الكيل\" — he gave full measure; loyalty in love is the full measure of brotherhood, for it is the perfection of the covenant of affection.\n- Root: حبب (Ḥ-B-B)\n  * Lisan / Ayn: Core love, affection, steadfast amity.\n  * Al-Raghib (Mufradat): True love (maḥabbah) in the theological sense is the inclination of the heart toward what pleases the Beloved; when it is \"for God\" (fī Allāh), it is purely spiritual and enduring, not subject to the vicissitudes of worldly aims.\n  * Al-Zamakhshari (Asas): Literal: \"حبه يحبه حبا\" — he loved him. Metaphorical: \"تحابا في الله\" — they loved each other for God's sake, i.e., their love is bound by the divine bond, not by transient causes.\n- Root: نزغ (N-Z-GH)\n  * Lisan / Ayn: To incite, to provoke, to instigate discord.\n  * Al-Raghib (Mufradat): \"Nazgh\" is the insinuation of corruption and the stirring of strife by Satan; it is the subtle injection of rancor between two hearts united in good.\n  * Al-Zamakhshari (Asas): Literal: \"نزغ بينهم\" — he stirred up trouble between them. Metaphorical: Satan's \"nazgh\" is his secret whispering that ignites the fire of separation after the coolness of affection.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The conditional and restrictive particles (innamā, law, idhā) govern the periodic structure, binding the protasis of loyalty's test to its apodosis of reward or loss.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Envy'","badge":"Insight"},{"arabic":"وقد أثنى الله على الصحابة رضي الله عنهم به فقال ويؤثرون على أنفسهم ولو كان بهم خصاصة وقال النبي صلى الله عليه وسلم أيما امرئ اشتهى شهوة فرد شهوته وآثر على نفسه غفر له (1) حديث عائشة ما شبع رسول الله صلى الله عليه وسلم ثلاثة أيام متواليات ولو شئنا لشبعنا ولكنا كنا نؤثر على أنفسنا أخرجه البيهقي في الشعب بلفظ ولكنه كان يؤثر على نفسه وأول الحديث عند مسلم بلفظ ما شبع رسول الله صلى الله عليه وسلم ثلاثة أيام تباعا من خبز بر حتى مضى لسبيله وللشيخين ما شبع آل محمد منذ قدم المدينة ثلاثة ليال تباعا حتى قبض زاد مسلم من طعام ونزل برسول الله ص","english":"And one day he went out intending to visit the Caliph al-Mahdī, and a woman of his household said to him: \"What do I get from you if you return with the gift?\" He said: \"If I am given one hundred thousand, I shall give you one dirham.\" So he was given sixty thousand, and he gave her four dānaqs (a fraction of a dirham).","book_title":"Condemnation of Miserliness and Love of Wealth","section_title_ar":"Section 775","section_title_en":"The Explanation of Altruism (Īthār) and Its Excellence","section_index":775,"anchors":"- Root: أ ث ر (Athara)\n  * Lisan / Ayn: Core meaning of precedence, choosing one thing over another; īthār is the act of preferring another over oneself.\n  * Al-Raghib (Mufradat): Theological nuance — īthār is the highest degree of generosity (sakhāʾ), the voluntary preference of another despite one's own need; it is the station of the Companions praised in the Qur'an.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — giving precedence; metaphorical (majāz) — the soul's inclination away from self-interest toward the welfare of others, even at personal cost.\n- Root: س خ و (Sakhuwa)\n  * Lisan / Ayn: Core meaning of liberality, open-handedness; sakhaʾ is the disposition of giving freely.\n  * Al-Raghib (Mufradat): Sakhāʾ is the mean between extravagance and miserliness; its perfection is īthār.\n  * Al-Zamakhshari (Asas): Literal — expending what one does not need; metaphorical — expending what one needs, which is the peak of generosity.\n- Root: ب خ ل (Bakhila)\n  * Lisan / Ayn: Core meaning of withholding, miserliness; bukhl is the vice opposed to sakhaʾ.\n  * Al-Raghib (Mufradat): \"البخل: إمساك المقتنيات عما لا يحق حبسها عنه\" — withholding possessions from what it is not right to withhold them from; its extreme form is withholding from oneself despite need.\n  * Al-Zamakhshari (Asas): Literal — withholding wealth; metaphorical — the miser's soul withholds even from itself, as in the anecdote of the sick miser who refuses medicine due to its price.\n- Root: ض ي ف (Dayf)\n  * Lisan / Ayn: Core meaning of inclining, leaning toward; dayf is the guest who inclines toward a host.\n  * Al-Raghib (Mufradat): \"أصل الضيف الميل\" — the guest is one who leans toward you, seeking hospitality; the root carries the sense of inclination and approach.\n  * Al-Zamakhshari (Asas): Literal — one who inclines toward a place or person; metaphorical — the guest as one to whom hospitality is owed, and the host's act of turning toward the guest's need.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — used in the author's framing \"إنما السخاء عبارة عن...\" to restrict the definition of generosity to its precise scope, and in the hadith \"ما شبع آل محمد...\" to emphasize the continuous state of the Prophet's household.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Miserliness and Love of Wealth'","badge":"Hadith"},{"arabic":"لهم حرمتهم وأوصيه بالأنصار خيرا الذين تبوءوا الدار والإيمان من قبلهم أن يقبل من محسنهم وأن يعفو عن مسيئهم وأوصيه بأهل الأمصار خيرا فإنهم ردء الإسلام وجباة الأموال وغيظ العدو وأن لا يأخذ منهم إلا فضلهم عن رضا منهم وأوصيه بالأعراب خيرا فإنهم أصل العرب ومادة الإسلام وأن يأخذ من حواشي أموالهم ويرد على فقرائهم وأوصيه بذمة الله عز وجل وذمة رسول الله صلى الله عليه وسلم أن يوفى لهم بعهدهم وأن يقاتل لهم من وراءهم ولا يكلفهم إلا طاقتهم قال فلما قبض خرجنا به فانطلقنا نمشي فسلم عبد الله بن عمر وقال يستأذن عمر بن الخطاب فقالت أدخلوه","english":"[ʿUmar (may Allah be pleased with him) said:] \"ʿUmar conveys to you the greeting of peace, and do not say 'Commander of the Faithful,' for today I am not a commander over the believers. Rather, say: 'ʿUmar ibn al-Khaṭṭāb seeks permission to be buried alongside his two companions.'\"","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1304","section_title_en":"The Death of ʿUmar ibn al-Khaṭṭāb (May Allah Be Pleased with Him) — Section 1304","section_index":1304,"anchors":"- Root: عمر (ʿ-m-r)\n  * Lisan / Ayn: Core meaning of \"living/peopling\" a land; ʿumr = the duration of life that \"peoples\" the body.\n  * Al-Raghib (Mufradat): ʿUmr is the span of bodily vitality, distinct from eternal subsistence (baqāʾ); used here as the proper name ʿUmar.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage as a personal name; no metaphorical transfer in this context.\n- Root: أذن (ʾ-dh-n)\n  * Lisan / Ayn: Listening, then granting permission; istiʾdhān = seeking leave to enter.\n  * Al-Raghib (Mufradat): Permission as a legal-religious act of authorization (idhn), tied to obedience.\n  * Al-Zamakhshari (Asas): Literal usage for entry permission; metaphorical extension to \"permission to rule\" in the succession narrative.\n- Root: وصى (w-ṣ-y)\n  * Lisan / Ayn: To enjoin, command, or bequeath; waṣiyyah = testamentary instruction.\n  * Al-Raghib (Mufradat): In theological context, waṣiyyah denotes binding counsel regarding communal duties (rights of others, caliphal obligations).\n  * Al-Zamakhshari (Asas): Literal for \"testament\"; metaphorical for \"moral charge\" passed to the successor.\n- Sibawayh Rule: Interposition of the subject between the verb and its object (al-faṣl bayn al-ʿāmil wa al-maʿmūl) — e.g., \"قال يقرأ عليك عمر السلام\" where the quoted speech is interposed for narrative clarity, permissible when the clause is self-sufficient.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'","badge":"Hadith"}],"10":[{"arabic":"وثبت أقدامنا وانصرنا على القوم الكافرين ربنا اغفر لنا ولإخواننا الذين سبقونا بالإيمان ولا تجعل في قلوبنا غلا للذين آمنوا ربنا إنك رؤوف رحيم ربنا آتنا من لدنك رحمة وهيئ لنا من أمرنا رشدا ربنا آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار ربنا إننا سمعنا مناديا ينادي للإيمان إلى قوله عز وجل إنك لا تخلف الميعاد ربنا لا تؤاخذنا إن نسينا أو أخطأنا ربنا إلى آخر السورة (3) رب اغفر لي ولوالدي وارحمهما كما ربياني صغيرا واغفر للمؤمنين والمؤمنات والمسلمين والمسلمات الأحياء منهم والأموات (4) رب اغفر وارحم وتجاوز عما تعلم وأنت الأعز الأكرم وأنت خير الراحمين وأنت خير الغافرين وإنا لله وإنا","english":"And employ me in righteous deeds which You will accept from me. (1) O God, I ask You for pardon, well-being, good certainty, and soundness in this world and the next. (2) O You Whom sins do not harm and from Whom forgiveness does not diminish anything — grant me that which will not harm You, and give me that which will not diminish You. Our Lord, pour upon us patience and cause us to die as Muslims. You are our Protector in this world and the next; cause me to die as a Muslim and join me with the righteous. You are our Protector, so forgive us and have mercy upon us, and You are the Best of forgivers. And write for us good in this world and in the Hereafter — indeed, we have turned to You in repentance. Our Lord, upon You we rely, to You we turn in repentance, and to You is the final return. Our Lord, make us not a trial for the wrongdoing people. Our Lord, make us not a trial for those who disbelieve, and forgive us, our Lord — indeed, You are the Mighty, the Wise. Our Lord, forgive us our sins and our excesses in our affairs, make firm our feet, and grant us victory over the disbelieving people. Our Lord, forgive us and our brothers who preceded us in faith, and place not in our hearts any rancor toward those who believe — our Lord, indeed You are Kind, Merciful. Our Lord, grant us from Yourself mercy and prepare for us from our affair right guidance. Our Lord, give us good in this world and good in the Hereafter, and protect us from the chastisement of the Fire. Our Lord, indeed we have heard a caller calling to faith — to His saying, Mighty and Majestic: {«إنك لا تخلف الميعاد»} [آل عمران/ 194] — Our Lord, do not take us to task if we forget or err. Our Lord, to the end of the surah. (3) My Lord, forgive me and my parents, and have mercy upon them as they raised me when I was small; and forgive the believing men and the believing women, and the Muslim men and the Muslim women, the living among them and the dead. (4) My Lord, forgive, have mercy, and overlook what You know — and You are the Most Exalted, the Most Generous, the Best of the merciful, and the Best of the forgivers. And indeed, to God we belong and to Him we return; and there is no might and no power except through God, the Exalted, the Magnificent; and God suffices us, and He is the Best Disposer of affairs. And may God send blessings upon Muhammad, the Seal of the Prophets, and upon his family and his companions, and grant them abundant peace. (5)","book_title":"On Invocations and Supplications","section_title_ar":"Section 252","section_title_en":"Section 252 — Supplications for Morning and Evening: Comprehensive Prayers of the Prophet (ﷺ)","section_index":252,"anchors":"- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core meaning of swallowing/ingesting (iltihām); from this derives the sense of something being cast directly into the innermost recess of the heart (al-rawʿ).\n  * Al-Raghib (Mufradat): \"الإلهام: إلقاء الشيء في الروع\" — ilhām is the casting of a thing into the innermost consciousness, specifically from God or the higher assembly (al-malaʾ al-aʿlā). It is that which the Prophet (ﷺ) called \"the touch of the angel\" (limat al-malak) and \"the breath of the Holy Spirit in my innermost heart\" (nafth rūḥ al-qudus fī rawʿī).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ألهمه الله الخير: ألقاه في روعه\" — God inspired him with good: He cast it into his innermost consciousness. Metaphorical (majāz): A horse that \"swallows the ground\" (yaltaḥimu al-arḍ) in swiftness; thus ilhām is the swift, direct ingress of divine guidance into the soul without intermediary effort.\n- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: The root denotes praise arising from recognition of voluntary excellence and beneficence; al-ḥamd is commendation of the beloved for their attributes and acts of goodness.\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence (niʿmah) with reverence and love; it is distinguished from mere thanks (shukr) in that it is directed to the essence and attributes of the praised one, not solely to the benefit received.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — I praise God with all His praiseworthy attributes. Metaphorical: \"أحمدت صنيعه\" — I found his deed praiseworthy; thus the tongue's praise must be matched by the heart's recognition of the praised one's perfection.\n- Root: غفر (gh-f-r)\n  * Lisan / Ayn: The root denotes covering and shielding; al-mighfar is the helmet that protects the head in battle.\n  * Al-Raghib (Mufradat): \"الغفر: إلباس ما يصونه عن الدنس\" — Forgiveness is the clothing of that which shields from filth. God's forgiveness (maghfirah) is His shielding of the servant from the touch of chastisement, covering the sin so that it is as though it never were.\n  * Al-Zamakhshari (Asas): Literal: \"اللهم غفرًا\" — O God, forgive. Metaphorical: The she-beasts that \"did not forgive\" their heedlessness (lam taghfir la-hā ghaflātuhā) — i.e., they did not shield their young from destruction; thus forgiveness is active protection, not mere erasure.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which breathes and has vital spirit; also used for the very essence of a thing.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul is the spirit; and in God's saying {«ويحذركم الله نفسه»} [آل عمران/ 28], \"His Self\" means His very essence (dhāt), which — though grammatically expressed as an annexation implying distinction — is in reality identical, with no multiplicity in the Divine Essence.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس\" — a precious thing. Metaphorical: \"دفق نفسه\" — he poured out his blood/life; thus nafs is the seat of life, passion, and moral responsibility.\n- Sibawayh Rule: باب الدعاء والخبر (The Chapter of Supplication and Assertion) — Supplications (duʿāʾ) are grammatically constructed as optative sentences (inshāʾ ṭalabī) using the imperative (rabbighfir), the jussive (lā tuʾākhidhnā), and the vocative (rabbanā), yet they may embed assertive clauses (khabar) of praise (al-ḥamdu lillāh) and attestation (lā ilāha illā anta). The periodic structure of these prayers alternates between direct address to God (munādāh) and self-referential confession, requiring the translator to preserve the vocative force of \"O God\" and \"Our Lord\" without flattening into mere description.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'","badge":"Hadith"},{"arabic":"اللهم اغفر للمهاجرين والأنصار واغفر لنا ولإخواننا الذين سبقونا بالإيمان اللهم لا تجعله آخر العهد من قبر نبيك ومن حرمك يا أرحم الراحمين ثم يأتي الروضة فيصلي فيها ركعتين ويكثر من الدعاء ما استطاع لقوله صلى الله عليه وسلم","english":"I say: The Prophet ﷺ said: \"Whoever visits me after my death, it is as though he visited me during my life.\" {من زارني بعد وفاتي فكأنما زارني في حياتي}","book_title":"Mysteries of Hajj","section_title_ar":"Section 210","section_title_en":"Section 210 — The Etiquette of Visiting the Prophet's Mosque and Grave in Medina","section_index":210,"anchors":"- Root: زور (z-w-r)\n  * Lisan / Ayn: Core meaning of inclining toward, visiting, or intending a place or person; the visitor (zā'ir) is one who turns away from his own affairs toward another.\n  * Al-Raghib (Mufradat): In theological context, ziyārah (visitation) of the Prophet ﷺ after death is an act of spiritual devotion (taqarrub), not a mere physical journey; its reward is tied to the sincerity of intention (niyyah).\n  * Al-Zamakhshari (Asas): Literal (haqīqah) usage denotes physical approach; metaphorical (majāz) usage extends to seeking intercession (shafā'ah) and spiritual connection with the visited.\n- Root: سلم (s-l-m)\n  * Lisan / Ayn: Root denotes safety, peace, and deliverance from harm; the greeting \"al-salāmu ʿalaykum\" is a prayer for the recipient's immunity from all deficiency.\n  * Al-Raghib (Mufradat): The greeting upon the Prophet ﷺ is a form of supplication (duʿā') and acknowledgment of his rank; it is also a renewal of the covenant (mīthāq) of obedience.\n  * Al-Zamakhshari (Asas): Literal usage is the exchange of safety; metaphorical usage in the visitation context signifies the visitor's submission and the Prophet's reciprocal blessing.\n- Root: شفع (sh-f-ʿ)\n  * Lisan / Ayn: Root denotes pairing or joining; shafā'ah (intercession) is the act of the intercessor joining his own plea to that of the petitioner.\n  * Al-Raghib (Mufradat): In Kalam, shafā'ah is a divinely granted honor (karāmah) to the Prophet ﷺ, conditional upon divine will; it is not an independent power but a mediated mercy.\n  * Al-Zamakhshari (Asas): Literal: making a number even by adding one; metaphorical: the intercessor's elevation of the petitioner's rank before the king.\n- Sibawayh Rule: Rule of Prepositional Interposition (al-faṣl bayna al-jār wa al-majrūr) — The text employs extended vocative and prepositional structures (e.g., \"al-salāmu ʿalayka yā Rasūl Allāh\") where the syntactic pause after each invocation is permissible and rhetorically deliberate, mirroring the classical allowance for separation between the governing particle and its object for emphasis.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Mysteries of Hajj'","badge":"Afterlife"}],"13":[{"arabic":"قال تعالى {لأنتم أشد رهبة في صدورهم من الله} الآية فأحال قلة خوفهم من الله واستعظامهم سطوة الخلق على قلة الفقه فانظر إن كان ذلك نتيجة عدم الحفظ لتفريعات الفتاوى أو هو نتيجة عدم ما ذكرناه من العلوم وقال صلى الله عليه وسلم علماء فقهاء (1) للذين وفدوا عليه وسئل سعد بن إبراهيم الزهري رحمه الله أي أهل المدينة أفقه فقال أتقاهم لله تعالى فكأنه أشار إلى ثمرة الفقه والتقوى ثمرة العلم الباطني دون الفتاوى والأقضية وقال صلى الله عليه وسلم ألا أنبئكم بالفقيه كل الفقيه قالوا بلى قال من لم يقنط الناس من ر","english":"They have manipulated this term through specification (takhṣīṣ), not through transfer (naql) or conversion (taḥwīl), for they have restricted it to knowledge of obscure legal branches (furūʿ gharībah) in legal opinions (fatāwā), to grasping the subtleties of their underlying causes (ʿilal), to multiplying discourse concerning them, and to memorizing the doctrinal positions related to them. Whoever is more profound in this and more occupied with it is called \"the most learned in fiqh\" (al-afqah). Yet in the first era, the name fiqh was applied absolutely to knowledge of the path of the Hereafter, to knowing the subtleties of the maladies of the souls (āfāt al-nufūs), to the corrupters of deeds (mufsidāt al-aʿmāl), to the power of encompassing the pettiness of this world, to intense longing for the bliss of the Hereafter, and to the dominance of fear over the heart. What indicates this to you is His saying, Mighty and Majestic: {«ليتفقهوا في الدين ولينذروا قومهم إذا رجعوا إليهم»} [“That they may gain understanding in the religion and warn their people when they return to them”] (Q 9:122). What effects warning and intimidation is this very fiqh — not the subdivisions of divorce (ṭalāq), manumission (ʿitāq), imprecation (liʿān), salam contracts, and leases (ijārah). For that (latter) does not produce warning or intimidation; rather, total devotion to it perpetually hardens the heart and strips away godly fear (khashyah) from it, as we now observe in those wholly devoted to it.","book_title":"Book of Knowledge","section_title_ar":"Section 27","section_title_en":"The Revival of the Religious Sciences — Section 27: The Corruption of the Praiseworthy Names (Taḥrīf al-Asāmī al-Maḥmūdah)","section_index":27,"anchors":"- Root: فقه (Fiqh)\n  * Lisan / Ayn: Core linguistic meaning of \"understanding\" (al-fahm) and \"comprehension\" (al-fahm ʿan al-shayʾ)\n  * Al-Raghib (Mufradat): \"Al-fiqh: attainment of knowledge of the unseen through a witnessed sign — it is more specific than ʿilm.\" Theological nuance: true fiqh is knowledge of the heart's maladies and the path to the Hereafter.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"afqih ʿannī mā aqūl\" — understand what I say. Metaphorical (majāz): technical restriction to legal rulings (furūʿ al-fatāwā) is a later convention, not the lexical or prophetic norm.\n- Root: علم (ʿIlm)\n  * Lisan / Ayn: Perception of a thing as it truly is; knowledge of the essence of a thing.\n  * Al-Raghib (Mufradat): Two types: (1) perception of the essence of a thing; (2) judgment upon a thing affirming or negating something of it. The highest ʿilm is knowledge of God, His verses, and His acts.\n  * Al-Zamakhshari (Asas): Literal: \"He is from the banners (aʿlām) of knowledge.\" Metaphorical: restriction of the title \"scholar\" (al-ʿālim) to the dialectician (al-munāẓir) is a corrupt specification (takhṣīṣ fāsid).\n- Root: وحد (Waḥḥada)\n  * Lisan / Ayn: To make one; to affirm unity.\n  * Al-Raghib (Mufradat): Tawḥīd is affirming God's unity in essence, attributes, and acts — the highest degree being the vision that all things proceed from Him alone.\n  * Al-Zamakhshari (Asas): Literal: utterance of \"Lā ilāha illā Allāh.\" Metaphorical: the inner reality (al-lubāb) — seeing all affairs from God, cutting off attention from secondary causes.\n- Sibawayh Rule: باب التخصيص والتقييد (Restriction and Specification) — The corruption of names occurs through takhṣīṣ (semantic restriction), not naql (lexical transfer). The grammarians' principle: a general term (al-ism al-ʿāmm) retains its full semantic range unless a valid sharʿī or linguistic evidence restricts it; arbitrary restriction by custom (ʿādat al-istimāl) is a rhetorical device of the devils among men and jinn.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'","badge":"Insight"}],"16":[{"arabic":"ظل إلا ظله وعد منهم رجل دعته امرأة ذات جمال وحسب إلى نفسها فقال إني أخاف الله رب العالمين (2) وقصة يوسف عليه السلام وامتناعه من زليخا مع القدرة ومع رغبتها معروفة وقد أثنى الله تعالى عليه بذلك في كتابه العزيز وهو إمام لكل من وفق لمجاهدة الشيطان في هذه الشهوة العظيمة وروي أن سليمان بن يسار كان من أحسن الناس وجها فدخلت عليه امرأة فسألته نفسه فامتنع عليها وخرج هاربا من منزله وتركها فيه قال سليمان فرأيت تلك الليلة في المنام يوسف عليه السلام وكأني أقول له أنت يوسف قال نعم أنا يوسف الذي هممت وأنت سليمان الذي لم تهم أشار إلى قوله","english":"...which one is ashamed of and fears to plunge into. And the abstention of most people from its requirements is either due to incapacity, or fear, or shame, or concern for preserving one's body — and in none of these is there any reward, for that is merely preferring one share of one's worldly desires over another share. Yes — from divine protection (al-ʿiṣmah) is that one is not able [to sin]; so in these obstacles there is a benefit, namely the repulsion of sin. For whoever abandons fornication, its sin is repelled from him by whatever cause his abandonment occurred. Rather, the virtue and abundant reward lie in abandoning it out of fear of God — may He be exalted — while possessing the ability, with the removal of obstacles, the facilitation of means, and especially at the height of genuine desire. And this is the station of the veracious (al-ṣiddīqīn). For this reason, the Prophet — peace be upon him — said: \"Whoever loves passionately, then remains chaste, then conceals [his love], then dies — he dies a martyr.\"(1)","book_title":"Harms of the Tongue","section_title_ar":"Section 654","section_title_en":"The Book of Breaking the Two Desires — Section 654: On Chastity, Guarding the Gaze, and the Virtue of Restraining Desire","section_index":654,"anchors":"- **Root: ع ف ف** (ʿaffa)\n  * **Lisan / Ayn**: Core meaning of abstaining from what is unlawful, refraining, and remaining chaste; al-ʿafāf is the state of one who abstains from forbidden things.\n  * **Al-Raghib (Mufradat)**: Theological nuance — ʿiffah (chastity) is a virtue of the soul that restrains the appetitive faculty from pursuing what is not permissible; it is a station of the ṣiddīqūn (veracious ones).\n  * **Al-Zamakhshari (Asas)**: Literal (ḥaqīqah) — physical abstention from unlawful acts; Metaphorical (majāz) — the heart's abstention from coveting what God has forbidden, which is the higher reality of chastity.\n\n- **Root: غ ب ق** (ghabaqa)\n  * **Lisan / Ayn**: The evening drink (al-ghabūq) — the milking or drink given at nightfall; contrasted with al-ṣabūḥ (the morning drink).\n  * **Al-Raghib (Mufradat)**: In the hadith of the three men in the cave, the term marks the temporal precision of filial devotion — serving parents before any other claim, even at the boundary of night.\n  * **Al-Zamakhshari (Asas)**: Literal — the evening milking; the narrative use in the hadith is literal, denoting the exact act of service delayed out of reverence.\n\n- **Root: ه م م** (hamma)\n  * **Lisan / Ayn**: To intend, to resolve upon a matter; al-hamm is the initial stirring of intention before full determination.\n  * **Al-Raghib (Mufradat)**: In Q. 12:24 {«وَلَقَدْ هَمَّتْ بِهِ وَهَمَّ بِهَا لَوْلَا أَنْ رَأَى بُرْهَانَ رَبِّهِ»} — \"And certainly she desired him, and he would have desired her, had it not been that he saw the proof of his Lord\" — the term distinguishes between a passing inclination (hamm) and a settled resolve; Yūsuf's hamm was repelled by divine proof, while Zulaykhā's was consummated in action.\n  * **Al-Zamakhshari (Asas)**: Literal — the inward movement of intention; the rhetorical force lies in the contrast between the two hamm-s, one punished and one pardoned.\n\n- **Root: ن ظ ر** (naẓara)\n  * **Lisan / Ayn**: To look, to gaze; al-naẓar is the act of sight, whether physical or intellectual.\n  * **Al-Raghib (Mufradat)**: The gaze (naẓar) is the gateway to desire; the Quranic phrase {«يَعْلَمُ خَائِنَةَ الْأَعْيُنِ»} — \"He knows the treachery of the eyes\" (Q. 40:19) — indicates that the look which steals toward the forbidden is itself an act of betrayal recorded by God.\n  * **Al-Zamakhshari (Asas)**: Literal — the first glance that occurs unintentionally; Metaphorical — the second glance is the \"treachery of the eyes,\" for it is a deliberate return to what the first glance stumbled upon by accident.\n\n- **Root: ر و د** (rāwada)\n  * **Lisan / Ayn**: To seek, to desire, to solicit; murāwadah is the act of soliciting someone for an unlawful purpose.\n  * **Al-Raghib (Mufradat)**: In the Yūsuf narrative, murāwadah denotes the persistent solicitation toward sin; the term carries the weight of repeated, deliberate pursuit.\n  * **Al-Zamakhshari (Asas)**: Literal — the physical act of solicitation; the narrative contexts in this section use the term literally for the woman's pursuit of the young man.\n\n- **Sibawayh Rule**: **Bāb al-ḥaṣr wa-l-taqyīd bi-innamā** (Restriction and Focused Predication with innamā)\n  * The particle innamā restricts and confines the predicate to the subject alone, negating all else. In the woman's statement \"innamā urīdu mā yakūnu min al-rajuli ilā ahlihī\" — \"I only desire what comes from a man to his wife\" — the restriction (ḥaṣr) intensifies the gravity of the solicitation, making the young man's resistance all the more virtuous.\n\n---\n\n##","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Harms of the Tongue'","badge":"Hadith"},{"arabic":"إني بريء منك فهو الذي قال الله تعالى فيه {كمثل الشيطان إذ قال للإنسان اكفر فلما كفر قال إني بريء منك} (2) حديث من حام حول الحمى يوشك أن يقع فيه متفق عليه من حديث النعمان ابن بشير من يرتع حول الحمى يوشك أن يواقعه لفظ البخاري","english":"A man said to al-Ḥasan: \"O Abū Saʿīd, does Satan sleep?\" He smiled and said: \"If he slept, we would find rest.\"","book_title":"Disciplining the Soul","section_title_ar":"Section 599","section_title_en":"Section 599 — The Inevitable Struggle Against Satan and the Parable of the Monk","section_index":599,"anchors":"- Root: شيط (Shayṭ)\n  * Lisan / Ayn: Core root denotes burning, scorching, or spoiling by fire; also one who is destroyed or wasted.\n  * Al-Raghib (Mufradat): الشيطان refers to the rebellious one who is consumed by pride and enmity, ever-present as an adversary to the human soul.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) — burning or spoiling meat; Metaphorical (Majaz) — \"شاط دمه\" (his blood was wasted), i.e., one who is ruined or led astray, as Satan wastes the soul's integrity.\n- Root: قلب (Qalb)\n  * Lisan / Ayn: The heart as the seat of turning, overturning, and transformation.\n  * Al-Raghib (Mufradat): قلب الشيء: تصريفه وصرفه عن وجه إلى وجه — the turning of a thing from one state to another; the heart is so named for its constant fluctuation and receptivity to divine or satanic influence.\n  * Al-Zamakhshari (Asas): Literal — turning a thing over; Metaphorical — the heart as the battlefield where Satan's doors open and close, requiring vigilant guardianship.\n- Root: جهد (Jahd)\n  * Lisan / Ayn: Exertion, struggle, or striving to the utmost limit.\n  * Al-Raghib (Mufradat): المجاهدة: بذل الوسع في مدافعة العدو — expending one's full capacity in repelling the enemy, whether outward or inward.\n  * Al-Zamakhshari (Asas): Literal — physical combat; Metaphorical — the soul's warfare against base desires, a struggle with no cessation while life remains.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the clause remains coherent, as in the conditional structures here, where the apodosis (جواب الشرط) is delayed for rhetorical emphasis.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Disciplining the Soul'","badge":"Hadith"}],"18":[{"arabic":"أما الفضيلة فقد قال الله تعالى {يا أيها الذين آمنوا اتقوا الله ولتنظر نفس ما قدمت لغد} وهذه إشارة إلى المحاسبة على ما مضى من الأعمال ولذلك قال عمر رضي الله تعالى عنه حاسبوا أنفسكم قبل أن تحاسبوا وزنوها قبل أن توزنوا وفي الخبر انه عليه السلام جاءه رجل فقال يا رسول الله أوصنى فقال أمستوص أنت فقال نعم قال إذا هممت بأمر فتدبر عاقبته فإن كان رشدا فامضه وإن كان غيا فانته عنه وفي الخبر وينبغى للعاقل أن يكون له أربع ساعات ساعة يحاسب فيها نفسه وقال تعالى {وتوبوا إلى الله جميعا أيها المؤمنون لعلكم تفلحون} والتوبة نظر في الفعل بعد","english":"As for its virtue, God most high has said: {«يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَلْتَنْظُرْ نَفْسٌ مَا قَدَّمَتْ لِغَدٍ»} (O you who believe, fear God, and let every soul look to what it has sent forward for the morrow) — and this is an allusion to reckoning over past deeds. For this reason, ʿUmar — may God most high be pleased with him — said: \"Call yourselves to account before you are called to account, and weigh yourselves before you are weighed.\" And in the report, a man came to him — peace be upon him — and said: \"O Messenger of God, counsel me.\" He said: \"Are you asking for counsel?\" He replied: \"Yes.\" He said: \"When you resolve upon a matter, then ponder its consequence: if it be right guidance, proceed with it; and if it be error, desist from it.\" And in the report: \"It behooves the intelligent man to have four hours: an hour in which he calls himself to account.\" And God most high said: {«وَتُوبُوا إِلَى اللَّهِ جَمِيعًا أَيُّهَا الْمُؤْمِنُونَ لَعَلَّكُمْ تُفْلِحُونَ»} (And turn in repentance to God all together, O believers, that you might succeed) — and repentance is a scrutiny of the deed after its completion, through regret over it. And he — peace be upon him — said: \"Verily I seek forgiveness from God most high and turn to Him in repentance a hundred times a day.\" And God most high said: {«إِنَّ الَّذِينَ اتَّقَوْا إِذَا مَسَّهُمْ طَائِفٌ مِنَ الشَّيْطَانِ تَذَكَّرُوا فَإِذَا هُمْ مُبْصِرُونَ»} (Verily those who fear God, when a whisper from Satan touches them, they remember — and behold, they are seeing clearly). And it is related of ʿUmar — may God be pleased with him — that he would strike his own feet with a whip when night fell upon him, saying to himself: \"What have you done today?\" And it is related of Maymūn ibn Mihrān that he said: \"A servant does not become one of the God-fearing until he calls himself to account more severely than he would his partner — and two partners reckon with each other after the work.\" And it is narrated from ʿĀʾishah — may God most high be pleased with her — that Abū Bakr — God's good pleasure be upon him — said to her at death: \"There is no one among mankind more beloved to me than ʿUmar.\" Then he said to her: \"How did I put it?\" So she repeated to him what he had said, whereupon he said: \"There is no one more honored by me than ʿUmar.\"","book_title":"Monitoring and Accounting","section_title_ar":"Section 1238","section_title_en":"The Third Watch: Self-Reckoning After Deeds — Its Virtue and Its Reality","section_index":1238,"anchors":"- Root: ح س ب (ḥ-s-b)\n  * Lisan / Ayn: Core meaning of counting, reckoning, and sufficient estimation; al-ḥisāb is the act of numbering and settling accounts.\n  * Al-Raghib (Mufradat): Theological nuance: muḥāsabah is the soul's voluntary audit of its deeds against divine command, prefiguring the eschatological reckoning (ḥisāb) by God.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): arithmetic counting; Metaphorical (majāz): self-interrogation and weighing of one's actions, as in \"ḥāsaba nafsahu\" (he called his soul to account).\n- Root: ن ظ ر (n-ẓ-r)\n  * Lisan / Ayn: To look, consider, reflect; naẓar implies deliberate examination with the eye or intellect.\n  * Al-Raghib (Mufradat): Theological nuance: taḍabbur (deep reflection) on consequences of actions, aligning sight with insight (baṣīrah).\n  * Al-Zamakhshari (Asas): Literal: physical gazing; Metaphorical: intellectual deliberation and foresight, as in \"tadabbar al-amr\" (he pondered the matter).\n- Root: ن ف س (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that which breathes and possesses volition.\n  * Al-Raghib (Mufradat): Theological nuance: al-nafs al-lawwāmah (the blaming soul) is the conscience that reproaches its owner for misdeeds, distinct from the corporeal body.\n  * Al-Zamakhshari (Asas): Literal: the animate self; Metaphorical: the inner tribunal where the soul is both accused and judge.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (باب الحصر والتقييد) — Constructions like \"إنما\" and conditional clauses (idhā... fa-) establish causal sequencing, as in \"if a whim touches them, they remember\" — the protasis governs the apodosis, binding reflection to action.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'","badge":"Insight"},{"arabic":"وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال","english":"The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.","book_title":"Duties of Brotherhood","section_title_ar":"Section 175","section_title_en":"The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)","section_index":175,"anchors":"- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'","badge":"Insight"}],"19":[{"arabic":"ومهما فعل ذلك فقد ظلم نفسه إذ قيل له ولا تكونوا كالذين نسوا الله فأنساهم أنفسهم أولئك هم الفاسقون أي الخارجون عن مقتضى طبعهم ومظنة استحقاقهم يقال فسقت الرطبة عن كمامها إذا خرجت عن معدنها الفطري وهذه إشارة إلى أسرار يهتز لاستنشاق روائحها العارفون وتشمئز من سماع ألفاظها القاصرون فإنها تضر بهم كما تضر رياح الورد بالجعل وتبهر أعينهم الضعيفة كما تبهر الشمس أبصار الخفافيش وانفتاح هذا الباب من سر القلب إلى عالم الملكوت يسمى معرفة وولاية ويسمى صاحبه وليا وعارفا وهي مبادي مقامات الأنبياء وآخر مقامات الأولياء أول مقامات الأنبياء ولنرجع إلى الغرض المطلوب","english":"Rather, the world is two worlds: the world of Command (ālam al-amr) and the world of Creation (ālam al-khalq). And to God belongs the Creation and the Command {«ألا له الخلق والأمر»} (Q. 7:54). For bodies — those possessing quantity (kammiyyah) and magnitudes (maqādīr) — belong to the world of Creation, since \"creation\" (khalq) in linguistic usage is an expression for measuring and determining (taqdīr). And every existent that is exalted above quantity and magnitude belongs to the world of Command. The explanation of this is the secret of the Spirit (sirr al-rūḥ), and there is no license to divulge it, because of the harm most creatures would suffer upon hearing it — like the breaking of the vessel (kasr al-qidr) which prevented its contents from being spilled abroad.","book_title":"Condemnation of Delusion","section_title_ar":"Section 886","section_title_en":"The Two Worlds: The World of Command and the World of Creation — On the Spirit, Self-Knowledge, and the Delusion of the World","section_index":886,"anchors":"- Root: امر (amr)\n  * Lisan / Ayn: Command, affair, matter; al-amr as divine imperative opposed to al-khalq (creation).\n  * Al-Raghib (Mufradat): Amr denotes the divine word of fiat (kun) by which things exist without mediate causation, contrasted with khalq as measured, quantified formation.\n  * Al-Zamakhshari (Asas): Haqiqah — amr is the unquantified, unmeasured divine decree; majaz would be applying it to corporeal extension.\n- Root: قدر (qadr)\n  * Lisan / Ayn: Measuring, determining, apportioning; al-taqdir is the assignment of quantity and limit.\n  * Al-Raghib (Mufradat): Khalq is taqdir — the imposition of quantity and magnitude upon bodies; what is exempt from quantity belongs to the world of amr.\n  * Al-Zamakhshari (Asas): Haqiqah — taqdir as delimitation; majaz — the \"measure\" of destiny as divine ordainment.\n- Root: فسق (fsq)\n  * Lisan / Ayn: To emerge, to exit; said of a ripe date (rutabah) bursting from its sheath (kimam).\n  * Al-Raghib (Mufradat): Fusuq is departure from the straight path — exiting one's natural, primordial locus (ma'din).\n  * Al-Zamakhshari (Asas): Haqiqah — physical emergence from a covering; majaz — moral transgression as deviation from innate disposition.\n- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Negligence, heedlessness; the white blaze on a horse's forehead; being deceived while unaware.\n  * Al-Raghib (Mufradat): Ghurur is delusion that seizes one in a state of ghaflah (unawareness), as in {«ما غرك بربك الكريم»} (Q. 82:6).\n  * Al-Zamakhshari (Asas): Haqiqah — the gazelle deceived by moonlight; majaz — the soul deceived by worldly allurements into false security.\n- Sibawayh Rule: باب الفصل بين المبتدأ والخبر (Interposition between Subject and Predicate) — Long periodic sentences with parenthetical clarifications (e.g., \"بل العالم عالمان...\") require the predicate to be held in suspense, mirroring the rhetorical deferral of meaning until the full contrast is established.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Delusion'","badge":"Insight"},{"arabic":"وفيه فهو ممن قال الله تعالى فيه نسوا الله فأنساهم أنفسهم أولئك هم الفاسقون فمعرفة القلب وحقيقة أوصافه أصل الدين وأساس طريق السالكين وإذ فرغنا من الشطر الأول من هذا الكتاب من النظر فيما يجري على الجوارح من العبادات والعادات وهو العلم الظاهر ووعدنا أن نشرح في الشطر الثاني ما يجري على القلب من الصفات المهلكات والمنجيات وهو العلم الباطن فلا بد أن نقدم عليه كتابين كتابا في شرح عجائب صفات القلب وأخلاقه وكتابا في كيفية رياضة القلب وتهذيب أخلاقه ثم نندفع بعد ذلك في تفصيل المهلكات والمنجيات فلنذكر الآن من شرح","english":"And whoever does not know his heart so as to watch over it, to tend it, and to lie in wait for what shines upon it and within it from the treasuries of the Dominion (malakūt) — he is among those of whom God, exalted, said: {«They forgot God, so He caused them to forget their selves; those are the wicked»} (Q 59:19). So the knowledge of the heart and the reality of its attributes is the root of religion and the foundation of the path of the wayfarers.","book_title":"Disciplining the Soul","section_title_ar":"Section 572","section_title_en":"The Exposition of His Miracles and Signs Indicating His Truthfulness — Being the Opening of the Book on the Marvels of the Heart, the First Book of the Quarter of the Destroyers","section_index":572,"anchors":"- Root: قلب (q-l-b)\n  * Lisan / Ayn: Core meaning of turning, overturning, and revolving a thing from one face to another; the heart as that which is perpetually turned about between states.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is that which is constantly diverted and turned; its very essence is fluctuation and transformation, making it the seat of divine turning (taqlīb).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): turning a thing over; metaphorical (majāz): \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters about. Here, the heart's turning between the two fingers of the Merciful is a metaphorical extension of this root meaning.\n- Root: جهل (j-h-l)\n  * Lisan / Ayn: Ignorance as the absence of knowledge; also foolish conduct.\n  * Al-Raghib (Mufradat): \"الجهل على ثلاثة أضرب\" — threefold: (1) the soul's emptiness of knowledge (the original sense), (2) belief contrary to what a thing actually is, (3) acting contrary to what a thing's right requires. The third sense applies here: \"whoever is ignorant of his heart is more ignorant of other things.\"\n  * Al-Zamakhshari (Asas): Literal: lack of knowledge; metaphorical: \"استجهلت الريح الغصن\" — the wind made the branch move violently, i.e., rendered it unsteady. The ignorant man is one whose movements are ungoverned by knowledge.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that by which a thing is valued.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the self as the immaterial reality of the human; \"وإذ فرغنا\" — the self is the referent of divine address and the locus of self-knowledge which leads to knowledge of God.\n  * Al-Zamakhshari (Asas): Literal: the soul/spirit; metaphorical: \"دفق نفسه أي دمه\" — the self as the whole person. Here, \"knowing oneself\" (maʿrifat al-nafs) is the path to knowing one's Lord.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The repeated use of \"إنما\" (only/indeed) throughout the opening establishes exclusive predication: the heart alone is the knower of God, the limbs are merely followers and instruments. This restrictive construction is deliberate and carries theological weight.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'","badge":"Insight"}],"21":[{"arabic":"تعالى {لو أنزلنا هذا القرآن على جبل لرأيته خاشعا متصدعا من خشية الله} فالوجل والخشوع وجد من قبيل الأحوال وإن لم يكن من قبيل المكاشفات ولكن قد يصير سببا للمكاشفات والتنبيهات ولهذا قال صلى الله عليه وسلم زينوا القرآن بأصواتكم (3) وقال لأبي موسى الأشعري لقد أوتى مزمارا من مزامير آل داود عليه السلام (1) وأما الحكايات الدالة على أن أرباب القلوب ظهر عليهم الوجد عند سماع القرآن فكثيرة فقوله صلى الله عليه وسلم شيبتني هود وأخواتها (2) خبر عن الوجد فإن الشيب يحصل من الحزن والخوف وذلك وجد وروي أن","english":"**QUAD_ANCHORS:**\n- Root: وجد (Wajd)\n  * Lisan / Ayn: The root وجد encompasses multiple senses: finding/attaining (إدراك), intense love (الحب الشديد), grief (الحزن), and wealth/sufficiency (الغنى). Al-Khalil notes the range: \"الوجد: الحب. والوجد: الحزن. والوجد: الغنى. والوجد: إدراك الشيء\"\n  * Al-Raghib (Mufradat): \"الوجد: إدراك الشيء على خلاف ما يطلب\" — and in the technical terminology of the Sufis: \"ما يصادف القلب من واردات الأحوال\" (what the heart encounters of the influxes of spiritual states)\n  * Al-Zamakhshari (Asas): Literal sense is finding/attaining; metaphorical extension (majāz) in devotional context: \"وجد فلان في العبادة وجدا: إذا أتى بها على وجهها مع حضور القلب\"\n- Root: طبع (Tabʿ)\n  * Lisan / Ayn: \"الطبع: السجية التي جبل عليها الإنسان\" — the innate disposition upon which one is created; also \"الختم\" (sealing)\n  * Al-Raghib (Mufradat): \"الطبع: السجية التي جبل عليها الإنسان\" — the original constitution\n  * Al-Zamakhshari (Asas): Distinguishes \"مطبوع\" (innate/natural) from \"متكلف\" (deliberately acquired) — \"فلان مطبوع على الكرم، ومتكلف له\"\n- Root: كلف (Kulfah/Takalluf)\n  * Lisan / Ayn: \"التكلف: تجشم ما لا يلزمك\" — undertaking what is not incumbent upon you with effort and hardship\n  * Al-Raghib (Mufradat): \"التكلف: تجشم ما ليس من شأنه\" — burdening oneself with what is not one's natural concern\n  * Al-Zamakhshari (Asas): \"تكلفت الأمر: تجشمته على مشقة\" — deliberate self-imposition of effort\n- Root: سمع (Samāʿ)\n  * Lisan / Ayn: Auditory perception; also what is heard — recitation, song, remembrance\n  * Al-Raghib (Mufradat): \"السماع عند الصوفية: ما يهيج الوجد من الأصوات الموزونة\" — that which stirs ecstatic finding from measured sounds\n  * Al-Zamakhshari (Asas): \"السماع عند القوم: حضور مجلس يهيج الأحوال الشريفة\" — attending an assembly that stirs noble spiritual states\n- Root: عشق (ʿIshq)\n  * Lisan / Ayn: \"العشق: فرط الحب\" — excessive love; from \"العشقة\" — a plant that twines around another\n  * Al-Raghib (Mufradat): \"العشق: فرط الحب، وأصله من عشقة النبات وهي ما التف منه على غيره\"\n  * Al-Zamakhshari (Asas): \"العشق مجاز في حق الله تعالى\" — metaphorical when applied to God\n- Root: بكى (Bukāʾ)\n  * Lisan / Ayn: Weeping, shedding tears\n  * Al-Raghib (Mufradat): \"البكاء: إجراء الدمع من عين لحزن أو غيره\"\n  * Al-Zamakhshari (Asas): \"تباكى: تكلف البكاء\" — deliberate self-induced weeping\n- Root: صعق (Ṣaʿq)\n  * Lisan / Ayn: \"الصعق: الغشي. والصعق: الموت\" — swooning/loss of consciousness; death\n  * Al-Raghib (Mufradat): \"الصعق: غشية تعرض من صوت شديد أو هول\"\n  * Al-Zamakhshari (Asas): \"صعق من هول الأمر: إذا غشي عليه من شدة الخوف\"\n- Root: خشع (Khushūʿ)\n  * Lisan / Ayn: \"الخشوع: الخضوع والتذلل\" — humility and submissiveness\n  * Al-Raghib (Mufradat): \"الخشوع: التذلل والخضوع، وقيل: الخشوع في الصوت والبصر، والخضوع في البدن\"\n  * Al-Zamakhshari (Asas): \"خشعت الأصوات: سكنت. وخشع البصر: انكسر\"\n- Root: أنس (Uns)\n  * Lisan / Ayn: \"الأنس: نقيض الوحشة\" — the opposite of loneliness/estrangement\n  * Al-Raghib (Mufradat): \"الأنس: حضور القلب مع المحبوب\" — the heart's presence with the Beloved\n  * Al-Zamakhshari (Asas): \"الأنس بالله: سكون القلب إليه\"\n- Root: وجل (Wajal)\n  * Lisan / Ayn: \"الوجل: الخوف مع اضطراب القلب\" — fear accompanied by cardiac agitation\n  * Al-Raghib (Mufradat): \"الوجل: الخوف مع اضطراب القلب\"\n  * Al-Zamakhshari (Asas): \"الوجل: أشد من الخوف، فإنه مع اضطراب\"\n- Root: طمأن (Ṭumaʾnīnah)\n  * Lisan / Ayn: \"الطمأنينة: السكون\" — tranquility\n  * Al-Raghib (Mufradat): \"الطمأنينة: سكون القلب بعد اضطراب\"\n  * Al-Zamakhshari (Asas): \"اطمأن القلب: سكن بعد اضطراب\"\n- Root: قشعر (Iqshirʿār)\n  * Lisan / Ayn: \"القشعريرة: تقبض الجلد من الخوف\" — contraction of the skin from fear\n  * Al-Raghib (Mufradat): \"الاقشعرار: انقباض الجلد وتقبضه من الخوف\"\n  * Al-Zamakhshari (Asas): \"اقشعر الجلد من الخوف: إذا تقبض\"\n- Root: لين (Līn)\n  * Lisan / Ayn: \"اللين: ضد الخشونة\" — softness, opposite of hardness\n  * Al-Raghib (Mufradat): \"اللين: نقيض الخشونة\"\n  * Al-Zamakhshari (Asas): \"لان قلبه: إذا سكن وخشع\"\n- Root: غشي (Ghashy)\n  * Lisan / Ayn: \"الغشي: الإغماء\" — loss of consciousness\n  * Al-Raghib (Mufradat): \"الغشية: ما يغشى القلب من شدة الوجد\"\n  * Al-Zamakhshari (Asas): \"غشي عليه: إذا أغمي عليه من شدة وجد أو خوف\"\n- Root: زعق (Zaʿq)\n  * Lisan / Ayn: \"الزعق: الصياح الشديد\" — violent screaming\n  * Al-Raghib (Al-Mufradat): \"الزعق: الصياح الشديد\"\n  * Al-Zamakhshari (Asas): \"زعق: صاح بأعلى صوته\"\n- Root: أزيز (Azīz)\n  * Lisan / Ayn: \"الأزيز: صوت النار والمرجل\" — the sound of fire and boiling pot\n  * Al-Raghib (Al-Mufradat): \"الأزيز: صوت النار والمرجل ونحوهما\"\n  * Al-Zamakhshari (Asas): \"أزيز الصدر: صوت يسمع من شدة البكاء والوجد\"\n- Root: شهق (Shahīq)\n  * Lisan / Ayn: \"الشهيق: رد النفس إلى الداخل بصوت\" — drawing breath inward with sound\n  * Al-Raghib (Al-Mufradat): \"الشهيق: رد النفس إلى الداخل بصوت\"\n  * Al-Zamakhshari (Asas): \"شهق الرجل: إذا خرجت نفسه بصوت من شدة الوجد\"\n- Root: حزن (Ḥuzn)\n  * Lisan / Ayn: \"الحزن: ضد السرور\" — grief, opposite of joy\n  * Al-Raghib (Al-Mufradat): \"الحزن: ألم النفس\"\n  * Al-Zamakhshari (Asas): \"الحزن: ألم النفس، وهو مجاز من حزن الأرض\" (metaphorical extension from rough ground)\n- Root: شيب (Shayb)\n  * Lisan / Ayn: \"الشيب: بياض الشعر\" — whitening of hair\n  * Al-Raghib (Al-Mufradat): \"الشيب: بياض الشعر\"\n  * Al-Zamakhshari (Asas): \"شيبتني هود: أي: كبرتني وأحزنتني حتى شاب شعري\"\n- Root: ذرف (Dharf)\n  * Lisan / Ayn: \"الذرف: سيلان الدمع\" — flowing of tears\n  * Al-Raghib (Al-Mufradat): \"ذرفت العين: سال دمعها\"\n  * Al-Zamakhshari (Asas): \"ذرفت عينه: إذا سال دمعها من حزن\"\n- Root: فيض (Fayḍ)\n  * Lisan / Ayn: \"الفيض: سيلان الماء\" — overflowing of water\n  * Al-Raghib (Al-Mufradat): \"الفيض: جريان الماء بكثرة\"\n  * Al-Zamakhshari (Asas): \"فاضت العين بالدمع: سالت. وفاض القلب: امتلأ\"\n- Root: نقر (Naqr)\n  * Lisan / Ayn: \"النقر: الضرب على الشيء حتى يصوت\" — striking something until it sounds\n  * Al-Raghib (Al-Mufradat): \"الناقور: الصور\" — the Trumpet\n  * Al-Zamakhshari (Asas): \"الناقور: الصور الذي ينفخ فيه إسرافيل\"\n- Root: رعش (Riʿshah)\n  * Lisan / Ayn: \"الرعدة: الاضطراب\" — trembling\n  * Al-Raghib (Al-Mufradat): \"الارتعداد: الاضطراب\"\n  * Al-Zamakhshari (Asas): \"ارتعدت فرائصه: اضطربت من شدة الخوف\"\n- Root: فرص (Farīṣah)\n  * Lisan / Ayn: \"الفريصة: لحمة بين الجنب والكتف ترعد عند الفزع\" — the flesh between the side and shoulder blade that trembles at fright\n  * Al-Raghib (Al-Mufradat): \"الفريصة: لحمة بين الجنب والكتف ترعد عند الفزع\"\n  * Al-Zamakhshari (Asas): \"ارتعدت فرائصه: من شدة الخوف\"\n- Root: عما (ʿAmā)\n  * Lisan / Ayn: \"العمى: ذهاب البصر. والعمى: ذهاب البصيرة\" — blindness of sight; blindness of insight\n  * Al-Raghib (Al-Mufradat): \"العمى: آفة في البصر، وقد يستعار لآفة البصيرة\"\n  * Al-Zamakhshari (Asas): \"عمي القلب: ذهبت بصيرته\"\n- Root: أبصر (Abṣara)\n  * Lisan / Ayn: \"البصر: حاسة الرؤية. والبصيرة: العلم\" — sight; insight\n  *Al-Raghib (Al-Mufradat): \"الإبصار: إدراك البصر، وقد يستعار للبصيرة\"\n  * Al-Zamakhshari (Asas): \"أبصر الحق: علمه. ومنه: البصيرة\"\n- Root: كأس (Ka's)\n  * Lisan / Ayn: \"الكأس: القدح إذا كان فيه شراب\" — the cup when it contains drink\n  * Al-Raghib (Al-Mufradat): \"الكأس: الإناء المعروف، وقد يقال لما فيه\"\n  * Al-Zamakhshari (Asas): \"الكأس: القدح إذا كان فيه شراب\"","book_title":"Arrangement of Litanies","section_title_ar":"Section 511","section_title_en":"Section 511","section_index":511,"anchors":"*(Anchors established)*","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Arrangement of Litanies'","badge":"Insight"}],"22":[{"arabic":"منيبا أشهد الله وأشهد ملائكته وأنبيائه ورسله وحملة عرشه ومن خلقه ومن هو خالقه بأنه هو الله الذي لا إله إلا هو وحده لا شريك له وأن محمدا عبده ورسوله صلى الله عليه وسلم وإن الجنة حق وأن النار حق والحوض حق والشفاعة حق ومنكرا ونكيرا حق ووعدك حق ووعيدك حق ولقاءك حق والساعة آتية لا ريب فيها وأن الله يبعث من في القبور على ذلك أحيا وعليه أموت وعليه أبعث إن شاء الله اللهم أنت ربي لا إله إلا أنت خلقتني وأنا عبدك وأنا على عهدك ووعدك ما استطعت أعوذ بك اللهم من شر ما صنعت ومن شر كل ذي شر اللهم إني ظلمت نفسي فاغفر لي ذنوبي فإنه لا يغفر الذنوب إلا","english":"It is narrated that Yūnus ibn ʿUbayd saw a man in a dream — a man who had been killed as a martyr in the lands of the Byzantines — and he said to him: \"What is the most excellent deed that you witnessed?\" He replied: \"I witnessed the glorifications (tasbīḥāt) of Ibn al-Muʿtamir holding a station with Allah, Mighty and Majestic.\" And they are these: \"Glory be to Allah (subḥāna Allāh), and praise be to Allah (al-ḥamdu li-Allāh), and there is no god but Allah (lā ilāha illā Allāh), and Allah is the Greatest (Allāhu akbar), and there is no might and no power except through Allah, the Most High, the Magnificent — to the number of what He has created, and the number of what He is creating, and the weight of what He has created, and the weight of what He is creating, and the fill of what He has created, and the fill of what He is creating, and the fill of His heavens and the fill of His earth, and the like of that, and multiples of that, and the number of His creation, and the weight of His Throne, and the utmost extent of His mercy, and the ink of His words, and the limit of His good pleasure, until He is pleased, and when He is pleased, [then] the number of what His creation has remembered Him with in all that has passed, and the number of what they will remember Him with in what remains, in every year, and month, and Friday, and day, and night, and hour of the hours, and breath of the breaths, and age of the ages, from eternity to eternity — the eternity of this world and the eternity of the Hereafter — and more than that, whose beginning does not cease and whose end does not come to an end.\"","book_title":"On Invocations and Supplications","section_title_ar":"Section 250","section_title_en":"The Supplications of Ibn al-Muʿtamir (Sulaymān al-Taymī) and His Glorifications, and the Supplication of Ibrāhīm ibn Adham — May Allah Be Well Pleased with Them","section_index":250,"anchors":"- Root: سبح (s-b-ḥ)\n  * Lisan / Ayn: Core meaning of swift motion (in water or air); extended to the act of prayer and glorification.\n  * Al-Raghib (Mufradat): \"التسبيح: تنزيه الله تعالى. وأصله: المر السريع في عبادة الله تعالى\" — Glorification is the declaration of Allah's transcendence; its root is the swift passage in worship of Allah.\n  * Al-Zamakhshari (Asas): Literal: \"سبحت الله وسبحت له\" — to declare Him transcendent. Metaphorical: \"والنجوم تسبح في الفلك\" — the stars glide in their orbits, a metaphor for their obedient motion.\n- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: Core meaning of praise and commendation for a beneficial act.\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence with reverence; it is due to Allah alone in His absolute perfection.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — to praise Allah with all His praiseworthy attributes. Metaphorical: \"أحمدت الأرض: رضيت سكناها\" — to find a thing agreeable, extending praise to non-verbal contexts.\n- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core meaning of swift swallowing or devouring.\n  * Al-Raghib (Mufradat): \"الإلهام: إلقاء الشيء في الروع\" — Inspiration is the casting of a thing into the heart/mind (al-rawʿ), specifically from Allah or the higher assembly.\n  * Al-Zamakhshari (Asas): Literal: \"ألهمه الله الخير: ألقاه في روعه\" — Allah inspired him with good. Metaphorical: \"جواد يلتهم الأرض\" — a swift horse devours the ground, extending to rapid comprehension.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the clause remains grammatically sound, as seen in the extended supplicatory sentences.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'","badge":"Du'a"},{"arabic":"القلوب فوالله الذي لا إله إلا هو ما ذلك إلا لأن المعلمين علموا لغير الله تعالى والمتعلمين تعلموا لغير الله تعالى وفي التوراة والإنجيل مكتوب لا تطلبوا علم ما لم تعلموا حتى تعملوا بما علمتم وقال حذيفة رضي الله عنه إنكم في زمان من ترك فيه عشر ما يعلم هلك وسيأتي زمان من عمل فيه بعشر ما يعلم نجا وذلك لكثرة البطالين واعلم أن مثل العالم مثل القاضي وقد قال صلى الله عليه وسلم القضاة ثلاثة قاض قضى بالحق وهو يعلم فذلك في الجنة وقاض قضى بالجور وهو يعلم أو لا يعلم فهو في النار وقاض قضى بغير ما أمر الله به فهو في النار (2) وقال كعب رحمه الله يكون في آخر الزمان علماء يزهدون الناس في الدنيا ولا يزهدون ويخوفون الناس ولا يخافون وينهون عن غشيان الولاة ويأتونهم ويؤثرون الدنيا على الآخرة يأكلون بألسنتهم يقربون الأغنياء دون الفقراء يتغايرون على العلم كما تتغاير النساء على الرجال يغضب أحدهم على جليسه إذا جالس غيره أولئك الجبارون أعداء الرحمن وقال صلى الله عليه وسلم إن الشيطان ربما يسوفكم بالعلم فقيل يا رسول الله وكيف ذلك قال صلى الله عليه وسلم يقول اطلب العلم ولا تعمل حتى تعلم فلا يزال للعلم قائلا وللعمل مسوفا حتى يموت وما عمل (3) وقال سرى السقطي اعتزل رجل للتعبد كان حريصا على طلب علم الظاهر فسألته فقال رأيت في النوم قائلا يقول لي إلى كم تضيع العلم ضيعك الله فقلت إني لأحفظه فقال حفظ العلم العمل به فتركت الطلب وأقبلت على العمل وقال ابن مسعود رضي الله عنه ليس العلم بكثرة الرواية إنما العلم الخشية وقال الحسن تعلموا ما شئتم أن تعلموا فوالله لا يأجركم الله حتى تعملوا فإن السفهاء همتهم الرواية والعلماء همتهم الرعاية وقال مالك رحمه الله إن طلب العلم لحسن وإن نشره لحسن إذا صحت فيه النية ولكن انظر ما يلزمك من حين تصبح إلى حين تمسي فلا تؤثرن عليه شيئا وقال ابن مسعود رضي الله عنه أنزل القرآن ليعمل به فاتخذتم دراسته عملا وسيأتي قوم يثقفونه مثل القناة ليسوا بخياركم والعالم الذي لا يعمل كالمريض الذي يصف الدواء وكالجائع الذي يصف لذائذ الأطعمة ولا يجدها وفي مثله قوله تعالى ولكم الويل مما تصفون وفي الخبر إنما أخاف على أمتي زلة عالم وجدال منافق في القرآن (1) ومنها أن تكون عنايته بتحصيل العلم النافع في الآخرة المرغب في الطاعات مجتنبا للعلوم التي يقل نفعها ويكثر فيها الجدال والقيل والقال فمثال من يعرض عن علم الأعمال ويشتغل بالجدال مثل رجل مريض به علل كثيرة وقد صادف طبيبا حاذقا في وقت ضيق يخشى فواته فاشتغل بالسؤال عن خاصية العقاقير والأدوية وغرائب الطب وترك مهمه الذي هو مؤاخذ به وذلك محض السفه وقد روي أن رجلا جاء رسول الله صلى الله عليه وسلم فقال علمني من غرائب العلم فقال له ما صنعت في رأس العلم فقال وما رأس العلم فقال صلى الله عليه وسلم هل عرفت الرب تعالى قال نعم قال فما صنعت في حقه قال ما شاء الله فقال صلى الله عليه وسلم هل عرفت الموت قال نعم قال فما أعددت له قال ما شاء الله قال صلى الله عليه وسلم إذهب فأحكم ما هناك ثم تعال نعلمك من غرائب العلم (2) بل ينبغي أن يكون المتعلم من جنس ما روي عن حاتم الأصم تلميذ شقيق البلخي رضي الله عنهما أنه قال له شقيق منذ كم صحبتني قال حاتم منذ ثلاث وثلاثين سنة قال فما تعلمت مني في هذه المدة قال ثماني مسائل قال شقيق له إنا لله وإنا إليه راجعون ذهب عمري معك ولم تتعلم إلا ثماني مسائل قال يا أستاذ لم أتعلم غيرها وإني لا أحب أن أكذب فقال هات هذه الثماني مسائل حتى أسمعها قال حاتم نظرت إلى هذا الخلق فرأيت كل واحد يحب محبوبا فهو مع محبوبه إلى القبر فإذا وصل إلى القبر فارقه فجعلت الحسنات محبوبي فإذا دخلت القبر دخل محبوبي معي فقال أحسنت يا حاتم فما الثانية فقال نظرت في قول الله عز وجل وأما من خاف مقام ربه ونهى النفس عن الهوى فإن الجنة هي المأوى فعلمت أن قوله سبحانه وتعالى هو الحق فأجهدت نفسي في دفع الهوى حتى استقرت على طاعة الله تعالى الثالثة أني نظرت إلى هذا الخلق فرأيت كل ممن معه شيء له قيمة ومقدار رفعه وحفظه ثم نظرت إلى قول الله عز وجل ما عندكم ينفذ وما عند الله باق فكلما وقع معي شيء له قيمة ومقدار وجهته إلى الله ليبقى عنده محفوظا الرابعة أني نظرت إلى هذا الخلق فرأيت كل واحد منهم يرجع إلى المال وإلى الحسب والشرف والنسب فنظرت فيها فإذا هي لا شيء ثم نظرت إلى قول الله تعالى إن أكرمكم عند الله أتقاكم فعملت في التقوى حتى أكون عند الله كريما الخامسة أني نظرت إلى هذا الخلق وهم يطعن بعضهم في بعض ويلعن بعضهم بعضا وأصل هذا كله الحسد ثم نظرت إلى قول الله عز وجل نحن قسمنا بينهم معيشتهم في الحياة الدنيا فتركت الحسد واجتنبت الخلق وعلمت أن القسمة من عند الله سبحانه وتعالى فتركت عداوة الخلق عني السادسة نظرت إلى هذا الخلق يبغي بعضهم على بعض ويقاتل بعضهم بعضا فرجعت إلى قول الله عز وجل إن الشيطان لكم عدو فاتخذوه عدوا فعاديته وحده واجتهدت في أخذ حذري منه لأن الله تعالى شهد عليه أنه عدو لي فتركت عداوة الخلق غيره السابعة نظرت إلى هذا الخلق فرأيت كل واحد منهم يطلب هذه الكسرة فيذل فيها نفسه ويدخل فيما لا يحل له ثم نظرت إلى قوله تعالى وما من دابة في الأرض إلا على الله رزقها فعلمت أني واحد من هذه الدواب التي على الله رزقها فاشتغلت بما لله تعالى علي وتركت ما لي عنده الثامنة نظرت إلى هذا الخلق فرأيتهم كلهم متوكلين على مخلوق هذا على ضيعته وهذا على تجارته وهذا على صناعته وهذا على صحة بدنه وكل مخلوق متوكل على مخلوق مثله فرجعت إلى قوله تعالى ومن يتوكل على الله فهو حسبه فتوكلت على الله عز وجل فهو حسبي قال شقيق يا حاتم وفقك الله تعالى فإني نظرت في علوم التوراة والإنجيل والزبور والفرقان العظيم فوجدت جميع أنواع الخير والديانة وهي تدور على هذه الثمان مسائل فمن استعملها فقد استعمل الكتب الأربعة فهذا الفن من العلم لا يهتم بإدراكه والتفطن له إلا علماء الآخرة فأما علماء الدنيا فيشتغلون بما يتيسر به اكتساب المال والجاه ويهملون أمثال هذه العلوم التي بعث الله بها الأنبياء كلهم عليهم السلام وقال الضحاك بن مزاحم أدركتهم وما يتعلم بعضهم من بعض إلا الورع وهم اليوم ما يتعلمون إلا الكلام ومنها أن يكون غير مائل إلى الترفه في المطعم والمشرب والتنعم في الملبس والتجمل في الأثاث والمسكن بل يؤثر الاقتصاد في جميع ذلك ويتشبه فيه بالسلف رحمهم الله تعالى ويميل إلى الاكتفاء بالأقل في جميع ذلك وكلما زاد إلى طرف القلة ميله ازداد من الله قربه وارتفع في علماء الآخرة حزبه ويشهد لذلك ما حكى عن أبي عبد الله الخواص وكان من أصحاب حاتم الأصم قال دخلت مع حاتم إلى الري ومعنا ثلثمائة وعشرون رجلا يريد الحج وعليهم الزرمانقات وليس معهم جراب ولا طعام فدخلنا على رجل من التجار متقشف يحب المساكين فأضافنا تلك الليلة فلما كان من الغد قال لحاتم ألك حاجة فإني أريد أن أعود فقيها لنا هو عليل قال حاتم عيادة المريض فيها فضل والنظر إلى الفقيه عبادة وأنا أيضا أجيء معك وكان العليل محمد بن مقاتل قاضي الري فلما جئنا إلى الباب فإذا قصر مشرف حسن فبقي حاتم متفكرا يقول باب عالم على هذه الحالة ثم أذن لهم فدخلوا فإذا دار حسناء فوراء واسعة نزهة وإذا بزة وستور فبقي حاتم متفكرا ثم دخلوا إلى المجلس الذي هو فيه وإذا بفرش وطيئة وهو راقد عليها وعند رأسه غلام وبيده مذبة فقعد الزائر عند رأسه وسأل عن حاله وحاتم قائم فأومأ إليه ابن مقاتل أن اجلس فقال لا أجلس فقال لعل لك حاجة فقال نعم قال وما هي قال مسئلة أسألك عنها قال سل قال قم فاستو جالسا حتى أسألك فاستوى جالسا قال حاتم علمك هذا من أين أخذته فقال من الثقات حدثوني به قال عمن قال عن أصحاب رسول الله صلى الله عليه وسلم قال وأصحاب رسول الله صلى الله عليه وسلم عمن قال عن رسول الله صلى الله عليه وسلم قال ورسول الله صلى الله عليه وسلم عمن قال عن جبرائيل عليه السلام عن الله عز وجل قال حاتم ففيما أداه جبرائيل عليه السلام عن الله عز وجل إلى رسول الله صلى الله عليه وسلم وأداه رسول الله صلى الله عليه وسلم إلى أصحابه وأصحابه إلى الثقات وأداه الثقات إليك هل سمعت فيه من كان في داره إشراف وكانت سعتها أكثر كان له عند الله عز وجل المنزلة أكبر قال لا قال فكيف سمعت قال سمعت أنه من زهد في الدنيا ورغب في الآخرة وأحب المساكين وقدم لآخرته كانت له عند الله المنزلة قال له حاتم فأنت بمن اقتديت ابالنبي صلى الله عليه وسلم وأصحابه رضي الله عنهم والصالحين رحمهم الله أم بفرعون ونمروذ أول من بنى بالجص والآجر يا علماء السوء مثلكم يراه الجاهل المتكالب على الدنيا الراغب فيها فيقول العالم على هذه الحالة أفلا أكون أنا شرا منه وخرج من عنده فازداد ابن مقاتل مرضا وبلغ أهل الري ما جرى بينه وبين ابن مقاتل فقالوا له إن الطنافسي بقزوين أكثر توسعا منه فسار حاتم متعمدا فدخل عليه فقال رحمك الله أنا رجل أعجمي أحب أن تعلمني مبتدأ ديني ومفتاح صلاتي كيف أتوضأ للصلاة قال نعم وكرامة يا غلام هات إناء فيه ماء فأتى به فقعد الطنافسي فتوضأ ثلاثا ثلاثا ثم قال هكذا فتوضأ فقال حاتم مكانك حتى أتوضأ بين يديك فيكون أوكد لما أريد فقام الطنافسي وقعد حاتم فتوضأ ثم غسل ذراعيه أربعا أربعا فقال الطنافسي يا هذا أسرفت قال له حاتم فبماذا قال غسلت ذراعيك أربعا فقال حاتم يا سبحان الله العظيم أنا في كف من ماء أسرفت وأنت في جميع هذا كله لم تسرف فعلم الطنافسي","english":"Know that the scholar who does not act upon his knowledge is condemned by the Book, the Sunnah, and the sayings of the sages. God, exalted be He, said: {«يا أيها الذين آمنوا لم تقولون ما لا تفعلون * كبر مقتا عند الله أن تقولوا ما لا تفعلون»} (\"O you who believe, why do you say what you do not do? Most hateful it is to God that you say what you do not do\"). And He said: {«أتأمرون الناس بالبر وتنسون أنفسكم»} (\"Do you command people to righteousness while you forget yourselves?\"). And He said: {«ومن الناس من يعجبك قوله في الحياة الدنيا ويشهد الله على ما في قلبه وهو ألد الخصام»} (\"And among people is he whose speech pleases you in the worldly life, and he calls God to witness what is in his heart, yet he is the fiercest of opponents\").","book_title":"On Invocations and Supplications","section_title_ar":"Section 54","section_title_en":"Section 54","section_index":54,"anchors":"*(Anchors established)*","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'","badge":"Insight"},{"arabic":"الأقصد فيما نراه والعلم عند الله عز وجل فيه وهو عالم الغيب والشهادة وهو الرحمن الرحيم بيان دواء الرياء وطريق معالجة القلب فيه قد عرفت مما سبق أن الرياء محبط للأعمال وسبب للمقت عند الله تعالى وأنه من كبائر المهلكات وما هذا وصفه فجدير بالتشمير عن ساق الجد في إزالته ولو بالمجاهدة وتحمل المشاق فلا شفاء إلا في شرب الأدوية المرة البشعة وهذه مجاهدة يضطر إليها العباد كلهم إذ الصبي يخلق ضعيف العقل والتمييز ممتد العين إلى الخلق كثير الطمع فيهم فيرى الناس يتصنع بعضهم لبعض فيغلب عليه حب التصنع بالضرورة ويرسخ ذلك في نفسه وإنما يشعر بكونه مهلكا","english":"Bearing witness to ostentation and to these causes — that they are what impel the ostentatious person — is what Abū Mūsā narrated: that a Bedouin asked the Prophet, peace be upon him, and said: \"O Messenger of God, a man fights...\" // The ḥadīth of Abū Mūsā that a Bedouin said: \"O Messenger of God, a man fights out of zeal (ḥamīyah)\" — the ḥadīth is agreed upon [by al-Bukhārī and Muslim]. Its meaning is that he disdains being overpowered or being blamed as one overpowered and vanquished. And he said: \"And a man fights to show his position (līurā makānahū)\" — and this is the pursuit of the pleasure of status and power.","book_title":"Condemnation of Status and Ostentation","section_title_ar":"Section 825","section_title_en":"The Revival of the Religious Sciences — Section 825: On the Night Prayer of Tarāwīḥ, the Blending of Intentions, and the Cure for Ostentation (Riyā')","section_index":825,"anchors":"- Root: صلا (Ṣ-L-Y)\n  * Lisan / Ayn: Core sense of \"igniting with fire\" and \"enduring heat\"; extended to the ritual prayer as an act of \"burning devotion\" or standing in worship.\n  * Al-Raghib (Mufradat): \"أصل الصلي الإيقاد بالنار\" — the root denotes exposure to fire; in religious usage, ṣalāh is the act of turning wholly toward God, burning away distraction.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) = kindling/roasting; metaphorical (majāz) = the prayer as a spiritual \"roasting\" of the ego's pretensions.\n- Root: فرض (F-R-Ḍ)\n  * Lisan / Ayn: \"Cutting into something solid\" — a decisive incision; hence a divinely ordained obligation as a fixed, incised decree.\n  * Al-Raghib (Mufradat): \"الفرض كالإيجاب لكن الإيجاب يقال اعتبارا بوقوعه وثباته، والفرض بقطع الحكم فيه\" — farḍ is obligation with a decisive, cut-off determination; it is the binding command that severs excuses.\n  * Al-Zamakhshari (Asas): Literal = the obligatory act itself (farīḍah); metaphorical = a \"huge, weighty\" matter (līḥyah fāriḍ) that presses down — here, the weight of divine command on the soul.\n- Root: بعث (B-ʿ-Th)\n  * Lisan / Ayn: \"To rouse, stir up, and send forth\" — the awakening of a motive.\n  * Al-Raghib (Mufradat): \"أصل البعث: إثارة الشيء وتوجيهه\" — the incitement and direction of a thing; in moral psychology, the internal impulse (bāʿith) that moves one to act.\n  * Al-Zamakhshari (Asas): Literal = sending a messenger or rousing from sleep; metaphorical = the stirring of intention (niyyah) that propels the will.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to isolate the sole efficient cause of an act (e.g., \"the obligation alone did not suffice as a rousing motive\"), distinguishing what is predicated exclusively from what is merely concomitant.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Status and Ostentation'","badge":"Ethics"}],"23":[{"arabic":"منيبا أشهد الله وأشهد ملائكته وأنبيائه ورسله وحملة عرشه ومن خلقه ومن هو خالقه بأنه هو الله الذي لا إله إلا هو وحده لا شريك له وأن محمدا عبده ورسوله صلى الله عليه وسلم وإن الجنة حق وأن النار حق والحوض حق والشفاعة حق ومنكرا ونكيرا حق ووعدك حق ووعيدك حق ولقاءك حق والساعة آتية لا ريب فيها وأن الله يبعث من في القبور على ذلك أحيا وعليه أموت وعليه أبعث إن شاء الله اللهم أنت ربي لا إله إلا أنت خلقتني وأنا عبدك وأنا على عهدك ووعدك ما استطعت أعوذ بك اللهم من شر ما صنعت ومن شر كل ذي شر اللهم إني ظلمت نفسي فاغفر لي ذنوبي فإنه لا يغفر الذنوب إلا","english":"It is narrated that Yūnus ibn ʿUbayd saw a man in a dream — a man who had been killed as a martyr in the lands of the Byzantines — and he said to him: \"What is the most excellent deed that you witnessed?\" He replied: \"I witnessed the glorifications (tasbīḥāt) of Ibn al-Muʿtamir holding a station with Allah, Mighty and Majestic.\" And they are these: \"Glory be to Allah (subḥāna Allāh), and praise be to Allah (al-ḥamdu li-Allāh), and there is no god but Allah (lā ilāha illā Allāh), and Allah is the Greatest (Allāhu akbar), and there is no might and no power except through Allah, the Most High, the Magnificent — to the number of what He has created, and the number of what He is creating, and the weight of what He has created, and the weight of what He is creating, and the fill of what He has created, and the fill of what He is creating, and the fill of His heavens and the fill of His earth, and the like of that, and multiples of that, and the number of His creation, and the weight of His Throne, and the utmost extent of His mercy, and the ink of His words, and the limit of His good pleasure, until He is pleased, and when He is pleased, [then] the number of what His creation has remembered Him with in all that has passed, and the number of what they will remember Him with in what remains, in every year, and month, and Friday, and day, and night, and hour of the hours, and breath of the breaths, and age of the ages, from eternity to eternity — the eternity of this world and the eternity of the Hereafter — and more than that, whose beginning does not cease and whose end does not come to an end.\"","book_title":"On Invocations and Supplications","section_title_ar":"Section 250","section_title_en":"The Supplications of Ibn al-Muʿtamir (Sulaymān al-Taymī) and His Glorifications, and the Supplication of Ibrāhīm ibn Adham — May Allah Be Well Pleased with Them","section_index":250,"anchors":"- Root: سبح (s-b-ḥ)\n  * Lisan / Ayn: Core meaning of swift motion (in water or air); extended to the act of prayer and glorification.\n  * Al-Raghib (Mufradat): \"التسبيح: تنزيه الله تعالى. وأصله: المر السريع في عبادة الله تعالى\" — Glorification is the declaration of Allah's transcendence; its root is the swift passage in worship of Allah.\n  * Al-Zamakhshari (Asas): Literal: \"سبحت الله وسبحت له\" — to declare Him transcendent. Metaphorical: \"والنجوم تسبح في الفلك\" — the stars glide in their orbits, a metaphor for their obedient motion.\n- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: Core meaning of praise and commendation for a beneficial act.\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence with reverence; it is due to Allah alone in His absolute perfection.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — to praise Allah with all His praiseworthy attributes. Metaphorical: \"أحمدت الأرض: رضيت سكناها\" — to find a thing agreeable, extending praise to non-verbal contexts.\n- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core meaning of swift swallowing or devouring.\n  * Al-Raghib (Mufradat): \"الإلهام: إلقاء الشيء في الروع\" — Inspiration is the casting of a thing into the heart/mind (al-rawʿ), specifically from Allah or the higher assembly.\n  * Al-Zamakhshari (Asas): Literal: \"ألهمه الله الخير: ألقاه في روعه\" — Allah inspired him with good. Metaphorical: \"جواد يلتهم الأرض\" — a swift horse devours the ground, extending to rapid comprehension.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the clause remains grammatically sound, as seen in the extended supplicatory sentences.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'","badge":"Du'a"},{"arabic":"القلوب فوالله الذي لا إله إلا هو ما ذلك إلا لأن المعلمين علموا لغير الله تعالى والمتعلمين تعلموا لغير الله تعالى وفي التوراة والإنجيل مكتوب لا تطلبوا علم ما لم تعلموا حتى تعملوا بما علمتم وقال حذيفة رضي الله عنه إنكم في زمان من ترك فيه عشر ما يعلم هلك وسيأتي زمان من عمل فيه بعشر ما يعلم نجا وذلك لكثرة البطالين واعلم أن مثل العالم مثل القاضي وقد قال صلى الله عليه وسلم القضاة ثلاثة قاض قضى بالحق وهو يعلم فذلك في الجنة وقاض قضى بالجور وهو يعلم أو لا يعلم فهو في النار وقاض ق","english":"Know that the scholar who does not act upon his knowledge is condemned by the Book, the Sunnah, and the sayings of the sages. God, exalted be He, said: {«يا أيها الذين آمنوا لم تقولون ما لا تفعلون * كبر مقتا عند الله أن تقولوا ما لا تفعلون»} (\"O you who believe, why do you say what you do not do? Most hateful it is to God that you say what you do not do\"). And He said: {«أتأمرون الناس بالبر وتنسون أنفسكم»} (\"Do you command people to righteousness while you forget yourselves?\"). And He said: {«ومن الناس من يعجبك قوله في الحياة الدنيا ويشهد الله على ما في قلبه وهو ألد الخصام»} (\"And among people is he whose speech pleases you in the worldly life, and he calls God to witness what is in his heart, yet he is the fiercest of opponents\").","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 54","section_title_en":"Section 54","section_index":54,"anchors":"*(Anchors established)*","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'","badge":"Afterlife"},{"arabic":"وكقوله تعالى الملك القدوس السلام المؤمن المهيمن العزيز الجبار المتكبر فليتأمل معاني هذه الأسماء والصفات لينكشف له أسرارها فتحتها معان","english":"Ali, may God be pleased with him, said: \"There is no good in worship that lacks understanding (fiqh), nor in recitation that lacks reflection.\"","book_title":"Etiquette of Quran Recitation","section_title_ar":"Section 227","section_title_en":"The Third Book on the Inward Acts During Recitation — Ten in Number","section_index":227,"anchors":"- Root: دبر (d-b-r)\n  * Lisan / Ayn: The rear, the back part; what comes after; to turn one's back; the end or sequel of a thing.\n  * Al-Raghib (Mufradat): That which is opposite of \"front\" (qabal); used metaphorically for what follows or comes after; \"adbar al-nahar\" — the latter part of the day; \"adbar al-sujud\" — the concluding portions of prayers.\n  * Al-Zamakhshari (Asas): Literal: the back or hind part. Metaphorical: what comes at the end, the sequel, the consequence of an affair.\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn over, to overturn, to transform; the heart as that which is constantly turning and fluctuating between states.\n  * Al-Raghib (Mufradat): The turning and directing of a thing from one face to another; al-taqallub — the constant changing and fluctuation; the heart (qalb) is so named for its perpetual turning about of resolutions and states.\n  * Al-Zamakhshari (Asas): Literal: to turn a thing over from its face. Metaphorical: to ponder, to examine thoroughly, to turn a matter over in the mind — \"qallaba al-amr\" — he examined the affair from all sides.\n- Root: ختم (kh-t-m)\n  * Lisan / Ayn: To seal, to stamp, to imprint; the seal or stamp itself.\n  * Al-Raghib (Mufradat): Sealing and stamping — used both for the act of impressing and the impression left; metaphorically employed for securing a thing and preventing access to it, as in {«ختم الله على قلوبهم»} (God sealed their hearts).\n  * Al-Zamakhshari (Asas): Literal: placing a seal upon something. Metaphorical: to conclude, to finish, to bring to an end — \"khatama al-Qur'an\" — he completed the recitation of the Quran.\n- Root: بقي (b-q-y)\n  * Lisan / Ayn: To remain, to endure, to persist; the lasting and continuing of a thing.\n  * Al-Raghib (Mufradat): The persistence of a thing upon its original state; that which remains (al-baqi) is of two kinds: that which remains by itself without limit — and that is the Creator, may He be exalted — and that which remains by another, which is everything other than Him.\n  * Al-Zamakhshari (Asas): Literal: to remain, to stay. Metaphorical: \"baqiya al-shay'\" — the enduring of a thing; \"ma baqiyat minhum baqiyah\" — not one of them remained.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — When the construction \"innama\" is employed, it restricts the predicate to the subject alone, excluding all else. This is pertinent here as the author delimits the inward acts of recitation to precisely ten, no more and no less.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'","badge":"Insight"}],"24":[{"arabic":"وقال صلى الله عليه وسلم يستغفر للعالم ما في السموات والأرض (3) وأي منصب يزيد على منصب من تشتغل ملائكة السموات والأرض بالاستغفار له وقال صلى الله عليه وسلم إن الحكمة تزيد الشريف شرفا وترفع المملوك حتى يدرك مدارك الملوك (4) وقد نبه بهذا على ثمراته في الدنيا ومعلوم أن الآخرة خير وأبقى وقال صلى الله عليه وسلم خصلتان لا يكونان في منافق حسن سمت وفقه في الدين (5) ولا تشكن في الحديث لنفاق بعض فقهاء الزمان فإنه ما أراد به الفقه الذي ظننته وسيأتي معنى الفقه وأدنى درجات الفقيه أن يعلم أن الآخرة خير من الدنيا","english":"How He, Glorified and Exalted, began with Himself, then seconded with the angels, and thirded with the people of knowledge — and sufficient for you is this as honor, excellence, splendor, and nobility. And God, Exalted, said: {«يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات»} — \"God will raise those who have believed among you and those who have been given knowledge, in degrees.\" Ibn ʿAbbās, may God be pleased with them both, said: For the scholars there are degrees above the believers, seven hundred degrees, and between each two degrees is a distance of five hundred years' journey.","book_title":"Contemplation","section_title_ar":"Section 4","section_title_en":"The Book of Knowledge — Section 4: The Excellence of Knowledge and the Scholars","section_index":4,"anchors":"- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Core root meaning of knowing, perceiving a thing in its true reality; the act of apprehension and judgment.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment of existence or non-existence.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes genuine knowing; metaphorical (majāz) usage extends to signs, landmarks, and traces that guide to knowledge.\n- Root: درج (d-r-j)\n  * Lisan / Ayn: Degrees, steps, ascending stations; the root denotes gradation and progressive elevation.\n  * Al-Raghib (Mufradat): \"الدرجة نحو المنزلة، لكن يقال للمنزلة: درجة إذا اعتبرت بالصعود\" — a degree is a station considered by ascent, not horizontal extension.\n  * Al-Zamakhshari (Asas): Literal: physical steps of ascent. Metaphorical: \"لفلان درجة رفيعة\" — lofty rank; \"امش في مدارج الحق\" — walk in the paths of truth.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day denotes the time of the sun's rising to its setting, and may denote any period of time whatsoever.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"ذكر في أيام العرب كذا\" — historical battles and events; \"وذكرهم بأيام الله\" — His mighty deeds against the disbelievers.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication) — The particle \"innamā\" restricts and confines the predicate to the subject alone, as in {«إنما يخشى الله من عباده العلماء»}, where fear of God is restricted exclusively to the scholars.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Contemplation'","badge":"Hadith"}]},"wordTiming":{"abdulbasit":{"1":[[1,400,1213],[2,1213,1964],[3,1964,2499],[4,2499,3013],[5,3013,4706],[6,4706,5550],[7,5550,6064],[8,6064,7052],[9,7052,7855],[10,7855,9090],[11,9090,10303]],"2":[[1,400,969],[2,969,2639],[3,2639,3658],[4,3658,4997],[5,4997,6442],[6,6442,6916],[7,6916,7650],[8,7650,8811],[9,8811,9285],[10,9285,10778],[11,10778,12158],[12,12158,13248],[13,13248,13864],[14,13864,15120],[15,15120,15641],[16,15641,17465],[17,17465,20012],[18,20012,21327],[19,21327,23495],[20,23495,25106],[21,25106,25923],[22,25923,26859],[23,26859,28636],[24,28636,29572],[25,29572,30046],[26,30046,30923],[27,30923,31397],[28,31397,33482],[29,33482,34619],[30,34619,35211],[31,35211,36775],[32,36775,38019],[33,38019,39701],[34,39701,41336],[35,41336,43255],[36,43255,44842],[37,44842,46761],[38,46761,48798],[39,48798,50954],[40,50954,52569]],"3":[[1,400,2738],[2,2738,3300],[3,3300,4066],[4,4066,5074],[5,5074,6503],[6,6503,8611],[7,8611,10404],[8,10404,11042],[9,11042,12867],[10,12867,13990],[11,13990,14628],[12,14628,16313],[13,16313,17564],[14,17564,19184]],"4":[[1,400,1519],[2,1519,3469],[3,3469,6613],[4,6613,7789],[5,7789,9873],[6,9873,10915],[7,10915,13583],[8,13583,14759],[9,14759,16143],[10,16143,17319],[11,17319,18718],[12,18718,20595]],"5":[[1,400,1003],[2,1003,2325],[3,2325,3125],[4,3125,4297],[5,4297,4923],[6,4923,7011],[7,7011,8974],[8,8974,10389],[9,10389,12129],[10,12129,13359],[11,13359,14275],[12,14275,16038],[13,16038,17826]],"6":[[1,400,2758],[