{"surah":59,"verses":[{"ayah":1,"text":"سَبَّحَ لِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ ","translation":"Whatever is in the heavens and whatever is on the earth exalts Allāh,[1] and He is the Exalted in Might, the Wise.","words":[{"id":1,"arabic":"سَبَّحَ","translit":"َḥَّbَs","root":"سبح"},{"id":2,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":3,"arabic":"مَا","translit":"āَm","root":""},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":6,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":7,"arabic":"فِى","translit":"àِf","root":""},{"id":8,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":9,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":10,"arabic":"ٱلْعَزِيزُ","translit":"ُzyِzَʿعْlٱ","root":"عزز"},{"id":11,"arabic":"ٱلْحَكِيمُ","translit":"ُmyِkَḥْlٱ","root":"حكم"}],"hasIhya":false},{"ayah":2,"text":"هُوَ ٱلَّذِىٓ أَخْرَجَ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَٰبِ مِن دِيَٰرِهِمْ لِأَوَّلِ ٱلْحَشْرِۚ مَا ظَنَنتُمْ أَن يَخْرُجُوا۟ۖ وَظَنُّوٓا۟ أَنَّهُم مَّانِعَتُهُمْ حُصُونُهُم مِّنَ ٱللَّهِ فَأَتَىٰهُمُ ٱللَّهُ مِنْ حَيْثُ لَمْ يَحْتَسِبُوا۟ۖ وَقَذَفَ فِى قُلُوبِهِمُ ٱلرُّعْبَۚ يُخْرِبُونَ بُيُوتَهُم بِأَيْدِيهِمْ وَأَيْدِى ٱلْمُؤْمِنِينَ فَٱعْتَبِرُوا۟ يَٰٓأُو۟لِى ٱلْأَبْصَٰرِ ","translation":"It is He who expelled the ones who disbelieved among the People of the Scripture[1] from their homes at the first gathering.[2] You did not think they would leave, and they thought that their fortresses would protect them from Allāh; but [the decree of] Allāh came upon them from where they had not expected, and He cast terror into their hearts [so] they destroyed their houses by their [own] hands and the hands of the believers. So take warning, O people of vision.","words":[{"id":1,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":2,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":3,"arabic":"أَخْرَجَ","translit":"َjgَrْhkَaʾ","root":"خرج"},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":6,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":7,"arabic":"أَهْلِ","translit":"ِlْhَaʾ","root":"اهل"},{"id":8,"arabic":"ٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱ","root":"كتب"},{"id":9,"arabic":"مِن","translit":"nِm","root":""},{"id":10,"arabic":"دِيَٰرِهِمْ","translit":"ْmِhِrَٰyِd","root":"دور"},{"id":11,"arabic":"لِأَوَّلِ","translit":"ِlَّwَaʾِl","root":"اول"},{"id":12,"arabic":"ٱلْحَشْرِ","translit":"ِrْhsَḥْlٱ","root":"حشر"},{"id":13,"arabic":"مَا","translit":"āَm","root":""},{"id":14,"arabic":"ظَنَنتُمْ","translit":"ْmُtnَnَẓ","root":"ظنن"},{"id":15,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":16,"arabic":"يَخْرُجُوا۟","translit":"۟āwُjgُrْhkَy","root":"خرج"},{"id":17,"arabic":"وَظَنُّوٓا۟","translit":"۟āٓwُّnَẓَw","root":"ظنن"},{"id":18,"arabic":"أَنَّهُم","translit":"mُhَّnَaʾ","root":""},{"id":19,"arabic":"مَّانِعَتُهُمْ","translit":"ْmُhُtَʿعِnāَّm","root":"منع"},{"id":20,"arabic":"حُصُونُهُم","translit":"mُhُnwُṣُḥ","root":"حصن"},{"id":21,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":22,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":23,"arabic":"فَأَتَىٰهُمُ","translit":"ُmُhٰàَtَaʾَf","root":"اتي"},{"id":24,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":25,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":26,"arabic":"حَيْثُ","translit":"ُhtْyَḥ","root":"حيث"},{"id":27,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":28,"arabic":"يَحْتَسِبُوا۟","translit":"۟āwُbِsَtْḥَy","root":"حسب"},{"id":29,"arabic":"وَقَذَفَ","translit":"َfَhdَqَw","root":"قذف"},{"id":30,"arabic":"فِى","translit":"àِf","root":""},{"id":31,"arabic":"قُلُوبِهِمُ","translit":"ُmِhِbwُlُq","root":"قلب"},{"id":32,"arabic":"ٱلرُّعْبَ","translit":"َbْʿعُّrlٱ","root":"رعب"},{"id":33,"arabic":"يُخْرِبُونَ","translit":"َnwُbِrْhkُy","root":"خرب"},{"id":34,"arabic":"بُيُوتَهُم","translit":"mُhَtwُyُb","root":"بيت"},{"id":35,"arabic":"بِأَيْدِيهِمْ","translit":"ْmِhyِdْyَaʾِb","root":"يدي"},{"id":36,"arabic":"وَأَيْدِى","translit":"àِdْyَaʾَw","root":"يدي"},{"id":37,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"},{"id":38,"arabic":"فَٱعْتَبِرُوا۟","translit":"۟āwُrِbَtْʿعٱَf","root":"عبر"},{"id":39,"arabic":"يَٰٓأُو۟لِى","translit":"àِl۟wُaʾَٰٓy","root":""},{"id":40,"arabic":"ٱلْأَبْصَٰرِ","translit":"ِrَٰṣْbَaʾْlٱ","root":"بصر"}],"hasIhya":true},{"ayah":3,"text":"وَلَوْلَآ أَن كَتَبَ ٱللَّهُ عَلَيْهِمُ ٱلْجَلَآءَ لَعَذَّبَهُمْ فِى ٱلدُّنْيَاۖ وَلَهُمْ فِى ٱلْءَاخِرَةِ عَذَابُ ٱلنَّارِ ","translation":"And if not that Allāh had decreed for them evacuation, He would have punished them in [this] world, and for them in the Hereafter is the punishment of the Fire.","words":[{"id":1,"arabic":"وَلَوْلَآ","translit":"ٓāَlْwَlَw","root":""},{"id":2,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":3,"arabic":"كَتَبَ","translit":"َbَtَk","root":"كتب"},{"id":4,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":5,"arabic":"عَلَيْهِمُ","translit":"ُmِhْyَlَʿع","root":""},{"id":6,"arabic":"ٱلْجَلَآءَ","translit":"َءٓāَlَjgْlٱ","root":"جلو"},{"id":7,"arabic":"لَعَذَّبَهُمْ","translit":"ْmُhَbَّhdَʿعَl","root":"عذب"},{"id":8,"arabic":"فِى","translit":"àِf","root":""},{"id":9,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":10,"arabic":"وَلَهُمْ","translit":"ْmُhَlَw","root":""},{"id":11,"arabic":"فِى","translit":"àِf","root":""},{"id":12,"arabic":"ٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱ","root":"اخر"},{"id":13,"arabic":"عَذَابُ","translit":"ُbāَhdَʿع","root":"عذب"},{"id":14,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"}],"hasIhya":false},{"ayah":4,"text":"ذَٰلِكَ بِأَنَّهُمْ شَآقُّوا۟ ٱللَّهَ وَرَسُولَهُۥۖ وَمَن يُشَآقِّ ٱللَّهَ فَإِنَّ ٱللَّهَ شَدِيدُ ٱلْعِقَابِ ","translation":"That is because they opposed Allāh and His Messenger. And whoever opposes Allāh - then indeed, Allāh is severe in penalty.","words":[{"id":1,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":2,"arabic":"بِأَنَّهُمْ","translit":"ْmُhَّnَaʾِb","root":""},{"id":3,"arabic":"شَآقُّوا۟","translit":"۟āwُّqٓāَhs","root":"شقق"},{"id":4,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":5,"arabic":"وَرَسُولَهُۥ","translit":"ۥُhَlwُsَrَw","root":"رسل"},{"id":6,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":7,"arabic":"يُشَآقِّ","translit":"ِّqٓāَhsُy","root":"شقق"},{"id":8,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":9,"arabic":"فَإِنَّ","translit":"َّnِiʾَf","root":""},{"id":10,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":11,"arabic":"شَدِيدُ","translit":"ُdyِdَhs","root":"شدد"},{"id":12,"arabic":"ٱلْعِقَابِ","translit":"ِbāَqِʿعْlٱ","root":"عقب"}],"hasIhya":false},{"ayah":5,"text":"مَا قَطَعْتُم مِّن لِّينَةٍ أَوْ تَرَكْتُمُوهَا قَآئِمَةً عَلَىٰٓ أُصُولِهَا فَبِإِذْنِ ٱللَّهِ وَلِيُخْزِىَ ٱلْفَٰسِقِينَ ","translation":"Whatever you have cut down of [their] palm trees or left standing on their trunks - it was by permission of Allāh and so He would disgrace the defiantly disobedient.","words":[{"id":1,"arabic":"مَا","translit":"āَm","root":""},{"id":2,"arabic":"قَطَعْتُم","translit":"mُtْʿعَṭَq","root":"قطع"},{"id":3,"arabic":"مِّن","translit":"nِّm","root":""},{"id":4,"arabic":"لِّينَةٍ","translit":"ٍẗَnyِّl","root":"لين"},{"id":5,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":6,"arabic":"تَرَكْتُمُوهَا","translit":"āَhwُmُtْkَrَt","root":"ترك"},{"id":7,"arabic":"قَآئِمَةً","translit":"ًẗَmِyʾٓāَq","root":"قوم"},{"id":8,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":9,"arabic":"أُصُولِهَا","translit":"āَhِlwُṣُaʾ","root":"اصل"},{"id":10,"arabic":"فَبِإِذْنِ","translit":"ِnْhdِiʾِbَf","root":"اذن"},{"id":11,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":12,"arabic":"وَلِيُخْزِىَ","translit":"َàِzْhkُyِlَw","root":"خزي"},{"id":13,"arabic":"ٱلْفَٰسِقِينَ","translit":"َnyِqِsَٰfْlٱ","root":"فسق"}],"hasIhya":false},{"ayah":6,"text":"وَمَآ أَفَآءَ ٱللَّهُ عَلَىٰ رَسُولِهِۦ مِنْهُمْ فَمَآ أَوْجَفْتُمْ عَلَيْهِ مِنْ خَيْلٍ وَلَا رِكَابٍ وَلَٰكِنَّ ٱللَّهَ يُسَلِّطُ رُسُلَهُۥ عَلَىٰ مَن يَشَآءُۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ","translation":"And what Allāh restored [of property] to His Messenger from them - you did not spur for it [in an expedition] any horses or camels,[1] but Allāh gives His messengers power over whom He wills, and Allāh is over all things competent.","words":[{"id":1,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":2,"arabic":"أَفَآءَ","translit":"َءٓāَfَaʾ","root":"فيا"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":5,"arabic":"رَسُولِهِۦ","translit":"ۦِhِlwُsَr","root":"رسل"},{"id":6,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":7,"arabic":"فَمَآ","translit":"ٓāَmَf","root":""},{"id":8,"arabic":"أَوْجَفْتُمْ","translit":"ْmُtْfَjgْwَaʾ","root":"وجف"},{"id":9,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":10,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":11,"arabic":"خَيْلٍ","translit":"ٍlْyَhk","root":"خيل"},{"id":12,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":13,"arabic":"رِكَابٍ","translit":"ٍbāَkِr","root":"ركب"},{"id":14,"arabic":"وَلَٰكِنَّ","translit":"َّnِkَٰlَw","root":""},{"id":15,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":16,"arabic":"يُسَلِّطُ","translit":"ُṭِّlَsُy","root":"سلط"},{"id":17,"arabic":"رُسُلَهُۥ","translit":"ۥُhَlُsُr","root":"رسل"},{"id":18,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":19,"arabic":"مَن","translit":"nَm","root":""},{"id":20,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":21,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":22,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":23,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":24,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":25,"arabic":"قَدِيرٌ","translit":"ٌryِdَq","root":"قدر"}],"hasIhya":false},{"ayah":7,"text":"مَّآ أَفَآءَ ٱللَّهُ عَلَىٰ رَسُولِهِۦ مِنْ أَهْلِ ٱلْقُرَىٰ فَلِلَّهِ وَلِلرَّسُولِ وَلِذِى ٱلْقُرْبَىٰ وَٱلْيَتَٰمَىٰ وَٱلْمَسَٰكِينِ وَٱبْنِ ٱلسَّبِيلِ كَىْ لَا يَكُونَ دُولَةًۢ بَيْنَ ٱلْأَغْنِيَآءِ مِنكُمْۚ وَمَآ ءَاتَىٰكُمُ ٱلرَّسُولُ فَخُذُوهُ وَمَا نَهَىٰكُمْ عَنْهُ فَٱنتَهُوا۟ۚ وَٱتَّقُوا۟ ٱللَّهَۖ إِنَّ ٱللَّهَ شَدِيدُ ٱلْعِقَابِ ","translation":"And what Allāh restored to His Messenger from the people of the towns - it is for Allāh and for the Messenger and for [his] near relatives[1] and orphans and the needy and the [stranded] traveler[2] - so that it will not be a perpetual distribution among the rich from among you. And whatever the Messenger has given you - take; and what he has forbidden you - refrain from. And fear Allāh; indeed, Allāh is severe in penalty.","words":[{"id":1,"arabic":"مَّآ","translit":"ٓāَّm","root":""},{"id":2,"arabic":"أَفَآءَ","translit":"َءٓāَfَaʾ","root":"فيا"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":5,"arabic":"رَسُولِهِۦ","translit":"ۦِhِlwُsَr","root":"رسل"},{"id":6,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":7,"arabic":"أَهْلِ","translit":"ِlْhَaʾ","root":"اهل"},{"id":8,"arabic":"ٱلْقُرَىٰ","translit":"ٰàَrُqْlٱ","root":"قري"},{"id":9,"arabic":"فَلِلَّهِ","translit":"ِhَّlِlَf","root":"اله"},{"id":10,"arabic":"وَلِلرَّسُولِ","translit":"ِlwُsَّrlِlَw","root":"رسل"},{"id":11,"arabic":"وَلِذِى","translit":"àِhdِlَw","root":""},{"id":12,"arabic":"ٱلْقُرْبَىٰ","translit":"ٰàَbْrُqْlٱ","root":"قرب"},{"id":13,"arabic":"وَٱلْيَتَٰمَىٰ","translit":"ٰàَmَٰtَyْlٱَw","root":"يتم"},{"id":14,"arabic":"وَٱلْمَسَٰكِينِ","translit":"ِnyِkَٰsَmْlٱَw","root":"سكن"},{"id":15,"arabic":"وَٱبْنِ","translit":"ِnْbٱَw","root":"بني"},{"id":16,"arabic":"ٱلسَّبِيلِ","translit":"ِlyِbَّslٱ","root":"سبل"},{"id":17,"arabic":"كَىْ","translit":"ْàَk","root":""},{"id":18,"arabic":"لَا","tran