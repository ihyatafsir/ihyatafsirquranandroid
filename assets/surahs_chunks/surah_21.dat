ot": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "دُونِهِۦٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "ءَالِهَةࣰۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 7, "arabic": "هَاتُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "بُرْهَٰنَكُمْۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 10, "arabic": "ذِكْرُ", "translit": "", "root": ""}, {"id": 11, "arabic": "مَن", "translit": "", "root": ""}, {"id": 12, "arabic": "مَّعِے", "translit": "", "root": ""}, {"id": 13, "arabic": "وَذِكْرُ", "translit": "", "root": ""}, {"id": 14, "arabic": "مَن", "translit": "", "root": ""}, {"id": 15, "arabic": "قَبْلِےۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "بَلَ", "translit": "", "root": ""}, {"id": 17, "arabic": "اَكْثَرُهُمْ", "translit": "", "root": ""}, {"id": 18, "arabic": "لَا", "translit": "", "root": ""}, {"id": 19, "arabic": "يَعْلَمُونَ", "translit": "", "root": ""}, {"id": 20, "arabic": "اَ۬لْحَقَّ", "translit": "", "root": ""}, {"id": 21, "arabic": "فَهُم", "translit": "", "root": ""}, {"id": 22, "arabic": "مُّعْرِضُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 25, "text": "وَمَآ أَرْسَلْنَا مِن قَبْلِكَ مِن رَّسُولٍ اِلَّا يُوح۪يٰٓ إِلَيْهِ أَنَّهُۥ لَآ إِلَٰهَ إِلَّآ أَنَا فَاعْبُدُونِۖ", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَبْلِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "رَّسُولٍ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "يُوح۪يٰٓ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِلَيْهِ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَنَّهُۥ", "translit": "", "root": ""}, {"id": 11, "arabic": "لَآ", "translit": "", "root": ""}, {"id": 12, "arabic": "إِلَٰهَ", "translit": "", "root": ""}, {"id": 13, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 14, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 15, "arabic": "فَاعْبُدُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 26, "text": "وَقَالُواْ اُ۪تَّخَذَ اَ۬لرَّحْمَٰنُ وَلَداࣰۖ سُبْحَٰنَهُۥۖ بَلْ عِبَادࣱ مُّكْرَمُونَۖ", "words": [{"id": 1, "arabic": "وَقَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۪تَّخَذَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لرَّحْمَٰنُ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَلَداࣰۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "سُبْحَٰنَهُۥۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 7, "arabic": "عِبَادࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُّكْرَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 27, "text": "لَا يَسْبِقُونَهُۥ بِالْقَوْلِ وَهُم بِأَمْرِهِۦ يَعْمَلُونَۖ", "words": [{"id": 1, "arabic": "لَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَسْبِقُونَهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِالْقَوْلِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَهُم", "translit": "", "root": ""}, {"id": 5, "arabic": "بِأَمْرِهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَعْمَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 28, "text": "يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْۖ وَلَا يَشْفَعُونَ إِلَّا لِمَنِ اِ۪رْتَض۪يٰ وَهُم مِّنْ خَشْيَتِهِۦ مُشْفِقُونَۖ", "words": [{"id": 1, "arabic": "يَعْلَمُ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "بَيْنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَيْدِيهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "خَلْفَهُمْۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 8, "arabic": "يَشْفَعُونَ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "لِمَنِ", "translit": "", "root": ""}, {"id": 11, "arabic": "اِ۪رْتَض۪يٰ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَهُم", "translit": "", "root": ""}, {"id": 13, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 14, "arabic": "خَشْيَتِهِۦ", "translit": "", "root": ""}, {"id": 15, "arabic": "مُشْفِقُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 29, "text": "وَمَنْ يَّقُلْ مِنْهُمُۥٓ إِنِّيَ إِلَٰهࣱ مِّن دُونِهِۦ فَذَٰلِكَ نَجْزِيهِ جَهَنَّمَۖ كَذَٰلِكَ نَجْزِے اِ۬لظَّٰلِمِينَۖ", "words": [{"id": 1, "arabic": "وَمَنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَّقُلْ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنْهُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنِّيَ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَٰهࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 7, "arabic": "دُونِهِۦ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَذَٰلِكَ", "translit": "", "root": ""}, {"id": 9, "arabic": "نَجْزِيهِ", "translit": "", "root": ""}, {"id": 10, "arabic": "جَهَنَّمَۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "كَذَٰلِكَ", "translit": "", "root": ""}, {"id": 12, "arabic": "نَجْزِے", "translit": "", "root": ""}, {"id": 13, "arabic": "اِ۬لظَّٰلِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 30, "text": "۞أَوَلَمْ يَرَ اَ۬لذِينَ كَفَرُوٓاْ أَنَّ اَ۬لسَّمَٰوَٰتِ وَالَارْضَ كَانَتَا رَتْقاࣰ فَفَتَقْنَٰهُمَاۖ وَجَعَلْنَا مِنَ اَ۬لْمَآءِ كُلَّ شَےْءٍ حَيٍّۖ اَفَلَا يُومِنُونَۖ", "words": [{"id": 1, "arabic": "۞أَوَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَرَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَفَرُوٓاْ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَنَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 8, "arabic": "كَانَتَا", "translit": "", "root": ""}, {"id": 9, "arabic": "رَتْقاࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَفَتَقْنَٰهُمَاۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَجَعَلْنَا", "translit": "", "root": ""}, {"id": 12, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 13, "arabic": "اَ۬لْمَآءِ", "translit": "", "root": ""}, {"id": 14, "arabic": "كُلَّ", "translit": "", "root": ""}, {"id": 15, "arabic": "شَےْءٍ", "translit": "", "root": ""}, {"id": 16, "arabic": "حَيٍّۖ", "translit": "", "root": ""}, {"id": 17, "arabic": "اَفَلَا", "translit": "", "root": ""}, {"id": 18, "arabic": "يُومِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 31, "text": "وَجَعَلْنَا فِے اِ۬لَارْضِ رَوَٰسِيَ أَن تَمِيدَ بِهِمْۖ وَجَعَلْنَا فِيهَا فِجَاجاࣰ سُبُلاࣰ لَّعَلَّهُمْ يَهْتَدُونَۖ", "words": [{"id": 1, "arabic": "وَجَعَلْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَوَٰسِيَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَن", "translit": "", "root": ""}, {"id": 6, "arabic": "تَمِيدَ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهِمْۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَجَعَلْنَا", "translit": "", "root": ""}, {"id": 9, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 10, "arabic": "فِجَاجاࣰ", "translit": "", "root": ""}, {"id": 11, "arabic": "سُبُلاࣰ", "translit": "", "root": ""}, {"id": 12, "arabic": "لَّعَلَّهُمْ", "translit": "", "root": ""}, {"id": 13, "arabic": "يَهْتَدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 32, "text": "وَجَعَلْنَا اَ۬لسَّمَآءَ سَقْفاࣰ مَّحْفُوظاࣰۖ وَهُمْ عَنَ اٰيَٰتِهَا مُعْرِضُونَۖ", "words": [{"id": 1, "arabic": "وَجَعَلْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لسَّمَآءَ", "translit": "", "root": ""}, {"id": 3, "arabic": "سَقْفاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَّحْفُوظاࣰۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اٰيَٰتِهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "مُعْرِضُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 33, "text": "وَهُوَ اَ۬لذِے خَلَقَ اَ۬ليْلَ وَالنَّهَارَ وَالشَّمْسَ وَالْقَمَرَۖ كُلࣱّ فِے فَلَكࣲ يَسْبَحُونَۖ", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 3, "arabic": "خَلَقَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬ليْلَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَالنَّهَارَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَالشَّمْسَ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَالْقَمَرَۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "كُلࣱّ", "translit": "", "root": ""}, {"id": 9, "arabic": "فِے", "translit": "", "root": ""}, {"id": 10, "arabic": "فَلَكࣲ", "translit": "", "root": ""}, {"id": 11, "arabic": "يَسْبَحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 34, "text": "وَمَا جَعَلْنَا لِبَشَرࣲ مِّن قَبْلِكَ اَ۬لْخُلْدَۖ أَفَإِيْن مِّتَّ فَهُمُ اُ۬لْخَٰلِدُونَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَعَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لِبَشَرࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 5, "arabic": "قَبْلِكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْخُلْدَۖ", "translit": "", 