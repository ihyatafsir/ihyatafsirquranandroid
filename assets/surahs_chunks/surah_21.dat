لَٰهِيَةࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "قُلُوبُهُمْۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَأَسَرُّواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لنَّجْوَي", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 6, "arabic": "ظَلَمُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "هَلْ", "translit": "", "root": ""}, {"id": 8, "arabic": "هَٰذَآ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "بَشَرࣱ", "translit": "", "root": ""}, {"id": 11, "arabic": "مِّثْلُكُمُۥٓۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "أَفَتَاتُونَ", "translit": "", "root": ""}, {"id": 13, "arabic": "اَ۬لسِّحْرَ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَأَنتُمْ", "translit": "", "root": ""}, {"id": 15, "arabic": "تُبْصِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 4, "text": "قُل رَّبِّے يَعْلَمُ اُ۬لْقَوْلَ فِے اِ۬لسَّمَآءِ وَالَارْضِۖ وَهُوَ اَ۬لسَّمِيعُ اُ۬لْعَلِيمُۖ", "words": [{"id": 1, "arabic": "قُل", "translit": "", "root": ""}, {"id": 2, "arabic": "رَّبِّے", "translit": "", "root": ""}, {"id": 3, "arabic": "يَعْلَمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْقَوْلَ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَالَارْضِۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لسَّمِيعُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لْعَلِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 5, "text": "بَلْ قَالُوٓاْ أَضْغَٰثُ أَحْلَٰمِۢ بَلِ اِ۪فْتَر۪يٰهُ بَلْ هُوَ شَاعِرࣱۖ فَلْيَاتِنَا بِـَٔايَةࣲ كَمَآ أُرْسِلَ اَ۬لَاوَّلُونَۖ", "words": [{"id": 1, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَالُو