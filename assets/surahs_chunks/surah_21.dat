{"surah": 21, "verses": [{"ayah": 1, "text": "ٱقْتَرَبَ لِلنَّاسِ حِسَابُهُمْ وَهُمْ فِى غَفْلَةٍ مُّعْرِضُونَ ", "translation": "[The time of] their account has approached for the people, while they are in heedlessness turning away.", "words": [{"id": 1, "arabic": "ٱقْتَرَبَ", "translit": "َbَrَtْqٱ", "root": "قرب"}, {"id": 2, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 3, "arabic": "حِسَابُهُمْ", "translit": "ْmُhُbāَsِḥ", "root": "حسب"}, {"id": 4, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "غَفْلَةٍ", "translit": "ٍẗَlْfَغ", "root": "غفل"}, {"id": 7, "arabic": "مُّعْرِضُونَ", "translit": "َnwُḍِrْʿعُّm", "root": "عرض"}], "hasIhya": true}, {"ayah": 2, "text": "مَا يَأْتِيهِم مِّن ذِكْرٍ مِّن رَّبِّهِم مُّحْدَثٍ إِلَّا ٱسْتَمَعُوهُ وَهُمْ يَلْعَبُونَ ", "translation": "No mention [i.e., revelation] comes to them anew from their Lord except that they listen to it while they are at play", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "يَأْتِيهِم", "translit": "mِhyِtْaʾَy", "root": "اتي"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "ذِكْرٍ", "translit": "ٍrْkِhd", "root": "ذكر"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "رَّبِّهِم", "translit": "mِhِّbَّr", "root": "ربب"}, {"id": 7, "arabic": "مُّحْدَثٍ", "translit": "ٍhtَdْḥُّm", "root": "حدث"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "ٱسْتَمَعُوهُ", "translit": "ُhwُʿعَmَtْsٱ", "root": "سمع"}, {"id": 10, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 11, "arabic": "يَلْعَبُونَ", "translit": "َnwُbَʿعْlَy", "root": "لعب"}], "hasIhya": false}, {"ayah": 3, "text": "لَاهِيَةً قُلُوبُهُمْۗ وَأَسَرُّوا۟ ٱلنَّجْوَى ٱلَّذِينَ ظَلَمُوا۟ هَلْ هَٰذَآ إِلَّا بَشَرٌ مِّثْلُكُمْۖ أَفَتَأْتُونَ ٱلسِّحْرَ وَأَنتُمْ تُبْصِرُونَ ", "translation": "With their hearts distracted. And those who do wrong conceal their private conversation, [saying], \"Is this [Prophet] except a human being like you? So would you approach magic while you are aware [of it]?\"", "words": [{"id": 1, "arabic": "لَاهِيَةً", "translit": "ًẗَyِhāَl", "root": "لهو"}, {"id": 2, "arabic": "قُلُوبُهُمْ", "translit": "ْmُhُbwُlُq", "root": "قلب"}, {"id": 3, "arabic": "وَأَسَرُّوا۟", "translit": "۟āwُّrَsَaʾَw", "root": "سرر"}, {"id": 4, "arabic": "ٱلنَّجْوَى", "translit": "àَwْjgَّnlٱ", "root": "نجو"}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "ظَلَمُوا۟", "translit": "۟āwُmَlَẓ", "root": "ظلم"}, {"id": 7, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 8, "arabic": "هَٰذَآ", "translit": "ٓāَhdَٰh", "root": ""}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "بَشَرٌ", "translit": "ٌrَhsَb", "root": "بشر"}, {"id": 11, "arabic": "مِّثْلُكُمْ", "translit": "ْmُkُlْhtِّm", "root": "مثل"}, {"id": 12, "arabic": "أَفَتَأْتُونَ", "translit": "َnwُtْaʾَtَfَaʾ", "root": "اتي"}, {"id": 13, "arabic": "ٱلسِّحْرَ", "translit": "َrْḥِّslٱ", "root": "سحر"}, {"id": 14, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 15, "arabic": "تُبْصِرُونَ", "translit": "َnwُrِṣْbُt", "root": "بصر"}], "hasIhya": false}, {"ayah": 4, "text": "قَالَ رَبِّى يَعْلَمُ ٱلْقَوْلَ فِى ٱلسَّمَآءِ وَٱلْأَرْضِۖ وَهُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ ", "translation": "He [the Prophet (ﷺ)] said, \"My Lord knows whatever is said throughout the heaven and earth, and He is the Hearing, the Knowing.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 3, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 4, "arabic": "ٱلْقَوْلَ", "translit": "َlْwَqْlٱ", "root": "قول"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 7, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 8, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 9, "arabic": "ٱلسَّمِيعُ", "translit": "ُʿعyِmَّslٱ", "root": "سمع"}, {"id": 10, "arabic": "ٱلْعَلِيمُ", "translit": "ُmyِlَʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 5, "text": "بَلْ قَالُوٓا۟ أَضْغَٰثُ أَحْلَٰمٍۭ بَلِ ٱفْتَرَىٰهُ بَلْ هُوَ شَاعِرٌ فَلْيَأْتِنَا بِـَٔايَةٍ كَمَآ أُرْسِلَ ٱلْأَوَّلُونَ ", "translation": "But they say, \"[The revelation is but] a mixture of false dreams; rather, he has invented it; rather, he is a poet. So let him bring us a sign just as the previous [messengers] were sent [with miracles].\"", "words": [{"id": 1, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 2, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 3, "arabic": "أَضْغَٰثُ", "translit": "ُhtَٰغْḍَaʾ", "root": "ضغث"}, {"id": 4, "arabic": "أَحْلَٰمٍۭ", "translit": "ٍۭmَٰlْḥَaʾ", "root": "حلم"}, {"id": 5, "arabic": "بَلِ", "translit": "ِlَb", "root": ""}, {"id": 6, "arabic": "ٱفْتَرَىٰهُ", "translit": "ُhٰàَrَtْfٱ", "root": "فري"}, {"id": 7, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 8, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 9, "arabic": "شَاعِرٌ", "translit": "ٌrِʿعāَhs", "root": "شعر"}, {"id": 10, "arabic": "فَلْيَأْتِنَا", "translit": "āَnِtْaʾَyْlَf", "root": "اتي"}, {"id": 11, "arabic": "بِـَٔايَةٍ", "translit": "ٍẗَyāَٔـِb", "root": "ايي"}, {"id": 12, "arabic": "كَمَآ", "translit": "ٓāَmَk", "root": ""}, {"id": 13, "arabic": "أُرْسِلَ", "translit": "َlِsْrُaʾ", "root": "رسل"}, {"id": 14, "arabic": "ٱلْأَوَّلُونَ", "translit": "َnwُlَّwَaʾْlٱ", "root": "اول"}], "hasIhya": false}, {"ayah": 6, "text": "مَآ ءَامَنَتْ قَبْلَهُم مِّن قَرْيَةٍ أَهْلَكْنَٰهَآۖ أَفَهُمْ يُؤْمِنُونَ ", "translation": "Not a [single] city which We destroyed believed before them,[1] so will they believe?", "words": [{"id": 1, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 2, "arabic": "ءَامَنَتْ", "translit": "ْtَnَmāَء", "root": "امن"}, {"id": 3, "arabic": "قَبْلَهُم", "translit": "mُhَlْbَq", "root": "قبل"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "قَرْيَةٍ", "translit": "ٍẗَyْrَq", "root": "قري"}, {"id": 6, "arabic": "أَهْلَكْنَٰهَآ", "translit": "ٓāَhَٰnْkَlْhَaʾ", "root": "هلك"}, {"id": 7, "arabic": "أَفَهُمْ", "translit": "ْmُhَfَaʾ", "root": ""}, {"id": 8, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 7, "text": "وَمَآ أَرْسَلْنَا قَبْلَكَ إِلَّا رِجَالًا نُّوحِىٓ إِلَيْهِمْۖ فَسْـَٔلُوٓا۟ أَهْلَ ٱلذِّكْرِ إِن كُنتُمْ لَا تَعْلَمُونَ ", "translation": "And We sent not before you, [O Muḥammad], except men to whom We revealed [the message], so ask the people of the message [i.e., former scriptures] if you do not know.", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "قَبْلَكَ", "translit": "َkَlْbَq", "root": "قبل"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "رِجَالًا", "translit": "āًlāَjgِr", "root": "رجل"}, {"id": 6, "arabic": "نُّوحِىٓ", "translit": "ٓàِḥwُّn", "root": "وحي"}, {"id": 7, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 8, "arabic": "فَسْـَٔلُوٓا۟", "translit": "۟āٓwُlَٔـْsَf", "root": "سال"}, {"id": 9, "arabic": "أَهْلَ", "translit": "َlْhَaʾ", "root": "اهل"}, {"id": 10, "arabic": "ٱلذِّكْرِ", "translit": "ِrْkِّhdlٱ", "root": "ذكر"}, {"id": 11, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 12, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 13, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 14, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": true}, {"ayah": 8, "text": "وَمَا جَعَلْنَٰهُمْ جَسَدًا لَّا يَأْكُلُونَ ٱلطَّعَامَ وَمَا كَانُوا۟ خَٰلِدِينَ ", "translation": "And We did not make them [i.e., the prophets] forms not eating food,[1] nor were they immortal [on earth].", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "جَعَلْنَٰهُمْ", "translit": "ْmُhَٰnْlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "جَسَدًا", "translit": "āًdَsَjg", "root": "جسد"}, {"id": 4, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 5, "arabic": "يَأْكُلُونَ", "translit": "َnwُlُkْaʾَy", "root": "اكل"}, {"id": 6, "arabic": "ٱلطَّعَامَ", "translit": "َmāَʿعَّṭlٱ", "root": "طعم"}, {"id": 7, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 8, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 9, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}], "hasIhya": false}, {"ayah": 9, "text": "ثُمَّ صَدَقْنَٰهُمُ ٱلْوَعْدَ فَأَنجَيْنَٰهُمْ وَمَن نَّشَآءُ وَأَهْلَكْنَا ٱلْمُسْرِفِينَ ", "translation": "Then[1] We fulfilled for them the promise, and We saved them and whom We willed and destroyed the transgressors.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "صَدَقْنَٰهُمُ", "translit": "ُmُhَٰnْqَdَṣ", "root": "صدق"}, {"id": 3, "arabic": "ٱلْوَعْدَ", "translit": "َdْʿعَwْlٱ", "root": "وعد"}, {"id": 4, "arabic": "فَأَنجَيْنَٰهُمْ", "translit": "ْmُhَٰnْyَjgnَaʾَf", "root": "نجو"}, {"id": 5, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 6, "arabic": "نَّشَآءُ", "translit": "ُءٓāَhsَّn", "root": "شيا"}, {"id": 7, "arabic": "وَأَهْلَكْنَا", "translit": "āَnْkَlْhَaʾَw", "root": "هلك"}, {"id": 8, "arabic": "ٱلْمُسْرِفِينَ", "translit": "َnyِfِrْsُmْlٱ", "root": "سرف"}], "hasIhya": false}, {"ayah": 10, "text": "لَقَدْ أَنزَلْنَآ إِلَيْكُمْ كِتَٰبًا فِيهِ ذِكْرُكُمْۖ أَفَلَا تَعْقِلُونَ ", "translation": "We have certainly sent down to you a Book [i.e., the Qur’ān] in which is your mention.[1] Then will you not reason?", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 2, "arabic": "أَنزَلْنَآ", "translit": "ٓāَnْlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "إِلَيْكُمْ", "translit": "ْmُkْyَlِiʾ", "root": ""}, {"id": 4, "arabic": "كِتَٰبًا", "translit": "āًbَٰtِk", "root": "كتب"}, {"id": 5, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 6, "arabic": "ذِكْرُكُمْ", "translit": "ْmُkُrْkِhd", "root": "ذكر"}, {"id": 7, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 8, "arabic": "تَعْقِلُونَ", "translit": "َnwُlِqْʿعَt", "root": "عقل"}], "hasIhya": true}, {"ayah": 11, "text": "وَكَمْ قَصَمْنَا مِن قَرْيَةٍ كَانَتْ ظَالِمَةً وَأَنشَأْنَا بَعْدَهَا قَوْمًا ءَاخَرِينَ ", "translation": "And how many a city which was unjust[1] have We shattered and produced after it another people.", "words": [{"id": 1, "arabic": "وَكَمْ", "translit": "ْmَkَw", "root": ""}, {"id": 2, "arabic": "قَصَمْنَا", "translit": "āَnْmَṣَq", "root": "قصم"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "قَرْيَةٍ", "translit": "ٍẗَyْrَq", "root": "قري"}, {"id": 5, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 6, "arabic": "ظَالِمَةً", "translit": "ًẗَmِlāَẓ", "root": "ظلم"}, {"id": 7, "arabic": "وَأَنشَأْنَا", "translit": "āَnْaʾَhsnَaʾَw", "root": "نشا"}, {"id": 8, "arabic": "بَعْدَهَا", "translit": "āَhَdْʿعَb", "root": "بعد"}, {"id": 9, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 10, "arabic": "ءَاخَرِينَ", "translit": "َnyِrَhkāَء", "root": "اخر"}], "hasIhya": false}, {"ayah": 12, "text": "فَلَمَّآ أَحَسُّوا۟ بَأْسَنَآ إِذَا هُم مِّنْهَا يَرْكُضُونَ ", "translation": "And when they [i.e., its inhabitants] perceived Our punishment, at once they fled from it.", "words": [{"id": 1, "arabic": "فَلَمَّآ", "translit": "ٓāَّmَlَf", "root": ""}, {"id": 2, "arabic": "أَحَسُّوا۟", "translit": "۟āwُّsَḥَaʾ", "root": "حسس"}, {"id": 3, "arabic": "بَأْسَنَآ", "translit": "ٓāَnَsْaʾَb", "root": "باس"}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 6, "arabic": "مِّنْهَا", "translit": "āَhْnِّm", "root": ""}, {"id": 7, "arabic": "يَرْكُضُونَ", "translit": "َnwُḍُkْrَy", "root": "ركض"}], "hasIhya": false}, {"ayah": 13, "text": "لَا تَرْكُضُوا۟ وَٱرْجِعُوٓا۟ إِلَىٰ مَآ أُتْرِفْتُمْ فِيهِ وَمَسَٰكِنِكُمْ لَعَلَّكُمْ تُسْـَٔلُونَ ", "translation": "[Some angels said], \"Do not flee but return to where you were given luxury and to your homes - perhaps you will be questioned.\"[1]", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "تَرْكُضُوا۟", "translit": "۟āwُḍُkْrَt", "root": "ركض"}, {"id": 3, "arabic": "وَٱرْجِعُوٓا۟", "translit": "۟āٓwُʿعِjgْrٱَw", "root": "رجع"}, {"id": 4, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 5, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 6, "arabic": "أُتْرِفْتُمْ", "translit": "ْmُtْfِrْtُaʾ", "root": "ترف"}, {"id": 7, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 8, "arabic": "وَمَسَٰكِنِكُمْ", "translit": "ْmُkِnِkَٰsَmَw", "root": "سكن"}, {"id": 9, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 10, "arabic": "تُسْـَٔلُونَ", "translit": "َnwُlَٔـْsُt", "root": "سال"}], "hasIhya": false}, {"ayah": 14, "text": "قَالُوا۟ يَٰوَيْلَنَآ إِنَّا كُنَّا ظَٰلِمِينَ ", "translation": "They said, \"O woe to us! Indeed, we were wrongdoers.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰوَيْلَنَآ", "translit": "ٓāَnَlْyَwَٰy", "root": ""}, {"id": 3, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 4, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 5, "arabic": "ظَٰلِمِينَ", "translit": "َnyِmِlَٰẓ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 15, "text": "فَمَا زَالَت تِّلْكَ دَعْوَىٰهُمْ حَتَّىٰ جَعَلْنَٰهُمْ حَصِيدًا خَٰمِدِينَ ", "translation": "And that declaration of theirs did not cease until We made them [as] a harvest [mowed down], extinguished [like a fire].", "words": [{"id": 1, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 2, "arabic": "زَالَت", "translit": "tَlāَz", "root": "زيل"}, {"id": 3, "arabic": "تِّلْكَ", "translit": "َkْlِّt", "root": ""}, {"id": 4, "arabic": "دَعْوَىٰهُمْ", "translit": "ْmُhٰàَwْʿعَd", "root": "دعو"}, {"id": 5, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 6, "arabic": "جَعَلْنَٰهُمْ", "translit": "ْmُhَٰnْlَʿعَjg", "root": "جعل"}, {"id": 7, "arabic": "حَصِيدًا", "translit": "āًdyِṣَḥ", "root": "حصد"}, {"id": 8, "arabic": "خَٰمِدِينَ", "translit": "َnyِdِmَٰhk", "root": "خمد"}], "hasIhya": false}, {"ayah": 16, "text": "وَمَا خَلَقْنَا ٱلسَّمَآءَ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا لَٰعِبِينَ ", "translation": "And We did not create the heaven and earth and that between them in play.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "خَلَقْنَا", "translit": "āَnْqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "ٱلسَّمَآءَ", "translit": "َءٓāَmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "بَيْنَهُمَا", "translit": "āَmُhَnْyَb", "root": "بين"}, {"id": 7, "arabic": "لَٰعِبِينَ", "translit": "َnyِbِʿعَٰl", "root": "لعب"}], "hasIhya": false}, {"ayah": 17, "text": "لَوْ أَرَدْنَآ أَن نَّتَّخِذَ لَهْوًا لَّٱتَّخَذْنَٰهُ مِن لَّدُنَّآ إِن كُنَّا فَٰعِلِينَ ", "translation": "Had We intended to take a diversion,[1] We could have taken it from [what is] with Us - if [indeed] We were to do so.", "words": [{"id": 1, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 2, "arabic": "أَرَدْنَآ", "translit": "ٓāَnْdَrَaʾ", "root": "رود"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "نَّتَّخِذَ", "translit": "َhdِhkَّtَّn", "root": "اخذ"}, {"id": 5, "arabic": "لَهْوًا", "translit": "āًwْhَl", "root": "لهو"}, {"id": 6, "arabic": "لَّٱتَّخَذْنَٰهُ", "translit": "ُhَٰnْhdَhkَّtٱَّl", "root": "اخذ"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "لَّدُنَّآ", "translit": "ٓāَّnُdَّl", "root": "لدن"}, {"id": 9, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 10, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 11, "arabic": "فَٰعِلِينَ", "translit": "َnyِlِʿعَٰf", "root": "فعل"}], "hasIhya": false}, {"ayah": 18, "text": "بَلْ نَقْذِفُ بِٱلْحَقِّ عَلَى ٱلْبَٰطِلِ فَيَدْمَغُهُۥ فَإِذَا هُوَ زَاهِقٌۚ وَلَكُمُ ٱلْوَيْلُ مِمَّا تَصِفُونَ ", "translation": "Rather, We dash the truth upon falsehood, and it destroys it,[1] and thereupon it departs. And for you is destruction from that which you describe.[2]", "words": [{"id": 1, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 2, "arabic": "نَقْذِفُ", "translit": "ُfِhdْqَn", "root": "قذف"}, {"id": 3, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 4, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱلْبَٰطِلِ", "translit": "ِlِṭَٰbْlٱ", "root": "بطل"}, {"id": 6, "arabic": "فَيَدْمَغُهُۥ", "translit": "ۥُhُغَmْdَyَf", "root": "دمغ"}, {"id": 7, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 8, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 9, "arabic": "زَاهِقٌ", "translit": "ٌqِhāَz", "root": "زهق"}, {"id": 10, "arabic": "وَلَكُمُ", "translit": "ُmُkَlَw", "root": ""}, {"id": 11, "arabic": "ٱلْوَيْلُ", "translit": "ُlْyَwْlٱ", "root": ""}, {"id": 12, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 13, "arabic": "تَصِفُونَ", "translit": "َnwُfِṣَt", "root": "وصف"}], "hasIhya": true}, {"ayah": 19, "text": "وَلَهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ وَمَنْ عِندَهُۥ لَا يَسْتَكْبِرُونَ عَنْ عِبَادَتِهِۦ وَلَا يَسْتَحْسِرُونَ ", "translation": "To Him belongs whoever is in the heavens and the earth. And those near Him [i.e., the angels] are not prevented by arrogance from His worship, nor do they tire.", "words": [{"id": 1, "arabic": "وَلَهُۥ", "translit": "ۥُhَlَw", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 6, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 7, "arabic": "عِندَهُۥ", "translit": "ۥُhَdnِʿع", "root": "عند"}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "يَسْتَكْبِرُونَ", "translit": "َnwُrِbْkَtْsَy", "root": "كبر"}, {"id": 10, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 11, "arabic": "عِبَادَتِهِۦ", "translit": "ۦِhِtَdāَbِʿع", "root": "عبد"}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "يَسْتَحْسِرُونَ", "translit": "َnwُrِsْḥَtْsَy", "root": "حسر"}], "hasIhya": true}, {"ayah": 20, "text": "يُسَبِّحُونَ ٱلَّيْلَ وَٱلنَّهَارَ لَا يَفْتُرُونَ ", "translation": "They exalt [Him] night and day [and] do not slacken.", "words": [{"id": 1, "arabic": "يُسَبِّحُونَ", "translit": "َnwُḥِّbَsُy", "root": "سبح"}, {"id": 2, "arabic": "ٱلَّيْلَ", "translit": "َlْyَّlٱ", "root": "ليل"}, {"id": 3, "arabic": "وَٱلنَّهَارَ", "translit": "َrāَhَّnlٱَw", "root": "نهر"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "يَفْتُرُونَ", "translit": "َnwُrُtْfَy", "root": "فتر"}], "hasIhya": true}, {"ayah": 21, "text": "أَمِ ٱتَّخَذُوٓا۟ ءَالِهَةً مِّنَ ٱلْأَرْضِ هُمْ يُنشِرُونَ ", "translation": "Or have they [i.e., men] taken for themselves gods from the earth who resurrect [the dead]?", "words": [{"id": 1, "arabic": "أَمِ", "translit": "ِmَaʾ", "root": ""}, {"id": 2, "arabic": "ٱتَّخَذُوٓا۟", "translit": "۟āٓwُhdَhkَّtٱ", "root": "اخذ"}, {"id": 3, "arabic": "ءَالِهَةً", "translit": "ًẗَhِlāَء", "root": "اله"}, {"id": 4, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 5, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 7, "arabic": "يُنشِرُونَ", "translit": "َnwُrِhsnُy", "root": "نشر"}], "hasIhya": false}, {"ayah": 22, "text": "لَوْ كَانَ فِيهِمَآ ءَالِهَةٌ إِلَّا ٱللَّهُ لَفَسَدَتَاۚ فَسُبْحَٰنَ ٱللَّهِ رَبِّ ٱلْعَرْشِ عَمَّا يَصِفُونَ ", "translation": "Had there been within them [i.e., the heavens and earth] gods besides Allāh, they both would have been ruined. So exalted is Allāh, Lord of the Throne, above what they describe.", "words": [{"id": 1, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "فِيهِمَآ", "translit": "ٓāَmِhyِf", "root": ""}, {"id": 4, "arabic": "ءَالِهَةٌ", "translit": "ٌẗَhِlāَء", "root": "اله"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "لَفَسَدَتَا", "translit": "āَtَdَsَfَl", "root": "فسد"}, {"id": 8, "arabic": "فَسُبْحَٰنَ", "translit": "َnَٰḥْbُsَf", "root": "سبح"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 11, "arabic": "ٱلْعَرْشِ", "translit": "ِhsْrَʿعْlٱ", "root": "عرش"}, {"id": 12, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 13, "arabic": "يَصِفُونَ", "translit": "َnwُfِṣَy", "root": "وصف"}], "hasIhya": true}, {"ayah": 23, "text": "لَا يُسْـَٔلُ عَمَّا يَفْعَلُ وَهُمْ يُسْـَٔلُونَ ", "translation": "He is not questioned about what He does, but they will be questioned.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "يُسْـَٔلُ", "translit": "ُlَٔـْsُy", "root": "سال"}, {"id": 3, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 4, "arabic": "يَفْعَلُ", "translit": "ُlَʿعْfَy", "root": "فعل"}, {"id": 5, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 6, "arabic": "يُسْـَٔلُونَ", "translit": "َnwُlَٔـْsُy", "root": "سال"}], "hasIhya": true}, {"ayah": 24, "text": "أَمِ ٱتَّخَذُوا۟ مِن دُونِهِۦٓ ءَالِهَةًۖ قُلْ هَاتُوا۟ بُرْهَٰنَكُمْۖ هَٰذَا ذِكْرُ مَن مَّعِىَ وَذِكْرُ مَن قَبْلِىۗ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ ٱلْحَقَّۖ فَهُم مُّعْرِضُونَ ", "translation": "Or have they taken gods besides Him? Say, [O Muḥammad], \"Produce your proof. This [Qur’ān] is the message for those with me and the message of those before me.\"[1] But most of them do not know the truth, so they are turning away.", "words": [{"id": 1, "arabic": "أَمِ", "translit": "ِmَaʾ", "root": ""}, {"id": 2, "arabic": "ٱتَّخَذُوا۟", "translit": "۟āwُhdَhkَّtٱ", "root": "اخذ"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "دُونِهِۦٓ", "translit": "ٓۦِhِnwُd", "root": "دون"}, {"id": 5, "arabic": "ءَالِهَةً", "translit": "ًẗَhِlāَء", "root": "اله"}, {"id": 6, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 7, "arabic": "هَاتُوا۟", "translit": "۟āwُtāَh", "root": "هات"}, {"id": 8, "arabic": "بُرْهَٰنَكُمْ", "translit": "ْmُkَnَٰhْrُb", "root": "برهن"}, {"id": 9, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 10, "arabic": "ذِكْرُ", "translit": "ُrْkِhd", "root": "ذكر"}, {"id": 11, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 12, "arabic": "مَّعِىَ", "translit": "َàِʿعَّm", "root": ""}, {"id": 13, "arabic": "وَذِكْرُ", "translit": "ُrْkِhdَw", "root": "ذكر"}, {"id": 14, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 15, "arabic": "قَبْلِى", "translit": "àِlْbَq", "root": "قبل"}, {"id": 16, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 17, "arabic": "أَكْثَرُهُمْ", "translit": "ْmُhُrَhtْkَaʾ", "root": "كثر"}, {"id": 18, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 19, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}, {"id": 20, "arabic": "ٱلْحَقَّ", "translit": "َّqَḥْlٱ", "root": "حقق"}, {"id": 21, "arabic": "فَهُم", "translit": "mُhَf", "root": ""}, {"id": 22, "arabic": "مُّعْرِضُونَ", "translit": "َnwُḍِrْʿعُّm", "root": "عرض"}], "hasIhya": false}, {"ayah": 25, "text": "وَمَآ أَرْسَلْنَا مِن قَبْلِكَ مِن رَّسُولٍ إِلَّا نُوحِىٓ إِلَيْهِ أَنَّهُۥ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱعْبُدُونِ ", "translation": "And We sent not before you any messenger except We revealed to him that, \"There is no deity except Me, so worship Me.\"", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "رَّسُولٍ", "translit": "ٍlwُsَّr", "root": "رسل"}, {"id": 7, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 8, "arabic": "نُوحِىٓ", "translit": "ٓàِḥwُn", "root": "وحي"}, {"id": 9, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 10, "arabic": "أَنَّهُۥ", "translit": "ۥُhَّnَaʾ", "root": ""}, {"id": 11, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 12, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 13, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 14, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 15, "arabic": "فَٱعْبُدُونِ", "translit": "ِnwُdُbْʿعٱَf", "root": "عبد"}], "hasIhya": false}, {"ayah": 26, "text": "وَقَالُوا۟ ٱتَّخَذَ ٱلرَّحْمَٰنُ وَلَدًاۗ سُبْحَٰنَهُۥۚ بَلْ عِبَادٌ مُّكْرَمُونَ ", "translation": "And they say, \"The Most Merciful has taken a son.\" Exalted is He! Rather, they[1] are [but] honored servants.", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱتَّخَذَ", "translit": "َhdَhkَّtٱ", "root": "اخذ"}, {"id": 3, "arabic": "ٱلرَّحْمَٰنُ", "translit": "ُnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 4, "arabic": "وَلَدًا", "translit": "āًdَlَw", "root": "ولد"}, {"id": 5, "arabic": "سُبْحَٰنَهُۥ", "translit": "ۥُhَnَٰḥْbُs", "root": "سبح"}, {"id": 6, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 7, "arabic": "عِبَادٌ", "translit": "ٌdāَbِʿع", "root": "عبد"}, {"id": 8, "arabic": "مُّكْرَمُونَ", "translit": "َnwُmَrْkُّm", "root": "كرم"}], "hasIhya": false}, {"ayah": 27, "text": "لَا يَسْبِقُونَهُۥ بِٱلْقَوْلِ وَهُم بِأَمْرِهِۦ يَعْمَلُونَ ", "translation": "They cannot precede Him in word, and they act by His command.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "يَسْبِقُونَهُۥ", "translit": "ۥُhَnwُqِbْsَy", "root": "سبق"}, {"id": 3, "arabic": "بِٱلْقَوْلِ", "translit": "ِlْwَqْlٱِb", "root": "قول"}, {"id": 4, "arabic": "وَهُم", "translit": "mُhَw", "root": ""}, {"id": 5, "arabic": "بِأَمْرِهِۦ", "translit": "ۦِhِrْmَaʾِb", "root": "امر"}, {"id": 6, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 28, "text": "يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَلَا يَشْفَعُونَ إِلَّا لِمَنِ ٱرْتَضَىٰ وَهُم مِّنْ خَشْيَتِهِۦ مُشْفِقُونَ ", "translation": "He knows what is [presently] before them and what will be after them,[1] and they cannot intercede except on behalf of one whom He approves. And they, from fear of Him, are apprehensive.", "words": [{"id": 1, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 4, "arabic": "أَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾ", "root": "يدي"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "خَلْفَهُمْ", "translit": "ْmُhَfْlَhk", "root": "خلف"}, {"id": 7, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 8, "arabic": "يَشْفَعُونَ", "translit": "َnwُʿعَfْhsَy", "root": "شفع"}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "لِمَنِ", "translit": "ِnَmِl", "root": ""}, {"id": 11, "arabic": "ٱرْتَضَىٰ", "translit": "ٰàَḍَtْrٱ", "root": "رضو"}, {"id": 12, "arabic": "وَهُم", "translit": "mُhَw", "root": ""}, {"id": 13, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 14, "arabic": "خَشْيَتِهِۦ", "translit": "ۦِhِtَyْhsَhk", "root": "خشي"}, {"id": 15, "arabic": "مُشْفِقُونَ", "translit": "َnwُqِfْhsُm", "root": "شفق"}], "hasIhya": true}, {"ayah": 29, "text": "وَمَن يَقُلْ مِنْهُمْ إِنِّىٓ إِلَٰهٌ مِّن دُونِهِۦ فَذَٰلِكَ نَجْزِيهِ جَهَنَّمَۚ كَذَٰلِكَ نَجْزِى ٱلظَّٰلِمِينَ ", "translation": "And whoever of them should say, \"Indeed, I am a god besides Him\" - that one We would recompense with Hell. Thus do We recompense the wrongdoers.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يَقُلْ", "translit": "ْlُqَy", "root": "قول"}, {"id": 3, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 4, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 5, "arabic": "إِلَٰهٌ", "translit": "ٌhَٰlِiʾ", "root": "اله"}, {"id": 6, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 7, "arabic": "دُونِهِۦ", "translit": "ۦِhِnwُd", "root": "دون"}, {"id": 8, "arabic": "فَذَٰلِكَ", "translit": "َkِlَٰhdَf", "root": ""}, {"id": 9, "arabic": "نَجْزِيهِ", "translit": "ِhyِzْjgَn", "root": "جزي"}, {"id": 10, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 11, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 12, "arabic": "نَجْزِى", "translit": "àِzْjgَn", "root": "جزي"}, {"id": 13, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 30, "text": "أَوَلَمْ يَرَ ٱلَّذِينَ كَفَرُوٓا۟ أَنَّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ كَانَتَا رَتْقًا فَفَتَقْنَٰهُمَاۖ وَجَعَلْنَا مِنَ ٱلْمَآءِ كُلَّ شَىْءٍ حَىٍّۖ أَفَلَا يُؤْمِنُونَ ", "translation": "Have those who disbelieved not considered that the heavens and the earth were a joined entity, and then We separated them and made from water every living thing? Then will they not believe?", "words": [{"id": 1, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 2, "arabic": "يَرَ", "translit": "َrَy", "root": "راي"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 5, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 6, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 7, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 8, "arabic": "كَانَتَا", "translit": "āَtَnāَk", "root": "كون"}, {"id": 9, "arabic": "رَتْقًا", "translit": "āًqْtَr", "root": "رتق"}, {"id": 10, "arabic": "فَفَتَقْنَٰهُمَا", "translit": "āَmُhَٰnْqَtَfَf", "root": "فتق"}, {"id": 11, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 12, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 13, "arabic": "ٱلْمَآءِ", "translit": "ِءٓāَmْlٱ", "root": "موه"}, {"id": 14, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 15, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 16, "arabic": "حَىٍّ", "translit": "ٍّàَḥ", "root": "حيي"}, {"id": 17, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 18, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 31, "text": "وَجَعَلْنَا فِى ٱلْأَرْضِ رَوَٰسِىَ أَن تَمِيدَ بِهِمْ وَجَعَلْنَا فِيهَا فِجَاجًا سُبُلًا لَّعَلَّهُمْ يَهْتَدُونَ ", "translation": "And We placed within the earth firmly set mountains, lest it should shift with them, and We made therein [mountain] passes [as] roads that they might be guided.", "words": [{"id": 1, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 4, "arabic": "رَوَٰسِىَ", "translit": "َàِsَٰwَr", "root": "رسو"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "تَمِيدَ", "translit": "َdyِmَt", "root": "ميد"}, {"id": 7, "arabic": "بِهِمْ", "translit": "ْmِhِb", "root": ""}, {"id": 8, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 9, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 10, "arabic": "فِجَاجًا", "translit": "āًjgāَjgِf", "root": "فجج"}, {"id": 11, "arabic": "سُبُلًا", "translit": "āًlُbُs", "root": "سبل"}, {"id": 12, "arabic": "لَّعَلَّهُمْ", "translit": "ْmُhَّlَʿعَّl", "root": ""}, {"id": 13, "arabic": "يَهْتَدُونَ", "translit": "َnwُdَtْhَy", "root": "هدي"}], "hasIhya": false}, {"ayah": 32, "text": "وَجَعَلْنَا ٱلسَّمَآءَ سَقْفًا مَّحْفُوظًاۖ وَهُمْ عَنْ ءَايَٰتِهَا مُعْرِضُونَ ", "translation": "And We made the sky a protected ceiling, but they, from its signs,[1] are turning away.", "words": [{"id": 1, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 2, "arabic": "ٱلسَّمَآءَ", "translit": "َءٓāَmَّslٱ", "root": "سمو"}, {"id": 3, "arabic": "سَقْفًا", "translit": "āًfْqَs", "root": "سقف"}, {"id": 4, "arabic": "مَّحْفُوظًا", "translit": "āًẓwُfْḥَّm", "root": "حفظ"}, {"id": 5, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 6, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 7, "arabic": "ءَايَٰتِهَا", "translit": "āَhِtَٰyāَء", "root": "ايي"}, {"id": 8, "arabic": "مُعْرِضُونَ", "translit": "َnwُḍِrْʿعُm", "root": "عرض"}], "hasIhya": true}, {"ayah": 33, "text": "وَهُوَ ٱلَّذِى خَلَقَ ٱلَّيْلَ وَٱلنَّهَارَ وَٱلشَّمْسَ وَٱلْقَمَرَۖ كُلٌّ فِى فَلَكٍ يَسْبَحُونَ ", "translation": "And it is He who created the night and the day and the sun and the moon; all [heavenly bodies] in an orbit are swimming.", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 4, "arabic": "ٱلَّيْلَ", "translit": "َlْyَّlٱ", "root": "ليل"}, {"id": 5, "arabic": "وَٱلنَّهَارَ", "translit": "َrāَhَّnlٱَw", "root": "نهر"}, {"id": 6, "arabic": "وَٱلشَّمْسَ", "translit": "َsْmَّhslٱَw", "root": "شمس"}, {"id": 7, "arabic": "وَٱلْقَمَرَ", "translit": "َrَmَqْlٱَw", "root": "قمر"}, {"id": 8, "arabic": "كُلٌّ", "translit": "ٌّlُk", "root": "كلل"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "فَلَكٍ", "translit": "ٍkَlَf", "root": "فلك"}, {"id": 11, "arabic": "يَسْبَحُونَ", "translit": "َnwُḥَbْsَy", "root": "سبح"}], "hasIhya": false}, {"ayah": 34, "text": "وَمَا جَعَلْنَا لِبَشَرٍ مِّن قَبْلِكَ ٱلْخُلْدَۖ أَفَإِي۟ن مِّتَّ فَهُمُ ٱلْخَٰلِدُونَ ", "translation": "And We did not grant to any man before you eternity [on earth]; so if you die - would they be eternal?", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "لِبَشَرٍ", "translit": "ٍrَhsَbِl", "root": "بشر"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 6, "arabic": "ٱلْخُلْدَ", "translit": "َdْlُhkْlٱ", "root": "خلد"}, {"id": 7, "arabic": "أَفَإِي۟ن", "translit": "n۟yِiʾَfَaʾ", "root": ""}, {"id": 8, "arabic": "مِّتَّ", "translit": "َّtِّm", "root": "موت"}, {"id": 9, "arabic": "فَهُمُ", "translit": "ُmُhَf", "root": ""}, {"id": 10, "arabic": "ٱلْخَٰلِدُونَ", "translit": "َnwُdِlَٰhkْlٱ", "root": "خلد"}], "hasIhya": false}, {"ayah": 35, "text": "كُلُّ نَفْسٍ ذَآئِقَةُ ٱلْمَوْتِۗ وَنَبْلُوكُم بِٱلشَّرِّ وَٱلْخَيْرِ فِتْنَةًۖ وَإِلَيْنَا تُرْجَعُونَ ", "translation": "Every soul will taste death. And We test you with evil and with good as trial; and to Us you will be returned.", "words": [{"id": 1, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 2, "arabic": "نَفْسٍ", "translit": "ٍsْfَn", "root": "نفس"}, {"id": 3, "arabic": "ذَآئِقَةُ", "translit": "ُẗَqِyʾٓāَhd", "root": "ذوق"}, {"id": 4, "arabic": "ٱلْمَوْتِ", "translit": "ِtْwَmْlٱ", "root": "موت"}, {"id": 5, "arabic": "وَنَبْلُوكُم", "translit": "mُkwُlْbَnَw", "root": "بلو"}, {"id": 6, "arabic": "بِٱلشَّرِّ", "translit": "ِّrَّhslٱِb", "root": "شرر"}, {"id": 7, "arabic": "وَٱلْخَيْرِ", "translit": "ِrْyَhkْlٱَw", "root": "خير"}, {"id": 8, "arabic": "فِتْنَةً", "translit": "ًẗَnْtِf", "root": "فتن"}, {"id": 9, "arabic": "وَإِلَيْنَا", "translit": "āَnْyَlِiʾَw", "root": ""}, {"id": 10, "arabic": "تُرْجَعُونَ", "translit": "َnwُʿعَjgْrُt", "root": "رجع"}], "hasIhya": true}, {"ayah": 36, "text": "وَإِذَا رَءَاكَ ٱلَّذِينَ كَفَرُوٓا۟ إِن يَتَّخِذُونَكَ إِلَّا هُزُوًا أَهَٰذَا ٱلَّذِى يَذْكُرُ ءَالِهَتَكُمْ وَهُم بِذِكْرِ ٱلرَّحْمَٰنِ هُمْ كَٰفِرُونَ ", "translation": "And when those who disbelieve see you, [O Muḥammad], they take you not except in ridicule, [saying], \"Is this the one who mentions [i.e., insults] your gods?\" And they are, at the mention of the Most Merciful, disbelievers.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "رَءَاكَ", "translit": "َkāَءَr", "root": "راي"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 5, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 6, "arabic": "يَتَّخِذُونَكَ", "translit": "َkَnwُhdِhkَّtَy", "root": "اخذ"}, {"id": 7, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 8, "arabic": "هُزُوًا", "translit": "āًwُzُh", "root": "هزا"}, {"id": 9, "arabic": "أَهَٰذَا", "translit": "āَhdَٰhَaʾ", "root": ""}, {"id": 10, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "يَذْكُرُ", "translit": "ُrُkْhdَy", "root": "ذكر"}, {"id": 12, "arabic": "ءَالِهَتَكُمْ", "translit": "ْmُkَtَhِlāَء", "root": "اله"}, {"id": 13, "arabic": "وَهُم", "translit": "mُhَw", "root": ""}, {"id": 14, "arabic": "بِذِكْرِ", "translit": "ِrْkِhdِb", "root": "ذكر"}, {"id": 15, "arabic": "ٱلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 16, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 17, "arabic": "كَٰفِرُونَ", "translit": "َnwُrِfَٰk", "root": "كفر"}], "hasIhya": false}, {"ayah": 37, "text": "خُلِقَ ٱلْإِنسَٰنُ مِنْ عَجَلٍۚ سَأُو۟رِيكُمْ ءَايَٰتِى فَلَا تَسْتَعْجِلُونِ ", "translation": "Man was created of haste [i.e., impatience]. I will show you My signs [i.e., vengeance], so do not impatiently urge Me.", "words": [{"id": 1, "arabic": "خُلِقَ", "translit": "َqِlُhk", "root": "خلق"}, {"id": 2, "arabic": "ٱلْإِنسَٰنُ", "translit": "ُnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 3, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 4, "arabic": "عَجَلٍ", "translit": "ٍlَjgَʿع", "root": "عجل"}, {"id": 5, "arabic": "سَأُو۟رِيكُمْ", "translit": "ْmُkyِr۟wُaʾَs", "root": "راي"}, {"id": 6, "arabic": "ءَايَٰتِى", "translit": "àِtَٰyāَء", "root": "ايي"}, {"id": 7, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 8, "arabic": "تَسْتَعْجِلُونِ", "translit": "ِnwُlِjgْʿعَtْsَt", "root": "عجل"}], "hasIhya": true}, {"ayah": 38, "text": "وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلْوَعْدُ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "And they say, \"When is this promise, if you should be truthful?\"", "words": [{"id": 1, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 2, "arabic": "مَتَىٰ", "translit": "ٰàَtَm", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "ٱلْوَعْدُ", "translit": "ُdْʿعَwْlٱ", "root": "وعد"}, {"id": 5, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 6, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 7, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": true}, {"ayah": 39, "text": "لَوْ يَعْلَمُ ٱلَّذِينَ كَفَرُوا۟ حِينَ لَا يَكُفُّونَ عَن وُجُوهِهِمُ ٱلنَّارَ وَلَا عَن ظُهُورِهِمْ وَلَا هُمْ يُنصَرُونَ ", "translation": "If those who disbelieved but knew the time when they will not avert the Fire from their faces or from their backs and they will not be aided...[1]", "words": [{"id": 1, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 2, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 5, "arabic": "حِينَ", "translit": "َnyِḥ", "root": "حين"}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يَكُفُّونَ", "translit": "َnwُّfُkَy", "root": "كفف"}, {"id": 8, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 9, "arabic": "وُجُوهِهِمُ", "translit": "ُmِhِhwُjgُw", "root": "وجه"}, {"id": 10, "arabic": "ٱلنَّارَ", "translit": "َrāَّnlٱ", "root": "نور"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 13, "arabic": "ظُهُورِهِمْ", "translit": "ْmِhِrwُhُẓ", "root": "ظهر"}, {"id": 14, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 15, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 16, "arabic": "يُنصَرُونَ", "translit": "َnwُrَṣnُy", "root": "نصر"}], "hasIhya": false}, {"ayah": 40, "text": "بَلْ تَأْتِيهِم بَغْتَةً فَتَبْهَتُهُمْ فَلَا يَسْتَطِيعُونَ رَدَّهَا وَلَا هُمْ يُنظَرُونَ ", "translation": "Rather, it will come to them unexpectedly and bewilder them, and they will not be able to repel it, nor will they be reprieved.", "words": [{"id": 1, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 2, "arabic": "تَأْتِيهِم", "translit": "mِhyِtْaʾَt", "root": "اتي"}, {"id": 3, "arabic": "بَغْتَةً", "translit": "ًẗَtْغَb", "root": "بغت"}, {"id": 4, "arabic": "فَتَبْهَتُهُمْ", "translit": "ْmُhُtَhْbَtَf", "root": "بهت"}, {"id": 5, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 6, "arabic": "يَسْتَطِيعُونَ", "translit": "َnwُʿعyِṭَtْsَy", "root": "طوع"}, {"id": 7, "arabic": "رَدَّهَا", "translit": "āَhَّdَr", "root": "ردد"}, {"id": 8, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 9, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 10, "arabic": "يُنظَرُونَ", "translit": "َnwُrَẓnُy", "root": "نظر"}], "hasIhya": false}, {"ayah": 41, "text": "وَلَقَدِ ٱسْتُهْزِئَ بِرُسُلٍ مِّن قَبْلِكَ فَحَاقَ بِٱلَّذِينَ سَخِرُوا۟ مِنْهُم مَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ ", "translation": "And already were messengers ridiculed before you, but those who mocked them were enveloped by what they used to ridicule.", "words": [{"id": 1, "arabic": "وَلَقَدِ", "translit": "ِdَqَlَw", "root": ""}, {"id": 2, "arabic": "ٱسْتُهْزِئَ", "translit": "َyʾِzْhُtْsٱ", "root": "هزا"}, {"id": 3, "arabic": "بِرُسُلٍ", "translit": "ٍlُsُrِb", "root": "رسل"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 6, "arabic": "فَحَاقَ", "translit": "َqāَḥَf", "root": "حيق"}, {"id": 7, "arabic": "بِٱلَّذِينَ", "translit": "َnyِhdَّlٱِb", "root": ""}, {"id": 8, "arabic": "سَخِرُوا۟", "translit": "۟āwُrِhkَs", "root": "سخر"}, {"id": 9, "arabic": "مِنْهُم", "translit": "mُhْnِm", "root": ""}, {"id": 10, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 11, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 12, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 13, "arabic": "يَسْتَهْزِءُونَ", "translit": "َnwُءِzْhَtْsَy", "root": "هزا"}], "hasIhya": false}, {"ayah": 42, "text": "قُلْ مَن يَكْلَؤُكُم بِٱلَّيْلِ وَٱلنَّهَارِ مِنَ ٱلرَّحْمَٰنِۗ بَلْ هُمْ عَن ذِكْرِ رَبِّهِم مُّعْرِضُونَ ", "translation": "Say, \"Who can protect you at night or by day from the Most Merciful?\" But they are, from the remembrance of their Lord, turning away.", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "يَكْلَؤُكُم", "translit": "mُkُwʾَlْkَy", "root": "كلا"}, {"id": 4, "arabic": "بِٱلَّيْلِ", "translit": "ِlْyَّlٱِb", "root": "ليل"}, {"id": 5, "arabic": "وَٱلنَّهَارِ", "translit": "ِrāَhَّnlٱَw", "root": "نهر"}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 8, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 9, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 10, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 11, "arabic": "ذِكْرِ", "translit": "ِrْkِhd", "root": "ذكر"}, {"id": 12, "arabic": "رَبِّهِم", "translit": "mِhِّbَr", "root": "ربب"}, {"id": 13, "arabic": "مُّعْرِضُونَ", "translit": "َnwُḍِrْʿعُّm", "root": "عرض"}], "hasIhya": false}, {"ayah": 43, "text": "أَمْ لَهُمْ ءَالِهَةٌ تَمْنَعُهُم مِّن دُونِنَاۚ لَا يَسْتَطِيعُونَ نَصْرَ أَنفُسِهِمْ وَلَا هُم مِّنَّا يُصْحَبُونَ ", "translation": "Or do they have gods to defend them other than Us? They are unable [even] to help themselves, nor can they be protected from Us.", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "ءَالِهَةٌ", "translit": "ٌẗَhِlāَء", "root": "اله"}, {"id": 4, "arabic": "تَمْنَعُهُم", "translit": "mُhُʿعَnْmَt", "root": "منع"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "دُونِنَا", "translit": "āَnِnwُd", "root": "دون"}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يَسْتَطِيعُونَ", "translit": "َnwُʿعyِṭَtْsَy", "root": "طوع"}, {"id": 9, "arabic": "نَصْرَ", "translit": "َrْṣَn", "root": "نصر"}, {"id": 10, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 13, "arabic": "مِّنَّا", "translit": "āَّnِّm", "root": ""}, {"id": 14, "arabic": "يُصْحَبُونَ", "translit": "َnwُbَḥْṣُy", "root": "صحب"}], "hasIhya": false}, {"ayah": 44, "text": "بَلْ مَتَّعْنَا هَٰٓؤُلَآءِ وَءَابَآءَهُمْ حَتَّىٰ طَالَ عَلَيْهِمُ ٱلْعُمُرُۗ أَفَلَا يَرَوْنَ أَنَّا نَأْتِى ٱلْأَرْضَ نَنقُصُهَا مِنْ أَطْرَافِهَآۚ أَفَهُمُ ٱلْغَٰلِبُونَ ", "translation": "But, [on the contrary], We have provided good things for these [disbelievers] and their fathers until life was prolonged for them. Then do they not see that We set upon the land, reducing it from its borders?[1] Is it they who will overcome?", "words": [{"id": 1, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 2, "arabic": "مَتَّعْنَا", "translit": "āَnْʿعَّtَm", "root": "متع"}, {"id": 3, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 4, "arabic": "وَءَابَآءَهُمْ", "translit": "ْmُhَءٓāَbāَءَw", "root": "ابو"}, {"id": 5, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 6, "arabic": "طَالَ", "translit": "َlāَṭ", "root": "طول"}, {"id": 7, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 8, "arabic": "ٱلْعُمُرُ", "translit": "ُrُmُʿعْlٱ", "root": "عمر"}, {"id": 9, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 10, "arabic": "يَرَوْنَ", "translit": "َnْwَrَy", "root": "راي"}, {"id": 11, "arabic": "أَنَّا", "translit": "āَّnَaʾ", "root": ""}, {"id": 12, "arabic": "نَأْتِى", "translit": "àِtْaʾَn", "root": "اتي"}, {"id": 13, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 14, "arabic": "نَنقُصُهَا", "translit": "āَhُṣُqnَn", "root": "نقص"}, {"id": 15, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 16, "arabic": "أَطْرَافِهَآ", "translit": "ٓāَhِfāَrْṭَaʾ", "root": "طرف"}, {"id": 17, "arabic": "أَفَهُمُ", "translit": "ُmُhَfَaʾ", "root": ""}, {"id": 18, "arabic": "ٱلْغَٰلِبُونَ", "translit": "َnwُbِlَٰغْlٱ", "root": "غلب"}], "hasIhya": false}, {"ayah": 45, "text": "قُلْ إِنَّمَآ أُنذِرُكُم بِٱلْوَحْىِۚ وَلَا يَسْمَعُ ٱلصُّمُّ ٱلدُّعَآءَ إِذَا مَا يُنذَرُونَ ", "translation": "Say, \"I only warn you by revelation.\" But the deaf do not hear the call when they are warned.", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 3, "arabic": "أُنذِرُكُم", "translit": "mُkُrِhdnُaʾ", "root": "نذر"}, {"id": 4, "arabic": "بِٱلْوَحْىِ", "translit": "ِàْḥَwْlٱِb", "root": "وحي"}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "يَسْمَعُ", "translit": "ُʿعَmْsَy", "root": "سمع"}, {"id": 7, "arabic": "ٱلصُّمُّ", "translit": "ُّmُّṣlٱ", "root": "صمم"}, {"id": 8, "arabic": "ٱلدُّعَآءَ", "translit": "َءٓāَʿعُّdlٱ", "root": "دعو"}, {"id": 9, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 10, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 11, "arabic": "يُنذَرُونَ", "translit": "َnwُrَhdnُy", "root": "نذر"}], "hasIhya": false}, {"ayah": 46, "text": "وَلَئِن مَّسَّتْهُمْ نَفْحَةٌ مِّنْ عَذَابِ رَبِّكَ لَيَقُولُنَّ يَٰوَيْلَنَآ إِنَّا كُنَّا ظَٰلِمِينَ ", "translation": "And if [as much as] a whiff of the punishment of your Lord should touch them, they would surely say, \"O woe to us! Indeed, we have been wrongdoers.\"", "words": [{"id": 1, "arabic": "وَلَئِن", "translit": "nِyʾَlَw", "root": ""}, {"id": 2, "arabic": "مَّسَّتْهُمْ", "translit": "ْmُhْtَّsَّm", "root": "مسس"}, {"id": 3, "arabic": "نَفْحَةٌ", "translit": "ٌẗَḥْfَn", "root": "نفح"}, {"id": 4, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 5, "arabic": "عَذَابِ", "translit": "ِbāَhdَʿع", "root": "عذب"}, {"id": 6, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 7, "arabic": "لَيَقُولُنَّ", "translit": "َّnُlwُqَyَl", "root": "قول"}, {"id": 8, "arabic": "يَٰوَيْلَنَآ", "translit": "ٓāَnَlْyَwَٰy", "root": ""}, {"id": 9, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 10, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 11, "arabic": "ظَٰلِمِينَ", "translit": "َnyِmِlَٰẓ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 47, "text": "وَنَضَعُ ٱلْمَوَٰزِينَ ٱلْقِسْطَ لِيَوْمِ ٱلْقِيَٰمَةِ فَلَا تُظْلَمُ نَفْسٌ شَيْـًٔاۖ وَإِن كَانَ مِثْقَالَ حَبَّةٍ مِّنْ خَرْدَلٍ أَتَيْنَا بِهَاۗ وَكَفَىٰ بِنَا حَٰسِبِينَ ", "translation": "And We place the scales of justice for the Day of Resurrection, so no soul will be treated unjustly at all. And if there is [even] the weight of a mustard seed,[1] We will bring it forth. And sufficient are We as accountant.", "words": [{"id": 1, "arabic": "وَنَضَعُ", "translit": "ُʿعَḍَnَw", "root": "وضع"}, {"id": 2, "arabic": "ٱلْمَوَٰزِينَ", "translit": "َnyِzَٰwَmْlٱ", "root": "وزن"}, {"id": 3, "arabic": "ٱلْقِسْطَ", "translit": "َṭْsِqْlٱ", "root": "قسط"}, {"id": 4, "arabic": "لِيَوْمِ", "translit": "ِmْwَyِl", "root": "يوم"}, {"id": 5, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 6, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 7, "arabic": "تُظْلَمُ", "translit": "ُmَlْẓُt", "root": "ظلم"}, {"id": 8, "arabic": "نَفْسٌ", "translit": "ٌsْfَn", "root": "نفس"}, {"id": 9, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 10, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 11, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 12, "arabic": "مِثْقَالَ", "translit": "َlāَqْhtِm", "root": "ثقل"}, {"id": 13, "arabic": "حَبَّةٍ", "translit": "ٍẗَّbَḥ", "root": "حبب"}, {"id": 14, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 15, "arabic": "خَرْدَلٍ", "translit": "ٍlَdْrَhk", "root": "خردل"}, {"id": 16, "arabic": "أَتَيْنَا", "translit": "āَnْyَtَaʾ", "root": "اتي"}, {"id": 17, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 18, "arabic": "وَكَفَىٰ", "translit": "ٰàَfَkَw", "root": "كفي"}, {"id": 19, "arabic": "بِنَا", "translit": "āَnِb", "root": ""}, {"id": 20, "arabic": "حَٰسِبِينَ", "translit": "َnyِbِsَٰḥ", "root": "حسب"}], "hasIhya": true}, {"ayah": 48, "text": "وَلَقَدْ ءَاتَيْنَا مُوسَىٰ وَهَٰرُونَ ٱلْفُرْقَانَ وَضِيَآءً وَذِكْرًا لِّلْمُتَّقِينَ ", "translation": "And We had already given Moses and Aaron the criterion and a light and a reminder[1] for the righteous", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَا", "translit": "āَnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 4, "arabic": "وَهَٰرُونَ", "translit": "َnwُrَٰhَw", "root": ""}, {"id": 5, "arabic": "ٱلْفُرْقَانَ", "translit": "َnāَqْrُfْlٱ", "root": "فرق"}, {"id": 6, "arabic": "وَضِيَآءً", "translit": "ًءٓāَyِḍَw", "root": "ضوا"}, {"id": 7, "arabic": "وَذِكْرًا", "translit": "āًrْkِhdَw", "root": "ذكر"}, {"id": 8, "arabic": "لِّلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlِّl", "root": "وقي"}], "hasIhya": false}, {"ayah": 49, "text": "ٱلَّذِينَ يَخْشَوْنَ رَبَّهُم بِٱلْغَيْبِ وَهُم مِّنَ ٱلسَّاعَةِ مُشْفِقُونَ ", "translation": "Who fear their Lord unseen,[1] while they are of the Hour apprehensive.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يَخْشَوْنَ", "translit": "َnْwَhsْhkَy", "root": "خشي"}, {"id": 3, "arabic": "رَبَّهُم", "translit": "mُhَّbَr", "root": "ربب"}, {"id": 4, "arabic": "بِٱلْغَيْبِ", "translit": "ِbْyَغْlٱِb", "root": "غيب"}, {"id": 5, "arabic": "وَهُم", "translit": "mُhَw", "root": ""}, {"id": 6, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 7, "arabic": "ٱلسَّاعَةِ", "translit": "ِẗَʿعāَّslٱ", "root": "سوع"}, {"id": 8, "arabic": "مُشْفِقُونَ", "translit": "َnwُqِfْhsُm", "root": "شفق"}], "hasIhya": false}, {"ayah": 50, "text": "وَهَٰذَا ذِكْرٌ مُّبَارَكٌ أَنزَلْنَٰهُۚ أَفَأَنتُمْ لَهُۥ مُنكِرُونَ ", "translation": "And this [Qur’ān] is a blessed message which We have sent down. Then are you with it unacquainted?[1]", "words": [{"id": 1, "arabic": "وَهَٰذَا", "translit": "āَhdَٰhَw", "root": ""}, {"id": 2, "arabic": "ذِكْرٌ", "translit": "ٌrْkِhd", "root": "ذكر"}, {"id": 3, "arabic": "مُّبَارَكٌ", "translit": "ٌkَrāَbُّm", "root": "برك"}, {"id": 4, "arabic": "أَنزَلْنَٰهُ", "translit": "ُhَٰnْlَznَaʾ", "root": "نزل"}, {"id": 5, "arabic": "أَفَأَنتُمْ", "translit": "ْmُtnَaʾَfَaʾ", "root": ""}, {"id": 6, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 7, "arabic": "مُنكِرُونَ", "translit": "َnwُrِknُm", "root": "نكر"}], "hasIhya": false}, {"ayah": 51, "text": "وَلَقَدْ ءَاتَيْنَآ إِبْرَٰهِيمَ رُشْدَهُۥ مِن قَبْلُ وَكُنَّا بِهِۦ عَٰلِمِينَ ", "translation": "And We had certainly given Abraham his sound judgement before,[1] and We were of him well-Knowing", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَآ", "translit": "ٓāَnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 4, "arabic": "رُشْدَهُۥ", "translit": "ۥُhَdْhsُr", "root": "رشد"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 7, "arabic": "وَكُنَّا", "translit": "āَّnُkَw", "root": "كون"}, {"id": 8, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 9, "arabic": "عَٰلِمِينَ", "translit": "َnyِmِlَٰʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 52, "text": "إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَا هَٰذِهِ ٱلتَّمَاثِيلُ ٱلَّتِىٓ أَنتُمْ لَهَا عَٰكِفُونَ ", "translation": "When he said to his father and his people, \"What are these statues to which you are devoted?\"", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "لِأَبِيهِ", "translit": "ِhyِbَaʾِl", "root": "ابو"}, {"id": 4, "arabic": "وَقَوْمِهِۦ", "translit": "ۦِhِmْwَqَw", "root": "قوم"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "هَٰذِهِ", "translit": "ِhِhdَٰh", "root": ""}, {"id": 7, "arabic": "ٱلتَّمَاثِيلُ", "translit": "ُlyِhtāَmَّtlٱ", "root": "مثل"}, {"id": 8, "arabic": "ٱلَّتِىٓ", "translit": "ٓàِtَّlٱ", "root": ""}, {"id": 9, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 10, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 11, "arabic": "عَٰكِفُونَ", "translit": "َnwُfِkَٰʿع", "root": "عكف"}], "hasIhya": false}, {"ayah": 53, "text": "قَالُوا۟ وَجَدْنَآ ءَابَآءَنَا لَهَا عَٰبِدِينَ ", "translation": "They said, \"We found our fathers worshippers of them.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "وَجَدْنَآ", "translit": "ٓāَnْdَjgَw", "root": "وجد"}, {"id": 3, "arabic": "ءَابَآءَنَا", "translit": "āَnَءٓāَbāَء", "root": "ابو"}, {"id": 4, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 5, "arabic": "عَٰبِدِينَ", "translit": "َnyِdِbَٰʿع", "root": "عبد"}], "hasIhya": false}, {"ayah": 54, "text": "قَالَ لَقَدْ كُنتُمْ أَنتُمْ وَءَابَآؤُكُمْ فِى ضَلَٰلٍ مُّبِينٍ ", "translation": "He said, \"You were certainly, you and your fathers, in manifest error.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 3, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 4, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 5, "arabic": "وَءَابَآؤُكُمْ", "translit": "ْmُkُwʾٓāَbāَءَw", "root": "ابو"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ضَلَٰلٍ", "translit": "ٍlَٰlَḍ", "root": "ضلل"}, {"id": 8, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 55, "text": "قَالُوٓا۟ أَجِئْتَنَا بِٱلْحَقِّ أَمْ أَنتَ مِنَ ٱللَّٰعِبِينَ ", "translation": "They said, \"Have you come to us with truth, or are you of those who jest?\"", "words": [{"id": 1, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 2, "arabic": "أَجِئْتَنَا", "translit": "āَnَtْyʾِjgَaʾ", "root": "جيا"}, {"id": 3, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 4, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 5, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱللَّٰعِبِينَ", "translit": "َnyِbِʿعَّٰllٱ", "root": "لعب"}], "hasIhya": false}, {"ayah": 56, "text": "قَالَ بَل رَّبُّكُمْ رَبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ٱلَّذِى فَطَرَهُنَّ وَأَنَا۠ عَلَىٰ ذَٰلِكُم مِّنَ ٱلشَّٰهِدِينَ ", "translation": "He said, \"[No], rather, your Lord is the Lord of the heavens and the earth who created them, and I, to that, am of those who testify.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "بَل", "translit": "lَb", "root": ""}, {"id": 3, "arabic": "رَّبُّكُمْ", "translit": "ْmُkُّbَّr", "root": "ربب"}, {"id": 4, "arabic": "رَبُّ", "translit": "ُّbَr", "root": "ربب"}, {"id": 5, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 7, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "فَطَرَهُنَّ", "translit": "َّnُhَrَṭَf", "root": "فطر"}, {"id": 9, "arabic": "وَأَنَا۠", "translit": "۠āَnَaʾَw", "root": ""}, {"id": 10, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 11, "arabic": "ذَٰلِكُم", "translit": "mُkِlَٰhd", "root": ""}, {"id": 12, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 13, "arabic": "ٱلشَّٰهِدِينَ", "translit": "َnyِdِhَّٰhslٱ", "root": "شهد"}], "hasIhya": true}, {"ayah": 57, "text": "وَتَٱللَّهِ لَأَكِيدَنَّ أَصْنَٰمَكُم بَعْدَ أَن تُوَلُّوا۟ مُدْبِرِينَ ", "translation": "And [I swear] by Allāh, I will surely plan against your idols after you have turned and gone away.\"", "words": [{"id": 1, "arabic": "وَتَٱللَّهِ", "translit": "ِhَّllٱَtَw", "root": "اله"}, {"id": 2, "arabic": "لَأَكِيدَنَّ", "translit": "َّnَdyِkَaʾَl", "root": "كيد"}, {"id": 3, "arabic": "أَصْنَٰمَكُم", "translit": "mُkَmَٰnْṣَaʾ", "root": "صنم"}, {"id": 4, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "تُوَلُّوا۟", "translit": "۟āwُّlَwُt", "root": "ولي"}, {"id": 7, "arabic": "مُدْبِرِينَ", "translit": "َnyِrِbْdُm", "root": "دبر"}], "hasIhya": false}, {"ayah": 58, "text": "فَجَعَلَهُمْ جُذَٰذًا إِلَّا كَبِيرًا لَّهُمْ لَعَلَّهُمْ إِلَيْهِ يَرْجِعُونَ ", "translation": "So he made them into fragments, except a large one among them, that they might return to it [and question].", "words": [{"id": 1, "arabic": "فَجَعَلَهُمْ", "translit": "ْmُhَlَʿعَjgَf", "root": "جعل"}, {"id": 2, "arabic": "جُذَٰذًا", "translit": "āًhdَٰhdُjg", "root": "جذذ"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "كَبِيرًا", "translit": "āًryِbَk", "root": "كبر"}, {"id": 5, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 6, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 7, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 8, "arabic": "يَرْجِعُونَ", "translit": "َnwُʿعِjgْrَy", "root": "رجع"}], "hasIhya": false}, {"ayah": 59, "text": "قَالُوا۟ مَن فَعَلَ هَٰذَا بِـَٔالِهَتِنَآ إِنَّهُۥ لَمِنَ ٱلظَّٰلِمِينَ ", "translation": "They said, \"Who has done this to our gods? Indeed, he is of the wrongdoers.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "فَعَلَ", "translit": "َlَʿعَf", "root": "فعل"}, {"id": 4, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 5, "arabic": "بِـَٔالِهَتِنَآ", "translit": "ٓāَnِtَhِlāَٔـِb", "root": "اله"}, {"id": 6, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 7, "arabic": "لَمِنَ", "translit": "َnِmَl", "root": ""}, {"id": 8, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 60, "text": "قَالُوا۟ سَمِعْنَا فَتًى يَذْكُرُهُمْ يُقَالُ لَهُۥٓ إِبْرَٰهِيمُ ", "translation": "They said, \"We heard a young man mention them who is called Abraham.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "سَمِعْنَا", "translit": "āَnْʿعِmَs", "root": "سمع"}, {"id": 3, "arabic": "فَتًى", "translit": "àًtَf", "root": "فتي"}, {"id": 4, "arabic": "يَذْكُرُهُمْ", "translit": "ْmُhُrُkْhdَy", "root": "ذكر"}, {"id": 5, "arabic": "يُقَالُ", "translit": "ُlāَqُy", "root": "قول"}, {"id": 6, "arabic": "لَهُۥٓ", "translit": "ٓۥُhَl", "root": ""}, {"id": 7, "arabic": "إِبْرَٰهِيمُ", "translit": "ُmyِhَٰrْbِiʾ", "root": ""}], "hasIhya": true}, {"ayah": 61, "text": "قَالُوا۟ فَأْتُوا۟ بِهِۦ عَلَىٰٓ أَعْيُنِ ٱلنَّاسِ لَعَلَّهُمْ يَشْهَدُونَ ", "translation": "They said, \"Then bring him before the eyes of the people that they may testify.\"[1]", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "فَأْتُوا۟", "translit": "۟āwُtْaʾَf", "root": "اتي"}, {"id": 3, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 4, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 5, "arabic": "أَعْيُنِ", "translit": "ِnُyْʿعَaʾ", "root": "عين"}, {"id": 6, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 7, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 8, "arabic": "يَشْهَدُونَ", "translit": "َnwُdَhْhsَy", "root": "شهد"}], "hasIhya": false}, {"ayah": 62, "text": "قَالُوٓا۟ ءَأَنتَ فَعَلْتَ هَٰذَا بِـَٔالِهَتِنَا يَٰٓإِبْرَٰهِيمُ ", "translation": "They said, \"Have you done this to our gods, O Abraham?\"", "words": [{"id": 1, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 2, "arabic": "ءَأَنتَ", "translit": "َtnَaʾَء", "root": ""}, {"id": 3, "arabic": "فَعَلْتَ", "translit": "َtْlَʿعَf", "root": "فعل"}, {"id": 4, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 5, "arabic": "بِـَٔالِهَتِنَا", "translit": "āَnِtَhِlāَٔـِb", "root": "اله"}, {"id": 6, "arabic": "يَٰٓإِبْرَٰهِيمُ", "translit": "ُmyِhَٰrْbِiʾَٰٓy", "root": ""}], "hasIhya": false}, {"ayah": 63, "text": "قَالَ بَلْ فَعَلَهُۥ كَبِيرُهُمْ هَٰذَا فَسْـَٔلُوهُمْ إِن كَانُوا۟ يَنطِقُونَ ", "translation": "He said, \"Rather, this - the largest of them - did it, so ask them, if they should [be able to] speak.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 3, "arabic": "فَعَلَهُۥ", "translit": "ۥُhَlَʿعَf", "root": "فعل"}, {"id": 4, "arabic": "كَبِيرُهُمْ", "translit": "ْmُhُryِbَk", "root": "كبر"}, {"id": 5, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 6, "arabic": "فَسْـَٔلُوهُمْ", "translit": "ْmُhwُlَٔـْsَf", "root": "سال"}, {"id": 7, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 8, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 9, "arabic": "يَنطِقُونَ", "translit": "َnwُqِṭnَy", "root": "نطق"}], "hasIhya": false}, {"ayah": 64, "text": "فَرَجَعُوٓا۟ إِلَىٰٓ أَنفُسِهِمْ فَقَالُوٓا۟ إِنَّكُمْ أَنتُمُ ٱلظَّٰلِمُونَ ", "translation": "So they returned to [blaming] themselves and said [to each other], \"Indeed, you are the wrongdoers.\"", "words": [{"id": 1, "arabic": "فَرَجَعُوٓا۟", "translit": "۟āٓwُʿعَjgَrَf", "root": "رجع"}, {"id": 2, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 3, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 4, "arabic": "فَقَالُوٓا۟", "translit": "۟āٓwُlāَqَf", "root": "قول"}, {"id": 5, "arabic": "إِنَّكُمْ", "translit": "ْmُkَّnِiʾ", "root": ""}, {"id": 6, "arabic": "أَنتُمُ", "translit": "ُmُtnَaʾ", "root": ""}, {"id": 7, "arabic": "ٱلظَّٰلِمُونَ", "translit": "َnwُmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 65, "text": "ثُمَّ نُكِسُوا۟ عَلَىٰ رُءُوسِهِمْ لَقَدْ عَلِمْتَ مَا هَٰٓؤُلَآءِ يَنطِقُونَ ", "translation": "Then they reversed themselves,[1] [saying], \"You have already known that these do not speak!\"", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "نُكِسُوا۟", "translit": "۟āwُsِkُn", "root": "نكس"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "رُءُوسِهِمْ", "translit": "ْmِhِswُءُr", "root": "راس"}, {"id": 5, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 6, "arabic": "عَلِمْتَ", "translit": "َtْmِlَʿع", "root": "علم"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 9, "arabic": "يَنطِقُونَ", "translit": "َnwُqِṭnَy", "root": "نطق"}], "hasIhya": false}, {"ayah": 66, "text": "قَالَ أَفَتَعْبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَنفَعُكُمْ شَيْـًٔا وَلَا يَضُرُّكُمْ ", "translation": "He said, \"Then do you worship instead of Allāh that which does not benefit you at all or harm you?", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "أَفَتَعْبُدُونَ", "translit": "َnwُdُbْʿعَtَfَaʾ", "root": "عبد"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يَنفَعُكُمْ", "translit": "ْmُkُʿعَfnَy", "root": "نفع"}, {"id": 9, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "يَضُرُّكُمْ", "translit": "ْmُkُّrُḍَy", "root": "ضرر"}], "hasIhya": false}, {"ayah": 67, "text": "أُفٍّ لَّكُمْ وَلِمَا تَعْبُدُونَ مِن دُونِ ٱللَّهِۖ أَفَلَا تَعْقِلُونَ ", "translation": "Uff[1] to you and to what you worship instead of Allāh. Then will you not use reason?\"", "words": [{"id": 1, "arabic": "أُفٍّ", "translit": "ٍّfُaʾ", "root": "افف"}, {"id": 2, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 3, "arabic": "وَلِمَا", "translit": "āَmِlَw", "root": ""}, {"id": 4, "arabic": "تَعْبُدُونَ", "translit": "َnwُdُbْʿعَt", "root": "عبد"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 9, "arabic": "تَعْقِلُونَ", "translit": "َnwُlِqْʿعَt", "root": "عقل"}], "hasIhya": true}, {"ayah": 68, "text": "قَالُوا۟ حَرِّقُوهُ وَٱنصُرُوٓا۟ ءَالِهَتَكُمْ إِن كُنتُمْ فَٰعِلِينَ ", "translation": "They said, \"Burn him and support your gods - if you are to act.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "حَرِّقُوهُ", "translit": "ُhwُqِّrَḥ", "root": "حرق"}, {"id": 3, "arabic": "وَٱنصُرُوٓا۟", "translit": "۟āٓwُrُṣnٱَw", "root": "نصر"}, {"id": 4, "arabic": "ءَالِهَتَكُمْ", "translit": "ْmُkَtَhِlāَء", "root": "اله"}, {"id": 5, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 6, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 7, "arabic": "فَٰعِلِينَ", "translit": "َnyِlِʿعَٰf", "root": "فعل"}], "hasIhya": false}, {"ayah": 69, "text": "قُلْنَا يَٰنَارُ كُونِى بَرْدًا وَسَلَٰمًا عَلَىٰٓ إِبْرَٰهِيمَ ", "translation": "We [i.e., Allāh] said, \"O fire, be coolness and safety upon Abraham.\"", "words": [{"id": 1, "arabic": "قُلْنَا", "translit": "āَnْlُq", "root": "قول"}, {"id": 2, "arabic": "يَٰنَارُ", "translit": "ُrāَnَٰy", "root": "نور"}, {"id": 3, "arabic": "كُونِى", "translit": "àِnwُk", "root": "كون"}, {"id": 4, "arabic": "بَرْدًا", "translit": "āًdْrَb", "root": "برد"}, {"id": 5, "arabic": "وَسَلَٰمًا", "translit": "āًmَٰlَsَw", "root": "سلم"}, {"id": 6, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 7, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}], "hasIhya": false}, {"ayah": 70, "text": "وَأَرَادُوا۟ بِهِۦ كَيْدًا فَجَعَلْنَٰهُمُ ٱلْأَخْسَرِينَ ", "translation": "And they intended for him a plan [i.e., harm], but We made them the greatest losers.", "words": [{"id": 1, "arabic": "وَأَرَادُوا۟", "translit": "۟āwُdāَrَaʾَw", "root": "رود"}, {"id": 2, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 3, "arabic": "كَيْدًا", "translit": "āًdْyَk", "root": "كيد"}, {"id": 4, "arabic": "فَجَعَلْنَٰهُمُ", "translit": "ُmُhَٰnْlَʿعَjgَf", "root": "جعل"}, {"id": 5, "arabic": "ٱلْأَخْسَرِينَ", "translit": "َnyِrَsْhkَaʾْlٱ", "root": "خسر"}], "hasIhya": false}, {"ayah": 71, "text": "وَنَجَّيْنَٰهُ وَلُوطًا إِلَى ٱلْأَرْضِ ٱلَّتِى بَٰرَكْنَا فِيهَا لِلْعَٰلَمِينَ ", "translation": "And We delivered him and Lot to the land which We had blessed for the worlds [i.e., peoples].", "words": [{"id": 1, "arabic": "وَنَجَّيْنَٰهُ", "translit": "ُhَٰnْyَّjgَnَw", "root": "نجو"}, {"id": 2, "arabic": "وَلُوطًا", "translit": "āًṭwُlَw", "root": ""}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 5, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 6, "arabic": "بَٰرَكْنَا", "translit": "āَnْkَrَٰb", "root": "برك"}, {"id": 7, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 8, "arabic": "لِلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlِl", "root": "علم"}], "hasIhya": false}, {"ayah": 72, "text": "وَوَهَبْنَا لَهُۥٓ إِسْحَٰقَ وَيَعْقُوبَ نَافِلَةًۖ وَكُلًّا جَعَلْنَا صَٰلِحِينَ ", "translation": "And We gave him Isaac and Jacob in addition, and all [of them] We made righteous.", "words": [{"id": 1, "arabic": "وَوَهَبْنَا", "translit": "āَnْbَhَwَw", "root": "وهب"}, {"id": 2, "arabic": "لَهُۥٓ", "translit": "ٓۥُhَl", "root": ""}, {"id": 3, "arabic": "إِسْحَٰقَ", "translit": "َqَٰḥْsِiʾ", "root": ""}, {"id": 4, "arabic": "وَيَعْقُوبَ", "translit": "َbwُqْʿعَyَw", "root": ""}, {"id": 5, "arabic": "نَافِلَةً", "translit": "ًẗَlِfāَn", "root": "نفل"}, {"id": 6, "arabic": "وَكُلًّا", "translit": "āًّlُkَw", "root": "كلل"}, {"id": 7, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 8, "arabic": "صَٰلِحِينَ", "translit": "َnyِḥِlَٰṣ", "root": "صلح"}], "hasIhya": false}, {"ayah": 73, "text": "وَجَعَلْنَٰهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا وَأَوْحَيْنَآ إِلَيْهِمْ فِعْلَ ٱلْخَيْرَٰتِ وَإِقَامَ ٱلصَّلَوٰةِ وَإِيتَآءَ ٱلزَّكَوٰةِۖ وَكَانُوا۟ لَنَا عَٰبِدِينَ ", "translation": "And We made them leaders guiding by Our command. And We inspired to them the doing of good deeds, establishment of prayer, and giving of zakāh; and they were worshippers of Us.", "words": [{"id": 1, "arabic": "وَجَعَلْنَٰهُمْ", "translit": "ْmُhَٰnْlَʿعَjgَw", "root": "جعل"}, {"id": 2, "arabic": "أَئِمَّةً", "translit": "ًẗَّmِyʾَaʾ", "root": "امم"}, {"id": 3, "arabic": "يَهْدُونَ", "translit": "َnwُdْhَy", "root": "هدي"}, {"id": 4, "arabic": "بِأَمْرِنَا", "translit": "āَnِrْmَaʾِb", "root": "امر"}, {"id": 5, "arabic": "وَأَوْحَيْنَآ", "translit": "ٓāَnْyَḥْwَaʾَw", "root": "وحي"}, {"id": 6, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 7, "arabic": "فِعْلَ", "translit": "َlْʿعِf", "root": "فعل"}, {"id": 8, "arabic": "ٱلْخَيْرَٰتِ", "translit": "ِtَٰrْyَhkْlٱ", "root": "خير"}, {"id": 9, "arabic": "وَإِقَامَ", "translit": "َmāَqِiʾَw", "root": "قوم"}, {"id": 10, "arabic": "ٱلصَّلَوٰةِ", "translit": "ِẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 11, "arabic": "وَإِيتَآءَ", "translit": "َءٓāَtyِiʾَw", "root": "اتي"}, {"id": 12, "arabic": "ٱلزَّكَوٰةِ", "translit": "ِẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 13, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 14, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 15, "arabic": "عَٰبِدِينَ", "translit": "َnyِdِbَٰʿع", "root": "عبد"}], "hasIhya": false}, {"ayah": 74, "text": "وَلُوطًا ءَاتَيْنَٰهُ حُكْمًا وَعِلْمًا وَنَجَّيْنَٰهُ مِنَ ٱلْقَرْيَةِ ٱلَّتِى كَانَت تَّعْمَلُ ٱلْخَبَٰٓئِثَۗ إِنَّهُمْ كَانُوا۟ قَوْمَ سَوْءٍ فَٰسِقِينَ ", "translation": "And to Lot We gave judgement and knowledge, and We saved him from the city that was committing wicked deeds. Indeed, they were a people of evil, defiantly disobedient.", "words": [{"id": 1, "arabic": "وَلُوطًا", "translit": "āًṭwُlَw", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَٰهُ", "translit": "ُhَٰnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "حُكْمًا", "translit": "āًmْkُḥ", "root": "حكم"}, {"id": 4, "arabic": "وَعِلْمًا", "translit": "āًmْlِʿعَw", "root": "علم"}, {"id": 5, "arabic": "وَنَجَّيْنَٰهُ", "translit": "ُhَٰnْyَّjgَnَw", "root": "نجو"}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱلْقَرْيَةِ", "translit": "ِẗَyْrَqْlٱ", "root": "قري"}, {"id": 8, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 9, "arabic": "كَانَت", "translit": "tَnāَk", "root": "كون"}, {"id": 10, "arabic": "تَّعْمَلُ", "translit": "ُlَmْʿعَّt", "root": "عمل"}, {"id": 11, "arabic": "ٱلْخَبَٰٓئِثَ", "translit": "َhtِyʾَٰٓbَhkْlٱ", "root": "خبث"}, {"id": 12, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 13, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 14, "arabic": "قَوْمَ", "translit": "َmْwَq", "root": "قوم"}, {"id": 15, "arabic": "سَوْءٍ", "translit": "ٍءْwَs", "root": "سوا"}, {"id": 16, "arabic": "فَٰسِقِينَ", "translit": "َnyِqِsَٰf", "root": "فسق"}], "hasIhya": false}, {"ayah": 75, "text": "وَأَدْخَلْنَٰهُ فِى رَحْمَتِنَآۖ إِنَّهُۥ مِنَ ٱلصَّٰلِحِينَ ", "translation": "And We admitted him into Our mercy. Indeed, he was of the righteous.", "words": [{"id": 1, "arabic": "وَأَدْخَلْنَٰهُ", "translit": "ُhَٰnْlَhkْdَaʾَw", "root": "دخل"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "رَحْمَتِنَآ", "translit": "ٓāَnِtَmْḥَr", "root": "رحم"}, {"id": 4, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 5, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 6, "arabic": "ٱلصَّٰلِحِينَ", "translit": "َnyِḥِlَّٰṣlٱ", "root": "صلح"}], "hasIhya": false}, {"ayah": 76, "text": "وَنُوحًا إِذْ نَادَىٰ مِن قَبْلُ فَٱسْتَجَبْنَا لَهُۥ فَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ ", "translation": "And [mention] Noah, when he called [to Allāh][1] before [that time], so We responded to him and saved him and his family from the great affliction [i.e., the flood].", "words": [{"id": 1, "arabic": "وَنُوحًا", "translit": "āًḥwُnَw", "root": ""}, {"id": 2, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 3, "arabic": "نَادَىٰ", "translit": "ٰàَdāَn", "root": "ندي"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 6, "arabic": "فَٱسْتَجَبْنَا", "translit": "āَnْbَjgَtْsٱَf", "root": "جوب"}, {"id": 7, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 8, "arabic": "فَنَجَّيْنَٰهُ", "translit": "ُhَٰnْyَّjgَnَf", "root": "نجو"}, {"id": 9, "arabic": "وَأَهْلَهُۥ", "translit": "ۥُhَlْhَaʾَw", "root": "اهل"}, {"id": 10, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 11, "arabic": "ٱلْكَرْبِ", "translit": "ِbْrَkْlٱ", "root": "كرب"}, {"id": 12, "arabic": "ٱلْعَظِيمِ", "translit": "ِmyِẓَʿعْlٱ", "root": "عظم"}], "hasIhya": false}, {"ayah": 77, "text": "وَنَصَرْنَٰهُ مِنَ ٱلْقَوْمِ ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَآۚ إِنَّهُمْ كَانُوا۟ قَوْمَ سَوْءٍ فَأَغْرَقْنَٰهُمْ أَجْمَعِينَ ", "translation": "And We aided [i.e., saved] him from the people who denied Our signs. Indeed, they were a people of evil, so We drowned them, all together.", "words": [{"id": 1, "arabic": "وَنَصَرْنَٰهُ", "translit": "ُhَٰnْrَṣَnَw", "root": "نصر"}, {"id": 2, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 3, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 6, "arabic": "بِـَٔايَٰتِنَآ", "translit": "ٓāَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 7, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 8, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 9, "arabic": "قَوْمَ", "translit": "َmْwَq", "root": "قوم"}, {"id": 10, "arabic": "سَوْءٍ", "translit": "ٍءْwَs", "root": "سوا"}, {"id": 11, "arabic": "فَأَغْرَقْنَٰهُمْ", "translit": "ْmُhَٰnْqَrْغَaʾَf", "root": "غرق"}, {"id": 12, "arabic": "أَجْمَعِينَ", "translit": "َnyِʿعَmْjgَaʾ", "root": "جمع"}], "hasIhya": false}, {"ayah": 78, "text": "وَدَاوُۥدَ وَسُلَيْمَٰنَ إِذْ يَحْكُمَانِ فِى ٱلْحَرْثِ إِذْ نَفَشَتْ فِيهِ غَنَمُ ٱلْقَوْمِ وَكُنَّا لِحُكْمِهِمْ شَٰهِدِينَ ", "translation": "And [mention] David and Solomon, when they judged concerning the field - when the sheep of a people overran it [at night],[1] and We were witness to their judgement.", "words": [{"id": 1, "arabic": "وَدَاوُۥدَ", "translit": "َdۥُwāَdَw", "root": ""}, {"id": 2, "arabic": "وَسُلَيْمَٰنَ", "translit": "َnَٰmْyَlُsَw", "root": ""}, {"id": 3, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 4, "arabic": "يَحْكُمَانِ", "translit": "ِnāَmُkْḥَy", "root": "حكم"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلْحَرْثِ", "translit": "ِhtْrَḥْlٱ", "root": "حرث"}, {"id": 7, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 8, "arabic": "نَفَشَتْ", "translit": "ْtَhsَfَn", "root": "نفش"}, {"id": 9, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 10, "arabic": "غَنَمُ", "translit": "ُmَnَغ", "root": "غنم"}, {"id": 11, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 12, "arabic": "وَكُنَّا", "translit": "āَّnُkَw", "root": "كون"}, {"id": 13, "arabic": "لِحُكْمِهِمْ", "translit": "ْmِhِmْkُḥِl", "root": "حكم"}, {"id": 14, "arabic": "شَٰهِدِينَ", "translit": "َnyِdِhَٰhs", "root": "شهد"}], "hasIhya": false}, {"ayah": 79, "text": "فَفَهَّمْنَٰهَا سُلَيْمَٰنَۚ وَكُلًّا ءَاتَيْنَا حُكْمًا وَعِلْمًاۚ وَسَخَّرْنَا مَعَ دَاوُۥدَ ٱلْجِبَالَ يُسَبِّحْنَ وَٱلطَّيْرَۚ وَكُنَّا فَٰعِلِينَ ", "translation": "And We gave understanding of it [i.e., the case] to Solomon, and to each [of them] We gave judgement and knowledge. And We subjected the mountains to exalt [Us], along with David and [also] the birds. And We were doing [that].[1]", "words": [{"id": 1, "arabic": "فَفَهَّمْنَٰهَا", "translit": "āَhَٰnْmَّhَfَf", "root": "فهم"}, {"id": 2, "arabic": "سُلَيْمَٰنَ", "translit": "َnَٰmْyَlُs", "root": ""}, {"id": 3, "arabic": "وَكُلًّا", "translit": "āًّlُkَw", "root": "كلل"}, {"id": 4, "arabic": "ءَاتَيْنَا", "translit": "āَnْyَtāَء", "root": "اتي"}, {"id": 5, "arabic": "حُكْمًا", "translit": "āًmْkُḥ", "root": "حكم"}, {"id": 6, "arabic": "وَعِلْمًا", "translit": "āًmْlِʿعَw", "root": "علم"}, {"id": 7, "arabic": "وَسَخَّرْنَا", "translit": "āَnْrَّhkَsَw", "root": "سخر"}, {"id": 8, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 9, "arabic": "دَاوُۥدَ", "translit": "َdۥُwāَd", "root": ""}, {"id": 10, "arabic": "ٱلْجِبَالَ", "translit": "َlāَbِjgْlٱ", "root": "جبل"}, {"id": 11, "arabic": "يُسَبِّحْنَ", "translit": "َnْḥِّbَsُy", "root": "سبح"}, {"id": 12, "arabic": "وَٱلطَّيْرَ", "translit": "َrْyَّṭlٱَw", "root": "طير"}, {"id": 13, "arabic": "وَكُنَّا", "translit": "āَّnُkَw", "root": "كون"}, {"id": 14, "arabic": "فَٰعِلِينَ", "translit": "َnyِlِʿعَٰf", "root": "فعل"}], "hasIhya": true}, {"ayah": 80, "text": "وَعَلَّمْنَٰهُ صَنْعَةَ لَبُوسٍ لَّكُمْ لِتُحْصِنَكُم مِّنۢ بَأْسِكُمْۖ فَهَلْ أَنتُمْ شَٰكِرُونَ ", "translation": "And We taught him the fashioning of coats of armor to protect you from your [enemy in] battle. So will you then be grateful?", "words": [{"id": 1, "arabic": "وَعَلَّمْنَٰهُ", "translit": "ُhَٰnْmَّlَʿعَw", "root": "علم"}, {"id": 2, "arabic": "صَنْعَةَ", "translit": "َẗَʿعْnَṣ", "root": "صنع"}, {"id": 3, "arabic": "لَبُوسٍ", "translit": "ٍswُbَl", "root": "لبس"}, {"id": 4, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 5, "arabic": "لِتُحْصِنَكُم", "translit": "mُkَnِṣْḥُtِl", "root": "حصن"}, {"id": 6, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 7, "arabic": "بَأْسِكُمْ", "translit": "ْmُkِsْaʾَb", "root": "باس"}, {"id": 8, "arabic": "فَهَلْ", "translit": "ْlَhَf", "root": ""}, {"id": 9, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 10, "arabic": "شَٰكِرُونَ", "translit": "َnwُrِkَٰhs", "root": "شكر"}], "hasIhya": false}, {"ayah": 81, "text": "وَلِسُلَيْمَٰنَ ٱلرِّيحَ عَاصِفَةً تَجْرِى بِأَمْرِهِۦٓ إِلَى ٱلْأَرْضِ ٱلَّتِى بَٰرَكْنَا فِيهَاۚ وَكُنَّا بِكُلِّ شَىْءٍ عَٰلِمِينَ ", "translation": "And to Solomon [We subjected] the wind, blowing forcefully, proceeding by his command toward the land which We had blessed. And We are ever, of all things, Knowing.", "words": [{"id": 1, "arabic": "وَلِسُلَيْمَٰنَ", "translit": "َnَٰmْyَlُsِlَw", "root": ""}, {"id": 2, "arabic": "ٱلرِّيحَ", "translit": "َḥyِّrlٱ", "root": "روح"}, {"id": 3, "arabic": "عَاصِفَةً", "translit": "ًẗَfِṣāَʿع", "root": "عصف"}, {"id": 4, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 5, "arabic": "بِأَمْرِهِۦٓ", "translit": "ٓۦِhِrْmَaʾِb", "root": "امر"}, {"id": 6, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 9, "arabic": "بَٰرَكْنَا", "translit": "āَnْkَrَٰb", "root": "برك"}, {"id": 10, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 11, "arabic": "وَكُنَّا", "translit": "āَّnُkَw", "root": "كون"}, {"id": 12, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 13, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 14, "arabic": "عَٰلِمِينَ", "translit": "َnyِmِlَٰʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 82, "text": "وَمِنَ ٱلشَّيَٰطِينِ مَن يَغُوصُونَ لَهُۥ وَيَعْمَلُونَ عَمَلًا دُونَ ذَٰلِكَۖ وَكُنَّا لَهُمْ حَٰفِظِينَ ", "translation": "And of the devils [i.e., jinn] were those who dived for him and did work other than that. And We were of them a guardian.[1]", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 2, "arabic": "ٱلشَّيَٰطِينِ", "translit": "ِnyِṭَٰyَّhslٱ", "root": "شطن"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "يَغُوصُونَ", "translit": "َnwُṣwُغَy", "root": "غوص"}, {"id": 5, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 6, "arabic": "وَيَعْمَلُونَ", "translit": "َnwُlَmْʿعَyَw", "root": "عمل"}, {"id": 7, "arabic": "عَمَلًا", "translit": "āًlَmَʿع", "root": "عمل"}, {"id": 8, "arabic": "دُونَ", "translit": "َnwُd", "root": "دون"}, {"id": 9, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 10, "arabic": "وَكُنَّا", "translit": "āَّnُkَw", "root": "كون"}, {"id": 11, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 12, "arabic": "حَٰفِظِينَ", "translit": "َnyِẓِfَٰḥ", "root": "حفظ"}], "hasIhya": false}, {"ayah": 83, "text": "وَأَيُّوبَ إِذْ نَادَىٰ رَبَّهُۥٓ أَنِّى مَسَّنِىَ ٱلضُّرُّ وَأَنتَ أَرْحَمُ ٱلرَّٰحِمِينَ ", "translation": "And [mention] Job, when he called to his Lord, \"Indeed, adversity has touched me, and You are the most merciful of the merciful.\"", "words": [{"id": 1, "arabic": "وَأَيُّوبَ", "translit": "َbwُّyَaʾَw", "root": ""}, {"id": 2, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 3, "arabic": "نَادَىٰ", "translit": "ٰàَdāَn", "root": "ندي"}, {"id": 4, "arabic": "رَبَّهُۥٓ", "translit": "ٓۥُhَّbَr", "root": "ربب"}, {"id": 5, "arabic": "أَنِّى", "translit": "àِّnَaʾ", "root": ""}, {"id": 6, "arabic": "مَسَّنِىَ", "translit": "َàِnَّsَm", "root": "مسس"}, {"id": 7, "arabic": "ٱلضُّرُّ", "translit": "ُّrُّḍlٱ", "root": "ضرر"}, {"id": 8, "arabic": "وَأَنتَ", "translit": "َtnَaʾَw", "root": ""}, {"id": 9, "arabic": "أَرْحَمُ", "translit": "ُmَḥْrَaʾ", "root": "رحم"}, {"id": 10, "arabic": "ٱلرَّٰحِمِينَ", "translit": "َnyِmِḥَّٰrlٱ", "root": "رحم"}], "hasIhya": false}, {"ayah": 84, "text": "فَٱسْتَجَبْنَا لَهُۥ فَكَشَفْنَا مَا بِهِۦ مِن ضُرٍّۖ وَءَاتَيْنَٰهُ أَهْلَهُۥ وَمِثْلَهُم مَّعَهُمْ رَحْمَةً مِّنْ عِندِنَا وَذِكْرَىٰ لِلْعَٰبِدِينَ ", "translation": "So We responded to him and removed what afflicted him of adversity. And We gave him [back] his family and the like thereof with them as mercy from Us and a reminder for the worshippers [of Allāh].", "words": [{"id": 1, "arabic": "فَٱسْتَجَبْنَا", "translit": "āَnْbَjgَtْsٱَf", "root": "جوب"}, {"id": 2, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 3, "arabic": "فَكَشَفْنَا", "translit": "āَnْfَhsَkَf", "root": "كشف"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "ضُرٍّ", "translit": "ٍّrُḍ", "root": "ضرر"}, {"id": 8, "arabic": "وَءَاتَيْنَٰهُ", "translit": "ُhَٰnْyَtāَءَw", "root": "اتي"}, {"id": 9, "arabic": "أَهْلَهُۥ", "translit": "ۥُhَlْhَaʾ", "root": "اهل"}, {"id": 10, "arabic": "وَمِثْلَهُم", "translit": "mُhَlْhtِmَw", "root": "مثل"}, {"id": 11, "arabic": "مَّعَهُمْ", "translit": "ْmُhَʿعَّm", "root": ""}, {"id": 12, "arabic": "رَحْمَةً", "translit": "ًẗَmْḥَr", "root": "رحم"}, {"id": 13, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 14, "arabic": "عِندِنَا", "translit": "āَnِdnِʿع", "root": "عند"}, {"id": 15, "arabic": "وَذِكْرَىٰ", "translit": "ٰàَrْkِhdَw", "root": "ذكر"}, {"id": 16, "arabic": "لِلْعَٰبِدِينَ", "translit": "َnyِdِbَٰʿعْlِl", "root": "عبد"}], "hasIhya": true}, {"ayah": 85, "text": "وَإِسْمَٰعِيلَ وَإِدْرِيسَ وَذَا ٱلْكِفْلِۖ كُلٌّ مِّنَ ٱلصَّٰبِرِينَ ", "translation": "And [mention] Ishmael and Idrees and Dhul-Kifl; all were of the patient.", "words": [{"id": 1, "arabic": "وَإِسْمَٰعِيلَ", "translit": "َlyِʿعَٰmْsِiʾَw", "root": ""}, {"id": 2, "arabic": "وَإِدْرِيسَ", "translit": "َsyِrْdِiʾَw", "root": ""}, {"id": 3, "arabic": "وَذَا", "translit": "āَhdَw", "root": ""}, {"id": 4, "arabic": "ٱلْكِفْلِ", "translit": "ِlْfِkْlٱ", "root": "كفل"}, {"id": 5, "arabic": "كُلٌّ", "translit": "ٌّlُk", "root": "كلل"}, {"id": 6, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 7, "arabic": "ٱلصَّٰبِرِينَ", "translit": "َnyِrِbَّٰṣlٱ", "root": "صبر"}], "hasIhya": false}, {"ayah": 86, "text": "وَأَدْخَلْنَٰهُمْ فِى رَحْمَتِنَآۖ إِنَّهُم مِّنَ ٱلصَّٰلِحِينَ ", "translation": "And We admitted them into Our mercy. Indeed, they were of the righteous.", "words": [{"id": 1, "arabic": "وَأَدْخَلْنَٰهُمْ", "translit": "ْmُhَٰnْlَhkْdَaʾَw", "root": "دخل"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "رَحْمَتِنَآ", "translit": "ٓāَnِtَmْḥَr", "root": "رحم"}, {"id": 4, "arabic": "إِنَّهُم", "translit": "mُhَّnِiʾ", "root": ""}, {"id": 5, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 6, "arabic": "ٱلصَّٰلِحِينَ", "translit": "َnyِḥِlَّٰṣlٱ", "root": "صلح"}], "hasIhya": false}, {"ayah": 87, "text": "وَذَا ٱلنُّونِ إِذ ذَّهَبَ مُغَٰضِبًا فَظَنَّ أَن لَّن نَّقْدِرَ عَلَيْهِ فَنَادَىٰ فِى ٱلظُّلُمَٰتِ أَن لَّآ إِلَٰهَ إِلَّآ أَنتَ سُبْحَٰنَكَ إِنِّى كُنتُ مِنَ ٱلظَّٰلِمِينَ ", "translation": "And [mention] the man of the fish [i.e., Jonah], when he went off in anger[1] and thought that We would not decree [anything] upon him.[2] And he called out within the darknesses,[3] \"There is no deity except You; exalted are You. Indeed, I have been of the wrongdoers.\"", "words": [{"id": 1, "arabic": "وَذَا", "translit": "āَhdَw", "root": ""}, {"id": 2, "arabic": "ٱلنُّونِ", "translit": "ِnwُّnlٱ", "root": "نون"}, {"id": 3, "arabic": "إِذ", "translit": "hdِiʾ", "root": ""}, {"id": 4, "arabic": "ذَّهَبَ", "translit": "َbَhَّhd", "root": "ذهب"}, {"id": 5, "arabic": "مُغَٰضِبًا", "translit": "āًbِḍَٰغُm", "root": "غضب"}, {"id": 6, "arabic": "فَظَنَّ", "translit": "َّnَẓَf", "root": "ظنن"}, {"id": 7, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 8, "arabic": "لَّن", "translit": "nَّl", "root": ""}, {"id": 9, "arabic": "نَّقْدِرَ", "translit": "َrِdْqَّn", "root": "قدر"}, {"id": 10, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 11, "arabic": "فَنَادَىٰ", "translit": "ٰàَdāَnَf", "root": "ندي"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ٱلظُّلُمَٰتِ", "translit": "ِtَٰmُlُّẓlٱ", "root": "ظلم"}, {"id": 14, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 15, "arabic": "لَّآ", "translit": "ٓāَّl", "root": ""}, {"id": 16, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 17, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 18, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 19, "arabic": "سُبْحَٰنَكَ", "translit": "َkَnَٰḥْbُs", "root": "سبح"}, {"id": 20, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 21, "arabic": "كُنتُ", "translit": "ُtnُk", "root": "كون"}, {"id": 22, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 23, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": true}, {"ayah": 88, "text": "فَٱسْتَجَبْنَا لَهُۥ وَنَجَّيْنَٰهُ مِنَ ٱلْغَمِّۚ وَكَذَٰلِكَ نُۨجِى ٱلْمُؤْمِنِينَ ", "translation": "So We responded to him and saved him from the distress. And thus do We save the believers.", "words": [{"id": 1, "arabic": "فَٱسْتَجَبْنَا", "translit": "āَnْbَjgَtْsٱَf", "root": "جوب"}, {"id": 2, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 3, "arabic": "وَنَجَّيْنَٰهُ", "translit": "ُhَٰnْyَّjgَnَw", "root": "نجو"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱلْغَمِّ", "translit": "ِّmَغْlٱ", "root": "غمم"}, {"id": 6, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 7, "arabic": "نُۨجِى", "translit": "àِjgُۨn", "root": "نجو"}, {"id": 8, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}], "hasIhya": false}, {"ayah": 89, "text": "وَزَكَرِيَّآ إِذْ نَادَىٰ رَبَّهُۥ رَبِّ لَا تَذَرْنِى فَرْدًا وَأَنتَ خَيْرُ ٱلْوَٰرِثِينَ ", "translation": "And [mention] Zechariah, when he called to his Lord, \"My Lord, do not leave me alone [with no heir], while You are the best of inheritors.\"", "words": [{"id": 1, "arabic": "وَزَكَرِيَّآ", "translit": "ٓāَّyِrَkَzَw", "root": ""}, {"id": 2, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 3, "arabic": "نَادَىٰ", "translit": "ٰàَdāَn", "root": "ندي"}, {"id": 4, "arabic": "رَبَّهُۥ", "translit": "ۥُhَّbَr", "root": "ربب"}, {"id": 5, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "تَذَرْنِى", "translit": "àِnْrَhdَt", "root": "وذر"}, {"id": 8, "arabic": "فَرْدًا", "translit": "āًdْrَf", "root": "فرد"}, {"id": 9, "arabic": "وَأَنتَ", "translit": "َtnَaʾَw", "root": ""}, {"id": 10, "arabic": "خَيْرُ", "translit": "ُrْyَhk", "root": "خير"}, {"id": 11, "arabic": "ٱلْوَٰرِثِينَ", "translit": "َnyِhtِrَٰwْlٱ", "root": "ورث"}], "hasIhya": false}, {"ayah": 90, "text": "فَٱسْتَجَبْنَا لَهُۥ وَوَهَبْنَا لَهُۥ يَحْيَىٰ وَأَصْلَحْنَا لَهُۥ زَوْجَهُۥٓۚ إِنَّهُمْ كَانُوا۟ يُسَٰرِعُونَ فِى ٱلْخَيْرَٰتِ وَيَدْعُونَنَا رَغَبًا وَرَهَبًاۖ وَكَانُوا۟ لَنَا خَٰشِعِينَ ", "translation": "So We responded to him, and We gave to him John, and amended for him his wife. Indeed, they used to hasten to good deeds and supplicate[1] Us in hope and fear, and they were to Us humbly submissive.", "words": [{"id": 1, "arabic": "فَٱسْتَجَبْنَا", "translit": "āَnْbَjgَtْsٱَf", "root": "جوب"}, {"id": 2, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 3, "arabic": "وَوَهَبْنَا", "translit": "āَnْbَhَwَw", "root": "وهب"}, {"id": 4, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 5, "arabic": "يَحْيَىٰ", "translit": "ٰàَyْḥَy", "root": "حيي"}, {"id": 6, "arabic": "وَأَصْلَحْنَا", "translit": "āَnْḥَlْṣَaʾَw", "root": "صلح"}, {"id": 7, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 8, "arabic": "زَوْجَهُۥٓ", "translit": "ٓۥُhَjgْwَz", "root": "زوج"}, {"id": 9, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 10, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 11, "arabic": "يُسَٰرِعُونَ", "translit": "َnwُʿعِrَٰsُy", "root": "سرع"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ٱلْخَيْرَٰتِ", "translit": "ِtَٰrْyَhkْlٱ", "root": "خير"}, {"id": 14, "arabic": "وَيَدْعُونَنَا", "translit": "āَnَnwُʿعْdَyَw", "root": "دعو"}, {"id": 15, "arabic": "رَغَبًا", "translit": "āًbَغَr", "root": "رغب"}, {"id": 16, "arabic": "وَرَهَبًا", "translit": "āًbَhَrَw", "root": "رهب"}, {"id": 17, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 18, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 19, "arabic": "خَٰشِعِينَ", "translit": "َnyِʿعِhsَٰhk", "root": "خشع"}], "hasIhya": true}, {"ayah": 91, "text": "وَٱلَّتِىٓ أَحْصَنَتْ فَرْجَهَا فَنَفَخْنَا فِيهَا مِن رُّوحِنَا وَجَعَلْنَٰهَا وَٱبْنَهَآ ءَايَةً لِّلْعَٰلَمِينَ ", "translation": "And [mention] the one who guarded her chastity [i.e., Mary], so We blew into her [garment] through Our angel [i.e., Gabriel], and We made her and her son a sign for the worlds.", "words": [{"id": 1, "arabic": "وَٱلَّتِىٓ", "translit": "ٓàِtَّlٱَw", "root": ""}, {"id": 2, "arabic": "أَحْصَنَتْ", "translit": "ْtَnَṣْḥَaʾ", "root": "حصن"}, {"id": 3, "arabic": "فَرْجَهَا", "translit": "āَhَjgْrَf", "root": "فرج"}, {"id": 4, "arabic": "فَنَفَخْنَا", "translit": "āَnْhkَfَnَf", "root": "نفخ"}, {"id": 5, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "رُّوحِنَا", "translit": "āَnِḥwُّr", "root": "روح"}, {"id": 8, "arabic": "وَجَعَلْنَٰهَا", "translit": "āَhَٰnْlَʿعَjgَw", "root": "جعل"}, {"id": 9, "arabic": "وَٱبْنَهَآ", "translit": "ٓāَhَnْbٱَw", "root": "بني"}, {"id": 10, "arabic": "ءَايَةً", "translit": "ًẗَyāَء", "root": "ايي"}, {"id": 11, "arabic": "لِّلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlِّl", "root": "علم"}], "hasIhya": true}, {"ayah": 92, "text": "إِنَّ هَٰذِهِۦٓ أُمَّتُكُمْ أُمَّةً وَٰحِدَةً وَأَنَا۠ رَبُّكُمْ فَٱعْبُدُونِ ", "translation": "Indeed this, your religion, is one religion,[1] and I am your Lord, so worship Me.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "هَٰذِهِۦٓ", "translit": "ٓۦِhِhdَٰh", "root": ""}, {"id": 3, "arabic": "أُمَّتُكُمْ", "translit": "ْmُkُtَّmُaʾ", "root": "امم"}, {"id": 4, "arabic": "أُمَّةً", "translit": "ًẗَّmُaʾ", "root": "امم"}, {"id": 5, "arabic": "وَٰحِدَةً", "translit": "ًẗَdِḥَٰw", "root": "وحد"}, {"id": 6, "arabic": "وَأَنَا۠", "translit": "۠āَnَaʾَw", "root": ""}, {"id": 7, "arabic": "رَبُّكُمْ", "translit": "ْmُkُّbَr", "root": "ربب"}, {"id": 8, "arabic": "فَٱعْبُدُونِ", "translit": "ِnwُdُbْʿعٱَf", "root": "عبد"}], "hasIhya": false}, {"ayah": 93, "text": "وَتَقَطَّعُوٓا۟ أَمْرَهُم بَيْنَهُمْۖ كُلٌّ إِلَيْنَا رَٰجِعُونَ ", "translation": "And [yet] they divided their affair [i.e., that of their religion] among themselves,[1] [but] all to Us will return.", "words": [{"id": 1, "arabic": "وَتَقَطَّعُوٓا۟", "translit": "۟āٓwُʿعَّṭَqَtَw", "root": "قطع"}, {"id": 2, "arabic": "أَمْرَهُم", "translit": "mُhَrْmَaʾ", "root": "امر"}, {"id": 3, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 4, "arabic": "كُلٌّ", "translit": "ٌّlُk", "root": "كلل"}, {"id": 5, "arabic": "إِلَيْنَا", "translit": "āَnْyَlِiʾ", "root": ""}, {"id": 6, "arabic": "رَٰجِعُونَ", "translit": "َnwُʿعِjgَٰr", "root": "رجع"}], "hasIhya": false}, {"ayah": 94, "text": "فَمَن يَعْمَلْ مِنَ ٱلصَّٰلِحَٰتِ وَهُوَ مُؤْمِنٌ فَلَا كُفْرَانَ لِسَعْيِهِۦ وَإِنَّا لَهُۥ كَٰتِبُونَ ", "translation": "So whoever does righteous deeds while he is a believer - no denial will there be for his effort,[1] and indeed We [i.e., Our angels], of it, are recorders.", "words": [{"id": 1, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 2, "arabic": "يَعْمَلْ", "translit": "ْlَmْʿعَy", "root": "عمل"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 5, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 6, "arabic": "مُؤْمِنٌ", "translit": "ٌnِmْwʾُm", "root": "امن"}, {"id": 7, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 8, "arabic": "كُفْرَانَ", "translit": "َnāَrْfُk", "root": "كفر"}, {"id": 9, "arabic": "لِسَعْيِهِۦ", "translit": "ۦِhِyْʿعَsِl", "root": "سعي"}, {"id": 10, "arabic": "وَإِنَّا", "translit": "āَّnِiʾَw", "root": ""}, {"id": 11, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 12, "arabic": "كَٰتِبُونَ", "translit": "َnwُbِtَٰk", "root": "كتب"}], "hasIhya": false}, {"ayah": 95, "text": "وَحَرَٰمٌ عَلَىٰ قَرْيَةٍ أَهْلَكْنَٰهَآ أَنَّهُمْ لَا يَرْجِعُونَ ", "translation": "And it is prohibited to [the people of] a city which We have destroyed that they will [ever] return[1]", "words": [{"id": 1, "arabic": "وَحَرَٰمٌ", "translit": "ٌmَٰrَḥَw", "root": "حرم"}, {"id": 2, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 3, "arabic": "قَرْيَةٍ", "translit": "ٍẗَyْrَq", "root": "قري"}, {"id": 4, "arabic": "أَهْلَكْنَٰهَآ", "translit": "ٓāَhَٰnْkَlْhَaʾ", "root": "هلك"}, {"id": 5, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يَرْجِعُونَ", "translit": "َnwُʿعِjgْrَy", "root": "رجع"}], "hasIhya": false}, {"ayah": 96, "text": "حَتَّىٰٓ إِذَا فُتِحَتْ يَأْجُوجُ وَمَأْجُوجُ وَهُم مِّن كُلِّ حَدَبٍ يَنسِلُونَ ", "translation": "Until when [the dam of] Gog and Magog has been opened and they, from every elevation, descend", "words": [{"id": 1, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "فُتِحَتْ", "translit": "ْtَḥِtُf", "root": "فتح"}, {"id": 4, "arabic": "يَأْجُوجُ", "translit": "ُjgwُjgْaʾَy", "root": ""}, {"id": 5, "arabic": "وَمَأْجُوجُ", "translit": "ُjgwُjgْaʾَmَw", "root": ""}, {"id": 6, "arabic": "وَهُم", "translit": "mُhَw", "root": ""}, {"id": 7, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 8, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 9, "arabic": "حَدَبٍ", "translit": "ٍbَdَḥ", "root": "حدب"}, {"id": 10, "arabic": "يَنسِلُونَ", "translit": "َnwُlِsnَy", "root": "نسل"}], "hasIhya": false}, {"ayah": 97, "text": "وَٱقْتَرَبَ ٱلْوَعْدُ ٱلْحَقُّ فَإِذَا هِىَ شَٰخِصَةٌ أَبْصَٰرُ ٱلَّذِينَ كَفَرُوا۟ يَٰوَيْلَنَا قَدْ كُنَّا فِى غَفْلَةٍ مِّنْ هَٰذَا بَلْ كُنَّا ظَٰلِمِينَ ", "translation": "And [when] the true promise [i.e., the resurrection] has approached; then suddenly the eyes of those who disbelieved will be staring [in horror, while they say], \"O woe to us; we had been unmindful of this; rather, we were wrongdoers.\"", "words": [{"id": 1, "arabic": "وَٱقْتَرَبَ", "translit": "َbَrَtْqٱَw", "root": "قرب"}, {"id": 2, "arabic": "ٱلْوَعْدُ", "translit": "ُdْʿعَwْlٱ", "root": "وعد"}, {"id": 3, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 4, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 5, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 6, "arabic": "شَٰخِصَةٌ", "translit": "ٌẗَṣِhkَٰhs", "root": "شخص"}, {"id": 7, "arabic": "أَبْصَٰرُ", "translit": "ُrَٰṣْbَaʾ", "root": "بصر"}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 10, "arabic": "يَٰوَيْلَنَا", "translit": "āَnَlْyَwَٰy", "root": ""}, {"id": 11, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 12, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "غَفْلَةٍ", "translit": "ٍẗَlْfَغ", "root": "غفل"}, {"id": 15, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 16, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 17, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 18, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 19, "arabic": "ظَٰلِمِينَ", "translit": "َnyِmِlَٰẓ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 98, "text": "إِنَّكُمْ وَمَا تَعْبُدُونَ مِن دُونِ ٱللَّهِ حَصَبُ جَهَنَّمَ أَنتُمْ لَهَا وَٰرِدُونَ ", "translation": "Indeed, you [disbelievers] and what you worship other than Allāh are the firewood of Hell. You will be coming to [enter] it.", "words": [{"id": 1, "arabic": "إِنَّكُمْ", "translit": "ْmُkَّnِiʾ", "root": ""}, {"id": 2, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 3, "arabic": "تَعْبُدُونَ", "translit": "َnwُdُbْʿعَt", "root": "عبد"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "حَصَبُ", "translit": "ُbَṣَḥ", "root": "حصب"}, {"id": 8, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 9, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 10, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 11, "arabic": "وَٰرِدُونَ", "translit": "َnwُdِrَٰw", "root": "ورد"}], "hasIhya": false}, {"ayah": 99, "text": "لَوْ كَانَ هَٰٓؤُلَآءِ ءَالِهَةً مَّا وَرَدُوهَاۖ وَكُلٌّ فِيهَا خَٰلِدُونَ ", "translation": "Had these [false deities] been [actual] gods, they would not have come to it, but all are eternal therein.", "words": [{"id": 1, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 4, "arabic": "ءَالِهَةً", "translit": "ًẗَhِlāَء", "root": "اله"}, {"id": 5, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 6, "arabic": "وَرَدُوهَا", "translit": "āَhwُdَrَw", "root": "ورد"}, {"id": 7, "arabic": "وَكُلٌّ", "translit": "ٌّlُkَw", "root": "كلل"}, {"id": 8, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 9, "arabic": "خَٰلِدُونَ", "translit": "َnwُdِlَٰhk", "root": "خلد"}], "hasIhya": false}, {"ayah": 100, "text": "لَهُمْ فِيهَا زَفِيرٌ وَهُمْ فِيهَا لَا يَسْمَعُونَ ", "translation": "For them therein is heavy sighing, and they therein will not hear.", "words": [{"id": 1, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "زَفِيرٌ", "translit": "ٌryِfَz", "root": "زفر"}, {"id": 4, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 5, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يَسْمَعُونَ", "translit": "َnwُʿعَmْsَy", "root": "سمع"}], "hasIhya": false}, {"ayah": 101, "text": "إِنَّ ٱلَّذِينَ سَبَقَتْ لَهُم مِّنَّا ٱلْحُسْنَىٰٓ أُو۟لَٰٓئِكَ عَنْهَا مُبْعَدُونَ ", "translation": "Indeed, those for whom the best [reward] has preceded from Us - they are from it far removed.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "سَبَقَتْ", "translit": "ْtَqَbَs", "root": "سبق"}, {"id": 4, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 5, "arabic": "مِّنَّا", "translit": "āَّnِّm", "root": ""}, {"id": 6, "arabic": "ٱلْحُسْنَىٰٓ", "translit": "ٰٓàَnْsُḥْlٱ", "root": "حسن"}, {"id": 7, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 8, "arabic": "عَنْهَا", "translit": "āَhْnَʿع", "root": ""}, {"id": 9, "arabic": "مُبْعَدُونَ", "translit": "َnwُdَʿعْbُm", "root": "بعد"}], "hasIhya": true}, {"ayah": 102, "text": "لَا يَسْمَعُونَ حَسِيسَهَاۖ وَهُمْ فِى مَا ٱشْتَهَتْ أَنفُسُهُمْ خَٰلِدُونَ ", "translation": "They will not hear its sound, while they are, in that which their souls desire, abiding eternally.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "يَسْمَعُونَ", "translit": "َnwُʿعَmْsَy", "root": "سمع"}, {"id": 3, "arabic": "حَسِيسَهَا", "translit": "āَhَsyِsَḥ", "root": "حسس"}, {"id": 4, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "ٱشْتَهَتْ", "translit": "ْtَhَtْhsٱ", "root": "شهو"}, {"id": 8, "arabic": "أَنفُسُهُمْ", "translit": "ْmُhُsُfnَaʾ", "root": "نفس"}, {"id": 9, "arabic": "خَٰلِدُونَ", "translit": "َnwُdِlَٰhk", "root": "خلد"}], "hasIhya": false}, {"ayah": 103, "text": "لَا يَحْزُنُهُمُ ٱلْفَزَعُ ٱلْأَكْبَرُ وَتَتَلَقَّىٰهُمُ ٱلْمَلَٰٓئِكَةُ هَٰذَا يَوْمُكُمُ ٱلَّذِى كُنتُمْ تُوعَدُونَ ", "translation": "They will not be grieved by the greatest terror,[1] and the angels will meet them, [saying], \"This is your Day which you have been promised\" -", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "يَحْزُنُهُمُ", "translit": "ُmُhُnُzْḥَy", "root": "حزن"}, {"id": 3, "arabic": "ٱلْفَزَعُ", "translit": "ُʿعَzَfْlٱ", "root": "فزع"}, {"id": 4, "arabic": "ٱلْأَكْبَرُ", "translit": "ُrَbْkَaʾْlٱ", "root": "كبر"}, {"id": 5, "arabic": "وَتَتَلَقَّىٰهُمُ", "translit": "ُmُhٰàَّqَlَtَtَw", "root": "لقي"}, {"id": 6, "arabic": "ٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 7, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 8, "arabic": "يَوْمُكُمُ", "translit": "ُmُkُmْwَy", "root": "يوم"}, {"id": 9, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 11, "arabic": "تُوعَدُونَ", "translit": "َnwُdَʿعwُt", "root": "وعد"}], "hasIhya": false}, {"ayah": 104, "text": "يَوْمَ نَطْوِى ٱلسَّمَآءَ كَطَىِّ ٱلسِّجِلِّ لِلْكُتُبِۚ كَمَا بَدَأْنَآ أَوَّلَ خَلْقٍ نُّعِيدُهُۥۚ وَعْدًا عَلَيْنَآۚ إِنَّا كُنَّا فَٰعِلِينَ ", "translation": "The Day when We will fold the heaven like the folding of a [written] sheet for the records. As We began the first creation, We will repeat it. [That is] a promise binding upon Us. Indeed, We will do it.[1]", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "نَطْوِى", "translit": "àِwْṭَn", "root": "طوي"}, {"id": 3, "arabic": "ٱلسَّمَآءَ", "translit": "َءٓāَmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "كَطَىِّ", "translit": "ِّàَṭَk", "root": "طوي"}, {"id": 5, "arabic": "ٱلسِّجِلِّ", "translit": "ِّlِjgِّslٱ", "root": "سجل"}, {"id": 6, "arabic": "لِلْكُتُبِ", "translit": "ِbُtُkْlِl", "root": "كتب"}, {"id": 7, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 8, "arabic": "بَدَأْنَآ", "translit": "ٓāَnْaʾَdَb", "root": "بدا"}, {"id": 9, "arabic": "أَوَّلَ", "translit": "َlَّwَaʾ", "root": "اول"}, {"id": 10, "arabic": "خَلْقٍ", "translit": "ٍqْlَhk", "root": "خلق"}, {"id": 11, "arabic": "نُّعِيدُهُۥ", "translit": "ۥُhُdyِʿعُّn", "root": "عود"}, {"id": 12, "arabic": "وَعْدًا", "translit": "āًdْʿعَw", "root": "وعد"}, {"id": 13, "arabic": "عَلَيْنَآ", "translit": "ٓāَnْyَlَʿع", "root": ""}, {"id": 14, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 15, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 16, "arabic": "فَٰعِلِينَ", "translit": "َnyِlِʿعَٰf", "root": "فعل"}], "hasIhya": true}, {"ayah": 105, "text": "وَلَقَدْ كَتَبْنَا فِى ٱلزَّبُورِ مِنۢ بَعْدِ ٱلذِّكْرِ أَنَّ ٱلْأَرْضَ يَرِثُهَا عِبَادِىَ ٱلصَّٰلِحُونَ ", "translation": "And We have already written in the book [of Psalms][1] after the [previous] mention[2] that the land [of Paradise] is inherited by My righteous servants.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "كَتَبْنَا", "translit": "āَnْbَtَk", "root": "كتب"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلزَّبُورِ", "translit": "ِrwُbَّzlٱ", "root": "زبر"}, {"id": 5, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 6, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 7, "arabic": "ٱلذِّكْرِ", "translit": "ِrْkِّhdlٱ", "root": "ذكر"}, {"id": 8, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 9, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 10, "arabic": "يَرِثُهَا", "translit": "āَhُhtِrَy", "root": "ورث"}, {"id": 11, "arabic": "عِبَادِىَ", "translit": "َàِdāَbِʿع", "root": "عبد"}, {"id": 12, "arabic": "ٱلصَّٰلِحُونَ", "translit": "َnwُḥِlَّٰṣlٱ", "root": "صلح"}], "hasIhya": false}, {"ayah": 106, "text": "إِنَّ فِى هَٰذَا لَبَلَٰغًا لِّقَوْمٍ عَٰبِدِينَ ", "translation": "Indeed, in this [Qur’ān] is notification for a worshipping people.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "لَبَلَٰغًا", "translit": "āًغَٰlَbَl", "root": "بلغ"}, {"id": 5, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 6, "arabic": "عَٰبِدِينَ", "translit": "َnyِdِbَٰʿع", "root": "عبد"}], "hasIhya": false}, {"ayah": 107, "text": "وَمَآ أَرْسَلْنَٰكَ إِلَّا رَحْمَةً لِّلْعَٰلَمِينَ ", "translation": "And We have not sent you, [O Muḥammad], except as a mercy to the worlds.", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَٰكَ", "translit": "َkَٰnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "رَحْمَةً", "translit": "ًẗَmْḥَr", "root": "رحم"}, {"id": 5, "arabic": "لِّلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlِّl", "root": "علم"}], "hasIhya": false}, {"ayah": 108, "text": "قُلْ إِنَّمَا يُوحَىٰٓ إِلَىَّ أَنَّمَآ إِلَٰهُكُمْ إِلَٰهٌ وَٰحِدٌۖ فَهَلْ أَنتُم مُّسْلِمُونَ ", "translation": "Say, \"It is only revealed to me that your god is but one God; so will you be Muslims [in submission to Him]?\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 3, "arabic": "يُوحَىٰٓ", "translit": "ٰٓàَḥwُy", "root": "وحي"}, {"id": 4, "arabic": "إِلَىَّ", "translit": "َّàَlِiʾ", "root": ""}, {"id": 5, "arabic": "أَنَّمَآ", "translit": "ٓāَmَّnَaʾ", "root": ""}, {"id": 6, "arabic": "إِلَٰهُكُمْ", "translit": "ْmُkُhَٰlِiʾ", "root": "اله"}, {"id": 7, "arabic": "إِلَٰهٌ", "translit": "ٌhَٰlِiʾ", "root": "اله"}, {"id": 8, "arabic": "وَٰحِدٌ", "translit": "ٌdِḥَٰw", "root": "وحد"}, {"id": 9, "arabic": "فَهَلْ", "translit": "ْlَhَf", "root": ""}, {"id": 10, "arabic": "أَنتُم", "translit": "mُtnَaʾ", "root": ""}, {"id": 11, "arabic": "مُّسْلِمُونَ", "translit": "َnwُmِlْsُّm", "root": "سلم"}], "hasIhya": false}, {"ayah": 109, "text": "فَإِن تَوَلَّوْا۟ فَقُلْ ءَاذَنتُكُمْ عَلَىٰ سَوَآءٍۖ وَإِنْ أَدْرِىٓ أَقَرِيبٌ أَم بَعِيدٌ مَّا تُوعَدُونَ ", "translation": "But if they turn away, then say, \"I have announced to [all of] you equally.[1] And I know not whether near or far is that which you are promised.", "words": [{"id": 1, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 2, "arabic": "تَوَلَّوْا۟", "translit": "۟āْwَّlَwَt", "root": "ولي"}, {"id": 3, "arabic": "فَقُلْ", "translit": "ْlُqَf", "root": "قول"}, {"id": 4, "arabic": "ءَاذَنتُكُمْ", "translit": "ْmُkُtnَhdāَء", "root": "اذن"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "سَوَآءٍ", "translit": "ٍءٓāَwَs", "root": "سوي"}, {"id": 7, "arabic": "وَإِنْ", "translit": "ْnِiʾَw", "root": ""}, {"id": 8, "arabic": "أَدْرِىٓ", "translit": "ٓàِrْdَaʾ", "root": "دري"}, {"id": 9, "arabic": "أَقَرِيبٌ", "translit": "ٌbyِrَqَaʾ", "root": "قرب"}, {"id": 10, "arabic": "أَم", "translit": "mَaʾ", "root": ""}, {"id": 11, "arabic": "بَعِيدٌ", "translit": "ٌdyِʿعَb", "root": "بعد"}, {"id": 12, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 13, "arabic": "تُوعَدُونَ", "translit": "َnwُdَʿعwُt", "root": "وعد"}], "hasIhya": false}, {"ayah": 110, "text": "إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ مِنَ ٱلْقَوْلِ وَيَعْلَمُ مَا تَكْتُمُونَ ", "translation": "Indeed, He knows what is declared of speech, and He knows what you conceal.", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 3, "arabic": "ٱلْجَهْرَ", "translit": "َrْhَjgْlٱ", "root": "جهر"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱلْقَوْلِ", "translit": "ِlْwَqْlٱ", "root": "قول"}, {"id": 6, "arabic": "وَيَعْلَمُ", "translit": "ُmَlْʿعَyَw", "root": "علم"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "تَكْتُمُونَ", "translit": "َnwُmُtْkَt", "root": "كتم"}], "hasIhya": false}, {"ayah": 111, "text": "وَإِنْ أَدْرِى لَعَلَّهُۥ فِتْنَةٌ لَّكُمْ وَمَتَٰعٌ إِلَىٰ حِينٍ ", "translation": "And I know not; perhaps it[1] is a trial for you and enjoyment for a time.\"", "words": [{"id": 1, "arabic": "وَإِنْ", "translit": "ْnِiʾَw", "root": ""}, {"id": 2, "arabic": "أَدْرِى", "translit": "àِrْdَaʾ", "root": "دري"}, {"id": 3, "arabic": "لَعَلَّهُۥ", "translit": "ۥُhَّlَʿعَl", "root": ""}, {"id": 4, "arabic": "فِتْنَةٌ", "translit": "ٌẗَnْtِf", "root": "فتن"}, {"id": 5, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 6, "arabic": "وَمَتَٰعٌ", "translit": "ٌʿعَٰtَmَw", "root": "متع"}, {"id": 7, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 8, "arabic": "حِينٍ", "translit": "ٍnyِḥ", "root": "حين"}], "hasIhya": false}, {"ayah": 112, "text": "قَٰلَ رَبِّ ٱحْكُم بِٱلْحَقِّۗ وَرَبُّنَا ٱلرَّحْمَٰنُ ٱلْمُسْتَعَانُ عَلَىٰ مَا تَصِفُونَ ", "translation": "[The Prophet (ﷺ)] has said, \"My Lord, judge [between us] in truth. And our Lord is the Most Merciful, the one whose help is sought against that which you describe.\"[1]", "words": [{"id": 1, "arabic": "قَٰلَ", "translit": "َlَٰq", "root": "قول"}, {"id": 2, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 3, "arabic": "ٱحْكُم", "translit": "mُkْḥٱ", "root": "حكم"}, {"id": 4, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 5, "arabic": "وَرَبُّنَا", "translit": "āَnُّbَrَw", "root": "ربب"}, {"id": 6, "arabic": "ٱلرَّحْمَٰنُ", "translit": "ُnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 7, "arabic": "ٱلْمُسْتَعَانُ", "translit": "ُnāَʿعَtْsُmْlٱ", "root": "عون"}, {"id": 8, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "تَصِفُونَ", "translit": "َnwُfِṣَt", "root": "وصف"}], "hasIhya": false}], "tafsir": {"1": [{"arabic": "أما تتدبرين قوله تعالى اقترب للناس حسابهم وهم في غفلة معرضون ما يأتيهم من ذكر من ربهم محدث إلا استمعوه وهم يلعبون لاهية قلوبهم ويحك يا نفس إن كانت جراءتك على معصية الله لاعتقادك أن الله لا يراك فما أعظم كفرك وإن كان مع علمك باطلاعه عليك فما أشد وقاحتك وأقل حياءك ويحك يا نفس لو واجهك عبد من عبيدك بل أخ من إخوانك بما تكرهينه كيف كان غضبك عليه ومقتك له فبأى جسارة تتعرضين لمقت الله وغضبه وشديد عقابه أفتظنين أنك تطيقين عذابه هيهات هيهات جربى نفسك إن ألهاك البطر عن أليم عذابه فاحتبسى ساعة في الشمس أو ", "english": "Do you not contemplate His saying, the Exalted: 'The accounting of the people has drawn near while they are in heedlessness, turning away. No new Remembrance (Dhikr) comes to them from their Lord except they listen to it while they play, their Hearts (Qalb) distracted.' And woe to you, O Soul (Nafs)! If your boldness in disobeying Allah is due to your belief that Allah does not see you, then how great is your disbelief (Kufr)! And if it is with your knowledge of His awareness of you, then how severe is your insolence and how little your shame! Woe to you, O Soul (Nafs)! If a slave from your slaves, or rather a brother from your brothers, confronted you with what you dislike, how would your anger be upon him and your hatred for him? So with what audacity do you expose yourself to the hatred of Allah, His anger, and His severe punishment? Do you think you can bear His punishment? Far from it, far from it! Test yourself: if heedlessness distracts you from His painful punishment, then confine yourself for an hour in the sun, or in the bathhouse, or bring your finger near the fire to make clear the extent of your capacity. Are you deluded by the generosity of Allah and His bounty and His independence from your obedience and worship? So why do you not rely on the generosity of Allah, the Exalted, in the affairs of your worldly life? If an enemy intends you, why do you not devise means to repel him, nor entrust him to the generosity of Allah, the Exalted? And if a need for a desire from the desires of the worldly life, which does not end except with the dinar and dirham, overwhelms you, why do you exert the Spirit (Ruh) in seeking it and obtaining it through various means, not relying on the generosity of Allah, the Exalted, until He causes you to stumble upon a treasure or subjugates a slave from His slaves to carry your need to you without effort or seeking from you? Do you reckon that Allah is generous in the Hereafter but not in the worldly life? And you have known that the way of Allah has no change, and that the Lord of the Hereafter and the worldly life is One (Tawhid).", "book_file": "vol4_j4-k08.doc.txt", "book_title": "Monitoring and Accounting", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monitoring and Accounting'", "badge": "Insight"}, {"arabic": "وكان داخلا في معنى قوله عز وجل ﴿ ومنهم أميون لا يعلمون الكتاب إلا أمانيّ ﴾ {} يعني التلاوة المجردة وقوله عز وجل ﴿ وكأين من آية في السموات والأرض يمرون عليها وهم عنها معرضون ﴾ {} لأن القرآن هو المبين لتلك الآيات في السموات والأرض ومهما تجاوزها ولم يتأثر بها كان معرضا عنها ولذلك قيل: إن من لم يكن متصفا بأخلاق القرآن فإذا قرأ القرآن ناداه الله تعالى: مالك ولكلامي وأنت معرض عني دع عنك كلامي إن لم تتب إلي. ومثال العاصي إذا قرأ القرآن وكرره مثال من يكرر كتاب الملك في كل يوم مرات وقد كتب إليه في عمارة ", "english": "And he was included in the meaning of His Mighty and Majestic saying: 'And among them are unlettered ones who do not know the Book except [mere] wishes' meaning mere recitation, and His Mighty and Majestic saying: 'And how many a sign in the heavens and earth they pass over while they are turning away from it' because the Quran is the clarifier of those signs in the heavens and the earth, and whenever he passes over them and is not affected by them, he is turning away from them. Therefore, it is said: Indeed, whoever is not characterized by the morals of the Quran, then when he recites the Quran, Allah the Exalted calls to him: What is your affair with My speech while you are turning away from Me? Leave My speech if you do not repent to Me. And the example of the disobedient one when he recites the Quran and repeats it is like one who repeats the book of the king every day multiple times, while it has been written to him concerning the building of his kingdom, yet he is busy destroying it and restricts himself to studying his book. Perhaps if he left the study at the time of transgression, he would be farther from mockery and deserving of hatred. Therefore, Yusuf ibn Asbat said: Indeed, I intend to recite the Quran, but when I remember what is in it, I fear hatred, so I turn to glorification and seeking forgiveness. And the one turning away from acting upon it is intended by His Mighty and Majestic saying: 'So they threw it behind their backs and purchased with it a small price, so wretched...'", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Etiquette of Quran Recitation'", "badge": "Dhikr"}, {"arabic": "فقد قرب لما بعد الموت الرحيل فما بقي من العمر إلا القليل والخلق عنه غافلون ﴿ اقترب للناس حسابهم وهم في غفلة معرضون ﴾ {} ونحن نذكر ما يتعلق بالموت في شطرين:", "english": "Indeed, the departure for what is after death has drawn near, and what remains of life is but little, and the creation is heedless of it. 'The reckoning for the people has drawn near, while they are in heedlessness, turning away.' And we mention what pertains to death in two parts:", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Book of Repentance'", "badge": "Afterlife"}, {"arabic": "يَا أَيُّهَا الْإِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِيمِ حَيْثُ أُغْلِقَتِ الْأَبْوَابُ وَأُرْخِيَتِ السُّتُورُ وَاسْتَتَرْتَ عَنِ الْخَلَائِقِ فَقَارَفْتَ الْفُجُورَ فَمَاذَا تَفْعَلُ وَقَدْ شَهِدَتْ عَلَيْكَ جَوَارِحُكَ فَالْوَيْلُ كُلُّ الْوَيْلِ لَنَا مَعْشَرَ الْغَافِلِينَ يُرْسِلُ اللَّهُ لَنَا سَيِّدَ الْمُرْسَلِينَ وَيُنْزِلُ عَلَيْهِ الْكِتَابَ الْمُبِينَ وَيُخْبِرُنَا بِهَذِهِ الصِّفَاتِ مِنْ نُعُوتِ يَوْمِ الدِّينِ ثُمَّ يُعَرِّفُنَا غَفْلَتَنَا وَيَقُولُ: ﴿ اقْتَرَبَ لِلنَّاسِ حِسَ", "english": "O human being, what has deceived you concerning your Generous Lord (Rabb) when the doors were closed and the curtains were lowered and you concealed yourself from the creatures, so you committed immorality? So what will you do when your limbs have testified against you? So woe, all woe to us, the community of the heedless ones (al-ghāfilīn). Allah sends to us the master of the messengers and reveals to him the Clear Book (al-Kitāb al-Mubīn) and informs us of these attributes from the descriptions of the Day of Recompense (Yawm al-Dīn). Then He makes us aware of our heedlessness (ghafla) and says: 'The reckoning for the people has drawn near, while they are in heedlessness (ghafla), turning away.' Then He makes us aware of the nearness of the Hour (al-Sāʿa) and says: 'The Hour has drawn near and the moon has split. Indeed, they see it as distant, but We see it as near.' 'And what will make you know? Perhaps the Hour is near.' Then the best of our states is that we take the study of this Qur'an as an action, so we do not ponder its meanings, nor do we look at the multitude of descriptions and names of this Day, nor do we prepare to escape from its calamities. So we seek refuge in Allah from this heedlessness (ghafla) if Allah does not reach us with His vast mercy.", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Book of Repentance'", "badge": "General"}], "7": [{"arabic": "فإن قلت فقد قال الله تعالى: (فاسألوا أهل الذكر إن كنتم لا تعلمون( (النحل: 43). فالسؤال مأمور به فاعلم أنه كذلك ولكن فيما يأذن المعلم في السؤال عنه فإن السؤال عما لم تبلغ مرتبتك إلى فهمه مذموم ولذلك منع الخضر موسى عليه السلام من السؤال أي دع السؤال قبل أوانه فالمعلم أعلم بما أنت أهل له وبأوان الكشف وما لم يدخل أوان الكشف في كل درجة من مراقي الدرجات لا يدخل أوان السؤال عنه", "english": "If you say: Indeed Allah the Exalted has said: 'So ask the people of the Remembrance (Dhikr) if you do not know' (16:43). So asking is commanded. Know that it is indeed so, but only regarding what the teacher permits you to ask about. For asking about what your rank has not reached to understand is blameworthy. And for that reason, Al-Khidr prevented Moses, peace be upon them, from asking—meaning, leave the question before its proper time. For the teacher knows better what you are worthy of and the time of unveiling (Kashf). And what has not entered the time of unveiling in every degree of the ascending degrees, does not enter the time of questioning about it.", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "وأعظم نعمة الله على عباده هو العلم وكشف الحق والإيمان عبارة عن نوع كشف وعلم ولذلك قال تعالى امتنانا على عبده وكان فضل الله عليك عظيما وأراد به العلم وقال تعالى فاسألوا أهل الذكر إن كنتم لا تعلمون وقال تعالى إن علينا للهدى وقال ثم إن علينا بيانه وقال وعلى الله قصد السبيل", "english": "And the greatest blessing of Allah upon His servants is knowledge and the unveiling of truth, and faith is an expression of a type of unveiling and knowledge. Therefore, Allah said, as a favor upon His servant: 'And great is the favor of Allah upon you' (Quran 4:113), and He intended by it knowledge. And He said: 'So ask the people of the Remembrance (Dhikr) if you do not know' (Quran 21:7). And He said: 'Indeed, upon Us is guidance' (Quran 92:12). And He said: 'Then indeed, upon Us is its explanation' (Quran 75:19). And He said: 'And upon Allah is the direction of the path' (Quran 16:9).", "book_file": "vol4_j4-k08.doc.txt", "book_title": "Monitoring and Accounting", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monitoring and Accounting'", "badge": "Insight"}, {"arabic": "والمقصود أن من قصد الخير بمعصية عن جهل فهو غير معذور إلا إذا كان قريب العهد بالإسلام ولم يجد بعد مهلة للتعلم وقد قال الله سبحانه فاسئلوا أهل الذكر إن كنتم لا تعلمون وقال النبي صلى الله عليه وسلم (لا يعذر الجاهل على الجهل ولا يحل للجاهل أن يسكت على جهله ولا للعالم أن يسكت على علمه)[24]", "english": "The intended meaning is that whoever intends good through disobedience (ma'siyah) out of ignorance (jahl) is not excused except if he is newly converted to Islam and has not yet found an opportunity for learning. And Allah the Exalted has said: 'So ask the people of the Remembrance (Dhikr) if you do not know.' And the Prophet, peace and blessings be upon him, said: 'The ignorant one (al-jahil) is not excused for his ignorance, nor is it permissible for the ignorant one to remain silent about his ignorance, nor for the knowledgeable one to remain silent about his knowledge.'", "book_file": "vol4_j4-k07-old.doc.txt", "book_title": "Intention, Sincerity and Truthfulness", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Intention, Sincerity and Truthfulness'", "badge": "Dhikr"}, {"arabic": "وأما الآيات فقوله تعالى: ﴿فلولا نفر من كل فرقة منهم طائفة ليتفقهوا في الدين﴾ (سورة التوبة: الآية 122) وقوله عز وجل ﴿فاسألوا أهل الذكر إن كنتم لا تعلمون﴾ (سورة النحل: الآية 43، وسورة الأنبياء: الآية 7)", "english": "As for the verses, there is His saying, the Exalted: 'Why does not a group from every faction among them go forth to gain understanding in the religion?' (Surah At-Tawbah: Verse 122) and His saying, the Mighty and Majestic: 'So ask the people of the Remembrance (Dhikr) if you do not know.' (Surah An-Nahl: Verse 43, and Surah Al-Anbiya': Verse 7)", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}], "10": [{"arabic": "ولذلك قال تعالى ﴿ ما نثبت به فؤادك ﴾ {} فليقدر العبد أن الله ثبت فؤاده بما يقصه عليه من أحوال الأنبياء وصبرهم على الإيذاء وثباتهم في الدين لانتظار نصر الله تعالى وكيف لا يقدر هذا والقرآن ما أنزل على رسول الله ﭬ لرسول الله خاصة بل هو شفاء وهدى ورحمة ونور للعالمين ولذلك أمر الله تعالى الكافة بشكر نعمة الكتاب فقال تعالى ﴿ واذكروا نعمة الله عليكم وما أنزل عليكم من الكتاب والحكمة يعظكم به ﴾ {} وقال عز وجل ﴿ لقد أنزلنا إليكم كتابا فيه ذكركم أفلا تعقلون. وأنزلنا إليك الذكر لتبين للناس ما نزل إليهم. كذل", "english": "And therefore, Allah the Exalted said: 'What We strengthen with it your heart (Fūād)' {} So let the servant (ʿAbd) consider that Allah strengthened his heart (Fūād) with what He narrates to him of the conditions of the prophets and their patience upon harm and their steadfastness in the religion (Dīn) in anticipation of the victory of Allah the Exalted. And how can he not consider this when the Quran was not sent down upon the Messenger of Allah ﷺ for the Messenger of Allah specifically, but it is a healing (Shifāʾ) and guidance (Hudā) and mercy (Raḥmah) and light (Nūr) for the worlds. And therefore, Allah the Exalted commanded the entirety to be grateful for the blessing of the Book, so He the Exalted said: 'And remember the blessing of Allah upon you and what He sent down upon you of the Book and the wisdom He admonishes you with' {} And He the Mighty and Majestic said: 'Certainly, We have sent down to you a Book in which is your Remembrance (Dhikr). Then do you not reason? And We have sent down to you the Remembrance (Dhikr) that you may make clear to the people what was sent down to them. Thus does Allah strike for the people their examples. And follow the best of what was sent down to you from your Lord. This is insights for the people and guidance (Hudā) and mercy (Raḥmah) for a people who are certain. This is a clarification for the people and guidance (Hudā) and admonition (Mawʿiẓah) for the God-fearing (Muttaqīn).' {} And if the address is intended for all people, then the individuals are intended, so this single reader is intended, so what is for him and for the rest of the people, let him consider that he is the intended one. Allah the Exalted said: 'And it was revealed to me this Quran that I may warn you thereby and whoever it reaches' {} Muhammad ibn Kaʿb al-Quraẓī said: Whoever the Quran reaches him, it is as if Allah spoke to him. And if he considers that, he does not take studying the Quran as his work, but he reads it as the servant (ʿAbd) reads the book of his master (Mawlā) which he wrote to him to contemplate it and act according to its requirement.", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}], "18": [{"arabic": "وقال ابن مسعود رضي الله عنه: أنزل القرآن ليعمل به فاتخذتم دراسته عملا وسيأتي قوم يثقفونه مثل القناة ليسوا بخياركم والعالم الذي لا يعمل كالمريض الذي يصف الدواء وكالجائع الذي يصف لذائذ الأطعمة ولا يجدها وفي مثله قوله تعالى: (ولكم الويل مما تصفون( (الأنبياء: 18). وفي الخبر: (( إنما أخاف على أمتي زلة عالم وجدال منافق في القرآن))[163].", "english": "And Ibn Mas'ud (may Allah be pleased with him) said: The Quran was revealed to be acted upon, but you have taken its study as action. And there will come a people who will master it like a spear, but they are not the best of you. And the scholar who does not act is like the sick person who describes medicine, and like the hungry person who describes the delights of foods but does not find them. And in its likeness is His saying, the Exalted: 'And woe to you for what you describe' (Al-Anbiya: 18). And in the report: 'Indeed, I fear for my nation the slip of a scholar and the argumentation of a hypocrite regarding the Quran.'", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Book of Knowledge'", "badge": "General"}], "19": [{"arabic": "وما رزق تعالى الملائكة من القرب والرتبة لازم مستمر على حال واحد لا يزيد ولا ينقص لذلك أخبر الله عنهم أنهم قالوا: وما منا إلا له مقام معلوم، وفارق الإنسان الملائكة في الترقي من درجة إلى درجة فإنه لا يزال يتقرب إلى الله تعالى فيستفيد مزيد قربه وباب المزيد مسدود على الملائكة عليهم السلام وليس لكل واحد إلا رتبته التي هي وقف عليه وعبادته التي هو مشغول بها لا ينتقل إلى غيرها ولا يفتر عنها لا يستكبرون عن عبادته ولا يستحسرون يسبحون الليل والنهار لا يفترون ومفتاح مزيد الدرجات هي الصلوات.", "english": "And what Allah the Exalted has granted the angels of nearness (Qurb) and rank (Rutbah) is necessary, continuous, and in a single state that does not increase nor decrease. Therefore, Allah informed about them that they said: 'And there is none among us except that he has a known station.' And the human differs from the angels in ascending from one degree (Darajah) to another, for he continually draws near to Allah the Exalted and benefits from increased nearness (Mazīd Qurb), and the door of increase (Bāb al-Mazīd) is closed upon the angels, peace be upon them. And for each one there is only his rank (Rutbah) which is fixed upon him and his worship (ʿIbādah) which he is occupied with; he does not transfer to other than it nor does he cease from it. They do not grow arrogant (lā yastakbirūna) from worshipping Him, nor do they grow weary (lā yastaḥsirūna). They glorify night and day without ceasing. And the key to increased degrees (Mazīd al-Darajāt) is the prayers (Ṣalawāt).", "book_file": "vol1_Vol1-book-4.doc.txt", "book_title": "Mysteries of Prayer", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Mysteries of Prayer'", "badge": "Insight"}], "20": [{"arabic": "وقد وصف الله تعالى الملائكة عليهم السلام مع تقدسهم عن الذنوب ومواظبتهم على العبادات على الدءوب بالإشفاق فقال تعالى مخبراً عنهم \"يُسَبِّحُونَ اللَّيْلَ وَالنَّهَارَ لَا يَفْتُرُونَ وهم من خشيته مشفقون\" فمتى زال الإشفاق والحذر مما سبق به القضاء في الأزل - وينكشف عند خاتمة الأجل - غلب الأمن من مكر الله وذلك يوجب الكبر وهو سبب الهلاك.", "english": "And Allah the Exalted has described the angels, peace be upon them, with their sanctity from sins and their persistence in acts of worship (Ibadat) continuously, with apprehension (Ishfaq), so He the Exalted said, informing about them: \"They glorify (Yusabbihuna) the night and the day, they do not cease (La Yafturuna), and they are from fear (Khashya) of Him apprehensive (Mushfiqun).\" So when the apprehension (Ishfaq) and caution from what has preceded in the decree (Qada) in eternity (Al-Azal) - and is revealed at the conclusion of the term (Ajal) - is removed, security (Al-Amn) from the deception (Makr) of Allah prevails, and that necessitates arrogance (Kibr), which is the cause of destruction.", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}, {"arabic": "بل هم مجبولون على الطاعة ضي الله عنه ضي الله عنه عليه السلام ضي الله عنه ضي الله عنه ضي الله عنه لا مجال للمعصية في حقهم فلا جرم لا يعصون الله ما أمرهم ويفعلون ما يؤمرون ويسبحون الليل والنهار لا يفترون والراكع منهم راكع أبدا والساجد منهم ساجد أبدا والقائم قائم أبدا لا اختلاف في أفعالهم ولا فتور ولكل واحد مقام معلوم لا يتعداه وطاعتهم لله تعالى من حيث لا مجال للمخالفة فيهم يمكن أن تشبه بطاعة أطرافك لك، فإنك مهما جزمت الإرادة بفتح الأجفان لم يكن للجفن الصحيح تردد واختلاف في طاعتك مرة ومعصيتك أخرى ب", "english": "Rather, they are created upon obedience (Taa'ah) - may Allah be pleased with him, may Allah be pleased with him, peace be upon him, may Allah be pleased with him, may Allah be pleased with him, may Allah be pleased with him - there is no possibility for disobedience (Ma'siyah) in their case, so certainly they do not disobey Allah in what He commands them, and they do what they are commanded, and they glorify (Yusabbihuna) the night and the day without ceasing (La Yafturuna). And the one bowing (Raki') among them is bowing forever, and the one prostrating (Sajid) among them is prostrating forever, and the one standing (Qa'im) is standing forever - there is no difference in their actions and no cessation. And for each one is a known station (Maqam) which he does not exceed, and their obedience (Taa'ah) to Allah the Exalted, from where there is no possibility for opposition in them, can be likened to the obedience of your limbs to you. For whenever you resolve the will (Iradah) to open the eyelids, there is no hesitation or difference for the sound eyelid in obeying you once and disobeying you another time; rather, it is as if it awaits your command and prohibition, opening and closing continuously at your signal. This resembles it from one aspect but differs from another aspect, since the eyelid has no knowledge of what issues from it of movement, opening and closing, while the angels are living beings (Ahya') who know (Alimun) what they do.", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Patience and Gratitude'", "badge": "Dhikr"}, {"arabic": "ومما يكره: التظاهر بالحب، بسبب أن المحب إن كان عارفاً - وعرف أحوال الملائكة في حبهم الدائم وشوقهم اللازم الذي به يسبحون الليل والنهار لا يفترون ولا يعصون الله ما أمرهم ويفعلون ما يؤمرون - لاستنكف من نفسه ومن إظهار حبه وعلم قطعاً أنه من أخس المحبين في مملكته وأن حبه أنقص من حب كل محب لله.", "english": "And from what is disliked: the ostentation of love, because if the lover is a knower - and knows the states of the angels in their perpetual love and their necessary longing by which they glorify the night and the day, they do not cease and they do not disobey Allah what He commands them and they do what they are commanded - he would disdain from himself and from showing his love and know with certainty that he is from the most base of lovers in His kingdom and that his love is less than the love of every lover for Allah.", "book_file": "vol4_Vol4-book6.doc.txt", "book_title": "Love, Longing, Intimacy and Contentment", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Love, Longing, Intimacy and Contentment'", "badge": "Dhikr"}], "22": [{"arabic": "فإن في عالم الشهادة أيضاً توحيداً، إذ يعلم كل أحد أن المنزل يفسد بصاحبين، والبلد يفسد بأميرين، فيقال له على حد عقله إله العالم واحد والمدبر واحد، إذ لو كان فيهما آلهة إلا الله لفسدتا، فيكون ذلك على ذوق ما رآه في عالم الشهادة، فينغرس اعتقاد التوحيد في قلبه بهذا الطريق اللائق بقدر عقله، وقد كلف الله الأنبياء أن يكلموا الناس على قدر عقولهم، ولذلك نزل القرآن بلسان العرب على حد عادتهم في المحاورة.", "english": "For in the world of testimony (Shahadah) there is also Oneness (Tawhid), since everyone knows that a house is corrupted by two owners, and a city is corrupted by two rulers. So it is said to him according to the limit of his intellect: The God (Ilah) of the world is one and the Manager (Mudabbir) is one, since if there were in them gods except Allah, they would have been corrupted. So that becomes according to the taste (Dhawq) of what he has seen in the world of testimony (Shahadah), and the belief (I'tiqad) in Oneness (Tawhid) becomes implanted in his heart (Qalb) by this path suitable to the measure of his intellect. And Allah has charged the Prophets to speak to people according to the measure of their intellects, and for that reason the Quran was revealed in the tongue of the Arabs according to the limit of their custom in discourse.", "book_file": "vol4_Vol4-book5.doc.txt", "book_title": "Monotheism and Reliance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monotheism and Reliance'", "badge": "Insight"}, {"arabic": "الأصل العاشر: العلم بأن الله عز وجل واحد لا شريك له فرد لا ند له انفرد بالخلق والإبداع واستند بالإيجاد والاختراع لا مثل له يساهمه ويساويه ولا ضد له فينازعه ويناويه وبرهانه قوله تعالى لو كان فيهما آلهة إلا الله لفسدتا وبيانه أنه لو كانا اثنين وأراد أحدهما أمرا فالثاني إن كان مضطرا إلى مساعدته كان هذا الثاني مقهورا عاجزا ولم يكن إلها قادرا وإن كان قادرا على مخالفته ومدافعته كان الثاني قويا قاهرا والأول ضعيفا قاصرا ولم يكن إلها قادرا.", "english": "The Tenth Foundation: The knowledge that Allah (Exalted and Glorified is He) is One, without partner, Unique without equal, Who alone created and originated, and relied upon bringing into existence and inventing, with none like Him to share with Him and equal Him, and no opponent to contend with Him and oppose Him. And its proof is His statement (Exalted is He): 'If there were in them (the heavens and the earth) gods besides Allah, they would have been corrupted.' And its explanation is that if there were two, and one of them willed a matter, then the second: if he were compelled to assist him, this second would be overpowered and incapable, and would not be a god capable; and if he were capable of opposing him and resisting him, the second would be strong and overpowering, and the first weak and deficient, and would not be a god capable.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Foundations of Belief'", "badge": "Dhikr"}, {"arabic": "وعلى الجملة فالقرآن من أوله إلى آخره محاجة مع الكفار فعمده أدلة المتكلمين في التوحيد قوله تعالى لو كان فيهما آلهة إلا الله لفسدتا وفي النبوة وإن كنتم في ريب مما نزلنا على عبدنا فأتوا بسورة من مثله وفي البعث قل يحييها الذي أنشأها أول مرة إلى غير ذلك من الآيات والأدلة ولم تزل الرسل صلوات الله عليهم يحاجون المنكرين ويجادلونهم قال تعالى: ﴿ وجادلهم بالتي هي أحسن ﴾ {} فالصحابة رضي الله عنهم أيضا كانوا يحاجون المنكرين ويجادلون ولكن عند الحاجة وكانت الحاجة إليه قليلة في زمانهم", "english": "And in summary, the Quran from its beginning to its end is an argumentation with the disbelievers, so the foundation of the theologians' proofs in Divine Oneness (Tawhid) is His saying, the Exalted: 'If there were in them (the heavens and earth) gods other than Allah, they would have been corrupted.' And in prophethood: 'And if you are in doubt about what We have sent down upon Our servant, then bring a surah like it.' And in resurrection: 'Say: He gives them life Who created them the first time.' To other than that of the verses and proofs. And the messengers, prayers of Allah upon them, have not ceased arguing with the deniers and debating them. He, the Exalted, said: 'And argue with them in that which is best.' So the companions, may Allah be pleased with them, also used to argue with the deniers and debate, but when needed, and the need for it was little in their time.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Foundations of Belief'", "badge": "Afterlife"}, {"arabic": "ولا نظام إلا في الوحدة ولا فساد إلا في الكثرة وإنما انتظم أمر العالم لأن مدبر الكل واحد لو كان فيهما آلهة إلا الله لفسدتا ومهما كان المدبر واحدا انتظم أمر التدبير وإذا كثر المدبرون فسدت الأمور في الحضر والسفر", "english": "And there is no order except in unity (al-wahdah), and no corruption (al-fasad) except in multiplicity. And indeed, the affair of the world has become orderly because the Manager (al-mudabbir) of all is One: 'If there were in them (the heavens and earth) gods (alihah) other than Allah, they would have been corrupted (lafasadata).' And whenever the Manager (al-mudabbir) is one, the affair of management (al-tadbir) becomes orderly; and when the managers (al-mudabbirun) become many, affairs become corrupted (fasadat) in both residence and travel.", "book_file": "vol2_j2-k07.doc.txt", "book_title": "Etiquette of Travel", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Etiquette of Travel'", "badge": "General"}], "23": [{"arabic": "فتعالى الله الملك الحق لا يسئل عما يفعل وهم يسئلون ولنقتصر على هذا القدر اليسير من ذكر عجائب القلب فإن استقصاءه لا يليق بعلم المعاملة وإنما ذكرنا منه ما يحتاج إليه لمعرفة أغوار علوم المعاملة وأسرارها لينتفع بها من لا يقنع بالظواهر ولا يجتزئ بالقشر عن اللباب بل يتشوق إلى معرفة دقائق حقائق الأسباب وفيما ذكرناه كفاية له ومقنع إن شاء الله تعالى والله ولي التوفيق تم كتاب عجائب القلب ولله الحمد والمنة ويتلوه كتاب رياضة النفس وتهذيب الأخلاق والحمد لله وحده وصلى الله على كل عبد مصطفى.", "english": "So exalted is Allah, the True King, He is not questioned about what He does, and they are questioned. And we will limit ourselves to this small amount of mentioning the wonders of the Heart (Qalb), for its exhaustive treatment is not fitting for the science of spiritual practice (Mu'amalah). Rather, we have mentioned from it what is needed for knowing the depths of the sciences of spiritual practice (Mu'amalah) and their secrets, so that those who are not satisfied with appearances and do not content themselves with the shell instead of the core (Lubab) may benefit from it, but rather yearn to know the subtleties of the realities of causes. In what we have mentioned, there is sufficiency for him and satisfaction, if Allah wills. And Allah is the Guardian of success. Completed is the book of the wonders of the Heart (Qalb), and praise and favor are to Allah. And following it is the book of disciplining the Soul (Nafs) and refining the character traits. And praise is to Allah alone, and may Allah bless every chosen servant.", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "الأصل الثالث: أن فعل العبد وإن كان كسبا للعبد فلا يخرج عن كونه مرادا لله سبحانه فلا يجري في الملك والملكوت طرفة عين ولا لفتة خاطر ولا فلتة ناظر إلا بقضاء الله وقدرته وبإرادته ومشيئته ومنه الشر والخير والنفع والضر والإسلام والكفر والعرفان والنكر والفوز والخسران والغواية والرشد والطاعة والعصيان والشرك والإيمان لا راد لقضائه ولا معقب لحكمه يضل من يشاء ويهدي من يشاء لا يسئل عما يفعل وهم يسألون ويدل عليه من النقل قول الأمة قاطبة ما شاء كان وما لم يشأ لم يكن وقول الله عز وجل أن لو يشاء الله لهدى الناس", "english": "The Third Foundation: That the action of the servant, even though it is an acquisition (kasb) for the servant, does not depart from being willed by Allah, Glorified and Exalted is He. Thus, not a blink of an eye, nor a turn of thought, nor a glance of sight occurs in the dominion (al-mulk) and the kingdom (al-malakūt) except by the decree (qadā') of Allah and His power (qudrah) and by His will (irādah) and His volition (mashī'ah). From it [comes] evil and good, benefit and harm, submission (al-Islām) and disbelief (al-kufr), recognition (al-'irfān) and denial (al-nukr), success (al-fawz) and loss (al-khusrān), misguidance (al-ghawāyah) and right guidance (al-rushd), obedience (al-ṭā'ah) and disobedience (al-'iṣyān), polytheism (al-shirk) and faith (al-īmān). There is no averter of His decree, nor any repealer of His judgment. He misguides whom He wills and guides whom He wills. He is not questioned about what He does, but they will be questioned. Evidence for this from transmission (al-naql) is the statement of the entire community: 'What He wills occurs, and what He does not will does not occur,' and the statement of Allah, Mighty and Majestic is He: 'If Allah had willed, He would have guided all the people,' and His statement, Exalted is He: 'And if We had willed, We could have given every soul its guidance.' Evidence for this from the perspective of intellect (al-'aql) is that if sins (al-ma'āṣī) and crimes (al-jarā'im) were such that Allah dislikes them and does not will them, and they only occur in accordance with the will of the enemy, Iblīs—may Allah curse him—even though he is an enemy to Allah, Glorified and Exalted is He, and what occurs in accordance with the will of the enemy is more than what occurs in accordance with His will, Exalted is He, then I wonder how a Muslim permits himself to reduce the dominion of the Compeller (al-Jabbār), Possessor of Majesty and Honor, to a rank that, if the leadership of a village chief were reduced to it, he would disdain it. For if what continues for the enemy of the chief in the village were more than what is established for him, he would disdain his leadership and disavow his authority. Disobedience (al-ma'ṣiyah) is what predominates over creation, and all of that, according to the innovators (al-mubtadi'ah), occurs contrary to the will of the Truth, Exalted is He. This is the utmost weakness and incapacity—Exalted is the Lord of lords above what the wrongdoers say, greatly exalted. Then, whenever it becomes clear that the actions of the servants are created by Allah, it is correct that they are willed by Him. If it is said: 'How does He prohibit what He wills and command what He does not will?' We say: Command (al-amr) is different from will (al-irādah). Therefore, when a master strikes his servant and the ruler reproaches him for it, and he excuses himself by the rebellion of his servant against him, and the ruler disbelieves him, he wanted to manifest his proof by commanding the...", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Foundations of Belief'", "badge": "Insight"}, {"arabic": "وعند هذا كاد أن يزيغ ويطلق بالجراءة لسان السؤال، فثبت بالقول الثابت ونودي من وراء حجاب سرادقات الحضرة \"لا يسأل عما يفعل وهم يسألون\" فغشيته هيبة الحضرة، فخر صعقاً يضطرب في غشيته، فلما أفاق قال: سبحانك ما أعظم شأنك تبت إليك وتوكلت عليك وآمنت بأنك الملك الجبار الواحد القهار، فلا أخاف غيرك ولا أرجو سواك ولا أعوذ إلا بعفوك من عقابك وبرضاك من سخطك، وما لي إلا أن أسألك وأتضرع إليك وأبتهل بين يديك، فأقول: اشرح لي صدري لأعرفك واحلل عقدة من لساني لأثني عليك، فنودي من وراء الحجاب: إياك أن تطمع في الثناء وت", "english": "And at this point, he nearly deviated and unleashed his tongue with audacity in questioning, but he was steadied by the firm statement and was called from behind the veil of the pavilions of the Presence (al-Hadrah): \"He is not questioned about what He does, but they will be questioned.\" Then the awe of the Presence (al-Hadrah) overwhelmed him, and he fell unconscious, trembling in his swoon. When he regained consciousness, he said: Glory be to You, how great is Your affair! I repent to You, rely on You, and believe that You are the Compelling King (al-Malik al-Jabbar), the One, the Subduer (al-Qahhar). So I fear none but You, hope for none but You, and seek refuge only in Your pardon from Your punishment and in Your pleasure from Your wrath. I have nothing except to ask You, supplicate to You, and implore before You, so I say: Expand my chest (sadr) to know You and untie a knot from my tongue to praise You. Then he was called from behind the veil: Beware of aspiring to praise and exceeding the Master of the Prophets (Sayyid al-Anbiya). Rather, return to him, for whatever he gives you, take it; whatever he forbids you from, abstain from it; and whatever he says to you, say it. For he did not increase in this Presence (al-Hadrah) beyond saying: \"Glory be to You, I cannot enumerate praise upon You; You are as You have praised Yourself.\"", "book_file": "vol4_Vol4-book5.doc.txt", "book_title": "Monotheism and Reliance", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Monotheism and Reliance'", "badge": "Ethics"}, {"arabic": "الأصل السابع: أنه تعالى يفعل بعباده ما يشاء فلا يجب عليه رعاية الأصلح لعباده لما ذكرناه من أنه لا يجب عليه سبحانه شيء بل لا يعقل في حقه الوجوب فإنه لا يسأل عما يفعل وهم يسألون وليت شعري بما يجيب المعتزلي في قوله إن الأصلح واجب عليه في مسألة نعرضها عليه وهو أن يفرض مناظرة في الآخرة بين صبي وبين بالغ ماتا مسلمين فإن الله سبحانه يزيد في درجات البالغ ويفضله على الصبي لأنه تعب بالإيمان والطاعات بعد البلوغ ويجب عليه ذلك عند المعتزلي فلو قال الصبي يا رب لم رفعت منزلته علي فيقول لأنه بلغ واجتهد في الطاع", "english": "The Seventh Foundation: That He, the Exalted, does with His servants what He wills, so it is not obligatory upon Him to observe what is most beneficial for His servants, due to what we have mentioned that nothing is obligatory upon Him, the Glorified, rather obligation is inconceivable in His regard. For He is not questioned about what He does, but they will be questioned. And I wonder how the Mu'tazilite would answer in his claim that what is most beneficial is obligatory upon Him in a matter we present to him, which is to suppose a debate in the Hereafter between a child and an adult who both died as Muslims. For Allah, the Glorified, increases the degrees of the adult and favors him over the child because he toiled in faith and acts of obedience after puberty, and this is obligatory upon Him according to the Mu'tazilite. So if the child says: 'O Lord, why have You elevated his station above mine?' He would say: 'Because he reached puberty and strove in acts of obedience.' And the child says: 'You caused me to die in childhood, so it was obligatory upon You to prolong my life until I reached puberty so I could strive.' You have deviated from justice in favoring him with long life to my exclusion, so why have You favored him? Allah, the Exalted, says: 'Because I knew that if you had reached puberty, you would have associated partners or disobeyed, so what was most beneficial for you was death in childhood.' This is the Mu'tazilite's excuse for Allah, the Mighty and Majestic. And at this, the disbelievers call from the depths of Hellfire and say: 'O Lord, did You not know that if we had reached puberty we would have associated partners? Why did You not cause us to die in childhood? For we would have been content with less than the station of the Muslim child.' With what can this be answered? And is it not necessary at this point except to affirm that divine matters are exalted by the decree of Majesty from being weighed with the scale of the people of Mu'tazila? If it is said: 'Whenever He is able to observe what is most beneficial for the servants, then He subjects them to causes of punishment, that would be ugliness unbecoming of wisdom.' We say: Ugliness is what does not conform.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Foundations of Belief'", "badge": "Afterlife"}, {"arabic": "فكان لفظ القضاء بإزاء الآمر الواحد الكلى ولفظ القدر بإزاء التفصيل المتمادى إلى غير نهاية وقيل إن شيئا من ذلك ليس خارجا عن القضاء والقدر فخطر لبعض العباد أن القسمة لماذا اقتضت هذا التفصيل وكيف انتظم العدل مع هذا التفاوت والتفضيل وكان بعضهم لقصوره لا يطيق ملاحظة كنه هذا الأمر والاحتواء على مجامعه فألجموا عما لم يطيقوا خوض غمرته بلجام المنع وقيل لهم اسكنوا فما لهذا خلقتم لا يسئل عما يفعل وهم يسئلون وامتلأت مشكاة بعضهم نورا مقتبسا من نور الله تعالى في السموات والأرض وكان زيتهم أولا صافيا يكاد يضىء و", "english": "So the term 'Decree (Qada)' corresponds to the single universal command, and the term 'Divine Measure (Qadar)' corresponds to the detailed specification extending without end. And it is said that nothing of that is outside of the Decree (Qada) and the Divine Measure (Qadar). Then it occurred to some servants (عباد) why the apportionment necessitated this detailed specification and how justice was organized with this disparity and preferential treatment. And some of them, due to their deficiency, could not bear to observe the reality (كنه) of this matter and encompass its totality, so they were restrained from what they could not bear to plunge into its depth by the bridle of prohibition. And it was said to them: 'Be still, for you were not created for this. He is not questioned about what He does, but they will be questioned.' And the niche (مشكاة) of some of them was filled with light (نور) taken from the light (نور) of Allah, the Exalted, in the heavens and the earth. And their oil was at first pure, almost giving light even if no fire touched it. Then fire touched it, and it blazed with light upon light. Then the regions of the Dominion (الملكوت) shone before them with the light (نور) of their Lord, so they comprehended all matters as they truly are. Then it was said to them: 'Adorn yourselves with the manners (آداب) of Allah, the Exalted, and be still. And when the Divine Measure (القدر) is mentioned, hold back, for walls have ears, and around you are those weak in vision.'", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Patience and Gratitude'", "badge": "General"}], "28": [{"arabic": "فإن قلت: فقد قال ﷺ بعد قوله لفاطمة وصفية \"إني لا أغني عنكما من الله شيئاً إلا أن لكم رحماً سأبلها ببلاها\" وقال عليه الصلاة والسلام \"أترجو سليم شفاعتي ولا يرجوها بنو عبد المطلب\" فذلك يدل على أنه سيخصص قرابته بالشفاعة؟ فاعلم أن كل مسلم فهو منتظر شفاعة رسول الله ﷺ، والنسيب أيضاً جدير بأن يرجوها لكن بشرط أن يتقي الله أن يغضب عليه، فإنه إن يغضب عليه فلا يأذن لأحد في شفاعته، لأن الذنوب منقسمة إلى ما يوجب المقت فلا يؤذن في الشفاعة له، وإلى ما يعفى عنه بسبب الشفاعة، كالذنوب عند ملوك الدنيا فإن كل ذي مكا", "english": "If you say: Indeed, he (peace be upon him) said after his statement to Fatimah and Safiyyah, \"I cannot avail you anything from Allah except that you have kinship ties which I will maintain with due maintenance,\" and he (peace and blessings be upon him) said, \"Do you hope for Salim my intercession while the sons of Abdul-Muttalib do not hope for it?\" Does that indicate that he will specifically grant his relatives intercession? Then know that every Muslim is awaiting the intercession of the Messenger of Allah (peace be upon him), and the relative is also worthy of hoping for it, but on the condition that he fears Allah (Taqwa) that He not be angry with him. For if He is angry with him, then He does not permit anyone to intercede for him, because sins are divided into that which necessitates wrath (Maaqt), so intercession is not permitted for it, and into that which is forgiven due to intercession, like sins with the kings of the world. For every person of status with the king cannot intercede in that which the king's anger has intensified against. So among sins are those from which intercession does not save, and about it is the expression by His saying, the Most High, \"Nor do they intercede except for him whom He approves\" (Quran 21:28), and by His saying, \"Who is it that can intercede with Him except by His permission?\" (Quran 2:255), and by His saying, \"And intercession does not benefit with Him except for him whom He permits\" (Quran 34:23), and by His saying, \"So their intercession will not benefit them\" (Quran 74:48). And when sins are divided into that in which there is intercession and into that in which there is no intercession, fear (Khawf) and apprehension (Ishfaq) become obligatory without doubt. And if there were a sin in which intercession is accepted, He would not have commanded Quraysh to obedience, and the Messenger of Allah (peace be upon him) would not have prohibited Fatimah (may Allah be pleased with her) from disobedience, and he would have permitted her to follow desires to complete her self (Dhaat) in this world, then intercede for her in the Hereafter to complete her self (Dhaat) in the Hereafter.", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}, {"arabic": "وقد وصف الله تعالى الملائكة عليهم السلام مع تقدسهم عن الذنوب ومواظبتهم على العبادات على الدءوب بالإشفاق فقال تعالى مخبراً عنهم \"يَسْبَحُونَ اللَّيْلَ وَالنَّهَارَ لا يَفْتُرُونَ وَهُمْ مِنْ خَشْيَتِهِ مُشْفِقُونَ\" فمتى زال الإشفاق والحذر مما سبق به القضاء في الأزل - وينكشف عند خاتمة الأجل - غلب الأمن من مكر الله وذلك يوجب الكبر وهو سبب الهلاك.", "english": "And Allah the Exalted has described the angels, peace be upon them, with their sanctity from sins and their persistence in acts of worship (Ibadat) continuously, with being apprehensive (Mushfiqun), as He the Exalted said informing about them: \"They glorify (Yasbahuna) night and day, they do not slacken, and they are from fear (Khashya) of Him apprehensive (Mushfiqun).\" So when the apprehension (Ishfaq) and caution from what has preceded in the decree (Qada) in pre-eternity (Al-Azal) - and is revealed at the conclusion of the term (Ajal) - is removed, security (Amn) from the deception (Makr) of Allah prevails, and that necessitates arrogance (Kibr), and it is the cause of destruction.", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}], "32": [{"arabic": "وذم المعرضين عنها فقال وجعلنا السماء سقفا محفوظا وهم عن آياتها معرضون فأى نسبة لجميع البحار والأرض إلى السماء وهى متغيرات على القرب والسموات صلاب شداد محفوظات عن التغير إلى أن يبلغ الكتاب أجله ولذلك سماه الله تعالى محفوظا فقال وجعلنا السماء سقفا محفوظا", "english": "And He censured those who turn away from them, saying: 'And We made the sky a protected ceiling, and they are turning away from its signs.' So what is the proportion of all the seas and the earth to the sky, while they are changing in proximity, and the heavens are firm, strong, protected from change until the decree reaches its term. And for that reason, Allah the Exalted named it protected, saying: 'And We made the sky a protected ceiling.'", "book_file": "vol4_j4-k09.doc.txt", "book_title": "Contemplation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Contemplation'", "badge": "Insight"}], "35": [{"arabic": "وعن ابن عمر أنه لما دخل أبو بكر البيت وصلى وأثنى عج أهل البيت عجيجا سمعه أهل المصلى كلما ذكر شيئا ازدادوا فما سكن عجيجهم إلا تسليم رجل على الباب صيت جلد قال السلام عليكم يا أهل البيت ﴿ كل نفس ذائقة الموت ﴾ {} الآية إن في الله خلفا من كل أحد ودركا لكل رغبة ونجاة من كل مخافة فالله تعالى فارجوا وبه فثقوا فاستمعوا له وأنكروه وقطعوا البكاء فلما انقطع البكاء فقد صوته فاطلع أحدهم فلم ير أحدا ثم عادوا فبكوا فناداهم مناد آخر لا يعرفون صوته يا اهل البيت اذكروا الله تعالى واحمدوه على كل حال تكونوا من المخل", "english": "And from Ibn Umar that when Abu Bakr entered the house and prayed and praised, the people of the house wailed a wailing heard by the people of the prayer place; whenever he mentioned something, they increased. Their wailing did not cease except by the greeting of a man at the door, strong-voiced, who said: 'Peace be upon you, O people of the house. \"Every soul (Nafs) shall taste death\" (Quran 21:35). Indeed, in Allah there is a successor (Khalaf) from everyone and attainment (Darak) for every desire and salvation (Najah) from every fear. So in Allah the Exalted, hope (Fargu), and in Him, trust (Thiq), and listen to Him and deny (Ankiruh) and cut off the weeping.' When the weeping ceased, his voice was lost. One of them looked out and did not see anyone. Then they returned and wept. Then another caller called them whose voice they did not recognize: 'O people of the house, remember (Udhkuru) Allah the Exalted and praise (Uhmaduh) Him in every state, that you may be among the sincere ones (Mukhlisin). Indeed, in Allah there is consolation (Azā') from every calamity and compensation (Iwad) from every desire. So in Allah, obey (Fati'u), and by His command, act (Fa'malu).' Abu Bakr said: 'This is Al-Khidr and Al-Yasa, peace be upon them, who attended the Prophet ﷺ.'", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Repentance'", "badge": "Insight"}, {"arabic": "وقال بعض الصوفية كنت أقرأ ليلة هذه الآية كل نفس ذائقة الموت فجعلت ارددها فإذا هاتف يهتف بي كم تردد هذه الآية فقد قتلت أربعة من الجن ما رفعوا رءوسهم إلى السماء منذ خلقوا", "english": "And some of the Sufis said: I was reciting one night this verse: 'Every Soul (Nafs) tastes death (Al-Mawt)' so I kept repeating it, then a caller called out to me: 'How much you repeat this verse! You have killed four of the Jinn (Al-Jinn) who have not raised their heads to the sky since they were created.'", "book_file": "vol2_j2-k08.doc.txt", "book_title": "Audition and Ecstasy", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Audition and Ecstasy'", "badge": "Insight"}, {"arabic": "وقال بعض الصالحين بينما أنا أسير في مسير لى إذ ملت إلى شجرة لأستريح تحتها فإذا أنا بشيخ قد أشرف على فقال لى يا هذا قم فإن الموت لم يمت ثم هام على وجه فاتبعته فسمعته وهو يقول كل نفس ذائقة الموت اللهم بارك لى في الموت فقلت وفيما بعد الموت فقال من أيقن بما بعد الموت شمر مئزر الحذر ولم يكن له في الدنيا مستقر", "english": "And some of the righteous said: While I was walking on my journey, I inclined toward a tree to rest under it, and behold, I saw an elder who had appeared to me and said to me: O this one, rise, for death has not died. Then he wandered on his face, and I followed him, and I heard him saying: 'Every soul (Nafs) will taste death (Quran 21:35). O Allah, bless me in death.' So I said: And in what comes after death? He said: Whoever is certain of what comes after death has girded the loincloth of caution and has no abode in this world.", "book_file": "vol4_j4-k08.doc.txt", "book_title": "Monitoring and Accounting", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Monitoring and Accounting'", "badge": "Afterlife"}], "37": [{"arabic": "ومن أبوابه العظيمة العجلة وترك التثبت في الأمور وقال صلى الله عليه وسلم العجلة من الشيطان والتأني من الله تعالى[58] وقال عز وجل خلق الإنسان من عجل وقال تعالى وكان الإنسان عجولا وقال لنبيه صلى الله عليه وسلم ولا تعجل بالقرآن من قبل أن يقضي إليك وحيه وهذا لأن الأعمال ينبغي أن تكون بعد التبصرة والمعرفة والتبصرة تحتاج إلى تأمل وتمهل والعجلة تمنع من ذلك وعند الاستعجال يروج الشيطان شره على الإنسان من حيث لا يدري", "english": "And from its great gates are haste and abandoning careful consideration in matters. And the Prophet (peace be upon him) said: 'Haste is from Satan, and deliberation is from Allah the Exalted.' And the Mighty and Majestic said: 'The human being (Al-Insan) is created from haste (عَجَلٍ).' And He said: 'And the human being (Al-Insan) is hasty (عَجُولًا).' And He said to His Prophet (peace be upon him): 'And do not hasten with the Quran before its revelation is completed to you.' And this is because actions should be after insight (Al-Basirah) and knowledge (Al-Ma'rifah), and insight requires contemplation (Ta'ammul) and deliberation (Tamahhul), and haste prevents from that. And during hastening, Satan promotes his evil upon the human being from where he does not realize.", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}], "38": [{"arabic": "واختلاف تركيب أعضائه أعاجيب تزيد على الأعاجيب فى بعثه وإعادته فكيف ينكر ذلك من قدرة الله تعالى وحكمته من يشاهد ذلك فى صنعته وقدرته فإن كان فى إيمانك ضعف فقو الإيمان بالنظر فى النشأة الأولى فإن الثانية مثلها وأسهل منها وإن كنت قوى الإيمان بها فأشعر قلبك تلك المخاوف والأخطار وأكثر فيها التفكر والاعتبار لتسلب عن قلبك الراحة والقرار فتشتغل بالتشمر للعرض على الجبار وتفكر أولا فيما يقرع سمع سكان القبور من شدة نفخ الصور فإنها صيحة واحدة تنفرج بها القبور عن رءوس الموتی فيثورون دفعة واحدة فتوهم نفسك وقد ", "english": "And the differing composition of its limbs are wonders that increase over wonders in its resurrection and restoration, so how can one deny that from the power (Qudrah) of Allah the Exalted and His wisdom who witnesses that in His creation and power? If there is weakness in your faith (Iman), then strengthen the faith (Iman) by looking at the first creation, for the second is like it and easier than it. And if you are strong in faith (Iman) in it, then make your heart (Qalb) feel those fears and dangers, and increase in it reflection (Tafakkur) and consideration (I'tibar) to strip from your heart (Qalb) comfort and settlement, so you busy yourself with preparing for the presentation before the Almighty (Al-Jabbar). And reflect first on what strikes the hearing of the inhabitants of the graves from the intensity of blowing the Trumpet (As-Sur), for it is a single cry by which the graves split open from the heads of the dead, and they rise up all at once. So imagine yourself having leapt up, your face changed, your body dusty from your scalp to your feet from the dust of your grave, stunned from the intensity of the blow, your eye fixed toward the call. And the creation has risen up in one uprising from the graves in which their tribulation has been prolonged, and alarm and terror have agitated them, added to what they had of sorrows and griefs and intense waiting for the outcome of the matter, as the Exalted said: 'And the Trumpet (As-Sur) will be blown, and all who are in the heavens and all who are on the earth will fall dead except whom Allah wills. Then it will be blown again, and at once they will be standing, looking on.' And the Exalted said: 'And when the Horn (An-Naqur) is blown, that Day will be a difficult day for the disbelievers; not easy.' And the Exalted said: 'And they say, \"When is this promise, if you should be truthful?\" They do not await except one blast which will seize them while they are disputing. And they will not be able to make a testament, nor to their people can they return. And the Trumpet (As-Sur) will be blown; and at once from the graves to their Lord they will hasten. They will say, \"O woe to us! Who has raised us from our sleeping place? This is what the Most Merciful had promised, and the messengers told the truth.\"' So if there were not before the dead except the terror of that blowing, it would be worthy to be feared, for it is a blowing and a cry by which those in the heavens and the earth are struck dead, meaning they die by it except whom Allah wills, and that is some of the angels. And therefore the Messenger of Allah (peace be upon him) said: 'How can I be at ease when the possessor of the Trumpet (As-Sur) has taken the horn in his mouth, lowered his forehead, and inclined his ear, waiting for when he is commanded to blow?' Maqatil said: The Trumpet (As-Sur) is the horn, and that Israfil (upon him be peace) is placing his mouth on the horn like the form of a trumpet, and the circle of the horn's head is like the width of the heavens and the earth, and he is fixing his gaze toward the Throne, waiting for when he is commanded to blow the first blowing. And when he blows, those in the heavens and the earth are struck dead, meaning every animal dies from the intensity of the alarm except whom Allah wills, and that is Jibril, Mika'il, Israfil, and the Angel of Death (Malak al-Mawt). Then the Angel of Death (Malak al-Mawt) is commanded to take the soul (Ruh) of Jibril, then the soul (Ruh) of Mika'il, then the soul (Ruh) of Israfil, then the Angel of Death (Malak al-Mawt) is commanded and he dies. Then the creation remains after the first blowing in the Barzakh for forty years, then Allah the Exalted revives Israfil and commands.", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Repentance'", "badge": "Insight"}], "47": [{"arabic": "خواطر عباده إذا اختلجت الذى لا يعزب عن علمه مثقال ذرة في السموات والأرض تحركت أو سكنت المحاسب على النقير والقطمير والقليل والكثير من الأعمال وإن خفيت المتفضل بقبول طاعات العباد وان صغرت المتطول بالعفو عن من معاصيهم وإن كثرت وإنما يحاسبهم لتعلم كل نفس ما أحضرت وتنظر فيما قدمت وأخرت فتعلم انه لولا لزومها للمراقبة والمحاسبة في الدنيا لشفيت في صعيد القيامة وهلكت وبعد المجاهدة والمحاسبة والمراقبة لولا فضله بقبول بضاعتها المزجاة لخابت وخسرت فسبحان من عمت نعمته كافة العباد وشملت واستغرقت رحمته الخلائق ", "english": "The thoughts (Khawatir) of His servants when they stir—He from Whose knowledge not an atom's weight in the heavens or earth escapes, whether it moves or is still—the Accountant (Al-Muhasib) over the smallest and the largest of deeds, even if hidden; the Bestower of favor (Al-Mutafaddil) by accepting the acts of obedience (Taat) of the servants, even if small; the One who extends pardon (Al-Mutawwil) by forgiving their sins, even if numerous. And He only accounts them so that every soul (Nafs) may know what it has brought forth and reflect on what it has sent ahead and left behind, so it knows that were it not for its adherence to vigilance (Muraqabah) and self-accounting (Muhasabah) in this world, it would be exposed on the plain of Resurrection and perish. And after striving (Mujahadah), self-accounting, and vigilance, were it not for His grace (Fadl) in accepting their meager offering, it would fail and lose. So glory be to Him whose favor (Nimat) encompasses all servants, and whose mercy (Rahmah) embraces and pervades the creatures in this world and the next, and overwhelms. And by the breaths of His grace, the hearts (Qulub) expanded for faith (Iman) and were opened, and by the blessing of His enabling success (Tawfiq), the limbs (Jawarih) were bound to acts of worship (Ibadat) and disciplined, and by the excellence of His guidance (Hidayah), the darknesses of ignorance (Jahl) cleared from the hearts and dispersed, and by His support (Tayid) and victory (Nasr), the schemes of Satan (Shaytan) were cut off and repelled, and by the gentleness of His care (Inayah), the scale of good deeds (Hasanat) tips when heavy, and by His facilitation (Taysir), what is facilitated of acts of obedience is facilitated. From Him is the giving and the recompense, the distancing and the drawing near, the making happy and the making wretched. And prayers and peace be upon Muhammad, the master of the prophets, and upon his family, the masters of the chosen ones, and upon his companions, the leaders of the pious. Then after, Allah the Exalted said: 'And We will set up the scales of justice (Al-Mawazin Al-Qist) for the Day of Resurrection, so no soul will be wronged at all. And if there is [even] the weight of a mustard seed (Habbah min Khardal), We will bring it forth. And sufficient are We as accountant (Hasib).' And He said: 'And the record [of deeds] will be placed, and you will see the criminals fearful of that within it, and they will say, \"Oh, woe to us! What is this book that leaves nothing small or great except that it has enumerated it?\" And they will find what they did present [before them]. And your Lord does injustice to no one.' And He said: 'On the Day when Allah will resurrect them all and inform them of what they did. Allah has enumerated it, and they have forgotten it; and Allah is, over all things, Witness.' And He said: 'That Day, the people will depart separated [into categories] to be shown their deeds. So whoever does an atom's weight of good will see it, and whoever does an atom's weight of evil will see it.' And He said: 'Then every soul will be compensated for what it earned, and they will not be wronged.' And He said: 'On the Day when every soul will find what it did of good present [before it] and what it did of evil, it will wish that between itself and that [evil] was a great distance. And Allah warns you of Himself.' And He said: 'And know that Allah knows what is within yourselves, so beware of Him.' So the possessors of insight (Arbab Al-Basair) from among the servants recognized that Allah the Exalted is lying in wait for them and that they will be scrutinized in the account and demanded with atom's weights of thoughts (Khawatir) and glances (Lahzat). And they realized that nothing saves them from these dangers except adherence to self-accounting, sincerity in vigilance, and demanding accountability from the soul (Nafs) in breaths (Anfas) and movements (Harakat), and accounting it for thoughts and glances. For whoever accounts his soul before being accounted, his account on the Day of Resurrection will be lightened, his answer will be present at the questioning, and his outcome and return will be good. And whoever does not account his soul, it persists.", "book_file": "vol4_j4-k08.doc.txt", "book_title": "Monitoring and Accounting", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monitoring and Accounting'", "badge": "Insight"}, {"arabic": "وقال تعالى \"وَنَضَعُ الْمَوَازِينَ الْقِسْطَ لِيَوْمِ الْقِيَامَةِ فَلَا تُظْلَمُ نَفْسٌ شَيْئًا ۖ وَإِنْ كَانَ مِثْقَالَ حَبَّةٍ مِنْ خَرْدَلٍ أَتَيْنَا بِهَا ۗ وَكَفَىٰ بِنَا حَاسِبِينَ\" وذم الكبر في القرآن كثير وقد قال رسول الله ﭬ \"لا يدخل الجنة من كان في قلبه مثقال حبة من خردل من كبر، ولا يدخل النار من كان في قلبه مثقال حبة من خردل من إيمان\"[3]", "english": "And He (Allah) said: \"And We will set up the scales of justice for the Day of Resurrection, so no soul (Nafs) will be wronged at all. And if there is the weight of a mustard seed, We will bring it forth. And sufficient are We as accountant.\" And the condemnation of arrogance in the Quran is abundant, and the Messenger of Allah (peace be upon him) said: \"He will not enter Paradise who has in his heart (Qalb) the weight of a mustard seed of arrogance, and he will not enter the Fire who has in his heart (Qalb) the weight of a mustard seed of faith.\"", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Pride and Conceit'", "badge": "Insight"}, {"arabic": "وقد قال رسول الله ﭬ \"لا يدخل الجنة من كان في قلبه مثقال حبة من خردل من كبر، ولا يدخل النار من كان في قلبه مثقال حبة من خردل من إيمان\"[3] وقال أبو هريرة رضي الله عنه: قال رسول الله ﭬ \"يقول الله تعالى الكبرياء ردائي والعظمة إزاري فمن نازعني واحداً منهما ألقيته في جهنم ولا أبالي\"[4] وعن أبي سلمة بن عبد الرحمن قال: التقى عبد الله بن عمرو وعبد الله بن عمر على الصفا فتواقفا، فمضى ابن عمرو وأقام ابن عمر يبكي، فقالوا ما يبكيك يا أبا عبد الرحمن؟ فقال: هذا - يعني عبد الله بن عمرو - زعم أنه سمع رسول الله ﭬ", "english": "And the Messenger of Allah (peace be upon him) said: \"He will not enter Paradise who has in his heart (Qalb) the weight of a mustard seed (Habbah min Khardal) of arrogance (Kibr), nor will he enter the Fire who has in his heart (Qalb) the weight of a mustard seed (Habbah min Khardal) of faith (Iman).\" [3] And Abu Hurairah (may Allah be pleased with him) said: The Messenger of Allah (peace be upon him) said: \"Allah the Exalted says: Arrogance (Kibriya') is My cloak and grandeur (Izzah) is My lower garment, so whoever contends with Me for one of them, I will cast him into Hellfire and I do not care.\" [4] And from Abu Salamah ibn Abd al-Rahman, he said: Abdullah ibn Amr and Abdullah ibn Umar met at al-Safa and stood together, then Ibn Amr went on and Ibn Umar remained weeping. They said: What makes you weep, O Abu Abd al-Rahman? He said: This - meaning Abdullah ibn Amr - claimed that he heard the Messenger of Allah (peace be upon him) say: \"Whoever has in his heart (Qalb) the weight of a mustard seed (Habbah min Khardal) of arrogance (Kibr), Allah will throw him on his face into the Fire.\" [5] And the Messenger of Allah (peace be upon him) said: \"A man continues to go with his soul (Nafs) until he is written among the tyrants (Jabbarin), and he will be afflicted with what afflicted them of punishment.\" [6] And Sulayman ibn Dawud (peace be upon them both) said one day - to the birds, mankind, jinn, and beasts: Come out, so they came out in two hundred thousand of mankind and two hundred thousand of jinn, then he was raised until he heard the clamor of the angels with glorification in the heavens, then he was lowered until his feet touched the sea, and he heard a voice: If there were in the heart (Qalb) of your companion the weight of an atom (Dharr) of arrogance (Kibr), I would have caused him to sink farther than I raised him. And he (peace be upon him) said: \"There will come out from the Fire a neck having two ears that hear and two eyes that see and a tongue that speaks, saying: I have been entrusted with three: with every obstinate tyrant (Jabbar Anid) and with everyone who called upon another god with Allah and with the image-makers.\" [7] And he (peace be upon him) said: \"He will not enter Paradise a miser, nor a tyrant (Jabbar), nor one of bad character.\" [8] And he (peace be upon him) said: \"Paradise and the Fire argued, so the Fire said: I have been favored with the arrogant (Mutakabbirin) and the tyrannical (Mutajabbirin), and Paradise said: Why is it that none enters me except the weak of the people, their lowly, and their incapable? So Allah said to Paradise: You are only My mercy, I show mercy with you to whom I will of My servants, and He said to the Fire: You are only My punishment, I punish with you whom I will, and for each of you is your fill.\" [9] And he (peace be upon him) said: \"Wretched is the servant (Abd) who acts arrogantly (Tajabbar) and transgresses and forgets the Most High Tyrant (Al-Jabbar al-A'la), wretched is the servant (Abd) who acts arrogantly (Tajabbar) and...", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}, {"arabic": "الأصل الرابع: الميزان وهو حق قال الله تعالى: ﴿ ونضع الموازين القسط ليوم القيامة ﴾ { سورة الأنبيآء: 47 } وقال تعالى: ﴿ فمن ثقلت موازينه فأولئك هم المفلحون. ومن خفت موازينه ﴾ { سورة المؤمنون:102، 103 } ووجهها أن الله تعالى يحدث في صحائف الأعمال وزنا بحسب درجات الأعمال عند الله تعالى فتصير مقادير أعمال العباد معلومة للعباد حتى يظهر لهم العدل في العقاب أو الفضل في العفو وتضعيف الثواب.", "english": "The Fourth Foundation: The Balance (Mizan) is truth. Allah the Exalted said: 'And We will set up the balances of justice (al-Mawazin al-Qist) for the Day of Resurrection' (Surah Al-Anbiya: 47). And He said: 'Then as for those whose scales are heavy, they are the successful ones. And as for those whose scales are light' (Surah Al-Muminun: 102-103). And its interpretation (Wajhuha) is that Allah the Exalted creates in the scrolls of deeds a weight (Waznan) according to the degrees of deeds with Allah the Exalted, so the measures (Maqadir) of the deeds of the servants become known to the servants until justice (al-Adl) in punishment or favor (al-Fadl) in pardon and multiplication of reward becomes apparent to them.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Foundations of Belief'", "badge": "Afterlife"}, {"arabic": "[3] حديث لا يدخل الجنة من كان في قلبه مثقال حبة من خردل من كبر ولا يدخل النار رجل في قلبه مثقال حبة من خردل من إيمان أخرجه مسلم من حديث ابن مسعود.", "english": "Hadith: \"He will not enter Paradise who has in his heart (Qalb) the weight of a mustard seed (Habbah min Khardal) of arrogance (Kibr), nor will he enter Hellfire a man who has in his heart (Qalb) the weight of a mustard seed (Habbah min Khardal) of faith (Iman).\" Reported by Muslim from the narration of Ibn Mas'ud.", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Condemnation of Pride and Conceit'", "badge": "Hadith"}], "51": [{"arabic": "وأما الرشد فنعنى به العناية الإلهية التى تعين الإنسان عند توجهه إلى مقاصده فتقوبه على ما فيه صلاحه وتفتره عما فيه فساده ويكون ذلك من الباطن كما قال تعالى: ﴿ ولقد آتينا إبراهيم رشده من قبل وكنا به عالمين ﴾ {} فالرشد عبارة عن هداية باعثة إلى جهة السعادة محركة إليها فالصبى إذا بلغ خبيرا بحفظ المال وطرق التجارة والاستنماء ولكنه مع ذلك يبذر ولا يريد الاستنماء لا يسمى رشيدا لا لعدم هدايته بل لقصور هدايته عن تحريك داعيته فكم من شخص يقدم على ما يعلم أنه يضره فقد أعطى الهداية وميز بها عن الجاهل الذى لا ي", "english": "And as for the Guidance (Rushd), we mean by it the Divine Care (Al-'Inayah Al-Ilahiyyah) that assists the human when he turns toward his objectives, so it guides him to what contains his rectification (Salah) and turns him away from what contains his corruption (Fasad), and this is from the inner dimension (Al-Batin) as Allah the Exalted said: 'And verily We gave Abraham his Guidance (Rushd) from before, and We were of him Knowers.' So the Guidance (Rushd) is an expression for a guidance (Hidayah) that motivates toward the direction of happiness (Al-Sa'adah) and moves toward it. For the boy when he reaches puberty, knowledgeable about preserving wealth and ways of commerce and growth, but with that he squanders and does not desire growth, he is not called guided (Rashid), not due to absence of his guidance (Hidayah) but due to deficiency of his guidance (Hidayah) in moving his motivation (Da'iyah). For how many a person proceeds upon what he knows harms him, he has been given the guidance (Hidayah) and distinguished by it from the ignorant one who does not know that it harms him, but he has not been given the Guidance (Rushd). So the Guidance (Rushd) by this consideration is more complete than mere guidance (Hidayah) to the aspects of deeds, and it is a great blessing (Ni'mah).", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}], "56": [{"arabic": "فإذا انتهى إلى قوله إنك تقضي ولا يقضى عليك فلا يليق به التأمين وهو ثناء فيقرأ معه فيقول مثل قوله أو يقول بلى وأنا على ذلك من الشاهدين أو صدقت وبررت وما أشبه ذلك", "english": "When he reaches His saying 'You judge and are not judged,' it is not fitting for him to say 'Amen' as it is praise, so he recites with him and says like his saying or says 'Yes, and I am among the witnesses of that' or 'You have spoken truthfully and righteously' and what resembles that.", "book_file": "vol1_Vol1-book-4.doc.txt", "book_title": "Mysteries of Prayer", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Mysteries of Prayer'", "badge": "General"}], "60": [{"arabic": "وقال ابن عباس رضي الله عنهما: ما آتي الله عز وجل عبدا علما إلا شابا والخير كله في الشباب ثم تلا قوله عز وجل: ﴿ قالوا سمعنا فتى يذكرهم يقال له إبراهيم ﴾ {} وقوله تعالى: ﴿ إنهم فتية آمنوا بربهم وزدناهم هدى ﴾ {} وقوله تعالى: ﴿ وآتيناه الحكم صبيا ﴾ {} وكان أنس رضي الله عنه يقول (قبض رسول الله ﭬ وليس في رأسه ولحيته عشرون شعرة بيضاء فقيل له: يا أبا حمزة فقد أسن فقال لم يشنه الله بالشيب فقيل أهو شين فقال كلكم يكرهه[76])", "english": "And Ibn Abbas, may Allah be pleased with them both, said: 'Allah Almighty does not give knowledge to a servant except when he is young, and all good is in youth.' Then he recited the saying of Allah Almighty: 'They said: We heard a youth (Fata) mentioning them; he is called Abraham' (Quran 21:60), and His saying: 'Indeed, they were youths (Fityah) who believed in their Lord, and We increased them in guidance' (Quran 18:13), and His saying: 'And We gave him wisdom (Hukm) as a boy (Sabiyyan)' (Quran 19:12). And Anas, may Allah be pleased with him, used to say: 'The Messenger of Allah, peace be upon him, passed away and there were not twenty white hairs in his head and beard. It was said to him: O Abu Hamzah, you have aged. He said: Allah did not disgrace him with gray hair. It was said: Is it a disgrace? He said: All of you dislike it.'", "book_file": "vol1_Vol1-book-3.doc.txt", "book_title": "Mysteries of Purity", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Mysteries of Purity'", "badge": "Insight"}], "67": [{"arabic": "الدرجة الرابعة السب والتعنيف بالقول الغليظ الخشن وذلك يعدل إليه عند العجز عن المنع باللطف وظهور مبادىء الإصرار والاستهزاء بالوعظ والنصح وذلك مثل قول إبراهيم عليه السلام أف لكم ولما تعبدون من دون الله أفلا تعقلون ولسنا نعني بالسب والفحش بما فيه نسبة إلى الزنا ومقدماته ولا الكذب بل أن يخاطبه بما فيه مما لا يعد من جملة الفحش كقوله يا فاسق يا أحمق يا جاهل ألا تخاف الله وكقوله يا سوادي يا غبي وما يجري هذا المجرى فإن كل فاسق فهو أحمق وجاهل ولولا حمقه لما عصى الله تعالى بل كل من ليس بكيس فهو أحمق والكي", "english": "The fourth degree: reviling and rebuking with harsh, coarse speech, and one resorts to this when incapable of prevention with gentleness and when signs of persistence and mockery of admonition and counsel appear. This is like the saying of Abraham (peace be upon him): 'Uff (an expression of disgust) to you and to what you worship besides Allah. Do you not then understand?' And we do not mean by reviling and obscenity that which involves attribution to fornication and its preliminaries, nor lying, but rather addressing him with what is not considered among obscenities, such as saying: 'O transgressor (Fasiq), O fool (Ahmaq), O ignorant one (Jahil), do you not fear Allah?' and like saying: 'O black one (Sawadi), O stupid one (Ghabi),' and what runs in this course. For every transgressor (Fasiq) is a fool (Ahmaq) and ignorant (Jahil), and were it not for his foolishness (Hamaq), he would not disobey Allah Almighty. Rather, everyone who is not prudent (Kays) is a fool (Ahmaq), and the prudent one (Kays) is he whom the Messenger of Allah (peace be upon him) testified to for prudence (Kaysah) when he said: 'The prudent one (Kays) is he who holds his Soul (Nafs) accountable and works for what is after death,' and the fool (Ahmaq) is he who follows his Soul's (Nafs) desire (Hawa) and wishes upon Allah. The hadith: 'The prudent one (Kays) is he who holds his Soul (Nafs) accountable and works for what is after death'—the hadith was reported by Al-Tirmidhi who said it is hasan, and by Ibn Majah from the narration of Shaddad ibn Aws. For this rank, there are two etiquettes: one is not to proceed to it except out of necessity and incapacity for gentleness, and the second is not to speak except with truth and not to indulge in it by letting his long tongue loose with what is not needed, but rather to limit to the extent of need. If he knows that addressing him with these deterrent words does not deter him, then it is not appropriate to let it loose, but rather to limit to showing anger and contempt for him and disdain for his place due to his disobedience. And if he knows that if he speaks he will be struck, but if he frowns and shows dislike with his face he will not be struck, it is incumbent upon him, and it does not suffice him to disapprove with the Heart (Qalb), but rather it is incumbent upon him.", "book_file": "vol2_j2-k09.doc.txt", "book_title": "Enjoining Good and Forbidding Evil", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Enjoining Good and Forbidding Evil'", "badge": "Ethics"}], "79": [{"arabic": "وقال ابن عباس رضي الله عنهما في قوله تعالى ﴿ ومن يؤت الحكمة فقد أوتي خيرا كثيرا ﴾ {} يعني الفهم في القرآن. وقال عز وجل ﴿ ففهمناها سليمان وكلا آتينا حكما وعلما ﴾ {} سمى ما آتاهما علما وحكما وخصص ما انفرد به سليمان بالتفطن له باسم الفهم وجعله مقدما على الحكم والعلم فهذه الأمور تدل على أن في فهم معاني القرآن مجالا رحبا ومتسعا بالغا وأن المنقول من ظاهر التفسير ليس منتهى الإدراك فيه.", "english": "And Ibn Abbas (may Allah be pleased with them both) said regarding His (the Exalted's) statement: 'And whoever is given wisdom has been given much good' (Quran 2:269) - meaning understanding (Fahm) in the Quran. And He (the Exalted) said: 'So We gave Solomon understanding (Fahhamnaha) of it, and to each We gave judgment (Hukm) and knowledge (Ilm)' (Quran 21:79). He named what He gave both of them as knowledge (Ilm) and judgment (Hukm), and He specified what Solomon uniquely possessed of discernment (Tafattun) by the name 'understanding' (Fahm) and made it precede judgment (Hukm) and knowledge (Ilm). These matters indicate that in understanding (Fahm) the meanings of the Quran there is a vast and extensive scope, and that what is transmitted of the apparent interpretation (Tafsir) is not the ultimate limit of comprehension (Idrak) in it.", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Etiquette of Quran Recitation'", "badge": "Hadith"}], "84": [{"arabic": "وقال الشافعي رحمه الله: (التمكين درجة الأنبياء ولا يكون التمكين إلا بعد المحنة فإذا امتحن صبر وإذا صبر مكن ألا ترى أن الله عز وجل امتحن إبراهيم عليه السلام ثم مكنه، وامتحن موسى عليه السلام ثم مكنه، وامتحن أيوب عليه السلام ثم مكنه، وامتحن سليمان عليه السلام ثم مكنه وآتاه ملكا، والتمكين أفضل الدرجات قال الله عز وجل (وكذلك مكنا ليوسف في الأرض( (يوسف: 56)، وأيوب عليه السلام بعد المحنة العظيمة مكن، قال الله تعالى (وآتيناه أهله ومثلهم معهم( (الأنبياء: 84) الآية. فهذا الكلام من الشافعي رحمه الله يدل عل", "english": "And Al-Shafi'i, may Allah have mercy upon him, said: 'Empowerment (Tamkin) is the rank of the Prophets, and empowerment does not occur except after trial (Mihna). So when one is tested, he endures with patience (Sabr), and when he endures with patience, he is empowered. Do you not see that Allah, the Exalted and Majestic, tested Ibrahim, peace be upon him, then empowered him; and tested Musa, peace be upon him, then empowered him; and tested Ayyub, peace be upon him, then empowered him; and tested Sulayman, peace be upon him, then empowered him and granted him a kingdom. And empowerment is the best of ranks. Allah, the Exalted and Majestic, said: \"And thus We empowered Yusuf in the land\" (Yusuf: 56). And Ayyub, peace be upon him, after the great trial, was empowered. Allah, the Exalted, said: \"And We gave him his family and the like of them with them\" (Al-Anbiya': 84) the verse. This speech from Al-Shafi'i, may Allah have mercy upon him, indicates his deep immersion in the secrets of the Quran and his awareness of the stations (Maqamat) of those journeying (Sa'irin) to Allah, the Exalted, from among the Prophets and the Friends (Awliya'), and all of that is from the sciences of the Hereafter (Al-Akhira).'", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "fiqh", "topic": "Al-Ghazali on the outer and inner dimensions of worship, from 'Book of Knowledge'", "badge": "Worship"}], "87": [{"arabic": "ستغفرك وأتوب إليك آمنت اللهم بما أرسلته من رسول وآمنت اللهم بما أنزلت من كتاب وصلى الله على محمد النبي الأمي وعلى آله وسلم تسليما كثيرا خاتم كلامي ومفتاحه وعلى أنبيائه ورسله أجمعين آمين يا رب العالمين اللهم أوردنا حوض محمد واسقنا بكأسه مشربا رويا سائغا هنيا لا نظمأ بعده أبدا واحشرنا في زمرته غير خزايا ولا ناكثين للعهد ولا مرتابين ولا مفتونين ولا مغضوب علينا ولا ضالين اللهم اعصمني من فتن الدنيا ووفقني لما تحب وترضى وأصلح لي شأني كله وثبتني بالقول الثابت في الحياة الدنيا وفي الآخرة ولا تضلني وإن ك", "english": "I seek Your forgiveness and repent to You. O Allah, I believe in what You have sent of Messenger, and I believe, O Allah, in what You have revealed of Book. And may Allah send blessings upon Muhammad, the unlettered Prophet, and upon his family and grant abundant peace, the seal of my speech and its key, and upon all His prophets and messengers. Amen, O Lord of the worlds. O Allah, make us arrive at the pool of Muhammad and give us to drink from his cup a drink that is quenching, pleasant, delightful, after which we shall never thirst forever. And gather us in his company, not disgraced, nor breaking the covenant, nor doubting, nor tempted, nor those upon whom is wrath, nor astray. O Allah, protect me from the trials of the world and grant me success in what You love and are pleased with, and rectify all my affairs for me, and make me firm with the firm word in the worldly life and in the Hereafter, and do not lead me astray, even if I have been unjust. Glory be to You, glory be to You, O Exalted, O Magnificent, O Creator, O Merciful, O Mighty, O Compeller. Glory be to Him for whom the heavens glorify with their expanses, and glory be to Him for whom the seas glorify with their waves, and glory be to Him for whom the mountains glorify with their echoes, and glory be to Him for whom the fish glorify with their languages, and glory be to Him for whom the stars in the sky glorify with their constellations, and glory be to Him for whom the trees glorify with their roots and fruits, and glory be to Him for whom the seven heavens and the seven earths glorify, and whoever is in them and upon them. Glory be to Him whom everything from His creatures glorifies. Blessed and Exalted are You. Glory be to You, glory be to You, O Living, O Self-Subsisting, O All-Knowing, O Forbearing. Glory be to You, there is no god but You alone, no partner to You. You give life and cause death, and You are Living, do not die. In Your hand is good, and You have power over all things.", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance", "badge": "Du'a"}, {"arabic": "ستغفرك وأتوب إليك آمنت اللهم بما أرسلته من رسول وآمنت اللهم  بما  أنزلت  من\nكتاب وصلى الله على محمد النبي الأمي وعلى آله وسلم تسليما  كثيرا  خاتم  كلامي\nومفتاحه وعلى أنبيائه ورسله أجمعين آمين يا رب العالمين اللهم أوردنا حوض  محمد\nواسقنا بكأسه مشربا رويا سائغا هنيا لا نظمأ بعده أبدا واحشرنا  في  زمرته  غير\nخزايا ولا ناكثين للعهد ولا مرتابين ولا مفتونين ولا  مغضوب  علينا  ولا  ضالين\nاللهم اعصمني من فتن الدنيا ووفقني لما تحب وترضى وأصلح  لي  شأني  كله  وثبتني\nبالقول الثابت في الحياة الدنيا وفي الآخ", "english": "[159] Hadith: 'Glory be to You, O Allah, and praise be to You, there is no god but You, I have done evil and wronged my soul (Nafs), so forgive me my sin, You are my Lord, indeed none forgives sins except You.' Al-Bayhaqi reported it in 'Al-Da'awat' from the narration of 'Ali, without the phrase 'my sin, You are my Lord,' and it has preceded in the second chapter.", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance", "badge": "Du'a"}], "90": [{"arabic": "السادس: التضرع والخشوع والرغبة والرهبة قال الله تعالى: ﴿ إنهم كانوا يسارعون في الخيرات ويدعوننا رغبا ورهبا ﴾ {} وقال عز وجل: ﴿ ادعوا ربكم تضرعا وخفية ﴾ {} وقال ﭬ: (إذا أحب الله عبدا ابتلاه حتى يسمع تضرعه[87]).", "english": "Sixth: Supplication (Tadarru'), Humility (Khushu'), Desire (Raghba), and Fear (Rahba). Allah the Exalted said: 'Indeed they used to hasten to good deeds and call upon Us with desire and fear' (Quran 21:90). And He the Mighty and Majestic said: 'Call upon your Lord with supplication and in secret' (Quran 7:55). And the Prophet (peace be upon him) said: 'When Allah loves a servant, He tests him until He hears his supplication.'", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance", "badge": "Du'a"}], "91": [{"arabic": "وقال عز وجل: \" فأرسلنا إليها روحنا فتمثل لها بشراً سوياً \"، ثم قال تعالى: \" فنفخنا فيها من روحنا \" وكان النافخ جبريل عليه السلام، وكما قال تعالى: \" فإذا قرأناه فاتبع قرآنه \" قيل في التفسير: معناه إذا قرأه عليك جبريل.", "english": "And He, the Exalted, said: \"So We sent to her Our Spirit (Ruh), and he appeared to her as a well-proportioned man.\" Then He, the Exalted, said: \"And she who guarded her chastity, so We breathed into her from Our Spirit (Ruh), and We made her and her son a sign for the worlds.\" And the blower was Gabriel, peace be upon him. And as He, the Exalted, said: \"So when We have recited it, then follow its recitation.\" It is said in the interpretation (Tafsir): its meaning is when Gabriel recites it to you.", "book_file": "vol4_Vol4-book5.doc.txt", "book_title": "Monotheism and Reliance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monotheism and Reliance'", "badge": "Insight"}], "101": [{"arabic": "فخوف الخاتمة كخوف السابقة وربما يظهر في الحال ما سبقت الكلمة بنقيضه. فمن الذي يدري أنه من الذين سبقت لهم من الله الحسنى وقيل في معنى قوله تعالى: ﴿ وجاءت سكرة الموت بالحق ﴾ {} أي بالسابقة يعني أظهرتها. وقال بعض السلف إنما يوزن من الأعمال خواتيمها وكان أبو الدرداء رضي الله عنه يحلف بالله ما من أحد يأمن أن يسلب إيممانه إلا سلبه وقيل من الذنوب ذنوب عقوبتها سوء الخاتمة، نعوذ بالله من ذلك وقيل هي عقوبات دعوى الولاية واالكرامة بالافتراء.", "english": "The fear of the ending (Al-Khatimah) is like the fear of the precedent (As-Sabiqah), and perhaps what appears in the present moment contradicts what the word (Al-Kalimah) preceded. So who knows that he is from those for whom the good (Al-Husna) has preceded from Allah? And it was said regarding the meaning of His saying, the Exalted: 'And the agony of death (Sakrat Al-Mawt) comes with the truth (Al-Haqq)' - meaning with the precedent (As-Sabiqah), that is, it reveals it. And some of the predecessors (As-Salaf) said: 'Only the endings (Al-Khawatim) of deeds are weighed.' And Abu Ad-Darda', may Allah be pleased with him, would swear by Allah that no one feels secure from having his faith (Iman) stripped away except that it is stripped from him. And it was said: Among sins (Adh-Dhunub) are sins whose punishment is a bad ending (Su' Al-Khatimah) - we seek refuge in Allah from that. And it was said: They are punishments for claiming sainthood (Al-Wilayah) and honor (Al-Karamah) through falsehood.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Foundations of Belief'", "badge": "Insight"}, {"arabic": "فإنه المستصفى لقلوب الصديقين والمبعد لقلوب الجاحدين والمغرورين فلا مانع لما أعطى ولا معطي لما منع ولم يقطع التوفيق عن الكفار لجناية متقدمة ولا أمد الأنبياء عليهم السلام بتوفيقه ونور هدايته لوسيلة سابقة ولكنه قال ولقد سبقت كلمتنا لعبادنا المرسلين وقال عز وجل ولكن حق القول مني لأملأن جهنم من الجنة والناس أجمعين وقال تعالى إن الذين سبقت لهم منا الحسنى أولئك عنها مبعدون فإن خطر ببالك أنه لم اختلفت السابقة وهم في ربقه العبودية مشتركون نوديت من سرادقات الجلال لا تجاوز حد الأدب فإنه لا يسئل عما يفعل وه", "english": "For He is the One Who selects the hearts (Qulūb) of the truthful ones (Ṣiddīqīn) and distances the hearts (Qulūb) of the deniers and the deluded ones. There is no preventer for what He gives, and no giver for what He withholds. He did not cut off divine facilitation (Tawfīq) from the disbelievers due to a preceding transgression, nor did He extend to the Prophets, peace be upon them, His facilitation (Tawfīq) and light of guidance (Hidāyah) due to a prior means. Rather, He said: 'And Our word has already preceded for Our servants, the messengers' (Quran 37:171). And the Almighty said: 'But the word from Me will come true: \"I will fill Hell with jinn and mankind all together.\"' (Quran 32:13). And the Exalted said: 'Indeed, those for whom the best [reward] has preceded from Us - they are from it [Hell] distanced' (Quran 21:101). If it occurs to your mind that the precedence has not differed while they are partners in the bond of servitude, you are called from the pavilions of majesty: 'Do not exceed the limit of etiquette, for He is not questioned about what He does, but they will be questioned.'", "book_file": "vol2_j2-k08.doc.txt", "book_title": "Audition and Ecstasy", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Audition and Ecstasy'", "badge": "Insight"}, {"arabic": "والهالكون في التيه هم الأكثرون من ركاب هذه الطريق ولكن السائحون بنور التوفيق فازوا بالنعيم والملك المقيم وهم الذين سبقت لهم من الله الحسنى", "english": "And those who perish in the wilderness are the majority of the riders on this path, but those who journey with the light of Divine Success (Tawfīq) have attained bliss and the abiding kingdom, and they are those for whom the good has preceded from Allah.", "book_file": "vol2_j2-k07.doc.txt", "book_title": "Etiquette of Travel", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Etiquette of Travel'", "badge": "Hadith"}, {"arabic": "اللهم إن أنت أمرضتني لتقبض روحي في مرضي هذا فاجعل روحي في أرواح من سبقت لهم منك الحسنى وباعدني من النار كما باعدت أولياءك الذين سبقت لهم منك الحسنى", "english": "O Allah, if You have made me ill to take my soul (Ruh) in this illness of mine, then place my soul (Ruh) among the souls (Arwah) of those for whom the good (Al-Husna) has preceded from You, and distance me from the Fire as You have distanced Your allies (Awliya) for whom the good (Al-Husna) has preceded from You.", "book_file": "vol2_j2-k05.doc.txt", "book_title": "Duties of Brotherhood", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "104": [{"arabic": "وكما أن الأبرار يجدون المزيد في حالهم ومعرفتهم بقربهم من المقربين ومشاهدتهم لهم، فكذلك يكون حالهم في الآخرة \"ما خلقكم ولا بعثكم إلا كنفس واحدة كما بدأنا أول خلق نعيده\"، وكما قال تعالى: \"جزاء وفاقاً\" أي وافق الجزاء أعمالهم فقوبل الخالص بالصرف من الشراب وقوبل المشوب بالمشوب، وشوب كل شراب على قدر ما سبق من الشوب في حبه وأعماله", "english": "And just as the righteous (al-abrar) find increase in their state and knowledge through their proximity to the close ones (al-muqarrabun) and their witnessing of them, so too will be their state in the Hereafter: \"We did not create you nor resurrect you except as a single soul (nafs), just as We began the first creation We repeat it,\" and as Allah the Exalted said: \"A recompense in accordance (wafaqan),\" meaning the recompense corresponded to their deeds, so the pure was met with the pure from the drink and the mixed was met with the mixed, and the mixing of each drink is according to what preceded of mixing in his love and his deeds.", "book_file": "vol4_Vol4-book6.doc.txt", "book_title": "Love, Longing, Intimacy and Contentment", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}, {"arabic": "ويحك يا نفس انزعى عن جهلك وقيسى آخرتك بدنياك فما خلقكم ولا بعثكم إلا كنفس واحدة و كما بدأنا أول خلق نعيده و كما بدأكم تعودون وسنة الله تعالى لا تجدين لها تبديلا ولا تحويلا", "english": "Woe to you, O Soul (Nafs)! Cast off your ignorance and measure your Hereafter (Akhirah) by your worldly life, for He did not create you nor resurrect you except as a single soul, and 'As We began the first creation, We will repeat it' (Quran 21:104), and as He began you, you will return. And the Way (Sunnah) of Allah, the Exalted, you will find no change or alteration for it.", "book_file": "vol4_j4-k08.doc.txt", "book_title": "Monitoring and Accounting", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monitoring and Accounting'", "badge": "Insight"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 1552], [2, 1552, 3268], [3, 3268, 4876], [4, 4876, 5692], [5, 5692, 6292], [6, 6292, 7228], [7, 7228, 9258]], "2": [[1, 400, 1009], [2, 1009, 2671], [3, 2671, 3479], [4, 3479, 4205], [5, 4205, 5013], [6, 5013, 6277], [7, 6277, 7600], [8, 7600, 8665], [9, 8665, 10304], [10, 10304, 11100], [11, 11100, 12785]], "3": [[1, 400, 1837], [2, 1837, 3472], [3, 3472, 5614], [4, 5614, 7595], [5, 7595, 8994], [6, 8994, 10579], [7, 10579, 11050], [8, 11050, 12709], [9, 12709, 13836], [10, 13836, 14629], [11, 14629, 16251], [12, 16251, 18208], [13, 18208, 19527], [14, 19527, 20939], [15, 20939, 22685]], "4": [[1, 400, 1122], [2, 1122, 1929], [3, 1929, 2822], [4, 2822, 3771], [5, 3771, 4246], [6, 4246, 5990], [7, 5990, 7186], [8, 7186, 7927], [9, 7927, 9242], [10, 9242, 10381]], "5": [[1, 400, 907], [2, 907, 3264], [3, 3264, 4623], [4, 4623, 5865], [5, 5865, 6372], [6, 6372, 8045], [7, 8045, 8552], [8, 8552, 9160], [9, 9160, 10427], [10, 10427, 12531], [11, 12531, 13849], [12, 13849, 15410], [13, 15410, 16500], 