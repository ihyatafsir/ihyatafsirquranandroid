 "narration": "warsh"}, {"surah": 21, "ayah": 100, "text": "لَهُمْ فِيهَا زَفِيرࣱ وَهُمْ فِيهَا لَا يَسْمَعُونَۖ", "words": [{"id": 1, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "زَفِيرࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "", "root": ""}, {"id": 7, "arabic": "يَسْمَعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 101, "text": "۞إِنَّ اَ۬لذِينَ سَبَقَتْ لَهُم مِّنَّا اَ۬لْحُسْن۪يٰٓ أُوْلَٰٓئِكَ عَنْهَا مُبْعَدُونَۖ", "words": [{"id": 1, "arabic": "۞إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "سَبَقَتْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَهُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّنَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْحُسْن۪يٰٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "أُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَنْهَا", "translit": "", "root": ""}, {"id": 9, "arabic": "مُبْعَدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 102, "text": "لَا يَسْمَعُونَ حَسِيسَهَا وَهُمْ فِے مَا اَ۪شْتَهَتَ اَنفُسُهُمْ خَٰلِدُونَۖ", "words": [{"id": 1, "arabic": "لَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَسْمَعُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "حَسِيسَهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۪شْتَهَتَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَنفُسُهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "خَٰلِدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 103, "text": "لَا يَحْزُنُهُمُ اُ۬لْفَزَعُ اُ۬لَاكْبَرُۖ وَتَتَلَقّ۪يٰهُمُ اُ۬لْمَلَٰٓئِكَةُ هَٰذَا يَوْمُكُمُ اُ۬لذِے كُنتُمْ تُوعَدُونَۖ", "words": [{"id": 1, "arabic": "لَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَحْزُنُهُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْفَزَعُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لَاكْبَرُۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَتَتَلَقّ۪يٰهُمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لْمَلَٰٓئِكَةُ", "translit": "", "root": ""}, {"id": 7, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 8, "arabic": "يَوْمُكُمُ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬لذِے", "translit": "", "root": ""}, {"id": 10, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "تُوعَدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 104, "text": "يَوْمَ نَطْوِے اِ۬لسَّمَآءَ كَطَيِّ اِ۬لسِّجِلِّ لِلْكِتَٰبِۖ كَمَا بَدَأْنَآ أَوَّلَ خَلْقࣲ نُّعِيدُهُۥۖ وَعْداً عَلَيْنَآۖ إِنَّا كُنَّا فَٰعِلِينَۖ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَطْوِے", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لسَّمَآءَ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَطَيِّ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لسِّجِلِّ", "translit": "", "root": ""}, {"id": 6, "arabic": "لِلْكِتَٰبِۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "كَمَا", "translit": "", "root": ""}, {"id": 8, "arabic": "بَدَأْنَآ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَوَّلَ", "translit": "", "root": ""}, {"id": 10, "arabic": "خَلْقࣲ", "translit": "", "root": ""}, {"id": 11, "arabic": "نُّعِيدُهُۥۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَعْداً", "translit": "", "root": ""}, {"id": 13, "arabic": "عَلَيْنَآۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 15, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 16, "arabic": "فَٰعِلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 105, "text": "وَلَقَدْ كَتَبْنَا فِے اِ۬لزَّبُورِ مِنۢ بَعْدِ اِ۬لذِّكْرِ أَنَّ اَ۬لَارْضَ يَرِثُهَا عِبَادِيَ اَ۬لصَّٰلِحُونَۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَتَبْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لزَّبُورِ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 6, "arabic": "بَعْدِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لذِّكْرِ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَنَّ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لَارْضَ", "translit": "", "root": ""}, {"id": 10, "arabic": "يَرِثُهَا", "translit": "", "root": ""}, {"id": 11, "arabic": "عِبَادِيَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬لصَّٰلِحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 106, "text": "إِنَّ فِے هَٰذَا لَبَلَٰغاࣰ لِّقَوْمٍ عَٰبِدِينَۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "لَبَلَٰغاࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِّقَوْمٍ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَٰبِدِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 107, "text": "وَمَآ أَرْسَلْنَٰكَ إِلَّا رَحْمَةࣰ لِّلْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَٰكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "رَحْمَةࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِّلْعَٰلَمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 108, "text": "قُلِ اِنَّمَا يُوح۪يٰٓ إِلَيَّ أَنَّمَآ إِلَٰهُكُمُۥٓ إِلَٰهࣱ وَٰحِدࣱۖ فَهَلَ اَنتُم مُّسْلِمُونَۖ", "words": [{"id": 1, "arabic": "قُلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِنَّمَا", "translit": "", "root": ""}, {"id": 3, "arabic": "يُوح۪يٰٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَيَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَنَّمَآ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِلَٰهُكُمُۥٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَٰهࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَٰحِدࣱۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "فَهَلَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَنتُم", "translit": "", "root": ""}, {"id": 11, "arabic": "مُّسْلِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 109, "text": "فَإِن تَوَلَّوْاْ فَقُلَ اٰذَنتُكُمْ عَلَيٰ سَوَآءࣲۖ وَإِنَ اَدْرِےٓ أَقَرِيبٌ اَم بَعِيدࣱ مَّا تُوعَدُونَۖ", "words": [{"id": 1, "arabic": "فَإِن", "translit": "", "root": ""}, {"id": 2, "arabic": "تَوَلَّوْاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَقُلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اٰذَنتُكُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "سَوَآءࣲۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَإِنَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَدْرِےٓ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَقَرِيبٌ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَم", "translit": "", "root": ""}, {"id": 11, "arabic": "بَعِيدࣱ", "translit": "", "root": ""}, {"id": 12, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 13, "arabic": "تُوعَدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 110, "text": "إِنَّهُۥ يَعْلَمُ اُ۬لْجَهْرَ مِنَ اَ۬لْقَوْلِ وَيَعْلَمُ مَا تَكْتُمُونَۖ", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَعْلَمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْجَهْرَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْقَوْلِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَيَعْلَمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَا", "translit": "", "root": ""}, {"id": 8, "arabic": "تَكْتُمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 111, "text": "وَإِنَ اَدْرِے لَعَلَّهُۥ فِتْنَةࣱ لَّكُمْ وَمَتَٰعٌ اِلَيٰ حِينࣲۖ", "words": [{"id": 1, "arabic": "وَإِنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَدْرِے", "translit": "", "root": ""}, {"id": 3, "arabic": "لَعَلَّهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِتْنَةࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمَتَٰعٌ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِلَيٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "حِينࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 112, "text": "قُل رَّبِّ اِ۟حْكُم بِالْحَقِّۖ وَرَبُّنَا اَ۬لرَّحْمَٰنُ اُ۬لْمُسْتَعَانُ عَلَيٰ مَا تَصِفُونَۖ", "words": [{"id": 1, "arabic": "قُل", "translit": "", "root": ""}, {"id": 2, "arabic": "رَّبِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۟حْكُم", "translit": "", "root": ""}, {"id": 4, "arabic": "بِالْحَقِّۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَرَبُّنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لرَّحْمَٰنُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْمُسْتَعَانُ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَا", "translit": "", "root": ""}, {"id": 10, "arabic": "تَصِفُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}]}