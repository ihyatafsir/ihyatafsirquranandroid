": "", "root": ""}, {"id": 5, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لصَّٰلِحِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 87, "text": "۞وَذَا اَ۬لنُّونِ إِذ ذَّهَبَ مُغَٰضِباࣰ فَظَنَّ أَن لَّن نَّقْدِرَ عَلَيْهِ فَنَاد۪يٰ فِے اِ۬لظُّلُمَٰتِ أَن لَّآ إِلَٰهَ إِلَّآ أَنتَ سُبْحَٰنَكَ إِنِّے كُنتُ مِنَ اَ۬لظَّٰلِمِينَۖ", "words": [{"id": 1, "arabic": "۞وَذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لنُّونِ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِذ", "translit": "", "root": ""}, {"id": 4, "arabic": "ذَّهَبَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُغَٰضِباࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَظَنَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَن", "translit": "", "root": ""}, {"id": 8, "arabic": "لَّن", "translit": "", "root": ""}, {"id": 9, "arabic": "نَّقْدِرَ", "translit": "", "root": ""}, {"id": 10, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 11, "arabic": "فَنَاد۪يٰ", "translit": "", "root": ""}, {"id": 12, "arabic": "فِے", "translit": "", "root": ""}, {"id": 13, "arabic": "اِ۬لظُّلُمَٰتِ", "translit": "", "root": ""}, {"id": 14, "arabic": "أَن", "translit": "", "root": ""}, {"id": 15, "arabic": "لَّآ", "translit": "", "root": ""}, {"id": 16, "arabic": "إِلَٰهَ", "translit": "", "root": ""}, {"id": 17, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 18, "arabic": "أَنتَ", "translit": "", "root": ""}, {"id": 19, "arabic": "سُبْحَٰنَكَ", "translit": "", "root": ""}, {"id": 20, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 21, "arabic": "كُنتُ", "translit": "", "root": ""}, {"id": 22, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 23, "arabic": "اَ۬لظَّٰلِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 88, "text": "فَاسْتَجَبْنَا لَهُۥ وَنَجَّيْنَٰهُ مِنَ اَ۬لْغَمِّۖ وَكَذَٰلِكَ نُۨجِے اِ۬لْمُومِنِينَۖ", "words": [{"id": 1, "arabic": "فَاسْتَ