ۦ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "", "root": ""}, {"id": 6, "arabic": "هَٰذِهِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لتَّمَاثِيلُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لتِےٓ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَنتُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَهَا", "translit": "", "root": ""}, {"id": 11, "arabic": "عَٰكِفُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 53, "text": "قَالُواْ وَجَدْنَآ ءَابَآءَنَا لَهَا عَٰبِدِينَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَجَدْنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَابَآءَنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "لَهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "عَٰبِدِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 54, "text": "قَالَ لَقَدْ كُنتُمُۥٓ أَنتُمْ وَءَابَآؤُكُمْ فِے ضَلَٰلࣲ مُّبِينࣲۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَقَدْ", "translit": "", "root": ""}, {"id": 3, "arabic": "كُنتُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنتُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَءَابَآؤُكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "ضَلَٰلࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُّبِينࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 55, "text": "قَالُوٓاْ أَجِئْتَنَا بِالْحَقِّ أَمَ اَنتَ مِنَ اَ۬للَّٰعِبِينَۖ", "words": [{"id": 1, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَجِئْتَنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "بِالْحَقِّ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَمَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَنتَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬للَّٰعِبِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 56, "text": "قَالَ بَل رَّبُّكُمْ رَبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ اِ۬لذِے فَطَرَهُنَّۖ وَأَنَا عَلَيٰ ذَٰلِكُم مِّنَ اَ۬لشَّٰهِدِينَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَل", "translit": "", "root": ""}, {"id": 3, "arabic": "رَّبُّكُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبُّ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَالَارْضِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لذِے", "translit": "", "root": ""}, {"id": 8, "arabic": "فَطَرَهُنَّۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَأَنَا", "translit": "", "root": ""}, {"id": 10, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 11, "arabic": "ذَٰلِكُم", "translit": "", "root": ""}, {"id": 12, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 13, "arabic": "اَ۬لشَّٰهِدِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 57, "text": "وَتَاللَّهِ لَأَكِيدَنَّ أَصْنَٰمَكُم بَعْدَ أَن تُوَلُّواْ مُدْبِرِينَۖ", "words": [{"id": 1, "arabic": "وَتَاللَّهِ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَأَكِيدَنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَصْنَٰمَكُم", "translit": "", "root": ""}, {"id": 4, "arabic": "بَعْدَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَن", "translit": "", "root": ""}, {"id": 6, "arabic": "تُوَلُّواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُدْبِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 58, "text": "فَجَعَلَهُمْ جُذَٰذاً اِلَّا كَبِيراࣰ لَّهُمْ لَعَلَّهُمُۥٓ إِلَيْهِ يَرْجِعُونَۖ", "words": [{"id": 1, "arabic": "فَجَعَلَهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "جُذَٰذاً", "translit": "", "root": ""}, {"id": 3, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "كَبِيراࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَعَلَّهُمُۥٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَيْهِ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَرْجِعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 59, "text": "قَالُواْ مَن فَعَلَ هَٰذَا بِـَٔالِهَتِنَآ إِنَّهُۥ لَمِنَ اَ۬لظَّٰلِمِينَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "", "root": ""}, {"id": 3, "arabic": "فَعَلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 5, "arabic": "بِـَٔالِهَتِنَآ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَمِنَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لظَّٰلِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 60, "text": "قَالُواْ سَمِعْنَا فَتيࣰ يَذْكُرُهُمْ يُقَالُ لَهُۥٓ إِبْرَٰهِيمُۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "سَمِعْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فَتيࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَذْكُرُهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يُقَالُ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَهُۥٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِبْرَٰهِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 61, "text": "قَالُواْ فَاتُواْ بِهِۦ عَلَيٰٓ أَعْيُنِ اِ۬لنَّاسِ لَعَلَّهُمْ يَشْهَدُونَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَاتُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَعْيُنِ", "translit": "", "root": ""}, 