", "translit": "", "root": ""}, {"id": 9, "arabic": "فَهُمُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لْخَٰلِدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 35, "text": "كُلُّ نَفْسࣲ ذَآئِقَةُ اُ۬لْمَوْتِۖ وَنَبْلُوكُم بِالشَّرِّ وَالْخَيْرِ فِتْنَةࣰۖ وَإِلَيْنَا تُرْجَعُونَۖ", "words": [{"id": 1, "arabic": "كُلُّ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَفْسࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "ذَآئِقَةُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْمَوْتِۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَنَبْلُوكُم", "translit": "", "root": ""}, {"id": 6, "arabic": "بِالشَّرِّ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَالْخَيْرِ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِتْنَةࣰۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَإِلَيْنَا", "translit": "", "root": ""}, {"id": 10, "arabic": "تُرْجَعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 36, "text": "وَإِذَا ر۪ء۪اكَ اَ۬لذِينَ كَفَرُوٓاْ إِنْ يَّتَّخِذُونَكَ إِلَّا هُزُؤاًۖ اَهَٰذَا اَ۬لذِے يَذْكُرُ ءَالِهَتَكُمْ وَهُم بِذِكْرِ اِ۬لرَّحْمَٰنِ هُمْ كَٰفِرُونَۖ", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "ر۪ء۪اكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَفَرُوٓاْ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنْ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَّتَّخِذُونَكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "هُزُؤاًۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَهَٰذَا", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 11, "arabic": "يَذْكُرُ", "translit": "", "root": ""}, {"id": 12, "arabic": "ءَالِهَتَكُمْ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَهُم", "translit": "", 