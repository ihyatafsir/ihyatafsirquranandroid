, "arabic": "إِلَيْهِمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَسْـَٔلُوٓاْ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَهْلَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لذِّكْرِ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِن", "translit": "", "root": ""}, {"id": 12, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 13, "arabic": "لَا", "translit": "", "root": ""}, {"id": 14, "arabic": "تَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 8, "text": "وَمَا جَعَلْنَٰهُمْ جَسَداࣰ لَّا يَاكُلُونَ اَ۬لطَّعَامَۖ وَمَا كَانُواْ خَٰلِدِينَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَعَلْنَٰهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "جَسَداࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "يَاكُلُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لطَّعَامَۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 8, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "خَٰلِدِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 9, "text": "ثُمَّ صَدَقْنَٰهُمُ اُ۬لْوَعْدَ فَأَنجَيْنَٰهُمْ وَمَن نَّشَآءُ وَأَهْلَكْنَا اَ۬لْمُسْرِفِينَۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "صَدَقْنَٰهُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْوَعْدَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَأَنجَيْنَٰهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَن", "translit": "", "root": ""}, {"id": 6, "arabic": "نَّشَآءُ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَأَهْلَكْنَا", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لْمُسْرِفِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 10, "text": "لَقَدَ اَنزَلْنَآ إِلَيْكُمْ كِتَٰباࣰ فِيهِ ذِكْرُكُمُۥٓۖ 