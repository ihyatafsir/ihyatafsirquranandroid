 تَكْتُمُونَۖ", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَعْلَمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْجَهْرَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْقَوْلِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَيَعْلَمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَا", "translit": "", "root": ""}, {"id": 8, "arabic": "تَكْتُمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 111, "text": "وَإِنَ اَدْرِے لَعَلَّهُۥ فِتْنَةࣱ لَّكُمْ وَمَتَٰعٌ اِلَيٰ حِينࣲۖ", "words": [{"id": 1, "arabic": "وَإِنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَدْرِے", "translit": "", "root": ""}, {"id": 3, "arabic": "لَعَلَّهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِتْنَةࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمَتَٰعٌ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِلَيٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "حِينࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 21, "ayah": 112, "text": "قُل رَّبِّ اِ۟حْكُم بِالْحَقِّۖ وَرَبُّنَا اَ۬لرَّحْمَٰنُ اُ۬لْمُسْتَعَانُ عَلَيٰ مَا تَصِفُونَۖ", "words": [{"id": 1, "arabic": "قُل", "translit": "", "root": ""}, {"id": 2, "arabic": "رَّبِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۟حْكُم", "translit": "", "root": ""}, {"id": 4, "arabic": "بِالْحَقِّۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَرَبُّنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لرَّحْمَٰنُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْمُسْتَعَانُ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَا", "translit": "", "root": ""}, {"id": 10, "arabic": "تَصِفُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}]}