: ""}, {"id": 14, "arabic": "أَنْعَٰمُهُمْ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَأَنفُسُهُمُۥٓۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "أَفَلَا", "translit": "", "root": ""}, {"id": 17, "arabic": "يُبْصِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 32, "ayah": 28, "text": "وَيَقُولُونَ مَت۪يٰ هَٰذَا اَ۬لْفَتْحُ إِن كُنتُمْ صَٰدِقِينَۖ", "words": [{"id": 1, "arabic": "وَيَقُولُونَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَت۪يٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْفَتْحُ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِن", "translit": "", "root": ""}, {"id": 6, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "صَٰدِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 32, "ayah": 29, "text": "قُلْ يَوْمَ اَ۬لْفَتْحِ لَا يَنفَعُ اُ۬لذِينَ كَفَرُوٓاْ إِيمَٰنُهُمْ وَلَا هُمْ يُنظَرُونَۖ", "words": [{"id": 1, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْفَتْحِ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يَنفَعُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 7, "arabic": "كَفَرُوٓاْ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِيمَٰنُهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 10, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "يُنظَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 32, "ayah": 30, "text": "فَأَعْرِضْ عَنْهُمْ وَانتَظِرِۖ اِنَّهُم مُّنتَظِرُونَۖ", "words": [{"id": 1, "arabic": "فَأَعْرِضْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَنْهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَانتَظِرِۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِنَّهُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّنتَظِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}]}