, {"surah": 32, "ayah": 24, "text": "وَجَعَلْنَا مِنْهُمُۥٓ أَئِمَّةࣰ يَهْدُونَ بِأَمْرِنَا لَمَّا صَبَرُواْۖ وَكَانُواْ بِـَٔايَٰتِنَا يُوقِنُونَۖ", "words": [{"id": 1, "arabic": "وَجَعَلْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مِنْهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَئِمَّةࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَهْدُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِأَمْرِنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "لَمَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "صَبَرُواْۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَكَانُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "بِـَٔايَٰتِنَا", "translit": "", "root": ""}, {"id": 10, "arabic": "يُوقِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 32, "ayah": 25, "text": "إِنَّ رَبَّكَ هُوَ يَفْصِلُ بَيْنَهُمْ يَوْمَ اَ۬لْقِيَٰمَةِ فِيمَا كَانُواْ فِيهِ يَخْتَلِفُونَۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَفْصِلُ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَيْنَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْقِيَٰمَةِ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِيمَا", "translit": "", "root": ""}, {"id": 9, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 11, "arabic": "يَخْتَلِفُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 32, "ayah": 26, "text": "أَوَلَمْ يَهْدِ لَهُمْ كَمَ اَهْلَكْنَا مِن قَبْلِهِم مِّنَ اَ۬لْقُرُونِ يَمْشُونَ فِے مَسَٰكِنِهِمُۥٓۖ إِنَّ فِے ذَٰلِكَ لَأٓيَٰتٍۖ اَفَلَا يَسْمَعُونَۖ", "words": [{"id": 1, "arabic": "أَوَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَهْدِ", "translit": "", "root": ""}, {"id": 3, 