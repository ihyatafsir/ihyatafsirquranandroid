"فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 16, "arabic": "لَءَايَٰتٍ", "translit": "ٍtَٰyāَءَl", "root": "ايي"}, {"id": 17, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 18, "arabic": "يَسْمَعُونَ", "translit": "َnwُʿعَmْsَy", "root": "سمع"}], "hasIhya": false}, {"ayah": 27, "text": "أَوَلَمْ يَرَوْا۟ أَنَّا نَسُوقُ ٱلْمَآءَ إِلَى ٱلْأَرْضِ ٱلْجُرُزِ فَنُخْرِجُ بِهِۦ زَرْعًا تَأْكُلُ مِنْهُ أَنْعَٰمُهُمْ وَأَنفُسُهُمْۖ أَفَلَا يُبْصِرُونَ ", "translation": "Have they not seen that We drive water [in clouds] to barren land and bring forth thereby crops from which their livestock eat and [they] themselves? Then do they not see?", "words": [{"id": 1, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 2, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 3, "arabic": "أَنَّا", "translit": "āَّnَaʾ", "root": ""}, {"id": 4, "arabic": "نَسُوقُ", "translit": "ُqwُsَn", "root": "سوق"}, {"id": 5, "arabic": "ٱلْمَآءَ", "translit": "َءٓāَmْlٱ", "root": "موه"}, {"id": 6, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "ٱلْجُرُزِ", "translit": "ِzُrُjgْlٱ", "root": "جرز"}, {"id": 9, "arabic": "فَنُخْرِجُ", "translit": "ُjgِrْhkُnَf", "root": "خرج"}, {"id": 10, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 11, "arabic": "زَرْعًا", "translit": "āًʿعْrَz", "root": "زرع"}, {"id": 12, "arabic": "تَأْكُلُ", "translit": "ُlُkْaʾَt", "root": "اكل"}, {"id": 13, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 14, "arabic": "أَنْعَٰمُهُمْ", "translit": "ْmُhُmَٰʿعْnَaʾ", "root": "نعم"}, {"id": 15, "arabic": "وَأَنفُسُهُمْ", "translit": "ْmُhُsُfnَaʾَw", "root": "نفس"}, {"id": 16, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 17, "arabic": "يُبْصِرُونَ", "translit": "َnwُrِṣْbُy", "root": "بصر"}], "hasIhya": false}, {"ayah": 28, "text": "وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلْفَتْحُ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "And they say, \"When will be this conquest,[1] if you should be truthful?\"", "words": [{"id": 1, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 2, "arabic": "مَتَىٰ", "translit": "ٰàَtَm", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "ٱلْفَتْحُ", "translit": "ُḥْtَfْlٱ", "root": "فتح"}, {"id": 5, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 6, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 7, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": false}, {"ayah": 29, "text": "قُلْ يَوْمَ ٱلْفَتْحِ لَا يَنفَعُ ٱلَّذِينَ كَفَرُوٓا۟ إِيمَٰنُهُمْ وَلَا هُمْ يُنظَرُونَ ", "translation": "Say, [O Muḥammad], \"On the Day of Conquest the belief of those who had disbelieved will not benefit them, nor will they be reprieved.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 3, "arabic": "ٱلْفَتْحِ", "translit": "ِḥْtَfْlٱ", "root": "فتح"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "يَنفَعُ", "translit": "ُʿعَfnَy", "root": "نفع"}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 8, "arabic": "إِيمَٰنُهُمْ", "translit": "ْmُhُnَٰmyِiʾ", "root": "امن"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 11, "arabic": "يُنظَرُونَ", "translit": "َnwُrَẓnُy", "root": "نظر"}], "hasIhya": false}, {"ayah": 30, "text": "فَأَعْرِضْ عَنْهُمْ وَٱنتَظِرْ إِنَّهُم مُّنتَظِرُونَ ", "translation": "So turn away from them and wait. Indeed, they are waiting.", "words": [{"id": 1, "arabic": "فَأَعْرِضْ", "translit": "ْḍِrْʿعَaʾَf", "root": "عرض"}, {"id": 2, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 3, "arabic": "وَٱنتَظِرْ", "translit": "ْrِẓَtnٱَw", "root": "نظر"}, {"id": 4, "arabic": "إِنَّهُم", "translit": "mُhَّnِiʾ", "root": ""}, {"id": 5, "arabic": "مُّنتَظِرُونَ", "translit": "َnwُrِẓَtnُّm", "root": "نظر"}], "hasIhya": false}], "tafsir": {"7": [{"arabic": "وجده البعيد تراب ذليل وقد عرفه الله تعالى نسبه فقال {الذي أحسن كل شيء خلقه وبدأ خلق الإنسان من طين ثم جعل نسله من سلالة من ماء مهين} فمن أصله التراب المهين الذي يداس بالأقدام ثم خمر طينة حتى صار حمأ مسنونا كيف يتكبر وأخس الأشياء ما إليه انتسابه إذ يقال يا أذل من التراب ويا أنتن من الحمأة ويا أقذر من المضغة فإن كان كونه من أبيه أقرب من كونه من التراب فنقول افتخر بالقريب دون البعيد فالنطفة والمضغة أقرب إليه من الأب فليحقر نفسه بذلك ثم إن كان ذلك يوجب رفعة لقربة فالأب الأعلى من التراب فمن أين رفعته وإذا لم يكن له رفعة فمن أين جاءت الرفعة لولده فإذن أصله من التراب وفصله من النطفة", "english": "The second [remedy] is that he should come to know his true lineage, and thus know his father and his grandfather. For his near father is a filthy drop [of semen], and his distant grandfather is abject dust. Indeed, Allah Most High has made known to him his lineage, saying: {«الذي أحسن كل شيء خلقه وبدأ خلق الإنسان من طين ثم جعل نسله من سلالة من ماء مهين»} — \"He who perfected everything He created, and began the creation of the human being from clay, then made his progeny from an extract of despicable water\" {Quran 32:7-8}. So when his origin is the abject dust that is trodden underfoot, and then his clay was fermented until it became stinking black mud — how can he be arrogant? For the most contemptible of things is that to which his lineage traces back, since it is said: \"O you more abject than dust! O you more foul than stinking mud! O you more filthy than a clot of blood [chewed flesh]!\"", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 866", "section_title_en": "The Second Cause of Pride: Pride of Lineage and Its Remedy — Section 866", "section_index": 866, "anchors": "- Root: نطف (naṭafa)\n  * Lisan / Ayn: Water that flows and drips; the seminal fluid; pure water.\n  * Al-Raghib (Mufradat): \"النطفة: الماء الصافي، ويعبر بها عن ماء الرجل\" — The drop of fluid, clear water, used technically for the male seminal emission; a Quranic term for the origin of human creation.\n  * Al-Zamakhshari (Asas): Literal: pure water, whether little or much. Metaphorical: \"ليلة نطوف: مطرت حتى الصباح\" — extended to anything flowing; here, the base material of human origin.\n- Root: نسب (nasaba)\n  * Lisan / Ayn: Lineage, kinship, relation by descent.\n  * Al-Raghib (Mufradat): \"النسب والنسبة: اشتراك من جهة أحد الأبوين\" — Participation through one of the two parents; two types: longitudinal (ancestry) and transverse (collateral kinship).\n  * Al-Zamakhshari (Asas): Literal: \"له نسب في بني فلان\" — genealogical connection. Metaphorical: \"بين الشيئين مناسبة وتناسب\" — proportion and correspondence; here, the true metaphysical lineage of man is contrasted with the false social one.\n- Root: مهن (mahana)\n  * Lisan / Ayn: To be contemptible, lowly, despicable; weakness and abasement.\n  * Al-Raghib (Mufradat): Water that is weak and despicable — \"ماء مهين\" {Quran 32:8}; the seminal fluid described as lowly in the Quranic discourse on human origin.\n  * Al-Zamakhshari (Asas): Literal: despicable, contemptible. Metaphorical: the moral abasement that follows from recognizing one's material origin.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The rhetorical structure \"فإذن أصله من التراب وفصله من النطفة فلا أصل له ولا فصل\" uses restrictive predication to annihilate any ground for pride, confining man's origin to dust and a drop.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'", "badge": "Insight"}], "11": [{"arabic": "بعينها مرة أخرى إلى نفسه فقال الله تعالى في الموت قل يتوفاكم ملك الموت ثم قال عز وجل الله يتوفى الأنفس حين موتها وقال تعالى أفرأيتم ما تحرثون أضاف إلينا ثم قال تعالى أنا صببنا الماء صبا ثم شققنا الأرض شقا فأنبتنا فيها حبا وعنبا وقال عز وجل فأرسلنا إليها روحنا فتمثل لها بشرا سويا ثم قال تعالى فنفخنا فيها من روحنا وكان النافخ جبريل عليه السلام وكما قال تعالى فإذا قرأناه فاتبع قرآنه قيل في التفسير معناه إذا قرأه عليك جبريل وقال تعالى قاتلوهم يعذبهم الله بأيديكم فأضاف القتل إليهم والتعذيب إلى نفسه والتعذيب هو عين", "english": "Thus should you understand the issuance of determined things (al-maqdūrāt) from eternal power — even though the power is eternal (qadīmah) and the objects of power are originated (ḥādithah). And this is a knocking upon another door of another world among the worlds of unveilings (mukāshafāt). So let us leave all of that, for our purpose is only to alert to the path of unification (tawḥīd) in the act — for the agent in truth (al-fāʿil bi-al-ḥaqīqah) is One. He is the feared and the hoped, and upon Him is reliance and trust. And we have not been able to mention from the seas of tawḥīd save a drop from the ocean of the third station among the stations of tawḥīd. And exhausting that within the lifetime of Noah is impossible — like exhausting the water of the sea by taking droplets from it. And all of that is subsumed under the saying: \"There is no god but God\" (lā ilāha illā Allāh). How light is its burden upon the tongue, how easy is the belief in the meaning of its utterance upon the heart, and how precious is its reality and its kernel (lubbuhu) among the scholars firmly rooted in knowledge — so how [much more so] with others?", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 1114", "section_title_en": "The Oneness of the Actor (Tawḥīd al-Fiʿl) — Reconciling Divine and Human Agency", "section_index": 1114, "anchors": "- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core root denotes measure, decree, and capacity; al-Farāhīdī anchors it in the physical act of measuring or sizing, extended to divine determining.\n  * Al-Raghib (Mufradat): \"Al-qudrah\" when ascribed to God negates incapacity (ʿajz) absolutely; when ascribed to man, it names a state (hayʾah) enabling a specific act — never absolute power, but restricted capacity over particular objects.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"He is qādir, possessing power.\" Metaphorical (majāz): \"faras baʿīd al-qadr\" (a far-striding horse) — power's \"reach\" extended figuratively; here, divine power's \"presence\" with its objects is literal for God, metaphorical for creatures.\n- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: \"Al-ḥudūth\": coming-to-be after non-existence; al-ḥadath: ritual impurity (as in this text's water analogy); al-muḥdath: the originated thing.\n  * Al-Raghib (Mufradat): \"Al-ḥudūth: the thing's being after it was not — whether accident or substance. Its iḥdāth (bringing-about) is exclusive to God.\" Creaturely acts are originated, but their origination is divine.\n  * Al-Zamakhshari (Asas): Literal: recent, newly arisen. Metaphorical: \"ʿUmar was muḥaddath\" (inspired in judgment) — as if spoken to by unseen truth; here, the \"newly arisen\" (ḥādith) effect is tied to a condition (sharṭ), not a new power.\n- Root: ماء (m-ā-ʾ)\n  * Al-Raghib (Mufradat): Water as the origin of life ({وجعلنا من الماء كل شيء حي}); its root is m-w-h, with hāʾ dropped and wāw shifted — a paradigm for how a thing's \"presence\" (mulāqāh) does not entail its \"effect\" (taʾthīr) absent a condition.\n  * Kitab al-Ayn: Water's essence is unchanged; the analogy hinges on its constancy.\n- Root: وجه (w-j-h)\n  * Al-Raghib (Mufradat): \"Al-wajh\" is the face; then extended to the \"foremost\" or \"noblest\" part of any thing, and to the self (dhāt) in {ويبقى وجه ربك}. Here, \"washing the face\" is the specified condition (sharṭ) — the \"foremost\" ritual act — not the efficient cause of purification.\n  * Al-Zamakhshari (Asas): Literal: the bodily face. Metaphorical: \"wajh al-qawm\" (the leaders), \"wajh al-thawb\" (the surface of a garment) — the \"face\" as the operative locus; in the analogy, the face's washing is the trigger, not the agent.\n- Sibawayh Rule: Al-Faṣl bayna al-jār wa-al-majrūr (Prepositional Interposition) — Governing principle: a dependent element (here, divine power's \"attachment\" to objects) can be separated from its governor by an intervening condition, just as grammatical separation is permissible when the intervening clause is complete; analogically, the \"link\" (irṭibāṭ) of power to its effect is mediated by conditions without altering the agent's nature.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monotheism and Reliance'", "badge": "Insight"}], "12": [{"arabic": "ولتعلمن نبأه بعد حين وعند ذلك يقولون كما أخبر الله عنهم ربنا أبصرنا وسمعنا فارجعنا نعمل صالحا إنا موقنون أي علمنا أنه كما لا يولد إلا بوقاع ونكاح ولا ينبت زرع إلا بحراثة وبث بذر فكذلك لا يحصل في الآخرة ثواب وأجر إلا بعمل صالح فارجعنا نعمل صالحا فقد علمنا الآن صدقك في قولك وأن ليس للإنسان إلا ما سعى وأن سعيه سوف يرى كلما ألقى فيها فوج سألهم خزنتها ألم يأتكم نذير قالوا بلى قد جاءنا نذير أي ألم نسمعكم سنة الله في عباده وأنه", "english": "I say: God—exalted is He—loves the obedient and hates the disobedient. So just as He does not hate the obedient father because of His hatred for the disobedient son, likewise He does not love the disobedient son because of His love for the obedient father. And if love were to flow from the father to the son, then hatred would likewise be bound to flow. Rather, the truth is: {«ولا تزر وازرة وزر أخرى»} — \"And no bearer of burdens will bear the burden of another\" {Quran 6:164, 17:15, 35:18, 39:7, 53:38}. And whoever supposes that he will be saved by his father's piety is like one who supposes he will be satiated by his father's eating, quenched by his father's drinking, become a scholar by his father's learning, and reach the Ka'bah and see it by his father's walking.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 889", "section_title_en": "The Reality of Hope (Al-Rajā') and the Futility of Reliance on Another's Piety", "section_index": 889, "anchors": "- Root: و ل د (walada)\n  * Lisan / Ayn: Physical begetting and offspring; the father's generative act.\n  * Al-Raghib (Mufradat): \"الولد: المولود\" — offspring as a created entity; here used metaphorically for spiritual causation.\n  * Al-Zamakhshari (Asas): Literal: physical birth. Metaphorical: \"تولدت العصبية\" — something generated or produced from another; Ghazali exploits this to refute the notion that a father's obedience \"generates\" salvation for the son.\n- Root: ر ج و (rajā)\n  * Lisan / Ayn: Expectation, hope, longing for a favorable outcome.\n  * Al-Raghib (Mufradat): Hope tied to legitimate means; not mere wishful thinking (tamannī).\n  * Al-Zamakhshari (Asas): Literal: awaiting rain. Metaphorical: \"رجوت فلانا\" — to expect from someone; Ghazali contrasts true hope (with action) vs. delusion (ghurūr).\n- Root: غ ر ر (gharara)\n  * Lisan / Ayn: Deception, heedlessness, being lured by a false appearance.\n  * Al-Raghib (Mufradat): The state of one who is duped by Satan's plausible speech.\n  * Al-Zamakhshari (Asas): Literal: a risky venture. Metaphorical: \"اغتر بفلان\" — to be deceived by outward charm while the inner reality is corrupt.\n- Root: ك ي س (kays)\n  * Lisan / Ayn: Intelligence, shrewdness, prudence.\n  * Al-Raghib (Mufradat): The wise man who disciplines his soul and acts for the afterlife.\n  * Al-Zamakhshari (Asas): Literal: alertness. Metaphorical: \"الكيس من دان نفسه\" — the prudent one who holds his soul to account; antonym of \"الأحمق\" (the fool).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما يوفى الصابرون أجرهم بغير حساب\" style; Ghazali uses \"إنما\" to restrict reward to personal action, and \"ليس للإنسان إلا ما سعى\" as a restrictive negative clause (nafy + illā) to deny any transfer of merit.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Condemnation of Delusion'", "badge": "Du'a"}], "13": [{"arabic": "ولقد سبقت كلمتنا لعبادنا المرسلين وقال عز وجل ولكن حق القول مني لأملأن جهنم من الجنة والناس أجمعين وقال تعالى إن الذين سبقت لهم منا الحسنى أولئك عنها مبعدون فإن خطر ببالك أنه لم اختلفت السابقة وهم في ربقه العبودية مشتركون نوديت من سرادقات الجلال لا تجاوز حد الأدب فإنه لا يسئل عما يفعل وهم يسئلون ولعمري تأدب اللسان والظاهر مما يقدر عليه الأكثرون فأما تأدب السر عن إضمار الاستبعاد بهذا الاختلاف الظاهر في التقريب والإبعاد والإشقاء والإسعاد مع بقاء السعادة والشقاوة أبد الآباد فلا يقوى عليه إلا العلماء الراسخون في العلم ولهذا قال الخضر عليه السلام لما س", "english": "Among the masters of ecstatic finding (arbāb al-wajd), there is one whom a state overwhelms like intoxicating drunkenness (sukr mudhish), so his tongue loosens with reproach (ʿitāb) toward God Almighty, and he finds objectionable (yastankiru) His overwhelming (iqtihār) of hearts and His apportioning of noble states differentially. For He is the One who elects (mustaṣfā) the hearts of the veracious (ṣiddīqīn) and distances the hearts of the deniers and the deluded (jāḥidīn wa-l-maghrūrīn). There is no preventer of what He gives, and no giver of what He withholds. He did not cut off divine success (tawfīq) from the disbelievers due to some prior transgression, nor did He extend to the Prophets, peace be upon them, His success and the light of His guidance due to some preceding means. Rather, He said: {«وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا الْمُرْسَلِينَ»} \"And Our word has already preceded for Our servants, the messengers\" [Al-Ṣāffāt/171]. And He said, Mighty and Majestic: {«وَلَٰكِنْ حَقَّ الْقَوْلُ مِنِّي لَأَمْلَأَنَّ جَهَنَّمَ مِنَ الْجِنَّةِ وَالنَّاسِ أَجْمَعِينَ»} \"But the word from Me has taken effect: I will surely fill Hell with jinn and people all together\" [Al-Sajdah/13]. And He said, Exalted: {«إِنَّ الَّذِينَ سَبَقَتْ لَهُمْ مِنَّا الْحُسْنَىٰ أُولَٰئِكَ عَنْهَا مُبْعَدُونَ»} \"Indeed, those for whom the best [reward] has preceded from Us — they are from it far removed\" [Al-Anbiyāʾ/101].", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 503", "section_title_en": "The Peril of Listening (Samāʿ) for the Novice and the Reality of Divine Transcendence Beyond Change", "section_index": 503, "anchors": "- Root: لون (L-W-N)\n  * Lisan / Ayn: Core meaning of color, hue, and physical appearance; also used for types and kinds.\n  * Al-Raghib (Mufradat): \"اللون معروف، وينطوي على الأبيض والأسود وما يركب منهما، ويقال: تلون: إذا اكتسى لوناً غير اللون الذي كان له\" — indicating acquisition of a new state or attribute.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): physical coloring and change of hue. Metaphorical (Majaz): \"عنده لون من الثياب: صنف منه\" — a type, kind, or varying disposition; hence \"mutalawwin\" (متلون) as one who shifts between states and moods.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn over, overturn, transform, or redirect from one face to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the continuous turning and overturning of a thing; God as \"Muqallib al-Qulūb\" (Turner of hearts).\n  * Al-Zamakhshari (Asas): Literal: physical overturning. Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who manages and disposes affairs; divine action of disposing hearts.\n- Root: حول (H-W-L)\n  * Lisan / Ayn: Change, transformation, power, and capacity.\n  * Al-Raghib (Mufradat): \"أصل الحول تغير الشيء وانفصاله عن غيره\" — change and separation from another state; \"يحول بين المرء وقلبه\" {«الأنفال/ 24»} — divine interposition between a man and his heart.\n  * Al-Zamakhshari (Asas): Literal: passage of time, transformation. Metaphorical: \"حال عليه الحول\" — the changing of conditions; \"حائل\" as that which has altered.\n- Root: قرب (Q-R-B)\n  * Lisan / Ayn: Nearness in place, time, or rank.\n  * Al-Raghib (Mufradat): \"القرب والبعد يتقابلان... ويستعمل ذلك في المكان، وفي الزمان، وفي النسبة، وفي الحظوة، والرعاية، والقدرة\" — including nearness in honor and station (zulfā).\n  * Al-Zamakhshari (Asas): Literal: physical proximity. Metaphorical: \"فلان يقرب أمراً لا يتسهل له\" — drawing near in rank and favor; divine drawing near (taqrīb) and distancing (ibʿād).\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the meaning remains clear, paralleling how divine attributes may be qualified without compromising essential unity.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Delusion'", "badge": "Hadith"}, {"arabic": "الله عز وجل أن لو يشاء الله لهدى الناس جميعا وقوله تعالى ولو شئنا لآتينا كل نفس هداها ويدل عليه من جهة العقل أن المعاصي والجرائم إن كان الله يكرهها ولا يريدها وإنما هي جارية على وفق إرادة العدو إبليس لعنه الله مع أنه عدو لله سبحانه والجاري على وفق إرادة العدو أكثر من الجاري على وفق إرادته تعالى فليت شعري كيف يستجيز المسلم أن يرد ملك الجبار ذي الجلال والإكرام إلى رتبة لو ردت إليها رياسة زعيم ضيعة لاستنكف منها إذ لو كان ما يستمر لعدو الزعيم في القرية أكثر مما يستقيم له لاستنكف من زعامته وتبرأ عن ولايته والمعصية هي الغالبة على الخل", "english": "As for the movement, it is a creation of the Lord — exalted is He — an attribute of the servant, and an acquisition of his. For it was created as empowered (maqdūrah) by a power that is His attribute, and the movement has a relation to another attribute called power; thus, by virtue of that relation, it is termed \"acquisition.\" And how could it be pure compulsion (jabr maḥḍ), when he necessarily perceives the distinction between the empowered movement and the involuntary tremor (al-raʿdah al-ḍarūriyyah)? Or how could it be a creation of the servant, when he does not encompass knowledge of the details of the parts of acquired movements nor their numbers? And when both extremes are refuted, nothing remains except moderation in belief (al-iqtiṣād fī al-iʿtiqād) — namely, that it is empowered by the power of God — exalted is He — by way of origination, and by the power of the servant in another mode of attachment (taʿlīq) expressed as acquisition.", "book_title": "Foundations of Belief", "section_title_ar": "Section 93", "section_title_en": "The Second Foundation: God's Sole Creation of Servants' Movements Does Not Negate Their Being Acquired by Servants", "section_index": 93, "anchors": "- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core meaning of measuring, determining, and empowering; al-Farahidi notes its application to capacity and divine decree.\n  * Al-Raghib (Mufradat): \"القدرة\" when attributed to humans denotes a state enabling one to perform an act; when attributed to God, it negates incapacity. Absolute power belongs solely to God; for others, it is always restricted and particularized.\n  * Al-Zamakhshari (Asas): Literal: \"هو قادر مقتدر ذو قدرة ومقدرة\" — one possessing power. Metaphorical: \"فرس بعيد القدر\" — a horse of far-reaching stride, extending the root to scope and reach.\n- Root: كسب (k-s-b)\n  * Lisan / Ayn: Acquisition, earning, and what one gains; al-Farahidi links it to amassing and profiting.\n  * Al-Raghib (Mufradat): Acquisition (al-kasb) in theological terms denotes an act's relation to the servant whereby responsibility attaches, while its origination remains divine.\n  * Al-Zamakhshari (Asas): Literal: earning and gaining. Metaphorical: the theological sense of acquired act (al-faʿl al-iktisābī) — a relational attribution distinct from creation.\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Measuring and smoothing; al-Farahidi notes its application to fashioning and proportioning.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — origination from nothing (ibdāʿ) or from something, always upon a measured determination.\n  * Al-Zamakhshari (Asas): Literal: measuring before cutting. Metaphorical: \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure required by wisdom.\n- Root: وجب (w-j-b)\n  * Lisan / Ayn: Being due, necessary, or obligatory; al-Farahidi notes its legal and ontological senses.\n  * Al-Raghib (Mufradat): \"الوجوب: الثبوت\" — necessary being is that whose non-existence entails an impossibility; obligation is that whose omission warrants blame.\n  * Al-Zamakhshari (Asas): Literal: \"وجب البيع\" — the sale became binding. Metaphorical: \"هو يأكل الوجبة\" — eating once daily, extending to fixed determination.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Specification) — The particle \"إنما\" restricts predication, as in \"إنما هو إله واحد,\" confining the attribute to its subject and negating it from others. This governs the Ashʿarī restriction of creative power to God alone while affirming acquired power for servants through a distinct relational mode.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Foundations of Belief'", "badge": "Hadith"}, {"arabic": "الله وإليهم الإشارة بقوله تعالى {ولو شئنا لآتينا كل نفس هداها ولكن حق القول مني لأملأن جهنم من الجنة والناس أجمعين} وهؤلاء هم الذين اشتروا الحياة الدنيا بالآخرة فخسرت صفقتهم وقيل لمن قصد إرشادهم فأعرض عمن تولى عن ذكرنا", "english": "Thus most of the moral traits of faith (akhlāq al-īmān) are subsumed under patience. For this reason, when the Prophet — peace be upon him — was once asked about faith, he said: \"It is patience\" — because it is the most abundant and most precious of its works, just as he said: \"The Pilgrimage is ʿArafah.\" And God — exalted be He — has gathered together all of these divisions and called the whole of them \"patience,\" saying — exalted be He: {And the patient in adversity (al-ba'sā') — i.e., calamity — and in hardship (al-ḍarrā') — i.e., poverty — and at the time of peril (ḥīna al-ba's) — i.e., warfare — {those are the ones who have been truthful, and those are the ones who are God-fearing} «أولئك الذين صدقوا وأولئك هم المتقون». So these, then, are the divisions of patience according to the difference of its objects of relation (mutaʿallaqātihā).", "book_title": "Patience and Gratitude", "section_title_ar": "Section 960", "section_title_en": "The Names That Accrue to Patience (Ṣabr) in Relation to Its Object, and the Divisions of Patience According to Strength and Weakness", "section_index": 960, "anchors": "- Root: صبر (Ṣ-B-R)\n  * Lisan / Ayn: Core sense of \"holding back\" or \"restraining\" (al-imsāk), as in holding a beast without fodder or confining someone; endurance of hardship.\n  * Al-Raghib (Mufradat): \"Patience is the restraint of the self (ḥabs al-nafs) upon what reason and Law require, or from what they require it to abstain.\" It is a generic term (laẓf ʿāmm) whose specific names vary by context: in calamity it is \"patience\" (ṣabr) against \"panic\" (jazaʿ); in battle, \"courage\" (shajāʿah) against \"cowardice\" (jubn); in affliction, \"breadth of breast\" (saʿat al-ṣadr) against \"vexation\" (ḍajar).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"I bore patiently what I dislike, and I held back from what I love.\" Metaphorical (majāz): \"His hand does not endure the cold\" — i.e., is not patient against it; \"he is more patient of beating than the ground.\"\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self or soul; that which is breathed; also blood (nafs sā'ilah).\n  * Al-Raghib (Mufradat): \"Al-Nafs: the spirit (al-rūḥ)… and in God's saying {He warns you of Himself} (nafsihi) it denotes His very essence (dhāt).\"\n  * Al-Zamakhshari (Asas): Literal: \"a precious thing (nafīs)\"; Metaphorical: \"he poured out his nafs (i.e., his blood).\"\n- Root: ضرب (Ḍ-R-B)\n  * Al-Raghib (Mufradat): Used for striking and for coercion; also for \"types\" or \"kinds\" (ḍarb min kadhā) — as in the section heading \"two types\" (ḍarbān).\n  * Al-Zamakhshari (Asas): Literal: \"he struck him with the sword\"; Metaphorical: \"he struck his hand\" (i.e., prevented him from an affair); \"the vicissitudes of time struck them.\"\n- Sibawayh Rule: Interposition and Specification (Bāb al-Faṣl bayn al-Jār wa-al-Majrūr) — The syntactic structure \"bi-al-iḍāfah ilā mā ʿanhu al-ṣabr\" (in relation to that from which one exercises patience) shows how prepositional phrases govern semantic specification, distinguishing the act of patience from its object (al-mutaʿallaq).", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Patience and Gratitude'", "badge": "Ethics"}], "15": [{"arabic": "أن يقرأ قوله تعالى {خروا سجدا وسبحوا بحمد ربهم وهم لا يستكبرون} فيقول اللهم اجعلني من الساجدين لوجهك المسبحين بحمدك وأعوذ بك أن أكون من المستكبرين عن أمرك أو على أوليائك وإذا قرأ قوله تعالى {ويخرون للأذقان يبكون ويزيدهم خشوعا} فيقول اللهم اجعلني من الباكين إليك الخاشعين لك وكذلك كل سجدة ويشترط في هذه السجدة شروط الصلاة من ستر العورة واستقبال القبلة وطهارة الثوب والبدن من الحدث والخبث ومن لم يكن على طهارة عند السماع فإذا تطهر يسجد وقد قيل في كمالها إنه يكبر رافعا يديه لتحريمه ثم يكبر للهوي للسجود ثم يكبر للارتفاع ث", "english": "If he recites without ritual purity, reclining upon his bed, he also has merit, but it is below that [of the one who is pure and seated properly]. Allah Most High said: {الَّذِينَ يَذْكُرُونَ اللَّهَ قِيَامًا وَقُعُودًا وَعَلَىٰ جُنُوبِهِمْ وَيَتَفَكَّرُونَ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ} (\"Those who remember Allah standing, sitting, and upon their sides, and reflect upon the creation of the heavens and the earth\") — and He praised all of them, but He mentioned standing first, then sitting, then remembrance while reclining.", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 223", "section_title_en": "The Book of the Etiquette of Qur'an Recitation — Section 223: On the Manners of the Reciter, the Measure of Recitation, Division into Portions, Orthography, Tartīl, Weeping, Rights of the Verses, Invocations, and Vocalization", "section_index": 223, "anchors": "- Root: قرا (Q-R-A)\n  * Lisan / Ayn: To read, recite, gather together; the core act of assembling letters into articulated speech.\n  * Al-Raghib (Mufradat): Recitation (tilāwah) is the following of the Qur'an in obedience and belief; qirā'ah is the articulation of the letters. The term carries both the physical act of vocalization and the spiritual act of devotion.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): to read from a written text or from memory. Metaphorical (majāz): \"qara'a al-rajul\" — to become religious, devoted, as the reciter is characterized by the state of worship.\n- Root: سجد (S-J-D)\n  * Lisan / Ayn: To bow, prostrate, lower oneself; the physical posture of placing the forehead on the ground.\n  * Al-Raghib (Mufradat): Prostration is of two kinds: voluntary (ikhtiyārī) — exclusive to humans, by which reward is deserved; and subjugated (taskhīrī) — universal to all creation, as in {وَلِلَّهِ يَسْجُدُ مَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ}.\n  * Al-Zamakhshari (Asas): Literal: the physical act of prostration. Metaphorical: \"shajarah sājidah\" — a tree bending over; \"ʿayn sājidah\" — a languid, drooping eye. The prostration of recitation is the literal act performed in obedience to the command of the verse.\n- Root: تلو (T-L-W)\n  * Lisan / Ayn: To follow, to recite; the reciter \"follows\" the letters in sequence and \"follows\" the commands contained therein.\n  * Al-Raghib (Mufradat): Tilāwah is following the Qur'an in deed as well as in word; the true reciter is he whose recitation is a following of the divine command.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The conditional and restrictive structures in the prophetic sayings (e.g., \"من قرأ القرآن في أقل من ثلاث لم يفقهه\") establish a causal link between the act and its consequence, requiring precise parsing of the conditional clause to extract the legal ruling.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Etiquette of Quran Recitation'", "badge": "Du'a"}], "16": [{"arabic": "يعلمون والذين لا يعلمون} وقال تعالى {تتجافى جنوبهم عن المضاجع يدعون ربهم خوفا وطمعا} وقال عز وجل {والذين يبيتون لربهم سجدا وقياما} وقال عز وجل {كانوا قليلا من الليل ما يهجعون وبالأسحار هم يستغفرون} وقال عز وجل {فسبحان الله حين تمسون وحين تصبحون} وقال تعالى {ولا تطرد الذين يدعون ربهم بالغداة والعشي يريدون وجهه} فهذا كله يبين لك أن الطريق إلى تعالى مراقبة الأوقات وعمارتها بالأوراد على سبيل الدوام ولذلك قال صلى الله عليه وسلم أحب عباد الله إلى الله الذين يراعون الشمس والقمر والأظلة لذكر الله تعالى (1) وقد قال تعالى {الشمس والقمر بحسبا", "english": "{«آناء الليل ساجدا وقائما يحذر الآخرة ويرجو رحمة ربه قل هل يستوي الذين يعلمون والذين لا يعلمون»} — \"During the hours of the night, prostrating and standing, fearing the Hereafter and hoping for the mercy of his Lord. Say: Are those who know equal to those who do not know?\" (Q. 39:9). And God Most High said: {«تتجافى جنوبهم عن المضاجع يدعون ربهم خوفا وطمعا»} — \"Their sides forsake their beds, calling upon their Lord in fear and hope\" (Q. 32:16). And God, Mighty and Majestic, said: {«والذين يبيتون لربهم سجدا وقياما»} — \"And those who pass the night prostrating and standing before their Lord\" (Q. 25:64). And God, Mighty and Majestic, said: {«كانوا قليلا من الليل ما يهجعون وبالأسحار هم يستغفرون»} — \"They used to sleep but little of the night, and in the dawn-hours they would seek forgiveness\" (Q. 51:17-18). And God, Mighty and Majestic, said: {«فسبحان الله حين تمسون وحين تصبحون»} — \"So glory be to God when you enter the evening and when you enter the morning\" (Q. 30:17). And God Most High said: {«ولا تطرد الذين يدعون ربهم بالغداة والعشي يريدون وجهه»} — \"And do not drive away those who call upon their Lord morning and evening, desiring His Face\" (Q. 6:52). All of this makes clear to you that the path to God Most High is the watchfulness over the times (murāqabat al-awqāt) and the cultivation of them with the appointed devotions (al-awrād) in a perpetual manner.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 258", "section_title_en": "The Revival of the Religious Sciences — Section 258: The Virtues of the Watches (Awrād) and Their Ordering", "section_index": 258, "anchors": "- Root: ورد (w-r-d)\n  * Lisan / Ayn: Core meaning is \"to arrive at water\" — the quenching of thirst at a watering place; al-Wird (pl. Awrād) denotes a set portion or appointed round of devotional recitation, by extension from the regular \"arrival\" at a source.\n  * Al-Raghib (Mufradat): Al-Wurūd is originally \"the intending of water,\" then used for other things. The theological nuance: the awrād are the appointed \"watering places\" of the soul — fixed times at which the servant presents himself before God to drink from the fountain of remembrance (dhikr).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"warda al-mā'a\" — to arrive at water. Metaphorical (Majāz): \"warada ʿalayhi amrun lam yuṭiqhu\" — an affair he could not bear arrived upon him; \"waradat-hu al-ḥummā\" — fever came upon him. Here, the awrād are the appointed times that \"come upon\" the servant, demanding their due of devotion.\n- Root: طلع (ṭ-l-ʿ)\n  * Lisan / Ayn: To rise, to appear above the horizon (of the sun); to ascend; to come upon suddenly.\n  * Al-Raghib (Mufradat): \"Ṭalaʿa al-shams ṭulūʿan wa-maṭlaʿan\" — the sun rose. From this is borrowed: \"ṭalaʿa ʿalaynā fulān\" — so-and-so came upon us. The maṭlaʿ is the place of rising.\n  * Al-Zamakhshari (Asas): Literal: \"ṭalaʿat al-shams\" — the sun rose. Metaphorical: \"ṭalaʿa ʿalaynā fulān\" — he descended upon us suddenly. The \"rising of the sun\" is the boundary-marker of the first watch.\n- Root: ليل (l-y-l)\n  * Lisan / Ayn: The night — from the time of sunset to sunrise; its root suggests \"enveloping\" and \"concealing.\"\n  * Al-Raghib (Mufradat): The night (al-layl) and the day (al-nahār) are two signs (āyatān) of God; the night is for stillness and the day for seeking provision.\n  * Al-Zamakhshari (Asas): Literal: the period of darkness. Metaphorical: \"layl al-hamm\" — the night of anxiety (a dark affair). The night is divided into watches for the one who stands in prayer.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-al-taqyīd bi-innamā (Restriction and Focused Predication) — The particle innamā restricts the predicate to the subject alone, negating all else. Applied here: \"the purpose of the sun and moon's course is not for worldly matters, but only (innamā) for knowing the measures of the times.\"", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Arrangement of Litanies'", "badge": "Dhikr"}, {"arabic": "وقيل إنها المراد بقوله عز وجل تتجافى جنوبهم عن المضاجع وقد روي عنه صلى الله عليه وسلم أنه قال من صلى بين المغرب والعشاء فإنها من صلاة الأوابين (3) وقال صلى الله عليه وسلم من عكف نفسه فيما بين المغرب والعشاء في مسجد جماعة لم يتكلم إلا بصلاة أو بقرآن كان حقا على الله أن يبني له قصرين في الجنة مسيرة كل قصر منهما مائة عام ويغرس له بينهما غراسا لوطافة أهل الأرض لوسعهم (4) وسيأتي بقية فضائلها في كتاب الأوراد إن شاء الله تعالى القسم الثاني ما يتكرر بتكرر الأسابيع وهي صلاة أيام الأسبوع ولياليه لكل يوم ولكل", "english": "The eighth: Reviving the time between the two evening prayers (al-maghrib and al-ʿishāʾ). It is an emphatically confirmed sunnah. What has been transmitted of its number from the action of the Messenger of Allah (ﷺ) between the two evening prayers is six rakʿahs (2). This prayer has a tremendous virtue. It was said that it is what is meant by His saying, Mighty and Majestic: {«Their sides forsake their beds»} (Q. 32:16). And it is narrated from him (ﷺ) that he said: \"Whoever prays between the maghrib and the ʿishāʾ, it is among the prayers of the penitent (al-awwābīn)\" (3). And he (ﷺ) said: \"Whoever confines himself between the maghrib and the ʿishāʾ in a congregational mosque, speaking nothing but prayer or Quran, it is incumbent upon Allah to build for him two palaces in Paradise, the journey of each palace being a hundred years, and to plant for him between them plantings that, if the inhabitants of the earth were to traverse them, would encompass them\" (4). The remainder of its virtues will come in the Book of Liturgies (Kitāb al-Awrād), if Allah the Exalted wills.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 158", "section_title_en": "Section 158 — On the Witr Prayer, the Forenoon (Ḍuḥā) Prayer, and the Prayer Between the Two Evening Prayers", "section_index": 158, "anchors": "- Root: وتر (w-t-r)\n  * Lisan / Ayn: The odd, the single; that which is not paired; to make odd; also vengeance or injury (watr/witar).\n  * Al-Raghib (Mufradat): \"الوتر في العدد خلاف الشفع\" — the odd in number as opposed to the even; al-ītār is to pray the witr; tawātur is succession one-by-one.\n  * Al-Zamakhshari (Asas): Literal: \"وأوتر: صلى الوتر\" — to perform the witr prayer. Metaphorical: \"وترته حقه\" — to deprive one of his right; \"كأنما وتر أهله وماله\" — as if bereft of family and wealth.\n- Root: ركع (r-k-ʿ)\n  * Lisan / Ayn: To bow, to incline the head and body downward.\n  * Al-Raghib (Mufradat): \"الركوع: الانحناء\" — bowing; used for the specific posture in prayer and metaphorically for humility and submission.\n  * Al-Zamakhshari (Asas): Literal: \"شيخ راكع: منحن من الكبر\" — an old man bowed with age; \"ركوع الصلاة\" — the bowing of prayer. Metaphorical: \"لغبت الإبل حتى ركعت\" — camels fatigued until they sank to their knees.\n- Root: ورد (w-r-d)\n  * Lisan / Ayn: To arrive at water; to approach; to come to a place.\n  * Al-Raghib (Mufradat): \"الورود أصله: قصد الماء\" — its root meaning is to seek water; then used for other things; \"الورد\" — the daily portion of recitation or litany.\n  * Al-Zamakhshari (Asas): Literal: \"ورد الماء وودا ووردا\" — to arrive at water. Metaphorical: \"وردت البلد\" — to enter a land; \"ورد عليه كتاب\" — a letter arrived; \"هو حسن الإيراد\" — excellent in delivery; \"الورد\" — the daily litany.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The conditional and restrictive particles (إنما، إن، لو) govern the scope of legal validity, as seen in the precise conditions for the witr prayer's correctness.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Arrangement of Litanies'", "badge": "Afterlife"}], "17": [{"arabic": "وقيل في قوله تعالى {فلا تعلم نفس ما أخفي لهم من قرة أعين جزاء بما كانوا يعملون} قيل كان عملهم الصيام لأنه قال {إنما يوفى الصابرون أجرهم بغير حساب} فيفرغ للصائم جزاؤه إفراغا ويجازف جزافا فلا يدخل تحت وهم وتقدير وجدير بأن يكون كذلك لأن الصوم إنما كان له ومشرفا بالنسبة إليه وإن كانت العبادات كلها له كما شرف البيت بالنسبة إلى نفسه والأرض كلها له لمعنيين أحدهما أن الصوم كف وترك وهو في نفسه سر ليس فيه عمل يشاهد وجميع أعمال الطاعات بمشهد من الخلق ومرأى والصوم لا يراه إلا الله عز وجل فإنه عمل في الباطن بالصبر المجرد والثاني أنه", "english": "To proceed: Fasting is one quarter of faith, by virtue of his saying, peace and blessings be upon him: \"Fasting is half of patience\" — and by virtue of his saying, peace and blessings be upon him: \"Patience is half of faith\" {«الإيمان»}. Then it is distinguished by a particular characteristic of its attribution to Allah the Exalted, above all the other pillars — for Allah the Exalted said, in what His Prophet narrated from Him, peace and blessings be upon him: \"Every good deed is multiplied tenfold up to seven hundred times, except fasting, for it is Mine, and I shall reward it.\" And Allah the Exalted has said: {«Only the patient shall be paid their reward in full without reckoning»} (Q 39:10). And fasting is half of patience — so its reward has surpassed the law of measure and reckoning. And sufficient for you in knowing its excellence is his saying, peace and blessings be upon him: \"By Him in whose hand is my soul, the change in the breath of the mouth of the fasting person is more fragrant to Allah than the scent of musk. Allah the Exalted says: 'He only abandons his appetite, his food, and his drink for My sake — so fasting is for Me, and I shall reward it.'\" And he said, peace and blessings be upon him: \"Paradise has a gate called al-Rayyān, through which none shall enter except the fasting ones.\" And the fasting person is promised the meeting with Allah the Exalted as a portion of his fasting. And he said, peace and blessings be upon him: \"For the fasting person there are two joys: a joy when he breaks his fast, and a joy when he meets his Lord.\" And he said, peace and blessings be upon him: \"Everything has a gate, and the gate of worship is fasting.\" And he said, peace and blessings be upon him: \"The sleep of the fasting person is worship.\" And Abū Hurayrah, may Allah be pleased with him, narrated that he, peace and blessings be upon him, said: \"When the month of Ramaḍān enters, the gates of Paradise are opened, the gates of the Fire are closed, the devils are chained, and a caller calls out: 'O seeker of good, come forth! O seeker of evil, desist!'\" And Wakīʿ said concerning His saying, the Exalted: {«Eat and drink in satisfaction for what you sent forth in the days past»} (Q 69:24) — these are the days of fasting, for in them they abandoned eating and drinking. And the Messenger of Allah, peace and blessings be upon him, gathered in the rank of divine boasting (mubāhāh) between renunciation of the world and fasting, saying: \"Allah the Exalted boasts to His angels of the young worshiper, saying: 'O young man who abandons his appetite for My sake, who devotes his youth to Me — you are to Me as some of My angels.'\" And he said, peace and blessings be upon him, concerning the fasting person: \"Allah the Exalted says: 'Look, O My angels, at My servant — he has abandoned his appetite, his pleasure, his food, and his drink for My sake.'\" And it was said concerning His saying, the Exalted: {«No soul knows what comfort has been concealed for them, as a reward for what they used to do»} (Q 32:17) — it was said: their deed was fasting, because He said: {«Only the patient shall be paid their reward in full without reckoning»} — so the reward of the fasting person is poured out upon him without measure, and is dealt out to him in bulk, not falling under any imagination or estimation.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 185", "section_title_en": "The Book of the Secrets of Fasting — Section 185: On the Excellence of Fasting and Its Distinction Among the Acts of Worship", "section_index": 185, "anchors": "- Root: صوم (ṣ-w-m)\n  * Lisan / Ayn: Core linguistic root meaning — abstention from any act, whether eating, speaking, or walking; a horse that refrains from movement or fodder is called ṣā'im.\n  * Al-Raghib (Mufradat): Theological/Kalam semantic nuance — \"الصوم في الأصل: الإمساك عن الفعل\" — fasting is fundamentally the restraint of the self from action; it is an inward act of the heart, invisible to creation.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical distinction — Haqiqah: the month of fasting, \"فمن شهد منكم الشهر فليصمه\" (Q 2:185); Majaz: \"صام الفرس على آريه\" — a horse standing still at its tether, refusing fodder, metaphorically \"fasting.\"\n- Root: عله (ʿ-l-h)\n  * Lisan / Ayn: Core linguistic root meaning — to feed or pasture; related to cultivation and nourishment.\n  * Al-Raghib (Mufradat): Theological/Kalam semantic nuance — not directly attested in Mufradat for this root; the root pertains to the means by which the body is sustained, which is precisely what the fasting person abstains from.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical distinction — literal feeding and satiation; the fasting person's abstention from these becomes the very means of spiritual nourishment.\n- Root: الي (a-l-y)\n  * Lisan / Ayn: Core linguistic root meaning — to convey a message; the angel (malak) is so named because the message is \"chewed\" (yu'lak) in the mouth, as a horse chews its bit.\n  * Al-Raghib (Mufradat): Theological/Kalam semantic nuance — \"المألكة: الرسالة\" — the angelic function is the conveyance of divine communication; the fasting person's hunger narrows the channels through which the devil (who runs like blood through the veins) reaches the heart.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical distinction — literal conveyance of a message versus the metaphorical \"message\" of the devil's insinuation (waswās) through the pathways of the body.\n- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core linguistic root meaning — to restrain, to hold back in constriction; \"صبرت الدابة: حبستها بلا علف\" — to hold an animal back without fodder.\n  * Al-Raghib (Mufradat): Theological/Kalam semantic nuance — \"الصبر: الإمساك في ضيق\" — patience is restraint within constriction; it is the holding of the soul upon what reason and law require, or from what they require it to abstain. Its names vary by context: in battle it is courage, in calamity it is patience proper.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical distinction — Haqiqah: \"صبرت على ما أكره وصبرت عما أحب\" — patience upon the disliked and patience from the beloved; Majaz: \"صبرت يمينه\" — to bind one's oath severely, and \"هو أصبر على الضرب من الأرض\" — more enduring of striking than the earth.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle innamā restricts and confines the predicate exclusively to its subject, as in the divine saying {«إنما يوفى الصابرون أجرهم بغير حساب»} and {«إنما يذر شهوته وطعامه وشرابه لأجلي»}, where the restriction elevates the restricted matter to a rank beyond all quantitative measure.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Delusion'", "badge": "Insight"}], "20": [{"arabic": "صالح فإني أجد غما فقرأت {كلما أرادوا أن يخرجوا منها أعيدوا فيها} فخر ميتا وروى أن زرارة بن أبي أوفى صلى بالناس الغداة فلما قرأ {فإذا نقر في الناقور} خر مغشيا عليه فحمل ميتا ودخل يزيد الرقاشي على عمر بن عبد العزيز فقال عظني يا يزيد فقال يا أمير المؤمنين اعلم أنك لست أول خليفة يموت فبكى ثم قال زدني قال يا أمير المومنين ليس بينك وبين آدم أب إلا ميت فبكى ثم قال زدني يا يزيد فقال يا أمير المؤمنين ليس بينك وبين الجنة والنار منزل فخر مغشيا عليه وقال ميمون بن مهران لما نزلت هذه الآية {وإن جهنم لموعدهم أجمعين} صاح", "english": "Al-Ḥasan [al-Baṣrī] passed by a young man who was completely absorbed in his laughter, sitting with a group of people in a gathering. Al-Ḥasan said to him: \"O young man, have you crossed the Ṣirāṭ [the Bridge]?\" He said: \"No.\" He said: \"Then do you know whether you will go to Paradise or to the Fire?\" He said: \"No.\" He said: \"Then what is this laughter?\" He said: \"And that young man was never seen laughing after that.\"", "book_title": "Contemplation", "section_title_ar": "Section 1062", "section_title_en": "The States of Fear and the Severity of Khawf — Accounts of the Early Pious (Section 1062)", "section_index": 1062, "anchors": "- Root: ضحك (Ḍaḥika)\n  * Lisan / Ayn: Core meaning is laughter, arising from a state of heedlessness or joy; its opposite is weeping (bukā') which accompanies khashyah.\n  * Al-Raghib (Mufradat): Laughter is a human accident (ʿaraḍ) indicating the heart's occupation with worldly pleasure, contra the state of the God-fearing whose hearts are preoccupied with divine threat.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for audible laughter; metaphorical (majāz) for the soul's levity and forgetfulness of the reckoning.\n- Root: خوف (Khawf)\n  * Lisan / Ayn: Fear, dread, anxiety of anticipated harm; in the Kalam context, it is the soul's perturbation due to probable punishment.\n  * Al-Raghib (Mufradat): Khawf is distinguished from khashyah — khashyah is specific to knowledge-based fear of Allah's majesty, while khawf is broader; here, the accounts blend both as the engine of righteous action.\n  * Al-Zamakhshari (Asas): Literal for fear of a known threat; metaphorical for the \"fear\" that severs the liver (qataʿa al-kabid), i.e., a spiritual state overwhelming the corporeal frame.\n- Root: أمن (Amn)\n  * Lisan / Ayn: Security, safety, freedom from fear; its root denotes tranquility of heart.\n  * Al-Raghib (Mufradat): Amn is the cessation of fear, which in this world is only proper for the prophets and angels in specific contexts; for the sinner, it is a delusion (ghurūr).\n  * Al-Zamakhshari (Asas): Literal for physical safety; metaphorical for spiritual complacency, which is blameworthy — as in the saying of Ḥammād: \"That is the sitting of the secure one.\"\n- Sibawayh Rule: Rule of Restriction with إنما (Innamā) — as in \"إنما جعل الله هذه الغفلة\" and \"إنما أغبط من لم يخلق\" — where the predicate is restricted to the subject, emphasizing exclusive causation or exclusive object of envy, per the canonical pattern of ḥaṣr.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Contemplation'", "badge": "Afterlife"}], "24": [{"arabic": "وجعلها ثمرة له فقال عز من قائل وجعلنا منهم أئمة يهدون بأمرنا لما صبروا وقال تعالى وتمت كلمة ربك الحسنى على بني إسرائيل بما صبروا وقال تعالى ولنجزين الذين صبروا أجرهم بأحسن ما كانوا يعملون وقال تعالى أولئك يؤتون أجرهم مرتين بما صبروا وقال تعالى إنما يوفى الصابرون أجرهم بغير حساب فما من قربة إلا وأجرها بتقدير وحساب إلا الصبر ولأجل كون الصوم من الصبر وأنه نصف الصبر قال الله تعالى الصوم لي وأنا أجزي به فأضافه إلى نفسه من بين سائر العبادات ووعد الصابرين بأنه معهم فقال تعالى واصبروا إن الله مع الصابرين وعلق النصرة على ال", "english": "Allah — exalted be He — has described the patient (al-ṣābirīn) with attributes, and He mentioned patience (al-ṣabr) in the Qur’an in upwards of seventy places. He attached most of the degrees and goods to patience, making them its fruit. For He said — majestic is His utterance: {«وَجَعَلْنَا مِنْهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا لَمَّا صَبَرُوا»} — “And We made from among them imams guiding by Our command, when they were patient” (Q 32:24). And He said — exalted be He: {«وَتَمَّتْ كَلِمَتُ رَبِّكَ الْحُسْنَىٰ عَلَىٰ بَنِي إِسْرَائِيلَ بِمَا صَبَرُوا»} — “And the good word of your Lord was fulfilled upon the Children of Israel, because they were patient” (Q 7:137). And He said — exalted be He: {«وَلَنَجْزِيَنَّ الَّذِينَ صَبَرُوا أَجْرَهُم بِأَحْسَنِ مَا كَانُوا يَعْمَلُونَ»} — “And We shall surely recompense those who were patient their wage according to the best of what they used to do” (Q 16:96). And He said — exalted be He: {«أُولَٰئِكَ يُؤْتَوْنَ أَجْرَهُم مَّرَّتَيْنِ بِمَا صَبَرُوا»} — “Those shall be given their wage twice, because they were patient” (Q 28:54). And He said — exalted be He: {«إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ»} — “Only the patient shall be paid their wage without reckoning” (Q 39:10). Thus there is no act of nearness (qurbah) whose wage is not meted out by measure and account — except patience. And because fasting (al-ṣawm) is of patience, and it is half of patience, Allah — exalted be He — said: “Fasting is Mine, and I recompense it” — so He attributed it to Himself, to the exclusion of all other acts of worship. And He promised the patient that He is with them, saying — exalted be He: {«وَاصْبِرُوا إِنَّ اللَّهَ مَعَ الصَّابِرِينَ»} — “And be patient; indeed Allah is with the patient” (Q 8:46). And He made victory contingent upon patience, saying — exalted be He: {«بَلَىٰ إِن تَصْبِرُوا وَتَتَّقُوا وَيَأْتُوكُم مِّن فَوْرِهِمْ هَٰذَا يُمْدِدْكُمْ رَبُّكُم بِخَمْسَةِ آلَافٍ مِّنَ الْمَلَائِكَةِ مُسَوِّمِينَ»} — “Yes, if you are patient and God-fearing, and they come upon you in their rush, your Lord will reinforce you with five thousand marked angels” (Q 3:125). And He gathered for the patient things He gathered for no others, saying — exalted be He: {«أُولَٰئِكَ عَلَيْهِمْ صَلَوَاتٌ مِّن رَّبِّهِمْ وَرَحْمَةٌ وَأُولَٰئِكَ هُمُ الْمُهْتَدُونَ»} — “Those — upon them are blessings from their Lord, and mercy; and those — they are the rightly guided” (Q 2:157). So guidance, mercy, and blessings are all gathered for the patient. And to exhaust all the verses concerning the station of patience would be lengthy.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 954", "section_title_en": "The Virtue of Patience (Ṣabr) — Its Excellence in the Qur’an, Sunnah, and Reports of the Salaf", "section_index": 954, "anchors": "- Root: صبر (Ṣ-B-R)\n  * Lisan / Ayn: Core meaning is “to restrain, to hold back, to bind firmly” — as in holding an animal by its halter or confining someone against departure.\n  * Al-Raghib (Mufradat): Patience is “the self’s restraint upon what reason and Sacred Law require, or from what they require it to abstain from.” It is a generic term whose specific names vary by context: in calamity it is ṣabr (opposed to jazaʿ); in battle it is courage (shajāʿah); in vexation it is forbearance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): “I bore patiently what I disliked, and I refrained patiently from what I loved.” Metaphorical (majāz): “His right hand was made to swear patiently” (i.e., bound by an emphatic oath), and “this tree is patient against cold” (i.e., unaffected by it).\n- Root: عله (ʿ-L-H) — [Noted as a rare root; no direct bearing on this passage’s core terms, but included per lexical apparatus.]\n- Root: ايم (A-Y-M) — [Noted as a rare root; no direct bearing on this passage’s core terms, but included per lexical apparatus.]\n- Root: نفس (N-F-S)\n  * Al-Raghib (Mufradat): The self (nafs) as the locus of volitional restraint — patience is an act of the nafs holding itself back, distinguishing it from mere physical endurance.\n  * Al-Zamakhshari (Asas): Literal: “a precious thing” (nafīs). Metaphorical: “he poured out his soul” (i.e., his blood), and “everything that has no flowing soul does not defile water.”\n- Sibawayh Rule: Restriction and Focused Predication (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — Governing the exclusive clause {«إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ»}, where innamā restricts the reward-without-account solely to the patient, and {«الصَّوْمُ لِي وَأَنَا أَجْزِي بِهِ»}, where the predicate is focused to Allah alone.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "25": [{"arabic": "عالم الغيب والشهادة أنت تحكم بين عبادك فيما كانوا فيه يختلفون اهدني لما اختلف فيه من الحق بإذنك إنك تهدي من تشاء إلى صراط مستقيما (7) ثم يفتتح الصلاة ويصلي ركعتين خفيفتين ثم يصلي مثنى مثنى ما تيسر له ويختم بالوتر إن لم يكن قد صلى الوتر ويستحب أن يفصل بين الصلاتين عند تسليمه بمائة تسبيحة ليستريح ويزيد نشاطه للصلاة وقد صح في صلاة رسول الله صلى الله عليه وسلم بالليل أنه صلى أولا ركعتين خفيفتين ثم ركعتين طويلتين ثم ركعتين دون اللتين قبلهما ثم لم يزل يقصر بالتدريج إلى ثلاث عشرة ركعة (1) وسئلت عائشة رضي الله", "english": "Then it is recommended, after the salutation of the witr, that he say: \"Glory be to the King, the Most Holy, the Lord of the angels and the Spirit. You have enveloped the heavens and the earth with majesty and dominion. You have manifested Your might through power, and You have subdued the servants through death.\" It is related that he (peace and blessings be upon him) — until he died — most of his prayer was seated, except for the obligatory prayers (1). And he said to the one who prays seated: \"Half the reward of the one who prays standing,\" and to the one who sleeps: \"Half the reward of the one who prays seated\" (2). This indicates the validity of the supererogatory prayer in all states.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 264", "section_title_en": "The Fourth and Fifth Wirds (Portions of Night Devotion): On Sleep and the Final Sixth of the Night", "section_index": 264, "anchors": "- Root: ليل (Layl)\n  * Lisan / Ayn: Night; the period of darkness from sunset to dawn; its plural forms include layālī and layalāt.\n  * Al-Raghib (Mufradat): Night is a divinely ordained sign (āyah) of Allah's power; sleep is described as a form of death (tawaffā) in the Qur'an, linking the nightly cycle to resurrection.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) for the astronomical night; metaphorical (majāz) for spiritual darkness or heedlessness.\n- Root: نوم (Nawm)\n  * Lisan / Ayn: Sleep; slumber; a state of rest.\n  * Al-Raghib (Mufradat): Sleep is \"death in a light form\" (al-mawt al-khafīf), and death is \"sleep in a heavy form\" (al-nawm al-thaqīl). Allah says: {«Allah takes the souls at the time of their death, and those that die not during their sleep»} (Q. 39:42).\n  * Al-Zamakhshari (Asas): Literal: bodily rest. Metaphorical: heedlessness (ghaflah) or spiritual inertia; \"the market slept\" means it stagnated.\n- Root: عله (Alaha/Ilah)\n  * Lisan / Ayn: To worship; to seek refuge; the root for ilāh (deity) and Allāh (the Supreme Deity).\n  * Al-Raghib (Mufradat): The root denotes the act of devotion and the object of ultimate veneration; al-ulūhiyyah is the state of being worshipped.\n  * Al-Zamakhshari (Asas): Literal: deity. Metaphorical: that which one is utterly devoted to or enslaved by (e.g., one's desires).\n- Root: الي (Alā/Yalū)\n  * Lisan / Ayn: To be occupied with; to manage; related to al-ālah (instrument) and ma'ālah (consequence).\n  * Al-Raghib (Mufradat): The root conveys the idea of returning to a state or being entrusted with a matter; al-ālah is that by which one accomplishes an affair.\n  * Al-Zamakhshari (Asas): Literal: instrumentality. Metaphorical: the means by which one draws near to Allah.\n- Sibawayh Rule: Restriction and Focused Predication (al-Ḥaṣr wa al-Taqyīd bi-innamā) — Used to distinguish the specific legal scope of actions (e.g., the witr prayer's status) and to restrict general statements to their precise conditions.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Arrangement of Litanies'", "badge": "Dhikr"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 350, 7342]], "2": [[1, 350, 1381], [2, 1381, 2299], [3, 2299, 2786], [4, 2786, 3442], [5, 3442, 4079], [6, 4079, 4454], [7, 4454, 5110], [8, 5110, 6558]], "3": [[1, 400, 883], [2, 883, 2573], [3, 2573, 4022], [4, 4022, 4461], [5, 4461, 4988], [6, 4988, 5976], [7, 5976, 6415], [8, 6415, 7403], [9, 7403, 8523], [10, 8523, 9687], [11, 9687, 11138], [12, 11138, 12565], [13, 12565, 13322], [14, 13322, 14650], [15, 14650, 15407], [16, 15407, 16384], [17, 16384, 17668], [18, 17668, 19184]], "4": [[1, 400, 1306], [2, 1306, 2372], [3, 2372, 3129], [4, 3129, 5015], [5, 5015, 6460], [6, 6460, 7400], [7, 7400, 9005], [8, 9005, 9578], [9, 9578, 10415], [10, 10415, 11888], [11, 11888, 12702], [12, 12702, 14147], [13, 14147, 14995], [14, 14995, 16073], [15, 16073, 16669], [16, 16669, 17357], [17, 17357, 18148], [18, 18148, 19157], [19, 19157, 19616], [20, 19616, 20791], [21, 20791, 21731], [22, 21731, 22855], [23, 22855, 23956], [24, 23956, 25872]], "5": [[1, 400, 1542], [2, 1542, 2521], [3, 2521, 2956], [4, 2956, 4954], [5, 4954, 5759], [6, 5759, 6803], [7, 6803, 7575], [8, 7575, 8597], [9, 8597, 9598], [10, 9598, 10142], [11, 10142, 11012], [12, 11012, 11795], [13, 11795, 13631], [14, 13631, 14327], [15, 14327, 14958], [16, 14958, 16372], [17, 16372, 17774]], "6": [[1, 350, 967], [2, 967, 1610], [3, 1610, 2414], [4, 2414, 3750], [5, 3750, 4735], [6, 4735, 5827]], "7": [[1, 400, 2191], [2, 2191, 3309], [3, 3309, 4008], [4, 4008, 4897], [5, 4897, 5964], [6, 5964, 7158], [7, 7158, 7996], [8, 7996, 9586], [9, 9586, 10094], [10, 10094, 11060]], "8": [[1, 400, 1411], [2, 1411, 2322], [3, 2322, 3461], [4, 3461, 4030], [5, 4030, 5311], [6, 5311, 6293], [7, 6293, 8403], [8, 8403, 10068]], "9":