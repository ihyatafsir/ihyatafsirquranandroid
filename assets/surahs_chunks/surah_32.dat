ic": "اُ۬لذِے", "translit": "", "root": ""}, {"id": 3, "arabic": "خَلَقَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "بَيْنَهُمَا", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "سِتَّةِ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَيَّامࣲ", "translit": "", "root": ""}, {"id": 11, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۪سْتَو۪يٰ", "translit": "", "root": ""}, {"id": 13, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 14, "arabic": "اَ۬لْعَرْشِۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "مَا", "translit": "", "root": ""}, {"id": 16, "arabic": "لَكُم", "translit": "", "root": ""}, {"id": 17, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 18, "arabic": "دُونِهِۦ", "translit": "", "root": ""}, {"id": 19, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 20, "arabic": "وَّلِيࣲّ", "translit": "", "root": ""}, {"id": 21, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 22, "arabic": "شَفِيعٍۖ", "translit": "", "root": ""}, {"id": 23, "arabic": "اَفَلَا", "translit": "", "root": ""}, {"id": 24, "arabic": "تَتَذَكَّرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 32, "ayah": 5, "text": "يُدَبِّرُ اُ۬لَامْرَ مِنَ اَ۬لسَّمَآءِ الَي اَ۬لَارْضِ ثُمَّ يَعْرُجُ إِلَيْهِ فِے يَوْمࣲ كَانَ مِقْدَارُهُۥٓ أَلْفَ سَنَةࣲ مِّمَّا تَعُدُّونَۖ", "words": [{"id": 1, "arabic": "يُدَبِّرُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لَامْرَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 5, "arabic": "الَي", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لَارْضِ", "translit": "", "root": ""}, {"id": 7, "arabic": "ثُ