{"surah": 32, "verses": [{"ayah": 1, "text": "الٓمٓ ", "translation": "Alif, Lām, Meem.[1]", "words": [{"id": 1, "arabic": "الٓمٓ", "translit": "ٓmٓlā", "root": ""}], "hasIhya": false}, {"ayah": 2, "text": "تَنزِيلُ ٱلْكِتَٰبِ لَا رَيْبَ فِيهِ مِن رَّبِّ ٱلْعَٰلَمِينَ ", "translation": "[This is] the revelation of the Book about which there is no doubt from the Lord of the worlds.", "words": [{"id": 1, "arabic": "تَنزِيلُ", "translit": "ُlyِznَt", "root": "نزل"}, {"id": 2, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "رَيْبَ", "translit": "َbْyَr", "root": "ريب"}, {"id": 5, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "رَّبِّ", "translit": "ِّbَّr", "root": "ربب"}, {"id": 8, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 3, "text": "أَمْ يَقُولُونَ ٱفْتَرَىٰهُۚ بَلْ هُوَ ٱلْحَقُّ مِن رَّبِّكَ لِتُنذِرَ قَوْمًا مَّآ أَتَىٰهُم مِّن نَّذِيرٍ مِّن قَبْلِكَ لَعَلَّهُمْ يَهْتَدُونَ ", "translation": "Or do they say, \"He invented it\"? Rather, it is the truth from your Lord, [O Muḥammad], that you may warn a people to whom no warner has come before you [so] perhaps they will be guided.", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 3, "arabic": "ٱفْتَرَىٰهُ", "translit": "ُhٰàَrَtْfٱ", "root": "فري"}, {"id": 4, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 5, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 6, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 9, "arabic": "لِتُنذِرَ", "translit": "َrِhdnُtِl", "root": "نذر"}, {"id": 10, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 11, "arabic": "مَّآ", "translit": "ٓāَّm", "root": ""}, {"id": 12, "arabic": "أَتَىٰهُم", "translit": "mُhٰàَtَaʾ", "root": "اتي"}, {"id": 13, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 14, "arabic": "نَّذِيرٍ", "translit": "ٍryِhdَّn", "root": "نذر"}, {"id": 15, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 16, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 17, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 18, "arabic": "يَهْتَدُونَ", "translit": "َnwُdَtْhَy", "root": "هدي"}], "hasIhya": false}, {"ayah": 4, "text": "ٱللَّهُ ٱلَّذِى خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا فِى سِتَّةِ أَيَّامٍ ثُمَّ ٱسْتَوَىٰ عَلَى ٱلْعَرْشِۖ مَا لَكُم مِّن دُونِهِۦ مِن وَلِىٍّ وَلَا شَفِيعٍۚ أَفَلَا تَتَذَكَّرُونَ ", "translation": "It is Allāh who created the heavens and the earth and whatever is between them in six days; then He established Himself above the Throne.[1] You have not besides Him any protector or any intercessor; so will you not be reminded?", "words": [{"id": 1, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "بَيْنَهُمَا", "translit": "āَmُhَnْyَb", "root": "بين"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "سِتَّةِ", "translit": "ِẗَّtِs", "root": "ستت"}, {"id": 10, "arabic": "أَيَّامٍ", "translit": "ٍmāَّyَaʾ", "root": "يوم"}, {"id": 11, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 12, "arabic": "ٱسْتَوَىٰ", "translit": "ٰàَwَtْsٱ", "root": "سوي"}, {"id": 13, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 14, "arabic": "ٱلْعَرْشِ", "translit": "ِhsْrَʿعْlٱ", "root": "عرش"}, {"id": 15, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 16, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 17, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 18, "arabic": "دُونِهِۦ", "translit": "ۦِhِnwُd", "root": "دون"}, {"id": 19, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 20, "arabic": "وَلِىٍّ", "translit": "ٍّàِlَw", "root": "ولي"}, {"id": 21, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 22, "arabic": "شَفِيعٍ", "translit": "ٍʿعyِfَhs", "root": "شفع"}, {"id": 23, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 24, "arabic": "تَتَذَكَّرُونَ", "translit": "َnwُrَّkَhdَtَt", "root": "ذكر"}], "hasIhya": false}, {"ayah": 5, "text": "يُدَبِّرُ ٱلْأَمْرَ مِنَ ٱلسَّمَآءِ إِلَى ٱلْأَرْضِ ثُمَّ يَعْرُجُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥٓ أَلْفَ سَنَةٍ مِّمَّا تَعُدُّونَ ", "translation": "He arranges [each] matter from the heaven to the earth; then it will ascend to Him in a Day, the extent of which is a thousand years of those which you count.", "words": [{"id": 1, "arabic": "يُدَبِّرُ", "translit": "ُrِّbَdُy", "root": "دبر"}, {"id": 2, "arabic": "ٱلْأَمْرَ", "translit": "َrْmَaʾْlٱ", "root": "امر"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 6, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 7, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 8, "arabic": "يَعْرُجُ", "translit": "ُjgُrْʿعَy", "root": "عرج"}, {"id": 9, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "يَوْمٍ", "translit": "ٍmْwَy", "root": "يوم"}, {"id": 12, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 13, "arabic": "مِقْدَارُهُۥٓ", "translit": "ٓۥُhُrāَdْqِm", "root": "قدر"}, {"id": 14, "arabic": "أَلْفَ", "translit": "َfْlَaʾ", "root": "الف"}, {"id": 15, "arabic": "سَنَةٍ", "translit": "ٍẗَnَs", "root": "سنو"}, {"id": 16, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 17, "arabic": "تَعُدُّونَ", "translit": "َnwُّdُʿعَt", "root": "عدد"}], "hasIhya": false}, {"ayah": 6, "text": "ذَٰلِكَ عَٰلِمُ ٱلْغَيْبِ وَٱلشَّهَٰدَةِ ٱلْعَزِيزُ ٱلرَّحِيمُ ", "translation": "That is the Knower of the unseen and the witnessed, the Exalted in Might, the Merciful,", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "عَٰلِمُ", "translit": "ُmِlَٰʿع", "root": "علم"}, {"id": 3, "arabic": "ٱلْغَيْبِ", "translit": "ِbْyَغْlٱ", "root": "غيب"}, {"id": 4, "arabic": "وَٱلشَّهَٰدَةِ", "translit": "ِẗَdَٰhَّhslٱَw", "root": "شهد"}, {"id": 5, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 6, "arabic": "ٱلرَّحِيمُ", "translit": "ُmyِḥَّrlٱ", "root": "رحم"}], "hasIhya": false}, {"ayah": 7, "text": "ٱلَّذِىٓ أَحْسَنَ كُلَّ شَىْءٍ خَلَقَهُۥۖ وَبَدَأَ خَلْقَ ٱلْإِنسَٰنِ مِن طِينٍ ", "translation": "Who perfected everything which He created and began the creation of man from clay.", "words": [{"id": 1, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "أَحْسَنَ", "translit": "َnَsْḥَaʾ", "root": "حسن"}, {"id": 3, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 4, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 5, "arabic": "خَلَقَهُۥ", "translit": "ۥُhَqَlَhk", "root": "خلق"}, {"id": 6, "arabic": "وَبَدَأَ", "translit": "َaʾَdَbَw", "root": "بدا"}, {"id": 7, "arabic": "خَلْقَ", "translit": "َqْlَhk", "root": "خلق"}, {"id": 8, "arabic": "ٱلْإِنسَٰنِ", "translit": "ِnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "طِينٍ", "translit": "ٍnyِṭ", "root": "طين"}], "hasIhya": true}, {"ayah": 8, "text": "ثُمَّ جَعَلَ نَسْلَهُۥ مِن سُلَٰلَةٍ مِّن مَّآءٍ مَّهِينٍ ", "translation": "Then He made his posterity out of the extract of a liquid disdained.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "نَسْلَهُۥ", "translit": "ۥُhَlْsَn", "root": "نسل"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "سُلَٰلَةٍ", "translit": "ٍẗَlَٰlُs", "root": "سلل"}, {"id": 6, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 7, "arabic": "مَّآءٍ", "translit": "ٍءٓāَّm", "root": "موه"}, {"id": 8, "arabic": "مَّهِينٍ", "translit": "ٍnyِhَّm", "root": "مهن"}], "hasIhya": false}, {"ayah": 9, "text": "ثُمَّ سَوَّىٰهُ وَنَفَخَ فِيهِ مِن رُّوحِهِۦۖ وَجَعَلَ لَكُمُ ٱلسَّمْعَ وَٱلْأَبْصَٰرَ وَٱلْأَفْـِٔدَةَۚ قَلِيلًا مَّا تَشْكُرُونَ ", "translation": "Then He proportioned him and breathed into him from His [created] soul[1] and made for you hearing and vision and hearts [i.e., intellect]; little are you grateful.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "سَوَّىٰهُ", "translit": "ُhٰàَّwَs", "root": "سوي"}, {"id": 3, "arabic": "وَنَفَخَ", "translit": "َhkَfَnَw", "root": "نفخ"}, {"id": 4, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "رُّوحِهِۦ", "translit": "ۦِhِḥwُّr", "root": "روح"}, {"id": 7, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 8, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 9, "arabic": "ٱلسَّمْعَ", "translit": "َʿعْmَّslٱ", "root": "سمع"}, {"id": 10, "arabic": "وَٱلْأَبْصَٰرَ", "translit": "َrَٰṣْbَaʾْlٱَw", "root": "بصر"}, {"id": 11, "arabic": "وَٱلْأَفْـِٔدَةَ", "translit": "َẗَdِٔـْfَaʾْlٱَw", "root": "فاد"}, {"id": 12, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 13, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 14, "arabic": "تَشْكُرُونَ", "translit": "َnwُrُkْhsَt", "root": "شكر"}], "hasIhya": false}, {"ayah": 10, "text": "وَقَالُوٓا۟ أَءِذَا ضَلَلْنَا فِى ٱلْأَرْضِ أَءِنَّا لَفِى خَلْقٍ جَدِيدٍۭۚ بَلْ هُم بِلِقَآءِ رَبِّهِمْ كَٰفِرُونَ ", "translation": "And they say, \"When we are lost [i.e., disintegrated] within the earth, will we indeed be [recreated] in a new creation?\" Rather, they are, in the meeting with their Lord, disbelievers.", "words": [{"id": 1, "arabic": "وَقَالُوٓا۟", "translit": "۟āٓwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "أَءِذَا", "translit": "āَhdِءَaʾ", "root": ""}, {"id": 3, "arabic": "ضَلَلْنَا", "translit": "āَnْlَlَḍ", "root": "ضلل"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "أَءِنَّا", "translit": "āَّnِءَaʾ", "root": ""}, {"id": 7, "arabic": "لَفِى", "translit": "àِfَl", "root": ""}, {"id": 8, "arabic": "خَلْقٍ", "translit": "ٍqْlَhk", "root": "خلق"}, {"id": 9, "arabic": "جَدِيدٍۭ", "translit": "ٍۭdyِdَjg", "root": "جدد"}, {"id": 10, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 11, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 12, "arabic": "بِلِقَآءِ", "translit": "ِءٓāَqِlِb", "root": "لقي"}, {"id": 13, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 14, "arabic": "كَٰفِرُونَ", "translit": "َnwُrِfَٰk", "root": "كفر"}], "hasIhya": false}, {"ayah": 11, "text": "قُلْ يَتَوَفَّىٰكُم مَّلَكُ ٱلْمَوْتِ ٱلَّذِى وُكِّلَ بِكُمْ ثُمَّ إِلَىٰ رَبِّكُمْ تُرْجَعُونَ ", "translation": "Say, \"The angel of death who has been entrusted with you will take you. Then to your Lord you will be returned.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "يَتَوَفَّىٰكُم", "translit": "mُkٰàَّfَwَtَy", "root": "وفي"}, {"id": 3, "arabic": "مَّلَكُ", "translit": "ُkَlَّm", "root": "ملك"}, {"id": 4, "arabic": "ٱلْمَوْتِ", "translit": "ِtْwَmْlٱ", "root": "موت"}, {"id": 5, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "وُكِّلَ", "translit": "َlِّkُw", "root": "وكل"}, {"id": 7, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": ""}, {"id": 8, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 9, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 10, "arabic": "رَبِّكُمْ", "translit": "ْmُkِّbَr", "root": "ربب"}, {"id": 11, "arabic": "تُرْجَعُونَ", "translit": "َnwُʿعَjgْrُt", "root": "رجع"}], "hasIhya": true}, {"ayah": 12, "text": "وَلَوْ تَرَىٰٓ إِذِ ٱلْمُجْرِمُونَ نَاكِسُوا۟ رُءُوسِهِمْ عِندَ رَبِّهِمْ رَبَّنَآ أَبْصَرْنَا وَسَمِعْنَا فَٱرْجِعْنَا نَعْمَلْ صَٰلِحًا إِنَّا مُوقِنُونَ ", "translation": "If you could but see when the criminals are hanging their heads before their Lord, [saying], \"Our Lord, we have seen and heard, so return us [to the world]; we will work righteousness. Indeed, we are [now] certain.\"", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "تَرَىٰٓ", "translit": "ٰٓàَrَt", "root": "راي"}, {"id": 3, "arabic": "إِذِ", "translit": "ِhdِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلْمُجْرِمُونَ", "translit": "َnwُmِrْjgُmْlٱ", "root": "جرم"}, {"id": 5, "arabic": "نَاكِسُوا۟", "translit": "۟āwُsِkāَn", "root": "نكس"}, {"id": 6, "arabic": "رُءُوسِهِمْ", "translit": "ْmِhِswُءُr", "root": "راس"}, {"id": 7, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 8, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 9, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 10, "arabic": "أَبْصَرْنَا", "translit": "āَnْrَṣْbَaʾ", "root": "بصر"}, {"id": 11, "arabic": "وَسَمِعْنَا", "translit": "āَnْʿعِmَsَw", "root": "سمع"}, {"id": 12, "arabic": "فَٱرْجِعْنَا", "translit": "āَnْʿعِjgْrٱَf", "root": "رجع"}, {"id": 13, "arabic": "نَعْمَلْ", "translit": "ْlَmْʿعَn", "root": "عمل"}, {"id": 14, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 15, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 16, "arabic": "مُوقِنُونَ", "translit": "َnwُnِqwُm", "root": "يقن"}], "hasIhya": true}, {"ayah": 13, "text": "وَلَوْ شِئْنَا لَءَاتَيْنَا كُلَّ نَفْسٍ هُدَىٰهَا وَلَٰكِنْ حَقَّ ٱلْقَوْلُ مِنِّى لَأَمْلَأَنَّ جَهَنَّمَ مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ أَجْمَعِينَ ", "translation": "And if We had willed, We could have given every soul its guidance, but the word[1] from Me will come into effect [that] \"I will surely fill Hell with jinn and people all together.", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "شِئْنَا", "translit": "āَnْyʾِhs", "root": "شيا"}, {"id": 3, "arabic": "لَءَاتَيْنَا", "translit": "āَnْyَtāَءَl", "root": "اتي"}, {"id": 4, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 5, "arabic": "نَفْسٍ", "translit": "ٍsْfَn", "root": "نفس"}, {"id": 6, "arabic": "هُدَىٰهَا", "translit": "āَhٰàَdُh", "root": "هدي"}, {"id": 7, "arabic": "وَلَٰكِنْ", "translit": "ْnِkَٰlَw", "root": ""}, {"id": 8, "arabic": "حَقَّ", "translit": "َّqَḥ", "root": "حقق"}, {"id": 9, "arabic": "ٱلْقَوْلُ", "translit": "ُlْwَqْlٱ", "root": "قول"}, {"id": 10, "arabic": "مِنِّى", "translit": "àِّnِm", "root": ""}, {"id": 11, "arabic": "لَأَمْلَأَنَّ", "translit": "َّnَaʾَlْmَaʾَl", "root": "ملا"}, {"id": 12, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 13, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 14, "arabic": "ٱلْجِنَّةِ", "translit": "ِẗَّnِjgْlٱ", "root": "جنن"}, {"id": 15, "arabic": "وَٱلنَّاسِ", "translit": "ِsāَّnlٱَw", "root": "انس"}, {"id": 16, "arabic": "أَجْمَعِينَ", "translit": "َnyِʿعَmْjgَaʾ", "root": "جمع"}], "hasIhya": true}, {"ayah": 14, "text": "فَذُوقُوا۟ بِمَا نَسِيتُمْ لِقَآءَ يَوْمِكُمْ هَٰذَآ إِنَّا نَسِينَٰكُمْۖ وَذُوقُوا۟ عَذَابَ ٱلْخُلْدِ بِمَا كُنتُمْ تَعْمَلُونَ ", "translation": "So taste [punishment] because you forgot the meeting of this, your Day; indeed, We have [accordingly] forgotten you. And taste the punishment of eternity for what you used to do.\"", "words": [{"id": 1, "arabic": "فَذُوقُوا۟", "translit": "۟āwُqwُhdَf", "root": "ذوق"}, {"id": 2, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 3, "arabic": "نَسِيتُمْ", "translit": "ْmُtyِsَn", "root": "نسي"}, {"id": 4, "arabic": "لِقَآءَ", "translit": "َءٓāَqِl", "root": "لقي"}, {"id": 5, "arabic": "يَوْمِكُمْ", "translit": "ْmُkِmْwَy", "root": "يوم"}, {"id": 6, "arabic": "هَٰذَآ", "translit": "ٓāَhdَٰh", "root": ""}, {"id": 7, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 8, "arabic": "نَسِينَٰكُمْ", "translit": "ْmُkَٰnyِsَn", "root": "نسي"}, {"id": 9, "arabic": "وَذُوقُوا۟", "translit": "۟āwُqwُhdَw", "root": "ذوق"}, {"id": 10, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 11, "arabic": "ٱلْخُلْدِ", "translit": "ِdْlُhkْlٱ", "root": "خلد"}, {"id": 12, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 13, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 14, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 15, "text": "إِنَّمَا يُؤْمِنُ بِـَٔايَٰتِنَا ٱلَّذِينَ إِذَا ذُكِّرُوا۟ بِهَا خَرُّوا۟ سُجَّدًا وَسَبَّحُوا۟ بِحَمْدِ رَبِّهِمْ وَهُمْ لَا يَسْتَكْبِرُونَ۩ ", "translation": "Only those believe in Our verses who, when they are reminded by them, fall down in prostration and exalt [Allāh] with praise of their Lord, and they are not arrogant.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "يُؤْمِنُ", "translit": "ُnِmْwʾُy", "root": "امن"}, {"id": 3, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 6, "arabic": "ذُكِّرُوا۟", "translit": "۟āwُrِّkُhd", "root": "ذكر"}, {"id": 7, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 8, "arabic": "خَرُّوا۟", "translit": "۟āwُّrَhk", "root": "خرر"}, {"id": 9, "arabic": "سُجَّدًا", "translit": "āًdَّjgُs", "root": "سجد"}, {"id": 10, "arabic": "وَسَبَّحُوا۟", "translit": "۟āwُḥَّbَsَw", "root": "سبح"}, {"id": 11, "arabic": "بِحَمْدِ", "translit": "ِdْmَḥِb", "root": "حمد"}, {"id": 12, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 13, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 14, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 15, "arabic": "يَسْتَكْبِرُونَ", "translit": "َnwُrِbْkَtْsَy", "root": "كبر"}], "hasIhya": true}, {"ayah": 16, "text": "تَتَجَافَىٰ جُنُوبُهُمْ عَنِ ٱلْمَضَاجِعِ يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا وَمِمَّا رَزَقْنَٰهُمْ يُنفِقُونَ ", "translation": "Their sides part [i.e., they arise] from [their] beds; they supplicate their Lord in fear and aspiration, and from what We have provided them, they spend.[1]", "words": [{"id": 1, "arabic": "تَتَجَافَىٰ", "translit": "ٰàَfāَjgَtَt", "root": "جفو"}, {"id": 2, "arabic": "جُنُوبُهُمْ", "translit": "ْmُhُbwُnُjg", "root": "جنب"}, {"id": 3, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 4, "arabic": "ٱلْمَضَاجِعِ", "translit": "ِʿعِjgāَḍَmْlٱ", "root": "ضجع"}, {"id": 5, "arabic": "يَدْعُونَ", "translit": "َnwُʿعْdَy", "root": "دعو"}, {"id": 6, "arabic": "رَبَّهُمْ", "translit": "ْmُhَّbَr", "root": "ربب"}, {"id": 7, "arabic": "خَوْفًا", "translit": "āًfْwَhk", "root": "خوف"}, {"id": 8, "arabic": "وَطَمَعًا", "translit": "āًʿعَmَṭَw", "root": "طمع"}, {"id": 9, "arabic": "وَمِمَّا", "translit": "āَّmِmَw", "root": ""}, {"id": 10, "arabic": "رَزَقْنَٰهُمْ", "translit": "ْmُhَٰnْqَzَr", "root": "رزق"}, {"id": 11, "arabic": "يُنفِقُونَ", "translit": "َnwُqِfnُy", "root": "نفق"}], "hasIhya": true}, {"ayah": 17, "text": "فَلَا تَعْلَمُ نَفْسٌ مَّآ أُخْفِىَ لَهُم مِّن قُرَّةِ أَعْيُنٍ جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ ", "translation": "And no soul knows what has been hidden for them of comfort for eyes [i.e., satisfaction] as reward for what they used to do.", "words": [{"id": 1, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 2, "arabic": "تَعْلَمُ", "translit": "ُmَlْʿعَt", "root": "علم"}, {"id": 3, "arabic": "نَفْسٌ", "translit": "ٌsْfَn", "root": "نفس"}, {"id": 4, "arabic": "مَّآ", "translit": "ٓāَّm", "root": ""}, {"id": 5, "arabic": "أُخْفِىَ", "translit": "َàِfْhkُaʾ", "root": "خفي"}, {"id": 6, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 7, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 8, "arabic": "قُرَّةِ", "translit": "ِẗَّrُq", "root": "قرر"}, {"id": 9, "arabic": "أَعْيُنٍ", "translit": "ٍnُyْʿعَaʾ", "root": "عين"}, {"id": 10, "arabic": "جَزَآءًۢ", "translit": "ًۢءٓāَzَjg", "root": "جزي"}, {"id": 11, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 12, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 13, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": true}, {"ayah": 18, "text": "أَفَمَن كَانَ مُؤْمِنًا كَمَن كَانَ فَاسِقًاۚ لَّا يَسْتَوُۥنَ ", "translation": "Then is one who was a believer like one who was defiantly disobedient? They are not equal.", "words": [{"id": 1, "arabic": "أَفَمَن", "translit": "nَmَfَaʾ", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "مُؤْمِنًا", "translit": "āًnِmْwʾُm", "root": "امن"}, {"id": 4, "arabic": "كَمَن", "translit": "nَmَk", "root": ""}, {"id": 5, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 6, "arabic": "فَاسِقًا", "translit": "āًqِsāَf", "root": "فسق"}, {"id": 7, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 8, "arabic": "يَسْتَوُۥنَ", "translit": "َnۥُwَtْsَy", "root": "سوي"}], "hasIhya": false}, {"ayah": 19, "text": "أَمَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ جَنَّٰتُ ٱلْمَأْوَىٰ نُزُلًۢا بِمَا كَانُوا۟ يَعْمَلُونَ ", "translation": "As for those who believed and did righteous deeds, for them will be the Gardens of Refuge as accommodation for what they used to do.", "words": [{"id": 1, "arabic": "أَمَّا", "translit": "āَّmَaʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 5, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 6, "arabic": "فَلَهُمْ", "translit": "ْmُhَlَf", "root": ""}, {"id": 7, "arabic": "جَنَّٰتُ", "translit": "ُtَّٰnَjg", "root": "جنن"}, {"id": 8, "arabic": "ٱلْمَأْوَىٰ", "translit": "ٰàَwْaʾَmْlٱ", "root": "اوي"}, {"id": 9, "arabic": "نُزُلًۢا", "translit": "āًۢlُzُn", "root": "نزل"}, {"id": 10, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 11, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 12, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 20, "text": "وَأَمَّا ٱلَّذِينَ فَسَقُوا۟ فَمَأْوَىٰهُمُ ٱلنَّارُۖ كُلَّمَآ أَرَادُوٓا۟ أَن يَخْرُجُوا۟ مِنْهَآ أُعِيدُوا۟ فِيهَا وَقِيلَ لَهُمْ ذُوقُوا۟ عَذَابَ ٱلنَّارِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ ", "translation": "But as for those who defiantly disobeyed, their refuge is the Fire. Every time they wish to emerge from it, they will be returned to it while it is said to them, \"Taste the punishment of the Fire which you used to deny.\"", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "āَّmَaʾَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "فَسَقُوا۟", "translit": "۟āwُqَsَf", "root": "فسق"}, {"id": 4, "arabic": "فَمَأْوَىٰهُمُ", "translit": "ُmُhٰàَwْaʾَmَf", "root": "اوي"}, {"id": 5, "arabic": "ٱلنَّارُ", "translit": "ُrāَّnlٱ", "root": "نور"}, {"id": 6, "arabic": "كُلَّمَآ", "translit": "ٓāَmَّlُk", "root": "كلل"}, {"id": 7, "arabic": "أَرَادُوٓا۟", "translit": "۟āٓwُdāَrَaʾ", "root": "رود"}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "يَخْرُجُوا۟", "translit": "۟āwُjgُrْhkَy", "root": "خرج"}, {"id": 10, "arabic": "مِنْهَآ", "translit": "ٓāَhْnِm", "root": ""}, {"id": 11, "arabic": "أُعِيدُوا۟", "translit": "۟āwُdyِʿعُaʾ", "root": "عود"}, {"id": 12, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 13, "arabic": "وَقِيلَ", "translit": "َlyِqَw", "root": "قول"}, {"id": 14, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 15, "arabic": "ذُوقُوا۟", "translit": "۟āwُqwُhd", "root": "ذوق"}, {"id": 16, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 17, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 18, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 19, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 20, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 21, "arabic": "تُكَذِّبُونَ", "translit": "َnwُbِّhdَkُt", "root": "كذب"}], "hasIhya": true}, {"ayah": 21, "text": "وَلَنُذِيقَنَّهُم مِّنَ ٱلْعَذَابِ ٱلْأَدْنَىٰ دُونَ ٱلْعَذَابِ ٱلْأَكْبَرِ لَعَلَّهُمْ يَرْجِعُونَ ", "translation": "And We will surely let them taste the nearer punishment[1] short of the greater punishment that perhaps they will return [i.e., repent].", "words": [{"id": 1, "arabic": "وَلَنُذِيقَنَّهُم", "translit": "mُhَّnَqyِhdُnَlَw", "root": "ذوق"}, {"id": 2, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 3, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 4, "arabic": "ٱلْأَدْنَىٰ", "translit": "ٰàَnْdَaʾْlٱ", "root": "دنو"}, {"id": 5, "arabic": "دُونَ", "translit": "َnwُd", "root": "دون"}, {"id": 6, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 7, "arabic": "ٱلْأَكْبَرِ", "translit": "ِrَbْkَaʾْlٱ", "root": "كبر"}, {"id": 8, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 9, "arabic": "يَرْجِعُونَ", "translit": "َnwُʿعِjgْrَy", "root": "رجع"}], "hasIhya": false}, {"ayah": 22, "text": "وَمَنْ أَظْلَمُ مِمَّن ذُكِّرَ بِـَٔايَٰتِ رَبِّهِۦ ثُمَّ أَعْرَضَ عَنْهَآۚ إِنَّا مِنَ ٱلْمُجْرِمِينَ مُنتَقِمُونَ ", "translation": "And who is more unjust than one who is reminded of the verses of his Lord; then he turns away from them? Indeed We, from the criminals, will take retribution.", "words": [{"id": 1, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 2, "arabic": "أَظْلَمُ", "translit": "ُmَlْẓَaʾ", "root": "ظلم"}, {"id": 3, "arabic": "مِمَّن", "translit": "nَّmِm", "root": ""}, {"id": 4, "arabic": "ذُكِّرَ", "translit": "َrِّkُhd", "root": "ذكر"}, {"id": 5, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 6, "arabic": "رَبِّهِۦ", "translit": "ۦِhِّbَr", "root": "ربب"}, {"id": 7, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 8, "arabic": "أَعْرَضَ", "translit": "َḍَrْʿعَaʾ", "root": "عرض"}, {"id": 9, "arabic": "عَنْهَآ", "translit": "ٓāَhْnَʿع", "root": ""}, {"id": 10, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 11, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 12, "arabic": "ٱلْمُجْرِمِينَ", "translit": "َnyِmِrْjgُmْlٱ", "root": "جرم"}, {"id": 13, "arabic": "مُنتَقِمُونَ", "translit": "َnwُmِqَtnُm", "root": "نقم"}], "hasIhya": false}, {"ayah": 23, "text": "وَلَقَدْ ءَاتَيْنَا مُوسَى ٱلْكِتَٰبَ فَلَا تَكُن فِى مِرْيَةٍ مِّن لِّقَآئِهِۦۖ وَجَعَلْنَٰهُ هُدًى لِّبَنِىٓ إِسْرَٰٓءِيلَ ", "translation": "And We certainly gave Moses the Scripture, so do not be in doubt over his meeting.[1] And We made it [i.e., the Torah] guidance for the Children of Israel.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَا", "translit": "āَnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "مُوسَى", "translit": "àَswُm", "root": ""}, {"id": 4, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 6, "arabic": "تَكُن", "translit": "nُkَt", "root": "كون"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "مِرْيَةٍ", "translit": "ٍẗَyْrِm", "root": "مري"}, {"id": 9, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 10, "arabic": "لِّقَآئِهِۦ", "translit": "ۦِhِyʾٓāَqِّl", "root": "لقي"}, {"id": 11, "arabic": "وَجَعَلْنَٰهُ", "translit": "ُhَٰnْlَʿعَjgَw", "root": "جعل"}, {"id": 12, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 13, "arabic": "لِّبَنِىٓ", "translit": "ٓàِnَbِّl", "root": "بني"}, {"id": 14, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}], "hasIhya": false}, {"ayah": 24, "text": "وَجَعَلْنَا مِنْهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا لَمَّا صَبَرُوا۟ۖ وَكَانُوا۟ بِـَٔايَٰتِنَا يُوقِنُونَ ", "translation": "And We made from among them leaders guiding by Our command when they were patient and [when] they were certain of Our signs.", "words": [{"id": 1, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 2, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 3, "arabic": "أَئِمَّةً", "translit": "ًẗَّmِyʾَaʾ", "root": "امم"}, {"id": 4, "arabic": "يَهْدُونَ", "translit": "َnwُdْhَy", "root": "هدي"}, {"id": 5, "arabic": "بِأَمْرِنَا", "translit": "āَnِrْmَaʾِb", "root": "امر"}, {"id": 6, "arabic": "لَمَّا", "translit": "āَّmَl", "root": ""}, {"id": 7, "arabic": "صَبَرُوا۟", "translit": "۟āwُrَbَṣ", "root": "صبر"}, {"id": 8, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 9, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 10, "arabic": "يُوقِنُونَ", "translit": "َnwُnِqwُy", "root": "يقن"}], "hasIhya": true}, {"ayah": 25, "text": "إِنَّ رَبَّكَ هُوَ يَفْصِلُ بَيْنَهُمْ يَوْمَ ٱلْقِيَٰمَةِ فِيمَا كَانُوا۟ فِيهِ يَخْتَلِفُونَ ", "translation": "Indeed, your Lord will judge between them on the Day of Resurrection concerning that over which they used to differ.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "