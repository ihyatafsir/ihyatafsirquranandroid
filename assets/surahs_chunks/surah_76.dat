{"surah": 76, "verses": [{"ayah": 1, "text": "هَلْ أَتَىٰ عَلَى ٱلْإِنسَٰنِ حِينٌ مِّنَ ٱلدَّهْرِ لَمْ يَكُن شَيْـًٔا مَّذْكُورًا ", "translation": "Has there [not] come upon man a period of time when he was not a thing [even] mentioned?", "words": [{"id": 1, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 2, "arabic": "أَتَىٰ", "translit": "ٰàَtَaʾ", "root": "اتي"}, {"id": 3, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلْإِنسَٰنِ", "translit": "ِnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 5, "arabic": "حِينٌ", "translit": "ٌnyِḥ", "root": "حين"}, {"id": 6, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 7, "arabic": "ٱلدَّهْرِ", "translit": "ِrْhَّdlٱ", "root": "دهر"}, {"id": 8, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 9, "arabic": "يَكُن", "translit": "nُkَy", "root": "كون"}, {"id": 10, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 11, "arabic": "مَّذْكُورًا", "translit": "āًrwُkْhdَّm", "root": "ذكر"}], "hasIhya": true}, {"ayah": 2, "text": "إِنَّا خَلَقْنَا ٱلْإِنسَٰنَ مِن نُّطْفَةٍ أَمْشَاجٍ نَّبْتَلِيهِ فَجَعَلْنَٰهُ سَمِيعًۢا بَصِيرًا ", "translation": "Indeed, We created man from a sperm-drop mixture[1] that We may try him; and We made him hearing and seeing.", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 2, "arabic": "خَلَقْنَا", "translit": "āَnْqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "ٱلْإِنسَٰنَ", "translit": "َnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "نُّطْفَةٍ", "translit": "ٍẗَfْṭُّn", "root": "نطف"}, {"id": 6, "arabic": "أَمْشَاجٍ", "translit": "ٍjgāَhsْmَaʾ", "root": "مشج"}, {"id": 7, "arabic": "نَّبْتَلِيهِ", "translit": "ِhyِlَtْbَّn", "root": "بلو"}, {"id": 8, "arabic": "فَجَعَلْنَٰهُ", "translit": "ُhَٰnْlَʿعَjgَf", "root": "جعل"}, {"id": 9, "arabic": "سَمِيعًۢا", "translit": "āًۢʿعyِmَs", "root": "سمع"}, {"id": 10, "arabic": "بَصِيرًا", "translit": "āًryِṣَb", "root": "بصر"}], "hasIhya": true}, {"ayah": 3, "text": "إِنَّا هَدَيْنَٰهُ ٱلسَّبِيلَ إِمَّا شَاكِرًا وَإِمَّا كَفُورًا ", "translation": "Indeed, We guided him to the way, be he grateful or be he ungrateful.", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 2, "arabic": "هَدَيْنَٰهُ", "translit": "ُhَٰnْyَdَh", "root": "هدي"}, {"id": 3, "arabic": "ٱلسَّبِيلَ", "translit": "َlyِbَّslٱ", "root": "سبل"}, {"id": 4, "arabic": "إِمَّا", "translit": "āَّmِiʾ", "root": ""}, {"id": 5, "arabic": "شَاكِرًا", "translit": "āًrِkāَhs", "root": "شكر"}, {"id": 6, "arabic": "وَإِمَّا", "translit": "āَّmِiʾَw", "root": ""}, {"id": 7, "arabic": "كَفُورًا", "translit": "āًrwُfَk", "root": "كفر"}], "hasIhya": false}, {"ayah": 4, "text": "إِنَّآ أَعْتَدْنَا لِلْكَٰفِرِينَ سَلَٰسِلَا۟ وَأَغْلَٰلًا وَسَعِيرًا ", "translation": "Indeed, We have prepared for the disbelievers chains and shackles and a blaze.", "words": [{"id": 1, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 2, "arabic": "أَعْتَدْنَا", "translit": "āَnْdَtْʿعَaʾ", "root": "عتد"}, {"id": 3, "arabic": "لِلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlِl", "root": "كفر"}, {"id": 4, "arabic": "سَلَٰسِلَا۟", "translit": "۟āَlِsَٰlَs", "root": "سلسل"}, {"id": 5, "arabic": "وَأَغْلَٰلًا", "translit": "āًlَٰlْغَaʾَw", "root": "غلل"}, {"id": 6, "arabic": "وَسَعِيرًا", "translit": "āًryِʿعَsَw", "root": "سعر"}], "hasIhya": false}, {"ayah": 5, "text": "إِنَّ ٱلْأَبْرَارَ يَشْرَبُونَ مِن كَأْسٍ كَانَ مِزَاجُهَا كَافُورًا ", "translation": "Indeed, the righteous will drink from a cup [of wine] whose mixture is of Kāfūr,[1]", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلْأَبْرَارَ", "translit": "َrāَrْbَaʾْlٱ", "root": "برر"}, {"id": 3, "arabic": "يَشْرَبُونَ", "translit": "َnwُbَrْhsَy", "root": "شرب"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "كَأْسٍ", "translit": "ٍsْaʾَk", "root": "كاس"}, {"id": 6, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 7, "arabic": "مِزَاجُهَا", "translit": "āَhُjgāَzِm", "root": "مزج"}, {"id": 8, "arabic": "كَافُورًا", "translit": "āًrwُfāَk", "root": "كفر"}], "hasIhya": false}, {"ayah": 6, "text": "عَيْنًا يَشْرَبُ بِهَا عِبَادُ ٱللَّهِ يُفَجِّرُونَهَا تَفْجِيرًا ", "translation": "A spring of which the [righteous] servants of Allāh will drink; they will make it gush forth in force [and abundance].", "words": [{"id": 1, "arabic": "عَيْنًا", "translit": "āًnْyَʿع", "root": "عين"}, {"id": 2, "arabic": "يَشْرَبُ", "translit": "ُbَrْhsَy", "root": "شرب"}, {"id": 3, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 4, "arabic": "عِبَادُ", "translit": "ُdāَbِʿع", "root": "عبد"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "يُفَجِّرُونَهَا", "translit": "āَhَnwُrِّjgَfُy", "root": "فجر"}, {"id": 7, "arabic": "تَفْجِيرًا", "translit": "āًryِjgْfَt", "root": "فجر"}], "hasIhya": false}, {"ayah": 7, "text": "يُوفُونَ بِٱلنَّذْرِ وَيَخَافُونَ يَوْمًا كَانَ شَرُّهُۥ مُسْتَطِيرًا ", "translation": "They [are those who] fulfill [their] vows and fear a Day whose evil will be widespread.", "words": [{"id": 1, "arabic": "يُوفُونَ", "translit": "َnwُfwُy", "root": "وفي"}, {"id": 2, "arabic": "بِٱلنَّذْرِ", "translit": "ِrْhdَّnlٱِb", "root": "نذر"}, {"id": 3, "arabic": "وَيَخَافُونَ", "translit": "َnwُfāَhkَyَw", "root": "خوف"}, {"id": 4, "arabic": "يَوْمًا", "translit": "āًmْwَy", "root": "يوم"}, {"id": 5, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 6, "arabic": "شَرُّهُۥ", "translit": "ۥُhُّrَhs", "root": "شرر"}, {"id": 7, "arabic": "مُسْتَطِيرًا", "translit": "āًryِṭَtْsُm", "root": "طير"}], "hasIhya": false}, {"ayah": 8, "text": "وَيُطْعِمُونَ ٱلطَّعَامَ عَلَىٰ حُبِّهِۦ مِسْكِينًا وَيَتِيمًا وَأَسِيرًا ", "translation": "And they give food in spite of love for it[1] to the needy, the orphan, and the captive,", "words": [{"id": 1, "arabic": "وَيُطْعِمُونَ", "translit": "َnwُmِʿعْṭُyَw", "root": "طعم"}, {"id": 2, "arabic": "ٱلطَّعَامَ", "translit": "َmāَʿعَّṭlٱ", "root": "طعم"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "حُبِّهِۦ", "translit": "ۦِhِّbُḥ", "root": "حبب"}, {"id": 5, "arabic": "مِسْكِينًا", "translit": "āًnyِkْsِm", "root": "سكن"}, {"id": 6, "arabic": "وَيَتِيمًا", "translit": "āًmyِtَyَw", "root": "يتم"}, {"id": 7, "arabic": "وَأَسِيرًا", "translit": "āًryِsَaʾَw", "root": "اسر"}], "hasIhya": true}, {"ayah": 9, "text": "إِنَّمَا نُطْعِمُكُمْ لِوَجْهِ ٱللَّهِ لَا نُرِيدُ مِنكُمْ جَزَآءً وَلَا شُكُورًا ", "translation": "[Saying], \"We feed you only for the face [i.e., approval] of Allāh. We wish not from you reward or gratitude.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "نُطْعِمُكُمْ", "translit": "ْmُkُmِʿعْṭُn", "root": "طعم"}, {"id": 3, "arabic": "لِوَجْهِ", "translit": "ِhْjgَwِl", "root": "وجه"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "نُرِيدُ", "translit": "ُdyِrُn", "root": "رود"}, {"id": 7, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 8, "arabic": "جَزَآءً", "translit": "ًءٓāَzَjg", "root": "جزي"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "شُكُورًا", "translit": "āًrwُkُhs", "root": "شكر"}], "hasIhya": true}, {"ayah": 10, "text": "إِنَّا نَخَافُ مِن رَّبِّنَا يَوْمًا عَبُوسًا قَمْطَرِيرًا ", "translation": "Indeed, We fear from our Lord a Day austere and distressful.\"", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 2, "arabic": "نَخَافُ", "translit": "ُfāَhkَn", "root": "خوف"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "رَّبِّنَا", "translit": "āَnِّbَّr", "root": "ربب"}, {"id": 5, "arabic": "يَوْمًا", "translit": "āًmْwَy", "root": "يوم"}, {"id": 6, "arabic": "عَبُوسًا", "translit": "āًswُbَʿع", "root": "عبس"}, {"id": 7, "arabic": "قَمْطَرِيرًا", "translit": "āًryِrَṭْmَq", "root": "قمطر"}], "hasIhya": false}, {"ayah": 11, "text": "فَوَقَىٰهُمُ ٱللَّهُ شَرَّ ذَٰلِكَ ٱلْيَوْمِ وَلَقَّىٰهُمْ نَضْرَةً وَسُرُورًا ", "translation": "So Allāh will protect them from the evil of that Day and give them radiance and happiness", "words": [{"id": 1, "arabic": "فَوَقَىٰهُمُ", "translit": "ُmُhٰàَqَwَf", "root": "وقي"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "شَرَّ", "translit": "َّrَhs", "root": "شرر"}, {"id": 4, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 5, "arabic": "ٱلْيَوْمِ", "translit": "ِmْwَyْlٱ", "root": "يوم"}, {"id": 6, "arabic": "وَلَقَّىٰهُمْ", "translit": "ْmُhٰàَّqَlَw", "root": "لقي"}, {"id": 7, "arabic": "نَضْرَةً", "translit": "ًẗَrْḍَn", "root": "نضر"}, {"id": 8, "arabic": "وَسُرُورًا", "translit": "āًrwُrُsَw", "root": "سرر"}], "hasIhya": false}, {"ayah": 12, "text": "وَجَزَىٰهُم بِمَا صَبَرُوا۟ جَنَّةً وَحَرِيرًا ", "translation": "And will reward them for what they patiently endured [with] a garden [in Paradise] and silk [garments].", "words": [{"id": 1, "arabic": "وَجَزَىٰهُم", "translit": "mُhٰàَzَjgَw", "root": "جزي"}, {"id": 2, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 3, "arabic": "صَبَرُوا۟", "translit": "۟āwُrَbَṣ", "root": "صبر"}, {"id": 4, "arabic": "جَنَّةً", "translit": "ًẗَّnَjg", "root": "جنن"}, {"id": 5, "arabic": "وَحَرِيرًا", "translit": "āًryِrَḥَw", "root": "حرر"}], "hasIhya": false}, {"ayah": 13, "text": "مُّتَّكِـِٔينَ فِيهَا عَلَى ٱلْأَرَآئِكِۖ لَا يَرَوْنَ فِيهَا شَمْسًا وَلَا زَمْهَرِيرًا ", "translation": "[They will be] reclining therein on adorned couches. They will not see therein any [burning] sun or [freezing] cold.", "words": [{"id": 1, "arabic": "مُّتَّكِـِٔينَ", "translit": "َnyِٔـِkَّtُّm", "root": "وكا"}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلْأَرَآئِكِ", "translit": "ِkِyʾٓāَrَaʾْlٱ", "root": "ارك"}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "يَرَوْنَ", "translit": "َnْwَrَy", "root": "راي"}, {"id": 7, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 8, "arabic": "شَمْسًا", "translit": "āًsْmَhs", "root": "شمس"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "زَمْهَرِيرًا", "translit": "āًryِrَhْmَz", "root": "زمهر"}], "hasIhya": false}, {"ayah": 14, "text": "وَدَانِيَةً عَلَيْهِمْ ظِلَٰلُهَا وَذُلِّلَتْ قُطُوفُهَا تَذْلِيلًا ", "translation": "And near above them are its shades, and its [fruit] to be picked will be lowered in compliance.", "words": [{"id": 1, "arabic": "وَدَانِيَةً", "translit": "ًẗَyِnāَdَw", "root": "دنو"}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "ظِلَٰلُهَا", "translit": "āَhُlَٰlِẓ", "root": "ظلل"}, {"id": 4, "arabic": "وَذُلِّلَتْ", "translit": "ْtَlِّlُhdَw", "root": "ذلل"}, {"id": 5, "arabic": "قُطُوفُهَا", "translit": "āَhُfwُṭُq", "root": "قطف"}, {"id": 6, "arabic": "تَذْلِيلًا", "translit": "āًlyِlْhdَt", "root": "ذلل"}], "hasIhya": false}, {"ayah": 15, "text": "وَيُطَافُ عَلَيْهِم بِـَٔانِيَةٍ مِّن فِضَّةٍ وَأَكْوَابٍ كَانَتْ قَوَارِيرَا۠ ", "translation": "And there will be circulated among them vessels of silver and cups having been [created] clear [as glass],", "words": [{"id": 1, "arabic": "وَيُطَافُ", "translit": "ُfāَṭُyَw", "root": "طوف"}, {"id": 2, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "بِـَٔانِيَةٍ", "translit": "ٍẗَyِnāَٔـِb", "root": "اني"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "فِضَّةٍ", "translit": "ٍẗَّḍِf", "root": "فضض"}, {"id": 6, "arabic": "وَأَكْوَابٍ", "translit": "ٍbāَwْkَaʾَw", "root": "كوب"}, {"id": 7, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 8, "arabic": "قَوَارِيرَا۠", "translit": "۠āَryِrāَwَq", "root": "قرر"}], "hasIhya": false}, {"ayah": 16, "text": "قَوَارِيرَا۟ مِن فِضَّةٍ قَدَّرُوهَا تَقْدِيرًا ", "translation": "Clear glasses [made] from silver of which they have determined the measure.", "words": [{"id": 1, "arabic": "قَوَارِيرَا۟", "translit": "۟āَryِrāَwَq", "root": "قرر"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "فِضَّةٍ", "translit": "ٍẗَّḍِf", "root": "فضض"}, {"id": 4, "arabic": "قَدَّرُوهَا", "translit": "āَhwُrَّdَq", "root": "قدر"}, {"id": 5, "arabic": "تَقْدِيرًا", "translit": "āًryِdْqَt", "root": "قدر"}], "hasIhya": false}, {"ayah": 17, "text": "وَيُسْقَوْنَ فِيهَا كَأْسًا كَانَ مِزَاجُهَا زَنجَبِيلًا ", "translation": "And they will be given to drink a cup [of wine] whose mixture is of ginger", "words": [{"id": 1, "arabic": "وَيُسْقَوْنَ", "translit": "َnْwَqْsُyَw", "root": "سقي"}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "كَأْسًا", "translit": "āًsْaʾَk", "root": "كاس"}, {"id": 4, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 5, "arabic": "مِزَاجُهَا", "translit": "āَhُjgāَzِm", "root": "مزج"}, {"id": 6, "arabic": "زَنجَبِيلًا", "translit": "āًlyِbَjgnَz", "root": ""}], "hasIhya": false}, {"ayah": 18, "text": "عَيْنًا فِيهَا تُسَمَّىٰ سَلْسَبِيلًا ", "translation": "[From] a fountain within it [i.e., Paradise] named Salsabeel.", "words": [{"id": 1, "arabic": "عَيْنًا", "translit": "āًnْyَʿع", "root": "عين"}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "تُسَمَّىٰ", "translit": "ٰàَّmَsُt", "root": "سمو"}, {"id": 4, "arabic": "سَلْسَبِيلًا", "translit": "āًlyِbَsْlَs", "root": ""}], "hasIhya": false}, {"ayah": 19, "text": "وَيَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ إِذَا رَأَيْتَهُمْ حَسِبْتَهُمْ لُؤْلُؤًا مَّنثُورًا ", "translation": "There will circulate among them young boys made eternal. When you see them, you would think them [as beautiful as] scattered pearls.", "words": [{"id": 1, "arabic": "وَيَطُوفُ", "translit": "ُfwُṭَyَw", "root": "طوف"}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "وِلْدَٰنٌ", "translit": "ٌnَٰdْlِw", "root": "ولد"}, {"id": 4, "arabic": "مُّخَلَّدُونَ", "translit": "َnwُdَّlَhkُّm", "root": "خلد"}, {"id": 5, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 6, "arabic": "رَأَيْتَهُمْ", "translit": "ْmُhَtْyَaʾَr", "root": "راي"}, {"id": 7, "arabic": "حَسِبْتَهُمْ", "translit": "ْmُhَtْbِsَḥ", "root": "حسب"}, {"id": 8, "arabic": "لُؤْلُؤًا", "translit": "āًwʾُlْwʾُl", "root": "لؤلؤ"}, {"id": 9, "arabic": "مَّنثُورًا", "translit": "āًrwُhtnَّm", "root": "نثر"}], "hasIhya": false}, {"ayah": 20, "text": "وَإِذَا رَأَيْتَ ثَمَّ رَأَيْتَ نَعِيمًا وَمُلْكًا كَبِيرًا ", "translation": "And when you look there [in Paradise], you will see pleasure and great dominion.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "رَأَيْتَ", "translit": "َtْyَaʾَr", "root": "راي"}, {"id": 3, "arabic": "ثَمَّ", "translit": "َّmَht", "root": ""}, {"id": 4, "arabic": "رَأَيْتَ", "translit": "َtْyَaʾَr", "root": "راي"}, {"id": 5, "arabic": "نَعِيمًا", "translit": "āًmyِʿعَn", "root": "نعم"}, {"id": 6, "arabic": "وَمُلْكًا", "translit": "āًkْlُmَw", "root": "ملك"}, {"id": 7, "arabic": "كَبِيرًا", "translit": "āًryِbَk", "root": "كبر"}], "hasIhya": false}, {"ayah": 21, "text": "عَٰلِيَهُمْ ثِيَابُ سُندُسٍ خُضْرٌ وَإِسْتَبْرَقٌۖ وَحُلُّوٓا۟ أَسَاوِرَ مِن فِضَّةٍ وَسَقَىٰهُمْ رَبُّهُمْ شَرَابًا طَهُورًا ", "translation": "Upon them [i.e., the inhabitants] will be green garments of fine silk and brocade. And they will be adorned with bracelets of silver, and their Lord will give them a purifying drink.", "words": [{"id": 1, "arabic": "عَٰلِيَهُمْ", "translit": "ْmُhَyِlَٰʿع", "root": "علو"}, {"id": 2, "arabic": "ثِيَابُ", "translit": "ُbāَyِht", "root": "ثوب"}, {"id": 3, "arabic": "سُندُسٍ", "translit": "ٍsُdnُs", "root": ""}, {"id": 4, "arabic": "خُضْرٌ", "translit": "ٌrْḍُhk", "root": "خضر"}, {"id": 5, "arabic": "وَإِسْتَبْرَقٌ", "translit": "ٌqَrْbَtْsِiʾَw", "root": ""}, {"id": 6, "arabic": "وَحُلُّوٓا۟", "translit": "۟āٓwُّlُḥَw", "root": "حلي"}, {"id": 7, "arabic": "أَسَاوِرَ", "translit": "َrِwāَsَaʾ", "root": "سور"}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "فِضَّةٍ", "translit": "ٍẗَّḍِf", "root": "فضض"}, {"id": 10, "arabic": "وَسَقَىٰهُمْ", "translit": "ْmُhٰàَqَsَw", "root": "سقي"}, {"id": 11, "arabic": "رَبُّهُمْ", "translit": "ْmُhُّbَr", "root": "ربب"}, {"id": 12, "arabic": "شَرَابًا", "translit": "āًbāَrَhs", "root": "شرب"}, {"id": 13, "arabic": "طَهُورًا", "translit": "āًrwُhَṭ", "root": "طهر"}], "hasIhya": false}, {"ayah": 22, "text": "إِنَّ هَٰذَا كَانَ لَكُمْ جَزَآءً وَكَانَ سَعْيُكُم مَّشْكُورًا ", "translation": "[And it will be said], \"Indeed, this is for you a reward, and your effort has been appreciated.\"", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 4, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 5, "arabic": "جَزَآءً", "translit": "ًءٓāَzَjg", "root": "جزي"}, {"id": 6, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 7, "arabic": "سَعْيُكُم", "translit": "mُkُyْʿعَs", "root": "سعي"}, {"id": 8, "arabic": "مَّشْكُورًا", "translit": "āًrwُkْhsَّm", "root": "شكر"}], "hasIhya": false}, {"ayah": 23, "text": "إِنَّا نَحْنُ نَزَّلْنَا عَلَيْكَ ٱلْقُرْءَانَ تَنزِيلًا ", "translation": "Indeed, it is We who have sent down to you, [O Muḥammad], the Qur’ān progressively.", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 2, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 3, "arabic": "نَزَّلْنَا", "translit": "āَnْlَّzَn", "root": "نزل"}, {"id": 4, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱلْقُرْءَانَ", "translit": "َnāَءْrُqْlٱ", "root": "قرا"}, {"id": 6, "arabic": "تَنزِيلًا", "translit": "āًlyِznَt", "root": "نزل"}], "hasIhya": false}, {"ayah": 24, "text": "فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تُطِعْ مِنْهُمْ ءَاثِمًا أَوْ كَفُورًا ", "translation": "So be patient for the decision of your Lord and do not obey from among them a sinner or ungrateful [disbeliever].", "words": [{"id": 1, "arabic": "فَٱصْبِرْ", "translit": "ْrِbْṣٱَf", "root": "صبر"}, {"id": 2, "arabic": "لِحُكْمِ", "translit": "ِmْkُḥِl", "root": "حكم"}, {"id": 3, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 5, "arabic": "تُطِعْ", "translit": "ْʿعِṭُt", "root": "طوع"}, {"id": 6, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 7, "arabic": "ءَاثِمًا", "translit": "āًmِhtāَء", "root": "اثم"}, {"id": 8, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 9, "arabic": "كَفُورًا", "translit": "āًrwُfَk", "root": "كفر"}], "hasIhya": false}, {"ayah": 25, "text": "وَٱذْكُرِ ٱسْمَ رَبِّكَ بُكْرَةً وَأَصِيلًا ", "translation": "And mention the name of your Lord [in prayer] morning and evening", "words": [{"id": 1, "arabic": "وَٱذْكُرِ", "translit": "ِrُkْhdٱَw", "root": "ذكر"}, {"id": 2, "arabic": "ٱسْمَ", "translit": "َmْsٱ", "root": "سمو"}, {"id": 3, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "بُكْرَةً", "translit": "ًẗَrْkُb", "root": "بكر"}, {"id": 5, "arabic": "وَأَصِيلًا", "translit": "āًlyِṣَaʾَw", "root": "اصل"}], "hasIhya": true}, {"ayah": 26, "text": "وَمِنَ ٱلَّيْلِ فَٱسْجُدْ لَهُۥ وَسَبِّحْهُ لَيْلًا طَوِيلًا ", "translation": "And during the night prostrate to Him and exalt [i.e., praise] Him a long [part of the] night.", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 2, "arabic": "ٱلَّيْلِ", "translit": "ِlْyَّlٱ", "root": "ليل"}, {"id": 3, "arabic": "فَٱسْجُدْ", "translit": "ْdُjgْsٱَf", "root": "سجد"}, {"id": 4, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 5, "arabic": "وَسَبِّحْهُ", "translit": "ُhْḥِّbَsَw", "root": "سبح"}, {"id": 6, "arabic": "لَيْلًا", "translit": "āًlْyَl", "root": "ليل"}, {"id": 7, "arabic": "طَوِيلًا", "translit": "āًlyِwَṭ", "root": "طول"}], "hasIhya": false}, {"ayah": 27, "text": "إِنَّ هَٰٓؤُلَآءِ يُحِبُّونَ ٱلْعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمْ يَوْمًا ثَقِيلًا ", "translation": "Indeed, these [disbelievers] love the immediate and leave behind them[1] a grave Day.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 3, "arabic": "يُحِبُّونَ", "translit": "َnwُّbِḥُy", "root": "حبب"}, {"id": 4, "arabic": "ٱلْعَاجِلَةَ", "translit": "َẗَlِjgāَʿعْlٱ", "root": "عجل"}, {"id": 5, "arabic": "وَيَذَرُونَ", "translit": "َnwُrَhdَyَw", "root": "وذر"}, {"id": 6, "arabic": "وَرَآءَهُمْ", "translit": "ْmُhَءٓāَrَw", "root": "وري"}, {"id": 7, "arabic": "يَوْمًا", "translit": "āًmْwَy", "root": "يوم"}, {"id": 8, "arabic": "ثَقِيلًا", "translit": "āًlyِqَht", "root": "ثقل"}], "hasIhya": true}, {"ayah": 28, "text": "نَّحْنُ خَلَقْنَٰهُمْ وَشَدَدْنَآ أَسْرَهُمْۖ وَإِذَا شِئْنَا بَدَّلْنَآ أَمْثَٰلَهُمْ تَبْدِيلًا ", "translation": "We have created them and strengthened their forms, and when We will, We can change their likenesses with [complete] alteration.", "words": [{"id": 1, "arabic": "نَّحْنُ", "translit": "ُnْḥَّn", "root": ""}, {"id": 2, "arabic": "خَلَقْنَٰهُمْ", "translit": "ْmُhَٰnْqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "وَشَدَدْنَآ", "translit": "ٓāَnْdَdَhsَw", "root": "شدد"}, {"id": 4, "arabic": "أَسْرَهُمْ", "translit": "ْmُhَrْsَaʾ", "root": "اسر"}, {"id": 5, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 6, "arabic": "شِئْنَا", "translit": "āَnْyʾِhs", "root": "شيا"}, {"id": 7, "arabic": "بَدَّلْنَآ", "translit": "ٓāَnْlَّdَb", "root": "بدل"}, {"id": 8, "arabic": "أَمْثَٰلَهُمْ", "translit": "ْmُhَlَٰhtْmَaʾ", "root": "مثل"}, {"id": 9, "arabic": "تَبْدِيلًا", "translit": "āًlyِdْbَt", "root": "بدل"}], "hasIhya": false}, {"ayah": 29, "text": "إِنَّ هَٰذِهِۦ تَذْكِرَةٌۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًا ", "translation": "Indeed, this is a reminder, so he who wills may take to his Lord a way.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "هَٰذِهِۦ", "translit": "ۦِhِhdَٰh", "root": ""}, {"id": 3, "arabic": "تَذْكِرَةٌ", "translit": "ٌẗَrِkْhdَt", "root": "ذكر"}, {"id": 4, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 5, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 6, "arabic": "ٱتَّخَذَ", "translit": "َhdَhkَّtٱ", "root": "اخذ"}, {"id": 7, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 8, "arabic": "رَبِّهِۦ", "translit": "ۦِhِّbَr", "root": "ربب"}, {"id": 9, "arabic": "سَبِيلًا", "translit": "āًlyِbَs", "root": "سبل"}], "hasIhya": false}, {"ayah": 30, "text": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمًا ", "translation": "And you do not will except that Allāh wills. Indeed, Allāh is ever Knowing and Wise.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "تَشَآءُونَ", "translit": "َnwُءٓāَhsَt", "root": "شيا"}, {"id": 3, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يَشَآءَ", "translit": "َءٓāَhsَy", "root": "شيا"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 10, "arabic": "عَلِيمًا", "translit": "āًmyِlَʿع", "root": "علم"}, {"id": 11, "arabic": "حَكِيمًا", "translit": "āًmyِkَḥ", "root": "حكم"}], "hasIhya": false}, {"ayah": 31, "text": "يُدْخِلُ مَن يَشَآءُ فِى رَحْمَتِهِۦۚ وَٱلظَّٰلِمِينَ أَعَدَّ لَهُمْ عَذَابًا أَلِيمًۢا ", "translation": "He admits whom He wills into His mercy; but the wrongdoers - He has prepared for them a painful punishment.", "words": [{"id": 1, "arabic": "يُدْخِلُ", "translit": "ُlِhkْdُy", "root": "دخل"}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "رَحْمَتِهِۦ", "translit": "ۦِhِtَmْḥَr", "root": "رحم"}, {"id": 6, "arabic": "وَٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱَw", "root": "ظلم"}, {"id": 7, "arabic": "أَعَدَّ", "translit": "َّdَʿعَaʾ", "root": "عدد"}, {"id": 8, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 9, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 10, "arabic": "أَلِيمًۢا", "translit": "āًۢmyِlَaʾ", "root": "الم"}], "hasIhya": false}], "tafsir": {"1": [{"arabic": "ثم انظر كيف رزقه القدرة والتمييز والعقل والهداية تدريجا حتى بلغ وتكامل فصار مراهقا ثم شابا ثم كهلا ثم شيخا إما كفورا أو شكورا مطيعا أو عاصيا مؤمنا أو كافرا تصديقا لقوله تعالى هل أتى على الإنسان حين من الدهر لم يكن شيئا مذكورا إنا خلقنا الإنسان من نطفة أمشاج نبتليه فجعلناه سميعا بصيرا إنا هديناه السبيل إما شاكرا وإما كفورا فانظر إلى اللطف والكرم ثم إلى القدرة والحكمة تبهرك عجائب الحضرة الربانية والعجب كل العجب ممن يرى خطا حسنا أو نقشا حسنا على حائط فيستحسنه فيصرف جميع همه إلى التفكر فى النقاش وال", "english": "Then look at how He (Allah) granted him (the human) capability, discernment, intellect (Aql), and guidance gradually until he reached and became complete, becoming an adolescent then a youth then middle-aged then an elder, either ungrateful (Kafir) or grateful (Shakir), obedient or disobedient, believing or disbelieving, confirming His (Allah's) saying, the Most High: 'Has there come upon the human a period of time when he was not a thing mentioned? Indeed, We created the human from a sperm-drop mixture to test him, and We made him hearing, seeing. Indeed, We guided him to the path, either grateful or ungrateful.' Then look at the gentleness (Lutf) and generosity (Karam), then at the power (Qudrah) and wisdom (Hikmah); the wonders of the Divine Presence (Al-Hadrah Al-Rabbaniyyah) will astonish you. And the wonder of all wonders is from one who sees beautiful calligraphy or a beautiful engraving on a wall and admires it, so he directs all his concern to pondering the engraver and calligrapher, and how he engraved it and wrote it and how he was capable of it, and he continues to magnify him in himself and says: 'How skillful he is, and how perfect his craftsmanship and how excellent his capability!' Then he looks at these wonders in himself and in others, then he neglects his Maker (Sani') and Fashioner (Musawwir), so His greatness does not amaze him, nor does His majesty (Jalal) and wisdom (Hikmah) perplex him. This is a sample of the wonders of your body which cannot be exhaustively enumerated; it is the closest field for your thought and the clearest witness to the greatness of your Creator, and you are heedless of that, preoccupied with your belly and private parts, and you know nothing of yourself except that you hunger so you eat and become full so you sleep, and you desire so you copulate, and you become angry so you fight, and all the beasts share with you in knowing that. Rather, the specific characteristic of the human that is veiled from the beasts is knowing Allah, the Most High, by contemplating the dominion (Mulk) of the heavens and the earth and the wonders of the horizons and the souls (Anfus), for through it the servant (Abd) enters into the company of the near angels (Al-Mala'ikah Al-Muqarrabin) and is resurrected in the company of the prophets (Al-Nabiyyin) and the truthful ones (Al-Siddiqin), brought near to the Presence (Hadrah) of the Lord of the worlds. And this station (Manzilah) is not for the beasts, nor for a human who is satisfied with the desires of the beasts from the world, for he is evil.", "book_file": "vol4_j4-k09.doc.txt", "book_title": "Contemplation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Contemplation'", "badge": "Insight"}], "2": [{"arabic": "ثم انظر كيف رزقه القدرة والتمييز والعقل والهداية تدريجا حتى بلغ وتكامل فصار مراهقا ثم شابا ثم كهلا ثم شيخا إما كفورا أو شكورا مطيعا أو عاصيا مؤمنا أو كافرا تصديقا لقوله تعالى هل أتى على الإنسان حين من الدهر لم يكن شيئا مذكورا إنا خلقنا الإنسان من نطفة أمشاج نبتليه فجعلناه سميعا بصيرا إنا هديناه السبيل إما شاكرا وإما كفورا فانظر إلى اللطف والكرم ثم إلى القدرة والحكمة تبهرك عجائب الحضرة الربانية", "english": "Then look how He provided him with capability, discernment, intellect, and guidance gradually until he reached maturity and became complete, turning into an adolescent, then a youth, then middle-aged, then an elder—either ungrateful or grateful, obedient or disobedient, believing or disbelieving—confirming His saying, the Most High: 'Has there come upon man a period of time when he was a thing unremembered? Indeed, We created man from a mixed drop (Nutfah Amshaj) to test him, so We made him hearing (Sami'an), seeing (Basiran). Indeed, We guided him to the path—either grateful or ungrateful.' So look at the gentleness and generosity, then at the capability and wisdom; the wonders of the Divine Presence (Al-Hadrah Al-Rabbaniyyah) will astonish you.", "book_file": "vol4_j4-k09.doc.txt", "book_title": "Contemplation", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Contemplation'", "badge": "General"}], "8": [{"arabic": "وقال مجاهد في قول الله عز وجل: ﴿ ويطعمون الطعام على حبه مسكينا ويتيما وأسيرا ﴾ فقال: وهم يشتهونه.", "english": "And Mujahid said regarding the saying of Allah the Exalted: 'And they give food, out of love for it, to the needy, the orphan, and the captive' (Quran 76:8), he said: 'And they desire it.'", "book_file": "vol1_Vol1-book-5.doc.txt", "book_title": "Mysteries of Zakat", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Mysteries of Zakat'", "badge": "General"}, {"arabic": "وقالوا: وأقبل يبكي ويقرأ \"ويطعمون الطعام على حبه مسكيناً ويتيماً وأسيرا\" ثم لم يذقه بعد ذلك.", "english": "And they said: And he began to cry and recite \"And they give food, despite their love for it, to the poor, the orphan, and the captive\" (Quran 76:8) then he did not taste it after that.", "book_file": "vol3_Vol3-book3a.doc.txt", "book_title": "Harms of the Tongue", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Harms of the Tongue'", "badge": "General"}], "9": [{"arabic": "أما الآيات: فقوله تعالى \"فويل للمصلين الذين هم عن صلاتهم ساهون الذين هم يراءون\" وقوله عز وجل \"والذين يمكرون السيئات لهم عذاب شديد ومكر أولئك هو يبور\" قال مجاهد هم أهل الرياء. وقال تعالى \"إنما نطعمكم لوجه الله لا نريد منكم جزاء ولا شكورا\" فمدح المخلصين ينفي كل إرادة سوى وجه الله، والرياء ضده وقال تعالى \"فمن كان يرجو لقاء ربه فليعمل صالحاً ولا يشرك بعبادة ربه أحدا\" نزل بعد ذلك فيمن يطلب الأجر والحمد بعباداته وأعماله.", "english": "As for the verses: His saying, the Exalted, \"Woe to those who pray, who are heedless of their prayer, who show off (yarā'ūn)\" and His saying, the Mighty and Majestic, \"And those who plot evil deeds, for them is a severe punishment, and the plotting of those, it will perish\" said Mujāhid: they are the people of showing off (riyā'). And He said, the Exalted, \"We only feed you for the Face (Wajh) of Allah; we desire no reward from you, nor thanks.\" So He praised the sincere ones (al-mukhliṣīn) by negating every desire (irādah) except the Face (Wajh) of Allah, and showing off (riyā') is its opposite. And He said, the Exalted, \"So whoever hopes for the meeting with his Lord, let him do righteous work and not associate in the worship of his Lord anyone.\" It was revealed after that concerning those who seek reward and praise with their acts of worship and deeds.", "book_file": "vol3_Vol3-book-8a.doc.txt", "book_title": "Condemnation of Status and Ostentation", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Condemnation of Status and Ostentation'", "badge": "Du'a"}], "25": [{"arabic": "وهو وقت شريف ويدل على شرفه وفضله إقسام الله تعالى به إذ قال: ﴿ والصبح إذا تنفس ﴾ {} وتمدحه به إذ قال: ﴿ فالق الإصباح ﴾ {} وقال تعالى: ﴿ قل أعوذ برب الفلق ﴾ {} وإظهاره القدرة بقبض الظل فيه إذ قال تعالى: ﴿ ثم قبضناه إلينا قبضا يسيرا ﴾ {} وهو وقت قبض ظل الليل ببسط نور الشمس وإرشاده الناس إلى التسبيح فيه بقوله تعالى: ﴿ فسبحان الله حين تمسون وحين تصبحون ﴾ {} وبقوله تعالى: ﴿ فسبح بحمد ربك قبل طلوع الشمس وقبل غروبها ﴾ {} وقوله عز وجل: ﴿ ومن آناء الليل فسبح وأطراف النهار لعلك ترضى ﴾ {} وقوله تعالى: ﴿ وا", "english": "And it is a noble time, and its nobility and virtue are indicated by Allah the Exalted swearing by it when He said: 'And by the dawn when it breathes' (Quran 81:18), and praising it when He said: 'The Cleaver of the daybreak' (Quran 6:96), and He the Exalted said: 'Say, \"I seek refuge in the Lord of daybreak\"' (Quran 113:1), and His manifestation of power in contracting the shadow therein when He the Exalted said: 'Then We drew it in towards Ourselves, a gradual drawing in' (Quran 25:46), and it is the time of contracting the shadow of the night by spreading the light of the sun, and His guiding people to glorification therein by His saying the Exalted: 'So exalt Allah when you reach the evening and when you reach the morning' (Quran 30:17), and by His saying the Exalted: 'So exalt [Allah] with praise of your Lord before the rising of the sun and before its setting' (Quran 50:39), and His saying the Mighty and Majestic: 'And [in part] of the night exalt Him and at the ends of the day, that you may be satisfied' (Quran 20:130), and His saying the Exalted: 'And remember the name (ism) of your Lord (rabbika) morning (bukratan) and evening (asilan)' (Quran 76:25). As for its arrangement, let him take from the time of his awakening from sleep, so when he awakens, he should begin with the remembrance (dhikr) of Allah the Exalted by saying: 'Praise be to Allah who gave us life after having caused us to die, and to Him is the resurrection,' to the end of the supplications and verses which we mentioned in the supplication of awakening from the Book of Supplications.", "book_file": "vol1_Vol1-book-10.doc.txt", "book_title": "Book of Knowledge", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Book of Knowledge'", "badge": "Dhikr"}, {"arabic": "فإن لم تكن من أهله فانظر إلى خطاب الله تعالى لرسوله واقتبسه بنور الإيمان فقد قال الله تعالى لأقرب عبادة إليه وارفعهم درجة لديه: ﴿ إن لك في النهار سبحا طويلا واذكر اسم ربك وتبتل إليه تبتيلا ﴾ {} وقال تعالى: ﴿ واذكر اسم ربك بكرة وأصيلا ومن الليل فاسجد له وسبحه ليلا طويلا ﴾ {}", "english": "If you are not from its people, then look at the address of Allah the Exalted to His Messenger and take it with the light of faith. Indeed, Allah the Exalted said to the closest of His worshippers to Him and the highest of them in degree with Him: 'Indeed, for you in the daytime is prolonged glorification, and remember the name of your Lord and devote yourself to Him with complete devotion.' And He the Exalted said: 'And remember the name of your Lord in the morning and in the evening, and during the night prostrate to Him and glorify Him a long night.'", "book_file": "vol1_Vol1-book-10.doc.txt", "book_title": "Book of Knowledge", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Book of Knowledge'", "badge": "Dhikr"}], "27": [{"arabic": "ولكن الملك ملكان ملك مشوب بأنواع آلالام وملحوق بسرعة الانصرام ولكنه عاجل وهو في الدنيا وملك مخلد دائم لا يشوبه كدر ولا آلم ولا يقطعه قاطع ولكنه آجل وقد خلق الانسان عجولا راغبا في العاجلة فجاء الشيطان وتوسل اليه بواسطة العجلة التي في طبعه فاستغواه بالعاجلة وزين له الحاضرة وتوسل اليه بواسطة الحمق فوعده بالغرور في الاخرة ومناه مع ملك الدنيا ملك الآخرة كما قال ﭬ: (والاحمق من اتبع نفسه هواها وتمنى على الله الأماني) فانخدع المخذول بغروره واشتغل بطلب عز الدنيا وملكها على قدر امكانه ولم يتدل الموفق بحبل", "english": "But the kingdom is two kingdoms: a kingdom mixed with various pains and accompanied by rapid disappearance, but it is immediate (al-ʿājila) and it is in this world; and an eternal, permanent kingdom that is not mixed with turbidity nor pain, nor is it cut off by any cutter, but it is deferred (al-ājila). And the human being was created hasty (ʿajūlan), desiring the immediate (al-ʿājila). So Satan came and approached him through the medium of haste that is in his nature, and he seduced him with the immediate (al-ʿājila) and adorned for him the present, and he approached him through the medium of foolishness (al-ḥamq) and promised him delusion in the Hereafter, and tempted him with the kingdom of the Hereafter along with the kingdom of this world, as He said: (And the foolish one is he who follows his soul's (Nafs) desires and wishes upon Allah vain hopes). So the deceived one was deluded by his deception and busied himself with seeking the glory and kingdom of this world to the extent of his capability. And the successful one did not cling to the rope of his deception, for he knew the entrances of his cunning, so he turned away from the immediate (al-ʿājila). Thus He expressed about the deceived ones with His saying, the Exalted: 'No! But you love the immediate (al-ʿājila) and leave the Hereafter.' And He said, the Exalted: 'Indeed, these love the immediate (al-ʿājila) and leave behind them a heavy day.' And He said, the Exalted: 'So turn away from him who turns away from Our Remembrance (Dhikr) and desires not except the life of this world. That is their extent of knowledge.' And when the cunning of Satan spread among all creation, Allah sent the angels to the messengers and they revealed to them what had befallen creation from the destruction of the enemy and his seduction. So they busied themselves with calling creation to the true kingdom over the metaphorical kingdom that has no foundation if it is safe, nor any permanence at all. So they called out to them: 'O you who have believed, what is [the matter] with you that, when it is said to you, \"Go forth in the way of Allah,\" you adhere heavily to the earth? Are you satisfied with the life of this world rather than the Hereafter? But what is the enjoyment of this world in the Hereafter except a little.'", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Patience and Gratitude'", "badge": "Ethics"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 852], [2, 852, 1947], [3, 1947, 2828], [4, 2828, 4318], [5, 4318, 5175], [6, 5175, 5996], [7, 5996, 7174], [8, 7174, 7650], [9, 7650, 8483], [10, 8483, 9578], [11, 9578, 11635]], "2": [[1, 400, 1684], [2, 1684, 3200], [3, 3200, 4731], [4, 4731, 5220], [5, 5220, 6657], [6, 6657, 8124], [7, 8124, 10105], [8, 10105, 11744], [9, 11744, 13309], [10, 13309, 14874]], "3": [[1, 400, 1643], [2, 1643, 3040], [3, 3040, 4632], [4, 4632, 5875], [5, 5875, 7390], [6, 7390, 8988], [7, 8988, 10434]], "4": [[1, 400, 2294], [2, 2294, 4052], [3, 4052, 6017], [4, 6017, 7569], [5, 7569, 9509], [6, 9509, 11426]], "5": [[1, 400, 1263], [2, 1263, 3000], [3, 3000, 4702], [4, 4702, 5175], [5, 5175, 5955], [6, 5955, 6806], [7, 6806, 8484], [8, 8484, 10303]], "6": [[1, 400, 1540], [2, 1540, 2551], [3, 2551, 3304], [4, 3304, 4336], [5, 4336, 5186], [6, 5186, 7391], [7, 7391, 8918]], "7": [[1, 400, 1810], [2, 1810, 3295], [3, 3295, 5290], [4, 5290, 6504], [5, 6504, 7285], [6, 7285, 8120], [7, 8120, 9963]], "8": [[1, 400, 2561], [2, 2561, 4270], [3, 4270, 5336], [4, 5336, 6205], [5, 6205, 7874], [6, 7874, 9751], [7, 9751, 11583]], "9": [[1, 400, 2045], [2, 2045, 3841], [3, 3841, 5065], [4, 5065, 6105], [5, 6105, 6789], [6, 6789, 7973], [7, 7973, 9026], [8, 9026, 10858], [9, 10858, 11937], [10, 11937, 13594]], "10": [[1, 400, 1632], [2, 1632, 2735], [3, 2735, 3204], [4, 3204, 4635], [5, 4635, 5949], [6, 5949, 7450], [7, 7450, 9467]], "11": [[1, 400, 2155], [2, 2155, 3022], [3, 3022, 3669], [4, 3669, 4494], [5, 4494, 5657], [6, 5657, 7610], [7, 7610, 8510], [8, 8510, 10198]], "12": [[1, 400, 2277], [2, 2277, 3143], [3, 3143, 4683], [4, 4683, 5706], [5, 5706, 7560]], "13": [[1, 400, 2198], [2, 2198, 3322], [3, 3322, 4154], [4, 4154, 6393], [5, 6393, 6977], [6, 6977, 8101], [7, 8101, 9225], [8, 9225, 10326], [9, 10326, 11248], [10, 11248, 13046]], "14": [[1, 400, 1992], [2, 1992, 3197], [3, 3197, 4574], [4, 4574, 5940], [5, 5940, 7553], [6, 7553, 9101]], "15": [[1, 400, 2179], [2, 2179, 3623], [3, 3623, 5222], [4, 5222, 6112], [5, 6112, 7163], [6, 7163, 9175], [7, 9175, 10361], [8, 10361, 12785]], "16": [[1, 400, 2538], [2, 2538, 2993], [3, 2993, 3920], [4, 3920, 5728], [5, 5728, 7456]], "17": [[1, 400, 2181], [2, 2181, 3323], [3, 3323, 4442], [4, 4442, 5264], [5, 5264, 6886], [6, 6886, 8736]], "18": [[1, 350, 1524], [2, 1524, 2632], [3, 2632, 4172], [4, 4172, 6010]], "19": [[1, 400, 1886], [2, 1886, 3110], [3, 3110, 4224], [4, 4224, 6147], [5, 6147, 6999], [6, 6999, 8441], [7, 8441, 9828], [8, 9828, 11183], [9, 11183, 13072]], "20": [[1, 400, 1641], [2, 1641, 2721], [3, 2721, 3537], [4, 3537, 4617], [5, 4617, 6064], [6, 6064, 7465], [7, 7465, 8866]], "21": [[1, 400, 2120], [2, 2120, 3536], [3, 3536, 4679], [4, 4679, 5605], [5, 5605, 7851], [6, 7851, 10532], [7, 10532, 12274], [8, 12274, 12818], [9, 12818, 13927], [10, 13927, 16132], [11, 16132, 17398], [12, 17398, 19140], [13, 19140, 20856]], "22": [[1, 400, 1358], [2, 1358, 2445], [3, 2445, 3390], [4, 3390, 4178], [5, 4178, 6005], [6, 6005, 7344], [7, 7344, 8867], [8, 8867