ا","translit":"āًrwُkْhsَّm","root":"شكر"}],"hasIhya":false},{"ayah":23,"text":"إِنَّا نَحْنُ نَزَّلْنَا عَلَيْكَ ٱلْقُرْءَانَ تَنزِيلًا ","translation":"Indeed, it is We who have sent down to you, [O Muḥammad], the Qur’ān progressively.","words":[{"id":1,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":2,"arabic":"نَحْنُ","translit":"ُnْḥَn","root":""},{"id":3,"arabic":"نَزَّلْنَا","translit":"āَnْlَّzَn","root":"نزل"},{"id":4,"arabic":"عَلَيْكَ","translit":"َkْyَlَʿع","root":""},{"id":5,"arabic":"ٱلْقُرْءَانَ","translit":"َnāَءْrُqْlٱ","root":"قرا"},{"id":6,"arabic":"تَنزِيلًا","translit":"āًlyِznَt","root":"نزل"}],"hasIhya":false},{"ayah":24,"text":"فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تُطِعْ مِنْهُمْ ءَاثِمًا أَوْ كَفُورًا ","translation":"So be patient for the decision of your Lord and do not obey from among them a sinner or ungrateful [disbeliever].","words":[{"id":1,"arabic":"فَٱصْبِرْ","translit":"ْrِbْṣٱَf","root":"صبر"},{"id":2,"arabic":"لِحُكْمِ","translit":"ِmْkُḥِl","root":"حكم"},{"id":3,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":4,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":5,"arabic":"تُطِعْ","translit":"ْʿعِṭُt","root":"طوع"},{"id":6,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":7,"arabic":"ءَاثِمًا","translit":"āًmِhtāَء","root":"اثم"},{"id":8,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":9,"arabic":"كَفُورًا","translit":"āًrwُfَk","root":"كفر"}],"hasIhya":false},{"ayah":25,"text":"وَٱذْكُرِ ٱسْمَ رَبِّكَ بُكْرَةً وَأَصِيلًا ","translation":"And mention the name of your Lord [in prayer] morning and evening","words":[{"id":1,"arabic":"وَٱذْكُرِ","translit":"ِrُkْhdٱَw","root":"ذكر"},{"id":2,"arabic":"ٱسْمَ","translit":"َmْsٱ","root":"سمو"},{"id":3,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":4,"arabic":"بُكْرَةً","translit":"ًẗَrْkُb","root":"بكر"},{"id":5,"arabic":"وَأَصِيلًا","translit":"āًlyِṣَaʾَw","root":"اصل"}],"hasIhya":true},{"ayah":26,"text":"وَمِنَ ٱلَّيْلِ فَٱسْجُدْ لَهُۥ وَسَبِّحْهُ لَيْلًا طَوِيلًا ","translation":"And during the night prostrate to Him and exalt [i.e., praise] Him a long [part of the] night.","words":[{"id":1,"arabic":"وَمِنَ","translit":"َnِmَw","root":""},{"id":2,"arabic":"ٱلَّيْلِ","translit":"ِlْyَّlٱ","root":"ليل"},{"id":3,"arabic":"فَٱسْجُدْ","translit":"ْdُjgْsٱَf","root":"سجد"},{"id":4,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":5,"arabic":"وَسَبِّحْهُ","translit":"ُhْḥِّbَsَw","root":"سبح"},{"id":6,"arabic":"لَيْلًا","translit":"āًlْyَl","root":"ليل"},{"id":7,"arabic":"طَوِيلًا","translit":"āًlyِwَṭ","root":"طول"}],"hasIhya":false},{"ayah":27,"text":"إِنَّ هَٰٓؤُلَآءِ يُحِبُّونَ ٱلْعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمْ يَوْمًا ثَقِيلًا ","translation":"Indeed, these [disbelievers] love the immediate and leave behind them[1] a grave Day.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"هَٰٓؤُلَآءِ","translit":"ِءٓāَlُwʾَٰٓh","root":""},{"id":3,"arabic":"يُحِبُّونَ","translit":"َnwُّbِḥُy","root":"حبب"},{"id":4,"arabic":"ٱلْعَاجِلَةَ","translit":"َẗَlِjgāَʿعْlٱ","root":"عجل"},{"id":5,"arabic":"وَيَذَرُونَ","translit":"َnwُrَhdَyَw","root":"وذر"},{"id":6,"arabic":"وَرَآءَهُمْ","translit":"ْmُhَءٓāَrَw","root":"وري"},{"id":7,"arabic":"يَوْمًا","translit":"āًmْwَy","root":"يوم"},{"id":8,"arabic":"ثَقِيلًا","translit":"āًlyِqَht","root":"ثقل"}],"hasIhya":true},{"ayah":28,"text":"نَّحْنُ خَلَقْنَٰهُمْ وَشَدَدْنَآ أَسْرَهُمْۖ وَإِذَا شِئْنَا بَدَّلْنَآ أَمْثَٰلَهُمْ تَبْدِيلًا ","translation":"We have created them and strengthened their forms, and when We will, We can change their likenesses with [complete] alteration.","words":[{"id":1,"arabic":"نَّحْنُ","translit":"ُnْḥَّn","root":""},{"id":2,"arabic":"خَلَقْنَٰهُمْ","translit":"ْmُhَٰnْqَlَhk","root":"خلق"},{"id":3,"arabic":"وَشَدَدْنَآ","translit":"ٓāَnْdَdَhsَw","root":"شدد"},{"id":4,"arabic":"أَسْرَهُمْ","translit":"ْmُhَrْsَaʾ","root":"اسر"},{"id":5,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":6,"arabic":"شِئْنَا","translit":"āَnْyʾِhs","root":"شيا"},{"id":7,"arabic":"بَدَّلْنَآ","translit":"ٓāَnْlَّdَb","root":"بدل"},{"id":8,"arabic":"أَمْثَٰلَهُمْ","translit":"ْmُhَlَٰhtْmَaʾ","root":"مثل"},{"id":9,"arabic":"تَبْدِيلًا","translit":"āًlyِdْbَt","root":"بدل"}],"hasIhya":false},{"ayah":29,"text":"إِنَّ هَٰذِهِۦ تَذْكِرَةٌۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًا ","translation":"Indeed, this is a reminder, so he who wills may take to his Lord a way.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"هَٰذِهِۦ","translit":"ۦِhِhdَٰh","root":""},{"id":3,"arabic":"تَذْكِرَةٌ","translit":"ٌẗَrِkْhdَt","root":"ذكر"},{"id":4,"arabic":"فَمَن","translit":"nَmَf","root":""},{"id":5,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":6,"arabic":"ٱتَّخَذَ","translit":"َhdَhkَّtٱ","root":"اخذ"},{"id":7,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":8,"arabic":"رَبِّهِۦ","translit":"ۦِhِّbَr","root":"ربب"},{"id":9,"arabic":"سَبِيلًا","translit":"āًlyِbَs","root":"سبل"}],"hasIhya":false},{"ayah":30,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمًا ","translation":"And you do not will except that Allāh wills. Indeed, Allāh is ever Knowing and Wise.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"تَشَآءُونَ","translit":"َnwُءٓāَhsَt","root":"شيا"},{"id":3,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":4,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":5,"arabic":"يَشَآءَ","translit":"َءٓāَhsَy","root":"شيا"},{"id":6,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":7,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":8,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":9,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":10,"arabic":"عَلِيمًا","translit":"āًmyِlَʿع","root":"علم"},{"id":11,"arabic":"حَكِيمًا","translit":"āًmyِkَḥ","root":"حكم"}],"hasIhya":false},{"ayah":31,"text":"يُدْخِلُ مَن يَشَآءُ فِى رَحْمَتِهِۦۚ وَٱلظَّٰلِمِينَ أَعَدَّ لَهُمْ عَذَابًا أَلِيمًۢا ","translation":"He admits whom He wills into His mercy; but the wrongdoers - He has prepared for them a painful punishment.","words":[{"id":1,"arabic":"يُدْخِلُ","translit":"ُlِhkْdُy","root":"دخل"},{"id":2,"arabic":"مَن","translit":"nَm","root":""},{"id":3,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"رَحْمَتِهِۦ","translit":"ۦِhِtَmْḥَr","root":"رحم"},{"id":6,"arabic":"وَٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱَw","root":"ظلم"},{"id":7,"arabic":"أَعَدَّ","translit":"َّdَʿعَaʾ","root":"عدد"},{"id":8,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":9,"arabic":"عَذَابًا","translit":"āًbāَhdَʿع","root":"عذب"},{"id":10,"arabic":"أَلِيمًۢا","translit":"āًۢmyِlَaʾ","root":"الم"}],"hasIhya":false}],"tafsir":{"1":[{"arabic":"مؤمنا أو كافرا تصديقا لقوله تعالى هل أتى على الإنسان حين من الدهر لم يكن شيئا مذكورا إنا خلقنا الإنسان من نطفة أمشاج نبتليه فجعلناه سميعا بصيرا إنا هديناه السبيل إما شاكرا وإما كفورا فانظر إلى اللطف والكرم ثم إلى القدرة والحكمة تبهرك عجائب الحضرة الربانية والعجب كل العجب ممن يرى خطا حسنا أو نقشا حسنا على حائط فيستحسنه فيصرف جميع همه إلى التفكر في النقاش والخطاط وأنه كيف نقشه وخطه وكيف اقتدر عليه ولا يزال يستعظمه في نفسه ويقول ما أحذقه وما أكمل صنعته وأحسن قدرته ثم ينظر إلى هذه العجائب في نفسه وفي غيره ثم يغفل عن صانعه ومصوره فلا تدهشه عظمته ولا يحيره جلاله وحكمته فهذه نبذة من عجائب بدنك الت","english":"And the wonder of all wonders is the one who sees a beautiful script or a beautiful engraving upon a wall and admires it, then devotes all his concern to reflecting upon the engraver and the calligrapher — how he engraved it and wrote it, and how he achieved mastery over it — and he continues to magnify it in himself, saying: \"How skillful he is! How perfect is his craft and how excellent his ability!\" Then he looks upon these very wonders in himself and in others, and then becomes heedless of their Maker and Fashioner — His greatness does not astound him, nor does His majesty and wisdom bewilder him. This, then, is a sample of the wonders of your body that cannot be fully enumerated — for it is the nearest field for your reflection and the clearest witness to the greatness of your Creator — while you are heedless of that, occupied with your belly and your genitals. You know nothing of yourself except that when you are hungry you eat, when you are full you sleep, when you desire you copulate, and when you are angry you fight. All the beasts share with you in the knowledge of that. Rather, the special property of the human being — which has veiled the beasts from it — is the knowledge of God, the Exalted, through reflection upon the dominion of the heavens and the earth and the wonders of the horizons and the souls. For by it the servant enters into the company of the angels brought near, and is gathered in the company of the Prophets and the Truthful Ones, brought near to the Presence of the Lord of the Worlds. And this station belongs not to the beasts, nor to any human who is content from this world with the lusts of beasts — for such a one is far worse than the beasts.","book_title":"Contemplation","section_title_ar":"Section 1272","section_title_en":"The Wonders of the Human Body as Proof of the Divine Artisan — A Section from the Revival of the Religious Sciences","section_index":1272,"anchors":"- Root: خلق (khalaqa)\n  * Lisan / Ayn: Core meaning is \"to measure, to proportion, to estimate rightly\" — the act of fashioning something according to a precise measure before its execution.\n  * Al-Raghib (Mufradat): In theological usage, it denotes \"originating something from nothing without a prior model\" (ibdāʿ), as in {«خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ»} — and also \"bringing forth something from another thing\" (ījād min shayʾ), as in the creation of man from a sperm-drop.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"the leather-worker measured the hide; the tailor measured the garment before cutting.\" Metaphorical (majāz): \"God created the creation: He brought it into existence upon a measure necessitated by wisdom.\"\n- Root: لطف (luṭf)\n  * Lisan / Ayn: Core meaning: \"subtlety, delicacy, refinement\" — that which is imperceptible to the senses due to its fineness.\n  * Al-Raghib (Mufradat): In Kalam, al-luṭf denotes the divine subtle kindness and gracious providence that disposes affairs toward benefit without coercion.\n  * Al-Zamakhshari (Asas): Literal: \"a subtle body.\" Metaphorical: \"God is Laṭīf with His servants\" — He who disposes their welfare through hidden, gentle means.\n- Root: نفس (nafs)\n  * Lisan / Ayn: Core meaning: \"the self, the soul, the vital principle.\"\n  * Al-Raghib (Mufradat): In the verse {«تَعْلَمُ مَا فِي نَفْسِي وَلَا أَعْلَمُ مَا فِي نَفْسِكَ»}, the \"self\" of God denotes His very Essence (dhāt) — the linguistic form of annexation implying distinction, but in meaning there is no duality.\n  * Al-Zamakhshari (Asas): Literal: \"a precious thing.\" Metaphorical: \"he poured out his soul\" i.e., his blood; \"a soul-afflicting eye\" i.e., the evil eye.\n- Root: هدي (hadā)\n  * Lisan / Ayn: Core meaning: \"to guide, to show the way, to lead gently to the goal.\"\n  * Al-Raghib (Mufradat): Guidance (hidāyah) is of two kinds: (1) the universal guidance of instinct and natural disposition granted to all creatures, and (2) the specific guidance of revelation and rational insight granted to humans — as in {«إِنَّا هَدَيْنَاهُ السَّبِيلَ إِمَّا شَاكِرًا وَإِمَّا كَفُورًا»}.\n  * Al-Zamakhshari (Asas): Literal: \"he guided the lost traveler to the road.\" Metaphorical: \"God guided the embryo to the breast\" — an instinctual, divinely-implanted direction without prior knowledge or deliberation.\n- Sibawayh Rule: باب التقديم والتأخير للتفخيم (Fronting and Delaying for Magnification) — When the object or circumstantial phrase is fronted before the subject, it serves to magnify the agent's action and to draw attention to the wonder of the deed itself, as in the periodic structure here where the divine acts are enumerated successively with fronted circumstantial clauses to evoke awe.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'","badge":"Insight"},{"arabic":"الإنسان فهو أنه لم يكن شيئا مذكورا وقد كان في حيز العدم دهورا بل لم يكن لعدمه أول وأي شيء أخس وأقل من المحو والعدم وقد كان كذلك في القدم ثم خلقه الله من أرذل الأشياء ثم من أقذرها إذ قد خلقه من تراب ثم من نطفة ثم من علقة ثم من مضغة ثم جعله عظما ثم كسا العظم لحما فقد كان هذا بداية وجوده حيث كان شيئا مذكورا فما صار شيئا مذكورا إلا وهو على أخس الأوصاف والنعوت إذ لم يخلق في ابتدائه كاملا بل خلقه جمادا ميتا لا يسمع ولا يبصر ولا يحس ولا يتحرك ولا ينطق ولا يبطش ولا يدرك ولا يعلم فبدأ بموته قبل حياته وبضعفه قبل قوته وبجهله قبل علمه وبعماه قبل بصره وبصممه قبل سمعه وببكمه قبل نطقه وبضلالته قبل هداه وبفقره قبل غناه وبعجزه قبل قدرته فهذا معنى قوله من أي شيء خلقه من نطفة خلقه فقدره ومعنى قوله هل أتى على الإنسان حين من الدهر لم يكن شيئا مذكورا إنا خلقنا الإنسان من نطفة أمشاج نبتليه كذلك خلقه أولا ثم امتن عليه فقال ثم السبيل يسره وهذا إشارة إلى ما تيسر له في مدة حياته إلى الموت وكذلك قال من نطفة أمشاج نبتليه فجعلناه سميعا بصيرا إنا هديناه السبيل وإما شاكرا أو كفورا ومعناه أنه أحياه بعد أن كان جمادا ميتا ترابا أولا ونطفة ثانيا وأسمعه بعد ما كان أصم وبصره بعد ما كان فاقدا للبصر وقواه بعد الضعف وعلمه بعد الجهل وخلق له الأعضاء بما فيها من العجائب والآيات بعد الفقد لها وأغناه بعد الفقر وأشبعه بعد الجوع وكساه بعد العري وهداه بعد الضلال فانظر كيف دبره وصوره وإلى السبيل كيف يسره وإلى طغيان الإنسان ما أكفره وإلى جهل الإنسان كيف أظهره فقال أو لم ير الإنسان أنا خلقناه من نطفة فإذا هو خصيم مبين {ومن آياته أن خلقكم من تراب ثم إذا أنتم بشر تنتشرون} فانظر إلى نعمة الله كيف نقله من تلك الذلة والقلة والخسة والقذا","english":"As for his knowledge of his Lord, His greatness, and His glory — the discourse thereon is lengthy, and it is the ultimate end of the science of unveiling (ʿilm al-mukāshafah). As for his knowledge of himself, that too is lengthy; but we shall mention therefrom that which benefits in arousing humility and lowliness. And it suffices him to understand the meaning of a single verse in the Book of God — for in the Qurʾān is the knowledge of the first and the last, for him whose inner sight has been opened. God, may He be exalted, has said: {«قُتِلَ الْإِنْسَانُ مَا أَكْفَرَهُ ۝ مِنْ أَيِّ شَيْءٍ خَلَقَهُ ۝ مِنْ نُطْفَةٍ خَلَقَهُ فَقَدَّرَهُ ۝ ثُمَّ السَّبِيلَ يَسَّرَهُ ۝ ثُمَّ أَمَاتَهُ فَأَقْبَرَهُ ۝ ثُمَّ إِذَا شَاءَ أَنْشَرَهُ»} [ʿAbasa: 17–22] — \"May man be killed! How ungrateful he is! From what thing did He create him? From a drop of fluid He created him and proportioned him. Then the path He made easy for him. Then He causes him to die and buries him. Then when He wills, He raises him.\" The verse has pointed to the first origin of man, to the last of his affair, and to his middle state. Let man, then, look upon that, in order to understand the meaning of this verse.","book_title":"Condemnation of Pride and Conceit","section_title_ar":"Section 863","section_title_en":"Exposition of the Character Traits of the Humble and the Sum Total of Wherein the Effect of Humility and Arrogance Appears — and the Exposition of the Method of Treating Arrogance and Acquiring Humility","section_index":863,"anchors":"- Root: تواضع (tawāḍuʿ)\n  * Lisan / Ayn: Root و-ض-ع: to place down, lower, set in a low position; al-tawāḍuʿ is self-lowering, the voluntary assumption of lowness.\n  * Al-Raghib (Mufradat): Al-waḍʿ is placing a thing in a station; tawāḍuʿ is the soul's self-abasement before truth and before the Creator, opposed to takabbur (self-elevation).\n  * Al-Zamakhshari (Asas): Haqīqah: physical lowering of position. Majāz: the soul's humility and abandonment of claims to eminence.\n- Root: كبر (kibr)\n  * Lisan / Ayn: Root ك-ب-ر: bigness, magnitude; al-kibriyāʾ is exclusive divine majesty; al-kibr (arrogance) is the creature's false claim to that majesty.\n  * Al-Raghib (Mufradat): Al-kibr is the soul's self-magnification, a claim to a station of greatness that belongs to God alone; it is the root of all disobedience.\n  * Al-Zamakhshari (Asas): Haqīqah: physical greatness. Majāz: the heart's disdain of others and refusal of truth — the blameworthy kibr.\n- Root: نطف (nuṭfah)\n  * Al-Raghib (Mufradat): Al-nuṭfah: pure water, used for the seminal fluid. {«ثُمَّ جَعَلْنَاهُ نُطْفَةً فِي قَرَارٍ مَكِينٍ»} [Al-Muʾminūn: 13].\n  * Al-Zamakhshari (Asas): Haqīqah: clear water, little or much. Majāz: \"laylah naṭūf\" — a night raining until morning.\n- Root: خلق (khalaqa)\n  * Al-Raghib (Mufradat): Al-khalq: measured estimation (taqdīr mustaqīm); used for bringing forth from nothing without model, and for producing a thing from another thing.\n  * Al-Zamakhshari (Asas): Haqīqah: the tailor's cutting cloth to measure. Majāz: God's origination of creatures upon a measure necessitated by wisdom.\n- Sibawayh Rule: Bāb al-ʿaṭf ʿalā al-ḍamīr al-marfūʿ al-muttaṣil (Coordination upon the connected nominative pronoun) — permissible when preceded by an explicit subject, as in \"خلقه من نطفة فقدره\" where the sequence of verbs coordinates without repetition of the pronoun, each verb governing its own object in ordered succession.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'","badge":"Insight"},{"arabic":"فهذا معنى قوله من أي شيء خلقه من نطفة خلقه فقدره ومعنى قوله هل أتى على الإنسان حين من الدهر لم يكن شيئا مذكورا إنا خلقنا الإنسان من نطفة أمشاج نبتليه كذلك خلقه أولا ثم امتن عليه فقال ثم السبيل يسره وهذا إشارة إلى ما تيسر له في مدة حياته إلى الموت وكذلك قال من نطفة أمشاج نبتليه فجعلناه سميعا بصيرا إنا هديناه السبيل وإما شاكرا أو كفورا ومعناه أنه أحياه بعد أن كان جمادا ميتا ترابا أولا ونطفة ثانيا وأسمعه بعد ما كان أصم وبصره بعد ما كان فاقدا للبصر وقواه بعد الضعف وعلمه بعد الجهل وخلق له الأعضاء بما فيها من العجائب والآيات بعد الفقد لها وأغناه بعد الفقر وأشبعه","english":"As for his knowledge of his Lord, His greatness, and His glory — the discourse thereon is lengthy, and it is the ultimate end of the science of unveiling (ʿilm al-mukāshafah). As for his knowledge of himself, that too is lengthy; but we shall mention therefrom that which benefits in arousing humility and lowliness. And it suffices him to understand the meaning of a single verse in the Book of God — for in the Qurʾān is the knowledge of the first and the last, for him whose inner sight has been opened. God, may He be exalted, has said: {«قُتِلَ الْإِنْسَانُ مَا أَكْفَرَهُ ۝ مِنْ أَيِّ شَيْءٍ خَلَقَهُ ۝ مِنْ نُطْفَةٍ خَلَقَهُ فَقَدَّرَهُ ۝ ثُمَّ السَّبِيلَ يَسَّرَهُ ۝ ثُمَّ أَمَاتَهُ فَأَقْبَرَهُ ۝ ثُمَّ إِذَا شَاءَ أَنْشَرَهُ»} [ʿAbasa: 17–22] — \"May man be killed! How ungrateful he is! From what thing did He create him? From a drop of fluid He created him and proportioned him. Then the path He made easy for him. Then He causes him to die and buries him. Then when He wills, He raises him.\" The verse has pointed to the first origin of man, to the last of his affair, and to his middle state. Let man, then, look upon that, in order to understand the meaning of this verse.","book_title":"Condemnation of Pride and Conceit","section_title_ar":"Section 863","section_title_en":"Exposition of the Character Traits of the Humble and the Sum Total of Wherein the Effect of Humility and Arrogance Appears — and the Exposition of the Method of Treating Arrogance and Acquiring Humility","section_index":863,"anchors":"- Root: تواضع (tawāḍuʿ)\n  * Lisan / Ayn: Root و-ض-ع: to place down, lower, set in a low position; al-tawāḍuʿ is self-lowering, the voluntary assumption of lowness.\n  * Al-Raghib (Mufradat): Al-waḍʿ is placing a thing in a station; tawāḍuʿ is the soul's self-abasement before truth and before the Creator, opposed to takabbur (self-elevation).\n  * Al-Zamakhshari (Asas): Haqīqah: physical lowering of position. Majāz: the soul's humility and abandonment of claims to eminence.\n- Root: كبر (kibr)\n  * Lisan / Ayn: Root ك-ب-ر: bigness, magnitude; al-kibriyāʾ is exclusive divine majesty; al-kibr (arrogance) is the creature's false claim to that majesty.\n  * Al-Raghib (Mufradat): Al-kibr is the soul's self-magnification, a claim to a station of greatness that belongs to God alone; it is the root of all disobedience.\n  * Al-Zamakhshari (Asas): Haqīqah: physical greatness. Majāz: the heart's disdain of others and refusal of truth — the blameworthy kibr.\n- Root: نطف (nuṭfah)\n  * Al-Raghib (Mufradat): Al-nuṭfah: pure water, used for the seminal fluid. {«ثُمَّ جَعَلْنَاهُ نُطْفَةً فِي قَرَارٍ مَكِينٍ»} [Al-Muʾminūn: 13].\n  * Al-Zamakhshari (Asas): Haqīqah: clear water, little or much. Majāz: \"laylah naṭūf\" — a night raining until morning.\n- Root: خلق (khalaqa)\n  * Al-Raghib (Mufradat): Al-khalq: measured estimation (taqdīr mustaqīm); used for bringing forth from nothing without model, and for producing a thing from another thing.\n  * Al-Zamakhshari (Asas): Haqīqah: the tailor's cutting cloth to measure. Majāz: God's origination of creatures upon a measure necessitated by wisdom.\n- Sibawayh Rule: Bāb al-ʿaṭf ʿalā al-ḍamīr al-marfūʿ al-muttaṣil (Coordination upon the connected nominative pronoun) — permissible when preceded by an explicit subject, as in \"خلقه من نطفة فقدره\" where the sequence of verbs coordinates without repetition of the pronoun, each verb governing its own object in ordered succession.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'","badge":"Insight"}],"2":[{"arabic":"الإنسان حين من الدهر لم يكن شيئا مذكورا إنا خلقنا الإنسان من نطفة أمشاج نبتليه كذلك خلقه أولا ثم امتن عليه فقال ثم السبيل يسره وهذا إشارة إلى ما تيسر له في مدة حياته إلى الموت وكذلك قال من نطفة أمشاج نبتليه فجعلناه سميعا بصيرا إنا هديناه السبيل وإما شاكرا أو كفورا ومعناه أنه أحياه بعد أن كان جمادا ميتا ترابا أولا ونطفة ثانيا وأسمعه بعد ما كان أصم وبصره بعد ما كان فاقدا للبصر وقواه بعد الضعف وعلمه بعد الجهل وخلق له الأعضاء بما فيها من العجائب والآيات بعد الفقد لها وأغناه بعد الفقر وأشبعه بعد الجوع وكساه بعد العري وهداه بعد الضلال فانظر كيف دبره وصوره وإلى السبيل كيف يسره وإلى طغيان الإنسان ما أكفره وإلى جهل الإنسان كيف أظهره فقال أو لم ير الإنسان أنا خلقناه من نطفة فإذا هو خصيم مبين {ومن آياته أن خلقكم من تراب ثم إذا أنتم بشر تنتشرون} فانظر إلى نعمة الله كيف نقله من تلك الذلة والقلة والخسة والقذارة إلى هذه الرفعة والكرامة فصار موجودا بعد العدم وحيا بعد الموت وناطقا بعد البكم وبصيرا بعد العمى وقويا بعد الضعف وعالما بعد الجهل ومهديا بعد","english":"As for his knowledge of his Lord, His greatness, and His glory — the discourse thereon is lengthy, and it is the ultimate end of the science of unveiling (ʿilm al-mukāshafah). As for his knowledge of himself, that too is lengthy; but we shall mention therefrom that which benefits in arousing humility and lowliness. And it suffices him to understand the meaning of a single verse in the Book of God — for in the Qurʾān is the knowledge of the first and the last, for him whose inner sight has been opened. God, may He be exalted, has said: {«قُتِلَ الْإِنْسَانُ مَا أَكْفَرَهُ ۝ مِنْ أَيِّ شَيْءٍ خَلَقَهُ ۝ مِنْ نُطْفَةٍ خَلَقَهُ فَقَدَّرَهُ ۝ ثُمَّ السَّبِيلَ يَسَّرَهُ ۝ ثُمَّ أَمَاتَهُ فَأَقْبَرَهُ ۝ ثُمَّ إِذَا شَاءَ أَنْشَرَهُ»} [ʿAbasa: 17–22] — \"May man be killed! How ungrateful he is! From what thing did He create him? From a drop of fluid He created him and proportioned him. Then the path He made easy for him. Then He causes him to die and buries him. Then when He wills, He raises him.\" The verse has pointed to the first origin of man, to the last of his affair, and to his middle state. Let man, then, look upon that, in order to understand the meaning of this verse.","book_title":"Contemplation","section_title_ar":"Section 863","section_title_en":"Exposition of the Character Traits of the Humble and the Sum Total of Wherein the Effect of Humility and Arrogance Appears — and the Exposition of the Method of Treating Arrogance and Acquiring Humility","section_index":863,"anchors":"- Root: تواضع (tawāḍuʿ)\n  * Lisan / Ayn: Root و-ض-ع: to place down, lower, set in a low position; al-tawāḍuʿ is self-lowering, the voluntary assumption of lowness.\n  * Al-Raghib (Mufradat): Al-waḍʿ is placing a thing in a station; tawāḍuʿ is the soul's self-abasement before truth and before the Creator, opposed to takabbur (self-elevation).\n  * Al-Zamakhshari (Asas): Haqīqah: physical lowering of position. Majāz: the soul's humility and abandonment of claims to eminence.\n- Root: كبر (kibr)\n  * Lisan / Ayn: Root ك-ب-ر: bigness, magnitude; al-kibriyāʾ is exclusive divine majesty; al-kibr (arrogance) is the creature's false claim to that majesty.\n  * Al-Raghib (Mufradat): Al-kibr is the soul's self-magnification, a claim to a station of greatness that belongs to God alone; it is the root of all disobedience.\n  * Al-Zamakhshari (Asas): Haqīqah: physical greatness. Majāz: the heart's disdain of others and refusal of truth — the blameworthy kibr.\n- Root: نطف (nuṭfah)\n  * Al-Raghib (Mufradat): Al-nuṭfah: pure water, used for the seminal fluid. {«ثُمَّ جَعَلْنَاهُ نُطْفَةً فِي قَرَارٍ مَكِينٍ»} [Al-Muʾminūn: 13].\n  * Al-Zamakhshari (Asas): Haqīqah: clear water, little or much. Majāz: \"laylah naṭūf\" — a night raining until morning.\n- Root: خلق (khalaqa)\n  * Al-Raghib (Mufradat): Al-khalq: measured estimation (taqdīr mustaqīm); used for bringing forth from nothing without model, and for producing a thing from another thing.\n  * Al-Zamakhshari (Asas): Haqīqah: the tailor's cutting cloth to measure. Majāz: God's origination of creatures upon a measure necessitated by wisdom.\n- Sibawayh Rule: Bāb al-ʿaṭf ʿalā al-ḍamīr al-marfūʿ al-muttaṣil (Coordination upon the connected nominative pronoun) — permissible when preceded by an explicit subject, as in \"خلقه من نطفة فقدره\" where the sequence of verbs coordinates without repetition of the pronoun, each verb governing its own object in ordered succession.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'","badge":"Insight"},{"arabic":"تيسر له في مدة حياته إلى الموت وكذلك قال من نطفة أمشاج نبتليه فجعلناه سميعا بصيرا إنا هديناه السبيل وإما شاكرا أو كفورا ومعناه أنه أحياه بعد أن كان جمادا ميتا ترابا أولا ونطفة ثانيا وأسمعه بعد ما كان أصم وبصره بعد ما كان فاقدا للبصر وقواه بعد الضعف وعلمه بعد الجهل وخلق له الأعضاء بما فيها من العجائب والآيات بعد الفقد لها وأغناه بعد الفقر وأشبعه بعد الجوع وكساه بعد العري وهداه بعد الضلال فانظر كيف دبره وصوره وإلى السبيل كيف يسره وإلى طغيان الإنسان ما أكفره وإلى جهل الإنسان كيف أظهره فقال أو لم ير الإنسان أنا خلقناه من نطفة فإ","english":"As for his knowledge of his Lord, His greatness, and His glory — the discourse thereon is lengthy, and it is the ultimate end of the science of unveiling (ʿilm al-mukāshafah). As for his knowledge of himself, that too is lengthy; but we shall mention therefrom that which benefits in arousing humility and lowliness. And it suffices him to understand the meaning of a single verse in the Book of God — for in the Qurʾān is the knowledge of the first and the last, for him whose inner sight has been opened. God, may He be exalted, has said: {«قُتِلَ الْإِنْسَانُ مَا أَكْفَرَهُ ۝ مِنْ أَيِّ شَيْءٍ خَلَقَهُ ۝ مِنْ نُطْفَةٍ خَلَقَهُ فَقَدَّرَهُ ۝ ثُمَّ السَّبِيلَ يَسَّرَهُ ۝ ثُمَّ أَمَاتَهُ فَأَقْبَرَهُ ۝ ثُمَّ إِذَا شَاءَ أَنْشَرَهُ»} [ʿAbasa: 17–22] — \"May man be killed! How ungrateful he is! From what thing did He create him? From a drop of fluid He created him and proportioned him. Then the path He made easy for him. Then He causes him to die and buries him. Then when He wills, He raises him.\" The verse has pointed to the first origin of man, to the last of his affair, and to his middle state. Let man, then, look upon that, in order to understand the meaning of this verse.","book_title":"Condemnation of Pride and Conceit","section_title_ar":"Section 863","section_title_en":"Exposition of the Character Traits of the Humble and the Sum Total of Wherein the Effect of Humility and Arrogance Appears — and the Exposition of the Method of Treating Arrogance and Acquiring Humility","section_index":863,"anchors":"- Root: تواضع (tawāḍuʿ)\n  * Lisan / Ayn: Root و-ض-ع: to place down, lower, set in a low position; al-tawāḍuʿ is self-lowering, the voluntary assumption of lowness.\n  * Al-Raghib (Mufradat): Al-waḍʿ is placing a thing in a station; tawāḍuʿ is the soul's self-abasement before truth and before the Creator, opposed to takabbur (self-elevation).\n  * Al-Zamakhshari (Asas): Haqīqah: physical lowering of position. Majāz: the soul's humility and abandonment of claims to eminence.\n- Root: كبر (kibr)\n  * Lisan / Ayn: Root ك-ب-ر: bigness, magnitude; al-kibriyāʾ is exclusive divine majesty; al-kibr (arrogance) is the creature's false claim to that majesty.\n  * Al-Raghib (Mufradat): Al-kibr is the soul's self-magnification, a claim to a station of greatness that belongs to God alone; it is the root of all disobedience.\n  * Al-Zamakhshari (Asas): Haqīqah: physical greatness. Majāz: the heart's disdain of others and refusal of truth — the blameworthy kibr.\n- Root: نطف (nuṭfah)\n  * Al-Raghib (Mufradat): Al-nuṭfah: pure water, used for the seminal fluid. {«ثُمَّ جَعَلْنَاهُ نُطْفَةً فِي قَرَارٍ مَكِينٍ»} [Al-Muʾminūn: 13].\n  * Al-Zamakhshari (Asas): Haqīqah: clear water, little or much. Majāz: \"laylah naṭūf\" — a night raining until morning.\n- Root: خلق (khalaqa)\n  * Al-Raghib (Mufradat): Al-khalq: measured estimation (taqdīr mustaqīm); used for bringing forth from nothing without model, and for producing a thing from another thing.\n  * Al-Zamakhshari (Asas): Haqīqah: the tailor's cutting cloth to measure. Majāz: God's origination of creatures upon a measure necessitated by wisdom.\n- Sibawayh Rule: Bāb al-ʿaṭf ʿalā al-ḍamīr al-marfūʿ al-muttaṣil (Coordination upon the connected nominative pronoun) — permissible when preceded by an explicit subject, as in \"خلقه من نطفة فقدره\" where the sequence of verbs coordinates without repetition of the pronoun, each verb governing its own object in ordered succession.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'","badge":"Insight"}],"8":[{"arabic":"وإن درعها لمرقع وقال مجاهد في قول الله عز وجل ويطعمون الطعام على حبه مسكينا ويتيما وأسيرا فقال وهم يشتهونه وكان عمر رضي الله عنه يقول اللهم اجعل الفضل عند خيارنا لعلهم يعودون به على ذوي الحاجة منا وقال عمر عبد العزيز الصلاة تبلغك نصف الطريق والصوم يبلغك باب الملك والصدقة تدخلك عليه وقال ابن أبي الجعد إن الصدقة لتدفع سبعين بابا من السوء وفضل سرها على علانيتها بسبعين ضعفا وإنها لتفك لحيى سبعين شيطانا وقال ابن مسعود إن رجلا عبد الله سبعين سنة ثم أصاب فاحشة فأحبط عمله ثم مر بمسكين فتصدق عليه برغيف فغفر الله له ذنبه ورد عليه","english":"Among the reports [concerning charity], his saying (peace and blessings be upon him): \"Give charity, even if with a single date-fruit, for it stays the hunger of the hungry and extinguishes sin just as water extinguishes fire.\" (1) And he said (peace and blessings be upon him): \"Guard yourselves against the Fire, even if with half a date-fruit; and if you find not even that, then with a kind word.\" (2) And he said (peace and blessings be upon him): \"There is no Muslim servant who gives charity from lawful earnings — and God accepts only what is lawful — but that God takes it in His Right Hand and nurtures it just as one of you nurtures his foal, until the single date-fruit grows to be like Mount Uḥud.\" (3) And he said (peace and blessings be upon him) to Abū al-Dardāʾ: \"When you cook a broth, increase its water, then look to a household among your neighbors and bestow upon them from it with kindness.\" (4) And he said (peace and blessings be upon him): \"No servant does well in charity but that God (mighty and majestic) does well for him in the stewardship of what he leaves behind.\" (5) And he said (peace and blessings be upon him): \"Every person is in the shade of his charity until judgment is rendered between the people.\" (6) And he said (peace and blessings be upon him): \"Charity closes seventy doors of evil.\" (7) And he said (peace and blessings be upon him): \"Secret charity extinguishes the wrath of the Lord (mighty and majestic).\" And the Messenger of God (peace and blessings be upon him) said: \"The one who gives from abundance is not more excellent in reward than the one who accepts from need.\" (8) Perhaps what is meant thereby is the one who intends, by the repelling of his need, to free himself for religion — so that he becomes equal to the giver who intends, by his giving, the flourishing of his religion.","book_title":"Mysteries of Zakat","section_title_ar":"Section 181","section_title_en":"The Book of the Etiquettes of Eating — Section on the Merits of Charity (Ṣadaqah) and Its Etiquettes","section_index":181,"anchors":"- Root: صدق (ṣ-d-q)\n  * Lisan / Ayn: Core meaning of truthfulness, veracity in speech and action; al-Raghib notes its origin is in speech (al-qawl), whether past or future, promise or otherwise.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول\" — truth and falsehood originate in utterance; charity (ṣadaqah) is so named because it is the truthful verification of one's faith through material sacrifice.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صدقته الحديث\" — to affirm someone's statement as true. Metaphorical (majāz): \"رجل صادق الحملة\" — a man truthful in his charge (i.e., steadfast in battle). Charity is thus the \"truthing\" of one's claim to faith by action.\n- Root: عله (ʿ-l-h) — [Note: This root appears in the scholia but is not directly relevant to the present text; the governing root for \"feeding\" is أ-ك-ل and for \"giving\" is ع-ط-ي]\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"الوجل: استشعار الخوف\" — the sensing of fear within oneself.\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف. يقال: وجل يوجل وجلا، فهو وجل. قال تعالى: {«إِنَّمَا الْمُؤْمِنُونَ الَّذِينَ إِذَا ذُكِرَ اللَّهُ وَجِلَتْ قُلُوبُهُمْ»}\" — the believers are those whose hearts tremble when God is mentioned.\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a people fearful. The root conveys the inner trepidation of the heart before divine majesty.\n- Root: سبع (s-b-ʿ)\n  * Al-Raghib (Mufradat): \"أصل السبع العدد\" — the root origin is the number seven; used for the seven heavens, seven earths, and in the present context, the seventy (seventy being a multiple of seven) doors of evil.\n  * Al-Zamakhshari (Asas): Literal: \"هو سابع سبعة\" — he is the seventh of seven. Metaphorical (majāz): \"أخذه أخذ سبعة\" — \"he seized with the seizure of seven,\" a proverb for intense, overwhelming force. The number seventy thus signifies multiplicity and completeness in repelling evil.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle \"innamā\" (إنما) restricts and confines the predicate to the subject alone, negating it for all others. This is crucial in the ḥadīth: \"إنما هي أوساخ الناس\" — charity is exclusively the filth of people, restricted to them and forbidden for the Prophet's family.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Zakat'","badge":"Du'a"}],"9":[{"arabic":"وقال تعالى إنما نطعمكم لوجه الله لا نريد منكم جزاء ولا شكورا فمدح المخلصين ينفي كل إرادة سوى وجه الله والرياء ضده وقال تعالى فمن كان يرجو لقاء ربه فليعمل عملا صالحا ولا يشرك بعبادة ربه أحدا // حديث نزول قوله تعالى فمن كان يرجو لقاء ربه الآية فيمن يطلب الآخرة بعباداته وأعماله أخرجه الحاكم من حديث طاوس قال رجل إني أقف الموقف أبتغي وجه الله وأحب أن يرى موطني فلم يرد عليه حتى نزلت هذه الآية هكذا في نسختي من المستدرك ولعله سقط منه ابن عباس أو أبو هريرة وللبزار من حديث معاذ بسند ضعيف من صام رياء فقد أشرك","english":"As for the verses: it is His saying, Exalted is He: {فويل للمصلين الذين هم عن صلاتهم ساهون الذين هم يراءون} — \"So woe to those who pray, those who are heedless of their prayer, those who make a show\" {Al-Ma'un 107:4-6}. And His saying, Mighty and Majestic is He: {والذين يمكرون السيئات لهم عذاب شديد ومكر أولئك هو يبور} — \"And those who scheme evil deeds — for them is a severe punishment, and the scheming of those — it shall perish\" {Fatir 35:10}. Mujāhid said: \"They are the people of riyā'.\"","book_title":"Condemnation of Status and Ostentation","section_title_ar":"Section 810","section_title_en":"The Second Half of the Book on Seeking Status and Rank through Acts of Worship — Being on Riya' (Ostentation/Show), Its Blameworthiness, and Its Treatment","section_index":810,"anchors":"- Root: راءى (rā'ā)\n  * Lisan / Ayn: Core root is الرؤية (vision/sight); المراءاة is showing oneself to another, derived from mutual seeing (تفاعل) — the act of displaying one's deeds for another's observation.\n  * Al-Raghib (Mufradat): الرياء is the seeking of rank (الجاه) and station (المنزلة) in the hearts of men through displaying acts of obedience — it is the antithesis of الإخلاص (sincerity), which restricts intention solely to the Divine Face (وجه الله).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): mutual visual perception. Metaphorical (Majaz): the spiritual \"seeing\" of one's deeds by creatures, seeking their approbation — a transfer from physical sight to the heart's craving for social esteem.\n- Root: سها (sahā)\n  * Lisan / Ayn: Neglect, heedlessness, inattention; the one who is \"sāhin\" is oblivious to the essence and time of an act.\n  * Al-Raghib (Mufradat): السهو is the heart's vacancy from awareness of the true import of an affair; in the verse {الذين هم عن صلاتهم ساهون} it denotes neglect of the prayer's time and conditions, coupled with ostentation in performing it.\n  * Al-Zamakhshari (Asas): Literal: distraction. Metaphorical: the soul's diversion from the Hereafter toward the gaze of creatures.\n- Root: مكر (makara)\n  * Lisan / Ayn: Crafty scheming, deception; the \"makr\" of the ostentatious is their covert corruption of good deeds.\n  * Al-Raghib (Mufradat): المكر is the turning of another from his intent by subtle concealment; the \"sayyi'āt\" (evil deeds) of the riyā' practitioners are their acts of worship corrupted by show — their scheming \"yabūr\" (perishes) because it is built on other than God.\n  * Al-Zamakhshari (Asas): Literal: stratagem. Metaphorical: the hypocritical display of piety as a ruse to capture hearts — a \"makr\" that boomerangs to perdition.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — In {إنما نطعمكم لوجه الله}, the particle إنما confines the motive exclusively to God's Face, negating all secondary aims (جزاء or شكورا); this is the grammatical seal of ikhlāṣ against riyā'.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Status and Ostentation'","badge":"Hadith"}],"25":[{"arabic":"النهار سبحا طويلا واذكر اسم ربك وتبتل إليه تبتيلا} وقال تعالى {واذكر اسم ربك بكرة وأصيلا ومن الليل فاسجد له وسبحه ليلا طويلا} وقال تعالى {وسبح بحمد ربك قبل طلوع الشمس وقبل الغروب ومن الليل فسبحه وأدبار السجود} وقال سبحانه {وسبح بحمد ربك حين تقوم ومن الليل فسبحه وإدبار النجوم} وقال تعالى {إن ناشئة الليل هي أشد وطأ وأقوم قيلا} وقال تعالى {ومن آناء الليل فسبح وأطراف النهار لعلك ترضى} وقال عز وجل {وأقم الصلاة طرفي النهار وزلفا من الليل أن الحسنات يذهبن السيئات} ثم انظر كيف وصف الفائزين من عباده وبماذا وصفهم فقال تعالى {أم من هو قانت}","english":"This is what has been unveiled to those who gaze with the light of inner vision. But if you are not among its people, then look to the address of God Most High to His Messenger and derive it by the light of faith. For God Most High said to the nearest of His servants to Him and the highest of them in rank before Him: {«Indeed, for you in the day is prolonged occupation and [in the night] long travail. And remember the name of your Lord and devote yourself to Him with [complete] devotion»} (73:7-8). And He said Most High: {«And remember the name of your Lord [in prayer] morning and evening. And from [part of] the night, prostrate to Him and exalt Him a long [part of the] night»} (76:25-26). And He said Most High: {«And exalt [Allah] with praise of your Lord before the rising of the sun and before its setting, and during periods of the night [exalt Him] and after the [performance of] prostrations»} (50:39-40). And He said, Glorified be He: {«And exalt [Allah] with praise of your Lord when you arise. And during part of the night exalt Him and after the stars»} (52:48-49). And He said Most High: {«Indeed, the rising by night is more potent for directing the soul and more suitable for the recitation [of the Qur'an]»} (73:6). And He said Most High: {«And from [part of] the night, exalt Him and after the setting of the stars»} (52:49). And He said Most High: {«And during parts of the night, exalt Him and at the ends of the day, that you may be satisfied»} (20:130). And He said, Mighty and Majestic: {«And establish prayer at the two ends of the day and at the approach of the night. Indeed, good deeds do away with misdeeds»} (11:114).","book_title":"Arrangement of Litanies","section_title_ar":"Section 257","section_title_en":"The Virtue of the Liturgies of Remembrance (Awrād) and the Elucidation That Perseverance Upon Them Is the Path to God Most High","section_index":257,"anchors":"- Root: ورد (w-r-d)\n  * Lisan / Ayn: The root denotes arriving at water, approaching a watering-place; the awrād (pl. of wird) are the appointed portions of devotional recitation assigned to fixed times, as one approaches the fountain of divine mercy.\n  * Al-Raghib (Mufradat): The wird is the allocated share of worship apportioned to a specific hour; its theological nuance is the systematic distribution of remembrance (dhikr) and reflection (fikr) across the昼夜 cycle to combat the soul's innate restlessness.\n  * Al-Zamakhshari (Asas): Literal: the portion of water one drinks. Metaphorical: the fixed liturgical portion one \"drinks\" from the fountain of gnosis—the shift from physical quenching to spiritual saturation.\n- Root: لطف (l-ṭ-f)\n  * Lisan / Ayn: Gentleness, subtlety, graciousness; to treat with kindness and refinement.\n  * Al-Raghib (Mufradat): The divine subtlety (al-luṭf) by which God gently draws His servant; here, the soul's need for gentle management (talṭīf) through variety in worship, lest it weary.\n  * Al-Zamakhshari (Asas): Literal: physical gentleness of touch. Metaphorical: the strategic, compassionate variation of devotional acts to sustain the soul's momentum—a haqīqah of spiritual governance.\n- Root: سأم (s-'-m)\n  * Lisan / Ayn: Weariness, boredom, satiety that breeds aversion; the soul's constitutional fatigue with a single monotonous mode.\n  * Al-Raghib (Mufradat): The psychological impediment to perseverance; overcome only by the divine mercy of variety, as the Prophet said: «إن الله لا يمل حتى تملوا» — God does not weary, but He has ordained that you may.\n  * Al-Zamakhshari (Asas): Literal: the nausea of over-satiation. Metaphorical: the spiritual listlessness that overtakes the heart when devotion becomes mechanical—requiring the \"turn\" (tanqul) between genres of worship.\n- Sibawayh Rule: باب التنويع والتقسيم (The Chapter of Division and Distribution) — The periodic structure here distributes predicates across multiple conditional clauses (fa-in... fa-in...), each governing a distinct outcome, requiring the translator to preserve the balanced, correlative syntax of proportional reward.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Arrangement of Litanies'","badge":"Insight"}],"27":[{"arabic":"كلا بل تحبون العاجلة وتذرون الآخرة وقال تعالى إن هؤلاء يحبون العاجله ويذرون وراءهم يوما ثقيلا وقال تعالى فأعرض عمن تولى عن ذكرنا ولم يرد إلا الحياة الدنيا ذلك مبلغهم من العلم ولما استطار مكر الشيطان في كافة الخلق أرسل الله الملائكة إلى الرسل وأوحوا إليهم ما تم على الخلق من إهلاك العدو وإغوائه فاشتغلوا بدعوة الخلق إلى الملك الحقيقي عن الملك المجازى الذي لا أصل له إن سلم ولا دوام له أصلا فنادوا فيهم يا أيها الذين آمنوا ما لكم إذا قيل لكم انفروا في سبيل الله اثاقلتم إلى الأرض أرضيتم بالحياة الدنيا من الآخرة فما متاع الحياة الدنيا في الآخرة","english":"Al-Junayd — may Allah have mercy on him — said: \"The journey from this world to the Hereafter is easy for the believer, but abandoning creation out of love for the Truth is severe. The journey from the self to Allah — exalted is He — is difficult and severe, and patience *with* Allah is even more severe.\" So he mentioned the severity of patience regarding the distractions of the heart, then the severity of abandoning creation.","book_title":"Patience and Gratitude","section_title_ar":"Section 970","section_title_en":"The Cure for Patience Regarding Whispers and Distractions — The Final Station of Patience","section_index":970,"anchors":"- Root: ملك (malaka)\n  * Lisan / Ayn: Core meaning of possession, dominion, and sovereign authority; al-mulk is that which is grasped and held under one's control.\n  * Al-Raghib (Mufradat): Al-Mulk is of two kinds: (1) possession and assumption of authority (al-tamalluk wa al-tawallī), and (2) the inherent capacity/power for it (al-quwwah ʿalā dhālika), whether or not one actually assumes it. True sovereignty belongs to Allah alone; human \"kingship\" is a shadow or metaphor of divine rubūbiyyah.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"Li-llāh al-mulk wa al-malakūt\" — dominion is real for God. Metaphorical (majāz): \"malaka nafsahu ʿinda al-ghaḍab\" (he mastered himself in anger) — self-possession as figurative rule; \"malaka ʿalayhi amruhu\" (his affair overcame him) — being dominated by external circumstance.\n- Root: دنا (danā)\n  * Lisan / Ayn: Proximity, nearness; al-dunyā (the lower/ nearer world) is so named because it is nearer to us and temporally prior, while the ākhirah is deferred.\n  * Al-Raghib (Mufradat): Al-dunūw is nearness by essence or by judgment, used of place, time, and station. The \"nearer\" (al-adnā) is sometimes contrasted with the greater, sometimes with the better — as in {«أَتَسْتَبْدِلُونَ الَّذِي هُوَ أَدْنَى بِالَّذِي هُوَ خَيْرٌ»} (Do you exchange that which is lower for that which is better?).\n  * Al-Zamakhshari (Asas): Literal: physical proximity. Metaphorical: preference for the immediate over the deferred — the dunyā as the \"present\" that seduces the impatient.\n- Root: خلق (khalaqa)\n  * Lisan / Ayn: Originary measuring and fashioning; estimation before cutting; creation as bringing into being upon a determined measure.\n  * Al-Raghib (Mufradat): Al-khalq is origination from no prior model (ibdāʿ), as in {«خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ»} — He originated them. Also used for bringing forth from something, as man from a drop. The \"command\" (amr) belongs to a different order than the \"creation\" (khalq).\n  * Al-Zamakhshari (Asas): Literal: the tailor's measuring of cloth before cutting. Metaphorical: Allah's creation of beings upon a measure necessitated by wisdom; \"khalq\" as the fashioned body vs. \"amr\" as the commanding, immaterial reality.\n- Root: الي (aliha / risālah)\n  * Lisan / Ayn: The root of mal'akah (messengership) — that which is \"chewed\" in the mouth, i.e., conveyed by utterance; the angel as one who delivers a message.\n  * Al-Raghib (Mufradat): Al-malā'ikah (angels) are so named from al-mal'akah (the message), because they deliver what is \"masticated\" in speech — from \"faras ya'luku al-lijām\" (a horse chewing the bit). The spirit (al-rūḥ) is from the \"command\" (amr) of the Lord — a subtle, immaterial reality.\n  * Al-Zamakhshari (Asas): Literal: physical chewing. Metaphorical: the conveyance of divine communication through angelic intermediaries.\n- Sibawayh Rule: Bāb al-ḥaṣr wa al-taqyīd bi-innamā (Restriction and Focused Predication) — \"Innamā\" restricts the predicate exclusively to the subject, as in {«إِنَّمَا مَتَاعُ الْحَيَاةِ الدُّنْيَا فِي الْآخِرَةِ إِلَّا قَلِيلٌ»} — the restriction here nullifies any comparison between the two realms, affirming the utter insignificance of worldly goods against the Hereafter.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'","badge":"Insight"}],"30":[{"arabic":"ولا تقولن لشيء إني فاعل ذلك غدا إلا أن يشاء الله ثم لم يقتصر على ذلك فيما لا يشك فيه بل قال تعالى لتدخلن المسجد الحرام إن شاء الله آمنين محلقين رءؤسكم ومقصرين وكان الله سبحانه عالما بأنهم يدخلون لا محالة وأنه شاءه ولكن المقصود تعليمه ذلك فتأدب رسول الله صلى الله عليه وسلم في ما كان يخبر عنه معلوما كان أو مشكوكا حتى قال صلى الله عليه وسلم لما دخل المقابر السلام عليكم دار قوم مؤمنين وإنا إن شاء الله بكم لاحقون (1) واللحوق بهم غير مشكوك فيه ولكن مقتضى الأدب ذكر الله تعالى وربط الأمور به وهذه الصيغ","english":"If you say: \"What is the meaning of the Salaf's statement, 'I am a believer, if God wills' — given that the exception (istithnā') implies doubt, and doubt in faith is unbelief? Yet they all refrained from giving an unqualified answer affirming faith and were cautious about it.\"","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 102","section_title_en":"On the Meaning of the Salaf's Statement \"I am a Believer, If God Wills\" — Section 102","section_index":102,"anchors":"- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which is breathed; the innermost reality of a person.\n  * Al-Raghib (Mufradat): النفس is used for the rūḥ (spirit), for the dhāt (essence/self), and for the seat of intention and knowledge. When one says \"he knows in himself (nafsihi) that he is a believer,\" it denotes certitude residing in the very core of one's being, not a corporeal faculty.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the soul's reflexive self-awareness; metaphorical (majāz) usage extends to \"blood\" (dam) or \"the eye\" (ʿayn) of envy. Here, \"in himself\" (fī nafsihi) is literal self-knowledge, not mere outward profession.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: Face, countenance; the foremost part; a mode, aspect, or direction.\n  * Al-Raghib (Mufradat): The face is the most noble apparent part of a thing; hence it is used for the \"aspect\" or \"manner\" (wajh) of an affair. \"Four aspects\" (wujūh) means four distinct modes of interpretation or rational grounds.\n  * Al-Zamakhshari (Asas): Literal: the face of a person or object. Metaphorical: \"the face of the matter\" (wajh al-amr) — its most salient and honorable dimension. Here, the \"aspects\" are hermeneutical angles, not physical parts.\n- Root: ايم (a-y-m)\n  * Al-Raghib (Mufradat): The unmarried state (aym); one who has no spouse. Not applicable here directly, but the root's semantic field of \"being alone/without attachment\" contrasts with īmān's root (a-m-n) — security and trust — which is the operative term in this text.\n  * Al-Zamakhshari (Asas): Not directly relevant; the operative root is أمن (a-m-n), meaning security from fear, and by extension, faith (īmān) as the state of being secure in God's truth.\n- Root: كان (k-w-n)\n  * Lisan / Ayn: To be, to exist; the copula of predication.\n  * Al-Raghib (Mufradat): Kāna denotes existence and becoming; in theological usage, it grounds the distinction between what is (mawjūd) and what is merely asserted. The question \"Are you a believer?\" (a-mu'min anta?) uses kāna implicitly to ask about actual, present state — not future contingency.\n  * Al-Zamakhshari (Asas): Literal: existence. Metaphorical: the \"being-so\" of a predicate. The istithnā' (exception) with \"in shā' Allāh\" suspends the copula's certainty, shifting from assertive existence to contingent hope.\n- Sibawayh Rule: باب الاستثناء والتعليق بالمشيئة (The Chapter of Exception and Suspension by the Divine Will) — When an exception clause (istithnā') follows a positive assertion, it grammatically suspends the universality or certainty of the predication. In theological discourse, this suspension may be semantic (doubt) or pragmatic (deference, etiquette, or self-deprecation), and Sibawayh's parsing of conditional suspension (taʿlīq) shows that the apodosis need not be negated — only its absolute, unqualified force is tempered.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"}]},"wordTiming":{"abdulbasit":{"1":[[1,400,852],[2,852,1947],[3,1947,2828],[4,2828,4318],[5,4318,5175],[6,5175,5996],[7,5996,7174],[8,7174,7650],[9,7650,8483],[10,8483,9578],[11,9578,11635]],"2":[[1,400,1684],[2,1684,3200],[3,3200,4731],[4,4731,5220],[5,5220,6657],[6,6657,8124],[7,8124,10105],[8,10105,11744],[9,11744,13309],[10,13309,14874]],"3":[[1,400,1643],[2,1643,3040],[3,3040,4632],[4,4632,5875],[5,5875,7390],[6,7390,8988],[7,8988,10434]],"4":[[1,400,2294],[2,2294,4052],[3,4052,6017],[4,6017,7569],[5,7569,9509],[6,9509,11426]],"5":[[1,400,1263],[2,1263,3000],[3,3000,4702],[4,4702,5175],[5,5175,5955],[6,5955,6806],[7,6806,8484],[8,8484,10303]],"6":[[1,400,1540],[2,1540,2551],[3,2551,3304],[4,3304,4336],[5,4336,5186],[6,5186,7391],[7,7391,8918]],"7":[[1,400,1810],[2,1810,3295],[3,3295,5290],[4,5290,6504],[5,6504,7285],[6,7285,8120],[7,8120,9963]],"8":[[1,400,2561],[2,2561,4270],[3,4270,5336],[4,5336,6205],[5,6205,7874],[6,7874,9751],[7,9751,11583]],"9":[[1,400,2045],[2,2045,3841],[3,3841,5065],[4,5065,6105],[5,6105,6789],[6,6789,7973],[7,7973,9026],[8,9026,10858],[9,10858,11937],[10,11937,13594]],"10":[[1,400,1632],[2,1632,2735],[3,2735,3204],[4,3204,4635],[5,4635,5949],[6,5949,7450],[7,7450,9467]],"11":[[1,400,2155],[2,2155,3022],[3,3022,3669],[4,3669,4494],[5,44