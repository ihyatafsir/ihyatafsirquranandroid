translit": "", "root": ""}, {"id": 8, "arabic": "فَجَعَلْنَٰهُ", "translit": "", "root": ""}, {"id": 9, "arabic": "سَمِيعاَۢ", "translit": "", "root": ""}, {"id": 10, "arabic": "بَصِيراًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 3, "text": "اِنَّا هَدَيْنَٰهُ اُ۬لسَّبِيلَ إِمَّا شَاكِراࣰ وَإِمَّا كَفُوراًۖ", "words": [{"id": 1, "arabic": "اِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "هَدَيْنَٰهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لسَّبِيلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِمَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "شَاكِراࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَإِمَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "كَفُوراًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 4, "text": "اِنَّآ أَعْتَدْنَا لِلْكٰ۪فِرِينَ سَلَٰسِلاࣰ وَأَغْلَٰلاࣰ وَسَعِيراًۖ", "words": [{"id": 1, "arabic": "اِنَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَعْتَدْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لِلْكٰ۪فِرِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "سَلَٰسِلاࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَأَغْلَٰلاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَسَعِيراًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 5, "text": "اِنَّ اَ۬لَابْرَارَ يَشْرَبُونَ مِن كَأْسࣲ كَانَ مِزَاجُهَا كَافُوراً", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لَابْرَارَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَشْرَبُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِن", "translit": "", "root": ""}, {"id": 5, "arabic": "كَأْسࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِزَاجُهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "كَافُوراً", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 6, "text": "عَيْناࣰ يَشْرَبُ بِهَا عِبَادُ اُ۬للَّهِ يُفَجِّرُونَهَا تَفْجِيراࣰۖ", "words": [{"id": 1, "arabic": "عَيْناࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَشْرَبُ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "عِبَادُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬للَّهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "يُفَجِّرُونَهَا", "translit": "", "root": ""}, {"id": 7, "arabic": "تَفْجِيراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 7, "text": "يُوفُونَ بِالنَّذْرِ وَيَخَافُونَ يَوْماࣰ كَانَ شَرُّهُۥ مُسْتَطِيراࣰۖ", "words": [{"id": 1, "arabic": "يُوفُونَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِالنَّذْرِ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَيَخَافُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَوْماࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 6, "arabic": "شَرُّهُۥ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُسْتَطِيراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 8, "text": "وَيُطْعِمُونَ اَ۬لطَّعَامَ عَلَيٰ حُبِّهِۦ مِسْكِيناࣰ وَيَتِيماࣰ وَأَسِيراً", "words": [{"id": 1, "arabic": "وَيُطْعِمُونَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لطَّعَامَ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "حُبِّهِۦ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِسْكِيناࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَيَتِيماࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَأَسِيراً", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 9, "text": "اِنَّمَا نُطْعِمُكُمْ لِوَجْهِ اِ۬للَّهِۖ لَا نُرِيدُ مِنكُمْ جَزَآءࣰ وَلَا شُكُوراًۖ", "words": [{"id": 1, "arabic": "اِنَّمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "نُطْعِمُكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِوَجْهِ", "t