{"surah":76,"verses":[{"ayah":1,"text":"هَلْ أَتَىٰ عَلَى ٱلْإِنسَٰنِ حِينٌ مِّنَ ٱلدَّهْرِ لَمْ يَكُن شَيْـًٔا مَّذْكُورًا ","translation":"Has there [not] come upon man a period of time when he was not a thing [even] mentioned?","words":[{"id":1,"arabic":"هَلْ","translit":"ْlَh","root":""},{"id":2,"arabic":"أَتَىٰ","translit":"ٰàَtَaʾ","root":"اتي"},{"id":3,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":4,"arabic":"ٱلْإِنسَٰنِ","translit":"ِnَٰsnِiʾْlٱ","root":"انس"},{"id":5,"arabic":"حِينٌ","translit":"ٌnyِḥ","root":"حين"},{"id":6,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":7,"arabic":"ٱلدَّهْرِ","translit":"ِrْhَّdlٱ","root":"دهر"},{"id":8,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":9,"arabic":"يَكُن","translit":"nُkَy","root":"كون"},{"id":10,"arabic":"شَيْـًٔا","translit":"āًٔـْyَhs","root":"شيا"},{"id":11,"arabic":"مَّذْكُورًا","translit":"āًrwُkْhdَّm","root":"ذكر"}],"hasIhya":true},{"ayah":2,"text":"إِنَّا خَلَقْنَا ٱلْإِنسَٰنَ مِن نُّطْفَةٍ أَمْشَاجٍ نَّبْتَلِيهِ فَجَعَلْنَٰهُ سَمِيعًۢا بَصِيرًا ","translation":"Indeed, We created man from a sperm-drop mixture[1] that We may try him; and We made him hearing and seeing.","words":[{"id":1,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":2,"arabic":"خَلَقْنَا","translit":"āَnْqَlَhk","root":"خلق"},{"id":3,"arabic":"ٱلْإِنسَٰنَ","translit":"َnَٰsnِiʾْlٱ","root":"انس"},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"نُّطْفَةٍ","translit":"ٍẗَfْṭُّn","root":"نطف"},{"id":6,"arabic":"أَمْشَاجٍ","translit":"ٍjgāَhsْmَaʾ","root":"مشج"},{"id":7,"arabic":"نَّبْتَلِيهِ","translit":"ِhyِlَtْbَّn","root":"بلو"},{"id":8,"arabic":"فَجَعَلْنَٰهُ","translit":"ُhَٰnْlَʿعَjgَf","root":"جعل"},{"id":9,"arabic":"سَمِيعًۢا","translit":"āًۢʿعyِmَs","root":"سمع"},{"id":10,"arabic":"بَصِيرًا","translit":"āًryِṣَb","root":"بصر"}],"hasIhya":true},{"ayah":3,"text":"إِنَّا هَدَيْنَٰهُ ٱلسَّبِيلَ إِمَّا شَاكِرًا وَإِمَّا كَفُورًا ","translation":"Indeed, We guided him to the way, be he grateful or be he ungrateful.","words":[{"id":1,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":2,"arabic":"هَدَيْنَٰهُ","translit":"ُhَٰnْyَdَh","root":"هدي"},{"id":3,"arabic":"ٱلسَّبِيلَ","translit":"َlyِbَّslٱ","root":"سبل"},{"id":4,"arabic":"إِمَّا","translit":"āَّmِiʾ","root":""},{"id":5,"arabic":"شَاكِرًا","translit":"āًrِkāَhs","root":"شكر"},{"id":6,"arabic":"وَإِمَّا","translit":"āَّmِiʾَw","root":""},{"id":7,"arabic":"كَفُورًا","translit":"āًrwُfَk","root":"كفر"}],"hasIhya":false},{"ayah":4,"text":"إِنَّآ أَعْتَدْنَا لِلْكَٰفِرِينَ سَلَٰسِلَا۟ وَأَغْلَٰلًا وَسَعِيرًا ","translation":"Indeed, We have prepared for the disbelievers chains and shackles and a blaze.","words":[{"id":1,"arabic":"إِنَّآ","translit":"ٓāَّnِiʾ","root":""},{"id":2,"arabic":"أَعْتَدْنَا","translit":"āَnْdَtْʿعَaʾ","root":"عتد"},{"id":3,"arabic":"لِلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlِl","root":"كفر"},{"id":4,"arabic":"سَلَٰسِلَا۟","translit":"۟āَlِsَٰlَs","root":"سلسل"},{"id":5,"arabic":"وَأَغْلَٰلًا","translit":"āًlَٰlْغَaʾَw","root":"غلل"},{"id":6,"arabic":"وَسَعِيرًا","translit":"āًryِʿعَsَw","root":"سعر"}],"hasIhya":false},{"ayah":5,"text":"إِنَّ ٱلْأَبْرَارَ يَشْرَبُونَ مِن كَأْسٍ كَانَ مِزَاجُهَا كَافُورًا ","translation":"Indeed, the righteous will drink from a cup [of wine] whose mixture is of Kāfūr,[1]","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلْأَبْرَارَ","translit":"َrāَrْbَaʾْlٱ","root":"برر"},{"id":3,"arabic":"يَشْرَبُونَ","translit":"َnwُbَrْhsَy","root":"شرب"},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"كَأْسٍ","translit":"ٍsْaʾَk","root":"كاس"},{"id":6,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":7,"arabic":"مِزَاجُهَا","translit":"āَhُjgāَzِm","root":"مزج"},{"id":8,"arabic":"كَافُورًا","translit":"āًrwُfāَk","root":"كفر"}],"hasIhya":false},{"ayah":6,"text":"عَيْنًا يَشْرَبُ بِهَا عِبَادُ ٱللَّهِ يُفَجِّرُونَهَا تَفْجِيرًا ","translation":"A spring of which the [righteous] servants of Allāh will drink; they will make it gush forth in force [and abundance].","words":[{"id":1,"arabic":"عَيْنًا","translit":"āًnْyَʿع","root":"عين"},{"id":2,"arabic":"يَشْرَبُ","translit":"ُbَrْhsَy","root":"شرب"},{"id":3,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":4,"arabic":"عِبَادُ","translit":"ُdāَbِʿع","root":"عبد"},{"id":5,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":6,"arabic":"يُفَجِّرُونَهَا","translit":"āَhَnwُrِّjgَfُy","root":"فجر"},{"id":7,"arabic":"تَفْجِيرًا","translit":"āًryِjgْfَt","root":"فجر"}],"hasIhya":false},{"ayah":7,"text":"يُوفُونَ بِٱلنَّذْرِ وَيَخَافُونَ يَوْمًا كَانَ شَرُّهُۥ مُسْتَطِيرًا ","translation":"They [are those who] fulfill [their] vows and fear a Day whose evil will be widespread.","words":[{"id":1,"arabic":"يُوفُونَ","translit":"َnwُfwُy","root":"وفي"},{"id":2,"arabic":"بِٱلنَّذْرِ","translit":"ِrْhdَّnlٱِb","root":"نذر"},{"id":3,"arabic":"وَيَخَافُونَ","translit":"َnwُfāَhkَyَw","root":"خوف"},{"id":4,"arabic":"يَوْمًا","translit":"āًmْwَy","root":"يوم"},{"id":5,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":6,"arabic":"شَرُّهُۥ","translit":"ۥُhُّrَhs","root":"شرر"},{"id":7,"arabic":"مُسْتَطِيرًا","translit":"āًryِṭَtْsُm","root":"طير"}],"hasIhya":false},{"ayah":8,"text":"وَيُطْعِمُونَ ٱلطَّعَامَ عَلَىٰ حُبِّهِۦ مِسْكِينًا وَيَتِيمًا وَأَسِيرًا ","translation":"And they give food in spite of love for it[1] to the needy, the orphan, and the captive,","words":[{"id":1,"arabic":"وَيُطْعِمُونَ","translit":"َnwُmِʿعْṭُyَw","root":"طعم"},{"id":2,"arabic":"ٱلطَّعَامَ","translit":"َmāَʿعَّṭlٱ","root":"طعم"},{"id":3,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":4,"arabic":"حُبِّهِۦ","translit":"ۦِhِّbُḥ","root":"حبب"},{"id":5,"arabic":"مِسْكِينًا","translit":"āًnyِkْsِm","root":"سكن"},{"id":6,"arabic":"وَيَتِيمًا","translit":"āًmyِtَyَw","root":"يتم"},{"id":7,"arabic":"وَأَسِيرًا","translit":"āًryِsَaʾَw","root":"اسر"}],"hasIhya":true},{"ayah":9,"text":"إِنَّمَا نُطْعِمُكُمْ لِوَجْهِ ٱللَّهِ لَا نُرِيدُ مِنكُمْ جَزَآءً وَلَا شُكُورًا ","translation":"[Saying], \"We feed you only for the face [i.e., approval] of Allāh. We wish not from you reward or gratitude.","words":[{"id":1,"arabic":"إِنَّمَا","translit":"āَmَّnِiʾ","root":""},{"id":2,"arabic":"نُطْعِمُكُمْ","translit":"ْmُkُmِʿعْṭُn","root":"طعم"},{"id":3,"arabic":"لِوَجْهِ","translit":"ِhْjgَwِl","root":"وجه"},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"لَا","translit":"āَl","root":""},{"id":6,"arabic":"نُرِيدُ","translit":"ُdyِrُn","root":"رود"},{"id":7,"arabic":"مِنكُمْ","translit":"ْmُknِm","root":""},{"id":8,"arabic":"جَزَآءً","translit":"ًءٓāَzَjg","root":"جزي"},{"id":9,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":10,"arabic":"شُكُورًا","translit":"āًrwُkُhs","root":"شكر"}],"hasIhya":true},{"ayah":10,"text":"إِنَّا نَخَافُ مِن رَّبِّنَا يَوْمًا عَبُوسًا قَمْطَرِيرًا ","translation":"Indeed, We fear from our Lord a Day austere and distressful.\"","words":[{"id":1,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":2,"arabic":"نَخَافُ","translit":"ُfāَhkَn","root":"خوف"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"رَّبِّنَا","translit":"āَnِّbَّr","root":"ربب"},{"id":5,"arabic":"يَوْمًا","translit":"āًmْwَy","root":"يوم"},{"id":6,"arabic":"عَبُوسًا","translit":"āًswُbَʿع","root":"عبس"},{"id":7,"arabic":"قَمْطَرِيرًا","translit":"āًryِrَṭْmَq","root":"قمطر"}],"hasIhya":false},{"ayah":11,"text":"فَوَقَىٰهُمُ ٱللَّهُ شَرَّ ذَٰلِكَ ٱلْيَوْمِ وَلَقَّىٰهُمْ نَضْرَةً وَسُرُورًا ","translation":"So Allāh will protect them from the evil of that Day and give them radiance and happiness","words":[{"id":1,"arabic":"فَوَقَىٰهُمُ","translit":"ُmُhٰàَqَwَf","root":"وقي"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"شَرَّ","translit":"َّrَhs","root":"شرر"},{"id":4,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":5,"arabic":"ٱلْيَوْمِ","translit":"ِmْwَyْlٱ","root":"يوم"},{"id":6,"arabic":"وَلَقَّىٰهُمْ","translit":"ْmُhٰàَّqَlَw","root":"لقي"},{"id":7,"arabic":"نَضْرَةً","translit":"ًẗَrْḍَn","root":"نضر"},{"id":8,"arabic":"وَسُرُورًا","translit":"āًrwُrُsَw","root":"سرر"}],"hasIhya":false},{"ayah":12,"text":"وَجَزَىٰهُم بِمَا صَبَرُوا۟ جَنَّةً وَحَرِيرًا ","translation":"And will reward them for what they patiently endured [with] a garden [in Paradise] and silk [garments].","words":[{"id":1,"arabic":"وَجَزَىٰهُم","translit":"mُhٰàَzَjgَw","root":"جزي"},{"id":2,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":3,"arabic":"صَبَرُوا۟","translit":"۟āwُrَbَṣ","root":"صبر"},{"id":4,"arabic":"جَنَّةً","translit":"ًẗَّnَjg","root":"جنن"},{"id":5,"arabic":"وَحَرِيرًا","translit":"āًryِrَḥَw","root":"حرر"}],"hasIhya":false},{"ayah":13,"text":"مُّتَّكِـِٔينَ فِيهَا عَلَى ٱلْأَرَآئِكِۖ لَا يَرَوْنَ فِيهَا شَمْسًا وَلَا زَمْهَرِيرًا ","translation":"[They will be] reclining therein on adorned couches. They will not see therein any [burning] sun or [freezing] cold.","words":[{"id":1,"arabic":"مُّتَّكِـِٔينَ","translit":"َnyِٔـِkَّtُّm","root":"وكا"},{"id":2,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":3,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":4,"arabic":"ٱلْأَرَآئِكِ","translit":"ِkِyʾٓāَrَaʾْlٱ","root":"ارك"},{"id":5,"arabic":"لَا","translit":"āَl","root":""},{"id":6,"arabic":"يَرَوْنَ","translit":"َnْwَrَy","root":"راي"},{"id":7,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":8,"arabic":"شَمْسًا","translit":"āًsْmَhs","root":"شمس"},{"id":9,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":10,"arabic":"زَمْهَرِيرًا","translit":"āًryِrَhْmَz","root":"زمهر"}],"hasIhya":false},{"ayah":14,"text":"وَدَانِيَةً عَلَيْهِمْ ظِلَٰلُهَا وَذُلِّلَتْ قُطُوفُهَا تَذْلِيلًا ","translation":"And near above them are its shades, and its [fruit] to be picked will be lowered in compliance.","words":[{"id":1,"arabic":"وَدَانِيَةً","translit":"ًẗَyِnāَdَw","root":"دنو"},{"id":2,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":3,"arabic":"ظِلَٰلُهَا","translit":"āَhُlَٰlِẓ","root":"ظلل"},{"id":4,"arabic":"وَذُلِّلَتْ","translit":"ْtَlِّlُhdَw","root":"ذلل"},{"id":5,"arabic":"قُطُوفُهَا","translit":"āَhُfwُṭُq","root":"قطف"},{"id":6,"arabic":"تَذْلِيلًا","translit":"āًlyِlْhdَt","root":"ذلل"}],"hasIhya":false},{"ayah":15,"text":"وَيُطَافُ عَلَيْهِم بِـَٔانِيَةٍ مِّن فِضَّةٍ وَأَكْوَابٍ كَانَتْ قَوَارِيرَا۠ ","translation":"And there will be circulated among them vessels of silver and cups having been [created] clear [as glass],","words":[{"id":1,"arabic":"وَيُطَافُ","translit":"ُfāَṭُyَw","root":"طوف"},{"id":2,"arabic":"عَلَيْهِم","translit":"mِhْyَlَʿع","root":""},{"id":3,"arabic":"بِـَٔانِيَةٍ","translit":"ٍẗَyِnāَٔـِb","root":"اني"},{"id":4,"arabic":"مِّن","translit":"nِّm","root":""},{"id":5,"arabic":"فِضَّةٍ","translit":"ٍẗَّḍِf","root":"فضض"},{"id":6,"arabic":"وَأَكْوَابٍ","translit":"ٍbāَwْkَaʾَw","root":"كوب"},{"id":7,"arabic":"كَانَتْ","translit":"ْtَnāَk","root":"كون"},{"id":8,"arabic":"قَوَارِيرَا۠","translit":"۠āَryِrāَwَq","root":"قرر"}],"hasIhya":false},{"ayah":16,"text":"قَوَارِيرَا۟ مِن فِضَّةٍ قَدَّرُوهَا تَقْدِيرًا ","translation":"Clear glasses [made] from silver of which they have determined the measure.","words":[{"id":1,"arabic":"قَوَارِيرَا۟","translit":"۟āَryِrāَwَq","root":"قرر"},{"id":2,"arabic":"مِن","translit":"nِm","root":""},{"id":3,"arabic":"فِضَّةٍ","translit":"ٍẗَّḍِf","root":"فضض"},{"id":4,"arabic":"قَدَّرُوهَا","translit":"āَhwُrَّdَq","root":"قدر"},{"id":5,"arabic":"تَقْدِيرًا","translit":"āًryِdْqَt","root":"قدر"}],"hasIhya":false},{"ayah":17,"text":"وَيُسْقَوْنَ فِيهَا كَأْسًا كَانَ مِزَاجُهَا زَنجَبِيلًا ","translation":"And they will be given to drink a cup [of wine] whose mixture is of ginger","words":[{"id":1,"arabic":"وَيُسْقَوْنَ","translit":"َnْwَqْsُyَw","root":"سقي"},{"id":2,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":3,"arabic":"كَأْسًا","translit":"āًsْaʾَk","root":"كاس"},{"id":4,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":5,"arabic":"مِزَاجُهَا","translit":"āَhُjgāَzِm","root":"مزج"},{"id":6,"arabic":"زَنجَبِيلًا","translit":"āًlyِbَjgnَz","root":""}],"hasIhya":false},{"ayah":18,"text":"عَيْنًا فِيهَا تُسَمَّىٰ سَلْسَبِيلًا ","translation":"[From] a fountain within it [i.e., Paradise] named Salsabeel.","words":[{"id":1,"arabic":"عَيْنًا","translit":"āًnْyَʿع","root":"عين"},{"id":2,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":3,"arabic":"تُسَمَّىٰ","translit":"ٰàَّmَsُt","root":"سمو"},{"id":4,"arabic":"سَلْسَبِيلًا","translit":"āًlyِbَsْlَs","root":""}],"hasIhya":false},{"ayah":19,"text":"وَيَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ إِذَا رَأَيْتَهُمْ حَسِبْتَهُمْ لُؤْلُؤًا مَّنثُورًا ","translation":"There will circulate among them young boys made eternal. When you see them, you would think them [as beautiful as] scattered pearls.","words":[{"id":1,"arabic":"وَيَطُوفُ","translit":"ُfwُṭَyَw","root":"طوف"},{"id":2,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":3,"arabic":"وِلْدَٰنٌ","translit":"ٌnَٰdْlِw","root":"ولد"},{"id":4,"arabic":"مُّخَلَّدُونَ","translit":"َnwُdَّlَhkُّm","root":"خلد"},{"id":5,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":6,"arabic":"رَأَيْتَهُمْ","translit":"ْmُhَtْyَaʾَr","root":"راي"},{"id":7,"arabic":"حَسِبْتَهُمْ","translit":"ْmُhَtْbِsَḥ","root":"حسب"},{"id":8,"arabic":"لُؤْلُؤًا","translit":"āًwʾُlْwʾُl","root":"لؤلؤ"},{"id":9,"arabic":"مَّنثُورًا","translit":"āًrwُhtnَّm","root":"نثر"}],"hasIhya":false},{"ayah":20,"text":"وَإِذَا رَأَيْتَ ثَمَّ رَأَيْتَ نَعِيمًا وَمُلْكًا كَبِيرًا ","translation":"And when you look there [in Paradise], you will see pleasure and great dominion.","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"رَأَيْتَ","translit":"َtْyَaʾَr","root":"راي"},{"id":3,"arabic":"ثَمَّ","translit":"َّmَht","root":""},{"id":4,"arabic":"رَأَيْتَ","translit":"َtْyَaʾَr","root":"راي"},{"id":5,"arabic":"نَعِيمًا","translit":"āًmyِʿعَn","root":"نعم"},{"id":6,"arabic":"وَمُلْكًا","t