 [{"id": 1, "arabic": "وَمِنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬ليْلِ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَاسْجُدْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَسَبِّحْهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَيْلاࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "طَوِيلاًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 27, "text": "اِنَّ هَٰٓؤُلَآءِ يُحِبُّونَ اَ۬لْعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمْ يَوْماࣰ ثَقِيلاࣰۖ", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَٰٓؤُلَآءِ", "translit": "", "root": ""}, {"id": 3, "arabic": "يُحِبُّونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْعَاجِلَةَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَيَذَرُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَرَآءَهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَوْماࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "ثَقِيلاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 28, "text": "نَّحْنُ خَلَقْنَٰهُمْ وَشَدَدْنَآ أَسْرَهُمْ وَإِذَا شِئْنَا بَدَّلْنَآ أَمْثَٰلَهُمْ تَبْدِيلاًۖ", "words": [{"id": 1, "arabic": "نَّحْنُ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْنَٰهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَشَدَدْنَآ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَسْرَهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 6, "arabic": "شِئْنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "بَدَّلْنَآ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَمْثَٰلَهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "تَبْدِيلاًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 29, "text": "اِنَّ هَٰذِهِۦ تَذْكِرَةࣱۖ فَمَن شَآءَ اَ۪تَّخَذَ إِلَيٰ رَبِّهِۦ سَبِيلاࣰۖ", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَٰذِهِۦ", "translit": "", "root": ""}, {"id": 3, "arabic": "تَذْكِرَةࣱۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَمَن", "translit": "", "root": ""}, {"id": 5, "arabic": "شَآءَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۪تَّخَذَ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "رَبِّهِۦ", "translit": "", "root": ""}, {"id": 9, "arabic": "سَبِيلاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 30, "text": "وَمَا تَشَآءُونَ إِلَّآ أَنْ يَّشَآءَ اَ۬للَّهُۖ إِنَّ اَ۬للَّهَ كَانَ عَلِيماً حَكِيماࣰۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَشَآءُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَّشَآءَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬للَّهُۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 9, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 10, "arabic": "عَلِيماً", "translit": "", "root": ""}, {"id": 11, "arabic": "حَكِيماࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 31, "text": "يُدْخِلُ مَنْ يَّشَآءُ فِے رَحْمَتِهِۦۖ وَالظَّٰلِمِينَ أَعَدَّ لَهُمْ عَذَاباً اَلِيماࣰۖ", "words": [{"id": 1, "arabic": "يُدْخِلُ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَّشَآءُ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "رَحْمَتِهِۦۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَالظَّٰلِمِينَ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَعَدَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَهُمْ", "tran