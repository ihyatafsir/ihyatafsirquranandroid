۪فِرِينَ سَلَٰسِلاࣰ وَأَغْلَٰلاࣰ وَسَعِيراًۖ", "words": [{"id": 1, "arabic": "اِنَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَعْتَدْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لِلْكٰ۪فِرِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "سَلَٰسِلاࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَأَغْلَٰلاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَسَعِيراًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 5, "text": "اِنَّ اَ۬لَابْرَارَ يَشْرَبُونَ مِن كَأْسࣲ كَانَ مِزَاجُهَا كَافُوراً", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لَابْرَارَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَشْرَبُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِن", "translit": "", "root": ""}, {"id": 5, "arabic": "كَأْسࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِزَاجُهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "كَافُوراً", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 6, "text": "عَيْناࣰ يَشْرَبُ بِهَا عِبَادُ اُ۬للَّهِ يُفَجِّرُونَهَا تَفْجِيراࣰۖ", "words": [{"id": 1, "arabic": "عَيْناࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَشْرَبُ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "عِبَادُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬للَّهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "يُفَجِّرُونَهَا", "translit": "", "root": ""}, {"id": 7, "arabic": "تَفْجِيراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 7, "text": "يُوفُونَ بِالنَّذْرِ وَيَخَافُونَ يَوْماࣰ كَانَ شَرُّهُۥ مُسْتَطِيراࣰۖ", "words": [{"id": 1, "arabic": "يُوفُونَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِالنَّذْرِ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَيَخَافُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَوْماࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 6, "arabic": "شَرُّهُۥ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُسْتَطِيراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 8, "text": "وَيُطْعِمُونَ اَ۬لطَّعَامَ عَلَيٰ حُبِّهِۦ مِسْكِيناࣰ وَيَتِيماࣰ وَأَسِيراً", "words": [{"id": 1, "arabic": "وَيُطْعِمُونَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لطَّعَامَ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "حُبِّهِۦ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِسْكِيناࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَيَتِيماࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَأَسِيراً", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 9, "text": "اِنَّمَا نُطْعِمُكُمْ لِوَجْهِ اِ۬للَّهِۖ لَا نُرِيدُ مِنكُمْ جَزَآءࣰ وَلَا شُكُوراًۖ", "words": [{"id": 1, "arabic": "اِنَّمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "نُطْعِمُكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِوَجْهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَا", "translit": "", "root": ""}, {"id": 6, "arabic": "نُرِيدُ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِنكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "جَزَآءࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 10, "arabic": "شُكُوراًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 10, "text": "اِنَّا نَخَافُ مِن رَّبِّنَا يَوْماً عَبُوساࣰ قَمْطَرِيراࣰۖ", "words": [{"id": 1, "arabic": "اِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "نَخَافُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "رَّبِّنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يَوْماً", "translit": "", "root": ""}, {"id": 6, "arabic": "عَبُوساࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَمْطَرِيراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 11, "text": "فَوَق۪يٰهُمُ اُ۬للَّهُ شَرَّ ذَٰلِكَ اَ۬لْيَوْمِ وَلَقّ۪يٰهُمْ نَضْرَةࣰ وَسُرُوراࣰۖ", "words": [{"id": 1, "arabic": "فَوَق۪يٰهُمُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬للَّهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "شَرَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْيَوْمِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَقّ۪يٰهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "نَضْرَةࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَسُرُوراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 12, "text": "وَجَز۪يٰهُم بِمَا صَبَرُواْ جَنَّةࣰ وَحَرِيراࣰ‏", "words": [{"id": 1, "arabic": "وَجَز۪يٰهُم", "translit": "", "root": ""}, {"id": 2, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 3, "arabic": "صَبَرُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "جَنَّةࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَحَرِيراࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 13, "text": "مُّتَّكِـِٕينَ فِيهَا عَلَي اَ۬لَارَآئِكِ لَا يَرَوْنَ فِيهَا شَمْساࣰ وَلَا زَمْهَرِيراࣰ‏", "words": [{"id": 1, "arabic": "مُّتَّكِـِٕينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لَارَآئِكِ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَا", "translit": "", "root": ""}, {"id": 6, "arabic": "يَرَوْنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "شَمْساࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 10, "arabic": "زَمْهَرِيراࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 14, "text": "وَدَانِيَةً عَلَيْهِمْ ظِلَٰلُهَا وَذُلِّلَتْ قُطُوفُهَا تَذْلِيلاࣰۖ", "words": [{"id": 1, "arabic": "وَدَانِيَةً", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "ظِلَٰلُهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "وَذُلِّلَتْ", "translit": "", "root": ""}, {"id": 5, "arabic": "قُطُوفُهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "تَذْلِيلاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 15, "text": "وَيُطَافُ عَلَيْهِم بِـَٔانِيَةࣲ مِّن فِضَّةࣲ وَأَكْوَابࣲ كَانَتْ قَوَارِيراࣰۖ", "words": [{"id": 1, "arabic": "وَيُطَافُ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِم", "translit": "", "root": ""}, {"id": 3, "arabic": "بِـَٔانِيَةࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 5, "arabic": "فِضَّةࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَكْوَابࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "كَانَتْ", "translit": "", "root": ""}, {"id": 8, "arabic": "قَوَارِيراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 16, "text": "قَوَارِيراࣰ مِّن فِضَّةࣲ قَدَّرُوهَا تَقْدِيراࣰۖ", "words": [{"id": 1, "arabic": "قَوَارِيراࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 3, "arabic": "فِضَّةࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَدَّرُوهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "تَقْدِيراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 17, "text": "وَيُسْقَوْنَ فِيهَا كَأْساࣰ كَانَ مِزَاجُهَا زَنجَبِيلاً", "words": [{"id": 1, "arabic": "وَيُسْقَوْنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "كَأْساࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِزَاجُهَا", "translit": 