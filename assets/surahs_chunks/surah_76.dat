"translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 16, "text": "قَوَارِيراࣰ مِّن فِضَّةࣲ قَدَّرُوهَا تَقْدِيراࣰۖ", "words": [{"id": 1, "arabic": "قَوَارِيراࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 3, "arabic": "فِضَّةࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَدَّرُوهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "تَقْدِيراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 17, "text": "وَيُسْقَوْنَ فِيهَا كَأْساࣰ كَانَ مِزَاجُهَا زَنجَبِيلاً", "words": [{"id": 1, "arabic": "وَيُسْقَوْنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "كَأْساࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِزَاجُهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "زَنجَبِيلاً", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 18, "text": "عَيْناࣰ فِيهَا تُسَمّ۪يٰ سَلْسَبِيلاࣰۖ", "words": [{"id": 1, "arabic": "عَيْناࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "تُسَمّ۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "سَلْسَبِيلاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 19, "text": "۞وَيَطُوفُ عَلَيْهِمْ وِلْدَٰنࣱ مُّخَلَّدُونَ إِذَا رَأَيْتَهُمْ حَسِبْتَهُمْ لُؤْلُؤاࣰ مَّنثُوراࣰۖ", "words": [{"id": 1, "arabic": "۞وَيَطُوفُ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وِلْدَٰنࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "مُّخَلَّدُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 6, "arabic": "رَأَيْتَهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "حَسِبْتَهُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "لُؤْلُؤاࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَّنثُوراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 20, "text": "وَإِذَا رَأَيْتَ ثَمَّ رَأَيْتَ نَعِيماࣰ وَمُلْكاࣰ كَبِيراً", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "رَأَيْتَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ثَمَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَأَيْتَ", "translit": "", "root": ""}, {"id": 5, "arabic": "نَعِيماࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمُلْكاࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "كَبِيراً", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 21, "text": "عَٰلِيهِمْ ثِيَابُ سُندُسٍ خُضْرࣱ وَإِسْتَبْرَقࣱۖ وَحُلُّوٓاْ أَسَاوِرَ مِن فِضَّةࣲۖ وَسَق۪يٰهُمْ رَبُّهُمْ شَرَاباࣰ طَهُوراًۖ", "words": [{"id": 1, "arabic": "عَٰلِيهِمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "ثِيَابُ", "translit": "", "root": ""}, {"id": 3, "arabic": "سُندُسٍ", "translit": "", "root": ""}, {"id": 4, "arabic": "خُضْرࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَإِسْتَبْرَقࣱۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَحُلُّوٓاْ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَسَاوِرَ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "", "root": ""}, {"id": 9, "arabic": "فِضَّةࣲۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَسَق۪يٰهُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "رَبُّهُمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "شَرَاباࣰ", "translit": "", "root": ""}, {"id": 13, "arabic": "طَهُوراًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 22, "text": "اِنَّ هَٰذَا كَانَ لَكُمْ جَزَآءࣰ وَكَانَ سَعْيُكُم مَّشْكُوراًۖ", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَكُمْ", "translit": "", "root": ""}