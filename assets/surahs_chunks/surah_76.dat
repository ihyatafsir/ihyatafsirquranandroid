 كَفُوراࣰۖ", "words": [{"id": 1, "arabic": "فَاصْبِرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِحُكْمِ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 5, "arabic": "تُطِعْ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِنْهُمُۥٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "ءَاثِماً", "translit": "", "root": ""}, {"id": 8, "arabic": "اَوْ", "translit": "", "root": ""}, {"id": 9, "arabic": "كَفُوراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 25, "text": "وَاذْكُرِ اِ۪سْمَ رَبِّكَ بُكْرَةࣰ وَأَصِيلاࣰۖ", "words": [{"id": 1, "arabic": "وَاذْكُرِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۪سْمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "بُكْرَةࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَأَصِيلاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 26, "text": "وَمِنَ اَ۬ليْلِ فَاسْجُدْ لَهُۥ وَسَبِّحْهُ لَيْلاࣰ طَوِيلاًۖ", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬ليْلِ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَاسْجُدْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَسَبِّحْهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَيْلاࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "طَوِيلاًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 76, "ayah": 27, "text": "اِنَّ هَٰٓؤُلَآءِ يُحِبُّونَ اَ۬لْعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمْ يَوْماࣰ ثَقِيلاࣰۖ", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَٰٓؤُلَآءِ", "translit": "", "root": ""}, {"id": 3, "arabic": "يُحِبُّونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْعَاجِلَةَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَيَذَرُونَ",