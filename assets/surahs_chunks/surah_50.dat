50, "ayah": 34, "text": "اُ۟دْخُلُوهَا بِسَلَٰمࣲۖ ذَٰلِكَ يَوْمُ اُ۬لْخُلُودِۖ", "words": [{"id": 1, "arabic": "اُ۟دْخُلُوهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "بِسَلَٰمࣲۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَوْمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْخُلُودِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 35, "text": "لَهُم مَّا يَشَآءُونَ فِيهَاۖ وَلَدَيْنَا مَزِيدࣱۖ", "words": [{"id": 1, "arabic": "لَهُم", "translit": "", "root": ""}, {"id": 2, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "يَشَآءُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِيهَاۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَلَدَيْنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "مَزِيدࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 36, "text": "وَكَمَ اَهْلَكْنَا قَبْلَهُم مِّن قَرْنٍ هُمُۥٓ أَشَدُّ مِنْهُم بَطْشاࣰ فَنَقَّبُواْ فِے اِ۬لْبِلَٰدِۖ هَلْ مِن مَّحِيصٍۖ", "words": [{"id": 1, "arabic": "وَكَمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَهْلَكْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "قَبْلَهُم", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 5, "arabic": "قَرْنٍ", "translit": "", "root": ""}, {"id": 6, "arabic": "هُمُۥٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَشَدُّ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِنْهُم", "translit": "", "root": ""}, {"id": 9, "arabic": "بَطْشاࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَنَقَّبُواْ", "translit": "", "root": ""}, {"id": 11, "arabic": "فِے", "translit": "", "root": ""}, {"id": 12, "arabic": "اِ۬لْبِلَٰدِۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "هَلْ", "translit": "", "root": ""}, {"id": 14, "arabic": "مِن", "translit": "", "root": ""}, {"id": 15, "arabic": "مَّحِيصٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 37, "text": "اِنَّ فِے ذَٰلِكَ لَذِكْر۪يٰ لِمَن كَانَ لَهُۥ قَلْبٌ اَوَ اَلْقَي اَ۬لسَّمْعَ وَهُوَ شَهِيدࣱۖ", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَذِكْر۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِمَن", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 8, "arabic": "قَلْبٌ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَوَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَلْقَي", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لسَّمْعَ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 13, "arabic": "شَهِيدࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 38, "text": "وَلَقَدْ خَلَقْنَا اَ۬لسَّمَٰوَٰتِ وَالَارْضَ وَمَا بَيْنَهُمَا فِے سِتَّةِ أَيَّامࣲ وَمَا مَسَّنَا مِن لُّغُوبࣲۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "بَيْنَهُمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "سِتَّةِ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَيَّامࣲ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 11, "arabic": "مَسَّنَا", "translit": "", "root": ""}, {"id": 12, "arabic": "مِن", "translit": "", "root": ""}, {"id": 13, "arabic": "لُّغُوبࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 39, "text": "فَاصْبِرْ عَلَيٰ مَا يَق