{"surah": 50, "verses": [{"ayah": 1, "text": "قٓۚ وَٱلْقُرْءَانِ ٱلْمَجِيدِ ", "translation": "Qāf.[1] By the honored Qur’ān...[2]", "words": [{"id": 1, "arabic": "قٓ", "translit": "ٓq", "root": ""}, {"id": 2, "arabic": "وَٱلْقُرْءَانِ", "translit": "ِnāَءْrُqْlٱَw", "root": "قرا"}, {"id": 3, "arabic": "ٱلْمَجِيدِ", "translit": "ِdyِjgَmْlٱ", "root": "مجد"}], "hasIhya": false}, {"ayah": 2, "text": "بَلْ عَجِبُوٓا۟ أَن جَآءَهُم مُّنذِرٌ مِّنْهُمْ فَقَالَ ٱلْكَٰفِرُونَ هَٰذَا شَىْءٌ عَجِيبٌ ", "translation": "But they wonder that there has come to them a warner from among themselves, and the disbelievers say, \"This is an amazing thing.", "words": [{"id": 1, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 2, "arabic": "عَجِبُوٓا۟", "translit": "۟āٓwُbِjgَʿع", "root": "عجب"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "جَآءَهُم", "translit": "mُhَءٓāَjg", "root": "جيا"}, {"id": 5, "arabic": "مُّنذِرٌ", "translit": "ٌrِhdnُّm", "root": "نذر"}, {"id": 6, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 7, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 8, "arabic": "ٱلْكَٰفِرُونَ", "translit": "َnwُrِfَٰkْlٱ", "root": "كفر"}, {"id": 9, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 10, "arabic": "شَىْءٌ", "translit": "ٌءْàَhs", "root": "شيا"}, {"id": 11, "arabic": "عَجِيبٌ", "translit": "ٌbyِjgَʿع", "root": "عجب"}], "hasIhya": false}, {"ayah": 3, "text": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًاۖ ذَٰلِكَ رَجْعٌۢ بَعِيدٌ ", "translation": "When we have died and have become dust, [we will return to life]? That is a distant [i.e., unlikely] return.\"", "words": [{"id": 1, "arabic": "أَءِذَا", "translit": "āَhdِءَaʾ", "root": ""}, {"id": 2, "arabic": "مِتْنَا", "translit": "āَnْtِm", "root": "موت"}, {"id": 3, "arabic": "وَكُنَّا", "translit": "āَّnُkَw", "root": "كون"}, {"id": 4, "arabic": "تُرَابًا", "translit": "āًbāَrُt", "root": "ترب"}, {"id": 5, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 6, "arabic": "رَجْعٌۢ", "translit": "ٌۢʿعْjgَr", "root": "رجع"}, {"id": 7, "arabic": "بَعِيدٌ", "translit": "ٌdyِʿعَb", "root": "بعد"}], "hasIhya": false}, {"ayah": 4, "text": "قَدْ عَلِمْنَا مَا تَنقُصُ ٱلْأَرْضُ مِنْهُمْۖ وَعِندَنَا كِتَٰبٌ حَفِيظٌۢ ", "translation": "We know what the earth diminishes [i.e., consumes] of them, and with Us is a retaining record.", "words": [{"id": 1, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 2, "arabic": "عَلِمْنَا", "translit": "āَnْmِlَʿع", "root": "علم"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "تَنقُصُ", "translit": "ُṣُqnَt", "root": "نقص"}, {"id": 5, "arabic": "ٱلْأَرْضُ", "translit": "ُḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 7, "arabic": "وَعِندَنَا", "translit": "āَnَdnِʿعَw", "root": "عند"}, {"id": 8, "arabic": "كِتَٰبٌ", "translit": "ٌbَٰtِk", "root": "كتب"}, {"id": 9, "arabic": "حَفِيظٌۢ", "translit": "ٌۢẓyِfَḥ", "root": "حفظ"}], "hasIhya": false}, {"ayah": 5, "text": "بَلْ كَذَّبُوا۟ بِٱلْحَقِّ لَمَّا جَآءَهُمْ فَهُمْ فِىٓ أَمْرٍ مَّرِيجٍ ", "translation": "But they denied the truth when it came to them, so they are in a confused condition.", "words": [{"id": 1, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 2, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 3, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 4, "arabic": "لَمَّا", "translit": "āَّmَl", "root": ""}, {"id": 5, "arabic": "جَآءَهُمْ", "translit": "ْmُhَءٓāَjg", "root": "جيا"}, {"id": 6, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 7, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 8, "arabic": "أَمْرٍ", "translit": "ٍrْmَaʾ", "root": "امر"}, {"id": 9, "arabic": "مَّرِيجٍ", "translit": "ٍjgyِrَّm", "root": "مرج"}], "hasIhya": false}, {"ayah": 6, "text": "أَفَلَمْ يَنظُرُوٓا۟ إِلَى ٱلسَّمَآءِ فَوْقَهُمْ كَيْفَ بَنَيْنَٰهَا وَزَيَّنَّٰهَا وَمَا لَهَا مِن فُرُوجٍ ", "translation": "Have they not looked at the heaven above them - how We structured it and adorned it and [how] it has no rifts?", "words": [{"id": 1, "arabic": "أَفَلَمْ", "translit": "ْmَlَfَaʾ", "root": ""}, {"id": 2, "arabic": "يَنظُرُوٓا۟", "translit": "۟āٓwُrُẓnَy", "root": "نظر"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "فَوْقَهُمْ", "translit": "ْmُhَqْwَf", "root": "فوق"}, {"id": 6, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 7, "arabic": "بَنَيْنَٰهَا", "translit": "āَhَٰnْyَnَb", "root": "بني"}, {"id": 8, "arabic": "وَزَيَّنَّٰهَا", "translit": "āَhَّٰnَّyَzَw", "root": "زين"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "فُرُوجٍ", "translit": "ٍjgwُrُf", "root": "فرج"}], "hasIhya": false}, {"ayah": 7, "text": "وَٱلْأَرْضَ مَدَدْنَٰهَا وَأَلْقَيْنَا فِيهَا رَوَٰسِىَ وَأَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجٍۭ بَهِيجٍ ", "translation": "And the earth - We spread it out and cast therein firmly set mountains and made grow therein [something] of every beautiful kind,", "words": [{"id": 1, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 2, "arabic": "مَدَدْنَٰهَا", "translit": "āَhَٰnْdَdَm", "root": "مدد"}, {"id": 3, "arabic": "وَأَلْقَيْنَا", "translit": "āَnْyَqْlَaʾَw", "root": "لقي"}, {"id": 4, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 5, "arabic": "رَوَٰسِىَ", "translit": "َàِsَٰwَr", "root": "رسو"}, {"id": 6, "arabic": "وَأَنۢبَتْنَا", "translit": "āَnْtَbۢnَaʾَw", "root": "نبت"}, {"id": 7, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 10, "arabic": "زَوْجٍۭ", "translit": "ٍۭjgْwَz", "root": "زوج"}, {"id": 11, "arabic": "بَهِيجٍ", "translit": "ٍjgyِhَb", "root": "بهج"}], "hasIhya": false}, {"ayah": 8, "text": "تَبْصِرَةً وَذِكْرَىٰ لِكُلِّ عَبْدٍ مُّنِيبٍ ", "translation": "Giving insight and a reminder for every servant who turns [to Allāh].", "words": [{"id": 1, "arabic": "تَبْصِرَةً", "translit": "ًẗَrِṣْbَt", "root": "بصر"}, {"id": 2, "arabic": "وَذِكْرَىٰ", "translit": "ٰàَrْkِhdَw", "root": "ذكر"}, {"id": 3, "arabic": "لِكُلِّ", "translit": "ِّlُkِl", "root": "كلل"}, {"id": 4, "arabic": "عَبْدٍ", "translit": "ٍdْbَʿع", "root": "عبد"}, {"id": 5, "arabic": "مُّنِيبٍ", "translit": "ٍbyِnُّm", "root": "نوب"}], "hasIhya": true}, {"ayah": 9, "text": "وَنَزَّلْنَا مِنَ ٱلسَّمَآءِ مَآءً مُّبَٰرَكًا فَأَنۢبَتْنَا بِهِۦ جَنَّٰتٍ وَحَبَّ ٱلْحَصِيدِ ", "translation": "And We have sent down blessed rain from the sky and made grow thereby gardens and grain from the harvest", "words": [{"id": 1, "arabic": "وَنَزَّلْنَا", "translit": "āَnْlَّzَnَw", "root": "نزل"}, {"id": 2, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 3, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "مَآءً", "translit": "ًءٓāَm", "root": "موه"}, {"id": 5, "arabic": "مُّبَٰرَكًا", "translit": "āًkَrَٰbُّm", "root": "برك"}, {"id": 6, "arabic": "فَأَنۢبَتْنَا", "translit": "āَnْtَbۢnَaʾَf", "root": "نبت"}, {"id": 7, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 8, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 9, "arabic": "وَحَبَّ", "translit": "َّbَḥَw", "root": "حبب"}, {"id": 10, "arabic": "ٱلْحَصِيدِ", "translit": "ِdyِṣَḥْlٱ", "root": "حصد"}], "hasIhya": false}, {"ayah": 10, "text": "وَٱلنَّخْلَ بَاسِقَٰتٍ لَّهَا طَلْعٌ نَّضِيدٌ ", "translation": "And lofty palm trees having fruit arranged in layers -", "words": [{"id": 1, "arabic": "وَٱلنَّخْلَ", "translit": "َlْhkَّnlٱَw", "root": "نخل"}, {"id": 2, "arabic": "بَاسِقَٰتٍ", "translit": "ٍtَٰqِsāَb", "root": "بسق"}, {"id": 3, "arabic": "لَّهَا", "translit": "āَhَّl", "root": ""}, {"id": 4, "arabic": "طَلْعٌ", "translit": "ٌʿعْlَṭ", "root": "طلع"}, {"id": 5, "arabic": "نَّضِيدٌ", "translit": "ٌdyِḍَّn", "root": "نضد"}], "hasIhya": false}, {"ayah": 11, "text": "رِّزْقًا لِّلْعِبَادِۖ وَأَحْيَيْنَا بِهِۦ بَلْدَةً مَّيْتًاۚ كَذَٰلِكَ ٱلْخُرُوجُ ", "translation": "As provision for the servants, and We have given life thereby to a dead land. Thus is the emergence [i.e., resurrection].", "words": [{"id": 1, "arabic": "رِّزْقًا", "translit": "āًqْzِّr", "root": "رزق"}, {"id": 2, "arabic": "لِّلْعِبَادِ", "translit": "ِdāَbِʿعْlِّl", "root": "عبد"}, {"id": 3, "arabic": "وَأَحْيَيْنَا", "translit": "āَnْyَyْḥَaʾَw", "root": "حيي"}, {"id": 4, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 5, "arabic": "بَلْدَةً", "translit": "ًẗَdْlَb", "root": "بلد"}, {"id": 6, "arabic": "مَّيْتًا", "translit": "āًtْyَّm", "root": "موت"}, {"id": 7, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 8, "arabic": "ٱلْخُرُوجُ", "translit": "ُjgwُrُhkْlٱ", "root": "خرج"}], "hasIhya": false}, {"ayah": 12, "text": "كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَأَصْحَٰبُ ٱلرَّسِّ وَثَمُودُ ", "translation": "The people of Noah denied before them,[1] and the companions of the well[2] and Thamūd", "words": [{"id": 1, "arabic": "كَذَّبَتْ", "translit": "ْtَbَّhdَk", "root": "كذب"}, {"id": 2, "arabic": "قَبْلَهُمْ", "translit": "ْmُhَlْbَq", "root": "قبل"}, {"id": 3, "arabic": "قَوْمُ", "translit": "ُmْwَq", "root": "قوم"}, {"id": 4, "arabic": "نُوحٍ", "translit": "ٍḥwُn", "root": ""}, {"id": 5, "arabic": "وَأَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾَw", "root": "صحب"}, {"id": 6, "arabic": "ٱلرَّسِّ", "translit": "ِّsَّrlٱ", "root": "رسس"}, {"id": 7, "arabic": "وَثَمُودُ", "translit": "ُdwُmَhtَw", "root": ""}], "hasIhya": false}, {"ayah": 13, "text": "وَعَادٌ وَفِرْعَوْنُ وَإِخْوَٰنُ لُوطٍ ", "translation": "And ʿAad and Pharaoh and the brothers [i.e., people] of Lot", "words": [{"id": 1, "arabic": "وَعَادٌ", "translit": "ٌdāَʿعَw", "root": "عود"}, {"id": 2, "arabic": "وَفِرْعَوْنُ", "translit": "ُnْwَʿعْrِfَw", "root": ""}, {"id": 3, "arabic": "وَإِخْوَٰنُ", "translit": "ُnَٰwْhkِiʾَw", "root": "اخو"}, {"id": 4, "arabic": "لُوطٍ", "translit": "ٍṭwُl", "root": ""}], "hasIhya": false}, {"ayah": 14, "text": "وَأَصْحَٰبُ ٱلْأَيْكَةِ وَقَوْمُ تُبَّعٍۚ كُلٌّ كَذَّبَ ٱلرُّسُلَ فَحَقَّ وَعِيدِ ", "translation": "And the companions of the thicket and the people of Tubbaʿ. All denied the messengers, so My threat was justly fulfilled.", "words": [{"id": 1, "arabic": "وَأَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾَw", "root": "صحب"}, {"id": 2, "arabic": "ٱلْأَيْكَةِ", "translit": "ِẗَkْyَaʾْlٱ", "root": ""}, {"id": 3, "arabic": "وَقَوْمُ", "translit": "ُmْwَqَw", "root": "قوم"}, {"id": 4, "arabic": "تُبَّعٍ", "translit": "ٍʿعَّbُt", "root": ""}, {"id": 5, "arabic": "كُلٌّ", "translit": "ٌّlُk", "root": "كلل"}, {"id": 6, "arabic": "كَذَّبَ", "translit": "َbَّhdَk", "root": "كذب"}, {"id": 7, "arabic": "ٱلرُّسُلَ", "translit": "َlُsُّrlٱ", "root": "رسل"}, {"id": 8, "arabic": "فَحَقَّ", "translit": "َّqَḥَf", "root": "حقق"}, {"id": 9, "arabic": "وَعِيدِ", "translit": "ِdyِʿعَw", "root": "وعد"}], "hasIhya": false}, {"ayah": 15, "text": "أَفَعَيِينَا بِٱلْخَلْقِ ٱلْأَوَّلِۚ بَلْ هُمْ فِى لَبْسٍ مِّنْ خَلْقٍ جَدِيدٍ ", "translation": "Did We fail in the first creation? But they are in confusion over a new creation.", "words": [{"id": 1, "arabic": "أَفَعَيِينَا", "translit": "āَnyِyَʿعَfَaʾ", "root": "عيي"}, {"id": 2, "arabic": "بِٱلْخَلْقِ", "translit": "ِqْlَhkْlٱِb", "root": "خلق"}, {"id": 3, "arabic": "ٱلْأَوَّلِ", "translit": "ِlَّwَaʾْlٱ", "root": "اول"}, {"id": 4, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 5, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "لَبْسٍ", "translit": "ٍsْbَl", "root": "لبس"}, {"id": 8, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 9, "arabic": "خَلْقٍ", "translit": "ٍqْlَhk", "root": "خلق"}, {"id": 10, "arabic": "جَدِيدٍ", "translit": "ٍdyِdَjg", "root": "جدد"}], "hasIhya": false}, {"ayah": 16, "text": "وَلَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ وَنَعْلَمُ مَا تُوَسْوِسُ بِهِۦ نَفْسُهُۥۖ وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنْ حَبْلِ ٱلْوَرِيدِ ", "translation": "And We have already created man and know what his soul whispers to him, and We are closer[1] to him than [his] jugular vein.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "خَلَقْنَا", "translit": "āَnْqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "ٱلْإِنسَٰنَ", "translit": "َnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 4, "arabic": "وَنَعْلَمُ", "translit": "ُmَlْʿعَnَw", "root": "علم"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "تُوَسْوِسُ", "translit": "ُsِwْsَwُt", "root": "وسوس"}, {"id": 7, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 8, "arabic": "نَفْسُهُۥ", "translit": "ۥُhُsْfَn", "root": "نفس"}, {"id": 9, "arabic": "وَنَحْنُ", "translit": "ُnْḥَnَw", "root": ""}, {"id": 10, "arabic": "أَقْرَبُ", "translit": "ُbَrْqَaʾ", "root": "قرب"}, {"id": 11, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 12, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 13, "arabic": "حَبْلِ", "translit": "ِlْbَḥ", "root": "حبل"}, {"id": 14, "arabic": "ٱلْوَرِيدِ", "translit": "ِdyِrَwْlٱ", "root": "ورد"}], "hasIhya": true}, {"ayah": 17, "text": "إِذْ يَتَلَقَّى ٱلْمُتَلَقِّيَانِ عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ قَعِيدٌ ", "translation": "When the two receivers [i.e., recording angels] receive,[1] seated on the right and on the left.", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "يَتَلَقَّى", "translit": "àَّqَlَtَy", "root": "لقي"}, {"id": 3, "arabic": "ٱلْمُتَلَقِّيَانِ", "translit": "ِnāَyِّqَlَtُmْlٱ", "root": "لقي"}, {"id": 4, "arabic": "عَنِ", "translit": "ِnَʿع", "root": 