ُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَقَالَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لْكَٰفِرُونَ", "translit": "", "root": ""}, {"id": 9, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 10, "arabic": "شَےْءٌ", "translit": "", "root": ""}, {"id": 11, "arabic": "عَجِيبٌ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 3, "text": "اَ۟ذَا مِتْنَا وَكُنَّا تُرَاباࣰ ذَٰلِكَ رَجْعُۢ بَعِيدࣱۖ", "words": [{"id": 1, "arabic": "اَ۟ذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مِتْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "وَكُنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "تُرَاباࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "رَجْعُۢ", "translit": "", "root": ""}, {"id": 7, "arabic": "بَعِيدࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 4, "text": "قَدْ عَلِمْنَا مَا تَنقُصُ اُ۬لَارْضُ مِنْهُمْ وَعِندَنَا كِتَٰبٌ حَفِيظُۢۖ", "words": [{"id": 1, "arabic": "قَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلِمْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "تَنقُصُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لَارْضُ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِنْهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَعِندَنَا", "translit": "", "root": ""}, {"id": 8, "arabic": "كِتَٰبٌ", "translit": "", "root": ""}, {"id": 9, "arabic": "حَفِيظُۢۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 5, "text": "بَلْ كَذَّبُواْ بِالْحَقِّ لَمَّا جَآءَهُمْ فَهُمْ فِےٓ أَمْرࣲ مَّرِيجٍۖ", "words": [{"id": 1, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَذَّبُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِالْحَقِّ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَمَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "جَآءَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَمْرࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَّرِيجٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 6, "text": "اَفَلَمْ يَنظُرُوٓاْ إِلَي اَ۬لسَّمَآءِ فَوْقَهُمْ كَيْفَ بَنَيْنَٰهَا وَزَيَّنَّٰهَا وَمَا لَهَا مِن فُرُوجࣲۖ", "words": [{"id": 1, "arabic": "اَفَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَنظُرُوٓاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَوْقَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَيْفَ", "translit": "", "root": ""}, {"id": 7, "arabic": "بَنَيْنَٰهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "وَزَيَّنَّٰهَا", "translit": "", "root": ""}, {"id": 9, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 10, "arabic": "لَهَا", "translit": "", "root": ""}, {"id": 11, "arabic": "مِن", "translit": "", "root": ""}, {"id": 12, "arabic": "فُرُوجࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 7, "text": "وَالَارْضَ مَدَدْنَٰهَا وَأَلْقَيْنَا فِيهَا رَوَٰسِيَ وَأَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجِۢ بَهِيجࣲ‏", "words": [{"id": 1, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَدَدْنَٰهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "وَأَلْقَيْنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "رَوَٰسِيَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَنۢبَتْنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "", "root": ""}, {"id": 9, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 10, "arabic": "زَوْجِۢ", "translit": "", "root": ""}, {"id": 11, "arabic": "بَهِيجࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 8, "text": "تَبْصِرَةࣰ وَذِكْر۪يٰ لِكُلِّ عَبْدࣲ مُّنِيبࣲۖ", "words": [{"id": 1, "arabic": "تَبْصِرَةࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَذِكْر۪يٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِكُلِّ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَبْدࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّنِيبࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 9, "text": "۞وَنَزَّلْنَا مِنَ اَ۬لسَّمَآءِ مَآءࣰ مُّبَٰرَكاࣰ فَأَنۢبَتْنَا بِهِۦ جَنَّٰتࣲ وَحَبَّ اَ۬لْحَصِيدِ", "words": [{"id": 1, "arabic": "۞وَنَزَّلْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَآءࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّبَٰرَكاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَأَنۢبَتْنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 8, "arabic": "جَنَّٰتࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَحَبَّ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لْحَصِيدِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 10, "text": "وَالنَّخْلَ بَاسِقَٰتࣲ لَّهَا طَلْعࣱ نَّضِيدࣱ‏", "words": [{"id": 1, "arabic": "وَالنَّخْلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَاسِقَٰتࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَّهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "طَلْعࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "نَّضِيدࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 11, "text": "رِّزْقاࣰ لِّلْعِبَادِۖ وَأَحْيَيْنَا بِهِۦ بَلْدَةࣰ مَّيْتاࣰۖ كَذَٰلِكَ اَ۬لْخُرُوجُۖ", "words": [{"id": 1, "arabic": "رِّزْقاࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِّلْعِبَادِۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "