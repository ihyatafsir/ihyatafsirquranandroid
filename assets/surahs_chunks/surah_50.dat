"}], "narration": "warsh"}, {"surah": 50, "ayah": 15, "text": "أَفَعَيِينَا بِالْخَلْقِ اِ۬لَاوَّلِۖ بَلْ هُمْ فِے لَبْسࣲ مِّنْ خَلْقࣲ جَدِيدࣲۖ", "words": [{"id": 1, "arabic": "أَفَعَيِينَا", "translit": "", "root": ""}, {"id": 2, "arabic": "بِالْخَلْقِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لَاوَّلِۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 5, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "لَبْسࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 9, "arabic": "خَلْقࣲ", "translit": "", "root": ""}, {"id": 10, "arabic": "جَدِيدࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 16, "text": "وَلَقَدْ خَلَقْنَا اَ۬لِانسَٰنَ وَنَعْلَمُ مَا تُوَسْوِسُ بِهِۦ نَفْسُهُۥ وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنْ حَبْلِ اِ۬لْوَرِيدِۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لِانسَٰنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَنَعْلَمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "", "root": ""}, {"id": 6, "arabic": "تُوَسْوِسُ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 8, "arabic": "نَفْسُهُۥ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَنَحْنُ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَقْرَبُ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِلَيْهِ", "translit": "", "root": ""}, {"id": 12, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 13, "arabic": "حَبْلِ", "translit": "", "root": ""}, {"id": 14, "arabic": "اِ۬لْوَرِيدِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 17, "text": "إِذْ يَتَلَقَّي اَ۬لْمُتَلَقِّيَٰنِ عَنِ اِ۬لْيَمِينِ وَعَنِ اِ۬لشِّمَالِ قَعِيدࣱۖ", "words": [{"id": 1, "arabic": "اِ