, {"surah": 50, "ayah": 26, "text": "اِ۬لذِے جَعَلَ مَعَ اَ۬للَّهِ إِلَٰهاً اٰخَرَ فَأَلْقِيَٰهُ فِے اِ۬لْعَذَابِ اِ۬لشَّدِيدِۖ", "words": [{"id": 1, "arabic": "اِ۬لذِے", "translit": "", "root": ""}, {"id": 2, "arabic": "جَعَلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَعَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَٰهاً", "translit": "", "root": ""}, {"id": 6, "arabic": "اٰخَرَ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَأَلْقِيَٰهُ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لْعَذَابِ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لشَّدِيدِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 27, "text": "۞قَالَ قَرِينُهُۥ رَبَّنَا مَآ أَطْغَيْتُهُۥ وَلَٰكِن كَانَ فِے ضَلَٰلِۢ بَعِيدࣲۖ", "words": [{"id": 1, "arabic": "۞قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَرِينُهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبَّنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَطْغَيْتُهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَٰكِن", "translit": "", "root": ""}, {"id": 7, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "ضَلَٰلِۢ", "translit": "", "root": ""}, {"id": 10, "arabic": "بَعِيدࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 28, "text": "قَالَ لَا تَخْتَصِمُواْ لَدَيَّ وَقَدْ قَدَّمْتُ إِلَيْكُم بِالْوَعِيدِۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "", "root": ""}, {"id": 3, "arabic": "تَخْتَصِمُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَدَيَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَقَدْ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَدَّمْتُ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَيْكُم", "translit": "", "root": ""}, {"id": 8, "arabic": "بِالْوَعِيدِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 29, "text": "مَا يُبَدَّلُ اُ۬لْقَوْلُ لَدَيَّ وَمَآ أَنَا بِظَلَّٰمࣲ لِّلْعَبِيدِۖ", "words": [{"id": 1, "arabic": "مَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يُبَدَّلُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْقَوْلُ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَدَيَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "بِظَلَّٰمࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "لِّلْعَبِيدِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 30, "text": "يَوْمَ يَقُولُ لِجَهَنَّمَ هَلِ اِ۪مْتَلَأْتِ وَتَقُولُ هَلْ مِن مَّزِيدࣲۖ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَقُولُ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِجَهَنَّمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "هَلِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۪مْتَلَأْتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَتَقُولُ", "translit": "", "root": ""}, {"id": 7, "arabic": "هَلْ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "", "root": ""}, {"id": 9, "arabic": "مَّزِيدࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 31, "text": "وَأُزْلِفَتِ اِ۬لْجَنَّةُ لِلْمُتَّقِينَ غَيْرَ بَعِيدٍۖ", "words": [{"id": 1, "arabic": "وَأُزْلِفَتِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لْجَنَّةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِلْمُتَّقِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "غَيْرَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَعِيدٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 32, "text": "هَٰذَا مَا تُوعَدُو