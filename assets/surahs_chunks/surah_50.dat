: "", "root": ""}, {"id": 3, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَآءࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّبَٰرَكاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَأَنۢبَتْنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 8, "arabic": "جَنَّٰتࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَحَبَّ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لْحَصِيدِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 10, "text": "وَالنَّخْلَ بَاسِقَٰتࣲ لَّهَا طَلْعࣱ نَّضِيدࣱ‏", "words": [{"id": 1, "arabic": "وَالنَّخْلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَاسِقَٰتࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَّهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "طَلْعࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "نَّضِيدࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 11, "text": "رِّزْقاࣰ لِّلْعِبَادِۖ وَأَحْيَيْنَا بِهِۦ بَلْدَةࣰ مَّيْتاࣰۖ كَذَٰلِكَ اَ۬لْخُرُوجُۖ", "words": [{"id": 1, "arabic": "رِّزْقاࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِّلْعِبَادِۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَأَحْيَيْنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَلْدَةࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَّيْتاࣰۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "كَذَٰلِكَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لْخُرُوجُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 12, "text": "كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحࣲ وَأَصْحَٰبُ اُ۬لرَّسِّ وَثَمُودُ", "words": [{"id": 1, "arabic": "كَذَّبَتْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَبْلَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَوْمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "نُوحࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَأَصْحَٰبُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لرَّسِّ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَثَمُودُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 13, "text": "وَعَادࣱ وَفِرْعَوْنُ وَإِخْوَٰنُ لُوطࣲ‏", "words": [{"id": 1, "arabic": "وَعَادࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَفِرْعَوْنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَإِخْوَٰنُ", "translit": "", "root": ""}, {"id": 4, "arabic": "لُوطࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 14, "text": "وَأَصْحَٰبُ اُ۬لَايْكَةِ وَقَوْمُ تُبَّعࣲۖ كُلࣱّ كَذَّبَ اَ۬لرُّسُلَ فَحَقَّ وَعِيدِۦٓۖ", "words": [{"id": 1, "arabic": "وَأَصْحَٰبُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لَايْكَةِ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَقَوْمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "تُبَّعࣲۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "كُلࣱّ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَذَّبَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لرُّسُلَ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَحَقَّ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَعِيدِۦٓۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 15, "text": "أَفَعَيِينَا بِالْخَلْقِ اِ۬لَاوَّلِۖ بَلْ هُمْ فِے لَبْسࣲ مِّنْ خَلْقࣲ جَدِيدࣲۖ", "words": [{"id": 1, "arabic": "أَفَعَيِينَا", "translit": "", "root": ""}, {"id": 2, "arabic": "بِالْخَلْقِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لَاوَّلِۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 5, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "لَبْسࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 9, "arabic": "خَلْقࣲ", "translit": "", "root": ""}, {"id": 10, "arabic": "جَدِيدࣲۖ", "translit": "", "r