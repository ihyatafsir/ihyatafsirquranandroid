, "translit": "", "root": ""}, {"id": 4, "arabic": "قَوْلٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "لَدَيْهِ", "translit": "", "root": ""}, {"id": 7, "arabic": "رَقِيبٌ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَتِيدࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 19, "text": "وَجَآءَتْ سَكْرَةُ اُ۬لْمَوْتِ بِالْحَقِّۖ ذَٰلِكَ مَا كُنتَ مِنْهُ تَحِيدُۖ", "words": [{"id": 1, "arabic": "وَجَآءَتْ", "translit": "", "root": ""}, {"id": 2, "arabic": "سَكْرَةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْمَوْتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِالْحَقِّۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "", "root": ""}, {"id": 7, "arabic": "كُنتَ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِنْهُ", "translit": "", "root": ""}, {"id": 9, "arabic": "تَحِيدُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 20, "text": "وَنُفِخَ فِے اِ۬لصُّورِۖ ذَٰلِكَ يَوْمُ اُ۬لْوَعِيدِۖ", "words": [{"id": 1, "arabic": "وَنُفِخَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لصُّورِۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَوْمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لْوَعِيدِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 21, "text": "وَجَآءَتْ كُلُّ نَفْسࣲ مَّعَهَا سَآئِقࣱ وَشَهِيدࣱۖ", "words": [{"id": 1, "arabic": "وَجَآءَتْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كُلُّ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَفْسࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَّعَهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "سَآئِقࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَشَهِيدࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 22, "text": "لَّقَدْ كُنتَ فِے غَفْلَةࣲ مِّنْ هَٰذَا فَكَشَفْنَا عَنكَ غِطَآءَكَ فَبَصَرُكَ اَ۬لْيَوْمَ حَدِيدࣱۖ", "words": [{"id": 1, "arabic": "لَّقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كُنتَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "غَفْلَةࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 6, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 7, "arabic": "فَكَشَفْنَا", "translit": "", "root": ""}, {"id": 8, "arabic": "عَنكَ", "translit": "", "root": ""}, {"id": 9, "arabic": "غِطَآءَكَ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَبَصَرُكَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لْيَوْمَ", "translit": "", "root": ""}, {"id": 12, "arabic": "حَدِيدࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 23, "text": "وَقَالَ قَرِينُهُۥ هَٰذَا مَا لَدَيَّ عَتِيدٌۖ", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَرِينُهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "لَدَيَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَتِيدٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 24, "text": "اَلْقِيَا فِے جَهَنَّمَ كُلَّ كَفّ۪ارٍ عَنِيدࣲ‏", "words": [{"id": 1, "arabic": "اَلْقِيَا", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "جَهَنَّمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "كُلَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "كَفّ۪ارٍ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَنِيدࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 25, "text": "مَّنَّاعࣲ لِّلْخَيْرِ مُعْتَدࣲ مُّرِيبٍ", "words": [{"id": 1, "arabic": "مَّن