: "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَسْمَعُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لصَّيْحَةَ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِالْحَقِّۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَوْمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْخُرُوجِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 43, "text": "إِنَّا نَحْنُ نُحْيِۦ وَنُمِيتُ وَإِلَيْنَا اَ۬لْمَصِيرُۖ", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "نُحْيِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَنُمِيتُ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَإِلَيْنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْمَصِيرُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 44, "text": "يَوْمَ تَشَّقَّقُ اُ۬لَارْضُ عَنْهُمْ سِرَاعاࣰۖ ذَٰلِكَ حَشْرٌ عَلَيْنَا يَسِيرࣱۖ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَشَّقَّقُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لَارْضُ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَنْهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "سِرَاعاࣰۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "حَشْرٌ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَلَيْنَا", "translit": "", "root": ""}, {"id": 9, "arabic": "يَسِيرࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 45, "text": "نَّحْنُ أَعْلَمُ بِمَا يَقُولُونَۖ وَمَآ أَنتَ عَلَيْهِم بِجَبّ۪ارࣲۖ فَذَكِّرْ بِالْقُرْءَانِ مَنْ يَّخَافُ وَعِيدِۦۖ", "words": [{"id": 1, "arabic": "نَّحْنُ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَعْلَمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِمَا", "translit": "", "root": ""}, {"