nslit": "", "root": ""}, {"id": 8, "arabic": "عَتِيدࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 19, "text": "وَجَآءَتْ سَكْرَةُ اُ۬لْمَوْتِ بِالْحَقِّۖ ذَٰلِكَ مَا كُنتَ مِنْهُ تَحِيدُۖ", "words": [{"id": 1, "arabic": "وَجَآءَتْ", "translit": "", "root": ""}, {"id": 2, "arabic": "سَكْرَةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْمَوْتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِالْحَقِّۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "", "root": ""}, {"id": 7, "arabic": "كُنتَ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِنْهُ", "translit": "", "root": ""}, {"id": 9, "arabic": "تَحِيدُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 20, "text": "وَنُفِخَ فِے اِ۬لصُّورِۖ ذَٰلِكَ يَوْمُ اُ۬لْوَعِيدِۖ", "words": [{"id": 1, "arabic": "وَنُفِخَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لصُّورِۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَوْمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لْوَعِيدِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 21, "text": "وَجَآءَتْ كُلُّ نَفْسࣲ مَّعَهَا سَآئِقࣱ وَشَهِيدࣱۖ", "words": [{"id": 1, "arabic": "وَجَآءَتْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كُلُّ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَفْسࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَّعَهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "سَآئِقࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَشَهِيدࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 22, "text": "لَّقَدْ كُنتَ فِے غَفْلَةࣲ مِّنْ هَٰذَا فَكَشَفْنَا عَنكَ غِطَآءَكَ فَبَصَرُكَ اَ۬لْيَوْمَ حَدِيدࣱۖ", "words": [{"id": 1, "arabic": "لَّقَدْ", "translit": "", "root": ""}, {"id"