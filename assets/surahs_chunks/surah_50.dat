مُۥٓ أَشَدُّ مِنْهُم بَطْشاࣰ فَنَقَّبُواْ فِے اِ۬لْبِلَٰدِۖ هَلْ مِن مَّحِيصٍۖ", "words": [{"id": 1, "arabic": "وَكَمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَهْلَكْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "قَبْلَهُم", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 5, "arabic": "قَرْنٍ", "translit": "", "root": ""}, {"id": 6, "arabic": "هُمُۥٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَشَدُّ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِنْهُم", "translit": "", "root": ""}, {"id": 9, "arabic": "بَطْشاࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَنَقَّبُواْ", "translit": "", "root": ""}, {"id": 11, "arabic": "فِے", "translit": "", "root": ""}, {"id": 12, "arabic": "اِ۬لْبِلَٰدِۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "هَلْ", "translit": "", "root": ""}, {"id": 14, "arabic": "مِن", "translit": "", "root": ""}, {"id": 15, "arabic": "مَّحِيصٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 37, "text": "اِنَّ فِے ذَٰلِكَ لَذِكْر۪يٰ لِمَن كَانَ لَهُۥ قَلْبٌ اَوَ اَلْقَي اَ۬لسَّمْعَ وَهُوَ شَهِيدࣱۖ", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَذِكْر۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِمَن", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 8, "arabic": "قَلْبٌ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَوَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَلْقَي", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لسَّمْعَ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 13, "arabic": "شَهِيدࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 38, "text": "وَلَقَدْ خَلَقْنَا اَ۬لسَّمَٰوَٰتِ وَالَارْضَ وَمَا بَيْنَهُمَا فِے سِتَّةِ أَيَّامࣲ وَمَا مَسَّنَا مِن لُّغُوبࣲۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "بَيْنَهُمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "سِتَّةِ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَيَّامࣲ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 11, "arabic": "مَسَّنَا", "translit": "", "root": ""}, {"id": 12, "arabic": "مِن", "translit": "", "root": ""}, {"id": 13, "arabic": "لُّغُوبࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 39, "text": "فَاصْبِرْ عَلَيٰ مَا يَقُولُونَۖ وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ اِ۬لشَّمْسِ وَقَبْلَ اَ۬لْغُرُوبِۖ", "words": [{"id": 1, "arabic": "فَاصْبِرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يَقُولُونَۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَسَبِّحْ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِحَمْدِ", "translit": "", "root": ""}, {"id": 7, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 8, "arabic": "قَبْلَ", "translit": "", "root": ""}, {"id": 9, "arabic": "طُلُوعِ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لشَّمْسِ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَقَبْلَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬لْغُرُوبِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 40, "text": "وَمِنَ اَ۬ليْلِ فَسَبِّحْهُ وَإِدْبَٰرَ اَ۬لسُّجُودِۖ", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬ليْلِ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَسَبِّحْهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَإِدْبَٰرَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لسُّجُودِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 41, "text": "وَاسْتَمِعْ يَوْمَ يُنَادِ اِ۬لْمُنَادِۦ مِن مَّكَانࣲ قَرِيبࣲ‏", "words": [{"id": 1, "arabic": "وَاسْتَمِعْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يُنَادِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْمُنَادِۦ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "مَّكَانࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَرِيبࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 42, "text": "يَوْمَ يَسْمَعُونَ اَ۬لصَّيْحَةَ بِالْحَقِّۖ ذَٰلِكَ يَوْمُ اُ۬لْخُرُوجِۖ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَسْمَعُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لصَّيْحَةَ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِالْحَقِّۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَوْمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْخُرُوجِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 43, "text": "إِنَّا نَحْنُ نُحْيِۦ وَنُمِيتُ وَإِلَيْنَا اَ۬لْمَصِيرُۖ", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "نُحْيِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَنُمِيتُ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَإِلَيْنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْمَصِيرُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 44, "text": "يَوْمَ تَشَّ