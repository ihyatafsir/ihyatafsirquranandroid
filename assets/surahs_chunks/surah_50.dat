lit": "", "root": ""}, {"id": 6, "arabic": "رَجْعُۢ", "translit": "", "root": ""}, {"id": 7, "arabic": "بَعِيدࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 4, "text": "قَدْ عَلِمْنَا مَا تَنقُصُ اُ۬لَارْضُ مِنْهُمْ وَعِندَنَا كِتَٰبٌ حَفِيظُۢۖ", "words": [{"id": 1, "arabic": "قَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلِمْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "تَنقُصُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لَارْضُ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِنْهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَعِندَنَا", "translit": "", "root": ""}, {"id": 8, "arabic": "كِتَٰبٌ", "translit": "", "root": ""}, {"id": 9, "arabic": "حَفِيظُۢۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 5, "text": "بَلْ كَذَّبُواْ بِالْحَقِّ لَمَّا جَآءَهُمْ فَهُمْ فِےٓ أَمْرࣲ مَّرِيجٍۖ", "words": [{"id": 1, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَذَّبُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِالْحَقِّ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَمَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "جَآءَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَمْرࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَّرِيجٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 6, "text": "اَفَلَمْ يَنظُرُوٓاْ إِلَي اَ۬لسَّمَآءِ فَوْقَهُمْ كَيْفَ بَنَيْنَٰهَا وَزَيَّنَّٰهَا وَمَا لَهَا مِن فُرُوجࣲۖ", "words": [{"id": 1, "arabic": "اَفَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَنظُرُوٓاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَوْقَهُمْ", "translit":