": "", "root": ""}, {"id": 3, "arabic": "تَخْتَصِمُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَدَيَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَقَدْ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَدَّمْتُ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَيْكُم", "translit": "", "root": ""}, {"id": 8, "arabic": "بِالْوَعِيدِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 29, "text": "مَا يُبَدَّلُ اُ۬لْقَوْلُ لَدَيَّ وَمَآ أَنَا بِظَلَّٰمࣲ لِّلْعَبِيدِۖ", "words": [{"id": 1, "arabic": "مَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يُبَدَّلُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْقَوْلُ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَدَيَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "بِظَلَّٰمࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "لِّلْعَبِيدِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 30, "text": "يَوْمَ يَقُولُ لِجَهَنَّمَ هَلِ اِ۪مْتَلَأْتِ وَتَقُولُ هَلْ مِن مَّزِيدࣲۖ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَقُولُ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِجَهَنَّمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "هَلِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۪مْتَلَأْتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَتَقُولُ", "translit": "", "root": ""}, {"id": 7, "arabic": "هَلْ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "", "root": ""}, {"id": 9, "arabic": "مَّزِيدࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 50, "ayah": 31, "text": "وَأُزْلِفَتِ اِ۬لْجَنَّةُ لِلْمُتَّقِينَ غَيْرَ بَعِيدٍۖ", "words": [{"id": 1, "arabic": "وَأُزْلِفَتِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لْجَنَّةُ", "translit": "", "root": ""}, {"id": 3, "arabic": 