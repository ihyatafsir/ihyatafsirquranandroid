11165], [9, 11165, 11760], [10, 11760, 13970]], "78:37": [[1, 200, 918], [2, 918, 2755], [3, 2755, 4232], [4, 4232, 5483], [5, 5483, 7165], [6, 7165, 8601], [7, 8601, 9360], [8, 9360, 11165], [9, 11165, 11760], [10, 11760, 13970]], "38": [[1, 1600, 2788], [2, 2788, 4452], [3, 4452, 6021], [4, 6021, 8957], [5, 8957, 10312], [6, 10312, 11370], [7, 11370, 13878], [8, 13878, 15221], [9, 15221, 15696], [10, 15696, 16480], [11, 16480, 16932], [12, 16932, 18596], [13, 18596, 20331], [14, 20331, 23190]], "78:38": [[1, 1600, 2788], [2, 2788, 4452], [3, 4452, 6021], [4, 6021, 8957], [5, 8957, 10312], [6, 10312, 11370], [7, 11370, 13878], [8, 13878, 15221], [9, 15221, 15696], [10, 15696, 16480], [11, 16480, 16932], [12, 16932, 18596], [13, 18596, 20331], [14, 20331, 23190]], "39": [[1, 510, 1528], [2, 1528, 3152], [3, 3152, 4316], [4, 4316, 5083], [5, 5083, 7666], [6, 7666, 8778], [7, 8778, 10077], [8, 10077, 11010], [9, 11010, 13460]], "78:39": [[1, 510, 1528], [2, 1528, 3152], [3, 3152, 4316], [4, 4316, 5083], [5, 5083, 7666], [6, 7666, 8778], [7, 8778, 10077], [8, 10077, 11010], [9, 11010, 13460]], "40": [[1, 10, 3619], [2, 3619, 6161], [3, 6161, 8907], [4, 8907, 11512], [5, 11512, 13081], [6, 13081, 14854], [7, 14854, 16156], [8, 16156, 17317], [9, 17317, 18870], [10, 18870, 21067], [11, 21067, 24017], [12, 24017, 26229], [13, 26229, 29078], [14, 29078, 30019], [15, 30019, 32680]], "78:40": [[1, 10, 3619], [2, 3619, 6161], [3, 6161, 8907], [4, 8907, 11512], [5, 11512, 13081], [6, 13081, 14854], [7, 14854, 16156], [8, 16156, 17317], [9, 17317, 18870], [10, 18870, 21067], [11, 21067, 24017], [12, 24017, 26229], [13, 26229, 29078], [14, 29078, 30019], [15, 30019, 32680]]}, "abdulbasit": {"1": [[1, 500, 1970], [2, 1980, 5190]], "78:1": [[1, 500, 1970], [2, 1980, 5190]], "2": [[1, 500, 1050], [2, 1060, 2360], [3, 2370, 3510]], "78:2": [[1, 500, 1050], [2, 1060, 2360], [3, 2370, 3510]], "3": [[1, 500, 1480], [2, 1490, 1880], [3, 1890, 2640], [4, 2650, 4400]], "78:3": [[1, 500, 1