 [[1, 10, 1063], [2, 1063, 3011], [3, 3011, 3746], [4, 3746, 5296], [5, 5296, 7400]], "28": [[1, 200, 2337], [2, 2337, 4485], [3, 4485, 6600]], "29": [[1, 20, 1369], [2, 1369, 2312], [3, 2312, 4368], [4, 4368, 6590]], "30": [[1, 10, 2199], [2, 2199, 2807], [3, 2807, 4550], [4, 4550, 5695], [5, 5695, 7870]], "31": [[1, 200, 1067], [2, 1067, 3452], [3, 3452, 6100]], "32": [[1, 30, 2684], [2, 2684, 5260]], "33": [[1, 350, 2189], [2, 2189, 4170]], "34": [[1, 200, 2082], [2, 2082, 4430]], "35": [[1, 200, 1054], [2, 1054, 2810], [3, 2810, 4153], [4, 4153, 5544], [5, 5544, 6714], [6, 6714, 8660]], "36": [[1, 20, 2566], [2, 2566, 3314], [3, 3314, 4365], [4, 4365, 7028], [5, 7028, 9500]], "37": [[1, 200, 918], [2, 918, 2755], [3, 2755, 4232], [4, 4232, 5483], [5, 5483, 7165], [6, 7165, 8601], [7, 8601, 9360], [8, 9360, 11165], [9, 11165, 11760], [10, 11760, 13970]], "38": [[1, 1600, 2788], [2, 2788, 4452], [3, 4452, 6021], [4, 6021, 8957], [5, 8957, 10312], [6, 10312, 11370], [7, 11370, 13878], [8, 13878, 15221], [9, 15221, 15696], [10, 15696, 16480], [11, 16480, 16932], [12, 16932, 18596], [13, 18596, 20331], [14, 20331, 23190]], "39": [[1, 510, 1528], [2, 1528, 3152], [3, 3152, 4316], [4, 4316, 5083], [5, 5083, 7666], [6, 7666, 8778], [7, 8778, 10077], [8, 10077, 11010], [9, 11010, 13460]], "40": [[1, 10, 3619], [2, 3619, 6161], [3, 6161, 8907], [4, 8907, 11512], [5, 11512, 13081], [6, 13081, 14854], [7, 14854, 16156], [8, 16156, 17317], [9, 17317, 18870], [10, 18870, 21067], [11, 21067, 24017], [12, 24017, 26229], [13, 26229, 29078], [14, 29078, 30019], [15, 30019, 32680]]}, "abdulbasit_warsh": {"78:1": [[1, 600, 1808], [2, 1808, 7792]], "1": [[1, 600, 1808], [2, 1808, 7792]], "78:2": [[1, 506, 960], [2, 960, 2887], [3, 2887, 5624]], "2": [[1, 506, 960], [2, 960, 2887], [3, 2887, 5624]], "78:3": [[1, 544, 1710], [2, 1710, 2154], [3, 2154, 2913], [4, 2913, 6042]], "3": [[1, 544, 1710], [2, 1710, 2154], [3, 2154, 2913], [4, 2913, 6042]], "78:4": [[1, 415, 1495], [2, 1495, 4