ٰدِلُوٓاْ أَهْلَ اَ۬لْكِتَٰبِ إِلَّا بِالتِے هِيَ أَحْسَنُۖ إِلَّا اَ۬لذِينَ ظَلَمُواْ مِنْهُمْۖ وَقُولُوٓاْ ءَامَنَّا بِالذِےٓ أُنزِلَ إِلَيْنَا وَأُنزِلَ إِلَيْكُمْ وَإِلَٰهُنَا وَإِلَٰهُكُمْ وَٰحِدࣱ وَنَحْنُ لَهُۥ مُسْلِمُونَۖ", "words": [{"id": 1, "arabic": "۞وَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تُجَٰدِلُوٓاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَهْلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْكِتَٰبِ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "بِالتِے", "translit": "", "root": ""}, {"id": 7, "arabic": "هِيَ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَحْسَنُۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 11, "arabic": "ظَلَمُواْ", "translit": "", "root": ""}, {"id": 12, "arabic": "مِنْهُمْۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَقُولُوٓاْ", "translit": "", "root": ""}, {"id": 14, "arabic": "ءَامَنَّا", "translit": "", "root": ""}, {"id": 15, "arabic": "بِالذِےٓ", "translit": "", "root": ""}, {"id": 16, "arabic": "أُنزِلَ", "translit": "", "root": ""}, {"id": 17, "arabic": "إِلَيْنَا", "translit": "", "root": ""}, {"id": 18, "arabic": "وَأُنزِلَ", "translit": "", "root": ""}, {"id": 19, "arabic": "إِلَيْكُمْ", "translit": "", "root": ""}, {"id": 20, "arabic": "وَإِلَٰهُنَا", "translit": "", "root": ""}, {"id": 21, "arabic": "وَإِلَٰهُكُمْ", "translit": "", "root": ""}, {"id": 22, "arabic": "وَٰحِدࣱ", "translit": "", "root": ""}, {"id": 23, "arabic": "وَنَحْنُ", "translit": "", "root": ""}, {"id": 24, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 25, "arabic": "مُسْلِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 47, "text": "وَكَذَٰلِكَ أَنزَلْنَآ إِلَيْكَ اَ۬لْكِتَٰبَۖ فَالذِينَ ءَاتَيْنَٰهُمُ اُ۬لْكِتَٰبَ يُومِنُونَ بِهِۦ وَمِنْ هَٰٓؤُلَآ