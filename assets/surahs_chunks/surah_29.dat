: "وَوَهَبْنَا لَهُۥٓ إِسْحَٰقَ وَيَعْقُوبَۖ وَجَعَلْنَا فِے ذُرِّيَّتِهِ اِ۬لنُّبُوٓءَةَ وَالْكِتَٰبَۖ وَءَاتَيْنَٰهُ أَجْرَهُۥ فِے اِ۬لدُّنْي۪اۖ وَإِنَّهُۥ فِے اِ۬لَاخِرَةِ لَمِنَ اَ۬لصَّٰلِحِينَۖ", "words": [{"id": 1, "arabic": "وَوَهَبْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِسْحَٰقَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَيَعْقُوبَۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَجَعَلْنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "ذُرِّيَّتِهِ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لنُّبُوٓءَةَ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَالْكِتَٰبَۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَءَاتَيْنَٰهُ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَجْرَهُۥ", "translit": "", "root": ""}, {"id": 12, "arabic": "فِے", "translit": "", "root": ""}, {"id": 13, "arabic": "اِ۬لدُّنْي۪اۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَإِنَّهُۥ", "translit": "", "root": ""}, {"id": 15, "arabic": "فِے", "translit": "", "root": ""}, {"id": 16, "arabic": "اِ۬لَاخِرَةِ", "translit": "", "root": ""}, {"id": 17, "arabic": "لَمِنَ", "translit": "", "root": ""}, {"id": 18, "arabic": "اَ۬لصَّٰلِحِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 28, "text": "وَلُوطاً اِذْ قَالَ لِقَوْمِهِۦٓ إِنَّكُمْ لَتَاتُونَ اَ۬لْفَٰحِشَةَ مَا سَبَقَكُم بِهَا مِنَ اَحَدࣲ مِّنَ اَ۬لْعَٰلَمِينَ", "words": [{"id": 1, "arabic": "وَلُوطاً", "translit": "", "root": ""}, {"id": 2, "arabic": "اِذْ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِقَوْمِهِۦٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنَّكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَتَاتُونَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْفَٰحِشَةَ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَا", "translit": "", "root": ""}, {"id": 9, "arabic": "سَبَقَكُم", "translit": "", "root": ""}, {"id": 10, "arabic": "بِهَا", "translit": "", "root": ""}, {"id": 11, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَحَدࣲ", "translit": "", "root": ""}, {"id": 13, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 14, "arabic": "اَ۬لْعَٰلَمِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 29, "text": "أَئِنَّكُمْ لَتَاتُونَ اَ۬لرِّجَالَ وَتَقْطَعُونَ اَ۬لسَّبِيلَ وَتَاتُونَ فِے نَادِيكُمُ اُ۬لْمُنكَرَۖ فَمَا كَانَ جَوَابَ قَوْمِهِۦٓ إِلَّآ أَن قَالُواْ اُ۪يتِنَا بِعَذَابِ اِ۬للَّهِ إِن كُنتَ مِنَ اَ۬لصَّٰدِقِينَۖ", "words": [{"id": 1, "arabic": "أَئِنَّكُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَتَاتُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لرِّجَالَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَتَقْطَعُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لسَّبِيلَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَتَاتُونَ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "نَادِيكُمُ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬لْمُنكَرَۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 11, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 12, "arabic": "جَوَابَ", "translit": "", "root": ""}, {"id": 13, "arabic": "قَوْمِهِۦٓ", "translit": "", "root": ""}, {"id": 14, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 15, "arabic": "أَن", "translit": "", "root": ""}, {"id": 16, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 17, "arabic": "اُ۪يتِنَا", "translit": "", "root": ""}, {"id": 18, "arabic": "بِعَذَابِ", "translit": "", "root": ""}, {"id": 19, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 20, "arabic": "إِن", "translit": "", "root": ""}, {"id": 21, "arabic": "كُنتَ", "translit": "", "root": ""}, {"id": 22, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 23, "arabic": "اَ۬لصَّٰدِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 30, "text": "قَالَ رَبِّ اِ۟نصُرْنِے عَلَي اَ۬لْقَوْمِ اِ۬لْمُفْسِدِينَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۟نصُرْنِے", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْقَوْمِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لْمُفْسِدِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 31, "text": "وَلَمَّا جَآءَتْ رُسُلُنَآ إِبْرَٰهِيمَ بِالْبُشْر۪يٰ قَالُوٓاْ إِنَّا مُهْلِكُوٓاْ أَهْلِ هَٰذِهِ اِ۬لْقَرْيَةِ إِنَّ أَهْلَهَا كَانُواْ ظَٰلِمِينَۖ", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَآءَتْ", "translit": "", "root": ""}, {"id": 3, "arabic": "رُسُلُنَآ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِبْرَٰهِيمَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِالْبُشْر۪يٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "مُهْلِكُوٓاْ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَهْلِ", "translit": "", "root": ""}, {"id": 10, "arabic": "هَٰذِهِ", "translit": "", "root": ""}, {"id": 11, "arabic": "اِ۬لْقَرْيَةِ", "translit": "", "root": ""}, {"id": 12, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 13, "arabic": "أَهْلَهَا", "translit": "", "root": ""}, {"id": 14, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 15, "arabic": "ظَٰلِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 32, "text": "قَالَ إِنَّ فِيهَا لُوطاࣰۖ قَالُواْ نَحْنُ أَعْلَمُ بِمَن فِيهَاۖ لَنُنَجِّيَنَّهُۥ وَأَهْلَهُۥٓ إِلَّا اَ۪مْرَأَتَهُۥ كَانَتْ 