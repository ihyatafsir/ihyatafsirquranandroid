id": 3, "arabic": "وَأَثْقَالاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَّعَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَثْقَالِهِمْۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَيُسْـَٔلُنَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لْقِيَٰمَةِ", "translit": "", "root": ""}, {"id": 9, "arabic": "عَمَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 11, "arabic": "يَفْتَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 14, "text": "وَلَقَدَ اَرْسَلْنَا نُوحاً اِلَيٰ قَوْمِهِۦ فَلَبِثَ فِيهِمُۥٓ أَلْفَ سَنَةٍ اِلَّا خَمْسِينَ عَاماࣰ فَأَخَذَهُمُ اُ۬لطُّوفَانُ وَهُمْ ظَٰلِمُونَۖ", "words": [{"id": 1, "arabic": "وَلَقَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَرْسَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "نُوحاً", "translit": "", "root": ""}, {"id": 4, "arabic": "اِلَيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَوْمِهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَلَبِثَ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِيهِمُۥٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَلْفَ", "translit": "", "root": ""}, {"id": 9, "arabic": "سَنَةٍ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 11, "arabic": "خَمْسِينَ", "translit": "", "root": ""}, {"id": 12, "arabic": "عَاماࣰ", "translit": "", "root": ""}, {"id": 13, "arabic": "فَأَخَذَهُمُ", "translit": "", "root": ""}, {"id": 14, "arabic": "اُ۬لطُّوفَانُ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 16, "arabic": "ظَٰلِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 15, "text": "فَأَنجَيْنَٰهُ وَأَصْحَٰبَ اَ۬لسَّفِينَةِۖ وَجَعَلْنَٰهَآ ءَايَةࣰ لِّلْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "فَأَنجَيْنَٰهُ", "translit": "", "root"