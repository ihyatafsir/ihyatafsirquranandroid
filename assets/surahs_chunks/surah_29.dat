it": "", "root": ""}, {"id": 6, "arabic": "وَٰسِعَةࣱ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَإِيَّٰيَ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَاعْبُدُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 57, "text": "كُلُّ نَفْسࣲ ذَآئِقَةُ اُ۬لْمَوْتِۖ ثُمَّ إِلَيْنَا تُرْجَعُونَۖ", "words": [{"id": 1, "arabic": "كُلُّ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَفْسࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "ذَآئِقَةُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْمَوْتِۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِلَيْنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "تُرْجَعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 58, "text": "وَالذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَنُبَوِّئَنَّهُم مِّنَ اَ۬لْجَنَّةِ غُرَفاࣰ تَجْرِے مِن تَحْتِهَا اَ۬لَانْهَٰرُ خَٰلِدِينَ فِيهَاۖ نِعْمَ أَجْرُ اُ۬لْعَٰمِلِينَۖ", "words": [{"id": 1, "arabic": "وَالذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَعَمِلُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لصَّٰلِحَٰتِ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَنُبَوِّئَنَّهُم", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْجَنَّةِ", "translit": "", "root": ""}, {"id": 8, "arabic": "غُرَفاࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "تَجْرِے", "translit": "", "root": ""}, {"id": 10, "arabic": "مِن", "translit": "", "root": ""}, {"id": 11, "arabic": "تَحْتِهَا", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬لَانْهَٰرُ", "translit": "", "root": ""}, {"id": 13, "arabic": "خَٰلِدِينَ", "translit": "", "root": ""}, {"id": 14, "arabic": "فِيهَاۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "نِعْمَ", "translit": "", "root": ""}, {"id": 16, "arabic"