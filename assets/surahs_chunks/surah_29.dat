ic": "مَا", "translit": "", "root": ""}, {"id": 10, "arabic": "يَحْكُمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 5, "text": "مَن كَانَ يَرْجُواْ لِقَآءَ اَ۬للَّهِ فَإِنَّ أَجَلَ اَ۬للَّهِ لَأٓتࣲۖ وَهُوَ اَ۬لسَّمِيعُ اُ۬لْعَلِيمُۖ", "words": [{"id": 1, "arabic": "مَن", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَرْجُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِقَآءَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَإِنَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَجَلَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَأٓتࣲۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لسَّمِيعُ", "translit": "", "root": ""}, {"id": 12, "arabic": "اُ۬لْعَلِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 6, "text": "وَمَن جَٰهَدَ فَإِنَّمَا يُجَٰهِدُ لِنَفْسِهِۦٓۖ إِنَّ اَ۬للَّهَ لَغَنِيٌّ عَنِ اِ۬لْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "وَمَن", "translit": "", "root": ""}, {"id": 2, "arabic": "جَٰهَدَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَإِنَّمَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يُجَٰهِدُ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِنَفْسِهِۦٓۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَغَنِيٌّ", "translit": "", "root": ""}, {"id": 9, "arabic": "عَنِ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لْعَٰلَمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 7, "text": "وَالذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَنُكَفِّرَنَّ عَنْهُمْ سَيِّـَٔاتِهِمْ وَلَنَجْزِيَنَّهُمُۥٓ أَحْسَنَ اَ۬لذِے كَ