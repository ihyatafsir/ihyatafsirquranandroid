c": "اُ۬لْحَكِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 43, "text": "وَتِلْكَ اَ۬لَامْثَٰلُ نَضْرِبُهَا لِلنَّاسِۖ وَمَا يَعْقِلُهَآ إِلَّا اَ۬لْعَٰلِمُونَۖ", "words": [{"id": 1, "arabic": "وَتِلْكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لَامْثَٰلُ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَضْرِبُهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "لِلنَّاسِۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "يَعْقِلُهَآ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لْعَٰلِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 44, "text": "خَلَقَ اَ۬للَّهُ اُ۬لسَّمَٰوَٰتِ وَالَارْضَ بِالْحَقِّۖ إِنَّ فِے ذَٰلِكَ لَأٓيَةࣰ لِّلْمُومِنِينَۖ", "words": [{"id": 1, "arabic": "خَلَقَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِالْحَقِّۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَأٓيَةࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "لِّلْمُومِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 45, "text": "اَ۟تْلُ مَآ أُوحِيَ إِلَيْكَ مِنَ اَ۬لْكِتَٰبِ وَأَقِمِ اِ۬لصَّلَوٰةَۖ إِنَّ اَ۬لصَّلَوٰةَ تَنْه۪يٰ عَنِ اِ۬لْفَحْشَآءِ وَالْمُنكَرِۖ وَلَذِكْرُ اُ۬للَّهِ أَكْبَرُۖ وَاللَّهُ يَعْلَمُ مَا تَصْنَعُونَۖ", "words": [{"id": 1, "arabic": "اَ۟تْلُ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُوحِيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَيْكَ