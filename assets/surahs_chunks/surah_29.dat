"}, {"surah": 29, "ayah": 42, "text": "إِنَّ اَ۬للَّهَ يَعْلَمُ مَا تَدْعُونَ مِن دُونِهِۦ مِن شَےْءࣲۖ وَهُوَ اَ۬لْعَزِيزُ اُ۬لْحَكِيمُۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَعْلَمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "تَدْعُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِن", "translit": "", "root": ""}, {"id": 7, "arabic": "دُونِهِۦ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "", "root": ""}, {"id": 9, "arabic": "شَےْءࣲۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لْعَزِيزُ", "translit": "", "root": ""}, {"id": 12, "arabic": "اُ۬لْحَكِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 43, "text": "وَتِلْكَ اَ۬لَامْثَٰلُ نَضْرِبُهَا لِلنَّاسِۖ وَمَا يَعْقِلُهَآ إِلَّا اَ۬لْعَٰلِمُونَۖ", "words": [{"id": 1, "arabic": "وَتِلْكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لَامْثَٰلُ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَضْرِبُهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "لِلنَّاسِۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "يَعْقِلُهَآ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لْعَٰلِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 44, "text": "خَلَقَ اَ۬للَّهُ اُ۬لسَّمَٰوَٰتِ وَالَارْضَ بِالْحَقِّۖ إِنَّ فِے ذَٰلِكَ لَأٓيَةࣰ لِّلْمُومِنِينَۖ", "words": [{"id": 1, "arabic": "خَلَقَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِالْحَقِّۖ