ن شَےْءٍۖ اِنَّهُمْ لَكَٰذِبُونَۖ", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِلذِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۪تَّبِعُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "سَبِيلَنَا", "translit": "", "root": ""}, {"id": 8, "arabic": "وَلْنَحْمِلْ", "translit": "", "root": ""}, {"id": 9, "arabic": "خَطَٰيٰ۪كُمْۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 11, "arabic": "هُم", "translit": "", "root": ""}, {"id": 12, "arabic": "بِحَٰمِلِينَ", "translit": "", "root": ""}, {"id": 13, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 14, "arabic": "خَطَٰيٰ۪هُم", "translit": "", "root": ""}, {"id": 15, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 16, "arabic": "شَےْءٍۖ", "translit": "", "root": ""}, {"id": 17, "arabic": "اِنَّهُمْ", "translit": "", "root": ""}, {"id": 18, "arabic": "لَكَٰذِبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 13, "text": "وَلَيَحْمِلُنَّ أَثْقَالَهُمْ وَأَثْقَالاࣰ مَّعَ أَثْقَالِهِمْۖ وَلَيُسْـَٔلُنَّ يَوْمَ اَ۬لْقِيَٰمَةِ عَمَّا كَانُواْ يَفْتَرُونَۖ", "words": [{"id": 1, "arabic": "وَلَيَحْمِلُنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَثْقَالَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَأَثْقَالاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَّعَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَثْقَالِهِمْۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَيُسْـَٔلُنَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لْقِيَٰمَةِ", "translit": "", "root": ""}, {"id": 9, "arabic": "عَمَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 11, "arabic": "يَفْتَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 14, "text": "وَلَقَدَ اَرْسَلْنَا نُوحاً اِلَيٰ قَوْمِهِۦ فَلَبِثَ فِيهِمُۥٓ أَلْفَ سَنَةٍ اِلَّا خَمْسِينَ عَاماࣰ فَأَخَذَهُمُ اُ۬لطُّوفَانُ وَهُمْ ظَٰلِمُونَۖ", "words": [{"id": 1, "arabic": "وَلَقَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَرْسَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "نُوحاً", "translit": "", "root": ""}, {"id": 4, "arabic": "اِلَيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَوْمِهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَلَبِثَ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِيهِمُۥٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَلْفَ", "translit": "", "root": ""}, {"id": 9, "arabic": "سَنَةٍ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 11, "arabic": "خَمْسِينَ", "translit": "", "root": ""}, {"id": 12, "arabic": "عَاماࣰ", "translit": "", "root": ""}, {"id": 13, "arabic": "فَأَخَذَهُمُ", "translit": "", "root": ""}, {"id": 14, "arabic": "اُ۬لطُّوفَانُ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 16, "arabic": "ظَٰلِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 15, "text": "فَأَنجَيْنَٰهُ وَأَصْحَٰبَ اَ۬لسَّفِينَةِۖ وَجَعَلْنَٰهَآ ءَايَةࣰ لِّلْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "فَأَنجَيْنَٰهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَأَصْحَٰبَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لسَّفِينَةِۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَجَعَلْنَٰهَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "ءَايَةࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "لِّلْعَٰلَمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 16, "text": "وَإِبْرَٰهِيمَ إِذْ قَالَ لِقَوْمِهِ اِ۟عْبُدُواْ اُ۬للَّهَ وَاتَّقُوهُۖ ذَٰلِكُمْ خَيْرࣱ ل