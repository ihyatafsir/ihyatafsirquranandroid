 16, "arabic": "إِلَيَّ", "translit": "", "root": ""}, {"id": 17, "arabic": "مَرْجِعُكُمْ", "translit": "", "root": ""}, {"id": 18, "arabic": "فَأُنَبِّئُكُم", "translit": "", "root": ""}, {"id": 19, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 20, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 21, "arabic": "تَعْمَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 9, "text": "وَالذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَنُدْخِلَنَّهُمْ فِے اِ۬لصَّٰلِحِينَۖ", "words": [{"id": 1, "arabic": "وَالذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَعَمِلُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لصَّٰلِحَٰتِ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَنُدْخِلَنَّهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لصَّٰلِحِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 10, "text": "وَمِنَ اَ۬لنَّاسِ مَنْ يَّقُولُ ءَامَنَّا بِاللَّهِ فَإِذَآ أُوذِيَ فِے اِ۬للَّهِ جَعَلَ فِتْنَةَ اَ۬لنَّاسِ كَعَذَابِ اِ۬للَّهِۖ وَلَئِن جَآءَ نَصْرࣱ مِّن رَّبِّكَ لَيَقُولُنَّ إِنَّا كُنَّا مَعَكُمُۥٓۖ أَوَلَيْسَ اَ۬للَّهُ بِأَعْلَمَ بِمَا فِے صُدُورِ اِ۬لْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لنَّاسِ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَنْ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَّقُولُ", "translit": "", "root": ""}, {"id": 5, "arabic": "ءَامَنَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "بِاللَّهِ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَإِذَآ", "translit": "", "root": ""}, {"id": 8, "arabic": "أُوذِيَ", "translit": "", "root": ""}, {"id": 9, "arabic": "فِے", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 11, "arabic": "جَعَلَ", "translit": "", "root": "