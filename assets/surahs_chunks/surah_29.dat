}]}}, "warshVerses": [{"surah": 29, "ayah": 1, "text": "أَلَٓمِّٓۖ", "words": [{"id": 1, "arabic": "أَلَٓمِّٓۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 2, "text": "اَحَسِبَ اَ۬لنَّاسُ أَنْ يُّتْرَكُوٓاْ أَنْ يَّقُولُوٓاْ ءَامَنَّا وَهُمْ لَا يُفْتَنُونَۖ", "words": [{"id": 1, "arabic": "اَحَسِبَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لنَّاسُ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 4, "arabic": "يُّتْرَكُوٓاْ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَّقُولُوٓاْ", "translit": "", "root": ""}, {"id": 7, "arabic": "ءَامَنَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَا", "translit": "", "root": ""}, {"id": 10, "arabic": "يُفْتَنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 3, "text": "وَلَقَدْ فَتَنَّا اَ۬لذِينَ مِن قَبْلِهِمْۖ فَلَيَعْلَمَنَّ اَ۬للَّهُ اُ۬لذِينَ صَدَقُواْ وَلَيَعْلَمَنَّ اَ۬لْكَٰذِبِينَۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَتَنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِن", "translit": "", "root": ""}, {"id": 5, "arabic": "قَبْلِهِمْۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَلَيَعْلَمَنَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 9, "arabic": "صَدَقُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَلَيَعْلَمَنَّ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لْكَٰذِبِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 4, "text": "أَمْ حَسِبَ اَ۬لذِينَ يَعْمَلُونَ اَ۬لسَّيِّـَٔاتِ أَنْ يَّسْبِقُونَاۖ سَآءَ مَا يَحْكُمُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "حَسِبَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَعْمَلُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لسَّيِّـَٔاتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَّسْبِقُونَاۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "سَآءَ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَا", "translit": "", "root": ""}, {"id": 10, "arabic": "يَحْكُمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 5, "text": "مَن كَانَ يَرْجُواْ لِقَآءَ اَ۬للَّهِ فَإِنَّ أَجَلَ اَ۬للَّهِ لَأٓتࣲۖ وَهُوَ اَ۬لسَّمِيعُ اُ۬لْعَلِيمُۖ", "words": [{"id": 1, "arabic": "مَن", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَرْجُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِقَآءَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَإِنَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَجَلَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَأٓتࣲۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لسَّمِيعُ", "translit": "", "root": ""}, {"id": 12, "arabic": "اُ۬لْعَلِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 29, "ayah": 6, "text": "وَمَن جَٰهَدَ فَإِنَّمَا يُجَٰهِدُ لِنَفْسِهِۦٓۖ إِنَّ اَ۬للَّهَ لَغَنِيٌّ عَنِ اِ۬لْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "وَمَن", "translit": "", "root": ""}, {"id": 2, "arabic": "جَٰهَدَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَإِنَّمَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يُجَٰهِدُ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِنَفْسِهِۦٓۖ", "translit": "", "root": ""}, {"id": 6, 