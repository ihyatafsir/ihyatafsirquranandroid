arsh"}, {"surah": 92, "ayah": 5, "text": "فَأَمَّا مَنَ اَعْط۪يٰ وَاتَّق۪يٰ", "words": [{"id": 1, "arabic": "فَأَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَعْط۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَاتَّق۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 92, "ayah": 6, "text": "وَصَدَّقَ بِالْحُسْن۪يٰ", "words": [{"id": 1, "arabic": "وَصَدَّقَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِالْحُسْن۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 92, "ayah": 7, "text": "فَسَنُيَسِّرُهُۥ لِلْيُسْر۪يٰۖ", "words": [{"id": 1, "arabic": "فَسَنُيَسِّرُهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِلْيُسْر۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 92, "ayah": 8, "text": "وَأَمَّا مَنۢ بَخِلَ وَاسْتَغْن۪يٰ", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنۢ", "translit": "", "root": ""}, {"id": 3, "arabic": "بَخِلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَاسْتَغْن۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 92, "ayah": 9, "text": "وَكَذَّبَ بِالْحُسْن۪يٰ", "words": [{"id": 1, "arabic": "وَكَذَّبَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِالْحُسْن۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 92, "ayah": 10, "text": "فَسَنُيَسِّرُهُۥ لِلْعُسْر۪يٰۖ", "words": [{"id": 1, "arabic": "فَسَنُيَسِّرُهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِلْعُسْر۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 92, "ayah": 11, "text": "وَمَا يُغْنِے عَنْهُ مَالُهُۥٓ إِذَا تَرَدّ۪يٰٓۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يُغْنِے", "translit": "", "root": ""}, {"id": 3, "arabic": "عَنْهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَالُهُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 6, "arabic": "تَرَدّ۪يٰٓۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 92, "ayah": 12, "text": "إِنَّ عَلَيْنَا لَلْهُد۪يٰ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لَلْهُد۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 92, "ayah": 13, "text": "وَإِنَّ لَنَا لَلَاخِرَةَ وَالُاول۪يٰۖ", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لَلَاخِرَةَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالُاول۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 92, "ayah": 14, "text": "فَأَنذَرْتُكُمْ نَاراࣰ تَلَظّ۪يٰ", "words": [{"id": 1, "arabic": "فَأَنذَرْتُكُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَاراࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "تَلَظّ۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 92, "ayah": 15, "text": "لَا يَصْلَيٰهَآ إِلَّا اَ۬لَاشْقَي", "words": [{"id": 1, "arabic": "لَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَصْلَيٰهَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لَاشْقَي", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 92, "ayah": 16, "text": "اَ۬لذِے كَذَّبَ وَتَوَلّ۪يٰۖ", "words": [{"id": 1, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 2, "arabic": "كَذَّبَ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَتَوَلّ۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 92, "ayah": 17, "text": "وَسَيُجَنَّبُهَا اَ۬لَاتْقَي", "words": [{"id": 1, "arabic": "وَسَيُجَنَّبُهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لَاتْقَي", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 92, "ayah": 18, "text": "اَ۬لذِے يُوتِے مَالَهُۥ يَتَزَكّ۪يٰۖ", "words": [{"id": 1, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 2, "arabic": "يُوتِے", "translit": "", "root": ""}, {"id": 3, "arabic": "مَالَهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَتَزَكّ۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 92, "ayah": 19, "text": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةࣲ تُجْز۪يٰٓ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لِأَحَدٍ", "translit": "", "root": ""}, {"id": 3, "arabic": "عِندَهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِن", "translit": "", "root": ""}, {"id": 5, "arabic": "نِّعْمَةࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "تُجْز۪يٰٓ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 92, "ayah": 20, "text": "إِلَّا اَ۪بْتِغَآءَ وَجْهِ رَبِّهِ اِ۬لَاعْل۪يٰۖ", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۪بْتِغَآءَ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَجْهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبِّهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لَاعْل۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 92, "ayah": 21, "text": "وَلَسَوْفَ يَرْض۪يٰۖ", "words": [{"id": 1, "arabic": "وَلَسَوْفَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَرْض۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}]}