"18": [[1, 800, 1720], [2, 1730, 2680], [3, 2690, 3720], [4, 3730, 5440]], "92:18": [[1, 800, 1720], [2, 1730, 2680], [3, 2690, 3720], [4, 3730, 5440]], "19": [[1, 750, 1290], [2, 1300, 2360], [3, 2370, 4220], [4, 4230, 5310], [5, 5320, 7210], [6, 7220, 8370]], "92:19": [[1, 750, 1290], [2, 1300, 2360], [3, 2370, 4220], [4, 4230, 5310], [5, 5320, 7210], [6, 7220, 8370]], "20": [[1, 700, 1170], [2, 1180, 3290], [3, 3300, 3850], [4, 3860, 4750], [5, 4760, 6060]], "92:20": [[1, 700, 1170], [2, 1180, 3290], [3, 3300, 3850], [4, 3860, 4750], [5, 4760, 6060]], "21": [[1, 390, 1560], [2, 1570, 2660]], "92:21": [[1, 390, 1560], [2, 1570, 2660]]}, "abdulbasit_mujawwad": {"1": [[1, 1740, 3420], [2, 3430, 4770], [3, 4780, 8460]], "92:1": [[1, 1740, 3420], [2, 3430, 4770], [3, 4780, 8460]], "2": [[1, 820, 3240], [2, 3250, 4490], [3, 4500, 7850]], "92:2": [[1, 820, 3240], [2, 3250, 4490], [3, 4500, 7850]], "3": [[1, 3270, 4180], [2, 4190, 5840], [3, 5850, 8820], [4, 8830, 12150]], "92:3": [[1, 3270, 4180], [2, 4190, 5840], [3, 5850, 8820], [4, 8830, 12150]], "4": [[1, 4860, 7510], [2, 7520, 8320], [3, 8330, 10970]], "92:4": [[1, 4860, 7510], [2, 7520, 8320], [3, 8330, 10970]], "5": [[1, 1600, 4340], [2, 4350, 4880], [3, 4890, 6630], [4, 6640, 10240]], "92:5": [[1, 1600, 4340], [2, 4350, 4880], [3, 4890, 6630], [4, 6640, 10240]], "6": [[1, 1750, 3110], [2, 3120, 7050]], "92:6": [[1, 1750, 3110], [2, 3120, 7050]], "7": [[1, 1300, 4770], [2, 4780, 8150]], "92:7": [[1, 1300, 4770], [2, 4780, 8150]], "8": [[1, 3980, 5536], [2, 5536, 6090], [3, 6100, 7390], [4, 7400, 11410]], "92:8": [[1, 3980, 5536], [2, 5536, 6090], [3, 6100, 7390], [4, 7400, 11410]], "9": [[1, 1150, 2910], [2, 2920, 6900]], "92:9": [[1, 1150, 2910], [2, 2920, 6900]], "10": [[1, 850, 4510], [2, 4520, 7750]], "92:10": [[1, 850, 4510], [2, 4520, 7750]], "11": [[1, 4000, 5840], [2, 5850, 6710], [3, 6720, 8120], [4, 8130, 11730], [5, 11740, 12950], [6, 12960, 16460]], "92:11": [[1, 4000, 5840], [2, 5850, 6710], [3, 6720