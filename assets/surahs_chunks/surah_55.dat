ic": "دُونِهِمَا", "translit": "āَmِhِnwُd", "root": "دون"}, {"id": 3, "arabic": "جَنَّتَانِ", "translit": "ِnāَtَّnَjg", "root": "جنن"}], "hasIhya": false}, {"ayah": 63, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ", "translation": "So which of the favors of your Lord would you deny? -", "words": [{"id": 1, "arabic": "فَبِأَىِّ", "translit": "ِّàَaʾِbَf", "root": "ايي"}, {"id": 2, "arabic": "ءَالَآءِ", "translit": "ِءٓāَlāَء", "root": "الو"}, {"id": 3, "arabic": "رَبِّكُمَا", "translit": "āَmُkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "تُكَذِّبَانِ", "translit": "ِnāَbِّhdَkُt", "root": "كذب"}], "hasIhya": false}, {"ayah": 64, "text": "مُدْهَآمَّتَانِ ", "translation": "Dark green [in color].", "words": [{"id": 1, "arabic": "مُدْهَآمَّتَانِ", "translit": "ِnāَtَّmٓāَhْdُm", "root": "دهم"}], "hasIhya": false}, {"ayah": 65, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ", "translation": "So which of the favors of your Lord would you deny?", "words": [{"id": 1, "arabic": "فَبِأَىِّ", "translit": "ِّàَaʾِbَf", "root": "ايي"}, {"id": 2, "arabic": "ءَالَآءِ", "translit": "ِءٓāَlāَء", "root": "الو"}, {"id": 3, "arabic": "رَبِّكُمَا", "translit": "āَmُkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "تُكَذِّبَانِ", "translit": "ِnāَbِّhdَkُt", "root": "كذب"}], "hasIhya": false}, {"ayah": 66, "text": "فِيهِمَا عَيْنَانِ نَضَّاخَتَانِ ", "translation": "In both of them are two springs, spouting.", "words": [{"id": 1, "arabic": "فِيهِمَا", "translit": "āَmِhyِf", "root": ""}, {"id": 2, "arabic": "عَيْنَانِ", "translit": "ِnāَnْyَʿع", "root": "عين"}, {"id": 3, "arabic": "نَضَّاخَتَانِ", "translit": "ِnāَtَhkāَّḍَn", "root": "نضخ"}], "hasIhya": false}, {"ayah": 67, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ", "translation": "So which of the favors of your Lord would you deny?", "words": [{"id": 1, "arabic": "فَبِأَىِّ", "translit": "ِّàَaʾِbَf", "root": "ايي"}, {"id": 2, "arabic": "ءَالَآءِ", "translit": "ِءٓāَlāَء", "root": "الو"}, {"id": 3, "arabic": "رَبِّكُمَا", "translit": "āَmُkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "تُكَذِّبَانِ", "translit": "ِnāَbِّhdَkُt", "root": "كذب"}], "hasIhya": false}, {"ayah": 68, "text": "فِيهِمَا فَٰكِهَةٌ وَنَخْلٌ وَرُمَّانٌ ", "translation": "In both of them are fruit and palm trees and pomegranates.", "words": [{"id": 1, "arabic": "فِيهِمَا", "translit": "āَmِhyِf", "root": ""}, {"id": 2, "arabic": "فَٰكِهَةٌ", "translit": "ٌẗَhِkَٰf", "root": "فكه"}, {"id": 3, "arabic": "وَنَخْلٌ", "translit": "ٌlْhkَnَw", "root": "نخل"}, {"id": 4, "arabic": "وَرُمَّانٌ", "translit": "ٌnāَّmُrَw", "root": "رمن"}], "hasIhya": false}, {"ayah": 69, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ", "translation": "So which of the favors of your Lord would you deny?", "words": [{"id": 1, "arabic": "فَبِأَىِّ", "translit": "ِّàَaʾِbَf", "root": "ايي"}, {"id": 2, "arabic": "ءَالَآءِ", "translit": "ِءٓāَlāَء", "root": "الو"}, {"id": 3, "arabic": "رَبِّكُمَا", "translit": "āَmُkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "تُكَذِّبَانِ", "translit": "ِnāَbِّhdَkُt", "root": "كذب"}], "hasIhya": false}, {"ayah": 70, "text": "فِيهِنَّ خَيْرَٰتٌ حِسَانٌ ", "translation": "In them are good and beautiful women -", "words": [{"id": 1, "arabic": "فِيهِنَّ", "translit": "َّnِhyِf", "root": ""}, {"id": 2, "arabic": "خَيْرَٰتٌ", "translit": "ٌtَٰrْyَhk", "root": "خير"}, {"id": 3, "arabic": "حِسَانٌ", "translit": "ٌnāَsِḥ", "root": "حسن"}], "hasIhya": false}, {"ayah": 71, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ", "translation": "So which of the favors of your Lord would you deny? -", "words": [{"id": 1, "arabic": "فَبِأَىِّ", "translit": "ِّàَaʾِbَf", "root": "ايي"}, {"id": 2, "arabic": "ءَالَآءِ", "translit": "ِءٓāَlāَء", "root": "الو"}, {"id": 3, "arabic": "رَبِّكُمَا", "translit": "āَmُkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "تُكَذِّبَانِ", "translit": "ِnāَbِّhdَkُt", "root": "كذب"}], "hasIhya": false}, {"ayah": 72, "text": "حُورٌ مَّقْصُورَٰتٌ فِى ٱلْخِيَامِ ", "translation": "Fair ones reserved in pavilions -", "words": [{"id": 1, "arabic": "حُورٌ", "translit": "ٌrwُḥ", "root": "حور"}, {"id": 2, "arabic": "مَّقْصُورَٰتٌ", "translit": "ٌtَٰrwُṣْqَّm", "root": "قصر"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْخِيَامِ", "translit": "ِmāَyِhkْlٱ", "root": "خيم"}], "hasIhya": true}, {"ayah": 73, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ", "translation": "So which of the favors of your Lord would you deny? -", "words": [{"id": 1, "arabic": "فَبِأَىِّ", "translit": "ِّàَaʾِbَf", "root": "ايي"}, {"id": 2, "arabic": "ءَالَآءِ", "translit": "ِءٓāَlāَء", "root": "الو"}, {"id": 3, "arabic": "رَبِّكُمَا", "translit": "āَmُkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "تُكَذِّبَانِ", "translit": "ِnāَbِّhdَkُt", "root": "كذب"}], "hasIhya": false}, {"ayah": 74, "text": "لَمْ يَطْمِثْهُنَّ إِنسٌ قَبْلَهُمْ وَلَا جَآنٌّ ", "translation": "Untouched before them by man or jinnī -", "words": [{"id": 1, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 2, "arabic": "يَطْمِثْهُنَّ", "translit": "َّnُhْhtِmْṭَy", "root": "طمث"}, {"id": 3, "arabic": "إِنسٌ", "translit": "ٌsnِiʾ", "root": "انس"}, {"id": 4, "arabic": "قَبْلَهُمْ", "translit": "ْmُhَlْbَq", "root": "قبل"}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "جَآنٌّ", "translit": "ٌّnٓāَjg", "root": "جنن"}], "hasIhya": true}, {"ayah": 75, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ", "translation": "So which of the favors of your Lord would you deny? -", "words": [{"id": 1, "arabic": "فَبِأَىِّ", "translit": "ِّàَaʾِbَf", "root": "ايي"}, {"id": 2, "arabic": "ءَالَآءِ", "translit": "ِءٓāَlāَء", "root": "الو"}, {"id": 3, "arabic": "رَبِّكُمَا", "translit": "āَmُkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "تُكَذِّبَانِ", "translit": "ِnāَbِّhdَkُt", "root": "كذب"}], "hasIhya": false}, {"ayah": 76, "text": "مُتَّكِـِٔينَ عَلَىٰ رَفْرَفٍ خُضْرٍ وَعَبْقَرِىٍّ حِسَانٍ ", "translation": "Reclining on green cushions and beautiful fine carpets.", "words": [{"id": 1, "arabic": "مُتَّكِـِٔينَ", "translit": "َnyِٔـِkَّtُm", "root": "وكا"}, {"id": 2, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 3, "arabic": "رَفْرَفٍ", "translit": "ٍfَrْfَr", "root": "رفرف"}, {"id": 4, "arabic": "خُضْرٍ", "translit": "ٍrْḍُhk", "root": "خضر"}, {"id": 5, "arabic": "وَعَبْقَرِىٍّ", "translit": "ٍّàِrَqْbَʿعَw", "root": "عبقر"}, {"id": 6, "arabic": "حِسَانٍ", "translit": "ٍnāَsِḥ", "root": "حسن"}], "hasIhya": false}, {"ayah": 77, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ", "translation": "So which of the favors of your Lord would you deny?", "words": [{"id": 1, "arabic": "فَبِأَىِّ", "translit": "ِّàَaʾِbَf", "root": "ايي"}, {"id": 2, "arabic": "ءَالَآءِ", "translit": "ِءٓāَlāَء", "root": "الو"}, {"id": 3, "arabic": "رَبِّكُمَا", "translit": "āَmُkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "تُكَذِّبَانِ", "translit": "ِnāَbِّhdَkُt", "root": "كذب"}], "hasIhya": false}, {"ayah": 78, "text": "تَبَٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَٰلِ وَٱلْإِكْرَامِ ", "translation": "Blessed is the name of your Lord, Owner of Majesty and Honor.", "words": [{"id": 1, "arabic": "تَبَٰرَكَ", "translit": "َkَrَٰbَt", "root": "برك"}, {"id": 2, "arabic": "ٱسْمُ", "translit": "ُmْsٱ", "root": "سمو"}, {"id": 3, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "ذِى", "translit": "àِhd", "root": ""}, {"id": 5, "arabic": "ٱلْجَلَٰلِ", "translit": "ِlَٰlَjgْlٱ", "root": "جلل"}, {"id": 6, "arabic": "وَٱلْإِكْرَامِ", "translit": "ِmāَrْkِiʾْlٱَw", "root": "كرم"}], "hasIhya": false}], "tafsir": {"3": [{"arabic": "وقال تعالى {خلق الإنسان علمه البيان} وإنما ذكر ذلك في معرض الامتنان وأما الأخبار فقال رسول الله صلى الله عليه وسلم من يرد الله به خيرا يفقهه في الدين ويلهمه رشده (1) وقال صلى الله عليه وسلم العلماء ورثة الأنبياء (2) ومعلوم أنه لا رتبة فوق النبوة ولا شرف فوق شرف الوراثة لتلك الرتبة وقال صلى الله عليه وسلم يستغفر للعالم ما في السموات والأرض (3) وأي منصب يزيد على منصب من تشتغل ملائكة السموات والأرض بالاستغفار له وقال صلى الله عليه وسلم إن الحكمة تزيد الشريف شرفا وترفع المملوك حتى يدر", "english": "How He, Glorified and Exalted, began with Himself, then seconded with the angels, and thirded with the people of knowledge — and sufficient for you is this as honor, excellence, splendor, and nobility. And God, Exalted, said: {«يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات»} — \"God will raise those who have believed among you and those who have been given knowledge, in degrees.\" Ibn ʿAbbās, may God be pleased with them both, said: For the scholars there are degrees above the believers, seven hundred degrees, and between each two degrees is a distance of five hundred years' journey.", "book_title": "Book of Knowledge", "section_title_ar": "Section 4", "section_title_en": "The Book of Knowledge — Section 4: The Excellence of Knowledge and the Scholars", "section_index": 4, "anchors": "- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Core root meaning of knowing, perceiving a thing in its true reality; the act of apprehension and judgment.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment of existence or non-existence.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes genuine knowing; metaphorical (majāz) usage extends to signs, landmarks, and traces that guide to knowledge.\n- Root: درج (d-r-j)\n  * Lisan / Ayn: Degrees, steps, ascending stations; the root denotes gradation and progressive elevation.\n  * Al-Raghib (Mufradat): \"الدرجة نحو المنزلة، لكن يقال للمنزلة: درجة إذا اعتبرت بالصعود\" — a degree is a station considered by ascent, not horizontal extension.\n  * Al-Zamakhshari (Asas): Literal: physical steps of ascent. Metaphorical: \"لفلان درجة رفيعة\" — lofty rank; \"امش في مدارج الحق\" — walk in the paths of truth.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day denotes the time of the sun's rising to its setting, and may denote any period of time whatsoever.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"ذكر في أيام العرب كذا\" — historical battles and events; \"وذكرهم بأيام الله\" — His mighty deeds against the disbelievers.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication) — The particle \"innamā\" restricts and confines the predicate to the subject alone, as in {«إنما يخشى الله من عباده العلماء»}, where fear of God is restricted exclusively to the scholars.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "8": [{"arabic": "تعالى إن لا تطغوا في الميزان وأقيموا الوزن بالقسط ولا تخسروا الميزان فمن خصي نفسه ليزيل شهوة النكاح أو ترك النكاح مع القدرة والأمن من الآفات أو ترك الأكل حتى ضعف عن العبادة والذكر والفكر فقد أخسر الميزان ومن انهمك في شهوة البطن والفرج فقد طغى في الميزان وإنما العدل أن يخلو وزنه وتقديره عن الطغيان والخسران فتعتدل به كفتا الميزان فإذن الفضائل الخاصة بالنفس المقربة إلى الله تعالى أربعة علم مكاشفة وعلم معاملة وعفة وعدالة ولا يتم هذا في غالب الأمر إلا بالنوع الثاني وهو الفضائل البدنية وهي أربعة الصحة والقوة والجمال و", "english": "The ultimate goal — nay, the ultimate goal — is the felicity of the Hereafter, and its total content reduces to four matters: a permanence with no annihilation, a joy with no grief therein, a knowledge with no ignorance accompanying it, and a wealth with no poverty after it. These constitute the true blessing (al-niʿmah al-ḥaqīqiyyah). For this reason, the Messenger of God — may God bless him and grant him peace — said: {«لَا عَيْشَ إِلَّا عَيْشُ الْآخِرَةِ»} (\"There is no life save the life of the Hereafter\"). He said this amid hardship as a consolation to the soul — and that was at the time of digging the trench (al-khandaq) in severe distress — and he said it once amid joy as a deterrent to the soul from leaning toward the pleasures of this world — and that was when the people crowded around him during the Farewell Pilgrimage. The report of his saying during the Farewell Pilgrimage, {«لَا عَيْشَ إِلَّا عَيْشَةُ الْآخِرَةِ»} (\"There is no life save the life of the Hereafter\"), was transmitted by al-Shāfiʿī as a disconnected (mursal) tradition and by al-Ḥākim as a connected (muttaṣil) one, and he declared it sound (ṣaḥīḥ); it has already been mentioned in the Book of Pilgrimage. And a man said: \"O God, I ask You for the completion of blessing (tamām al-niʿmah).\" The Prophet — may God bless him and grant him peace — said: \"And do you know what the completion of blessing is?\" He said: \"No.\" He said: \"The completion of blessing is the entering of Paradise.\" This is the hadith of the man who said: \"O God, I ask You for the completion of blessing\" — the full report.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 995", "section_title_en": "The Ultimate Goal and Its Means — The Fourfold Division of True Blessedness and the Necessity of External Goods for the Path to the Hereafter", "section_index": 995, "anchors": "- Root: غ ي ا (gh-y-a)\n  * Lisan / Ayn: The extreme limit, endpoint, or terminal aim toward which something strives; the farthest reach of a matter.\n  * Al-Raghib (Mufradat): The final purpose (al-ghāyah) contrasted with the means (al-wasīlah); in theological terms, the ultimate end of human striving is the felicity of the Hereafter (saʿādat al-ākhirah), not transient worldly states.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes a spatial or temporal terminus; metaphorical (majāz) extension applies it to the teleological end of moral and spiritual endeavor.\n- Root: ن ع م (n-ʿ-m)\n  * Lisan / Ayn: Softness, ease, and well-being; also the state of living pleasantly and abundantly.\n  * Al-Raghib (Mufradat): Al-Niʿmah is the \"goodly state\" (al-ḥālah al-ḥasanah) — a condition of being, not merely a discrete object; true niʿmah is that which endures without cessation, hence the Hereafter's bliss is the real blessing, while worldly goods are only instrumental.\n  * Al-Zamakhshari (Asas): Literal: \"jallat niʿmatu-llāh\" (God's blessing is immense); metaphorical: \"khafat naʿāmatuhum\" (their prosperity vanished) — indicating that apparent goods may be stripped of true value when severed from the ultimate end.\n- Root: ر ب ع (r-b-ʿ)\n  * Lisan / Ayn: Fourfoldness; the root of quartile division and dwelling in a place (rubʿ).\n  * Al-Raghib (Mufradat): The numerical base for systematic classification; here, the exhaustive partitioning of blessings into four genera, each subdivided into four species, yielding sixteen total — a structural device for comprehensive enumeration.\n  * Al-Zamakhshari (Asas): Literal: \"rabiʿa al-makān\" (he dwelt in the place); metaphorical: \"rabbaʿahu Allāh\" (God raised him up) — suggesting that the fourfold scheme is not arbitrary but a divinely ordered taxonomy of means that \"raise up\" the seeker toward the end.\n- Root: ن ف س (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that which is most interior and precious to a person.\n  * Al-Raghib (Mufradat): Al-Nafs denotes the rational soul (al-rūḥ) in its capacity for knowledge and virtue; its \"virtues\" (faḍāʾil) are the immaterial perfections that draw one near to God, distinct from bodily or external accidents.\n  * Al-Zamakhshari (Asas): Literal: \"shayʾ nafīs\" (a precious thing); metaphorical: \"aṣābat-hu nafs\" (an evil eye struck him) — showing that the soul's true preciousness lies in its inward purity, not outward display.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-l-taqyīd bi-innamā (Restriction and Focused Predication) — The particle innamā restricts the predicate to the subject alone, as in \"the true blessing is only the Hereafter's felicity,\" excluding all else from the category of genuine, ultimate good.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "14": [{"arabic": "الطيار والشهوة عبارة عن حركة جنده السيار وهذا لأن الشيطان خلق من النار وخلق الإنسان من صلصال كالفخار والفخار قد اجتمع فيه مع النار الطين والطين طبيعته السكون والنار طبيعتها الحركة فلا يتصور نار مشتعلة لا تتحرك بل لا تزال تتحرك بطبعها وقد كلف الملعون المخلوق من النار أن يطمئن عن حركته ساجدا لما خلق الله من الطين فأبى واستكبر واستعصى وعبر عن سبب استعصائه بأن قال {خلقتني من نار وخلقته من طين} فإذن حيث لم يسجد الملعون لأبينا آدم صلوات الله عليه وسلامه فلا ينبغي أن يطمع في سجوده لأولاده ومهما كف عن القلب وسواسه وعدوانه وطيرانه وجولانه فقد أظهر انق", "english": "Ibn ʿAbbās, may God be pleased with them both, said: \"Patience in the Qur'an is of three aspects: patience in performing the obligatory duties of God most High — for it has three hundred degrees; patience in refraining from the forbidden things of God most High — for it has six hundred degrees; and patience over calamity at the first shock — for it has nine hundred degrees.\" This rank, despite being among the virtuous acts, was only rendered superior to what precedes it — which belongs to the obligatory acts — because every believer is capable of patience in refraining from forbidden things.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 966", "section_title_en": "The Third Division: Patience Regarding What Lies Beyond the Scope of Choice — Calamities, Its Supreme Stations, and the Warfare of the Heart Against the Whisperer", "section_index": 966, "anchors": "- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: \"Al-Sabr: al-imsāk fī ḍīq\" — restraint within constriction; to hold back, to bind, to detain.\n  * Al-Raghib (Mufradat): \"Ṣabartu al-dābbah: ḥabastuhā bilā ʿalaf\" — I held the beast back without fodder. \"Al-ṣabr: ḥabs al-nafs ʿalā mā yaqtaḍīhi al-ʿaql wa-al-sharʿ\" — Patience is the soul's self-restraint upon what reason and Law require, or from what they require it to be withheld. It is a generic term whose names vary by situation: over calamity it is *ṣabr* alone (opposed to *jazaʿ*); in battle, *shajāʿah* (courage); in affliction, forbearance.\n  * Al-Zamakhshari (Asas): Haqiqah (Literal): \"Ṣabartu ʿalā mā akrah, wa-ṣabartu ʿammā uḥibb\" — I bore patiently what I dislike and refrained from what I love. Majaz (Metaphorical): \"Huwa aṣbaru ʿalā al-ḍarb min al-arḍ\" — He is more enduring of blows than the earth; and \"ṣabartu yamīnahu\" — I bound him by an oath (holding him to a stringent vow).\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn over, to overturn, to flip from one face to another; the heart as that which is perpetually turning (taqallub).\n  * Al-Raghib (Mufradat): \"Qalb al-shay': taṣrīfuhu wa-ṣarfuhu ʿan wajh ilā wajh\" — The heart's essence is its constant overturning and veering between states; hence its name.\n  * Al-Zamakhshari (Asas): Haqiqah: \"Qalaba al-shay' qalban: ḥawwalahu ʿan wajhihi\" — to turn a thing from its face. Majaz: \"Rajul qalb ḥawal: yuqallibu al-umūr wa-yaḥtāl\" — a man who turns matters over and devises stratagems; \"wa-qallabū laka al-umūr\" — they turned the affairs over for you (scrutinized them).\n- Root: عله (ʿ-l-h) — [Note: Root appears corrupted in source; likely intended ʿ-l-m or ʿ-l-q; context governs]\n  * Lisan / Ayn: [Source entry unclear; context indicates occupation and preoccupation of the heart.]\n- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Grace, bounty, well-being; the state of ease and delight.\n  * Al-Raghib (Mufradat): \"Al-niʿmah: al-ḥālah al-ḥasanah\" — the beautiful state; \"al-naʿīm: al-tanaʿʿum\" — the act of living pleasantly. \"Wa-in taʿuddū niʿmata Allāhi lā tuḥṣūhā\" {«وَإِن تَعُدُّوا نِعْمَةَ اللَّهِ لَا تُحْصُوهَا»} — the genus of grace encompasses both little and much.\n  * Al-Zamakhshari (Asas): Haqiqah: \"Jallat niʿmat Allāh wa-naʿmā'uh\" — God's grace and bounties are immense. Majaz: \"Khafat naʿāmatuhum: dhahabū\" — their ostriches departed (i.e., their prosperity fled).\n- Sibawayh Rule: Bāb al-ḥaṣr wa-al-taqyīd bi-innamā (Restriction and Specification by *innamā*) — Governing the exclusive predication in \"إنما يرحم الله من عباده الرحما\" (God shows mercy only to the merciful among His servants), restricting mercy's object.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Patience and Gratitude'", "badge": "Ethics"}], "26": [{"arabic": "في حقه بالموت ف كل من عليها فان ويبقى وجه ربك ذو الجلال والإكرام وإنما تفنى الدنيا بالموت في حقه إلى أن تفنى في نفسها عند بلوغ الكتاب أجله وهذا الأنس يتلذذ به العبد بعد موته إلى أن ينزل في جوار الله عز وجل ويترقى من الذكر إلى اللقاء وذلك بعد أن يبعثر ما في القبور ويحصل ما في الصدور ولا ينكر بقاء ذكر الله عز وجل معه الموت فيقول إنه أعدم فكيف يبقى معه ذكر الله عز وجل فإنه لم يعدم عدما يمنع الذكر بل عدما من الدنيا وعالم الملك والشهادة لا من عالم الملكوت وإلى ما ذكرناه الإشارة بقوله صلى الله عليه وسلم القبر إما حفرة", "english": "If, therefore, he had grown intimate with it, he delights in it and takes pleasure in the cessation of the impediments that had diverted him from it. For the pressing necessities of needs in this worldly life divert one from the remembrance of God, may He be mighty and majestic, and after death no impediment remains. It is as if he has been left alone with his Beloved, and so his joy is immense, and he is delivered from the prison in which he had been prevented from that which was his source of intimacy. For this reason, he, peace and blessings be upon him, said: \"The Holy Spirit (Rūḥ al-Qudus) breathed into my heart: Love whom you will, for you shall surely part from him.\" {«أحبب من أحببت فإنك مفارقه»} By this he intended everything connected to this world, for that perishes with respect to him at death. For {«كل من عليها فان * ويبقى وجه ربك ذو الجلال والإكرام»} [Everything upon it is perishing, and there remains the Face of your Lord, Possessor of Majesty and Honor]. And this world only perishes with respect to him at death, until it perishes in itself when the Book reaches its appointed term.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 240", "section_title_en": "Section 240 — The Station of Remembrance (Dhikr): On the Transformation of Habit into Nature, the Intimacy of Remembrance After Death, and the Excellence of Martyrdom as the Seal of One's State", "section_index": 240, "anchors": "- Root: ألف (Alifa)\n  * Lisan / Ayn: Core meaning of reconciliation, familiarity, and the formation of habit through repeated engagement.\n  * Al-Raghib (Mufradat): The theological nuance of 'uns' (intimacy) as the soul's acquired disposition of comfort in the presence of its Beloved, contrasting with 'wahsha' (estrangement).\n  * Al-Zamakhshari (Asas): Distinguishes the literal sense of social familiarity from the metaphorical (majaz) sense of the heart's deep-seated repose in the remembrance of God, which becomes a 'second nature' (ṭabʿan ākhara).\n- Root: ختم (Khatama)\n  * Lisan / Ayn: To seal, stamp, or conclude; the final impression left upon a thing.\n  * Al-Raghib (Mufradat): The theological sense of the 'seal' (khātima) of one's life—the terminal state upon which one departs from the world and which determines the nature of the afterlife.\n  * Al-Zamakhshari (Asas): The literal act of sealing a document versus the metaphorical designation of one's final spiritual condition as the determining factor of one's eternal outcome.\n- Root: شهد (Shahida)\n  * Lisan / Ayn: To witness, to be present, to testify.\n  * Al-Raghib (Mufradat): The specific theological elevation of 'shahāda' (martyrdom) as the ultimate act of witnessing the truth of God through the sacrifice of one's own life, rendering the martyr a living witness (shahīd).\n  * Al-Zamakhshari (Asas): The literal sense of legal testimony versus the metaphorical reality of the martyr whose very being testifies to the sincerity of his devotion, being 'alive' with his Lord.\n- Root: قطع (Qata'a)\n  * Lisan / Ayn: To sever, cut off, or detach.\n  * Al-Raghib (Mufradat): The essential spiritual operation of severing worldly attachments ('alā'iq) to achieve the unadulterated focus of the heart upon God.\n  * Al-Zamakhshari (Asas): The literal cutting of a physical tie versus the metaphorical severance of all internal and external impediments that distract the soul from its sole Beloved.\n- Sibawayh Rule: Rule of Restriction and Specification (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — Governing how the exclusive focus of the martyr's intention is syntactically and logically restricted to God alone, as exemplified in the phrase \"no god but God\" (lā ilāha illā Allāh), which requires the complete negation of all other objects of intention before affirming the sole Divine Object.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'", "badge": "Insight"}], "27": [{"arabic": "في حقه بالموت ف كل من عليها فان ويبقى وجه ربك ذو الجلال والإكرام وإنما تفنى الدنيا بالموت في حقه إلى أن تفنى في نفسها عند بلوغ الكتاب أجله وهذا الأنس يتلذذ به العبد بعد موته إلى أن ينزل في جوار الله عز وجل ويترقى من الذكر إلى اللقاء وذلك بعد أن يبعثر ما في القبور ويحصل ما في الصدور ولا ينكر بقاء ذكر الله عز وجل معه الموت فيقول إنه أعدم فكيف يبقى معه ذكر الله عز وجل فإنه لم يعدم عدما يمنع الذكر بل عدما من الدنيا وعالم الملك والشهادة لا من عالم الملكوت وإلى ما ذكرناه الإشارة بقوله صلى الله عليه وسلم القبر إما حفر", "english": "If, therefore, he had grown intimate with it, he delights in it and takes pleasure in the cessation of the impediments that had diverted him from it. For the pressing necessities of needs in this worldly life divert one from the remembrance of God, may He be mighty and majestic, and after death no impediment remains. It is as if he has been left alone with his Beloved, and so his joy is immense, and he is delivered from the prison in which he had been prevented from that which was his source of intimacy. For this reason, he, peace and blessings be upon him, said: \"The Holy Spirit (Rūḥ al-Qudus) breathed into my heart: Love whom you will, for you shall surely part from him.\" {«أحبب من أحببت فإنك مفارقه»} By this he intended everything connected to this world, for that perishes with respect to him at death. For {«كل من عليها فان * ويبقى وجه ربك ذو الجلال والإكرام»} [Everything upon it is perishing, and there remains the Face of your Lord, Possessor of Majesty and Honor]. And this world only perishes with respect to him at death, until it perishes in itself when the Book reaches its appointed term.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 240", "section_title_en": "Section 240 — The Station of Remembrance (Dhikr): On the Transformation of Habit into Nature, the Intimacy of Remembrance After Death, and the Excellence of Martyrdom as the Seal of One's State", "section_index": 240, "anchors": "- Root: ألف (Alifa)\n  * Lisan / Ayn: Core meaning of reconciliation, familiarity, and the formation of habit through repeated engagement.\n  * Al-Raghib (Mufradat): The theological nuance of 'uns' (intimacy) as the soul's acquired disposition of comfort in the presence of its Beloved, contrasting with 'wahsha' (estrangement).\n  * Al-Zamakhshari (Asas): Distinguishes the literal sense of social familiarity from the metaphorical (majaz) sense of the heart's deep-seated repose in the remembrance of God, which becomes a 'second nature' (ṭabʿan ākhara).\n- Root: ختم (Khatama)\n  * Lisan / Ayn: To seal, stamp, or conclude; the final impression left upon a thing.\n  * Al-Raghib (Mufradat): The theological sense of the 'seal' (khātima) of one's life—the terminal state upon which one departs from the world and which determines the nature of the afterlife.\n  * Al-Zamakhshari (Asas): The literal act of sealing a document versus the metaphorical designation of one's final spiritual condition as the determining factor of one's eternal outcome.\n- Root: شهد (Shahida)\n  * Lisan / Ayn: To witness, to be present, to testify.\n  * Al-Raghib (Mufradat): The specific theological elevation of 'shahāda' (martyrdom) as the ultimate act of witnessing the truth of God through the sacrifice of one's own life, rendering the martyr a living witness (shahīd).\n  * Al-Zamakhshari (Asas): The literal sense of legal testimony versus the metaphorical reality of the martyr whose very being testifies to the sincerity of his devotion, being 'alive' with his Lord.\n- Root: قطع (Qata'a)\n  * Lisan / Ayn: To sever, cut off, or detach.\n  * Al-Raghib (Mufradat): The essential spiritual operation of severing worldly attachments ('alā'iq) to achieve the unadulterated focus of the heart upon God.\n  * Al-Zamakhshari (Asas): The literal cutting of a physical tie versus the metaphorical severance of all internal and external impediments that distract the soul from its sole Beloved.\n- Sibawayh Rule: Rule of Restriction and Specification (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — Governing how the exclusive focus of the martyr's intention is syntactically and logically restricted to God alone, as exemplified in the phrase \"no god but God\" (lā ilāha illā Allāh), which requires the complete negation of all other objects of intention before affirming the sole Divine Object.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "29": [{"arabic": "وهو أحد والآصال التي ذكرها الله تعالى إذ قال ولله يسجد من في السموات والأرض طوعا وكرها وظلالهم بالغدو والآصال وإذا سجد لله عز وجل الجمادات فكيف يجوز أن يغفل العبد العاقل عن أنواع العبادات الورد السادس إذا دخل وقت العصر دخل وقت الورد السادس وهو الذي أقسم الله تعالى به فقال تعالى {والعصر} هذا أحد معنيي الآية وهو المراد بالآصال في أحد التفسيرين وهو العشي المذكور في قوله {وعشيا} وفي قوله {بالعشي والإشراق} وليس في هذا الورد صلاة إلا أربع ركعات بين الأذان والإقامة كما سبق في الظهر ثم يصلي الفرض ويشتغل بالأقسام الأربعة المذكورة", "english": "I say: And just as knowledge and remembrance are the nourishment of the heart, which can never be cut off from it, so too the measure of moderation is this; and deficiency from it may lead to the disturbance of the body — except for one who accustoms himself to wakefulness gradually, for he may train himself upon it without disturbance. And this litany (wird) is among the longest of the litanies and the most delightful for the worshippers, and it is one of the \"evenings and mornings\" (al-āṣāl) which God Most High mentioned when He said: {«ولله يسجد من في السموات والأرض طوعا وكرها وظلالهم بالغدو والآصال»} \"And to God prostrates whoever is in the heavens and the earth, willingly or unwillingly, and their shadows, in the mornings and the evenings\" (Q. 13:15). And when inanimate objects prostrate to God, Mighty and Majestic, how then can the intelligent servant be heedless of the varieties of worship?", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 261", "section_title_en": "The Seventh Daily Litany (Al-Wird al-Sābiʿ): The Time of Sunset — The Completion of the Day's Litanies and Self-Accounting", "section_index": 261, "anchors": "- Root: ورد (warada)\n  * Lisan / Ayn: The root denotes arriving at water, seeking it, and drinking from it; also the portion or share of water allotted for drinking at a specific time.\n  * Al-Raghib (Mufradat): \"الورود أصله: قصد الماء\" — the core meaning is the intentional approach to water; the litany (wird) is the appointed portion of devotional recitation, likened to the daily share of water that a person must take to sustain life.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): the act of arriving at water. Metaphorical (Majaz): \"ورد علي كتاب سرني مورده\" — a book arrived upon me whose arrival pleased me; likewise, the wird is the arrival of the appointed time for worship, and the soul's approach to the fountain of divine remembrance.\n- Root: عصر (ʿaṣr)\n  * Lisan / Ayn: The root denotes pressing, squeezing, and extracting; also the time of afternoon, so called because it is the pressing of the day's end.\n  * Al-Raghib (Mufradat): The ʿaṣr is the latter part of the day; God swore by it in {«والعصر»} (Q. 103:1), indicating its great merit.\n  * Al-Zamakhshari (Asas): Literal: the afternoon time. Metaphorical: the pressing of one's life — as the day is pressed at its end, so the life of man is pressed at its term.\n- Root: غرب (gharaba)\n  * Lisan / Ayn: The root denotes disappearance, absence, and setting; the sun's setting (ghurūb) is its concealment from the eye.\n  * Al-Raghib (Mufradat): The setting of the sun marks the boundary between the day's works and the night's; it is the terminus of the visible world's diurnal cycle.\n  * Al-Zamakhshari (Asas): Literal: the sun's descent below the horizon. Metaphorical: the setting of the sun of life — the death of man, after which there is no rising.\n- Root: حاسب (ḥāsaba)\n  * Lisan / Ayn: The root denotes reckoning, counting, and taking account; muḥāsabah is the mutual reckoning between two parties.\n  * Al-Raghib (Mufradat): Self-accounting (muḥāsabat al-nafs) is the soul's reckoning with itself over its deeds before the Day of Reckoning, for \"one who reckons himself before he is reckoned\" is among the wise.\n  * Al-Zamakhshari (Asas): Literal: the arithmetic counting of sums. Metaphorical: the soul's audit of its own works, weighing the day's deeds against the standard of the Sacred Law.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of the prepositional phrase from its governing verb, as in the construction \"فسبحان الله حين تمسون\" where the adverbial clause is interposed to emphasize the temporal specification of the act of glorification.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Remembrance of Death and Afterlife'", "badge": "Dhikr"}], "39": [{"arabic": "تنشق فيه السماء فتكون وردة كالدهان فيومئذ لا يسئل عن ذنبه إنس ولا جان يوم يمنع فيه العاصى من الكلام ولا يسئل فيه عن الأجرام بل يؤخذ بالنواصى والأقدام يوم تجد كل نفس ما عملت من خير محضرا وما عملت من سوء تود لو أن بينها وبينه أمدا بعيدا يوم تعلم فيه كل نفس ما أحضرت وتشهد ما قدمت وأخرت يوم تخرس فيه الألسن وتنطق الجوارح يوم شيب ذكره سيد المرسلين إذ قال له الصديق رضي الله عنه أراك قد شبت يا رسول الله قال شيبتنى هود وأخواتها (1) وهى الواقعة والمرسلات وعم يتساءلون وإذا الشمس كورت فيا أيها القارىء العاجز إنما حظك من قراءتك", "english": "So prepare yourself, O wretched one, for this Day of immense magnitude, of prolonged duration, of overwhelming dominion, whose appointed time is near — a Day when you shall see the heaven split asunder, and the stars scattered in its terror, and the shining planets extinguished, and the sun folded up, and the mountains set in motion, and the pregnant camels neglected, and the wild beasts gathered together, and the seas set ablaze, and the souls paired with their bodies, and the Hellfire ignited, and Paradise brought near, and the mountains pulverized, and the earth stretched out — a Day when you shall see the earth shaken with its quaking, and the earth casts forth its burdens. On that Day shall people issue forth in scattered groups to be shown their deeds — a Day when the earth and the mountains are lifted and crushed with a single crushing. Then on that Day the Imminent Event shall come to pass, and the heaven shall split open, for on that Day it shall be frail, and the angels shall be at its edges, and eight shall bear the Throne of your Lord above them on that Day. On that Day you shall be presented — no secret of yours shall remain hidden. A Day when the mountains shall move and you shall see the earth laid bare — a Day when the earth shall be shaken with a violent shaking, and the mountains crumbled to dust, becoming scattered particles — a Day when people shall be like scattered moths, and the mountains like carded wool — a Day when every nursing mother shall forget what she nursed, and every pregnant female shall cast down her burden, and you shall see people drunk, yet they are not drunk, but the chastisement of God is severe — a Day when the earth shall be changed to other than this earth, and the heavens, and they shall appear before God, the One, the All-Compelling — a Day when the mountains shall be blown away as dust, leaving a level, bare plain, wherein you see no crookedness nor curve — a Day when you see the mountains and suppose them solid, yet they pass by like the passing of clouds — a Day when the heaven shall split open and become rosy like molten oil. Then on that Day no human nor jinn shall be asked about his sin. A Day when the disobedient shall be prevented from speech, and shall not be asked about their crimes, but shall be seized by their forelocks and their feet — a Day when every soul shall find what it did of good brought forth present, and what it did of evil, wishing that between it and that evil there were a far distance — a Day when every soul shall know what it has sent ahead, and shall witness what it has forwarded and what it has left behind — a Day when tongues shall be struck mute and the bodily members shall speak — a Day whose mention turned the hair of the Master of the Messengers white, when al-Ṣiddīq (may God be pleased with him) said to him: \"I see that you have turned white-haired, O Messenger of God.\" He said: \"Sūrat Hūd and its sisters have made me white-haired\" — namely, al-Wāqiʿah, al-Mursalāt, ʿAmma Yatasāʾalūn, and Idhā al-Shamsu Kuwwirat.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1339", "section_title_en": "The Names and Attributes of the Day of Resurrection — An Exhortation to the Negligent", "section_index": 1339, "anchors": "- Root: يوم (yawm)\n  * Lisan / Ayn: \"اليوم: وقت طلوع الشمس إلى غروبها، وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day as a temporal span, extended metaphorically to any epoch or era.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — theological usage denotes the appointed time of reckoning, magnified by divine attribution (أيام الله).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): a measured solar period. Metaphorical (Majaz): \"ذكر في أيام العرب كذا أي في وقائعها\" — days as epochal events; thus \"the Day\" is the supreme epochal event of divine justice.\n- Root: نفس (nafs)\n  * Lisan / Ayn: النفس: الروح والذات — the self, soul, or very essence.\n  * Al-Raghib (Mufradat): \"النفس: الروح... وقوله: ويحذركم الله نفسه فنفسه: ذاته\" — nafs as the innermost reality of a being; in the eschatological context, souls are \"paired\" (زوجت) with bodies for judgment.\n  * Al-Zamakhshari (Asas): Literal: the soul as life-principle. Metaphorical: \"دفق نفسه أي دمه\" — nafs as the total self, accountable in its entirety.\n- Root: ارض (arḍ)\n  * Lisan / Ayn: الأرض: الجرم المقابل للسماء — the earth as the corporeal substratum beneath the heavens.\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء... ويعبر بها عن أسفل الشيء\" — the earth as the lowest register of creation, subject to total transformation on that Day.\n  * Al-Zamakhshari (Asas): Literal: the physical earth. Metaphorical: \"تأرض فلان: لزم الأرض\" — to cling low; on that Day the earth itself is leveled, flattened, and replaced.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated \"يوم\" clauses function as temporal restrictors (ẓurūf) binding each predicate to that single, all-encompassing moment; the accumulation of names (أسامي) serves not as mere repetition but as focused predication upon the multifarious realities of a single event.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "46": [{"arabic": "وقد قال تعالى ولمن خاف مقام ربه جنتان ذلك لمن خاف مقامي وخاف وعيد والقرآن من أوله إلى آخره تحذير وتخويف لا يتفكر فيه متفكر إلا ويطول حزنه ويعظم خوفه إن كان مؤمنا بما فيه وترى الناس يهذونه هذا يخرجون الحروف من مخارجها ويتناظرون على خفضها ورفعها ونصبها وكأنهم يقرءون شعرا من أشعار العرب لا يهمهم الالتفات إلى معانيه والعمل بما فيه وهل في العالم غرور يزيد على هذا فهذه أمثلة الغرور بالله وبيان الفرق بين الرجاء والغرور ويقرب منه غرور طوائف لهم طاعات ومعاص إلا أن معاصيهم أكثر وهم يتوقعون", "english": "For if this matter were attained by wishful longing and reached by idle desire, then what was the meaning of the weeping of those [early believers], their fear, and their grief? We have already expounded the reality of these matters in the Book of Fear and Hope (Kitāb al-Khawf wa al-Rajā'). And the Messenger of God, peace and blessings be upon him, said — in what Muʿqil ibn Yasār narrated: \"A time will come upon the people in which the Qur'an will wear out in the hearts of men just as garments wear out upon bodies. Their entire affair will be [one of] covetousness with no fear accompanying it. If one of them does good, he says: 'It will be accepted from me'; and if he does evil, he says: 'I will be forgiven.'\" // The hadith of Muʿqil ibn Yasār: \"A time will come upon the people in which the Qur'an will wear out in the hearts of men...\" — This hadith was transmitted by Abu Mansur al-Daylami in Musnad al-Firdaws from Ibn ʿAbbas with similar wording, through a chain containing unknown narrators; I have not seen it from the hadith of Muʿqil.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 891", "section_title_en": "The Reality of False Hope (Ghurūr) and Its Distinction from True Hope (Rajā') — Section 891", "section_index": 891, "anchors": "- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Core meaning — an outward trace or mark; heedlessness in wakefulness; the blaze on a horse's forehead.\n  * Al-Raghib (Mufradat): \"Ghurūr\" is delusion arising from heedlessness — one is \"folded upon his heedlessness\" (ṭawāhu ʿalā gharrihi), as in {«ما غرك بربك الكريم»} (Q 82:6). It is the state of being deceived by wishful thinking while blind to warning.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): heedlessness/negligence. Metaphorical (Majaz): being deceived by false appearances — e.g., \"a day white and blazing\" (yawm agharr muḥajjal) for intense heat; the gazelle deceived by moonlight (agharr min ẓaby muqmir) that exposes it to predators.\n- Root: خوف (kh-w-f)\n  * Al-Raghib (Mufradat): \"Al-Khawf\" is the anticipation of something disliked based on a probable or certain indicator — the opposite of amn (security). It is paired with rajā' (hope) in {«يدعون ربهم خوفا وطمعا»} (Q 32:16).\n  * Al-Zamakhshari (Asas): Literal: fear of loss or harm. Metaphorical: gradual diminishment — \"takhawwafa al-sayr\" (the journey wore away the camel's hump little by little), as if fearing it.\n- Root: وقد (w-q-d)\n  * Al-Raghib (Mufradat): Fire blazing with fuel — {«وقودها الناس والحجارة»} (Q 2:24). Used for both the fuel and the flame.\n  * Al-Zamakhshari (Asas): Literal: kindling fire. Metaphorical: \"qalb waqqād\" (a blazing, penetrating intellect); \"waqada al-ḥaṣā\" (pebbles becoming scorching hot).\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a governing word and its governed prepositional phrase, provided the intervening clause is complete in itself; here, the periodic structure of Ghazali's condemnation (\"فترى الواحد...\") suspends the subject across multiple clauses before resolution.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "56": [{"arabic": "والمرجان لم يطمثهن إنس قبلهم ولا جان يمشين في درجات الجنان إذا اختالت إحداهن في مشيها حمل أعطافها سبعون ألفا من الولدان عليها من طرائف الحرير الأبيض ما تتحير فيه الأبصار مكللات بالتيجان المرصعة باللؤلؤ والمرجان شكلات غنجات عطرات آمنات من الهرم والبؤس مقصورات في الخيام في قصور من الياقوت بنيت وسط روضات الجنان قاصرات الطرف عين ثم يطاف عليهم وعليهن بأكواب وأباريق وكأس من معين بيضاء لذة للشاربين ويطوف عليهم خدام وولدان كأمثال اللؤلؤ المكنون جزاء بما كانوا يعملون في مقام أمين في جنات", "english": "For God Most High has said: {«إن الأبرار لفي نعيم وإن الفجار لفي جحيم»} — \"Indeed the righteous are in bliss, and indeed the wicked are in Hellfire.\" So present yourself before these two verses, and you will have known your resting-place between the two abodes. And God knows best.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1351", "section_title_en": "Section 1351 — On the Description of Paradise and the Varieties of Its Bliss", "section_index": 1351, "anchors": "- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Core root denotes softness, ease, and pleasant living; al-Ayn notes it among names of the leopard and tiger, while Lisan records \"Nuʿm\" as a proper name.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — niʿmah is the excellent state/condition one inhabits; niʿīm is the experience of delight. The verse {«إن الأبرار لفي نعيم»} designates the abiding state of bliss as a settled condition, not a transient act.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"في النعمة والنعيم\" — dwelling in bounty and bliss. Metaphorical (Majaz): \"خفت نعامتهم: ذهبوا\" — ostriches departing; here the root's literal sense of softness is transfigured into the theological state of perpetual ease, free from all harshness.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: Core root: face, front, direction; al-Ayn cites \"وجه الصواب\" — the face/course of correctness.\n  * Al-Raghib (Mufradat): The face is the noblest part of the outward body, hence used for the essence (al-dhāt) of a thing; in {«ويبقى وجه ربك ذو الجلال والإكرام»} it signifies the Divine Essence. Here \"وجه الملك الكريم\" — the Face of the Generous King — denotes the Beatific Vision of God's Essence, not a corporeal organ.\n  * Al-Zamakhshari (Asas): Literal: physical face. Metaphorical: \"وجه القوم، وهؤلاء وجوه البلد\" — the foremost, noblest of a people; thus the \"face\" of the King is His most august presence.\n- Root: مرج (m-r-j)\n  * Lisan / Ayn: Core root: mixing, confusion, letting loose; al-Ayn: \"المرج: الشهد\" — also pure honey; Lisan: \"مرج أمرهم: اختلط\" — their affair became disordered.\n  * Al-Raghib (Mufradat): \"أصل المرج: الخلط\" — mixing; \"أمر مريج\" — a confused affair (Q. 50:5). In this text, the rivers of Paradise \"مطردة\" (flowing) are not \"ممرجة\" (mixed/confused) — rather they run pure and distinct, each in its channel.\n  * Al-Zamakhshari (Asas): Literal: \"مرج الدواب: أرسلها في المرج\" — releasing beasts into pasture. Metaphorical: \"مرج الله البحرين\" — God let the two seas flow freely; \"مرجت عهودهم\" — covenants became disordered. The contrast sharpens the purity of Paradise's rivers.\n- Root: امن (a-m-n)\n  * Lisan / Ayn: Core root: safety, freedom from fear; al-Ayn treats it under the hamzah chapter as the state of security.\n  * Al-Raghib (Mufradat): \"أصل الأمن: طمأنينة النفس وزوال الخوف\" — tranquility of the soul and removal of fear. In the Hereafter, \"آمنون\" is not mere absence of threat but the positive, settled peace of the soul in the Divine presence.\n  * Al-Zamakhshari (Asas): Literal: \"أمنته وآمننيه\" — to grant safety. Metaphorical: \"فرس أمين القوى\" — a horse whose strength is trustworthy; here the blessed are \"آمنون من ريب المنون\" — secure from the vicissitudes of fate, a security that is trustworthy and unbreachable.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule permits separation between a preposition and its object by an element upon which speech may properly pause, as in \"إن به لضرًا\" — here \"فهم فيما اشتهت أنفسهم خالدون\" (in what their souls desire, abiding eternally) interposes the clause of desire between the prepositional phrase and its predicate, heightening rhetorical emphasis on the soul's fulfillment.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "60": [{"arabic": "وهي كلمة طيبة وهي دعوة الحق وهي العروة الوثقى وهي ثمن الجنة وقال الله عز وجل {هل جزاء الإحسان إلا الإحسان} فقيل الإحسان في الدنيا قول لا إله إلا الله وفي الآخرة الجنة وكذا قوله تعالى {للذين أحسنوا الحسنى وزيادة} وروى البراء بن عازب أنه صلى الله عليه وسلم قال من قال لا إله إلا الله وحده لا شريك له له الملك وله الحمد وهو على كل شيء قدير عشر مرات كانت له عدل رقبة أو قال نسمة (1) وروى عمرو بن شعيب عن أبيه عن جده أنه قال قال رسول الله صلى الله عليه وسلم من قال في يوم مائتي مرة لا إله إلا الله وحده لا شريك له له الملك وله الحمد وهو على كل شيء قدير", "english": "The Prophet, peace be upon him, said: \"The most excellent words that I and the prophets before me have uttered are: There is no god but Allah alone, with no partner.\" (1)", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 237", "section_title_en": "The Virtue of the Declaration of Divine Oneness (Fāḍīlat al-Tahlīl)", "section_index": 237, "anchors": "- Root: اله (ʾ-l-h)\n  * Lisan / Ayn: Core root denoting worship, servitude, and the act of deifying; the name \"Allah\" is the specific designation of the True Deity, distinguished from all false objects of worship.\n  * Al-Raghib (Mufradat): \"الله: قيل: أصله إله فحذفت همزته، وأدخل عليها الألف واللام، فخص بالباري تعالى\" — The name is exclusively reserved for the Creator, and \"ilāh\" is that which is worshipped; the declaration \"lā ilāha illā Allāh\" negates all false objects of worship and affirms sole divinity for God.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes true worship and servitude; metaphorical (majāz) usage applies to anything taken as an object of devotion. The tahlīl is the verbal embodiment of sincere worship.\n- Root: شرك (sh-r-k)\n  * Lisan / Ayn: Partnership, sharing, or association; in theological context, the ascription of partners or associates to God in His divinity or worship.\n  * Al-Raghib (Mufradat): \"الشركة والمشاركة: خلط الملكين\" — The mixing of two ownerships; in Kalam, shirk is the association of another with God in that which is exclusively His, namely divinity and worship.\n  * Al-Zamakhshari (Asas): Literal usage denotes partnership in ownership; metaphorical usage in the phrase \"lā sharīka lahu\" (no partner has He) affirms God's exclusive and unshared sovereignty, kingdom, and praise.\n- Root: وحد (w-ḥ-d)\n  * Lisan / Ayn: Oneness, uniqueness, singularity; the state of being one without peer or equal.\n  * Al-Raghib (Mufradat): Oneness in essence, attributes, and acts; the tahlīl affirms tawḥīd — the absolute unity of God in His divinity, His sole possession of the kingdom, and His exclusive receipt of praise.\n  * Al-Zamakhshari (Asas): Literal usage denotes numerical oneness; theological usage denotes the affirmation of God's unique and incomparable nature, negating all plurality in His essence and attributes.\n- Sibawayh Rule: Rule of Conjunction and Disjunction (al-ʿAṭf wa al-Faṣl) — The phrase \"lā ilāha illā Allāh\" employs the grammatical structure of negation (lā) followed by exception (illā), establishing a complete disjunction between all false deities and the One True God, followed by the conjunction of His exclusive attributes: \"waḥdahu lā sharīka lahu, lahu al-mulku wa lahu al-ḥamdu.\"", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'", "badge": "Hadith"}], "72": [{"arabic": "قوله تعالى حور مقصورات في الخيام // حديث أنس لما أسري بي دخلت في الجنة موضعا يسمى الصرح عليه خيام اللؤلؤ والزبرجد الأخضر والياقوت الأحمر الحديث وفيه أن جبريل قال هؤلاء المقصورات في الخيام وفيه فطفقن يقلن نحن الراضيات فلا نسخط لم أجده هكذا بتمامه وللترمذى من حديث على أن فى الجنة لمجتمعا للحور العين يرفعن أصواتا لم تسمع الخلائق مثلها يقلن نحن الخالدات فلا نبيد ونحن الناعمات فلا نبأس ونحن الراضيات فلا نسخط طوبى لمن كان لنا وكنا له وقال غريب ولأبى الشيخ فى كتاب العظمة", "english": "It is narrated from Anas (may God be pleased with him) that the Messenger of God (peace and blessings be upon him) said: \"A single morning or evening march in the path of God is better than the world and all that is in it. And verily, the space of the bow of one of you, or the place of his foot, in Paradise is better than the world and all that is in it. And if a woman from among the women of the people of Paradise were to look down upon the earth, she would illuminate it and fill all that is between the two [heaven and earth] with fragrance, and verily the scarf upon her head is better than the world and all that is in it\" — meaning the veil (khimār).", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1356", "section_title_en": "On the Attributes of the Houris (Ḥūr al-ʿAyn) and the Eternal Youths (Wildān)", "section_index": 1356, "anchors": "- Root: حور (Ḥ-W-R)\n  * Lisan / Ayn: Core meaning of returning, circling back; in the passive form (ḥūr), denotes intensely white eyes with intensely black pupils — the paradigmatic beauty of the celestial maidens.\n  * Al-Raghib (Mufradat): Al-ḥawar is \"the turning back\" — whether by essence or by thought; the ḥūr are so named for the purity of their gaze, their eyes turning in radiant whiteness, never dimming.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"In her eye is ḥawar\" — the natural, created whiteness. Metaphorical (majāz): \"His mill-pegs became restless\" (qaliqat maḥāwiruh) — borrowed from the axle's turning when the socket loosens, signifying utter disquiet; thus the ḥūr's beauty is a perpetual, unshaken radiance.\n- Root: عين (ʿAyn)\n  * Lisan / Ayn: The eye as organ; also the spring of water, the self, the watcher. Kitāb al-ʿAyn: \"ʿAyn āniyah\" — a hot spring {«الغاشية: 12»}.\n  * Al-Raghib (Mufradat): The eye is the instrument of perception; \"ʿayn\" for the guardian who watches over a thing — \"Verily you are in Our eyes\" {«الطور: 48»} means under Our sight and protection.\n  * Al-Zamakhshari (Asas): Literal: \"He is a slave of the eye\" — one who serves only for show. Metaphorical: \"The earth looked with an eye\" — vegetation sprouting without deep roots; thus ḥūr ʿayn are those whose beauty is beheld by the eye as a living spring, never exhausted.\n- Root: انس (A-N-S)\n  * Lisan / Ayn: Sociability, familiarity, companionship; the human being (insān) as the sociable creature.\n  * Al-Raghib (Mufradat): The jinn and ins are both created, passive to God's act; the houris are \"the companions\" (al-ʿīn) who bring perfect intimacy, removing all estrangement.\n  * Al-Zamakhshari (Asas): Literal: \"He is the son of the intimacy of so-and-so\" — his special confidant. Metaphorical: \"The fire is the intimate one\" (al-anīsah) — that which keeps one company and calms the heart; so the houris are the intimate companions of the blessed, dispelling all solitude.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing a clause between a preposition and its object when the intervening material is a complete, self-sufficient statement, as in the reported speech of the houris: \"We are the contented ones, so we never anger\" — each clause standing independently yet grammatically bound to the governing verb of saying.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}], "74": [{"arabic": "والمرجان لم يطمثهن إنس قبلهم ولا جان يمشين في درجات الجنان إذا اختالت إحداهن في مشيها حمل أعطافها سبعون ألفا من الولدان عليها من طرائف الحرير الأبيض ما تتحير فيه الأبصار مكللات بالتيجان المرصعة باللؤلؤ والمرجان شكلات غنجات عطرات آمنات من الهرم والبؤس مقصورات في الخيام في قصور من الياقوت بنيت وسط روضات الجنان قاصرات الطرف عين ثم يطاف عليهم وعليهن بأكواب وأباريق وكأس من معين بيضاء لذة للشاربين ويطوف عليهم خدام وولدان كأمثال اللؤلؤ المكنون جزاء بما كانوا يعملون في مقام أمين في جنات", "english": "For God Most High has said: {«إن الأبرار لفي نعيم وإن الفجار لفي جحيم»} — \"Indeed the righteous are in bliss, and indeed the wicked are in Hellfire.\" So present yourself before these two verses, and you will have known your resting-place between the two abodes. And God knows best.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1351", "section_title_en": "Section 1351 — On the Description of Paradise and the Varieties of Its Bliss", "section_index": 1351, "anchors": "- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Core root denotes softness, ease, and pleasant living; al-Ayn notes it among names of the leopard and tiger, while Lisan records \"Nuʿm\" as a proper name.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — niʿmah is the excellent state/condition one inhabits; niʿīm is the experience of delight. The verse {«إن الأبرار لفي نعيم»} designates the abiding state of bliss as a settled condition, not a transient act.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"في النعمة والنعيم\" — dwelling in bounty and bliss. Metaphorical (Majaz): \"خفت نعامتهم: ذهبوا\" — ostriches departing; here the root's literal sense of softness is transfigured into the theological state of perpetual ease, free from all harshness.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: Core root: face, front, direction; al-Ayn cites \"وجه الصواب\" — the face/course of correctness.\n  * Al-Raghib (Mufradat): The face is the noblest part of the outward body, hence used for the essence (al-dhāt) of a thing; in {«ويبقى وجه ربك ذو الجلال والإكرام»} it signifies the Divine Essence. Here \"وجه الملك الكريم\" — the Face of the Generous King — denotes the Beatific Vision of God's Essence, not a corporeal organ.\n  * Al-Zamakhshari (Asas): Literal: physical face. Metaphorical: \"وجه القوم، وهؤلاء وجوه البلد\" — the foremost, noblest of a people; thus the \"face\" of the King is His most august presence.\n- Root: مرج (m-r-j)\n  * Lisan / Ayn: Core root: mixing, confusion, letting loose; al-Ayn: \"المرج: الشهد\" — also pure honey; Lisan: \"مرج أمرهم: اختلط\" — their affair became disordered.\n  * Al-Raghib (Mufradat): \"أصل المرج: الخلط\" — mixing; \"أمر مريج\" — a confused affair (Q. 50:5). In this text, the rivers of Paradise \"مطردة\" (flowing) are not \"ممرجة\" (mixed/confused) — rather they run pure and distinct, each in its channel.\n  * Al-Zamakhshari (Asas): Literal: \"مرج الدواب: أرسلها في المرج\" — releasing beasts into pasture. Metaphorical: \"مرج الله البحرين\" — God let the two seas flow freely; \"مرجت عهودهم\" — covenants became disordered. The contrast sharpens the purity of Paradise's rivers.\n- Root: امن (a-m-n)\n  * Lisan / Ayn: Core root: safety, freedom from fear; al-Ayn treats it under the hamzah chapter as the state of security.\n  * Al-Raghib (Mufradat): \"أصل الأمن: طمأنينة النفس وزوال الخوف\" — tranquility of the soul and removal of fear. In the Hereafter, \"آمنون\" is not mere absence of threat but the positive, settled peace of the soul in the Divine presence.\n  * Al-Zamakhshari (Asas): Literal: \"أمنته وآمننيه\" — to grant safety. Metaphorical: \"فرس أمين القوى\" — a horse whose strength is trustworthy; here the blessed are \"آمنون من ريب المنون\" — secure from the vicissitudes of fate, a security that is trustworthy and unbreachable.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule permits separation between a preposition and its object by an element upon which speech may properly pause, as in \"إن به لضرًا\" — here \"فهم فيما اشتهت أنفسهم خالدون\" (in what their souls desire, abiding eternally) interposes the clause of desire between the prepositional phrase and its predicate, heightening rhetorical emphasis on the soul's fulfillment.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}]}, "wordTiming": {"minshawi": {"1": [[1, 300, 2230]], "55:1": [[1, 300, 2230]], "2": [[1, 40, 1159], [2, 1159, 3410]], "55:2": [[1, 40, 1159], [2, 1159, 3410]], "3": [[1, 30, 1291], [2, 1291, 3750]], "55:3": [[1, 30, 1291], [2, 1291, 3750]], "4": [[1, 20, 1099], [2, 1099, 2960]], "55:4": [[1, 20, 1099], [2, 1099, 2960]], "5": [[1, 30, 1262], [2, 1262, 2805], [3, 2805, 4560]], "55:5": [[1, 30, 1262], [2, 1262, 2805], [3, 2805, 4560]], "6": [[1, 200, 1791], [2, 1791, 3305], [3, 3305, 5080]], "55:6": [[1, 200, 1791], [2, 1791, 3305], [3, 3305, 5080]], "7": [[1, 930, 3367], [2, 3367, 4439], [3, 4439, 5581], [4, 5581, 7060]], "55:7": [[1, 930, 3367], [2, 3367, 4439], [3, 4439, 5581], [4, 5581, 7060]], "8": [[1, 570, 1372], [2, 1372, 2519], [3, 2519, 2888], [4, 2888, 4230]], "55:8": [[1, 570, 1372], [2, 1372, 2519], [3, 2519, 2888], [4, 2888, 4230]], "9": [[1, 200, 1859], [2, 1859, 2576], [3, 2576, 3312], [4, 3312, 4073], [5, 4073, 5240], [6, 5240, 6420]], "55:9": [[1, 200, 1859], [2, 1859, 2576], [3, 2576, 3312], [4, 3312, 4073], [5, 4073, 5240], [6, 5240, 6420]], "10": [[1, 200, 1451], [2, 1451, 2928], [3, 2928, 4300]], "55:10": [[1, 200, 1451], [2, 1451, 2928], [3, 2928, 4300]], "11": [[1, 450, 1822], [2, 1822, 2704], [3, 2704, 4292], [4, 4292, 5233], [5, 5233, 6850]], "55:11": [[1, 450, 1822], [2, 1822, 2704], [3, 2704, 4292], [4, 4292, 5233], [5, 5233, 6850]], "12": [[1, 30, 1092], [2, 1092, 1655], [3, 1655, 2435], [4, 2435, 4350]], "55:12": [[1, 30, 1092], [2, 1092, 1655], [3, 1655, 2435], [4, 2435, 4350]], "13": [[1, 350, 1392], [2, 1392, 3719], [3, 3719, 5013], [4, 5013, 6510]], "55:13": [[1, 350, 1392], [2, 1392, 3719], [3, 3719, 5013], [4, 5013, 6510]], "