ِ", "translit": "ِrāَṭْqَaʾ", "root": "قطر"}, {"id": 10, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 11, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 12, "arabic": "فَٱنفُذُوا۟", "translit": "۟āwُhdُfnٱَf", "root": "نفذ"}, {"id": 13, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 14, "arabic": "تَنفُذُونَ", "translit": "َnwُhdُfnَt", "root": "نفذ"}, {"id": 15, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 16, "arabic": "بِسُلْطَٰنٍ", "translit": "ٍnَٰṭْlُsِb", "root": "سلط"}], "hasIhya": false}, {"ayah": 34, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ", "translation": "So which of the favors of your Lord would you deny?", "words": [{"id": 1, "arabic": "فَبِأَىِّ", "translit": "ِّàَaʾِbَf", "root": "ايي"}, {"id": 2, "arabic": "ءَالَآءِ", "translit": "ِءٓāَlāَء", "root": "الو"}, {"id": 3, "arabic": "رَبِّكُمَا", "translit": "āَmُkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "تُكَذِّبَانِ", "translit": "ِnāَbِّhdَkُt", "root": "كذب"}], "hasIhya": false}, {"ayah": 35, "text": "يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِّن نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ ", "translation": "There will be sent upon you a flame of fire and smoke,[1] and you will not defend yourselves.", "words": [{"id": 1, "arabic": "يُرْسَلُ", "translit": "ُlَsْrُy", "root": "رسل"}, {"id": 2, "arabic": "عَلَيْكُمَا", "translit": "āَmُkْyَlَʿع", "root": ""}, {"id": 3, "arabic": "شُوَاظٌ", "translit": "ٌẓāَwُhs", "root": "شوظ"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "نَّارٍ", "translit": "ٍrāَّn", "root": "نور"}, {"id": 6, "arabic": "وَنُحَاسٌ", "translit": "ٌsāَḥُnَw", "root": "نحس"}, {"id": 7, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 8, "arabic": "تَنتَصِرَانِ", "translit": "ِnāَrِṣَtnَt", "root": "نصر"}], "hasIhya": false}, {"ayah": 36, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ", "translation": "So which of the favors of your Lord would you deny?", "words": [{"id": 1, "arabic": "فَبِأَىِّ", "translit": "ِّàَaʾِbَf", "root": "ايي"}, {"id": 2, "arabic": "ءَالَآءِ", "translit": "ِءٓāَlāَء", "root": "الو"}, {"id": 3, "arabic": "رَبِّكُمَا", "translit": "āَmُkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "تُكَذِّبَانِ", "translit": "ِnāَbِّhdَkُt", "root": "كذب"}], "hasIhya": false}, {"ayah": 37, "text": "فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةً كَٱلدِّهَانِ ", "translation": "And when the heaven is split open and becomes rose-colored like oil[1] -", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 2, "arabic": "ٱنشَقَّتِ", "translit": "ِtَّqَhsnٱ", "root": "شقق"}, {"id": 3, "arabic": "ٱلسَّمَآءُ", "translit": "ُءٓāَmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "فَكَانَتْ", "translit": "ْtَnāَkَf", "root": "كون"}, {"id": 5, "arabic": "وَرْدَةً", "translit": "ًẗَdْrَw", "root": "ورد"}, {"id": 6, "arabic": "كَٱلدِّهَانِ", "translit": "ِnāَhِّdlٱَk", "root": "دهن"}], "hasIhya": false}, {"ayah": 38, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ", "translation": "So which of the favors of your Lord would you deny? -", "words": [{"id": 1, "arabic": "فَبِأَىِّ", "translit": "ِّàَaʾِbَf", "root": "ايي"}, {"id": 2, "arabic": "ءَالَآءِ", "translit": "ِءٓāَlāَء", "root": "الو"}, {"id": 3, "arabic": "رَبِّكُمَا", "translit": "āَmُkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "تُكَذِّبَانِ", "translit": "ِnāَbِّhdَkُt", "root": "كذب"}], "hasIhya": false}, {"ayah": 39, "text": "فَيَوْمَئِذٍ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌ وَلَا جَآنٌّ ", "translation": "Then on that Day none will be asked about his sin among men or jinn.[1]", "words": [{"id": 1, "arabic": "فَيَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَyَf", "root": "يوم"}, {"id": 2, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 3, "arabic": "يُسْـَٔلُ", "translit": "ُlَٔـْsُy", "root": "سال"}, {"id": 4, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 5, "arabic": "ذَنۢبِهِۦٓ", "translit": "ٓۦِhِbۢnَh