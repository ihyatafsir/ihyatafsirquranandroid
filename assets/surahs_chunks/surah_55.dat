{"surah": 55, "verses": [{"ayah": 1, "text": "ٱلرَّحْمَٰنُ ", "translation": "The Most Merciful", "words": [{"id": 1, "arabic": "ٱلرَّحْمَٰنُ", "translit": "ُnَٰmْḥَّrlٱ", "root": "رحم"}], "hasIhya": false}, {"ayah": 2, "text": "عَلَّمَ ٱلْقُرْءَانَ ", "translation": "Taught the Qur’ān,", "words": [{"id": 1, "arabic": "عَلَّمَ", "translit": "َmَّlَʿع", "root": "علم"}, {"id": 2, "arabic": "ٱلْقُرْءَانَ", "translit": "َnāَءْrُqْlٱ", "root": "قرا"}], "hasIhya": false}, {"ayah": 3, "text": "خَلَقَ ٱلْإِنسَٰنَ ", "translation": "Created man,", "words": [{"id": 1, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 2, "arabic": "ٱلْإِنسَٰنَ", "translit": "َnَٰsnِiʾْlٱ", "root": "انس"}], "hasIhya": true}, {"ayah": 4, "text": "عَلَّمَهُ ٱلْبَيَانَ ", "translation": "[And] taught him eloquence.", "words": [{"id": 1, "arabic": "عَلَّمَهُ", "translit": "ُhَmَّlَʿع", "root": "علم"}, {"id": 2, "arabic": "ٱلْبَيَانَ", "translit": "َnāَyَbْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 5, "text": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍ ", "translation": "The sun and the moon [move] by precise calculation,", "words": [{"id": 1, "arabic": "ٱلشَّمْسُ", "translit": "ُsْmَّhslٱ", "root": "شمس"}, {"id": 2, "arabic": "وَٱلْقَمَرُ", "translit": "ُrَmَqْlٱَw", "root": "قمر"}, {"id": 3, "arabic": "بِحُسْبَانٍ", "translit": "ٍnāَbْsُḥِb", "root": "حسب"}], "hasIhya": false}, {"ayah": 6, "text": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ ", "translation": "And the stars and trees prostrate.[1]", "words": [{"id": 1, "arabic": "وَٱلنَّجْمُ", "translit": "ُmْjgَّnlٱَw", "root": "نجم"}, {"id": 2, "arabic": "وَٱلشَّجَرُ", "translit": "ُrَjgَّhslٱَw", "root": "شجر"}, {"id": 3, "arabic": "يَسْجُدَانِ", "translit": "ِnāَdُjgْsَy", "root": "سجد"}], "hasIhya": false}, {"ayah": 7, "text": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ ", "translation": "And the heaven He raised and imposed the balance", "words": [{"id": 1, "arabic": "وَٱلسَّمَآءَ", "translit": "َءٓāَmَّslٱَw", "root": "سمو"}, {"id": 2, "arabic": "رَفَعَهَا", "translit": "āَhَʿعَfَr", "root": "رفع"}, {"id": 3, "arabic": "وَوَضَعَ", "translit": "َʿعَḍَwَw", "root": "وضع"}, {"id": 4, "arabic": "ٱلْمِيزَانَ", "translit": "َnāَzyِmْlٱ", "root": "وزن"}], "hasIhya": false}, {"ayah": 8, "text": "أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ ", "translation": "That you not transgress within the balance.", "words": [{"id": 1, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 2, "arabic": "تَطْغَوْا۟", "translit": "۟āْwَغْṭَt", "root": "طغي"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْمِيزَانِ", "translit": "ِnāَzyِmْlٱ", "root": "وزن"}], "hasIhya": true}, {"ayah": 9, "text": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ ", "translation": "And establish weight in justice and do not make deficient the balance.", "words": [{"id": 1, "arabic": "وَأَقِيمُوا۟", "translit": "۟āwُmyِqَaʾَw", "root": "قوم"}, {"id": 2, "arabic": "ٱلْوَزْنَ", "translit": "َnْzَwْlٱ", "root": "وزن"}, {"id": 3, "arabic": "بِٱلْقِسْطِ", "translit": "ِṭْsِqْlٱِb", "root": "قسط"}, {"id": 4, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 5, "arabic": "تُخْسِرُوا۟", "translit": "۟āwُrِsْhkُt", "root": "خسر"}, {"id": 6, "arabic": "ٱلْمِيزَانَ", "translit": "َnāَzyِmْlٱ", "root": "وزن"}], "hasIhya": false}, {"ayah": 10, "text": "وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ ", "translation": "And the earth He laid [out] for the creatures.", "words": [{"id": 1, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 2, "arabic": "وَضَعَهَا", "translit": "āَhَʿعَḍَw", "root": "وضع"}, {"id": 3, "arabic": "لِلْأَنَامِ", "translit": "ِmāَnَaʾْlِl", "root": "انم"}], "hasIhya": false}, {"ayah": 11, "text": "فِيهَا فَٰكِهَةٌ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ ", "translation": "Therein is fruit and palm trees having sheaths [of dates]", "words": [{"id": 1, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 2, "arabic": "فَٰكِهَةٌ", "translit": "ٌẗَhِkَٰf", "root": "فكه"}, {"id": 3, "arabic": "وَٱلنَّخْلُ", "translit": "ُlْhkَّnlٱَw", "root": "نخل"}, {"id": 4, "arabic": "ذَاتُ", "translit": "ُtāَhd", "root": ""}, {"id": 5, "arabic": "ٱلْأَكْمَامِ", "translit": "ِmāَmْkَaʾْlٱ", "root": "كمم"}], "hasIhya": false}, {"ayah": 12, "text": "وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ ", "translation": "And grain having husks and scented plants.", "words": [{"id": 1, "arabic": "وَٱلْحَبُّ", "translit": "ُّbَḥْlٱَw", "root": "حبب"}, {"id": 2, "arabic": "ذُو", "translit": "wُhd", "root": ""}, {"id": 3, "arabic": "ٱلْعَصْفِ", "translit": "ِfْṣَʿعْlٱ", "root": "عصف"}, {"id": 4, "arabic": "وَٱلرَّيْحَانُ", "translit": "ُnāَḥْyَّrlٱَw", "root": "روح"}], "hasIhya": false}, {"ayah": 13, "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ ", "translation": "So which of the favors of your Lord would you deny?[1]", "words": [{"id": 1, "arabic": "فَبِأَىِّ", "translit": "ِّàَaʾِbَf", "root": "ايي"}, {"id": 2, "arabic": "ءَالَآءِ", "translit": "ِءٓāَlāَء", "root": "الو"}, {"id": 3, "arabic": "رَبِّكُمَا", "translit": "āَmُkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "تُكَذِّبَانِ", "translit": "ِnāَbِّhdَkُt", "root": "كذب"}], "hasIhya": false}, {"ayah": 14, "text": "خَلَقَ ٱلْإِنسَٰنَ مِن صَلْصَٰلٍ كَٱلْفَخَّارِ ", "translation": "He created man from clay like [that of] pottery.", "words": [{"id": 1, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 2, "arabic": "ٱلْإِنسَٰنَ", "translit": "َnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "صَلْصَٰلٍ", "translit": "ٍlَٰṣْlَṣ", "root": "صلصل"}, {"id": 5, "arabic": "كَٱلْفَخَّارِ", "translit": "ِrāَّhkَfْlٱَk", "root": "فخر"}], "hasIhya": true}, {"ayah": 15, "text": "وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍ مِّن نَّارٍ ", "translation": "And He created the jinn from a smokeless flame of fire.", "words": [{"id": 1, "arabic": "وَخَلَقَ", "translit": "َqَlَhkَw", "root": "خلق"}, {"id": 2, "arabic": "ٱلْجَآنَّ", "translit": "َّnٓā